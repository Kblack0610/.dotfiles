# AWS CLI profiles. No secrets here: each profile reads its key from rbw
# through aws-rbw-creds (.local/bin). Pass `--profile bnb` (or AWS_PROFILE=bnb
# with no AWS_ACCESS_KEY_ID in the env: env keys beat AWS_PROFILE, --profile beats both).

# Studio AWS account, Unity CI burst runners (home-config docs/unity-ci-hardware.md).
[profile bnb]
# Many small files (the Unity art libraries are ~170k files): the default 10
# requests leaves the uplink idle; 64 fills it (0.5 -> 4.7 MB/s measured 11-03).
s3 =
    max_concurrent_requests = 64
    max_queue_size = 10000
region = us-east-2
credential_process = aws-rbw-creds aws_bnb-admin
