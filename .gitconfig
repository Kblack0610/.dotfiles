[user]
	name = Kenneth
	email = kblack0610@gmail.com

# Work identity for anything cloned under ~/dev/.
# The included file is machine-local (not in dotfiles) — see .ssh/README.md.
# Trailing slash matters: scopes to the directory tree.
[includeIf "gitdir:~/dev/"]
	path = ~/.gitconfig-work
# The macOS keychain, on macOS only. Elsewhere there is no git-credential-osxkeychain, and
# naming it printed "'credential-osxkeychain' is not a git command" on every https fetch.
[credential]
	helper = "!f() { [ \"$(uname)\" = Darwin ] || exit 0; exec git credential-osxkeychain \"$@\"; }; f"
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
# One dispatcher for every clone and worktree: it runs the repo's committed .githooks/<hook> (our
# repos only) or the repo's own .git/hooks, so no repo needs a setup step. A repo's own local
# core.hooksPath still wins. See .config/git/hooks/dispatch. Rollback: delete this line.
[core]
	hooksPath = ~/.config/git/hooks
# fsync loose objects too (git's default skips them), so a crash cannot leave a ref pointing at an
# empty or missing object. One fsync per object: batch, which git calls safe only on macOS and
# Windows, lost the batched trees and blob of two ~/.notes commits on btrfs in a crash on 2026-11-20
# while their commit objects survived. Needs git 2.36+. Test: tests/unit/gitconfig.bats.
	fsync = committed
	fsyncMethod = fsync
[fetch]
	prune = true
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[url "git@bitbucket-nova:"]
	insteadOf = git@bitbucket.org:
[url "ssh://git@bitbucket-nova/"]
	insteadOf = ssh://git@bitbucket.org/
# Machine-local overrides (untracked). Holds the Cloudflare Access service-token
# headers for git.kennethblack.me so secrets never land in this tracked file.
# See ~/.gitconfig.local (create per-machine; not stowed).
[include]
	path = ~/.gitconfig.local

[include]
	path = ~/.config/git/private.inc
