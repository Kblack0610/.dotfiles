[Desktop Entry]
Version=1.5
Name=RustDesk
GenericName=Remote Desktop
Comment=Remote Desktop (XWayland)
# XWayland: under native Wayland on the NVIDIA desktop the Flutter window fails
# "Failed to initialize GLArea" and opens empty, showing the blur behind it.
Exec=env GDK_BACKEND=x11 rustdesk %u
Icon=rustdesk
Terminal=false
Type=Application
StartupNotify=true
Categories=Network;RemoteAccess;GTK;
Keywords=internet;
