# The Google AI Pro seat through the Antigravity CLI's own login (~/.gemini/antigravity-cli). No
# host to name, so it ships public, like chatgpt. An exported GEMINI_API_KEY or GOOGLE_API_KEY
# could move billing to a metered key, so lib/scrub.list takes them before agy starts.
ROUTE_DESC="personal Google AI Pro seat via the Antigravity CLI (agy), native endpoint, its own OAuth"
ROUTE_TRANSPORT="google-native"
ROUTE_BASE_URL=""
ROUTE_KEY_SOURCE="oauth"
ROUTE_PAYER="subscription"
ROUTE_PERSONAL_SAFE="no"
ROUTE_WORK_SAFE="no"
ROUTE_FALLBACK_SAFE="yes"      # native: no router in the path, so no edge exists
ROUTE_HARNESSES="agy"
ROUTE_NOTE="PERSONAL_SAFE=no until the human decides whether personal data may go to the Google account; a run declares DATA_CLASS=public meanwhile."
