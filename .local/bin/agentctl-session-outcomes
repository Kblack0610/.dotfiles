#!/usr/bin/env bash
# agentctl-session-outcomes - nightly, model-free record of what each session did.
#
#   agentctl-session-outcomes [run] [--all]                observe due sessions (--all: every one)
#   agentctl-session-outcomes worst [--by hook|skill] [--project P] [--days N] [-n N] [--json]
#   agentctl-session-outcomes card <session-id prefix> [--json]   one session's full card
#   agentctl-session-outcomes ended [--days N]             the sessions that stopped that recently, one JSON line each, newest first
#   agentctl-session-outcomes costs [--days N]             what each session in the window cost and on what, runners too (the hub's Costs tab)
#   agentctl-session-outcomes langfuse [--all]             push outcomes and judge verdicts to Langfuse as scores
#   agentctl-session-outcomes backfill-harness YYYY-MM     give that month's rows with no harness one
#   agentctl-session-outcomes rework DIR [--days N] [--until T] [--sample N]   rework over a repo's commits
#   agentctl-session-outcomes lessons [--days N] [--json] [--cached]   did each lesson with a sig change behaviour
#
# run: every registry session (~/.agent/sessions/*/sessions.jsonl) that is new, was
# resumed, or just turned SO_FINAL_DAYS old gets one line in ~/.agent/outcomes. Outcomes:
# WORKED = lines written, NOOP = nothing due, STALLED (exit 1) = gh or a write failed,
# in which case NOTHING is written and the next run catches up. --all observes every session
# again, so a fixed detector reaches sessions already past their final observation. Lib + field meanings:
# ~/.local/lib/session-outcomes.sh. A headless session (`claude -p`, a runner) files under
# project `_runner` with no corrections: nobody is there to correct it, so a lesson it
# writes is its job, not a redirect. Its `agent` is the runner calls.jsonl names for it. Every run ends with `langfuse`: rows observed since the
# last push go to Langfuse as session scores (so_langfuse_events), so its trace view filters
# by them, and each judge verdict that names its call goes as a score on that call's session
# (judge.sh, its own mark). URL: SO_LF_URL (the private runner conf sets it). Key: rbw entry
# SO_LF_ENTRY, "pk-lf-...:sk-lf-...". With either missing the push is skipped; a failed push
# leaves the mark where it was, so the next run sends them again.
# A row is the session's whole card: the registry's cost, tokens and models, the transcript's
# counts, agent-panel's time use, and `fleet-bench stats` as delivery (time per stage, nudges,
# escalations, merged PRs with their lines and CI reds), read once per run. The account is the
# Claude config dir its transcript lives under, as `agent-usage burn` names it.
# An opencode or Codex session has no registry row, so its line comes from opencode's DB
# (so_opencode_rows) or Codex's rollout files (so_codex_rows).
# `harness` on a line is what its launcher recorded (HARNESS_DEF). A gateway item's real spend
# goes on the item as gateway_cost_usd (gateway_push).
# Seams: SO_SESSIONS SO_OUT SO_NOW SO_GH SO_LIB_DIR SO_RBW SO_CURL SO_BENCH SO_QUEUE SO_LESSONS_DIR
# SO_OPENCODE_DB SO_CODEX_SESSIONS SO_PROJECT_LIB SO_HARNESSES SO_PROJECT_MAP SO_ROADMAP SO_TRANSCRIPT_ROOTS.
# `class` on a line is {size, kind} of the queue item the session worked: the size and kind of the
# item's `row:` on its project's roadmap, the item's own `type:` when the row is not there. The first
# item of a chain that has either wins; a session with no item has no class. fleet-bench models --by
# class reads it. A row written before the stamp has none until the session is observed again; an
# observation that cannot resolve the item or its roadmap row keeps the class the last row had.
# Rework (session-outcomes.sh "rework"): each merged PR whose repo has a clone in the project map
# carries the fixes that rewrote its lines, from one blame pass per repo per run. A session with a
# merged PR is observed once more when it turns SO_REWORK_VERIFY_DAYS (30) old, so the verified
# count has had its whole window. `rework DIR` prints the same count for a repo's commits.
# Session links: a PR whose body names a claude.ai/code session link (so_pr_index) is a PR of the
# session whose transcript or subagents recorded that link (so_session_links), so a PR opened in a
# subagent or by any command counts. The repos read are the due sessions' plus every repo with a
# clone in the project map. A link no local transcript recorded, with a PR merged in the observation
# band, is a session that ran elsewhere (claude.ai/code): it gets a line of its own, harness
# claude-cloud, observed by the same rule as a registry row, on a run that has any session due.
# Each merged PR whose repo has a clone gets `project` from its changed paths (agent-queue credit-of),
# and `projects` on the line is the session's project plus its PRs', which `worst --project` matches.

set -uo pipefail

SESSIONS="${SO_SESSIONS:-$HOME/.agent/sessions}"
OUT="${SO_OUT:-$HOME/.agent/outcomes}"
NOW="${SO_NOW:-$(date +%s)}"
FINAL_DAYS="${SO_FINAL_DAYS:-7}"
PR_LIMIT="${SO_PR_LIMIT:-1000}"   # newest N PRs per repo; one paginated call covers them
GH="${SO_GH:-gh}"
RBW="${SO_RBW:-rbw}"
CURL="${SO_CURL:-curl}"
BENCH="${SO_BENCH:-fleet-bench}"
QUEUE="${SO_QUEUE:-agent-queue}"
ROADMAP="${SO_ROADMAP:-notes projects --roadmap}"   # given <project> --json: leaf rows with size and kind
OC_DB="${SO_OPENCODE_DB:-$HOME/.local/share/opencode/opencode.db}"
CX_DIR="${SO_CODEX_SESSIONS:-$HOME/.codex/sessions}"
HARNESSES="${SO_HARNESSES:-$HOME/.config/agentctl/harnesses.json}"
PROJECT_MAP="${SO_PROJECT_MAP:-$HOME/.config/shared-hooks/project-map.json}"   # a PR's repo -> its clone and its apps
TR_ROOTS="${SO_TRANSCRIPT_ROOTS:-}"   # colon-separated; unset: every ~/.claude*/projects, for the links local transcripts recorded
# Money as `worst` and `card` print it.
FMT_DEF='def usd: if . == null then "-" else "$\(. * 100 | round / 100)" end;'
LF_URL="${SO_LF_URL:-}"   # set by the private runner conf; this repo is public
LF_ENTRY="${SO_LF_ENTRY:-langfuse-api}"
LF_TTL_DAYS=90    # Langfuse keeps traces 90 days; a score on a session older than that has nothing to point at
SO_ASKS="${SO_ASKS:-$HOME/.agent/asks}"                          # the ask judge's verdicts
SO_VERDICTS="${SO_VERDICTS:-$HOME/.agent/dispatch/verdicts.jsonl}"  # the dispatch judge's
NAME=session-outcomes

LIB_DIR="${SO_LIB_DIR:-$HOME/.local/lib}"

# shellcheck source=/dev/null
. "$LIB_DIR/agent-proof.sh"
# shellcheck source=/dev/null
. "$LIB_DIR/langfuse.sh"
# shellcheck source=/dev/null
. "$LIB_DIR/judge.sh"
# shellcheck source=/dev/null
. "$LIB_DIR/session-outcomes.sh"
# shellcheck source=/dev/null
. "$LIB_DIR/agent-merge-proof.sh"   # merge_proof_branch: the branch rework reads

# queue_index FILE - what the queue knows of each session, {"<sid>": {agent, pr, items, refs}}: the work
# items whose `sessions:` list it (the ledger join every reader of a row uses; a session can work
# several), the harness it ran on and, for a headless harness (opencode, codex), the PR the brief
# set. An unreadable queue writes {} and returns 1.
queue_index() {
  "$QUEUE" list --json --state all 2>/dev/null | jq -cn 'reduce (inputs | select(.sessions) | . as $i
      | (.sessions | split(" "))[] | {s: ., i: $i}) as $x ({};
        .[$x.s] = {agent: $x.i.agent, pr: $x.i.pr, items: ((.[$x.s].items // []) + [$x.i.slug]),
                   refs: ((.[$x.s].refs // []) + [{row: ($x.i.row // ""), type: ($x.i.type // "")}])})' > "$1" && return 0
  printf '{}' > "$1"
  return 1
}

# roadmap_index QUEUE_FILE DUE_FILE FILE - {"<project>:<id>": {size, kind}} for every row the due
# sessions' items name, one roadmap read per project. An unreadable roadmap leaves its rows out (the
# row's last class, else the item's type, then stands in) and the run goes on: a class is a label,
# not a gate.
roadmap_index() {
  local p
  for p in $(jq -r --slurpfile d "$2" '[$d[].session_id] as $ids
      | [to_entries[] | select(.key as $k | $ids | index($k)) | .value.refs[]?.row | select(test(":")) | split(":")[0]] | unique[]' "$1"); do
    $ROADMAP "$p" --json 2>/dev/null | jq -c --arg p "$p" 'arrays | .[].rows[]? | {key: "\($p):\(.id)", value: {size, kind}}' 2>/dev/null
  done | jq -cs 'from_entries' > "$3" 2>/dev/null || printf '{}' > "$3"
  [ -s "$3" ] || printf '{}' > "$3"
}

# The one harness rule, for `run` and `backfill-harness`: what the row says. The launcher records it:
# opencode and codex rows carry theirs, and the Stop hook stores the session's AGENT_HARNESS
# (claude-lazer exports it, fleet-dispatch names the gateway harness it starts), claude when unset.
# A row from before that record keeps the harness an earlier `run` gave the session, else takes the
# item's agent, except a gateway agent (one the harness map launches by claude-lazer) on a transcript
# under another account's config dir: a gateway run unsets CLAUDE_CONFIG_DIR, so it is always under
# ~/.claude.
HARNESS_DEF='def harness_of($i):
  ($i.agent // "claude") as $a
  | .harness // .prior_harness // (
      if ($hm.harnesses[$a].launcher // $a) == "claude-lazer"
         and ((.account // (.transcript // "" | capture("/\\.(?<a>claude[^/]*)/projects/").a)) // "claude") != "claude" then "claude"
      else $a end);'

# The harness map as JSON, {} when there is none.
harness_map() { { [ -r "$HARNESSES" ] && jq -c . "$HARNESSES"; } 2>/dev/null || echo '{}'; }

# due_rows SEEN ALL - stdin: registry-shaped lines; stdout: those due an observation, with final,
# rework_settled and the prior class and harness. A session id on two lines (it moved project
# mid-life) takes the newest Stop.
due_rows() {
  jq -cnR --slurpfile seen "$1" --argjson now "$NOW" --argjson days "$FINAL_DAYS" \
      --argjson vdays "$SO_REWORK_VERIFY_DAYS" --argjson all "$2" '
      ($seen | map({key: .session_id, value: .}) | from_entries) as $s
      | [inputs | fromjson? | select(type == "object" and .session_id and .updated)]
      | group_by(.session_id) | map(max_by(.updated)) | .[]
      | . + {final: (($now - .updated) >= $days * 86400),
             rework_settled: (($now - .updated) >= $vdays * 86400),
             prior_class: ($s[.session_id].class // null), prior_harness: ($s[.session_id].harness // null)}
      | select(($s[.session_id] // null) as $p
               | $all or $p == null
                 or $p.updated_epoch != .updated
                 or ($p.final == false and .final)
                 or (($p.prs_merged // 0) > 0 and ($p.rework_settled // false) == false and .rework_settled
                     and ($now - .updated) < ($vdays + $days) * 86400))
    '
}

die_stalled() {
  echo "$NAME: $1" >&2
  proof_outcome "$NAME" STALLED "$1"
  exit 1
}

# null_metrics WORK SID - a session with no transcript to read: null metrics and time use. Newline-ended,
# since the PR lists below cat every m file into one jq stream, and nullnull is not JSON.
null_metrics() { printf 'null\n' | tee "$1/m.$2.json" > "$1/t.$2.json"; }

# clone_of CLONES_TSV REPO - the local clone of an owner/name repo (so_rework_repos), or nothing.
clone_of() { awk -F'\t' -v r="${2,,}" 'tolower($1) == r { print $2; exit }' "$1"; }

cmd_run() {
  local work all=false
  case "${1:-}" in
    "") ;;
    --all) all=true ;;
    *) echo "$NAME run: unknown arg $1" >&2; return 2 ;;
  esac
  work="$(mktemp -d)" || die_stalled "mktemp failed"
  # shellcheck disable=SC2064
  trap "rm -rf '$work'" EXIT

  so_latest "$OUT" > "$work/seen.jsonl" || die_stalled "could not read $OUT"

  # A DB opencode's next upgrade reshapes loses its lines and says so, like the bench below: it must
  # not stall every Claude session's row. Nothing reads as zero, because no line is written.
  local oc_note=""
  so_opencode_rows "$OC_DB" "$work" > "$work/opencode.jsonl" 2>"$work/oc.err" ||
    { oc_note="; opencode rows unread: $(head -c 120 "$work/oc.err")"; : > "$work/opencode.jsonl"; echo "$NAME${oc_note#;}" >&2; }
  so_codex_rows "$CX_DIR" "$work" "$HARNESSES" > "$work/codex.jsonl" 2>"$work/cx.err" ||
    { oc_note="$oc_note; codex rows unread: $(head -c 120 "$work/cx.err")"; : > "$work/codex.jsonl"; echo "$NAME: codex rows unread" >&2; }

  # Registry rows due for an observation. A session id can sit in two project files
  # (it moved project mid-life); the newest Stop wins.
  if compgen -G "$SESSIONS/*/sessions.jsonl" >/dev/null; then
    cat "$SESSIONS"/*/sessions.jsonl
  fi | cat - "$work/opencode.jsonl" "$work/codex.jsonl" | due_rows "$work/seen.jsonl" "$all" > "$work/due.jsonl" || die_stalled "could not read the session registry"

  if [ ! -s "$work/due.jsonl" ]; then
    echo "$NAME: nothing due"
    proof_report "$NAME" NOOP "nothing due$oc_note; $(lessons_note); $(gateway_push); $(lf_push "" "$work")"
    return 0
  fi

  local queue_note=""
  queue_index "$work/queue.json" || queue_note="; queue unreadable, harness read as claude, items unknown"
  roadmap_index "$work/queue.json" "$work/due.jsonl" "$work/roadmap.json"
  jq -c --slurpfile q "$work/queue.json" --slurpfile rm "$work/roadmap.json" --argjson hm "$(harness_map)" "$HARNESS_DEF"'($q[0][.session_id] // {}) as $i
      | .items = ($i.items // [])
      | .class = (([($i.refs // [])[] | ($rm[0][.row] // {}) as $r
                   | {size: ($r.size // null), kind: ((($r.kind // "") | select(. != "")) // (.type | select(. != "")) // null)}
                   | select(.size != null or .kind != null)] | first) // .prior_class)
      | .harness = harness_of($i)
      | if .harness == "opencode" or .harness == "codex" then
          .prs = (((.prs // []) + [$i.pr // "" | capture("^(?<repo>[^#]+/[^#]+)#(?<n>[0-9]+)$") | {repo, number: (.n | tonumber)}]) | unique)
        else . end' "$work/due.jsonl" > "$work/due.next" && mv "$work/due.next" "$work/due.jsonl" ||
    die_stalled "could not join the due sessions to the queue"

  # Transcript metrics, one file per due session. A pruned transcript yields null
  # metrics rather than a skipped session: the registry row (cost, edits) still counts.
  # Lessons that carry a sig, read once: each transcript counts its hits (lesson_hits), and
  # fleet-bench retro turns a lesson recurring in two sessions into a guard row.
  local row sid tr n=0 sigs
  sigs=$(so_lesson_sigs | jq -c 'map({sig, since})') || sigs='[]'
  : > "$work/links.jsonl"
  while IFS= read -r row; do
    sid="$(jq -r .session_id <<<"$row")"
    tr="$(jq -r '.transcript // ""' <<<"$row")"
    if [ -n "$tr" ] && [ -f "$tr" ]; then
      so_transcript_metrics "$tr" "$sigs" > "$work/m.$sid.json" || printf 'null\n' > "$work/m.$sid.json"
      "${AGENT_PANEL:-agent-panel}" time-use "$tr" > "$work/t.$sid.json" 2>/dev/null || printf 'null\n' > "$work/t.$sid.json"
      so_session_links "$tr" "${tr%.jsonl}/subagents" | jq -Rcn --arg s "$sid" '{($s): [inputs]}' >> "$work/links.jsonl"
    else
      null_metrics "$work" "$sid"
    fi
    n=$((n + 1))
  done < "$work/due.jsonl"

  # One `gh pr list` per repo per run, never per PR: under fleet load per-PR calls are
  # what tripped the 403 rate limit. The due sessions' repos, plus every repo with a clone in the
  # project map, where a PR that names a session link may sit.
  local repo
  so_rework_repos "$PROJECT_MAP" > "$work/clones.tsv"
  # A due session's repo that cannot be listed stalls the run; a clone's alone is skipped and reported.
  { cat "$work"/m.*.json; jq -c '{prs: (.prs // [])}' "$work/due.jsonl"; } | jq -r 'select(. != null) | .prs[].repo' |
    sort -u > "$work/repos.due"
  sort -u "$work/repos.due" <(cut -f1 "$work/clones.tsv") > "$work/repos"
  : > "$work/index.jsonl"
  local unlisted=0 list_note=""
  while IFS= read -r repo; do
    [ -n "$repo" ] || continue
    if ! "$GH" pr list -R "$repo" --state all --limit "$PR_LIMIT" \
        --json number,state,title,mergedAt,body,mergeCommit > "$work/prs.json" 2>"$work/gh.err"; then
      grep -qixF -- "$repo" "$work/repos.due" && die_stalled "gh pr list $repo failed: $(head -c 200 "$work/gh.err")"
      unlisted=$((unlisted + 1)) list_note="; $((unlisted)) clone repo(s) unlisted, last $repo"
      continue
    fi
    so_pr_index "$FINAL_DAYS" < "$work/prs.json" | jq -c --arg r "$repo" '{($r): .}' >> "$work/index.jsonl" \
      || die_stalled "could not index PRs for $repo"
  done < "$work/repos"
  jq -cs 'add // {}' "$work/index.jsonl" > "$work/index.json" || die_stalled "could not merge the PR indexes"

  # Session links. A PR whose body names a due session's link joins its prs. A link no local
  # transcript recorded, with a PR merged in the band (every one with --all), is a session that ran
  # elsewhere and gets a line of its own. With no transcript root to read, every link would look like
  # one, so none is made and the report says so.
  local cloud_note="" r cand=() roots=()
  if [ -n "$TR_ROOTS" ]; then IFS=: read -ra cand <<<"$TR_ROOTS"; else cand=("$HOME"/.claude*/projects); fi
  for r in "${cand[@]}"; do [ -d "$r" ] && roots+=("$r"); done
  jq -cs 'add // {}' "$work/links.jsonl" 2>/dev/null > "$work/links.json" || printf '{}' > "$work/links.json"
  if [ "${#roots[@]}" -eq 0 ]; then
    cloud_note="; no transcript root, cloud sessions unread"
  elif so_session_links "${roots[@]}" > "$work/local.txt"; then
    { cat "$work/local.txt"; jq -r '.[][]' "$work/links.json"; } | jq -Rcs 'split("\n") | map(select(. != ""))' > "$work/local.json" ||
      die_stalled "could not read the local session links"
  else
    cloud_note="; a transcript unreadable, cloud sessions unread"   # a link it holds would read as a cloud one
  fi
  # {"<link>": [{repo, number}]} over every listed PR
  jq -c '[to_entries[] | .key as $r | .value | to_entries[] | {repo: $r, number: (.key | tonumber), v: .value}
          | .v.links[]? as $l | {l: $l, pr: {repo, number}, merged: (if .v.state == "MERGED" then .v.merged_at else null end)}]' \
    "$work/index.json" > "$work/linked.json" || die_stalled "could not index the PRs' session links"
  jq -c --slurpfile ln "$work/links.json" --slurpfile lk "$work/linked.json" '
      ($ln[0][.session_id] // []) as $mine
      | if ($mine | length) == 0 then . else
          .prs = (.prs // []) + [$lk[0][] | select(.l as $l | $mine | index($l)) | .pr] end' \
    "$work/due.jsonl" > "$work/due.next" && mv "$work/due.next" "$work/due.jsonl" ||
    die_stalled "could not join the due sessions to their PR links"
  if [ -s "$work/local.json" ]; then
    jq -c --slurpfile loc "$work/local.json" --argjson now "$NOW" --argjson all "$all" \
        --argjson band "$(((SO_REWORK_VERIFY_DAYS + FINAL_DAYS) * 86400))" '
        ($loc[0] | map({key: ., value: true}) | from_entries) as $local
        | [.[] | select($local[.l] | not)] | group_by(.l)[]
        | ([.[].merged | select(.) | fromdateiso8601] | max) as $last
        | select($last != null and ($all or ($now - $last) < $band))
        | {session_id: .[0].l, project: null, harness: "claude-cloud", title: "",
           updated: $last, edits: 0, prs: (map(.pr) | unique)}' "$work/linked.json" |
      due_rows "$work/seen.jsonl" "$all" > "$work/cloud.jsonl" || die_stalled "could not read the cloud sessions"
    while IFS= read -r sid; do null_metrics "$work" "$sid"; done < <(jq -r .session_id "$work/cloud.jsonl")
    n=$((n + $(wc -l < "$work/cloud.jsonl")))
    cat "$work/cloud.jsonl" >> "$work/due.jsonl"
  fi

  # The PRs the due sessions name, kept from the index, since each row's jq below reads the whole
  # of it; and the merged ones among them, which rework and attribution read.
  { cat "$work"/m.*.json; jq -c '{prs: (.prs // [])}' "$work/due.jsonl"; } | jq -cn --slurpfile i "$work/index.json" '
      reduce (inputs | select(. != null) | .prs[]) as $p ({};
        ($p.number | tostring) as $n | ($i[0][$p.repo][$n] // null) as $v
        | if $v == null then . else .[$p.repo][$n] = $v end)' > "$work/index.due.json" ||
    die_stalled "could not list the due sessions' PRs"
  jq -r 'to_entries[] | .key as $r | .value | to_entries[]
         | select(.value.state == "MERGED" and .value.merged_at and .value.merge_oid)
         | [$r, .key, .value.merge_oid, (.value.merged_at | fromdateiso8601)] | @tsv' "$work/index.due.json" > "$work/merged.tsv" ||
    die_stalled "could not list the merged PRs to read rework for"

  # Rework: one blame pass per repo, over the fixes since the oldest merged PR a due session
  # names. The clone is fetched first, so a fix merged since its last pull is seen; one that will
  # not fetch is read as it stands, and the report says so. A repo with no clone stays unmeasured.
  local rework_note="" dir branch since
  printf '{}' > "$work/rework.json"
  sort -t$'\t' -k1,1 -k4,4n "$work/merged.tsv" | awk -F'\t' '!seen[$1]++ { print $1 "\t" $4 }' > "$work/rework.due"
  while IFS=$'\t' read -r repo since; do
    dir=$(clone_of "$work/clones.tsv" "$repo")
    [ -n "$dir" ] || continue
    timeout 120 git -C "$dir" fetch -q origin </dev/null 2>/dev/null || rework_note="$rework_note; rework: $repo not fetched"
    branch=$(merge_proof_branch "$dir") || { rework_note="$rework_note; rework: $repo has no origin branch"; continue; }
    so_rework_fixes "$dir" "origin/$branch" "$((since - 1))" "$NOW" | so_rework_index "$dir" > "$work/rw.json" &&
      jq -c --arg r "$repo" --slurpfile i "$work/rw.json" '. + {($r): $i[0]}' "$work/rework.json" > "$work/rework.next" &&
      mv "$work/rework.next" "$work/rework.json" || rework_note="$rework_note; rework: $repo unread"
  done < "$work/rework.due"

  # What each merged PR changed, from its merge commit in the clone (fetched above), credited to an
  # app by `agent-queue credit-of`, the queue's own rule; a PR no app wins is its repo's project, the
  # one the repo's name resolves to (project-name.sh). No clone, a commit the clone does not have, or
  # an unreadable rule leaves the PR's project unknown, and the report says so for the rule.
  local num oid at proj files win attr_note="" names=()
  local -A rproj=()
  mapfile -t names < <(sed 's|.*/||' "$work/repos")
  PROJECT_MAP_FILE="$PROJECT_MAP" bash -c '. "$1" && shift && project_of_repos_json "$@"' _ \
      "${SO_PROJECT_LIB:-$HOME/.config/shared-hooks/project-name.sh}" "${names[@]}" 2>/dev/null |
    jq -c --rawfile repos "$work/repos" '. as $b | [$repos | split("\n")[] | select(. != "")
      | {key: ., value: $b[split("/") | last]} | select(.value)] | from_entries' > "$work/repoproj.json" ||
    { printf '{}' > "$work/repoproj.json"; attr_note="; repo projects unread"; }
  while IFS=$'\t' read -r repo proj; do rproj[$repo]=$proj; done < <(jq -r 'to_entries[] | [.key, .value] | @tsv' "$work/repoproj.json")
  : > "$work/attr.tsv"
  while IFS=$'\t' read -r repo num oid at; do
    dir=$(clone_of "$work/clones.tsv" "$repo") proj=${rproj[$repo]:-}
    [ -n "$dir" ] && [ -n "$proj" ] || continue
    files=$(git -C "$dir" -c core.quotepath=off diff --name-only "$oid^1" "$oid" 2>/dev/null) || continue
    win=$(printf '%s\n' "$files" | AGENT_QUEUE_PROJECT_MAP="$PROJECT_MAP" "$QUEUE" credit-of "$proj" 2>/dev/null) || { attr_note="; credit-of unread"; continue; }
    win=${win%%$'\t'*}
    printf '%s\t%s\n' "$repo#$num" "${win:-$proj}" >> "$work/attr.tsv"
  done < "$work/merged.tsv"
  jq -Rn '[inputs | split("\t") | {key: .[0], value: .[1]}] | from_entries' "$work/attr.tsv" > "$work/attr.json" ||
    die_stalled "could not read the PRs' projects"

  # Delivery from the bench, keyed by session and kept to the due ones, since each row's jq
  # reads the whole map. An unreadable bench leaves delivery null and says so in the
  # report: the rest of the row does not depend on it.
  local bench_note=""
  if ! "$BENCH" stats --json > "$work/bench.jsonl" 2>"$work/bench.err"; then
    bench_note="; fleet-bench stats failed: $(head -c 120 "$work/bench.err")"
    : > "$work/bench.jsonl"
  fi
  jq -cn --slurpfile due "$work/due.jsonl" '($due | map({key: .session_id}) | from_entries) as $d
      | [inputs | .session_id as $s | select($d | has($s)) | {key: .session_id, value: del(.session_id, .project)}]
      | from_entries' "$work/bench.jsonl" > "$work/bench.json" 2>/dev/null \
    || { printf '{}' > "$work/bench.json"; bench_note="; fleet-bench stats unreadable"; }

  # Which runner a headless session was: calls.jsonl names the agent of every call that
  # went through agentctl-run, keyed by its session id. A session with no call line (a
  # runner still outside the contract) keeps agent null.
  jq -cn '[inputs | select(.session_id and .agent) | {key: .session_id, value: .agent}] | from_entries' \
    "$AGENTCTL_CALLS" > "$work/agents.json" 2>/dev/null || printf '{}' > "$work/agents.json"

  local observed
  observed="$(date -u -d "@$NOW" +%Y-%m-%dT%H:%M:%SZ)"
  : > "$work/lines.jsonl"
  while IFS= read -r row; do
    sid="$(jq -r .session_id <<<"$row")"
    jq -c --argjson row "$row" --slurpfile idx "$work/index.due.json" --slurpfile time_use "$work/t.$sid.json" \
       --slurpfile bench "$work/bench.json" --slurpfile agents "$work/agents.json" --arg observed "$observed" \
       --slurpfile rw "$work/rework.json" --argjson now "$NOW" --argjson rdays "$SO_REWORK_DAYS" \
       --slurpfile attr "$work/attr.json" --slurpfile rp "$work/repoproj.json" '
      . as $m | $idx[0] as $ix
      | ($m // {}) as $mm
      | ($mm.entrypoint == "sdk-cli") as $runner
      | [ (($mm.prs // []) + ($row.prs // []) | unique)[] | . as $p
          | ($ix[$p.repo][($p.number | tostring)] // {state: "UNKNOWN", merged_at: null, reverted: false})
          | {repo: $p.repo, number: $p.number, state, merged_at, reverted,
             project: ($attr[0]["\($p.repo)#\($p.number)"] // null)}
            + (($rw[0][$p.repo] // null) as $r | .merge_oid as $oid
               | if $r != null and .state == "MERGED" and .merged_at and $oid
                 then ($r[$oid] // []) as $f
                   | {rework: {seen_days: (($now - (.merged_at | fromdateiso8601)) / 86400 | floor),
                               candidate: any($f[]; .days <= $rdays), verified: any($f[]; .named), fixes: $f}}
                 else {} end) ] as $prs
      # a cloud session has no project of its own: the one its attributed PRs most often name, a tie
      # going to the one with more PRs overall, where an unattributed (open, or no clone) PR counts
      # for the project of its repo
      | (if $runner then "_runner"
         elif $row.harness == "claude-cloud" then
           ([$prs[] | {p: (.project // $rp[0][.repo]), a: (.project != null)} | select(.p)]
            | group_by(.p) | max_by([(map(select(.a)) | length), length]) | .[0].p) // "_unscoped"
         else $row.project end) as $proj
      | { session_id: $row.session_id,
          project: $proj,
          projects: ([$proj] + [$prs[].project | select(.)] | unique),
          runner: $runner,
          harness: $row.harness,
          provider: $row.provider,
          items: ($row.items // []),
          class: ($row.class // null),
          agent: (if $runner then ($agents[0][$row.session_id] // null) else null end),
          title: ($row.title // $row.first_prompt // ""),
          updated: ($row.updated | todate),
          updated_epoch: $row.updated,
          observed: $observed,
          final: $row.final,
          transcript: ($m != null),
          edits: ($row.edits // 0),
          cost_usd: ($row.cost_usd // null),
          cost_by_model: ($row.cost_by_model // null),
          cost_src: ($row.cost_src // null),
          models: ($row.models // null),
          account: ($row.transcript // "" | capture("/\\.(?<a>claude[^/]*)/projects/").a // null),
          tokens_total: ($row.tokens.total // null),
          duration_s: ($row.duration_s // null),
          prs: $prs,
          prs_merged: ([$prs[] | select(.state == "MERGED")] | length),
          prs_open: ([$prs[] | select(.state == "OPEN")] | length),
          prs_closed_unmerged: ([$prs[] | select(.state == "CLOSED")] | length),
          reverted_7d: ([$prs[] | select(.reverted)] | length),
          rework: ([$prs[] | select(.rework)] as $m
                   | if ($m | length) == 0 then null
                     else {measured: ($m | length),
                           candidate_7d: ([$m[] | select(.rework.candidate)] | length),
                           verified_30d: ([$m[] | select(.rework.verified)] | length)} end),
          # settled only once every merged PR was measured, so a failed read is retried inside the band
          rework_settled: (($row.rework_settled // false) and all($prs[] | select(.state == "MERGED"); .rework != null)),
          board_done: ($mm.board_done // null),
          corrections: (if $runner then null else ($mm.corrections // null) end),
          hard_errors: ($mm.hard_errors // null),
          plan_gate: ($mm.plan_gate // null),
          guards: ($mm.guards // null),
          lesson_hits: (if ($mm.lesson_hits // {}) == {} then null else $mm.lesson_hits end),
          activity: ($mm.activity // null),
          uses: ($mm.uses // null),
          time_use: $time_use[0],
          delivery: ($bench[0][$row.session_id] // null) }
    ' "$work/m.$sid.json" >> "$work/lines.jsonl" || die_stalled "could not build the line for $sid"
  done < "$work/due.jsonl"

  # Append last, all at once: a run that fails above leaves the output untouched.
  local line proj month written=0
  while IFS= read -r line; do
    proj="$(jq -r .project <<<"$line")"
    month="$(jq -r '.updated[0:7]' <<<"$line")"
    mkdir -p "$OUT/$proj" || die_stalled "mkdir $OUT/$proj failed"
    printf '%s\n' "$line" >> "$OUT/$proj/$month.jsonl" || die_stalled "append to $OUT/$proj/$month.jsonl failed"
    written=$((written + 1))
  done < "$work/lines.jsonl"

  echo "$NAME: observed $written session(s) ($n due), $(wc -l < "$work/repos") repo(s) checked$bench_note$oc_note$queue_note$rework_note$attr_note$cloud_note$list_note"
  proof_report "$NAME" WORKED "observed $written$bench_note$oc_note$queue_note$rework_note$attr_note$cloud_note$list_note; $(lessons_note); $(ledger_push); $(gateway_push); $(lf_push "" "$work")"
}

# ledger_push - the work ledger's cost and time (~/.config/agentctl/QUEUE.md): every queue item
# active or finished in the last FINAL_DAYS days gets cost_usd and work_min (agent-panel's
# time_use.work_min) summed over the newest outcome row of each session its `sessions:` lists,
# through `agent-queue set`, only where a value changed. work_min is left out when no session has
# a time_use, and cost_usd when no session row has a cost (a 0 would claim free). Prints one status phrase; never fails the run, the outcome rows are already written.
ledger_push() {
  local items since lines slug kv n=0 bad=0
  since="$(date -u -d "@$((NOW - FINAL_DAYS * 86400))" +%F)"
  items="$("$QUEUE" list --json --state all --since "$since" 2>/dev/null)" || { echo "ledger unreadable"; return 0; }
  lines="$(so_latest "$OUT" | jq -rn --slurpfile items <(printf '%s\n' "$items") '
    ([inputs] | map({key: .session_id, value: .}) | from_entries) as $o
    | $items[] | select(.sessions) | . as $it
    | [(.sessions | split(" "))[] | $o[.] // empty] as $rows
    | select($rows | length > 0)
    | {cost_usd: (if any($rows[]; .cost_usd != null) then $rows | map(.cost_usd // 0) | add * 100 | round / 100 | tostring else null end),
       work_min: (if any($rows[]; .time_use) then $rows | map(.time_use.work_min // 0) | add | tostring else null end)}
    | to_entries | map(select(.value != null and .value != ($it[.key] // null)) | "\(.key)=\(.value)")
    | select(length > 0) | [$it.slug] + . | join("\t")')" || { echo "ledger join failed"; return 0; }
  while IFS=$'\t' read -r slug kv; do
    [ -n "$slug" ] || continue
    # shellcheck disable=SC2086 # kv is key=value fields, tab-joined above
    if "$QUEUE" set "$slug" ${kv//$'\t'/ } >/dev/null 2>&1; then n=$((n + 1)); else bad=$((bad + 1)); fi
  done <<<"$lines"
  if [ "$bad" -eq 0 ]; then echo "ledger $n item(s) updated"; else echo "ledger $n item(s) updated, $bad failed"; fi
}

# gateway_push - what each gateway item really cost: every item on another harness than claude,
# active or finished in the last FINAL_DAYS days, gets gateway_cost_usd from the spend tagged
# queue:<slug>. Runs on the NOOP path too, so an item's cost never waits on an unrelated session, and
# with its own `agent-queue set`, so a failure cannot take cost_usd with it. The endpoint needs both
# dates, in UTC, and lags calls by a minute or so. A failed read, or a tag with no requests yet,
# leaves the field as it is: empty means unknown, and $0 would be a claim. Prints one status phrase.
gateway_push() {
  local items since url file key slug from cur body v to n=0 bad=0
  [ -r "$HARNESSES" ] || { echo "gateway skipped, no harness map"; return 0; }
  since="$(date -u -d "@$((NOW - FINAL_DAYS * 86400))" +%F)"
  to="$(date -u -d "@$NOW" +%F)"
  items="$("$QUEUE" list --json --state all --since "$since" 2>/dev/null |
    jq -r 'select(.started and (.agent // "claude") != "claude") | [.slug, .started[0:10], .gateway_cost_usd // ""] | @tsv')" ||
    { echo "gateway ledger unreadable"; return 0; }
  [ -n "$items" ] || { echo "gateway 0 item(s)"; return 0; }
  url="$(jq -r .gateway.url "$HARNESSES")"
  file="$(jq -r '.gateway.reader_key_file | sub("^~"; env.HOME)' "$HARNESSES")"
  key="$(cat "$file" 2>/dev/null)" || { echo "gateway reader key unreadable"; return 0; }
  while IFS=$'\t' read -r slug from cur; do
    # The key goes in on stdin, off the process list.
    body="$("$CURL" -fsS -m 20 -K - "$url/tag/daily/activity?tags=queue:$slug&start_date=$from&end_date=$to" \
      <<<"header = \"Authorization: Bearer $key\"" 2>/dev/null)" || { bad=$((bad + 1)); continue; }
    v="$(jq -er '.metadata | if .total_api_requests > 0 then .total_spend * 10000 | round / 10000 else "" end' <<<"$body" 2>/dev/null)" ||
      { bad=$((bad + 1)); continue; }
    [ -n "$v" ] && [ "$v" != "$cur" ] || continue
    if "$QUEUE" set "$slug" "gateway_cost_usd=$v" >/dev/null 2>&1; then n=$((n + 1)); else bad=$((bad + 1)); fi
  done <<<"$items"
  if [ "$bad" -eq 0 ]; then echo "gateway $n item(s) updated"; else echo "gateway $n item(s) updated, $bad failed"; fi
}

# lf_push [--all] WORKDIR - send every session's newest row observed after the mark (all
# of them with --all) to Langfuse, then move the mark; then the same for the judge lanes'
# verdicts (lf_push_judge). Prints one status phrase for the run's report. Never fails the
# run: the outcome rows are already written and are the record; a push that failed says so on
# stderr and in the report, and is retried next run.
lf_push() {
  local all="$1" work="$2" key mark since
  local mark_file
  mark_file="$(proof_state_dir)/$NAME/langfuse-mark"
  if [ -z "$LF_URL" ]; then
    printf 'langfuse: no URL (SO_LF_URL)'
    return 0
  fi
  key="$("$RBW" get "$LF_ENTRY" 2>/dev/null)" || key=""
  if [ -z "$key" ]; then
    printf 'langfuse: no key (rbw %s)' "$LF_ENTRY"
    return 0
  fi
  mark=""
  [ "$all" = --all ] || mark="$(cat "$mark_file" 2>/dev/null)"
  since=$((NOW - LF_TTL_DAYS * 86400))
  so_latest "$OUT" | jq -c --arg m "$mark" --argjson since "$since" \
    'select(.observed > $m and .updated_epoch >= $since)' > "$work/lf.rows" || {
    echo "$NAME: langfuse: could not read $OUT" >&2
    printf 'langfuse: FAILED reading outcomes'
    return 0
  }
  if [ ! -s "$work/lf.rows" ]; then
    printf 'langfuse: nothing new'
  elif ! so_langfuse_events < "$work/lf.rows" > "$work/lf.events"; then
    echo "$NAME: langfuse: could not build score events" >&2
    printf 'langfuse: FAILED building events'
  elif ! lf_ingest "$CURL" "$LF_URL" "$key" "$work/lf.events" "$work"; then
    printf 'langfuse: FAILED (HTTP %s) after %s score(s), retried next run' "$LF_STATUS" "$LF_SENT"
  else
    mkdir -p "${mark_file%/*}" && jq -rs 'map(.observed) | max' "$work/lf.rows" > "$mark_file"
    printf 'langfuse: %s score(s) for %s session(s)' "$LF_SENT" "$(wc -l < "$work/lf.rows")"
  fi
  lf_push_judge "$all" "$work" "$key" "$since"
}

# lf_push_judge ALL WORKDIR KEY SINCE - each judge verdict judged after its own mark, as a score
# on the session its call ran as (judge_langfuse_events). Appends "; judge: ..." to the report,
# and nothing when there was no verdict to send.
lf_push_judge() {
  local all="$1" work="$2" key="$3" since="$4" mark_file mark=0
  mark_file="$(proof_state_dir)/$NAME/langfuse-judge-mark"
  [ "$all" = --all ] || mark="$(cat "$mark_file" 2>/dev/null || echo 0)"
  judge_verdicts "$SO_ASKS" "$SO_VERDICTS" |
    judge_langfuse_events "$AGENTCTL_CALLS" "$since" "${mark:-0}" > "$work/jv.events" 2>/dev/null || {
    printf '; judge: FAILED building events'
    return 0
  }
  [ -s "$work/jv.events" ] || return 0
  jq -c 'del(.epoch)' "$work/jv.events" > "$work/jv.send"
  if lf_ingest "$CURL" "$LF_URL" "$key" "$work/jv.send" "$work"; then
    mkdir -p "${mark_file%/*}" && jq -s 'map(.epoch) | max' "$work/jv.events" > "$mark_file"
    printf '; judge: %s score(s)' "$LF_SENT"
  else
    printf '; judge: FAILED (HTTP %s) after %s score(s), retried next run' "$LF_STATUS" "$LF_SENT"
  fi
}

cmd_langfuse() {
  case "${1:-}" in
    ""|--all) ;;
    *) echo "$NAME langfuse: unknown arg $1" >&2; return 2 ;;
  esac
  local work
  work="$(mktemp -d)" || return 1
  # shellcheck disable=SC2064
  trap "rm -rf '$work'" EXIT
  lf_push "${1:-}" "$work"
  echo
}

# so_worst_by KIND PROJECT DAYS TOP JSON: outcome rows on stdin, names ranked by calls (see cmd_worst).
so_worst_by() {
  jq -rn --arg by "$1" --arg p "$2" --argjson days "$3" --argjson top "$4" --argjson json "$5" \
      --argjson now "$NOW" "$(so_friction_def)$FMT_DEF"'
    [inputs
     | select(in_project($p))
     | select(.updated_epoch >= $now - $days * 86400)
     | . + {friction: friction}
     | . as $r
     | ((if $by == "hook" then .guards else .uses.skills end) // {} | to_entries[])
     | {name: .key, calls: .value, session: $r.session_id, project: $r.project,
        cost: $r.cost_usd, friction: ($r.friction > 0)}]
    | group_by(.name)
    | map({name: .[0].name, calls: (map(.calls) | add), sessions: length,
           projects: (map(.project) | unique | length), friction_sessions: (map(select(.friction)) | length),
           mean_session_cost: (map(.cost | select(. != null)) | if length == 0 then null else (add / length) * 100 | round / 100 end)})
    | sort_by(-.calls, -.sessions, .name) | .[:$top]
    | if $json then .[] | tojson
      elif length == 0 then "_(no \($by) in the last \($days) days)_"
      else
        (["| \($by) | calls | sessions | projects | sessions with friction | mean session cost |", "|---|---|---|---|---|---|"]
         + map("| `\(.name)` | \(.calls) | \(.sessions) | \(.projects) | \(.friction_sessions) | \(.mean_session_cost | usd) |"))
        | join("\n")
      end'
}

# worst: the sessions to look at first over the last N days, as a markdown table. --by hook or
# skill ranks names instead, from each outcome row's `guards` (hook denials by hook name) and
# `uses.skills` (Skill calls): calls, the sessions that made them, their projects, how many of those
# sessions had friction (the one `friction` sum, which does not count a hook's own denials), and
# their mean cost over the sessions that have one (the whole session's, so a skill is not charged for it).
cmd_worst() {
  local project="" days=7 top=5 json=false by="" by_given=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --by) [ $# -ge 2 ] || { echo "$NAME worst: --by takes hook or skill" >&2; return 2; }
            by="$2"; by_given=true; shift 2 ;;
      --project) project="${2:-}"; shift 2 ;;
      --days) days="${2:-7}"; shift 2 ;;
      -n) top="${2:-5}"; shift 2 ;;
      --json) json=true; shift ;;
      *) echo "$NAME worst: unknown arg $1" >&2; return 2 ;;
    esac
  done
  if $by_given; then
    case "$by" in
      hook|skill) so_latest "$OUT" | so_worst_by "$by" "$project" "$days" "$top" "$json"; return ;;
      *) echo "$NAME worst: --by takes hook or skill" >&2; return 2 ;;
    esac
  fi
  so_latest "$OUT" | jq -rn --arg p "$project" --argjson now "$NOW" --argjson json "$json" \
      --argjson days "$days" --argjson top "$top" "$(so_friction_def)$FMT_DEF"'
    [inputs
     | select(in_project($p))
     | select(.updated_epoch >= $now - $days * 86400)
     | . + {friction: friction}
     | select(.friction > 0)]
    | sort_by(-.friction, -(.cost_usd // 0)) | .[:$top]
    | if $json then .[] | . + {why: why} | tojson
      elif length == 0 then "_(no session with friction in the last \($days) days)_"
      else
        (["| friction | session | project | title | why | cost | test runs | CI polls | spent after last edit |",
          "|---|---|---|---|---|---|---|---|---|"]
         + map("| \(.friction) | `\(.session_id[0:8])` | \(.project) | \(.title | gsub("[|\n]"; " ") | .[0:60]) | "
               + why
               + " | \(.cost_usd | usd)"
               + " | \(.activity.test_runs // "-") | \(.activity.ci_polls // "-") | "
               + (.activity as $a | if (.edits // 0) > 0 and ($a.tokens // 0) > 0
                  then "\($a.tokens_after_last_edit * 100 / $a.tokens | round)%" else "-" end) + " |"))
        | join("\n")
      end'
}

# ended: what the hub's Sessions table lists as ended (hub_core::session_table), for a session
# with no queue item. The Stop-hook registry has a session from its first stop, so it shows the
# day it ends rather than after the 02:30 run; its outcome row, once written, adds the PR counts and
# harness, and an opencode or Codex session (no registry row) comes from its outcome row alone.
# A headless call is not a session: `_runner` in its outcome row, or a transcript whose first
# entrypoint is sdk-cli before one is written.
cmd_ended() {
  local days=1 since work
  while [ $# -gt 0 ]; do
    case "$1" in
      --days) days="${2:-1}"; shift 2 ;;
      *) echo "$NAME ended: unknown arg $1" >&2; return 2 ;;
    esac
  done
  since=$((NOW - days * 86400))
  work="$(mktemp -d)" || return 1
  # shellcheck disable=SC2064
  trap "rm -rf '$work'" EXIT
  so_latest "$OUT" > "$work/latest.jsonl" || return 1
  if compgen -G "$SESSIONS/*/sessions.jsonl" >/dev/null; then
    cat "$SESSIONS"/*/sessions.jsonl
  fi | jq -cnR --argjson since "$since" '
    [inputs | fromjson? | select(type == "object" and .session_id and (.updated | type) == "number" and .updated >= $since)]
    | group_by(.session_id) | map(max_by(.updated)) | .[]' > "$work/reg.jsonl" || return 1
  # One grep over every transcript, its first entrypoint each (-m1 per file; -o can print two from
  # that line, so awk keeps the first). A missing transcript, or one with no entrypoint, is not
  # headless: grep exits nonzero for it, which must not fail the listing.
  jq -r '.transcript // empty' "$work/reg.jsonl" | sort -u |
    { xargs -r -d '\n' grep -m1 -oH '"entrypoint": *"[^"]*"' 2>/dev/null || :; } |
    awk -F'"entrypoint"' '!seen[$1]++ && $2 ~ /"sdk-cli"/ { sub(/:$/, "", $1); print $1 }' |
    jq -R . | jq -s . > "$work/headless.json" || return 1
  jq -cn --argjson since "$since" --slurpfile reg "$work/reg.jsonl" --slurpfile latest "$work/latest.jsonl" \
      --slurpfile headless "$work/headless.json" '
    ($latest | map({key: .session_id, value: .}) | from_entries) as $o
    | ($headless[0] | map({key: ., value: true}) | from_entries) as $hl
    | ($reg | map({key: .session_id, value: true}) | from_entries) as $inreg
    | [ ($reg[] | select($hl[.transcript // ""] | not) | . as $r | ($o[$r.session_id] // {}) as $p
          | {session_id, project, title: (.title // .first_prompt // ""), harness: ($p.harness // null),
             account: ((.transcript // "" | capture("/\\.(?<a>claude[^/]*)/projects/").a) // $p.account // null),
             cost_usd: (.cost_usd // $p.cost_usd // null),
             updated_epoch: ([.updated, ($p.updated_epoch // 0)] | max),
             prs_merged: ($p.prs_merged // 0), prs_open: ($p.prs_open // 0), _runner: ($p.project == "_runner")}),
        ($latest[] | select(.updated_epoch >= $since and ($inreg[.session_id] | not))
          | {session_id, project, title, harness, account, cost_usd, updated_epoch, prs_merged, prs_open, _runner: (.project == "_runner")}) ]
    | map(select(._runner | not) | del(._runner)) | sort_by(-.updated_epoch)[]'
}

# costs: one line per session updated in the window, runner calls included, with what the hub's
# Costs tab (hub_core::costs) cuts it by. kind is automated for a runner or a queue item's session.
cmd_costs() {
  local days=7
  while [ $# -gt 0 ]; do
    case "$1" in
      --days)
        [[ "${2:-}" =~ ^[0-9]+$ ]] || { echo "$NAME costs: --days takes a whole number of days" >&2; return 2; }
        days="$2"; shift 2 ;;
      *) echo "$NAME costs: unknown arg $1" >&2; return 2 ;;
    esac
  done
  so_latest "$OUT" | jq -cn --argjson now "$NOW" --argjson days "$days" '
    [inputs | select(.updated_epoch >= $now - $days * 86400)]
    | sort_by(-.updated_epoch)[]
    | {session_id, project, title, harness, account, provider, models: (.models // []), cost_usd, cost_by_model,
       tokens_total, updated_epoch, observed,
       runner: (if .runner then (.agent // "runner") else null end),
       kind: (if .runner or ((.items // []) | length > 0) then "automated" else "human" end),
       pr: ((.prs // []) | map(select(.state == "MERGED")) | first
            | if . then "\(.repo)#\(.number)" else null end)}'
}

# cmd_card PREFIX [--json] - one session's newest row as its full card: time, stages, cost,
# delivery, the friction sum term by term, activity and what it reached for. --json is the
# row plus friction and why. A prefix that names no session or more than one is an error.
cmd_card() {
  local prefix="" json=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=true ;;
      -*) echo "$NAME card: unknown arg $1" >&2; return 2 ;;
      *) prefix="$1" ;;
    esac
    shift
  done
  [ -n "$prefix" ] || { echo "usage: $NAME card <session-id prefix> [--json]" >&2; return 2; }
  local rows n
  rows="$(so_latest "$OUT" | jq -c --arg p "$prefix" 'select(.session_id | startswith($p))')"
  n=$(grep -c . <<<"$rows")
  if [ "$n" -eq 0 ]; then
    echo "$NAME card: no outcome row for $prefix" >&2; return 1
  elif [ "$n" -gt 1 ]; then
    echo "$NAME card: $prefix names $n sessions:" >&2
    jq -r '"  \(.session_id)  \(.project)  \(.title | .[0:60])"' <<<"$rows" >&2
    return 2
  fi
  jq -r --argjson json "$json" "$(so_friction_def)$FMT_DEF"'
    def dur: if . == null then "-" else (floor) as $m | if $m >= 60 then "\($m / 60 | floor)h\($m % 60 | tostring | if length < 2 then "0" + . else . end)" else "\($m)m" end end;
    def big: if . == null then "-" elif . >= 1e6 then "\(. / 1e5 | round / 10)M" elif . >= 1e3 then "\(. / 1e3 | round)k" else tostring end;
    def ranked(f): to_entries | sort_by(-.value) | map("\(.key) \(.value | f)") | join(", ");
    . + {friction: friction, why: why}
    | if $json then tojson else
      (.time_use // {}) as $t | (.delivery // {}) as $d | (.activity // {}) as $a
      | [ "\(.title | gsub("\n"; " ") | .[0:80]) (\(.session_id[0:8])), \(.project), updated \(.updated[0:16] | sub("T"; " ")): "
          + "\(if .duration_s then .duration_s / 60 | dur else "-" end) wall, friction \(.friction), \(.cost_usd | usd), "
          + "\(.prs_merged) of \(.prs | length) PRs merged",
          "  Time      " + (if .time_use == null then "-" else
            "work \($t.work_min | dur), gate \($t.gate_min | dur), tests \($t.test_min | dur), jobs \($t.jobs_min | dur), waiting on you \($t.human_min | dur), parked \($t.parked_min | dur)" end),
          "  Stages    " + (if .delivery == null or $d.sampled == false then "never sampled by fleet-bench" else
            ($d.minutes | ranked(dur) | if . == "" then "-" else . end)
            + "; phases ticked \($d.ticked // 0); nudges \($d.nudges // 0), escalations \($d.escalations // 0); peak context \($d.peak_context | big)" end),
          "  Cost      \(.cost_usd | usd)"
            + (if .cost_by_model then ": " + (.cost_by_model | ranked(usd)) else "" end)
            + "; account \(.account // "-"); \(.tokens_total | big) tokens",
          "  Delivery  " + (if (.prs | length) == 0 then "no PR" else
            "\(.prs_merged) merged, \(.prs_open) open, \(.prs_closed_unmerged) closed unmerged, \(.reverted_7d) reverted"
            + " (" + (.prs | map("#\(.number)") | if length > 6 then .[0:6] + ["+\(length - 6) more"] else . end | join(" ")) + ")" end)
            + (if $d.merged then "; +\($d.merged.lines_added) -\($d.merged.lines_deleted) landed; CI \($d.merged.ci_runs) runs, \($d.merged.ci_reds) red before merge" else "" end)
            + (if .rework then "; rework \(.rework.candidate_7d) candidate, \(.rework.verified_30d) verified of \(.rework.measured)" else "" end),
          "  Friction  \(.friction)" + (if .why == "" then "" else " = " + .why end),
          "  Activity  " + (if .activity == null then "no transcript" else
            "\($a.tool_calls) tool calls, \($a.test_runs) test runs, \($a.ci_polls) CI polls"
            + (if $a.compactions then ", \($a.compactions.auto + $a.compactions.manual) compactions (\($a.compactions.auto) auto)" else "" end)
            + (if (.edits // 0) > 0 and ($a.tokens // 0) > 0 then ", \($a.tokens_after_last_edit * 100 / $a.tokens | round)% of tokens after the last edit" else "" end) end),
          "  Uses      " + (if .uses == null then "-" else
            ([ (.uses.skills | if length > 0 then "skills: " + ranked(tostring) else empty end),
               (.uses.subagents | if length > 0 then "agents: " + ranked(tostring) else empty end),
               (.uses.slash | if length > 0 then "commands: " + ranked(tostring) else empty end) ] | join("; ") | if . == "" then "nothing" else . end) end)
        ] | join("\n")
      end' <<<"$rows"
}

# lessons [--days N] [--json] [--cached] - did a lesson change behaviour. For each lesson with a sig
# (so_lesson_sigs), the share of its project's sessions (the lesson file's name) whose Bash commands
# match the sig in the N days (14) before the day it was written, against the N days after that day.
# The sessions are the registry's (newest row per session, as `run` reads it, since an outcome row
# keeps only whether its transcript was read): one sits in the window its last stop falls in, and only
# one whose transcript is still on disk counts, hit or not. The sig is matched afresh rather than read
# from lesson_hits, which counts only after the lesson's date and so has no before window. Each window is scanned once, when it is whole (LESSON_LAG_DAYS after its
# end, so the 02:30 run has rows for it), and kept in $OUT/lesson-effect.jsonl; --cached reads only
# that file. Verdicts: held (the after share is at most LESSON_HELD_RATIO of the before share),
# recurring, no-baseline (no session hit it before, so nothing to compare), thin (a whole window with
# fewer than LESSON_MIN_SESSIONS sessions, too few to call), early (a window not whole yet).
# The last line counts the dream-sweep lessons and how many carry a sig: a lesson with none is not
# measured. `run` refreshes it nightly; fleet-bench KPI lesson_held_share reads the --json.
LESSON_HELD_RATIO="${SO_LESSON_HELD_RATIO:-0.5}"  # provisional (standards.md): revisit once 10 lessons have a verdict
LESSON_MIN_SESSIONS="${SO_LESSON_MIN_SESSIONS:-5}"  # provisional: a window below this is thin; same revisit
LESSON_LAG_DAYS=2

# lesson_window ROWS SIG PROJECT FROM TO - one cache line {sessions, hits} for that window, over
# ROWS (the registry's newest row per session, read once per refresh).
lesson_window() {
  local rows="$1" sig="$2" proj="$3" from="$4" to="$5" tr hits=0 list=()
  while IFS= read -r tr; do
    [ -f "$tr" ] && list+=("$tr")
  done < <(jq -r --arg p "$proj" --argjson f "$from" --argjson t "$to" '
    select(.project == $p and .updated >= $f and .updated < $t) | .transcript // empty' "$rows")
  if [ "${#list[@]}" -gt 0 ]; then
    hits=$(printf '%s\0' "${list[@]}" | xargs -0 jq -rR --arg re "$sig" '
      fromjson? | select(.type == "assistant") | .message.content[]?
      | select(.type == "tool_use" and .name == "Bash")
      | select((.input.command // "") | try test($re) catch false) | input_filename' 2>/dev/null | sort -u | wc -l)
  fi
  jq -cn --argjson s "${#list[@]}" --argjson h "$hits" '{sessions: $s, hits: $h}'
}

# lessons_refresh DAYS - scan every whole window not yet in the cache. Prints how many it added.
lessons_refresh() {
  local days="$1" cache="$OUT/lesson-effect.jsonl" sigs added=0 l sig since proj day0 w from to r rows
  sigs=$(so_lesson_sigs | jq -c '.[] | {sig, since, p: (.file | sub("\\.md$"; ""))}') || return 1
  [ -n "$sigs" ] || { echo 0; return 0; }
  mkdir -p "$OUT" && touch "$cache" || return 1
  rows=$(mktemp) || return 1
  if compgen -G "$SESSIONS/*/sessions.jsonl" >/dev/null; then cat "$SESSIONS"/*/sessions.jsonl; fi |
    jq -cn '[inputs | select(type == "object" and .session_id and (.updated | numbers))]
            | group_by(.session_id)[] | max_by(.updated)' > "$rows" || { rm -f "$rows"; return 1; }
  while IFS= read -r l; do
    sig=$(jq -r .sig <<<"$l"); since=$(jq -r .since <<<"$l"); proj=$(jq -r .p <<<"$l")
    day0=$(date -d "$since" +%s) || continue
    for w in before after; do
      if [ "$w" = before ]; then from=$((day0 - days * 86400)) to=$day0
      else from=$((day0 + 86400)) to=$((day0 + 86400 + days * 86400)); fi
      [ "$NOW" -ge $((to + LESSON_LAG_DAYS * 86400)) ] || continue
      jq -e --arg s "$sig" --arg d "$since" --argjson n "$days" --arg w "$w" \
        'select(.sig == $s and .since == $d and .days == $n and .window == $w)' "$cache" >/dev/null 2>&1 && continue
      r=$(lesson_window "$rows" "$sig" "$proj" "$from" "$to") &&
        jq -c --arg s "$sig" --arg d "$since" --argjson n "$days" --arg w "$w" --arg p "$proj" --argjson at "$NOW" \
          '{sig: $s, since: $d, project: $p, days: $n, window: $w} + . + {at: $at}' <<<"$r" >> "$cache" ||
        { rm -f "$rows"; return 1; }
      added=$((added + 1))
    done
  done <<<"$sigs"
  rm -f "$rows"
  echo "$added"
}

# lessons_note - the nightly refresh, as a clause for run's report. A failed scan is said, not fatal:
# the rows are written, and the next run scans the windows again.
lessons_note() {
  local n
  n=$(lessons_refresh 14) && printf 'lessons: %s window(s) scanned' "$n" || printf 'lessons: scan failed'
}

cmd_lessons() {
  local days=14 json=false cached=false use="usage: $NAME lessons [--days N] [--json] [--cached]"
  while [ $# -gt 0 ]; do
    case "$1" in
      --days) [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || { echo "$use" >&2; return 2; }; days="$2"; shift 2 ;;
      --json) json=true; shift ;;
      --cached) cached=true; shift ;;
      *) echo "$use" >&2; return 2 ;;
    esac
  done
  $cached || lessons_refresh "$days" >/dev/null || { echo "$NAME lessons: scan failed" >&2; return 1; }
  local dir="${SO_LESSONS_DIR:-$HOME/.agent/lessons}" dream sigd sigs
  dream=$(cat "$dir"/*.md 2>/dev/null | grep -c 'dream sweep')
  sigd=$(cat "$dir"/*.md 2>/dev/null | grep 'dream sweep' | grep -c '<!-- sig:')
  sigs=$(so_lesson_sigs) || return 1
  { [ -f "$OUT/lesson-effect.jsonl" ] && cat "$OUT/lesson-effect.jsonl"; true; } |
  jq -rn --argjson sigs "$sigs" --argjson days "$days" --argjson ratio "$LESSON_HELD_RATIO" --argjson min "$LESSON_MIN_SESSIONS" --argjson json "$json" \
     --argjson dream "$dream" --argjson sigd "$sigd" '
    def share: if . == null or .sessions == 0 then null else .hits / .sessions end;
    def pct: if . == null then "-" else "\(. * 1000 | round / 10)%" end;
    [inputs | select(.days == $days)] as $c
    | [$sigs[] | . as $l
       | ($c | map(select(.sig == $l.sig and .since == $l.since and .window == "before")) | last) as $b
       | ($c | map(select(.sig == $l.sig and .since == $l.since and .window == "after")) | last) as $a
       | {sig, since, claim, project: (.file | sub("\\.md$"; "")),
          before: ($b | if . then {sessions, hits} else null end), after: ($a | if . then {sessions, hits} else null end)}
       | .verdict = (if .before == null then "early"
                     elif .before.hits == 0 then "no-baseline"
                     elif .after == null then "early"
                     elif .before.sessions < $min or .after.sessions < $min then "thin"
                     elif (.after | share) <= ($ratio * (.before | share)) then "held"
                     else "recurring" end)] as $ls
    | ($ls | map(.verdict) | {held: (map(select(. == "held")) | length), recurring: (map(select(. == "recurring")) | length),
                              no_baseline: (map(select(. == "no-baseline")) | length), thin: (map(select(. == "thin")) | length), early: (map(select(. == "early")) | length)}) as $t
    | if $json then {lessons: $ls, days: $days} + $t + {dream_lessons: $dream, dream_with_sig: $sigd} | tojson
      else
        (if ($ls | length) == 0 then "_(no lesson carries a sig, so none is measured)_"
         else (["| verdict | project | since | before | after | lesson |", "|---|---|---|---|---|---|"]
               + ($ls | map("| \(.verdict) | \(.project) | \(.since) | "
                            + (.before | if . then "\(.hits)/\(.sessions) \(share | pct)" else "-" end) + " | "
                            + (.after | if . then "\(.hits)/\(.sessions) \(share | pct)" else "-" end) + " | "
                            + (.claim | gsub("[|\n]"; " ") | .[0:70]) + " |"))) | join("\n") end),
        "\($t.held) held, \($t.recurring) recurring, \($t.no_baseline) no-baseline, \($t.thin) thin, \($t.early) early (\($days)d windows); \($sigd) of \($dream) dream-sweep lessons carry a sig"
      end'
}

# rework DIR [--days N] [--until T] [--sample N] - the rework count over a repo's own commits:
# every commit on its default branch in the N days (60) to T (now), the same method `run` puts on
# each merged PR. Non-fix commits old enough for their window are the base; the review's figure
# (54 of 195 on dotfiles, 60 days to 2026-11-06T21:38:18Z) reproduces with
# `rework ~/.dotfiles --until 2026-11-06T21:38:18Z`. --sample N prints N verified pairs at random,
# the change and the fix that names it, for the human's check of the label.
cmd_rework() {
  local dir="" days=60 until="$NOW" sample=0 branch ref since idx commits
  local use="usage: $NAME rework DIR [--days N] [--until T] [--sample N]"
  while [ $# -gt 0 ]; do
    case "$1" in --days|--until|--sample) [ -n "${2:-}" ] || { echo "$use" >&2; return 2; } ;; esac
    case "$1" in
      --days) days="$2"; shift 2 ;;
      --until) until=$(date -d "$2" +%s) || return 2; shift 2 ;;
      --sample) sample="$2"; shift 2 ;;
      -*) echo "$use" >&2; return 2 ;;
      *) dir="$1"; shift ;;
    esac
  done
  [ -n "$dir" ] && [[ "$days" =~ ^[1-9][0-9]*$ ]] && [[ "$sample" =~ ^[0-9]+$ ]] || { echo "$use" >&2; return 2; }
  branch=$(merge_proof_branch "$dir") || { echo "$NAME rework: $dir has no origin branch" >&2; return 1; }
  ref="origin/$branch" since=$((until - days * 86400))
  idx=$(so_rework_fixes "$dir" "$ref" "$since" "$until" | so_rework_index "$dir") || return 1
  commits=$(so_rework_commits "$dir" "$ref" --no-merges --since="@$since" --until="@$until") || return 1
  jq -rn --slurpfile i <(printf '%s\n' "$idx") --arg dir "$dir" --arg ref "$ref" --argjson days "$days" --argjson sample "$sample" \
     --argjson rd "$SO_REWORK_DAYS" --argjson vd "$SO_REWORK_VERIFY_DAYS" '
    def pct($a; $b): if $b == 0 then "-" else "\($a * 1000 / $b | round / 10)%" end;
    $i[0] as $i | [inputs] as $all | ($all | map(.at) | max // 0) as $last
    | ($all | map(select(.fix | not))) as $nf
    | ($nf | map(select(.at <= $last - $rd * 86400))) as $c | ($nf | map(select(.at <= $last - $vd * 86400))) as $v
    | ($c | map(select(any($i[.sha][]?; .days <= $rd))) | length) as $cn
    | ($v | map(select(any($i[.sha][]?; .named))) | length) as $vn
    | "rework in \($dir) (\($ref)), \($all | length) commits over \($days) days:",
      "  candidate: \($cn) of \($c | length) non-fix commits older than \($rd)d had a line rewritten by a fix within \($rd)d (\(pct($cn; $c | length)))",
      "  verified:  \($vn) of \($v | length) non-fix commits older than \($vd)d were rewritten by a fix within \($vd)d that names them (\(pct($vn; $v | length)))",
      if $sample > 0 then "  sample of the verified label (is each fix a fix of that change?):" else empty end
  ' <<<"$commits" || return 1
  [ "$sample" -gt 0 ] || return 0
  jq -rn --slurpfile i <(printf '%s\n' "$idx") '$i[0] as $i | inputs | select(.fix | not) | . as $n
      | $i[.sha][]? | select(.named) | "  - \($n.sha[0:10]) \($n.s) <- \(.fix[0:10]) \(.subject) (\(.days)d)"' <<<"$commits" |
    shuf -n "$sample"
}

# backfill-harness MONTH - rows written before the writer stamped a harness (#1125) get one by the
# rule `run` uses (HARNESS_DEF), in place in every project's MONTH file; nothing else on a row
# changes, and a file whose rows would differ in anything but harness is left alone. The file as it
# was stays beside it as .bak, for the reader to compare and delete; a .bak still there from an earlier
# backfill leaves that file alone. An unreadable queue changes nothing, as it would read a gateway
# session as claude. A file written while it runs (the nightly `run`) is left alone, to run again.
cmd_backfill_harness() {
  local month="${1:-}" work f n next rows=0 files=0
  [[ "$month" =~ ^[0-9]{4}-[0-9]{2}$ ]] || { echo "usage: $NAME backfill-harness YYYY-MM" >&2; return 2; }
  work="$(mktemp -d)" || return 1
  # shellcheck disable=SC2064
  trap "rm -rf '$work'" EXIT
  queue_index "$work/queue.json" || { echo "$NAME: the queue is unreadable; nothing backfilled" >&2; return 1; }
  for f in "$OUT"/*/"$month".jsonl; do
    [ -f "$f" ] || continue
    n=$(jq -s 'map(select(.harness == null)) | length' "$f") || { echo "$NAME: $f unreadable, skipped" >&2; continue; }
    [ "$n" -gt 0 ] || continue
    [ ! -e "$f.bak" ] || { echo "$NAME: $f.bak from an earlier backfill is still there; compare and delete it first. $f left alone" >&2; continue; }
    cp -p "$f" "$f.bak" || { echo "$NAME: no .bak for $f; left alone" >&2; continue; }
    next="$f.next"  # beside $f, so the mv below is a rename on one filesystem
    if ! { cp -p "$f.bak" "$next" &&
        jq -c --slurpfile q "$work/queue.json" --argjson hm "$(harness_map)" "$HARNESS_DEF"'
          if .harness == null then .harness = harness_of($q[0][.session_id // ""] // {}) else . end' "$f.bak" > "$next" &&
        [ "$(jq -cs 'map(del(.harness))' "$f.bak")" = "$(jq -cs 'map(del(.harness))' "$next")" ]; }; then
      rm -f "$next" "$f.bak"; echo "$NAME: $f would change beyond harness; left alone" >&2; continue
    fi
    cmp -s "$f" "$f.bak" || { rm -f "$next" "$f.bak"; echo "$NAME: $f was written during the backfill; left alone, run it again" >&2; continue; }
    mv "$next" "$f" || return 1
    rows=$((rows + n)); files=$((files + 1))
  done
  echo "$NAME: $rows row(s) in $files file(s) given a harness for $month"
}

case "${1:-run}" in
  run) shift || true; cmd_run "$@" ;;
  worst) shift; cmd_worst "$@" ;;
  card) shift; cmd_card "$@" ;;
  ended) shift; cmd_ended "$@" ;;
  costs) shift; cmd_costs "$@" ;;
  langfuse) shift; cmd_langfuse "$@" ;;
  backfill-harness) shift; cmd_backfill_harness "$@" ;;
  rework) shift; cmd_rework "$@" ;;
  lessons) shift; cmd_lessons "$@" ;;
  -h|--help) sed -n '2,40p' "$0" ;;
  *) echo "usage: $NAME [run [--all]] | worst [--by hook|skill] [--project P] [--days N] [-n N] [--json] | card <sid> [--json] | ended [--days N] | costs [--days N] | langfuse [--all] | backfill-harness YYYY-MM | rework DIR [--days N] [--until T] [--sample N] | lessons [--days N] [--json] [--cached]" >&2; exit 2 ;;
esac
