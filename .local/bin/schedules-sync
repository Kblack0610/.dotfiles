#!/usr/bin/env python3
"""schedules-sync - the one local writer of CI run facts: GitHub scheduled runs, and every run.

For each GitHub repo in the day-log-ci list (`<owner/name> <base> [clone]`, private overlay), it
records every workflow on the base branch that has an `on.schedule`: its crons, its
timeout (the longest `needs:` path of job timeouts, GitHub's 360 min where a job sets
none), its purpose (the comment block right above `on:`, else the file's first comment
block), its job graph, and its last SCHEDULES_RUNS scheduled runs (id, url, status,
conclusion, start, end, failed jobs). It also records the repo's night set, scripts/night.json
on the base (keys are workflow files: `night` the ones the nightly runs, `held` the ones it
holds back), as `night: {night, held, sha, etag}`, read through the contents API conditional on
its ETag and decoded only when its sha moves; a file that is not a JSON object keeps its sha
with `error` set. A repo without the file has `night_absent` (when it was found missing)
instead and is asked again a day later. It writes them to one file, SCHEDULES_STATE
(~/.local/state/schedules/state.json), which the agent-queue `nightly:` hold, fleet-sessions
and the hub Schedules and Pipelines views read instead of asking gh themselves.

Each pass also appends every run of every event, on GitHub and on the Forgejo repos the list
names as `forgejo:<host>/<owner/name> <base>`, to the run ledger SCHEDULES_RUNS_LEDGER
(~/.local/state/ci/runs.jsonl), one JSON row per run each time it changes: forge, repo, id,
attempt (the key), workflow, path, title, branch, event, sha, status, conclusion, created_at,
started_at, ended_at, queue_wait_s, url. A reader dedupes on the key and keeps the last
row; a torn last line is skipped. Rows whose run was created more than 30 days ago are pruned
by an atomic rewrite, which also drops superseded rows once they outnumber the live ones.
Forgejo has no attempt (always 1) and lists jobs, not runs: a run is its jobs grouped by run
number, failed when one failed. A finished run's end is the run's own `stopped`, read once per
run: a job's updated_at is no end, since Forgejo's midnight transfer_lingering_logs cron rewrites
it a day or more after the job stopped. A run whose waiting job Forgejo cancelled unrun (its
abandoned-job cron, a day on) has the conclusion `abandoned`, which no run time counts. Its
API is https://<host>/api/v1, the host named in the private list (never here), with the token
FORGEJO_TOKEN, else `rbw get forgejo_repo_admin`, sent in curl's stdin config, never argv; with
neither, a public repo still reads.

  schedules-sync          sync every repo, write the state file and the ledger, print the state path
  schedules-sync prs <repo|all> [--state open|merged|closed|all] [--since T] [--branch B] [--checks]
                          the PR store's PRs of one repo (owner/repo on GitHub, host/owner/repo
                          on Forgejo) or of every repo, a JSON array, newest number first, one
                          object per PR: forge, repo, number, branch, base, state (OPEN, MERGED,
                          CLOSED), draft, title, author, created_at, updated_at, closed_at,
                          merged_at (UTC), merge_sha, head_sha, url, links (the claude.ai/code
                          session ids its body names), revert (what it says it reverts, or null).
                          --since keeps PRs updated at or after T; --checks adds ci (NONE,
                          PENDING, FAIL, PASS) and red (failed job ids) on the head commit from
                          the run ledger and job archive. The one reader of the store:
                          fleet-sessions, session-outcomes, day-log, fleet-bench, project-timeline,
                          credit-backfill and git_open_prs read PRs here, never from gh pr list.
                          Exit 1 when a repo's PRs last synced over 30 minutes ago (with all,
                          the others still print and stderr names it), 3 when the list does not
                          sync the repo
  schedules-sync sync-prs <repo>...
                          refresh those repos' PR stores now: agent-land runs it after a merge, so
                          a reader never waits a pass to see it
  schedules-sync jobs <repo> [--run ID] [--since T]
                          the job archive's records of one GitHub repo, a JSON array in
                          created_at order, one object per run attempt: forge, repo, run_id,
                          attempt (the key), created_at, source (exporter or github), complete,
                          fetched_at, jobs (id, name, conclusion, runner_name, labels,
                          created_at, started_at, completed_at, url, steps). A run missing here,
                          or with complete false, has no full job detail yet. ci-cost.py and the
                          hub's run detail read jobs here, never from actions/jobs
  schedules-sync pending <repo> [--day YYYY-MM-DD]
                          what an agent-queue `nightly:<repo>` hold still waits for, one line;
                          exit 0 and no output when nothing is (repo: owner/name or name);
                          --day judges that local date's runs instead of today's
  schedules-sync runs <repo> [--branch B] [--since T] [--until T]
                          the ledger's runs of one repo (owner/name, or forgejo:owner/name),
                          as a JSON array in created_at order, one object per run: its newest
                          attempt's last row; --branch keeps one branch, --since/--until (ISO,
                          UTC) bound created_at. The one reader of the ledger: fleet-sessions,
                          fleet-bench and ci-failures read runs here, never from actions/runs.
                          Exit 1 when the repo's last sync is over 30 minutes old (a window
                          that closed before that sync is still complete) or --since is older
                          than the ledger's 30 days, 3 when the list does not sync the repo (a
                          caller tells "unknown" from "no runs"), 4 when a past --until is
                          after the last sync: that window is not yet complete, and the next
                          pass completes it

  schedules-sync run-tags <repo> <workflow path>...
                          backfill: for each finished dispatched run of those workflows whose name
                          carries no tag, read its log once and append the TAG: (or RUN_ID:, the
                          run a Steam upload ships) it names to SCHEDULES_RUN_TAGS
                          (run-tags.jsonl beside the ledger), which the hub's release graph joins;
                          the ledger is never rewritten. Exit 1 when a log could not be read

Each pass also refreshes the PR store, SCHEDULES_PRS_DIR (~/.agent/prs), one file per repo of the
list (a `prs-only:<owner/name> <base>` line is read for this alone: no runs, schedules or
quarantine), <owner>__<repo>.jsonl (Forgejo: <host>__<owner>__<repo>.jsonl), one JSON row per PR each time
it changes, kept forever and compacted like the ledger. It reads pulls?state=all newest update
first back to the last sync less an hour, the whole history on a cold start; GitHub's first page
is conditional on the ETag in the store's sync.json (a 304 when no PR changed), Forgejo's is one
page; a Forgejo pull mirror, whose PRs are off, is synced with none. A store's last sync and
error per repo are in that sync.json. No reader stores a PR fact of its own:
run -> PR is a join against this store, so the ledger's runs carry no PR list.

Job detail goes to the job archive SCHEDULES_JOBS_LEDGER (~/.local/state/ci/jobs.jsonl),
kept 90 days, deduped and pruned like the run ledger. For the repos the github-runner-exporter
collects (its feed names them; there is no second list here) it comes from the exporter's
changes feed, read through the API server's Service proxy with SCHEDULES_KUBECTL (kubectl):
the cursor, epoch, repos and last error are in sync.json's "exporter", and a new epoch reads the exporter's
24h window again. A feed that fails is recorded there and those repos wait; it is never
covered by asking GitHub. The feed's `runs` (each of its repos' runs each time its state moves)
go to the run ledger, and are those repos' only run source: a pass reads actions/runs only for
a GitHub repo the exporter does not collect (and for every one while no feed has ever named its
repos). Their scheduled runs for the state file are the feed's `event: schedule` runs, and their
freshness is the feed's: while it fails, each such repo keeps its last state with `error` set.
The feed agreed with the actions/runs poll row for row over 830 runs before the poll stopped
(2026-11-12). Job detail for every other GitHub repo, and for an exporter repo's runs older than its
window, is read per attempt from actions/runs/<id>/attempts/<n>/jobs, every page, newest run
first, at most SCHEDULES_JOB_CALLS (40) gh calls a pass for the last day's runs and
SCHEDULES_BACKFILL_CALLS (20) for older ones. A run's failed jobs come from here.

Each GitHub repo whose base carries scripts/test/quarantine.py and quarantine.txt gets a lane in
SCHEDULES_QUARANTINE (quarantine.json beside the ledger), which the hub's Tests Quarantine draws:
the base's own `quarantine.py report --json` (entries per owner row, end date, days left, as of
the local date), run from the two files read through the contents API (a conditional listing, a
304 when unchanged; blobs re-read only when a sha moves), and the newest finished `Tests (all)`
run on the base that uploaded playmode-summary: its KNOWN count (summary.txt's "N known red",
summed), the tests results.py says "known red now passes" (now_passing_tests) and the ones it
marks KNOWN, failed (known_tests), in the test-runs-* artifacts, downloaded once per run attempt;
a quarantined test in neither did not run. A repo without the files is listed under "absent" and asked
again a day later. A lane whose read fails keeps its last numbers with `error` set; a quarantine
failure never changes the exit status.

Deterministic, no model. schedules-sync.timer runs it every 10 minutes: GitHub sends this
machine no event when a run ends, so it samples.

gh cost per GitHub repo per pass: one workflows listing, one conditional night.json read (a
304 when unchanged; none for a day once it is missing), for a repo the exporter does not
collect, one conditional runs page (a 304, which costs no rate limit, when nothing on it
changed; more pages only on a cold start or after a gap), one blob per changed workflow file, and the job calls above. The scheduled runs are the runs page's `event: schedule` rows, so there is no second
listing. The ETag, the last sync and the last error per repo are in ci/sync.json beside the
ledger. The previous state is the cache: a workflow whose blob sha is unchanged is not
re-read, a finished run's failed jobs are not re-asked. Runs come from actions/runs, not
`gh run list`, which looks workflows up under actions/workflows, the bucket used up on
2026-10-29 (fleet-sessions main_runs). A re-run of a run older than the first page leaves
that page unchanged, so it is read when the page next changes.

A repo gh cannot read keeps its last good entry, with `error` set and `synced_at` left at
the last success, so a reader can tell stale from fresh per repo; the exit status is 1, and
the other repos still land. A repo with no scheduled workflow is an empty list, not an error.

`pending` reads the state file and nothing else. Each scheduled workflow's cron slots on
one local date (--day, else today) must each have a finished run, or be past the slot (or
the run's start) plus the workflow's timeout, which a triage reads as red. A slot still to
come that day holds. agent-queue passes the date of the item's `at:` tag, so a night that
finished stays released: judged by today, a 22:00 slot (soak.yml) left a hold free only
until midnight, when every slot of the new day held again (nightly-validate-20261108).
A missing file, a repo not in it, or one not synced in 30 minutes holds (fails
closed, like the `pr:` hold when gh cannot answer). A frequent cron holds all day, so tag
only repos whose schedules run nightly.
"""

import base64
import fcntl
import io
import json
import os
import re
import subprocess
import sys
import zipfile
from datetime import datetime, timedelta, timezone

import yaml

HOME = os.path.expanduser("~")
GH = os.environ.get("SCHEDULES_GH", "gh")
REPOS = os.environ.get("SCHEDULES_REPOS", os.path.join(HOME, ".config/agentctl/day-log-ci"))
STATE = os.environ.get(
    "SCHEDULES_STATE",
    os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state"), "schedules/state.json"),
)
LEDGER = os.environ.get(
    "SCHEDULES_RUNS_LEDGER",
    os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state"), "ci/runs.jsonl"),
)
SYNC = os.path.join(os.path.dirname(LEDGER), "sync.json")
JOBS_LEDGER = os.environ.get("SCHEDULES_JOBS_LEDGER", os.path.join(os.path.dirname(LEDGER), "jobs.jsonl"))
# The tag (or uploaded run) each dispatched release run's log names, for runs whose name does not
# carry it; the hub's release graph reads it beside the ledger (hub_core::release_graph).
RUN_TAGS = os.environ.get("SCHEDULES_RUN_TAGS", os.path.join(os.path.dirname(LEDGER), "run-tags.jsonl"))
# A step's env (TAG, RUN_ID) or a reusable workflow's input (tag), as the log echoes them.
LOG_NAMES = re.compile(rb"^\S+Z\s+(TAG|tag|RUN_ID): (\S+)\s*$", re.M)
JOBS_KEEP = timedelta(days=90)  # the job archive's window
KUBECTL = os.environ.get("SCHEDULES_KUBECTL", "kubectl")
QUARANTINE = os.environ.get("SCHEDULES_QUARANTINE", os.path.join(os.path.dirname(LEDGER), "quarantine.json"))
# The repo's own quarantine reader and list; a repo whose base has the script has a lane.
QUARANTINE_DIR = "scripts/test"
QUARANTINE_FILES = ("quarantine.py", "quarantine.txt")
QUARANTINE_RECHECK = timedelta(days=1)  # how often a repo with no quarantine is asked again
NIGHT_FILE = "scripts/night.json"  # the repo's night set: which workflows the nightly runs or holds
# The nightly: the full run's title (playground scripts/test/last-nightly.py TITLES), its joined
# summary, uploaded only when every shard reported (test.yml playmode-report), and each job's
# suite output, where results.py names a quarantined test that passed.
NIGHT_TITLE = "Tests (all)"
NIGHT_SUMMARY = "playmode-summary"
NIGHT_LOGS = "test-runs-"
NIGHT_LOOKS = 5  # finished nightlies a pass asks for artifacts, newest first
KNOWN_RED = re.compile(r"\b(\d+) known red\b")
NOW_PASSES = re.compile(r"^==> known red now passes, take it off \S+: (.+)$", re.M)
KNOWN_FAILS = re.compile(r"^\s+KNOWN\s+(.+) \(\d+(?:\.\d+)?s\)$", re.M)  # results.py's line for a known red that failed
# The exporter's changes feed, through the API server's Service proxy: no ingress, and the
# kubeconfig this machine already has is the credential.
FEED = "/api/v1/namespaces/monitoring/services/github-runner-exporter:9320/proxy/api/ci/details"
FEED_LIMIT = 100
FEED_PAGES = 50  # a cold 24h window is ~1,500 runs; this bounds one pass at 5,000
# gh calls a pass may spend on job detail it reads itself, newest run first; the rest waits for
# the next pass. Live is the last day of repos outside the exporter's; backfill is older runs of
# any repo, apart so a cold 30-day ledger never starves a live run.
JOB_CALLS = int(os.environ.get("SCHEDULES_JOB_CALLS", "40"))
BACKFILL_CALLS = int(os.environ.get("SCHEDULES_BACKFILL_CALLS", "20"))
JOB_KEYS = ("id", "name", "conclusion", "runner_name", "labels", "created_at", "started_at", "completed_at")
STEP_KEYS = ("number", "name", "conclusion", "started_at", "completed_at")
CURL = os.environ.get("SCHEDULES_CURL", "curl")
RBW = os.environ.get("SCHEDULES_RBW", "rbw")
FORGEJO_ENTRY = os.environ.get("SCHEDULES_FORGEJO_ENTRY", "forgejo_repo_admin")
FJ_PAGE = 50  # Forgejo's MAX_RESPONSE_ITEMS caps every list page at 50
FJ_DONE = ("success", "failure", "cancelled", "skipped")
KEEP = timedelta(days=30)  # the ledger's window, and how far back a cold pass reads
RUNS_KEPT = int(os.environ.get("SCHEDULES_RUNS", "14"))
PER_PAGE = int(os.environ.get("SCHEDULES_PER_PAGE", "100"))
MAX_PAGES = int(os.environ.get("SCHEDULES_MAX_PAGES", "20"))  # a cold start of a busy repo
GH_JOB_TIMEOUT_MIN = 360  # GitHub's default timeout-minutes for a job that sets none
OVERLAP = timedelta(hours=1)  # re-read this far behind the last sync
FAILED = ("failure", "timed_out")
GH_CALL_TIMEOUT_S = 60  # a guard: one hung call must not eat the whole pass
STALE = timedelta(minutes=30)  # three missed 10-minute passes
RUN_OPTS = {"--branch", "--since", "--until"}
CRON_NAMES = {n: i for i, n in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
CRON_NAMES.update({n: i + 1 for i, n in enumerate(
    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"])})


class GhError(Exception):
    """str() is the short cause sync.json keeps; `detail` is the raw text the journal gets."""

    def __init__(self, msg, detail=None):
        super().__init__(msg)
        self.detail = detail or msg


def now():
    s = os.environ.get("SCHEDULES_NOW")
    return datetime.fromtimestamp(int(s), timezone.utc) if s else datetime.now(timezone.utc)


def iso(t):
    return t.strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_iso(s):
    return datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)


def when(s):
    """An API timestamp as an aware datetime, or None (Forgejo writes year 1 for never)."""
    try:
        t = datetime.fromisoformat(s.replace("Z", "+00:00"))
    except (AttributeError, TypeError, ValueError):
        return None
    return t if t.year > 2000 else None


def wait_s(a, b):
    ta, tb = when(a), when(b)
    return int((tb - ta).total_seconds()) if ta and tb else None


def gh_fail(path, text):
    """A failed gh call as a GhError: one short cause, the same on every repo it hits, so the
    dashboards fold them into one line; the raw text and the path go to the journal."""
    raw = text.strip()
    low = raw.lower()
    try:
        first = str(json.loads(raw).get("message") or "")
    except (ValueError, AttributeError):
        first = next((ln.strip() for ln in raw.splitlines() if ln.strip()), "")
    if "rate limit" in low and "exceeded" in low:
        why = "GitHub API rate limit hit"
    elif "http 401" in low or "bad credentials" in low or "gh auth login" in low:
        why = "gh is not logged in: run gh auth login"
    else:
        why = first.removeprefix("gh: ").split(". If you reach out")[0][:160] or "gh failed with no output"
    return GhError(why, f"gh api {path}: {raw}")


def gh_run(path, text=True):
    try:
        return subprocess.run([GH, "api", path], capture_output=True, text=text, timeout=GH_CALL_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        raise GhError(f"gh api {path}: no answer in {GH_CALL_TIMEOUT_S}s")


def gh(path, missing=None):
    """gh api <path> as JSON. A 404 returns `missing` when one is given, else it is an error."""
    p = gh_run(path)
    try:
        body = json.loads(p.stdout)
    except ValueError:
        body = None
    if p.returncode == 0 and body is not None:
        return body
    if missing is not None and isinstance(body, dict) and str(body.get("status")) == "404":
        return missing
    raise gh_fail(path, p.stderr or p.stdout)


def gh_page(path, etag=None, missing=None):
    """gh api -i <path>, conditional on `etag` -> (body, etag); body is None on a 304. A 404
    returns (`missing`, None) when one is given, else it is an error."""
    cmd = [GH, "api", "-i"] + (["-H", f"If-None-Match: {etag}"] if etag else []) + [path]
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=GH_CALL_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        raise GhError(f"gh api {path}: no answer in {GH_CALL_TIMEOUT_S}s")
    head, _, raw = p.stdout.replace("\r\n", "\n").partition("\n\n")
    status = head.split("\n", 1)[0].split()
    if len(status) > 1 and status[1] == "304":
        return None, etag  # gh exits 1 on it, but it is the answer asked for
    tag = next((h.split(":", 1)[1].strip() for h in head.split("\n") if h.lower().startswith("etag:")), None)
    try:
        body = json.loads(raw)
    except ValueError:
        body = None
    if p.returncode == 0 and body is not None:
        return body, tag
    if missing is not None and isinstance(body, dict) and str(body.get("status")) == "404":
        return missing, None
    raise gh_fail(path, p.stderr or raw)


def gh_bytes(path):
    """gh api <path>'s raw body: an artifact's zip."""
    p = gh_run(path, text=False)
    if p.returncode:
        raise gh_fail(path, (p.stderr or p.stdout).decode("utf-8", "replace"))
    return p.stdout


def blob_bytes(repo, sha):
    return base64.b64decode(gh(f"repos/{repo}/git/blobs/{sha}").get("content", ""))


FJ_TOKEN = []


def fj_token():
    """FORGEJO_TOKEN, else the rbw entry, read once per pass; "" when neither answers."""
    if not FJ_TOKEN:
        tok = os.environ.get("FORGEJO_TOKEN", "")
        if not tok:
            try:
                tok = subprocess.run([RBW, "get", FORGEJO_ENTRY], capture_output=True, text=True,
                                     timeout=GH_CALL_TIMEOUT_S).stdout.strip()
            except (OSError, subprocess.TimeoutExpired):
                tok = ""
        FJ_TOKEN.append(tok)
    return FJ_TOKEN[0]


def fj(host, path):
    """GET https://<host>/api/v1/<path> as JSON; the token goes in on curl's stdin, never argv."""
    tok = fj_token()
    conf = f'header = "Authorization: token {tok}"\n' if tok else ""
    try:
        p = subprocess.run([CURL, "-sSf", "-K", "-", "--max-time", "30", f"https://{host}/api/v1/{path}"],
                           input=conf, capture_output=True, text=True, timeout=GH_CALL_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        raise GhError(f"forgejo {path}: no answer in {GH_CALL_TIMEOUT_S}s")
    if p.returncode == 0:
        try:
            return json.loads(p.stdout)
        except ValueError:
            pass
    why = (p.stderr or p.stdout).strip()[:200]
    raise GhError(f"forgejo {path}: {why}" + ("" if tok else f" (no token: FORGEJO_TOKEN unset, rbw {FORGEJO_ENTRY} unread)"))


def read_repos():
    """-> [(forge, owner/name, base, host)]: `forgejo:<host>/<owner/name>` is a Forgejo repo,
    a bare (or `github:`) name a GitHub one, whose host is None, and `prs-only:<owner/name>` a
    GitHub repo only the PR store reads (a work or client repo whose CI day-log leaves out)."""
    out = []
    with open(REPOS) as f:
        for line in f:
            line = line.split("#", 1)[0].split()
            if len(line) >= 2:
                forge, _, name = line[0].rpartition(":")
                host = None
                if forge == "forgejo":
                    host, _, name = name.partition("/")
                out.append((forge or "github", name, line[1], host))
    ci = {r.lower() for f, r, _, _ in out if f == "github"}
    return [e for e in out if not (e[0] == PRS_ONLY and e[1].lower() in ci)]  # a CI line reads its PRs already


def has_prs(forge, repo):
    """Whether a list line has a PR store: a Forgejo line needs its owner/name."""
    return forge in ("github", PRS_ONLY) or (forge == "forgejo" and "/" in repo)


def read_prev():
    try:
        with open(STATE) as f:
            return {r["repo"]: r for r in json.load(f).get("repos", [])}
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return {}


def purpose_of(text):
    """The comment block right above top-level `on:`, else the file's first comment block."""
    blocks, cur = [], []
    above_on = None
    for line in text.splitlines():
        if line.startswith("#"):
            cur.append(line.lstrip("#").strip())
            continue
        if cur:
            blocks.append(cur)
        if line.startswith(("on:", '"on":', "'on':")) and cur:
            above_on = cur
        cur = []
        if line.startswith("jobs:"):
            break
    chosen = above_on or (blocks[0] if blocks else None)
    if not chosen:
        return None
    return " ".join(w for w in chosen if w) or None


def job_timeout(job):
    t = job.get("timeout-minutes")
    return t if isinstance(t, (int, float)) and not isinstance(t, bool) else GH_JOB_TIMEOUT_MIN


def needs_of(job):
    n = job.get("needs") or []
    return [n] if isinstance(n, str) else [x for x in n if isinstance(x, str)]


def parse_workflow(text):
    """-> (name, crons, jobs, timeout_min) or None when the file has no schedule."""
    doc = yaml.safe_load(text)
    if not isinstance(doc, dict):
        return None
    on = doc.get("on", doc.get(True))  # YAML 1.1 reads a bare `on` key as true
    sched = on.get("schedule") if isinstance(on, dict) else None
    crons = [s["cron"] for s in sched or [] if isinstance(s, dict) and isinstance(s.get("cron"), str)]
    if not crons:
        return None
    raw = doc.get("jobs") if isinstance(doc.get("jobs"), dict) else {}
    jobs = [
        {"id": k, "name": v.get("name", k) if isinstance(v, dict) else k,
         "needs": needs_of(v) if isinstance(v, dict) else [],
         "timeout_min": job_timeout(v) if isinstance(v, dict) else GH_JOB_TIMEOUT_MIN}
        for k, v in raw.items()
    ]
    by_id = {j["id"]: j for j in jobs}
    memo = {}

    def path_end(jid, seen=()):
        if jid in memo:
            return memo[jid]
        if jid not in by_id or jid in seen:
            return 0
        j = by_id[jid]
        memo[jid] = j["timeout_min"] + max((path_end(n, seen + (jid,)) for n in j["needs"]), default=0)
        return memo[jid]

    timeout = max((path_end(j["id"]) for j in jobs), default=0)
    return str(doc.get("name") or ""), crons, jobs, timeout


def scheduled_workflows(repo, base, prev):
    """-> (scheduled workflows, {path: sha} of the unscheduled ones). A file whose blob sha
    the last pass already read, scheduled or not, is not read again."""
    known = {w["path"]: w for w in prev.get("workflows", [])} if prev else {}
    seen = (prev or {}).get("unscheduled") or {}
    listing = gh(f"repos/{repo}/contents/.github/workflows?ref={base}", missing=[])
    out, unscheduled = [], {}
    for f in listing if isinstance(listing, list) else []:
        if f.get("type") != "file" or not f.get("name", "").endswith((".yml", ".yaml")):
            continue
        path, sha = f["path"], f["sha"]
        old = known.get(path)
        if old and old.get("sha") == sha:
            out.append({k: v for k, v in old.items() if k != "runs"})
            continue
        if seen.get(path) == sha:
            unscheduled[path] = sha
            continue
        text = blob_bytes(repo, sha).decode("utf-8", "replace")
        try:
            parsed = parse_workflow(text)
        except yaml.YAMLError:
            parsed = None  # GitHub would not schedule an unparseable file either
        if not parsed:
            unscheduled[path] = sha
            continue
        name, crons, jobs, timeout = parsed
        out.append({"path": path, "sha": sha, "name": name or f["name"], "crons": crons,
                    "timeout_min": timeout, "purpose": purpose_of(text), "jobs": jobs})
    return sorted(out, key=lambda w: w["path"]), unscheduled


def run_record(r):
    done = r.get("status") == "completed"
    return {"id": r["id"], "attempt": r.get("run_attempt", 1), "url": r.get("html_url"),
            "title": r.get("name"), "sha": r.get("head_sha"), "created_at": r.get("created_at"),
            "status": r.get("status"), "conclusion": r.get("conclusion") if done else None,
            "started_at": r.get("run_started_at"), "ended_at": r.get("updated_at") if done else None}


def window(entry, open_since, t):
    """How far back a pass reads: the last sync less OVERLAP, or the oldest run still open
    then, never past KEEP; a repo never synced reads all of KEEP."""
    floor = t - KEEP
    stop = parse_iso(entry["synced_at"]) - OVERLAP if entry.get("synced_at") else floor
    if open_since:
        stop = min(stop, open_since)
    return max(stop, floor)


def fetch_runs(repo, entry, open_since, t):
    """Every GitHub run, newest first, paged back to window(), or MAX_PAGES on a cold start.
    -> (runs, etag); runs is None when the first page is unchanged (a 304)."""
    stop, runs, etag = window(entry, open_since, t), [], None
    for page in range(1, MAX_PAGES + 1):
        path = f"repos/{repo}/actions/runs?per_page={PER_PAGE}&page={page}"
        if page == 1:
            got, etag = gh_page(path, entry.get("etag"))
            if got is None:
                return None, etag
        else:
            got = gh(path)
        batch = got.get("workflow_runs", []) if isinstance(got, dict) else []
        runs.extend(batch)
        if len(batch) < PER_PAGE:
            break
        oldest = when(batch[-1].get("created_at"))
        if oldest and oldest < stop:
            break
    return runs, etag


def gh_row(repo, r):
    done = r.get("status") == "completed"
    return {"forge": "github", "repo": repo, "id": r["id"], "attempt": r.get("run_attempt", 1),
            "workflow": r.get("name"), "path": r.get("path"), "title": r.get("display_title"),
            "branch": r.get("head_branch"), "event": r.get("event"), "sha": r.get("head_sha"),
            "status": r.get("status"), "conclusion": r.get("conclusion") if done else None,
            "created_at": r.get("created_at"), "started_at": r.get("run_started_at"),
            "ended_at": r.get("updated_at") if done else None,
            "queue_wait_s": wait_s(r.get("created_at"), r.get("run_started_at")),
            "url": r.get("html_url")}


def fj_run(host, repo, n):
    """Forgejo run <n> itself (its status and stopped), or {} when the API has none."""
    got = fj(host, f"repos/{repo}/actions/runs?run_number={n}")
    runs = got.get("workflow_runs") or [] if isinstance(got, dict) else []
    return next((r for r in runs if r.get("index_in_repo") == n), {})


def fj_close(host, repo, n, st, had):
    """-> (done, conclusion, end) of Forgejo run <n>, whose tasks all finished with statuses st:
    the ledger's (had) once it recorded an end, else the run's own. A run not finished by its own
    status still has a job waiting for a runner; one it cancelled with no task cancelled is
    `abandoned`, a job cancelled before any runner took it."""
    conclusion = next((c for c in ("failure", "cancelled", "success") if c in st), "skipped")
    if had.get("status") == "completed" and had.get("ended_at"):
        return True, had.get("conclusion") or conclusion, had["ended_at"]
    run = fj_run(host, repo, n)
    if run and run.get("status") not in FJ_DONE:
        return False, None, None
    if run.get("status") == "cancelled" and "cancelled" not in st:
        conclusion = "abandoned"
    return True, conclusion, run.get("stopped") if when(run.get("stopped")) else None


def forgejo_rows(host, repo, entry, open_since, t, last):
    """Every Forgejo run back to window(), one row per run from its jobs (actions/tasks lists
    jobs, newest first). When paging stops before the list ends, the oldest run seen may be
    cut by the page edge, so it is left out; a pass that saw it whole wrote its row. A finished
    run's end and conclusion are fj_close()'s: a job's updated_at moves when Forgejo's midnight
    log transfer rewrites the job, a day or more after it stopped, and a job no runner took never
    becomes a task, so only the run itself says whether it finished."""
    stop, tasks, whole = window(entry, open_since, t), [], False
    for page in range(1, MAX_PAGES + 1):
        got = fj(host, f"repos/{repo}/actions/tasks?limit={FJ_PAGE}&page={page}")
        batch = got.get("workflow_runs") or [] if isinstance(got, dict) else []
        tasks.extend(batch)
        if len(batch) < FJ_PAGE:
            whole = True
            break
        oldest = when(batch[-1].get("created_at"))
        if oldest and oldest < stop:
            break
    cut = None if whole or not tasks else tasks[-1].get("run_number")
    runs = {}
    for k in tasks:
        if k.get("run_number") is not None and k["run_number"] != cut:
            runs.setdefault(k["run_number"], []).append(k)
    rows = []
    for n, jobs in runs.items():
        st = [j.get("status") for j in jobs]
        done, conclusion, ended = all(x in FJ_DONE for x in st), None, None
        if done:
            done, conclusion, ended = fj_close(host, repo, n, st, last.get(("forgejo", repo, n, 1)) or {})
        created = min((j.get("created_at") for j in jobs if when(j.get("created_at"))), default=None)
        started = min((j.get("run_started_at") for j in jobs if when(j.get("run_started_at"))), default=None)
        j = jobs[0]
        rows.append({"forge": "forgejo", "repo": repo, "id": n, "attempt": 1,
                     "workflow": j.get("workflow_id"), "path": j.get("workflow_id"), "title": j.get("display_title"),
                     "branch": j.get("head_branch"), "event": j.get("event"), "sha": j.get("head_sha"),
                     "status": "completed" if done else ("in_progress" if "running" in st else "queued"),
                     "conclusion": conclusion, "created_at": created, "started_at": started, "ended_at": ended,
                     "queue_wait_s": wait_s(created, started), "url": j.get("url")})
    return rows


# ---- the PR store: one file per repo, one row per PR each time it changes ----

PRS_DIR = os.environ.get("SCHEDULES_PRS_DIR", os.path.join(HOME, ".agent/prs"))
PRS_ONLY = "prs-only"  # a day-log-ci line's prefix: the PR store reads the repo, nothing else does
PRS_SYNC = os.path.join(PRS_DIR, "sync.json")
PR_PAGES = int(os.environ.get("SCHEDULES_PR_PAGES", "100"))  # a cold read of a repo's whole PR history
PR_STATES = ("open", "merged", "closed", "all")
PR_OPTS = {"--state", "--since", "--branch"}
RED = FAILED + ("cancelled", "action_required", "startup_failure")  # pr-ci.sh's red_re
# so_pr_index's revert word: "revert-safe" is not one, and "reverted in #N" names the reverter.
REVERT_RE = r"(?i)\brevert(s|ed|ing)?(?![-\w])(?!\s+(in|by)\b)"


def pr_key(r):
    return r["number"]


def pr_name(forge, repo, host):
    """The store's name of a repo: owner/repo on GitHub, host/owner/repo on Forgejo."""
    return f"{host}/{repo}" if forge == "forgejo" else repo


def pr_file(name):
    return os.path.join(PRS_DIR, name.replace("/", "__") + ".jsonl")


def utc(s):
    t = when(s)
    return iso(t.astimezone(timezone.utc)) if t else None


def revert_of(title, body):
    """What a PR's title and body say it reverts, parsed once here for so_pr_index: {title (the
    `Revert "<title>"` button's), prs (each `#N` after a revert word on its line), shas ("This
    reverts commit <sha>")}, or None when no revert word appears."""
    text = f"{title or ''}\n{body or ''}"
    if not re.search(REVERT_RE, text):
        return None
    m = re.match(r'^Revert "(.*)"$', title or "")
    refs = []
    for line in text.split("\n"):
        hit = re.search(REVERT_RE + r"(?P<rest>.*)", line)
        if hit:
            refs += [int(n) for n in re.findall(r"#([0-9]+)\b", hit.group("rest"))]
    return {"title": m.group(1) if m else None, "prs": refs,
            "shas": re.findall(r"(?i)this reverts commit ([0-9a-f]{7,40})", text)}


def pr_row(forge, name, p, branch, merged):
    body = p.get("body") or ""
    head, base, user = p.get("head") or {}, p.get("base") or {}, p.get("user") or {}
    return {"forge": forge, "repo": name, "number": p["number"], "branch": branch, "base": base.get("ref"),
            "state": "MERGED" if merged else ("OPEN" if p.get("state") == "open" else "CLOSED"),
            "draft": bool(p.get("draft")), "title": p.get("title"), "author": user.get("login"),
            "created_at": utc(p.get("created_at")), "updated_at": utc(p.get("updated_at")),
            "closed_at": utc(p.get("closed_at")), "merged_at": utc(p.get("merged_at")) if merged else None,
            "merge_sha": p.get("merge_commit_sha") if merged else None, "head_sha": head.get("sha"),
            "url": p.get("html_url"),
            "links": sorted(set(re.findall(r"claude\.ai/code/(session_[A-Za-z0-9]+)", body))),
            "revert": revert_of(p.get("title"), body)}


def gh_pr_row(repo, p):
    return pr_row("github", repo, p, (p.get("head") or {}).get("ref"), bool(p.get("merged_at")))


def fj_pr_row(name, p, had):
    """Forgejo's head.ref reads refs/pull/N/head once the branch is deleted: the branch the store
    already had stays."""
    ref = (p.get("head") or {}).get("ref") or ""
    branch = (had or {}).get("branch") if ref.startswith("refs/") else ref
    return pr_row("forgejo", name, p, branch, bool(p.get("merged")))


def fj_pulls_off(host, repo):
    """Whether the Forgejo repo has its PR unit off (a pull mirror, most often), which makes its
    pulls list a 404: such a repo has no PRs."""
    try:
        got = fj(host, f"repos/{repo}")
    except GhError:
        return False
    return isinstance(got, dict) and got.get("has_pull_requests") is False


def fetch_prs(forge, repo, host, entry):
    """Every PR updated since the last sync less OVERLAP, newest update first; a repo never synced
    reads its whole history (PR_PAGES pages). GitHub's first page is conditional on the ETag.
    -> (PRs, etag); PRs is None when that page is unchanged (a 304)."""
    stop = parse_iso(entry["synced_at"]) - OVERLAP if entry.get("synced_at") else None
    out, etag = [], None
    for page in range(1, PR_PAGES + 1):
        if forge == "forgejo":
            try:
                got = fj(host, f"repos/{repo}/pulls?state=all&sort=recentupdate&limit={FJ_PAGE}&page={page}")
            except GhError as e:
                if page == 1 and "error: 404" in e.detail and fj_pulls_off(host, repo):
                    return [], None  # PRs off: a pull mirror's PRs are on the forge it mirrors
                raise
            size = FJ_PAGE
        else:
            path = f"repos/{repo}/pulls?state=all&sort=updated&direction=desc&per_page={PER_PAGE}&page={page}"
            size = PER_PAGE
            if page == 1:
                got, etag = gh_page(path, entry.get("etag"))
                if got is None:
                    return None, etag
            else:
                got = gh(path)
        batch = got if isinstance(got, list) else []
        out.extend(batch)
        if len(batch) < size:
            break
        oldest = when(batch[-1].get("updated_at"))
        if stop and oldest and oldest < stop:
            break
    return out, etag


def sync_prs(forge, repo, host, t, wait=True):
    """Refresh one repo's PR store and its entry in the store's sync.json, under the store's lock
    (a pass and agent-land's `sync-prs` may run at once). -> the error, or None. With wait False a
    held lock is that error at once: agent-land never stalls behind a pass's cold read."""
    name = pr_name(forge, repo, host)
    os.makedirs(PRS_DIR, exist_ok=True)
    with open(os.path.join(PRS_DIR, ".lock"), "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
        except BlockingIOError:
            return f"{name}: a pass holds the PR store"
        state = read_sync(path=PRS_SYNC)
        last, n, torn = read_ledger(path=pr_file(name), key=pr_key)
        entry = dict(state.get(name) or {}) if last is not None else {}  # no store: read it all again
        last, err = last or {}, None
        try:
            got, etag = fetch_prs(forge, repo, host, entry)
            if forge == "forgejo":
                rows = [fj_pr_row(name, p, last.get(p.get("number"))) for p in got or [] if "number" in p]
            else:
                rows = [gh_pr_row(repo, p) for p in got or [] if "number" in p]
            write_ledger(last, n, torn, rows, t, pr_file(name), pr_key, None)
            entry.update(etag=etag, synced_at=iso(t), error=None)  # the ETag only once its rows are kept
        except GhError as e:
            print(f"schedules-sync: PRs of {name}: {e.detail}", file=sys.stderr)
            entry["error"] = err = str(e)
        state[name] = entry
        write_json(PRS_SYNC, {"generated_at": iso(t), "repos": state})
    return err


def pr_checks(forge, repo, rows):
    """Each PR's CI on its head commit, from the run ledger: `ci` NONE, PENDING, FAIL or PASS (the
    newest run of each workflow file, a workflow_dispatch run aside: a PR's checks never hold one,
    fleet-sessions' gate_ci folds those in), and `red`, the failed runs' failed job ids from the job
    archive, comma-separated, `-` for a run the archive has no jobs of yet."""
    shas = {r.get("head_sha") for r in rows} - {None}
    last, _, _ = read_ledger(f'"repo":"{repo.lower()}"')
    newest = newest_attempts((r for r in (last or {}).values()
                              if r["forge"] == forge and r["repo"].lower() == repo.lower() and r.get("sha") in shas
                              and r.get("event") != "workflow_dispatch"), key=lambda r: (r["sha"], r["id"]))
    by_wf = {}  # sha -> workflow file -> its newest run
    for r in sorted(newest.values(), key=lambda r: (r.get("created_at") or "", r["id"])):
        by_wf.setdefault(r["sha"], {})[r.get("path") or r.get("workflow")] = r
    jobs = None
    for p in rows:
        runs = list(by_wf.get(p.get("head_sha"), {}).values())
        failed = [r for r in runs if r.get("status") == "completed" and r.get("conclusion") in RED]
        p["ci"] = ("NONE" if not runs else "PENDING" if any(r.get("status") != "completed" for r in runs)
                   else "FAIL" if failed else "PASS")
        ids = []
        if p["ci"] == "FAIL":
            if jobs is None:
                jobs = read_ledger(f'"repo":"{repo.lower()}"', JOBS_LEDGER, job_key)[0] or {}
            for r in failed:
                rec = jobs.get((forge, repo.lower(), r["id"], r.get("attempt") or 1))
                ids += [str(j["id"]) for j in (rec or {}).get("jobs") or [] if j.get("conclusion") in RED] if rec else ["-"]
        p["red"] = ",".join(ids) or "-"


def prs(argv, t):
    """`prs <repo|all> [--state S] [--since T] [--branch B] [--checks]` -> (exit code, JSON, reason). With
    all, a stale repo is named in the reason (exit 1) and the rest still print, so one broken repo never
    hides every other."""
    checks = "--checks" in argv
    argv = [a for a in argv if a != "--checks"]
    usage = "prs <owner/repo|host/owner/repo|all> [--state open|merged|closed|all] [--since T] [--branch B] [--checks]"
    if not argv or argv[0].startswith("-") or len(argv) % 2 != 1:
        return 2, "", usage
    opts = dict(zip(argv[1::2], argv[2::2]))
    if set(opts) - PR_OPTS or len(opts) * 2 != len(argv) - 1 or any(v.startswith("--") for v in opts.values()):
        return 2, "", usage
    state = opts.get("--state", "all").lower()
    if state not in PR_STATES:
        return 2, "", usage
    try:
        since = parse_iso(opts["--since"]) if "--since" in opts else None
    except ValueError:
        return 2, "", "prs: --since is YYYY-MM-DDTHH:MM:SSZ"
    synced = read_sync(path=PRS_SYNC)
    want = argv[0].lower()
    if want == "all":
        try:  # a repo dropped from the list is no longer read, so it never reads as stale
            listed = {pr_name(f, r, h).lower() for f, r, _, h in read_repos() if has_prs(f, r)}
        except OSError:
            listed = None
        names = sorted(k for k in synced if listed is None or k.lower() in listed)
    else:
        names = [k for k in synced if k.lower() == want]
    if not names:
        return 3, "", f"{argv[0]} is not in the PR store ({REPOS})"
    out, stale = [], []
    for name in names:
        entry, at = synced[name], when(synced[name].get("synced_at"))
        last = None
        if at and at >= t - STALE:
            last, _, _ = read_ledger(path=pr_file(name), key=pr_key)
        if last is None:
            stale.append(stale_why(f"{name}: PRs", entry) if not at or at < t - STALE
                         else f"{name}: no PR store at {pr_file(name)}")
            continue
        rows = [r for r in last.values()
                if (state == "all" or r.get("state") == state.upper())
                and ("--branch" not in opts or r.get("branch") == opts["--branch"])
                and not (since and (when(r.get("updated_at")) or since) < since)]
        rows.sort(key=lambda r: -r["number"])
        if checks and rows:
            forge = rows[0]["forge"]
            pr_checks(forge, name.split("/", 1)[1] if forge == "forgejo" else name, rows)
        out += rows
    if stale and want != "all":
        return 1, "", stale[0]
    return (1 if stale else 0), json.dumps(out, separators=(",", ":")), "\n".join(stale)


def sync_prs_cmd(argv, t):
    """`sync-prs <repo>...`: refresh those repos' PR stores now (agent-land, after a merge)."""
    if not argv:
        return 2, "sync-prs <owner/repo|host/owner/repo>..."
    try:
        listed = {pr_name(f, r, h).lower(): ("github" if f == PRS_ONLY else f, r, h)
                  for f, r, _, h in read_repos() if has_prs(f, r)}
    except OSError as e:
        return 1, f"no repo list: {e}"
    missing = [a for a in argv if a.lower() not in listed]
    if missing:
        return 3, f"{', '.join(missing)} not in the repo list ({REPOS})"
    errs = [e for e in (sync_prs(*listed[a.lower()], t, wait=False) for a in argv) if e]
    return (1, "; ".join(errs)) if errs else (0, "")


def run_key(r):
    return (r["forge"], r["repo"], r["id"], r["attempt"])


def job_key(r):
    return (r["forge"], r["repo"].lower(), r["run_id"], r["attempt"])  # GitHub names are case-blind


def read_ledger(repo=None, path=None, key=run_key):
    """-> ({key: last row}, rows read, whether the file ends mid-line); None for no ledger. With
    <repo> (owner/name) only lines naming it are parsed: a reader of one repo skips the rest.
    The run ledger by default; the job archive with path=JOBS_LEDGER, key=job_key."""
    try:
        f = open(path or LEDGER)
    except OSError:
        return None, 0, False
    last, n, line = {}, 0, ""
    with f:
        for line in f:
            if repo and repo not in line.lower():
                continue
            try:
                r = json.loads(line)
                last[key(r)] = r
                n += 1
            except (ValueError, KeyError, TypeError):
                continue  # a torn last line, or not a row
    return last, n, bool(line) and not line.endswith("\n")


def write_ledger(last, n, torn, rows, t, path=None, key=run_key, keep=KEEP):
    """Append the rows that changed since their key's last row. Rewrite instead, through a tmp
    file, when a run has aged past `keep` (None keeps every key) or superseded rows outnumber live ones. -> the rows the
    file now holds; `last` is left holding only the live runs."""
    path = path or LEDGER
    changed = []
    for r in rows:
        if last.get(key(r)) != r:
            last[key(r)] = r
            changed.append(r)
    live = dict(last) if keep is None else {k: r for k, r in last.items() if (when(r.get("created_at")) or t) >= t - keep}
    os.makedirs(os.path.dirname(path), exist_ok=True)
    line = lambda r: json.dumps(r, separators=(",", ":")) + "\n"
    if len(live) < len(last) or n + len(changed) - len(live) > len(live):
        tmp = f"{path}.{os.getpid()}"
        with open(tmp, "w") as f:
            f.writelines(line(r) for r in sorted(live.values(), key=lambda r: (r.get("created_at") or "", key(r))))
        os.replace(tmp, path)
        for k in set(last) - set(live):
            del last[k]
        return len(live)
    else:  # opened even with nothing to add: an ETag in sync.json is only trusted beside a ledger
        with open(path, "a") as f:
            f.write(("\n" if torn else "") + "".join(line(r) for r in changed))
    return n + len(changed)


def job_record(forge, repo, run_id, attempt, created_at, source, complete, jobs, t):
    """One run attempt's jobs as the archive keeps them (the hub's run detail reads this shape)."""
    slim = [{**{k: j.get(k) for k in JOB_KEYS}, "url": j.get("html_url") or j.get("url"),
             "steps": [{k: st.get(k) for k in STEP_KEYS} for st in j.get("steps") or []]} for j in jobs]
    return {"forge": forge, "repo": repo, "run_id": run_id, "attempt": attempt, "created_at": created_at,
            "source": source, "complete": complete, "fetched_at": iso(t), "jobs": slim}


def feed_get(cursor):
    path = f"{FEED}?cursor={cursor}&limit={FEED_LIMIT}"
    try:
        p = subprocess.run([KUBECTL, "get", "--raw", path], capture_output=True, text=True, timeout=GH_CALL_TIMEOUT_S)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise GhError(f"exporter feed: {e}")
    try:
        if p.returncode == 0:
            return json.loads(p.stdout)
    except ValueError:
        pass
    raise GhError(f"exporter feed: {(p.stderr or p.stdout).strip()[:160] or 'no answer'}")


def import_feed(entry, t):
    """The exporter's records since entry's cursor -> (job records, [(repo, GitHub run)]). `entry` (sync.json "exporter")
    keeps the cursor, the epoch it belongs to and the repos the exporter collects for; a new
    epoch (the exporter restarted) reads its window from 0. A failure keeps the last cursor and
    repos and sets error: those repos' runs then wait as pending, never read from GitHub here."""
    cursor = entry.get("cursor", 0) if entry.get("epoch") else 0
    out, runs = [], []
    try:
        for _ in range(FEED_PAGES):
            d = feed_get(cursor)
            if d.get("epoch") != entry.get("epoch") and cursor:
                entry["epoch"], cursor = d.get("epoch"), 0
                continue
            for r in d.get("records", []):
                run = r.get("run") or {}
                out.append(job_record(r["forge"], r["repo"], r["run_id"], r["attempt"], run.get("created_at"),
                                      "exporter", bool(r.get("complete")), r.get("jobs", []), t))
            runs += [(r["repo"], r["run"]) for r in d.get("runs", []) if r.get("repo") and r.get("run")]
            cursor = d.get("next", cursor)
            entry.update(epoch=d.get("epoch"), cursor=cursor, repos=d.get("repos", []),
                         window_secs=d.get("window_secs", 86400))
            if not d.get("more"):
                break
        entry.update(synced_at=iso(t), error=None)
    except GhError as e:
        print(f"schedules-sync: {e.detail}", file=sys.stderr)
        entry["error"] = str(e)
    return out, runs


def fetch_jobs(repo, run, budget):
    """Every job of one GitHub run's attempt, paged -> (jobs, complete), or None when the first
    page fails or the budget ([calls spent, limit]) is spent."""
    base = f"repos/{repo}/actions/runs/{run['id']}/attempts/{run['attempt']}/jobs?per_page=100"
    jobs, page = [], 1
    while True:
        if budget[0] >= budget[1]:
            return (jobs, False) if page > 1 else None
        budget[0] += 1
        try:
            got = gh(base if page == 1 else f"{base}&page={page}")
        except GhError:
            return (jobs, False) if page > 1 else None
        batch = got.get("jobs", []) if isinstance(got, dict) else []
        jobs += batch
        if not batch or len(jobs) >= (got.get("total_count") or 0):
            return jobs, True
        page += 1


def direct_jobs(repo, runs_last, jobs_last, exporter, budgets, t):
    """Job records this pass reads from GitHub for one repo: every finished run outside the
    exporter's window (budgets["backfill"]), and inside it too when the exporter does not collect
    the repo (budgets["live"]). Nothing while the exporter's repo list is unknown, so a dead feed
    is never papered over."""
    if exporter.get("repos") is None:
        return []
    owned = repo.lower() in {r.lower() for r in exporter["repos"]}
    edge = t - timedelta(seconds=exporter.get("window_secs") or 86400)
    todo = {"live": [], "backfill": []}
    for r in runs_last.values():
        if r["forge"] != "github" or r["repo"] != repo or r.get("status") != "completed":
            continue
        have = jobs_last.get(("github", repo.lower(), r["id"], r["attempt"]))
        if have and have.get("complete"):
            continue
        live = (when(r.get("created_at")) or t) >= edge
        if owned and live:
            continue  # the feed's
        todo["live" if live else "backfill"].append(r)
    out = []
    for kind, runs in todo.items():
        budget = budgets[kind]
        for r in sorted(runs, key=lambda r: (r.get("created_at") or "", r["id"]), reverse=True):
            if budget[0] >= budget[1]:
                break
            got = fetch_jobs(repo, r, budget)
            if got is not None:
                out.append(job_record("github", repo, r["id"], r["attempt"], r.get("created_at"), "github", got[1], got[0], t))
    return out


def newest_attempts(rows, key=lambda r: r["id"]):
    """{key(row): the row of the newest attempt}: the ledger keeps a row per attempt."""
    out = {}
    for r in rows:
        k = key(r)
        if k not in out or (r.get("attempt") or 1) >= (out[k].get("attempt") or 1):
            out[k] = r
    return out


def stale_why(label, entry):
    """The reason a reader gets for a repo last synced longer ago than STALE."""
    why = f": {entry['error']}" if entry.get("error") else ""
    return f"{label} last synced {entry.get('synced_at')}, older than {int(STALE.total_seconds() // 60)}m{why}"


def read_sync(part="repos", path=SYNC):
    try:
        with open(path) as f:
            return json.load(f).get(part) or {}
    except (OSError, ValueError, AttributeError):
        return {}


def new_jobs(jlast, rows):
    """Rows whose content differs from the archive's, fetched_at aside: a feed re-read after an
    exporter restart appends nothing it already has."""
    bare = lambda r: {k: v for k, v in (r or {}).items() if k != "fetched_at"}
    return [r for r in rows if bare(jlast.get(job_key(r))) != bare(r)]


def jobs(argv):
    """`jobs <repo> [--run ID] [--since T]` -> (exit code, JSON or a reason)."""
    if not argv or argv[0].startswith("-") or len(argv) % 2 != 1:
        return 2, "jobs <repo> [--run ID] [--since T]"
    opts = dict(zip(argv[1::2], argv[2::2]))
    if set(opts) - {"--run", "--since"} or len(opts) * 2 != len(argv) - 1:
        return 2, "jobs: --run ID and --since T, each once"
    try:
        run = int(opts["--run"]) if "--run" in opts else None
        since = parse_iso(opts["--since"]) if "--since" in opts else None
    except ValueError:
        return 2, "jobs: --run is a run id, --since is YYYY-MM-DDTHH:MM:SSZ"
    name = argv[0].rpartition(":")[2].lower()
    last, _, _ = read_ledger(f'"repo":"{name}"', JOBS_LEDGER, job_key)
    if last is None:
        return 1, f"no job archive at {JOBS_LEDGER}"
    rows = [r for r in last.values() if r["repo"].lower() == name and (run is None or r["run_id"] == run)
            and not (since and (when(r.get("created_at")) or since) < since)]
    rows.sort(key=lambda r: (r.get("created_at") or "", r["run_id"], r["attempt"]))
    return 0, json.dumps(rows, separators=(",", ":"))


def runs(argv, t):
    """`runs <repo> [--branch B] [--since T] [--until T]` -> (exit code, JSON or a reason)."""
    if not argv or argv[0].startswith("-") or len(argv) % 2 != 1:
        return 2, "runs <repo> [--branch B] [--since T] [--until T]"
    opts = dict(zip(argv[1::2], argv[2::2]))
    if set(opts) - RUN_OPTS:
        return 2, f"runs: unknown option {sorted(set(opts) - RUN_OPTS)[0]}"
    if len(opts) * 2 != len(argv) - 1 or any(v.startswith("--") for v in opts.values()):
        return 2, "runs: each option once, each with a value"
    forge, _, name = argv[0].rpartition(":")
    key = f"{forge or 'github'}:{name}".lower()
    try:
        since = parse_iso(opts["--since"]) if "--since" in opts else None
        until = parse_iso(opts["--until"]) if "--until" in opts else None
    except ValueError:
        return 2, "runs: --since and --until are YYYY-MM-DDTHH:MM:SSZ"
    entry = next((e for k, e in read_sync().items() if k.lower() == key), None)
    if entry is None:
        return 3, f"{argv[0]} is not in the run ledger ({REPOS})"
    synced = when(entry.get("synced_at"))
    if since and since < t - KEEP - STALE:
        return 1, f"runs: the ledger keeps {KEEP.days} days, --since {opts['--since']} is older"
    complete = until and synced and synced >= until  # closed before the last sync, however old that is
    if until and synced and until <= t and not complete:
        return 4, f"{argv[0]} last synced {entry.get('synced_at')}, not yet past {opts['--until']}"
    if not complete and (not synced or synced < t - STALE):
        return 1, stale_why(argv[0], entry)
    last, _, _ = read_ledger(f'"repo":"{name.lower()}"')
    if last is None:
        return 1, f"no ledger at {LEDGER}"

    def wanted(r):
        c = when(r.get("created_at"))
        return (f"{r['forge']}:{r['repo']}".lower() == key
                and ("--branch" not in opts or r.get("branch") == opts["--branch"])
                and not (since and (not c or c < since)) and not (until and (not c or c > until)))

    newest = newest_attempts(r for r in last.values() if wanted(r))
    rows = sorted(newest.values(), key=lambda r: (r.get("created_at") or "", r["id"]))
    return 0, json.dumps(rows, separators=(",", ":"))


def log_names(repo, run_id):
    """-> {"tag": T} or {"of": N} from one run's log zip: the TAG: or tag: its steps echo, else the
    RUN_ID: of the run a Steam upload ships. A release run that uploads its own build echoes its
    own RUN_ID, which names nothing. None when the log names neither, or two different ones."""
    seen = set()
    with zipfile.ZipFile(io.BytesIO(gh_bytes(f"repos/{repo}/actions/runs/{run_id}/logs"))) as z:
        for n in z.namelist():
            seen |= {(k.decode().upper(), v.decode()) for k, v in LOG_NAMES.findall(z.read(n))}
    seen.discard(("RUN_ID", str(run_id)))
    for k, field in (("TAG", "tag"), ("RUN_ID", "of")):
        vals = {v for kk, v in seen if kk == k}
        if len(vals) > 1:
            return None
        if vals:
            v = vals.pop()
            if field == "tag":
                return {"tag": v}
            return {"of": int(v)} if v.isdigit() else None
    return None


def run_tags(argv):
    """`run-tags <repo> <workflow path>...` -> (exit code, report). For each finished dispatched
    run of those workflows the ledger holds, whose name carries no tag (`... of <tag>`) and that
    RUN_TAGS has no line for, reads the run's log and appends what it names (no tag when it names
    none, so each log is read once). The ledger is never rewritten. Exit 1 when a log could not be
    read; the next call asks it again."""
    if len(argv) < 2 or argv[0].startswith("-"):
        return 2, "run-tags <repo> <workflow path>..."
    repo, paths = argv[0], set(argv[1:])
    last, _, _ = read_ledger(f'"repo":"{repo.lower()}"')
    if last is None:
        return 1, f"no ledger at {LEDGER}"
    have, _, _ = read_ledger(None, RUN_TAGS, key=lambda r: (r["repo"].lower(), r["id"]))
    todo = sorted({r["id"] for r in last.values()
                   if r["forge"] == "github" and r["repo"].lower() == repo.lower() and r.get("path") in paths
                   and r.get("event") == "workflow_dispatch" and r.get("status") == "completed"
                   and " of " not in (r.get("workflow") or "") and (repo.lower(), r["id"]) not in (have or {})})
    out, rc = [], 0
    os.makedirs(os.path.dirname(RUN_TAGS), exist_ok=True)
    for run_id in todo:
        try:
            named = log_names(repo, run_id)
        except (GhError, zipfile.BadZipFile) as e:
            out.append(f"{run_id}: log not read: {e}")
            rc = 1
            continue
        # A log that names nothing is kept too, with no tag, so it is read once.
        with open(RUN_TAGS, "a") as f:
            f.write(json.dumps({"repo": repo, "id": run_id, **(named or {})}, separators=(",", ":")) + "\n")
        if not named:
            out.append(f"{run_id}: the log names no tag")
        else:
            out.append(f"{run_id}: {'tag ' + named['tag'] if 'tag' in named else 'uploads run ' + str(named['of'])}")
    return rc, "\n".join(out) or "nothing to read"


def write_json(path, doc):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(doc, f, indent=1)
        f.write("\n")
    os.replace(tmp, path)


def failed_jobs(repo, run, old, jobs_last):
    """Names of the failed jobs of a failed run, from the job archive; reused from the last pass
    for the same attempt. None (unknown) until the archive has that attempt whole."""
    if run["conclusion"] not in FAILED:
        return []
    rec = jobs_last.get(("github", repo.lower(), run["id"], run["attempt"]))
    if rec and rec.get("complete"):
        return [j["name"] for j in rec["jobs"] if j.get("conclusion") in FAILED]
    if (old and old.get("attempt") == run["attempt"] and old.get("conclusion") == run["conclusion"]
            and old.get("failed_jobs") is not None):
        return old["failed_jobs"]
    return None


def night_set(repo, base, prev, t):
    """{"night": the night.json entry, or "night_absent": when it was last found missing} for the
    state entry. Asked conditionally on the last ETag and decoded only when its blob sha moves; a
    repo with no file is asked again after QUARANTINE_RECHECK, like one with no quarantine."""
    prev = prev or {}
    old, absent = prev.get("night"), when(prev.get("night_absent"))
    if absent and t - absent < QUARANTINE_RECHECK:
        return {"night_absent": prev["night_absent"]}
    try:
        got, etag = gh_page(f"repos/{repo}/contents/{NIGHT_FILE}?ref={base}", (old or {}).get("etag"), missing={})
    except GhError as e:  # an optional file: a failed read keeps the last set and names the miss
        print(f"schedules-sync: {NIGHT_FILE} of {repo}: {e.detail}", file=sys.stderr)
        kept = {"night": dict(old, error=str(e))} if old else {}
        return kept or ({"night_absent": prev["night_absent"]} if absent else {})
    if got is None or (old and isinstance(got, dict) and got.get("sha") == old.get("sha")):
        return {"night": dict(old, etag=etag or old.get("etag"))}  # unchanged since the last pass
    if not isinstance(got, dict) or not got.get("sha"):
        return {"night_absent": iso(t)}
    try:
        doc = json.loads(base64.b64decode(got.get("content", "")))
        doc = doc if isinstance(doc, dict) else None
    except ValueError:
        doc = None
    if doc is None:  # a broken file is shown as one, never read as an empty night
        return {"night": {"night": {}, "held": {}, "sha": got["sha"], "etag": etag, "error": f"{NIGHT_FILE}: not a JSON object"}}
    pick = lambda k: {f: str(n) for f, n in (doc.get(k) or {}).items()} if isinstance(doc.get(k), dict) else {}
    return {"night": {"night": pick("night"), "held": pick("held"), "sha": got["sha"], "etag": etag}}


def sync_repo(repo, base, prev, t, sched, jobs_last):
    """The state entry of one repo; `sched` is this pass's new scheduled runs."""
    workflows, unscheduled = scheduled_workflows(repo, base, prev)
    paths = {w["path"] for w in workflows}
    old_runs = {r["id"]: (w["path"], r) for w in (prev or {}).get("workflows", []) for r in w.get("runs", [])}
    merged = {rid: pr for rid, pr in old_runs.items() if pr[0] in paths}
    for raw in sched:
        if raw.get("path") in paths:
            merged[raw["id"]] = (raw["path"], run_record(raw))
    for w in workflows:
        mine = [r for p, r in merged.values() if p == w["path"]]
        w["runs"] = sorted(mine, key=lambda r: (r.get("created_at") or "", r["id"]), reverse=True)[:RUNS_KEPT]
        for r in w["runs"]:  # only the kept runs are asked about
            r["failed_jobs"] = failed_jobs(repo, r, old_runs.get(r["id"], (None, None))[1], jobs_last)
    return {"repo": repo, "base": base, "synced_at": iso(t), "error": None,
            "workflows": workflows, "unscheduled": unscheduled, **night_set(repo, base, prev, t)}


def quarantine_report(repo, base, old, t):
    """(report, etag, files) of `repo`'s quarantine on `base`: its own `quarantine.py report
    --json` over its quarantine.txt, both read through gh and kept beside QUARANTINE, so a pass
    where the listing is unchanged (a 304, free) asks for nothing more. None for no quarantine."""
    listing, etag = gh_page(f"repos/{repo}/contents/{QUARANTINE_DIR}?ref={base}", old.get("etag"), missing=[])
    cache = os.path.join(os.path.dirname(QUARANTINE), "quarantine", *repo.split("/"))
    files = dict(old.get("files") or {})
    today = t.astimezone().date().isoformat()
    if listing is None:  # unchanged since the last pass
        etag = old.get("etag")
        if (old.get("report") or {}).get("today") == today:
            return old["report"], etag, files  # same files, same day: the same report
    else:
        shas = {f.get("name"): f.get("sha") for f in listing if isinstance(f, dict) and f.get("type") == "file"}
        if not all(shas.get(n) for n in QUARANTINE_FILES):
            return None, None, {}
        files = {n: shas[n] for n in QUARANTINE_FILES}
    os.makedirs(cache, exist_ok=True)
    for name, sha in files.items():
        path = os.path.join(cache, name)
        if old.get("files", {}).get(name) == sha and os.path.isfile(path):
            continue
        with open(path, "wb") as f:
            f.write(blob_bytes(repo, sha))
    p = subprocess.run([sys.executable, "-I", os.path.join(cache, "quarantine.py"), "report", "--json",
                        "--today", today, "--file", os.path.join(cache, "quarantine.txt")],
                       capture_output=True, text=True, timeout=GH_CALL_TIMEOUT_S, cwd=cache)
    try:
        report = json.loads(p.stdout) if p.returncode == 0 else None
    except ValueError:
        report = None
    if not isinstance(report, dict):
        why = (p.stderr or p.stdout).strip().splitlines()
        raise GhError(f"quarantine.py report: {why[-1] if why else f'exit {p.returncode}'}")
    return report, etag, files


def artifact_zip(repo, art):
    return zipfile.ZipFile(io.BytesIO(gh_bytes(f"repos/{repo}/actions/artifacts/{art['id']}/zip")))


def run_artifacts(repo, run_id):
    """The artifacts of one run, expired ones left out, the newest of each name: a re-run's
    attempt uploads its own under the same name, and the run's newest attempt is the one read."""
    newest, page = {}, 1
    while True:
        got = gh(f"repos/{repo}/actions/runs/{run_id}/artifacts?per_page=100&page={page}")
        arts = got.get("artifacts") or []
        for a in arts:
            if not a.get("expired") and (a.get("created_at") or "") >= (newest.get(a.get("name"), {}).get("created_at") or ""):
                newest[a.get("name")] = a
        if len(arts) < 100 or page >= MAX_PAGES:
            return list(newest.values())
        page += 1


def night_counts(repo, run, arts):
    """The nightly's KNOWN count (summary.txt's "N known red", every class's line summed), its
    quarantined tests that passed (results.py's "known red now passes" lines in the suite
    output) and those that failed (its "KNOWN <name> (<s>s)" lines); a test seen twice, in a
    batch and alone, counts once. A quarantined test in neither list did not run."""
    summary = next(a for a in arts if a.get("name") == NIGHT_SUMMARY)
    with artifact_zip(repo, summary) as z:
        text = "".join(z.read(n).decode("utf-8", "replace") for n in z.namelist() if n.endswith("summary.txt"))
    passing, known, logs = set(), set(), 0
    for a in arts:
        if not str(a.get("name", "")).startswith(NIGHT_LOGS):
            continue
        logs += 1
        with artifact_zip(repo, a) as z:
            for n in z.namelist():
                if n.endswith(".txt"):
                    out = z.read(n).decode("utf-8", "replace")
                    passing.update(m.strip() for m in NOW_PASSES.findall(out))
                    known.update(m.strip() for m in KNOWN_FAILS.findall(out))
    return {"run_id": run["id"], "attempt": run["attempt"], "url": run.get("url"), "sha": run.get("sha"),
            "created_at": run.get("created_at"), "conclusion": run.get("conclusion"),
            "known": sum(int(m) for m in KNOWN_RED.findall(text)),
            "now_passing": len(passing) if logs else None, "now_passing_tests": sorted(passing),
            "known_tests": sorted(known), "logs": logs}


def last_nightly(repo, base, runs_last, old):
    """(nightly, no_summary): the newest finished `Tests (all)` run on base that uploaded its
    summary, read once per run attempt; `no_summary` keys the newer ones that did not (a skipped
    night, a shard that never reported), so they are asked once."""
    newest = newest_attempts(r for r in runs_last.values()
                             if r.get("forge") == "github" and r.get("repo") == repo and r.get("branch") == base
                             and r.get("title") == NIGHT_TITLE and r.get("status") == "completed"
                             and r.get("conclusion") not in ("cancelled", "skipped"))
    runs = sorted(newest.values(), key=lambda r: (r.get("created_at") or "", r["id"]), reverse=True)
    had, skip, no_summary = old.get("nightly"), set(old.get("no_summary") or []), []
    for r in runs[:NIGHT_LOOKS]:
        key = f"{r['id']}:{r['attempt']}"
        if had and (had.get("run_id"), had.get("attempt")) == (r["id"], r["attempt"]):
            return had, no_summary
        if key in skip:
            no_summary.append(key)
            continue
        arts = run_artifacts(repo, r["id"])
        if any(a.get("name") == NIGHT_SUMMARY for a in arts):
            try:
                return night_counts(repo, r, arts), no_summary
            except zipfile.BadZipFile as e:  # an artifact that never reads again: asked once
                print(f"schedules-sync: {repo} nightly {r['id']}: {e}", file=sys.stderr)
        no_summary.append(key)
    return had, no_summary


def quarantine_pass(repos, runs_last, t):
    """Write QUARANTINE: one lane per GitHub repo whose base has a quarantine, each with its
    report and its last nightly's counts. A lane whose read fails keeps its last good numbers with
    `error` set, as sync.json does for a repo; a failure here never fails the pass."""
    try:
        with open(QUARANTINE) as f:
            prev = json.load(f)
    except (OSError, ValueError):
        prev = {}
    lanes = {l["repo"]: l for l in prev.get("repos") or [] if isinstance(l, dict) and "repo" in l}
    absent = {r: a for r, a in (prev.get("absent") or {}).items() if isinstance(a, str)}
    out, gone = [], {}
    for forge, repo, base, _ in repos:
        if forge != "github":
            continue
        old = lanes.get(repo) or {}
        if not old and repo in absent and (when(absent[repo]) or t) > t - QUARANTINE_RECHECK:
            gone[repo] = absent[repo]
            continue
        lane = {**old, "repo": repo, "base": base}
        try:
            report, etag, files = quarantine_report(repo, base, old, t)
            if report is None:
                gone[repo] = iso(t)
                continue
            lane.update(report=report, etag=etag, files=files)
            lane["nightly"], lane["no_summary"] = last_nightly(repo, base, runs_last, old)
            lane.update(synced_at=iso(t), error=None)
        except Exception as e:  # any failure stays on its lane: the run facts above are written
            print(f"schedules-sync: {repo} quarantine: {getattr(e, 'detail', e)}", file=sys.stderr)
            if "report" not in lane:
                continue  # not yet known to have a quarantine: asked again next pass, not drawn
            lane["error"] = str(e)
        out.append(lane)
    try:
        write_json(QUARANTINE, {"generated_at": iso(t), "repos": out, "absent": gone})
    except OSError as e:
        print(f"schedules-sync: {QUARANTINE}: {e}", file=sys.stderr)


def cron_field(spec, lo, hi):
    vals = set()
    for part in spec.upper().split(","):
        part, _, step = part.partition("/")
        step = int(step) if step else 1
        if part == "*":
            a, b = lo, hi
        else:
            a, _, b = part.partition("-")
            a = CRON_NAMES[a] if a in CRON_NAMES else int(a)
            b = (CRON_NAMES[b] if b in CRON_NAMES else int(b)) if b else (hi if step > 1 else a)
        vals.update(range(a, b + 1, step))
    return vals


def cron_slots(cron, start, end):
    """The UTC minutes in [start, end) that a 5-field cron fires on, as GitHub reads it (UTC,
    and a day matches on day-of-month OR day-of-week when both are restricted)."""
    f = cron.split()
    if len(f) != 5:
        raise ValueError(cron)
    mins, hours, doms, months = cron_field(f[0], 0, 59), cron_field(f[1], 0, 23), cron_field(f[2], 1, 31), cron_field(f[3], 1, 12)
    dows = {d % 7 for d in cron_field(f[4], 0, 7)}
    either = f[2] != "*" and f[4] != "*"
    out, t = [], start
    while t < end:
        dom, dow = t.day in doms, t.isoweekday() % 7 in dows
        if (t.month in months and t.hour in hours and t.minute in mins
                and ((dom or dow) if either else (dom and dow))):
            out.append(t)
        t += timedelta(minutes=1)
    return out


def pending(name, t, day=None):
    """-> what a nightly:<name> hold still waits for on local date `day` (default: t's);
    empty when it releases."""
    try:
        with open(STATE) as f:
            repos = json.load(f).get("repos", [])
    except (OSError, ValueError, AttributeError):
        return ["no schedules state"]
    entry = next((r for r in repos if name in (r.get("repo"), r.get("repo", "").split("/")[-1])), None)
    if not entry:
        return [f"{name} not in the schedules state"]
    if not entry.get("synced_at") or t - parse_iso(entry["synced_at"]) > STALE:
        return [f"schedules state for {name} stale since {entry.get('synced_at')}"]
    day = day or t.astimezone().date()  # local time; naive datetimes below are local too
    start = datetime(day.year, day.month, day.day).astimezone(timezone.utc)
    end = (datetime(day.year, day.month, day.day) + timedelta(days=1)).astimezone(timezone.utc)
    out = []
    for w in entry.get("workflows", []):
        wf = os.path.basename(w["path"])
        try:
            slots = sorted({s for c in w.get("crons", []) for s in cron_slots(c, start, end)})
        except (ValueError, KeyError):
            out.append(f"{wf} cron unreadable")
            continue
        timeout = timedelta(minutes=w.get("timeout_min") or 0)
        for i, slot in enumerate(slots):
            if slot > t:
                out.append(f"{wf} due {slot.astimezone():%H:%M}")
                break
            upto = slots[i + 1] if i + 1 < len(slots) else end
            run = next((r for r in w.get("runs", []) if r.get("created_at")
                        and slot <= parse_iso(r["created_at"]) < upto), None)
            if run and run.get("status") == "completed":
                continue
            if t < (parse_iso(run["created_at"]) if run else slot) + timeout:
                out.append(f"{wf} {'running' if run else 'not started'}")
                break
    return out


def main(argv):
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if argv and argv[0] == "pending":
        day = None
        if len(argv) == 4 and argv[2] == "--day":
            try:
                day = datetime.strptime(argv[3], "%Y-%m-%d").date()
            except ValueError:
                day = False
        if len(argv) not in (2, 4) or day is False or (len(argv) == 4 and day is None):
            print("schedules-sync: pending <repo> [--day YYYY-MM-DD]", file=sys.stderr)
            return 2
        left = pending(argv[1], now(), day)
        if left:
            print(", ".join(left))
        return 1 if left else 0
    if argv and argv[0] == "runs":
        rc, out = runs(argv[1:], now())
        print(out, file=sys.stdout if rc == 0 else sys.stderr)
        return rc
    if argv and argv[0] == "prs":
        rc, out, why = prs(argv[1:], now())
        if out:
            print(out)
        if why:
            print(why, file=sys.stderr)
        return rc
    if argv and argv[0] in ("jobs", "sync-prs"):
        rc, out = jobs(argv[1:]) if argv[0] == "jobs" else sync_prs_cmd(argv[1:], now())
        if out:
            print(out, file=sys.stdout if rc == 0 else sys.stderr)
        return rc
    if argv and argv[0] == "run-tags":
        rc, out = run_tags(argv[1:])
        print(out, file=sys.stdout if rc == 0 else sys.stderr)
        return rc
    if argv and argv[0] != "sync":
        print(f"schedules-sync: unknown verb {argv[0]} (sync, pending, runs, jobs, prs, sync-prs, run-tags, --help)", file=sys.stderr)
        return 2
    try:
        repos = read_repos()
    except OSError as e:
        print(f"schedules-sync: no repo list: {e}", file=sys.stderr)
        return 1
    prev, t, out, bad = read_prev(), now(), [], 0
    last, n, torn = read_ledger()
    sync = read_sync() if last is not None else {}  # no ledger: an ETag would hide its rows
    last = last or {}
    opened = {}  # (forge, repo) -> the oldest run the ledger still has open
    jlast, jn, jtorn = read_ledger(path=JOBS_LEDGER, key=job_key)
    exporter = read_sync("exporter") if jlast is not None else {}  # no archive: read the window again
    jlast = jlast or {}
    fed_jobs, fed_runs = import_feed(exporter, t)
    jn, jtorn = write_ledger(jlast, jn, jtorn, new_jobs(jlast, fed_jobs), t, JOBS_LEDGER, job_key, JOBS_KEEP), False
    # The feed's repos: their runs come from it alone. Unknown until a feed answers once.
    owned = {r.lower() for r in exporter.get("repos") or []}
    budgets = {"live": [0, JOB_CALLS], "backfill": [0, BACKFILL_CALLS]}
    for r in last.values():
        c = when(r.get("created_at")) if r.get("status") != "completed" else None
        if c:
            k = (r["forge"], r["repo"])
            opened[k] = min(opened.get(k, c), c)
    for forge, repo, base, host in repos:
        if forge == PRS_ONLY:  # the PR store alone: no runs, schedules or quarantine
            bad += bool(sync_prs("github", repo, None, t))
            continue
        rows = []
        entry = dict(sync.get(f"{forge}:{repo}") or {})
        p = prev.get(repo) if forge == "github" else None
        state = None
        try:
            if forge == "forgejo" and "/" not in repo:
                raise GhError(f"forgejo:{host}/{repo}: want forgejo:<host>/<owner/name>")
            if forge == "forgejo":
                rows.extend(forgejo_rows(host, repo, entry, opened.get((forge, repo)), t, last))
            elif forge == "github":
                if repo.lower() in owned:  # the feed's alone: never read from GitHub here
                    got, etag = [run for r, run in fed_runs if r.lower() == repo.lower()], None
                else:
                    since = [opened[(forge, repo)]] if (forge, repo) in opened else []
                    since += [parse_iso(r["created_at"]) for w in (p or {}).get("workflows", [])
                              for r in w.get("runs", []) if r.get("status") != "completed" and r.get("created_at")]
                    got, etag = fetch_runs(repo, entry, min(since, default=None), t)
                    got = got or []
                rows.extend(gh_row(repo, r) for r in got)
                seen = {**last, **{run_key(r): r for r in rows}}  # the ledger with this pass's runs
                jn = write_ledger(jlast, jn, jtorn, new_jobs(jlast, direct_jobs(repo, seen, jlast, exporter, budgets, t)), t,
                                  JOBS_LEDGER, job_key, JOBS_KEEP)
                state = sync_repo(repo, base, p, t, [r for r in got if r.get("event") == "schedule"], jlast)
                entry["etag"] = etag  # only once its rows are kept: a 304 must not hide them
                if repo.lower() in owned and exporter.get("error"):
                    # The pages it served before failing are kept above: the cursor is past them.
                    raise GhError(f"exporter feed: {exporter['error']}")
                out.append(state)
            else:
                raise GhError(f"unknown forge {forge} (github, forgejo)")
            entry.update(synced_at=iso(t), error=None)
        except GhError as e:
            bad += 1
            print(f"schedules-sync: {repo}: {e.detail}", file=sys.stderr)
            entry["error"] = str(e)
            if forge == "github":
                kept = dict(state or p or {"repo": repo, "base": base, "synced_at": None, "workflows": []})
                kept["error"] = str(e)
                out.append(kept)
        sync[f"{forge}:{repo}"] = entry
        # Per repo, so a cold pass the service timeout cuts keeps the repos it finished. The
        # ledger goes first: a crash between the two re-reads the repo, it never skips it.
        n, torn = write_ledger(last, n, torn, rows, t), False
        write_json(SYNC, {"generated_at": iso(t), "repos": sync, "exporter": exporter})
        if has_prs(forge, repo) and sync_prs(forge, repo, host, t):
            bad += 1
    write_json(STATE, {"generated_at": iso(t), "repos": out})
    quarantine_pass(repos, last, t)
    print(STATE)
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
