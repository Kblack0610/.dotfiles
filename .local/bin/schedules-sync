#!/usr/bin/env python3
"""schedules-sync - the one local writer of CI run facts: GitHub scheduled runs, and every run.

For each GitHub repo in the day-log-ci list (`<owner/name> <base> [clone]`, private overlay), it
records every workflow on the base branch that has an `on.schedule`: its crons, its
timeout (the longest `needs:` path of job timeouts, GitHub's 360 min where a job sets
none), its purpose (the comment block right above `on:`, else the file's first comment
block), its job graph, and its last SCHEDULES_RUNS scheduled runs (id, url, status,
conclusion, start, end, failed jobs). It writes them to one file, SCHEDULES_STATE
(~/.local/state/schedules/state.json), which the agent-queue `nightly:` hold, fleet-sessions
and the hub Schedules tab read instead of asking gh themselves.

Each pass also appends every run of every event, on GitHub and on the Forgejo repos the list
names as `forgejo:<host>/<owner/name> <base>`, to the run ledger SCHEDULES_RUNS_LEDGER
(~/.local/state/ci/runs.jsonl), one JSON row per run each time it changes: forge, repo, id,
attempt (the key), workflow, path, title, branch, event, sha, status, conclusion, created_at,
started_at, ended_at, queue_wait_s, prs, url. A reader dedupes on the key and keeps the last
row; a torn last line is skipped. Rows whose run was created more than 30 days ago are pruned
by an atomic rewrite, which also drops superseded rows once they outnumber the live ones.
Forgejo has no attempt (always 1) and lists jobs, not runs: a run is its jobs grouped by run
number, failed when one failed. Its API is https://<host>/api/v1, the host named in the
private list (never here), with the token FORGEJO_TOKEN, else `rbw get forgejo_repo_admin`,
sent in curl's stdin config, never argv; with neither, a public repo still reads.

  schedules-sync          sync every repo, write the state file and the ledger, print the state path
  schedules-sync pending <repo> [--day YYYY-MM-DD]
                          what an agent-queue `nightly:<repo>` hold still waits for, one line;
                          exit 0 and no output when nothing is (repo: owner/name or name);
                          --day judges that local date's runs instead of today's
  schedules-sync runs <repo> [--branch B] [--since T] [--until T]
                          the ledger's runs of one repo (owner/name, or forgejo:owner/name),
                          as a JSON array in created_at order, one object per run: its newest
                          attempt's last row; --branch keeps one branch, --since/--until (ISO,
                          UTC) bound created_at. The one reader of the ledger: fleet-sessions,
                          fleet-bench and ci-failures read runs here, never from actions/runs.
                          Exit 1 when the repo's last sync is over 30 minutes old (a window
                          that closed before that sync is still complete) or --since is older
                          than the ledger's 30 days, 3 when the list does not sync the repo (a
                          caller tells "unknown" from "no runs"), 4 when a past --until is
                          after the last sync: that window is not yet complete, and the next
                          pass completes it

Deterministic, no model. schedules-sync.timer runs it every 10 minutes: GitHub sends this
machine no event when a run ends, so it samples.

gh cost per GitHub repo per pass: one workflows listing, one conditional runs page (a 304,
which costs no rate limit, when nothing on it changed; more pages only on a cold start or
after a gap), one blob per changed workflow file and one jobs call per newly failed scheduled
run. The scheduled runs are the runs page's `event: schedule` rows, so there is no second
listing. The ETag, the last sync and the last error per repo are in ci/sync.json beside the
ledger. The previous state is the cache: a workflow whose blob sha is unchanged is not
re-read, a finished run's failed jobs are not re-asked. Runs come from actions/runs, not
`gh run list`, which looks workflows up under actions/workflows, the bucket used up on
2026-10-29 (fleet-sessions main_runs). A re-run of a run older than the first page leaves
that page unchanged, so it is read when the page next changes.

A repo gh cannot read keeps its last good entry, with `error` set and `synced_at` left at
the last success, so a reader can tell stale from fresh per repo; the exit status is 1, and
the other repos still land. A repo with no scheduled workflow is an empty list, not an error.

`pending` reads the state file and nothing else. Each scheduled workflow's cron slots on
one local date (--day, else today) must each have a finished run, or be past the slot (or
the run's start) plus the workflow's timeout, which a triage reads as red. A slot still to
come that day holds. agent-queue passes the date of the item's `at:` tag, so a night that
finished stays released: judged by today, a 22:00 slot (soak.yml) left a hold free only
until midnight, when every slot of the new day held again (nightly-validate-20261108).
A missing file, a repo not in it, or one not synced in 30 minutes holds (fails
closed, like the `pr:` hold when gh cannot answer). A frequent cron holds all day, so tag
only repos whose schedules run nightly.
"""

import base64
import json
import os
import subprocess
import sys
from datetime import datetime, timedelta, timezone

import yaml

HOME = os.path.expanduser("~")
GH = os.environ.get("SCHEDULES_GH", "gh")
REPOS = os.environ.get("SCHEDULES_REPOS", os.path.join(HOME, ".config/agentctl/day-log-ci"))
STATE = os.environ.get(
    "SCHEDULES_STATE",
    os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state"), "schedules/state.json"),
)
LEDGER = os.environ.get(
    "SCHEDULES_RUNS_LEDGER",
    os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state"), "ci/runs.jsonl"),
)
SYNC = os.path.join(os.path.dirname(LEDGER), "sync.json")
CURL = os.environ.get("SCHEDULES_CURL", "curl")
RBW = os.environ.get("SCHEDULES_RBW", "rbw")
FORGEJO_ENTRY = os.environ.get("SCHEDULES_FORGEJO_ENTRY", "forgejo_repo_admin")
FJ_PAGE = 50  # Forgejo's MAX_RESPONSE_ITEMS caps every list page at 50
FJ_DONE = ("success", "failure", "cancelled", "skipped")
KEEP = timedelta(days=30)  # the ledger's window, and how far back a cold pass reads
RUNS_KEPT = int(os.environ.get("SCHEDULES_RUNS", "14"))
PER_PAGE = int(os.environ.get("SCHEDULES_PER_PAGE", "100"))
MAX_PAGES = int(os.environ.get("SCHEDULES_MAX_PAGES", "20"))  # a cold start of a busy repo
GH_JOB_TIMEOUT_MIN = 360  # GitHub's default timeout-minutes for a job that sets none
OVERLAP = timedelta(hours=1)  # re-read this far behind the last sync
FAILED = ("failure", "timed_out")
GH_CALL_TIMEOUT_S = 60  # a guard: one hung call must not eat the whole pass
STALE = timedelta(minutes=30)  # three missed 10-minute passes
RUN_OPTS = {"--branch", "--since", "--until"}
CRON_NAMES = {n: i for i, n in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
CRON_NAMES.update({n: i + 1 for i, n in enumerate(
    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"])})


class GhError(Exception):
    pass


def now():
    s = os.environ.get("SCHEDULES_NOW")
    return datetime.fromtimestamp(int(s), timezone.utc) if s else datetime.now(timezone.utc)


def iso(t):
    return t.strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_iso(s):
    return datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)


def when(s):
    """An API timestamp as an aware datetime, or None (Forgejo writes year 1 for never)."""
    try:
        t = datetime.fromisoformat(s.replace("Z", "+00:00"))
    except (AttributeError, TypeError, ValueError):
        return None
    return t if t.year > 2000 else None


def wait_s(a, b):
    ta, tb = when(a), when(b)
    return int((tb - ta).total_seconds()) if ta and tb else None


def gh_why(path, text, head=""):
    """A failed gh call as one short line someone can act on; the raw text stays in gh's own logs.

    A cause that fails every repo the same way (rate limit, auth, no access) reads the same for
    each, so the dashboards can fold them into one line; anything else keeps the path."""
    low = text.lower()
    if "rate limit" in low:
        reset = next((h.split(":", 1)[1].strip() for h in head.split("\n")
                      if h.lower().startswith("x-ratelimit-reset:")), "")
        at = f", resets {datetime.fromtimestamp(int(reset)).strftime('%H:%M')}" if reset.isdigit() else ""
        return f"GitHub API rate limit hit{at}"
    if "http 401" in low or "bad credentials" in low or "gh auth login" in low:
        return "gh is not logged in: run gh auth login"
    first = next((ln.strip() for ln in text.splitlines() if ln.strip()), "no output")
    return f"gh api {path}: {first.removeprefix('gh: ').split('. If you reach out')[0][:160]}"


def gh(path, missing=None):
    """gh api <path> as JSON. A 404 returns `missing` when one is given, else it is an error."""
    try:
        p = subprocess.run([GH, "api", path], capture_output=True, text=True, timeout=GH_CALL_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        raise GhError(f"gh api {path}: no answer in {GH_CALL_TIMEOUT_S}s")
    try:
        body = json.loads(p.stdout)
    except ValueError:
        body = None
    if p.returncode == 0 and body is not None:
        return body
    if missing is not None and isinstance(body, dict) and str(body.get("status")) == "404":
        return missing
    raise GhError(gh_why(path, p.stderr or p.stdout))


def gh_page(path, etag=None):
    """gh api -i <path>, conditional on `etag` -> (body, etag); body is None on a 304."""
    cmd = [GH, "api", "-i"] + (["-H", f"If-None-Match: {etag}"] if etag else []) + [path]
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=GH_CALL_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        raise GhError(f"gh api {path}: no answer in {GH_CALL_TIMEOUT_S}s")
    head, _, raw = p.stdout.replace("\r\n", "\n").partition("\n\n")
    status = head.split("\n", 1)[0].split()
    if len(status) > 1 and status[1] == "304":
        return None, etag  # gh exits 1 on it, but it is the answer asked for
    tag = next((h.split(":", 1)[1].strip() for h in head.split("\n") if h.lower().startswith("etag:")), None)
    try:
        body = json.loads(raw)
    except ValueError:
        body = None
    if p.returncode == 0 and body is not None:
        return body, tag
    raise GhError(gh_why(path, p.stderr or raw, head))


FJ_TOKEN = []


def fj_token():
    """FORGEJO_TOKEN, else the rbw entry, read once per pass; "" when neither answers."""
    if not FJ_TOKEN:
        tok = os.environ.get("FORGEJO_TOKEN", "")
        if not tok:
            try:
                tok = subprocess.run([RBW, "get", FORGEJO_ENTRY], capture_output=True, text=True,
                                     timeout=GH_CALL_TIMEOUT_S).stdout.strip()
            except (OSError, subprocess.TimeoutExpired):
                tok = ""
        FJ_TOKEN.append(tok)
    return FJ_TOKEN[0]


def fj(host, path):
    """GET https://<host>/api/v1/<path> as JSON; the token goes in on curl's stdin, never argv."""
    tok = fj_token()
    conf = f'header = "Authorization: token {tok}"\n' if tok else ""
    try:
        p = subprocess.run([CURL, "-sSf", "-K", "-", "--max-time", "30", f"https://{host}/api/v1/{path}"],
                           input=conf, capture_output=True, text=True, timeout=GH_CALL_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        raise GhError(f"forgejo {path}: no answer in {GH_CALL_TIMEOUT_S}s")
    if p.returncode == 0:
        try:
            return json.loads(p.stdout)
        except ValueError:
            pass
    why = (p.stderr or p.stdout).strip()[:200]
    raise GhError(f"forgejo {path}: {why}" + ("" if tok else f" (no token: FORGEJO_TOKEN unset, rbw {FORGEJO_ENTRY} unread)"))


def read_repos():
    """-> [(forge, owner/name, base, host)]: `forgejo:<host>/<owner/name>` is a Forgejo repo,
    a bare (or `github:`) name a GitHub one, whose host is None."""
    out = []
    with open(REPOS) as f:
        for line in f:
            line = line.split("#", 1)[0].split()
            if len(line) >= 2:
                forge, _, name = line[0].rpartition(":")
                host = None
                if forge == "forgejo":
                    host, _, name = name.partition("/")
                out.append((forge or "github", name, line[1], host))
    return out


def read_prev():
    try:
        with open(STATE) as f:
            return {r["repo"]: r for r in json.load(f).get("repos", [])}
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return {}


def purpose_of(text):
    """The comment block right above top-level `on:`, else the file's first comment block."""
    blocks, cur = [], []
    above_on = None
    for line in text.splitlines():
        if line.startswith("#"):
            cur.append(line.lstrip("#").strip())
            continue
        if cur:
            blocks.append(cur)
        if line.startswith(("on:", '"on":', "'on':")) and cur:
            above_on = cur
        cur = []
        if line.startswith("jobs:"):
            break
    chosen = above_on or (blocks[0] if blocks else None)
    if not chosen:
        return None
    return " ".join(w for w in chosen if w) or None


def job_timeout(job):
    t = job.get("timeout-minutes")
    return t if isinstance(t, (int, float)) and not isinstance(t, bool) else GH_JOB_TIMEOUT_MIN


def needs_of(job):
    n = job.get("needs") or []
    return [n] if isinstance(n, str) else [x for x in n if isinstance(x, str)]


def parse_workflow(text):
    """-> (name, crons, jobs, timeout_min) or None when the file has no schedule."""
    doc = yaml.safe_load(text)
    if not isinstance(doc, dict):
        return None
    on = doc.get("on", doc.get(True))  # YAML 1.1 reads a bare `on` key as true
    sched = on.get("schedule") if isinstance(on, dict) else None
    crons = [s["cron"] for s in sched or [] if isinstance(s, dict) and isinstance(s.get("cron"), str)]
    if not crons:
        return None
    raw = doc.get("jobs") if isinstance(doc.get("jobs"), dict) else {}
    jobs = [
        {"id": k, "name": v.get("name", k) if isinstance(v, dict) else k,
         "needs": needs_of(v) if isinstance(v, dict) else [],
         "timeout_min": job_timeout(v) if isinstance(v, dict) else GH_JOB_TIMEOUT_MIN}
        for k, v in raw.items()
    ]
    by_id = {j["id"]: j for j in jobs}
    memo = {}

    def path_end(jid, seen=()):
        if jid in memo:
            return memo[jid]
        if jid not in by_id or jid in seen:
            return 0
        j = by_id[jid]
        memo[jid] = j["timeout_min"] + max((path_end(n, seen + (jid,)) for n in j["needs"]), default=0)
        return memo[jid]

    timeout = max((path_end(j["id"]) for j in jobs), default=0)
    return str(doc.get("name") or ""), crons, jobs, timeout


def scheduled_workflows(repo, base, prev):
    """-> (scheduled workflows, {path: sha} of the unscheduled ones). A file whose blob sha
    the last pass already read, scheduled or not, is not read again."""
    known = {w["path"]: w for w in prev.get("workflows", [])} if prev else {}
    seen = (prev or {}).get("unscheduled") or {}
    listing = gh(f"repos/{repo}/contents/.github/workflows?ref={base}", missing=[])
    out, unscheduled = [], {}
    for f in listing if isinstance(listing, list) else []:
        if f.get("type") != "file" or not f.get("name", "").endswith((".yml", ".yaml")):
            continue
        path, sha = f["path"], f["sha"]
        old = known.get(path)
        if old and old.get("sha") == sha:
            out.append({k: v for k, v in old.items() if k != "runs"})
            continue
        if seen.get(path) == sha:
            unscheduled[path] = sha
            continue
        blob = gh(f"repos/{repo}/git/blobs/{sha}")
        text = base64.b64decode(blob.get("content", "")).decode("utf-8", "replace")
        try:
            parsed = parse_workflow(text)
        except yaml.YAMLError:
            parsed = None  # GitHub would not schedule an unparseable file either
        if not parsed:
            unscheduled[path] = sha
            continue
        name, crons, jobs, timeout = parsed
        out.append({"path": path, "sha": sha, "name": name or f["name"], "crons": crons,
                    "timeout_min": timeout, "purpose": purpose_of(text), "jobs": jobs})
    return sorted(out, key=lambda w: w["path"]), unscheduled


def run_record(r):
    done = r.get("status") == "completed"
    return {"id": r["id"], "attempt": r.get("run_attempt", 1), "url": r.get("html_url"),
            "title": r.get("name"), "sha": r.get("head_sha"), "created_at": r.get("created_at"),
            "status": r.get("status"), "conclusion": r.get("conclusion") if done else None,
            "started_at": r.get("run_started_at"), "ended_at": r.get("updated_at") if done else None}


def window(entry, open_since, t):
    """How far back a pass reads: the last sync less OVERLAP, or the oldest run still open
    then, never past KEEP; a repo never synced reads all of KEEP."""
    floor = t - KEEP
    stop = parse_iso(entry["synced_at"]) - OVERLAP if entry.get("synced_at") else floor
    if open_since:
        stop = min(stop, open_since)
    return max(stop, floor)


def fetch_runs(repo, entry, open_since, t):
    """Every GitHub run, newest first, paged back to window(), or MAX_PAGES on a cold start.
    -> (runs, etag); runs is None when the first page is unchanged (a 304)."""
    stop, runs, etag = window(entry, open_since, t), [], None
    for page in range(1, MAX_PAGES + 1):
        path = f"repos/{repo}/actions/runs?per_page={PER_PAGE}&page={page}"
        if page == 1:
            got, etag = gh_page(path, entry.get("etag"))
            if got is None:
                return None, etag
        else:
            got = gh(path)
        batch = got.get("workflow_runs", []) if isinstance(got, dict) else []
        runs.extend(batch)
        if len(batch) < PER_PAGE:
            break
        oldest = when(batch[-1].get("created_at"))
        if oldest and oldest < stop:
            break
    return runs, etag


def gh_row(repo, r):
    done = r.get("status") == "completed"
    return {"forge": "github", "repo": repo, "id": r["id"], "attempt": r.get("run_attempt", 1),
            "workflow": r.get("name"), "path": r.get("path"), "title": r.get("display_title"),
            "branch": r.get("head_branch"), "event": r.get("event"), "sha": r.get("head_sha"),
            "status": r.get("status"), "conclusion": r.get("conclusion") if done else None,
            "created_at": r.get("created_at"), "started_at": r.get("run_started_at"),
            "ended_at": r.get("updated_at") if done else None,
            "queue_wait_s": wait_s(r.get("created_at"), r.get("run_started_at")),
            "prs": [p["number"] for p in r.get("pull_requests") or [] if isinstance(p, dict) and "number" in p],
            "url": r.get("html_url")}


def forgejo_rows(host, repo, entry, open_since, t):
    """Every Forgejo run back to window(), one row per run from its jobs (actions/tasks lists
    jobs, newest first). When paging stops before the list ends, the oldest run seen may be
    cut by the page edge, so it is left out; a pass that saw it whole wrote its row."""
    stop, tasks, whole = window(entry, open_since, t), [], False
    for page in range(1, MAX_PAGES + 1):
        got = fj(host, f"repos/{repo}/actions/tasks?limit={FJ_PAGE}&page={page}")
        batch = got.get("workflow_runs") or [] if isinstance(got, dict) else []
        tasks.extend(batch)
        if len(batch) < FJ_PAGE:
            whole = True
            break
        oldest = when(batch[-1].get("created_at"))
        if oldest and oldest < stop:
            break
    cut = None if whole or not tasks else tasks[-1].get("run_number")
    runs = {}
    for k in tasks:
        if k.get("run_number") is not None and k["run_number"] != cut:
            runs.setdefault(k["run_number"], []).append(k)
    rows = []
    for n, jobs in runs.items():
        st = [j.get("status") for j in jobs]
        done = all(x in FJ_DONE for x in st)
        conclusion = None
        if done:
            conclusion = next((c for c in ("failure", "cancelled", "success") if c in st), "skipped")
        created = min((j.get("created_at") for j in jobs if when(j.get("created_at"))), default=None)
        started = min((j.get("run_started_at") for j in jobs if when(j.get("run_started_at"))), default=None)
        ended = max((j.get("updated_at") for j in jobs if when(j.get("updated_at"))), default=None) if done else None
        j = jobs[0]
        rows.append({"forge": "forgejo", "repo": repo, "id": n, "attempt": 1,
                     "workflow": j.get("workflow_id"), "path": j.get("workflow_id"), "title": j.get("display_title"),
                     "branch": j.get("head_branch"), "event": j.get("event"), "sha": j.get("head_sha"),
                     "status": "completed" if done else ("in_progress" if "running" in st else "queued"),
                     "conclusion": conclusion, "created_at": created, "started_at": started, "ended_at": ended,
                     "queue_wait_s": wait_s(created, started), "prs": [], "url": j.get("url")})
    return rows


def run_key(r):
    return (r["forge"], r["repo"], r["id"], r["attempt"])


def read_ledger(repo=None):
    """-> ({key: last row}, rows read, whether the file ends mid-line); None for no ledger. With
    <repo> (owner/name) only lines naming it are parsed: a reader of one repo skips the rest."""
    try:
        f = open(LEDGER)
    except OSError:
        return None, 0, False
    last, n, line = {}, 0, ""
    with f:
        for line in f:
            if repo and repo not in line.lower():
                continue
            try:
                r = json.loads(line)
                last[run_key(r)] = r
                n += 1
            except (ValueError, KeyError, TypeError):
                continue  # a torn last line, or not a row
    return last, n, bool(line) and not line.endswith("\n")


def write_ledger(last, n, torn, rows, t):
    """Append the rows that changed since their key's last row. Rewrite instead, through a tmp
    file, when a run has aged past KEEP or superseded rows outnumber live ones. -> the rows the
    file now holds; `last` is left holding only the live runs."""
    changed = []
    for r in rows:
        if last.get(run_key(r)) != r:
            last[run_key(r)] = r
            changed.append(r)
    live = {k: r for k, r in last.items() if (when(r.get("created_at")) or t) >= t - KEEP}
    os.makedirs(os.path.dirname(LEDGER), exist_ok=True)
    line = lambda r: json.dumps(r, separators=(",", ":")) + "\n"
    if len(live) < len(last) or n + len(changed) - len(live) > len(live):
        tmp = f"{LEDGER}.{os.getpid()}"
        with open(tmp, "w") as f:
            f.writelines(line(r) for r in sorted(live.values(), key=lambda r: (r.get("created_at") or "", run_key(r))))
        os.replace(tmp, LEDGER)
        for k in set(last) - set(live):
            del last[k]
        return len(live)
    else:  # opened even with nothing to add: an ETag in sync.json is only trusted beside a ledger
        with open(LEDGER, "a") as f:
            f.write(("\n" if torn else "") + "".join(line(r) for r in changed))
    return n + len(changed)


def read_sync():
    try:
        with open(SYNC) as f:
            return json.load(f).get("repos", {})
    except (OSError, ValueError, AttributeError):
        return {}


def runs(argv, t):
    """`runs <repo> [--branch B] [--since T] [--until T]` -> (exit code, JSON or a reason)."""
    if not argv or argv[0].startswith("-") or len(argv) % 2 != 1:
        return 2, "runs <repo> [--branch B] [--since T] [--until T]"
    opts = dict(zip(argv[1::2], argv[2::2]))
    if set(opts) - RUN_OPTS:
        return 2, f"runs: unknown option {sorted(set(opts) - RUN_OPTS)[0]}"
    if len(opts) * 2 != len(argv) - 1 or any(v.startswith("--") for v in opts.values()):
        return 2, "runs: each option once, each with a value"
    forge, _, name = argv[0].rpartition(":")
    key = f"{forge or 'github'}:{name}".lower()
    try:
        since = parse_iso(opts["--since"]) if "--since" in opts else None
        until = parse_iso(opts["--until"]) if "--until" in opts else None
    except ValueError:
        return 2, "runs: --since and --until are YYYY-MM-DDTHH:MM:SSZ"
    entry = next((e for k, e in read_sync().items() if k.lower() == key), None)
    if entry is None:
        return 3, f"{argv[0]} is not in the run ledger ({REPOS})"
    synced = when(entry.get("synced_at"))
    if since and since < t - KEEP - STALE:
        return 1, f"runs: the ledger keeps {KEEP.days} days, --since {opts['--since']} is older"
    complete = until and synced and synced >= until  # closed before the last sync, however old that is
    if until and synced and until <= t and not complete:
        return 4, f"{argv[0]} last synced {entry.get('synced_at')}, not yet past {opts['--until']}"
    if not complete and (not synced or synced < t - STALE):
        why = f": {entry['error']}" if entry.get("error") else ""
        return 1, f"{argv[0]} last synced {entry.get('synced_at')}, older than {int(STALE.total_seconds() // 60)}m{why}"
    last, _, _ = read_ledger(f'"repo":"{name.lower()}"')
    if last is None:
        return 1, f"no ledger at {LEDGER}"
    newest = {}
    for r in last.values():
        if f"{r['forge']}:{r['repo']}".lower() != key:
            continue
        if "--branch" in opts and r.get("branch") != opts["--branch"]:
            continue
        c = when(r.get("created_at"))
        if (since and (not c or c < since)) or (until and (not c or c > until)):
            continue
        k = r["id"]
        if k not in newest or (r.get("attempt") or 1) >= (newest[k].get("attempt") or 1):
            newest[k] = r
    rows = sorted(newest.values(), key=lambda r: (r.get("created_at") or "", r["id"]))
    return 0, json.dumps(rows, separators=(",", ":"))


def write_json(path, doc):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(doc, f, indent=1)
        f.write("\n")
    os.replace(tmp, path)


def failed_jobs(repo, run, old):
    """Names of the failed jobs of a failed run; reused from the last pass for the same attempt."""
    if run["conclusion"] not in FAILED:
        return []
    if (old and old.get("attempt") == run["attempt"] and old.get("conclusion") == run["conclusion"]
            and old.get("failed_jobs") is not None):
        return old["failed_jobs"]
    try:
        got = gh(f"repos/{repo}/actions/runs/{run['id']}/attempts/{run['attempt']}/jobs?per_page=100")
    except GhError:
        return None  # unknown, asked again next pass
    return [j["name"] for j in got.get("jobs", []) if j.get("conclusion") in FAILED]


def sync_repo(repo, base, prev, t, sched):
    """The state entry of one repo; `sched` is this pass's new scheduled runs."""
    workflows, unscheduled = scheduled_workflows(repo, base, prev)
    paths = {w["path"] for w in workflows}
    old_runs = {r["id"]: (w["path"], r) for w in (prev or {}).get("workflows", []) for r in w.get("runs", [])}
    merged = {rid: pr for rid, pr in old_runs.items() if pr[0] in paths}
    for raw in sched:
        if raw.get("path") in paths:
            merged[raw["id"]] = (raw["path"], run_record(raw))
    for w in workflows:
        mine = [r for p, r in merged.values() if p == w["path"]]
        w["runs"] = sorted(mine, key=lambda r: (r.get("created_at") or "", r["id"]), reverse=True)[:RUNS_KEPT]
        for r in w["runs"]:  # only the kept runs are asked about
            r["failed_jobs"] = failed_jobs(repo, r, old_runs.get(r["id"], (None, None))[1])
    return {"repo": repo, "base": base, "synced_at": iso(t), "error": None,
            "workflows": workflows, "unscheduled": unscheduled}


def cron_field(spec, lo, hi):
    vals = set()
    for part in spec.upper().split(","):
        part, _, step = part.partition("/")
        step = int(step) if step else 1
        if part == "*":
            a, b = lo, hi
        else:
            a, _, b = part.partition("-")
            a = CRON_NAMES[a] if a in CRON_NAMES else int(a)
            b = (CRON_NAMES[b] if b in CRON_NAMES else int(b)) if b else (hi if step > 1 else a)
        vals.update(range(a, b + 1, step))
    return vals


def cron_slots(cron, start, end):
    """The UTC minutes in [start, end) that a 5-field cron fires on, as GitHub reads it (UTC,
    and a day matches on day-of-month OR day-of-week when both are restricted)."""
    f = cron.split()
    if len(f) != 5:
        raise ValueError(cron)
    mins, hours, doms, months = cron_field(f[0], 0, 59), cron_field(f[1], 0, 23), cron_field(f[2], 1, 31), cron_field(f[3], 1, 12)
    dows = {d % 7 for d in cron_field(f[4], 0, 7)}
    either = f[2] != "*" and f[4] != "*"
    out, t = [], start
    while t < end:
        dom, dow = t.day in doms, t.isoweekday() % 7 in dows
        if (t.month in months and t.hour in hours and t.minute in mins
                and ((dom or dow) if either else (dom and dow))):
            out.append(t)
        t += timedelta(minutes=1)
    return out


def pending(name, t, day=None):
    """-> what a nightly:<name> hold still waits for on local date `day` (default: t's);
    empty when it releases."""
    try:
        with open(STATE) as f:
            repos = json.load(f).get("repos", [])
    except (OSError, ValueError, AttributeError):
        return ["no schedules state"]
    entry = next((r for r in repos if name in (r.get("repo"), r.get("repo", "").split("/")[-1])), None)
    if not entry:
        return [f"{name} not in the schedules state"]
    if not entry.get("synced_at") or t - parse_iso(entry["synced_at"]) > STALE:
        return [f"schedules state for {name} stale since {entry.get('synced_at')}"]
    day = day or t.astimezone().date()  # local time; naive datetimes below are local too
    start = datetime(day.year, day.month, day.day).astimezone(timezone.utc)
    end = (datetime(day.year, day.month, day.day) + timedelta(days=1)).astimezone(timezone.utc)
    out = []
    for w in entry.get("workflows", []):
        wf = os.path.basename(w["path"])
        try:
            slots = sorted({s for c in w.get("crons", []) for s in cron_slots(c, start, end)})
        except (ValueError, KeyError):
            out.append(f"{wf} cron unreadable")
            continue
        timeout = timedelta(minutes=w.get("timeout_min") or 0)
        for i, slot in enumerate(slots):
            if slot > t:
                out.append(f"{wf} due {slot.astimezone():%H:%M}")
                break
            upto = slots[i + 1] if i + 1 < len(slots) else end
            run = next((r for r in w.get("runs", []) if r.get("created_at")
                        and slot <= parse_iso(r["created_at"]) < upto), None)
            if run and run.get("status") == "completed":
                continue
            if t < (parse_iso(run["created_at"]) if run else slot) + timeout:
                out.append(f"{wf} {'running' if run else 'not started'}")
                break
    return out


def main(argv):
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if argv and argv[0] == "pending":
        day = None
        if len(argv) == 4 and argv[2] == "--day":
            try:
                day = datetime.strptime(argv[3], "%Y-%m-%d").date()
            except ValueError:
                day = False
        if len(argv) not in (2, 4) or day is False or (len(argv) == 4 and day is None):
            print("schedules-sync: pending <repo> [--day YYYY-MM-DD]", file=sys.stderr)
            return 2
        left = pending(argv[1], now(), day)
        if left:
            print(", ".join(left))
        return 1 if left else 0
    if argv and argv[0] == "runs":
        rc, out = runs(argv[1:], now())
        print(out, file=sys.stdout if rc == 0 else sys.stderr)
        return rc
    if argv and argv[0] != "sync":
        print(f"schedules-sync: unknown verb {argv[0]} (sync, pending, runs, --help)", file=sys.stderr)
        return 2
    try:
        repos = read_repos()
    except OSError as e:
        print(f"schedules-sync: no repo list: {e}", file=sys.stderr)
        return 1
    prev, t, out, bad = read_prev(), now(), [], 0
    last, n, torn = read_ledger()
    sync = read_sync() if last is not None else {}  # no ledger: an ETag would hide its rows
    last = last or {}
    opened = {}  # (forge, repo) -> the oldest run the ledger still has open
    for r in last.values():
        c = when(r.get("created_at")) if r.get("status") != "completed" else None
        if c:
            k = (r["forge"], r["repo"])
            opened[k] = min(opened.get(k, c), c)
    for forge, repo, base, host in repos:
        rows = []
        entry = dict(sync.get(f"{forge}:{repo}") or {})
        p = prev.get(repo) if forge == "github" else None
        try:
            if forge == "forgejo" and "/" not in repo:
                raise GhError(f"forgejo:{host}/{repo}: want forgejo:<host>/<owner/name>")
            if forge == "forgejo":
                rows.extend(forgejo_rows(host, repo, entry, opened.get((forge, repo)), t))
            elif forge == "github":
                since = [opened[(forge, repo)]] if (forge, repo) in opened else []
                since += [parse_iso(r["created_at"]) for w in (p or {}).get("workflows", [])
                          for r in w.get("runs", []) if r.get("status") != "completed" and r.get("created_at")]
                got, etag = fetch_runs(repo, entry, min(since, default=None), t)
                got = got or []
                out.append(sync_repo(repo, base, p, t, [r for r in got if r.get("event") == "schedule"]))
                rows.extend(gh_row(repo, r) for r in got)
                entry["etag"] = etag  # only once its rows are kept: a 304 must not hide them
            else:
                raise GhError(f"unknown forge {forge} (github, forgejo)")
            entry.update(synced_at=iso(t), error=None)
        except GhError as e:
            bad += 1
            print(f"schedules-sync: {repo}: {e}", file=sys.stderr)
            entry["error"] = str(e)
            if forge == "github":
                kept = dict(p or {"repo": repo, "base": base, "synced_at": None, "workflows": []})
                kept["error"] = str(e)
                out.append(kept)
        sync[f"{forge}:{repo}"] = entry
        # Per repo, so a cold pass the service timeout cuts keeps the repos it finished. The
        # ledger goes first: a crash between the two re-reads the repo, it never skips it.
        n, torn = write_ledger(last, n, torn, rows, t), False
        write_json(SYNC, {"generated_at": iso(t), "repos": sync})
    write_json(STATE, {"generated_at": iso(t), "repos": out})
    print(STATE)
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
