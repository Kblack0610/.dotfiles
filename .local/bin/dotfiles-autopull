#!/usr/bin/env bash
# dotfiles-autopull - keep the stowed checkouts current: ~/.dotfiles and the private overlay
# ~/.dotfiles-private (DOTFILES_DIR, DOTFILES_PRIVATE).
#
#   dotfiles-autopull               the shell-start pass (~/.zshrc): every checkout, at most once
#                                   per DOTFILES_AUTOPULL_INTERVAL (6h), silent unless it moves one
#                                   while attached to a terminal
#   dotfiles-autopull --now <path>  agent-land's post-merge step: no throttle, only the checkout whose
#                                   repo holds <path> (a worktree of it counts), one line saying what
#                                   happened; nothing for a repo that is not one of the checkouts
#
# Stow serves the main checkouts, so a merged change is live only once its checkout moves, and a
# file it adds or moves to the other repo only once it has a link: every pass, moved or not (another
# tool may have pulled), runs `dotfiles-deploy --apply --missing`, which links every deploy path of
# both checkouts that resolves to nothing in $HOME (one more line when it linked or failed). It only creates links where nothing resolves; a file in $HOME
# is never replaced. Stow ignores .claude/skills, so `skill-deploy --quiet` runs beside it (one more
# line when it changed a link or failed). A merged Rust change is live only once its binary is rebuilt,
# so every pass also runs `cargo build --release` for each Rust tool linked into ~/.local/bin and
# restarts a running unit named after one whose binary is newer than the unit (agent-web). A
# persistent agentctl runner is one long-lived process that keeps the code it parsed at start, so
# every pass also restarts a running one whose script is newer than its unit (inbox-triage).
# `git merge --ff-only` refuses rather than overwrite a dirty or untracked file, so local work is
# never touched; a refused or diverged checkout stays put and says why (logged too). Fail-soft:
# every path exits 0, so no network or repo state can break a shell start or a landing.

set -uo pipefail

REPOS=("${DOTFILES_DIR:-$HOME/.dotfiles}" "${DOTFILES_PRIVATE:-$HOME/.dotfiles-private}")
THROTTLE_SECS="${DOTFILES_AUTOPULL_INTERVAL:-21600}" # 6h
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles-autopull"
STAMP="$CACHE_DIR/last-pull"
LOG="$CACHE_DIR/autopull.log"
# The public checkout's own copy, so a pull that changed it runs the new one.
DEPLOY="${DOTFILES_DEPLOY:-${REPOS[0]}/.local/bin/dotfiles-deploy}"
SKILL_DEPLOY="${DOTFILES_SKILL_DEPLOY:-${REPOS[0]}/.local/bin/skill-deploy}"
DEPLOY_SECS="${DOTFILES_AUTOPULL_DEPLOY_SECS:-120}"
FETCH_SECS="${DOTFILES_AUTOPULL_FETCH_SECS:-60}"
BUILD_SECS="${DOTFILES_AUTOPULL_BUILD_SECS:-900}" # all builds of one pass; agent-web from clean takes minutes
BIN_DIR="${DOTFILES_AUTOPULL_BIN:-$HOME/.local/bin}"
CONF_DIR="${AGENTCTL_CONF_DIR:-$HOME/.config/agentctl/agents}"

command -v git >/dev/null 2>&1 || exit 0

log() {
  mkdir -p "$CACHE_DIR" 2>/dev/null
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >>"$LOG" 2>/dev/null
}

# capped <secs> <cmd...>: a network call under a time cap, so a hung remote cannot hold a landing or a
# shell start; macOS ships no timeout, and there the call runs uncapped.
capped() {
  if command -v timeout >/dev/null 2>&1; then timeout "$@"; else shift && "$@"; fi
}

# phys <dir> -> its physical path (no realpath on older macOS)
phys() { (cd "$1" 2>/dev/null && pwd -P); }

# say <line>: print it and log it
say() {
  log "$1"
  echo "$1"
}

# log_report <cmd> <rc> <output>: a failed attach step's report goes to the log
log_report() {
  log "$1 exited $2, its report:"
  printf '%s\n' "$3" | tail -n 40 | sed 's/^/    /' >>"$LOG" 2>/dev/null
}

# attach_missing -> one line when it linked anything or failed, nothing otherwise. A move can add a
# tracked file and stow never runs on pull, so link every deploy path (both checkouts) that resolves
# to nothing. Runs once per pass, moved or not. A failure's report goes to the log.
attach_missing() {
  local out rc n
  [ -x "$DEPLOY" ] || return 0
  out=$(DOTFILES="${REPOS[0]}" DOTFILES_PRIVATE="${REPOS[1]}" capped "$DEPLOY_SECS" "$DEPLOY" --apply --missing 2>&1)
  rc=$?
  n=$(printf '%s\n' "$out" | grep -c '^  linked ')
  if [ "$rc" -ne 0 ]; then
    log_report 'dotfiles-deploy --apply --missing' "$rc" "$out"
    say "~: linked $n missing file(s), then dotfiles-deploy --apply --missing failed (exit $rc); report in ${LOG/#"$HOME"/\~}"
  elif [ "$n" -gt 0 ]; then
    say "~: linked $n missing file(s) into \$HOME (dotfiles-deploy --apply --missing)"
  fi
}

# attach_skills -> one line when it changed a link or failed, nothing otherwise. Idempotent and quiet,
# so it needs no check of what the move touched, and a skill a hand pull left unlinked heals too. A
# failure names its skills on the line, a CONFLICT skill-deploy will not resolve for us, and its report
# goes to the log.
attach_skills() {
  local out rc n names
  [ -x "$SKILL_DEPLOY" ] || return 0
  out=$(DOTFILES="${REPOS[0]}" DOTFILES_PRIVATE="${REPOS[1]}" capped "$DEPLOY_SECS" "$SKILL_DEPLOY" --quiet 2>&1)
  rc=$?
  n=$(printf '%s\n' "$out" | grep -cE '^(LINKED|RELINKED|REMOVED) ')
  if [ "$rc" -ne 0 ]; then
    log_report 'skill-deploy --quiet' "$rc" "$out"
    names=$(printf '%s\n' "$out" | awk '$1 == "CONFLICT" || $1 == "FAILED" { print $2 }' | paste -sd ' ' -)
    say "~: updated $n skill link(s), then skill-deploy failed (exit $rc)${names:+ on: $names}; report in ${LOG/#"$HOME"/\~}"
  elif [ "$n" -gt 0 ]; then
    say "~: updated $n skill link(s) in ~/.claude/skills (skill-deploy)"
  fi
}

# mtime <file> -> seconds since the epoch (GNU stat, else BSD stat)
mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null; }

# restart_stale <unit> <file> <what>: a running user <unit> that started before <file> last changed
# still runs the old <what>, so restart it. One line when it restarted or failed.
restart_stale() {
  local unit="$1" state started built
  command -v systemctl >/dev/null 2>&1 || return 0
  state=$(systemctl --user show "$unit" -p ActiveState --value 2>/dev/null)
  [ "$state" = active ] || return 0
  started=$(systemctl --user show "$unit" -p ActiveEnterTimestamp --value --timestamp=unix 2>/dev/null)
  started=${started#@}
  built=$(mtime "$2")
  [[ "$started" =~ ^[0-9]+$ && "$built" =~ ^[0-9]+$ ]] && [ "$built" -gt "$started" ] || return 0
  if systemctl --user restart "$unit" 2>/dev/null; then
    say "~: restarted $unit on the new $3"
  else
    say "~: $unit runs an old $3 and its restart failed: systemctl --user restart $unit"
  fi
}

# attach_rust -> one line per tool it rebuilt or could not build, and per unit it restarted. A link
# in ~/.local/bin into <public checkout>/.local/src/<crate>/target/release/<bin> is a Rust tool
# installed here (build_local_rust_tools writes them). cargo follows path dependencies (hub-core),
# so it rebuilds a tool whatever crate the move touched, and is a no-op of about 0.1s per tool when
# nothing changed; so this runs every pass, moved or not, and a hand pull heals too. All builds share
# one BUILD_SECS budget, since agent-land waits on them. A failed build leaves the binary on disk in
# place, and its report goes to the log; a unit older than that binary is restarted either way.
attach_rust() {
  local link target crate bin before out rc left deadline
  deadline=$(($(date +%s) + BUILD_SECS))
  # A runner's or a unit's PATH often lacks rustup's bin dir.
  command -v cargo >/dev/null 2>&1 || PATH="$HOME/.cargo/bin:$PATH"
  for link in "$BIN_DIR"/*; do
    [ -L "$link" ] || continue
    target=$(readlink "$link")
    case $target in "${REPOS[0]}"/.local/src/*/target/release/*) ;; *) continue ;; esac
    crate=${target%/target/release/*}
    bin=${target##*/}
    [ -f "$crate/Cargo.toml" ] || continue
    left=$((deadline - $(date +%s)))
    if ! command -v cargo >/dev/null 2>&1; then
      say "~: cargo not found, $bin not rebuilt"
    elif [ "$left" -le 0 ]; then
      say "~: build budget of ${BUILD_SECS}s spent, $bin not rebuilt"
    else
      before=$(mtime "$target")
      out=$(cd "$crate" && capped "$left" cargo build --release --quiet 2>&1)
      rc=$?
      if [ "$rc" -ne 0 ]; then
        log_report "cargo build --release ($bin)" "$rc" "$out"
        say "~: cargo build of $bin failed (exit $rc), the binary on disk stays; report in ${LOG/#"$HOME"/\~}"
      elif [ "$(mtime "$target")" != "$before" ]; then
        say "~: rebuilt $bin (cargo build --release)"
      fi
    fi
    restart_stale "$bin.service" "$target" "$bin"
  done
}

# attach_runners -> one line per persistent agentctl runner it restarted. A KIND=persistent conf's
# unit is agentctl@<name>.service, and the first word of its COMMAND is the script it runs ($HOME
# expanded, links followed). A pull that changes that script leaves the running process on the old
# functions, so a merged fix to the runner is not live until its restart: the route prompt of #1815
# filed with the old one for hours (ar-1633). Like a Rust unit, one that is not running stays down.
attach_runners() {
  local conf cmd script
  for conf in "$CONF_DIR"/*.conf; do
    [ -f "$conf" ] && grep -qE '^KIND=persistent([[:space:]]|$)' "$conf" || continue
    cmd=$(sed -n 's/^COMMAND=//p' "$conf" | head -n 1)
    # The first word before $HOME is expanded, so a $HOME with a space in it stays one path.
    cmd=${cmd#[\"\']}
    cmd=${cmd%%[ \"\']*}
    cmd=${cmd/#'${HOME}'/$HOME}
    cmd=${cmd/#'$HOME'/$HOME}
    script=$(readlink -f "$cmd" 2>/dev/null) && [ -f "$script" ] || continue
    restart_stale "agentctl@$(basename "$conf" .conf).service" "$script" "${script##*/}"
  done
}

# attach_all: what every pass runs once, moved or not
attach_all() {
  attach_missing
  attach_skills
  attach_rust
  attach_runners
}

# pull <checkout> -> one line on stdout saying what happened; every outcome but "already current" is
# logged, so the silent shell pass leaves a trace of a checkout it could not move.
pull() {
  local repo=$1 name branch head up out files
  name=${repo/#"$HOME"/\~}
  if git -C "$repo" rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 ||
    [ -d "$repo/.git/rebase-merge" ] || [ -d "$repo/.git/rebase-apply" ]; then
    say "$name: mid-merge or mid-rebase, left alone"
    return
  fi
  branch=$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null) || {
    say "$name: detached HEAD, left alone"
    return
  }
  git -C "$repo" rev-parse --quiet --verify '@{u}' >/dev/null 2>&1 || {
    say "$name: $branch has no upstream, left alone"
    return
  }
  capped "$FETCH_SECS" git -C "$repo" fetch --quiet 2>/dev/null || {
    say "$name: fetch failed, $branch left at $(git -C "$repo" rev-parse --short HEAD 2>/dev/null)"
    return
  }
  head=$(git -C "$repo" rev-parse HEAD 2>/dev/null) && up=$(git -C "$repo" rev-parse '@{u}' 2>/dev/null) || return
  if [ "$head" = "$up" ]; then
    echo "$name: $branch already current at ${head:0:8}"
    return
  fi
  if ! git -C "$repo" merge-base --is-ancestor HEAD '@{u}' 2>/dev/null; then
    say "$name: not fast-forwarded, $branch has local commits its upstream lacks"
  elif out=$(git -C "$repo" merge --ff-only '@{u}' 2>&1); then
    say "$name: fast-forwarded $branch ${head:0:8}..${up:0:8}"
    # A move may have advanced submodule pointers (android-suite): check them out so their links do
    # not dangle. HTTPS avoids SSH:22 hangs on networks that block it; capped and fail-soft.
    capped 120 git -C "$repo" -c url."https://github.com/".insteadOf="git@github.com:" \
      submodule update --init --recursive --quiet >/dev/null 2>&1 || true
  else
    # git lists each file it refused to overwrite, dirty or untracked, on its own tab-indented line.
    files=$(printf '%s\n' "$out" | awk 'sub(/^\t/, "")' | paste -sd ' ' -)
    if [ -n "$files" ]; then
      say "$name: not fast-forwarded, $branch stays at ${head:0:8}: local files in the way: $files"
    else
      say "$name: not fast-forwarded, $branch stays at ${head:0:8}: $(printf '%s\n' "$out" | tail -n 1)"
    fi
  fi
}

if [ "${1:-}" = --now ]; then
  common=$(git -C "${2:-.}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
  common=$(phys "$common") || exit 0
  for repo in "${REPOS[@]}"; do
    [ -d "$repo/.git" ] && [ "$(phys "$repo/.git")" = "$common" ] || continue
    line=$(pull "$repo")
    echo "$line"
    attach_all
    exit 0
  done
  exit 0
fi

# Throttle: at most once per THROTTLE_SECS. Stamp BEFORE the network calls so an offline or hung
# fetch does not retry on every single shell.
now=$(date +%s)
if [ -f "$STAMP" ]; then
  last=$(cat "$STAMP" 2>/dev/null || echo 0)
  [ "$((now - last))" -lt "$THROTTLE_SECS" ] && exit 0
fi
mkdir -p "$CACHE_DIR"
echo "$now" >"$STAMP"

for repo in "${REPOS[@]}"; do
  [ -d "$repo/.git" ] || continue
  line=$(pull "$repo")
  # Only speak in the foreground: backgrounded from .zshrc it stays silent.
  if [[ -t 1 && "$line" == *": fast-forwarded "* ]]; then echo "$line"; fi
done
# Every pass attaches, moved or not: a checkout another tool pulled moved without this script, and
# its new files would otherwise never link.
line=$(attach_all)
[[ ! -t 1 || -z "$line" ]] || echo "$line"
exit 0
