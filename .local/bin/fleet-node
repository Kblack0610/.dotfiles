#!/usr/bin/env bash
# fleet-node - make this machine a fleet node, and say what it still lacks.
#
# Usage:
#   fleet-node install [--no-sudo] [install.sh args]
#       the whole agent runtime, unattended: install.sh --yes --only base,fleet,dotfiles.
#       A native host and any image built later run this one definition.
#   fleet-node signin
#       what only the human can do here, one line each: each Claude account with no setup
#       token, gh, the private overlay, codex, rbw. Prints nothing and exits 0 when none is left.
#   fleet-node ready
#       whether this peer can hold the fleet lease and run every singleton lane, checked here
#       rather than found missing at failover: one line per need it lacks (each signin line,
#       a dotfiles checkout behind origin/main, a store remote it cannot reach, a home-k3s call
#       the lanes make that its kubeconfig may not, agent-web), exit 1; nothing and exit 0 when
#       it lacks none. It fetches both dotfiles checkouts and asks the store remotes and the
#       cluster, so it takes seconds.
#   fleet-node ready claude
#       exit 0 when every Claude account has a token here: fleet-dispatch's kit check.
#
# Logins are never copied by this script (Auth-State Safety): the human pushes each token.
set -euo pipefail

here=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
dotfiles=$(cd "$here/../.." && pwd)
# The accounts file claude-acct itself reads (its CONF), so the two cannot name different accounts.
accounts="${CLAUDE_ACCT_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/claude-acct/accounts}"

# unsigned_accounts -> one line per Claude account with no setup token readable here. A token is an
# account's only sign-in (claude-acct has no /login), so this asks claude-acct's one reader, which
# looks in rbw and then in the copy `claude-acct token push` left on this machine.
unsigned_accounts() {
  local name dir
  [ -r "$accounts" ] || { echo "no claude-acct accounts file at $accounts: stow the dotfiles"; return 0; }
  while read -r name dir; do
    case "$name" in '' | '#'*) continue ;; esac
    "$here/claude-acct" token "$name" >/dev/null 2>&1 ||
      echo "sign in account $name: from a machine with rbw unlocked, claude-acct token push $(uname -n | cut -d. -f1)"
  done <"$accounts"
}

# missing -> one line per thing the human still has to do on this node.
missing() {
  unsigned_accounts
  [ -s "${GH_CONFIG_DIR:-$HOME/.config/gh}/hosts.yml" ] || echo "sign in to GitHub: gh auth login"
  [ -d "$HOME/.dotfiles-private/.git" ] ||
    echo "clone the private overlay: gh repo clone Kblack0610/.dotfiles-private ~/.dotfiles-private, then ~/.dotfiles-private/.local/bin/restore-private-state"
  [ -s "${CODEX_HOME:-$HOME/.codex}/auth.json" ] || echo "sign in to codex: codex login"
  # rbw keeps its vault copy in its cache dir once `rbw login` has run; config alone is not a sign-in.
  local rbw_db="${XDG_CACHE_HOME:-$HOME/.cache}/rbw${RBW_PROFILE:+-$RBW_PROFILE}"
  if ! command -v rbw >/dev/null 2>&1; then
    echo "install rbw and sign in: install.sh --only secrets, then rbw login"
  elif [ -z "$(ls -A "$rbw_db" 2>/dev/null)" ]; then
    echo "sign in to rbw: rbw login"
  fi
  return 0
}

# behind -> one line per stowed dotfiles checkout below origin/main, fetched first (a failed fetch
# reads the last one). dotfiles-drift owns the comparison, including the grace a merge gets while
# its pull is in flight.
behind() {
  local pub="${DOTFILES_DIR:-$HOME/.dotfiles}" priv="${DOTFILES_PRIVATE:-$HOME/.dotfiles-private}" repo
  for repo in "$pub" "$priv"; do
    [ ! -e "$repo/.git" ] || timeout 30 git -C "$repo" fetch -q origin main >/dev/null 2>&1 || true
  done
  { DOTFILES="$pub" DOTFILES_PRIVATE="$priv" "$here/dotfiles-drift" --json 2>/dev/null || true; } |
    jq -r --arg pub "$pub" --arg priv "$priv" '.findings[]? | select(.type == "BEHIND")
      | (if .repo == "public" then $pub else $priv end) as $p
      | "\($p) is behind origin/main (\(.detail)): dotfiles-autopull --now \($p)"' 2>/dev/null || true
}

# store_unreachable -> one line per agent store remote this peer cannot reach the way store-sync and
# fleet-lease do (store-remote.sh): a holder renews the lease and syncs through both.
store_unreachable() {
  # shellcheck source=../lib/store-remote.sh
  . "$here/../lib/store-remote.sh"
  load_conf
  [ -n "$STORE_PRIMARY_URL$STORE_BACKUP_URL" ] || { echo "no store remotes in $CONF: stow the private overlay"; return 0; }
  local r url
  for r in origin backup; do
    case "$r" in origin) url=$STORE_PRIMARY_URL ;; *) url=$STORE_BACKUP_URL ;; esac
    if [ -z "$url" ]; then echo "no $r store remote in $CONF"
    elif ! timeout 30 bash -c '. "$1"; shift; net "$@"' _ "$here/../lib/store-remote.sh" "$r" ls-remote "$url" HEAD >/dev/null 2>&1; then
      echo "cannot reach the $r store remote ($url) the way store-sync does"
    fi
  done
  return 0
}

# The home-k3s calls the singleton lanes make, one of each kind, as "<can-i args>|<who makes it>".
# home-config grants them to the scoped account (apps/github-runner-exporter/fleet-read-rbac.yaml,
# apps/binks-api/fleet-read-rbac.yaml, apps/agents/record-rbac.yaml); a call a lane adds gets its
# grant there and its line here.
KUBE_NEEDS=(
  "patch endpoints/agents -n agents|agent-web-record points the agents Endpoints at the holder"
  "get configmaps/ci-runner-governor-override -n monitoring|fleet-bench triage reads the governor's pins"
  "get services/victoria-metrics:8428 --subresource=proxy -n monitoring|fleet-bench and agent-web read VictoriaMetrics"
  "get services/loki:3100 --subresource=proxy -n monitoring|fleet-state's hub needs reads Loki"
  "get services/github-runner-exporter:9320 --subresource=proxy -n monitoring|schedules-sync reads the runner feed"
  "get cronjobs/cluster-janitor -n cluster-janitor|the Sentinel cluster-janitor-alive watch"
  "get services/binks-api:80 --subresource=proxy -n binks-api|the Sentinel binks metrics watches"
  "get deployments -n binks-api|release-state reads what is deployed"
  "list nodes|the Sentinel node watches"
  "list nodes.metrics.k8s.io|the Sentinel node-memory watch (kubectl top nodes)"
  "list vulnerabilityreports.aquasecurity.github.io -A|the Sentinel trivy-criticals watch"
)

# kube_needs -> one line per home-k3s call above that this peer's kubeconfig (fleet_kubeconfig)
# may not make, or one line when it cannot ask at all.
kube_needs() {
  command -v kubectl >/dev/null 2>&1 || { echo "kubectl is not installed: the singleton lanes read home-k3s with it"; return 0; }
  # shellcheck source=../lib/fleet-kubeconfig.sh
  . "$here/../lib/fleet-kubeconfig.sh"
  local kcfg need args who out err
  kcfg=$(fleet_kubeconfig)
  [ -r "${kcfg%%:*}" ] || { echo "no kubeconfig for home-k3s at $kcfg: the home-config fleet-worker play writes the scoped one"; return 0; }
  err=$(mktemp)
  for need in "${KUBE_NEEDS[@]}"; do
    args=${need%%|*} who=${need#*|}
    # can-i answers yes or no on stdout; a warning (a cluster-scoped kind under a namespaced context)
    # or the reason it could not ask goes to stderr.
    # shellcheck disable=SC2086 # args is a word list
    out=$(KUBECONFIG="$kcfg" kubectl --context home-k3s --request-timeout=10s auth can-i $args 2>"$err")
    case "$out" in
      yes) ;;
      no*) echo "the kubeconfig at $kcfg may not $args: $who (home-config fleet-read-rbac.yaml)" ;;
      *) echo "cannot ask home-k3s with the kubeconfig at $kcfg: $(grep -v '^Warning:' "$err" | head -n 1)"; break ;;
    esac
  done
  rm -f "$err"
  return 0
}

# web_needs -> what agent-web lacks here: the holder serves it (home-config fleet-worker tasks/peer.yml).
web_needs() {
  # The path its unit runs, not PATH: over ssh, PATH has no ~/.local/bin.
  [ -x "$HOME/.local/bin/agent-web" ] || echo "agent-web is not installed: the home-config fleet-worker play builds it"
  [ -s "$HOME/.config/agent-web/oauth.json" ] ||
    echo "write ~/.config/agent-web/oauth.json (0600) from rbw item agent-web-oauth-client"
  if [ ! -e "$HOME/.config/systemd/user/agent-web.service" ] || [ ! -e "$HOME/.config/agent-web/env" ]; then
    echo "agent-web's unit and env file are not stowed: stow the private overlay"
  fi
  return 0
}

# lease_needs -> every line `fleet-node ready` prints.
lease_needs() {
  missing
  behind
  store_unreachable
  kube_needs
  web_needs
}

case "${1:-}" in
  install)
    shift
    exec bash "$dotfiles/.local/src/installation_scripts/install.sh" --yes --only base,fleet,dotfiles "$@"
    ;;
  signin)
    out=$(missing)
    [ -z "$out" ] || { printf '%s\n' "$out"; exit 1; }
    ;;
  ready)
    if [ "${2:-}" = claude ]; then
      [ -z "$(unsigned_accounts)" ]
      exit
    fi
    out=$(lease_needs)
    [ -z "$out" ] || { printf '%s\n' "$out"; exit 1; }
    ;;
  -h | --help | help)
    sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "$0"
    ;;
  *)
    echo "usage: fleet-node install|signin|ready [claude]" >&2
    exit 2
    ;;
esac
