#!/usr/bin/env bash
# agent-hold - a fleet-wide pause on a shared resource, held as state instead of sent as
# a message.
#
#   agent-hold set <resource> [--roster a,b,c] [--by name] "<reason>"
#   agent-hold claim <resource> [--by name] [--class c] "<what>"   one session's exclusive
#                                   use: fails while another session holds it, and the
#                                   holder's own `check` passes (the agent machine's desktop:
#                                   mac-desktop); --class says why it needs it (`classes`)
#   agent-hold classes              class<TAB>rank<TAB>meaning, best first: who takes a
#                                   claimed resource next (agent-queue desk:<class>)
#   agent-hold grant <resource> <session>...   GO for those sessions while the hold stays
#   agent-hold lower <resource> <pid>...   CPUWeight=1 on each pid's tmux pane scope or
#                                   agentctl unit, recorded on the hold; release restores it
#   agent-hold release <resource>
#   agent-hold check <resource>     exit 1 (and print the hold) while held, 0 when free or
#                                   when the caller's session has been granted
#   agent-hold list                 resource<TAB>since<TAB>by<TAB>reason, one per hold
#   agent-hold show <resource>      print the hold file
#
# One file per hold in ~/.agent/holds/ (AGENT_HOLD_DIR overrides), flat `key: value`.
# A hold is state, not a message, because shell loops have no inbox and new sessions miss
# a broadcast: the gate, the preflight and the coordinator all read this one file. Why and
# how to use it: the fleet-comms and fleet-pace skills.
#
# A grant is GO as state: a staged restart lets a few sessions back in while the hold stays
# set for the rest. It lives in the hold file, so it ends with the hold, and a new `set`
# starts with no grants. Before this, GO was a message telling a session to run with
# UNITY_TEST_IGNORE_HOLD=1, a flag that never expired: on 2026-10-28 all 6 Unity runs live
# under a hold carried it.
#
# `lower` slows a consumer by its cgroup, not its nice: ananicy-cpp types bash and zsh nice
# -4 and re-applies that to each new child, so a reniced bats run's new shells came back at
# -4 (2026-11-07: 583 threads reniced under 20 sessions, ni share stayed 0.4%). Nice only
# orders tasks inside one cgroup; each tmux pane is its own systemd scope, so a CPUWeight
# on the scope holds for every process in it, whatever its nice.

set -uo pipefail

HOLD_ROOT="${AGENT_HOLD_DIR:-$HOME/.agent/holds}"
PROC_ROOT="${AGENT_HOLD_PROC:-/proc}"
# 1 of the default 100: a held scope gets about 1% of a contended CPU, near nice 19's share.
LOW_CPU_WEIGHT=1
# Desk classes, best first: why a session needs a claimed resource, and so who takes it next
# once it is free (agent-queue starts the best-ranked `desk:<class>` waiter). auth ranks first
# only while the human is here, since a 2FA prompt with nobody to answer it holds the desktop
# for nothing. A live claim is never taken over: preempting a session mid-form breaks both
# forms. Release builds are not here: they run over ssh and never claim the desktop.
DESK_CLASSES='auth	1	the human must answer now: a 2FA code, passkey, CAPTCHA or Allow prompt
legal	2	partner and developer program sign-ups, agreements, tax, bank, content ratings
release	3	console steps a release waits on: first upload, app record, depot or branch, review submit
listing	4	store text, art, screenshots
other	5	setup, exploration, anything else (the default)'

# class_rank <class> -> its rank, nothing for an unknown class
class_rank() { awk -F'\t' -v c="$1" '$1 == c { print $2 }' <<<"$DESK_CLASSES"; }

# shellcheck source=../lib/fmt.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/fmt.sh"
# shellcheck source=../lib/audit.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/audit.sh"

# collapse a value to a single physical line (files are one key:value per line)
oneline() { printf '%s' "$1" | tr '\n\t' '  ' | sed -E 's/  +/ /g; s/^ +//; s/ +$//'; }

# field <file> <key> -> first value (text after "key: ")
field() { sed -n "s/^$2: //p" "$1" 2>/dev/null | head -1; }

# A resource is one path segment. Anything else could escape HOLD_ROOT.
valid_resource() {
  case "$1" in
    ''|.|..|*/*) return 1 ;;
  esac
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]
}

need_resource() {
  valid_resource "${1:-}" || { echo "agent-hold: bad resource name '${1:-}' (letters, digits, . _ -)" >&2; exit 2; }
}

# Who is holding: the tmux session when there is one (that is the name ListAgents and the
# panel show), else the working directory's basename.
default_by() {
  local s=""
  [ -n "${TMUX:-}" ] && s="$(tmux display-message -p '#S' 2>/dev/null)"
  printf '%s' "${s:-${PWD##*/}}"
}

notify() { agent-notify "$@" >/dev/null 2>&1 || true; }

# set_field <file> <key> <value>: replace one key line atomically, keeping the rest. The
# rename is also the wake-up: a gate waiting on the hold dir sees it and re-checks.
set_field() {
  local f="$1" tmp
  tmp="$(mktemp "$HOLD_ROOT/.${f##*/}.XXXXXX")" || return 1
  { grep -v "^$2:" "$f"; printf '%s: %s\n' "$2" "$3"; } > "$tmp"
  mv "$tmp" "$f"
}

cmd_set() {
  local resource="${1:-}"; shift || true
  need_resource "$resource"
  local roster="" by="" reason=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --roster) roster="${2:-}"; shift 2 ;;
      --by)     by="${2:-}"; shift 2 ;;
      --) shift; reason="$*"; break ;;
      -*) echo "agent-hold set: unknown flag $1" >&2; exit 2 ;;
      *)  reason="$*"; break ;;
    esac
  done
  [ -n "$reason" ] || { echo "agent-hold set: say why (the reason is what every reader sees)" >&2; exit 2; }
  [ -n "$by" ] || by="$(default_by)"
  mkdir -p "$HOLD_ROOT" || { echo "agent-hold: cannot mkdir $HOLD_ROOT" >&2; exit 1; }

  local f="$HOLD_ROOT/$resource" tmp lowered
  # A re-set keeps what `lower` changed, so the release that ends it still restores it.
  lowered="$(field "$f" lowered)"
  tmp="$(mktemp "$HOLD_ROOT/.${resource}.XXXXXX")" || exit 1
  {
    printf 'resource: %s\n' "$resource"
    printf 'since: %s\n'    "$(now_iso)"
    printf 'by: %s\n'       "$(oneline "$by")"
    printf 'roster: %s\n'   "$(oneline "$roster")"
    printf 'granted: \n'
    [ -n "$lowered" ] && printf 'lowered: %s\n' "$lowered"
    printf 'reason: %s\n'   "$(oneline "$reason")"
  } > "$tmp"
  # Re-setting an existing hold replaces it (new reason, new roster, no grants),
  # atomically, so a reader never sees half a file.
  mv "$tmp" "$f"
  # Low on set and on release: fleet-pace sets and lifts holds itself, so a hold is the
  # fleet pacing itself, not something the human acts on. At high it was 10 of the phone's
  # 270 pages in 48h (2026-10-28). The hold still shows in the briefing and the preflight.
  notify -p low -t "hold: $resource" "$(oneline "$reason") (by $(oneline "$by"))"
  audit_append "$(oneline "$by")" hold.placed "$resource" ok "$(oneline "$reason")"
  echo "held: $resource"
}

# claim: a hold that one session takes for its own use, so two sessions never drive the
# same desktop at once. Unlike `set`, it never replaces someone else's hold: the file is
# created with noclobber, so of two racing claims exactly one wins. Re-claiming your own
# refreshes it. A claim left by a dead session is released by whoever finds it.
cmd_claim() {
  local resource="${1:-}"; shift || true
  need_resource "$resource"
  local by="" reason="" class=other
  while [ $# -gt 0 ]; do
    case "$1" in
      --by) by="${2:-}"; shift 2 ;;
      --class) class="${2:-}"; shift 2 ;;
      --) shift; reason="$*"; break ;;
      -*) echo "agent-hold claim: unknown flag $1" >&2; exit 2 ;;
      *)  reason="$*"; break ;;
    esac
  done
  [ -n "$reason" ] || { echo "agent-hold claim: say what you are doing with it" >&2; exit 2; }
  [ -n "$(class_rank "$class")" ] || { echo "agent-hold claim: unknown class '$class' (agent-hold classes)" >&2; exit 2; }
  [ -n "$by" ] || by="$(default_by)"
  by="$(oneline "$by")"
  mkdir -p "$HOLD_ROOT" || { echo "agent-hold: cannot mkdir $HOLD_ROOT" >&2; exit 1; }
  local f="$HOLD_ROOT/$resource" body
  body="$(printf 'resource: %s\nkind: claim\nclass: %s\nsince: %s\nby: %s\nroster: \ngranted: \nreason: %s\n' \
    "$resource" "$class" "$(now_iso)" "$by" "$(oneline "$reason")")"
  if [ -f "$f" ] && [ "$(field "$f" by)" = "$by" ]; then
    printf '%s\n' "$body" > "$f"; echo "claimed: $resource (refreshed)"; return 0
  fi
  if ( set -o noclobber; printf '%s\n' "$body" > "$f" ) 2>/dev/null; then
    echo "claimed: $resource"; return 0
  fi
  # The holder keeps it; a better class is told it starts next, not that it may take over.
  local held; held="$(field "$f" class)"
  local outrank=""
  [ -n "$held" ] && [ "$(class_rank "$class")" -lt "$(class_rank "$held")" ] &&
    outrank=" (you outrank it: requeue with --class $class, it starts next)"
  echo "busy: $resource since $(field "$f" since) by $(field "$f" by)${held:+ ($held)}: $(field "$f" reason)$outrank" >&2
  return 1
}

# Who is asking, for `check`: the same name `set` records as `by`, which is also the name
# the shepherd and fleet-sessions use for a session.
caller() { default_by; }

# in_list <name> <a,b,c>
in_list() { case ",$2," in *",$1,"*) return 0 ;; esac; return 1; }

cmd_grant() {
  local resource="${1:-}"; shift || true
  need_resource "$resource"
  [ $# -gt 0 ] || { echo "agent-hold grant: name at least one session" >&2; exit 2; }
  local f="$HOLD_ROOT/$resource"
  [ -f "$f" ] || { echo "agent-hold: $resource is not held, nothing to grant" >&2; exit 1; }
  local granted name
  granted="$(field "$f" granted)"
  for name in "$@"; do
    name="$(oneline "$name")"
    [ -n "$name" ] || continue
    case "$name" in *,*) echo "agent-hold grant: bad session name '$name'" >&2; exit 2 ;; esac
    in_list "$name" "$granted" || granted="${granted:+$granted,}$name"
  done
  set_field "$f" granted "$granted" || exit 1
  notify -p normal -t "go: $resource" "granted $*; the rest stay held"
  audit_append "$(default_by)" hold.granted "$resource" ok "$*"
  echo "granted: $resource for $granted"
}

# unit_of <pid|self> -> the user unit a process runs in: the tmux pane scope or agentctl unit
# on its cgroup path when there is one (a run started with `systemd-run --scope` from a
# pane sits in a scope nested inside the pane's), else the innermost .scope or .service.
# Exit 1 when the process is gone, 2 when it is not under this user's manager.
unit_of() {
  local path part unit="" batch=""
  path="$(sed -n 's/^0:://p' "$PROC_ROOT/$1/cgroup" 2>/dev/null)" || return 1
  [ -n "$path" ] || return 1
  case "$path" in */user@"$(id -u)".service/*) ;; *) return 2 ;; esac
  path="${path#*/user@"$(id -u)".service/}"
  local IFS=/
  for part in $path; do
    case "$part" in
      tmux-spawn-*.scope|agentctl@*.service) batch="${batch:-$part}" ;;
      *.scope|*.service) unit="$part" ;;
    esac
  done
  unit="${batch:-$unit}"
  [ -n "$unit" ] || return 2
  printf '%s' "$unit"
}

cmd_lower() {
  local resource="${1:-}"; shift || true
  need_resource "$resource"
  [ $# -gt 0 ] || { echo "agent-hold lower: name at least one pid" >&2; exit 2; }
  local f="$HOLD_ROOT/$resource"
  [ -f "$f" ] || { echo "agent-hold: $resource is not held; set it first, so its release restores what lower changes" >&2; exit 1; }
  # A claim is one session's use of a desktop, not a load hold, and its refresh rewrites
  # the file whole, so nothing recorded on it would survive to the release.
  [ "$(field "$f" kind)" = claim ] && { echo "agent-hold lower: $resource is a claim, not a load hold" >&2; exit 2; }
  local lowered pid unit self rc=0 err
  lowered="$(field "$f" lowered)"
  self="$(unit_of self)"
  for pid in "$@"; do
    [[ "$pid" =~ ^[0-9]+$ ]] || { echo "agent-hold lower: bad pid '$pid'" >&2; rc=2; continue; }
    unit="$(unit_of "$pid")"; err=$?
    case "$err" in
      1) echo "agent-hold lower: no process $pid" >&2; [ "$rc" -gt 1 ] || rc=1; continue ;;
      2) echo "agent-hold lower: pid $pid is not under this user's systemd manager; left alone" >&2; [ "$rc" -gt 1 ] || rc=1; continue ;;
    esac
    # Only units that are batch work: a desktop terminal's or app's scope is the human's,
    # and the caller's own pane would slow the pass that has to lift the hold.
    case "$unit" in
      tmux-spawn-*.scope|agentctl@*.service) ;;
      *) echo "agent-hold lower: pid $pid runs in $unit, not a tmux pane or agentctl unit; left alone" >&2; [ "$rc" -gt 1 ] || rc=1; continue ;;
    esac
    [ "$unit" = "$self" ] && { echo "agent-hold lower: pid $pid is in this pane ($unit); left alone" >&2; [ "$rc" -gt 1 ] || rc=1; continue; }
    if in_list "$unit" "$lowered"; then echo "lowered: $unit (pid $pid, already)"; continue; fi
    # Recorded before it is applied, so no interrupted run leaves a unit lowered that the
    # release does not know about. Restoring a unit that was never lowered is harmless.
    lowered="${lowered:+$lowered,}$unit"
    set_field "$f" lowered "$lowered" || exit 1
    systemctl --user set-property --runtime "$unit" "CPUWeight=$LOW_CPU_WEIGHT" ||
      { echo "agent-hold lower: systemctl could not set CPUWeight on $unit" >&2; [ "$rc" -gt 1 ] || rc=1; continue; }
    echo "lowered: $unit (pid $pid)"
  done
  return "$rc"
}

cmd_release() {
  local resource="${1:-}"
  need_resource "$resource"
  local f="$HOLD_ROOT/$resource"
  [ -f "$f" ] || { echo "agent-hold: $resource is not held" >&2; exit 1; }
  local reason roster
  reason="$(field "$f" reason)"; roster="$(field "$f" roster)"
  local unit failed=""
  for unit in $(field "$f" lowered | tr ',' ' '); do
    # An empty CPUWeight= drops the runtime setting. A pane closed since has no scope left.
    if systemctl --user set-property --runtime "$unit" CPUWeight=; then
      echo "restored: $unit"
    elif [ "$(systemctl --user show -p LoadState --value "$unit" 2>/dev/null)" = not-found ]; then
      echo "gone: $unit"
    else
      failed="${failed:+$failed,}$unit"
    fi
  done
  # The hold file is the only record of what is still lowered, so it stays until each
  # live unit is restored.
  if [ -n "$failed" ]; then
    set_field "$f" lowered "$failed"
    echo "agent-hold release: could not restore $failed; $resource stays held, release it again" >&2
    return 1
  fi
  rm -f "$f"
  notify -p low -t "go: $resource" "released (was: $reason)"
  audit_append "$(default_by)" hold.released "$resource" ok "was: $reason"
  echo "released: $resource"
  # Printed so the caller can send GO to exactly the sessions that were told to stop.
  [ -n "$roster" ] && echo "roster: $roster"
  return 0
}

cmd_check() {
  local resource="${1:-}"
  need_resource "$resource"
  local f="$HOLD_ROOT/$resource"
  [ -f "$f" ] || return 0
  local me
  me="$(caller)"
  if [ -n "$me" ] && [ "$(field "$f" kind)" = claim ] && [ "$(field "$f" by)" = "$me" ]; then
    echo "claimed: $resource by $me" >&2
    return 0
  fi
  if [ -n "$me" ] && in_list "$me" "$(field "$f" granted)"; then
    echo "granted: $resource for $me" >&2
    return 0
  fi
  echo "held: $resource since $(field "$f" since) by $(field "$f" by): $(field "$f" reason)"
  return 1
}

cmd_list() {
  [ -d "$HOLD_ROOT" ] || return 0
  local f g c
  for f in "$HOLD_ROOT"/*; do
    [ -f "$f" ] || continue
    g="$(field "$f" granted)" c="$(field "$f" class)"
    printf '%s\t%s\t%s\t%s%s%s\n' "${f##*/}" "$(field "$f" since)" "$(field "$f" by)" "${c:+[$c] }" "$(field "$f" reason)" "${g:+ (granted: $g)}"
  done
}

cmd_show() {
  local resource="${1:-}"
  need_resource "$resource"
  cat "$HOLD_ROOT/$resource" 2>/dev/null || { echo "agent-hold: $resource is not held" >&2; exit 1; }
}

cmd_classes() { printf '%s\n' "$DESK_CLASSES"; }

usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; }

verb="${1:-}"; shift || true
case "$verb" in
  set)     cmd_set "$@" ;;
  claim)   cmd_claim "$@" ;;
  grant)   cmd_grant "$@" ;;
  lower)   cmd_lower "$@" ;;
  release) cmd_release "$@" ;;
  check)   cmd_check "$@" ;;
  list)    cmd_list ;;
  classes) cmd_classes ;;
  show)    cmd_show "$@" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
