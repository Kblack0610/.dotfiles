#!/usr/bin/env bash
# agent-hold - a fleet-wide pause on a shared resource, held as state instead of sent as
# a message.
#
#   agent-hold set <resource> [--roster a,b,c] [--by name] "<reason>"
#   agent-hold grant <resource> <session>...   GO for those sessions while the hold stays
#   agent-hold release <resource>
#   agent-hold check <resource>     exit 1 (and print the hold) while held, 0 when free or
#                                   when the caller's session has been granted
#   agent-hold list                 resource<TAB>since<TAB>by<TAB>reason, one per hold
#   agent-hold show <resource>      print the hold file
#
# One file per hold in ~/.agent/holds/ (AGENT_HOLD_DIR overrides), flat `key: value`.
# A hold is state, not a message, because shell loops have no inbox and new sessions miss
# a broadcast: the gate, the preflight and the coordinator all read this one file. Why and
# how to use it: the fleet-comms and fleet-overseer skills.
#
# A grant is GO as state: a staged restart lets a few sessions back in while the hold stays
# set for the rest. It lives in the hold file, so it ends with the hold, and a new `set`
# starts with no grants. Before this, GO was a message telling a session to run with
# UNITY_TEST_IGNORE_HOLD=1, a flag that never expired: on 2026-10-28 all 6 Unity runs live
# under a hold carried it.

set -uo pipefail

HOLD_ROOT="${AGENT_HOLD_DIR:-$HOME/.agent/holds}"

now_iso() { date +%Y-%m-%dT%H:%M:%S%z; }

# collapse a value to a single physical line (files are one key:value per line)
oneline() { printf '%s' "$1" | tr '\n\t' '  ' | sed -E 's/  +/ /g; s/^ +//; s/ +$//'; }

# field <file> <key> -> first value (text after "key: ")
field() { sed -n "s/^$2: //p" "$1" 2>/dev/null | head -1; }

# A resource is one path segment. Anything else could escape HOLD_ROOT.
valid_resource() {
  case "$1" in
    ''|.|..|*/*) return 1 ;;
  esac
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]
}

need_resource() {
  valid_resource "${1:-}" || { echo "agent-hold: bad resource name '${1:-}' (letters, digits, . _ -)" >&2; exit 2; }
}

# Who is holding: the tmux session when there is one (that is the name ListAgents and the
# panel show), else the working directory's basename.
default_by() {
  local s=""
  [ -n "${TMUX:-}" ] && s="$(tmux display-message -p '#S' 2>/dev/null)"
  printf '%s' "${s:-${PWD##*/}}"
}

notify() { agent-notify "$@" >/dev/null 2>&1 || true; }

cmd_set() {
  local resource="${1:-}"; shift || true
  need_resource "$resource"
  local roster="" by="" reason=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --roster) roster="${2:-}"; shift 2 ;;
      --by)     by="${2:-}"; shift 2 ;;
      --) shift; reason="$*"; break ;;
      -*) echo "agent-hold set: unknown flag $1" >&2; exit 2 ;;
      *)  reason="$*"; break ;;
    esac
  done
  [ -n "$reason" ] || { echo "agent-hold set: say why (the reason is what every reader sees)" >&2; exit 2; }
  [ -n "$by" ] || by="$(default_by)"
  mkdir -p "$HOLD_ROOT" || { echo "agent-hold: cannot mkdir $HOLD_ROOT" >&2; exit 1; }

  local f="$HOLD_ROOT/$resource" tmp
  tmp="$(mktemp "$HOLD_ROOT/.${resource}.XXXXXX")" || exit 1
  {
    printf 'resource: %s\n' "$resource"
    printf 'since: %s\n'    "$(now_iso)"
    printf 'by: %s\n'       "$(oneline "$by")"
    printf 'roster: %s\n'   "$(oneline "$roster")"
    printf 'granted: \n'
    printf 'reason: %s\n'   "$(oneline "$reason")"
  } > "$tmp"
  # Re-setting an existing hold replaces it (new reason, new roster), atomically, so a
  # reader never sees half a file.
  mv "$tmp" "$f"
  # Low on set and on release: fleet-overseer sets and lifts holds itself, so a hold is the
  # fleet pacing itself, not something the human acts on. At high it was 10 of the phone's
  # 270 pages in 48h (2026-10-28). The hold still shows in the briefing and the preflight.
  notify -p low -t "hold: $resource" "$(oneline "$reason") (by $(oneline "$by"))"
  echo "held: $resource"
}

# Who is asking, for `check`: the same name `set` records as `by`, which is also the name
# the shepherd and fleet-sessions use for a session.
caller() { default_by; }

# in_list <name> <a,b,c>
in_list() { case ",$2," in *",$1,"*) return 0 ;; esac; return 1; }

cmd_grant() {
  local resource="${1:-}"; shift || true
  need_resource "$resource"
  [ $# -gt 0 ] || { echo "agent-hold grant: name at least one session" >&2; exit 2; }
  local f="$HOLD_ROOT/$resource"
  [ -f "$f" ] || { echo "agent-hold: $resource is not held, nothing to grant" >&2; exit 1; }
  local granted name tmp
  granted="$(field "$f" granted)"
  for name in "$@"; do
    name="$(oneline "$name")"
    [ -n "$name" ] || continue
    case "$name" in *,*) echo "agent-hold grant: bad session name '$name'" >&2; exit 2 ;; esac
    in_list "$name" "$granted" || granted="${granted:+$granted,}$name"
  done
  tmp="$(mktemp "$HOLD_ROOT/.${resource}.XXXXXX")" || exit 1
  # Older hold files have no granted line; drop any and write one, keeping the rest.
  { grep -v '^granted:' "$f"; printf 'granted: %s\n' "$granted"; } > "$tmp"
  # The rename is also the wake-up: a gate waiting on the hold dir sees it and re-checks.
  mv "$tmp" "$f"
  notify -p normal -t "go: $resource" "granted $*; the rest stay held"
  echo "granted: $resource for $granted"
}

cmd_release() {
  local resource="${1:-}"
  need_resource "$resource"
  local f="$HOLD_ROOT/$resource"
  [ -f "$f" ] || { echo "agent-hold: $resource is not held" >&2; exit 1; }
  local reason roster
  reason="$(field "$f" reason)"; roster="$(field "$f" roster)"
  rm -f "$f"
  notify -p low -t "go: $resource" "released (was: $reason)"
  echo "released: $resource"
  # Printed so the caller can send GO to exactly the sessions that were told to stop.
  [ -n "$roster" ] && echo "roster: $roster"
  return 0
}

cmd_check() {
  local resource="${1:-}"
  need_resource "$resource"
  local f="$HOLD_ROOT/$resource"
  [ -f "$f" ] || return 0
  local me
  me="$(caller)"
  if [ -n "$me" ] && in_list "$me" "$(field "$f" granted)"; then
    echo "granted: $resource for $me" >&2
    return 0
  fi
  echo "held: $resource since $(field "$f" since) by $(field "$f" by): $(field "$f" reason)"
  return 1
}

cmd_list() {
  [ -d "$HOLD_ROOT" ] || return 0
  local f g
  for f in "$HOLD_ROOT"/*; do
    [ -f "$f" ] || continue
    g="$(field "$f" granted)"
    printf '%s\t%s\t%s\t%s%s\n' "${f##*/}" "$(field "$f" since)" "$(field "$f" by)" "$(field "$f" reason)" "${g:+ (granted: $g)}"
  done
}

cmd_show() {
  local resource="${1:-}"
  need_resource "$resource"
  cat "$HOLD_ROOT/$resource" 2>/dev/null || { echo "agent-hold: $resource is not held" >&2; exit 1; }
}

usage() { sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; }

verb="${1:-}"; shift || true
case "$verb" in
  set)     cmd_set "$@" ;;
  grant)   cmd_grant "$@" ;;
  release) cmd_release "$@" ;;
  check)   cmd_check "$@" ;;
  list)    cmd_list ;;
  show)    cmd_show "$@" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
