#!/usr/bin/env bash
# agent-hold - a fleet-wide pause on a shared resource, held as state instead of sent as
# a message.
#
#   agent-hold set <resource> [--roster a,b,c] [--by name] [--kind load|resource]
#                  [--until <time>] [--quote '<words>'] [--scope <repo>[:<path>],...] "<reason>"
#                                   --scope: the repos or paths the hold locks for every project's
#                                   work, not only rows tagged #hold/<resource>: dispatch skips a row
#                                   that lands there (fleet-dispatch row_off_set) and agent-land
#                                   refuses a PR whose changed files are under it (covers). <repo> is
#                                   the forge repo name (home-config), <path> a file or directory in it
#                                   --kind: load (the default) is the fleet pacing itself, which
#                                   the shepherd lifts once the machine reads CLEAR; resource is
#                                   anything else (bad RAM, a maintenance pause), released by hand
#                                   (the default for dispatch). A re-set writes the kind, scope,
#                                   roster and reason afresh, drops the grants and keeps since;
#                                   a hold by: human is re-set only --by human. --until (any time
#                                   date -d reads, at most 24h ahead) ends the hold on its own:
#                                   check and list read it released once it passes. --by human
#                                   needs --until, and from an agent session --quote, the human's
#                                   words typed in this session in the last hour (agent-ask said)
#   agent-hold claim <resource> [--by name] [--class c] "<what>"   one session's exclusive
#                                   use: fails while another session holds it, and the
#                                   holder's own `check` passes (the agent machine's desktop:
#                                   mac-desktop); --class says why it needs it (`classes`)
#   agent-hold classes              class<TAB>rank<TAB>meaning, best first: who takes a
#                                   claimed resource next (agent-queue desk:<class>)
#   agent-hold grant <resource> [--ask <id>] <name>...   GO for those names while the hold stays, keeping since:
#                                   a session by its Claude session id (stable), or its fleet-sessions
#                                   target (hub/dotfiles:3, or dotfiles:3) until windows renumber (a
#                                   bare tmux session name matches only a one-window session); or a
#                                   board row, epic or plan id (hc-952, ar-4938, a plan's slug), which
#                                   check --for reads: agent-queue lets a granted #hold/ row and its
#                                   item start. A human's narrowing of its own hold is a grant, not
#                                   reason text. On a hold by: human it needs --ask: an ask the human
#                                   answered grant after since, naming the resource and each name;
#                                   the id is kept beside each name on granted_ask:
#   agent-hold lower <resource> <pid>...   CPUWeight=1 on each pid's tmux pane scope or
#                                   agentctl unit, recorded on the hold; release restores it
#   agent-hold release <resource> [--by name] [--force]   ends the hold, restoring what lower
#                                   slowed, and answers grant each open ask that asked only for a
#                                   grant under it. A claim in force is released only by its holder
#                                   (one of its names or its session id, from the caller or given
#                                   as --by, audited); --force frees one whose holder is gone
#   agent-hold check <resource> [--no-caller] [--for <id>...]   exit 1 (and print the hold) while
#                                   held, 0 when free, past its until, or when the caller is
#                                   granted or holds the claim; --no-caller asks as no session, so neither counts; --for
#                                   names the work asked about (its row, epic and plan ids), and a
#                                   grant naming any passes, every granted one named on stderr
#   agent-hold list [--kind k | --expired]   resource<TAB>since<TAB>by<TAB>reason, one per hold
#                                   still in force; --kind load|resource|claim keeps that kind (a
#                                   hold with no kind line reads as the kind set would give it);
#                                   --expired lists only the holds past their until, which
#                                   release ends (the shepherd's pace line names them)
#   agent-hold show <resource>      print the hold file
#   agent-hold scopes               resource<TAB>repo<TAB>path<TAB>granted, one line per --scope entry of
#                                   each hold in force (path empty for a whole repo, granted comma-separated)
#   agent-hold covers <repo> [--for <id>...] < changed paths   exit 1, one held: line each, while a hold
#                                   in force scopes a path given (a whole-repo scope: any path) and grants
#                                   neither the caller nor a --for name (check decides that); else 0
#   agent-hold aged [--days N]      each resource or human-set hold with no until, set N days ago
#                                   or longer (1), then `page: high`, exit 1 when any; never releases
#
# One file per hold in ~/.agent/holds/ (AGENT_HOLD_DIR overrides), flat `key: value`.
# A hold is state, not a message, because shell loops have no inbox and new sessions miss
# a broadcast: the gate, the preflight and the coordinator all read this one file. Why and
# how to use it: the fleet-comms and fleet-pace skills.
#
# A scope is what a hold locks when the work is not the holder's project's: on 2026-11-20 the human
# locked home-config with #hold/ tags on its rows, and 40 minutes later home-config #1333, the work of
# a unity-core-playground row, changed apps/ci-runner-governor anyway (ar-4187).
#
# A grant is GO as state: a staged restart lets a few sessions back in while the hold stays
# set for the rest, and a human's narrowing lets the rows of a plan they approved run. It lives in
# the hold file, so it ends with the hold, and a new `set` starts with no grants. Before grants took
# row, epic and plan ids, a narrowing was a re-set with more reason text: each re-set restarted
# since, so hold-age never saw the critical lockdown age, and every reader had to interpret the
# prose (2026-11-20 to 11-24, ar-5235). Before this, GO was a message telling a session to run with
# UNITY_TEST_IGNORE_HOLD=1, a flag that never expired: on 2026-10-28 all 6 Unity runs live
# under a hold carried it.
#
# `lower` slows a consumer by its cgroup, not its nice: ananicy-cpp types bash and zsh nice
# -4 and re-applies that to each new child, so a reniced bats run's new shells came back at
# -4 (2026-11-07: 583 threads reniced under 20 sessions, ni share stayed 0.4%). Nice only
# orders tasks inside one cgroup; each tmux pane is its own systemd scope, so a CPUWeight
# on the scope holds for every process in it, whatever its nice.
#
# A hold by: human takes the human's words and ends within a day. Before this, `set --by human`
# checked nothing, so any session could write the stamp: the 2026-11-20 critical lockdown was re-set
# 5 times as human from the CLI, and stood 5 days on a `keep` answer whose relayed words never said
# keep (ask M0yWLL). Now the words are checked against the session's transcript, and the hold ends
# by its until, so nothing asks the human to keep it (ar-6059).

set -uo pipefail

HOLD_ROOT="${AGENT_HOLD_DIR:-$HOME/.agent/holds}"
PROC_ROOT="${AGENT_HOLD_PROC:-/proc}"
# 1 of the default 100: a held scope gets about 1% of a contended CPU, near nice 19's share.
LOW_CPU_WEIGHT=1
# The longest a hold may be set for by --until, and how far back the human's quoted words may be.
HOLD_UNTIL_MAX_SECS=86400
HUMAN_QUOTE_SECS=3600
# Desk classes, best first: why a session needs a claimed resource, and so who takes it next
# once it is free (agent-queue starts the best-ranked `desk:<class>` waiter). auth ranks first
# only while the human is here, since a 2FA prompt with nobody to answer it holds the desktop
# for nothing. A live claim is never taken over: preempting a session mid-form breaks both
# forms. Release builds are not here: they run over ssh and never claim the desktop.
DESK_CLASSES='auth	1	the human must answer now: a 2FA code, passkey, CAPTCHA or Allow prompt
legal	2	partner and developer program sign-ups, agreements, tax, bank, content ratings
release	3	console steps a release waits on: first upload, app record, depot or branch, review submit
listing	4	store text, art, screenshots
other	5	setup, exploration, anything else (the default)'

# class_rank <class> -> its rank, nothing for an unknown class
class_rank() { awk -F'\t' -v c="$1" '$1 == c { print $2 }' <<<"$DESK_CLASSES"; }

# shellcheck source=../lib/fmt.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/fmt.sh"
# shellcheck source=../lib/audit.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/audit.sh"
# shellcheck source=../lib/agent-units.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/agent-units.sh"   # agent_batch_unit
# shellcheck source=../lib/dispatch-wake.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/dispatch-wake.sh"

# default_kind <resource> -> the kind a set with no --kind gets: resource for dispatch, which
# pauses a workflow and never load, so a hand `set dispatch` does not drop fleet-assess's trip
# line (fleet-thermal paged high 36 times in 8 hours on one), load for the rest.
default_kind() { if [ "$1" = dispatch ]; then printf resource; else printf load; fi; }

# hold_kind <file> -> load, resource or claim; a hold set before kinds existed gets its default.
hold_kind() { local k; k="$(field "$1" kind)"; printf '%s' "${k:-$(default_kind "${1##*/}")}"; }

# names_word <word> <text>: the text has <word> as a whole word (a hyphen or underscore joins a
# word, so hc-1 is not in hc-10), case-blind, every character literal.
names_word() {
  grep -qiE "(^|[^[:alnum:]_-])$(sed 's/[][\.*^$+?(){}|]/\\&/g' <<<"$1")([^[:alnum:]_-]|\$)" <<<"$2"
}

# expired <hold file>: it has an until and that time has passed. An until no date reads has passed:
# a hold whose end cannot be read is not kept in force on that.
expired() {
  local u; u="$(field "$1" until)"
  [ -n "$u" ] || return 1
  u=$(date -d "$u" +%s 2>/dev/null) || return 0
  [ "$(date +%s)" -ge "$u" ]
}

# A resource is one path segment. Anything else could escape HOLD_ROOT.
valid_resource() {
  case "$1" in
    ''|.|..|*/*) return 1 ;;
  esac
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]
}

need_resource() {
  valid_resource "${1:-}" || { echo "agent-hold: bad resource name '${1:-}' (letters, digits, . _ -)" >&2; exit 2; }
}

# tmux_names -> the caller's tmux window as fleet-sessions names it, one name per line: the
# target <server>/<session>:<window>, then <session>:<window>, then the bare session only when
# it has one window. A world session (hub:dotfiles) has many, so its bare name is none of them:
# a grant to `dotfiles` let every window through (ar-2836). Asked of $TMUX_PANE: with no -t,
# tmux answers for the window the client is looking at, not the caller's. Nothing outside a pane.
tmux_names() {
  [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] || return 0
  local s w n
  IFS=$'\t' read -r s w n < <(tmux display-message -p -t "$TMUX_PANE" \
    $'#{session_name}\t#{window_index}\t#{session_windows}' 2>/dev/null)
  [ -n "${s:-}" ] && [ -n "${w:-}" ] || return 0
  printf '%s/%s:%s\n%s:%s\n' "$(basename "${TMUX%%,*}")" "$s" "$w" "$s" "$w"
  [ "${n:-}" != 1 ] || printf '%s\n' "$s"
}

# callers -> every name the caller answers to, one per line, for `check` and a claim's owner:
# its Claude session id (what fleet-sessions rows and NIGHTLY owners carry), its tmux names,
# else the working directory's basename.
callers() {
  local t
  [ -z "${CLAUDE_CODE_SESSION_ID:-}" ] || printf '%s\n' "$CLAUDE_CODE_SESSION_ID"
  t="$(tmux_names)"
  if [ -n "$t" ]; then printf '%s\n' "$t"; elif [ -n "${PWD##*/}" ]; then printf '%s\n' "${PWD##*/}"; fi
}

# scope_norm <list> -> the --scope list as the hold file keeps it: comma-separated <repo> or
# <repo>:<path>, the path with no leading ./ or /, no trailing /, and no . or .. segment; fails
# naming the bad entry. A repo is the forge's repo name, which agent-land and dispatch both read.
scope_norm() {
  local e r p out="" seg
  local -a es segs
  IFS=, read -ra es <<<"$1"
  for e in "${es[@]}"; do
    e="${e//[[:space:]]/}"
    [ -n "$e" ] || continue
    r="${e%%:*}" p=""
    [ "$r" = "$e" ] || p="${e#*:}"
    p="${p#./}"; while [[ "$p" == /* ]]; do p="${p#/}"; done; while [[ "$p" == */ ]]; do p="${p%/}"; done
    [[ "$r" =~ ^[A-Za-z0-9._-]+$ ]] && [ "$r" != . ] && [ "$r" != .. ] ||
      { echo "agent-hold set: --scope entry '$e' names no repo (<repo> or <repo>:<path>)" >&2; return 1; }
    IFS=/ read -ra segs <<<"$p"
    for seg in "${segs[@]}"; do
      case "$seg" in ''|.|..) [ -z "$p" ] || { echo "agent-hold set: --scope path '$p' has an empty, . or .. segment" >&2; return 1; } ;; esac
    done
    out+="${out:+,}$r${p:+:$p}"
  done
  [ -n "$out" ] || { echo "agent-hold set: --scope names nothing" >&2; return 1; }
  printf '%s' "$out"
}

# Who is holding, as set and claim record it and every reader shows it: the fleet-sessions
# target in a tmux pane, else the working directory's basename. A claim keeps the Claude
# session id beside it (sid:), so the name stays readable and the owner stays exact.
default_by() {
  local t
  t="$(tmux_names)"; t="${t%%$'\n'*}"
  printf '%s' "${t:-${PWD##*/}}"
}

# in_names <name> <names, one a line>: true when the name is one of them. A here-string, not a
# pipe: under pipefail, grep -q exiting at its match can SIGPIPE the writer and fail the match.
in_names() { [ -n "$1" ] && grep -qxF -- "$1" <<<"$2"; }

# owns_claim <file> <caller names>: the caller holds this claim, by any of its names or by the
# Claude session id the claim recorded.
owns_claim() { in_names "$(field "$1" by)" "$2" || in_names "$(field "$1" sid)" "$2"; }

notify() { agent-notify "$@" >/dev/null 2>&1 || true; }

# set_field <file> <key> <value> [<key> <value>]...: replace those key lines in one atomic
# rewrite, keeping the rest. The rename is also the wake-up: a gate waiting on the hold dir sees
# it and re-checks. A file gone by now (released meanwhile) fails it, so a write never brings a
# released hold back.
set_field() {
  local f="$1" tmp pat="" i
  shift
  for ((i = 1; i < $#; i += 2)); do pat="${pat:+$pat|}^${!i}:"; done
  tmp="$(mktemp "$HOLD_ROOT/.${f##*/}.XXXXXX")" || return 1
  { grep -vE "$pat" "$f" || [ -f "$f" ]; } > "$tmp" || { rm -f "$tmp"; return 1; }
  while [ $# -gt 1 ]; do printf '%s: %s\n' "$1" "$2"; shift 2; done >> "$tmp"
  [ -f "$f" ] || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$f"
}

cmd_set() {
  local resource="${1:-}"; shift || true
  need_resource "$resource"
  local roster="" by="" reason="" kind="" until="" quote="" quoted="" scope=""
  # gate: none
  while [ $# -gt 0 ]; do
    case "$1" in
      --roster|--by|--kind|--until|--quote|--scope) [ $# -ge 2 ] || { echo "agent-hold set: $1 needs a value" >&2; exit 2; }
        case "$1" in --roster) roster="$2" ;; --by) by="$2" ;; --kind) kind="$2" ;; --until) until="$2" ;;
          --scope) scope="$(scope_norm "$2")" || exit 2 ;;
          --quote) quote="$(oneline "$2")" quoted=1 ;; esac; shift 2 ;;
      --) shift; reason="$*"; break ;;
      -*) echo "agent-hold set: unknown flag $1" >&2; exit 2 ;;
      *)  reason="$*"; break ;;
    esac
  done
  case "${kind:=$(default_kind "$resource")}" in
    load|resource) ;;
    *) echo "agent-hold set: --kind is load or resource, not '$kind'" >&2; exit 2 ;;
  esac
  [ -n "$reason" ] || { echo "agent-hold set: say why (the reason is what every reader sees)" >&2; exit 2; }
  [ -n "$by" ] || by="$(default_by)"
  # now is read after u, so a relative until of exactly 24h never reads one second over it.
  local now u=""
  if [ -n "$until" ]; then
    u=$(date -d "$until" +%s 2>/dev/null) || { echo "agent-hold set: --until '$until' does not read as a time" >&2; exit 2; }
  fi
  now=$(date +%s)
  if [ -n "$u" ]; then
    [ "$u" -gt "$now" ] || { echo "agent-hold set: --until $until has already passed" >&2; exit 2; }
    [ "$u" -le $((now + HOLD_UNTIL_MAX_SECS)) ] || { echo "agent-hold set: --until is at most 24h ahead; set it again when it ends" >&2; exit 2; }
  fi
  # The human's word is checked the way agent-ask checks a relayed answer: outside an agent session
  # (no CLAUDE_CODE_SESSION_ID or AGENT_QUEUE_ITEM) it is the human's own shell; inside one it takes
  # --quote, words the transcript shows the human typed here in the last hour (agent-ask said, the
  # relay's check, shared). A dispatched session has no human at it, so it never sets one.
  local in_agent=""
  [ -z "${CLAUDE_CODE_SESSION_ID:-}${AGENT_QUEUE_ITEM:-}" ] || in_agent=1
  if [ -n "$quoted" ] && { [ "$(oneline "$by")" != human ] || [ -z "$in_agent" ] || [ -z "$quote" ]; }; then
    echo "agent-hold set: --quote is the human's words an attended session relays, with --by human, from inside a session" >&2; exit 2
  fi
  if [ "$(oneline "$by")" = human ]; then
    [ -n "$u" ] || { echo "agent-hold set: a hold by the human ends on its own: give --until <time>, at most 24h ahead" >&2; exit 2; }
    if [ -n "$in_agent" ]; then
      [ -n "$quote" ] || { echo "agent-hold set: an agent session sets a hold --by human only with --quote '<their words>', typed in this session; else set it under its own name" >&2; exit 2; }
      # The words must be about this hold, so a stray "the" or "yes" from any message cannot stand for it.
      names_word "$resource" "$quote" || { echo "agent-hold set: the quote does not name $resource; quote the human's words that ask for this hold" >&2; exit 1; }
      local why
      why="$("${AGENT_ASK:-agent-ask}" said --since "@$((now - HUMAN_QUOTE_SECS))" "$quote" 2>&1)" \
        || { echo "agent-hold set: cannot set $resource as the human's: ${why:-agent-ask said failed}" >&2; exit 1; }
    fi
  fi
  mkdir -p "$HOLD_ROOT" || { echo "agent-hold: cannot mkdir $HOLD_ROOT" >&2; exit 1; }

  local f="$HOLD_ROOT/$resource" tmp lowered since=""
  # The human's hold stays theirs while it is in force: a re-set by another name would make its
  # grants need no ask (cmd_grant), so it is refused; the hold ends by release or its until.
  if [ "$(field "$f" by)" = human ] && ! expired "$f" && [ "$(oneline "$by")" != human ]; then
    echo "agent-hold set: the human set $resource, so a re-set by $(oneline "$by") is refused (its grants would need no ask); ask the human, or release it on their word" >&2
    exit 1
  fi
  # A re-set keeps what `lower` changed, so the release that ends it still restores it, and its
  # since, while it stays the same kind of hold: it has stood since it was first set, which is what
  # hold-age ages. A new kind is a new hold (a load hold re-set as a human's lockdown, a set over a
  # claim, a hold past its until), and a since no date reads is repaired, not carried forward.
  lowered="$(field "$f" lowered)"
  if [ -f "$f" ] && [ "$(hold_kind "$f")" = "$kind" ] && ! expired "$f"; then
    since="$(field "$f" since)"
    { [ -n "$since" ] && date -d "$since" +%s >/dev/null 2>&1; } || since=""
  fi
  tmp="$(mktemp "$HOLD_ROOT/.${resource}.XXXXXX")" || exit 1
  {
    printf 'resource: %s\n' "$resource"
    printf 'kind: %s\n'     "$kind"
    printf 'since: %s\n'    "${since:-$(now_iso)}"
    printf 'by: %s\n'       "$(oneline "$by")"
    printf 'roster: %s\n'   "$(oneline "$roster")"
    printf 'granted: \n'
    [ -n "$scope" ] && printf 'scope: %s\n' "$scope"
    [ -n "$lowered" ] && printf 'lowered: %s\n' "$lowered"
    [ -n "$u" ] && printf 'until: %s\n' "$(date -d "@$u" +%Y-%m-%dT%H:%M:%S%z)"
    [ -n "$quote" ] && printf 'quote: %s\n' "$(cut -c1-300 <<<"$quote")"
    printf 'reason: %s\n'   "$(oneline "$reason")"
  } > "$tmp"
  # Re-setting an existing hold replaces it (new reason, new roster, no grants, the same since),
  # atomically, so a reader never sees half a file.
  mv "$tmp" "$f"
  # Low on set and on release: fleet-pace sets and lifts holds itself, so a hold is the
  # fleet pacing itself, not something the human acts on. At high it was 10 of the phone's
  # 270 pages in 48h (2026-10-28). The hold still shows in the briefing and the preflight.
  notify -p low -t "hold: $resource" "$(oneline "$reason") (by $(oneline "$by"))"
  audit_append "$(oneline "$by")" hold.placed "$resource" ok "$(oneline "$reason")"
  echo "held: $resource"
}

# claim: a hold that one session takes for its own use, so two sessions never drive the
# same desktop at once. Unlike `set`, it never replaces someone else's hold: the file is
# created with noclobber, so of two racing claims exactly one wins. Re-claiming your own
# refreshes it. A claim left by a dead session is released by whoever finds it, with
# `release --force`.
cmd_claim() {
  local resource="${1:-}"; shift || true
  need_resource "$resource"
  local by="" reason="" class=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --by|--class) [ $# -ge 2 ] || { echo "agent-hold claim: $1 needs a value" >&2; exit 2; }
        if [ "$1" = --by ]; then by="$2"; else class="$2"; fi; shift 2 ;;
      --) shift; reason="$*"; break ;;
      -*) echo "agent-hold claim: unknown flag $1" >&2; exit 2 ;;
      *)  reason="$*"; break ;;
    esac
  done
  [ -n "$reason" ] || { echo "agent-hold claim: say what you are doing with it" >&2; exit 2; }
  [ -z "$class" ] || [ -n "$(class_rank "$class")" ] || { echo "agent-hold claim: unknown class '$class' (agent-hold classes)" >&2; exit 2; }
  # A claim taken as this session also records its Claude session id: renumber-windows moves a
  # window's index, and so its target, while the claim is held, and the id keeps it the owner.
  # One made for a name given by --by is that name's alone.
  local f="$HOLD_ROOT/$resource" body own="" sidline=""
  if [ -n "$by" ]; then
    by="$(oneline "$by")"
    [ -f "$f" ] && [ "$(field "$f" by)" = "$by" ] && own=1
  else
    by="$(oneline "$(default_by)")"
    [ -z "${CLAUDE_CODE_SESSION_ID:-}" ] || sidline="sid: $(oneline "$CLAUDE_CODE_SESSION_ID")"$'\n'
    [ -f "$f" ] && owns_claim "$f" "$(callers)" && own=1
  fi
  mkdir -p "$HOLD_ROOT" || { echo "agent-hold: cannot mkdir $HOLD_ROOT" >&2; exit 1; }
  # A refresh with no --class keeps the class the claim had.
  if [ -z "$class" ] && [ -n "$own" ]; then class="$(field "$f" class)"; fi
  class="${class:-other}"
  body="$(printf 'resource: %s\nkind: claim\nclass: %s\nsince: %s\nby: %s\n%sroster: \ngranted: \nreason: %s\n' \
    "$resource" "$class" "$(now_iso)" "$by" "$sidline" "$(oneline "$reason")")"
  if [ -n "$own" ]; then
    printf '%s\n' "$body" > "$f"; echo "claimed: $resource (refreshed)"; return 0
  fi
  # A hold past its until is over: its release, which restores what it lowered, makes way for the claim.
  if [ -f "$f" ] && expired "$f"; then keep_asks=1 cmd_release "$resource" >/dev/null || return 1; fi
  if ( set -o noclobber; printf '%s\n' "$body" > "$f" ) 2>/dev/null; then
    echo "claimed: $resource"; return 0
  fi
  # The holder keeps it; a better class is told it starts next, not that it may take over.
  local held; held="$(field "$f" class)"
  local outrank=""
  # A class the table no longer has (or a claim from before classes) ranks last.
  local hr; hr="$(class_rank "$held")"
  [ -n "$held" ] && [ "$(class_rank "$class")" -lt "${hr:-9}" ] &&
    outrank=" (you outrank it: requeue with --class $class, it starts next)"
  echo "busy: $resource since $(field "$f" since) by $(field "$f" by)${held:+ ($held)}: $(field "$f" reason)$outrank" >&2
  return 1
}

# in_list <name> <a,b,c>
in_list() { case ",$2," in *",$1,"*) return 0 ;; esac; return 1; }

# A grant on a hold the human set (by: human) is the human's word, so it takes --ask <id>: an ask the
# human answered `grant` after since, naming the resource and each name granted (human_answer).
# Without one it is refused: by 2026-11-25 the critical lockdown carried about 60 grants agent
# sessions had written themselves, and the human had made none (ar-6046). The ask id goes beside
# each name it granted on `granted_ask:` (name=id), so a reader sees whose words let it run. A hold
# an agent or dispatch set grants on the caller's word, as before.
cmd_grant() {
  local resource="${1:-}"; shift || true
  need_resource "$resource"
  local id="" names=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --ask) [ -n "${2:-}" ] || { echo "agent-hold grant: --ask needs an ask id" >&2; exit 2; }
        id="$2"; shift 2 ;;
      *) names+=("$1"); shift ;;
    esac
  done
  [ "${#names[@]}" -gt 0 ] || { echo "agent-hold grant: name at least one session, row, epic or plan" >&2; exit 2; }
  local f="$HOLD_ROOT/$resource"
  [ -f "$f" ] || { echo "agent-hold: $resource is not held, nothing to grant" >&2; exit 1; }
  local granted asks name clean=()
  for name in "${names[@]}"; do
    name="$(oneline "$name")"
    [ -n "$name" ] || continue
    case "$name" in *,*|*' '*|*=*) echo "agent-hold grant: bad name '$name' (one session, row, epic or plan id, no comma, space or =)" >&2; exit 2 ;; esac
    clean+=("$name")
  done
  [ "${#clean[@]}" -gt 0 ] || { echo "agent-hold grant: name at least one session, row, epic or plan" >&2; exit 2; }
  if [ -n "$id" ]; then
    human_answer grant "$resource" "$id" "$f" "${clean[@]}" >/dev/null || exit 1
  elif [ "$(field "$f" by)" = human ]; then
    echo "agent-hold grant: the human set $resource, so only the human grants on it: post an ask naming $resource and ${clean[*]} with a grant option (agent-ask post --options 'grant=...|hold=...'), then run grant $resource --ask <id> ${clean[*]} once they answer grant" >&2
    exit 1
  fi
  granted="$(field "$f" granted)" asks="$(field "$f" granted_ask)"
  # A name granted again under an ask takes that ask, so every granted name shows whose words let it run.
  for name in "${clean[@]}"; do
    in_list "$name" "$granted" || granted="${granted:+$granted,}$name"
    [ -n "$id" ] || continue
    asks="$(tr , '\n' <<<"$asks" | awk -F= -v n="$name" 'NF && $1 != n' | paste -sd,)"
    asks="${asks:+$asks,}$name=$id"
  done
  set_field "$f" granted "$granted" granted_ask "$asks" || exit 1
  notify -p normal -t "go: $resource" "granted ${clean[*]}${id:+ (ask $id)}; the rest stay held"
  audit_append "$(default_by)" hold.granted "$resource" ok "${clean[*]}${id:+ (ask $id)}"
  echo "granted: $resource for $granted${id:+ (ask $id)}"
}

# human_answer <verb> <resource> <id> <hold file> [<name>...]: print ask <id>'s answered_at when the
# human answered it <verb> after the hold's since and it names the resource and each name as a word
# in its question or context; else say why on stderr and fail. The ask is the proof, not the caller's
# word: an empty answered_by is refused (the hold needs the record), and the names are a text match
# (asks carry no hold field). grant takes its ask through this.
human_answer() {
  local verb="$1" resource="$2" id="$3" f="$4" ask at t s w text
  shift 4
  ask="$("${AGENT_ASK:-agent-ask}" show "$id" 2>/dev/null)" || { echo "agent-hold $verb: no ask $id" >&2; return 1; }
  askf() { sed -n "/^$1: /{s///p;q;}" <<<"$ask"; }
  [ "$(askf answer)" = "$verb" ] && [ "$(askf answered_by)" = human ] \
    || { echo "agent-hold $verb: ask $id is not answered $verb by the human" >&2; return 1; }
  text="$(askf question) $(askf context)"
  for w in "$resource" "$@"; do
    names_word "$w" "$text" \
      || { echo "agent-hold $verb: ask $id does not name $w" >&2; return 1; }
  done
  at="$(askf answered_at)"
  t=$(date -d "$at" +%s 2>/dev/null) && [ -n "$at" ] || { echo "agent-hold $verb: ask $id has no readable answered_at" >&2; return 1; }
  # An empty value is no time: date -d "" alone reads as today's midnight.
  s="$(field "$f" since)"; { [ -n "$s" ] && s=$(date -d "$s" +%s 2>/dev/null); } || s=0
  [ "$t" -gt "$s" ] || { echo "agent-hold $verb: ask $id was answered before the hold's since, nothing changed" >&2; return 1; }
  printf '%s\n' "$at"
}

# unit_of <pid|self> -> the user unit a process runs in: the tmux pane scope, agent session scope
# (claude-acct scope) or agentctl unit on its cgroup path when there is one (a run started with
# `systemd-run --scope` from a pane sits in a scope nested inside the pane's), else the innermost
# .scope or .service.
# Exit 1 when the process is gone, 2 when it is not under this user's manager.
unit_of() {
  local path part unit="" batch=""
  path="$(sed -n 's/^0:://p' "$PROC_ROOT/$1/cgroup" 2>/dev/null)" || return 1
  [ -n "$path" ] || return 1
  case "$path" in */user@"$(id -u)".service/*) ;; *) return 2 ;; esac
  path="${path#*/user@"$(id -u)".service/}"
  local IFS=/
  for part in $path; do
    case "$part" in
      *.scope|*.service) if agent_batch_unit "$part"; then batch="${batch:-$part}"; else unit="$part"; fi ;;
    esac
  done
  unit="${batch:-$unit}"
  [ -n "$unit" ] || return 2
  printf '%s' "$unit"
}

cmd_lower() {
  local resource="${1:-}"; shift || true
  need_resource "$resource"
  [ $# -gt 0 ] || { echo "agent-hold lower: name at least one pid" >&2; exit 2; }
  local f="$HOLD_ROOT/$resource"
  [ -f "$f" ] || { echo "agent-hold: $resource is not held; set it first, so its release restores what lower changes" >&2; exit 1; }
  # A claim is one session's use of a desktop, not a load hold, and its refresh rewrites
  # the file whole, so nothing recorded on it would survive to the release.
  [ "$(field "$f" kind)" = claim ] && { echo "agent-hold lower: $resource is a claim, not a load hold" >&2; exit 2; }
  local lowered pid unit self rc=0 err
  lowered="$(field "$f" lowered)"
  self="$(unit_of self)"
  for pid in "$@"; do
    [[ "$pid" =~ ^[0-9]+$ ]] || { echo "agent-hold lower: bad pid '$pid'" >&2; rc=2; continue; }
    unit="$(unit_of "$pid")"; err=$?
    case "$err" in
      1) echo "agent-hold lower: no process $pid" >&2; [ "$rc" -gt 1 ] || rc=1; continue ;;
      2) echo "agent-hold lower: pid $pid is not under this user's systemd manager; left alone" >&2; [ "$rc" -gt 1 ] || rc=1; continue ;;
    esac
    # Only units that are batch work: a desktop terminal's or app's scope is the human's,
    # and the caller's own pane would slow the pass that has to lift the hold.
    agent_batch_unit "$unit" || { echo "agent-hold lower: pid $pid runs in $unit, not a tmux pane, agent session or agentctl unit; left alone" >&2; [ "$rc" -gt 1 ] || rc=1; continue; }
    [ "$unit" = "$self" ] && { echo "agent-hold lower: pid $pid is in this pane ($unit); left alone" >&2; [ "$rc" -gt 1 ] || rc=1; continue; }
    if in_list "$unit" "$lowered"; then echo "lowered: $unit (pid $pid, already)"; continue; fi
    # Recorded before it is applied, so no interrupted run leaves a unit lowered that the
    # release does not know about. Restoring a unit that was never lowered is harmless.
    lowered="${lowered:+$lowered,}$unit"
    set_field "$f" lowered "$lowered" || exit 1
    systemctl --user set-property --runtime "$unit" "CPUWeight=$LOW_CPU_WEIGHT" ||
      { echo "agent-hold lower: systemctl could not set CPUWeight on $unit" >&2; [ "$rc" -gt 1 ] || rc=1; continue; }
    echo "lowered: $unit (pid $pid)"
  done
  return "$rc"
}

# settle_grant_asks <resource>: answer `grant` to each open ask that asked only for a grant under
# the hold just released: its options are grant plus only GRANT_ASK_HOLD_SIDE ones, and its
# question or context names the resource and no hold still set (names_word, the match
# human_answer applies to a grant ask). With the hold gone a grant is what the asker gets anyway,
# and nothing else answered it: on 2026-11-25 the critical hold was released and 7 asks to grant
# work under it stayed on Needs (ar-6045). The answer is the human's only from their own shell (a
# terminal on stdin, no agent session); a session's or an unattended caller's (fleet-dispatch
# releases with stdin on /dev/null) is the agent's, and one agent-ask refuses an agent (a
# human-only ask) is cancelled instead, since what it asked about is gone. The release stands
# either way.
GRANT_ASK_HOLD_SIDE="hold keep"
settle_grant_asks() {
  local resource="$1" id text h why by=agent answered="" cancelled="" others=()
  [ -z "${CLAUDE_CODE_SESSION_ID:-}${AGENT_QUEUE_ITEM:-}" ] && [ -t 0 ] && by=human
  for h in "$HOLD_ROOT"/*; do [ -f "$h" ] && others+=("${h##*/}"); done
  while IFS=$'\t' read -r id text; do
    names_word "$resource" "$text" || continue
    for h in "${others[@]}"; do names_word "$h" "$text" && continue 2; done
    if why="$("${AGENT_ASK:-agent-ask}" answer --by "$by" "$id" grant 2>&1 </dev/null)"; then
      answered="${answered:+$answered }$id"
    elif "${AGENT_ASK:-agent-ask}" cancel "$id" "hold $resource released, so there is no hold left to grant under" </dev/null 2>/dev/null; then
      cancelled="${cancelled:+$cancelled }$id"
    else
      echo "agent-hold release: grant ask $id stays pending: $(oneline "$why")" >&2
    fi
  done < <("${AGENT_ASK:-agent-ask}" list --all --open 2>/dev/null | awk -F'\t' -v side="$GRANT_ASK_HOLD_SIDE" '
    BEGIN { split(side, s, " "); for (i in s) keep[s[i]] = 1 }
    # list columns: 1 id, 6 question, 7 options, 20 context (agent-ask cmd_list, which only appends).
    { n = split(tolower($7), o, "|"); g = 0; ok = 1
      for (i = 1; i <= n; i++) { gsub(/^ +| +$/, "", o[i]); if (o[i] == "grant") g = 1; else if (!(o[i] in keep)) ok = 0 }
      if (g && ok && $1 != "") print $1 "\t" $6 " " $20 }')
  [ -z "$answered" ] || echo "answered grant ($by): $answered"
  [ -z "$cancelled" ] || echo "cancelled (no hold left to grant under): $cancelled"
}

# cmd_release <resource> [--by name] [--force]: exit 1 on a claim in force the caller does not
# hold, unless --force. keep_asks=1 is the claim path's, which takes the resource again at
# once, so no ask about it is settled as free.
cmd_release() {
  local resource="${1:-}"; shift || true
  need_resource "$resource"
  local by="" force=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --by) [ $# -ge 2 ] || { echo "agent-hold release: --by needs a value" >&2; exit 2; }
        by="$(oneline "$2")"; shift 2
        [ -n "$by" ] || { echo "agent-hold release: --by needs a value" >&2; exit 2; } ;;
      --force) force=1; shift ;;
      *) echo "agent-hold release: unknown argument $1" >&2; exit 2 ;;
    esac
  done
  local f="$HOLD_ROOT/$resource"
  [ -f "$f" ] || { echo "agent-hold: $resource is not held" >&2; exit 1; }
  local reason roster
  reason="$(field "$f" reason)"; roster="$(field "$f" roster)"
  # A claim is one session's: another session's release would free a desktop still being driven
  # (2026-11-06, a session released agent-42's mac-desktop claim, ar-751). A claim whose holder is
  # gone is freed with --force by whoever finds it. The check catches a release by mistake; it does
  # not prove a holder gone, and the audit line names whose claim a --force freed. A claim past
  # its until is over, as check reads it, so anyone releases it (claim's own takeover of one does).
  local note=""
  if [ "$(field "$f" kind)" = claim ] && ! expired "$f"; then
    local holder; holder="$(field "$f" by)"
    if [ -n "$force" ]; then note=" (forced over $holder's claim)"
    else
      owns_claim "$f" "${by:-$(callers)}" ||
        { echo "agent-hold release: $resource is claimed by $holder since $(field "$f" since): $reason. Only its holder releases it, from its own session; --force (audited) only when that session is gone." >&2; exit 1; }
      [ -z "$by" ] || note=" (released as $by)"
    fi
  fi
  local unit failed=""
  for unit in $(field "$f" lowered | tr ',' ' '); do
    # An empty CPUWeight= drops the runtime setting. A pane closed since has no scope left.
    if systemctl --user set-property --runtime "$unit" CPUWeight=; then
      echo "restored: $unit"
    elif [ "$(systemctl --user show -p LoadState --value "$unit" 2>/dev/null)" = not-found ]; then
      echo "gone: $unit"
    else
      failed="${failed:+$failed,}$unit"
    fi
  done
  # The hold file is the only record of what is still lowered, so it stays until each
  # live unit is restored.
  if [ -n "$failed" ]; then
    set_field "$f" lowered "$failed"
    echo "agent-hold release: could not restore $failed; $resource stays held, release it again" >&2
    return 1
  fi
  rm -f "$f"
  # A lifted hold is what held starts back: wake a kick (dispatch_wake) rather than wait for the timer.
  dispatch_wake "agent-hold release $resource"
  notify -p low -t "go: $resource" "released (was: $reason)"
  audit_append "$(default_by)" hold.released "$resource" ok "was: $reason$note"
  echo "released: $resource"
  # Printed so the caller can send GO to exactly the sessions that were told to stop.
  [ -n "$roster" ] && echo "roster: $roster"
  [ -n "${keep_asks:-}" ] || settle_grant_asks "$resource"
  return 0
}

cmd_check() {
  local resource="${1:-}" nocaller="" work=""
  need_resource "$resource"
  shift || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-caller) nocaller=1; shift ;;
      --for) shift; while [ $# -gt 0 ] && [[ "$1" != --* ]]; do work+="$1"$'\n'; shift; done ;;
      *) echo "agent-hold check: unknown argument $1" >&2; exit 2 ;;
    esac
  done
  local f="$HOLD_ROOT/$resource"
  [ -f "$f" ] || return 0
  if expired "$f"; then
    echo "expired: $resource at $(field "$f" until), released once agent-hold release $resource runs" >&2
    return 0
  fi
  # --no-caller asks for a session that does not exist yet (agent-queue's hold:<resource>), so
  # no grant or claim of the asker's counts.
  local me=""
  [ -n "$nocaller" ] || me="$(callers)"
  if [ "$(field "$f" kind)" = claim ] && owns_claim "$f" "$me"; then
    echo "claimed: $resource by $(field "$f" by)" >&2
    return 0
  fi
  # A grant names a session (matched against the caller's names) or a row, epic or plan id
  # (matched against --for, the work asked about). Every --for name granted is said, so one call
  # can answer a batch of rows (agent-queue gate --all).
  local name names hit=""
  IFS=, read -ra names <<<"$(field "$f" granted)"
  for name in "${names[@]}"; do
    in_names "$name" "$me" && { echo "granted: $resource for $name" >&2; return 0; }
    in_names "$name" "$work" && hit+="${hit:+ }$name"
  done
  [ -z "$hit" ] || { echo "granted: $resource for $hit" >&2; return 0; }
  echo "held: $resource since $(field "$f" since) by $(field "$f" by): $(field "$f" reason)"
  return 1
}

cmd_list() {
  local want="" ended=""
  case "${1:-}" in
    '') ;;
    --expired) [ $# -eq 1 ] || { echo "agent-hold list: --expired takes no value" >&2; exit 2; }; ended=1 ;;
    --kind) [ $# -eq 2 ] || { echo "agent-hold list: --kind takes one value" >&2; exit 2; }; want="$2"
      case "$want" in load|resource|claim) ;; *) echo "agent-hold list: --kind is load, resource or claim, not '$want'" >&2; exit 2 ;; esac ;;
    *) echo "agent-hold list: unknown argument $1" >&2; exit 2 ;;
  esac
  [ -d "$HOLD_ROOT" ] || return 0
  local f g c
  for f in "$HOLD_ROOT"/*; do
    [ -f "$f" ] || continue
    if [ -n "$ended" ]; then expired "$f" || continue; else ! expired "$f" || continue; fi
    [ -z "$want" ] || [ "$(hold_kind "$f")" = "$want" ] || continue
    g="$(field "$f" granted)" c="$(field "$f" class)"
    printf '%s\t%s\t%s\t%s%s%s\n' "${f##*/}" "$(field "$f" since)" "$(field "$f" by)" "${c:+[$c] }" "$(field "$f" reason)" "${g:+ (granted: $g)}"
  done
}

# aged [--days N] -> one line per standing hold set N days ago or longer (AGENT_HOLD_AGE_DAYS, 1), its
# age, who set it and why, then how to end it and `page: high`; exit 1 when any, 0 when none. A
# standing hold is one only the human ends: a resource hold, or any hold `by: human`. A load hold
# (the shepherd lifts it once the machine reads CLEAR) and a claim (it ends with its skill) are
# exempt, and so is a hold with an until (every hold by: human has one): it ends on its own, so
# nothing asks the human to keep it. It reads and never releases: a hold with no until ends only by
# a release, so its age is a page, never a timeout (ask GwQIYE, 2026-11-21). The watch hold-age runs it at severity high, since only the human
# releases one (priority.md). Event-free by necessity: a hold growing old has no event, so the watch samples.
cmd_aged() {
  local days="${AGENT_HOLD_AGE_DAYS:-1}" f since s age now n=0 kind
  case "${1:-}" in
    '') ;;
    --days) [[ "${2:-}" =~ ^[0-9]+$ ]] || { echo "agent-hold aged: --days takes a whole number" >&2; exit 2; }; days="$2" ;;
    *) echo "agent-hold aged: unknown argument $1" >&2; exit 2 ;;
  esac
  [ -d "$HOLD_ROOT" ] || return 0
  now=$(date +%s)
  for f in "$HOLD_ROOT"/*; do
    [ -f "$f" ] || continue
    kind="$(hold_kind "$f")"
    [ "$kind" = resource ] || { [ "$kind" != claim ] && [ "$(field "$f" by)" = human ]; } || continue
    [ -z "$(field "$f" until)" ] || continue
    since="$(field "$f" since)"
    # A since no date reads is a hold nobody can age: it shows, since it is as old as anything. An
    # empty one too: `date -d ""` reads as today's midnight.
    { [ -n "$since" ] && s=$(date -d "$since" +%s 2>/dev/null); } || s=0
    age=$(( (now - s) / 86400 ))
    [ "$age" -ge "$days" ] || continue
    n=$((n + 1))
    printf '%s: held %sd, since %s by %s: %s\n' "${f##*/}" "$age" "${since:-an unreadable time}" "$(field "$f" by)" "$(field "$f" reason)"
  done
  [ "$n" -gt 0 ] || return 0
  echo "$n hold(s) set $days day(s) ago or longer; release each that is done (agent-hold release <resource>) or ask its setter; nothing releases them on age"
  echo "page: high"
  return 1
}

# scopes -> resource, repo, path and granted, tab-separated, for each --scope entry of each hold in force.
cmd_scopes() {
  # gate: none
  [ $# -eq 0 ] || { echo "agent-hold scopes: takes no argument" >&2; exit 2; }
  [ -d "$HOLD_ROOT" ] || return 0
  local f e sc g
  local -a es
  for f in "$HOLD_ROOT"/*; do
    [ -f "$f" ] && ! expired "$f" || continue
    sc="$(field "$f" scope)"; [ -n "$sc" ] || continue
    g="$(field "$f" granted)"
    IFS=, read -ra es <<<"$sc"
    for e in "${es[@]}"; do
      [ -n "$e" ] || continue
      if [[ "$e" == *:* ]]; then printf '%s\t%s\t%s\t%s\n' "${f##*/}" "${e%%:*}" "${e#*:}" "$g"
      else printf '%s\t%s\t\t%s\n' "${f##*/}" "$e" "$g"; fi
    done
  done
}

# covers <repo> [--for <id>...] < changed paths -> exit 1 with one held: line per hold in force whose
# scope covers a path (its path, or a file under that directory; a whole-repo entry: any path) of
# <repo>, compared case-blind, and that check does not pass for the caller or a --for name. Else 0.
cmd_covers() {
  local repo="${1:-}" rc=0
  shift || true
  # gate: none
  [ -n "$repo" ] || { echo "agent-hold covers: name the repo" >&2; exit 2; }
  local -a fors=()
  case "${1:-}" in
    '') ;;
    --for) shift; fors=(--for "$@") ;;
    *) echo "agent-hold covers: unknown argument $1" >&2; exit 2 ;;
  esac
  local files r sr sp g hit out
  local -A seen=()
  files="$(cat)"
  [ -n "$files" ] || return 0
  while IFS=$'\t' read -r r sr sp g; do
    [ -n "$r" ] && [ -z "${seen[$r]+x}" ] || continue
    [ "${sr,,}" = "${repo,,}" ] || continue
    if [ -z "$sp" ]; then hit="${files%%$'\n'*}"
    else hit="$(awk -v p="$sp" '$0 == p || index($0, p "/") == 1 { print; exit }' <<<"$files")"; fi
    [ -n "$hit" ] || continue
    seen[$r]=1
    out="$(cmd_check "$r" "${fors[@]}" 2>/dev/null)" && continue
    printf '%s (scope %s%s covers %s)\n' "$out" "$sr" "${sp:+:$sp}" "$hit"
    rc=1
  done < <(cmd_scopes)
  return "$rc"
}

cmd_show() {
  local resource="${1:-}"
  need_resource "$resource"
  cat "$HOLD_ROOT/$resource" 2>/dev/null || { echo "agent-hold: $resource is not held" >&2; exit 1; }
}

cmd_classes() { printf '%s\n' "$DESK_CLASSES"; }

usage() { sed -n '2,62p' "$0" | sed 's/^# \{0,1\}//'; }

verb="${1:-}"; shift || true
case "$verb" in
  set)     cmd_set "$@" ;;
  claim)   cmd_claim "$@" ;;
  grant)   cmd_grant "$@" ;;
  lower)   cmd_lower "$@" ;;
  release) cmd_release "$@" ;;
  check)   cmd_check "$@" ;;
  list)    cmd_list "$@" ;;
  aged)    cmd_aged "$@" ;;
  classes) cmd_classes ;;
  show)    cmd_show "$@" ;;
  scopes)  cmd_scopes "$@" ;;
  covers)  cmd_covers "$@" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
