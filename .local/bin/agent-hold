#!/usr/bin/env bash
# agent-hold - a fleet-wide pause on a shared resource, held as state instead of sent as
# a message.
#
#   agent-hold set <resource> [--roster a,b,c] [--by name] [--kind load|resource] "<reason>"
#                                   --kind: load (the default) is the fleet pacing itself, which
#                                   the shepherd lifts once the machine reads CLEAR; resource is
#                                   anything else (bad RAM, a maintenance pause), released by hand
#                                   (the default for dispatch). A re-set writes the kind,
#                                   roster and reason afresh, drops the grants and keeps since
#   agent-hold claim <resource> [--by name] [--class c] "<what>"   one session's exclusive
#                                   use: fails while another session holds it, and the
#                                   holder's own `check` passes (the agent machine's desktop:
#                                   mac-desktop); --class says why it needs it (`classes`)
#   agent-hold classes              class<TAB>rank<TAB>meaning, best first: who takes a
#                                   claimed resource next (agent-queue desk:<class>)
#   agent-hold grant <resource> <name>...   GO for those names while the hold stays, keeping since:
#                                   a session by its Claude session id (stable), or its fleet-sessions
#                                   target (hub/dotfiles:3, or dotfiles:3) until windows renumber (a
#                                   bare tmux session name matches only a one-window session); or a
#                                   board row, epic or plan id (hc-952, ar-4938, a plan's slug). check
#                                   matches only session names; no gate reads a row, epic or plan
#                                   grant yet (ar-5235 phase 2), list and the preflight show it. A
#                                   human's narrowing of its own hold is a grant, not reason text
#   agent-hold keep <resource> --ask <id>   the human re-confirmed the hold: records `kept:` (the
#                                   ask's answered_at) and `kept_ask:`, keeping since and grants, so
#                                   aged and hub count its age from the keep. The ask must name the
#                                   resource and be answered keep by the human, after since and any
#                                   earlier keep; a same-kind re-set carries it, like since
#   agent-hold lower <resource> <pid>...   CPUWeight=1 on each pid's tmux pane scope or
#                                   agentctl unit, recorded on the hold; release restores it
#   agent-hold release <resource>
#   agent-hold check <resource> [--no-caller]   exit 1 (and print the hold) while held, 0
#                                   when free or when the caller is granted or holds the claim;
#                                   --no-caller asks as no session, so neither counts
#   agent-hold list [--kind k]      resource<TAB>since<TAB>by<TAB>reason, one per hold; --kind
#                                   load|resource|claim keeps that kind (a hold with no kind line
#                                   reads as the kind set would give it)
#   agent-hold show <resource>      print the hold file
#   agent-hold aged [--days N]      each resource or human-set hold set or kept N days ago or longer
#                                   (1), then `page: high`, exit 1 when any; never releases
#
# One file per hold in ~/.agent/holds/ (AGENT_HOLD_DIR overrides), flat `key: value`.
# A hold is state, not a message, because shell loops have no inbox and new sessions miss
# a broadcast: the gate, the preflight and the coordinator all read this one file. Why and
# how to use it: the fleet-comms and fleet-pace skills.
#
# A grant is GO as state: a staged restart lets a few sessions back in while the hold stays
# set for the rest, and a human's narrowing lets the rows of a plan they approved run. It lives in
# the hold file, so it ends with the hold, and a new `set` starts with no grants. Before grants took
# row, epic and plan ids, a narrowing was a re-set with more reason text: each re-set restarted
# since, so hold-age never saw the critical lockdown age, and every reader had to interpret the
# prose (2026-11-20 to 11-24, ar-5235). Before this, GO was a message telling a session to run with
# UNITY_TEST_IGNORE_HOLD=1, a flag that never expired: on 2026-10-28 all 6 Unity runs live
# under a hold carried it.
#
# `lower` slows a consumer by its cgroup, not its nice: ananicy-cpp types bash and zsh nice
# -4 and re-applies that to each new child, so a reniced bats run's new shells came back at
# -4 (2026-11-07: 583 threads reniced under 20 sessions, ni share stayed 0.4%). Nice only
# orders tasks inside one cgroup; each tmux pane is its own systemd scope, so a CPUWeight
# on the scope holds for every process in it, whatever its nice.

set -uo pipefail

HOLD_ROOT="${AGENT_HOLD_DIR:-$HOME/.agent/holds}"
PROC_ROOT="${AGENT_HOLD_PROC:-/proc}"
# 1 of the default 100: a held scope gets about 1% of a contended CPU, near nice 19's share.
LOW_CPU_WEIGHT=1
# Desk classes, best first: why a session needs a claimed resource, and so who takes it next
# once it is free (agent-queue starts the best-ranked `desk:<class>` waiter). auth ranks first
# only while the human is here, since a 2FA prompt with nobody to answer it holds the desktop
# for nothing. A live claim is never taken over: preempting a session mid-form breaks both
# forms. Release builds are not here: they run over ssh and never claim the desktop.
DESK_CLASSES='auth	1	the human must answer now: a 2FA code, passkey, CAPTCHA or Allow prompt
legal	2	partner and developer program sign-ups, agreements, tax, bank, content ratings
release	3	console steps a release waits on: first upload, app record, depot or branch, review submit
listing	4	store text, art, screenshots
other	5	setup, exploration, anything else (the default)'

# class_rank <class> -> its rank, nothing for an unknown class
class_rank() { awk -F'\t' -v c="$1" '$1 == c { print $2 }' <<<"$DESK_CLASSES"; }

# shellcheck source=../lib/fmt.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/fmt.sh"
# shellcheck source=../lib/audit.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/audit.sh"
# shellcheck source=../lib/dispatch-wake.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/dispatch-wake.sh"

# collapse a value to a single physical line (files are one key:value per line)
oneline() { printf '%s' "$1" | tr '\n\t' '  ' | sed -E 's/  +/ /g; s/^ +//; s/ +$//'; }

# field <file> <key> -> first value (text after "key: ")
field() { sed -n "/^$2: /{s///p;q;}" "$1" 2>/dev/null; }

# default_kind <resource> -> the kind a set with no --kind gets: resource for dispatch, which
# pauses a workflow and never load, so a hand `set dispatch` does not drop fleet-assess's trip
# line (fleet-thermal paged high 36 times in 8 hours on one), load for the rest.
default_kind() { if [ "$1" = dispatch ]; then printf resource; else printf load; fi; }

# hold_kind <file> -> load, resource or claim; a hold set before kinds existed gets its default.
hold_kind() { local k; k="$(field "$1" kind)"; printf '%s' "${k:-$(default_kind "${1##*/}")}"; }

# A resource is one path segment. Anything else could escape HOLD_ROOT.
valid_resource() {
  case "$1" in
    ''|.|..|*/*) return 1 ;;
  esac
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]
}

need_resource() {
  valid_resource "${1:-}" || { echo "agent-hold: bad resource name '${1:-}' (letters, digits, . _ -)" >&2; exit 2; }
}

# tmux_names -> the caller's tmux window as fleet-sessions names it, one name per line: the
# target <server>/<session>:<window>, then <session>:<window>, then the bare session only when
# it has one window. A world session (hub:dotfiles) has many, so its bare name is none of them:
# a grant to `dotfiles` let every window through (ar-2836). Asked of $TMUX_PANE: with no -t,
# tmux answers for the window the client is looking at, not the caller's. Nothing outside a pane.
tmux_names() {
  [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] || return 0
  local s w n
  IFS=$'\t' read -r s w n < <(tmux display-message -p -t "$TMUX_PANE" \
    $'#{session_name}\t#{window_index}\t#{session_windows}' 2>/dev/null)
  [ -n "${s:-}" ] && [ -n "${w:-}" ] || return 0
  printf '%s/%s:%s\n%s:%s\n' "$(basename "${TMUX%%,*}")" "$s" "$w" "$s" "$w"
  [ "${n:-}" != 1 ] || printf '%s\n' "$s"
}

# callers -> every name the caller answers to, one per line, for `check` and a claim's owner:
# its Claude session id (what fleet-sessions rows and NIGHTLY owners carry), its tmux names,
# else the working directory's basename.
callers() {
  local t
  [ -z "${CLAUDE_CODE_SESSION_ID:-}" ] || printf '%s\n' "$CLAUDE_CODE_SESSION_ID"
  t="$(tmux_names)"
  if [ -n "$t" ]; then printf '%s\n' "$t"; elif [ -n "${PWD##*/}" ]; then printf '%s\n' "${PWD##*/}"; fi
}

# Who is holding, as set and claim record it and every reader shows it: the fleet-sessions
# target in a tmux pane, else the working directory's basename. A claim keeps the Claude
# session id beside it (sid:), so the name stays readable and the owner stays exact.
default_by() {
  local t
  t="$(tmux_names)"; t="${t%%$'\n'*}"
  printf '%s' "${t:-${PWD##*/}}"
}

# in_names <name> <names, one a line>: true when the name is one of them. A here-string, not a
# pipe: under pipefail, grep -q exiting at its match can SIGPIPE the writer and fail the match.
in_names() { [ -n "$1" ] && grep -qxF -- "$1" <<<"$2"; }

# owns_claim <file> <caller names>: the caller holds this claim, by any of its names or by the
# Claude session id the claim recorded.
owns_claim() { in_names "$(field "$1" by)" "$2" || in_names "$(field "$1" sid)" "$2"; }

notify() { agent-notify "$@" >/dev/null 2>&1 || true; }

# set_field <file> <key> <value> [<key> <value>]...: replace those key lines in one atomic
# rewrite, keeping the rest. The rename is also the wake-up: a gate waiting on the hold dir sees
# it and re-checks. A file gone by now (released meanwhile) fails it, so a write never brings a
# released hold back.
set_field() {
  local f="$1" tmp pat="" i
  shift
  for ((i = 1; i < $#; i += 2)); do pat="${pat:+$pat|}^${!i}:"; done
  tmp="$(mktemp "$HOLD_ROOT/.${f##*/}.XXXXXX")" || return 1
  { grep -vE "$pat" "$f" || [ -f "$f" ]; } > "$tmp" || { rm -f "$tmp"; return 1; }
  while [ $# -gt 1 ]; do printf '%s: %s\n' "$1" "$2"; shift 2; done >> "$tmp"
  [ -f "$f" ] || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$f"
}

cmd_set() {
  local resource="${1:-}"; shift || true
  need_resource "$resource"
  local roster="" by="" reason="" kind=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --roster|--by|--kind) [ $# -ge 2 ] || { echo "agent-hold set: $1 needs a value" >&2; exit 2; }
        case "$1" in --roster) roster="$2" ;; --by) by="$2" ;; --kind) kind="$2" ;; esac; shift 2 ;;
      --) shift; reason="$*"; break ;;
      -*) echo "agent-hold set: unknown flag $1" >&2; exit 2 ;;
      *)  reason="$*"; break ;;
    esac
  done
  case "${kind:=$(default_kind "$resource")}" in
    load|resource) ;;
    *) echo "agent-hold set: --kind is load or resource, not '$kind'" >&2; exit 2 ;;
  esac
  [ -n "$reason" ] || { echo "agent-hold set: say why (the reason is what every reader sees)" >&2; exit 2; }
  [ -n "$by" ] || by="$(default_by)"
  mkdir -p "$HOLD_ROOT" || { echo "agent-hold: cannot mkdir $HOLD_ROOT" >&2; exit 1; }

  local f="$HOLD_ROOT/$resource" tmp lowered since="" kept="" kept_ask=""
  # A re-set keeps what `lower` changed, so the release that ends it still restores it, and its
  # since, while it stays the same kind of hold: it has stood since it was first set, which is what
  # hold-age ages. A new kind is a new hold (a load hold re-set as a human's lockdown, a set over a
  # claim), and a since no date reads is repaired, not carried forward.
  lowered="$(field "$f" lowered)"
  if [ -f "$f" ] && [ "$(hold_kind "$f")" = "$kind" ]; then
    since="$(field "$f" since)"
    { [ -n "$since" ] && date -d "$since" +%s >/dev/null 2>&1; } || since=""
    # The human's keep goes with since: a re-set that only rewords the hold is still the hold they
    # re-confirmed.
    [ -n "$since" ] && kept="$(field "$f" kept)" kept_ask="$(field "$f" kept_ask)"
  fi
  tmp="$(mktemp "$HOLD_ROOT/.${resource}.XXXXXX")" || exit 1
  {
    printf 'resource: %s\n' "$resource"
    printf 'kind: %s\n'     "$kind"
    printf 'since: %s\n'    "${since:-$(now_iso)}"
    printf 'by: %s\n'       "$(oneline "$by")"
    printf 'roster: %s\n'   "$(oneline "$roster")"
    printf 'granted: \n'
    [ -n "$lowered" ] && printf 'lowered: %s\n' "$lowered"
    [ -n "$kept" ] && printf 'kept: %s\nkept_ask: %s\n' "$kept" "$kept_ask"
    printf 'reason: %s\n'   "$(oneline "$reason")"
  } > "$tmp"
  # Re-setting an existing hold replaces it (new reason, new roster, no grants, the same since),
  # atomically, so a reader never sees half a file.
  mv "$tmp" "$f"
  # Low on set and on release: fleet-pace sets and lifts holds itself, so a hold is the
  # fleet pacing itself, not something the human acts on. At high it was 10 of the phone's
  # 270 pages in 48h (2026-10-28). The hold still shows in the briefing and the preflight.
  notify -p low -t "hold: $resource" "$(oneline "$reason") (by $(oneline "$by"))"
  audit_append "$(oneline "$by")" hold.placed "$resource" ok "$(oneline "$reason")"
  echo "held: $resource"
}

# claim: a hold that one session takes for its own use, so two sessions never drive the
# same desktop at once. Unlike `set`, it never replaces someone else's hold: the file is
# created with noclobber, so of two racing claims exactly one wins. Re-claiming your own
# refreshes it. A claim left by a dead session is released by whoever finds it.
cmd_claim() {
  local resource="${1:-}"; shift || true
  need_resource "$resource"
  local by="" reason="" class=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --by|--class) [ $# -ge 2 ] || { echo "agent-hold claim: $1 needs a value" >&2; exit 2; }
        if [ "$1" = --by ]; then by="$2"; else class="$2"; fi; shift 2 ;;
      --) shift; reason="$*"; break ;;
      -*) echo "agent-hold claim: unknown flag $1" >&2; exit 2 ;;
      *)  reason="$*"; break ;;
    esac
  done
  [ -n "$reason" ] || { echo "agent-hold claim: say what you are doing with it" >&2; exit 2; }
  [ -z "$class" ] || [ -n "$(class_rank "$class")" ] || { echo "agent-hold claim: unknown class '$class' (agent-hold classes)" >&2; exit 2; }
  # A claim taken as this session also records its Claude session id: renumber-windows moves a
  # window's index, and so its target, while the claim is held, and the id keeps it the owner.
  # One made for a name given by --by is that name's alone.
  local f="$HOLD_ROOT/$resource" body own="" sidline=""
  if [ -n "$by" ]; then
    by="$(oneline "$by")"
    [ -f "$f" ] && [ "$(field "$f" by)" = "$by" ] && own=1
  else
    by="$(oneline "$(default_by)")"
    [ -z "${CLAUDE_CODE_SESSION_ID:-}" ] || sidline="sid: $(oneline "$CLAUDE_CODE_SESSION_ID")"$'\n'
    [ -f "$f" ] && owns_claim "$f" "$(callers)" && own=1
  fi
  mkdir -p "$HOLD_ROOT" || { echo "agent-hold: cannot mkdir $HOLD_ROOT" >&2; exit 1; }
  # A refresh with no --class keeps the class the claim had.
  if [ -z "$class" ] && [ -n "$own" ]; then class="$(field "$f" class)"; fi
  class="${class:-other}"
  body="$(printf 'resource: %s\nkind: claim\nclass: %s\nsince: %s\nby: %s\n%sroster: \ngranted: \nreason: %s\n' \
    "$resource" "$class" "$(now_iso)" "$by" "$sidline" "$(oneline "$reason")")"
  if [ -n "$own" ]; then
    printf '%s\n' "$body" > "$f"; echo "claimed: $resource (refreshed)"; return 0
  fi
  if ( set -o noclobber; printf '%s\n' "$body" > "$f" ) 2>/dev/null; then
    echo "claimed: $resource"; return 0
  fi
  # The holder keeps it; a better class is told it starts next, not that it may take over.
  local held; held="$(field "$f" class)"
  local outrank=""
  # A class the table no longer has (or a claim from before classes) ranks last.
  local hr; hr="$(class_rank "$held")"
  [ -n "$held" ] && [ "$(class_rank "$class")" -lt "${hr:-9}" ] &&
    outrank=" (you outrank it: requeue with --class $class, it starts next)"
  echo "busy: $resource since $(field "$f" since) by $(field "$f" by)${held:+ ($held)}: $(field "$f" reason)$outrank" >&2
  return 1
}

# in_list <name> <a,b,c>
in_list() { case ",$2," in *",$1,"*) return 0 ;; esac; return 1; }

cmd_grant() {
  local resource="${1:-}"; shift || true
  need_resource "$resource"
  [ $# -gt 0 ] || { echo "agent-hold grant: name at least one session, row, epic or plan" >&2; exit 2; }
  local f="$HOLD_ROOT/$resource"
  [ -f "$f" ] || { echo "agent-hold: $resource is not held, nothing to grant" >&2; exit 1; }
  local granted name
  granted="$(field "$f" granted)"
  for name in "$@"; do
    name="$(oneline "$name")"
    [ -n "$name" ] || continue
    case "$name" in *,*|*' '*) echo "agent-hold grant: bad name '$name' (one session, row, epic or plan id, no comma or space)" >&2; exit 2 ;; esac
    in_list "$name" "$granted" || granted="${granted:+$granted,}$name"
  done
  set_field "$f" granted "$granted" || exit 1
  notify -p normal -t "go: $resource" "granted $*; the rest stay held"
  audit_append "$(default_by)" hold.granted "$resource" ok "$*"
  echo "granted: $resource for $granted"
}

# keep <resource> --ask <id>: the human's answer `keep` on ask <id> about this hold becomes its
# `kept:` time, so its age (aged, hub's Needs and Alerts) runs from that answer, not from since: a
# hold the human just re-confirmed does not stand again until it is a day past the keep (ar-5307).
# The ask is the proof, not the caller's word: it must be answered keep by the human (an empty
# answered_by is refused: a hold's keep needs the record), name the resource as a word in its
# question or context (a text match: asks carry no hold field), and be newer than since and any
# earlier keep, or nothing is written.
cmd_keep() {
  local resource="${1:-}"; shift || true
  need_resource "$resource"
  [ "${1:-}" = --ask ] && [ -n "${2:-}" ] || { echo "agent-hold keep: usage: keep <resource> --ask <id>" >&2; exit 2; }
  local id="$2" f="$HOLD_ROOT/$resource" ask at
  [ -f "$f" ] || { echo "agent-hold: $resource is not held, nothing to keep" >&2; exit 1; }
  ask="$("${AGENT_ASK:-agent-ask}" show "$id" 2>/dev/null)" || { echo "agent-hold keep: no ask $id" >&2; exit 1; }
  askf() { sed -n "/^$1: /{s///p;q;}" <<<"$ask"; }
  [ "$(askf answer)" = keep ] && [ "$(askf answered_by)" = human ] \
    || { echo "agent-hold keep: ask $id is not answered keep by the human" >&2; exit 1; }
  grep -qE "(^|[^[:alnum:]_-])$resource([^[:alnum:]_-]|\$)" <<<"$(askf question) $(askf context)" \
    || { echo "agent-hold keep: ask $id does not name the hold $resource" >&2; exit 1; }
  local t s k
  at="$(askf answered_at)"
  t=$(date -d "$at" +%s 2>/dev/null) && [ -n "$at" ] || { echo "agent-hold keep: ask $id has no readable answered_at" >&2; exit 1; }
  # An empty value is no time: date -d "" alone reads as today's midnight.
  s="$(field "$f" since)"; { [ -n "$s" ] && s=$(date -d "$s" +%s 2>/dev/null); } || s=0
  k="$(field "$f" kept)"; { [ -n "$k" ] && k=$(date -d "$k" +%s 2>/dev/null); } || k=0
  [ "$t" -gt "$s" ] && [ "$t" -gt "$k" ] \
    || { echo "agent-hold keep: ask $id was answered before the hold's since or its last keep, nothing changed" >&2; exit 1; }
  set_field "$f" kept "$at" kept_ask "$id" || { echo "agent-hold: $resource is not held, nothing to keep" >&2; exit 1; }
  audit_append "$(default_by)" hold.kept "$resource" ok "ask $id"
  echo "kept: $resource since $at (ask $id)"
}

# unit_of <pid|self> -> the user unit a process runs in: the tmux pane scope, agent session scope
# (claude-acct scope) or agentctl unit on its cgroup path when there is one (a run started with
# `systemd-run --scope` from a pane sits in a scope nested inside the pane's), else the innermost
# .scope or .service.
# Exit 1 when the process is gone, 2 when it is not under this user's manager.
unit_of() {
  local path part unit="" batch=""
  path="$(sed -n 's/^0:://p' "$PROC_ROOT/$1/cgroup" 2>/dev/null)" || return 1
  [ -n "$path" ] || return 1
  case "$path" in */user@"$(id -u)".service/*) ;; *) return 2 ;; esac
  path="${path#*/user@"$(id -u)".service/}"
  local IFS=/
  for part in $path; do
    case "$part" in
      tmux-spawn-*.scope|agent-*.scope|agentctl@*.service) batch="${batch:-$part}" ;;
      *.scope|*.service) unit="$part" ;;
    esac
  done
  unit="${batch:-$unit}"
  [ -n "$unit" ] || return 2
  printf '%s' "$unit"
}

cmd_lower() {
  local resource="${1:-}"; shift || true
  need_resource "$resource"
  [ $# -gt 0 ] || { echo "agent-hold lower: name at least one pid" >&2; exit 2; }
  local f="$HOLD_ROOT/$resource"
  [ -f "$f" ] || { echo "agent-hold: $resource is not held; set it first, so its release restores what lower changes" >&2; exit 1; }
  # A claim is one session's use of a desktop, not a load hold, and its refresh rewrites
  # the file whole, so nothing recorded on it would survive to the release.
  [ "$(field "$f" kind)" = claim ] && { echo "agent-hold lower: $resource is a claim, not a load hold" >&2; exit 2; }
  local lowered pid unit self rc=0 err
  lowered="$(field "$f" lowered)"
  self="$(unit_of self)"
  for pid in "$@"; do
    [[ "$pid" =~ ^[0-9]+$ ]] || { echo "agent-hold lower: bad pid '$pid'" >&2; rc=2; continue; }
    unit="$(unit_of "$pid")"; err=$?
    case "$err" in
      1) echo "agent-hold lower: no process $pid" >&2; [ "$rc" -gt 1 ] || rc=1; continue ;;
      2) echo "agent-hold lower: pid $pid is not under this user's systemd manager; left alone" >&2; [ "$rc" -gt 1 ] || rc=1; continue ;;
    esac
    # Only units that are batch work: a desktop terminal's or app's scope is the human's,
    # and the caller's own pane would slow the pass that has to lift the hold.
    case "$unit" in
      tmux-spawn-*.scope|agent-*.scope|agentctl@*.service) ;;
      *) echo "agent-hold lower: pid $pid runs in $unit, not a tmux pane, agent session or agentctl unit; left alone" >&2; [ "$rc" -gt 1 ] || rc=1; continue ;;
    esac
    [ "$unit" = "$self" ] && { echo "agent-hold lower: pid $pid is in this pane ($unit); left alone" >&2; [ "$rc" -gt 1 ] || rc=1; continue; }
    if in_list "$unit" "$lowered"; then echo "lowered: $unit (pid $pid, already)"; continue; fi
    # Recorded before it is applied, so no interrupted run leaves a unit lowered that the
    # release does not know about. Restoring a unit that was never lowered is harmless.
    lowered="${lowered:+$lowered,}$unit"
    set_field "$f" lowered "$lowered" || exit 1
    systemctl --user set-property --runtime "$unit" "CPUWeight=$LOW_CPU_WEIGHT" ||
      { echo "agent-hold lower: systemctl could not set CPUWeight on $unit" >&2; [ "$rc" -gt 1 ] || rc=1; continue; }
    echo "lowered: $unit (pid $pid)"
  done
  return "$rc"
}

cmd_release() {
  local resource="${1:-}"
  need_resource "$resource"
  local f="$HOLD_ROOT/$resource"
  [ -f "$f" ] || { echo "agent-hold: $resource is not held" >&2; exit 1; }
  local reason roster
  reason="$(field "$f" reason)"; roster="$(field "$f" roster)"
  local unit failed=""
  for unit in $(field "$f" lowered | tr ',' ' '); do
    # An empty CPUWeight= drops the runtime setting. A pane closed since has no scope left.
    if systemctl --user set-property --runtime "$unit" CPUWeight=; then
      echo "restored: $unit"
    elif [ "$(systemctl --user show -p LoadState --value "$unit" 2>/dev/null)" = not-found ]; then
      echo "gone: $unit"
    else
      failed="${failed:+$failed,}$unit"
    fi
  done
  # The hold file is the only record of what is still lowered, so it stays until each
  # live unit is restored.
  if [ -n "$failed" ]; then
    set_field "$f" lowered "$failed"
    echo "agent-hold release: could not restore $failed; $resource stays held, release it again" >&2
    return 1
  fi
  rm -f "$f"
  # A lifted hold is what held starts back: wake a kick (dispatch_wake) rather than wait for the timer.
  dispatch_wake "agent-hold release $resource"
  notify -p low -t "go: $resource" "released (was: $reason)"
  audit_append "$(default_by)" hold.released "$resource" ok "was: $reason"
  echo "released: $resource"
  # Printed so the caller can send GO to exactly the sessions that were told to stop.
  [ -n "$roster" ] && echo "roster: $roster"
  return 0
}

cmd_check() {
  local resource="${1:-}"
  need_resource "$resource"
  case "${2:-}" in
    ''|--no-caller) ;;
    *) echo "agent-hold check: unknown argument $2" >&2; exit 2 ;;
  esac
  local f="$HOLD_ROOT/$resource"
  [ -f "$f" ] || return 0
  # --no-caller asks for a session that does not exist yet (agent-queue's hold:<resource>), so
  # no grant or claim of the asker's counts.
  local me=""
  [ "${2:-}" = --no-caller ] || me="$(callers)"
  if [ "$(field "$f" kind)" = claim ] && owns_claim "$f" "$me"; then
    echo "claimed: $resource by $(field "$f" by)" >&2
    return 0
  fi
  local name names
  IFS=, read -ra names <<<"$(field "$f" granted)"
  for name in "${names[@]}"; do
    in_names "$name" "$me" && { echo "granted: $resource for $name" >&2; return 0; }
  done
  echo "held: $resource since $(field "$f" since) by $(field "$f" by): $(field "$f" reason)"
  return 1
}

cmd_list() {
  local want=""
  case "${1:-}" in
    '') ;;
    --kind) [ $# -eq 2 ] || { echo "agent-hold list: --kind takes one value" >&2; exit 2; }; want="$2"
      case "$want" in load|resource|claim) ;; *) echo "agent-hold list: --kind is load, resource or claim, not '$want'" >&2; exit 2 ;; esac ;;
    *) echo "agent-hold list: unknown argument $1" >&2; exit 2 ;;
  esac
  [ -d "$HOLD_ROOT" ] || return 0
  local f g c
  for f in "$HOLD_ROOT"/*; do
    [ -f "$f" ] || continue
    [ -z "$want" ] || [ "$(hold_kind "$f")" = "$want" ] || continue
    g="$(field "$f" granted)" c="$(field "$f" class)"
    printf '%s\t%s\t%s\t%s%s%s\n' "${f##*/}" "$(field "$f" since)" "$(field "$f" by)" "${c:+[$c] }" "$(field "$f" reason)" "${g:+ (granted: $g)}"
  done
}

# aged [--days N] -> one line per standing hold set N days ago or longer (AGENT_HOLD_AGE_DAYS, 1), its
# age, who set it and why, then how to end it and `page: high`; exit 1 when any, 0 when none. A
# standing hold is one only the human ends: a resource hold, or any hold `by: human`. A load hold
# (the shepherd lifts it once the machine reads CLEAR) and a claim (it ends with its skill) are
# exempt. It reads and never releases: a hold is the human's word, so its age is a page, never a
# timeout (ask GwQIYE, 2026-11-21). The watch hold-age runs it at severity high, since only the human
# releases one (priority.md). Event-free by necessity: a hold growing old has no event, so the watch samples.
cmd_aged() {
  local days="${AGENT_HOLD_AGE_DAYS:-1}" f since s k age now n=0 kind
  case "${1:-}" in
    '') ;;
    --days) [[ "${2:-}" =~ ^[0-9]+$ ]] || { echo "agent-hold aged: --days takes a whole number" >&2; exit 2; }; days="$2" ;;
    *) echo "agent-hold aged: unknown argument $1" >&2; exit 2 ;;
  esac
  [ -d "$HOLD_ROOT" ] || return 0
  now=$(date +%s)
  for f in "$HOLD_ROOT"/*; do
    [ -f "$f" ] || continue
    kind="$(hold_kind "$f")"
    [ "$kind" = resource ] || { [ "$kind" != claim ] && [ "$(field "$f" by)" = human ]; } || continue
    since="$(field "$f" since)"
    # A since no date reads is a hold nobody can age: it shows, since it is as old as anything. An
    # empty one too: `date -d ""` reads as today's midnight.
    { [ -n "$since" ] && s=$(date -d "$since" +%s 2>/dev/null); } || s=0
    age=$(( (now - s) / 86400 ))
    # A keep (cmd_keep) restarts the clock: the human re-confirmed it, so it waits a day past that.
    k="$(field "$f" kept)"
    if [ -n "$k" ] && k=$(date -d "$k" +%s 2>/dev/null) && [ "$k" -gt "$s" ]; then
      [ $(( (now - k) / 86400 )) -ge "$days" ] || continue
    fi
    [ "$age" -ge "$days" ] || continue
    n=$((n + 1))
    printf '%s: held %sd, since %s by %s: %s\n' "${f##*/}" "$age" "${since:-an unreadable time}" "$(field "$f" by)" "$(field "$f" reason)"
  done
  [ "$n" -gt 0 ] || return 0
  echo "$n hold(s) set $days day(s) ago or longer; release each that is done (agent-hold release <resource>) or ask its setter; nothing releases them on age"
  echo "page: high"
  return 1
}

cmd_show() {
  local resource="${1:-}"
  need_resource "$resource"
  cat "$HOLD_ROOT/$resource" 2>/dev/null || { echo "agent-hold: $resource is not held" >&2; exit 1; }
}

cmd_classes() { printf '%s\n' "$DESK_CLASSES"; }

usage() { sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'; }

verb="${1:-}"; shift || true
case "$verb" in
  set)     cmd_set "$@" ;;
  claim)   cmd_claim "$@" ;;
  grant)   cmd_grant "$@" ;;
  lower)   cmd_lower "$@" ;;
  keep)    cmd_keep "$@" ;;
  release) cmd_release "$@" ;;
  check)   cmd_check "$@" ;;
  list)    cmd_list "$@" ;;
  aged)    cmd_aged "$@" ;;
  classes) cmd_classes ;;
  show)    cmd_show "$@" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
