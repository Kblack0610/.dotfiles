say() { printf 'fleet-bench: %s\n' "$*" >&2; }

# agent-proof.sh owns the agentctl state dir and the last-outcome contract.
proof_lib() {
  local lib="${BENCH_LIB_DIR:-$HOME/.local/lib}/agent-proof.sh"
  # shellcheck source=/dev/null
  [ -f "$lib" ] && . "$lib"
}

report_outcome() { proof_lib && proof_outcome "$NAME" "$@"; }

now() { printf '%s' "${BENCH_NOW:-$(date +%s)}"; }

# with_reads <cmd...>: run the command inside one read cache (BENCH_READ_CACHE), removed after it,
# so the counts it takes read one snapshot of each source and read it once. Nested, it joins the
# open one. The concurrent sections of par_go keep their output in it too.
with_reads() {
  [ -z "${BENCH_READ_CACHE:-}" ] || { "$@"; return; }
  local BENCH_READ_CACHE rc traps
  traps=$(trap -p TERM INT HUP)
  BENCH_READ_CACHE=$(mktemp -d "${TMPDIR:-/tmp}/fleet-bench-reads.XXXXXX") || return 1
  trap 'rm -rf -- "$BENCH_READ_CACHE"; exit 143' TERM INT HUP
  "$@"; rc=$?
  trap - TERM INT HUP; eval "$traps"
  rm -rf -- "$BENCH_READ_CACHE"
  return "$rc"
}

# bench_read <cmd...> -> the command's output and status. Under with_reads each distinct command
# line runs once and every later caller gets that answer, a concurrent section included (it waits
# on the lock); outside one, the command just runs. A failed read is not kept, so the next caller
# tries it again. The queue's done read alone is about 3 s and 10 MB, and the KPIs took it four
# times (ar-4590).
bench_read() {
  [ -n "${BENCH_READ_CACHE:-}" ] && command -v flock >/dev/null || { "$@"; return; }
  local f rc=0
  f="$BENCH_READ_CACHE/read.$(printf '%s\0' "$@" | sha1sum | cut -d' ' -f1)"
  {
    flock 9
    if [ ! -e "$f.ok" ]; then
      "$@" >"$f.out" 9>&- || rc=$?
      [ "$rc" -ne 0 ] || : >"$f.ok"
    fi
    cat "$f.out"   # under the lock: a caller retrying a failed read rewrites the file
  } 9>"$f.lock"
  return "$rc"
}

# Concurrent sections, inside with_reads: par_open (after `local PAR PAR_PIDS`) makes the caller's
# dir, par_go <name> <cmd...> starts one section with its stdout in $PAR/<name>, par_wait waits for
# them all. The caller prints the files in its own order, so the output is the serial one.
par_open() { PAR=$(mktemp -d "$BENCH_READ_CACHE/par.XXXXXX") && PAR_PIDS=(); }
par_go() { local n=$1; shift; "$@" >"$PAR/$n" & PAR_PIDS+=("$!"); }
par_wait() { wait "${PAR_PIDS[@]}"; }

# jq helpers shared by every verb.
VITALS_JQ='def vitals($v): [$v | splits("\\s+") | select(test("^[^=]+=[^=]+$")) | split("=") | {question: .[0], kpi: (.[1] | split(",")[])}];'
JQ_LIB='
def median: sort | length as $n | if $n == 0 then null
  elif $n % 2 == 1 then .[($n - 1) / 2] else (.[$n / 2 - 1] + .[$n / 2]) / 2 end;
def iso: strflocaltime("%Y-%m-%dT%H:%M:%S%z");
def hm: if . == null then "-" else strflocaltime("%a %H:%M") end;
def round1: . * 10 | round / 10;
def round2: . * 100 | round / 100;
def ownerless: select((.state == "running" or .state == "review" or .state == "waiting") and (.session // "") == "" and (.sessions // "") == "");
def ep: if . == null or . == "" then null else (sub("\\.[0-9]+"; "") | fromdateiso8601? // null) end;   # a queue or gh time
def tagged($t): (" " + (.tags // "") + " ") | contains(" \($t) ");
# A canary score on the claude baseline: claude as dispatch runs it. A claude lane pins an effort (canary queue), so it is never pooled in.
def canary_base: (.harness // "claude") == "claude" and (.effort // "") == "";
# canary_control($t): a lane (score row) running task $t is the positive control: the claude baseline on opus
# doing a 1-point known-answer task, which the instrument must see pass. A row with no model is not one: its
# harness record was lost (a free lane run has scored as bare claude), so it vouches for nothing.
def canary_control($t): canary_base and .model == "opus" and $t.pts == 1 and ($t.merge // null) == null;
# An end that says nothing about the model (UNRATED_ENDS, lib/end-reasons.sh) is no evidence for or against it.
def unrated: (.end_reason // "") | IN('"$(unrated_json)"'[]);
# A canary score whose session ended outside the model (canary_score, OUTSIDE_ENDS) has pass null: not run, in no pass rate.
def canary_ran: .pass != null;
# canary_batch: the ISO week a score ran in, as its run slug names it (canary_slug), else as its epoch falls.
def canary_batch: first(.run // "" | capture("-(?<w>[0-9]{4}w[0-9]{2})(-|$)").w) // (.epoch // 0 | strflocaltime("%Gw%V"));
# canary_graded: the score rows with every instrument fault made not run (pass null, instrument true), so no
# rate reads one: a runner not found (rc 127), and every run in a batch whose positive control (control
# true, canary_score) failed on its latest run of a task, since the oracle or the sandbox, not the model, is what
# that week measured; a rerun that passes clears the week.
def canary_graded: (map(select(.control == true and .pass != null)) | group_by([canary_batch, .id])
    | map(max_by(.epoch) | select(.pass == false) | canary_batch) | unique) as $bad
  | map(if .rc == 127 or (canary_batch | IN($bad[])) then . + {pass: null, instrument: true} else . end);
# wilson($k; $n): the Wilson 95% interval of $k passes in $n trials, {lo, hi} to 2 places; null over none, or
# when $k is past $n (no proportion, so no interval).
def wilson($k; $n): if ($n // 0) == 0 or $k == null or $k > $n then null else 3.8416 as $z2 | ($k / $n) as $p | (1 + $z2 / $n) as $d
  | (($p + $z2 / (2 * $n)) / $d) as $c | (1.96 * (($p * (1 - $p) / $n + $z2 / (4 * $n * $n)) | sqrt) / $d) as $h
  | {lo: ([$c - $h, 0] | max | . * 100 | round / 100), hi: ([$c + $h, 1] | min | . * 100 | round / 100)} end;
# ci_cell: a rate, its interval and its n for a table cell, as "0.4 (0.12-0.77, n 5)"; - with no rate.
def ci_cell($r; $ci; $n): if $r == null then "-" else "\($r)" + (if $ci then " (\($ci.lo)-\($ci.hi), n \($n))" else "" end) end;
# vs_ci($a; $b): where interval $a sits against $b: above, below, or overlap (no rank between them); null without both.
def vs_ci($a; $b): if $a == null or $b == null then null elif $a.lo > $b.hi then "above" elif $a.hi < $b.lo then "below" else "overlap" end;
def hold_key: "fix(hold): \(.name) went red";
# an epic (notes projects rollup) whose every leaf has closed: ready to verify
def leaves_landed: .open == 0 and .done > 0;
# agent-ask stamps date +%Y-%m-%dT%H:%M:%S%z; jq has no offset-aware parser
def ask_epoch: (.[0:19] + "Z" | fromdateiso8601)
  - ((if .[19:20] == "-" then -1 else 1 end) * ((.[20:22] | tonumber) * 3600 + (.[22:24] | tonumber) * 60));
# iso_epoch: an ISO time with a Z, +HH:MM or +HHMM offset (date -Iseconds writes the colon form)
def iso_epoch: if endswith("Z") then fromdateiso8601 else sub(":(?<m>[0-9]{2})$"; "\(.m)") | ask_epoch end;
def ratio($a; $b): if $b == 0 then null else ($a / $b * 1000 | round) / 1000 end;   # 3 places, null over none
# landed, rated: the stamped outcome of a done item (agent-queue OUTCOME_JQ); rated is what a landed rate is over
def landed: .outcome == "landed";
# sids: the session ids of an item; the models, skills, sources and matrix tables share it
def sids: (.sessions // "") | split(" ") | map(select(. != ""));
def rated: .outcome | IN("landed", "no-pr", "failed");
# move($before; $after; $dir; $flat): improved or regressed when the value moved more than $flat
# (relative) the way $dir says (-1 lower is better, 1 higher), flat inside that, - with no value
def move($b; $a; $dir; $flat): if $b == null or $a == null or $dir == 0 then "-"
  else (if $b == 0 then (if $a == 0 then 0 else ($a | if . > 0 then 1 else -1 end) end)
        else ($a - $b) / ($b | fabs) end) as $rel
  | if ($rel | fabs) <= $flat then "flat" elif $rel * $dir > 0 then "improved" else "regressed" end end;
def dur: if . >= 3600 then "\(. / 3600 | round1)h" else "\(. / 60 | round)m" end;
def run_rows: split("\n") | map(select(. != "") | split("\t")
  | {s: ((.[0] | tonumber) - (.[1] | tonumber)), res: .[2], branch: .[5], repo: .[6]});
def total(f): map(f // 0) | add // 0;
def key: "\(.repo)#\(.number)";
# the lowercase owner/repo#N an item names (prkeys); the repo of a Forgejo row also carries its host
def itemkey: "\(.repo // "" | split("/") | .[-2:] | join("/") | ascii_downcase)#\(.number)";
# every PR an item names (pr and prs, owner/repo#N or a pull URL), lowercase owner/repo#N. A bare
# number names no repo, so it credits nothing: PR numbers repeat across repos.
def prkeys: [.pr, .prs] | map(strings) | join(" ") | ascii_downcase
  | [scan("([a-z0-9_.-]+/[a-z0-9_.-]+)(?:#|/pulls?/)([0-9]+)") | "\(.[0])#\(.[1])"];
# the "<project>:<id>" board row a queue item works: its row, else the board: it came from
def rowkey: .row // ((.from // "") | select(startswith("board:")) | ltrimstr("board:"));
# a board feed row on the agent boards of profile $p in a project with automation on: the unit
# dispatch pulls from. on_board is the open or started one still on the board (a row with the retired
# backlog token is off it). board_open (board_reading) and the pipeline backlog step both count these.
def agent_row($p): .profile == $p and .lane == "agent" and .automation != false;
def on_board($p): agent_row($p) and (.state == "open" or .state == "doing") and .backlog != true;
# who wrote an ingest.jsonl event, the one rule for it: the human by hand (writer "human" or none),
# a runner by its conf name ($runners: {<name>: true}), else a session (its item, slug or session id)
def human_writer: (.by // "") | IN("", "human");
def door($runners): if human_writer then "human" elif (.by | type) == "string" and $runners[.by] then .by else "session" end;
# how an ingest.jsonl event takes work off the chain, else empty: merged, done, or a drop split into
# dup (dup:<id>), moved (sent to its home: `moved:`, improvements.md, a sheet, another board) and
# dropped. An `improvement` event is the write at the home, paired with its drop, so it is no exit.
def out_kind: if .action == "merged" or .action == "done" then .action
  elif .action == "dup" then "dup"
  elif .action != "dropped" then empty
  elif (.why // "") | test("^dup:") then "dup"
  elif (.why // "") | test("^dropped: (moved\\b|kept in .*improvements\\.md|on the .* sheet|.*\\bsent to the )") then "moved"
  else "dropped" end;
# board rows -> the oldest open #requested agent row as {project, id, since, h}, ties by key so the
# named row is stable; the one source of requested_unstarted_h and the row it names
def oldest_request($t): [.[] | select(.lane == "agent" and .requested and .state == "open" and ((.since // "") | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")))]
  | sort_by([.since, .project, .id]) | first // empty
  | {project, id, since, h: (($t - (.since + "T00:00:00Z" | fromdate)) / 3600 | floor)};
def claimed: (.session_id // "") != "";
def ran_gate: (.gate_runs // 0) > 0;
def first_try: .gate_red == 0;
def kind: sub("\\(.*"; "");
# the ETA an estimate publishes and how it was made: calibrated when a factor was applied;
# null for no estimate
def shown_eta: if . == null then null else .cal_eta_epoch // .eta_epoch end;
# the ETA column of a live row: the time, or how late it is once that time has passed
def eta_cell: if .late_min != null then "late \(.late_min * 60 | dur)" else (.eta | shown_eta | hm) end;
def basis_label: if . == null then null
  else .basis + (if .factor != null then " x\(.factor) (n=\(.factor_n))" else "" end) end;
# scores in -> one object per basis kind: how far its raw ETAs ran, and the calibration factor
# a new estimate of that kind gets (null below $minn scores with a ratio). Scores are raw, so
# the factor is made from raw ratios only.
def accuracy($minn; $lo; $hi):
  group_by(.basis | kind) | map(
    (map(.ratio // empty) | median | if . == null then null else (. * 100 | round) / 100 end) as $mr
    | (map(.ratio // empty) | length) as $nr
    | {basis: (.[0].basis | kind), n: length, n_ratio: $nr, median_ratio: $mr,
       median_error_min: (map(.error_min) | median),
       median_abs_error_min: (map(.error_min | fabs) | median),
       factor: (if $nr < $minn then null else [[$mr, $lo] | max, $hi] | min end)});
# per-phase minutes for each phase whose start and end were both sampled
def phase_minutes:
  sort_by(.epoch)
  | reduce .[] as $r ({prev: null, starts: []};
      if .prev != null and $r.phases_done != null and .prev.phases_done != null
         and $r.phases_done > .prev.phases_done
      then .starts += [{epoch: $r.epoch, from: .prev.phases_done, to: $r.phases_done}]
      else . end
      | .prev = $r)
  | .starts as $s
  | [range(1; $s | length) | ($s[.].epoch - $s[. - 1].epoch) / 60 / ($s[.].to - $s[.].from)];
def pct($q): sort | if length == 0 then null else .[((length - 1) * $q) | floor] end;
# live rows (latest_live) in -> each session with phases left and a measured pace, every open
# phase given a p50 end (per-phase minutes x the estimate factor) and a slow end (x $slow, the
# last window scored ratio), in plan order. A session past its ETA has its current phase due
# now and the rest after it. $names maps session_id to the open phase names of its plan.
def schedule($t; $slow; $names):
  map(select((.finished | not) and .phases_total != null and .phases_done != null and .eta != null)
    | (.phases_total - .phases_done) as $left | select($left > 0)
    | . as $r | ($r.eta.per_phase_min * 60) as $m
    | ($m * ($r.eta.factor // 1)) as $P | ($m * $slow) as $S
    | ([$r.eta.made_epoch + $P, $t] | max) as $p1 | ([$r.eta.made_epoch + $S, $t] | max) as $s1
    | ($names[$r.session_id] // []) as $nm
    | {session_id, target, project, bucket, phases_done, phases_total, left: $left, late_min,
       basis: ($r.eta | basis_label),
       phases: [range(0; $left) | {name: ($nm[.] // "phase \($r.phases_done + . + 1)"),
                                   p50: ($p1 + . * $P | floor), slow: ($s1 + . * $S | floor)}]}
    | . + {finish_p50: .phases[-1].p50, finish_slow: .phases[-1].slow});
def fleet_finish: {median_p50: (map(.finish_p50) | median | if . == null then null else floor end),
  p90_p50: (map(.finish_p50) | pct(0.9)), last_p50: (map(.finish_p50) | max),
  median_slow: (map(.finish_slow) | median | if . == null then null else floor end),
  p90_slow: (map(.finish_slow) | pct(0.9)), last_slow: (map(.finish_slow) | max)};
# queue items in (enriched by forecast_json: phases, P and S seconds a phase, start, live, after,
# why) -> each item placed on $K dispatcher slots on track $k ("P" or "S"). Running items hold a
# slot until they end (the finish of its live session when that is on the schedule). Each time
# the earliest slot frees, it goes to the first queued item in queue order whose after: parents
# have all ended by then, or else to the one ready soonest: fleet-dispatch starts the runnable head.
# Items with a why, and those behind one, stay unplaced.
def qplace($t; $K; $k):
  (map(select(.state == "running")
       | . + {end: (if .live != null then .live[$k] else ([.start + .phases * .[$k], $t] | max | floor) end)})) as $run
  | ($run | map(.end)) as $busy
  | {done: ($run | map({key: .slug, value: .end}) | from_entries),
     free: ($busy + [range(0; [$K - ($busy | length), 0] | max) | $t] | sort),
     placed: ($run | map({slug, start, end})),
     todo: map(select(.state == "queued" and .why == null)), stuck: false}
  | until((.todo | length) == 0 or .stuck;
      . as $s
      | ($s.free[0] // $t) as $slot
      | [$s.todo | to_entries[] | (.value.after // []) as $par | select(all($par[]; $s.done[.] != null))
         | . + {ready: ([$par[] | $s.done[.]] + [$t] | max)}] as $can
      | (($can | map(select(.ready <= $slot)) | first) // ($can | min_by(.ready))) as $pick
      | if $pick == null then .stuck = true
        else $pick.value as $it
          | ([$pick.ready, $slot] | max) as $start
          | ($start + $it.phases * $it[$k] | floor) as $end
          | .free = (.free[1:] + [$end] | sort) | .done[$it.slug] = $end
          | .placed += [{slug: $it.slug, start: $start, end: $end}]
          | .todo = (.todo | del(.[$pick.key]))
        end)
  | {placed: (.placed | INDEX(.slug)), behind: (.todo | map(.slug))};
# progress rows in -> open phases in the newest sample at or before $t
def open_at($t): map(select(.epoch <= $t)) | (map(.epoch) | max) as $s
  | if $s == null then 0 else
      map(select(.epoch == $s and (.finished | not) and .phases_total != null and .phases_done != null)
          | .phases_total - .phases_done | select(. > 0)) | add // 0 end;
# progress rows in -> one step per sample of each (session, plan): the first sample of a plan
# starts it with its open phases; every later one ticks, adds or removes phases against the one before.
# A plan is its file name, since every account plan dir links to one tree (no file: the session
# alone). Only the session that sampled a plan first brings its phases in (open); a later session
# starting it resumes phases another session left (resumed, resume 1), counted when they came in, so
# they never count twice.
# A resume step carries prev_end, the last sample of the session that had the plan before it. A
# session gone from the newest sample whose plan no later session took up ends with an end step:
# left, the phases it left open, and began, when its plan first came in.
def flow_steps: map(select(.phases_total != null and .phases_done != null) | . + {plan: (if (.plan_file // "-") | IN("", "-") then "session \(.session_id)" else .plan_file | split("/") | last end)})
  | (map(.epoch) | max) as $last
  | [group_by([.session_id, .plan_file])[] | sort_by(.epoch)]
  | (map({epoch: .[0].epoch, session_id: .[0].session_id, plan: .[0].plan, last: .[-1].epoch}) | group_by(.plan)
     | map({key: .[0].plan, value: sort_by([.epoch, .session_id])}) | from_entries) as $starts
  | map(. as $r | $starts[$r[0].plan] as $s | ([$r[0].phases_total - $r[0].phases_done, 0] | max) as $o
      | ($s[0].session_id == $r[0].session_id and $s[0].epoch == $r[0].epoch) as $new
      | {epoch: 0, session_id: $r[0].session_id, project: $r[0].project, start: 0, open: 0, resumed: 0, resume: 0,
         ticked: 0, added: 0, removed: 0, end: 0, left: 0, began: $s[0].epoch, prev_end: null} as $z
      | [$z + {epoch: $r[0].epoch, start: 1, open: (if $new then $o else 0 end), resumed: (if $new then 0 else $o end), resume: (if $new then 0 else 1 end),
               prev_end: (if $new then null else [$s[] | select(.epoch < $r[0].epoch or (.epoch == $r[0].epoch and .session_id < $r[0].session_id)) | .last] | max end)}]
        + [range(1; length) | $z + {epoch: $r[.].epoch,
          ticked: ([$r[.].phases_done - $r[. - 1].phases_done, 0] | max),
          added: ([$r[.].phases_total - $r[. - 1].phases_total, 0] | max),
          removed: ([$r[. - 1].phases_total - $r[.].phases_total, 0] | max)}]
        + (if $r[-1].epoch < $last and ($s | any(.epoch > $r[0].epoch) | not)
           then [$z + {epoch: $r[-1].epoch, end: 1, left: ([$r[-1].phases_total - $r[-1].phases_done, 0] | max)}] else [] end)) | add // [];
# steps in -> their sums over a window from $a. abandoned is the phases left by plans that ended or
# were switched away from unfinished and came in after $a: they count apart, never in in.
def flow_sum($a): {ticked: (map(.ticked) | add // 0), added: (map(.added) | add // 0),
  removed: (map(.removed) | add // 0), started: (map(.start) | add // 0), started_open: (map(.open) | add // 0),
  resumed: (map(.resumed) | add // 0), resumed_plans: (map(.resume) | add // 0),
  abandoned: (map(select(.began > $a) | .left) | add // 0)}
  | . + {in: (.started_open + .added - .abandoned)};
# progress rows in -> what came in and what went out between $a and $b. dropped is the open
# phases that left with a session that ended unfinished or switched plans: the remainder of the
# balance, where abandoned ones (flow_sum) are already out of in, and resumed phases are open
# phases another session took up again. handed is the resumed phases whose earlier session was
# still sampled at the window start or later, so they were in the balance already and no drop.
def flow($a; $b): . as $p | (($b - $a) / 3600) as $h
  | def per($x): if $h > 0 then $x / $h | round2 else null end;
  ($p | flow_steps | map(select(.epoch > $a and .epoch <= $b))) as $st
  | ($p | open_at($a)) as $o0 | ($p | open_at($b)) as $o1
  | ($st | flow_sum($a)) as $f
  | ($p | map(select(.epoch <= $a)) | map(.epoch) | max // -1) as $s0
  | ($st | map(select(.resume == 1 and (.prev_end // -2) >= $s0) | .resumed) | add // 0) as $handed
  | {from: $a, to: $b, hours: ($h | round2)} + $f
  + {net_in: ($f.in - $f.removed), in_per_h: per($f.in), out_per_h: per($f.ticked),
     net_in_per_h: per($f.in - $f.removed), open_start: $o0, open_end: $o1, handed: $handed,
     dropped: ($o0 + $f.in + $f.abandoned + $f.resumed - $handed - $f.removed - $f.ticked - $o1),
     by_project: ($st | group_by(.project) | map({project: .[0].project} + flow_sum($a)) | sort_by(-.ticked)),
     hourly: ($st | group_by(.epoch / 3600 | floor) | map({hour: ((.[0].epoch / 3600 | floor) * 3600)} + flow_sum($a))
       | reduce .[] as $x ({scope: $o0, done: 0, rows: []};
           .scope += ($x.in - $x.removed) | .done += $x.ticked
           | .rows += [$x + {scope: .scope, done: .done}]) | .rows)};
# progress rows in -> a frozen forecast $b against what happened by $t: per baseline session the
# phases expected by now (p50 and slow) against the phases it ticked, and the scope that came in.
def vs($b; $t): . as $p | $b.made_epoch as $m
  | ($p | map(select(.epoch <= $t)) | map(.epoch) | max) as $last
  | ($p | map(select(.epoch == $last)) | map({key: .session_id, value: .}) | from_entries) as $cur
  | ($p | flow_steps | map(select(.epoch > $m and .epoch <= $t))) as $st
  | ($b.schedule | map(.session_id)) as $ids
  | ($b.schedule | map(. as $s | $cur[$s.session_id] as $r
      | ($st | map(select(.session_id == $s.session_id))) as $mine
      | ([$s.phases[] | select(.p50 <= $t)] | length) as $exp
      | ([$mine | map(.ticked) | add // 0, $s.left] | min) as $act
      | {target: $s.target, session_id: $s.session_id, left: $s.left, expected: $exp,
         expected_slow: ([$s.phases[] | select(.slow <= $t)] | length), ticked: $act,
         added: ($mine | map(.added) | add // 0), removed: ($mine | map(.removed) | add // 0),
         new_plans: ($mine | map(.start) | add // 0),
         state: (if $r == null then "gone"
                 elif $r.finished or $act >= $s.left or ($r.phases_total != null and $r.phases_done != null and $r.phases_done >= $r.phases_total) then "finished"
                 elif $act > $exp then "ahead" elif $act < $exp then "behind" else "on track" end),
         next: ($s.phases[$act].name // null)}
      # behind: minutes since the phase it is on was due; ahead: minutes early on the last one it ticked
      | . + {min: (if .state == "behind" then (($t - $s.phases[$act].p50) / 60 | floor)
                   elif .state == "ahead" then (($s.phases[$act - 1].p50 - $t) / 60 | floor) else null end)})) as $rows
  | ($p | flow($m; $t)) as $f
  | {label: $b.label, made_epoch: $m, now: $t, hours: (($t - $m) / 3600 | round2),
     expected: ($rows | map(.expected) | add // 0), expected_slow: ($rows | map(.expected_slow) | add // 0),
     ticked: ($rows | map(.ticked) | add // 0), ticked_all: $f.ticked,
     states: ($rows | group_by(.state) | map({key: .[0].state, value: length}) | from_entries),
     added: ($rows | map(.added) | add // 0), removed: ($rows | map(.removed) | add // 0),
     new_plans: ($rows | map(.new_plans) | add // 0),
     started_since: ($st | map(select(.start == 1 and (.session_id as $i | $ids | index($i) | not)) | .session_id) | unique | length),
     in: $f.in, in_per_h: $f.net_in_per_h, in_per_h_frozen: $b.drain.in_per_h, out_per_h: $f.out_per_h,
     sessions: $rows};
# progress rows in -> the score of baseline $b at $t once it resolves: every one of its sessions
# finished or gone, or $hz hours passed. Nothing until then, so a baseline is scored once.
def forecast_score($b; $t; $hz): . as $p | $b.made_epoch as $m
  | ($p | map(select(.epoch <= $t)) | map(.epoch) | max) as $last
  | ($p | flow_steps | map(select(.epoch > $m and .epoch <= $t))) as $st
  | ($b.schedule | map(. as $s | ($p | map(select(.session_id == $s.session_id and .epoch > $m and .epoch <= $t))) as $r
      # done when it says so, or once it has ticked as many phases as it had open, as vs counts it
      | ([$st[] | select(.session_id == $s.session_id)] | sort_by(.epoch)
         | reduce .[] as $x ({n: 0, at: null}; .n += $x.ticked | if .at == null and .n >= $s.left then .at = $x.epoch else . end) | .at) as $ticked
      | ([($r | map(select(.finished or (.phases_total != null and .phases_done != null and .phases_done >= .phases_total))) | map(.epoch) | min), $ticked]
         | map(select(. != null)) | min) as $fin
      | ($r | map(.epoch) | max) as $seen
      | if $fin != null then {end: $fin, how: "finished"}
        # gone: ended by the first sample that no longer had it
        elif ($seen // $m) < $last then {end: ($p | map(.epoch | select(. > ($seen // $m))) | min), how: "gone"}
        else {end: null, how: "open"} end)) as $ends
  | ($ends | map(select(.end == null)) | length) as $open
  | select($open == 0 or $t - $m >= $hz * 3600)
  | (if $open == 0 then ($ends | map(.end) | max) else $t end) as $end
  | def ratio($pred): if $pred == null or $pred <= $m then null else (($end - $m) / ($pred - $m) | round2) end;
  {label: $b.label, made_epoch: $m, scored_epoch: $t, resolved_by: (if $open == 0 then "all done" else "horizon" end),
   sessions: ($ends | length), finished: ($ends | map(select(.how == "finished")) | length),
   gone: ($ends | map(select(.how == "gone")) | length), open: $open,
   actual_last: (if $open == 0 then $end else null end),
   bound: (if $open == 0 then "exact" else "lower" end),
   pred_last_p50: $b.last_p50, pred_last_slow: $b.last_slow, pred_drain: $b.drain.epoch,
   ratio_p50: ratio($b.last_p50), ratio_slow: ratio($b.last_slow),
   error_min: (if $b.last_p50 == null then null else (($end - $b.last_p50) / 60 | floor) end),
   within_slow: ($b.last_slow != null and $end <= $b.last_slow)}
  + ($p | flow($m; $end) | {in, ticked, in_per_h: .net_in_per_h, in_per_h_frozen: $b.drain.in_per_h});
'

# sample_rows -> the live fleet-sessions rows as progress lines (NIGHTLY, CHECKOUT and SHARED rows have no session)
# A row held open on the human's word (kept.jq, the shepherd's definition) is sampled held: true, so
# window_stats counts its STALLED minutes as HELD, not as the fleet's stall (ar-5151: the 11-23 Stalled
# row named dotfiles-agent-14, labelled manual by the human, at 23.7h).
sample_rows() {
  local t="$1" kept
  kept="$(grep -v '^#' "${BENCH_LIB_DIR:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib}/kept.jq")" || return 1
  $BENCH_SESSIONS_CMD | jq -c --argjson t "$t" "$JQ_LIB$kept"'
    select(type == "object" and (.session_id // "") != "" and (.bucket | IN("NIGHTLY", "CHECKOUT", "SHARED") | not))
    | {epoch: $t, at: ($t | iso), session_id, target, project, bucket,
       phases_done, phases_total, next_phase, finished: (.finished // false), idle_min, active_min,
       context_tokens, nudged, escalated, pr, plan_file, held: kept}'
}

# new_estimates <now> -> an estimate for every live, unfinished session with a phase count
# that has no estimate yet. Reads the whole progress history for the medians. The raw ETA is
# what gets scored; the calibration factor is the median raw ratio of that basis kind's past
# scores, kept in its own fields, so it never feeds back into the ratios it is made from.
new_estimates() {
  local t="$1" est="$ESTIMATES" sc="$SCORES"
  [ -s "$est" ] || est=/dev/null
  [ -s "$sc" ] || sc=/dev/null
  jq -cn --argjson t "$t" --argjson def "$BENCH_DEFAULT_PHASE_MIN" --argjson minb "$BENCH_BASIS_MIN_N" \
     "${CAL_ARGS[@]}" --slurpfile p "$PROGRESS" --slurpfile e "$est" --slurpfile s "$sc" "$JQ_LIB"'
    ($p | group_by(.session_id) | map({key: .[0].session_id,
          value: (group_by(.plan_file) | map(phase_minutes) | add // [])}) | from_entries) as $bys
    | ($p | group_by(.project) | map({key: .[0].project,
          value: (group_by([.session_id, .plan_file]) | map(phase_minutes) | add // [])}) | from_entries) as $byp
    | ($e | map("\(.session_id)/\(.phases_done)/\(.phases_total)") | INDEX(.)) as $have
    | ($s | accuracy($minn; $lo; $hi) | INDEX(.basis)) as $acc
    | $p | map(select(.epoch == $t)) | .[]
    | select(.finished | not) | select(.phases_total != null and .phases_done != null)
    | select($have["\(.session_id)/\(.phases_done)/\(.phases_total)"] | not)
    | ($bys[.session_id] // []) as $s | ($byp[.project] // []) as $j
    | (if ($s | length) >= $minb then {m: ($s | median), basis: "session-median(\($s | length))"}
       elif ($j | length) >= $minb then {m: ($j | median), basis: "project-median(\($j | length))"}
       else {m: $def, basis: "default"} end) as $pp
    | ($t + (((.phases_total - .phases_done) * $pp.m * 60) | floor)) as $eta
    | ($acc[$pp.basis | kind].factor // null) as $f
    | {made_epoch: $t, made_at: ($t | iso), session_id, target, project, phases_done,
       phases_total, per_phase_min: ($pp.m | floor), eta_epoch: $eta, eta: ($eta | iso),
       basis: $pp.basis}
      + (if $f == null then {} else
           ($t + (($eta - $t) * $f | floor)) as $cal
           | {factor: $f, factor_n: $acc[$pp.basis | kind].n_ratio, cal_eta_epoch: $cal, cal_eta: ($cal | iso)} end)'
}

# new_scores -> a score for every estimate whose session has since finished. The finish is
# the first sample that read finished; when that was the session's first sample at all, the
# real finish was earlier and done_bound says "upper".
new_scores() {
  local sc="$SCORES"
  [ -s "$sc" ] || sc=/dev/null
  [ -s "$ESTIMATES" ] || return 0
  jq -cn --slurpfile p "$PROGRESS" --slurpfile e "$ESTIMATES" --slurpfile s "$sc" '
    ($p | group_by(.session_id) | map(sort_by(.epoch)
          | {key: .[0].session_id,
             value: {first: .[0].epoch,
                     done: (map(select(.finished)) | .[0].epoch // null)}})
        | from_entries) as $f
    | ($s | map("\(.session_id)/\(.made_epoch)") | INDEX(.)) as $have
    | $e[] | . as $x | ($f[.session_id] // null) as $d
    | select($d != null and $d.done != null and $d.done > .made_epoch)
    | select($have["\(.session_id)/\(.made_epoch)"] | not)
    | {session_id, target, project, basis, made_epoch, eta_epoch, done_epoch: $d.done,
       done_bound: (if $d.done == $d.first then "upper" else "sampled" end),
       horizon_min: ((.eta_epoch - .made_epoch) / 60 | floor),
       error_min: (($d.done - .eta_epoch) / 60 | floor),
       ratio: (if .eta_epoch > .made_epoch
               then (($d.done - .made_epoch) / (.eta_epoch - .made_epoch) * 100 | floor) / 100
               else null end)}
      + (if .cal_eta_epoch == null then {} else
           {factor, cal_eta_epoch, cal_error_min: (($d.done - .cal_eta_epoch) / 60 | floor),
            cal_ratio: (if .cal_eta_epoch > .made_epoch
                        then (($d.done - .made_epoch) / (.cal_eta_epoch - .made_epoch) * 100 | floor) / 100
                        else null end)} end)'
}

cmd_sample() {
  local t rows est sc
  mkdir -p "$DIR"
  exec 9>"$DIR/.lock"
  flock -n 9 || { say "another sample is running"; return 0; }
  t=$(now)
  if ! rows=$(sample_rows "$t"); then
    say "fleet-sessions failed; nothing written"
    report_outcome FAILED "fleet-sessions failed"
    return 1
  fi
  if [ -z "$rows" ]; then
    say "no live session"
    publish_window "$t"
    findings_run "$t"
    epics_step "$t"
    fleet_cost_step
    budget_step
    report_outcome NOOP "no live session"
    return 0
  fi
  printf '%s\n' "$rows" >> "$PROGRESS"
  est=$(new_estimates "$t") || { report_outcome FAILED "estimate step failed"; return 1; }
  [ -n "$est" ] && printf '%s\n' "$est" >> "$ESTIMATES"
  sc=$(new_scores) || { report_outcome FAILED "score step failed"; return 1; }
  [ -n "$sc" ] && printf '%s\n' "$sc" >> "$SCORES"
  local fs
  fs=$(new_forecast_scores "$t") || { report_outcome FAILED "forecast score step failed"; return 1; }
  [ -n "$fs" ] && printf '%s\n' "$fs" >> "$FORECAST_SCORES"
  local n e s
  n=$(grep -c . <<<"$rows"); e=$(grep -c . <<<"$est"); s=$(grep -c . <<<"$sc")
  say "$n sessions, $e new estimates, $s new scores"
  publish_window "$t"
  findings_run "$t"
  epics_step "$t"
  fleet_cost_step
  budget_step
  report_outcome WORKED "$n sessions, $e estimates, $s scores"
}

# state_file_step <file> <every min> <timeout s> <name> <cmd...>: run cmd at most every <every> minutes
# and keep its JSON (it must have .total) as <file>. A failed run keeps the last file and waits the
# same interval (touch), so a reader's outage (Prometheus, gh, a bill's API) costs one attempt per
# interval; its as_of_epoch then reads stale on the Costs tab, in the KPI and in
# `agent-usage budget check`.
state_file_step() {
  local file=$1 every=$2 limit=$3 name=$4
  shift 4
  [ -z "$(find "$file" -mmin "-$every" 2>/dev/null)" ] || return 0
  mkdir -p "$(dirname "$file")"
  local tmp="$file.$$.tmp"
  if timeout "$limit" "$@" > "$tmp" 2>/dev/null && jq -e .total "$tmp" >/dev/null 2>&1; then
    mv "$tmp" "$file"
  else
    rm -f "$tmp"
    touch -c "$file"
    say "$name: the run failed; the last file stays"
  fi
}

# fleet_cost_step: the whole fleet's list-price estimate over 24h.
fleet_cost_step() {
  # shellcheck disable=SC2086  # the command is words
  state_file_step "$BENCH_FLEET_COST_FILE" "$BENCH_FLEET_COST_EVERY_MIN" "$BENCH_FLEET_COST_TIMEOUT" fleet-cost $BENCH_FLEET_COST_CMD
}

# budget_step: this month's cash by bill. A bill its reader cannot read is an `unread` line in a fresh
# file, never the last good figure; BUDGET_JSON points the command at this file, whose unread_since it
# carries forward (the only record of how long a reader has failed).
budget_step() {
  # shellcheck disable=SC2086  # the command is words
  BUDGET_JSON=$BENCH_BUDGET_FILE state_file_step "$BENCH_BUDGET_FILE" "$BENCH_BUDGET_EVERY_MIN" "$BENCH_BUDGET_TIMEOUT" budget $BENCH_BUDGET_CMD
}

# epics_step <now>: freeze the epic baselines and write the scores this sample owes. A failure is
# said and the sample goes on: the session ETAs do not wait on the roadmaps.
epics_step() {
  epics_sample "$1" || say "epics: the step failed; nothing frozen or scored"
}

# latest_live -> the newest sample's rows joined with each session's newest estimate, and
# late_min when the ETA it shows is already behind that sample. The estimate is not redone:
# it is scored as it was made. phase_since_epoch is the first sample at the session's current
# phases_done: when its open phase started, as near as the sample cadence can say. phase_active_base is
# the session's active_min (fleet-sessions' work time) at the first sample in that phase that has one,
# which fleet-sessions' overdue_of subtracts so a phase ages by work, not wall clock.
latest_live() {
  [ -s "$PROGRESS" ] || return 0
  local est="$ESTIMATES"
  [ -s "$est" ] || est=/dev/null
  jq -cn --slurpfile p "$PROGRESS" --slurpfile e "$est" "$JQ_LIB"'
    ($p | max_by(.epoch) | .epoch) as $last
    | ($e | group_by(.session_id) | map(max_by(.made_epoch) | {key: .session_id, value: .})
        | from_entries) as $eta
    # keyed by tojson, not IN($live[]): a scan of every live session per row was 2s of the 160k rows (ar-1140)
    | ($p | map(select(.epoch == $last) | {key: (.session_id | tojson), value: true}) | from_entries) as $live
    | ($p | map(select($live[.session_id | tojson])) | group_by(.session_id)
        | map({key: .[0].session_id, value: map({epoch, phases_done, active_min})}) | from_entries) as $hist
    | $p[] | select(.epoch == $last)
    | . as $r
    | ([$hist[$r.session_id][] | select(.phases_done != $r.phases_done) | .epoch] | max) as $moved
    | [$hist[$r.session_id][] | select($moved == null or .epoch > $moved)] as $phase
    | . + {phase_since_epoch: ($phase | map(.epoch) | min),
           phase_active_base: ($phase | map(select(.active_min != null)) | min_by(.epoch) | .active_min // null)}
    | . + {eta: (if .finished then null else $eta[.session_id] end)}
    | . + {late_min: ((.eta | shown_eta) as $s
                      | if $s != null and $s < $last then (($last - $s) / 60 | floor) else null end)}'
}

cmd_eta() {
  if [ "${1:-}" = --json ]; then
    latest_live | jq -c "$JQ_LIB"'{target, session_id, phases_done, phases_total, finished,
      eta: (.eta.cal_eta // .eta.eta // null), eta_epoch: (.eta | shown_eta),
      raw_eta_epoch: (.eta.eta_epoch // null), factor: (.eta.factor // null), late_min,
      phase_since_epoch, phase_active_base,
      phase_min: (if .eta.per_phase_min == null then null else .eta.per_phase_min * (.eta.factor // 1) | floor end),
      basis: (.eta | basis_label)}'
    return
  fi
  latest_live | jq -r "$JQ_LIB"'[.target, "\(.phases_done // "-")/\(.phases_total // "-")",
      (if .finished then "finished" else eta_cell end), (.eta | basis_label // "-")] | @tsv' |
    awk -F'\t' '{ printf "%-42s %-6s %-10s %s\n", $1, $2, $3, $4 }'
}

cmd_report() {
  local last
  if [ ! -s "$PROGRESS" ]; then echo "no samples yet: run fleet-bench sample"; return 0; fi
  last=$(jq -rs "$JQ_LIB"'max_by(.epoch) | .epoch | hm' "$PROGRESS")
  echo "Live sessions (sampled $last; ETA from measured phase times, x the basis's measured ratio once it has $BENCH_CAL_MIN_N scores)"
  printf '%-42s %-6s %-8s %-10s %s\n' SESSION PHASE BUCKET ETA BASIS
  latest_live | jq -r "$JQ_LIB"'[.target, "\(.phases_done // "-")/\(.phases_total // "-")", .bucket,
      (if .finished then "finished" else eta_cell end), (.eta | basis_label // "-")] | @tsv' |
    awk -F'\t' '{ printf "%-42s %-6s %-8s %-10s %s\n", $1, $2, $3, $4, $5 }'
  echo
  echo "ETA accuracy (error = actual finish - predicted; ratio = actual/predicted duration)"
  if [ ! -s "$SCORES" ]; then
    echo "  nothing scored yet: an ETA is scored when its session finishes"
  else
    jq -rs "${CAL_ARGS[@]}" "$JQ_LIB"'
      def line($label; err; rat): if length == 0 then empty else
        "  \($label): \(length) scored, median error \(map(err) | median) min, median |error| \(map(err | fabs) | median) min, median ratio \(map(rat // empty) | median // "-")" end;
      def line($label): line($label; .error_min; .ratio);
      (accuracy($minn; $lo; $hi) | .[]
        | "  \(.basis): \(.n) scored, median error \(.median_error_min) min, median |error| \(.median_abs_error_min) min, median ratio \(.median_ratio // "-")"),
      (map(select(.cal_eta_epoch != null)) | group_by(.basis | kind) | .[]
        | line("\(.[0].basis | kind) calibrated"; .cal_error_min; .cal_ratio)),
      (map(select(.horizon_min < 120)) | line("horizon under 2h")),
      (map(select(.horizon_min >= 120 and .horizon_min < 480)) | line("horizon 2-8h")),
      (map(select(.horizon_min >= 480)) | line("horizon over 8h")),
      (map(select(.done_bound == "upper")) | if length > 0 then "  \(length) finished before their first sample, so their real error is smaller than shown" else empty end)
    ' "$SCORES"
  fi
  echo
  echo "Fleet forecast accuracy (ratio = actual over predicted time to the last session's finish)"
  if [ ! -s "$FORECAST_SCORES" ]; then
    echo "  nothing scored yet: a baseline is scored when its sessions are all done, or after ${BENCH_FORECAST_HORIZON_H}h"
  else
    jq -rs "$JQ_LIB"'
      "  \(length) baselines scored: median ratio \(map(.ratio_p50 // empty) | median // "-")x as calibrated, \(map(.ratio_slow // empty) | median // "-")x at the slow end; \(map(select(.within_slow)) | length) of \(length) done inside the slow end",
      (.[-3:][] | "  \(.label): \(.resolved_by), \(.ratio_p50 // "-")x\(if .bound == "lower" then " or more (\(.open) still open)" else "" end), error \(.error_min // "-") min, \(.in) phases came in at \(.in_per_h)/h against \(.in_per_h_frozen)/h frozen")' "$FORECAST_SCORES"
  fi
  echo
  local r st
  proof_lib || return 0
  for r in fleet-bench fleet-review briefing; do
    st="$(proof_state_dir)/$r/last-outcome"
    printf '%s last outcome: %s\n' "$r" "$(cat "$st" 2>/dev/null || echo 'none recorded (not run under agentctl yet)')"
  done
}

cmd_accuracy() {
  [ "${1:-}" = --json ] || { echo "usage: fleet-bench accuracy --json" >&2; return 2; }
  [ -s "$SCORES" ] || return 0
  jq -cs "${CAL_ARGS[@]}" "$JQ_LIB"'accuracy($minn; $lo; $hi) | .[]' "$SCORES"
}

# window_stats <now> [since] -> one JSON object per session seen since <since> (default: the
# window): phases ticked, minutes per bucket (each sample owns the gap to the next one,
# capped; a STALLED sample the human held open, held: true, is HELD, never stalled_min),
# nudges and escalations (a flag turning on), peak context, first and last sample.
window_stats() {
  local t="$1"
  jq -cn --argjson since "${2:-$(( t - BENCH_WINDOW_H * 3600 ))}" --argjson cap $(( BENCH_GAP_CAP_MIN * 60 )) \
     --slurpfile p "$PROGRESS" '
    $p | map(select(.epoch >= $since)) | group_by(.session_id) | .[] | sort_by(.epoch) | . as $r
    | [range(0; length - 1) | {b: (if $r[.].bucket == "STALLED" and $r[.].held == true then "HELD" else $r[.].bucket end),
         m: (([($r[. + 1].epoch - $r[.].epoch), $cap] | min) / 60)}] as $gaps
    | ($gaps | group_by(.b) | map({key: .[0].b, value: (map(.m) | add | floor)}) | from_entries) as $minutes
    | {session_id: .[0].session_id, target: (last.target), project: (last.project),
     plan: (last.plan_file // "" | sub(".*/"; "") | sub("\\.md$"; "")),
     phase: "\(last.phases_done // "-")/\(last.phases_total // "-")",
     ticked: (group_by(.plan_file) | map((last.phases_done // 0) - (map(.phases_done // 0) | min)) | add),
     working_min: ($minutes.WORKING // 0), waiting_min: ($minutes.NEEDS // 0), stalled_min: ($minutes.STALLED // 0),
     minutes: $minutes,
     nudges: ([range(1; length) | select($r[.].nudged == true and $r[. - 1].nudged != true)] | length),
     escalations: ([range(1; length) | select($r[.].escalated == true and $r[. - 1].escalated != true)] | length),
     peak_context: (map(.context_tokens // 0) | max), first_epoch: (.[0].epoch), last_epoch: (last.epoch)}'
}

# bench_prom <now> -> the fleet_bench.prom lines: the scorecard's window per project, waiting and
# stalled hours summed over the project's sessions. The KPIs ride along so a reader never runs `kpi`.
bench_prom() {
  local t="$1" pl="$2" kpis
  kpis=$(kpi_now "$t") || kpis='{}'
  jq -rn --arg win "$BENCH_WINDOW_H" --argjson pl "$pl" --slurpfile w <(window_stats "$t") --argjson k "$kpis" \
     --slurpfile or <(oldest_requested "$t") --slurpfile pd <(prio_defaults) --arg vitals "$BENCH_VITALS" "$JQ_LIB$PROM_JQ$VITALS_JQ"'
    def h: . / 60 * 100 | round / 100;
    gauge("agent_bench_waiting_hours"; "Hours sessions sat in NEEDS over the last \($win)h.";
        $w | group_by(.project)[] | [{project: .[0].project}, (map(.waiting_min) | add | h)]),
      gauge("agent_bench_stalled_hours"; "Hours sessions sat in STALLED over the last \($win)h.";
        $w | group_by(.project)[] | [{project: .[0].project}, (map(.stalled_min) | add | h)]),
      gauge("agent_bench_kpi"; "The KPIs `fleet-bench kpi` prints, by window.";
        $k | to_entries[] | .key as $n | .value as $v | ("7d", "28d") as $d | [{kpi: $n, window: $d}, $v[$d]]),
      gauge("agent_bench_kpi_limit"; "Each KPI'"'"'s threshold from kpi-thresholds.";
        $k | to_entries[] | [{kpi: .key}, .value.threshold]),
      gauge("agent_bench_kpi_past"; "1 when a KPI is past its threshold, as fleet-bench judged it.";
        $k | to_entries[] | select(.value.status != "-") | [{kpi: .key}, (if .value.status == "past" then 1 else 0 end)]),
      gauge("agent_bench_kpi_subject"; "The row behind a KPI that names one, as project:id; the value is always 1.";
        ($or[] | [{kpi: "requested_unstarted_h", subject: "\(.project):\(.id)"}, 1]),
        ($pd[] | ([.origins[] | select(.origin != "unrecorded")] | first) as $o | select($o != null) | [{kpi: "prio_default", subject: $o.origin}, 1])),
      gauge("agent_bench_vital"; "The front-page KPIs from BENCH_VITALS, by the question each answers; the value is its row. Read each one from agent_bench_kpi.";
        vitals($vitals) | to_entries[] | [{question: .value.question, kpi: .value.kpi}, .key]),
      gauge("agent_chain_wip"; "Items at each step of the work chain now, from the state files.";
        $pl.steps[] | [{step}, .wip]),
      gauge("agent_chain_age_ratio"; "Each step'"'"'s age p90 over its bound in kpi-thresholds; past 1 is a bottleneck.";
        $pl.steps[] | [{step}, .ratio]),
      gauge("agent_chain_score"; "Each step'"'"'s measure over its bound (fleet-bench pipeline): an age p90, the rows admission held in 24h, or the minutes dispatch has been held; 1 or more is over.";
        $pl.steps[] | [{step}, .score]),
      gauge("agent_chain_moves"; "Items each step took in and let out over the last hour, from the record.";
        $pl.steps[] | {step} as $l | (["in", .in_1h], ["out", .out_1h]) | [$l + {dir: .[0]}, .[1]]),
      gauge("agent_chain_drift"; "Queue items the record and the queue folders place at different steps.";
        [{}, $pl.drift]),
      gauge("agent_chain_inbox_drift"; "Lines the record holds in the inbox step against the lines the outbox and every ## Inbox hold, apart.";
        [{}, $pl.inbox_drift])'
}

# projects_prom -> the fleet_projects.prom lines: each project's state and its open release window,
# from hub's cards (stages.md "Project state" and "Release windows"). Carried is a committed row
# still open, the card's `open`, which the cut counts as carried. A closed window has no series of
# its own: its say/do is the last sample of its version. An unstated card ("") has no state series.
projects_prom() {
  local cards
  cards=$(timeout "$BENCH_HUB_TIMEOUT_S" $BENCH_HUB_PROJECTS_CMD 2>/dev/null | jq -ce '.cards | arrays') || return 1
  jq -rn --argjson c "$cards" "$PROM_JQ"'
    gauge("agent_project_state"; "Each project'"'"'s state from hub_core::projects::state (stages.md, Project state); the value is always 1.";
      $c[] | select((.state // "") != "") | [{project: .name, state: .state}, 1]),
    gauge("agent_project_window_rows"; "Rows of each project'"'"'s open release window by kind: committed at open, delivered, carried (committed and still open), dropped, interrupted.";
      $c[] | select(.window != null) | .window as $w | {project: .name, version: $w.version} as $l
      | (["committed", $w.committed], ["delivered", $w.delivered], ["carried", $w.open], ["dropped", $w.dropped], ["interrupted", $w.interrupted])
      | [$l + {kind: .[0]}, .[1]]),
    gauge("agent_project_window_days_left"; "Days until the open window'"'"'s due day; negative once it has passed, no series when it has no due day.";
      $c[] | select(.window != null) | [{project: .name, version: .window.version}, .window.days_left])'
}

# pipeline_snapshot <json>: the file the pipeline line reads, renamed into place so no reader
# sees half of it. A failed build or write leaves the last one, whose as_of shows its age.
pipeline_snapshot() {
  local dir=${PIPELINE_SNAPSHOT%/*} tmp
  mkdir -p "$dir" && tmp=$(mktemp "$dir/.pipeline.XXXXXX") || return 1
  if printf '%s\n' "$1" >"$tmp" && chmod 0644 "$tmp" && mv -f "$tmp" "$PIPELINE_SNAPSHOT"; then return 0; fi
  rm -f "$tmp"
  return 1
}

# publish_window <now>: one pipeline_json for the snapshot and the gauges, so the line and Grafana
# cannot disagree, then bench_prom where node_exporter reads it. The snapshot comes first: it does
# not depend on the session progress the gauges need, and neither does fleet_projects.prom, which
# is removed when hub cannot be read: its series go stale rather than flatlining on old numbers.
publish_window() {
  local pl d
  if pl=$(pipeline_json "$1"); then
    pipeline_snapshot "$pl" || say "could not write $PIPELINE_SNAPSHOT"
  else
    say "pipeline: the rollup failed; the last snapshot stays"
    pl='{"steps": []}'
  fi
  if ! prom_textfile fleet_projects.prom projects_prom; then
    d=$(prom_textfile_target) && rm -f "$d/fleet_projects.prom"
    say "hub projects unreadable; fleet_projects.prom removed"
  fi
  [ -s "$PROGRESS" ] || return 0
  prom_textfile fleet_bench.prom bench_prom "$1" "$pl" || say "could not write fleet_bench.prom"
}

# outcomes_newest -> the newest session-outcomes line per session_id (its own reader rule)
outcomes_newest() {
  if compgen -G "$BENCH_OUTCOMES_DIR/*/*.jsonl" >/dev/null; then
    cat "$BENCH_OUTCOMES_DIR"/*/*.jsonl
  fi | jq -c -s 'map(select(.session_id)) | group_by(.session_id) | map(last) | .[]'
}

outcomes_latest() {
  outcomes_newest | jq -cs 'map({key: .session_id, value: {prs_merged, reverted_7d, harness, cost_usd, cost_by_model, models, edits, activity, class, tool_errors: .hard_errors.tool_errors}}) | from_entries'
}

# in_window <file> <epoch field> <now> [since] -> the file's rows whose field falls since
# <since> (default: the window)
in_window() {
  [ -s "$1" ] || return 0
  jq -c --arg f "$2" --argjson since "${4:-$(( $3 - BENCH_WINDOW_H * 3600 ))}" 'select(.[$f] >= $since)' "$1"
}

# ci_claimed -> the pr-ci rows a session claims; a repo with sections also holds every other merged
# PR, and only `sections` and the review itself read those
ci_claimed() { [ ! -s "$CI" ] || jq -c "$JQ_LIB"'select(claimed)' "$CI"; }
# ci_window <now> [since] -> the same rows, merged in the window
ci_window() { in_window "$CI" merged_epoch "$@" | jq -c "$JQ_LIB"'select(claimed)'; }

cmd_headline() {
  local t; t=$(now)
  [ -s "$PROGRESS" ] || { echo "bench: no samples yet"; return 0; }
  jq -rn --arg win "$BENCH_WINDOW_H" --slurpfile w <(window_stats "$t") --slurpfile s <(in_window "$SCORES" done_epoch "$t") \
     --slurpfile c <(ci_window "$t") "$JQ_LIB"'
    def h: . / 60 * 10 | floor / 10;
    "bench \($win)h: \($w | length) sessions, \($w | map(.ticked) | add // 0) phases ticked, "
    + "\($w | map(.waiting_min) | add // 0 | h)h waiting on you, \($w | map(.stalled_min) | add // 0 | h)h stalled, "
    + (if ($s | length) == 0 then "no ETA finished yet"
       else "\($s | length) ETAs scored, median \($s | map(.ratio // empty) | median | round2)x of predicted"
         + ($s | map(.cal_ratio // empty) | if length == 0 then ""
            else " (\(length) calibrated, median \(median | round2)x)" end) end)
    + (if ($c | length) == 0 then ""
       else ", \($c | map(.ci_red) | add) failed CI runs before merge in \($c | length) merged PRs" end)'
}

# runs_between <from> <to> -> the run ledger's rows that ended in that time
runs_between() { awk -F'\t' -v a="$1" -v b="$2" '$1 > a && $1 <= b' "$BENCH_RUNS_TSV" 2>/dev/null; }

# prom_map <label> <promql> <epoch> -> {label value: number}; rc 1 when unreadable. A recorded
# series can only answer instant lookups, so a replay has no answer to these.
prom_map() {
  [ -z "${BENCH_PROM_TSV:-}" ] || return 1
  prom_q "$2" "$3" | jq -c --arg l "$1" '[.data.result[] | {key: (.metric[$l] // "-"), value: (.value[1] | tonumber)}] | from_entries'
}

# vm_map <label> <promql> <epoch> -> prom_map read from VictoriaMetrics (vm_q), for a window of days that
# Prometheus no longer holds
vm_map() {
  [ -z "${BENCH_PROM_TSV:-}" ] || return 1
  vm_q "$2" "$3" | jq -ce --arg l "$1" '[.data.result[] | {key: (.metric[$l] // "-"), value: (.value[1] | tonumber)}] | from_entries'
}

# spend_by_session <now> -> {session id: dollars in the window}, the fleet cost's session rows (billed
# where a session reports cost, priced from tokens otherwise). The 24h window reads BENCH_FLEET_COST_FILE,
# the file the hub's Costs card reads, unless it is older than four of the sampler's tries
# (BENCH_FLEET_COST_EVERY_MIN); any other window asks BENCH_FLEET_COST_CMD for its own range. rc 1 when
# it cannot answer: a replay, or a cost that cannot be read.
spend_by_session() {
  [ -z "${BENCH_PROM_TSV:-}" ] || return 1
  local rows='(.by_session // []) | map({key: .sid, value: .usd}) | from_entries'
  if [ "$BENCH_WINDOW_H" = 24 ]; then
    jq -ce --argjson oldest "$(($1 - BENCH_FLEET_COST_EVERY_MIN * 240))" "select((.as_of_epoch // 0) >= \$oldest) | $rows" \
      "$BENCH_FLEET_COST_FILE" 2>/dev/null
  else
    $BENCH_FLEET_COST_CMD --since "$(date -d "@$(($1 - BENCH_WINDOW_H * 3600))" -Iseconds)" --before "$(date -d "@$1" -Iseconds)" 2>/dev/null |
      jq -ce "$rows" 2>/dev/null
  fi
}

# fleet_cost_figure -> {usd, cash, burn}: the hub Costs card's figures (whole dollars, the
# last 24h); rc 1 when hub-figure cannot read one.
fleet_cost_figure() {
  local u c b
  u=$($BENCH_HUB_FIGURE_CMD costs_headline 2>/dev/null) && c=$($BENCH_HUB_FIGURE_CMD costs_api_cash 2>/dev/null) &&
    b=$($BENCH_HUB_FIGURE_CMD costs_sub_burn 2>/dev/null) || return 1
  jq -cen --arg u "$u" --arg c "$c" --arg b "$b" '{usd: ($u | tonumber), cash: ($c | tonumber), burn: ($b | tonumber)}' 2>/dev/null
}

# session_rows <now> -> one JSON object per session in the window, most working time first:
# what `fleet-bench sessions --json` prints (day-log's Sessions table), joined to session-outcomes and the CI reds.
session_rows() {
  local t="$1" spend
  spend=$(spend_by_session "$t") || spend=null
  # Through a file: the outcomes of a few thousand sessions are over the kernel's 128 KB limit on one argument.
  jq -cn --slurpfile w <(window_stats "$t") --slurpfile outcomes <(outcomes_latest) --argjson spend "$spend" \
     --slurpfile c <(ci_window "$t") "$JQ_LIB"'
    def h: . / 60 * 10 | floor / 10;
    ($c | group_by(.session_id) | map({key: .[0].session_id, value: (map(.ci_red) | add)}) | from_entries) as $red
    | $outcomes[0] as $o
    | $w | sort_by(-.working_min) | .[] | ($o[.session_id] // {}) as $x
    | {session_id, target, plan, phase, ticked, working_h: (.working_min | h), waiting_h: (.waiting_min | h),
       stalled_h: (.stalled_min | h), nudges, peak_k: (.peak_context / 1000 | floor),
       prs_merged: $x.prs_merged, ci_reds: $red[.session_id], reverts: $x.reverted_7d,
       cost_usd: (if $x.cost_usd then $x.cost_usd * 100 | floor / 100 else null end),
       cost_24h: ($spend[.session_id] // null | if . then round2 else . end),
       edits: $x.edits, activity: $x.activity, tool_errors: $x.tool_errors}'
}

cmd_sessions() {
  [ "${1:-}" = --json ] || { echo "usage: fleet-bench sessions --json" >&2; return 2; }
  [ -s "$PROGRESS" ] || return 0
  session_rows "$(now)"
}

# cmd_stats --json [--since E] -> one JSON object per session sampled or merging a PR since E
# (default: all of it): its whole life from this bench's two stores, the progress samples and
# pr-ci. merged is null on a session with no merged PR in pr-ci, and sampled is false on one
# the sampler never saw. session-outcomes keeps each row as its own row's delivery.
cmd_stats() {
  local json=0 since=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      --since) since="${2:-}"; shift ;;
      *) json=0; break ;;
    esac
    shift
  done
  { [ "$json" = 1 ] && [[ "$since" =~ ^[0-9]+$ ]]; } || { echo "usage: fleet-bench stats --json [--since <epoch>]" >&2; return 2; }
  jq -cn --slurpfile w <([ -s "$PROGRESS" ] && window_stats "$(now)" "$since") \
     --slurpfile c <(ci_window 0 "$since") '
    ($w | map({key: .session_id, value: del(.working_min, .waiting_min, .stalled_min)}) | from_entries) as $ws
    | ($c | group_by(.session_id)
       | map({key: .[0].session_id,
              value: {prs: length, lines_added: (map(.additions // 0) | add), lines_deleted: (map(.deletions // 0) | add),
                      ci_runs: (map(.ci_runs // 0) | add), ci_reds: (map(.ci_red // 0) | add)}})
       | from_entries) as $ci
    | (($ws | keys) + ($ci | keys) | unique)[] as $k
    | {session_id: $k} + ($ws[$k] // {sampled: false}) + {merged: ($ci[$k] // null)}'
}

cmd_scorecard() {
  [ -n "${BENCH_READ_CACHE:-}" ] || { with_reads cmd_scorecard "$@"; return; }
  local t day out counts kpis PAR PAR_PIDS SOURCE_ATTR_JSON=""
  t=$(now); day=$(date -d "@$t" +%F)
  [ -s "$PROGRESS" ] || { say "no samples yet"; return 1; }
  mkdir -p "$BENCH_SCORECARD_DIR" || return 1
  out="$BENCH_SCORECARD_DIR/$day.md"
  SOURCE_ATTR_JSON=$(source_attr "$t")   # counts, models and sources all read it: one status probe, one VictoriaMetrics read
  par_open || return 1
  par_go counts ledger_counts
  par_go live kpi_live "$t"
  par_wait
  counts=$(cat "$PAR/counts")
  kpis=$(kpi_json "$t" "$counts" "$(cat "$PAR/live")")
  {
    echo "# Fleet bench, $day"
    echo
    echo "$(BENCH_NOW=$t cmd_headline)."
    echo
    echo "## Vitals"
    echo
    vitals_table "$kpis"
    echo
    echo "## KPIs"
    echo
    echo "Human sessions by when session-outcomes last saw them; (now) is a count taken at this run. Thresholds: $KPI_THRESHOLDS. \`fleet-bench improve\` names one past it at a time; retro files none."
    echo
    kpi_table "$kpis"
    echo
    forecast_section "$t"
    echo
    wakes_lines
    report_line "$BENCH_TOKENS_CMD" tokens
    report_line "$BENCH_WEEK_CMD" week
    report_line "$BENCH_COMMS_CMD line" comms
    echo
    bottleneck_section "$t"
    echo
    time_section "$t"
    echo
    queue_section "$t"
    echo
    epics_section "$t"
    echo
    windows_section
    echo
    models_section "$t"
    echo
    trainee_section "$t"
    echo
    sources_section "$t"
    echo
    canary_lanes_section
    echo
    canary_matrix_section
    echo
    sizes_section "$t"
    echo
    sections_section "$t"
    echo
    depth_section "$t"
    echo
    session_time_section "$t"
    echo
    echo "## ETA accuracy"
    echo
    echo "Error is actual finish minus predicted (positive ran long). Ratio is actual over predicted duration."
    echo
    cmd_report | sed -n '/^ETA accuracy/,/^$/p' | sed '1d;/^$/d;s/^  /- /'
    echo
    echo "## Consolidation ledger"
    echo
    echo "Runners and timers may only shrink, against ~/.config/agentctl/ledger-baseline; each direct headless launch has its row in ~/.config/agentctl/PIPELINES.md."
    echo
    ledger_section "$counts"
    echo
    echo "## Rule numbers"
    echo
    echo "Each provisional rule's number, re-measured; a moved one gets a cleanup item (standards.md, the last rule)."
    echo
    cmd_rules | sed 's/^\([a-z_]*\)=/- \1: /; /^- /!s/^/- /'
  } > "$out.tmp" && mv "$out.tmp" "$out" && cp "$out" "$BENCH_SCORECARD_DIR/latest.md" || return 1
  echo "$out"
}

# forecast_section <now>: when the live work should be done and in what order, then the newest
# baseline frozen at least an hour earlier (yesterday's daily one, at the 06:45 run) against what
# happened since. Markdown bullets of the same lines forecast and vs print.
forecast_section() {
  local t="$1" f b label
  echo "## Forecast"
  echo
  echo "Every open phase scheduled from its session's newest estimate, in plan order; the slow end is the last ${BENCH_WINDOW_H}h scored ratio. Inflow and the drain come from \`fleet-bench flow\`. Formulas: the fleet-bench skill."
  echo
  if f=$(BENCH_NOW=$t cmd_forecast 2>/dev/null); then
    sed 's/^    /  - /; t; s/^  /- /' <<<"$f"
  else
    echo "- ? the forecast could not be made (fleet-bench forecast)"
  fi
  [ -s "$FORECASTS" ] || return 0
  label=$(jq -rs --argjson t "$t" 'map(select(.made_epoch <= $t - 3600 and .made_epoch >= $t - 172800)) | last | .label // empty' "$FORECASTS")
  [ -n "$label" ] || return 0
  echo
  if b=$(BENCH_NOW=$t cmd_vs "$label" 2>/dev/null); then
    sed 's/^    /  - /; t; s/^  /- /' <<<"$b"
  else
    echo "- ? baseline $label could not be compared (fleet-bench vs $label)"
  fi
}

# windows_section: per project its release window, scored against the rows it committed at
# open (`notes projects --commit`, stages.md "Release windows"): the open window so far, and the
# last cut's line from its frozen note. A project with neither is left out.
windows_section() {
  local pj
  echo "## Release windows"
  echo
  echo "A window commits its open rows when it opens; a later add waits for the next window unless it comes in by the interrupt lane. Carried is a committed row still open, dropped one closed without shipping. Rules: stages.md, Release windows."
  echo
  if ! pj=$(bench_read $BENCH_PROJECTS_CMD 2>/dev/null | jq -ce 'arrays'); then
    echo "- ? the projects could not be read ($BENCH_PROJECTS_CMD)"
    return 0
  fi
  jq -r 'map(select(.window != null or .last_window != null)) as $ps
    | if ($ps | length) == 0 then "- no project has a window snapshot yet" else
      ($ps[] | "- \(.name)"
        + (if .window then " \(.window.version) open since \(.window.opened)\(if .window.due then ", due \(.window.due)" else "" end): committed \(.window.committed), delivered \(.window.delivered), open \(.window.open), dropped \(.window.dropped), interrupted \(.window.interrupted)" else "" end)
        + (if .last_window then "\(if .window then ";" else "" end) last cut \(.last_window.version): \(.last_window.line)" else "" end))
      end' <<<"$pj"
}

# epics_section <now>: per project how its epic ETAs ran (each scored against its newest frozen
# baseline), the epics scored in the window, and the open ones behind their baseline.
epics_section() {
  local t="$1" ej
  echo "## Epic ETAs"
  echo
  echo "An open epic's ETA is when its last leaf row should land, frozen when the epic is first seen and again on each scope change, then scored once every leaf has landed. Ratio is actual over predicted duration. Formulas: the fleet-bench skill."
  echo
  if ! ej=$(epics_json "$t" 2>/dev/null); then
    echo "- ? the epics could not be read (fleet-bench epics)"
    return 0
  fi
  jq -r --argjson t "$t" --argjson win "$BENCH_WINDOW_H" "$JQ_LIB"'
    (.projects | map(select(.accuracy.scored > 0 or ([.epics[] | select(.baseline != null)] | length) > 0))) as $ps
    | if ($ps | length) == 0 then "- no epic has a frozen ETA yet" else
      ($ps[] | "- \(.project): \(.accuracy.scored) scored"
        + (if .accuracy.scored > 0 then ", median ratio \(.accuracy.median_ratio // "-"), \(.accuracy.on_time) on time, \(.accuracy.within_slow) within the slow end" else "" end)
        + ", \([.epics[] | select(.track == "behind")] | length) open behind, \([.epics[] | select(.track == "on track")] | length) on track"),
      (.projects[] | .project as $p | .epics[] | select(.score != null and .score.landed_epoch >= $t - $win * 3600)
        | "  - \($p) \(.id) \(.title): landed \(.score.landed_epoch | hm), predicted \(.score.pred_p50 | hm), ratio \(.score.ratio // "-"), \(.score.verdict)"),
      (.projects[] | .project as $p | .epics[] | select(.track == "behind")
        | "  - \($p) \(.id) \(.title): behind, frozen \(.baseline.p50 | hm), now \(.eta.cal_p50 // .eta.p50 | hm)")
      end' <<<"$ej"
}

# bottleneck_data <now> [scope] [since]: the Bottlenecks rows as one JSON object, {rows, branches}, the one
# computation the report (bottleneck_section) and `bottleneck --check` both read. A row is {key, what,
# h, unit, detail} (a session row also carries `top`: its three biggest sessions as {target, h}); h is
# null when its source is unreadable. Waited hours come from the queue length sampled every 10
# minutes, and low-water hours from fleet-dispatch stats' under_low_water gauge, sampled the same way.
# `sessions` skips the Prometheus and run-ledger reads and returns only the two session rows; `pools`
# reads only the pool rows (no series is as unreadable as no answer: cc:pool_waiting has a row for every
# pool, so an empty read means the rule or Prometheus is gone, not that nothing waited). <since>, an epoch,
# starts the session rows there instead of at the window start (window_stats).
bottleneck_data() {
  local t="$1" scope="${2:-all}" since="${3:-}" win="${BENCH_WINDOW_H}h" pool=null queued=null low=null
  if [ "$scope" = all ] || [ "$scope" = pools ]; then
    pool=$(prom_map pool "sum_over_time(cc:pool_waiting[$win:10m]) / 6" "$t") || pool=null
    [ "$pool" != '{}' ] || pool=null
  fi
  if [ "$scope" = all ]; then
    queued=$(prom_map kind "sum_over_time(ci_governor_backlog_units{kind=\"local\"}[$win:10m]) / 6" "$t") || queued=null
    low=$(prom_map topic "sum_over_time(max by (topic) (mqtt_under_low_water{topic=~\"agents_.+_summary_dispatch\"})[$win:10m]) / 6" "$t") || low=null
  fi
  jq -n --arg scope "$scope" --argjson pool "$pool" --argjson queued "$queued" --argjson low "$low" --slurpfile w <([ "$scope" = pools ] && echo "{}" || window_stats "$t" "$since") \
      --rawfile r <([ "$scope" != all ] || runs_between $((t - BENCH_WINDOW_H * 3600)) "$t") "$JQ_LIB"'
    def hours($k): map(.[$k]) | add // 0 | . / 60;
    def top($k): map(select(.[$k] > 0)) | sort_by(-.[$k]) | .[:3] | map({target, h: (.[$k] / 60)});
    def bad: map(select(.res != "pass"));
    def sess($key; $what; $k): {key: $key, what: $what, h: ($w | hours($k)), unit: "session-hours", top: ($w | top($k))}
      | .detail = (.top | map("\(.target) \(.h | round1)h") | join(", "));
    ($r | run_rows) as $runs
    | ($runs | map(.s) | add // 0 | . / 3600) as $editor
    | ($runs | bad | map(.s) | add // 0 | . / 3600) as $lost
    | ($runs | bad | group_by(.branch) | map({branch: .[0].branch, not_passed: length, h: (map(.s) | add / 3600)}) | sort_by(-.h)) as $branches
    | [ (if $pool == null then {key: "pools", what: "Pool queues", h: null, unit: "job-hours", detail: "prometheus unreadable"}
         else $pool | to_entries[] | select(.value >= 0.1) | {key: "pool:\(.key)", what: "Pool queue: \(.key)", h: .value, unit: "job-hours", detail: "jobs waiting, sampled every 10 minutes"} end),
        (if $queued == null then {key: "local", what: "Local queue", h: null, unit: "unit-hours", detail: "prometheus unreadable"}
         else $queued | to_entries[] | select(.value >= 0.1) | {key: "local", what: "Local queue", h: .value, unit: "unit-hours", detail: "governor units waiting for a seat, sampled every 10 minutes"} end),
        (if $low == null then {key: "low-water", what: "Queue under low water", h: null, unit: "hours", detail: "prometheus unreadable"}
         else ([$low[]] | max // 0) as $h | select($h >= 0.1) | {key: "low-water", what: "Queue under low water", h: $h, unit: "hours", detail: "runnable under DISPATCH_LOW_WATER, sampled every 10 minutes"} end),
        (select($lost > 0) | {key: "runs", what: "Local runs not passed", h: $lost, unit: "editor-hours", detail: "of \($editor | round1)h on all local runs"}),
        sess("waiting"; "Sessions waiting on you"; "waiting_min"),
        sess("stalled"; "Sessions stalled"; "stalled_min") ]
    | map(select($scope == "all" or ($scope == "sessions" and (.key == "waiting" or .key == "stalled"))
                 or ($scope == "pools" and (.key | startswith("pool"))))) as $rows
    | {rows: $rows, branches: $branches}'
}

# bottleneck_section <now>: the hours lost in the window, biggest first, and the branches behind the
# failed runs, from bottleneck_data.
bottleneck_section() {
  local t="$1" win="${BENCH_WINDOW_H}h"
  echo "## Bottlenecks"
  echo
  echo "Hours lost over the last $win, from counts. The units differ, so the order says where to look first and the rows do not add up."
  echo
  bottleneck_data "$t" | jq -r "$JQ_LIB"'
    "| Bottleneck | Hours | Unit | Detail |", "|---|---|---|---|",
    (.rows | sort_by(-(.h // -1)) | .[] | "| \(.what) | \(.h // "?" | if type == "number" then round1 else . end) | \(.unit) | \(.detail) |"),
    (if (.branches | length) == 0 then empty else
      "", "Branches by editor-hours on runs not passed. A suite is one run per class, so the run count alone overstates a retry.", "",
      "| Branch | Runs not passed | Hours |", "|---|---|---|",
      (.branches[:5][] | "| \(.branch) | \(.not_passed) | \(.h | round1) |") end)'
}

# bottleneck_bound <name>: that bound in KPI_THRESHOLDS, nothing when it is unset or not a number.
bottleneck_bound() {
  local v
  v=$(sed -n "s/^$1=//p" "$KPI_THRESHOLDS" 2>/dev/null | tail -1)
  [[ "$v" =~ ^[0-9]+(\.[0-9]+)?$ ]] && printf '%s' "$v"
}

# bottleneck_check_stalled <now>: the Sessions stalled row against stalled_session_hours_max. One line
# naming the top three sessions and exit 1 past the bound; exit 2 when the sampler is stale (its newest
# sample older than two cadences, so a dead sampler cannot read as no stall) or the bound is unset. It
# counts from the later of the window start and the watch's fix watermark (FIX_SINCE): a stall a merged
# fix ended is counted up to the fix, never for the next 24h, and a stall after it still trips.
bottleneck_check_stalled() {
  local t="$1" max last out since span
  max=$(bottleneck_bound stalled_session_hours_max) || { say "bottleneck --check stalled: no stalled_session_hours_max in $KPI_THRESHOLDS"; return 2; }
  last=$(jq -s 'map(.epoch) | max // 0' "$PROGRESS" 2>/dev/null) || last=0
  [ $((t - ${last:-0})) -le $((BENCH_GAP_CAP_MIN * 60)) ] || { say "bottleneck --check stalled: the newest session sample in $PROGRESS is older than $BENCH_GAP_CAP_MIN minutes"; return 2; }
  since=$((t - BENCH_WINDOW_H * 3600)); span="over the last ${BENCH_WINDOW_H}h"
  if [ "$FIX_SINCE" -gt "$since" ]; then since=$FIX_SINCE; span="since the fix at $(date -d "@$since" '+%F %H:%M')"; fi
  out=$(bottleneck_data "$t" sessions "$since" | jq -r --argjson max "$max" --arg span "$span" "$JQ_LIB"'
    .rows[] | select(.key == "stalled") | select(.h > $max)
    | "\(.h * 100 | round / 100) session-hours stalled \($span), past \($max): \(.detail)"') || { say "bottleneck --check stalled: its source cannot be read"; return 2; }
  [ -z "$out" ] || { printf '%s\n' "$out"; return 1; }
}

# bottleneck_check_pools <now>: every pool's waited job-hours (cc:pool_waiting over the window) against
# the one bound pool_wait_hours_max. One line naming each pool past it, the longest first, and exit 1;
# exit 2 when the bound is unset or Prometheus gave no pool series. A pool under 0.1 job-hours has no row, so a
# bound under 0.1 would never trip for it.
bottleneck_check_pools() {
  local t="$1" max data out
  max=$(bottleneck_bound pool_wait_hours_max) || { say "bottleneck --check pools: no pool_wait_hours_max in $KPI_THRESHOLDS"; return 2; }
  data=$(bottleneck_data "$t" pools) || { say "bottleneck --check pools: its source cannot be read"; return 2; }
  jq -e 'all(.rows[]; .h != null)' <<<"$data" >/dev/null || { say "bottleneck --check pools: Prometheus gave no pool series"; return 2; }
  out=$(jq -r --argjson max "$max" "$JQ_LIB"'
    [.rows[] | select(.h > $max)] | sort_by(-.h)
    | if length == 0 then empty else
        "pool waits past \($max) job-hours over the last '"$BENCH_WINDOW_H"'h: \(map("\(.key | sub("^pool:"; "")) \(.h | round1)h") | join(", "))" end' <<<"$data")
  [ -z "$out" ] || { printf '%s\n' "$out"; return 1; }
}

# bottleneck_check [stalled|pools]: one check, or both with no name. The fleet-bottleneck watch runs stalled,
# the pool-wait watch pools: two routes, since pool capacity is the human's call (ar-5157). Prints each
# check's line; exits with the worst code (2 unreadable over 1 tripped over 0).
bottleneck_check() {
  local t c r rc=0 names
  case "${1:-}" in
    '') names="stalled pools" ;;
    stalled|pools) names="$1" ;;
    *) say "usage: fleet-bench bottleneck --check [stalled|pools]"; return 2 ;;
  esac
  t=$(now)
  for c in $names; do
    "bottleneck_check_$c" "$t"; r=$?
    if [ "$r" -gt "$rc" ]; then rc=$r; fi
  done
  return "$rc"
}

# bottleneck [--json | --check [stalled|pools]] -- the Bottlenecks section, the data behind it as JSON, or
# the checks (bottleneck_check).
cmd_bottleneck() {
  case "${1:-}" in
    '') bottleneck_section "$(now)" ;;
    --json) bottleneck_data "$(now)" ;;
    --check) bottleneck_check "${2:-}" ;;
    *) say "usage: fleet-bench bottleneck [--json | --check [stalled|pools]]"; return 2 ;;
  esac
}

# time_section <now>: where the window went per project and per plan, for reading against what the
# human said matters. There is no join yet from a hand-launched session to a row's priority.
time_section() {
  local t="$1" since=$((t - BENCH_WINDOW_H * 3600)) spend fig merges
  spend=$(spend_by_session "$t") || spend=null
  fig=$(fleet_cost_figure) || fig=null
  merges=$(merge_rows "$t" "$since")
  echo "## Where the time went"
  echo
  jq -rn --argjson since "$since" --argjson t "$t" --argjson spend "$spend" --argjson fig "$fig" --rawfile m <(printf '%s\n' "$merges") \
      --slurpfile w <(window_stats "$t") --rawfile r <(runs_between "$since" "$t") "$JQ_LIB"'
    def hours($k): map(.[$k]) | add // 0 | . / 60 | round1;
    def cost: if $spend == null then "-" else "$\(map($spend[.session_id] // 0) | add // 0 | round2)" end;
    ($r | run_rows) as $runs
    | ($m | split("\n") | map(select(. != "") | split("\t"))) as $rows
    | [$rows[] | select(.[0] | startswith("!")) | .[0][1:]] as $unread
    | ($rows | map(select((.[0] | startswith("!") | not) and (.[1] | tonumber) > $since and (.[1] | tonumber) <= $t)) | group_by(.[0])
       | map({key: .[0][0], value: length}) | from_entries) as $merged
    | (if $fig == null then "Agent spend: the hub Costs figure is unreadable."
       else "Agent spend over 24h: about $\($fig.usd) (API cash $\($fig.cash), subscription burn $\($fig.burn)), the hub Costs figure"
         + (if $spend == null then "." else "; $\([$fig.usd - ($w | map($spend[.session_id] // 0) | add // 0), 0] | max | round) of it on sessions no sample saw, the gateway and helper calls." end) end),
      "",
      "| Project | Sessions | Working h | Waiting h | Stalled h | Spend | Editor h | Editor h not passed | Commits on main |",
      "|---|---|---|---|---|---|---|---|---|",
      ((($w | map(.project)) + ($runs | map(.repo)) + ($merged | keys) | unique | map(select(. != null))) as $ps
       | $ps[] | . as $p | ($w | map(select(.project == $p))) as $g | ($runs | map(select(.repo == $p))) as $e
       | "| \($p) | \($g | length) | \($g | hours("working_min")) | \($g | hours("waiting_min")) | \($g | hours("stalled_min")) | \($g | cost) | "
         + "\($e | map(.s) | add // 0 | . / 3600 | round1) | \($e | map(select(.res != "pass") | .s) | add // 0 | . / 3600 | round1) | "
         + "\(if ($unread | index($p)) then "?" else ($merged[$p] // 0) end) |"),
      "",
      "| Plan | Project | Sessions | Working h | Phases ticked | Spend |",
      "|---|---|---|---|---|---|",
      ($w | group_by(.plan) | map({plan: (.[0].plan | if . == "" then "(no plan)" else . end), project: .[0].project, n: length,
          work: hours("working_min"), ticked: (map(.ticked // 0) | add), cost: cost}) | sort_by(-.work) | .[:10][]
       | "| \(.plan) | \(.project) | \(.n) | \(.work) | \(.ticked) | \(.cost) |")'
}

# depth_section <now>: how each session spent itself, top spenders of tokens first. Whole sessions as
# of the last nightly, so a session the nightly has not seen is not listed.
depth_section() {
  echo "## Agent depth"
  echo
  echo "Whole sessions as of the last nightly, counted from the transcript's structure. A test run is one command, and a suite is many runs. Spent after the last edit is the share of tokens past its last commit or edit, so a high share on a long session is time spent waiting or polling."
  echo
  session_rows "$1" | jq -rs "$JQ_LIB"'
    map(select(.activity != null)) | sort_by(-(.activity.tokens // 0)) | .[:15]
    | if length == 0 then "_No session in this window has been through the nightly yet._"
      else ("| Session | Test runs | Test runs per PR | CI polls | Tool calls | Tool errors | API messages | Tokens (M) | Spent after last edit |",
            "|---|---|---|---|---|---|---|---|---|",
            (.[] | .activity as $a
             | "| \(.target) | \($a.test_runs) | \(if (.prs_merged // 0) > 0 then $a.test_runs / .prs_merged | round1 else "-" end) | \($a.ci_polls) | \($a.tool_calls) | "
               + "\(if $a.tool_calls > 0 then "\((.tool_errors // 0) * 100 / $a.tool_calls | round)%" else "-" end) | \($a.api_messages // "-") | \(($a.tokens // 0) / 1000000 | round1) | "
               + "\(if (.edits // 0) > 0 and ($a.tokens // 0) > 0 and $a.tokens_after_last_edit != null then "\($a.tokens_after_last_edit * 100 / $a.tokens | round)%" else "-" end) |"))
      end'
}

# session_time_section <now>: per project, where the hours of human sessions went, from `agent-panel
# time-use` by way of the nightly. Whole sessions: a long one counts all its hours the week it ends.
session_time_section() {
  echo "## Session time"
  echo
  echo "Whole sessions the nightly saw in the last $BENCH_TIME_DAYS days, hours by what was running, counted from the transcript's structure. Gate and test are commands named in ~/.config/agent-panel/time-use.conf; jobs is anything else running; parked is nothing running."
  echo
  outcomes_newest | jq -rs --argjson since $(( $1 - BENCH_TIME_DAYS * 86400 )) "$JQ_LIB"'
    def h($k): map(.time_use[$k]) | add / 60 | round1;
    map(select(.time_use != null and .runner != true and .project != "_runner" and .updated_epoch >= $since))
    | group_by(.project) | sort_by(-(map(.time_use | add) | add))
    | if length == 0 then "_No session has a time split from the nightly in this window yet._"
      else ("| Project | Sessions | Work h | Gate h | Test h | Other jobs h | You h | Parked h |",
            "|---|---|---|---|---|---|---|---|",
            (.[] | "| \(.[0].project) | \(length) | \(h("work_min")) | \(h("gate_min")) | \(h("test_min")) | \(h("jobs_min")) | \(h("human_min")) | \(h("parked_min")) |"))
      end'
}

ledger_section() {
  local counts="$1" over
  sed 's/^\(.*\)=\(.*\)$/- \1: \2/' <<<"$counts"
  if over=$(ledger_check "$counts" 2>&1); then
    echo "- check: held"
  else
    echo "- check: ${over//$'\n'/; }"
  fi
}

# ci_file -> the CI rows file, or /dev/null when there are none
ci_file() { [ -s "$CI" ] && printf '%s' "$CI" || printf /dev/null; }

# section_cfg -> the `sections` block of every tracker that has one, keyed by repo: {repo, gate,
# roots}. Roots decide a path's section, gate names the workflow that first-try means.
section_cfg() {
  [ -r "$BENCH_PROJECT_MAP" ] || { echo '{}'; return 0; }
  jq -c '[.trackers[] | objects | .sections // empty] | INDEX(.repo)' "$BENCH_PROJECT_MAP"
}

# merged_new <since> <cfg> -> repo, number, merge epoch and session_id (tab-separated, the one that may be empty last, since read folds two tabs into one) for every PR to count:
# what session-outcomes says merged since then, plus on a repo with sections whatever merged
# there, since about a third of those no session claims. A PR is counted once, except that a row
# from before its repo had sections or from before a session claimed it counts again, and
# ci_keep_newest drops the old one. A recount keeps the session an older row had. A sections repo's
# merges come from the PR store (`schedules-sync prs`), which holds its whole history, so no list is cut.
# Its store is refreshed first (`sync-prs --wait`, as agent-land does after a merge, but waiting out a
# pass that holds the store): a boot catch-up runs before or during schedules-sync's first pass, and
# `prs` refuses a store over 30 minutes old (ar-1090). A refresh that fails says why on stderr and
# leaves that check to decide.
merged_new() {
  local repo prs listed='[]'
  for repo in $(jq -r 'keys[]' <<<"$2"); do
    "$SCHEDULES_SYNC" sync-prs --wait "$repo" >&2 || true
    prs=$("$SCHEDULES_SYNC" prs "$repo" --state merged --since "$(date -u -d "@$1" +%FT%TZ)") || return 1
    listed=$(jq -c --argjson l "$listed" --arg r "$repo" --argjson since "$1" \
      '$l + map(select(.merged_at and (.merged_at | fromdateiso8601) >= $since)
                | {repo: $r, number, session_id: "", merged: (.merged_at | fromdateiso8601 | floor)})' <<<"$prs") || return 1
  done
  outcomes_newest | jq -rs --argjson since "$1" --argjson cfg "$2" --argjson listed "$listed" --slurpfile c "$(ci_file)" "$JQ_LIB"'
    ($c | INDEX(key)) as $old
    | ($c | map(select($cfg[.repo] == null or .sections != null)) | INDEX(key)) as $have
    | [.[] | .session_id as $sid | (.prs // [])[]
       | select(.state == "MERGED" and .merged_at != null)
       | (.merged_at | fromdateiso8601 | floor) as $m | select($m >= $since)
       | {repo, number, session_id: $sid, merged: $m}] + $listed
    | unique_by(key)
    | map(if claimed then . else .session_id = ($old[key].session_id // "") end)
    | map(. as $pr | $have[key] as $row | select($row == null or (($row | claimed | not) and ($pr | claimed))))
    | .[] | [.repo, .number, .merged, .session_id] | @tsv'
}

# ci_keep_newest -> the newest line per PR stays, so a recount replaces its row
ci_keep_newest() {
  [ -s "$CI" ] || return 0
  jq -cs "$JQ_LIB"'group_by(key) | map(last) | sort_by(.merged_epoch) | .[]' "$CI" > "$CI.tmp" && mv "$CI.tmp" "$CI"
}

# commit_paths <owner/repo> <merge sha> -> what the merge changed: the merge commit, not
# pulls/N/files, which is a 422 on a diff too big to generate (#1403, 2.7M lines), nor `pr view
# --json files`, which stops at 100. A squash holds the whole PR; a multi-commit rebase merge would
# list its last commit only, and main has none.
commit_paths() {
  gh api --paginate "repos/$1/commits/$2?per_page=100" --jq '.files[].filename'
}

# pr_ci <repo> <number> <session> <cfg> -> its size and the CI runs on its branch from its first
# commit to merge (earlier runs are a reused branch name), read from the run ledger (schedules-sync
# runs). Exit 3: the ledger does not sync the repo. Exit 4: it has not synced past the merge yet.
# Exit 5: its Forgejo says the PR does not exist (so_forgejo_pr). Exit 1: unreadable or stale.
# Red is failure, timed_out or startup_failure, and cancelled is superseded, not red. A Forgejo PR (repo host/owner/repo,
# session-outcomes.sh SO_PR_JQ) is read through that host's API, since gh speaks only to GitHub, and
# keeps its outcomes name on the row; the ledger names it forgejo:owner/repo. A repo with sections
# adds the PR's sections and its gate workflow's runs, the gate named by its file path, since a run's
# name is its run-name title ("Tests (affected)", "Tests (delta of N)") and changes per dispatch; green_lost is a green gate on an earlier head that a later
# commit replaced, main moving or a review change alike. A path inside no root is `other`.
pr_ci() {
  local pr runs paths='' ledger=$1
  if [[ "$1" == */*/* ]]; then
    pr=$(so_forgejo_pr "$1" "$2") || { [ $? -eq 3 ] && return 5; return 1; }
    ledger=forgejo:${1#*/}
  else
    pr=$(gh pr view "$2" -R "$1" --json headRefName,createdAt,mergedAt,additions,deletions,commits,mergeCommit) || return 1
  fi
  runs=$("$SCHEDULES_SYNC" runs "$ledger" --branch "$(jq -r .headRefName <<<"$pr")" --until "$(jq -r .mergedAt <<<"$pr")") || return
  runs=$(jq -c 'map({conclusion, workflowName: .workflow, workflowPath: .path, headSha: .sha, createdAt: .created_at,
    startedAt: (.started_at // .created_at), updatedAt: (.ended_at // .started_at // .created_at)})' <<<"$runs") || return 1
  if jq -e --arg r "$1" 'has($r)' <<<"$4" >/dev/null; then
    paths=$(commit_paths "$1" "$(jq -r .mergeCommit.oid <<<"$pr")") || return 1
  fi
  jq -cn --argjson pr "$pr" --argjson runs "$runs" --arg repo "$1" --argjson n "$2" --arg sid "$3" \
     --argjson cfg "$4" --arg paths "$paths" "$JQ_LIB"'
    def red: .conclusion | IN("failure", "timed_out", "startup_failure");
    def section($roots): split("/") as $c
      | first($roots[] | split("/") as $r
          | select(($c | length) > ($r | length) and ([range($r | length) as $i | $r[$i] == "*" or $r[$i] == $c[$i]] | all))
          | $c[:$r | length] | join("/")) // "other";
    ([$pr.createdAt, ($pr.commits // [])[].committedDate] | map(fromdateiso8601) | min) as $start
    | ($pr.mergedAt | fromdateiso8601) as $merged
    | ($runs | map(select((.createdAt | fromdateiso8601) as $c | $c >= $start and $c <= $merged))) as $r
    | {repo: $repo, number: $n, session_id: $sid, merged_epoch: $merged, merged_at: ($merged | iso),
       additions: ($pr.additions), deletions: ($pr.deletions), ci_runs: ($r | length),
       ci_red: ($r | map(select(red)) | length)}
      + ($cfg[$repo] as $s | if $s == null then {} else
          ($r | map(select(.workflowPath == $s.gate))) as $g
          | {sections: ($paths | split("\n") | map(select(. != "") | section($s.roots)) | unique),
             gate_runs: ($g | length), gate_red: ($g | map(select(red)) | length),
             gate_min: ($g | map((.updatedAt | fromdateiso8601) - (.startedAt | fromdateiso8601)) | add // 0 | . / 60 | round),
             green_lost: ([0, ($g | map(select(.conclusion == "success") | .headSha) | unique | length) - 1] | max)}
        end)'
}

# forgejo_ready <host/owner/repo> -> the lib loaded and the token read in this shell, so the
# subshell each pr_ci runs in inherits them and a review reads the token once, a failed read too
forgejo_ready() {
  [ -z "${SO_FORGEJO_ERR:-}" ] || return 1
  # shellcheck source=/dev/null
  declare -F so_forgejo_auth >/dev/null || . "$BENCH_SO_LIB" || return 1
  so_forgejo_auth "$1" || { say "$SO_FORGEJO_ERR"; return 1; }
}

# review_start <now> -> where the next window starts: BENCH_WINDOW_H back, or further back to the
# cursor review.last when that is older, though never more than BENCH_REVIEW_MAX_DAYS
review_start() {
  local c s=$(( $1 - BENCH_WINDOW_H * 3600 )) floor=$(( $1 - BENCH_REVIEW_MAX_DAYS * 86400 ))
  c=$(sed -n '1{/^[0-9][0-9]*$/p}' "$REVIEW_PASS" 2>/dev/null)
  [ -n "$c" ] || { echo "$s"; return 0; }
  [ "$c" -ge "$floor" ] || c=$floor
  [ "$c" -lt "$s" ] || c=$s
  echo "$c"
}

# cmd_review: the window reaches back to the last pass, so a failed or missed night is counted by
# the next one (ar-2852). A pass moves the cursor to its own start time, held back to the oldest PR
# it left for later (ledger not synced past it) or could not count; a PR in a repo the ledger does
# not sync, or one its forge says does not exist, is left out and holds nothing, so the nightly window
# passes it; a --days window that reaches it probes it again. A --days window moves it only when it reached the start.
cmd_review() {
  local t since start cfg new repo num sid merged row rc n=0 red=0 failed=0 unsynced=0 later=0 gone=0 msg days='' off=' ' hold
  case "${1:-}" in
    '') ;;
    --days) days=${2:-}; [[ "$days" =~ ^[1-9][0-9]*$ ]] || { say "usage: fleet-bench review [--days N]"; return 2; } ;;
    *) say "usage: fleet-bench review [--days N]"; return 2 ;;
  esac
  mkdir -p "$DIR"
  t=$(now)
  start=$(review_start "$t"); since=$start hold=$t
  [ -z "$days" ] || since=$(( t - days * 86400 ))
  cfg=$(section_cfg) || { report_outcome FAILED "project map unreadable"; return 1; }
  new=$(merged_new "$since" "$cfg") || { report_outcome FAILED "merged PRs unreadable"; return 1; }
  # a recount leaves two lines for a PR until this runs, so it runs however the loop ends
  [ -z "$new" ] || { trap ci_keep_newest EXIT; trap 'exit 143' TERM INT HUP; }
  while IFS=$'\t' read -r repo num merged sid; do
    [ -n "$repo" ] || continue
    # a repo the ledger does not sync is learnt once per review, not paid a gh call per PR
    case "$off" in *" $repo "*) unsynced=$((unsynced + 1)); continue ;; esac
    rc=0
    if [[ "$repo" == */*/* ]] && ! forgejo_ready "$repo"; then rc=1
    else row=$(pr_ci "$repo" "$num" "$sid" "$cfg") || rc=$?; fi
    case $rc in
      0) ;;
      3) unsynced=$((unsynced + 1)); off+="$repo "; continue ;;
      4) later=$((later + 1)); [ "$merged" -ge "$hold" ] || hold=$merged; continue ;;
      5) say "$repo#$num left out: its forge says no such PR (pulls/$num is a 404)"; gone=$((gone + 1)); continue ;;
      *) say "cannot count $repo#$num"; failed=$((failed + 1)); [ "$merged" -ge "$hold" ] || hold=$merged; continue ;;
    esac
    printf '%s\n' "$row" >> "$CI"
    n=$((n + 1)); red=$((red + $(jq .ci_red <<<"$row")))
  done <<<"$new"
  # a PR with no row is picked up by the next run, so one bad PR never holds back the rest
  # a repo the run ledger does not sync has no CI facts: `schedules-sync repos` lists the repos it syncs
  [ "$unsynced" -eq 0 ] || say "$unsynced PRs left out: their repos are not in the run ledger (schedules-sync repos)"
  # a PR merged after the ledger's last sync is counted by the next review, once its runs are in
  [ "$later" -eq 0 ] || say "$later PRs merged after the run ledger's last sync, left for the next review"
  [ "$since" -gt "$start" ] || printf '%s\n' "$hold" > "$REVIEW_PASS"
  if [ "$failed" -gt 0 ]; then
    report_outcome FAILED "cannot count $failed PRs (gh, Forgejo or the run ledger), $n counted"
    return 1
  fi
  if [ "$n" -eq 0 ]; then
    msg="nothing new merged in the window"
    [ "$gone" -eq 0 ] || msg="nothing counted: $gone merged PRs their forge no longer has"
    report_outcome NOOP "$msg"
    return 0
  fi
  msg="$n PRs counted, $red CI reds"
  [ "$gone" -eq 0 ] || msg+=", $gone left out that their forge no longer has"
  say "$msg"
  report_outcome WORKED "$msg"
}

# sections_json <now> <days> -> what each section cost over the window. A row is a merged PR with
# sections; its session is whichever claims it in outcomes now (the row may predate the claim),
# and takes an equal share of that session's cost, tokens and work minutes. A session with no
# price stays out of the cost mean rather than counting as free.
sections_json() {
  outcomes_newest | jq -cs --argjson t "$1" --argjson days "$2" --slurpfile c "$(ci_file)" "$JQ_LIB"'
    def gated: map(select(ran_gate));
    def mean(f): map(f | numbers) | ratio(add // 0; length);
    def stats: gated as $g | {prs: length, gated: ($g | length), with_session: (map(select(.share)) | length),
      first_try: ratio($g | map(select(first_try)) | length; $g | length),
      reds_per_pr: ratio($g | total(.gate_red); $g | length),
      gate_min_per_pr: ratio($g | total(.gate_min); $g | length),
      gate_h: ($g | total(.gate_min) / 60 | round), green_lost: total(.green_lost),
      cost_per_pr: mean(.share.cost), tokens_per_pr: (mean(.share.tokens) | if . then round else . end),
      work_min_per_pr: mean(.share.work)};
    def per($n): if . then . / $n else null end;
    ([.[] | . as $s | ((.prs // []) | map(select(.state == "MERGED"))) as $m | ($m | length) as $n | $m[]
      | {key: key, share: {cost: ($s.cost_usd | per($n)), tokens: ($s.tokens_total | per($n)), work: ($s.time_use.work_min | per($n))}}]
     | unique_by(.key) | INDEX(.key)) as $claimed
    | ($c | map(select(.sections != null and .merged_epoch > $t - $days * 86400 and .merged_epoch <= $t)
                | . + {share: $claimed[key].share})) as $rows
    | {days: $days, all: ($rows | stats),
       sections: ([$rows[] | .sections[] as $n | . + {section: $n}] | group_by(.section)
                  | map({section: .[0].section} + stats) | sort_by(-.gate_h, -.prs))}'
}

# sections_table <json> <top, 0 for all>
sections_table() {
  jq -r --argjson top "$2" "$JQ_LIB"'def d: if . == null then "-" else tostring end;
    def mins: if . == null then "-" else round | tostring end;
    def usd: if . == null then "-" else "$\(round2)" end;
    def mtok: if . == null then "-" else "\(. / 1000000 | round1)M" end;
    def row($n): "| \($n) | \(.prs) | \(.first_try | d) | \(.reds_per_pr | d) | \(.gate_min_per_pr | mins) | \(.gate_h) | \(.green_lost) | \(.cost_per_pr | usd) | \(.tokens_per_pr | mtok) | \(.work_min_per_pr | mins) |";
    "| Section | PRs | First try | Gate reds per PR | Gate min per PR | Gate h | Greens lost | Cost per PR | Tokens per PR | Work min per PR |",
    "|---|---|---|---|---|---|---|---|---|---|",
    (.all | row("All PRs")),
    ((if $top > 0 then .sections[:$top] else .sections end)[] | row(.section)),
    "",
    "- A PR counts in every section it touches, so sections sum past All PRs. Greens lost is a green head a later commit replaced, for any reason. Gate columns cover the \(.all.gated) PRs that ran a gate, and cost, tokens and work the \(.all.with_session) of \(.all.prs) a session claims.",
    (if $top > 0 and (.sections | length) > $top then "- \(.sections | length - $top) more: `fleet-bench sections`." else empty end)' <<<"$1"
}

sections_section() {
  local j
  echo "## Sections"
  echo
  echo "Merged PRs in the last ${BENCH_SECTIONS_DAYS} days by section of the repo, from the paths each changed, the most gate hours first. First try is a PR whose gate never went red."
  echo
  j=$(sections_json "$1" "$BENCH_SECTIONS_DAYS") || { echo "- sections: ? (outcomes or pr-ci.jsonl unreadable)"; return 0; }
  [ "$(jq .all.prs <<<"$j")" -gt 0 ] || { echo "_No PR merged in a repo with sections in this window._"; return 0; }
  sections_table "$j" "$BENCH_SECTIONS_TOP"
}

cmd_sections() {
  local json=0 days="$BENCH_SECTIONS_DAYS" j
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      --days) days=${2:-}; shift ;;
      *) say "usage: fleet-bench sections [--days N] [--json]"; return 2 ;;
    esac
    shift
  done
  [[ "$days" =~ ^[1-9][0-9]*$ ]] || { say "usage: fleet-bench sections [--days N] [--json]"; return 2; }
  j=$(sections_json "$(now)" "$days") || return 1
  if [ "$json" = 1 ]; then printf '%s\n' "$j"; else sections_table "$j" 0; fi
}

# ask_rows -> a JSON array of pending asks in the order hub Home ranks them
# (hub_core::home::needs: what each holds times how long it waited), with the facts that score
# counted. Fails when hub could not read agent-ask, rather than report no asks.
ask_rows() {
  local needs
  needs=$($BENCH_NEEDS_CMD) || return 1
  jq -ce 'if any(.errors[]; test("agent-ask")) then error("agent-ask unreadable") else . end
    | [.needs[] | select(.kind == "ask")
       | {id, project, question: .text, recommend: (.recommend // ""), target,
          live: .score.session, phases_left: .score.phases, holds: .score.holds,
          age_h: (.score.age_min / 60)}]' <<<"$needs" 2>/dev/null
}

# asks_md <rows> -> the digest page, the same text in the terminal and in asks.md
asks_md() {
  local last="never"
  [ -s "$PROGRESS" ] && last=$(jq -rs "$JQ_LIB"'max_by(.epoch) | .epoch | hm' "$PROGRESS")
  jq -r --arg last "$last" '
    def age: if . < 48 then "\(floor)h" else "\(. / 24 | floor)d" end;
    def cell: gsub("\\|"; "\\|") | if length > 140 then .[0:140] + "..." else . end;
    def holds: if .holds == "" then "-" else .holds end;
    "# Pending asks",
    "",
    "\(length) pending. Sessions as sampled \($last). In hub Home'"'"'s order: what each holds (its session, plan phases left, queued items after it) times how long it waited; fields: the fleet-bench skill.",
    "",
    "## Blocking a live session",
    "",
    (map(select(.live)) | if length == 0 then "None." else
      "| Ask | Session | Age | Holds | Recommend | Question |", "|---|---|---|---|---|---|",
      (.[] | "| \(.id) | \(.target) | \(.age_h | age) | \(holds) | \(.recommend | if . == "" then "-" else . end) | \(.question | cell) |")
    end),
    "",
    "## No live session behind them",
    "",
    "Headless asks and asks whose session has ended. Answer, or cancel with `agent-ask cancel <id>` when it no longer applies.",
    "",
    (map(select(.live | not)) | if length == 0 then "None." else
      "| Ask | Project | Age | Holds | Recommend | Question |", "|---|---|---|---|---|---|",
      (.[] | "| \(.id) | \(.project) | \(.age_h | age) | \(holds) | \(.recommend | if . == "" then "-" else . end) | \(.question | cell) |")
    end)' <<<"$1"
}

# asks_line <rows> <top-n> <max-chars> -> one plain line (comms-standard): the count, the top
# few questions with their age and recommendation, as many as fit in max-chars (the first
# always), and where to see them all. Ids and session targets stay in asks.md; the line is
# read on a lock screen and in the briefing.
asks_line() {
  jq -r --argjson k "$2" --argjson max "$3" '
    def age: if . < 48 then "\(floor)h" else "\(. / 24 | floor)d" end;
    # The first sentence is the question; the rest is context. A question is never cut:
    # one too long for the line is named by its "topic:" label (else its project) and id instead.
    def name: ((.question | capture("^(?<t>[^:?.!]{3,60}): ") | .t) // "a \(.project) question") + ", ask \(.id)";
    def q: .question | gsub("\\s+"; " ") | ((capture("^(?<s>.*?[?.!])( |$)") | .s) // .);
    def meta: " (\(.age_h | age)" + (if .recommend != "" then ", recommend \(.recommend)" else "" end) + ")";
    (map(select(.live)) | length) as $l
    | ((if length == 1 then "1 question waits on you" else "\(length) questions wait on you" end)
      + (if $l == 0 then ", none holding up a session" else ", \($l) holding up a session" end)
      + ". Top: ") as $head
    | ". List: fleet-bench asks." as $tail
    | def fits($l): ($head + ($l | join("; ")) + $tail | length) <= $max;
      reduce (.[:$k][] | [q + meta, name + meta]) as [$full, $short] ([];
        if fits(. + [$full]) then . + [$full] elif length == 0 or fits(. + [$short]) then . + [$short] else . end)
    | $head + join("; ") + $tail' <<<"$1"
}

# The page for these asks is hub's (`hub needs --page`, after every fleet-state pass).
cmd_asks() {
  local mode="${1:-}" rows out
  case "$mode" in ""|--write) ;; *) say "usage: fleet-bench asks [--write]"; return 2 ;; esac
  if ! rows=$(ask_rows); then
    say "hub needs failed or could not read agent-ask"
    return 1
  fi
  [ -n "$mode" ] || { asks_md "$rows"; return 0; }
  mkdir -p "$BENCH_SCORECARD_DIR" || return 1
  out="$BENCH_SCORECARD_DIR/asks.md"
  asks_md "$rows" > "$out.tmp" && mv "$out.tmp" "$out" || return 1
  [ "$(jq length <<<"$rows")" = 0 ] && return 0
  # --write is the morning briefing's step: one item of at most 160 chars, so the top one
  # (channels.toml: a briefing item is 160).
  asks_line "$rows" 1 160
}

# ---------------------------------------------------------------- ledger
#
# The consolidation ledger. Every new need used to become a new runner, timer or launch
# path, so the fleet grew while it was being consolidated. These are counts, never a
# grade. --check holds the two that may only shrink to the committed baseline: to add
# one, retire one or raise the baseline in the same PR with a why. A direct launch is held
# per file instead (launches_unlisted): launches_direct is a reading, never a gate.

: "${LEDGER_GATED:=runners timers}"

# headless_launches DIR... -> file:line of every executable line that starts a headless
# claude, opencode, codex or agy outside agentctl-run, or calls a model's HTTP API (an OpenAI-style chat/completions or
# Anthropic /v1/messages URL, or a chat body with a "model" key and a "messages" list on one line,
# for a caller that reads its URL from config) with no registered agent at all. Comments, echo
# lines, docs, yaml and tests are not call sites, and agent-run's harnesses are the launcher itself.
# git grep honours .gitignore, so 1.8G of build output under .local/src is never read;
# it works on a plain directory too. runner_contract.bats calls this through
# `ledger --launches`, so there is one scan.
headless_launches() {
  local d
  for d in "$@"; do
    [ -d "$d" ] || continue
    (cd "$d" && git grep --no-index --exclude-standard -nIiE \
      '\b(claude|claude_bin)\b[^|#]* (-p|--print)( |$|")|\bopencode run\b|\bagy\b[^|#]* -p( |$|")|\b(codex|codex_bin)\b[^|#]* exec( |$|")|[A-Za-z0-9_}]/(v1/)?chat/completions|[A-Za-z0-9_}]/v1/messages\b|"model"[[:space:]]*:[^|#]*"messages"[[:space:]]*:[[:space:]]*\[' \
      -- . ':!*.md' ':!*.yaml' ':!*.yml' ':!tests/**' ':!**/tests/**') \
      | sed "s|^|${d%/}/|"
  done | grep -vE '^[^:]+:[0-9]+:[[:space:]]*(#|echo )' | grep -v '/agent-run/harnesses/'
}

# launch_rows -> the file each row of PIPELINES.md's "Model calls outside agentctl-run" table
# names (the first backticked word of its File cell), sorted; exit 2 with no such table.
launch_rows() {
  [ -r "$LEDGER_PIPELINES" ] || { say "no launch table: cannot read $LEDGER_PIPELINES"; return 2; }
  awk '/^## /{ on = (index($0, "## Model calls outside agentctl-run") == 1); found = found || on; next }
    on && /^\| `/ { split($0, c, "`"); print c[2] }
    END { exit !found }' "$LEDGER_PIPELINES" | sort -u
  [ "${PIPESTATUS[0]}" = 0 ] \
    || { say "no launch table: $LEDGER_PIPELINES has no '## Model calls outside agentctl-run' section"; return 2; }
}

# launch_files -> each file under LEDGER_SRC with a headless launch line, once, sorted
launch_files() {
  local src
  IFS=: read -ra src <<<"$LEDGER_SRC"
  headless_launches "${src[@]}" | cut -d: -f1 | sort -u
}

# launches_unlisted -> one line per launch file (launch_files) with no launch_rows row (by file
# name, as the table names them), and per row no launch file has that name; exit 1 on any, 2 with
# no table. The rows are the per-file allowlist of launches outside agentctl-run.
launches_unlisted() {
  local rows
  rows=$(launch_rows) || return 2
  launch_files | awk 'NR == FNR { if ($0 != "") row[$0] = 1; next }
    $0 != "" { b = $0; sub(/.*\//, "", b); seen[b] = 1; if (!(b in row)) { print "launch with no PIPELINES.md row: " $0; bad = 1 } }
    END { for (k in row) if (!(k in seen)) { print "PIPELINES.md row with no launch: " k; bad = 1 }; exit bad }' <(printf '%s\n' "$rows") -
  return "${PIPESTATUS[1]}"   # awk's word: an empty scan exits 1 from its grep -v, and that is no fault
}

# scheduled_runner <conf> -> the runner's name, failing for one fired by hand. fleet-liveness's
# roster: a retired runner keeps its state dir, and a conf with no SCHEDULE or AUTOSTART=yes is
# fired by hand, so neither can count as bad. The caller has already skipped KIND=call and ENABLED=no.
scheduled_runner() {
  local name
  grep -qE '^SCHEDULE=["'"'"']?[^"'"'"' ]' "$1" || grep -qE '^AUTOSTART=["'"'"']?yes' "$1" || return 1
  name=$(sed -n '/^NAME=/{s///p;q;}' "$1")
  printf '%s\n' "${name:-$(basename "$1" .conf)}"
}

# bench_profile -> sets BENCH_PROFILE to the profile `notes config` names unless it is set; fails with none
bench_profile() {
  [ -n "${BENCH_PROFILE:-}" ] || BENCH_PROFILE=$(notes config 2>/dev/null | awk '$1 == "profile" { print $2; exit }')
  [ -n "$BENCH_PROFILE" ]
}

# board_reading -> "<open> <backlog> <days>" for the active profile's agent boards (BENCH_BOARD_CMD
# feeds every profile; BENCH_PROFILE overrides the profile `notes config` names). One profile is the
# unit dispatch pulls from, so a second profile's boards do not add to it, and a project with
# automation off is left out. open counts the open and started agent-lane rows on the board; a row
# still carrying the retired backlog token (`.backlog`, which the sweep strips) is off the board and
# counts in backlog. days is the board's weight over the weight its agent rows closed with a PR
# shipped a day across the feed's done window (BOARD_SHIP_DAYS), one decimal: the days the fleet
# takes to clear the board at its current rate. The rate is floored at one weight a day, so a board
# that shipped nothing in the window reads its whole weight in days and trips, not a quiet ?. ? for
# a field that cannot be read.
board_reading() {
  bench_profile || { echo '? ? ?'; return; }
  bench_read $BENCH_BOARD_CMD 2>/dev/null | jq -er --arg p "$BENCH_PROFILE" --argjson days "$BOARD_SHIP_DAYS" "$JQ_LIB"'
    (.done // []) as $done
    | .rows | if type == "array" then . else error("no rows") end
    | map(select(agent_row($p) and (.state == "open" or .state == "doing"))) as $r
    | ($r | map(select(on_board($p)))) as $on
    | ([$on[].weight // 0] | add // 0) as $w
    | ([$done[] | select(agent_row($p) and ((.prs // []) | length > 0)) | .weight // 0] | add // 0) as $s
    | "\($on | length) \(($r | length) - ($on | length)) \($w / ([$s / $days, 1] | max) | round1)"' \
    2>/dev/null || echo '? ? ?'
}

# intake_room -> one line, board_days against board_days_max in KPI_THRESHOLDS, then the board's row
# and backlog counts; 1 when board_days is past it. Information only: nothing holds a filer on it.
# The board is all planned work, so no threshold is set and no threshold is no limit; dispatch not
# pulling is the queue-starved and sprint-stalled watches' alert.
intake_room() {
  local n b d max rows
  read -r n b d < <(board_reading)
  [ "$n" = '?' ] && { echo "room: board_days ?, the board feed is unreadable"; return 0; }
  rows="board_open $n (backlog $b)"
  max=$(sed -n 's/^board_days_max=//p' "$KPI_THRESHOLDS" 2>/dev/null | tail -1)
  if [ -z "$max" ]; then echo "room: board_days $d, $rows, no board_days_max"; return 0; fi
  if awk -v n="$d" -v m="$max" 'BEGIN { exit !(n > m) }'; then
    echo "full: board_days $d past board_days_max $max, $rows"; return 1
  fi
  echo "room: board_days $d of board_days_max $max, $rows"
}

# ledger_roster -> the roster's key=value lines, read from the confs and the source tree alone,
# so CI can count a checkout (the ledger workflow): `--check` reads only these. A timer is
# counted where `agentctl reload` writes one, a switched-on oneshot with a SCHEDULE; reload
# removes any other, so the live timer dir holds the same count once reloaded.
ledger_roster() {
  local c n_conf=0 n_on=0 n_bad=0 n_call=0 n_timer=0 sd="" name
  proof_lib && sd=$(proof_state_dir)
  for c in "$LEDGER_CONF_DIR"/*.conf; do
    [ -e "$c" ] || continue
    # A KIND=call agent is a model call its caller starts, not a runner: no unit, no timer.
    grep -qE '^KIND=["'"'"']?call' "$c" && { n_call=$((n_call + 1)); continue; }
    n_conf=$((n_conf + 1))
    grep -qE '^ENABLED=["'"'"']?no' "$c" && continue
    n_on=$((n_on + 1))
    grep -qE '^KIND=["'"'"']?oneshot' "$c" && grep -qE '^SCHEDULE=["'"'"']?[^"'"'"' ]' "$c" && n_timer=$((n_timer + 1))
    name=$(scheduled_runner "$c") || continue
    [ -n "$sd" ] && grep -qE '^(FAILED|STALLED)' "$sd/$name/last-outcome" 2>/dev/null && n_bad=$((n_bad + 1))
  done
  echo "runners=$n_conf"
  echo "runners_on=$n_on"
  echo "runners_bad=$n_bad"
  echo "agents_call=$n_call"
  echo "timers=$n_timer"
  echo "launches_direct=$(launch_files | wc -l)"
}

# ledger_counts -> key=value lines: the roster, then the fleet's live counts. Its sections read on
# their own, so they run at once in one read cache and print in this order (ar-4590: serial, the
# kpi call took 345 s at load 13).
ledger_counts() {
  [ -n "${BENCH_READ_CACHE:-}" ] || { with_reads ledger_counts; return; }
  local t PAR PAR_PIDS s
  t=$(now)
  par_open || return 1
  par_go 1 ledger_proof "$t"
  par_go 2 ledger_asks
  par_go 3 ledger_board
  par_go 4 ledger_points "$t"
  par_go 5 ledger_local "$t"
  par_go 6 ledger_systems
  par_go 7 chain_counts "$t"
  par_wait
  for s in 1 2 3 4 5 6 7; do cat "$PAR/$s"; done
}

# ledger_proof <now> -> the roster, verdict_words and failed_unexplained
ledger_proof() {
  local t=$1 sd=""
  ledger_roster
  proof_lib && sd=$(proof_state_dir)
  # awk, not cat: last-outcome has no trailing newline, so cat runs every verdict into one word
  echo "verdict_words=$([ -n "$sd" ] && awk '{print $1}' "$sd"/*/last-outcome 2>/dev/null | sort -u | grep -c .)"
  # proof_report writes "why: unrecorded" on a FAILED, STALLED or BLOCKED line its runner gave no
  # reason for; this counts those of the last 24h (local times, compared as text)
  if [ -n "$sd" ]; then
    echo "failed_unexplained=$(awk -v s="$(date -d "@$((t - 86400))" +%FT%T)" \
      'substr($1, 2, 19) > s && / outcome=(FAILED|STALLED|BLOCKED) / && / why: unrecorded$/' "$sd"/*/activity.log 2>/dev/null | grep -c .)"
  else
    echo "failed_unexplained=?"
  fi
}

# ledger_asks -> asks_pending and asks_stale
ledger_asks() {
  local rows
  if rows=$(ask_rows 2>/dev/null); then
    jq -r --argjson d "$ASK_STALE_DAYS" '"asks_pending=\(length)", "asks_stale=\(map(select(.age_h > $d * 24)) | length)"' <<<"$rows"
  else
    echo "asks_pending=?"; echo "asks_stale=?"
  fi
}

# ledger_board -> board_open and board_days
ledger_board() {
  local board_open board_backlog board_days
  read -r board_open board_backlog board_days < <(board_reading)
  echo "board_open=$board_open"
  echo "board_days=$board_days"
}

# ledger_points <now> -> points_per_pr: Claude weekly points per landed PR, the plans' real price;
# other sources bill in other units
ledger_points() {
  echo "points_per_pr=$(sources_json "$1" 2>/dev/null | jq -er '[.sources[] | select(.kind == "claude" and .points != null)]
    | (map(.landed // 0) | add // 0) as $n | if $n > 0 then (map(.points // 0) | add) / $n * 100 | round / 100 else "?" end' 2>/dev/null || echo '?')"
}

# ledger_local <now> -> loop_dark, lesson_held_share and the worktree counts
ledger_local() {
  local t=$1
  # loop_dark: the dark episodes still firing; `fleet-bench loop` lists every episode, cleared ones too
  loop_episodes "$t" $((t - LOOP_WINDOW_S)) | jq -sr '"loop_dark=\(map(select(.dark and .open)) | length)"'
  # lesson_held_share: of the lessons with a sig whose before and after windows are both read, the share
  # that held (session-outcomes lessons); ? when none has a verdict yet or the cache cannot be read
  echo "lesson_held_share=$($BENCH_LESSONS_CMD 2>/dev/null | jq -er '(.held + .recurring) as $n
    | if $n > 0 then .held / $n * 100 | round / 100 else "?" end' 2>/dev/null || echo '?')"
  # worktrees_held, worktrees_held_over_7d: trees held with nobody in them, and those idle past 7 days, from
  # the newest worktree-gc row; ? with no row, one older than WORKTREE_GC_STALE_H, or one dated in the future
  jq -nrR --argjson t "$t" --argjson h "$WORKTREE_GC_STALE_H" '
    ([inputs] | last // "" | try fromjson catch null) as $r
    | if ($r | type) == "object" and ($r.epoch | numbers) != null and $r.epoch > $t - $h * 3600 and $r.epoch <= $t + 3600
      then "worktrees_held=\($r.held // "?")", "worktrees_held_over_7d=\($r.held_over_7d // "?")"
      else "worktrees_held=?", "worktrees_held_over_7d=?" end' < <(tail -n 1 "$WORKTREE_GC_LOG" 2>/dev/null)
}

# ledger_systems -> systems_no_skill: registry systems no skill's metadata.system names (skill-drift
# --systems); report-only, so it is outside the chain (no watch reads it) and improve never picks it
ledger_systems() {
  echo "systems_no_skill=$($BENCH_SYSTEMS_CMD 2>/dev/null | jq -er '.no_skill | arrays | length' 2>/dev/null || echo '?')"
}

# The work chain, intake -> backlog row -> queue item -> session -> PR -> merge -> closed row, as
# counts taken now; each is 0 (or 1 for a share) when every link holds. A backlog size or age here
# (requested_unstarted_h, next_up_blocked) has no bar in kpi-thresholds, so it prints but never trips --check. ledger_coverage and
# untracked_merged_prs: of the PRs merged in the last CHAIN_DAYS (pr-ci.jsonl), how many an item
# names (owner/repo#N, a forge URL, or a bare N by number). board_orphan_started: started agent rows
# no active item names. merged_open_rows: done items with merge proof whose row is still open.
# ownerless_running: running or waiting items with no session (reap flags them).
# epic_linked_share: the agent rows filed under an epic (#of/), over every project automation manages;
# a project with no epic yet counts, all its rows unlinked, since the link pass gives each row one.
# uncaused_close_share: the done items finished in the window that closed failed with no end_reason, over every one
# finished; end_reason is the one record of why a run ended (lib/end-reasons.sh), so a failed close with none is a
# cause no reader can find (ar-5427).
# landed_unverified: open epics whose every leaf is done, waiting on proof of the outcome. doctor_fail: FAIL lines in the last notes doctor.
# dup_pairs: instructions two homes restate, from the newest nightly docs-cleanup night's dups.json
# (skill-drift --dups); the bound is dup_pairs_max, the same row skill-drift --dups --check holds.
# chain_drift, chain_inbox_drift and step_age_p90_<step>: pipeline_json's drift and inbox_drift and each step's age p90, in minutes.
# plans_unqueued: approved plans with open phases and no session or item (plans_orphaned).
# requested_unstarted_h: hours the oldest #requested agent row has sat open and unstarted.
# orphan_request_rows, next_up_blocked, stale_urgent_d, urgent_per_board, playtest_waiting_d and done_inline_old: the
# rows the board holds that no step will move, from board_links (which says what each counts).
# prio_default: open agent and human rows with no priority tag or no #why/<reason> (the default rank
# normal still applies to them), by the filer that wrote each (prio_defaults); 0 when every row has both.
# request_to_live_h: the p50 hours from request to live (lead_time_json), ? until every
# BENCH_LEAD_TRUST KPI holds its bound (lead_untrusted).
# wants_unstamped: of the agent-lane rows the human's channels added over the last CHAIN_DAYS
# (ingest.jsonl: an added or filed event the human wrote by hand, writer "human" or unnamed, or one
# naming its channel, `want` from `ptask --want`, whichever runner wrote it; only an agent row can
# carry #requested), the share that carry no #requested. A `want` event was stamped by the writer.
# A runner's own row is not a channel: `notes` names its writer (AGENTCTL_NAME) since #1688.
# routes_unresolved: standing watches, runners and the hold row no triage-routes line resolves, owned:<row> routes whose row is not open, and runners whose SKILL= names nothing (triage_coverage).
# reds_spent: causes red now whose TRIAGE_FIX_TRIES and escalation are spent (triage_spent_write), each carried by one ask, so a red no try is left for shows on the scorecard.
# reds_unfixed: red fixes merged in the last REDS_DAYS whose red is still or again red (reds_json),
# leaving out a red TRIAGE_ROUTES sends to alert, which no merge can clear; ? when a cleanup hold cannot be read.
# admission_held: adds the queue cap held in the last 7 days (agent-queue admit).
# cost_per_merged_item rides the same read but is not a link: the work ledger's spend per landed
# item, cost_usd (the nightly outcomes pass sums it over the item's sessions) plus gateway_cost_usd,
# over the done items with merge proof that finished in the last CHAIN_DAYS and carry a cost. An
# item with no cost yet is left out, never counted as free.
# release_overdue and version_tag_drift are the release link (release_kpis): a project a day past its
# target date with that version uncut, else a sheet-counter project, or a prod app its tag owns, a day past
# its cadence due date with done rows and no cut; and a tagged project whose sheet is not its tag plus one patch.
KPI_CHAIN="ledger_coverage untracked_merged_prs board_orphan_started merged_open_rows ownerless_running uncaused_close_share epic_linked_share landed_unverified release_overdue version_tag_drift doctor_fail dup_pairs plans_unqueued routes_unresolved reds_unfixed reds_spent requested_unstarted_h orphan_request_rows next_up_blocked stale_urgent_d urgent_per_board playtest_waiting_d done_inline_old prio_default request_to_live_h wants_unstamped admission_held chain_drift chain_inbox_drift step_age_p90_backlog step_age_p90_queued step_age_p90_running step_age_p90_review step_age_p90_waiting queue_net_24h estimated_token_share"

# wants_stats <now> -> {total, unstamped, by_project: {<from>: {total, unstamped}}} over the last
# CHAIN_DAYS of the notes ingest record; nothing and a failure when the record cannot be read.
wants_stats() {
  [ -r "$BENCH_INGEST" ] || return 1
  jq -Rnc --arg since "$(date -d "@$(( $1 - CHAIN_DAYS * 86400 ))" +%F)" --argjson fix "$FIX_SINCE" "$JQ_LIB"'
    [inputs | fromjson? | ((.want // "") != "") as $want | select((.ts // "")[0:10] >= $since and ($fix == 0 or ((try ((.ts // "") | sub("\\.[0-9]+"; "") | iso_epoch) catch $fix) >= $fix)) and .lane == "agent" and (.action | IN("added", "filed")) and (human_writer or $want))
         | {from: (.from // "?"), stamped: ($want or ((.text // "") | test("#requested")))}] as $w
    | {total: ($w | length), unstamped: ($w | map(select(.stamped | not)) | length),
       by_project: ($w | group_by(.from) | map({key: .[0].from, value: {total: length, unstamped: map(select(.stamped | not)) | length}}) | from_entries)}' "$BENCH_INGEST"
}

# lead_time_json <now> -> {hours, p50, at_merge, in_release, unreleased, unknown}: request to live
# for the items the human asked for (from: human) with merge proof, finished in the last
# BENCH_LEAD_DAYS. Request is the item's queued time. Live is the item's finished time (agent-land
# closes it at the merge) in a project release-state has no row for, since its merge is its
# deploy; else the first tag of the project's line holding every merged commit (release-state
# released), live at the first deploy the release graph records for that tag (hub releases
# --json, each history row's reached), or at the tag's own time when none is. hours and p50 cover those live in the last
# CHAIN_DAYS; unreleased counts the merged ones no tag holds yet, unknown the ones whose commit
# the checkout lacks (one of an item's merges in another repo makes it unknown too), both over
# the whole BENCH_LEAD_DAYS. A failure when the queue or the
# release graph cannot be read.
lead_time_json() {
  local t=$1 items graph rel deployed p released=() shas
  items=$(bench_read $BENCH_DONE_ITEMS_CMD --since "$(date -d "@$((t - BENCH_LEAD_DAYS * 86400))" +%F)" 2>/dev/null \
    | jq -sc 'map(select(.from == "human" and (.merged // "") != "") | {project, merged, queued, finished})') || return 1
  # hub exits 1 on any fault, a channel not probed included, so its exit says nothing here: a read
  # with no rows and an error is a snapshot that did not read.
  graph=$(bench_read $BENCH_RELEASES_CMD 2>/dev/null)
  rel=$(jq -ce 'if (.rows | length) == 0 and (.errors | length) > 0 then error("unread") else [.rows[].project] | unique end' <<<"$graph") || return 1
  # {project: {tag: the first deploy's epoch, null when none is recorded}}
  deployed=$(jq -c '[.apps[]? | {key: .project, value: ([.history[]? | {key: .tag, value: ([.reached[]?.at | values] | min)}] | from_entries)}] | from_entries' <<<"$graph") || return 1
  for p in $(jq -r --argjson r "$rel" '[.[].project | select(IN($r[]))] | unique[]' <<<"$items"); do
    mapfile -t shas < <(jq -r --arg p "$p" '.[] | select(.project == $p) | .merged | splits(" +") | select(. != "")' <<<"$items")
    released+=("$($BENCH_RELEASED_CMD "$p" "${shas[@]}" 2>/dev/null | jq -sc .)")
  done
  jq -c --argjson t "$t" --argjson days "$CHAIN_DAYS" --argjson r "$rel" --argjson d "$deployed" \
     --slurpfile x <(printf '%s\n' "${released[@]}" '[]') "$JQ_LIB"'
    . as $a | ($x | add | map(select(.sha)) | INDEX(.sha)) as $tag
    | [$a[] | [.merged | splits(" +") | select(. != "")] as $s | .project as $p
       | (.queued | ep) as $q
       | if (.project | IN($r[])) | not then {kind: "at_merge", at: (.finished | ep)}
         elif any($s[]; $tag[.] == null or $tag[.].error != null) then {kind: "unknown"}
         elif any($s[]; $tag[.].at == null) then {kind: "unreleased"}
         else {kind: "in_release", at: ([$s[] | $tag[.] | $d[$p][.tag] // .at] | max)} end
       | . + {q: $q}] as $rows
    | ($rows | map(select(.at != null and .q != null and .at > $t - $days * 86400 and .at <= $t))) as $live
    | ($live | map((.at - .q) / 3600 | round1)) as $h
    | {hours: $h, p50: ($h | median | if . == null then null else round1 end),
       at_merge: ($live | map(select(.kind == "at_merge")) | length),
       in_release: ($live | map(select(.kind == "in_release")) | length),
       unreleased: ($rows | map(select(.kind == "unreleased")) | length),
       unknown: ($rows | map(select(.kind == "unknown")) | length)}' <<<"$items"
}

# lead_untrusted <key=value lines> -> one "<kpi> <value> (min <bound>)" line per BENCH_LEAD_TRUST
# KPI that is unread, has no min in kpi-thresholds, or sits under it; nothing when all hold, and
# request_to_live_h reads its value only then (a lead time over a ledger that misses half the
# merges is not one). A share over nothing (`-`, an empty window) holds: it misses no merge.
lead_untrusted() {
  local kv=$1 k v min
  for k in $BENCH_LEAD_TRUST; do
    v=$(sed -n "s/^$k=//p" <<<"$kv" | tail -1)
    [ "$v" != - ] || continue
    min=$(sed -n "s/^${k}_min=//p" "$KPI_THRESHOLDS" 2>/dev/null | tail -1)
    if [ -z "$min" ]; then echo "$k ${v:-?} (no min)"
    elif ! awk -v v="$v" -v m="$min" 'BEGIN { exit !(v ~ /^[0-9.]+$/ && v + 0 >= m + 0) }'; then echo "$k ${v:-?} (min $min)"; fi
  done
}

# playtest_blame <board json> -> "<sheet>\t<line>\t<epoch>" for each line of every playtest sheet
# with an open check on a managed board: the author time git blame gives the line, as a check
# carries no date of its own (an uncommitted line reads now); "<sheet>\t?\t?" for a sheet git cannot blame
playtest_blame() {
  local s
  jq -r '[.rows[]? | select(.lane == "playtest" and .state == "open" and .automation != false) | .sheet | strings] | unique[]' <<<"$1" |
    while IFS= read -r s; do
      git -C "${s%/*}" blame --line-porcelain -M -- "${s##*/}" 2>/dev/null | awk -v s="$s" '
        substr($0, 1, 1) != "\t" && length($1) >= 40 && $1 ~ /^[0-9a-f]+$/ && NF >= 3 { l = $3 }
        /^author-time / { print s "\t" l "\t" $2; n++ }
        END { if (!n) print s "\t?\t?" }'
    done
}

# board_links <now> -> one object naming the rows behind five chain KPIs, a field null when its
# source cannot be read; nothing and rc 1 when the board feed (BENCH_BOARD_CMD) cannot be read.
# Rows of a project with automation off are never counted.
#   orphans (orphan_request_rows): open rows with an id whose #of/ parent is no open row, or that a
#     done item with merge proof (the done items merged_open_rows reads) names as its subject while
#     it worked another row. The subject is agent-queue named_row's, over the title, else the task's
#     first line: its first word, or the one id in brackets that ends it (ar-5461). The item that worked the row itself is
#     merged_open_rows; a merged PR reaches a row through its item. A row an active item works
#     (BENCH_ITEMS_CMD) is that item's to move, so it is no orphan of the merged one.
#   blocked (next_up_blocked): open agent rows the dispatch judge's latest verdict (BENCH_VERDICTS_CMD)
#     skipped for a split (plan: a DISPATCH_PLAN_RULES rule) over 24h ago, and that split never ran
#   urgent (stale_urgent_d): the oldest triaged #urgent agent row not yet started (open, or Next up:
#     its item queued), in whole days since it was filed
#   urgent_boards (urgent_per_board): the triaged #urgent agent rows not yet started (as urgent), counted
#     per board, most first; past the cap, urgent no longer says what starts first
#   playtest (playtest_waiting_d): each game's oldest open playtest check, days since git blame dates it
#   done_old (done_inline_old): closed rows past the Done window that the next sweep rolls off
board_links() {
  local t=$1 feed done verdicts blame active
  feed=$(bench_read $BENCH_BOARD_CMD 2>/dev/null | jq -ce 'select(.rows | arrays)') || return 1
  active=$(bench_read $BENCH_ITEMS_CMD 2>/dev/null | jq -sc .) || active=null
  done=$(bench_read $BENCH_DONE_ITEMS_CMD --since "$(date -d "@$((t - (CHAIN_DAYS + 1) * 86400))" +%F)" 2>/dev/null | jq -sc .) || done=null
  verdicts=$($BENCH_VERDICTS_CMD 2>/dev/null | jq -sc .) || verdicts=null
  blame=$(playtest_blame "$feed" | jq -Rsc 'split("\n") | map(select(. != "") | split("\t"))')
  jq -c --argjson t "$t" --slurpfile d <(printf '%s' "$done") --slurpfile v <(printf '%s' "$verdicts") \
     --slurpfile a <(printf '%s' "$active") --argjson blame "${blame:-[]}" "$JQ_LIB"'
    def subject: [(capture("^\\s*(?<i>[a-z]{2,4}-[0-9]+)([:\\s]|$)"; "i") | .i), (capture("[(\\[](?<i>[a-z]{2,4}-[0-9]+)[)\\]][\\s.]*$"; "i") | .i)]
      | map(ascii_downcase) | unique | if length == 1 then .[0] else null end;
    def live: .state == "open" or .state == "doing";
    $d[0] as $d | $v[0] as $v | ($a[0] | if . == null then null else map(rowkey | strings) | INDEX(.) end) as $worked
    | [.rows[] | select(.id != null and live)] as $live
    | ($live | map({key: "\(.project):\(.id)", value: .}) | from_entries) as $open
    | ($live | group_by(.id) | map({key: .[0].id, value: .}) | from_entries) as $byid
    | [.rows[] | select(.automation != false)] as $rows
    | {orphans: (if $d == null or $worked == null then null else
         [($rows[] | select(.id != null and live and .parent != null and $open["\(.project):\(.parent)"] == null)
             | {project, id, why: "its parent \(.parent) is closed"}),
          ($d[] | select((.merged // "") != "")
             | ((.title | select(. != "")) // (.task // "" | split("\n")[0]) // "" | subject) as $s | select($s != null) | $byid[$s][]? as $o
             | select($o.automation != false and ([rowkey | strings] | index(["\($o.project):\($s)"]) == null)
                      and $worked["\($o.project):\($s)"] == null)
             | {project: $o.project, id: $s, why: "\(.slug) landed it"})]
         | unique_by([.project, .id]) end),
       blocked: (if $v == null then null else
         ($v | map(select(.lane == "agent" and .plan == true))
              | map({key: "\(.project)\t\(.key)", value: .}) | from_entries) as $by
         | [$rows[] | select(.lane == "agent" and .state == "open" and .id != null)
             | $by["\(.project)\t\(.id)"] as $x | select($x != null)
             | (($x.at // "") | try iso_epoch catch null) as $at | select($at != null and $at < $t - 86400)
             | {project, id, rule: $x.rule, at: $x.at}] end),
       urgent: ([$rows[] | select(.lane == "agent" and .priority == "urgent" and .untriaged != true
                   and (.state == "open" or .section == "next") and ((.since // "") | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")))
                 | {project, id, since, days: (($t - (.since + "T00:00:00Z" | fromdate)) / 86400 | floor)}]
                | sort_by(-.days) | first),
       urgent_boards: ([$rows[] | select(.lane == "agent" and .priority == "urgent" and .untriaged != true
                         and (.state == "open" or .section == "next"))]
                       | group_by(.project) | map({project: .[0].project, n: length}) | sort_by(-.n)),
       playtest: (if any($blame[]; .[1] == "?") then null else
         ($blame | map({key: "\(.[0])\t\(.[1])", value: (.[2] | tonumber)}) | from_entries) as $at
         | [$rows[] | select(.lane == "playtest" and .state == "open") | $at["\(.sheet)\t\(.line)"] as $e | select($e != null)
             | {project, game: (.game // "-"), days: (($t - $e) / 86400 | floor)}]
         | group_by([.project, .game]) | map(max_by(.days)) | sort_by(-.days) end),
       done_old: (.projects // null | if . == null then null
         else map(select(.automation != false) | .done_old) | if any(. == null) then null else add // 0 end end)}' <<<"$feed"
}

# oldest_requested <now> -> the oldest open #requested agent row as {project, id, since, h}, the row
# behind requested_unstarted_h; nothing when there is none or the board does not read
oldest_requested() {
  bench_read $BENCH_BOARD_CMD 2>/dev/null | jq -c --argjson t "$1" "$JQ_LIB"'.rows // [] | oldest_request($t)' 2>/dev/null
}

# chain_notes <now> <chain json>: the lines under the chain table that say which rows sit behind
# its numbers, the lead time's raw value while its trust KPIs hold it at ? among them
chain_notes() {
  local t=$1 stats lead held
  bench_read $BENCH_ITEMS_CMD 2>/dev/null | jq -rs "$JQ_LIB"'
    map(ownerless | .slug) | select(. != []) | "ownerless_running: \(join(", "))"' 2>/dev/null
  oldest_requested "$t" | jq -r '"requested_unstarted_h: oldest is \(.project):\(.id), open since \(.since) (\(.h)h)"' 2>/dev/null
  board_links "$t" | jq -r 'def few: (.[0:8] | join(", ")) + (if length > 8 then ", \(length - 8) more" else "" end);
    (.orphans // [] | select(. != []) | "orphan_request_rows: " + (map("\(.project):\(.id) (\(.why))") | few)),
    (.blocked // [] | select(. != []) | sort_by(.at) | "next_up_blocked: skipped for a split over 24h ago, oldest first: " + (map("\(.project):\(.id) (\(.rule) \(.at[0:10]))") | few)),
    (.urgent // empty | "stale_urgent_d: oldest is \(.project):\(.id), filed \(.since) (\(.days)d)"),
    (.urgent_boards // [] | select(. != []) | "urgent_per_board: " + (map("\(.project) \(.n)") | few)),
    (.playtest // [] | select(. != []) | "playtest_waiting_d: oldest open check per game: " + (map("\(.project) \(.game) \(.days)d") | few))' 2>/dev/null
  prio_defaults | jq -r 'select(.total > 0) | "prio_default: \(.total) open rows with no priority or no #why, by filer: " + ([.origins[] | "\(.origin) \(.n)"] | .[0:8] | join(", "))'
  local projects
  projects=$(bench_read $BENCH_PROJECTS_CMD 2>/dev/null | jq -ce 'arrays') && release_kpis "$t" "$projects" | jq -r '
    (.overdue | select(. != []) | "release_overdue: " + (map("\(.project) \(.version) \(if .by == "target" then "targeted for" elif .by == "tag" then "untagged, due since" else "due since" end) \(.due_on)") | join(", "))),
    (.drift | select(. != []) | "version_tag_drift: " + (map("\(.project) sheet \(.sheet), tag \(.tag)") | join(", ")))' 2>/dev/null
  held=$(lead_untrusted "$(jq -r 'to_entries[] | "\(.key)=\(.value["7d"] // "?")"' <<<"$2")" | paste -sd, - | sed 's/,/, /g')
  if lead=$(lead_time_json "$t"); then
    jq -r --argjson d "$CHAIN_DAYS" --argjson lead "$BENCH_LEAD_DAYS" --arg held "$held" '"request_to_live_h: p50 \(.p50 // "-")h over \(.hours | length) live in \($d)d"
      + " (\(.at_merge) on merge, \(.in_release) in a tag); of those merged in \($lead)d, \(.unreleased) in no tag yet, \(.unknown) unknown"
      + (if $held == "" then "" else "; reads ? until \($held)" end)' <<<"$lead"
  else
    echo "request_to_live_h: the done items or the release graph (hub releases --json) unreadable"
  fi
  if stats=$(wants_stats "$t") && [ -n "$stats" ]; then
    jq -r --argjson d "$CHAIN_DAYS" '"wants_unstamped: \(.unstamped) of \(.total) human-channel agent rows added in \($d)d carry no #requested, by project"
      + (if .total == 0 then "" else " (" + ([.by_project | to_entries | sort_by(-.value.unstamped)[] | "\(.key) \(.value.unstamped)/\(.value.total)"] | join(", ")) + ")" end)' <<<"$stats"
  else
    echo "wants_unstamped: $BENCH_INGEST unreadable"
  fi
}

# release_kpis <now> <projects json> -> {overdue: [{project, version, due_on, by}], drift: [{project, sheet,
# tag}]}, the release link over `notes projects --stats --json` (stages.md, "Versions"). overdue: a project
# with a human target (`target_on`) a day past that date with the targeted version still uncut (a cut moves
# the `Target:` line off the sheet), by "target", whoever owns its version; else a project whose own sheet
# counter owns its version (project_version_owner) still due a day after its cadence due date, so a
# wave-roll pass had all day to cut it, by "cadence"; else a prod-stage app (registry `type`) its tag owns
# still due a day after that date, by "tag": done rows waited out the prod cadence and no tag shipped them,
# which only a release cut fixes (stages.md, "Versions"). A tag at or above the open version is shipped
# with its roll pending, so it is not counted here. Games are left out: they ship on playtest and store
# windows, not the prod cadence (the plan's decision, an overdue prod app). Its `.release.due` already means done rows waited
# out the cadence. drift: a project a vX.Y.Z tag owns whose sheet is neither that tag (the roll is pending) nor
# a next open version above it (git_version_next_ok, what wave-roll may open). A game its parent versions
# (`version_parent`, project_version_owner `parent`) counts in neither: the parent is the one cut. A profile with `automation = false` counts in neither.
release_kpis() {
  local today prof name ver due_on tver ton stage parent shipped owner by ver_due
  today=$(date -d "@$1" +%F)
  jq -r '.[] | select(.automation != false) | [.profile, .name, (.version // "-"), (if .release.due then .release.due_on // "-" else "-" end),
      (.target_version // "-"), (.target_on // "-"), (.stage // "-"), (.version_parent // "")] | join("|")' <<<"$2" |
  while IFS='|' read -r prof name ver due_on tver ton stage parent; do
    shipped=$(project_release_version "$name")
    owner=$(project_version_owner "$name" "$shipped" "$parent")
    if [ "$ton" != - ]; then by=target ver_due=$tver due_on=$ton
    elif [ "$owner" = sheet ]; then by=cadence ver_due=$ver
    elif [ "$owner" = tag ] && [ "$stage" = prod ] && [ "$(project_field "$name" type)" = app ] &&
      { ! project_release_lib || ! git_version_ge "$shipped" "$ver"; }; then by=tag ver_due=$ver
    else by=; fi
    [ -n "$by" ] && [ "$due_on" != - ] && [[ "$due_on" < "$today" ]] &&
      jq -cn --arg p "$prof/$name" --arg v "$ver_due" --arg d "$due_on" --arg by "$by" '{overdue: {project: $p, version: $v, due_on: $d, by: $by}}'
    [ "$owner" = tag ] && [[ "$shipped" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] && [ "$ver" != "$shipped" ] &&
      project_release_lib && ! git_version_next_ok "$shipped" "$ver" &&
      jq -cn --arg p "$prof/$name" --arg v "$ver" --arg s "$shipped" '{drift: {project: $p, sheet: $v, tag: $s}}'
    :   # a project that counts in neither is no failed pass, under pipefail
  done | jq -sc '{overdue: map(.overdue // empty), drift: map(.drift // empty)}'
}

# chain_counts <now> -> one key=value line per KPI_CHAIN entry, ? when its source cannot be read
# Its sections read on their own, so they run at once and print in this order; one read cache
# serves the queue and board reads they share.
chain_counts() {
  [ -n "${BENCH_READ_CACHE:-}" ] || { with_reads chain_counts "$@"; return; }
  local t=$1 PAR PAR_PIDS s
  par_open || return 1
  par_go links chain_links "$t"
  par_go rel chain_release "$t"
  # computed beside the links rather than after them: it is the slowest section, and it is
  # dropped when lead_untrusted holds it at ?
  par_go lead lead_time_json "$t"
  par_go board chain_board "$t"
  par_go local chain_local "$t"
  par_go prio chain_prio
  par_go plans chain_plans
  par_go routes chain_routes
  par_go queue chain_queue "$t"
  par_go reds reds_counts "$t"
  par_go spent reds_spent
  par_go pipeline chain_pipeline "$t"
  par_wait
  cat "$PAR/links" "$PAR/rel"
  if [ -n "$(lead_untrusted "$(cat "$PAR/links")")" ] || [ ! -s "$PAR/lead" ]; then echo "request_to_live_h=?"
  else jq -r '"request_to_live_h=\(.p50 // "-")"' "$PAR/lead"; fi
  for s in board prio local plans routes queue reds spent pipeline; do cat "$PAR/$s"; done
}

# prio_origins -> {<row id>: its filer}, the first added or filed event of each id in the ingest record: its
# origin, else its writer ("human" for a hand write, "session" for a session id). A row a sweep runner filed
# (inbox-triage, inbox-plan) names the runner, which carried the line in: the capture before it is not recorded.
# rc 1 when the record cannot be read.
# prio_defaults -> {total, origins: [{origin, n, ids}]}: the open agent and human rows that carry no
# priority tag or no #why/<reason> (the board feed's untriaged and prio_why), grouped by the writer of the
# row's first added or filed event in the ingest record, most first, ids sampled (PRIO_SAMPLE). An origin
# is the event's origin, else its writer, "human" for a hand write; a row with no event is "unrecorded".
# Nothing and rc 1 when the board feed cannot be read; an unreadable ingest record leaves every origin
# "unrecorded", the count unchanged. Rows of a project with automation off are not counted.
prio_origins() {
  [ -r "$BENCH_INGEST" ] || return 1
  { grep -hE '"action":"(added|filed)"' "$BENCH_INGEST" || :; } | jq -Rnc "$JQ_LIB"'
    reduce (inputs | fromjson? | select((.id // "") != "")) as $e ({};
      if has($e.id) then . else .[$e.id] = ($e | ((.origin | select(. != null and . != "")) // (if human_writer then "human" else .by end))
        | if test("^[0-9a-f]{8}$") then "session" else . end) end)'
}

prio_defaults() {
  local origins
  origins=$(bench_read prio_origins) || origins=null
  bench_read $BENCH_BOARD_CMD 2>/dev/null | jq -ce --argjson o "${origins:-null}" --argjson k "$PRIO_SAMPLE" '
    select(.rows | arrays) | [.rows[] | select(.lane | IN("agent", "human")) | select(.state | IN("open", "doing"))
        | select(.automation != false and (.untriaged == true or .prio_why == null))
        | {id, origin: ((($o // {})[.id // ""]) // "unrecorded")}] as $r
    | {total: ($r | length),
       origins: ($r | group_by(.origin) | map({origin: .[0].origin, n: length, ids: (map(.id // "?") | .[0:$k])}) | sort_by(-.n))}'
}

# chain_links <now> -> the link KPIs read from the queue, the board, the projects and the CI rows
chain_links() {
  local t=$1 since active done board projects ci links
  since=$(date -d "@$((t - (CHAIN_DAYS + 1) * 86400))" +%F)
  active=$(bench_read $BENCH_ITEMS_CMD 2>/dev/null | jq -sc .) || active=null
  done=$(bench_read $BENCH_DONE_ITEMS_CMD --since "$since" 2>/dev/null | jq -sc .) || done=null
  board=$(bench_read $BENCH_BOARD_CMD 2>/dev/null | jq -ce '.rows | arrays') || board=null
  projects=$(bench_read $BENCH_PROJECTS_CMD 2>/dev/null | jq -ce 'arrays') || projects=null
  ci=null; [ -r "$CI" ] && ci=$(ci_claimed | jq -sc --argjson t "$t" --argjson d "$CHAIN_DAYS" --argjson fix "$FIX_SINCE" \
    'map(select(.merged_epoch > ([$t - $d * 86400, $fix] | max) and .merged_epoch <= $t))')
  links=$(jq -rn --argjson t "$t" --argjson days "$CHAIN_DAYS" --slurpfile a <(printf '%s' "$active") --slurpfile d <(printf '%s' "$done") \
     --slurpfile b <(printf '%s' "$board") --slurpfile p <(printf '%s' "$projects") \
     --slurpfile c <(printf '%s' "$ci") "$JQ_LIB"'
    # ? is a source it could not read; - is a share over nothing (an empty window), read but empty
    def n($v): if $v == null then "?" else $v end;
    def share($a; $b): ratio($a; $b) // "-";
    $a[0] as $a | $d[0] as $d | $b[0] as $b | $p[0] as $p | $c[0] as $c
    | (if $a == null or $d == null or $c == null then null
       else (($a + $d) | map(prkeys[]) | INDEX(.)) as $refs
         | {total: ($c | length),
            hit: ($c | map(select($refs[itemkey])) | length)} end) as $cov
    | ($b // [] | map(select(.lane == "agent"))) as $agent
    | ($b // [] | map("\(.project):\(.id)") | INDEX(.)) as $open
    | ($agent | map(select(.automation != false and .type != "epic"))) as $linkable
    | "ledger_coverage=\(n(if $cov == null then null else share($cov.hit; $cov.total) end))",
      "untracked_merged_prs=\(n(if $cov == null then null else $cov.total - $cov.hit end))",
      "board_orphan_started=\(n(if $a == null or $b == null then null else ($a | map(rowkey | strings) | INDEX(.)) as $live
        | $agent | map(select(.state == "doing" and ($live["\(.project):\(.id)"] | not))) | length end))",
      "merged_open_rows=\(n(if $d == null or $b == null then null
        else $d | map(select(.merged and any(rowkey | strings; $open[.] != null))) | length end))",
      "ownerless_running=\(n(if $a == null then null
        else $a | map(ownerless) | length end))",
      "epic_linked_share=\(n(if $b == null or $p == null then null
        else share($linkable | map(select(.tags | any(startswith("of/")))) | length; $linkable | length) end))",
      "landed_unverified=\(n(if $p == null then null else [$p[] | (.epics // [])[] | select(leaves_landed)] | length end))",
      "uncaused_close_share=\(n(if $d == null then null
        else [$d[] | select((.finished // "" | fromdateiso8601? // 0) > $t - $days * 86400)] as $w
          | share($w | map(select(.status == "failed" and ((.end_reason // "") == ""))) | length; $w | length) end))",
      "requested_unstarted_h=\(n(if $b == null then null else [$b | oldest_request($t) | .h] | first // 0 end))",
      "cost_per_merged_item=\(n(if $d == null then null else [$d[] | select(.merged and (.finished // "" | fromdateiso8601? // 0) > $t - $days * 86400)
        | [.cost_usd, .gateway_cost_usd] | map(tonumber? // empty) | select(length > 0) | add]
        | if length == 0 then null else add / length * 100 | round / 100 end end))"')
  [ -n "$links" ] && printf '%s\n' "$links"
}

# chain_release <now> -> release_overdue and version_tag_drift
chain_release() {
  local projects rel
  if projects=$(bench_read $BENCH_PROJECTS_CMD 2>/dev/null | jq -ce 'arrays') && rel=$(release_kpis "$1" "$projects"); then
    jq -r '"release_overdue=\(.overdue | length)", "version_tag_drift=\(.drift | length)"' <<<"$rel"
  else printf '%s=?\n' release_overdue version_tag_drift; fi
}

# chain_board <now> -> the rows the board holds that no step will move (board_links)
chain_board() {
  local t=$1 bl
  if bl=$(board_links "$t"); then
    jq -r '"orphan_request_rows=\(.orphans | if . == null then "?" else length end)",
      "next_up_blocked=\(.blocked | if . == null then "?" else length end)",
      "stale_urgent_d=\(.urgent.days // 0)",
      "urgent_per_board=\(.urgent_boards | map(.n) | max // 0)",
      "playtest_waiting_d=\(.playtest | if . == null then "?" else map(.days) | max // 0 end)",
      "done_inline_old=\(.done_old // "?")"' <<<"$bl"
  else printf '%s=?\n' orphan_request_rows next_up_blocked stale_urgent_d urgent_per_board playtest_waiting_d done_inline_old; fi
}

# chain_prio -> prio_default, ? when the board cannot be read
chain_prio() {
  local pd
  if pd=$(prio_defaults) && [ -n "$pd" ]; then jq -r '"prio_default=\(.total)"' <<<"$pd"; else echo "prio_default=?"; fi
}

# chain_local <now> -> doctor_fail, estimated_token_share and dup_pairs, read from local files
chain_local() {
  local t=$1 dups
  if [ -r "$BENCH_DOCTOR_LAST" ]; then echo "doctor_fail=$(grep -c '^FAIL' "$BENCH_DOCTOR_LAST")"; else echo "doctor_fail=?"; fi
  # older than four tries is an estimator that stopped, not today's share
  echo "estimated_token_share=$(jq -r --argjson oldest "$((t - BENCH_FLEET_COST_EVERY_MIN * 240))" 'if (.as_of_epoch // 0) < $oldest then "?" else .coverage.estimated_token_share // "?" end' "$BENCH_FLEET_COST_FILE" 2>/dev/null || echo '?')"
  # the newest night only: a runner that stopped must read ?, never an older night's count as now
  dups=$(ls -d "$BENCH_DOCS_CLEANUP_DIR"/*/ 2>/dev/null | tail -1)
  if [ -n "$dups" ] && dups=$(jq -er '.pairs | numbers' "${dups}dups.json" 2>/dev/null); then echo "dup_pairs=$dups"; else echo "dup_pairs=?"; fi
}

# chain_plans -> plans_unqueued
chain_plans() {
  local orphans
  if orphans=$(plans_orphaned); then echo "plans_unqueued=$(grep -c . <<<"$orphans")"; else echo "plans_unqueued=?"; fi
}

# chain_routes -> routes_unresolved
chain_routes() { echo "routes_unresolved=$(triage_coverage | grep -c .)"; }

# chain_queue <now> -> wants_unstamped and admission_held
chain_queue() {
  local t=$1 wants held
  if wants=$(wants_stats "$t"); then jq -r '"wants_unstamped=\(if .total == 0 then 0 else (.unstamped / .total * 1000 | round) / 1000 end)"' <<<"$wants"; else echo "wants_unstamped=?"; fi
  held=$(bench_read $BENCH_ADMISSION_CMD 2>/dev/null | jq -er '.held_7d | numbers' 2>/dev/null) || held='?'
  echo "admission_held=$held"
}

# chain_pipeline <now> -> chain_drift, chain_inbox_drift, each step's step_age_p90 and queue_net_24h (pipeline_json)
chain_pipeline() {
  pipeline_json "$1" | jq -r 'def n: if . == null then "?" else . end;
    "chain_drift=\(.drift | n)",
    "chain_inbox_drift=\(.inbox_drift | n)",
    (.steps[] | select(.step | IN("backlog", "queued", "running", "review", "waiting")) | "step_age_p90_\(.step)=\(.age_p90_min | n)"),
    (.steps[] | select(.step == "queued") | "queue_net_24h=\(if .in_24h == null or .out_24h == null then "?" else .in_24h - .out_24h end)")'
}

# The work chain's steps, in order: an untriaged line, an open agent-board row, a row held out of
# the queue (admission), a queue item queued, the start dispatch makes (dispatch), running, on its PR
# (review) or waiting on the human, and done.
PIPELINE_STEPS="inbox backlog admission queued dispatch running review waiting done"

# inbox_lines -> the lines that wait untriaged, one JSON array of their texts: the outbox plus every
# project's `## Inbox`. pipeline_json counts them and ages each from the intake record.
inbox_lines() {
  local out p
  out=$($BENCH_NOTES_CMD outbox list) || return 1
  for p in $(bench_read $BENCH_PROJECTS_CMD | jq -r '.[].name'); do
    $BENCH_NOTES_CMD ptask "$p" inbox --json 2>/dev/null || :
  done | jq -sc --arg out "$out" '($out | split("\n") | map(sub("^[^\t]*\t"; "") | select(. != ""))) + [.[][] | .text // empty]'
}

# ingest_flow <now> -> {doors, out} over the 24h of the notes ingest record before <now>; fails when
# the record cannot be read. doors: one {door, rows, lines} per writer (door: human, a runner by its
# conf NAME in LEDGER_CONF_DIR, else session), most first. rows are the rows it put on a board (an
# added row, or an inbox line it filed); lines are what it put in an inbox, which triage later files
# under its own door. out: {merged, done, dup, moved, dropped}, each event counted by out_kind.
ingest_flow() {
  local runners c n
  [ -r "$BENCH_INGEST" ] || return 1
  # every conf, a hand-fired or switched-off one too: it may have written in the window; named as scheduled_runner names it
  runners=$(for c in "$LEDGER_CONF_DIR"/*.conf; do
      [ -e "$c" ] || continue
      n=$(sed -n '/^NAME=/{s///p;q;}' "$c"); printf '%s\n' "${n:-$(basename "$c" .conf)}"
    done \
    | jq -Rnc '[inputs | {key: ., value: true}] | from_entries')
  # the date prefix is a cheap first cut, two days back so no time zone loses an event; the epoch decides
  jq -Rnc --argjson t "$1" --arg day "$(date -d "@$(($1 - 172800))" +%F)" --argjson runners "$runners" "$JQ_LIB"'
    [inputs | fromjson? | objects | select((.ts | type) == "string" and .ts[0:10] >= $day)
     | select((.ts | sub("\\.[0-9]+"; "") | try iso_epoch catch 0) as $e | $e > $t - 86400 and $e <= $t)] as $ev
    | {doors: ([$ev[] | select(.action | IN("added", "filed")) | {door: door($runners), line: (.action == "added" and .stage == "intake")}]
               | group_by(.door) | map({door: .[0].door, rows: map(select(.line | not)) | length, lines: map(select(.line)) | length})
               | sort_by([-(.rows + .lines), .door])),
       out: (reduce ($ev[] | out_kind) as $k ({merged: 0, done: 0, dup: 0, moved: 0, dropped: 0}; .[$k] += 1))}' "$BENCH_INGEST"
}

# pipeline_json <now> -> where every item sits and how each step scores: {since, drift, inbox_drift, doors_24h,
# out_24h, bottleneck, headline, steps}, one step object each in PIPELINE_STEPS order. WIP and the age of what sits in a
# step (p50, p90, oldest, minutes) come from the state files: the inbox lines (aged from the intake
# record's first event of the same text; a line it never saw counts in WIP, not in the age), the rows
# on the active profile's agent boards (on_board, the rows board_open counts) no active item has
# started (aged from the day they were filed), the queue items by
# state (aged from ready, started, waiting; a held queued item has no ready, so it counts in WIP but
# not in the age: agent-queue's one rule), and the items finished in the last 24h. In, out and dwell
# come from the record (`notes log --steps`), which cannot see work older than its start (since).
# drift counts the queue items the record and the queue folders place apart: at another step, held
# by the record but gone from the queue, or queued after the record began with no event of it. A fleet
# worker's closes reach the record through fleet-dispatch's worker_records, so a gap that stays is an
# event no writer sent. inbox_drift sets the lines the record holds in the inbox step (`notes log
# --steps` open) against the lines the outbox and every `## Inbox` hold here (the inbox WIP), apart
# either way: more in the record is a line that left with no event, or one a worker's session wrote
# to that worker's own outbox (its add event is imported, the line arrives only by its notes sync),
# fewer is a line the record never saw added. Null when either cannot be read.
#
# Each step also carries score (its measure over its bound), verdict (stopped, over at 1 or more,
# near at 0.8 or more, ok; "-" with no bound or no measure, never ok), why (the top 3 reasons as
# {reason, n}, counted from the step's own record) and clears (what ends a stop, in the words of the
# gate that holds; dispatch only). The measure is the age p90 against step_age_p90_<step>_max in
# kpi-thresholds (an empty step measures 0), for admission the items the queue cap held in 24h (agent-queue admission --json day)
# against admission_held_24h_max, and for dispatch the minutes the runner's hold has stood
# (`fleet-dispatch stopped`, which reads the live hold; none is 0) against DISPATCH_STARVED_MIN. Dispatch is stopped when
# `fleet-dispatch stopped` says so: any start, a floor one too, ends the hold (agent-proof.sh, ar-4387). headline names the worst step, stopped first,
# then the largest score past 1, in one sentence; null while none is. The bottleneck is the step
# whose age p90 is furthest past its bound, null while every step is inside it. A source that cannot
# be read leaves its numbers null. doors_24h and out_24h are ingest_flow's doors and out. Why each stage reads its record: plan can-we-update-our-gleaming-axolotl.
pipeline_json() {
  local t=$1 items fin board rec inbox stop hr ing adm acts verdicts lim='{}' ev=null prof=''
  stop=$({ $BENCH_STOPPED_CMD 2>/dev/null || :; } | jq -ce 'objects' 2>/dev/null) || stop=null
  items=$(bench_read $BENCH_ITEMS_CMD 2>/dev/null | jq -sc .) || items=null
  fin=$(bench_read $BENCH_DONE_ITEMS_CMD --since "$(date -d "@$((t - 86400))" +%F)" 2>/dev/null | jq -sc .) || fin=null
  board=$(bench_read $BENCH_BOARD_CMD 2>/dev/null | jq -ce '.rows | arrays') || board=null
  rec=$($BENCH_STEPS_CMD 2>/dev/null | jq -ce 'select(.steps | arrays)') || rec=null
  inbox=$($BENCH_INBOX_CMD 2>/dev/null | jq -ce 'arrays') || inbox=null
  verdicts=$(bench_read $BENCH_VERDICTS_CMD 2>/dev/null | jq -sc .) || verdicts=null
  adm=$(bench_read $BENCH_ADMISSION_CMD 2>/dev/null | jq -ce '.day | objects') || adm=null
  # A headroom.json older than a pass's 45 minutes is no answer (hub_core::capacity::headroom).
  hr=null; [ -n "$(find "$BENCH_HEADROOM" -mmin -45 2>/dev/null)" ] && { hr=$(jq -ce 'objects' "$BENCH_HEADROOM" 2>/dev/null) || hr=null; }
  # Reads of the records that already exist: the intake and land-failed events and the dispatch
  # passes; each is cut to its window in the jq below.
  ing=null; [ -r "$BENCH_INGEST" ] && ing=$({ grep -hE '"action":"(added|filed|moved|dup|dropped|refused|left|sweep-stopped|land-failed)"' "$BENCH_INGEST" || :; } \
    | jq -sc 'map(select(.stage == "intake" or .action == "land-failed") | {ts, action, text, why})')
  acts=null; [ -r "$BENCH_DISPATCH_LOG" ] && acts=$(tail -n "$BENCH_RECORD_TAIL" "$BENCH_DISPATCH_LOG" \
    | jq -Rnc '[inputs | capture("^\\[(?<ts>[^]]+)\\] outcome=(?<o>[A-Z]+) ?(?<rest>.*)$")]')
  [ -r "$KPI_THRESHOLDS" ] && lim=$(grep -E '^[a-z0-9_]+=' "$KPI_THRESHOLDS" | kv_json)
  bench_profile && prof=$BENCH_PROFILE
  ev=$(ingest_flow "$t") || ev=null
  jq -cn --argjson t "$t" --arg steps "$PIPELINE_STEPS" --argjson lim "$lim" --argjson stop "${stop:-null}" --argjson hr "${hr:-null}" \
     --arg prof "$prof" --argjson ev "$ev" \
     --slurpfile a <(printf '%s' "$items") --slurpfile d <(printf '%s' "$fin") --slurpfile i <(printf '%s' "$inbox") \
     --slurpfile b <(printf '%s' "$board") --slurpfile r <(printf '%s' "$rec") --slurpfile v <(printf '%s' "${verdicts:-null}") \
     --slurpfile g <(printf '%s' "${ing:-null}") --slurpfile q <(printf '%s' "${adm:-null}") --slurpfile p <(printf '%s' "${acts:-null}") "$JQ_LIB"'
    def epoch: strings | sub("\\.[0-9]+"; "") | try iso_epoch catch empty;   # Z or a local offset
    def mins: ($t - .) / 60 | floor;
    def pct($p): sort | if length == 0 then null else .[([length * $p / 100 | ceil, 1] | max) - 1] end;
    def top: group_by(.reason) | map({reason: .[0].reason, n: (map(.n) | add)}) | sort_by(-.n, .reason) | .[:3];
    def tally: map({reason: ., n: 1}) | top;
    def mdur: floor | if . >= 1440 then "\(. / 1440 | floor)d\(. % 1440 / 60 | floor)h"
      elif . >= 60 then "\(. / 60 | floor)h\(. % 60 | if . < 10 then "0\(.)" else tostring end)m" else "\(.)m" end;
    # A dispatch pass in a few words: its outcome, past the pass notes ahead of the gate.
    def pass_why: .o as $o | .rest | sub("^why: "; "")
      | gsub("(tagged [0-9]+ for a plan|could not judge the new rows( \\([^)]*\\))?); "; "") as $r
      | if $o == "WORKED" then "started"
        elif $o == "FAILED" and ($r | test("could not start")) then "a start failed"
        elif $r | test("pace target is") then "at the pace target"
        elif $r | test("^held \\(agent-hold") then "held by agent-hold"
        elif $r | test("human is not away") then "the human is here"
        else $r | sub("^queue item [^ ]+ waits: "; "") | split(";")[0] | split(":")[0] | gsub(" \\([^)]*\\)"; "") | gsub("[0-9]+"; "N") | .[0:60] end;
    $a[0] as $a | $d[0] as $d | $b[0] as $b | $r[0] as $r | $i[0] as $i | $v[0] as $v
    | ($g[0] | if . == null then null else map(. + {e: (.ts | epoch)}) end) as $g
    | $q[0] as $q
    | ($p[0] | if . == null then null else map(. + {e: (.ts | epoch)} | select(.e > $t - 86400)) end) as $p
    | def held($s; $f): if $a == null then null else $a | map(select(.state == $s)) | {n: length, ages: map(.[$f] | epoch | mins)} end;
    ($a // [] | map(rowkey | strings) | INDEX(.)) as $live
    | ($b // [] | map(select(on_board($prof) and ($live["\(.project):\(.id)"] | not)))) as $open
    | $stop.since as $since
    | (if $since != null then ($t - $since) / 60 | floor elif $hr != null then 0 else null end) as $held_min
    | {inbox: (if $i == null then null
               else ($g // [] | map(select((.action | IN("added", "filed", "moved")) and (.text | type) == "string")) | group_by(.text) | map({key: .[0].text, value: (map(.e) | min)}) | from_entries) as $first
                 | {n: ($i | length), ages: [$i[] | $first[.] | numbers | mins],
                    why: (if $g == null then null else [$g[] | select(.e > $t - 86400 and (.action | IN("dup", "dropped", "refused", "left", "sweep-stopped"))) | .action] | tally end)} end),
       backlog: (if $b == null or $a == null or $prof == "" then null
                 else ($v // [] | map(select(.lane == "agent")) | map({key: "\(.project):\(.key)", value: .}) | from_entries) as $vk
                   | $open | {n: length, ages: map((.since // "") + "T00:00:00Z" | epoch | mins),
                       why: (if $v == null then null else map($vk["\(.project):\(.id)"] | if . then "\(.verdict): \(.rule)" else "no verdict yet" end) | tally end)} end),
       admission: (if $q == null then null else {n: $q.held, ages: [], why: ($q.why | to_entries | map({reason: .key, n: .value}) | top)} end),
       queued: (held("queued"; "ready") | if . == null then . else . + {why: ($a | map(select(.state == "queued")
                  | .hold // "" | if . == "" then "runnable" else capture("^(hold:)?(?<k>[^ :(]+)").k // "held" end) | tally)} end),
       dispatch: (if $hr == null then null
                  else {n: $hr.runnable, ages: [],
                        why: (if $p == null then null else ($p | map(select(.e > $t - 3600) | pass_why))
                              | if length == 0 then [{reason: "no pass in the last hour", n: 0}] else tally end end)} end),
       running: (held("running"; "started") | if . == null or $d == null then . else . + {why: ($d | map(select((.finished | epoch) > $t - 86400) | .end_reason | strings) | tally)} end),
       review: (held("review"; "review") | if . == null or $g == null then . else . + {why: ([$g[] | select(.e > $t - 86400 and .action == "land-failed")
                  | "land failed, " + (.why // "" | split(" (")[0] | gsub("[0-9]+"; "N") | .[0:60])] | tally)} end),
       waiting: held("waiting"; "waiting"),
       done: (if $d == null then null else {n: ($d | map(select((.finished | epoch) > $t - 86400)) | length), ages: []} end)} as $now
    | ($r.steps // [] | INDEX(.step)) as $flow
    | [$steps | split(" ")[] | . as $s | $now[$s] as $w | ($flow[$s] // {}) as $f
       | (($lim["step_age_p90_\($s)_max"] | numbers) // null) as $bound | ($w.ages // [] | pct(90)) as $p90
       | (if $s == "admission" then {m: $w.n, b: (($lim.admission_held_24h_max | numbers) // null)}
          elif $s == "dispatch" then {m: $held_min, b: $hr.starved_min}
          else {m: ($p90 // (if $w.n == 0 then 0 else null end)), b: $bound} end) as $mb
       | (if $mb.m == null or $mb.b == null or $mb.b <= 0 then null else $mb.m / $mb.b * 100 | round / 100 end) as $score
       | {step: $s, wip: $w.n, age_p50_min: ($w.ages // [] | pct(50)), age_p90_min: $p90, oldest_min: ($w.ages // [] | max),
          in_1h: $f.in_1h, out_1h: $f.out_1h, in_24h: $f.in_24h, out_24h: $f.out_24h,
          dwell_p50_min: $f.dwell_p50_min, dwell_p90_min: $f.dwell_p90_min, bound: $bound,
          ratio: (if $bound == null or $bound <= 0 or $p90 == null then null else $p90 / $bound * 100 | round / 100 end),
          measure: $mb.m, measure_bound: $mb.b, score: $score,
          verdict: (if $s == "dispatch" and $stop != null then "stopped" elif $score == null then "-"
                    elif $score >= 1 then "over" elif $score >= 0.8 then "near" else "ok" end),
          why: $w.why, clears: (if $s == "dispatch" then $stop.clears else null end),
          problems_n: $f.problems_n, problems: ($f.problems // []),
          blocked: (if $s == "queued" and $stop != null then $stop.line else null end)}
       + (if $s == "dispatch" then {held: ($stop.why // $hr.held), held_kind: $hr.held_kind} else {} end)] as $rows
    | (if $a == null or $r == null then null
       else ($r.steps | map(.step as $s | (.items // [])[] | {key: ., value: $s}) | from_entries) as $rec
         | ($a | map({key: .slug, value: .state}) | from_entries) as $st
         | ([$a[] | select(if $rec[.slug] then $rec[.slug] != .state else (.queued // "") >= ($r.items_since // "~") end)] | length)
           + ([$rec | keys[] | select($st[.] == null)] | length) end) as $drift
    | ([$r.steps[]? | select(.step == "inbox") | .open | numbers] | first) as $inbox_open
    | (if $inbox_open == null or $i == null then null else $inbox_open - ($i | length) | fabs end) as $inbox_drift
    | ([$rows[] | select(.verdict == "stopped")] + ([$rows[] | select(.verdict == "over")] | sort_by(-.score)) | first) as $worst
    | {as_of: $t, since: $r.since, items_since: $r.items_since, drift: $drift, inbox_drift: $inbox_drift,
       doors_24h: $ev.doors, out_24h: $ev.out,
       bottleneck: ($rows | map(select((.ratio // 0) > 1)) | max_by(.ratio) | if . then {step, age_p90_min, bound, ratio} else null end),
       headline: ($worst | if . == null then null else
         (if .score == null then "" elif .step == "admission" then " (\(.score * 100 | round)% of \(.measure_bound))"
          else " (\(.score * 100 | round)% of \(.measure_bound | mdur))" end) as $of
         | (if .step == "dispatch" then (if .measure == null then "stopped"
                                         elif .verdict == "stopped" then "stopped \(.measure | mdur)"
                                         else "held \(.measure | mdur)" end) + $of
            elif .step == "admission" then "\(.measure) rows held in 24h\($of)"
            else "age p90 \(.measure | mdur)\($of)" end) as $m
         | ((if .step == "dispatch" then .held else null end) // (.why // [] | first | if . then "\(.reason) (\(.n))" else null end)) as $y
         | {step, verdict, score, text: "\(.step), \($m)\(if $y then ": \($y)" else "" end).\(if .clears then " \(.clears)." else "" end)"} end),
       steps: $rows}'
}

# pipeline_check <cap|age|mix|held|owner|chain-lag> -- one line and exit 1 when the queue's flow is off: runnable items over
# the admission cap (the adds it exempts, urgent, red, board pulls and plans, can
# carry it past), the queued step's age p90 past its bound (an empty step passes), or, while the mix
# is on, a class of service starved (agent-queue mix; off, nothing balances the classes), or a queued item with a pending gate (hold_for, past a desk turn),
# which belongs on its board row (QUEUE.md "Admission"), or an urgent or high chain whose handoff p90 over 24h is past chain_handoff_p90_max, or an active item no session owns (ownerless, the
# ownerless_running KPI, which reap flags). Exit 2 when
# its source cannot be read. cap, age, mix and owner are each one Sentinel watch (queue-over-cap, queue-age, queue-class-starved, queue-ownerless, chain-lag,
# in ~/.agent/watches), so one that stays red masks no other.
pipeline_check() {
  local out
  case "$1" in
    cap) out=$($BENCH_ADMISSION_CMD 2>/dev/null | jq -er 'select(.runnable | numbers)
           | if .on and .runnable > .limit then "runnable \(.runnable) is over the cap of \(.limit)" else "" end') ;;
    age) out=$(pipeline_json "$(now)" | jq -er '.steps[] | select(.step == "queued")
           | if (.age_p90_min | type) == "number" and (.bound | type) == "number" and .age_p90_min > .bound
             then "queued age p90 \(.age_p90_min)m is past its bound of \(.bound)m" else "" end') ;;
    mix) out=$($BENCH_MIX_CMD 2>/dev/null | jq -er 'select(.starved | arrays) | .starve_days as $d | .on as $on
           | .starved | if length > 0 and $on then "starved: \(join(", ")) (runnable, none started in \($d)d)" else "" end') ;;
    held) out=$(bench_read $BENCH_ITEMS_CMD 2>/dev/null) && out=$(jq -sr '[.[] | select(.state == "queued" and (.hold // "") != ""
           and (.hold | test("^hold:[^ ]+ \\((behind |desk:auth waits)") | not)) | "\(.slug) (\(.hold))"]
           | if length == 0 then "" else "\(length) queued with a pending gate, which belongs on its board row: \(.[:5] | join(", "))" end' <<<"$out") ;;
    owner) out=$(bench_read $BENCH_ITEMS_CMD 2>/dev/null) && out=$(jq -sr "$JQ_LIB"'[.[] | ownerless | "\(.slug) (\(.state))"]
           | if length == 0 then "" else "\(length) running, review or waiting with no session: \(.[:5] | join(", "))" end' <<<"$out") ;;
    chain-lag) local lim='{}'; [ -r "$KPI_THRESHOLDS" ] && lim=$(grep -E '^[a-z0-9_]+=' "$KPI_THRESHOLDS" | kv_json)
      out=$($BENCH_QUEUE_STATS_CMD --since "$(date -d "@$(($(now) - 86400))" +%F)" 2>/dev/null | jq -er --argjson lim "$lim" '
        select(.chain.h24 | objects) | (($lim.chain_handoff_p90_max | numbers) // 60) as $b
        | [.chain.h24 | to_entries[] | select(.key == "urgent" or .key == "high") | select(.value.p90 > $b)
           | "\(.key) p90 \(.value.p90)m over \(.value.n) handoffs"]
        | if length == 0 then "" else "chain handoff over 24h is past its bound of \($b)m: \(join(", "))" end') ;;
    *) say "usage: fleet-bench pipeline --check cap|age|mix|held|owner|chain-lag"; return 2 ;;
  esac || { say "pipeline --check $1: its source cannot be read"; return 2; }
  [ -z "$out" ] || { printf '%s\n' "$out"; return 1; }
}

# pipeline [--json | --check cap|age|mix|held|owner|chain-lag] -- pipeline_json with the admission cap and the class mix
# (agent-queue mix), or a table of it with the bottleneck, the steps taking in more than they let out
# over 24h, the drift, the doors and the out line, the cap and each class's starts against its share;
# --check is pipeline_check.
cmd_pipeline() {
  local json adm mix
  case "${1:-}" in
    ""|--json) ;;
    --check) pipeline_check "${2:-}"; return ;;
    *) say "usage: fleet-bench pipeline [--json | --check cap|age|mix|held|owner|chain-lag]"; return 2 ;;
  esac
  json=$(pipeline_json "$(now)") || return 1
  adm=$(bench_read $BENCH_ADMISSION_CMD 2>/dev/null | jq -ce 'objects') || adm=null
  mix=$($BENCH_MIX_CMD 2>/dev/null | jq -ce 'objects') || mix=null
  json=$(jq -c --argjson a "$adm" --argjson m "$mix" '. + {admission: $a, mix: $m}' <<<"$json")
  [ "${1:-}" = --json ] && { printf '%s\n' "$json"; return 0; }
  jq -r 'def m: if . == null then "-" elif . >= 1440 then "\(. / 144 | round / 10)d" elif . >= 60 then "\(. / 6 | round / 10)h" else "\(.)m" end;
    def c: if . == null then "-" else tostring end;
    "step       wip   age p50   p90  oldest   in/out 1h  in/out 24h  dwell p50   p90   bound",
    (.steps[] | "\(.step | . + "         " | .[0:8]) \(.wip | c | " " * (5 - length) + .) \(.age_p50_min | m | " " * (9 - length) + .) \(.age_p90_min | m | " " * (5 - length) + .) \(.oldest_min | m | " " * (7 - length) + .) \("\(.in_1h | c)/\(.out_1h | c)" | " " * (11 - length) + .) \("\(.in_24h | c)/\(.out_24h | c)" | " " * (11 - length) + .) \(.dwell_p50_min | m | " " * (10 - length) + .) \(.dwell_p90_min | m | " " * (5 - length) + .) \(.bound | m | " " * (7 - length) + .)"),
    "",
    (.bottleneck | if . then "bottleneck: \(.step), age p90 \(.age_p90_min | m) against a bound of \(.bound | m) (\(.ratio)x)"
                   else "bottleneck: none, every step with a bound is inside it" end),
    (.headline | if . then "headline: \(.text)" else "headline: none, no step is stopped or past its bound" end),
    "score: \([.steps[] | if .verdict == "-" then "\(.step) -" else "\(.step) \(if .score == null then "" else "\(.score * 100 | round)% " end)\(.verdict)" end] | join(", "))",
    (.steps[] | select(.blocked) | "blocked at \(.step): \(.blocked)"),
    ([.steps[] | select(.in_24h != null and .step != "done" and .in_24h > .out_24h) | "\(.step) +\(.in_24h - .out_24h)"]
      | if length > 0 then "growing over 24h: \(join(", "))" else empty end),
    ([.steps[] | select((.problems_n // 0) > 0) | "\(.step) \(.problems_n)"]
      | if length > 0 then "problems over 24h: \(join(", "))" else empty end),
    "drift: \(.drift | c) queue items the record and the queue folders place apart (it sees queue items from \(.items_since // "-"))",
    (.doors_24h | if . == null then "doors 24h: the ingest record is unreadable"
      elif length == 0 then "doors 24h: nothing filed"
      else "doors 24h (rows filed, + inbox lines): \(map("\(.door) \(.rows)\(if .lines > 0 then " +\(.lines)" else "" end)") | join(", "))" end),
    (.out_24h | if . == null then empty
      else "out 24h: merged \(.merged), done \(.done), dup \(.dup), moved \(.moved), dropped \(.dropped)" end),
    (.admission | if . == null then "cap: unreadable" elif .on | not then "cap: off, \(.runnable) runnable"
      else "cap: \(.runnable) runnable against a cap of \(.limit)\(if .runnable > .limit then ", over by \(.runnable - .limit)" else "" end)" end),
    (.mix | if . == null then "mix: unreadable"
      else "mix (\(if .on then "on" else "off" end)), started in \(.window_days)d against share: \([.classes[] | "\(.name) \(.started) (\(.pct // 0)% of \(.share)%)"] | join(", "))",
        "starved: \(if (.starved | length) > 0 then "\(.starved | join(", ")), runnable and none started in \(.starve_days)d" else "none" end)" end)' <<<"$json"
}

# The open PRs the fleet authored, one GraphQL search (paginated, 100 a page) per call: the last
# commit's check rollup and GitHub's mergeable verdict ride along, so a check costs one request,
# not one per PR. Search leaves mergeable UNKNOWN until GitHub computes it; UNKNOWN never trips.
# Scope: GitHub PRs authored by the login gh runs as (every fleet session's), plus every open PR of
# the Forgejo repos `schedules-sync repos` lists (gh sees none of them: home-config's 20 open PRs, 11 of
# them Renovate's, sat unread, ar-4470).
: "${BENCH_PRS_QUERY:=is:pr is:open author:@me archived:false}"
: "${BENCH_PRS_CMD:=prs_all}"   # prints one JSON object per open PR (prs_search's shape)
: "${BENCH_BRANCHES_CMD:=prs_branches}"   # prints one JSON object per pushed branch (prs_branches' shape)
PRS_GRAPHQL='query($q: String!, $endCursor: String) {
  search(query: $q, type: ISSUE, first: 100, after: $endCursor) {
    pageInfo { hasNextPage endCursor }
    nodes { ... on PullRequest { number title isDraft createdAt updatedAt mergeable url headRefName
      repository { nameWithOwner } commits(last: 1) { nodes { commit { committedDate statusCheckRollup { state } } } } } }
  }
}'

# prs_search -> one {ref, branch, title, draft, created, updated, commit, mergeable, checks, url} per
# open PR; commit is the last commit's date, which idle is measured from (updated moves on a comment, a
# label or CI churn); checks is the rollup state (SUCCESS, FAILURE, ERROR, PENDING, EXPECTED) or NONE
prs_search() {
  timeout 60 gh api graphql --paginate -F q="$BENCH_PRS_QUERY" -f query="$PRS_GRAPHQL" \
    --jq '.data.search.nodes[] | select(.number) | {ref: "\(.repository.nameWithOwner)#\(.number)", branch: .headRefName, title, draft: .isDraft,
      created: .createdAt, updated: .updatedAt, commit: .commits.nodes[0].commit.committedDate, mergeable, url,
      checks: (.commits.nodes[0].commit.statusCheckRollup.state // "NONE")}'
}

# prs_forgejo -> prs_search's shape for every open PR of each Forgejo repo in the repo list, read from
# the PR store (`schedules-sync prs`, the one reader of it). The store holds no commit date and no
# mergeable verdict: commit is the PR's last update, so on Forgejo a comment or label does reset idle,
# and mergeable is UNKNOWN, which never trips. Only the PRs the repo owner's login authored count, as
# author:@me limits the GitHub side: a bot's (Renovate) are not the fleet's to land. A repo whose store cannot be read fails the whole read: nothing is left silently out.
prs_forgejo() {
  local repos r
  repos=$("$SCHEDULES_SYNC" repos 2>/dev/null | jq -r '.[] | select(.forge == "forgejo") | "\(.host)/\(.repo)"') || return 1
  while IFS= read -r r; do
    [ -n "$r" ] || continue
    "$SCHEDULES_SYNC" prs "$r" --state open --checks | jq -c --arg r "${r#*/}" '($r | split("/")[0]) as $o | .[] | select(.author == $o) | {ref: "\($r)#\(.number)", branch, title, draft,
      created: .created_at, updated: .updated_at, commit: .updated_at, mergeable: "UNKNOWN", url,
      checks: ({NONE: "NONE", PENDING: "PENDING", FAIL: "FAILURE", PASS: "SUCCESS"}[.ci // "NONE"] // "NONE")}' || return 1
  done <<<"$repos"
}

# prs_all -> every open PR, GitHub's then Forgejo's
prs_all() { prs_search && prs_forgejo; }

# prs_branches -> one {repo, branch, sha, commit, kind} per branch pushed to origin that no open PR
# names and whose work has not landed, from each project-map checkout's remote refs as last fetched
# (no fetch here: a check that waits on the network is its own outage). Landed: merged into the trunk,
# or the head of a merged PR in the PR store (a squash merge leaves the commits unmerged). kind is
# salvage for a salvage/* branch, else pushed. A repo the PR store does not sync is skipped: without
# its PRs every branch would read unowned.
prs_branches() {
  local dir repo key base seen=' ' prs repos
  repos=$("$SCHEDULES_SYNC" repos 2>/dev/null) || return 1
  while IFS= read -r dir; do
    [ -e "$dir/.git" ] || continue
    repo=$(origin_repo "$dir") || continue
    case "$seen" in *" $repo "*) continue ;; esac
    seen+="$repo "
    base=$(merge_proof_ref "$dir") || continue
    # The store names a Forgejo repo host/owner/repo, a GitHub one owner/repo.
    key=$(jq -r --arg r "$repo" 'first(.[] | select(.forge == "forgejo" and .repo == $r) | "\(.host)/\(.repo)") // $r' <<<"$repos") || continue
    prs=$("$SCHEDULES_SYNC" prs "$key" --state all 2>/dev/null) || continue
    # One jq over the whole branch list: a clone holds thousands of branches, a process each is minutes.
    # commit is UTC with a Z (jq's date parser takes no offset). Owned: an open PR names the branch, or a
    # merged PR's head is this very commit.
    git -C "$dir" for-each-ref --no-merged "$base" --format='%(refname:lstrip=3)%09%(objectname)%09%(committerdate:unix)' refs/remotes/origin |
      jq -Rnc --arg r "$repo" --arg base "${base#*/}" --slurpfile prs <(printf '%s' "$prs") '
        ($prs[0] | {open: (map(select(.state == "OPEN") | {key: .branch, value: 1}) | from_entries),
                    merged: (map(select(.state == "MERGED") | {key: "\(.branch) \(.head_sha)", value: 1}) | from_entries) }) as $p
        | inputs | split("\t") | {b: .[0], sha: .[1], t: (.[2] | tonumber)}
        | select(.b != $base and .b != "HEAD" and ($p.open[.b] | not) and ($p.merged["\(.b) \(.sha)"] | not))
        | {repo: $r, branch: .b, sha: .sha, commit: (.t | todate), kind: (if .b | startswith("salvage/") then "salvage" else "pushed" end)}'
  done < <(jq -r '.paths | keys[]' "$BENCH_PROJECT_MAP" 2>/dev/null)
}

# prs_json <now> -> {as_of, bounds, prs, branches}: each open PR with idle_h (since its last commit,
# else its last update: a comment, a label or CI churn never resets it), its owner (the live queue item
# naming it in pr: or open_pr:, where agent-land records a PR until it merges; of several, the one
# furthest along: running, queued, waiting), and its class, at most one each: stranded (no running,
# waiting or queued item owns it, so nobody will land it; a review item's session has ended, so review
# counts as no owner) once idle past pr_idle_h_max; else blocked once idle past pr_blocked_h_max: checks
# still pending (CI that never started or hung, whoever owns it), or red checks or a conflict with no
# running or queued item on it (a running one's stall is the shepherd's, a queued one is the fix waiting
# its turn); else aged: a draft, or a PR opened before the last pr_window_d days, that no running or
# queued item works (a backlog the human decides on, not a fresh stall, but never unlisted); else none.
# branches: pushed branches no open PR names and no merged PR landed (prs_branches), idle past
# pr_idle_h_max, each one to land, open a PR for or delete.
prs_json() {
  local t=$1 prs items branches lim='{}'
  prs=$($BENCH_PRS_CMD | jq -sc .) || return 1
  branches=$($BENCH_BRANCHES_CMD | jq -sc .) || return 1
  items=$(bench_read $BENCH_ITEMS_CMD 2>/dev/null | jq -sc 'map(select(.pr or .open_pr) | {slug, state, refs: "\(.pr // "") \(.open_pr // "")"})') || return 1
  [ -r "$KPI_THRESHOLDS" ] && lim=$(grep -E '^[a-z0-9_]+=' "$KPI_THRESHOLDS" | kv_json)
  jq -cn --argjson t "$t" --slurpfile p <(printf '%s' "$prs") --slurpfile i <(printf '%s' "$items") --slurpfile br <(printf '%s' "$branches") --argjson lim "$lim" '
    def epoch: sub("\\.[0-9]+"; "") | fromdateiso8601;
    $p[0] as $prs | $i[0] as $items
    | {idle_h: ($lim.pr_idle_h_max // 24), blocked_h: ($lim.pr_blocked_h_max // 4), window_d: ($lim.pr_window_d // 30)} as $b
    | ([$items[] | . as $i | .refs | splits("[ ,]+") | select(length > 0) | {ref: ., slug: $i.slug, state: $i.state}]
       | group_by(.ref) | map({key: .[0].ref, value: (min_by(.state | {running: 0, queued: 1, waiting: 2}[.] // 3) | {slug, state})})
       | from_entries) as $own
    | {as_of: $t, bounds: $b,
       prs: [$prs[] | . + {idle_h: (($t - ((.commit // .updated) | epoch)) / 3600 | floor), owner: $own[.ref]}
         | ((.owner.state // "review") | IN("running", "waiting", "queued") | not) as $orphan
         | ((.owner.state // "") | IN("running", "queued")) as $worked
         | ((.checks | IN("PENDING", "EXPECTED")) or ($worked | not) and ((.checks | IN("FAILURE", "ERROR")) or .mergeable == "CONFLICTING")) as $stuck
         | (.draft or ($t - (.created | epoch)) > $b.window_d * 86400) as $old
         | . + {class: (if $old then (if $worked then "none" else "aged" end)
                        elif $orphan and .idle_h >= $b.idle_h then "stranded"
                        elif $stuck and .idle_h >= $b.blocked_h then "blocked"
                        else "none" end)}],
       branches: [$br[0][] | . + {idle_h: (($t - (.commit | epoch)) / 3600 | floor)} | select(.idle_h >= $b.idle_h)]}'
}

# prs_line <pr> (jq def): one line naming the PR and why it is in its class
PRS_LINE='def why: [(if .checks | IN("FAILURE", "ERROR") then "checks red" elif .checks | IN("PENDING", "EXPECTED") then "checks pending" else empty end),
    (if .mergeable == "CONFLICTING" then "conflicts" else empty end)] | join(", ");
  def branch_line: "\(.repo) \(.branch) (\(.kind)) idle \(.idle_h)h";
  def line: "\(.ref) idle \(.idle_h)h\(if .owner then ", item \(.owner.slug) (\(.owner.state))" else ", no item" end)\(why | if . == "" then "" else ", \(.)" end): \(.title[:70])";'

# cmd_prs [--json | --check stranded|blocked|aged|branches] -- the fleet's open PRs and which ones stall:
# stranded (nobody owns it), blocked (cannot land and nobody pushed), aged (a draft or a PR past the window
# that no live item works), and the pushed branches no PR owns (salvage/* included): land, open a PR or
# delete. --check prints one line per PR or branch in that class and exits 1 when any is (stranded and
# blocked are Sentinel watches, pr-stranded and pr-blocked, so one that stays red masks no other); 2 when
# GitHub, Forgejo or the queue cannot be read.
cmd_prs() {
  local json out usage="usage: fleet-bench prs [--json | --check stranded|blocked|aged|branches]"
  case "${1:-}" in
    ""|--json) ;;
    --check) case "${2:-}" in stranded|blocked|aged|branches) ;; *) say "$usage"; return 2 ;; esac ;;
    *) say "$usage"; return 2 ;;
  esac
  json=$(prs_json "$(now)") || { echo "unreadable: the open PRs (gh, the Forgejo PR store), the branches or the queue items"; return 2; }
  case "${1:-}" in
    --json) printf '%s\n' "$json" ;;
    --check) out=$(jq -r --arg c "$2" "$PRS_LINE"'
        (if $c == "branches" then .branches | sort_by(-.idle_h)
           | if length == 0 then empty else "\(length) unowned branch\(if length > 1 then "es" else "" end)", (.[] | branch_line) end
         else [.prs[] | select(.class == $c)] | sort_by(-.idle_h)
           | if length == 0 then empty else "\(length) \($c) PR\(if length > 1 then "s" else "" end)", (.[] | line) end end)' <<<"$json") \
        || { echo "unreadable: fleet-bench prs could not class the PRs"; return 2; }
      [ -z "$out" ] || { printf '%s\n' "$out"; return 1; } ;;
    *) jq -r "$PRS_LINE"'"open PRs: \(.prs | length), stranded after \(.bounds.idle_h)h with no live item, blocked after \(.bounds.blocked_h)h idle, aged past \(.bounds.window_d)d or a draft; idle counts from the last commit",
        (["stranded", "blocked", "aged"][] as $c | [.prs[] | select(.class == $c)] | sort_by(-.idle_h)
          | "", "\($c): \(length)", (.[] | "  " + line)),
        "", "unowned branches (land, open a PR or delete): \(.branches | length)", (.branches | sort_by(-.idle_h) | (.[:20][] | "  " + branch_line), if length > 20 then "  and \(length - 20) more: fleet-bench prs --check branches" else empty end)' <<<"$json" ;;
  esac
}

# ledger_base <key> -> the baseline count for <key>: its last `key=N` line plus each `key+=N` or
# `key-=N` line after it (format: the baseline's header). The file is merge=union, so two PRs that
# each add a line keep both, and a delta must carry its date and name so no two read alike for union
# to fold into one; two PRs that each rewrote `runners=34` to 35 conflicted (ar-4471). Prints the raw value when the absolute line is not a number, and `bad delta: <line>`
# for a delta with no date, so the caller fails either.
ledger_base() {
  awk -v k="$1" '
    index($0, k "=") == 1 { base = substr($0, length(k) + 2); sum = 0; next }
    $0 ~ ("^" k "[+-]=") {
      if ($0 !~ ("^" k "[+-]=[0-9]+ [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [^ ]")) { print "bad delta: " $0; bad = 1; exit }
      n = substr($1, length(k) + 3) + 0
      sum += (substr($1, length(k) + 1, 1) == "+") ? n : -n
    }
    END { if (bad) exit; if (base ~ /^[0-9]+$/) print base + sum; else print base }' "$LEDGER_BASELINE"
}

# ledger_check <counts> -> one line per gated count over the baseline, then launches_unlisted's
# lines; exit 1 if any, 2 if no baseline or no launch table
ledger_check() {
  local k cur base bad=0
  [ -r "$LEDGER_BASELINE" ] || { say "no ledger baseline at $LEDGER_BASELINE"; return 2; }
  for k in $LEDGER_GATED; do
    cur=$(sed -n "s/^$k=//p" <<<"$1"); cur=${cur//[[:blank:]]/}   # BSD wc pads its count
    base=$(ledger_base "$k")
    # A missing or non-numeric value fails: `[ "" -gt 8 ]` errors and reads as not grown.
    [[ $base =~ ^[0-9]+$ ]] || { say "baseline has no number for $k: '$base'"; bad=1; continue; }
    [[ $cur =~ ^[0-9]+$ ]] || { say "no single count for $k: '$cur'"; bad=1; continue; }
    if [ "$cur" -gt "$base" ]; then
      echo "$k grew: $cur > baseline $base"
      bad=1
    fi
  done
  launches_unlisted
  case $? in 0) ;; 1) bad=1 ;; *) return 2 ;; esac
  return "$bad"
}

cmd_ledger() {
  local counts
  case "${1:-}" in
    --launches) shift; headless_launches "$@"; return 0 ;;
    --check) ledger_check "$(ledger_roster)"; return ;;
    --unlisted) launches_unlisted; return ;;
  esac
  counts=$(ledger_counts)
  case "${1:-}" in
    --json) jq -Rn '[inputs | split("=") | {key: .[0], value: (.[1] | tonumber? // .)}] | from_entries' <<<"$counts" ;;
    "") echo "$counts" ;;
    *) say "ledger: unknown option $1"; return 2 ;;
  esac
}

# ---------------------------------------------------------------- rules

# The rule register: one JSON row per rule, its kind, the number it rests on, a confidence and a
# revisit trigger (~/.local/src/docs/standards.md, the last rule). A row with `measure` re-measures
# itself here: `measure` prints a number (`value`), and with `max` or `min`, `holds` says it is inside
# the bound. A measure without a bound is a reading: a knob set in its own source (a cap, a share)
# is read there, so its number has one home; a bound copied from the file the measure reads can
# never move, and --check fails it (`restates`: a bounded measure naming its own source, ~ or $HOME,
# that is not a size or count, i.e. no wc, grep -c, stat or find). A size or count is a real bound.
# confidence low records a number known not to hold, so `moved` is a change from what the register
# says, never a number merely being past its line. `dead` is a measure that printed no number, with
# the last line of its stderr, or that it timed out, as `err`. A measure whose stderr says GitHub did
# not answer is `limited`, not dead: nothing was measured, so it reads `absent` and no gate goes red
# until it answers again. That is a rate limit (HTTP 403 "API rate limit exceeded"; the core budget
# is shared by every session) or a transport failure on a line naming github.com
# (RULES_UNANSWERED_RE): one failed gh run list turned the tests.yml budget rule dead on a 2026-11-18
# Stack read and it read fine minutes later (ar-3274). Any other tool's failure, a local service
# down or a measure's own syntax error, stays dead.
# `anchored` is the rule's text still being in its source; null when the source is not on this
# machine. A source tracked in a git checkout is read from that repo's origin/HEAD, as of its last
# fetch (nothing here fetches), never its working tree: a main checkout sits weeks behind (the bnb
# platform one was detached 57 commits back, so the anchors #1644 dropped read as present, ar-6241);
# rules_source says which file stands in for it. `state` is the one verdict, first of stale, absent
# (source not here, or limited), dead, restates, moved, layer, else ok: --check fails all but absent and ok, and Stack shows it as is. A row's optional `scenario` is the hard
# situation the rule decides: the must-keep list a context trim is checked against (context-trim skill).
# `form` says whether a row is a rule (text a session reads, a .md source) or a mechanism (a hook,
# script or config that enforces one); the source decides it, and a row's own `form` overrides that.
# `enforced_by` names what holds a rule row to its text: `test:<path>` (a bats file, optionally
# `test:<path>::<test name>`; an absolute or ~ path), `hook:<path>`, `ci:<path>`, or `review` (nothing but a reader, the prose-only
# row). A mechanism row is its own enforcer and needs none. `enforcer` is the verdict: ok, review, missing (a
# rule row names none), bad (not that grammar) or dead (the path, or the test name in it, is not there; a
# source on another machine is absent first, as for every row). --check fails a missing, bad or dead one, and
# fails when the `review` rows outnumber RULES_PROSE_BASELINE (`review=N`), which may only shrink: a new
# rule row names a check, or it is one more prose-only row and the count has to be argued for.

# `layer` holds "narrowest layer that covers every repo a rule applies to" (global CLAUDE.md, Memory
# Routing) to a test. A row sourced in a global file (RULES_GLOBAL_SOURCES) carries `applies`: "all"
# (a rule about how a session works anywhere) or the list of repos that need it, two or more; one repo
# means the rule belongs in that repo's own file. A rule row sourced anywhere else whose anchor is a
# global row's anchor (or contains it, 20 characters or more, ignoring case and punctuation) restates
# the wider layer; a row that must stand alone says why in `layer_waiver` (fleet-platform: teammates
# read its AGENTS.md without ours).

# rules_enforcer <enforced_by> -> none (empty), review, ok, bad or dead: `<kind>:<path>[::<test name>]`
# resolved against the disk: an absolute path or one under `~`, and the name as written in an `@test "<name>"` line.
rules_enforcer() {
  local v="$1" path name=""
  [ -n "$v" ] || { echo none; return; }
  [ "$v" != review ] || { echo review; return; }
  case "$v" in test:*|hook:*|ci:*) ;; *) echo bad; return ;; esac
  path="${v#*:}"
  if [ "${v%%:*}" = test ] && [[ "$path" == *::* ]]; then name="${path#*::}" path="${path%%::*}"; [ -n "$name" ] || { echo bad; return; }; fi
  [ -n "$path" ] || { echo bad; return; }
  path="${path/#\~/$HOME}"
  [[ "$path" == /* ]] || { echo bad; return; }
  if [ -f "$path" ] && { [ -z "$name" ] || grep -qF -- "@test \"$name\"" "$path"; }; then echo ok; else echo dead; fi
}

# rules_source <path> <dir> -> REPLY: the file whose text is <path>'s rule text, empty when there is
# none (the source is absent, or a directory); REPLY, not stdout, so RULES_SRC_REF outlives the call.
# A file tracked in a git checkout with an origin/HEAD is that tip's copy, written under <dir>: an
# empty file when the tip does not have it (gone from origin, or committed here and not yet merged),
# so its anchors read stale until it is. rc 1 when that copy cannot be written. An untracked or
# ignored file, or one outside a checkout, is itself, and so is any file of a repo with no
# origin/HEAD, whose origin is named on stderr once (`git remote set-head origin -a` fixes it), as
# project-stage-check reads one (stages.md). The caller declares RULES_SRC_REF (repo -> ref).
rules_source() {
  local real top rel ref type=
  REPLY=
  real=$(readlink -f -- "$1" 2>/dev/null) && [ ! -d "$real" ] || return 0
  if top=$(git -C "$(dirname -- "$real")" rev-parse --show-toplevel 2>/dev/null) && [ -n "$top" ]; then
    if [ -z "${RULES_SRC_REF[$top]+x}" ]; then
      RULES_SRC_REF[$top]=
      if git -C "$top" rev-parse -q --verify origin/HEAD >/dev/null; then RULES_SRC_REF[$top]=origin/HEAD
      elif git -C "$top" remote get-url origin >/dev/null 2>&1; then
        echo "fleet-bench rules: $top has an origin but no origin/HEAD, so its working tree is read; git -C $top remote set-head origin -a fixes it" >&2
      fi
    fi
    ref=${RULES_SRC_REF[$top]} rel=${real#"$top"/}
    [ -z "$ref" ] || type=$(git -C "$top" cat-file -t "$ref:$rel" 2>/dev/null)
    if [ -n "$ref" ] && { [ "$type" = blob ] || git -C "$top" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1; }; then
      REPLY=$(mktemp "$2/src.XXXXXX") || { REPLY=; return 1; }
      [ "$type" != blob ] || git -C "$top" cat-file blob "$ref:$rel" > "$REPLY" || { REPLY=; return 1; }
      return 0
    fi
  fi
  [ ! -f "$real" ] || REPLY=$real
}

# rules_states -> each register row, one JSON object a line, with form, anchored, value, limited, err, holds, moved, dead, restates, state.
rules_states() {
  [ -s "$RULES_REGISTER" ] || return 0
  local src anchor cmd enf value anchored limited err enforcer why rc text srcs
  local -A RULES_SRC_REF=() texts=()
  err=$(mktemp) || return 1
  srcs=$(mktemp -d) || { rm -f "$err"; return 1; }
  while IFS=$'\x1f' read -r src anchor cmd enf; do
    src="${src/#\~/$HOME}"
    # Keyed with a leading @, so a row with no source is a key too.
    if [ -z "${texts[@$src]+x}" ]; then
      rules_source "$src" "$srcs" || { echo "fleet-bench rules: cannot copy $src from its origin tip" >&2; exit 1; }
      texts[@$src]=$REPLY
    fi
    text=${texts[@$src]}
    if [ -z "$text" ]; then anchored=null
    elif grep -qF -- "$anchor" "$text"; then anchored=true
    else anchored=false
    fi
    value="" limited=false why=""
    if [ -n "$cmd" ]; then
      value=$(timeout "$RULES_MEASURE_TIMEOUT" bash -c "$cmd" 2>"$err" </dev/null | tail -1; exit "${PIPESTATUS[0]}")
      rc=$?
      # A counting measure prints 0 when GitHub did not answer, so its number goes too.
      if grep -qiE 'rate limit.*HTTP (403|429)' "$err" \
        || grep -i 'github\.com' "$err" | grep -qiE "$RULES_UNANSWERED_RE"; then
        limited=true value=
      fi
      if [ "$rc" = 124 ]; then why="timed out after ${RULES_MEASURE_TIMEOUT}s"
      else why=$(grep . "$err" | tail -1 | tr -d '\037' | cut -c1-200)
      fi
    fi
    enforcer=$(rules_enforcer "$enf")
    printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\n' "$anchored" "$value" "$limited" "$enforcer" "$why"
  done < <(jq -r '[.source, .anchor, (.measure // ""), (.enforced_by // "")] | map(gsub("\n"; " ")) | join("\u001f")' "$RULES_REGISTER") |
    jq -cRn --slurpfile rows "$RULES_REGISTER" --arg globals "$RULES_GLOBAL_SOURCES" '
      def norm: ascii_downcase | gsub("[^a-z0-9]+"; " ") | gsub("^ +| +$"; "");
      def home: sub("^~"; env.HOME);
      ($globals | split(":") | map(select(. != "") | home)) as $gl
      | ([$rows[] | select((.source // "" | home) | IN($gl[])) | (.anchor // "" | norm) | select(length >= 20)]) as $ganchors
      | [inputs | split("\u001f")] as $seen
      | range($rows | length) as $i
      | $rows[$i] + {anchored: ($seen[$i][0] | fromjson), value: ($seen[$i][1] | tonumber? // null), limited: ($seen[$i][2] == "true"), enforcer: $seen[$i][3], err: ($seen[$i][4] // "")}
      | (.max != null or .min != null) as $bounded
      | (.source // "") as $raw | ($raw | sub("^~"; env.HOME)) as $src
      | .form = (.form // (if ($raw | test("\\.md$")) then "rule" else "mechanism" end))
      | .enforcer = (if .enforcer == "none" and .form == "mechanism" then "self" else .enforcer end)
      | .enforcer = (if .enforcer == "none" then "missing" else .enforcer end)
      | .limited = (.limited and .value == null)
      | .dead = (.measure != null and .value == null and (.limited | not))
      | .err = (if .dead then .err else "" end)
      | ((.measure // "") | gsub("\\$\\{HOME\\}|\\$HOME"; "~") | gsub("~"; env.HOME)) as $reads
      | .restates = ($bounded and $raw != "" and .measure != null
          and (.measure | test("\\bwc\\b|grep -c|\\bstat\\b|\\bfind\\b") | not) and ($reads | contains($src)))
      | .layer = (if ($src | IN($gl[])) then
            (if .applies == "all" then ""
             elif (.applies | type) == "array" then
               (if (.applies | unique | length) >= 2 and all(.applies[]; type == "string" and . != "") then ""
                else "applies lists \(.applies | unique | length) distinct repo(s); a rule for fewer than 2 belongs in that repo'"'"'s own file" end)
             else "names no applies: give \"all\" or the repos that need it" end)
          elif .form == "rule" and ((.layer_waiver // "") == "") and ((.anchor // "" | norm) as $a | ($a | length) >= 20 and any($ganchors[]; . as $g | ($a | contains($g)) or ($g | contains($a))))
          then "restates a global row; keep the global one and link to it, or give layer_waiver the reason this file must stand alone"
          else "" end)
      | .holds = (if $bounded and .value != null
          then ((.max == null or .value <= .max) and (.min == null or .value >= .min)) else null end)
      | .moved = (.holds != null and .holds != (.confidence != "low"))
      | .state = (if .anchored == false then "stale" elif .anchored == null or .limited then "absent"
          elif .dead then "dead" elif .restates then "restates" elif .moved then "moved"
          elif .layer != "" then "layer"
          elif .enforcer | IN("missing", "bad", "dead") then "enforcer" else "ok" end)'
  local rc=$?
  rm -rf "$err" "$srcs"
  return "$rc"
}

# rules_problems <states array> -> one line per row --check fails on: its `state`, which Stack shows too.
rules_problems() {
  jq -r 'def rules_gate_problem:
      (.id) as $id
      | if ((.asked_by // "") | test("^(ask:[A-Za-z0-9_-]+|human:.{8,}|agent:.{2,})$") | not)
        then "gate asked_by: \($id): \(.asked_by // "missing") is not ask:<id>, human:<their words or the rule that says it> or agent:<PR or incident>"
        elif .routes == "human" and (.asked_by | startswith("agent:")) then
          if (.remove_item // "") == "" or (.remove_by // "") == "" then
            "agent route: \($id): it routes work to the human and an agent added it; remove it, get the human'"'"'s ask, or name the item that removes it (remove_item, remove_by)"
          elif .remove_by < $today then "agent route: \($id): its removal by \(.remove_item) was due \(.remove_by); delete the gate"
          else empty end
        else empty end,
      (if (.added // "") | (try (strptime("%Y-%m-%d") | mktime | strftime("%Y-%m-%d")) catch "") as $d | $d == "" or . != $d
        then "gate added: \($id): \(.added // "missing") is not the YYYY-MM-DD the gate first merged, which rules --new reads" else empty end);
    .[] | (.source | split("/") | last) as $f
    | if .state == "stale" then "stale: \($f): \(.anchor)"
      elif .state == "dead" then "dead measure: \($f): \(.anchor)\(if .err != "" then " (\(.err))" else "" end)"
      elif .state == "restates" then "restates: \($f): \(.anchor): its bound is a copy of the number its measure reads from \($f); drop max/min, the reading is the number"
      elif .state == "moved" then "moved: \($f): \(.anchor): \(.value) against \(if .max != null then "max \(.max)" else "min \(.min)" end), recorded \(.confidence)"
      elif .state == "layer" then "layer: \($f): \(.anchor): \(.layer)"
      else empty end,
    (select(.enforcer | IN("missing", "bad", "dead")) | select(.anchored != null) | "enforcer: \($f): \(.anchor): " + (
      if .enforcer == "missing" then "names no enforced_by; give test:<path>, hook:<path>, ci:<path>, or review when only a reader holds it"
      elif .enforcer == "bad" then "enforced_by \(.enforced_by) is not review, test:<path>[::<test name>], hook:<path> or ci:<path>"
      else "enforced_by \(.enforced_by) does not resolve: no such file, or the test name is not in it" end)),
    (select(.form | IN("rule", "mechanism") | not) | "form: \($f): \(.anchor): \(.form) is neither rule nor mechanism"),
    (select(.id != null) | rules_gate_problem)' --arg today "$(date -u +%F)" <<<"$1"
}

# rules_prose_problems <states array> -> the line --check fails on when the rule rows that name no check
# but `review` are not exactly the RULES_PROSE_BASELINE count: more means a rule landed with no check, fewer
# means the baseline is slack and the next prose row would hide in it, so it is lowered with the row.
rules_prose_problems() {
  local n base
  n=$(jq 'map(select(.form == "rule" and .enforced_by == "review")) | length' <<<"$1")
  base=$(sed -n 's/^review=\([0-9][0-9]*\)$/\1/p' "$RULES_PROSE_BASELINE" 2>/dev/null | tail -1)
  if [ -z "$base" ]; then
    [ "$n" -eq 0 ] || echo "prose-only: $n rule rows name no check but review, and $RULES_PROSE_BASELINE has no review=N line"
  elif [ "$n" -gt "$base" ]; then
    echo "prose-only: $n rule rows name no check but review, over the baseline $base; give the new row a test, hook or ci enforcer"
  elif [ "$n" -lt "$base" ]; then
    echo "prose-only: $n rule rows name no check but review, under the baseline $base; lower review= in $RULES_PROSE_BASELINE to $n"
  fi
}

# rules_lesson_problems -> one line per lesson the dream sweep found RULES_LESSON_SEEN times or more whose
# enforced_by marker is neither a test, hook or ci that resolves nor an explicit `review` (a lesson no check can
# hold says so in writing, so the lesson is not silently one more prose rule). No lessons dir or CLI is no problem.
rules_lesson_problems() {
  local lessons="${RULES_LESSONS_CMD:-$(dirname "$0")/lessons}" at seen enf title
  [ -d "${RULES_LESSONS_DIR:-$HOME/.agent/lessons}" ] && [ -x "$lessons" ] || return 0
  while IFS=$'\t' read -r at seen enf title; do
    [ "$enf" != - ] || enf=
    [ "$(rules_enforcer "$enf")" != ok ] && [ "$enf" != review ] || continue
    echo "lesson: ${at##*/}: seen $seen times, enforced_by ${enf:-missing}; add <!-- enforced_by:test:<path> --> (or hook:, ci:) once a check holds it: $title"
  done < <("$lessons" seen --min "$RULES_LESSON_SEEN" "${RULES_LESSONS_DIR:-$HOME/.agent/lessons}")
}

# rules_summary <states array> -> the counts, key=value.
rules_summary() {
  jq -r 'def n($k; $v): map(select(.[$k] == $v)) | length;
    ["rules=\(length)", "invariant=\(n("kind"; "invariant"))", "provisional=\(n("kind"; "provisional"))",
     "confidence_high=\(n("confidence"; "high"))", "confidence_med=\(n("confidence"; "med"))", "confidence_low=\(n("confidence"; "low"))",
     "keep=\(n("action"; "keep"))", "rewrite=\(n("action"; "rewrite"))", "drop=\(n("action"; "drop"))",
     "measured=\(map(select(.holds != null)) | length)", "holds=\(n("holds"; true))", "past=\(n("holds"; false))",
     "mechanisms=\(n("form"; "mechanism"))",
     "prose_only=\(map(select(.form == "rule" and .enforced_by == "review")) | length)",
     "limited=\(map(select(.limited)) | length)",
     "scenarios=\(map(select((.scenario // "") != "")) | length)"] | .[]' <<<"$1"
}

# rules_scenarios <states array> -> one line per hard scenario: ok, stale or absent (source not here),
# the source file, the scenario, and the anchor that must stay.
# One line per scenario, with its full source (three files here are called CLAUDE.md); 1 when any is stale.
rules_scenarios() {
  local out
  out=$(jq -r '.[] | select((.scenario // "") != "")
    | "\(if .anchored == true then "ok" elif .anchored == false then "stale" else "absent" end)\t\(.source)\t\(.scenario)\t\(.anchor)"' <<<"$1")
  [ -z "$out" ] || printf '%s\n' "$out"
  ! grep -q '^stale' <<<"$out"
}

# rules_changed <since> -> one tab-separated line per rule line a PR merged since <since> added or
# removed: repo, PR number, PR title, file, + or -, the line. A rule written from one session's own
# review of its own answer landed with no review and reached no human for two weeks ("never explain
# how a piece of the system works unless asked", 2026-11-06), so the briefing lists each one the
# next morning. Read from GitHub, never a local log: the private clone is shallow, and its oldest
# commit looks like it adds every file. The repos are the config repos (BENCH_CANARY_CONFIG_REPOS).
rules_changed() {
  local since iso dirs dir slug name prs rows count n title
  since="$1"; [[ "$since" =~ ^[0-9]+$ ]] && since="@$since"
  iso=$(date -u -d "$since" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null) || { say "rules --changed: not a time: $1"; return 2; }
  IFS=: read -ra dirs <<<"$BENCH_CANARY_CONFIG_REPOS"
  for dir in "${dirs[@]}"; do
    slug=$(git -C "$dir" remote get-url origin 2>/dev/null | sed -E 's#^.*github\.com[:/]##; s#\.git$##')
    [ -n "$slug" ] || { say "rules --changed: no GitHub origin in $dir"; return 1; }
    name="${slug##*/}"; name="${name#.}"
    prs=$(timeout "$RULES_CHANGED_GH_TIMEOUT" gh pr list -R "$slug" --state merged --search "merged:>=$iso" \
      --limit "$RULES_CHANGED_MAX_PRS" --json number,title,mergedAt,files) ||
      { say "rules --changed: gh pr list failed for $slug"; return 1; }
    count=$(jq length <<<"$prs" 2>/dev/null) || { say "rules --changed: gh pr list for $slug did not return JSON"; return 1; }
    [ "$count" -lt "$RULES_CHANGED_MAX_PRS" ] ||
      { say "rules --changed: $count PRs merged in $slug since $iso, the most one list reads; give a later time"; return 1; }
    # gh lists only a PR's first 100 files, so a PR with 100 or more is read whole.
    rows=$(jq -r --arg iso "$iso" --arg ere "$RULES_CHANGED_ERE" --arg skip "$RULES_CHANGED_SKIP_ERE" '
      sort_by(.mergedAt) | .[] | select(.mergedAt >= $iso)
      | select((.files | length) >= 100 or any(.files[]?.path; test($ere) and (test($skip) | not)))
      | [.number, (.title | gsub("\t"; " "))] | @tsv' <<<"$prs") ||
      { say "rules --changed: could not read the PR list for $slug"; return 1; }
    while IFS=$'\t' read -r n title; do
      [ -n "$n" ] || continue
      # The patterns go through ENVIRON: awk -v would read their backslashes as escapes. A file is
      # named by its new path (the last " b/"), so a rename into a rule file is read.
      timeout "$RULES_CHANGED_GH_TIMEOUT" gh pr diff "$n" -R "$slug" | RC_PRE="$name"$'\t'"$n"$'\t'"$title" awk '
        BEGIN { ere = ENVIRON["RULES_CHANGED_ERE"]; skip = ENVIRON["RULES_CHANGED_SKIP_ERE"]
                noise = ENVIRON["RULES_CHANGED_NOISE_ERE"]; pre = ENVIRON["RC_PRE"] }
        /^diff --git / { f = $0; sub(/^.* b\//, "", f)
                         keep = (f ~ ere) && !(f ~ skip); hunk = 0; next }
        /^@@/ { hunk = 1; next }
        keep && hunk && /^[-+]/ { t = substr($0, 2); gsub(/^[ \t]+|[ \t]+$/, "", t)
                                  if (length(t) >= 3 && t !~ noise) print pre "\t" f "\t" substr($0, 1, 1) "\t" t }' ||
        { say "rules --changed: gh pr diff $n failed for $slug"; return 1; }
    done <<<"$rows"
  done
}

# rules_gates [<base>] -> one line per problem the code has against the register, 1 when any: a marker
# naming a row that does not exist, a hook that denies or blocks and names no row, and, against the merge
# base with <base> (default origin/main; no base, no diff check), an added refusal in a gate tool with no
# marker within GATE_NEAR lines above it. A gate cannot merge without a row, and a row says who asked.
rules_gates() {
  local base="${1:-origin/main}" root="$GATE_ROOT" ids f n id mb out="" line files=()
  ids=$(jq -r 'select(.id != null) | .id' "$RULES_REGISTER" 2>/dev/null)
  for f in $GATE_TOOLS; do [ -f "$root/$f" ] && files+=("$f"); done
  while IFS= read -r f; do files+=("$f"); done < <(cd "$root" 2>/dev/null && find "$GATE_HOOKS_DIR" -type f \( -name '*.py' -o -name '*.sh' \) 2>/dev/null | sort)
  [ "${#files[@]}" -gt 0 ] || { say "rules --gates: no gate code under $root"; return 1; }
  for f in "${files[@]}"; do
    while IFS=: read -r n line; do
      id=$(sed -nE "s/${GATE_MARKER_ERE}/\\1/p" <<<"$line" | awk 'NR==1')
      [ "$n" -le 1 ] || ! sed -n "$((n - 1))p" "$root/$f" | grep -qE '\\$' ||
        out+="misplaced gate: $f:$n: the marker sits inside a continued command, which it would swallow; put it above the command"$'\n'
      [ "$id" = none ] || grep -qxF -- "$id" <<<"$ids" || out+="unregistered gate: $f:$n: gate: $id has no row in the register"$'\n'
    done < <(grep -nE "$GATE_MARKER_ERE" "$root/$f")
    case "$f" in "$GATE_HOOKS_DIR"/*)
      if grep -qE "$GATE_DENY_ERE" "$root/$f" && ! grep -qE "$GATE_MARKER_ERE" "$root/$f"; then
        out+="unmarked gate: $f: it denies or blocks and names no register row (# gate: <id>)"$'\n'
      fi ;;
    esac
  done
  if mb=$(git -C "$root" merge-base HEAD "$base" 2>/dev/null); then
    local d dfile=""
    while IFS=$'\t' read -r dfile n line; do
      [ -n "$dfile" ] || continue
      sed -n "$(( n > GATE_NEAR ? n - GATE_NEAR : 1 )),${n}p" "$root/$dfile" | grep -qE "$GATE_MARKER_ERE" ||
        out+="unmarked refusal: $dfile:$n: an added refusal names no register row; add # gate: <id> (or # gate: none for a usage error) above it: ${line:0:90}"$'\n'
    done < <(git -C "$root" diff --no-color --no-ext-diff --src-prefix=a/ --dst-prefix=b/ -U0 "$mb" -- "${files[@]}" | awk -v re="$GATE_REFUSE_ERE" '
      /^\+\+\+ b\// { file = substr($0, 7); next }
      /^@@/ { match($0, /\+[0-9]+/); n = substr($0, RSTART + 1, RLENGTH - 1) + 0; next }
      /^\+/ { t = substr($0, 2); if (t !~ /^[[:space:]]*#/ && t ~ re) printf "%s\t%d\t%s\n", file, n, t; n++ }')
  fi
  [ -z "$out" ] || { printf '%s' "$out"; return 1; }
}

# rules_new [--days N | --since T] [--until D] [--json | --line] -> the gate rows (those with an id) whose
# `added` date, the local day the gate first merged, is in the window: N local days ending today (default
# 7), or from the day of T (epoch or a date) on, up to D when given. Agent-added first, newest first in each.
# A date has no time, so a gate that merged on T's own day is listed even when it merged before T: shown
# twice beats missed. Text is one tab-separated line a gate (added, id, asked_by, repo #PR or -, rule);
# --json the rows plus by_agent and pr; --line the one sentence for the briefing and day-log, nothing
# when no gate is new. Reads the register alone, no measure, so a 5-minute day-log pass can call it.
rules_new() {
  local days="" since="" until="" mode=text from to window list
  while [ $# -gt 0 ]; do
    case "$1" in
      --days|--since|--until) [ -n "${2:-}" ] || { say "rules --new: $1 needs a value"; return 2; } ;;&
      --days) days="$2"; shift 2 ;;
      --since) since="$2"; shift 2 ;;
      --until) until="$2"; shift 2 ;;
      --json|--line) mode="${1#--}"; shift ;;
      *) say "rules --new: unknown option $1"; return 2 ;;
    esac
  done
  [ -z "$since" ] || [ -z "$days" ] || { say "rules --new: give --days or --since, not both"; return 2; }
  [ -n "$since" ] || [ -z "$until" ] || { say "rules --new: --until bounds a --since window; --days always ends today"; return 2; }
  [ -s "$RULES_REGISTER" ] || { say "rules --new: no register at $RULES_REGISTER"; return 1; }
  if [ -n "$since" ]; then
    [[ "$since" =~ ^[0-9]+$ ]] && since="@$since"
    from=$(date -d "$since" +%F 2>/dev/null) || { say "rules --new: not a time: $since"; return 2; }
    list="--since $from"
  else
    days="${days:-7}"
    [[ "$days" =~ ^[1-9][0-9]*$ ]] || { say "rules --new: --days takes a whole number of days, 1 or more: $days"; return 2; }
    from=$(date -d "$((days - 1)) days ago" +%F)
    list="--days $days"
  fi
  to=$(date -d "${until:-today}" +%F 2>/dev/null) || { say "rules --new: not a date: $until"; return 2; }
  [ -z "$until" ] || list+=" --until $to"
  if [ "$from" = "$to" ]; then window="on $from"; elif [ -n "$until" ]; then window="from $from to $to"
  elif [ -n "$since" ]; then window="since $from"; else window="in $days days"; fi
  jq -rs --arg from "$from" --arg to "$to" --arg mode "$mode" --arg window "$window" --arg list "$list" '
    def by_agent: (.asked_by // "") | startswith("agent:");
    def repo: .source // "" | sub("^~/"; "") | ltrimstr(env.HOME + "/") | split("/")[0] | ltrimstr(".");
    def pr: (((.asked_by // "") | capture("^agent:#(?<n>[0-9]+)")? | .n) // null) as $n | if $n then "\(repo) #\($n)" else null end;
    def gates($n): if $n == 1 then "1 gate" else "\($n) gates" end;
    [.[] | select(.id != null and (.added // "") >= $from and (.added // "") <= $to)]
    | sort_by(.added, .id) | reverse | sort_by(by_agent | not)
    | if $mode == "json" then map(. + {by_agent: by_agent, pr: pr})
      elif $mode == "text" then .[] | [.added, .id, .asked_by, (pr // "-"), (.rule // "" | gsub("[\t\n]"; " "))] | @tsv
      elif length == 0 then empty
      else map(select(by_agent)) as $a | ($a | length) as $k
        | ($a[:5] | map("\(.id) (\(pr // (.asked_by | ltrimstr("agent:") | sub(" [(].*$"; ""))))") | join(", ")) as $names
        | "\(gates(length)) added \($window), "
          + (if $k == 0 then (if length == 1 then "on your ask" else "all on your ask" end)
             elif $k == length and $k == 1 then "by an agent without your ask: \($names)"
             else "\($k) by an agent without your ask: \($names)" end)
          + (if $k > 5 then ", and \($k - 5) more" else "" end)
          + ". List: fleet-bench rules --new \($list)."
      end' "$RULES_REGISTER"
}

cmd_rules() {
  local states problems
  [ "${1:-}" != --changed ] || { rules_changed "${2:?rules --changed needs a since time}"; return; }
  [ "${1:-}" != --new ] || { shift; rules_new "$@"; return; }
  [ "${1:-}" != --gates ] || { rules_gates "${2:-}"; return; }
  states=$(rules_states | jq -s .) || { say "rules: the register's sources could not be read"; return 2; }
  problems=$(rules_problems "$states"; rules_prose_problems "$states"; rules_lesson_problems)
  case "${1:-}" in
    --json) echo "$states" ;;
    --check) [ -z "$problems" ] || { echo "$problems"; return 1; } ;;
    --scenarios) rules_scenarios "$states" ;;
    "") rules_summary "$states"; [ -z "$problems" ] || echo "$problems" ;;
    *) say "rules: unknown option $1"; return 2 ;;
  esac
}

# KPIs: ratios over the human sessions session-outcomes saw in the last 7 and 28 days, the comms
# standard's 7d and 28d numbers from the nightly comms snapshot (comms-lint owns the formulas), the
# judges' from judge-eval (it owns those; ~/.local/src/docs/judges.md), plus counts taken now. Headless runs are left out: they have no human to interrupt and their
# cost is the fleet's, not a session's. Each threshold is <kpi>_max or <kpi>_min.

KPI_NOW="runners_bad failed_unexplained board_open board_days points_per_pr loop_dark $KPI_CHAIN cost_per_merged_item red_fix_min_p50 lesson_held_share worktrees_held worktrees_held_over_7d systems_no_skill"
KPI_COMMS="buzzes_per_day comms_pass_pct rows_pass_pct pages_held_per_day"
KPI_JUDGE="judge_errors judge_precision ask_answered_pct ask_unclear_pct judge_human_only_live_pct ask_human_only_pct dispatch_false_defer_pct"
KPI_ASKS="human_answered_per_day ask_wait_p90_min"
KPI_STARTUP="startup_ready_ms_p50"
KPI_SANDBOX="sandboxed_lane_pct"
KPI_POOL="pool_busy_share"
KPI_CHURN="churn_merges_per_day churn_filed_per_closed churn_reopens_per_day churn_followups_per_pr churn_admitted_per_day churn_refused_per_day"
# Each scored runner's runner_score_<name> is judge-eval's too, listed from its output and the
# thresholds rather than here: the runner confs' SCORE= is the one list of lanes.

# comms_kpi -> the comms snapshot's KPI object, or {} when there is none or it is stale, so both
# KPIs show - rather than an old number
comms_kpi() { $BENCH_COMMS_CMD kpi --json 2>/dev/null | jq -ce 'objects' 2>/dev/null || echo '{}'; }
# judge_kpi -> judge-eval's KPI object, the same shape, or {} when it cannot score
judge_kpi() { $BENCH_JUDGE_CMD kpi --json 2>/dev/null | jq -ce 'objects' 2>/dev/null || echo '{}'; }
# ask_kpi <now> -> the ask KPIs, the same shape, or {} when agent-ask cannot be read.
# human_answered_per_day: asks the human answered in the window, a day, outside the chat that asked
# them, so it counts interrupts: an answer typed into the asking session (answer_note "in session: ",
# closed_reason "replied in session") or with no answered_by (an in-session capture from before the
# field existed) is the conversation, not an interrupt (the human's pick in ask Go78lB, 2026-11-10).
# ask_wait_p90_min: p90 minutes from post to answer or close over the asks posted in the window, a
# pending one counted to now, so an ask nobody answers raises it (this replaced asks_stale).
# A cancelled ask was withdrawn by its asker and waited on no one.
ask_kpi() {
  local asks
  asks=$($BENCH_ASKS_ALL_CMD 2>/dev/null) || { echo '{}'; return 0; }
  jq -nc --argjson t "$1" --rawfile a <(printf '%s' "$asks") "$JQ_LIB"'
    def p90: sort | if length == 0 then null else .[(length * 0.9 | ceil) - 1] end;   # nearest rank
    [$a | split("\n")[] | select(length > 0) | split("\t")
     | {status: .[3], by: (.[17] // ""), c: (.[11] // ""), a: (.[8] // ""), x: (.[13] // ""),
        chat: (((.[23] // "") | startswith("in session")) or ((.[14] // "") | test("replied in session")))}
     | select(.c != "")
     | .c |= ask_epoch | .a |= (if . == "" then null else ask_epoch end)
     | .x |= (if . == "" then null else ask_epoch end)] as $r
    | def w($d): ($t - $d * 86400) as $s
        | {human_answered_per_day: ([$r[] | select(.status == "answered" and .by == "human" and (.chat | not)
                                                  and .a != null and .a > $s and .a <= $t)] | length / $d | round1),
           ask_wait_p90_min: ([$r[] | select(.status != "cancelled" and .c > $s and .c <= $t)
                               | (([.a // .x // $t, $t] | min) - .c) / 60] | p90 | if . == null then null else round end)};
    w(7) as $x | w(28) as $y | $x | keys_unsorted | map({(.): {"7d": $x[.], "28d": $y[.]}}) | add'
}

# startup_rows -> every SessionStart row, oldest first; jq's starts keeps the process starts
startup_rows() {
  [ -s "$CLAUDE_STARTUP_LOG" ] || return 0
  jq -c 'objects' "$CLAUDE_STARTUP_LOG" 2>/dev/null || true
}
STARTUP_JQ='def starts: map(select(.source == "startup" and (.ready_ms | numbers)));'

# startup_kpi <now> -> the startup KPI object, the same shape as comms_kpi: the median ms from a
# process start to the turn-1 context over the starts in the window, all sessions (a headless start
# is as slow as a human one)
startup_kpi() {
  jq -nc --argjson t "$1" --slurpfile r <(startup_rows) "$JQ_LIB$STARTUP_JQ"'
    def w($d): [$r | starts[] | select(.epoch > $t - $d * 86400 and .epoch <= $t) | .ready_ms] | median;
    {startup_ready_ms_p50: {"7d": w(7), "28d": w(28)}}'
}

# sandbox_kpi <now> -> the lane sandbox KPI object, the same shape as comms_kpi. sandboxed_lane_pct: of
# the named lanes that ran claude or codex in the window (calls.jsonl, agent-run lib/calls.sh), the
# percent whose newest call ran under a lane sandbox profile (the record's sandbox field). A refused
# run makes no call (lib/sandbox.sh records it elsewhere). A raw-harness call has no shell to confine.
sandbox_kpi() {
  [ -s "$BENCH_CALLS" ] || { echo '{}'; return 0; }
  jq -nc --argjson t "$1" "$JQ_LIB"'
    [inputs | objects | select((.agent // "") != "" and (.harness == "claude" or .harness == "codex") and (.at | type) == "string")
     | {agent, sb: ((.sandbox // "") != ""), e: (try (.at | iso_epoch) catch null)} | select(.e)] as $c
    | def w($d): [$c[] | select(.e > $t - $d * 86400 and .e <= $t)] | group_by(.agent) | map(max_by(.e).sb)
        | if length == 0 then null else (map(select(.)) | length) * 100 / length | round1 end;
    {sandboxed_lane_pct: {"7d": w(7), "28d": w(28)}}' "$BENCH_CALLS" 2>/dev/null || echo '{}'
}

# pool_kpi <now> -> the pool KPI object, the same shape as comms_kpi. pool_busy_share: the time average
# of cc:pool_busy over cc:pool_slots, summed over the pools fleet-dispatch's idle-pool rank term watches
# (BENCH_CLASSES `idle_pool.pools`), sampled every 10m, the measure of that term (plan
# can-we-wget-more-linked-pony P5; unity 0.592 over the 3 days before it went live, 2026-11-21). Read
# from VictoriaMetrics (vm_map): Prometheus keeps about 52 h, so both windows read from it were the same
# 2-day number. No knob, or VictoriaMetrics unread (a replay has no range answer), is no value.
pool_kpi() {
  local re q w7 w28
  re=$(prom_label_re "$(jq -c '.idle_pool.pools' "$BENCH_CLASSES" 2>/dev/null)")
  [ -n "$re" ] || { echo '{}'; return 0; }
  q="(sum(cc:pool_busy{pool=~\"$re\"}) / sum(cc:pool_slots{pool=~\"$re\"}))"
  w7=$(vm_map - "avg_over_time(${q}[7d:10m])" "$1") && [ -n "$w7" ] || w7='{}'
  w28=$(vm_map - "avg_over_time(${q}[28d:10m])" "$1") && [ -n "$w28" ] || w28='{}'
  jq -nc --argjson a "$w7" --argjson b "$w28" '
    def v: .["-"] | if type == "number" and (isnan | not) and (isinfinite | not) then (. * 1000 | round) / 1000 else null end;
    {pool_busy_share: {"7d": ($a | v), "28d": ($b | v)}}' 2>/dev/null || echo '{}'
}

# KPI_DEFS: the windowed KPIs as jq, shared by kpi, its --trend and effect. win($t; $d) is every
# ratio over the human sessions whose last update fell in the $d days up to $t, with $o the outcome
# rows, $c the CI rows and $k the canary score rows (slurped). The token KPIs are sums over the
# nightly token-usage snapshots ($tk) of the whole days in the window, all sessions (start_context_median
# is the median of those days' first-turn context medians), so a token lever gets the same kpi, improve
# and effect verdicts as a process one. Older lines have no runner field;
# _runner is where headless runs are filed. A canary session is an eval, not work: it leaves the
# human KPIs and makes the canary_ ones, scored by the oracle and costed from its outcome row.
# The rework KPIs are shares of merged PRs (session-outcomes.sh "rework") that a fix rewrote within
# 7 days (candidate) or rewrote within 30 days and named (verified). Each reads the cohort that has
# had its whole window: sessions that ended 7 or 30 days (rework_kpi .lag) before the window, counting only PRs observed
# that long after their merge. A candidate is a lead, not a defect.
KPI_DEFS="$JQ_LIB"'
  def bots: ($o | map(select(.runner == true or .project == "_runner") | .session_id))
    + ($k | map(.session_id // empty)) | INDEX(.);
  # the human sessions that ended in ($since, $t]
  def humans($bot; $since; $t): $o | map(select(($bot[.session_id] | not) and .updated_epoch != null
                                               and .updated_epoch > $since and .updated_epoch <= $t));
  # each rework KPI: its lag in days and the flag session-outcomes sets on each PR rework
  def rework_kpi: {rework_candidate_7d: {lag: 7, flag: "candidate"}, rework_verified_30d: {lag: 30, flag: "verified"}};
  def reworked($bot; $t; $d; $k): rework_kpi[$k] as $r | ($t - $r.lag * 86400) as $u
    | [humans($bot; $u - $d * 86400; $u)[] | .prs[]? | .rework | select(. and .seen_days >= $r.lag)]
    | ratio(map(select(.[$r.flag])) | length; length);
  def win($t; $d): bots as $bot | ($t - $d * 86400) as $since
    | humans($bot; $since; $t) as $s
    | ($c | map(select(.merged_epoch > $since and .merged_epoch <= $t and ($bot[.session_id] | not)))) as $ci
    | ($k | canary_graded | map(select(canary_base and canary_ran and .epoch > $since and .epoch <= $t))) as $kw
    | ($o | INDEX(.session_id)) as $os | [$kw[] | $os[.session_id // ""] // empty] as $ks
    | ($s | total(.prs_merged)) as $prs
    | ($since | strflocaltime("%Y-%m-%d")) as $d0 | ($t | strflocaltime("%Y-%m-%d")) as $d1
    | ($tk | map(select((.date // "") >= $d0 and .date < $d1))) as $tw
    | ($tw | map(select(.merged_prs | numbers))) as $tp
    | ($tw | map(select(.context_split.start | numbers))) as $ts
    | {sessions: ($s | length), merged_prs: ($c | map(select(.merged_epoch > $since and .merged_epoch <= $t)) | unique_by([.repo, .number]) | length),
       revert_rate: ratio(($s | total(.reverted_7d)); $prs),
       interrupts_per_day: ratio(($s | total(.corrections.interrupts)); $d),
       cost_per_pr: ratio(($s | total(.cost_usd)); $prs),
       ci_red_per_pr: ratio(($ci | total(.ci_red)); $ci | length),
       first_pass_share: ($ci | map(select(ran_gate)) as $ran | ratio($ran | map(select(first_try)) | length; $ran | length)),
       plan_gate_deny_rate: ratio(($s | total(.plan_gate.denied)); $s | total(.plan_gate.exits)),
       canary_runs: ($kw | length), canary_pass_rate: ratio(($kw | map(select(.pass == true)) | length); $kw | length),
       canary_cost_per_task: ratio(($ks | total(.cost_usd)); $ks | length),
       canary_min_per_task: ratio(($ks | total(.duration_s)) / 60; $ks | length),
       canary_turns_per_task: ($ks | map(.activity.api_messages | numbers) | ratio(add // 0; length)),
       responses_per_merged_pr: ratio(($tp | total(.totals.responses)); $tp | total(.merged_prs)),
       context_per_merged_pr: (ratio(($tp | total(.totals.context)); $tp | total(.merged_prs)) | if . then round else . end),
       tool_chars_per_call: ratio(($tw | total(.totals.tool_chars)); $tw | total(.totals.tool_calls)),
       locate_read_share: ratio(($tw | total(.reads.locate_then_read)); $tw | total(.reads.reads)),
       reread_share: ratio(($tw | total(.reads.reread_same_lines)); $tw | total(.reads.reads)),
       cache_write_share: ratio(($tw | total(.totals.cache_write)); $tw | total(.totals.context)),
       start_share: ratio(($ts | total(.context_split.start)); $ts | total(.totals.context)),
       start_context_median: ($tw | map(.start_context_median | numbers) | median),
       compactions_per_session: ratio(($tw | total(.compactions)); $tw | total(.sessions)),
       rework_candidate_7d: reworked($bot; $t; $d; "rework_candidate_7d"),
       rework_verified_30d: reworked($bot; $t; $d; "rework_verified_30d")};
  # which way is better: -1 lower, 1 higher, 0 neither (sessions is volume, not quality)
  def better: {sessions: 0, merged_prs: 0, revert_rate: -1, interrupts_per_day: -1,
               cost_per_pr: -1, ci_red_per_pr: -1, first_pass_share: 1, plan_gate_deny_rate: -1, canary_runs: 0, canary_pass_rate: 1,
               canary_cost_per_task: -1, canary_min_per_task: -1, canary_turns_per_task: -1,
               responses_per_merged_pr: -1, context_per_merged_pr: -1, tool_chars_per_call: -1,
               locate_read_share: -1, reread_share: -1, cache_write_share: -1, start_share: -1, start_context_median: -1,
               compactions_per_session: -1, rework_candidate_7d: -1, rework_verified_30d: -1};'

# kpi_canary -> the canary score rows file, or /dev/null when there are none
kpi_canary() { [ -s "$CANARY" ] && printf '%s' "$CANARY" || printf /dev/null; }
# kpi_tokens -> each nightly token-usage snapshot (agent-usage tokens snapshot is its one writer), cut
# to the token KPIs' inputs, one a line; nothing when there are none
kpi_tokens() {
  local f=("$BENCH_TOKENS_DIR"/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].json)
  [ -e "${f[0]}" ] || return 0
  jq -c '{date, merged_prs, compactions, context_split, reads, start_context_median, sessions: ([.by_kind[]?.sessions | numbers] | add),
           totals: (.totals // {} | {responses, context, cache_write, tool_chars, tool_calls})}' "${f[@]}" 2>/dev/null || true
}

# kpi_live <now> -> the comms, judge, ask, startup, sandbox, pool and churn KPIs as one object
kpi_live() { jq -sc 'add' <(comms_kpi) <(judge_kpi) <(ask_kpi "$1") <(startup_kpi "$1") <(sandbox_kpi "$1") <(pool_kpi "$1") <(churn_kpi "$1"); }

# kpi_json <now> <ledger counts> [live] -> one object keyed by KPI, in table order. live is
# kpi_live's object, read now when not given. kpi --at gives {} and no counts, so the comms and the
# counted-now KPIs read null: nothing records them as of a past time. chain gives {}: it keeps only
# counted-now rows.
kpi_json() {
  local lim='{}' cm=${3:-}
  [ -r "$KPI_THRESHOLDS" ] && lim=$(grep -E '^[a-z0-9_]+=' "$KPI_THRESHOLDS" | kv_json)
  [ -n "$cm" ] || cm=$(kpi_live "$1")
  jq -n --argjson t "$1" --slurpfile o <(outcomes_newest) --slurpfile c <(ci_claimed) --slurpfile k "$(kpi_canary)" --slurpfile tk <(kpi_tokens) \
     --argjson pit "$(kv_json <<<"$2")" --argjson lim "$lim" --arg nowkeys "$KPI_NOW" \
     --argjson cm "$cm" --arg commskeys "$KPI_COMMS $KPI_JUDGE $KPI_ASKS $KPI_STARTUP $KPI_SANDBOX $KPI_POOL $KPI_CHURN" "$KPI_DEFS"'
    win($t; 7) as $w7 | win($t; 28) as $w28
    | [($w7 | keys_unsorted[] | {key: ., value: {"7d": $w7[.], "28d": $w28[.], now: false}}),
       ((($commskeys | split(" ")) + ([$cm, $lim | keys[] | select(startswith("runner_score_")) | sub("_(min|max)$"; "")] | unique))[]
        | {key: ., value: {"7d": ((($cm[.] // {})["7d"] | numbers) // null),
                           "28d": ((($cm[.] // {})["28d"] | numbers) // null), now: false}}),
       ($nowkeys | split(" ")[] | {key: ., value: {"7d": (($pit[.] | numbers) // null), "28d": null, now: true}})]
    | map(.key as $k | .value |= (
        (($lim[$k + "_max"] | numbers) // null) as $max | (($lim[$k + "_min"] | numbers) // null) as $min
        | . + {threshold: ($max // $min),
               bound: (if $max != null then "max" elif $min != null then "min" else null end)}
        | . + {status: (if .threshold == null or .["7d"] == null then "-"
                        elif (.bound == "max" and .["7d"] > .threshold)
                          or (.bound == "min" and .["7d"] < .threshold) then "past"
                        else "ok" end)}))
    | from_entries'
}

# kpi_now <now> -> kpi_json as of now, its ledger counts and live KPIs taken at once
kpi_now() {
  [ -n "${BENCH_READ_CACHE:-}" ] || { with_reads kpi_now "$@"; return; }
  local PAR PAR_PIDS
  par_open || return 1
  par_go counts ledger_counts
  par_go live kpi_live "$1"
  par_wait
  kpi_json "$1" "$(cat "$PAR/counts")" "$(cat "$PAR/live")"
}

# kpi_trend <now> <days> -> one object a day, oldest first: {date, <kpi>: its 7d value as of that
# day's end}. The outcome rows are the history, so a trend needs no store of its own.
kpi_trend() {
  local ch; ch=$(churn_rows) || ch=null
  jq -nc --argjson t "$1" --argjson n "$2" --argjson ch "$ch" --slurpfile o <(outcomes_newest) --slurpfile c <(ci_claimed) --slurpfile k "$(kpi_canary)" --slurpfile tk <(kpi_tokens) "$KPI_DEFS$CHURN_JQ"'
    range($n - 1; -1; -1) as $i | ($t - $i * 86400) as $at
    | {date: ($at | strflocaltime("%Y-%m-%d"))} + win($at; 7) + churn_kpis($ch; $at; 7)'
}

# kv_json -> key=value lines on stdin as one object; a value that is not a number is null
kv_json() { jq -Rn '[inputs | select(length > 0) | split("=") | {key: .[0], value: (.[1] | tonumber? // null)}] | from_entries'; }

# kpi_table <kpi json> -> the markdown table kpi prints and the scorecard carries
kpi_table() {
  jq -r '"| KPI | 7d | 28d | threshold | status |", "|---|---|---|---|---|",
    (to_entries[] | .value as $v
     | "| \(.key)\(if $v.now then " (now)" else "" end) | \($v["7d"] // "-") | \($v["28d"] // "-") | \(if $v.bound then "\($v.bound) \($v.threshold)" else "-" end) | \($v.status) |")' <<<"$1"
}

# vitals_json <kpi json> -> the BENCH_VITALS rows in their order, each with the question it answers. A key
# kpi_json does not carry stays as a row with no value: a dropped row reads as a healthy one.
vitals_json() {
  jq -c --arg v "$BENCH_VITALS" "$VITALS_JQ"'. as $k | [vitals($v)[] | {"7d": null, "28d": null, threshold: null, bound: null, status: "-", now: false} + ($k[.kpi] // {}) + .]' <<<"$1"
}

# vitals_table <kpi json> -> the front page: the scorecard's first table and `kpi --vitals`
vitals_table() {
  vitals_json "$1" | jq -r '"| Question | KPI | 7d | 28d | threshold | status |", "|---|---|---|---|---|---|",
    (.[] | "| \(.question) | \(.kpi)\(if .now then " (now)" else "" end) | \(.["7d"] // "-") | \(.["28d"] // "-") | \(if .bound then "\(.bound) \(.threshold)" else "-" end) | \(.status) |")'
}

# wakes_lines -> the calls-per-wake lines under the KPI table, from `agent-usage wakes` over the
# scorecard window. Each API call re-reads the session's whole context, so calls per wake is the cost.
# A background-task wake whose run passed has nothing left to decide: its target is WAKE_CALLS_TARGET.
# queue_stats <now>: agent-queue's own stats over the last BENCH_QUEUE_DAYS days, or a failure
# when it cannot be read. agent-queue owns the store and the formulas; this only reads them.
queue_stats() {
  local since
  since=$(date -d "@$(( $1 - BENCH_QUEUE_DAYS * 86400 ))" +%F)
  $BENCH_QUEUE_STATS_CMD --since "$since" 2>/dev/null | jq -ce 'select(.done and .by_project)' 2>/dev/null
}

# queue_line < stats: the window in one line (the briefing prints it as is)
queue_line() {
  jq -r --argjson days "$BENCH_QUEUE_DAYS" '
    def m($v): if $v == null then "-" elif $v >= 120 then "\($v / 60 | floor)h" else "\($v)m" end;
    ([.done[]] | add // 0) as $n
    | "queue \($days)d: \($n) done (\(.done.ok // 0) ok, \(.done.failed // 0) failed, \(.done.cancelled // 0) cancelled), "
      + "\([.by_project[].prs] | add // 0) with a PR, \($n / $days * 10 | round / 10)/day, "
      + "wait median \(m(.wait_minutes_median)) p90 \(m(.wait_minutes_p90)) (\(.started_at_once // 0) started at once), "
      + "to PR median \(m(.to_pr_minutes_median))"
      + (.sitting | if . == null then "" else "; sitting: \(.runnable) can start, oldest \(m(.oldest_runnable[0].minutes))" end)'
}

cmd_queue() {
  local s
  case "${1:-}" in ""|--json) ;; *) say "usage: fleet-bench queue [--json]"; return 2 ;; esac
  s=$(queue_stats "$(now)") || { say "agent-queue stats unreadable"; return 1; }
  if [ "${1:-}" = --json ]; then printf '%s\n' "$s"; else queue_line <<<"$s"; fi
}

# Items in, with $sessions (the state document's rows), $etas (a cell per target) and $since:
# the requests. An item finds its live session row by the Claude session ids its `sessions:`
# lists (the ledger join), never by window name: the newest such row when it has several.
# A request is an urgent item from the human or the shepherd; `<prefix>-pN` items
# linked by after: are one request, and n of m reads their phase numbers, so a plan queued from
# phase 3 says 3 of 6. The shepherd's own intake leads, each group in queue order: sorted by source
# alone a morning of human-queued items would bury the ask, and newest first would let the next ask
# bury it (ci-cleanup fell to third within the hour).
REQUESTS_JQ='
def prefix: sub("-p[0-9]+$"; "");
def pnum: (capture("-p(?<n>[0-9]+)$").n | tonumber) // null;
def asked: .priority == "urgent" and (.from == "human" or .from == "shepherd");
def live: .state != "done";
def open: any(.[]; live and asked);
def afters: .after // "" | split(" ") | map(select(. != ""));
def keyed: . as $all | map(. as $i | ($i.slug | prefix) as $p
  | . + {key: (if any($all[]; . as $o | (($i | afters | index([$o.slug])) != null or ($o | afters | index([$i.slug])) != null)
                 and ($o.slug | prefix) == $p)
               then $p else $i.slug end)});
def session_row($c): ($c.sessions // "" | split(" ") | map(select(. != ""))) as $ids
  | [$sessions[0][] | select(.session_id as $s | $ids | index($s))] | last;
def active_row: sort_by(.slug | pnum // 0) as $c
  | ($c | map(select(live)) | sort_by(.state == "queued") | first) as $cur
  | session_row($cur) as $s
  | ([$c[].slug | pnum] + [$c[] | (.phases // "") | split(" ")[] | tonumber?] | max) as $m
  | {request: $c[0].key, slugs: ($c | map(.slug)), project: $cur.project, from: $cur.from,
     queued: $cur.queued, slug: $cur.slug, n: ($cur.slug | pnum), m: $m, state: $cur.state,
     session: $cur.session, bucket: $s.bucket,
     pr: (if $s.pr_state == "OPEN" then $s.pr else null end), ci: (if $s.pr_state == "OPEN" then $s.ci else null end),
     eta: (if $s == null then null else $etas[0][$s.target] end),
     waits: (if $cur.state == "queued" then $cur.hold // "a dispatch slot"
             elif $s != null and $s.bucket != "WORKING" then $s.reason | sub("^waiting on "; "") else null end),
     report: ([$c[].report // empty] | last)};
def finished_row: sort_by(.finished) as $c
  | {request: $c[0].key, slugs: ($c | map(.slug)), project: $c[0].project, from: $c[0].from,
     finished: $c[-1].finished,
     outcome: (($c | map(.status // "unknown" | select(. != "ok")) | first) // "ok"),
     prs: ($c | map(.pr // empty)), report: ([$c[].report // empty] | last)};
group_by(.slug) | map(sort_by(live, .finished) | last) | keyed | group_by(.key)
| {since: $since,
   active: (map(select(open) | active_row)
            | sort_by(.from != "shepherd", .queued)),
   finished: (map(select(open | not) | map(select(.state == "done" and asked
                and (.finished // "1970-01-01T00:00:00Z" | fromdateiso8601) >= $since))
                | select(length > 0) | finished_row) | sort_by(.finished) | reverse)}
'

# The rows as the block that heads a summary. Every fact it cannot read stays out of its row.
REQUESTS_TEXT_JQ='
def cell($label; $v): if $v == null then empty else "\($label)\($v)" end;
"## Your requests", "",
(if (.active | length) == 0 then "No urgent request is active."
 else .active[] | "- " + ([.request,
     (if .n == null then empty else "\(.n) of \(.m)" end),
     (.state + (if .bucket == null then "" else "/\(.bucket)" end)),
     cell(""; .session),
     (if .pr == null then "no open PR" else "PR #\(.pr) CI \(.ci // "not read")" end),
     (if .eta == null then "no ETA" else "ETA \(.eta)" end),
     cell("waits on: "; .waits), cell("report: "; .report)] | join(", ")) end),
"", "Finished since \(.since | hm):",
(if (.finished | length) == 0 then "- nothing"
 else .finished[] | "- " + ([.request, .outcome,
     (if (.prs | length) == 0 then "no PR" else (.prs | map("#\(.)") | join(" ")) end),
     (.finished | fromdateiso8601 | hm), cell("report: "; .report)] | join(", ")) end)
'

# cmd_requests [--json] [--since T]: the human's requests, from the queue, the fleet state document
# and the ETAs. T defaults to the last rundown, so a finished request is told once.
cmd_requests() {
  local json=0 since='' t items first done_items sessions='[]' etas last out
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --since) since=$(throughput_epoch "${2:-}") || return 2; shift 2 ;;
      *) say "usage: fleet-bench requests [--json] [--since T]"; return 2 ;;
    esac
  done
  t=$(now)
  if [ -z "$since" ]; then
    last=$(ls -t "$RUNDOWNS"/*.md 2>/dev/null | awk 'NR==1')
    if [ -n "$last" ]; then since=$(stat -c %Y "$last"); else since=$((t - BENCH_WINDOW_H * 3600)); fi
  fi
  items=$(bench_read $BENCH_ITEMS_CMD) || { say "the agent queue is unreadable"; return 1; }
  # Done items go back to the oldest live chain as well as to T: an earlier phase holds its report.
  first=$(jq -rs --argjson s "$since" '[$s] + [.[] | select(.priority == "urgent" and .after != null) | .queued | fromdateiso8601] | min' <<<"$items")
  done_items=$(bench_read $BENCH_DONE_ITEMS_CMD --since "$(date -d "@$first" +%F)") || { say "the agent queue's done items are unreadable"; return 1; }
  [ -r "$STATE_FILE" ] && sessions=$(jq -c '.sessions // []' "$STATE_FILE")
  etas=$(latest_live | jq -cs "$JQ_LIB"'map(select(.eta != null or .finished)
    | {key: .target, value: (if .finished then "finished" else eta_cell end)}) | from_entries')
  out=$(printf '%s\n%s\n' "$items" "$done_items" | jq -cs --argjson since "$since" \
    --slurpfile sessions <(printf '%s\n' "$sessions") --slurpfile etas <(printf '%s\n' "$etas") "$REQUESTS_JQ") || return 1
  if [ "$json" = 1 ]; then printf '%s\n' "$out"; else jq -r "$JQ_LIB$REQUESTS_TEXT_JQ" <<<"$out"; fi
}

# queue_section <now>: the queue line, what is active now, and the outcomes by project and by
# source (human, shepherd, board, ...), in the scorecard
queue_section() {
  local s
  echo "## Queue"
  echo
  s=$(queue_stats "$1") || { echo "- queue ${BENCH_QUEUE_DAYS}d: ? (\`agent-queue stats\` unreadable)"; return 0; }
  echo "Items agent-queue finished in the last ${BENCH_QUEUE_DAYS} days, from its own timestamps (\`agent-queue stats\`). Wait is queued to started; to PR is queued to finished, for items that recorded a PR."
  echo
  jq -r 'def l: to_entries | map("\(.key) \(.value)") | join(", ") | if . == "" then "none" else . end;
    "- active now: \(.active | l)", "- per day: \(.per_day | l)"' <<<"$s"
  queue_line <<<"$s" | sed 's/^/- /'
  local by
  for by in project source; do
    echo
    echo "| ${by^} | Done | OK | Failed | Cancelled | PRs | Wait median | To PR median |"
    echo "|---|---|---|---|---|---|---|---|"
    jq -r --arg k "by_$by" 'def m($v): if $v == null then "-" else "\($v)m" end;
      .[$k] | to_entries | sort_by(-.value.done, .key)[] | .key as $n | .value
      | "| \($n) | \(.done) | \(.ok) | \(.failed) | \(.cancelled) | \(.prs) | \(m(.wait_minutes_median)) | \(m(.to_pr_minutes_median)) |"' <<<"$s"
  done
}

# models_json <now> [by]: per model and harness (the item's agent, claude when unset), the queue items
# finished in the last BENCH_QUEUE_DAYS days (the model= fleet-dispatch stamped at start) joined to
# their sessions' outcomes (cost_usd, reverts), and model-lane's runs in the same days by the model
# and harness they ran on (redo). Each item's verdict is the outcome agent-queue stamped on it at close
# (OUTCOME_JQ there: landed, no-pr, unrated, failed, cancelled); a cancel counts against no pairing.
# An item started before fleet-dispatch stamped model= takes the model its sessions spent most on
# (cost_by_model), or with no cost the one their rows name most (models), as the alias an item names
# (claude-opus-5-5 is opus); unrecorded is an item none of whose sessions has an outcomes row.
# An item's gateway_cost_usd beats its sessions' sum: one is metered dollars, the other a list-price
# estimate. A session counts once per row, however many items of a chain it ran. source says which
# a row's cost is, and mixed means it holds both. cost_per_pr divides by priced, the landed items with a known cost: a landed item with none would pass as free and pull
# the row under pairings that are fully priced. ci_prs are the landed items' PRs (prkeys) that
# have a pr-ci row: ci_red_per_pr is its red CI runs per PR, first_pass_share the
# share of those that ran a gate with no red gate run (the KPI of that name). points are the
# window points (source_attr) of the landed items' sessions, per pointed item: one with a known share.
# landed_rate is landed over landed_n, the items a harness could have landed (landed, no_pr, failed);
# an unrated item (a cause outside the model, a check or doc that opened no PR) is in done only, and a canary in canary alone. A run model-lane voided
# (voids.jsonl, `model-lane void`) is left out of runs, rated and redo; it still names its item's lane.
# by is a comma list of class and lane. lane is the model-lane lane the item's run logged under (the
# run its lane_run= names; unrouted when it has none), so a lane's trial candidate is scored on its
# own lane's landings; with lane alone, redo counts the runs of that lane. This is the evidence a
# lane graduates or demotes on.
models_json() {
  local since by="${2:-}"; since=$(( $1 - BENCH_QUEUE_DAYS * 86400 ))
  jq -cn --arg by "$by" --argjson days "$BENCH_QUEUE_DAYS" --argjson since "$since" \
     --slurpfile items <(bench_read $BENCH_DONE_ITEMS_CMD --since "$(date -d "@$since" +%F)" 2>/dev/null) \
     --slurpfile outcomes <(outcomes_latest) \
     --slurpfile runs <(jq -c 'select(.id and .ts)' "$BENCH_LANE_LOG" 2>/dev/null) \
     --slurpfile voids <([ ! -s "$BENCH_LANE_VOIDS" ] || jq -cR 'fromjson? | select(.id)' "$BENCH_LANE_VOIDS" 2>/dev/null) \
     --slurpfile ci <([ ! -s "$CI" ] || jq -c 'select(.repo and .number)' "$CI" 2>/dev/null) \
     --slurpfile sa <(source_attr "$1" | jq -c '.sessions') "$JQ_LIB"'
    def ratio($a; $b): if $b > 0 then ($a / $b * 100 | round / 100) else null end;
    ($by | split(",")) as $bys | ($bys | index("class") != null) as $cl | ($bys | index("lane") != null) as $ln
    | ($runs | INDEX(.id)) as $rix | ($voids | INDEX(.id)) as $vix
    | ($ci | INDEX(itemkey)) as $cix | ($sa[0] // {}) as $sp |
    def metered: (.gateway_cost_usd // "") != "";
    def alias: capture("^claude-(?<f>[a-z]+)-").f // .;
    def canary: (.from // "") == "canary" or ((.tags // "") | test("(^| )canary( |$)"));
    ($outcomes[0] // {}) as $o
    # own($h): the item sessions pair h ran itself. A claude session on an item of another harness is the
    # reviewer or lander it handed off to, so its cost and points are Claude, never the pair.
    | def own($h): [sids[] | select((($o[.].harness // "") == "claude" and $h != "claude") | not)];
      def cost_of($its; $h): ($its | map(select(metered) | .gateway_cost_usd | tonumber) | add // 0)
        + ($its | map(select(metered | not) | own($h)[]) | unique | map($o[.].cost_usd // 0) | add // 0);
      def cls: ([sids[] | $o[.].class // empty] | first) as $c
        | if $c then "\($c.kind // "untyped")/\($c.size // "-")" else "unclassed" end;
      def spent_most: [sids[] | $o[.] // empty] as $rows
        | ([$rows[] | .cost_by_model // {} | to_entries[] | select(.value > 0 and (.key | startswith("<") | not))]
            | group_by(.key) | map({key: .[0].key, usd: (map(.value) | add)}) | max_by(.usd) | .key)
          // ([$rows[] | .models // [] | .[] | select(startswith("<") | not)] | group_by(.) | max_by(length) | .[0]);
      ($items | map(. + {m: (((.model // spent_most) | if . then alias else . end) // "unrecorded"), h: (.agent // "claude"),
               c: (if $cl then cls else null end), l: (if $ln then $rix[.lane_run // ""].lane // "unrouted" else null end)})) as $all
    | ($all | map(select(.outcome != "cancelled"))) as $done
    | ($all | map(select(.outcome == "cancelled" and .end_reason == "returned"))) as $ret
    | ($runs | map(select(($vix[.id] | not) and (.ts | sub("\\+00:00$"; "Z") | fromdateiso8601) >= $since)
        | . + {h: (.harness // "claude"), ran: (.ran | if . then alias else . end), lane: (.lane // "unrouted")})) as $rs
    # $firsts: the first rated run of each item on any pair (eval lane left out), so an item a trainee had
    # rejected is a miss for the trainee pair and no first success for the claude run that landed it.
    | ($rs | map(select(.outcome and .lane != "eval")) | group_by(.item // .id) | map(min_by(.ts))) as $firsts
    | ([($done + $ret)[] | {m, h, c, l}] + (if $cl then [] else [$rs[] | {m: .ran, h, c: null, l: (if $ln then .lane else null end)}] end) | unique_by([.m, .h, .c, .l])) as $pairs
    | {days: $days, models: ($pairs | map(. as {m: $m, h: $h, c: $c, l: $l}
        | ($done | map(select(.m == $m and .h == $h and .c == $c and .l == $l))) as $ia
        | ($ia | map(select(canary | not))) as $it
        | ($ia | map(select(canary)) | length) as $canaries
        | ($it | map(select(landed)) | length) as $landed
        | ($it | map(sids[]) | unique | map($o[.] // empty)) as $sess
        | ($ia | map({landed: landed, canary: canary, source: (if metered then "gateway" elif any(own($h)[]; $o[.].cost_usd != null) then "list" else null end)})) as $priced_items
        | ($rs | map(select(($cl | not) and .ran == $m and .h == $h and (($ln | not) or .lane == $l)))) as $r
        | ($r | map(select(.outcome)) | length) as $rated
        | ($r | map(select(.outcome == "redo")) | length) as $redo
        | ($firsts | map(select(($cl | not) and .ran == $m and .h == $h and (($ln | not) or .lane == $l)))) as $first
        | ($first | map(select(.outcome == "ok")) | length) as $first_ok
        | cost_of($ia; $h) as $cost
        | ($priced_items | map(.source // empty) | unique) as $src
        | ($priced_items | map(select(.landed and .source and (.canary | not))) | length) as $priced
        | ($it | map(select(landed))) as $li
        | [$li | map(prkeys[]) | unique[] | $cix[.] // empty] as $cr
        | ($li | map(own($h)[]) | unique | map($sp[.].points // empty)) as $pt
        | ($li | map(select(any(own($h)[]; $sp[.].points != null))) | length) as $pointed
        | ($ret | map(select(.m == $m and .h == $h and .c == $c and .l == $l and (canary | not))) | length) as $returned
        | ($it | map(select(.outcome == "no-pr")) | length) as $no_pr
        | ($it | map(select(.outcome == "failed")) | length) as $failed
        | ($landed + $no_pr + $failed) as $ln_n
        | ($cr | map(select(ran_gate))) as $ran | ($ran | map(select(first_try)) | length) as $fp
        | {model: $m, harness: $h, done: ($it | length), canary: $canaries, returned: $returned, landed: $landed, no_pr: $no_pr, landed_rate: ratio($landed; $ln_n), landed_n: $ln_n, landed_ci: wilson($landed; $ln_n),
           failed: $failed, unrated: ($it | map(select(.outcome == "unrated")) | length),
           fix_none: ($li | map(select(.review_fix == "none")) | length), fix_small: ($li | map(select(.review_fix == "small")) | length),
           runs: ($r | length), approved: ($r | map(select(.outcome == "ok")) | length), rated: $rated, redo: $redo, redo_rate: ratio($redo; $rated),
           reverts: ($sess | map(.reverted_7d // 0) | add // 0),
           first_attempt_ok: $first_ok, first_attempt_n: ($first | length), first_attempt_rate: ratio($first_ok; $first | length), first_attempt_ci: wilson($first_ok; $first | length),
           cost_usd: (if $h != "claude" and ($src | length) == 0 then null else ($cost * 100 | round / 100) end), priced: $priced,
           cost_per_pr: (if $priced > 0 then (cost_of($it; $h) / $priced * 100 | round / 100) else null end),
           source: (if ($src | length) > 1 then "mixed" else ($src[0] // "-") end),
           ci_prs: ($cr | length), ci_red_per_pr: ratio($cr | map(.ci_red // 0) | add // 0; $cr | length),
           first_pass_share: ratio($fp; $ran | length), first_pass_n: ($ran | length), first_pass_ci: wilson($fp; $ran | length),
           points: (if $pointed > 0 then ($pt | add | round2) else null end),
           points_per_pr: (if $pointed > 0 then ($pt | add / $pointed | round2) else null end)}
          + (if $cl then {class: $c, runs: null, approved: null, rated: null, redo: null, redo_rate: null} else {} end)
          + (if $ln then {lane: $l} else {} end)))}'
}

# models_section <now> [by]: the models table, in the scorecard; by (a comma list) splits each pairing
# by class, the task class stamped on its sessions' outcome rows (kind/size, from the item's roadmap
# row), and by lane, the model-lane lane its run logged under
models_section() {
  local j by="${2:-}" cols="" lead=""
  echo "## Models"
  echo
  echo "Queue items finished in the last ${BENCH_QUEUE_DAYS} days by the model and harness they started on, joined to their sessions' outcomes; redo is model-lane's runs on that pairing that were put back in the queue (\`model-lane report\`), less the runs \`model-lane void\` voided. Each item is counted by the \`outcome\` agent-queue stamped at its close: Landed is done ok with a PR; No PR is done ok with no PR on a kind whose exit is a PR; Unrated is an item whose verdict says nothing of the model (a check or doc kind that opened no PR, an end outside the model); Rate is Landed over Landed, No PR and Failed; Returned are items sent back to their board row to wait on an ask, a hold or a gate (cancelled, \`end_reason: returned\`): a workflow wait, in no Done, Rate or Failed. Source says what a cost is: list is an estimate at list price, not money paid; gateway is dollars metered at the LiteLLM gateway; mixed holds both. Per PR counts only PRs with a known cost. CI red is red CI runs per landed PR with a \`pr-ci\` row, first pass the share of those green first time. Points are percent points of the pairing's sources' weekly windows its landed items' sessions used (\`fleet-bench sources\`), per PR with a known share. Counts, not a winner: pairings ran different tasks."
  echo
  j=$(models_json "$1" "$by") || { echo "- models: ? (queue or outcomes unreadable)"; return 0; }
  case ",$by," in *,class,*)
    echo "Class is kind/size of the item's roadmap row, stamped on its sessions' outcome rows by \`agentctl-session-outcomes\`; unclassed is an item none of whose sessions carries one (a row written before the stamp, or no row). Redo is model-lane's and has no class, so it is left out."
    echo
    cols="Class | "; lead='\(.class) | ' ;;
  esac
  case ",$by," in *,lane,*)
    echo "Lane is the model-lane lane the item's run logged under (the run its \`lane_run=\` names); unrouted is an item that started with none."
    echo
    cols="${cols}Lane | "; lead="${lead}"'\(.lane) | ' ;;
  esac
  echo "An item that ended for a cause outside the model (\`end_reason\` ${UNRATED_ENDS// /, }: a quota end, a provider failure, a kill) is Unrated: in Done, not in Rate or Failed. A canary item (\`from: canary\`) is an eval, not work: it is in the Canary column and in no other count of the row but Cost, so Done, Landed and Rate are real work only. First attempt is the share of items whose first rated run, on any pairing, was this one's and approved (a trainee diff the review rejected is a miss for its harness, and no first success for the Claude run that lands the row after); runs in lane eval are left out. Redo counts model-lane runs, not items, so a canary run outside lane eval still shows there. Cost and Points count only the sessions the pairing ran itself, never the Claude reviewer's or lander's, and Cost reads - when none of them has a price (agy publishes none)."
  echo
  echo "Rate and First pass show their Wilson 95% interval and n (rated items; PRs whose CI ran a gate), so a rate on a few items reads as the range it is; CI red is a mean count per PR, so it shows its n (PRs with a \`pr-ci\` row) and no interval."
  echo
  local redo_h="Redo | " redo_c='\(.redo) | ' hdr
  case ",$by," in *,class,*) redo_h="" redo_c="" ;; esac
  hdr="${cols}Model | Harness | Done | Canary | Returned | Landed | No PR | Unrated | Rate | Failed | ${redo_h}First attempt | Reverts | Cost | Per PR | Source | CI red | First pass | Points | Points per PR"
  echo "| $hdr |"
  echo "|$(sed 's/[^|][^|]*/---/g' <<<"$hdr")|"
  jq -r "$JQ_LIB"'def d: if . == null then "-" else tostring end;
    .models | sort_by(.class, .lane, -.done)[]
    | "| '"$lead"'\(.model) | \(.harness) | \(.done) | \(.canary) | \(.returned) | \(.landed) | \(.no_pr) | \(.unrated) | \(ci_cell(.landed_rate; .landed_ci; .landed_n)) | \(.failed) | '"$redo_c"'\(ci_cell(.first_attempt_rate; .first_attempt_ci; .first_attempt_n)) | \(.reverts) | \(if .cost_usd == null then "-" else "$\(.cost_usd)" end) | \(if .cost_per_pr == null then "-" else "$\(.cost_per_pr)" end) | \(.source) | \(if .ci_red_per_pr == null then "-" else "\(.ci_red_per_pr) (n \(.ci_prs))" end) | \(ci_cell(.first_pass_share; .first_pass_ci; .first_pass_n)) | \(.points | d) | \(.points_per_pr | d) |"' <<<"$j"
}

# trainee_section <now>: the trainee ladder in the scorecard. Per pair (lane trainee in model-lane's log,
# the models table's own join): runs, approved (the batch review's ok), rejected (redo), landed (done ok
# with a PR, outcome landed). Then the pool and the floor as fleet-dispatch reads them (BENCH_TRAINEE_CMD).
trainee_section() {
  local j p
  echo "## Trainee"
  echo
  echo "Free-model pairs on easy rows, over the last ${BENCH_QUEUE_DAYS} days: runs logged under lane trainee (a promoted pair's direct runs log there too, with no review), approved and rejected by the batch review or the run's own outcome, landed is done ok with a PR, split by what the review changed first (the item's \`review_fix\`: none, small; a landing the review did not record counts in neither, and a rejected diff is the Rejected column). Pool is the open agent-board rows a trainee takes, with the commonest refusal; floor is whether dispatch starts trainee runs at the time this scorecard ran, and why not (\`fleet-dispatch trainee-pool\`). Promotion bars: \`model-lane score --dry\`."
  echo
  if p=$($BENCH_TRAINEE_CMD 2>/dev/null) && jq -e '.floor' <<<"$p" >/dev/null 2>&1; then
    jq -r '"- Pool: \(.eligible) of \(.rows) open agent-board rows" + (if (.refused | length) > 0 then ", most turned away: \(.refused[0].why) (\(.refused[0].count))" else "" end)
      + "\n- Floor now: \(.floor.state)" + (if .floor.why != "" then ", \(.floor.why)" else "" end)' <<<"$p"
  else
    echo "- Pool and floor: ? (fleet-dispatch trainee-pool unreadable)"
  fi
  j=$(models_json "$1" lane) || { echo "- Pairs: ? (queue or outcomes unreadable)"; return 0; }
  echo
  if ! jq -e '.models | map(select(.lane == "trainee")) | length > 0' <<<"$j" >/dev/null; then
    echo "- Pairs: no trainee runs in the window"; return 0
  fi
  echo "| Pair | Runs | Approved | Rejected | Landed | Landed as is | Landed with a small fix |"
  echo "|---|---|---|---|---|---|---|"
  jq -r '.models | map(select(.lane == "trainee")) | sort_by(-.runs, .harness, .model)[]
    | "| \(.harness):\(.model) | \(.runs) | \(.approved) | \(.redo) | \(.landed) | \(.fix_none) | \(.fix_small) |"' <<<"$j"
}

cmd_models() {
  local j by="" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --by) case "${2:-}" in
              class | lane) by=$2 ;;
              class,lane | lane,class) by=class,lane ;;
              *) say "models: --by takes class, lane or class,lane"; return 2 ;;
            esac; shift 2 ;;
      *) say "usage: fleet-bench models [--by class,lane] [--json]"; return 2 ;;
    esac
  done
  j=$(models_json "$(now)" "$by") || { say "the queue or the outcomes are unreadable"; return 1; }
  if [ "$json" = 1 ]; then printf '%s\n' "$j"; else models_section "$(now)" "$by" | sed '1,4d'; fi
}

# skills_json <now>: per skill, the queue items finished in the last BENCH_QUEUE_DAYS days whose
# sessions ran it (outcome rows' uses.skills, and uses.slash naming a dir in BENCH_SKILLS_DIR, so a
# dispatched /one-shot counts), joined to what came of them. Landed, unrated and the CI columns read
# as in models_json; the other columns and the two extra rows: the fleet-bench skill, `skills`.
skills_json() {
  local since reds read=true names REDS_DAYS=$BENCH_QUEUE_DAYS; since=$(( $1 - BENCH_QUEUE_DAYS * 86400 ))
  reds=$(reds_json "$1") || read=false   # reds_json said why; the reds columns read ?, the rest stands
  names=$(find -L "$BENCH_SKILLS_DIR" -mindepth 2 -maxdepth 2 -name SKILL.md 2>/dev/null \
    | awk -F/ '{print $(NF-1)}' | jq -Rsc 'split("\n") | map(select(. != ""))')
  jq -cn --argjson days "$BENCH_QUEUE_DAYS" --argjson names "$names" --argjson read "$read" \
     --slurpfile items <(bench_read $BENCH_DONE_ITEMS_CMD --since "$(date -d "@$since" +%F)" 2>/dev/null) \
     --slurpfile o <(outcomes_newest | jq -cs 'map({key: .session_id, value: {uses, prs}}) | from_entries') \
     --slurpfile reds <(printf '%s\n' "$reds" | jq -cs 'map(select(.slug and (.cleanup | not)) | {key: .slug, value: .outcome}) | from_entries') \
     --slurpfile ci <([ ! -s "$CI" ] || jq -c 'select(.repo and .number)' "$CI" 2>/dev/null) "$JQ_LIB"'
    def bare: sub("^[^:]+:"; "");
    ($o[0] // {}) as $o | ($reds[0] // {}) as $r | ($ci | INDEX(itemkey)) as $cix
    | ($items | map(prkeys as $pk | (sids | map($o[.] // empty)) as $rows
        | {outcome, landed: landed, pk: $pk,
           skills: ([$rows[] | (.uses.skills // {} | keys[] | bare), (.uses.slash // {} | keys[] | bare | select(IN($names[])))] | unique),
           reverted: any($rows[] | .prs // [] | .[]; .reverted == true and (itemkey | IN($pk[]))),
           tried: ((.fix_tries // "") != ""), red: $r[.slug]})) as $done
    | def score($name; $it):
        ($it | map(select(.outcome != "cancelled"))) as $n
        | ($n | map(select(.landed))) as $l
        | ($n | map(select(rated)) | length) as $rated
        | [$l | map(.pk[]) | unique[] | $cix[.] // empty] as $cr
        | ($cr | map(select(ran_gate))) as $ran
        | ($n | map(select(.tried))) as $tried
        | ($n | map(select(.red == "fixed"))) as $rok
        | ($n | map(select(.red | IN("still red", "came back")))) as $rbad
        | {skill: $name, items: ($n | length), cancelled: (($it | length) - ($n | length)),
           landed: ($l | length), rated: $rated, landed_rate: ratio($l | length; $rated),
           failed: ($n | map(select(.outcome == "failed")) | length),
           held: ($l | map(select(.reverted | not)) | length), held_rate: ratio($l | map(select(.reverted | not)) | length; $l | length),
           ci_prs: ($cr | length), ci_red_per_pr: ratio($cr | map(.ci_red // 0) | add // 0; $cr | length),
           gated: ($ran | length), first_pass: ($ran | map(select(first_try)) | length),
           first_pass_share: ratio($ran | map(select(first_try)) | length; $ran | length),
           fix_tried: ($tried | length), fixed: ($tried | map(select(.landed)) | length),
           fixed_rate: ratio($tried | map(select(.landed)) | length; $tried | length),
           reds: (if $read then ($rok + $rbad) | length else null end), reds_held: (if $read then $rok | length else null end),
           reds_held_rate: (if $read then ratio($rok | length; ($rok + $rbad) | length) else null end)};
      {days: $days,
       skills: ([score("all items"; $done)]
         + ($done | map(.skills[]) | unique | map(. as $s | score($s; $done | map(select(.skills | index($s))))) | sort_by(-.items, .skill))
         + [score("none recorded"; $done | map(select(.skills == [])))])}'
}

cmd_skills() {
  local j json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --days) [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || { say "skills: --days takes a day count"; return 2; }
              BENCH_QUEUE_DAYS=$2; shift 2 ;;
      *) say "usage: fleet-bench skills [--days N] [--json]"; return 2 ;;
    esac
  done
  j=$(skills_json "$(now)") || { say "the queue or the outcomes are unreadable"; return 1; }
  if [ "$json" = 1 ]; then printf '%s\n' "$j"; return 0; fi
  echo "Queue items finished in the last ${BENCH_QUEUE_DAYS} days, by each skill their sessions ran (outcome rows' Skill calls and skill slash commands). Each ratio carries its count: held is landed with its PR not reverted, CI red is red CI runs per landed PR with a pr-ci row, first pass the share of those green at the gate first time, fixed is landed after a fix-ci try, reds held is a red fix that \`fleet-bench reds\` reads fixed (? when it cannot be read). Counts, not a grade: skills ran different tasks."
  echo
  echo "| Skill | Items | Cancelled | Landed | Failed | Held | CI red | First pass | Fixed after fix-ci | Reds held |"
  echo "|---|---|---|---|---|---|---|---|---|---|"
  jq -r 'def c($r; $a; $b): if $b == 0 then "-" else "\($r) (\($a)/\($b))" end;
    .skills[] | "| \(.skill) | \(.items) | \(.cancelled) | \(c(.landed_rate; .landed; .rated)) | \(.failed) | \(c(.held_rate; .held; .landed)) | \(if .ci_prs == 0 then "-" else "\(.ci_red_per_pr) (\(.ci_prs) PRs)" end) | \(c(.first_pass_share; .first_pass; .gated)) | \(c(.fixed_rate; .fixed; .fix_tried)) | \(if .reds == null then "?" else c(.reds_held_rate; .reds_held; .reds) end) |"' <<<"$j"
}

# source_attr <now> -> every claude-acct source over the last BENCH_QUEUE_DAYS, and which source each
# session and landed item spent from. Points and list dollars come from VictoriaMetrics (vm_map), since
# Prometheus keeps about 2 days and the landed counts cover the whole window. Points are percent points of a source's own window: the sum of
# every 15-minute rise in its published used percent (a reset is a fall, so it adds nothing, and the
# step it falls in loses what was spent after it). A pool's points hold its keys' spend, so its landed
# counts its keys' items too. A session
# is on its harness's harnesses.json `source`, or for claude and a harness with no source (claude-cloud)
# on its account (the outcome row's config dir); an item on its agent's source, its `account:`, else its
# sessions'. An item on none is counted by why (unattributed_why): it names no session, none of its
# sessions has an outcome row yet (a hand session's lands when it ends), or their rows name no
# account. A session's share of its
# source's points is its share of the tokens all of that source's sessions in the window used: an
# estimate, and the only per-session measure every harness records; tokens_total is the session's
# whole life, so one that began before the window is over-weighted. Dollars: a Claude account's are
# Claude Code's list-price cost counter by login email (null with no email), a dollar-capped source's are its points of
# its budget (metered at the gateway), and a Codex or agy source's are the sum of its priced sessions' outcome
# cost_usd: the harnesses.json price table, applied once by agentctl-session-outcomes, which
# `agent-usage budget` sums too (burn's other_harness). Each part that cannot be read is null.
source_attr() {
  local t="$1" days="$BENCH_QUEUE_DAYS" since rows pts usd hs holds
  [ -z "${SOURCE_ATTR_JSON:-}" ] || { printf '%s\n' "$SOURCE_ATTR_JSON"; return 0; }   # the scorecard reads it once
  since=$(( t - days * 86400 ))
  rows=$($BENCH_SOURCES_CMD 2>/dev/null | jq -ce 'arrays' 2>/dev/null) || rows=null
  pts=$(vm_map account "sum by (account) (sum_over_time((clamp_min(max by (account) (claude_account_week_used_percent) - max by (account) (claude_account_week_used_percent offset 15m), 0))[${days}d:15m]))" "$t" 2>/dev/null) || pts=null
  holds=null
  [ "$rows" = null ] || holds=$($BENCH_HOLDS_CMD 2>/dev/null | jq -ce 'objects' 2>/dev/null) || holds=null
  usd=$(vm_map user_email "sum by (user_email) (increase(claude_code_cost_usage_USD_total[${days}d]))" "$t" 2>/dev/null) || usd=null
  hs=$(jq -ce '.harnesses // {} | map_values(.source)' "$BENCH_HARNESSES" 2>/dev/null) || hs='{}'
  jq -cn --argjson rows "${rows:-null}" --argjson pts "${pts:-null}" --argjson usd "${usd:-null}" --argjson hs "$hs" --argjson holds "${holds:-null}" \
     --argjson since "$since" --argjson t "$t" --argjson days "$days" \
     --slurpfile o <(outcomes_newest) \
     --slurpfile items <(bench_read $BENCH_DONE_ITEMS_CMD --since "$(date -d "@$since" +%F)" 2>/dev/null) "$JQ_LIB"'
    def dirkey: if (.dir // "") == "" then "claude" else .dir | sub("/+$"; "") | split("/") | last | ltrimstr(".") end;
    ($rows // []) as $R
    | ([$R[] | select(.kind == "claude") | {key: dirkey, value: .name}, {key: .name, value: .name}] | from_entries) as $acct
    | def acct: $acct[(. // "") | ltrimstr(".")];
      def on: (.harness // "claude") as $h | if $h == "claude" then .account | acct else $hs[$h] // (.account | acct) end;
      ($o | INDEX(.session_id)) as $os
    | ($o | map(select((.updated_epoch // 0) > $since and .updated_epoch <= $t)
              | {sid: .session_id, src: on, w: (.tokens_total // 0), usd: .cost_usd} | select(.src))) as $ws
    | ($ws | group_by(.src) | map({key: .[0].src, value: (map(.w) | add)}) | from_entries) as $wsum
    | ($ws | map(select(.usd != null)) | group_by(.src) | map({key: .[0].src, value: (map(.usd) | add)}) | from_entries) as $priced
    | ($ws | map({key: .sid, value: {source: .src,
        points: (if $pts[.src] == null or ($wsum[.src] // 0) == 0 then null else $pts[.src] * .w / $wsum[.src] end)}}) | from_entries) as $sess
    | def item_src: (.agent // "claude") as $h | (.account // "") as $a
        | sids as $ids
        | if $h != "claude" then $hs[$h] // (.account | acct)
          else (.account | acct) // ([$ids[] | $os[.] // empty | on // empty] | first) end
        | {src: ., why: (if . != null then null elif $a != "" then "unknown_account" elif $ids == [] then "no_session"
                         elif any($ids[]; $os[.] != null) then "no_account" else "no_outcome" end)};
      [$items[] | select(landed) | item_src] as $L
    | ($L | map(.src)) as $landed
    | ($R | map({key: .name, value: .parent}) | from_entries) as $parent
    | {days: $days, read: {sources: ($rows != null), points: ($pts != null), usd: ($usd != null), holds: ($holds != null)}, sessions: $sess,
       unattributed: ($landed | map(select(. == null)) | length),
       unattributed_why: ($L | map(.why // empty) | group_by(.) | map({key: .[0], value: length}) | from_entries),
       sources: [$R[] | .name as $n | ($pts[$n] | if . == null then . else round2 end) as $p
         | (if .usd_max != null then (if $p == null then null else $p * .usd_max / 100 end)
            elif .kind == "claude" then (if $usd == null or (.email // "") == "" then null else $usd[.email] // 0 end)
            elif .kind == "codex" or .kind == "agy" then $priced[$n]
            else null end) as $d
         | ([$landed[] | select(. == $n or $parent[. // ""] == $n)] | length) as $l
         | {name: $n, kind, parent, used: .week_used, hold: ($holds[$n] // null), points: $p,
            usd: ($d | if . == null then . else round2 end),
            usd_src: (if .usd_max != null then "gateway" elif .kind == "claude" or .kind == "codex" or .kind == "agy" then "list" else null end),
            landed: $l,
            usd_per_point: (if $d == null or ($p // 0) <= 0 then null else ($d / $p | round2) end),
            prs_per_point: (if ($p // 0) <= 0 then null else ratio($l; $p) end),
            points_per_pr: (if $p == null or $l == 0 then null else ($p / $l | round2) end)}]}'
}

# sources_json <now> -> source_attr without the per-session map; rc 1 when the sources are unreadable
sources_json() {
  source_attr "$1" | jq -ce 'select(.read.sources) | del(.sessions)'
}

# sources_section <now>: the sources table, in the scorecard
sources_section() {
  local j
  echo "## Sources"
  echo
  echo "Every model source \`claude-acct\` lists, over the last ${BENCH_QUEUE_DAYS} days. Points are percent points of the source's own window used (the sum of its rises), so a plan and a budget compare in one unit; a key spends inside its parent pool, so the pool's points hold its keys'. Dollars: list is the API list price, no money paid on a plan (Claude Code's own counter for a Claude account, the harnesses.json price table for Codex and agy, which has none yet, so agy reads -), gateway is metered spend. Landed is queue items done ok with a PR, by the source they ran on. Dollars and PRs per point say what a point of each source buys: the number a purchase is decided on."
  echo
  j=$(sources_json "$1") || { echo "- sources: ? (claude-acct status unreadable)"; return 0; }
  sources_table "$j"
}

# sources_table <sources json>: the table sources prints and the scorecard carries
sources_table() {
  jq -r 'def d: if . == null then "-" else tostring end;
    (if .read.points then empty else "- points: ? (VictoriaMetrics unreadable)", "" end),
    (if .read.holds then empty else "- holds: ? (fleet-dispatch provider-holds unreadable, so a held source reads as free)", "" end),
    "| Source | Kind | Used now | Hold | Points | Dollars | Landed | $ per point | PRs per point | Points per PR | Parent |",
    "|---|---|---|---|---|---|---|---|---|---|---|",
    (.sources[] | "| \(.name) | \(.kind) | \(.used | if . == null then "-" else "\(. | floor)%" end) | \(.hold // "-") | \(.points | d) | \(if .usd == null then "-" else "$\(.usd) \(.usd_src)" end) | \(.landed) | \(if .usd_per_point == null then "-" else "$\(.usd_per_point)" end) | \(.prs_per_point | d) | \(.points_per_pr | d) | \(.parent // "-") |"),
    (if .unattributed > 0 then "", "- landed on no source: \(.unattributed) (" + ([(.unattributed_why // {}) | to_entries[]
        | "\(.value) " + ({no_session: "name no session", no_outcome: "whose sessions have no outcome row yet (a hand session'"'"'s lands when it ends)",
                           no_account: "whose sessions'"'"' outcome rows name no account",
                           unknown_account: "whose account is no source'"'"'s"}[.key] // .key)] | join(", ")) + ")" else empty end)' <<<"$1"
}

cmd_sources() {
  local j json=0
  case "${1:-}" in
    '') ;;
    --json) json=1 ;;
    *) say "usage: fleet-bench sources [--json]"; return 2 ;;
  esac
  j=$(sources_json "$(now)") || { say "the sources are unreadable (claude-acct status)"; return 1; }
  if [ "$json" = 1 ]; then printf '%s\n' "$j"; else sources_table "$j"; fi
}

# sizes_json <now> -> the size calibration and per-kind cycle time over BENCH_SIZES_DAYS: each
# done item (cancelled left out) joined through its `row:` to that row on its project's roadmap,
# which gives the size, the weight and the kind (the item's own `type:` when no row is found).
# A size is calibrated at BENCH_SIZES_MIN or more items with work_min; its measured weight is its
# median work over the median of the calibrated weight-1 size with the most items. Percentiles
# are nearest rank. .bands is the median work of each #pts band (s, m, l: notes-cli
# epics::POINTS) over the items closed ok in the last BENCH_BANDS_DAYS whose row carries #pts (a
# bare #size/ tag is not scored by the size rubric, and most closes have only that), whether they
# climb: inverted when l is not slower than m or m not slower than s (a tie counts), each pair
# read only when both its bands have BENCH_SIZES_MIN items; thin when no pair is out of order
# but a band is under that.
# the size rubric's minutes (.config/inbox-size/prompt.md, agentctl-inbox-triage) are provisional on that order.
sizes_json() {
  local since bands_since rows projects p items
  since=$(( $1 - BENCH_SIZES_DAYS * 86400 )) bands_since=$(( $1 - BENCH_BANDS_DAYS * 86400 ))
  items=$(bench_read $BENCH_DONE_ITEMS_CMD --since "$(date -d "@$(( since < bands_since ? since : bands_since ))" +%F)" 2>/dev/null | jq -cs .) || return 1
  projects=$(jq -r '.[].row // empty | select(test(":")) | split(":")[0]' <<<"$items" | sort -u)
  # the roadmaps go in as a file: a big project's is past the length of one argument
  rows=$(for p in $projects; do
      $BENCH_ROADMAP_CMD "$p" --json 2>/dev/null | jq -c --arg p "$p" 'arrays | .[].rows[]? | {key: "\($p):\(.id)", value: ({size, weight, kind} + if has("pts") then {pts} else {} end)}'
    done | jq -cs 'from_entries')
  jq -cn --argjson days "$BENCH_SIZES_DAYS" --argjson bdays "$BENCH_BANDS_DAYS" --argjson min "$BENCH_SIZES_MIN" \
     --argjson since "$since" --argjson bsince "$bands_since" \
     --slurpfile items <(printf '%s\n' "$items") --slurpfile rows <(printf '%s\n' "$rows") "$JQ_LIB"'
    def pct($p): sort | if length == 0 then null else .[((length * $p) | ceil) - 1] end;
    def epoch: if . == null or . == "" then null else (sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601) end;
    def hours: if . == null then null else (. / 3600 * 10 | round / 10) end;
    $rows[0] as $R
    | [$items[0][] | select(.status != "cancelled") | ((.finished | epoch) // 0) as $fin
       | ($R[.row // ""]) as $r
       | {fin: $fin, ok: (.status == "ok"), size: ($r.size // ""), pts: $r.pts, weight: $r.weight, kind: ($r.kind // .type // "untyped" | if . == "" then "untyped" else . end),
          landed: landed,
          work: (.work_min // "" | tonumber? // null),
          cycle: (if (.started | epoch) and (.finished | epoch) then (.finished | epoch) - (.started | epoch) else null end),
          lead: (if (.queued | epoch) and (.finished | epoch) then (.finished | epoch) - (.queued | epoch) else null end)}] as $read
    | ($read | map(select(.fin >= $since))) as $all
    | ($all | map(select(.work != null))) as $timed
    | ($timed | map(select(.size != "")) | group_by(.size)
       | map({size: .[0].size, weight: .[0].weight, n: length, calibrated: (length >= $min),
              work_p50: (map(.work) | pct(0.5)), work_p75: (map(.work) | pct(0.75))})) as $sz
    | ($sz | map(select(.calibrated and .weight == 1)) | sort_by(-.n) | first) as $base
    | ($read | map(select(.fin >= $bsince and .ok and .work != null and .pts != null)) as $bt
       | ["s", "m", "l"] | map(. as $k | $bt | map(select(.size == $k) | .work) | {key: $k, value: {n: length, p50: pct(0.5)}})
       | from_entries) as $b
    | {days: $days, min_n: $min, base: ($base.size // null),
       sizes: ($sz | sort_by(.weight, .size) | map(. + {
         per_point: (if .calibrated then (.work_p50 / .weight * 10 | round / 10) else null end),
         measured_weight: (if .calibrated and $base != null and $base.work_p50 > 0 then (.work_p50 / $base.work_p50 * 10 | round / 10) else null end)})),
       unsized: ($timed | map(select(.size == "")) | length),
       kinds: ($all | group_by(.kind) | map({kind: .[0].kind, done: length, landed: (map(select(.landed)) | length),
         work_p50: (map(.work // empty) | pct(0.5)),
         cycle_p50_h: (map(.cycle // empty) | pct(0.5) | hours), cycle_p90_h: (map(.cycle // empty) | pct(0.9) | hours),
         lead_p50_h: (map(.lead // empty) | pct(0.5) | hours)}) | sort_by(-.done, .kind)),
       bands: ($b + {days: $bdays,
         thin: ["s", "m", "l"] | map(select($b[.].n < $min)),
         out_of_order: [["s", "m"], ["m", "l"]] | map(. as [$lo, $hi]
           | select($b[$lo].n >= $min and $b[$hi].n >= $min and $b[$hi].p50 <= $b[$lo].p50) | "\($hi) not slower than \($lo)")}
         | .status = (if ($R | length) > 0 and ($R | [.[] | has("pts")] | any | not) then "unreadable" elif (.out_of_order | length) > 0 then "inverted" elif (.thin | length) > 0 then "thin" else "ok" end))}'
}

# bands_line <sizes json>: its .bands as the one scorecard and probe row
bands_line() {
  jq -r '.min_n as $min | .bands | def b($k): "\($k) \(.[$k].p50 // "-") min (\(.[$k].n))";
    "- work p50 by #pts band, last \(.days)d of closes: \(b("s")), \(b("m")), \(b("l")): "
    + if .status == "inverted" then "inverted, " + (.out_of_order | join(", ")) else "" end
    + if (.thin | length) > 0 then (if .status == "inverted" then "; " else "" end) + "too few to order \(.thin | join(", ")) (under \($min))" else "" end
    + if .status == "ok" then "climbs" elif .status == "unreadable" then "unreadable, no roadmap row carries pts (the notes binary predates it)" else "" end' <<<"$1"
}

# sizes_section <now>: the size calibration, the band row and the per-kind cycle time, in the scorecard
sizes_section() {
  local j
  echo "## Sizes and kinds"
  echo
  echo "Queue items finished in the last ${BENCH_SIZES_DAYS} days, joined through their \`row:\` to the row's size and kind on its roadmap. Work is the items' work_min (minutes a session was working). A size is calibrated at ${BENCH_SIZES_MIN} or more items; its measured weight is its median work over the base size's, to set beside the weight the rollups use. Cycle is started to finished, lead is queued to finished."
  echo
  j=$(sizes_json "$1") || { echo "- sizes: ? (the done queue items are unreadable)"; return 0; }
  sizes_tables "$j"
}

# sizes_tables <sizes json>: the size table, the band row and the kind table
sizes_tables() {
  jq -r 'def d: if . == null then "-" else tostring end;
    "| Size | Weight | Items | Work p50 min | Work p75 min | Min per point | Measured weight |",
    "|---|---|---|---|---|---|---|",
    (.min_n as $m | .sizes[] | "| \(.size) | \(.weight) | \(.n) | " + (if .calibrated
       then "\(.work_p50) | \(.work_p75) | \(.per_point) | \(.measured_weight | d) |"
       else "- | - | - | too few (\(.n) of \($m)) |" end)),
    "",
    "- base size: \(.base // "none calibrated"); items with work_min and no sized row: \(.unsized)"' <<<"$1"
  bands_line "$1"
  echo
  jq -r 'def d: if . == null then "-" else tostring end;
    "| Kind | Done | Landed | Work p50 min | Cycle p50 h | Cycle p90 h | Lead p50 h |",
    "|---|---|---|---|---|---|---|",
    (.kinds[] | "| \(.kind) | \(.done) | \(.landed) | \(.work_p50 | d) | \(.cycle_p50_h | d) | \(.cycle_p90_h | d) | \(.lead_p50_h | d) |")' <<<"$1"
}

# sizes [--json|--check]: --check prints the band row and exits 1 when it is inverted, 2 when the
# closes are unreadable. A thin window (a band under BENCH_SIZES_MIN items) exits 0, unlike
# startup --check's blind recorder: a quiet week leaves the rubric unmeasured, not wrong.
cmd_sizes() {
  local j
  case "${1:-}" in ""|--json|--check) ;; *) say "usage: fleet-bench sizes [--json|--check]"; return 2 ;; esac
  j=$(sizes_json "$(now)") || { say "sizes: the done queue items are unreadable"; [ "${1:-}" = --check ] && return 2; return 1; }
  case "${1:-}" in
    '') sizes_tables "$j" ;;
    --json) printf '%s\n' "$j" ;;
    --check)
      bands_line "$j" || return 2
      case "$(jq -r .bands.status <<<"$j")" in ok|thin) return 0 ;; inverted) return 1 ;; *) return 2 ;; esac ;;
  esac
}

wakes_lines() {
  local w win="${BENCH_WINDOW_H}h"
  w=$($BENCH_WAKES_CMD --since "$win" --json 2>/dev/null) && jq -e .all <<<"$w" >/dev/null 2>&1 \
    || { echo "- calls per passing wake ($win): ? (\`agent-usage wakes\` unreadable)"; echo "- calls per wake, all ($win): ?"; return 0; }
  jq -r --argjson target "$WAKE_CALLS_TARGET" --arg win "$win" '
    (.rows | map(select(.trigger == "background-task" and .verdict == "pass")) | first) as $p
    | (if $p == null then "- calls per passing wake (\($win)): - (no passing background-task wake)"
       else "- calls per passing wake (\($win)): median \($p.median) over \($p.wakes) wakes, target \($target) or fewer: \(if $p.median > $target then "past" else "ok" end)" end),
      "- calls per wake, all (\($win)): " + (if .all.wakes == 0 then "-"
        else "median \(.all.median), p90 \(.all.p90) over \(.all.wakes) wakes" end)' <<<"$w"
}

# report_line <command> <label>: one scorecard row another tool writes (the nightly token-usage
# row, the newest stored week from day-log).
report_line() {
  local l
  l=$($1 2>/dev/null) && [ -n "$l" ] || l="$2: ? (\`$1\` unreadable)"
  echo "- $l"
}

# kpi_past <json>: one line per KPI in it past its threshold, and exit 1 when any is: what each
# --check prints.
kpi_past() {
  jq -re 'to_entries | map(select(.value.status == "past")
    | "\(.key) \(.value["7d"]) (\(.value.bound) \(.value.threshold))") | if length == 0 then empty else .[] end' <<<"$1" && return 1
  return 0
}

cmd_kpi() {
  local json=0 vitals=0 at='' trend='' check='' re='' t
  local usage="usage: fleet-bench kpi [--json] [--vitals | --at T | --trend DAYS | --check [ERE]]"
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      --vitals) vitals=1 ;;
      --at) at="${2:?--at needs a time}"; shift ;;
      --trend) trend="${2:?--trend needs a day count}"; shift ;;
      --check) check=1; if [ $# -gt 1 ] && [[ "$2" != --* ]]; then re=$2; shift; fi ;;
      *) say "$usage"; return 2 ;;
    esac
    shift
  done
  [ -z "$check" ] || [ -z "$at$trend" ] || { say "$usage"; return 2; }
  [ "$vitals" = 0 ] || [ -z "$at$trend$check" ] || { say "$usage"; return 2; }
  t=$(now)
  [ -z "$at" ] || t=$(throughput_epoch "$at") || { say "kpi: cannot read the time $at"; return 2; }
  if [ -n "$trend" ]; then
    [[ "$trend" =~ ^[1-9][0-9]*$ ]] || { say "kpi: --trend takes a day count"; return 2; }
    local rows; rows=$(kpi_trend "$t" "$trend") || return 1
    if [ "$json" = 1 ]; then printf '%s\n' "$rows"; return 0; fi
    jq -rs '(.[0] | keys_unsorted) as $k | ($k | join(" | ") | "| \(.) |"), ($k | map("---") | join("|") | "|\(.)|"),
      (.[] | [.[$k[]] | if . == null then "-" else tostring end] | join(" | ") | "| \(.) |")' <<<"$rows"
    return 0
  fi
  if [ -n "$at" ]; then t=$(kpi_json "$t" "" '{}'); else t=$(kpi_now "$t"); fi || return 1
  if [ -n "$check" ]; then
    # A scope that names no KPI is a typo, not a pass: a watch on it would never trip.
    t=$(jq -c --arg re "$re" 'with_entries(select(.key | test($re)))' <<<"$t") || { say "kpi: --check takes an ERE"; return 2; }
    [ "$t" != "{}" ] || { say "kpi: no KPI matches $re"; return 2; }
    kpi_past "$t"
    return
  fi
  if [ "$vitals" = 1 ]; then
    if [ "$json" = 1 ]; then vitals_json "$t"; else vitals_table "$t"; fi
  elif [ "$json" = 1 ]; then jq -c . <<<"$t"; else kpi_table "$t"; fi
}

# chain_json <now> <counts> [<key>] -> the KPI_CHAIN rows of the KPI table graded from chain_counts
# output, or only <key>'s
chain_json() {
  kpi_json "$1" "$2" '{}' | jq -c --arg k "${3:-$KPI_CHAIN}" '($k | split(" ")) as $ks | with_entries(select(.key | IN($ks[])))'
}

# chain_snapshot <now> <key> -> chain_counts, reused from $DIR/chain.<FIX_SINCE>.counts when that was
# counted under CHAIN_SNAPSHOT_MAX_S before <now> and read a number for <key>, else counted now and
# written there. Each chain KPI has its own watch probing one key, and one count takes about 3 min,
# so under the lock the first probe of an hourly pass counts and the rest read it (ar-3966). Only the
# counts are kept: the caller grades them (kpi_json), so a thresholds edit holds at once. The file is
# per fix watermark (FIX_SINCE, from the watch's SENTINEL_SINCE), since the counts honor it, and a key
# whose source could not be read (`<key>=?`) is counted again rather than read as clear for an hour.
chain_snapshot() {
  local f="$DIR/chain.$FIX_SINCE.counts" at counts
  command -v flock >/dev/null && mkdir -p "$DIR" || { chain_counts "$1"; return; }
  {
    flock -w "$CHAIN_LOCK_WAIT_S" 8 || return 1
    if read -r at 2>/dev/null < "$f" && [[ "$at" =~ ^[0-9]+$ ]] && [ "$at" -le "$1" ] && [ $(( $1 - at )) -lt "$CHAIN_SNAPSHOT_MAX_S" ] \
       && grep -qE "^$2=(-?[0-9.]+(e[-+]?[0-9]+)?|-)\$" "$f"; then
      tail -n +2 "$f"; return 0
    fi
    # the count's own sections must not hold the lock: a killed probe would leave them holding it
    counts=$(chain_counts "$1" 8>&-) || return 1
    printf '%s\n%s\n' "$1" "$counts" > "$f.tmp" && mv -f "$f.tmp" "$f"
    find "$DIR" -maxdepth 1 -name 'chain.*.counts' -mmin +120 -delete 2>/dev/null
    printf '%s\n' "$counts"
  } 8>"$DIR/chain.lock"
}

# chain_check <json> <counts> -> kpi_past, then an `unreadable:` line naming each bounded KPI of
# <json> that <counts> holds no reading of (`<key>=?`, or no `<key>=` line), exit 2: a KPI that
# could not be counted is not one under its bound, and Sentinel reads the line as UNKNOWN (ar-5413).
# A KPI past its bound still exits 1 first. A share over nothing (`<key>=-`) is null in <json> too,
# but read, so it is no unreadable one.
chain_check() {
  local unread
  kpi_past "$1" || return 1
  unread=$(jq -r --arg c "$2" '($c | split("\n") | map(select(test("^[a-z0-9_]+=") and (endswith("=?") | not)) | sub("=.*"; ""))) as $read
    | [to_entries[] | select(.value.bound != null and (.key | IN($read[]) | not)) | .key] | join(" ")' <<<"$1") || unread='?'
  [ -z "$unread" ] || { echo "unreadable: $unread could not be counted"; return 2; }
}

# chain [--json|--check] [--kpi <key>] -- the KPI_CHAIN rows of the KPI table, counted now. --check
# prints one line per chain KPI past its threshold and exits 1 when any is. --kpi narrows it to one
# KPI_CHAIN key, read from chain_snapshot: `chain --check --kpi <key>` is the probe of that KPI's
# chain-<key> Sentinel watch, so a new trip shows while other chain KPIs stay red. An unknown key
# exits 2, and so does --check on a count that failed or a bounded KPI it could not read (chain_check).
cmd_chain() {
  local t json counts mode='' kpi='' args=("$@") usage="usage: fleet-bench chain [--json|--check] [--kpi <key>]"
  while [ $# -gt 0 ]; do
    case "$1" in
      --json|--check) [ -z "$mode" ] || { say "$usage"; return 2; }; mode=$1 ;;
      --kpi) [ -n "${2:-}" ] || { say "$usage"; return 2; }; kpi=$2; shift ;;
      *) say "$usage"; return 2 ;;
    esac
    shift
  done
  [ -z "$kpi" ] || [[ " $KPI_CHAIN " == *" $kpi "* ]] || { say "chain: $kpi is not a chain KPI (KPI_CHAIN)"; return 2; }
  # one read cache for the counts and the notes under the table, which read the same sources
  [ -n "${BENCH_READ_CACHE:-}" ] || { with_reads cmd_chain "${args[@]}"; return; }
  t=$(now)
  if [ -n "$kpi" ]; then
    # "unreadable:" reads UNKNOWN to Sentinel: a count that failed says nothing about this KPI
    counts=$(chain_snapshot "$t" "$kpi")
  else
    counts=$(chain_counts "$t")
  fi && json=$(chain_json "$t" "$counts" "$kpi") || {
    [ "$mode" = --check ] || { say "chain: the chain count failed"; return 1; }
    echo "unreadable: the chain count failed"; return 2
  }
  case "$mode" in
    --json) printf '%s\n' "$json" ;;
    --check) chain_check "$json" "$counts" ;;
    *) kpi_table "$json"; [ -n "$kpi" ] || chain_notes "$t" "$json" ;;
  esac
}

# prio-defaults [--json] -- the open rows that rank by default (no priority tag or no #why/<reason>), by the
# filer that wrote them, most first, with sample ids: the rows behind the prio_default KPI.
cmd_prio_defaults() {
  local pd
  case "${1:-}" in ""|--json) ;; *) say "usage: fleet-bench prio-defaults [--json]"; return 2 ;; esac
  [ -n "${BENCH_READ_CACHE:-}" ] || { with_reads cmd_prio_defaults "$@"; return; }
  pd=$(prio_defaults) && [ -n "$pd" ] || { say "prio-defaults: the board feed cannot be read"; return 1; }
  if [ "${1:-}" = --json ]; then printf '%s\n' "$pd"
  else jq -r '"prio_default \(.total)", (.origins[] | "  \(.origin) \(.n)  \(.ids | join(" "))")' <<<"$pd"; fi
}

# inflow_events <project> -> the ingest record's row events of one project's agent lane that say where a row
# came from or how it ended (added, filed, done, settled, dropped, dup, reopened), one JSON object a line.
# rc 1 when the record cannot be read.
inflow_events() {
  [ -r "$BENCH_INGEST" ] || return 1
  { grep -hE '"action":"(added|filed|done|settled|dropped|dup|reopened)"' "$BENCH_INGEST" || :; } \
    | jq -Rc --arg p "$1" 'fromjson? | select(.from == $p and (.id // "") != "" and (.lane == "agent" or .action == "settled"))
        | {action, id, ts, by, origin, why, pr, text}'
}

# inflow [--project P] [--days N] [--json] -- every open agent-lane row of a project attributed to the source
# that filed it, and each source's arrivals per day, how its arrivals ended and the age of its open rows.
cmd_inflow() {
  local project=agent-runtime days=$INFLOW_DAYS json=0 json_flag=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project=${2:?--project needs a name}; shift ;;
      --days) days=${2:?--days needs a number}; shift ;;
      --json) json=1; json_flag=(--json) ;;
      *) say "usage: fleet-bench inflow [--project P] [--days N] [--json]"; return 2 ;;
    esac
    shift
  done
  case "$days" in ""|*[!0-9]*|0) say "inflow: --days is a whole number of days"; return 2 ;; esac
  [ -n "${BENCH_READ_CACHE:-}" ] || { with_reads cmd_inflow --project "$project" --days "$days" "${json_flag[@]}"; return; }
  bench_read $BENCH_BOARD_CMD 2>/dev/null | jq -ce 'select(.rows | arrays)' > "$BENCH_READ_CACHE/inflow.board" && [ -s "$BENCH_READ_CACHE/inflow.board" ] \
    || { say "inflow: the board feed cannot be read"; return 1; }
  inflow_events "$project" > "$BENCH_READ_CACHE/inflow.events" || { say "inflow: the ingest record cannot be read ($BENCH_INGEST)"; return 1; }
  jq -rn --arg p "$project" --argjson days "$days" --argjson t "$(now)" --arg json "$json" \
    --slurpfile e "$BENCH_READ_CACHE/inflow.events" --slurpfile f "$BENCH_READ_CACHE/inflow.board" "$JQ_LIB"'
    def num: (capture("-(?<n>[0-9]+)$") | .n | tonumber) // null;
    def day: .[0:10];
    # the source of a row: the filer the ingest record names, else the #from/ its triage carried in, else
    # a hand session'"'"'s self-check, else the writer; a row the record never saw is pre-log below its first id
    def from_class: if . == null then null elif . == "" then "triage: no #from" elif . == "dream" or . == "ladder-scout" then "from: \(.)" else "from: item or session" end;
    def source($first; $text; $logged; $id):
      if $first == null then (if ($id | num) != null and ($id | num) < $logged then "pre-log" else "unrecorded" end)
      elif ($first.origin // "") != "" then $first.origin
      else (($first.text // $text // "") | capture("#from/(?<f>[^ ]*)") | .f | from_class) // (
        if $first.why == "self-check" then "self-check"
        elif ($first | human_writer) then "human"
        elif ($first.by | test("^[0-9a-f]{8}$")) then "session"
        else $first.by end) end;
    # an event'"'"'s moment: ts carries the writer'"'"'s UTC offset, so strings do not order across a DST change
    def at: sub("\\.[0-9]+"; "") | if test("Z$") then fromdateiso8601
      else capture("^(?<d>.*)(?<s>[+-])(?<h>[0-9]{2}):?(?<m>[0-9]{2})$")
        | (.d + "Z" | fromdateiso8601) - (if .s == "-" then -1 else 1 end) * ((.h | tonumber) * 3600 + (.m | tonumber) * 60) end;
    def close_kind: if (.pr // "") != "" or ((.why // "") | test("^pr:|/pull/")) then "closed by PR" else "done, no PR" end;
    # how the row ended after its last reopen: the last closing event, else null. A settled event closes only
    # when it carries a PR (closed on merge proof); the others un-start the row (item failed, cancelled, orphaned)
    def ended($evs):
      ($evs | map(select(.action != "added" and .action != "filed" and (.action != "settled" or (.pr // "") != ""))) | sort_by(.ts | at)) as $x
      | ($x | map(.action == "reopened") | rindex(true)) as $r
      | ($x | if $r == null then . else .[$r + 1:] end | map(select(.action != "reopened")) | last)
      | if . == null then null elif .action == "dropped" then "dropped" elif .action == "dup" then "dup"
        elif .action == "settled" then "closed by PR" else close_kind end;
    ($f[0].rows | map(select(.project == $p and .lane == "agent"))) as $rows
    | ($rows | map(select(.state == "open" or .state == "doing"))) as $open
    | ($open | map({key: .id, value: true}) | from_entries) as $isopen
    | ($e | group_by(.id) | map({key: .[0].id, value: .}) | from_entries) as $by
    | ([$e[] | select(.action == "added") | .id | num | numbers] | min // 0) as $logged   # a filed event can re-file an old id
    | ([$e[] | select(.action == "added") | .ts | day] | min) as $began_day
    | ([$days, (if $began_day == null then 1 else ((($t - ($began_day + "T12:00:00Z" | fromdateiso8601)) / 86400 | floor) + 1) end)] | min) as $covered
    | def first_ev($evs): ($evs // [] | map(select(.action == "added" or .action == "filed")) | sort_by(.ts | at) | first);
      ($open | map(. as $r | first_ev($by[$r.id]) as $f
        | {id: $r.id, source: source($f; $r.raw; $logged; $r.id), since: $r.since})) as $censused
    | ($t - $days * 86400 | strflocaltime("%Y-%m-%d")) as $from
    | def age: if (.since // "" | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") | not) then null else (($t - (.since + "T12:00:00Z" | fromdateiso8601)) / 86400 | floor) end;
      ([range(0; $days) | ($t - . * 86400) | strflocaltime("%Y-%m-%d")] | reverse) as $dates
    | ([$by | keys[] | . as $id | first_ev($by[$id]) as $first | select($first != null and ($first.ts | day) > $from)
        | {id: $id, day: ($first.ts | day), source: source($first; null; $logged; $id),   # a row counts once, on its first event
           end: (if $isopen[$id] then "open" else (ended($by[$id]) // "gone") end)}]) as $arr
    | ($censused | group_by(.source) | map({source: .[0].source, open: length, ids: map(.id),
        age_p50: (map(age | numbers) | median), age_max: (map(age | numbers) | max)})) as $cens
    | ($arr | group_by(.source) | map({source: .[0].source, arrived: length,
        per_day: (length / $covered | round2),
        daily: (. as $g | [$dates[] | . as $d | $g | map(select(.day == $d)) | length]),
        closed_by_pr: (map(select(.end == "closed by PR")) | length), done_no_pr: (map(select(.end == "done, no PR")) | length),
        dropped: (map(select(.end == "dropped")) | length), dup: (map(select(.end == "dup")) | length),
        open: (map(select(.end == "open")) | length), gone: (map(select(.end == "gone")) | length)})) as $arrivals
    | ([$cens[].source, $arrivals[].source] | unique) as $names
    | {project: $p, days: $days, covered_days: $covered, dates: $dates, open_rows: ($open | length), attributed: ($censused | length),
       sources: [$names[] | . as $n | ($cens | map(select(.source == $n)) | first) as $c | ($arrivals | map(select(.source == $n)) | first) as $a
         | {source: $n, open: ($c.open // 0), open_ids: ($c.ids // []), open_age_p50_d: $c.age_p50, open_age_max_d: $c.age_max,
            arrived: ($a.arrived // 0), arrived_per_day: ($a.per_day // 0), daily: ($a.daily // ([range(0; $days) | 0])),
            closed_by_pr: ($a.closed_by_pr // 0), done_no_pr: ($a.done_no_pr // 0), dropped: ($a.dropped // 0), dup: ($a.dup // 0),
            still_open: ($a.open // 0), gone: ($a.gone // 0)}] | sort_by(-.open, -.arrived)}
    | if $json == "1" then . else
      def d: if . == null then "-" else . end;
      "inflow \(.project): \(.open_rows) open agent rows, \(.attributed) attributed to a source; arrivals over the last \(.covered_days) days" + (if .covered_days < .days then " (the record starts there, not \(.days) days ago)" else "" end),
      "| source | open now | open age p50 d | open age max d | arrived | per day | closed by PR | done, no PR | dropped | dup | other | arrivals still open |",
      "|---|---|---|---|---|---|---|---|---|---|---|---|",
      (.sources[] | "| \(.source) | \(.open) | \(.open_age_p50_d | d) | \(.open_age_max_d | d) | \(.arrived) | \(.arrived_per_day) | \(.closed_by_pr) | \(.done_no_pr) | \(.dropped) | \(.dup) | \(.gone) | \(.still_open) |"),
      "| total | \(.sources | map(.open) | add) |  |  | \(.sources | map(.arrived) | add) | \((.sources | map(.arrived_per_day) | add) | round2) | \(.sources | map(.closed_by_pr) | add) | \(.sources | map(.done_no_pr) | add) | \(.sources | map(.dropped) | add) | \(.sources | map(.dup) | add) | \(.sources | map(.gone) | add) | \(.sources | map(.still_open) | add) |" end
  '
}

# CHURN_JQ: the runtime churn KPIs as jq, one bucket a local day. churn_rows builds {began, merges_known, days: {<date>: {merges, filed,
# closed, dropped, reopened, followups, admitted, refused}}} from the ingest events (inflow_events) and the merge dates; churn_kpis reads the $d complete days
# before the day of $at (a rate is never read from a part day), clipped to the record's first day.
# filed: a row's first added or filed event, counted once; followups: those no runner or hand wrote, a session's own (its 8-hex id is the writer
# and no origin); closed: done, or settled with a PR; dropped: dropped or dup, kept apart so one board cut never reads as work closed;
# admitted and refused: the new agent rows the board's daily cap (intake_daily_cap) let in and turned away, as `notes ingest cap` counts them.
CHURN_JQ='
def churn_rows($merges; $cap):
  . as $ev
  | ([$ev[] | select(.action == "added" or .action == "filed")] | group_by(.id) | map(min_by(.ts))) as $arr
  | ([($arr[] | {d: .ts[0:10], k: "filed"}),
      ($arr[] | select((.origin == null or .origin == "") and ((.by // "") | test("^[0-9a-f]{8}$"))) | {d: .ts[0:10], k: "followups"}),
      ($ev[] | select(.action == "done" or (.action == "settled" and (.pr // "") != "")) | {d: .ts[0:10], k: "closed"}),
      ($ev[] | select(.action == "dropped" or .action == "dup") | {d: .ts[0:10], k: "dropped"}),
      ($ev[] | select(.action == "reopened") | {d: .ts[0:10], k: "reopened"}),
      (($merges // [])[] | {d: ., k: "merges"})]
     | group_by(.d) | map({key: .[0].d, value: (group_by(.k) | map({key: .[0].k, value: length}) | from_entries)}) | from_entries) as $days
  | ([($days | keys[]), (($cap // {}) | keys[])] | unique | map({key: ., value: (($days[.] // {}) + (($cap // {})[.] // {}))}) | from_entries) as $all
  | {began: ([$ev[].ts[0:10]] | min // ""), merges_known: ($merges != null), cap_known: ($cap != null), days: $all};
def churn_dates($at; $d):
  ($at | strflocaltime("%Y-%m-%d") + "T12:00:00Z" | fromdateiso8601) as $noon
  | [range(1; $d + 1) | ($noon - . * 86400) | strftime("%Y-%m-%d")];
def churn_kpis($ch; $at; $d):
  if $ch == null then {churn_merges_per_day: null, churn_filed_per_closed: null, churn_reopens_per_day: null, churn_followups_per_pr: null, churn_admitted_per_day: null, churn_refused_per_day: null}
  else (churn_dates($at; $d) | map(select(. >= $ch.began))) as $ds
    | ($ds | length) as $n
    | def sum($k): [$ds[] | ($ch.days[.] // {})[$k] // 0] | add // 0;
      {churn_merges_per_day: (if $ch.merges_known and $n > 0 then (sum("merges") / $n * 1000 | round / 1000) else null end),
       churn_filed_per_closed: ratio(sum("filed"); sum("closed")),
       churn_reopens_per_day: (if $n > 0 then (sum("reopened") / $n * 1000 | round / 1000) else null end),
       churn_followups_per_pr: (if $ch.merges_known then ratio(sum("followups"); sum("merges")) else null end),
       churn_admitted_per_day: (if $ch.cap_known and $n > 0 then (sum("admitted") / $n * 1000 | round / 1000) else null end),
       churn_refused_per_day: (if $ch.cap_known and $n > 0 then (sum("refused") / $n * 1000 | round / 1000) else null end)}
  end;'

# churn_rows -> churn_rows of CHURN_JQ over the agent-runtime ingest events and the dotfiles merge dates; a failure when the ingest
# record cannot be read. A merge log that cannot be read or lists no merge leaves the merge-based KPIs null (merges_known false), never 0.
churn_rows() {
  local m merges=null c cap=null
  [ -r "$BENCH_INGEST" ] || return 1
  # The cap's day counts are notes' (one reader of the predicate); a notes that cannot give them leaves the two KPIs null, never 0.
  if c=$($BENCH_INTAKE_CMD 2>/dev/null); then
    cap=$(jq -sc 'map(select(type == "object" and .project == "agent-runtime")) | if length == 0 then null else (map({key: .date, value: {admitted, refused}}) | from_entries) end' <<<"$c" 2>/dev/null) || cap=null
    [ -n "$cap" ] || cap=null
  fi
  if m=$($BENCH_CHURN_MERGES_CMD 2>/dev/null); then
    merges=$(jq -Rsc 'split("\n") | map(select(test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$"))) | if length == 0 then null else . end' <<<"$m") || merges=null
  fi
  inflow_events agent-runtime | jq -sc --argjson m "$merges" --argjson cap "$cap" "$JQ_LIB$CHURN_JQ"'churn_rows($m; $cap)'
}

# churn_kpi <now> -> the churn KPI object, the same shape as comms_kpi; {} when the ingest record cannot be read
churn_kpi() {
  local ch
  ch=$(churn_rows) || { echo '{}'; return 0; }
  jq -nc --argjson t "$1" --argjson ch "$ch" "$JQ_LIB$CHURN_JQ"'
    churn_kpis($ch; $t; 7) as $a | churn_kpis($ch; $t; 28) as $b | $a | with_entries(.value = {"7d": .value, "28d": $b[.key]})'
}

# churn [--days N] [--json|--check] -- agent-runtime's churn a local day, oldest first: N complete days and today so far.
# --check prints nothing when it holds; when filed exceeded closed on each of the last CHURN_RUN_DAYS complete days it prints those days and exits 1.
cmd_churn() {
  local days=7 json=0 check=0 ch rows
  while [ $# -gt 0 ]; do
    case "$1" in
      --days) days=${2:?--days needs a number}; shift ;;
      --json) json=1 ;;
      --check) check=1 ;;
      *) say "usage: fleet-bench churn [--days N] [--json|--check]"; return 2 ;;
    esac
    shift
  done
  case "$days" in ""|*[!0-9]*|0) say "churn: --days is a whole number of days"; return 2 ;; esac
  [ "$check" = 0 ] || [ "$days" -ge "$CHURN_RUN_DAYS" ] || days=$CHURN_RUN_DAYS
  ch=$(churn_rows) || { say "churn: the ingest record cannot be read ($BENCH_INGEST)"; [ "$check" = 0 ] && return 1; return 2; }
  rows=$(jq -nc --argjson t "$(now)" --argjson n "$days" --argjson ch "$ch" '
    ($t | strflocaltime("%Y-%m-%d")) as $today
    | [range($n; -1; -1) | ($t | strflocaltime("%Y-%m-%d") + "T12:00:00Z" | fromdateiso8601) - . * 86400 | strftime("%Y-%m-%d")]
    | map(. as $d | ($ch.days[$d] // {}) as $r
        | {date: $d, complete: ($d != $today), merges: (if $ch.merges_known then ($r.merges // 0) else null end),
           filed: ($r.filed // 0), closed: ($r.closed // 0), dropped: ($r.dropped // 0), reopened: ($r.reopened // 0), followups: ($r.followups // 0),
           admitted: (if $ch.cap_known then ($r.admitted // 0) else null end), refused: (if $ch.cap_known then ($r.refused // 0) else null end)})') || return 1
  if [ "$check" = 1 ]; then
    # nothing when it holds, the days that tripped it when it does; fewer complete days than CHURN_RUN_DAYS is no trip
    jq -e --argjson k "$CHURN_RUN_DAYS" '[.[] | select(.complete)] | .[-$k:] | (length < $k or any(.filed <= .closed))' <<<"$rows" >/dev/null && return 0
    jq -r --argjson k "$CHURN_RUN_DAYS" '[.[] | select(.complete)] | .[-$k:][] | "churn \(.date): filed \(.filed), closed \(.closed)"' <<<"$rows"
    echo "churn: filed exceeded closed $CHURN_RUN_DAYS days running"
    return 1
  fi
  if [ "$json" = 1 ]; then jq -c '.[]' <<<"$rows"; return 0; fi
  jq -r '"| date | merges | filed | closed | dropped | reopened | followups | admitted | refused |", "|---|---|---|---|---|---|---|---|---|",
    (.[] | "| \(.date)\(if .complete then "" else " (so far)" end) | \(.merges // "-") | \(.filed) | \(.closed) | \(.dropped) | \(.reopened) | \(.followups) | \(.admitted // "-") | \(.refused // "-") |")' <<<"$rows"
}

# startup [--json|--check] -- Claude Code start times over the last startup_rolling_n (20) starts:
# the medians of ready, process (harness boot) and hook ms, each hook phase and each MCP server's
# spawn. The threshold and window are kpi-thresholds keys, the same startup_ready_ms_p50_max the KPI
# table uses. --check is the claude-startup watch's probe: exit 1 past the threshold, 2 when no
# SessionStart row (a resume counts) is newer than startup_stale_h (48) or the newest start has no
# ready time: a quiet or blind recorder trips too.
cmd_startup() {
  local lim='{}' json
  case "${1:-}" in ""|--json|--check) ;; *) say "usage: fleet-bench startup [--json|--check]"; return 2 ;; esac
  [ -r "$KPI_THRESHOLDS" ] && lim=$(grep -E '^[a-z0-9_]+=' "$KPI_THRESHOLDS" | kv_json)
  json=$(jq -nc --argjson t "$(now)" --argjson lim "$lim" --slurpfile r <(startup_rows) "$JQ_LIB$STARTUP_JQ"'
    def p50(f): map(f | numbers) | median | if . == null then null else round end;
    def p50by(s): [s] | group_by(.key) | map({key: .[0].key, value: p50(.value)}) | from_entries;
    ($lim.startup_rolling_n // 20) as $n | ($lim.startup_stale_h // 48) as $stale
    | ($r | starts | .[-$n:]) as $w | $lim.startup_ready_ms_p50_max as $max
    | ($w | p50(.ready_ms)) as $ready | ($r | last | .epoch) as $newest
    | {starts: ($w | length), newest_epoch: $newest, ready_ms_p50: $ready,
       process_ms_p50: ($w | p50(.process_ms)), hook_ms_p50: ($w | p50(.hook_ms)),
       phases_p50: p50by($w[] | .hooks[]? | .name as $h | .phases // {} | to_entries[] | {key: "\($h).\(.key)", value}),
       mcp_spawn_ms_p50: p50by($w[] | .mcp[]? | {key: .name, value: .spawn_ms}),
       threshold: $max, window: $n, stale_h: $stale,
       status: (if $newest == null or $newest < $t - $stale * 3600 then "stale"
                elif ([$r[] | select(.source == "startup")] | last | .ready_ms | type) != "number" then "blind"
                elif $max != null and $ready > $max then "past" else "ok" end)}') || return 1
  [ "${1:-}" = --json ] && { printf '%s\n' "$json"; return 0; }
  jq -r "$JQ_LIB"'
    def s: if . == null then "-" else "\(. / 1000 | round2)s" end;
    if .status == "stale" then
      if .newest_epoch == null then "startup: no Claude Code start recorded, is startup-telemetry.sh deployed?"
      else "startup: no Claude Code start recorded in \(.stale_h)h (newest \(.newest_epoch | todate))" end
    elif .status == "blind" then "startup: rows are written but the newest start has no ready time: is its claude process found?"
    else "startup: ready p50 \(.ready_ms_p50 | s) over the last \(.starts) starts"
         + (if .threshold == null then ", no startup_ready_ms_p50_max"
            elif .status == "past" then ", past startup_ready_ms_p50_max \(.threshold | s)"
            else " (max \(.threshold | s))" end)
         + ": process \(.process_ms_p50 | s), hooks \(.hook_ms_p50 | s)"
         + ([.phases_p50 | to_entries | sort_by(-.value) | .[:3][] | "\(.key) \(.value | s)"]
            | if length > 0 then " (" + join(", ") + ")" else "" end)
         + ([.mcp_spawn_ms_p50 | to_entries[] | "\(.key) \(.value | s)"]
            | if length > 0 then ", mcp spawn " + join(", ") else "" end)
    end' <<<"$json"
  [ "${1:-}" = --check ] || return 0
  case "$(jq -r .status <<<"$json")" in ok) return 0 ;; past) return 1 ;; *) return 2 ;; esac
}

# effect <T | owner/repo#N> [--days N] [--compare C] [--json] -- what changed after a change landed:
# each windowed KPI over the N days (BENCH_EFFECT_DAYS, 14) up to T against the N days after it. A
# PR is read as its merge time. Verdict per KPI: improved or regressed when it moved more than
# BENCH_EFFECT_FLAT (10%) the way better says, flat inside that, pending until the after window has
# ended, - when either side has no value. control is the same split at C, a time with no such
# change (default T - N days, the drift just before it), and net is the verdict unless control
# moved the same way, when it reads "as control": the KPI was moving anyway. A rework KPI reads
# each side lag days later (KPI_DEFS), so it is pending that much longer. Many changes land in any
# window, so even net is a lead to look at, never proof one change did it.
cmd_effect() {
  local ref='' days="$BENCH_EFFECT_DAYS" json=0 t info compare='' c
  local use="usage: fleet-bench effect <T | owner/repo#N> [--days N] [--compare C] [--json]"
  while [ $# -gt 0 ]; do
    case "$1" in
      --days) days="${2:?--days needs a count}"; shift ;;
      --compare) compare="${2:?--compare needs a time}"; shift ;;
      --json) json=1 ;;
      -*) say "$use"; return 2 ;;
      *) ref="$1" ;;
    esac
    shift
  done
  [ -n "$ref" ] || { say "$use"; return 2; }
  [[ "$days" =~ ^[1-9][0-9]*$ ]] || { say "effect: --days takes a day count"; return 2; }
  if [[ "$ref" == */*#* ]]; then
    info=$(gh pr view "${ref##*#}" -R "${ref%#*}" --json mergedAt -q '.mergedAt // ""' 2>/dev/null) ||
      { say "effect: gh cannot read $ref"; return 1; }
    [ -n "$info" ] || { say "effect: $ref is not merged"; return 1; }
    t=$(date -d "$info" +%s)
  elif [[ "$ref" =~ ^[0-9]{1,9}$ ]]; then
    say "effect: $ref reads as a PR number; give it as owner/repo#$ref"; return 2
  else
    t=$(throughput_epoch "$ref") || { say "effect: cannot read the time $ref"; return 2; }
  fi
  local cmp out
  cmp=$(throughput_epoch "${compare:-$((t - days * 86400))}") || { say "effect: cannot read the compare time ${compare:-T - $days days}"; return 2; }
  # a control split within N days of T would hold the change it is the control for
  [ $(( cmp > t ? cmp - t : t - cmp )) -ge $((days * 86400)) ] || { say "effect: --compare must be $days days or more from the change"; return 2; }
  out=$(jq -n --argjson t "$t" --argjson cmp "$cmp" --argjson d "$days" --argjson now "$(now)" --argjson flat "$BENCH_EFFECT_FLAT" \
        --arg ref "$ref" --slurpfile o <(outcomes_newest) --slurpfile c <(ci_claimed) --slurpfile k "$(kpi_canary)" --slurpfile tk <(kpi_tokens) "$KPI_DEFS"'
    bots as $bot
    # one change point: {x, b, a}, its time and the windows either side of it, each read once
    | def point($x): {x: $x, b: win($x; $d), a: win($x + $d * 86400; $d)};
    # a rework KPI reads its cohort lag days later, so it is pending that much longer
    def split($p; $k; $dir): (rework_kpi[$k].lag // 0) as $l | ($now >= $p.x + ($d + $l) * 86400) as $done
      | (if $l > 0 then [reworked($bot; $p.x + $l * 86400; $d; $k), reworked($bot; $p.x + ($d + $l) * 86400; $d; $k)]
         else [$p.b[$k], $p.a[$k]] end) as [$b, $a]
      | {before: $b, after: (if $done then $a else null end),
         verdict: (if ($done | not) then "pending" else move($b; $a; $dir; $flat) end)};
    point($t) as $pt | point($cmp) as $pc
    | {ref: $ref, at: ($t | todate), days: $d, compare: ($cmp | todate),
       kpis: [$pt.b | keys_unsorted[] as $k | better[$k] as $dir | split($pt; $k; $dir) as $x | split($pc; $k; $dir).verdict as $ctl
         | {kpi: $k, before: $x.before, after: $x.after, verdict: $x.verdict, control: $ctl,
            net: (if ($x.verdict | IN("improved", "regressed")) and $x.verdict == $ctl then "as control" else $x.verdict end)}]}') || return 1
  if [ "$json" = 1 ]; then jq -c . <<<"$out"; return 0; fi
  jq -r '"effect of \(.ref) at \(.at), \(.days)d before vs after; control: the same split at \(.compare):",
    "| KPI | before | after | verdict | control | net |", "|---|---|---|---|---|---|",
    (.kpis[] | "| \(.kpi) | \(.before // "-") | \(.after // "-") | \(.verdict) | \(.control) | \(.net) |")' <<<"$out"
}

# --- improve: one KPI past its threshold at a time, each with a check written before the work ---
# effect.jsonl holds two kinds of line. A claim, {type: "claim", at, kpi, subject, from, bound,
# threshold}, names the row (ar-N) or queue item (item:<slug>) that owns a KPI and the 7d value it
# started from. A verdict, {type: "verdict", at, kpi, subject, verdict, from, after, pr, bound,
# threshold}, ends it. A claim is live until its subject has a verdict after it: identity is the
# subject, never a row's title. The verdict compares values, never the status, so an edit to
# kpi-thresholds cannot turn a flat result into a pass.
IMPROVE_JQ='
def live: group_by([.subject, .kpi]) | map(sort_by(.at) | last | select(.type == "claim"));
# the live claims whose row or item has not closed, by the closes improve_closes prints: the WIP cap
# counts only these, as a shipped claim only waits out BENCH_EFFECT_DAYS for its verdict (ar-4768)
def open_live($c): [$c[] | (select(.action | IN("done", "dropped", "dup")) | .id),
    (select(.item != null and ((.action == "item-moved" and .to == "done") or .action == "item-cancelled")) | "item:\(.item)")] as $x
  | live | map(select(.subject | IN($x[]) | not));
def last_verdict($k): map(select(.type == "verdict" and .kpi == $k)) | sort_by(.at) | last
  | if . == null then null else {subject, verdict} end;
# how far past its threshold a KPI is, relative to the threshold
def gap: (.threshold | fabs | if . == 0 then 1 else . end) as $d
  | (if .bound == "max" then .["7d"] - .threshold else .threshold - .["7d"] end) / $d;
'

effect_lines() { cat "$EFFECT" 2>/dev/null || true; }

# improve_closes <live claims json> -> the record of how each claim's subject closed, one notes-log
# line each: the log since the oldest claim, plus for a row the log has no close for, its close from
# the feed (`notes board --json --id`, whose marker holds every close however it was made). Why:
# ar-579 and ar-596 closed with no log line, so their claims never got a verdict and held the cap
# (ar-4768). Fails when the log cannot be read; an unreadable feed adds nothing.
improve_closes() {
  local days log feed='{"rows":[]}' i
  local -a ids=()
  days=$(jq -r --argjson now "$(now)" 'if length == 0 then 1 else ($now - (map(.at) | min)) / 86400 | floor + 2 end' <<<"$1") || return 1
  log=$($BENCH_LOG_CMD --days "$days") || return 1
  while IFS= read -r i; do ids+=(--id "$i"); done < <(jq -r '[.[].subject | select(startswith("item:") | not)] | unique | .[]' <<<"$1")
  [ "${#ids[@]}" = 0 ] || feed=$($BENCH_NOTES_CMD board --json "${ids[@]}" 2>/dev/null) || feed='{"rows":[]}'
  jq -e '.rows | type == "array"' >/dev/null 2>&1 <<<"$feed" || feed='{"rows":[]}'
  # A row with an open copy has not closed (a reopened row's old close stays in its version note). A
  # feed close is a date, so it is read as that day's end, which never starts the verdict wait early.
  jq -c --slurpfile log <(printf '%s\n' "$log") '
    ($log | map(select(.action | IN("done", "dropped", "dup")) | .id)) as $logged
    | [.rows[] | select(.state != "done") | .id] as $reopened
    | $log[], (.rows[] | select(.state == "done" and .closed != null and (.id | IN($logged[]) | not) and (.id | IN($reopened[]) | not))
        | {id, ts: "\(.closed)T23:59:59Z",
           action: (if ((.marker // "") | test("(^| )dropped")) then "dropped" elif .dup then "dup" else "done" end),
           why: (if (.prs // []) == [] then null else "pr:\(.prs[-1])" end)})' <<<"$feed"
}

# improve_live_closes -> improve_closes for the live claims; [] when none or the log cannot be read
improve_live_closes() {
  local claims
  claims=$(effect_lines | jq -sc "$IMPROVE_JQ"'live') && [ "$claims" != "[]" ] && improve_closes "$claims" || true
}

# improve_pick <kpi json> -> the KPI furthest past its threshold that no live claim owns, as
# {kpi, value, threshold, bound, last}; nothing when none is, or BENCH_IMPROVE_MAX claims are live
# on rows or items still open (open_live).
# board_days and board_open are never picked: a session whose job is shrinking the board would
# delete rows the human filled on purpose. Nor is
# systems_no_skill: it is report-only, since a system with no skill yet is a gap to read, not a red.
# The churn_* rows are report-only too: a row filed to bring runtime merges down is itself runtime churn,
# and the runtime-churn watch is what reports them.
improve_pick() {
  jq -c --slurpfile e <(effect_lines) --slurpfile c <(improve_live_closes) --argjson max "$BENCH_IMPROVE_MAX" "$IMPROVE_JQ"'
    ($e | live) as $live | ($live | map(.kpi)) as $owned
    | if ($e | open_live($c) | length) >= $max then empty else
        [to_entries[] | select(.value.status == "past" and (.key | IN("board_days", "board_open", "systems_no_skill") | not) and (.key | startswith("churn_") | not) and (.key | IN($owned[]) | not))
         | {kpi: .key, value: .value["7d"], threshold: .value.threshold, bound: .value.bound, gap: (.value | gap)}]
        | sort_by(-.gap) | first // empty
        | del(.gap) | . + {last: (.kpi as $k | $e | last_verdict($k))} end' <<<"$1"
}

# improve_target <kpi json> <kpi> [subject] -> the KPI as {kpi, value, threshold, bound}, or a why
# and a failure: it must be past its threshold and unclaimed, and with no subject (file: new work)
# under the cap. A subject (claim) records a row or item that already exists, so the cap does not
# hold it, and one subject may claim each KPI its lever moves.
improve_target() {
  local why
  why=$(jq -r --arg k "$2" --arg s "${3:-}" --slurpfile e <(effect_lines) --slurpfile c <(improve_live_closes) --argjson max "$BENCH_IMPROVE_MAX" "$IMPROVE_JQ"'
    ($e | live) as $live | ($e | open_live($c)) as $open | .[$k] as $v
    | if $v == null then "no KPI named \($k)"
      elif $v.status != "past" then "\($k) is not past its threshold (\($v.status))"
      elif ($live | any(.kpi == $k)) then "\($k) is already claimed by \([$live[] | select(.kpi == $k) | .subject] | first)"
      elif $s == "" and ($open | length) >= $max then "\($open | length) claims on open work are live (BENCH_IMPROVE_MAX \($max)); one must end first"
      else empty end' <<<"$1") || return 1
  [ -z "$why" ] || { say "improve: $why"; return 1; }
  jq -c --arg k "$2" '.[$k] | {kpi: $k, value: .["7d"], threshold, bound}' <<<"$1"
}

# improve_claim_write <subject> <{kpi, value, threshold, bound}>: append the claim, its baseline
improve_claim_write() {
  mkdir -p "$DIR"
  jq -c --argjson at "$(now)" --arg s "$1" \
    '{type: "claim", at: $at, kpi, subject: $s, from: .value, bound, threshold}' <<<"$2" >> "$EFFECT"
}

# improve_add <text> <detail> [<reason>] -> the new row's id on the agent board; 3 when its twin is open.
# A <reason> is a slug of priority-reasons.tsv for the priority the text names; with none the row is
# filed as the text says, and the priority pass judges it.
improve_add() {
  local out rc=0 why=()
  [ -z "${3:-}" ] || why=(--why "$3")
  out=$($BENCH_NOTES_CMD ptask "$KPI_BOARD" --agent add "$1" --detail "$2" "${why[@]}" --origin fleet-bench) || rc=$?
  [ "$rc" = 0 ] || return "$rc"
  grep -oE '<!-- id:[a-z]+-[0-9]+' <<<"$out" | awk 'NR==1' | sed 's/^<!-- id://' | grep . ||
    { say "improve: the row was added but notes printed no id, so nothing claims it"; return 1; }
}

improve_kpis() { kpi_now "$(now)" || { say "improve: kpi unreadable"; return 2; }; }

# improve [--json]: the pick; exit 1 when nothing is due
improve_show() {
  local json pick
  json=$(improve_kpis) || return 2
  pick=$(improve_pick "$json") || return 2
  [ -n "$pick" ] || return 1
  if [ "$1" = --json ]; then printf '%s\n' "$pick"; return 0; fi
  jq -r '"\(.kpi) 7d \(.value) past \(.bound) \(.threshold)" + (if .last then ", last \(.last.subject) \(.last.verdict)" else "" end)' <<<"$pick"
}

# improve file <kpi> <text>: add the row tagged #kpi/<kpi> with its check as a detail line, and
# claim it with the KPI's 7d value now as the baseline
improve_file() {
  local json t text id rc=0
  json=$(improve_kpis) || return 2
  t=$(improve_target "$json" "$1") || return 1
  text="$2 #kpi/$1"
  [[ "$text" == *"#size/"* ]] || text+=" #size/s"
  id=$(improve_add "$text" "$(jq -r --argjson d "$BENCH_EFFECT_DAYS" \
    '"check: kpi \(.kpi) from \(.value) (\(.bound) \(.threshold)), read \($d)d after the PR lands; kpi-thresholds is not edited"' <<<"$t")") || rc=$?
  case $rc in
    0) ;;
    3) say "improve: a row with that text is already open; claim it: fleet-bench improve claim $1 <its id>"; return 3 ;;
    *) say "improve: the add failed ($rc)"; return 1 ;;
  esac
  improve_claim_write "$id" "$t"
  printf '%s claims %s from %s\n' "$id" "$1" "$(jq -r .value <<<"$t")"
}

# improve claim <kpi> <ar-N|item:slug>: record a row or queue item that already owns the KPI; the
# board is not written
improve_claim() {
  local json t
  [[ "$2" =~ ^([a-z]+-[0-9]+|item:[a-z0-9][a-z0-9-]*)$ ]] || { say "improve: claim takes a row id (ar-N) or item:<slug>, not $2"; return 2; }
  json=$(improve_kpis) || return 2
  t=$(improve_target "$json" "$1" "$2") || return 1
  improve_claim_write "$2" "$t"
  printf '%s claims %s from %s\n' "$2" "$1" "$(jq -r .value <<<"$t")"
}

# improve list [--json]: the live claims with their age, and the newest verdicts
improve_list() {
  local rows
  rows=$(effect_lines | jq -sc --argjson now "$(now)" --slurpfile c <(improve_live_closes) "$IMPROVE_JQ"'
    (open_live($c) | map(.subject)) as $open
    | {live: (live | map(. + {age_d: (($now - .at) / 86400 | floor), open: (.subject | IN($open[]))})), open_n: ($open | length),
     verdicts: (map(select(.type == "verdict")) | sort_by(.at) | reverse | .[:20])}') || return 1
  if [ "$1" = --json ]; then printf '%s\n' "$rows"; return 0; fi
  jq -r --argjson max "$BENCH_IMPROVE_MAX" '"live claims: \(.live | length), \(.open_n) on open work of \($max)",
    (.live[] | "  \(.subject) \(.kpi) from \(.from) (\(.bound) \(.threshold)), \(.age_d)d\(if .open then "" else ", closed: waits for its verdict" end)"),
    "verdicts:", (.verdicts[] | "  \(.subject) \(.kpi) \(.verdict) \(.from) -> \(.after // "-")\(if .pr then " (pr:\(.pr))" else "" end)")' <<<"$rows"
}

# improve_check: retro's read of each live claim. A row closed with a PR, or an item moved to done
# with one, BENCH_EFFECT_DAYS or more ago gets a verdict from the KPI's 7d value now against the
# claim's (move, the bound gives the direction); one closed with no PR, dropped, a dup or cancelled
# is unproven; one still open stays live. Regressed files one #high revert row and claims it; flat
# and unproven end the claim, so the pick names the KPI again. Leaves IMPROVE_LINE (the outcome
# part), IMPROVE_WHY (when nothing was checked) and IMPROVE_FAIL.
improve_check() {
  local claims log json v line verdict id n=0 imp=0 flt=0 reg=0 unp=0
  IMPROVE_LINE='' IMPROVE_WHY='' IMPROVE_FAIL=''
  claims=$(effect_lines | jq -sc "$IMPROVE_JQ"'live') || { IMPROVE_FAIL="effect ledger unreadable"; return 1; }
  if [ "$claims" = "[]" ]; then IMPROVE_WHY="no live improvement claim"; return 0; fi
  log=$(improve_closes "$claims") || { IMPROVE_FAIL="notes log unreadable"; return 1; }
  json=$(kpi_now "$(now)") || { IMPROVE_FAIL="kpi unreadable"; return 1; }
  v=$(jq -c --argjson now "$(now)" --argjson d "$BENCH_EFFECT_DAYS" --argjson flat "$BENCH_EFFECT_FLAT" \
      --argjson k "$json" --slurpfile log <(printf '%s\n' "$log") "$JQ_LIB"'
    def log_epoch: sub("\\.[0-9]+"; "")
      | iso_epoch;
    .[] | . as $c | ($c.subject | ltrimstr("item:")) as $slug | ($c.subject | startswith("item:")) as $item
    | [$log[] | select(if $item then .item == $slug and ((.action == "item-moved" and .to == "done") or .action == "item-cancelled")
                       else .id == $c.subject and (.action | IN("done", "dropped", "dup")) end)
       | {at: (.ts | log_epoch),
          pr: (if $item then .pr else first((.why // "") | capture("pr:(?<p>[^ ;]+)") | .p) end // null)}]
    | (sort_by(.at) | last) as $close
    | if $close == null then empty
      elif $close.pr == null then {verdict: "unproven", after: null}
      elif $now < $close.at + $d * 86400 then empty
      else (($k[$c.kpi] // {})["7d"]) as $a
        | move($c.from; $a; (if $c.bound == "max" then -1 else 1 end); $flat) as $m
        | if $m == "-" then empty else {verdict: $m, after: $a} end end
    | {type: "verdict", at: $now, kpi: $c.kpi, subject: $c.subject, from: $c.from, pr: $close.pr,
       bound: $c.bound, threshold: $c.threshold} + .' <<<"$claims") || { IMPROVE_FAIL="check unreadable"; return 1; }
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    verdict=$(jq -r .verdict <<<"$line") id=''
    if [ "$verdict" = regressed ]; then
      local rc=0 text
      text=$(jq -r '"fix(kpi): revert \(.pr), \(.kpi) went from \(.from) to \(.after) #kpi/\(.kpi) #high #size/s"' <<<"$line")
      id=$(improve_add "$text" "$(jq -r --argjson d "$BENCH_EFFECT_DAYS" \
        '"check: kpi \(.kpi) from \(.after) (\(.bound) \(.threshold)), read \($d)d after the PR lands; kpi-thresholds is not edited"' <<<"$line")" runtime-fault) || rc=$?
      case $rc in 0|3) ;; *) IMPROVE_FAIL="the revert row for $(jq -r .subject <<<"$line") failed"; return 1 ;; esac
    fi
    printf '%s\n' "$line" >> "$EFFECT"
    [ -z "$id" ] || improve_claim_write "$id" "$(jq -c '{kpi, value: .after, threshold, bound}' <<<"$line")"
    n=$((n + 1))
    case $verdict in improved) imp=$((imp + 1)) ;; flat) flt=$((flt + 1)) ;; regressed) reg=$((reg + 1)) ;; *) unp=$((unp + 1)) ;; esac
  done <<<"$v"
  if [ "$n" = 0 ]; then IMPROVE_WHY="$(jq length <<<"$claims") improvement claims not yet due"; return 0; fi
  IMPROVE_LINE="$n checked: $imp improved, $flt flat, $reg regressed, $unp unproven"
}

# improve [--json] | file <kpi> <text> | claim <kpi> <ar-N|item:slug> | list [--json]
cmd_improve() {
  local usage="usage: fleet-bench improve [--json] | file <kpi> <text> | claim <kpi> <ar-N|item:slug> | list [--json]"
  case "${1:-}" in
    ""|--json) improve_show "${1:-}" ;;
    file) [ $# -eq 3 ] && [ -n "$3" ] || { say "$usage"; return 2; }; improve_file "$2" "$3" ;;
    claim) [ $# -eq 3 ] || { say "$usage"; return 2; }; improve_claim "$2" "$3" ;;
    list) improve_list "${2:-}" ;;
    *) say "$usage"; return 2 ;;
  esac
}

# retro_guard_rows -> one "check(lesson): guard <hash>:<TAB>text<TAB>priority" line per lesson whose sig
# (so_lesson_sigs) hit in BENCH_GUARD_RECUR or more sessions after it was written, or that the dream
# sweep found again in BENCH_GUARD_SEEN or more sweeps (so_lesson_seen, keyed by its file and title; a
# lesson with a sig is measured by its sig alone, so one lesson never has two rows):
# a lesson the fleet keeps relearning wants a hook, test or lint, and the lesson goes once that lands.
retro_guard_rows() {
  local sigs seen sig claim since file n h key title last
  # shellcheck source=/dev/null
  . "$BENCH_SO_LIB" || return 1
  sigs=$(so_lesson_sigs) || return 1
  seen=$(so_lesson_seen) || return 1
  jq -r --argjson min "$BENCH_GUARD_SEEN" --argjson sigs "$sigs" '.[] | select(.seen >= $min)
    | select(.claim as $c | all($sigs[]; .claim != $c)) | [.title, .claim, .file, .last, .seen] | @tsv' <<<"$seen" |
  while IFS=$'\t' read -r title claim file last n; do
    h=$(printf '%s %s' "$file" "$title" | sha1sum | cut -c1-8)
    key="check(lesson): guard $h:"
    printf '%s\t%s lesson "%s" (%s, last %s) was found again in %s dream sweeps; make it a hook, test or lint, then delete the lesson\t%s\n' \
      "$key" "$key" "$claim" "$file" "$last" "$n" "$( [ "$n" -ge $((BENCH_GUARD_SEEN * 2)) ] && echo '#high' || echo '#low')"
  done
  jq -r --argjson min "$BENCH_GUARD_RECUR" --slurpfile o <(outcomes_newest) '
    .[] as $s | ([$o[] | select(((.lesson_hits // {})[$s.sig] // 0) > 0)] | length) as $n
    | select($n >= $min) | [$s.sig, $s.claim, $s.since, $s.file, $n] | @tsv' <<<"$sigs" |
  while IFS=$'\t' read -r sig claim since file n; do
    h=$(printf '%s' "$sig" | sha1sum | cut -c1-8)
    key="check(lesson): guard $h:"
    printf '%s\t%s lesson "%s" (%s, %s) recurred in %s sessions; make it a hook, test or lint, then delete the lesson\t%s\n' \
      "$key" "$key" "$claim" "$file" "$since" "$n" "$( [ "$n" -ge $((BENCH_GUARD_RECUR * 2)) ] && echo '#high' || echo '#low')"
  done
}

# retro reads each live improvement claim (improve_check), queues no canary (fleet-dispatch
# keeps DISPATCH_CANARY_KEEP canaries queued, canary_top_up), and keeps exactly one open agent-board row per lesson that keeps recurring
# (`check(lesson): guard <hash>:`). A KPI past its threshold gets
# no row here: `fleet-bench improve` names one at a time, and its row carries the check.
cmd_retro() {
  local grows why=()
  improve_check || { report_outcome FAILED "$IMPROVE_FAIL"; return 1; }
  if [ -n "$IMPROVE_LINE" ]; then say "$IMPROVE_LINE"; else why+=("$IMPROVE_WHY"); fi
  grows=$(retro_guard_rows) || { report_outcome FAILED "lesson sigs or seen markers unreadable"; return 1; }
  if [ -z "$grows" ]; then
    why+=("no lesson recurred")
    if [ -n "$IMPROVE_LINE" ]; then report_outcome WORKED "$IMPROVE_LINE"; return 0; fi
    say "${why[*]}"
    report_outcome NOOP "$(IFS=';'; echo "${why[*]}")"
    return 0
  fi
  board_upsert "$grows" || return 1
  upsert_report "$grows" "$IMPROVE_LINE"
}

# upsert_why <key> <priority tag> -> the priority reason (priority-reasons.tsv) of a row whose key
# says what it is: a firing alert at #high is a firing-alert, which the board's daily cap never
# holds (ar-4296), a tripped watch, a dispatch hold or a recurring lesson at #high is a runtime
# fault, a lesson at #low is upkeep. Any other row files without one, and the priority pass judges
# it.
upsert_why() {
  case "$1:$2" in
    'check(alert)'*:'#high') echo firing-alert ;;
    'check(watch)'*:'#high'|'fix(hold)'*:'#high'|'check(lesson)'*:'#high') echo runtime-fault ;;
    'check(lesson)'*:'#low') echo upkeep ;;
  esac
}

# board_upsert <rows: key TAB text TAB priority, one a line> keeps exactly one open agent-board row
# per key, matched as a lowercase title prefix (each key's shape is in lib/board-keys.sh, so the
# backlog triager leaves the row's prefix alone): a row whose text moved is edited in place, and one
# that matches writes nothing. An add runs only for a key with no open row, and passes the key
# (`ptask add --key`), so the writer takes no other key's row for its near twin (ar-4296: two alerts
# on one label, or one alert on two hosts, were twins, and the second had no row for days); an exit
# 3 that still comes is a red with no row, and no item, since triage_promote queues a key's own row:
# a failed write, never filed. A key with no open row but one closed in
# the board feed's window (upsert_closed) has that row reopened and its text refreshed, never a new
# row: a cause that is red again is the same work (alertmanager-fleet was filed 27 times in 7 days,
# 2026-11-18). A row whose condition cleared is triage_retire's. Every row is #size/s. A reopen that
# fails is said and the key is filed as a new row, and a row whose add or edit fails is said and
# skipped, so one stuck row never stops the pass (ar-4064: one failed add skipped every red fix
# promotion after it). An add the board's daily cap refuses (exit 6) is said, counted in
# UPSERT_CAPPED and tried again next pass; a firing alert's row and a red marked urgent pass the
# cap.
# Each write names its row by id, since `notes ptask edit` refuses a query two open rows match: the
# key's row is its first open row with an id marker, and only a key whose one row has none (written
# by hand) is named by its prefix. A twin a race left open on the key (ar-5690) is dropped as a dup
# of that row, its children moving under it; a twin being done, or one with no id, is left and said.
# Leaves the counts in UPSERT_ADDED, UPSERT_EDITED, UPSERT_REOPENED, UPSERT_DROPPED and
# UPSERT_CAPPED and the failed keys in UPSERT_FAILED, which upsert_report reports FAILED, so every
# caller ends with upsert_report;
# status 1 only when the board cannot be read, 2 when the upsert lock stays held (nothing is written).
# The read of the board and the writes after it are one section under BENCH_UPSERT_LOCK: the timed
# runner and every dispatch pass run triage, and two of them reading before either added filed the
# same key twice, then dropped one as a dup (2026-11-25: 45 same-day dup drops of check rows, ar-6078).
# A key whose row closed within the board feed's window is reopened with the red as a detail line,
# so the trip is history on that row, not a row of its own.
board_upsert() {
  local board closed human p text pri why have hid twin id rc added=0 edited=0 reopened=0 dropped=0 capped=0 failed=() twins=() trip=()
  UPSERT_ADDED=0; UPSERT_EDITED=0; UPSERT_REOPENED=0; UPSERT_DROPPED=0; UPSERT_CAPPED=0; UPSERT_FAILED=
  upsert_lock_take || { say "$UPSERT_LOCK_WHY"; report_outcome FAILED "$UPSERT_LOCK_WHY"; return 2; }
  board=$($BENCH_NOTES_CMD ptask "$KPI_BOARD" --agent list) || { upsert_lock_drop; report_outcome FAILED "$KPI_BOARD agent board unreadable"; return 1; }
  closed=$(upsert_closed)
  human=$($BENCH_NOTES_CMD ptask "$KPI_BOARD" list 2>/dev/null) || { human=; say "$KPI_BOARD human sheet unreadable: a row started there is not skipped this pass"; }
  while IFS=$'\t' read -r p text pri; do
    [[ "$text" == *'#size/'* ]] || text+=" #size/s"
    # each open row on this key, board order: "id TAB doing TAB lowercased text", id empty when it
    # has no marker
    mapfile -t twins < <(awk -F'\t' -v p="${p,,}" 'index($3, p) == 1 {
      id = ""; if (match($4, /<!-- id:[^ ]+/)) id = substr($4, RSTART + 8, RLENGTH - 8)
      print id "\t" ($4 ~ /^[ \t]*- \[\/\]/ ? "doing" : "") "\t" $3 }' <<<"$board")
    have=; hid=
    for twin in "${twins[@]}"; do
      [ -z "${twin%%$'\t'*}" ] || { hid=${twin%%$'\t'*}; have=${twin#*$'\t'*$'\t'}; break; }
    done
    if [ -z "$hid" ] && [ ${#twins[@]} -gt 0 ]; then
      have=${twins[0]#*$'\t'*$'\t'}
      [ ${#twins[@]} -eq 1 ] || { say "$p has ${#twins[@]} open rows and none has an id: left for triage"; failed+=("$p"); continue; }
    fi
    for twin in "${twins[@]}"; do
      id=${twin%%$'\t'*}
      [ "$id" != "$hid" ] || continue
      if [ -z "$id" ] || [[ "$twin" == *$'\t'doing$'\t'* ]]; then
        say "$p: open twin ${id:-with no id} of $hid left for triage"
      elif $BENCH_NOTES_CMD ptask "$KPI_BOARD" --agent drop "$id" --dup "$hid" >/dev/null; then
        dropped=$((dropped + 1))
      else
        say "could not drop $id, a twin of $hid for $p"; failed+=("$p")
      fi
    done
    # A key a person has started on the human sheet is theirs: an agent row filed here would make triage_twins
    # drop the row they are working (an open sheet copy with no agent row is a stray it drops, ar-6265).
    if [ -z "$have" ] && awk -F'\t' -v p="${p,,}" '$4 ~ /^[ \t]*- \[\/\]/ && index($3, p) == 1 { f = 1 } END { exit !f }' <<<"$human"; then
      say "$p: started on the human sheet, left there"; continue
    fi
    id=; [ -n "$have" ] || id=$(awk -F'\t' -v p="${p,,}" 'index($2, p) == 1 { print $1; exit }' <<<"$closed")
    if [ -n "$id" ]; then
      trip=(--detail "$(date -d "@$(now)" +%F) red again after it closed")
      if $BENCH_NOTES_CMD ptask "$KPI_BOARD" reopen "$id" --why "fleet-bench: $p red again" >/dev/null; then
        if $BENCH_NOTES_CMD ptask "$KPI_BOARD" --agent edit "$id" --text "$text" "${trip[@]}" >/dev/null; then
          reopened=$((reopened + 1))
        else
          say "edit failed for reopened $p ($id)"; failed+=("$p")
        fi
        continue
      fi
      say "could not reopen $id for $p: filing a new row"
    fi
    if [ -z "$have" ]; then
      rc=0 why=$(upsert_why "$p" "$pri")
      $BENCH_NOTES_CMD ptask "$KPI_BOARD" --agent add "$text $pri" ${why:+--why "$why"} --origin fleet-bench --key "$p" >/dev/null || rc=$?
      case $rc in
        0) added=$((added + 1)) ;;
        3) say "$p: the board took it for a twin of another open row, so it has no row"; failed+=("$p") ;;
        # The board's daily cap (intake_daily_cap, QUEUE.md "Admission"): the red waits for a later pass, and is no failure.
        6) say "$p: the board's daily cap holds this row; the next pass tries it again"; capped=$((capped + 1)) ;;
        *) say "add failed for $p"; failed+=("$p") ;;
      esac
    elif [ "$have" != "${text,,}" ]; then
      if $BENCH_NOTES_CMD ptask "$KPI_BOARD" --agent edit "${hid:-$p}" --text "$text" >/dev/null; then
        edited=$((edited + 1))
      else
        say "edit failed for $p"; failed+=("$p")
      fi
    fi
  done <<<"$1"
  upsert_lock_drop
  UPSERT_ADDED=$added; UPSERT_EDITED=$edited; UPSERT_REOPENED=$reopened; UPSERT_DROPPED=$dropped; UPSERT_CAPPED=$capped
  UPSERT_FAILED=$(IFS=';'; echo "${failed[*]}")
}

# upsert_lock_take / upsert_lock_drop: the one process-wide lock on filing rows (BENCH_UPSERT_LOCK),
# held by board_upsert and triage_human around their read-then-add, so two triage runs (the timed
# runner and a dispatch pass) never both find a key missing and both file it. rc 1 when the lock is
# held past BENCH_UPSERT_LOCK_WAIT, 2 when it cannot be opened; UPSERT_LOCK_WHY says which. A caller
# never takes it twice (flock on a second descriptor of one file would wait on itself).
upsert_lock_take() {
  mkdir -p "${BENCH_UPSERT_LOCK%/*}" 2>/dev/null
  { exec {UPSERT_LOCK_FD}>>"$BENCH_UPSERT_LOCK"; } 2>/dev/null || { UPSERT_LOCK_WHY="cannot open the board upsert lock $BENCH_UPSERT_LOCK"; return 2; }
  flock -w "$BENCH_UPSERT_LOCK_WAIT" "$UPSERT_LOCK_FD" && return 0
  upsert_lock_drop
  UPSERT_LOCK_WHY="board upsert lock $BENCH_UPSERT_LOCK held for ${BENCH_UPSERT_LOCK_WAIT}s by another filer"
  return 1
}
upsert_lock_drop() { [ -z "${UPSERT_LOCK_FD:-}" ] || exec {UPSERT_LOCK_FD}>&-; UPSERT_LOCK_FD=; }

# upsert_closed -> "id TAB lowercased text" for each KPI_BOARD agent row of the active profile
# (BENCH_PROFILE, else `notes config`) closed in the board feed's window (BENCH_BOARD_CMD,
# BOARD_SHIP_DAYS), newest first. Nothing when the feed cannot be read, so board_upsert then files a
# new row as it did before reopening existed.
upsert_closed() {
  bench_profile
  bench_read $BENCH_BOARD_CMD 2>/dev/null | jq -r --arg p "$KPI_BOARD" --arg prof "$BENCH_PROFILE" '[(.done // []) | .[]
    | select(.project == $p and .lane == "agent" and .profile == $prof and (.id // "") != "")]
    | sort_by(.closed // "") | reverse | .[] | [.id, (.text | ascii_downcase)] | @tsv' 2>/dev/null
}

# upsert_report <rows> [more]: the one line and the outcome after board_upsert; NOOP when it wrote
# nothing, FAILED and status 1 when a row's write failed (UPSERT_FAILED). A failure is the last line,
# since fleet-dispatch's triage_pass names a failed triage by its last line (ar-5583).
upsert_report() {
  local did="$UPSERT_ADDED added, $UPSERT_EDITED refreshed"
  [ "${UPSERT_REOPENED:-0}" -eq 0 ] || did+=", $UPSERT_REOPENED reopened"
  [ "${UPSERT_DROPPED:-0}" -eq 0 ] || did+=", $UPSERT_DROPPED twins dropped"
  [ "${UPSERT_CAPPED:-0}" -eq 0 ] || did+=", $UPSERT_CAPPED held by the board's daily cap"
  did+="${2:+, $2}"
  say "$(grep -c . <<<"$1") rows due: $did"
  if [ -n "${UPSERT_FAILED:-}" ]; then
    say "board write failed for $UPSERT_FAILED"
    report_outcome FAILED "board write failed for $UPSERT_FAILED; $did"
    return 1
  elif [ $((UPSERT_ADDED + UPSERT_EDITED + ${UPSERT_REOPENED:-0} + ${UPSERT_DROPPED:-0})) -eq 0 ] && [ -z "${2:-}" ]; then
    if [ "${UPSERT_CAPPED:-0}" -eq 0 ]; then report_outcome NOOP "every row already current"; else report_outcome NOOP "$did"; fi
  else
    report_outcome WORKED "$did"
  fi
}

# watch_sev <name> -> the severity in its manifest, read through sentinel-watch.sh watch_severity.
# watch_after <severity> -> seconds it must stay at TRIP before it is a red.
watch_sev() { watch_severity "$TRIAGE_WATCHES/$1.yaml"; }
watch_after() { case "$1" in high|urgent) echo "$TRIAGE_WATCH_HIGH_AFTER" ;; *) echo "$TRIAGE_WATCH_AFTER" ;; esac; }

# system_note <watch> <route skill> -> "; system <ids>: load fix-red and <skills>" for a watch whose
# manifest names a `system:`, else nothing. The skills are the ones whose metadata.system names one
# of its ids (one pass over BENCH_SKILLS_DIR), less fix-red and the route's own skill, at most
# TRIAGE_SYSTEM_SKILLS of them, so the red's session loads fix-red plus its system's domain skills.
system_note() {
  local ids skills
  # one line, `system: ci` or `system: [ci, tests]` (the forms SENTINEL.md shows), quotes and a comment dropped
  ids=$(awk '/^system:/ { sub(/^system:[[:space:]]*/, ""); sub(/[[:space:]]#.*/, ""); gsub(/["'"'"'\[\],]/, " "); print; exit }' "$TRIAGE_WATCHES/$1.yaml" 2>/dev/null)
  ids=$(echo $ids)
  [ -n "$ids" ] || return 0
  skills=$(find -L "$BENCH_SKILLS_DIR" -mindepth 2 -maxdepth 2 -name SKILL.md -print0 2>/dev/null | sort -z \
    | xargs -0 awk -v ids=" $ids " '
        FNR == 1 { fm = 0; done = 0 }
        /^---[[:space:]]*$/ { fm++; next }
        fm == 1 && !done && /^[[:space:]]+system:/ {
          line = $0; sub(/^[[:space:]]*system:[[:space:]]*/, "", line); gsub(/[][,]/, " ", line)
          n = split(line, a, " ")
          for (i = 1; i <= n; i++) if (index(ids, " " a[i] " ")) {
            m = split(FILENAME, p, "/"); print p[m - 1]; done = 1; break }
        }' 2>/dev/null \
    | awk -v skip="${2:--}" -v max="$TRIAGE_SYSTEM_SKILLS" '$0 != "fix-red" && $0 != skip && ++c <= max' | paste -sd, - | sed 's/,/, /g')
  printf '; system %s: load fix-red%s' "$ids" "${skills:+ and $skills}"
}

# watch_paused <name> -> 0 when the watch is paused (`<name>.yaml.paused`). Its state is kept for when
# it resumes, but it is no live red: `watch-companion-loop list` shows it PAUSED, and triage neither
# files nor keeps a row for it.
watch_paused() { [ -e "$TRIAGE_WATCHES/$1.yaml.paused" ]; }

# watch_tripped_since <name> <now> -> when the watch tripped, once it is past triage's patience
watch_tripped_since() {
  local since
  ! watch_paused "$1" || return 1
  [ "$(cat "$TRIAGE_WATCH_STATE/$1.state" 2>/dev/null)" = TRIP ] || return 1
  since=$(cat "$TRIAGE_WATCH_STATE/$1.since" 2>/dev/null) || return 1
  [[ "$since" =~ ^[0-9]+$ ]] && [ $(($2 - since)) -ge "$(watch_after "$(watch_sev "$1")")" ] || return 1
  printf '%s\n' "$since"
}

# failed_units -> "<unit> TAB <Result> TAB <LoadState>" for each failed user unit. Status 1 when
# systemctl cannot list them, so a reader can tell "none failed" from "could not read".
failed_units() {
  local list u
  list=$($TRIAGE_SYSTEMCTL --user list-units --failed --plain --no-legend 2>/dev/null) || return 1
  awk '{ print $1 }' <<<"$list" | while read -r u; do
    [ -n "$u" ] || continue
    printf '%s\t%s\t%s\n' "$u" "$($TRIAGE_SYSTEMCTL --user show -p Result --value "$u" 2>/dev/null)" \
      "$($TRIAGE_SYSTEMCTL --user show -p LoadState --value "$u" 2>/dev/null)"
  done
}

# unit_reset_why <unit> <LoadState> -> why a failed unit has nothing left to fix but its failed state,
# rc 1 when it has a cause to fix (triage_reset_gone)
unit_reset_why() {
  if [ "$2" = not-found ]; then echo 'the unit file is gone'
  elif [[ $1 =~ ^run-(u[0-9]+|p[0-9]+-i[0-9]+)\.service$ ]]; then echo 'a hand systemd-run with no --collect'
  else return 1; fi
}

# triage_reset_gone <dry> -> each failed user unit with nothing left to fix that it ran reset-failed
# on, or would on a dry run, one a line: one whose unit file is gone (LoadState not-found: retired
# while failed), or a hand `systemd-run` service left failed (auto-named run-u<N> or run-p<pid>-i<id>:
# every fleet caller passes --collect, a --unit name or --scope, so only a one-off command typed by
# a session or the human gets that name and keeps its failed state). A detached hand job's failure
# is dropped on purpose: its owner reads it in the journal, which reset-failed keeps
# (`journalctl --user -u <unit>`). Only the failed state systemd keeps is left, so triage clears it
# rather than filing a row; a reset that fails is not printed, so triage_rows files it, with
# unit_reset_why as its suffix. Each reset is said with its Result and why.
triage_reset_gone() {
  local u res load why
  failed_units | while IFS=$'\t' read -r u res load; do
    why=$(unit_reset_why "$u" "$load") || continue
    if [ "$1" = 1 ] || $TRIAGE_SYSTEMCTL --user reset-failed "$u" >/dev/null 2>&1; then
      say "reset: $u failed: ${res:-unknown}, $why$([ "$1" = 1 ] && echo '; dry run, not reset')"
      printf '%s\n' "$u"
    else
      say "reset: could not reset-failed $u"
    fi
  done
}

# triage_alerts -> "<alertname> TAB <id>" for each alert the aggregate watch (TRIAGE_ALERT_WATCH) lists
# in its evidence, one probe line each: the alert name, then its host or other label, then an optional
# kind (joined to the id with "/"). Nothing unless the watch is TRIP and its evidence names an alert.
# The id is cut to a token a board title can carry.
triage_alerts() {
  local o="$TRIAGE_WATCH_STATE/$TRIAGE_ALERT_WATCH.out" name id rest
  [ "$(cat "$TRIAGE_WATCH_STATE/$TRIAGE_ALERT_WATCH.state" 2>/dev/null)" = TRIP ] && [ -r "$o" ] || return 0
  # the first line is the verdict, the "fleet=fix firing:" line the probe's own summary
  sed '1d; /^fleet=fix firing: /,$d' "$o" | while read -r name id rest; do
    [[ "$name" =~ ^[A-Za-z][A-Za-z0-9_]*$ && -n "$id" ]] || continue
    id=${id}${rest:+/${rest// //}}
    printf '%s\t%s\n' "$name" "${id//[^A-Za-z0-9._\/-]/_}"
  done | sort -u
}

# triage_pinned -> each host a human pinned out of service in the governor's override ConfigMap
# (`<host>.slots` whose `by` says "human: ..."), one a line: that host's alerts are the move the
# human asked for, not a fault. Machine-mode's own daily pins say nothing about one host. Unreadable
# is no pin, so an alert stays red rather than being hidden.
triage_pinned() {
  $TRIAGE_PINS_CMD 2>/dev/null | jq -r '(.data // {}) | to_entries[] | select(.key | endswith(".slots"))
    | select(((.value | fromjson? // {}).by // "") | startswith("human:")) | .key | sub("\\.slots$"; "")'
}

# triage_alert_rows <since epoch> <severity> -> key, text and priority for each alert the aggregate
# watch lists that no human pin explains, so each firing alert (name and host) has a row, a cause and
# a red item of its own, and the row closes when that alert clears (triage_retire). Rc 1 when the
# evidence lists no alert: the watch's own row then stands, so unreadable evidence hides nothing.
# An explained alert is said, never filed.
triage_alert_rows() {
  local alerts name id pinned pri
  alerts=$(triage_alerts)
  [ -n "$alerts" ] || return 1
  pinned=$(triage_pinned)
  pri=$(case "$2" in high|urgent) echo '#high' ;; normal) echo '#normal' ;; *) echo '#low' ;; esac)
  while IFS=$'\t' read -r name id; do
    if grep -qxF -- "${id%%/*}" <<<"$pinned"; then say "triage: $name $id is intended: ${id%%/*} is pinned by a human"; continue; fi
    printf 'check(alert): %s %s firing\tcheck(alert): %s %s firing, %s tripped since %s, expected: no fleet=fix alert, evidence: watch-companion-loop list --long %s\t%s\n' \
      "$name" "$id" "$name" "$id" "$TRIAGE_ALERT_WATCH" "$(date -d "@$1" +%Y-%m-%d)" "$TRIAGE_ALERT_WATCH" "$pri"
  done <<<"$alerts"
  return 0
}

# triage_rows -> key, text and priority (tab-separated) for each runtime fault that persists: a
# scheduled runner whose last-outcome is FAILED or STALLED, a failed user unit, and a Sentinel
# watch held at TRIP past TRIAGE_WATCH_AFTER, or TRIAGE_WATCH_HIGH_AFTER when high or urgent.
# FAILED, a failed unit and a high or urgent watch are #high. Sentinel stays observe-only: this
# reads its state files.
triage_rows() {
  local c name sd v detail u res load f n since sev what why t unc qowner
  t=$(now)
  proof_lib && sd=$(proof_state_dir)
  for c in "$LEDGER_CONF_DIR"/*.conf; do
    [ -e "$c" ] && [ -n "$sd" ] || continue
    grep -qE '^KIND=["'"'"']?call' "$c" && continue
    grep -qE '^ENABLED=["'"'"']?no' "$c" && continue
    name=$(scheduled_runner "$c") || continue
    v=$(awk 'NR == 1 { print $1 }' "$sd/$name/last-outcome" 2>/dev/null)
    case "$v" in FAILED|STALLED) ;; *) continue ;; esac
    detail=$(grep "outcome=$v" "$sd/$name/activity.log" 2>/dev/null | tail -1 \
      | sed -E 's/^\[([0-9-]{10})[^]]*\] outcome=[A-Z]+ ?/\1 /; s/^([0-9-]{10}) .* (why: .*)$/\1 \2/' | cut -c1-100)
    printf 'fix(runner): %s is\tfix(runner): %s is %s: %s\t%s\n' "$name" "$name" "$v" "${detail:-no detail}" \
      "$([ "$v" = FAILED ] && echo '#high' || echo '#low')"
  done
  failed_units | while IFS=$'\t' read -r u res load; do
    # a unit triage_reset_gone cleared (or, on a dry run, would) is no fault
    grep -qxF -- "$u" <<<"${TRIAGE_GONE:-}" && continue
    printf 'fix(unit): %s failed\tfix(unit): %s failed: %s%s\t#high\n' "$u" "$u" "${res:-unknown}" \
      "$(why=$(unit_reset_why "$u" "$load") && echo ", $why")"
  done
  for f in "$TRIAGE_WATCH_STATE"/*.state; do
    [ -e "$f" ] || continue
    n=$(basename "$f" .state)
    since=$(watch_tripped_since "$n" "$t") || continue
    # A quarantine (`watch-companion-loop quarantine`, a line `UNTIL OWNER AT WHY`) names the red's
    # owner and expiry, so it files no row until UNTIL; then it is filed like any other red. It covers
    # only the reds it was taken on: one the probe names since is filed now, as the why (ar-3916).
    unc=
    if watch_quarantine_open "$TRIAGE_WATCH_STATE" "$n" "$t"; then
      unc=$(watch_uncovered "$TRIAGE_WATCH_STATE" "$n" | awk 'NR == 1')
      [ -n "$unc" ] || continue
      read -r _ qowner _ < "$TRIAGE_WATCH_STATE/$n.quarantine"
    fi
    sev=$(watch_sev "$n")
    # The aggregate Alertmanager watch files one row a firing alert instead of its own.
    if [ "$n" = "$TRIAGE_ALERT_WATCH" ] && triage_alert_rows "$since" "$sev"; then continue; fi
    # `what:` is one line or a folded block whose first sentence is the healthy state
    what=$(awk '/^what:/ { sub(/^what:[[:space:]]*(>-?|\|-?)?[[:space:]]*/, ""); on = 1; if ($0 != "") print; next }
                on && /^[[:space:]]/ { sub(/^[[:space:]]+/, ""); print; next } on { exit }' "$TRIAGE_WATCHES/$n.yaml" 2>/dev/null \
      | tr '\n' ' ' | sed -E 's/\. .*/./; s/[[:space:]]+$//' | cut -c1-100)
    # The why is the first red line of the redacted evidence (sentinel-watch.sh watch_red_lines),
    # normalized, so a new pid or timestamp in it does not edit the row every pass.
    why=$({ [ -n "$unc" ] && printf '%s\n' "$unc" || watch_red_lines "$TRIAGE_WATCH_STATE/$n.out"; } | awk 'NR == 1' | log_norm | tr -d '#' | cut -c1-100)
    [ -z "$unc" ] || why+=" (not covered by the quarantine $qowner holds)"
    printf 'check(watch): %s tripped since\tcheck(watch): %s tripped since %s, expected: %s%s\t%s\n' "$n" "$n" \
      "$(date -d "@$since" +%Y-%m-%d)" "${what:-no manifest}" \
      "${why:+, why: $why, evidence: watch-companion-loop list --long $n}" \
      "$(case "$sev" in high|urgent) echo '#high' ;; normal) echo '#normal' ;; *) echo '#low' ;; esac)"
  done
}

# log_lines -> each readable run of the last TRIAGE_LOG_HOURS, oldest first, as "<name> TAB <err
# start>", then one "<name> TAB <err start> TAB <normalized> TAB <line>" per error line it logged.
# Each run's bytes come from its runs.jsonl err range; a range past the end of the log was rotated
# away and is no run. rc 1 when runs.jsonl cannot be read.
log_lines() {
  local sd name a b f
  proof_lib && sd=$(proof_state_dir)
  [ -n "$sd" ] && [ -r "$sd/runs.jsonl" ] || return 1
  jq -rs --argjson s $(($(now) - TRIAGE_LOG_HOURS * 3600)) \
    'map(select((.finished // 0) >= $s and (.err[0] | type) == "number" and (.err[1] | type) == "number"
      and .err[1] >= .err[0])) | sort_by(.finished)[] | [.name, .err[0], .err[1]] | @tsv' "$sd/runs.jsonl" 2>/dev/null |
  while IFS=$'\t' read -r name a b; do
    f="$sd/$name.stderr.log"
    [ -n "$name" ] && [ -r "$f" ] && [ "$(stat -c %s "$f")" -ge "$b" ] || continue
    printf '%s\t%s\n' "$name" "$a"
    [ "$b" -gt "$a" ] || continue
    # one dd reads the range: `tail | head -c` cut the pipe early, and under systemd (SIGPIPE
    # ignored) tail logged a Broken pipe per range into the very logs this reads
    dd if="$f" iflag=skip_bytes,count_bytes skip="$a" count=$((b - a)) status=none |
      grep -aiE -- "$TRIAGE_ERR_RE" | tr -d '\t\r' |
      while IFS= read -r line; do printf '%s\t%s\t%s\t%s\n' "$name" "$a" "$(log_norm <<<"$line")" "$line"; done
  done
  # a run with no error line ends the loop on grep's 1, which is no failure to read
  return 0
}

# log_sig <runner> <normalized line> -> the 8-hex signature a fix(logs) row key carries
log_sig() { printf '%s\t%s' "$1" "$2" | sha1sum | cut -c1-8; }

# log_recent -> "runner <name>" for each runner with BENCH_GUARD_RECUR or more readable runs in the
# window, and the row key of each signature any of a runner's newest BENCH_GUARD_RECUR readable runs
# logged, lowercased as board keys are. A log row is recovered when its runner is listed and its key
# is not: the error is gone from as many newest runs as filing needs to see it. rc 1 when unread.
log_recent() {
  local kind name norm
  log_lines | awk -F'\t' -v min="$BENCH_GUARD_RECUR" '
    NF == 2 { run[$1, ++runs[$1]] = $2; next }
    { k = $1 FS $3; r[k] = $1; seen[k, $2] = 1 }
    END { for (n in runs) if (runs[n] >= min) print "runner" FS n
          for (k in r) for (j = runs[r[k]]; j > 0 && j > runs[r[k]] - min; j--)
            if ((k, run[r[k], j]) in seen) { print "sig" FS k; break } }' |
  while IFS=$'\t' read -r kind name norm; do
    if [ "$kind" = runner ]; then echo "runner $name"; else echo "fix(logs): $name error $(log_sig "$name" "$norm"):"; fi
  done | tr '[:upper:]' '[:lower:]'
}

# triage_log_rows -> one row per runner stderr error signature seen in BENCH_GUARD_RECUR or more
# runs of the last TRIAGE_LOG_HOURS, one of them among the runner's newest BENCH_GUARD_RECUR readable
# runs: a cause fixed earlier in the window is not red now, and cause_tries would count its merged
# fix as one that did not hold. That many runs outlast a dispatch pass for the fastest runner, so an
# intermittent error is still seen. #high at twice the recurrence.
triage_log_rows() {
  local name norm n sample sig
  log_lines |
  awk -F'\t' -v min="$BENCH_GUARD_RECUR" '
    NF == 2 { run[$1, ++runs[$1]] = $2; next }
    { k = $1 FS $3; r[k] = $1; if (!((k, $2) in seen)) { seen[k, $2] = 1; n[k]++ } if (!(k in s)) s[k] = $4 }
    END { for (k in n) if (n[k] >= min) for (j = runs[r[k]]; j > 0 && j > runs[r[k]] - min; j--)
            if ((k, run[r[k], j]) in seen) { print k FS n[k] FS s[k]; break } }' |
  while IFS=$'\t' read -r name norm n sample; do
    sig=$(log_sig "$name" "$norm")
    # a # would read as a tag on the board
    sample=$(sed -E 's/^\[[^]]*\][[:space:]]*//; s/#/no./g' <<<"$sample" | cut -c1-80)
    printf 'fix(logs): %s error %s:\tfix(logs): %s error %s: %s\t%s\n' "$name" "$sig" "$name" "$sig" "$sample" \
      "$( [ "$n" -ge $((BENCH_GUARD_RECUR * 2)) ] && echo '#high' || echo '#low')"
  done | sort
}

# red_items <epoch> -> the cc:red_now items red now and TRIAGE_WATCH_AFTER ago, the same patience a
# watch gets, because the rule has no "since" to read.
red_items() {
  prom_q "cc:red_now and (cc:red_now offset ${TRIAGE_WATCH_AFTER}s)" "$1" 2>/dev/null | jq -r '.data.result[]?.metric.item // empty'
}

# triage_red_rows -> a row for each cc:red_now item with no state on this machine: reds another host
# watches, such as the voice pucks. A watch or runner with local state already has its own row.
triage_red_rows() {
  local item n
  $TRIAGE_RED_CMD "$(now)" | while IFS= read -r item; do
    [ -n "$item" ] || continue
    n=${item#* }; n=${n//_/-}
    [ -e "$TRIAGE_WATCH_STATE/$n.state" ] || [ -e "$LEDGER_CONF_DIR/$n.conf" ] && continue
    printf 'check(red): %s is red\tcheck(red): %s is red\t#low\n' "$item" "$item"
  done
}

# triage_line <text>: the first TRIAGE_ROUTES line whose ERE matches, into the caller's re, route,
# skill, fix and tags. Status 1 when none does.
triage_line() {
  [ -r "$TRIAGE_ROUTES" ] || return 1
  while IFS=$'\t' read -r re route skill fix tags; do
    [[ -n "$re" && "$re" != \#* && -n "$fix" ]] || continue
    [[ "$1" =~ $re ]] && return 0
  done < "$TRIAGE_ROUTES"
  return 1
}

# triage_shape <kind> <name>: the row a failure of that kind files, into the caller's text, with
# its date and cause as stand-ins: the shape the route table matches on.
triage_shape() {
  case "$1" in
    watch) text="check(watch): $2 tripped since 2026-01-01, expected: -" ;;
    alert) text="check(alert): $2 firing, $TRIAGE_ALERT_WATCH tripped since 2026-01-01, expected: -" ;;
    runner) text="fix(runner): $2 is FAILED: -" ;;
    unit) text="fix(unit): $2 failed: failed" ;;
    hold) text="fix(hold): $2 went red after cleanup merge -: -" ;;
    *) text= ;;
  esac
}

# triage_route <rows> -> key, text, priority, route, cause, item tags. The first TRIAGE_ROUTES line
# whose ERE matches the row decides; no match, or a route it does not know, is route "-" and cause
# "-", or for a watch check(watch):<name> hashed. The cause is that line's ERE hashed, so every row one line explains is one cause. A line with a capture group
# names one cause per value, such as one per runner or watch, and that cause is the row's kind (its
# text to the first colon; every triage_shape row has one) plus the value, not the ERE: the watch
# line lists every watch it routes, so each edit to it gave every watch a new cause, cause_tries
# counted 0 again and a red two fixes did not hold was retried past the cap
# (the old aggregate work-chain watch and runner-score, 2026-11-07).
triage_route() {
  local n key text pri re route skill fix tags t note hit cause extra
  while IFS=$'\t' read -r key text pri; do
    hit=0 cause=- extra=
    triage_line "$text" && hit=1
    if [ "$hit" = 1 ]; then
      fix=${fix//#/no.}
      case "$route" in
        agent) note="fix${skill:+ with $skill}: $fix"; [ "$skill" != - ] || note="fix: $fix" ;;
        script) note="script: $fix" ;;
        human:?*) note="for the human: $fix" ;;
        alert | owned:?*) note='' ;;
        *) say "triage: $TRIAGE_ROUTES: no such route: $route"; hit=0 ;;
      esac
    fi
    if [ "$hit" = 0 ]; then
      # An unrouted watch is still queued (triage_queues), so it is a cause of its own, named as a
      # capture-group line names it, so a line added for it later keeps its tries.
      if [[ "$key" == 'check(watch): '* ]]; then
        cause=${key#'check(watch): '}; cause=$(printf 'check(watch):%s' "${cause%% *}" | sha256sum | cut -c1-8)
      fi
      printf '%s\t%s\t%s\t-\t%s\t\n' "$key" "$text" "$pri" "$cause"
      continue
    fi
    if [[ "$text" =~ $re ]] && [ -n "${BASH_REMATCH[1]:-}" ]; then
      if [[ "$text" == *:* ]]; then re="${text%%:*}:${BASH_REMATCH[1]}"; else re+=${BASH_REMATCH[1]}; fi
    fi
    cause=$(printf '%s' "$re" | sha256sum | cut -c1-8)
    if [[ "$key" == 'check(watch): '* ]]; then
      case "$route" in
        alert) note="the human decides: $fix; own it: file that decision as one agent-ask with a recommendation, and fix what is not theirs" ;;
        owned:?*) note="owned by ${route#owned:}: $fix; get that work running, or fix it here" ;;
      esac
    fi
    text+="${note:+; $note}"
    case "$route" in agent | alert | owned:?*)
      if [[ "$key" == 'check(watch): '* ]]; then n=${key#'check(watch): '}; text+=$(system_note "${n%% *}" "${skill:--}"); fi ;;
    esac
    for t in ${tags:-}; do
      case "$t" in -) ;; \#*) text+=" $t" ;; *) extra+="${extra:+ }$t" ;; esac
    done
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$key" "$text" "$pri" "$route" "$cause" "$extra"
  done <<<"$1"
}

# triage_queues <key> <route>: the row is queued as a red item. An agent route is; so is a tripped
# watch on any route but a human's, so every tripped watch has an owner (TRIAGE_WATCH_AFTER): an
# alert or owned watch's session files the decision or chases the owner.
triage_queues() { [ "$2" = agent ] || { [[ "$1" == 'check(watch): '* ]] && [[ "$2" != human:* ]]; }; }

# triage_filed <rows> -> the rows for the agent board: every one triage_queues, and an unrouted or
# script row. Any other alert, owned or human red takes no agent row: dispatch would read an open one as work.
triage_filed() {
  local line key route
  while IFS= read -r line; do
    IFS=$'\t' read -r key _ _ route _ <<<"$line"
    case "$route" in - | script) ;; *) triage_queues "$key" "$route" || continue ;; esac
    printf '%s\n' "$line"
  done <<<"$1"
}

# row_open <list> <key>: the TSV list (title third) holds an open row whose lowercase title starts with the key.
row_open() { awk -F'\t' -v p="${2,,}" 'index(tolower($3), p) == 1 { f = 1 } END { exit !f }' <<<"$1"; }

# triage_twins <rows> <filed keys>: a row lives in exactly one lane, the one its route names (triage is the
# one writer of a keyed row's lane: fleet-dispatch gives such a row no exit, bench_keyed), so once the new
# lane holds it the old lane's twin on the KPI_BOARD sheet is dropped, with the reason in its marker. A
# human route's agent-board twin goes first; then each filed key's sheet twin. Read from every pass, so a
# twin left by an earlier route or a drop that failed is retried. A sheet row is a twin only while the
# agent board holds its key open: a key whose agent add the daily cap held keeps its sheet row until the
# add lands (ar-6265). Closing a twin is the only write.
triage_twins() {
  local key route sheet have agent kpi
  agent=$($BENCH_NOTES_CMD ptask "$KPI_BOARD" --agent list 2>/dev/null </dev/null) || return 0
  while IFS=$'\t' read -r key _ _ route _; do
    [ -n "$key" ] || continue
    case "$route" in human:?*) ;; *) continue ;; esac
    sheet=${route#human:}
    have=$($BENCH_NOTES_CMD ptask "$sheet" list 2>/dev/null </dev/null) || continue
    row_open "$have" "$key" && row_open "$agent" "$key" || continue
    $BENCH_NOTES_CMD ptask "$KPI_BOARD" --agent drop "$key" --why "moved to the $sheet sheet" >/dev/null 2>&1 </dev/null \
      || say "twin: could not drop the agent row for $key"
  done <<<"$1"
  [ -n "$2" ] || return 0
  kpi=$($BENCH_NOTES_CMD ptask "$KPI_BOARD" list 2>/dev/null </dev/null) || return 0
  while IFS= read -r key; do
    [ -n "$key" ] || continue
    row_open "$kpi" "$key" && row_open "$agent" "$key" || continue
    $BENCH_NOTES_CMD ptask "$KPI_BOARD" drop "$key" --why "moved to the agent board" >/dev/null 2>&1 </dev/null \
      || say "twin: could not drop the sheet row for $key"
  done <<<"$2"
}

# triage_human <rows>: a human route's row on that sheet, paged once, the day it lands. The page
# is keyed by the row, so a row closed and filed again within agent-notify's dedupe window
# (a watch that trips, clears and trips) does not page again: up to 6 pages a row on 2026-11-18.
triage_human() {
  local key text pri route sheet have why n=0
  grep -q $'\thuman:' <<<"$1" || { echo 0; return 0; }
  upsert_lock_take || { say "triage: $UPSERT_LOCK_WHY: the human sheet rows wait for the next pass"; echo 0; return 0; }
  while IFS=$'\t' read -r key text pri route _; do
    case "$route" in human:?*) sheet=${route#human:} ;; *) continue ;; esac
    have=$($BENCH_NOTES_CMD ptask "$sheet" list 2>/dev/null) || continue
    row_open "$have" "$key" && continue
    [[ $text == *'#size/'* ]] || text+=" #size/s"
    why=$(upsert_why "$key" "$pri")
    $BENCH_NOTES_CMD ptask "$sheet" add "$text $pri" ${why:+--why "$why"} --origin fleet-bench >/dev/null 2>&1 || continue
    $TRIAGE_NOTIFY_CMD -t 'Needs you' -d "needs:$sheet:$key" "$sheet sheet: $key" >/dev/null 2>&1
    n=$((n + 1))
  done <<<"$1"
  upsert_lock_drop
  echo "$n"
}

# cause_tries <items> <cause> [trip] [route] -> -1 while an item stands for the cause:
# - queued, running, waiting, or in review (its PR waits on a merge, and a second session would only repeat it);
# - merged and closed under TRIAGE_WATCH_AFTER ago (the patience a low red gets before it is filed,
#   given to a merge to deploy and age out of the probe's window);
# - merged and before its proves_at, the time its fixer said the probe can first read it (a CronJob
#   alert clears only on its next run), at most TRIAGE_PROVES_MAX after it closed (ar-4215);
# - on an alert or owned route, closed ok since the trip (its job was the ask or the owner, not the red, so a PR it
# merged fixed something beside the red; the watch re-pages on its own). Else how many tries the
# cause had: given the epoch its watch tripped at, the items queued at or after it, so each trip gets
# its own TRIAGE_FIX_TRIES (ar-4064); else every item in the TRIAGE_FIX_DAYS window.
# Every row triage reads is red now, so an item that closed cancelled or failed, or merged with its
# red still here on an agent route, did not hold. So did one closed with a PR it records no merge
# for: a red fix merges itself (agent-land) and one parked on its PR waits in review, so nothing
# merges a closed item's PR. Read as an owner, a stale record held a cause unowned for good
# (playground-train-stuck: ar-3447 closed 2026-11-22 recording #3091, merged by ar-2940's landing,
# and its next trip went 17h with no item while 44 PRs waited in landing-queue, ar-5294).
# CAUSE_JQ: the cause's items ($c, its " cause:<id> " tag) and of those its tries ($trip, or "" for
# the whole window), shared so cause_slugs names exactly what cause_tries counts.
CAUSE_JQ='def cause_items: [.[] | select((" " + (.tags // "") + " ") | contains($c))];
def trip_tries: [.[] | select($trip == "" or ((.queued | ep) // 0) >= ($trip | tonumber))];'
cause_tries() {
  local owned=false
  case "${4:-}" in alert | owned:?*) owned=true ;; esac
  jq --arg c " cause:$2 " --arg trip "${3:-}" --argjson owned "$owned" --argjson now "$(now)" \
    --argjson after "$TRIAGE_WATCH_AFTER" --argjson most "$TRIAGE_PROVES_MAX" \
    "$JQ_LIB$CAUSE_JQ"'def settles: ((.finished | ep) // 0) as $f | [$f + $after, ([(.proves_at | ep) // 0, $f + $most] | min)] | max;
    cause_items | trip_tries as $tries
    | if any(.[]; .state == "queued" or .state == "running" or .state == "review" or .state == "waiting"
                or (.state == "done" and (.merged // "") != "" and settles >= $now))
         or ($owned and any($tries[]; .state == "done" and .status == "ok"))
      then -1 else ($tries | length) end' <<<"$1"
}

# watch_trip <key> -> the epoch a watch row's watch tripped at, on any route; nothing for any other
# row. 2026-11-20 (ar-4064): tries were counted over the whole window, so a watch that cleared and
# tripped again found its tries spent by an earlier trip, and 12 of 22 tripped watches had no owner.
# A watch that flaps gets TRIAGE_FIX_TRIES items and one escalation a trip by design (every trip has an owner, ar-1531);
# only a trip that outlasts watch_after is a red, which bounds how often that can be.
watch_trip() {
  [[ "$1" == 'check(watch): '* ]] || return 0
  local n=${1#'check(watch): '}
  sed -n '1{/^[0-9][0-9]*$/p}' "$TRIAGE_WATCH_STATE/${n%% *}.since" 2>/dev/null
}

# cause_slugs <items> <cause> [trip] -> the slugs of the tries cause_tries counts, oldest first, comma-joined
cause_slugs() {
  jq -r --arg c " cause:$2 " --arg trip "${3:-}" "$JQ_LIB$CAUSE_JQ"'cause_items | trip_tries | sort_by((.queued | ep) // 0) | map(.slug) | join(",")' <<<"$1"
}

# triage_items -> the queue items of the last TRIAGE_FIX_DAYS as one array; rc 1 when unreadable
triage_items() {
  bench_read $TRIAGE_ITEMS_CMD --since "$(date -d "@$(( $(now) - TRIAGE_FIX_DAYS * 86400 ))" +%F)" 2>/dev/null | jq -cs .
}

# triage_kind <key> -> " watch" for a tripped watch's own red, which triage tags `watch` (below), and " alert"
# for one firing alert's red, tagged `alert`: both are outside the daily cap, bounded by what is red (a
# watch, an alert), and only a watch's widens the red floor. Nothing for any other red.
triage_kind() { case "$1" in 'check(watch): '*) echo ' watch' ;; 'check(alert): '*) echo ' alert' ;; esac; }

# triage_promote <rows> -> how many rows triage_queues were queued as red fixes. A red fix runs and
# merges itself at any hour (policy.md Tier-3 gate), so each guard here keeps that from running away: a
# dispatch hold or an unreadable queue queues nothing, TRIAGE_FIX_CAP bounds the day's other reds, an
# item in hand stands for its cause (cause_tries), and a cause gets at most TRIAGE_FIX_TRIES items and one escalation in
# the window, a watch's in its current trip. A tripped watch's item is tagged `watch` and is outside the cap: each watch is one cause,
# so the watches bound it, and fleet-dispatch widens its red floor by one for each. Outside
# TRIAGE_FIX_CAP is not outside the queue cap: the promote is a dispatch pull (--dispatch), so at the cap it makes
# room or leaves its row on the board for a pass (agent-queue make_room, admit).
# A row a closed try left started that no live item holds (row_in_hand) is promoted with --restart, and a
# promote that refuses is said with its reason (ar-4654).
# A later try is tagged `retry:<earlier slugs>` so its session starts from what did not hold. Once its
# TRIAGE_FIX_TRIES did not hold, a cause gets one escalation: an item tagged `escalate`, pinned to
# TRIAGE_ESCALATE_MODEL, whose brief is fix-red's root-cause pass. Only when that did not hold either is
# the cause spent: it stays on its agent row, counted by the reds_spent KPI, and one ask carries it
# (triage_spent_ask), so Needs you holds a red only once the agent system has nothing left to try
# (ask UfRZaR, 2026-11-20, on the human's "needs me should only be what needs me").
triage_promote() {
  local board key raw route cause tags items used trip tries more kind n=0 capped=0 seen=' ' model restart err
  $TRIAGE_HOLD_CMD >/dev/null 2>&1 || { echo 0; return 0; }
  items=$(triage_items) || { echo 0; return 0; }
  used=$(jq --arg d "$(date -u -d "@$(now)" +%F)" \
    "$JQ_LIB"'[.[] | select(tagged("red") and (tagged("watch") | not) and (tagged("alert") | not) and (.queued // "" | startswith($d)))] | length' <<<"$items")
  board=$($BENCH_NOTES_CMD ptask "$KPI_BOARD" --agent list) || { echo 0; return 0; }
  local spent=''
  while IFS=$'\t' read -r key _ _ route cause tags; do
    triage_queues "$key" "$route" || continue
    kind=$(triage_kind "$key")
    trip=$(watch_trip "$key")
    tries=$(cause_tries "$items" "$cause" "$trip" "$route")
    # Spent is counted before the day's cap, which says nothing about a cause's own tries; an
    # unreadable count is neither spent nor a try.
    [[ "$tries" =~ ^-?[0-9]+$ ]] || continue
    if [ "$tries" -gt "$TRIAGE_FIX_TRIES" ]; then
      [[ $'\n'"$spent" != *$'\n'"$cause"$'\t'* ]] || continue   # one ask a cause, however many rows it has
      spent+="$cause"$'\t'"$key"$'\t'"$(triage_spent_ask "$cause" "$key" "$(cause_slugs "$items" "$cause" "$trip")" "$items")"$'\n'
      continue
    fi
    [ -n "$kind" ] || [ $((used + capped)) -lt "$TRIAGE_FIX_CAP" ] || continue
    [[ "$seen" != *" $cause "* ]] || continue
    seen+="$cause "
    [ "$tries" -ge 0 ] || continue
    more=''; [ "$tries" -eq 0 ] || more=" retry:$(cause_slugs "$items" "$cause" "$trip")"
    model=(); [ "$tries" -lt "$TRIAGE_FIX_TRIES" ] || { more=" escalate$more"; model=(--model "$TRIAGE_ESCALATE_MODEL"); }
    raw=$(awk -F'\t' -v p="${key,,}" 'index($3, p) == 1 { print $4; exit }' <<<"$board")
    # A row its own fix item (slug = its id) left started when it closed, with no live item behind it, is
    # queued again with --restart, as a todo one is (ar-4654): it waited 72h for the orphan pass. A row
    # started by hand has no such item and stays.
    restart=()
    case $raw in
      '- [ ]'*) ;;
      '- [/]'*) [[ $raw =~ id:([a-z]+-[0-9]+) ]] && jq -e --arg id "${BASH_REMATCH[1]}" 'any(.[]; .slug == $id and .state == "done")' <<<"$items" >/dev/null &&
        ! row_in_hand "$items" "$raw" || continue
        restart=(--restart) ;;
      *) continue ;;
    esac
    err=$($TRIAGE_PROMOTE_CMD --agent --dispatch "${restart[@]}" --project "$KPI_BOARD" "${model[@]}" --tags "red$kind cause:$cause$more${tags:+ $tags}" --raw "$raw" 2>&1 >/dev/null) ||
      { say "triage: could not queue $key (${raw:0:5}): $(tail -n 1 <<<"$err")"; continue; }
    n=$((n + 1)); [ -n "$kind" ] || capped=$((capped + 1))
  done <<<"$1"
  triage_spent_write "$spent"
  echo "$n"
}

# triage_spent_ask <cause> <key> <slugs> <items> -> the id of the one ask a spent cause gets: the one the
# last pass recorded in TRIAGE_SPENT_FILE, else the one it had when it left the spent set (TRIAGE_HELD_FILE)
# while that still holds it (triage_ask_held), else one posted now; nothing when the post failed, so the
# next pass posts it. An ask the human closed is not posted again while the cause stays: its answer went
# to a board row, its owner. A cause that clears leaves the file, so its next spell of red is asked
# again, unless its last ask still holds it (ar-6233). An ask agent-ask cannot show is kept, never
# posted twice.
triage_spent_ask() {
  local id ask
  id=$(awk -F'\t' -v c="$1" '$1 == c && $3 != "" { print $3; exit }' "$TRIAGE_SPENT_FILE" 2>/dev/null)
  if [ -z "$id" ]; then
    id=$(awk -F'\t' -v c="$1" '$1 == c && $2 != "" { print $2; exit }' "$TRIAGE_HELD_FILE" 2>/dev/null)
    if [ -n "$id" ] && ask=$($TRIAGE_ASK_CMD show "$id" 2>/dev/null) && [ -n "$ask" ]; then
      triage_ask_held "$ask" "$4" || id=''
    fi
  fi
  if [ -z "$id" ]; then
    # No session owns it: a triage run by hand from a session would otherwise tie it to that session.
    id=$(env -u CLAUDE_CODE_SESSION_ID $TRIAGE_ASK_CMD post --project "$KPI_BOARD" \
      --context "A red is a check the fleet reads as failing; this one is \"$2\". Triage (fleet-bench, which queues a fix item for each red) queued $3 for it, the last a root-cause pass on $TRIAGE_ESCALATE_MODEL, and none held, so it queues no more. What each found is on its item (agent-queue show <slug>)." \
      "Red \"${2:0:70}\" outlasted every fix tried: what should the next fix do?" 2>/dev/null </dev/null | tail -n 1)
    [[ "$id" =~ ^[A-Za-z0-9]+$ ]] || { say "triage: could not ask about the spent red $2"; id=''; }
  fi
  printf '%s' "$id"
}

TRIAGE_CANCEL_WHY='the red cleared or agents are trying it again (fleet-bench triage)'

# triage_ask_held <agent-ask show output> <items> -> rc 0 while a returning cause's last ask holds it
# off the human: still pending, or cancelled by anyone but triage (TRIAGE_CANCEL_WHY) under
# TRIAGE_ASK_HOLD_SEC ago or while a queue item in <items> or an ask its reason names is still open.
# An answered ask holds nothing: its answer was tried, so a red back once more is a new question.
triage_ask_held() {
  local st at why tok words
  st=$(sed -n '/^status: /{s///p;q;}' <<<"$1")
  [ "$st" != pending ] || return 0
  [ "$st" = cancelled ] || return 1
  why=$(sed -n '/^closed_reason: /{s///p;q;}' <<<"$1")
  [ "$why" != "$TRIAGE_CANCEL_WHY" ] || return 1
  at=$(sed -n '/^closed_at: /{s///p;q;}' <<<"$1")
  # date -d '' reads as today's midnight, so a cancel with no stamp gets only the hold of its reason.
  [ -n "$at" ] && at=$(date -d "$at" +%s 2>/dev/null) && [ $(( $(now) - at )) -lt "$TRIAGE_ASK_HOLD_SEC" ] && return 0
  # A word with a hyphen (hc-1133, fix-ci-runner) is looked up as a slug in <items>, in one jq call; a
  # six-character word with a capital or a digit (mHHGUX) is asked of agent-ask, so a plain word costs
  # no call. A word missed here shortens the hold to TRIAGE_ASK_HOLD_SEC, never posts at once.
  words=$(grep -oE '[A-Za-z0-9]+(-[A-Za-z0-9]+)*' <<<"$why" | sort -u)
  jq -e --arg w "$words" '($w | split("\n") | map(select(contains("-")))) as $s
    | any(.[]; (.slug | IN($s[])) and (.state | IN("queued", "running", "review", "waiting")))' <<<"$2" >/dev/null 2>&1 && return 0
  for tok in $words; do
    [[ "$tok" =~ ^[A-Za-z0-9]{6}$ && "$tok" =~ [A-Z0-9] ]] || continue
    at=$($TRIAGE_ASK_CMD show "$tok" 2>/dev/null) || continue
    grep -qx 'status: pending' <<<"$at" && return 0
  done
  return 1
}

# triage_spent_write <cause TAB key TAB ask lines>: the causes red now whose tries and escalation are
# spent, one a cause, as TRIAGE_SPENT_FILE; the reds_spent KPI counts it. Every triage pass that reads
# the queue rewrites it, so a cause that cleared or got a try back leaves it.
triage_spent_write() {
  mkdir -p "$(dirname "$TRIAGE_SPENT_FILE")" || return 0
  # The ask of a cause that left (it cleared, or its tries aged out so agents try again) needs the human
  # no longer: cancel it while it is still pending, so Needs you never holds a red that needs nobody.
  local id left
  left=$(awk -F'\t' 'NR == FNR { if (NF) now[$1] = 1; next } $3 != "" && !($1 in now) { print $1 "\t" $3 }' <(printf '%s\n' "$1") "$TRIAGE_SPENT_FILE" 2>/dev/null)
  while IFS=$'\t' read -r _ id; do
    [ -n "$id" ] || continue
    $TRIAGE_ASK_CMD show "$id" 2>/dev/null | grep -q '^status: pending' || continue
    $TRIAGE_ASK_CMD cancel "$id" "$TRIAGE_CANCEL_WHY" >/dev/null 2>&1 ||
      say "triage: could not cancel the ask $id of a red that left"
  done <<<"$left"
  triage_held_write "$1" "$left"
  # A failed write says so and leaves no temp file; the old file then ages into reds_spent=?.
  printf '%s' "$1" | awk -F'\t' 'NF && !seen[$1]++' > "$TRIAGE_SPENT_FILE.$$" && mv "$TRIAGE_SPENT_FILE.$$" "$TRIAGE_SPENT_FILE" \
    || { rm -f "$TRIAGE_SPENT_FILE.$$"; say "triage: could not write $TRIAGE_SPENT_FILE"; }
}

# triage_held_write <spent lines> <left: cause TAB ask lines>: TRIAGE_HELD_FILE keeps the ask of each cause
# that left the spent set, stamped now, for triage_spent_ask to take again when the cause returns. A cause
# spent again drops its line (TRIAGE_SPENT_FILE has its ask), and a line older than TRIAGE_FIX_DAYS goes.
triage_held_write() {
  local f=$TRIAGE_HELD_FILE
  mkdir -p "$(dirname "$f")" || return 0
  { awk -F'\t' -v t="$(now)" 'NF && $2 != "" { print $1 "\t" $2 "\t" t }' <<<"$2"
    [ ! -s "$f" ] || awk -F'\t' -v cut="$(( $(now) - TRIAGE_FIX_DAYS * 86400 ))" \
      'NR == FNR { if (NF) drop[$1] = 1; next } !($1 in drop) && $3 >= cut' <(printf '%s\n%s\n' "$1" "$2") "$f"
  } > "$f.$$" && mv "$f.$$" "$f" || { rm -f "$f.$$"; say "triage: could not write $f"; }
}

# reds_spent -> the count of TRIAGE_SPENT_FILE, ? when no triage pass wrote it in TRIAGE_SPENT_STALE_MIN
reds_spent() {
  if [ -n "$(find "$TRIAGE_SPENT_FILE" -mmin "-$TRIAGE_SPENT_STALE_MIN" 2>/dev/null)" ]; then
    echo "reds_spent=$(grep -c . "$TRIAGE_SPENT_FILE")"
  else echo "reds_spent=?"; fi
}

# triage_coverage -> each standing watch and each runner no TRIAGE_ROUTES line resolves, and each
# runner whose SKILL names nothing (agentctl skill --dangling), one a line.
# It builds the row each would file, so a line that stops matching the real row text counts too. A
# watch with an expiry is a bake or a one-off: it pages and goes, so it needs no line. A watch counts
# as routed only by a line that names it: each watch's fix is its own, so a generic line such as
# `check(watch): ([a-z-]+) tripped` would read every new watch as covered (penguin P4, ar-4155). An
# owned:<row> route counts too when that row is not open (triage_owned_closed): its red would be
# sent to chase a closed row (ar-2571: playground-gate-budget owned by the closed ucp-2115).
triage_coverage() {
  local f n text out key route re skill fix tags rows= routed owned=
  # Exit 1 is the answer "some are dangling"; any other failure means the check did not run, which
  # counts too, so a missing agentctl cannot read as clean.
  out=$(AGENTCTL_CONF_DIR="$LEDGER_CONF_DIR" $BENCH_SKILL_CMD 2>&1) || [ $? -eq 1 ] || out="the SKILL check failed: $out"
  [ -z "$out" ] || sed 's/^/skill /' <<<"$out"
  for f in "$TRIAGE_WATCHES"/*.yaml; do
    [ -e "$f" ] || continue
    grep -qE '^expiry: *[^n[:space:]]' "$f" && continue
    n=${f##*/} n=${n%.yaml}
    triage_shape watch "$n"
    rows+="watch $n"$'\t'"$text"$'\t-\n'
    [ "$n" = "$TRIAGE_ALERT_WATCH" ] || continue
    triage_shape alert "Alertname host"
    rows+="alert $n"$'\t'"$text"$'\t-\n'
  done
  for f in "$LEDGER_CONF_DIR"/*.conf; do
    [ -e "$f" ] || continue
    n=${f##*/} n=${n%.conf}
    triage_shape runner "$n"
    rows+="runner $n"$'\t'"$text"$'\t-\n'
  done
  [ -n "$rows" ] || return 0
  triage_shape hold ci-0
  rows+="hold"$'\t'"$text"$'\t-\n'
  routed=$(triage_route "${rows%$'\n'}")
  while IFS=$'\t' read -r key _ _ route _; do
    [ "$route" != - ] || { echo "$key"; continue; }
    [[ "$route" != owned:?* ]] || owned+="$key"$'\t'"${route#owned:}"$'\n'
    [[ "$key" == 'watch '* ]] || continue
    n=${key#watch }
    triage_shape watch "$n"
    triage_line "$text" && [[ "$re" =~ (^|[^a-z0-9_-])$n([^a-z0-9_-]|$) ]] || echo "$key"
  done <<<"$routed"
  [ -z "$owned" ] || triage_owned_closed "${owned%$'\n'}"
}

# triage_owned_closed <key TAB row lines> -> "<key> owned:<row> <why>" for each owned route whose row
# is not open: closed, folded into another row, or on no board this host's notes reads (a host
# without an org's profile misses its rows). One `notes board --json --id` read, cached for the pass
# (bench_read), finds a row wherever it sits, any version, open or closed. An unreadable feed names
# each owned route unchecked, so a check that did not run cannot read as clean.
triage_owned_closed() {
  local key id feed
  local -a ids=()
  while IFS=$'\t' read -r key id; do ids+=(--id "$id"); done <<<"$1"
  feed=$(bench_read $BENCH_NOTES_CMD board --json "${ids[@]}" 2>/dev/null </dev/null) && jq -e '.rows | type == "array"' >/dev/null 2>&1 <<<"$feed" \
    || { awk -F'\t' '{ print $1 " owned:" $2 " unchecked: notes board --json --id cannot be read" }' <<<"$1"; return 0; }
  jq -r --arg want "$1" '.rows as $rows
    | $want | split("\n")[] | split("\t") as [$key, $id]
    | [$rows[] | select(.id == $id)] as $r | ([$r[] | .dup // empty] | first) as $dup
    | if $r == [] then "\($key) owned:\($id) is on no board here"
      elif any($r[]; .state != "done") then empty
      elif $dup != null then "\($key) owned:\($id) is closed, folded into \($dup)"
      else "\($key) owned:\($id) is closed" end' <<<"$feed"
}

# A cleanup item merges itself at any hour behind the red-fix gate (policy.md), so nobody is there
# when it breaks something: these are its post-merge guard. Each red reads as one record naming
# every merge it could be, because one red that queued a fix per merge would be a stampede.

# hold_ledger <owner/repo> -> "<ledger name> <base branch>" from `schedules-sync repos`, the one
# list of watched repos: a GitHub repo as listed, else a Forgejo one as forgejo:owner/repo (the
# name pr_ci uses), else "prs-only" for a repo listed only for its PRs (a work or client repo whose
# runs the ledger never reads), else the repo and main, which the ledger then answers for.
hold_ledger() {
  { "$SCHEDULES_SYNC" repos 2>/dev/null || echo '[]'; } | jq -r --arg want "${1,,}" --arg fallback "$1 main" '
    def on($f): map(select(.forge == $f and (.repo | ascii_downcase) == $want)) | first | select(.);
    (on("github") | "\(.repo) \(.base)") // (on("forgejo") | "forgejo:\(.repo | ascii_downcase) \(.base)")
      // (on("prs-only") | "prs-only \(.base)") // $fallback'
}

# hold_runs <owner/repo> -> the runs main's pushes started, from main_runs (exit 3: the run ledger
# does not sync the repo; exit 5: it lists the repo for its PRs alone, so no run of it is ever read).
# A scheduled run is left out: it fails on the environment moving, not on a merge.
hold_runs() {
  local runs name base
  read -r name base < <(hold_ledger "$1")
  [ "$name" != prs-only ] || return 5
  runs=$(main_runs "$name" "$base") || return
  jq -c 'map(select(.event == "push"))' <<<"$runs"
}

# hold_memo <key> <command...> -> the command's output, kept for a read that cannot change (a run's
# log, a commit's files, a file at a sha): a red stands for many passes and every hub refresh and KPI
# sample reads it, on the REST budget of 2026-10-29. A failed read is not kept.
hold_memo() {
  local file="$MAIN_CACHE/hold_$1" out tmp
  shift
  [ -e "$file" ] && { cat "$file"; return; }
  out=$("$@") || return 1
  mkdir -p "$MAIN_CACHE"
  find "$MAIN_CACHE" -maxdepth 1 -name 'hold_*' -mtime +"$REDS_DAYS" -delete
  # mktemp, not $$: concurrent sections (par_go) share the parent's $$
  tmp=$(mktemp "$file.XXXXXX") && printf '%s\n' "$out" > "$tmp" && mv "$tmp" "$file"
  printf '%s\n' "$out"
}

# hold_failed <owner/repo> <run id> -> the bats files that failed in that run, repo-relative; rc 1
# when its log cannot be read, or is not there yet. gh cannot read a Forgejo run's log, so one names
# no file and counts against the merges since the last green, like any red that names none. Only a
# TAP diagnostic line (# first, then perhaps "(from function `setup'") names a failure: a bats
# warning (BW02) prints the same "in test file" trace without the #, and named a file that passed
# (ar-4122).
hold_failed() {
  local log
  [[ $(hold_ledger "$1") != forgejo:* ]] || return 0
  log=$(gh run view "$2" -R "$1" --log-failed 2>/dev/null) && [ -n "$log" ] || return 1
  { grep -oE '#[^,]*in test file [^,]+\.bats' <<<"$log" || true; } | sed -E 's#.*[ /](unit|integ|ui)/#tests/\1/#' | sort -u
}

# hold_test <owner/repo> <sha> <file> -> the file's text at that sha
hold_test() {
  gh api -H 'Accept: application/vnd.github.raw+json' "repos/$1/contents/$3?ref=$2" 2>/dev/null
}

# hold_streak <owner/repo> <streak> <runs> <merges> -> the record for main's red streak, if it counts
# against a merge: one landed at or before the first red and within HOLD_HOURS of it. A merge's time
# is its own run's, since the item finishes after the push. The failed bats files narrow that to the
# merges whose area they are, the ones the Stop hook would pick for what each changed; a red that names none (lint, rust, a timeout) leaves only the merges
# in last green..first red. The runs reach jq by file, since main's push runs pass the 128 KB
# one-argument limit (ar-1619).
hold_streak() {
  local repo=$1 streak=$2 near id failed sha msha m f paths hits unread=0
  local -A body
  near=$(jq -c --arg repo "$repo" --argjson s "$streak" --slurpfile runs <(printf '%s\n' "$3") --argjson h "$((HOLD_HOURS * 3600))" "$JQ_LIB"'
    ($s.red.createdAt | ep) as $red | .[] | select(.repo == $repo)
    | . as $m | .at = (([$runs[0][] | select(.workflowPath == $s.red.workflowPath and .headSha == $m.sha) | .createdAt | ep] | first) // $m.at)
    | select(.at <= $red and $red - .at <= $h)' <<<"$4")
  [ -n "$near" ] || return 0
  id=$(jq -r .red.id <<<"$streak")
  failed=$(hold_memo "failed_${repo//\//_}_$id" hold_failed "$repo" "$id") ||
    { say "hold: cannot read the log of run $id on $repo"; return 1; }
  sha=$(jq -r .red.headSha <<<"$streak")
  if [ -n "$failed" ]; then
    while IFS= read -r f; do
      body[$f]=$(hold_memo "test_${repo//\//_}_${sha}_${f//\//_}" hold_test "$repo" "$sha" "$f") ||
        { say "hold: cannot read $f on $repo at ${sha:0:8}"; unread=1; }
    done <<<"$failed"
    hits=$(rc=0; while IFS= read -r m; do
      msha=$(jq -r .sha <<<"$m")
      paths=$(hold_memo "files_${repo//\//_}_$msha" commit_paths "$repo" "$msha" 2>/dev/null) ||
        { say "hold: cannot read the files of $repo ${msha:0:8}"; rc=1; continue; }
      for f in "${!body[@]}"; do
        test_picked "$paths" "$f" <<<"${body[$f]}" && { printf '%s\n' "$m"; break; }
      done
    done <<<"$near"; exit "$rc") || unread=1
  else
    hits=$(jq -c --argjson s "$streak" "$JQ_LIB"'select(.at > ($s.green.createdAt | ep))' <<<"$near")
  fi
  [ -n "$hits" ] || return "$unread"
  jq -cs --argjson s "$streak" --arg failed "$failed" '
    {name: "ci-\($s.red.headSha[0:8])-\($s.workflow | ascii_downcase | gsub("[^a-z0-9]+"; "-"))",
     what: "\($s.workflow) red at \($s.red.headSha[0:8])\(if $failed == "" then ", no bats file named" else ": " + ($failed | split("\n") | join(", ")) end)",
     merges: .}' <<<"$hits"
  return "$unread"
}

# repo_path <file> -> "owner/repo<TAB>path" for the checkout holding the file, links followed, so a
# stowed script lands in the repo it was written in, and a link a merge left dangling still names
# the path it removed; rc 1 when it is in no checkout with an origin
repo_path() {
  local f top url
  f=$(readlink -f "$1") && [ -d "${f%/*}" ] || return 1
  top=$(git -C "${f%/*}" rev-parse --show-toplevel 2>/dev/null) || return 1
  url=$(git -C "$top" remote get-url origin 2>/dev/null) || return 1
  url=${url%/}; url=${url%.git}
  printf '%s\t%s\n' "$(sed -E 's#.*[:/]([^/:]+/[^/:]+)$#\1#' <<<"$url" | tr '[:upper:]' '[:lower:]')" "${f#"$top"/}"
}

# liveness_reach -> repo_path of each file a runner the fleet-liveness probe names runs from: its
# conf and each $HOME-, ~- or /-rooted word of its COMMAND; rc 1 when the probe's output cannot be
# read. The probe prints one "<runner>: <fault>" line each; a line naming no runner conf (a fleet
# pause) reaches nothing.
liveness_reach() {
  local n c cmd w words o="$TRIAGE_WATCH_STATE/fleet-liveness.out"
  [ -r "$o" ] || return 1
  { grep -oE '^[A-Za-z0-9_.-]+:' "$o" || true; } | tr -d : | sort -u |
  while IFS= read -r n; do
    for c in "$LEDGER_CONF_DIR"/*.conf; do
      [ -e "$c" ] || continue
      [ "$(sed -n '/^NAME=/{s///p;q;}' "$c" | tr -d "\"'")" = "$n" ] || [ "$(basename "$c" .conf)" = "$n" ] || continue
      repo_path "$c" || true
      cmd=$(sed -n '/^COMMAND=/{s///p;q;}' "$c" | tr -d "\"'")
      read -ra words <<<"$cmd"
      for w in "${words[@]}"; do
        w=${w//'${HOME}'/$HOME}; w=${w//'$HOME'/$HOME}; [[ "$w" == '~/'* ]] && w=$HOME/${w#'~/'}
        [[ "$w" == /* ]] && { repo_path "$w" || true; }
      done
      break
    done
  done
}

# hold_reaching <merges> <reach> -> each merge, a line, that changed a file of the reach in its repo;
# rc 1 when a merge's files cannot be read
hold_reaching() {
  local m repo msha paths rc=0
  [ -n "$2" ] || return 0
  while IFS= read -r m; do
    repo=$(jq -r .repo <<<"$m"); msha=$(jq -r .sha <<<"$m")
    awk -F'\t' -v r="${repo,,}" '$1 == r { f = 1 } END { exit !f }' <<<"$2" || continue
    paths=$(hold_memo "files_${repo//\//_}_$msha" commit_paths "$repo" "$msha" 2>/dev/null) ||
      { say "hold: cannot read the files of $repo ${msha:0:8}"; rc=1; continue; }
    awk -F'\t' -v r="${repo,,}" 'NR == FNR { if ($1 == r) want[$2]; next } $0 in want { f = 1; exit } END { exit !f }' \
      <(printf '%s\n' "$2") <(printf '%s\n' "$paths") && printf '%s\n' "$m"
  done < <(jq -c '.[]' <<<"$1")
  return "$rc"
}

# hold_reds <now> <queue items> -> one record a line for each red now that counts against a cleanup
# merge: {name, what, merges}. fleet-liveness counts once it is past triage's patience, so a flap
# stays out, and only against a merge liveness_reach says could reach a runner its probe names.
# A repo or run that cannot be read, or that the run ledger does not hold, says so and
# counts as nothing, and the return is 1 so a caller that needs "not red" can tell that from "unknown".
# A repo the ledger lists for its PRs alone (prs-only) has no main to guard: it is skipped quietly.
hold_reds() {
  local t=$1 merges repo runs rc streak since near hits='' reach w=fleet-liveness h=$((HOLD_HOURS * 3600)) unread=0
  # pr: and merged: are lists in step, one PR per repo (agent-land)
  merges=$(jq -c "$JQ_LIB"'[.[] | select(tagged("cleanup") and (.merged // "") != "" and (.finished | ep) != null)
    | . as $i | [(.pr | tostring | split(" ")), (.merged | tostring | split(" "))] | transpose[]
    | select((.[0] // "" | test("^[^/# ]+/[^/# ]+#[0-9]+$")) and .[1] != null)
    | {slug: $i.slug, repo: (.[0] | split("#")[0]), n: (.[0] | split("#")[1]), sha: .[1], at: ($i.finished | ep)}]' <<<"$2") || return 1
  [ "$merges" != '[]' ] || return 0
  if since=$(watch_tripped_since "$w" "$t"); then
    near=$(jq -c --argjson s "$since" --argjson h "$h" 'map(select(.at <= $s and $s - .at <= $h))' <<<"$merges")
    if [ "$near" != '[]' ]; then
      reach=$(liveness_reach) || { say "hold: cannot read the fleet-liveness probe output"; unread=1; }
      hits=$(hold_reaching "$near" "$reach") || unread=1
    fi
    [ -z "$hits" ] || jq -cs --argjson s "$since" --arg w "$w" \
      '{name: "liveness-\($s)", what: "\($w) tripped, evidence: watch-companion-loop list --long \($w)", merges: .}' <<<"$hits"
  fi
  while IFS= read -r repo; do
    rc=0; runs=$(hold_runs "$repo") || rc=$?
    # A prs-only repo has no runs to read by its config: nothing to hold, and not an unknown.
    [ "$rc" -ne 5 ] || continue
    if [ "$rc" -eq 3 ]; then say "hold: $repo is not in the run ledger (schedules-sync repos), so nothing guards its main"; unread=1; continue; fi
    [ "$rc" -eq 0 ] || { say "hold: cannot read the runs on $repo main"; unread=1; continue; }
    while IFS= read -r streak; do
      hold_streak "$repo" "$streak" "$runs" "$merges" || unread=1
    done < <(jq -c "$MAIN_LIVE | $MAIN_STREAKS"' | select(.green)' <<<"$runs")
  done < <(jq -r 'map(.repo) | unique[]' <<<"$merges")
  return "$unread"
}

# reds_items <now> -> the queue items of the last REDS_DAYS as one array; rc 1 when unreadable
reds_items() {
  bench_read $TRIAGE_ITEMS_CMD --since "$(date -d "@$(($1 - REDS_DAYS * 86400))" +%F)" 2>/dev/null | jq -cs .
}

# triage_hold_rows -> a row per red that counts against a cleanup merge, naming each merge
triage_hold_rows() {
  local t items
  t=$(now)
  items=$(reds_items "$t") || return 0
  hold_reds "$t" "$items" | jq -r "$JQ_LIB"'(.merges | map("\(.slug) (PR \(.n) at \(.sha[0:8]))") | join(", ")) as $m
    | "\(hold_key)\t\(hold_key) after cleanup merge\(if (.merges | length) > 1 then "s" else "" end) \($m): \(.what)\t#high"'
}

# reds_live <hold_reds records> -> the row key of each thing red right now, one a line: every triage
# row, every hold, plus every watch at TRIP whatever its age, so a fix that came back counts before
# triage would file it.
reds_live() {
  { triage_rows; triage_log_rows; triage_red_rows; } | cut -f1
  jq -r "$JQ_LIB"'hold_key' <<<"$1"
  watch_keys TRIP
}

# watch_keys <state> -> the row key of every watch in that Sentinel state, one a line
watch_keys() {
  local f
  for f in "$TRIAGE_WATCH_STATE"/*.state; do
    [ -e "$f" ] && [ "$(cat "$f")" = "$1" ] || continue
    f=${f##*/}
    ! watch_paused "${f%.state}" || continue
    # its alerts are its rows (triage_alert_rows), so its own row is no live red while they are listed
    [ "$1" = TRIP ] && [ "${f%.state}" = "$TRIAGE_ALERT_WATCH" ] && [ -n "$(triage_alerts)" ] && continue
    printf 'check(watch): %s tripped since\n' "${f%.state}"
  done
}

# red_titles <items> -> {<title>: {area, name}} for each red item whose title parses as
# `type(area): <name> ...` with a name word, from one `notes row parse` (the grammar's home); fails, saying so,
# when the verb fails or answers short. A newline in a title reads as a space, as in reds_json.
red_titles() {
  local titles parsed
  titles=$(jq -c "$JQ_LIB"'[.[] | select(tagged("red")) | .title // .task // "" | gsub("\n"; " ")] | unique' <<<"$1") || return 1
  [ "$titles" != '[]' ] || { echo '{}'; return 0; }
  parsed=$(jq -r '.[]' <<<"$titles" | notes row parse) ||
    { say "reds: notes row parse failed (an old notes? notes-bootstrap --build-only)"; return 1; }
  # titles grows with the queue, past the 128 KB one argument can carry (reds_json): it comes in as a file
  jq -cRn --slurpfile t <(printf '%s\n' "$titles") '$t[0] as $t | [inputs | split("\t")] as $p
      | if ($p | length) != ($t | length) then error("short") else . end
      | [range($t | length) as $i | select($p[$i][3] == "1")
         | {key: $t[$i], value: {area: $p[$i][1], name: ([$p[$i][2] | capture("^(?<n>[^ ,;]+)").n][0])}}
         | select(.value.name != null)] | from_entries' <<<"$parsed" ||
    { say "reds: notes row parse answered short, or jq failed (its error is above)"; return 1; }
}

# alert_titles <items> -> the titles of the red items whose row TRIAGE_ROUTES sends to alert, as a
# JSON array: their watch pages the human on a KPI past its bound, so no merge can clear it.
alert_titles() {
  jq -r "$JQ_LIB"'.[] | select(tagged("red")) | .title // .task // "" | gsub("\n"; " ")' <<<"$1" | sort -u |
    while IFS= read -r title; do
      if triage_line "$title" && [ "$route" = alert ]; then printf '%s\n' "$title"; fi
    done | jq -Rsc 'split("\n") | map(select(. != ""))'
}

# reds_json <now> -> one JSON object a line per red queue item queued in the last REDS_DAYS, then
# per merged cleanup item (cleanup: true, its outcome the hold: the reds line of the usage above): what
# was red, its cause, when it was queued and finished, its PR and merge, and its outcome. A merged
# fix is "fixed" only while nothing it was queued for is red now; red again with the watch's trip
# after the merge is "came back", red the whole time is "still red", and red now with its row routed
# to alert is "alert route" (its watch pages, and the KPI it trips on is not a merge's to clear).
# Each red row also names its item's board row id (row, the ticket) and session, and a fix in hand (queued or fixing) its due epoch,
# which the overviews read as past its ETA (hub_core::alerts). Counted, never judged.
# Returns 3 after its rows when a cleanup hold could not be read (hold_reds said which): a red that
# hold should key may be missing from live, so a fix can read fixed while its red is not gone.
reds_json() {
  local t="$1" items holds live watches='{}' f n parsed alerted partial=0
  items=$(reds_items "$t") || { say "reds: cannot read the queue ($TRIAGE_ITEMS_CMD)"; return 1; }
  parsed=$(red_titles "$items") || return 1
  alerted=$(alert_titles "$items") || return 1
  holds=$(hold_reds "$t" "$items" | jq -cs .) || partial=3
  live=$(reds_live "$(jq -c '.[]' <<<"$holds")" | sort -u | jq -Rsc 'split("\n") | map(select(. != ""))')
  for f in "$TRIAGE_WATCH_STATE"/*.since; do
    [ -e "$f" ] || continue
    n=${f##*/} n=${n%.since}
    watches=$(jq -c --arg n "$n" --arg s "$(cat "$f")" '. + {($n): ($s | tonumber? // 0)}' <<<"$watches")
  done
  jq -c --slurpfile live <(printf '%s\n' "$live") --slurpfile w <(printf '%s\n' "$watches") \
    --slurpfile holds <(printf '%s\n' "$holds") --argjson clock "$t" \
    --slurpfile parsed <(printf '%s\n' "$parsed") --slurpfile alerted <(printf '%s\n' "$alerted") \
    --argjson h "$((HOLD_HOURS * 3600))" --argjson n "$REDS_ETA_SAMPLES" "$JQ_LIB"'
    # each grows with the queue or the watches, past the 128 KB one argument can carry: they come in as files
    $live[0] as $live | $w[0] as $w | $holds[0] as $holds | $parsed[0] as $parsed | $alerted[0] as $alerted
    | def title: .title // .task // "";
    # the board row the item works as, its id alone (ar-5133): its row:, else the row it was promoted from (agent-queue item_row)
    def rowid: (.row // "") as $r | (.from // "") as $f
        | (if $r != "" then $r elif ($f | startswith("board:")) then ($f | ltrimstr("board:")) else "" end)
        | (split(":") | last // "") | if . == "" then null else . end;
    ([$holds[].merges[].slug]) as $went
    | ([.[] | select(tagged("red")) | title | select(startswith("fix(hold): "))]) as $held
    | ([.[] | select(tagged("cleanup") and (tagged("red") | not) and (.merged // "") != "")
        | {slug, row: rowid, project: (.project // ""), red: ("cleanup " + (title[0:60])), cause: null, state, queued, finished, pr, merged,
           fix_min: null, cleanup: true,
           outcome: (.slug as $s | if $s | IN($went[]) then "went red"
                     elif any($held[]; contains(" \($s) (")) then "recovered"
                     elif $clock - ((.finished | ep) // 0) < $h then "holding" else "held" end)}]) as $cleanups
    | [.[] | select(tagged("red")) | title as $t
    | ($parsed[$t | gsub("\n"; " ")] // {}) as $r
    | ((" " + (.tags // "") + " ") | capture(" cause:(?<c>[^ ]+) ").c // null) as $cause
    | ([$live[] as $k | select($t | startswith($k))] | length > 0) as $red
    | (.finished | ep) as $fin
    | {slug, row: rowid, project: (.project // ""), red: (if $r.name then "\($r.area) \($r.name)" else $t[0:60] end), cause: $cause, state,
       session, queued, finished, pr, merged,
       fix_min: (if .merged != null and $fin != null and (.queued | ep) != null then ((($fin - (.queued | ep)) / 60) | floor) else null end),
       outcome: (
         if .state == "queued" then "queued"
         elif .state == "running" or .state == "review" or .state == "waiting" then "fixing"
         elif .merged != null then
           (if $red | not then "fixed"
            elif $t | gsub("\n"; " ") | IN($alerted[]) then "alert route"
            elif $r.area == "watch" and $fin != null and ($w[$r.name] // 0) > $fin then "came back"
            else "still red" end)
         elif .status == "cancelled" then "cancelled"
         elif .pr != null then "needs merge"
         elif .status == "ok" then "cleared"
         else "no fix" end)}] as $reds
    # A fix in hand is due once it has taken as long as 9 in 10 of the window'"'"'s merged fixes did
    # (nearest rank), counted from when it was queued; fewer than $n merged fixes give no due time.
    | ([$reds[] | .fix_min // empty] | sort) as $m
    | (if ($m | length) >= $n then $m[((($m | length) * 0.9) | ceil) - 1] else null end) as $p90
    | ($reds[] | . + {due: (if $p90 != null and (.outcome == "queued" or .outcome == "fixing") and (.queued | ep) != null
                             then (.queued | ep) + $p90 * 60 else null end)}), $cleanups[]' <<<"$items" || return 1
  return "$partial"
}

# reds_counts <now> -> the KPI lines: merged fixes whose red is back or never went (reds_unfixed),
# and the median minutes from queued to merged (red_fix_min_p50), ? when the queue cannot be read;
# reds_unfixed alone is ? when a cleanup hold cannot be (reds_json returns 3), since it reads what is red now
reds_counts() {
  local rows rc=0
  rows=$(reds_json "$1" | jq -cs .) || rc=$?
  [ "$rc" -eq 0 ] || [ "$rc" -eq 3 ] || { echo "reds_unfixed=?"; echo "red_fix_min_p50=?"; return 0; }
  jq -r --argjson fix "$FIX_SINCE" --argjson part "$rc" "$JQ_LIB"'"reds_unfixed=\(if $part != 0 then "?" else [.[] | select((.outcome == "still red" or .outcome == "came back")
      and ((.finished | ep) // $fix) >= $fix)] | length end)",
    "red_fix_min_p50=\([.[] | .fix_min // empty] | sort | if length == 0 then "?" else .[(length - 1) / 2 | floor] end)"' <<<"$rows"
}

cmd_reds() {
  local json=0 rows rc=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      --days) REDS_DAYS="${2:?--days needs a count}"; shift ;;
      *) say "usage: fleet-bench reds [--json] [--days N]"; return 2 ;;
    esac
    shift
  done
  [[ "$REDS_DAYS" =~ ^[1-9][0-9]*$ ]] || { say "reds: --days takes a day count"; return 2; }
  # reds_json said why; a partial read (3) still lists its rows, and the text says what it may miss
  rows=$(reds_json "$(now)") || rc=$?
  [ "$rc" -eq 0 ] || [ "$rc" -eq 3 ] || return 1
  # --json keeps exit 0 and its rows for the overviews (a nonzero exit reads as an error there), so it says it on stderr
  if [ "$rc" -eq 3 ]; then
    local u="unreadable: a cleanup hold could not be read, so a fix below may read fixed while its red is live"
    if [ "$json" = 1 ]; then echo "$u" >&2; else echo "$u"; fi
  fi
  if [ "$json" = 1 ]; then [ -z "$rows" ] || printf '%s\n' "$rows"; return 0; fi
  [ -n "$rows" ] || { echo "no red fix queued in the last $REDS_DAYS days"; return 0; }
  jq -rs --arg d "$REDS_DAYS" '
    def words: group_by(.outcome) | map("\(length) \(.[0].outcome)") | join(", ");
    map(select(.cleanup | not)) as $f | map(select(.cleanup)) as $c
    | (if $f == [] then empty else "\($f | length) red fix\(if ($f | length) == 1 then "" else "es" end) in \($d)d: \($f | words)" end),
    (if $c == [] then empty else "\($c | length) cleanup merge\(if ($c | length) == 1 then "" else "s" end) in \($d)d: \($c | words)" end),
    "", "| item | red | outcome | queued | fix min | PR |", "|---|---|---|---|---|---|",
    (.[] | "| \(.slug) | \(.red) | \(.outcome) | \(.queued // "-" | .[0:16]) | \(.fix_min // "-") | \(.pr // "-") |")' <<<"$rows"
}

# alerts_readable -> 1 when the alert watch says what is firing: it is not paused and is OK (nothing
# fires) or TRIP with alerts listed; 0 for ERROR (Alertmanager unreachable), a pause or missing
# evidence, where an open check(alert) row stays rather than reading as recovered.
alerts_readable() {
  local s
  ! watch_paused "$TRIAGE_ALERT_WATCH" || { echo 0; return; }
  s=$(cat "$TRIAGE_WATCH_STATE/$TRIAGE_ALERT_WATCH.state" 2>/dev/null)
  if [ "$s" = OK ] || { [ "$s" = TRIP ] && [ -n "$(triage_alerts)" ]; }; then echo 1; else echo 0; fi
}

# row_in_hand <items json> <raw row> -> rc 0 when a live queue item (queued, running, waiting, review)
# holds the row its id names, when the row names no id, or when the items cannot be read. A `[/]` row
# held by none is orphaned: its item closed (ok with no PR, cancelled) and nothing works it, so triage
# treats it as a todo row (ar-4415, ar-4654: six such rows sat open on watches that read OK).
row_in_hand() {
  local rc
  [[ $2 =~ id:([a-z]+-[0-9]+) ]] || return 0
  jq -e --arg id "${BASH_REMATCH[1]}" 'any(.[]; (.state | IN("queued", "running", "waiting", "review"))
    and ((.row // "") | . == $id or endswith(":" + $id)))' <<<"$1" >/dev/null 2>&1
  rc=$?; [ "$rc" != 1 ]
}

# triage_retire <dry> -> closes each check(watch), fix(hold), fix(logs) or fix(unit) row nobody works (todo, or an agent-board row started with no live item: row_in_hand) whose
# key left reds_live, so a recovered fault stops reading as a red; if it comes back, triage files it
# again. Only a reading that says "not red" closes a row. These stay open: every row when the queue or the
# board cannot be read, a watch whose probe could not run (ERROR), a log row log_recent does not read
# as recovered (its error in a newest run, too few runs, no ledger), every hold row when a repo's runs
# could not be read, every unit row when systemctl cannot list the failed units, every alert row unless the alert watch is read (alerts_readable), and a ci- hold whose
# merge has left the REDS_DAYS window hold_reds reads. A row
# that fails to close is said and tried again next pass: retiring never stops new reds being filed.
# Leaves the count in TRIAGE_RETIRED.
triage_retire() {
  local dry=$1 scope sheet t items holds holds_read=1 live board slugs title raw key recent logs_read=1 runner units_read=1 alerts_read
  local merge='after cleanup merges? ([^ ]+) \('
  TRIAGE_RETIRED=0
  [ -d "$TRIAGE_WATCH_STATE" ] || return 0
  t=$(now)
  # The board is read before the queue: a row dispatch starts between the two reads then shows its
  # item, so row_in_hand never reads a just-started row as one no item holds.
  board=$($BENCH_NOTES_CMD ptask "$KPI_BOARD" --agent list) || { say "retire: $KPI_BOARD agent board unreadable"; return 0; }
  board=$(sed 's/^/--agent\t/' <<<"$board")
  # The human sheet too: a row an earlier triage wrote there (a spent cause, a tripped watch) is closed
  # the same way once its red is gone. An unreadable sheet is skipped, never a reason to keep the agent rows.
  sheet=$($BENCH_NOTES_CMD ptask "$KPI_BOARD" list 2>/dev/null </dev/null) && board+=$'\n'$(sed 's/^/-\t/' <<<"$sheet")
  items=$(reds_items "$t") || return 0
  holds=$(hold_reds "$t" "$items") || holds_read=0
  recent=$(log_recent) || logs_read=0
  failed_units >/dev/null || units_read=0
  live=$({ reds_live "$holds"; watch_keys ERROR; } | tr '[:upper:]' '[:lower:]')
  slugs=$(jq -r '.[].slug' <<<"$items")
  alerts_read=$(alerts_readable)
  while IFS=$'\t' read -r scope _ _ title raw; do
    [[ $title =~ $BOARD_KEY_ERE ]] || continue
    key=${BASH_REMATCH[1]}
    # only these kinds close on recovery; a red, runner or lesson row is board_upsert's alone
    case $key in 'check(watch): '* | 'check(alert): '* | 'fix(hold): '* | 'fix(logs): '* | 'fix(unit): '*) ;; *) continue ;; esac
    runner=; [[ $key =~ ^fix\(logs\):\ ([^ ]+) ]] && runner=${BASH_REMATCH[1]}
    [ "$scope" != - ] || scope=
    ! grep -qxF -- "$key" <<<"$live" || continue
    # A started sheet row is the human's (or a hand session's), which no queue item tracks: it stays.
    [[ $raw == '- [ ]'* ]] || { [ -n "$scope" ] && [[ $raw == '- [/]'* ]] && ! row_in_hand "$items" "$raw"; } || continue
    [[ $key == 'check(alert): '* ]] && [ "$alerts_read" = 0 ] && continue
    if [[ $key == 'fix(logs): '* ]]; then
      [ "$logs_read" = 1 ] && grep -qxF -- "runner $runner" <<<"$recent" && ! grep -qxF -- "$key" <<<"$recent" || continue
    fi
    [[ $key == 'fix(unit): '* ]] && [ "$units_read" = 0 ] && continue
    if [[ $key == 'fix(hold): '* ]]; then
      [ "$holds_read" = 1 ] || continue
      if [[ $key == 'fix(hold): ci-'* ]]; then
        [[ $raw =~ $merge ]] && grep -qxF -- "${BASH_REMATCH[1]}" <<<"$slugs" || continue
      fi
    fi
    if [ "$dry" = 1 ]; then echo "retire: $key"; TRIAGE_RETIRED=$((TRIAGE_RETIRED + 1)); continue; fi
    if $BENCH_NOTES_CMD ptask "$KPI_BOARD" $scope done "$key" --proof "run:fleet-bench-triage-$(date -d "@$t" +%F)" >/dev/null; then
      TRIAGE_RETIRED=$((TRIAGE_RETIRED + 1))
    else
      say "retire: could not close $key"
    fi
  done <<<"$board"
}

cmd_triage() {
  local rows filed dry=0 causes="" q h text re route skill fix tags key extra gone did
  case "${1:-}" in
    "") ;;
    --dry-run) dry=1 ;;
    --causes) dry=1; causes=1 ;;
    --route)
      # The route table as a query, one row key an argument: the Schedules tab's triage column.
      shift
      # An unreadable table is a failed read, not a table with no route for any key.
      [ -r "$TRIAGE_ROUTES" ] || { say "triage --route: cannot read $TRIAGE_ROUTES"; return 2; }
      for key in "$@"; do
        triage_shape "${key%% *}" "${key#* }"
        if triage_line "$text"; then
          printf '%s\t%s\t%s\t%s\n' "$key" "$route" "$skill" "$tags"
        else
          printf '%s\t-\t-\t\n' "$key"
        fi
      done
      return 0
      ;;
    --coverage)
      rows=$(triage_coverage)
      [ -z "$rows" ] || { echo "$rows"; return 1; }
      return 0
      ;;
    *) say "usage: fleet-bench triage [--dry-run|--causes|--coverage|--route <key>...]"; return 2 ;;
  esac
  TRIAGE_GONE=$(triage_reset_gone "$dry")
  gone=$(grep -c . <<<"$TRIAGE_GONE")
  rows=$({ triage_rows; triage_log_rows; triage_red_rows; triage_hold_rows; } | grep .)
  # A liveness hold row is the same red as the watch's own row, with its suspects named: one fix.
  grep -q '^fix(hold): liveness-' <<<"$rows" && rows=$(grep -v '^check(watch): fleet-liveness tripped since' <<<"$rows")
  [ -n "$rows" ] && rows=$(triage_route "$rows")
  if [ -n "$causes" ]; then
    # The tags triage_promote files each red it queues with, once per cause, less its retry: tag.
    local seen=' ' cause
    while IFS=$'\t' read -r key _ _ route cause tags; do
      triage_queues "$key" "$route" && [[ "$seen" != *" $cause "* ]] || continue
      seen+="$cause "
      printf 'red%s cause:%s%s\t%s\n' "$(triage_kind "$key")" "$cause" "${tags:+ $tags}" "$key"
    done <<<"$rows"
    return 0
  fi
  if [ "$dry" = 1 ]; then
    [ -z "$rows" ] || awk -F'\t' '{ print $2, $3 ($4 == "-" ? "" : " (" $4 ")") }' <<<"$rows"
    triage_retire 1
    return 0
  fi
  triage_retire 0
  did=$(printf '%s' "$([ "$TRIAGE_RETIRED" -gt 0 ] && echo "$TRIAGE_RETIRED recovered rows closed")$([ "$gone" -gt 0 ] && echo " $gone failed units reset")" | sed 's/^ //')
  if [ -z "$rows" ]; then
    triage_spent_write ''
    say "no runner, unit, watch or log error at fault"
    if [ -n "$did" ]; then report_outcome WORKED "$did"
    else report_outcome NOOP "no runner, unit, watch or log error at fault"; fi
    return 0
  fi
  filed=$(triage_filed "$rows")
  # A held lock fails this pass's filing (upsert_report says so) but not the human sheet, twins or red fixes after it.
  if [ -n "$filed" ]; then
    board_upsert "$(cut -f1-3 <<<"$filed")" || { [ $? = 2 ] || return 1; UPSERT_FAILED="$UPSERT_LOCK_WHY"; }
  else UPSERT_ADDED=0; UPSERT_EDITED=0; UPSERT_REOPENED=0; UPSERT_DROPPED=0; UPSERT_CAPPED=0; UPSERT_FAILED=; fi
  h=$(triage_human "$rows")
  triage_twins "$rows" "$(cut -f1 <<<"$filed")"
  q=$(triage_promote "$rows")
  extra=$(printf '%s' "$([ "$q" -gt 0 ] && echo "$q queued as red fixes")${h:+$([ "$h" -gt 0 ] && echo " $h for the human")}${did:+ $did}" | sed 's/^ //')
  upsert_report "$rows" "$extra"
}

# health: the fleet's parts joined to the watches that probe them. The parts list and each watch's
# `flows:` names come from sentinel-manifest, a watch's reading from Sentinel's own <watch>.state
# (the files triage reads), so this runs no probe and asks no model. A watch with no reading yet
# (state "new") is not a live probe: it shows beside its part but does not make it covered.
# Rows: "<part> TAB <OK|TRIP/Q|TRIP|ERROR|UNCOVERED> TAB <watch=STATE, ...>", then "! TAB <watch> TAB <name>"
# for a `flows:` name that is no part (a renamed Flows row, or a part left out of the list).
health_rows() {
  local parts tags w p s lastrun err
  err=$(mktemp) || return 1
  # stderr stays out of the data and is shown only when the command fails
  parts=$($HEALTH_MANIFEST_CMD parts 2>"$err") || { say "health: cannot read the parts list: $(cat "$err")"; rm -f "$err"; return 1; }
  [ -n "$parts" ] || { rm -f "$err"; say "health: the parts list is empty"; return 1; }
  tags=$($HEALTH_MANIFEST_CMD tags "$TRIAGE_WATCHES" 2>"$err") || { say "health: cannot read the watch tags: $(cat "$err")"; rm -f "$err"; return 1; }
  rm -f "$err"
  # A dead Sentinel leaves every .state frozen, so a reading older than the watch's poll window
  # (sentinel-watch.sh, the rule every reader of a watch shares) is STALE, and counts as ERROR.
  tags=$(while IFS=$'\t' read -r w p; do
    [ -n "$w" ] || continue
    s=new; [ -r "$TRIAGE_WATCH_STATE/$w.state" ] && read -r s <"$TRIAGE_WATCH_STATE/$w.state"
    lastrun=""; [ -r "$TRIAGE_WATCH_STATE/$w.lastrun" ] && read -r lastrun <"$TRIAGE_WATCH_STATE/$w.lastrun"
    case "$s" in OK|TRIP|ERROR) watch_is_stale "$TRIAGE_WATCHES/$w.yaml" "$lastrun" "${BENCH_NOW:-}" && s=STALE ;; esac
    # A quarantined red (sentinel-watch.sh) is a warning, TRIP/Q: above OK, below TRIP, and the verdict
    # reads GAPS, not RED. A STALE reading still wins over it: a dead Sentinel is an ERROR.
    [ "$s" != TRIP ] || ! watch_quarantined "$TRIAGE_WATCH_STATE" "$w" "${BENCH_NOW:-}" || s=TRIP/Q
    printf '%s\t%s\t%s\n' "$w" "$p" "${s:-new}"
  done <<<"$tags")
  awk -F'\t' -v OFS='\t' '
    NR == FNR { if ($0 != "") order[++n] = $0; known[$0] = 1; next }
    { if (!($2 in known)) { stale[++ns] = $1 OFS $2; next }
      list[$2] = list[$2] (list[$2] == "" ? "" : ", ") $1 "=" $3
      r = ($3 == "ERROR" || $3 == "STALE") ? 4 : ($3 == "TRIP") ? 3 : ($3 == "TRIP/Q") ? 2 : ($3 == "OK") ? 1 : 0
      if (r > worst[$2]) worst[$2] = r }
    END {
      split("UNCOVERED OK TRIP/Q TRIP ERROR", name, " ")
      for (i = 1; i <= n; i++) print order[i], name[worst[order[i]] + 1], (order[i] in list ? list[order[i]] : "-")
      for (i = 1; i <= ns; i++) print "!", stale[i]
    }' <(printf '%s\n' "$parts") <(printf '%s' "$tags")
}

cmd_health() {
  local rows cov=0 verdict
  while [ $# -gt 0 ]; do
    case "$1" in
      --coverage) cov=1 ;;
      *) say "usage: fleet-bench health [--coverage]"; return 2 ;;
    esac
    shift
  done
  rows=$(health_rows) || return 1
  if [ "$cov" = 1 ]; then
    rows=$(awk -F'\t' '$1 == "!" { print "stale flows name: " $2 " names " $3; next } $2 == "UNCOVERED" { print $1 }' <<<"$rows")
    [ -z "$rows" ] || { echo "$rows"; return 1; }
    return 0
  fi
  verdict=$(awk -F'\t' '
    $1 == "!" { stale++; next }
    { n++; c[$2]++; if ($2 == "TRIP" || $2 == "ERROR") bad = bad (bad == "" ? "" : ", ") $1
      if ($2 == "TRIP/Q") q = q (q == "" ? "" : ", ") $1 }
    END {
      v = (c["TRIP"] + c["ERROR"] > 0) ? "RED" : (c["UNCOVERED"] + c["TRIP/Q"] + stale > 0) ? "GAPS" : "GREEN"
      printf "fleet health %s: %d parts, %d OK, %d TRIP, %d ERROR, %d UNCOVERED", v, n, c["OK"], c["TRIP"], c["ERROR"], c["UNCOVERED"]
      if (c["TRIP/Q"] > 0) printf ", %d TRIP/Q", c["TRIP/Q"]
      if (bad != "") printf " (down: %s)", bad
      if (q != "") printf " (quarantined: %s)", q
      if (stale > 0) printf ", %d stale flows names", stale
      printf "\n" }' <<<"$rows")
  awk -F'\t' '{ a[NR] = $1; b[NR] = $2; c[NR] = $3; if ($1 != "!" && length($1) > w) w = length($1) }
    END { for (i = 1; i <= NR; i++)
      if (a[i] == "!") printf "%-*s  %-9s  %s\n", w, "?", "STALE", b[i] " names " c[i]
      else printf "%-*s  %-9s  %s\n", w, a[i], b[i], c[i] }' <<<"$rows"
  echo "$verdict"
  grep -qE $'\t(TRIP|ERROR)\t' <<<"$rows" && return 1
  return 0
}

# Findings: conclusions that want a decision, reached by rules over counted facts, every machine
# included. fleet-assess decides for this box alone; these read the pool and the other hosts too.
# On 2026-10-29 the pool queue was an hour old at 09:30, local runs starved from 13:00 and merges
# collapsed at 14:20; the human found it at 19:59, because nothing read any of these for a decision.

FINDING_METRICS='cc:host_load1|cc:host_cores|cc:host_cpu_busy_ratio|cc:pool_waiting|cc:pool_busy|cc:pool_slots|cc:pool_oldest_wait_seconds|ci_governor_capacity_units|ci_governor_busy_units'
# A rule whose series is missing cannot fire, so its absence must not read as healthy. cc:pool_oldest_wait_seconds
# is left out: it is only there while something waits.
FINDING_REQUIRED='["cc:host_load1","cc:host_cores","cc:host_cpu_busy_ratio","cc:pool_waiting","cc:pool_busy","cc:pool_slots","ci_governor_capacity_units","ci_governor_busy_units"]'
FINDING_SAMPLE_S=600   # snapshots this far apart: the sampler's cadence, so "on 2 samples" holds on replay
# Starting points set from the 10-29 replay; kpi-thresholds overrides any of them.
FINDING_DEFAULTS='{"finding_pool_wait_s":3600,
  "finding_pool_idle_share":0.75,"finding_pool_admitted_share":0.5,"finding_merge_ratio":0.5,"finding_demand_ratio":0.7,"finding_merge_floor_h":2,
  "finding_host_load_per_core":2,"finding_clear_min":60,"finding_human_after_min":60}'

finding_limits() {
  local file='{}'
  [ -r "$KPI_THRESHOLDS" ] && file=$(grep -E '^finding_[a-z_]+=' "$KPI_THRESHOLDS" | kv_json)
  jq -cn --argjson d "$FINDING_DEFAULTS" --argjson f "$file" '$d + ($f | with_entries(select(.value != null)))'
}

# prom_match_rows -> cc:pool_match_{slots,busy,runners} per pool and cc:pool_match_labels "<pool>/<label sets>":
# the slots that can take the jobs the pool has long waited on. A job runs only on a runner holding all
# its labels (GitHub compares them without case), so a pool's total busy/slots says nothing about a
# job that fits two of its ten runners (2026-11-05: razer-laptop-unity-pool-1/2 were the only ones that
# matched while mac-studio slots sat idle). The join is hub_core::ci, the one copy the hub and agent-web
# draw too; this only asks it. Empty when nothing waits long or it is unread: the rule then falls back
# to the pool's own totals. It reads Prometheus now, which is the newest sample the one reader of this asks for.
# A failed ask is the row cc:pool_match_unread, so the finding says its match is unread instead of
# reading as one that matched nothing (2026-11-25: hub ci failed while Prometheus restarted, ar-4653).
prom_match_rows() {
  local out
  out=$($BENCH_CI_MATCH_CMD "$(finding_limits | jq -r .finding_pool_wait_s)" 2>/dev/null) || { printf 'cc:pool_match_unread\t-\t1\n'; return 0; }
  [ -z "$out" ] || printf '%s\n' "$out"
}

# prom_rows <epoch> [match] -> metric, label, value (tab-separated) at that moment; rc 1 when unreadable.
# "match" adds the cc:pool_match_* rows, which only the newest sample of a finding reads.
# BENCH_PROM_TSV is a recorded series (metric, label, epoch, value), so a replay needs no server.
prom_rows() {
  local t="$1" out
  if [ -n "${BENCH_PROM_TSV:-}" ]; then
    out=$(awk -F'\t' -v t="$t" -v old="$FINDING_SAMPLE_S" '$3 <= t && $3 > t - old { v[$1 "\t" $2] = $4 }
      END { for (k in v) print k "\t" v[k] }' "$BENCH_PROM_TSV")
  else
    out=$(prom_q "{__name__=~\"$FINDING_METRICS\"}" "$t" | jq -r '.data.result[]
      | [.metric.__name__, (.metric.host // .metric.pool // "-"), (.value[1] | tonumber)] | @tsv') || return 1
    # Which repos' jobs wait in each pool, as "<pool>/<repo>": a starved pool holds only the work
    # that feeds it. Unread, a starved pool names no repos, and whoever reads it must assume all.
    out+=$'\n'$(prom_q "count by (pool, repo) ($W (github_actions_job_waiting{stuck!=\"true\"}))" "$t" |
      jq -r '.data.result[] | select(.metric.pool and .metric.repo) | ["cc:pool_waiting_repo", "\(.metric.pool)/\(.metric.repo)", (.value[1] | tonumber)] | @tsv' 2>/dev/null)
    [ -n "${2:-}" ] && out+=$'\n'$(prom_match_rows)
    out=$(grep . <<<"$out")
  fi
  [ -n "$out" ] && printf '%s\n' "$out"
}

# prom_snapshot <epoch> [match] -> {metric: {label: value}}; rc 1 when unreadable
prom_snapshot() {
  local rows
  rows=$(prom_rows "$@") || return 1
  jq -Rn 'reduce (inputs | split("\t")) as $r ({}; .[$r[0]][$r[1]] = ($r[2] | tonumber))' <<<"$rows"
}

# merge_rows <until> [since] -> project, merge epoch (tab-separated) for each project sampled in that
# time, default 24h. A project whose merges cannot be read prints "!project": no repo in the map, or a
# failed fetch, whose old refs would otherwise read as no merges. A name the map lacks is an app inside
# a repo (project-name.sh resolves a bnb-platform worktree to its app) or a progress line written before
# rows carried their project, a worktree's `<repo>-<slug>`: the longest spelling in the name index
# (project_index_json) it starts with names it, and its merges count under that name.
merge_rows() {
  local until="$1" since="${2:-$(($1 - 86400))}" p path ref
  if [ -n "${BENCH_MERGES_TSV:-}" ]; then cat "$BENCH_MERGES_TSV"; return; fi
  [ -s "$PROGRESS" ] || return 0
  [ -r "$BENCH_PROJECT_MAP" ] || { echo '!project-map'; return 0; }
  while read -r p path; do
    [ -n "$path" ] || { printf '!%s\n' "$p"; continue; }
    ref=$(merge_proof_ref "$path") || ref=origin/main
    if ! timeout 30 git -C "$path" fetch -q "${ref%%/*}" "${ref#*/}" 2>/dev/null; then printf '!%s\n' "$p"; continue; fi
    git -C "$path" log "$ref" --first-parent --since="$since" --until="$until" --format=%ct | sed "s/^/$p\t/"
  done < <(jq -rn --argjson since "$since" --slurpfile m "$BENCH_PROJECT_MAP" \
      --argjson idx "$(PROJECT_MAP_FILE="$BENCH_PROJECT_MAP" project_index_json)" '
    ($m[0].paths | to_entries | map({key: .value, value: .key}) | from_entries) as $path
    | [$idx | to_entries[] | {b: .key, p: ($path[.value] // "")} | select(.b != "" and .p != "")] as $bases
    | [inputs | select(.epoch >= $since) | .project | select(. != "")] | unique
    | [.[] | . as $n | ($path[$idx[$n | ascii_downcase] // $n] // "") as $direct
       | if $direct != "" then "\($n) \($direct)"
         else ([$bases[] | select(.b as $b | $n | ascii_downcase | startswith($b + "-"))] | max_by(.b | length)) as $hit
           | if $hit then "\($hit.b) \($hit.p)" else "\($n) " end end] | unique[]' "$PROGRESS")
}

# finding_facts <now> -> everything the rules read, as one object; a source that could not be read is
# null. Demand is the time average of live sessions, so a straggler on an empty project is not a full load.
finding_facts() {
  local t="$1" s0 s1 s2 merges live='' src=/dev/null
  s0=$(prom_snapshot "$t" match) && s1=$(prom_snapshot $((t - FINDING_SAMPLE_S))) && s2=$(prom_snapshot $((t - 2 * FINDING_SAMPLE_S))) \
    || s0='null' s1='null' s2='null'
  merges=$(merge_rows "$t")
  [ -s "$PROGRESS" ] && src=$PROGRESS
  live=$(jq -c --argjson since $((t - 86400)) --argjson t "$t" \
    'select(.epoch > $since and .epoch <= $t and (.bucket == "WORKING" or .bucket == "STALLED")) | {epoch, project}' "$src") || return 1
  jq -cn --argjson t "$t" --argjson s0 "$s0" --argjson s1 "$s1" --argjson s2 "$s2" --rawfile m <(printf '%s\n' "$merges") \
      --argjson every "$FINDING_SAMPLE_S" --slurpfile p <(printf '%s\n' "$live") '
    def avg_live($span): map(select(.epoch > $t - $span)) | length * $every / $span;
    ($m | split("\n") | map(select(. != "") | split("\t"))) as $rows
    | {t: $t, prom: [$s0, $s1, $s2],
       unfetched: [$rows[] | select(.[0] | startswith("!")) | .[0][1:]],
       merges: ($rows | map(select(.[0] | startswith("!") | not)) | group_by(.[0]) | map({key: .[0][0], value: map(.[1] | tonumber)}) | from_entries),
       live: ($p | group_by(.project) | map({key: .[0].project, value: {avg_24h: avg_live(86400), avg_2h: avg_live(7200)}}) | from_entries)}'
}

# finding_rows <facts> -> one object per rule firing now. Pure: the same facts give the same rows.
finding_rows() {
  jq -c --argjson l "$(finding_limits)" --argjson required "$FINDING_REQUIRED" "$JQ_LIB"'
    def pct: . * 100 | round;
    def row($rule; $scope; $class; $numbers; $window; $source; $conclusion; $cost):
      {rule: $rule, scope: $scope, decision_class: $class, evidence: {numbers: $numbers, window: $window, source: $source},
       conclusion: $conclusion, cost: $cost};
    def units: if . == null then "?" else round1 end;
    .t as $t | .prom as $p | .
    | ( .unfetched[] | row("blind"; "merges:\(.)"; "report"; {}; "now"; "git log";
          "merges for \(.) unreadable (no mapped repo, or the fetch failed), so throughput-drop is off for it"; "") ),
      ( if $p[0] == null then row("blind"; "prom"; "report"; {}; "now"; "prometheus";
          "prometheus unreadable, so starved and host-overload are off"; "") else empty end ),
      ( select($p[0] != null) | $p[0] as $a | $required[] | select($a[.] == null)
        | row("blind"; "prom:\(.)"; "report"; {}; "now"; "prometheus"; "\(.) is missing, so the rules that read it are off"; "") ),
      ( select($p[0] != null) | $p[0] as $a | $p[1] as $b | $p[2] as $c
        | ($a["ci_governor_capacity_units"] // {}) as $gc
        | (if ($gc | length) > 0 then {u: (($a["ci_governor_busy_units"] // {}) | add // 0), s: ($gc | add)} else {u: null, s: null} end) as $fu
        | ( ($a["cc:pool_oldest_wait_seconds"] // {}) | to_entries[] | .key as $pool | .value as $w
            | (($a["cc:pool_waiting"][$pool]) // 0) as $n
            | select($w >= $l.finding_pool_wait_s and $n > 0)
            | ([($a["cc:pool_waiting_repo"] // {}) | keys[] | select(startswith($pool + "/")) | ltrimstr($pool + "/")]
               | if length > 0 then . else null end) as $repos
            # The slots that can take the waiting jobs, when the reader could tell: the other slots of
            # the pool may lack their labels, so its total busy/slots says nothing about those jobs.
            | ($a["cc:pool_match_slots"][$pool]) as $ms | ($a["cc:pool_match_busy"][$pool]) as $mu | ($a["cc:pool_match_runners"][$pool]) as $mr
            | ([($a["cc:pool_match_labels"] // {}) | keys[] | select(startswith($pool + "/")) | ltrimstr($pool + "/")] | first) as $want
            | ($ms == null and $a["cc:pool_match_unread"] != null) as $unread
            # No labels read: the slots the governor counts across the fleet, taken against capacity. A kind runs
            # fewer jobs than slots it holds when another kind fills them, so cc:pool_busy would read labels (ar-3729).
            | (if $ms != null and $mu != null then {u: $mu, s: $ms} else $fu end) as $k
            # The fleet total covers hosts that cannot take the job, so it never decides labels: only the matching slots do.
            # bind: capacity when the slots that fit are full, labels when slots sit free, none can
            # take the job, or the jobs carry no pool label (pool "other": pinned to one host, say), so
            # more sessions add no demand to it. admission when the slots that fit are full but most runners
            # with the labels are withheld or offline: on 2026-11-18 a playground gate waited 4h41m on 3
            # admitted of about 13 Unity runners, read as demand, and nobody looked at the hosts (ar-3132).
            | (if $pool == "other" or ($ms != null and $k.s == 0 and $mr == 0) or ($ms != null and $k.u != null and $k.s != null and $k.s > 0 and ($k.u / $k.s) < $l.finding_pool_idle_share)
               then "labels"
               elif $ms != null and $mr != null and $mr > 0 and ($ms / $mr) < $l.finding_pool_admitted_share then "admission"
               else "capacity" end) as $bind
            # Jobs pinned to a host (a host-<name> label) wait on the slots of that host by choice:
            # with those all busy, no label or admission is wrong.
            | ($pool == "other" and $ms != null and $ms > 0 and $mu >= $ms
               and (($want // "") | split(" | ") | length > 0 and all(.[]; test("(^|,)host-")))) as $pinned
            | row("starved"; "pool:\($pool)"; "shepherd"; {waiting: $n, busy: $k.u, slots: $k.s, oldest_s: $w}
                + (if $ms != null then {fleet_taken: $fu.u, fleet_units: $fu.s, labels: $want, runners: $mr} elif $unread then {match_unread: 1} else {} end); "now"; "cc:pool_*";
                "oldest job waited \($w | dur) with \($k.u | units)/\($k.s | units) slots busy"
                + (if $unread then " (the slots matching its labels unread)" else "" end)
                + (if $ms != null then " among those matching its labels (\($want // "?")), \($fu.u | units)/\($fu.s | units) in the fleet" else "" end) + ": "
                + (if $pinned then "the jobs are pinned to a host, so the slots of the pin bind, not the pool" elif $bind == "labels" then "admission or labels bind, not capacity" elif $bind == "admission" then "only \($ms) of the \($mr) runners with its labels are admitted, the rest withheld, parked or offline: admission or host health binds, not demand" else "demand is over the \(if $ms != null then "matching slots'"'"'" else "pool'"'"'s" end) capacity" end);
                "\($n) jobs waiting") + {repos: $repos, bind: $bind} ),
          ( ($a["cc:host_load1"] // {}) | to_entries[] | .key as $h | .value as $v | ($a["cc:host_cores"][$h]) as $n
            | select($n != null and $n > 0)
            | [$v, ($b["cc:host_load1"][$h]), ($c["cc:host_load1"][$h])] as $vs
            | select(($vs | all(. != null and . / $n >= $l.finding_host_load_per_core)))
            | row("host-overload"; $h; "report"; {load: $v, cores: $n, per_core: ($v / $n | round1)}; "3 samples"; "cc:host_load1, cc:host_cores";
                "load \($v | round1) on \($n) cores for 20m (\($v / $n | round1)x)"; "") ) ),
      ( .unfetched as $u | .live as $live | .merges | to_entries[] | .key as $proj | .value as $e
        | select(($u | index($proj)) == null) | ($live[$proj]) as $d
        | ($e | map(select(. > $t - 86400 and . <= $t)) | length / 24) as $base
        | ($e | map(select(. > $t - 7200 and . <= $t)) | length / 2) as $now
        | select($d != null and $base >= $l.finding_merge_floor_h and $now < $l.finding_merge_ratio * $base
                 and $d.avg_2h >= $l.finding_demand_ratio * $d.avg_24h)
        | row("throughput-drop"; $proj; "human"; {merges_h_2h: $now, merges_h_24h: ($base | round1), live_2h: ($d.avg_2h | round1), live_24h: ($d.avg_24h | round1)};
            "2h against 24h"; "git log --first-parent, progress.jsonl";
            "merges \($now)/h against \($base | round1)/h with sessions still working (\($d.avg_2h | round1) live, usual \($d.avg_24h | round1)): something between gate and merge binds";
            "\(($base - $now) * 2 | round) merges behind in 2h") )' <<<"$1"
}

# finding_stamp <now> -> rows on stdin with their episode. An episode is the time a rule first fired
# for a scope, and it outlives a gap shorter than finding_clear_min, so a rule that flickers is one
# episode and a recurrence is a new one. The fact is what the ledger pages once.
finding_stamp() {
  local t="$1" prior=/dev/null
  [ -s "$FINDINGS" ] && prior=$FINDINGS
  jq -c --argjson t "$t" --argjson l "$(finding_limits)" --slurpfile p "$prior" "$JQ_LIB"'
    ($p | map(select(.epoch < $t and .epoch >= $t - $l.finding_clear_min * 60)) | group_by([.rule, .scope])
     | map(max_by(.epoch) | {key: "\(.rule)/\(.scope)", value: .}) | from_entries) as $last
    | ($last["\(.rule)/\(.scope)"].episode // $t) as $ep
    | . + {epoch: $t, at: ($t | iso), episode: $ep, fact: "\(.rule) \(.scope) @\($ep)"}
    | if (.rule == "starved" or .rule == "host-overload") and $t - $ep >= $l.finding_human_after_min * 60
      then .decision_class = "human" else . end'
}

# finding_blind <scope> <source> <conclusion> -> one unstamped row, for a source no rule could read
finding_blind() {
  jq -cn --arg s "$1" --arg src "$2" --arg c "$3" \
    '{rule: "blind", scope: $s, decision_class: "report", evidence: {numbers: {}, window: "now", source: $src}, conclusion: $c, cost: ""}'
}

# findings_run <now>: evaluate and append. Never fails the sample that calls it, and a failed evaluation
# leaves a row, because no rows is what a healthy pass looks like.
findings_run() {
  local facts rows
  mkdir -p "$DIR"
  { facts=$(finding_facts "$1") && [ -n "$facts" ] && rows=$(finding_rows "$facts" | finding_stamp "$1"); } \
    || rows=$(finding_blind findings "fleet-bench" "the rules could not be evaluated, so nothing here is a healthy read" | finding_stamp "$1")
  [ -z "$rows" ] || printf '%s\n' "$rows" >> "$FINDINGS"
  printf '%s\n' "$1" > "$FINDINGS_PASS"
}

# findings_open <now> -> the newest row of each finding still inside its episode, worst class first. A
# store nobody has evaluated lately says so first, because its emptiness is not health.
findings_open() {
  local t="$1" limits last store=/dev/null
  limits=$(finding_limits)
  [ -s "$FINDINGS" ] && store=$FINDINGS
  last=$(cat "$FINDINGS_PASS" 2>/dev/null)
  if [ $((t - ${last:-0})) -gt "$(jq '.finding_clear_min * 60 | floor' <<<"$limits")" ]; then
    finding_blind sampler "findings.last" "no evaluation since $(jq -rn --argjson e "${last:-0}" "$JQ_LIB"'$e | if . == 0 then "ever" else hm end'), so this list is not current" | finding_stamp "$t"
  fi
  jq -cn --argjson t "$t" --argjson l "$limits" --slurpfile f "$store" '
    $f | map(select(.epoch <= $t)) | group_by([.rule, .scope]) | map(max_by(.epoch))
    | map(select($t - .epoch <= $l.finding_clear_min * 60))
    | sort_by(({human: 0, shepherd: 1, report: 2}[.decision_class]), .episode) | .[]'
}

cmd_findings() {
  case "${1:-}" in
    --run) findings_run "$(now)"; return ;;
    --json) findings_open "$(now)"; return ;;
    ""|--open) ;;
    *) say "usage: fleet-bench findings [--open|--json|--run]"; return 2 ;;
  esac
  local rows
  rows=$(findings_open "$(now)")
  [ -n "$rows" ] || { echo "findings: none open"; return 0; }
  jq -r "$JQ_LIB"'[.decision_class, .rule, .scope, "since \(.episode | hm)", .conclusion + (if .cost != "" then " (\(.cost))" else "" end)] | @tsv' <<<"$rows" |
    awk -F'\t' '{ printf "%-8s %-15s %-24s %-15s %s\n", $1, $2, $3, $4, $5 }'
}

# The loop: what answered each finding. A finding of class human goes on the human's page once (the
# ledger's escalate records it as paged); what the fleet did about it is a response: asked,
# filed-row, cancelled or fixed. An episode that reached class human with nothing but pages is dark:
# the loop saw it and nothing acted. On 2026-11-05 starved pools paged from 23:31 to 06:07 and no
# pass did anything else, which no number showed.
RESPONSE_ACTIONS="paged asked filed-row cancelled fixed"
LOOP_WINDOW_S=$((7 * 86400))   # the KPI table's 7d

cmd_respond() {
  local fact="${1:-}" actor="${2:-}" action="${3:-}" ref="${4:-}"
  if ! [[ "$fact" =~ ^[a-z-]+\ [^\ ]+\ @[0-9]+$ ]] || [ -z "$actor" ] || [[ " $RESPONSE_ACTIONS " != *" $action "* ]]; then
    say "usage: fleet-bench respond '<rule> <scope> @<episode>' <actor> <${RESPONSE_ACTIONS// /|}> [ref]"
    return 2
  fi
  mkdir -p "$DIR"
  jq -cn --argjson t "$(now)" --arg f "$fact" --arg a "$actor" --arg x "$action" --arg r "$ref" \
    '{epoch: $t, fact: $f, actor: $a, action: $x, ref: $r}' >> "$RESPONSES"
}

# loop_episodes <now> <since> -> one object per finding episode begun since <since> and seen on two
# samples or more (one is noise, as fleet-lead reads it), report class left out: when it reached class
# human, its responses, minutes from the episode to its first response that is not a page, whether
# it still fires, and dark.
loop_episodes() {
  local f=/dev/null r=/dev/null
  [ -s "$FINDINGS" ] && f=$FINDINGS
  [ -s "$RESPONSES" ] && r=$RESPONSES
  jq -cn --argjson t "$1" --argjson since "$2" --argjson l "$(finding_limits)" --slurpfile f "$f" --slurpfile r "$r" '
    ($r | map(select(.epoch <= $t)) | group_by(.fact) | map({key: .[0].fact, value: .}) | from_entries) as $resp
    | $f | map(select(.decision_class != "report" and .episode >= $since and .epoch <= $t)) | group_by(.fact)[]
    | select(length > 1)
    | (map(select(.decision_class == "human")) | min_by(.epoch) | .epoch?) as $human
    | ($resp[.[0].fact] // []) as $rs
    | ($rs | map(select(.action != "paged")) | min_by(.epoch) | .epoch?) as $acted
    | (max_by(.epoch) | .epoch) as $last
    | {fact: .[0].fact, rule: .[0].rule, scope: .[0].scope, episode: .[0].episode, last: $last,
       open: ($t - $last <= $l.finding_clear_min * 60), human_at: $human, responses: ($rs | sort_by(.epoch) | map(.action)),
       first_response_min: (if $acted == null then null else ($acted - .[0].episode) / 60 | round end),
       dark: ($human != null and $acted == null)}'
}

cmd_loop() {
  local t rows
  case "${1:-}" in ""|--json|--firing) ;; *) say "usage: fleet-bench loop [--json|--firing]"; return 2 ;; esac
  t=$(now)
  rows=$(loop_episodes "$t" $((t - LOOP_WINDOW_S))) || return 1
  if [ "${1:-}" = --json ]; then [ -z "$rows" ] || printf '%s\n' "$rows"; return 0; fi
  # The daily briefing's Needs you line: one sentence per dark episode still firing, nothing when none.
  if [ "${1:-}" = --firing ]; then
    [ -z "$rows" ] || jq -rs --argjson t "$t" 'sort_by(.episode)[] | select(.dark and .open)
      | "Finding \(.fact) has been yours for \((($t - .human_at) / 60) | floor)m and still fires, with nothing done but a page. Run fleet-bench loop."' <<<"$rows"
    return 0
  fi
  [ -n "$rows" ] || { echo "loop: no finding episodes in 7d"; return 0; }
  jq -rs "$JQ_LIB"'
    "loop, 7d: \(length) episodes, \(map(select(.dark)) | length) dark (\(map(select(.dark and .open)) | length) still firing), \(map(.first_response_min | numbers) | median | if . == null then "no act recorded" else "first response after \(.)m median" end)",
    (sort_by(.episode)[] | [(if .dark then "DARK" elif .first_response_min != null then "\(.first_response_min)m" else "-" end),
       (if .open then "firing" else "cleared" end), .fact,
       (.responses | if length == 0 then "no response" else join(",") end)] | @tsv)' <<<"$rows" |
    awk -F'\t' 'NR == 1 { print; next } { printf "%-6s %-8s %-40s %s\n", $1, $2, $3, $4 }'
}

# throughput_epoch <text> -> an epoch, from an epoch or anything `date -d` reads
throughput_epoch() { [[ "$1" =~ ^[0-9]+$ ]] && printf '%s' "$1" || date -d "$1" +%s; }

# The before and after any slot, hold or pace change has to state: load and idle are proxies, and the
# outcome is merges per hour and queue wait (dotfiles lessons, 2026-10-30).
cmd_throughput() {
  local from='' to='' snap='null' merges queue=''
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) from=$(throughput_epoch "${2:-}") || return 2; shift 2 ;;
      --to) to=$(throughput_epoch "${2:-}") || return 2; shift 2 ;;
      *) say "usage: fleet-bench throughput [--from T] [--to T]"; return 2 ;;
    esac
  done
  [ -n "$to" ] || to=$(now)
  [ -n "$from" ] || from=$((to - 7200))
  [ "$to" -gt "$from" ] || { say "--to must be after --from"; return 2; }
  snap=$(prom_snapshot "$to") || snap='null'
  merges=$(merge_rows "$to" "$from")
  # The exporter's own quantiles over the jobs finished in 24h; a recorded fixture has none.
  [ -n "${BENCH_PROM_TSV:-}" ] || queue=$(prom_q github_job_queue_seconds "$to" | jq -r '.data.result[] | [.metric.pool, .metric.quantile, .value[1]] | @tsv')
  # Merges and the snapshot grow with the window and the fleet, so they go by file, never --arg (128 KB each).
  jq -rn --argjson a "$from" --argjson b "$to" --slurpfile sf <(printf '%s\n' "$snap") --rawfile m <(printf '%s\n' "$merges") \
      --arg q "$queue" --rawfile r <(runs_between "$from" "$to") "$JQ_LIB"'
    $sf[0] as $s | (($b - $a) / 3600) as $h
    | ($q | split("\n") | map(select(. != "") | split("\t")) | reduce .[] as $x ({}; .[$x[0]][$x[1]] = ($x[2] | tonumber))) as $wait
    | ($r | run_rows) as $runs
    | ($runs | map(select(.res != "pass"))) as $bad
    | "window: \($a | hm) -> \($b | hm) (\($h | round1)h)",
      (if ($runs | length) == 0 then "local runs: none recorded"
       else "local runs: \($runs | length / $h | round1)/h, \($bad | length * 100 / ($runs | length) | round)% not passed, editor \(($runs | map(.s) | add) / 3600 | round1)h, of which on runs not passed \((($bad | map(.s) | add) // 0) / 3600 | round1)h" end),
      ($m | split("\n") | map(select(. != "") | split("\t"))
       | (map(select(.[0] | startswith("!")) | .[0][1:]) | unique) as $unread
       | (map(select((.[0] | startswith("!") | not) and (.[1] | tonumber) > $a and (.[1] | tonumber) <= $b)) | group_by(.[0])
          | if length > 0 then "merges/h: " + (map("\(.[0][0]) \(length / $h | round1)") | join(", "))
            elif ($unread | length) > 0 then "merges: none in the repos read"
            else "merges: none" end),
         # a project with no repo in the map, or no clone here that fetches, is unread, never counted as no merges
         (if $unread == ["project-map"] then "merges unread: the project map is unreadable"
          elif ($unread | length) > 0 then "merges unread (no mapped repo, or no clone here that fetches): \($unread | join(", "))"
          else empty end)),
      (if $s == null then "pool and hosts: prometheus unreadable"
       else ($s["cc:pool_slots"] // {} | keys[] | . as $p | select(($s["cc:pool_slots"][$p] // 0) > 0)
             | "pool \($p): \($s["cc:pool_waiting"][$p] // 0) waiting, \($s["cc:pool_busy"][$p] // 0) running"
               + (if $s["cc:pool_oldest_wait_seconds"][$p] then ", oldest \($s["cc:pool_oldest_wait_seconds"][$p] | dur)" else "" end)
               + (if $wait[$p] then ", finished jobs waited p50 \($wait[$p]["0.5"] | dur), p90 \($wait[$p]["0.9"] | dur) (24h)" else "" end)),
            "hosts, load per core: " + ($s["cc:host_load1"] // {} | to_entries | map(select(($s["cc:host_cores"][.key] // 0) > 0) | {k: .key, v: (.value / $s["cc:host_cores"][.key])})
               | map(select(.v >= 0.5)) | sort_by(-.v) | if length == 0 then "all under 0.5x" else map("\(.k) \(.v | round1)x") | join(", ") end)
       end),
      # A wait the exporter reports with no slot row of its own: a subset by a shard label (unity-gate,
      # unity-full) or a pool with no live slots. It is its own query, so it prints with the snapshot
      # unreadable too. unity-queue-wait reads the gate one (ar-3437).
      ($wait | keys[] | . as $p | select((($s // {})["cc:pool_slots"][$p] // 0) == 0 and $wait[$p]["0.5"] != null and $wait[$p]["0.9"] != null)
       | "wait \($p): finished jobs waited p50 \($wait[$p]["0.5"] | dur), p90 \($wait[$p]["0.9"] | dur) (24h)")'
}

# queue_slots -> how many sessions fleet-dispatch keeps live: BENCH_QUEUE_SLOTS, else the pace target its
# last pass published (stats room_max_live, the `target` of `headroom --json`: what the Claude accounts
# carry, at most DISPATCH_TARGET_PRESENT or _AWAY). Unreadable or stale (stats drops it after 45 min)
# fails. One source, read, never restated.
queue_slots() {
  local n="${BENCH_QUEUE_SLOTS:-}"
  [ -n "$n" ] || n=$(bench_read $BENCH_DISPATCH_STATS_CMD 2>/dev/null | jq -r '.room_max_live // empty' 2>/dev/null)
  [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -gt 0 ] && printf '%s' "$n"
}

# forecast_json <now> [queue json lines] [items json lines|"!"] [items] -> one object: the schedule of
# every open phase, the fleet's all-done-by at both ends of the band, the drain against the
# last window's flow, the board rows behind the live work, and the agent queue's items placed
# on the dispatcher's slots ("!" when the queue could not be read, null in .items). A fourth
# argument `items` says the caller reads only .items (epics): the drain, a flow over every
# sample and a third of the time, is null then. The live rows and the slots go through
# bench_read, so a concurrent section can read them first (epics_json).
forecast_json() {
  local t="$1" queue="${2:-}" items="${3:-}" drain=true live names iphases sc="$SCORES" map=/dev/null slots
  [ "${4:-}" = items ] && drain=false
  live=$(bench_read latest_live)
  [ -s "$sc" ] || sc=/dev/null
  [ -r "$BENCH_PROJECT_MAP" ] && map=$BENCH_PROJECT_MAP
  slots=$(queue_slots) || slots=''
  names=$(jq -r '[.session_id, .plan_file // ""] | @tsv' <<<"$live" | while IFS=$'\t' read -r sid pf; do
      [ -n "$pf" ] && printf '{"%s":%s}\n' "$sid" "$(plan_session_phases "$pf" | jq -c 'map(select(.state == "open") | .name)')"
    done | jq -cs 'add // {}')
  # an item with `phases:` (agent-queue add --plan) counts those; one that only names its plan, its plan's open phases
  iphases=$( [ "$items" = "!" ] || jq -r 'select((.plan // "") != "" and (.phases // "") == "") | [.slug, .plan] | @tsv' <<<"$items" 2>/dev/null \
    | while IFS=$'\t' read -r slug pf; do
        printf '{"%s":%s}\n' "$slug" "$(plan_session_phases "$pf" | jq 'map(select(.state == "open")) | length')"
      done | jq -cs 'add // {}')
  jq -cn --argjson t "$t" --argjson win "$BENCH_WINDOW_H" --slurpfile nm <(printf '%s\n' "$names") --rawfile queue <(printf '%s' "$queue") \
     --rawfile items <(printf '%s' "$items") --argjson ip "${iphases:-"{}"}" --arg slots "$slots" --argjson drain "$drain" \
     --argjson def "$BENCH_DEFAULT_PHASE_MIN" --argjson minb "$BENCH_BASIS_MIN_N" "${CAL_ARGS[@]}" --slurpfile map "$map" \
     --slurpfile live <(printf '%s\n' "$live") --slurpfile p "$PROGRESS" --slurpfile s "$sc" "$JQ_LIB"'
    $nm[0] as $names
    | ($s | map(select(.done_epoch >= $t - $win * 3600) | .ratio // empty) | median) as $r24
    | (if $drain then $p | flow($t - $win * 3600; $t) else null end) as $f
    | ($live | schedule($t; $r24 // 1; $names)) as $sch
    | ($sch | map(.left) | add // 0) as $open
    | (if $f == null then null else $f.out_per_h - $f.net_in_per_h end) as $net
    | ($queue | split("\n") | map(select(. != "") | fromjson)) as $q
    | ($p | map(select(.phases_total != null)) | group_by([.session_id, .plan_file]) | map(map(.phases_total) | max) | median) as $ppp
    | {made_epoch: $t, made_at: ($t | iso), slow_ratio: $r24,
       sessions: ($sch | length),
       unscheduled: ($live | map(select((.finished | not) and (.phases_total == null or .eta == null))) | length),
       open: $open}
      + ($sch | fleet_finish)
      + {drain: (if $f == null then null else {out_per_h: $f.out_per_h, in_per_h: $f.net_in_per_h,
                 epoch: (if $net > 0 then ($t + $open / $net * 3600 | floor) else null end)} end),
         queue: (if $queue == "" then null else {rows: ($q | length), ready: ($q | map(select(.state == "ready")) | length),
                 phases_per_plan: $ppp, phases: (($q | length) * ($ppp // 0) | floor)} end),
         schedule: $sch}
      + {items: (if $items == "!" then null else
          ($items | split("\n") | map(select(. != "") | fromjson)) as $it
          | ($it | map(.slug) | INDEX(.)) as $active
          | ($p | group_by(.project) | map({key: .[0].project,
                value: (group_by([.session_id, .plan_file]) | map(phase_minutes) | add // [])}) | from_entries) as $byp
          | ($byp | [.[]] | add // []) as $every
          | ($s | accuracy($minn; $lo; $hi) | INDEX(.basis)) as $acc
          | ($sch | map({key: (.target | sub(":[0-9]+$"; "")), value: {P: .finish_p50, S: .finish_slow}}) | from_entries) as $onsch
          | ($slots | if . == "" then 1 else tonumber end) as $K
          # seconds a phase takes on each repo with enough measured phases, else the fleet: P as
          # calibrated, S at the slow ratio
          | def pace_of($pp): ($acc[$pp.basis | kind].factor // 1) as $fac
              | {P: ($pp.m * 60 * $fac), S: ($pp.m * 60 * ($r24 // 1)),
                 basis: ($pp.basis + (if $fac != 1 then " x\($fac)" else "" end))};
          ($byp | map_values(select(length >= $minb) | pace_of({m: median, basis: "project-median(\(length))"}))) as $prp
          | (if ($every | length) >= $minb then {m: ($every | median), basis: "fleet-median(\($every | length))"}
             else {m: $def, basis: "default"} end | pace_of(.)) as $flp
          | ($it | map(
              (($map[0].trackers // {})[.project].repo // .project) as $repo
              | ($prp[$repo] // $flp) as $pp
              | (.hold // "") as $h | ($h | sub("^after "; "") | sub(" closed .*$"; "") | split(" ")) as $pars
              | {slug, project, state, mode,
                 phases: ((.phases // "" | [splits(" +")] | map(select(. != "")) | length | select(. > 0)) // $ip[.slug] // (if .mode == "plan" then ($ppp // 1) else 1 end)),
                 P: $pp.P, S: $pp.S, basis: $pp.basis,
                 start: ((.started // .queued) | fromdateiso8601? // $t),
                 live: (if .state == "running" then $onsch[(.session // "") | if test(":") then sub(":"; "/") else "lab/" + . end] else null end),
                 after: (if ($h | startswith("after ")) and all($pars[]; $active[.] != null) then $pars else null end),
                 why: (if .state == "waiting" then "waiting on you"
                       elif .state == "review" then "on a PR"
                       elif ($h | startswith("after ")) and any($pars[]; $active[.] == null) then "after \($pars | join(" ")), which did not finish ok"
                       elif $h != "" and ($h | startswith("after ") | not) then "held: \($h)"
                       else null end)})) as $e
          | ($e | qplace($t; $K; "P")) as $a | ($e | qplace($t; $K; "S")) as $b
          | ($e | map(select(.live == null and $a.placed[.slug] != null)
                      | {slug, project, state, phases, basis, start: $a.placed[.slug].start,
                         p50: $a.placed[.slug].end, slow: $b.placed[.slug].end})) as $rows
          | {count: ($it | length), running: ($it | map(select(.state == "running")) | length),
             queued: ($it | map(select(.state == "queued")) | length),
             review: ($it | map(select(.state == "review")) | length),
             waiting: ($it | map(select(.state == "waiting")) | length),
             slots: $K, slots_known: ($slots != ""), on_schedule: ($e | map(select(.live != null)) | length),
             phases: ($rows | map(.phases) | add // 0),
             finish_p50: ($rows | map(.p50) | max), finish_slow: ($rows | map(.slow) | max),
             not_scheduled: ($e | map(select(.why != null) | {slug, why})
                             + ($a.behind | map({slug: ., why: "behind an item that is not scheduled"}))),
             schedule: ($rows | sort_by(.p50)),
             # when each scheduled item ends, live or placed, and the pace per repo (fleet-bench epics)
             ends: ($e | map(if .live != null then {key: .slug, value: {p50: .live.P, slow: .live.S}}
                             elif $a.placed[.slug] != null then {key: .slug, value: {p50: $a.placed[.slug].end, slow: $b.placed[.slug].end}}
                             else empty end) | from_entries),
             pace: {repos: $prp, fleet: $flp}} end)}'
}

# cmd_forecast [--json] [--queue] [--baseline <label>]: when the live work should be done, and in
# what order. --baseline freezes it into forecasts.jsonl, queue included, for vs to compare.
cmd_forecast() {
  local json=0 withq=0 label='' t fc queue='' items
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --queue) withq=1; shift ;;
      --baseline) label="${2:-}"; [ -n "$label" ] || { say "--baseline needs a label"; return 2; }; withq=1; shift 2 ;;
      *) say "usage: fleet-bench forecast [--json] [--queue] [--baseline <label>]"; return 2 ;;
    esac
  done
  [ -s "$PROGRESS" ] || { say "no samples yet: run fleet-bench sample"; return 1; }
  t=$(now)
  [ "$withq" = 0 ] || queue=$($BENCH_QUEUE_CMD 2>/dev/null) || { say "the dispatch queue could not be read; forecast without it"; queue=''; }
  items=$(bench_read $BENCH_ITEMS_CMD 2>/dev/null) || { say "the agent queue could not be read; forecast without its items"; items='!'; }
  fc=$(forecast_json "$t" "$queue" "$items") || return 1
  [ -z "$items" ] || [ "$items" = "!" ] || jq -e ".items.slots_known != false" <<<"$fc" >/dev/null || say "the dispatcher's slot count is unread, zero or stale (stats drops the last pass's headroom after 45 min); placing queue items on 1 slot"
  if [ -n "$label" ]; then
    mkdir -p "$DIR"
    jq -c --arg l "$label" '{label: $l} + .' <<<"$fc" >> "$FORECASTS"
    say "baseline $label frozen in $FORECASTS"
  fi
  if [ "$json" = 1 ]; then printf '%s\n' "$fc"; return 0; fi
  jq -r "$JQ_LIB"'
    "forecast \(.made_epoch | hm): \(.sessions) sessions with a plan, \(.open) phases open"
      + (if .unscheduled > 0 then " (\(.unscheduled) more with no plan or no estimate)" else "" end),
    "  all done by: median \(.median_p50 | hm), p90 \(.p90_p50 | hm), last \(.last_p50 | hm) (each estimate as calibrated)",
    "        slow: median \(.median_slow | hm), p90 \(.p90_slow | hm), last \(.last_slow | hm) (at the last 24h scored ratio, \(.slow_ratio // "none, so 1")x)",
    "  drain: " + (if .drain.epoch != null
      then "\(.drain.epoch | hm) at \(.drain.out_per_h)/h out against \(.drain.in_per_h)/h in (last 24h)"
      else "not draining at current inflow (in \(.drain.in_per_h)/h, out \(.drain.out_per_h)/h): no time until one of them changes" end),
    (if .items == null then "  agent queue: unreadable"
     elif .items.count == 0 then "  agent queue: empty"
     else .items as $i
       | "  agent queue: \($i.count) items (\($i.running) running, \($i.queued) queued, \($i.review) on a PR, \($i.waiting) waiting on you), \($i.phases) phases on \($i.slots) dispatch slots"
         + (if ($i.schedule | length) > 0 then ": all done by \($i.finish_p50 | hm), slow \($i.finish_slow | hm)" else "" end)
         + (if $i.on_schedule > 0 then " (\($i.on_schedule) running already counted above)" else "" end),
         (if ($i.not_scheduled | length) > 0
          then "    not scheduled: \($i.not_scheduled | length): " + ($i.not_scheduled | group_by(.why) | map("\(length) \(.[0].why)") | join(", "))
          else empty end) end),
    (if .queue != null then "  queued after this: \(.queue.rows) board rows (\(.queue.ready) ready to start), about \(.queue.phases) phases at the median \(.queue.phases_per_plan // "-") per plan" else empty end),
    ([(.schedule[] | . as $s | .phases[] | {t: .p50, slow, target: $s.target, name}),
      (.items.schedule // [] | .[] | {t: .p50, slow, target: "queue:\(.project)", name: .slug})] | sort_by(.t)) as $all
    | .made_epoch as $now | ($all | map(select(.t <= $now))) as $due
    | (if ($due | length) > 0 then "  due now, past their estimate: \($due | length) phases in \($due | map(.target) | unique | length) sessions" else empty end),
      "  next phases, in expected order:",
      ($all | map(select(.t > $now)) | .[:10][]
        | "    \(.t | hm)  (slow \(.slow | hm))  \(.target | sub("^[^/]*/"; ""))  \(.name | if length > 70 then .[:67] + "..." else . end)")' <<<"$fc"
}

# progress_since <epoch>: the progress rows from an hour before it on, so a flow from that epoch
# has the sample before it and the 9 MB history is not slurped whole.
progress_since() { jq -c --argjson a "$(($1 - 3600))" 'select(.epoch >= $a)' "$PROGRESS"; }

# baseline_pick [label|latest] -> the newest frozen forecast with that label, or the newest of all
baseline_pick() {
  local l="${1:-latest}"
  [ -s "$FORECASTS" ] || return 1
  jq -cs --arg l "$l" 'map(select($l == "latest" or .label == $l)) | last // empty' "$FORECASTS" | grep .
}

# cmd_vs [<label>|latest] [--json]: a frozen forecast against what the fleet did since
cmd_vs() {
  local json=0 label=latest b t
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      -*) say "usage: fleet-bench vs [<label>|latest] [--json]"; return 2 ;;
      *) label="$1"; shift ;;
    esac
  done
  b=$(baseline_pick "$label") || { say "no baseline $label: freeze one with fleet-bench forecast --baseline <label>"; return 1; }
  t=$(now)
  local v
  v=$(progress_since "$(jq -r .made_epoch <<<"$b")" | jq -cs --slurpfile b <(printf '%s\n' "$b") --argjson t "$t" "$JQ_LIB"'vs($b[0]; $t)') || return 1
  if [ "$json" = 1 ]; then printf '%s\n' "$v"; return 0; fi
  jq -r "$JQ_LIB"'
    "vs baseline \(.label) (frozen \(.made_epoch | hm), \(.hours)h ago)",
    "  ticked: \(.ticked) of the \(.expected) phases expected by now (\(.expected_slow) at the slow end), \(.ticked_all) fleet-wide",
    "  sessions: " + ([("finished", "ahead", "on track", "behind", "gone") as $k | select(.states[$k] != null) | "\(.states[$k]) \($k)"] | join(", ")),
    "  scope: +\(.added) added to baseline plans, -\(.removed) removed, \(.new_plans) new plans in them, \(.started_since) sessions started since",
    "  inflow: \(.in_per_h)/h since against \(.in_per_h_frozen)/h when frozen, out \(.out_per_h)/h",
    (.sessions | map(select(.state == "behind")) | sort_by(-.min) | if length > 0 then "  behind:", (.[] | "    \(.target | sub("^[^/]*/"; "")): \(.ticked) of \(.expected) expected, \(.min)m past due on \(.next)") else empty end),
    (.sessions | map(select(.state == "ahead")) | sort_by(-.min) | if length > 0 then "  ahead:", (.[] | "    \(.target | sub("^[^/]*/"; "")): \(.ticked) of \(.expected) expected, \(.min)m early") else empty end)' <<<"$v"
}

# new_forecast_scores <now> -> a score for each frozen forecast that resolved and has none yet.
# A forecast frozen with no scheduled session has no end to measure, so it is never scored.
new_forecast_scores() {
  local t="$1" b k min
  [ -s "$FORECASTS" ] || return 0
  local todo
  todo=$(jq -cs --slurpfile d <(cat "$FORECAST_SCORES" 2>/dev/null) '
    ($d | map("\(.label) \(.made_epoch)")) as $done | .[] | select((.schedule // [] | length) > 0) | select(("\(.label) \(.made_epoch)") as $k | $done | index($k) | not)' "$FORECASTS")
  [ -n "$todo" ] || return 0
  min=$(jq -s 'map(.made_epoch) | min' <<<"$todo")
  progress_since "$min" | jq -cs --slurpfile todo <(printf '%s\n' "$todo") --argjson t "$t" --argjson hz "$BENCH_FORECAST_HORIZON_H" "$JQ_LIB"'
    . as $p | $todo[] as $b | $p | forecast_score($b; $t; $hz)'
}

# cmd_flow [--from T] [--to T] [--json] [--hourly]: phases in against phases out over a window
cmd_flow() {
  local from='' to='' json=0 hourly=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) from=$(throughput_epoch "${2:-}") || return 2; shift 2 ;;
      --to) to=$(throughput_epoch "${2:-}") || return 2; shift 2 ;;
      --json) json=1; shift ;;
      --hourly) hourly=1; shift ;;
      *) say "usage: fleet-bench flow [--from T] [--to T] [--json] [--hourly]"; return 2 ;;
    esac
  done
  [ -n "$to" ] || to=$(now)
  [ -n "$from" ] || from=$((to - BENCH_WINDOW_H * 3600))
  [ "$to" -gt "$from" ] || { say "--to must be after --from"; return 2; }
  [ -s "$PROGRESS" ] || { [ "$json" = 1 ] && echo null || echo "flow: no samples yet"; return 0; }
  if [ "$json" = 1 ]; then
    jq -cs --argjson a "$from" --argjson b "$to" --argjson hr "$hourly" "$JQ_LIB"'
      flow($a; $b) | if $hr == 1 then . else del(.hourly) end' "$PROGRESS"
    return
  fi
  jq -rs --argjson a "$from" --argjson b "$to" --argjson hr "$hourly" "$JQ_LIB"'
    flow($a; $b) as $f
    | "flow \($a | hm) -> \($b | hm) (\($f.hours | round1)h)",
      "  out: \($f.ticked) phases ticked (\($f.out_per_h)/h)",
      "  in:  \($f.in) phases (\($f.in_per_h)/h): \($f.started - $f.resumed_plans) plans started with \($f.started_open) open, \($f.added) added to running plans\(if $f.abandoned > 0 then ", less \($f.abandoned) abandoned" else "" end); \($f.removed) removed by rewrites",
      "  open: \($f.open_start) at start, \($f.open_end) at end\(if $f.dropped > 0 then "; \($f.dropped) left open by sessions that ended or switched plans" else "" end)",
      (if $f.abandoned > 0 then "  abandoned: \($f.abandoned) phases came in with plans that ended or were switched away from unfinished, kept out of in" else empty end),
      (if $f.resumed_plans > 0 then "  resumed: \($f.resumed) phases in \($f.resumed_plans) plans another session left, taken up again and not counted in again" else empty end),
      "  net: " + (($f.out_per_h - $f.net_in_per_h) as $d
        | if $d > 0 then "draining \($d | round2)/h" else "not draining (in \($f.net_in_per_h)/h, out \($f.out_per_h)/h)" end),
      ($f.by_project[] | "  \(.project): \(.ticked) out, \(.in) in, \(.removed) removed"),
      (if $hr == 1 then ($f.hourly[] | "  \(.hour | hm)  +\(.in) -\(.removed) in, \(.ticked) out, scope \(.scope), done \(.done)") else empty end)
  ' "$PROGRESS"
}

# --- canary: a fixed eval set run weekly, so "the agents got better" reads apart from "the task
# mix changed". A task is one merged PR as data in BENCH_CANARY_DIR/<id>.json: {id, project, pr,
# base (the commit before it), merge, task (its row text), pts (its size on the board's #pts/ scale,
# scored by the size rubric, .config/inbox-size/prompt.md; a score row never copies it), accept (the oracle's test names),
# oracle: {paths, cmd}}. The oracle is the PR's own tests, laid over the session's tree from
# merge, so a session can neither see nor edit what scores it. A cmd run from tests/vendor (bats) needs the
# link canary start, score and verify lay (canary_vendor); by hand, link the main checkout's tests/vendor first. A task with no merged PR (a known-answer
# fix at a pinned base) has no merge and no paths: its oracle is a script from BENCH_CANARY_ORACLES that
# fleet-bench pipes into cmd's stdin (`oracle.script`, the same guarantee), and verify proves it on the
# known answer, `oracle.answer: {script, cmd}`, written into the tree in place of the merge. A score row in canary.jsonl is
# {epoch, run, id, project, pr, session_id, harness, model, effort, pass (null: not run, canary_score), rc, end_reason, config,
# control (true only on a positive control run, canary_control)}; every reader grades the rows first (canary_graded); cost, minutes,
# turns and tokens come from the session's outcome row by session_id, never copied here. A lane is
# a harness, model and effort (null: the harness's own default): the same tasks run under each, so
# lanes compare on equal work. A task may name its `stack` (else its project's, by BENCH_MATRIX);
# its kind is its task text's prefix. The canary_
# KPIs read the claude lane alone (a row without harness is claude), one baseline week to week.

# canary_tasks [id...] -> one compact task a line, by id; every listed id must exist
canary_tasks() {
  local f id
  if [ $# -eq 0 ]; then
    compgen -G "$BENCH_CANARY_DIR/*.json" >/dev/null || return 0
    set -- "$BENCH_CANARY_DIR"/*.json
  else
    for id in "$@"; do
      [ -f "$BENCH_CANARY_DIR/$id.json" ] || { say "canary: no task $id in $BENCH_CANARY_DIR"; return 2; }
    done
    set -- "${@/#/$BENCH_CANARY_DIR/}"; set -- "${@/%/.json}"
  fi
  for f in "$@"; do
    jq -ce 'select((.id | strings) and (.project | strings) and (.base | strings)
                   and ((.merge | type == "string") or ((.oracle.script | type == "string") and (.oracle.answer.script | type == "string") and (.oracle.answer.cmd | type == "array")))
                   and (.task | strings) and (.pts | numbers and . >= 1 and . == floor)
                   and (.oracle.paths | arrays) and (.oracle.cmd | arrays))' "$f" 2>/dev/null ||
      { say "canary: $f is not a task (id, project, base, merge or oracle.script with oracle.answer, task, pts, oracle.paths, oracle.cmd)"; return 2; }
  done
}

canary_task() { canary_tasks "$1"; }
canary_week() { date -d "@$(now)" +%Gw%V; }

# canary_repo <project> -> the project's checkout from the project map, else the caller's repo
canary_repo() {
  local dir
  dir=$(jq -r --arg p "$1" 'first(.paths // {} | to_entries[] | select(.value == $p) | .key) // empty' "$BENCH_PROJECT_MAP" 2>/dev/null)
  [ -n "$dir" ] && [ -d "$dir" ] || dir=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  printf '%s' "$dir"
}

# canary_script <name> -> the path of an answer-key script in BENCH_CANARY_ORACLES (a bare file name, no path)
canary_script() {
  # Non-empty: `bash -s` on an empty stdin exits 0, which would score every run a pass.
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] && [ -s "$BENCH_CANARY_ORACLES/$1" ] || { say "canary: no oracle script $1 in $BENCH_CANARY_ORACLES"; return 1; }
  printf '%s/%s' "$BENCH_CANARY_ORACLES" "$1"
}

# canary_vendor <tree> -> the tree's tests/vendor made a link to its main checkout's (bats and its
# helpers: gitignored, and the lane sandbox has no network to fetch them), which the gateway sandbox
# profile reads (allowRead). Whatever stood there goes, so a tests/vendor the run made itself can neither
# hide bats from the oracle nor stand in a bats of its own, even one it committed (ar-3777). Nothing to do
# when the main checkout has no bats, when the tree is that checkout, or when the task's base tracks files
# under tests/vendor. An older base ignores only `tests/vendor/`, which a link does not match, so the link
# goes in the repo's info/exclude there: a tree left by a run that never scored still reads clean to wt reap.
# Run only on a tree canary start and score own (start's, score's when it resets, verify's throwaway).
canary_vendor() {
  local v="$1/tests/vendor" src ex
  src=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/../tests/vendor
  src=$(realpath -e -- "$src" 2>/dev/null) && [ -x "$src/bats-core/bin/bats" ] || return 0
  [ "$(realpath -m -- "$v")" != "$src" ] && [ -z "$(git -C "$1" ls-tree --name-only "$2" -- tests/vendor)" ] || return 0
  rm -rf -- "$v" && mkdir -p -- "$1/tests" && ln -s -- "$src" "$v" || return 1
  git -C "$1" check-ignore -q tests/vendor && return 0
  ex=$(git -C "$1" rev-parse --path-format=absolute --git-path info/exclude) && mkdir -p -- "${ex%/*}" && echo tests/vendor >>"$ex"
}

# canary_oracle <task> <tree> <log> -> lays the oracle paths from merge over the tree (a task with a merge
# and paths), runs its command there under BENCH_CANARY_TIMEOUT (inside BENCH_CANARY_WRAP when set), with
# its oracle.script on stdin when it has one, and returns its exit (98 when the overlay or the script
# fails, or the command is a tests/vendor runner the tree lacks, canary_vendor's to lay: a broken task or
# an oracle that could not run, not a failed session)
canary_oracle() {
  local merge paths=() cmd=() wrap=() script=/dev/null
  merge=$(jq -r '.merge // empty' <<<"$1")
  mapfile -t paths < <(jq -r '.oracle.paths[]' <<<"$1")
  mapfile -t cmd < <(jq -r '.oracle.cmd[]' <<<"$1")
  [ -z "$merge" ] || [ "${#paths[@]}" = 0 ] || git -C "$2" checkout -q "$merge" -- "${paths[@]}" 2>>"$3" || return 98
  [[ "${cmd[0]}" != tests/vendor/* ]] || [ -x "$2/${cmd[0]}" ] ||
    { echo "oracle: ${cmd[0]} is missing, so the oracle could not run" >>"$3"; return 98; }
  [ -z "$(jq -r '.oracle.script // empty' <<<"$1")" ] || script=$(canary_script "$(jq -r .oracle.script <<<"$1")" 2>>"$3") || return 98
  [ -z "$BENCH_CANARY_WRAP" ] || wrap=(bash -c "$BENCH_CANARY_WRAP \"\$@\"" oracle)
  (cd "$2" && timeout "$BENCH_CANARY_TIMEOUT" "${wrap[@]}" "${cmd[@]}" <"$script") >>"$3" 2>&1
}

# canary_answer <task> <tree> <log> -> writes the task's known answer into the tree: its merge for a task
# that has one (the whole tree, as verify always did), else oracle.answer's script run there
canary_answer() {
  local cmd=() script
  if [ -n "$(jq -r '.merge // empty' <<<"$1")" ]; then
    git -C "$2" checkout -q -f --detach "$(jq -r .merge <<<"$1")" 2>>"$3" && git -C "$2" clean -qfd; return
  fi
  mapfile -t cmd < <(jq -r '.oracle.answer.cmd[]' <<<"$1")
  script=$(canary_script "$(jq -r .oracle.answer.script <<<"$1")" 2>>"$3") || return 98
  (cd "$2" && "${cmd[@]}" <"$script") >>"$3" 2>&1
}

# canary_brief <task> <slug> [sandboxed] -> the canary item's whole task: no /one-shot, no PR (fleet-dispatch
# starts a `canary` item on this text as it is). A run in its harness's own lane sandbox sees its
# worktree alone, so fleet-dispatch runs the start, score and done steps around it and its brief is
# the task alone.
canary_brief() {
  # A task with a merged PR is replayed from it and scored by its tests; one without (a known-answer fix at a
  # pinned base) names no PR and is scored by its answer-key script, so its brief says neither "PR" nor "tests".
  local defs='
    (if .merge then {src: (.pr // "a merged PR"), at: "the commit before that PR", later: "that PR (not git log past HEAD, not origin/main, not the PR)",
                     score: "that PR'"'"'s own tests", lays: "lays that PR'"'"'s own tests over your tree, runs them"}
     else {src: "the known-answer set", at: "this task'"'"'s pinned commit", later: "this commit (not git log past HEAD, not origin/main)",
           score: "a script that checks the result", lays: "runs the script that checks the result on your tree"} end) as $k
    | (if .merge then "Done when these tests pass: \((.accept // []) | join("; ")) (in \(.oracle.paths | join(" ")))."
       else "Done when: \((.accept // []) | join("; "))." end) as $done'
  [ -z "${3:-}" ] || { jq -r "$defs"'
    | "Canary eval \(.id): a fixed task from \($k.src), run each week to score the fleet. It is not a change to ship: open no PR, push nothing, and read nothing later than \($k.later).",
    "This worktree is already at \($k.at), and it is scored by \($k.score) once you end. Your shell sees this worktree and nothing else of the machine.",
    "Do this task here, as you would on main: \(.task)",
    (if (.accept // []) | length > 0 then $done else empty end),
    "Then end the session."' <<<"$1"; return; }
  jq -r --arg slug "$2" "$defs"'
    | "Canary eval \(.id): a fixed task from \($k.src), run each week to score the fleet. It is not a change to ship: open no PR, push nothing, touch no board or sheet row, and read nothing later than \($k.later).",
    "1. Run `fleet-bench canary start \(.id)` here: it puts this worktree at \($k.at).",
    "2. Do this task there, as you would on main: \(.task)",
    (if (.accept // []) | length > 0 then "   \($done)" else empty end),
    "3. Run `fleet-bench canary score \(.id)` once: it \($k.lays), records the score and puts this worktree back at that commit, keeping your diff beside the score'"'"'s log. Its result is final.",
    "4. agent-queue move \($slug) done --status ok, then wind down (in Claude Code, the wind-down skill; in any other harness, end the session)."' <<<"$1"
}

# canary queue [--harness h [--model m]]: one canary item per task for this ISO week, none for a
# task whose item exists (by its title or slug, canary_known) in any state but a cancel by a session, which
# is queued again up to BENCH_CANARY_RETRIES times, so a second pass the same week queues nothing. `from: canary` files no story row. With no flags it is the weekly claude lane;
# another lane's items are canary-<id>-<week>-<h>[-<m>] (a long id cut, see canary_slug), carrying
# agent and model for fleet-dispatch to start them on.
# Every lane queues at low: a canary is a check, upkeep, never work that blocks a release or another
# agent (ar-4349). The week-46 claude run at low started none of its 14 tasks in 3 nights (ar-845),
# so #1948 raised it to high while most of the queue was high; on 2026-11-19..21 low items waited 0.3h at
# the median and 11h at p90, and another harness's low lane starts as overflow on its own source.
# canary_slug <id> <week> [lane] -> the item slug, built to survive agent-queue's slugify (lowercase,
# a-z0-9 and single dashes, cut at 40): the lane suffix stays whole and the id is what gets shortened,
# so lanes never collapse into one another and `show`, `set` and the brief name the item as stored.
# A shortened id ends in 4 hex of the whole id's sha1, so two ids that share a prefix keep two slugs:
# the go lane leaves an id 9 letters, and dispatch-load-hold and dispatch-requested-night both cut to
# "dispatch", which refused the whole go lane on every pass of 2026w47 (ar-2854).
# A lane with an effort ends in its first two letters (me, hi, lo, mi, xh): the whole word would
# leave the id too few letters to tell the tasks apart. For the same reason a claude lane with a model
# is named by the model alone, as the baseline lane names no harness. Retro refuses a lane whose slug
# repeats one before it.
# canary_lane_name <harness> [model] [effort] -> the lane part of the slug, as canary_slug keeps it whole
canary_lane_name() {
  local h=$1; [ "$h" != claude ] || [ -z "$2" ] || h=''
  printf '%s' "$h${2:+${h:+-}$2}${3:+-${3:0:2}}"
}

canary_slug() {
  local id tail room
  tail=$(printf '%s' "-$2${3:+-$3}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | tr -s '-')
  id=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | tr -s '-' | sed 's/^-//')
  room=$((40 - 7 - ${#tail}))
  if [ "${#id}" -gt "$room" ]; then
    local hash; hash=$(printf '%s' "$1" | sha1sum)
    if [ "$room" -gt 6 ]; then id="$(printf '%s' "${id:0:$((room - 5))}" | sed 's/-*$//')-${hash:0:4}"
    elif [ "$room" -ge 4 ]; then id=${hash:0:$room}   # too little room for a prefix: the hash alone
    else return 1; fi
  fi
  [ -n "$id" ] || return 1
  printf 'canary-%s%s' "$id" "$tail"
}

# canary_lane_why <harness> <model> <effort> -> says what is wrong with the lane and returns 1, or nothing and 0
canary_lane_why() {
  [ -z "$2" ] || [ -n "$1" ] || { echo "--model needs --harness"; return 1; }
  [ -z "$3" ] || [ -n "$2" ] || { echo "--effort needs --model"; return 1; }
  [ "$1" != claude ] || [ -z "$2" ] || [ -n "$3" ] || { echo "a claude lane needs --effort, which keeps its scores out of the claude baseline"; return 1; }
}

# canary_queue [--harness h [--model m [--effort e]]] [--max N] [--task id[,id]] [--pts n[,n]] [--off-claude p[,p]]: the CLI. With a lane it queues that lane's
# missing tasks (at most N when given; only the named ids and sizes when --task or --pts is given); with --max alone it tops up across the claude lane and every lane
# in BENCH_CANARY_LANES (canary_top_up), one task a lane a round, so a few canaries run across lanes together. --off-claude (fleet-dispatch) names the projects whose share is full: a claude lane leaves out the tasks of those projects only (a Claude canary there would wait at the cap), every other task and lane queues.
canary_queue() {
  local why harness="" model="" effort="" max="" only_ids="" only_pts="" off_claude=""   # only_*: read by canary_lane_queue, off_claude by canary_top_up (dynamic scope)
  while [ $# -gt 0 ]; do
    case "$1" in
      --harness) harness="${2:?canary queue: --harness needs a value}"; shift 2 ;;
      --model) model="${2:?canary queue: --model needs a value}"; shift 2 ;;
      --effort) effort="${2:?canary queue: --effort needs a value}"; shift 2 ;;
      --max) max="${2:?canary queue: --max needs a number}"; shift 2 ;;
      --task) only_ids="${2:?canary queue: --task needs task ids, comma-separated}"; shift 2 ;;
      --pts) only_pts="${2:?canary queue: --pts needs sizes, comma-separated}"; shift 2 ;;
      --off-claude) off_claude="${2:?canary queue: --off-claude needs projects, comma-separated}"; shift 2 ;;
      *) say "usage: fleet-bench canary queue [--harness h [--model m [--effort e]]] [--max N] [--task id[,id]] [--pts n[,n]] [--off-claude p[,p]]"; return 2 ;;
    esac
  done
  [[ -z "$only_pts" || "$only_pts" =~ ^[1-9][0-9]*(,[1-9][0-9]*)*$ ]] || { say "canary queue: --pts needs whole sizes, comma-separated"; return 2; }
  [[ -z "$only_ids" || "$only_ids" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*(,[A-Za-z0-9][A-Za-z0-9_-]*)*$ ]] || { say "canary queue: --task needs task ids (letters, digits, - and _), comma-separated"; return 2; }
  [ -z "$only_ids$only_pts" ] || [ -n "$harness" ] || { say "canary queue: --task and --pts need --harness (the top-up fills every lane)"; return 2; }
  [[ -z "$max" || "$max" =~ ^[1-9][0-9]*$ ]] || { say "canary queue: --max needs a whole number above 0"; return 2; }
  [ -z "$off_claude" ] || { [ -n "$max" ] && [ -z "$harness" ]; } || { say "canary queue: --off-claude goes with --max alone (the top-up)"; return 2; }
  why=$(canary_lane_why "$harness" "$model" "$effort") || { say "canary queue: $why"; return 2; }
  if [ -n "$max" ] && [ -z "$harness" ]; then canary_top_up "$max"; return; fi
  canary_lane_queue "$harness" "$model" "$effort" "${max:-0}"
}

# canary_title <id> <week> [label] -> the item's title and its identity: the whole id, the week and the lane, so
# an item is found by what it runs, whatever its slug was cut to when it was queued.
canary_title() { printf 'check(canary): %s %s%s' "$1" "$2" "${3:+ $3}"; }

# canary_known_load -> reads the titles and slugs of the week's window into CANARY_KNOWN once (CANARY_KNOWN_ON=1),
# so a pass forks no `show` per task and lane. Rc 1 when the queue cannot be read: queueing blind would add twice.
# A cancelled item never ran, so a session's cancel of one (cancelled_by set) leaves it unknown and its lane queues
# it again in its week, up to BENCH_CANARY_RETRIES times (148 w47 items sat cancelled by a queue-cap plan, never
# rerun). Kept known: a cancel by hand (no cancelled_by), canary_lane_queue's own (CANARY_SET_CANCEL, so a model
# that cannot be set does not redo on every pass), and a slug already queued again that many times.
CANARY_SET_CANCEL="canary: its model and canary id could not be set"
canary_known_load() {
  [ -z "${CANARY_KNOWN_ON:-}" ] || return 0
  local out
  out=$($BENCH_CANARY_QUEUE_CMD list --json --state all --since 10d 2>/dev/null) || return 1
  CANARY_KNOWN=$(jq -rs --argjson r "$BENCH_CANARY_RETRIES" --arg own "$CANARY_SET_CANCEL" '
    def retryable: .status == "cancelled" and ((.cancelled_by // "") != "") and ((.cancel_why // "") | startswith($own) | not);
    (map(select(retryable)) | group_by(.slug) | map(select(length > $r) | .[0].slug)) as $spent
    | .[] | select((retryable | not) or (.slug | IN($spent[])))
    | .title // empty, .slug // empty' <<<"$out" 2>/dev/null) || return 1
  CANARY_KNOWN_ON=1
}

# canary_known <title> <slug> -> true when an item of that title or slug is held against queueing (canary_known_load)
canary_known() { grep -qxF -e "$1" -e "$2" <<<"$CANARY_KNOWN"; }

# canary_lane_queue <harness> <model> <effort> <max> -> queues the lane's missing tasks, at most <max> (0: all),
# and leaves the count in CANARY_ADDED. Says its one summary line unless CANARY_QUIET is set (canary_top_up
# says its own).
canary_lane_queue() {
  local tasks t id tproject slug title week why lane="" label="" harness=$1 model=$2 effort=$3 max=$4 added=0 had=0 off=0
  local -A seen=()
  CANARY_ADDED=0
  [ -z "$harness" ] || { lane=$(canary_lane_name "$harness" "$model" "$effort"); label="$harness${model:+/$model}${effort:+@$effort}"; }
  if [ -n "${only_ids:-}" ]; then
    local -a ids; IFS=, read -ra ids <<<"$only_ids"
    tasks=$(canary_tasks "${ids[@]}") || return $?
  else tasks=$(canary_tasks) || return 1; fi
  [ -z "${only_pts:-}" ] || tasks=$(jq -c --arg p ",$only_pts," 'select(. as $t | $p | contains("," + ($t.pts | tostring) + ","))' <<<"$tasks")
  [ -z "${only_ids:-}${only_pts:-}" ] || [ -n "$tasks" ] || { say "canary queue: no task matches ${only_ids:+--task $only_ids }${only_pts:+--pts $only_pts}"; return 2; }
  [ -n "$tasks" ] || return 0   # no set yet: nothing to run, and nothing to say on every retro
  # The baseline lane queues its positive control tasks first, so each week's control runs before the
  # scores it vouches for (canary_graded); the top-up takes one task a lane a round, in this order.
  [ -n "$harness" ] || tasks=$(jq -sc "$JQ_LIB"'sort_by(. as $t | {model: "opus"} | canary_control($t) | not) | .[]' <<<"$tasks")
  week=$(canary_week)
  canary_known_load || { say "canary: the queue is unreadable, so nothing is queued${label:+ for $label}"; return 1; }
  # A harness lane replays only the tasks its harness may run: with a project allowlist (ocfree:
  # public input only) only those projects', and with a malformed one nothing, since fleet-dispatch
  # would refuse every one on every pass. A claude lane, and a harness the map lacks (fleet-dispatch
  # refuses it at start), are held by no list here.
  local held='' sbx=''
  if [ -n "$harness" ] && [ "$harness" != claude ] &&
    jq -e --arg h "$harness" '.harnesses[$h] | type == "object"' "$BENCH_HARNESSES" >/dev/null 2>&1; then
    held=1
    # A harness in its own lane sandbox: fleet-dispatch runs the steps around it by the item's canary id.
    sbx=$(jq -r --arg h "$harness" '.harnesses[$h].sandbox // empty' "$BENCH_HARNESSES")
    why=$(harness_project_why "$BENCH_HARNESSES" "$harness" "")
    [ $? != 2 ] || { say "canary: $label queues nothing: $why"; return 1; }
  fi
  while IFS= read -r t; do
    { read -r id; read -r tproject; } < <(jq -r '.id, (.project // "")' <<<"$t")
    # A claude lane (the baseline has no harness) leaves out a task of a project whose share is full (--off-claude).
    if [ -n "${off_claude:-}" ] && { [ -z "$harness" ] || [ "$harness" = claude ]; } && [[ ",$off_claude," == *",$tproject,"* ]]; then
      continue
    fi
    [ -z "$held" ] || harness_project_why "$BENCH_HARNESSES" "$harness" "$tproject" >/dev/null ||
      { off=$((off + 1)); continue; }
    slug=$(canary_slug "$id" "$week" "$lane") || { say "canary: lane '$lane' leaves no room for $id in a 40-char slug"; return 1; }
    [ -z "${seen[$slug]:-}" ] || { say "canary: $id and ${seen[$slug]} share the slug $slug"; return 1; }
    seen[$slug]=$id
    title=$(canary_title "$id" "$week" "$label")
    if canary_known "$title" "$slug"; then had=$((had + 1)); continue; fi
    $BENCH_CANARY_QUEUE_CMD add --project "$tproject" --from canary --tags canary \
      --priority low --weight light ${harness:+--agent "$harness"} --slug "$slug" --title "$title" \
      -- "$(canary_brief "$t" "$slug" "$sbx")" >/dev/null || { say "canary: could not queue $slug"; return 1; }
    [ -z "$model$sbx" ] || $BENCH_CANARY_QUEUE_CMD set "$slug" ${model:+"model=$model"} ${effort:+"effort=$effort"} ${sbx:+"canary=$id"} >/dev/null ||
      { $BENCH_CANARY_QUEUE_CMD cancel "$slug" --why "$CANARY_SET_CANCEL" >/dev/null 2>&1
        say "canary: could not set the model and canary id of $slug, so it is cancelled and not queued again in its week"; return 1; }
    CANARY_KNOWN+=$'\n'"$title"$'\n'"$slug"
    added=$((added + 1)); CANARY_ADDED=$added
    [ "$max" = 0 ] || [ "$added" -lt "$max" ] || break
  done <<<"$tasks"
  local note=''; [ "$off" = 0 ] || note=", $off outside $harness's projects"
  [ -n "${CANARY_QUIET:-}" ] || say "canary: $added queued, $had already queued$note for $week${label:+ ($label)}"
}

# canary_retire -- cancel the queued canary items of an earlier week than canary_week: a week's set
# replays the same tasks, so a leftover only spends a slot on last week's lane beside this week's
# (22 week-46 codex items still queued on 2026-11-17). A running one is left to finish. canary_top_up runs it
# first. Returns 1 when one could not be cancelled.
canary_retire() {
  local week items slug out rc=0 n=0
  week=$(canary_week)
  items=$($BENCH_CANARY_QUEUE_CMD list --json --state queued 2>/dev/null) || { say "canary: the queue is unreadable, so no earlier week's run is retired"; return 1; }
  while IFS= read -r slug; do
    [ -n "$slug" ] || continue
    if out=$($BENCH_CANARY_QUEUE_CMD cancel "$slug" --why "canary: superseded by the $week set" 2>&1); then n=$((n + 1))
    else say "canary: could not cancel $slug: ${out##*$'\n'}"; rc=1; fi
  done < <(jq -r --arg w "$week" 'select(.from == "canary")
    | ((.title // "") | capture("^check\\(canary\\): [^ ]+ (?<w>[0-9]{4}w[0-9]{2})( |$)").w) as $iw
    | select($iw < $w) | .slug' <<<"$items" 2>/dev/null)
  [ "$n" = 0 ] || say "canary: retired $n queued item(s) of an earlier week than $week"
  return "$rc"
}

# canary_top_up <max> -> queues at most <max> of this week's missing canary items, one task a lane a round
# across the claude baseline lane and each lane in BENCH_CANARY_LANES (`harness model [effort]` a line, #
# comments) that has room, so the few queued at once run across lanes together instead of one lane's whole
# set first. A lane has room when the source its harness spends from (harnesses.json `source`) does by
# BENCH_ROOM_CMD, as a claude lane does when any Claude account does; a lane with none, no source or a
# repeated slug is said and skipped. fleet-dispatch calls it (canary_top_up) to keep DISPATCH_CANARY_KEEP canaries queued; the
# weekly retro queues none. Says one line a lane that queued, and returns 1 when a lane could not be queued.
canary_top_up() {
  local left=$1 h m e src route why label lane entry got rc=0 round
  local -A lanes=() queued=() dead=()
  local -a active=("||")
  # An earlier week's queued items go first: they hold floor slots for lanes that no longer replay them.
  canary_retire || say "canary: could not retire every earlier week's run"
  # Every title of the week's window in one read, held for the whole pass.
  CANARY_KNOWN='' CANARY_KNOWN_ON=''
  canary_known_load || { say "canary: the queue is unreadable, so no lane is topped up"; return 1; }
  if [ -r "$BENCH_CANARY_LANES" ]; then
    while read -r h m e _ <&3 || [ -n "$h" ]; do
      [ -n "$h" ] && [ "${h:0:1}" != "#" ] || continue
      label="$h${m:+/$m}${e:+@$e}" lane=$(canary_lane_name "$h" "$m" "$e")
      if [ -n "${lanes[$lane]:-}" ]; then say "canary: $label not queued, its slug is ${lanes[$lane]}'s"; continue; fi
      lanes[$lane]=$label
      if ! why=$(canary_lane_why "$h" "$m" "$e"); then say "canary: $label not queued, $why"; rc=1; continue; fi
      if [ "$h" = claude ]; then
        if ! why=$($BENCH_ROOM_CMD 2>&1); then say "canary: $label not queued, no Claude account has room${why:+: $why}"; continue; fi
      else
        IFS=$'\x1f' read -r src route < <(jq -r --arg h "$h" --arg m "$m" '.harnesses[$h] as $x
          | [$x.source // "", (($x.models // {})[$m] // "" | if ($x.launcher // $h) == "opencode" then sub("^[^/]*/"; "") else . end)] | join("\u001f")' "$BENCH_HARNESSES" 2>/dev/null)
        if [ -z "$src" ]; then say "canary: $label not queued, $h has no source in $BENCH_HARNESSES"; continue; fi
        # The model's own route as well as its source, as fleet-dispatch's start asks (harness_route): a
        # source with room still refuses a route whose daily quota is spent (ar-4601: ocfree beam, 11-22).
        if ! why=$($BENCH_ROOM_CMD --source "$src" ${route:+--model "$route"} 2>&1); then say "canary: $label not queued, ${why:-$src has no room}"; continue; fi
      fi
      active+=("$h|$m|$e")
    done 3<"$BENCH_CANARY_LANES"
  fi
  while [ "$left" -gt 0 ]; do
    round=0
    for entry in ${active[@]+"${active[@]}"}; do
      [ "$left" -gt 0 ] || break
      [ -z "${dead[$entry]:-}" ] || continue
      IFS='|' read -r h m e <<<"$entry"
      CANARY_QUIET=1 canary_lane_queue "$h" "$m" "$e" 1 || { dead[$entry]=1; rc=1; continue; }
      got=$CANARY_ADDED
      [ "$got" -gt 0 ] || { dead[$entry]=1; continue; }   # the lane's week is all queued
      queued[$entry]=$(( ${queued[$entry]:-0} + got )); left=$(( left - got )); round=1
    done
    [ "$round" = 1 ] || break
  done
  for entry in ${active[@]+"${active[@]}"}; do
    [ -n "${queued[$entry]:-}" ] || continue
    IFS='|' read -r h m e <<<"$entry"
    say "canary: ${queued[$entry]} queued for $(canary_week)${h:+ ($h${m:+/$m}${e:+@$e})}"
  done
  CANARY_KNOWN='' CANARY_KNOWN_ON=''
  return "$rc"
}

# canary_lane -> {harness, model, effort, session_id, end_reason} of the run scoring now: harness, model, effort and
# end_reason (why the session ended: the one record, which fleet-dispatch record-end writes in the canary tail)
# from its queue item, else codex when CODEX_THREAD_ID is set, else claude. The session is that harness's own
# id, else the newest one claimed on the item.
canary_lane() {
  local it=null
  [ -z "${AGENT_QUEUE_ITEM:-}" ] || it=$($BENCH_CANARY_QUEUE_CMD show "$AGENT_QUEUE_ITEM" --json 2>/dev/null | jq -ce objects) || it=null
  jq -nc --argjson it "$it" --arg cx "${CODEX_THREAD_ID:-}" --arg cl "${CLAUDE_CODE_SESSION_ID:-}" '
    def nz: if . == "" then null else . end;
    ($it.agent // (if $cx != "" then "codex" else "claude" end)) as $h
    | {harness: $h, model: ($it.model // null | nz), effort: ($it.effort // null | nz), end_reason: ($it.end_reason // null | nz),
       session_id: ((if $h == "claude" then $cl elif $h == "codex" then $cx else "" end | nz)
                    // ($it.sessions // "" | split(" ") | map(select(length > 0)) | last))}'
}

# canary start <id>: the session's own worktree, clean, moved to the task's base (detached), tests/vendor linked in.
# The caller's place (its branch, else its commit) is kept in the tree's own git dir (canary_mark) for score to put
# back (ar-5935: a detached session tree lost its branch); a second start keeps the first one's. A start that fails
# after its checkout puts the tree back there.
# A base that leaves untracked a path HEAD tracks is refused and the tree put back: git could not remove a directory
# that is not empty (a populated submodule at a base before it was one, muxpoon in ar-5933, or ignored files in a
# tracked one), which score's clean would delete, and the run would start on a tree that is not base.
canary_start() {
  local t top base orig from left mark
  t=$(canary_task "${1:?usage: fleet-bench canary start <id>}") || return 2
  top=$(git rev-parse --show-toplevel 2>/dev/null) || { say "canary start: not in a git worktree"; return 2; }
  base=$(jq -r .base <<<"$t")
  git -C "$top" cat-file -e "$base^{commit}" 2>/dev/null || { say "canary start: $top has no commit $base"; return 2; }
  [ -z "$(git -C "$top" status --porcelain)" ] || { say "canary start: $top has uncommitted changes"; return 2; }
  mark=$(canary_mark "$top") || return 1
  # A record counts only while HEAD is the base it was left at, detached: an earlier start's. Anywhere else the
  # caller is where it stands (a branch by its full ref, since --short can print an ambiguous heads/<name>).
  orig=$(canary_marked "$top") ||
    { orig=$(git -C "$top" symbolic-ref -q HEAD) && orig=${orig#refs/heads/}; } || orig=$(git -C "$top" rev-parse HEAD) || return 1
  # Written before the checkout, so a start killed between the two still knows where to go back to.
  printf '%s\t%s\n' "$orig" "$(git -C "$top" rev-parse "$base^{commit}")" >"$mark" || { say "canary start: could not record $orig in $mark"; return 1; }
  from=$(git -C "$top" rev-parse HEAD) || return 1
  git -C "$top" checkout -q --detach "$base" || { rm -f "$mark"; return 1; }
  left=$(git -C "$top" -c core.quotePath=false ls-files --others --exclude-standard --directory | while IFS= read -r p; do
           [ -z "$(git -C "$top" ls-tree --name-only "$from" -- "${p%/}")" ] || printf '%s\n' "${p%/}"
         done | paste -sd ' ')
  if [ -n "$left" ]; then
    canary_restore "$top" "$orig" || { say "canary start: $base leaves $left untracked in $top, and $top could not be put back at $orig"; return 1; }
    say "canary start: $base leaves $left untracked in $top (git could not remove a tracked directory that is not empty: a submodule's copy, or ignored files in it), so $top stays at $orig"; return 2
  fi
  # Here, outside the lane sandbox, so the run can run the tests its brief names (canary_vendor).
  canary_vendor "$top" "$base" || {
    canary_restore "$top" "$orig" || say "canary start: $top could not be put back at $orig"
    say "canary start: could not link $top/tests/vendor, so the run would have no bats"; return 1; }
  printf 'canary %s: %s is at %s\n%s\n' "$1" "$top" "${base:0:10}" "$(jq -r .task <<<"$t")"
}

# canary_mark <tree> -> the file in the tree's own git dir (per worktree) that holds `<place>\t<base sha>`: where
# canary start found the tree, and the base it moved it to
canary_mark() { git -C "$1" rev-parse --path-format=absolute --git-path fleet-bench-canary; }

# canary_marked <tree> -> the place canary start found the tree at, when its record names the commit the
# tree is detached at now; rc 1 for none, or for a stale one (a tree that has moved since, ar-5935)
canary_marked() {
  local m place sha
  m=$(canary_mark "$1") && [ -s "$m" ] && IFS=$'\t' read -r place sha <"$m" && [ -n "$place" ] || return 1
  ! git -C "$1" symbolic-ref -q HEAD >/dev/null && [ "$(git -C "$1" rev-parse HEAD)" = "$sha" ] && printf '%s\n' "$place"
}

# canary_restore <tree> <place> -> the tree checked out at <place> (a branch it attaches, else a commit,
# detached), and its canary_mark removed; rc 1 when the checkout fails, the mark kept
canary_restore() {
  if git -C "$1" show-ref --verify -q "refs/heads/$2"; then git -C "$1" checkout -q "$2" --
  else git -C "$1" checkout -q --detach "$2" --; fi || return 1
  rm -f "$(canary_mark "$1")"
}

# canary_keep <tree> <base> <patch> -> the run's own diff from base saved to <patch>, before the oracle
# is laid over the tree, so it holds neither the PR's tests nor what they write; rc 1, saying why, when
# the tree is to stay as the run left it. canary score resets only a linked worktree detached at a
# canary start: in a main checkout, or on a branch, the reset would discard real work.
canary_keep() {
  [ "$(git -C "$1" rev-parse --path-format=absolute --git-dir)" != "$(git -C "$1" rev-parse --path-format=absolute --git-common-dir)" ] ||
    { say "canary score: $1 is no linked worktree, so it stays as the run left it"; return 1; }
  ! git -C "$1" symbolic-ref -q HEAD >/dev/null ||
    { say "canary score: $1 is on a branch, not detached by canary start, so it stays as the run left it"; return 1; }
  # Staged only to diff the untracked files too, then unstaged, so the oracle runs on the tree as it was.
  git -C "$1" add -A && git -C "$1" diff --cached --no-ext-diff --no-textconv --src-prefix=a/ --dst-prefix=b/ "$2" >"$3" &&
    git -C "$1" reset -q || { say "canary score: could not save the run's diff, so $1 stays as the run left it"; return 1; }
}

# OUTSIDE_ENDS (lib/end-reasons.sh): a session end that leaves a canary run not run (pass null), out of every pass rate:
# UNRATED_ENDS, and a timeout too, since the pass rate grades the diff a finished session left and the
# lane's minutes already show a slow model. 12 of 16 failed free-model 2 and 3 point runs on 2026-11-19
# were provider refusals scored as model fails (agent-runtime docs/canary-free-failures-2026-11-19.md).

# canary score <id>: run the oracle over the session's tree and append one score row, then put the tree
# back where canary start found it (its branch, canary_mark), clean, so wt reaps it as landed (a dirty one was held forever: 23 of 134
# held trees on 2026-11-18); the run's diff stays as <run>.patch beside its log (canary_keep). A run is
# the queue item ($AGENT_QUEUE_ITEM) or the task and week, and it scores once: a second score is refused, unless
# the first was not run (pass null): that run is queued again (fleet-dispatch canary-close), and its next run scores.
# Why the session ended is the item's end_reason, which fleet-dispatch's canary tail writes from the harness's
# record once the run is over (record-end); none is unknown, and the oracle alone scores it. The row keeps it
# as end_reason, and an end in OUTSIDE_ENDS scores pass null, not run, whatever the oracle said. A
# positive control run (canary_control) is marked control, and when it fails it says that its whole week now
# reads instrument (canary_graded).
canary_score() {
  local t top run log rc=0 cfg r repos lane base reset=1 id="${1:-}" end='' pass verdict control orig
  t=$(canary_task "${id:?usage: fleet-bench canary score <id>}") || return 2
  [ $# -eq 1 ] || { say "usage: fleet-bench canary score <id>"; return 2; }
  top=$(git rev-parse --show-toplevel 2>/dev/null) || { say "canary score: not in a git worktree"; return 2; }
  run=${AGENT_QUEUE_ITEM:-canary-$id-$(canary_week)}
  if [ -s "$CANARY" ] && jq -e --arg r "$run" 'select(.run == $r and .pass != null)' "$CANARY" >/dev/null 2>&1; then
    say "canary score: $run is already scored"; return 3
  fi
  mkdir -p "$DIR/canary"; log="$DIR/canary/$run.log"; : >"$log"
  # The harness's own log of the run, kept before its shared log rotates it away: why a run with no diff ended.
  if [ -n "$BENCH_CANARY_RUN_LOG" ]; then
    timeout "$BENCH_CANARY_TIMEOUT" bash -c "$BENCH_CANARY_RUN_LOG" >"$DIR/canary/$run.harness.log" 2>>"$log" ||
      echo "canary score: the harness log command exited $?" >>"$log"
    [ -s "$DIR/canary/$run.harness.log" ] || rm -f "$DIR/canary/$run.harness.log"
  fi
  base=$(jq -r .base <<<"$t")
  canary_keep "$top" "$base" "$DIR/canary/$run.patch" || reset=''
  # A tree it resets is its own to relink; one it leaves as the run left it keeps its own tests/vendor.
  [ -z "$reset" ] || canary_vendor "$top" "$base" 2>>"$log" || { say "canary score: could not link $top/tests/vendor (log $log)"; return 1; }
  canary_oracle "$t" "$top" "$log" || rc=$?
  [ "$rc" != 98 ] || { say "canary score: the oracle could not be laid over $top, or its script or runner was not found (log $log)"; return 1; }
  IFS=: read -ra repos <<<"$BENCH_CANARY_CONFIG_REPOS"
  cfg=$(for r in "${repos[@]}"; do
          printf '%s\t%s\n' "$(basename "$r")" "$(git -C "$r" rev-parse --short=12 HEAD 2>/dev/null || echo null)"
        done | jq -Rn '[inputs | split("\t") | {key: .[0], value: .[1]}] | from_entries')
  lane=$(canary_lane)
  end=$(jq -r '.end_reason // empty' <<<"$lane")
  [ -z "${AGENT_QUEUE_ITEM:-}" ] || [ -n "$end" ] ||
    say "canary score: the session's end is unknown (the item has no end_reason: the harness record said nothing), so the oracle alone scores it"
  pass=false verdict=fail
  [ "$rc" != 0 ] || { pass=true verdict=pass; }
  ! outside_end "$end" || { pass=null verdict="not run (the session ended: $end)"; }
  control=$(jq -n --argjson t "$t" --argjson l "$lane" "$JQ_LIB"'$l | canary_control($t)')
  jq -nc --argjson t "$t" --argjson e "$(now)" --arg run "$run" --argjson rc "$rc" --argjson l "$lane" \
    --argjson pass "$pass" --arg end "$end" --argjson control "$control" \
    --argjson cfg "$cfg" '{epoch: $e, run: $run, id: $t.id, project: $t.project, pr: ($t.pr // null),
      session_id: $l.session_id, harness: $l.harness, model: $l.model, effort: $l.effort, pass: $pass, rc: $rc,
      end_reason: (if $end == "" then null else $end end), config: $cfg} + (if $control then {control: true} else {} end)' >>"$CANARY" ||
    { say "canary score: could not record $run in $CANARY"; return 1; }
  printf 'canary %s: %s (exit %s), log %s\n' "$id" "$verdict" "$rc" "$log"
  [ "$control" != true ] || [ "$pass" != false ] ||
    say "canary score: the positive control failed, so every run of $(jq -rn --arg r "$run" --argjson e "$(now)" "$JQ_LIB"'{run: $r, epoch: $e} | canary_batch') reads instrument, in no rate (fix the oracle or the sandbox, then rerun)"
  # The score is recorded, so a tree left dirty is said, not failed: the run's item still closes.
  if [ -z "$reset" ]; then
    ! orig=$(canary_marked "$top") || say "canary score: canary start found $top at $orig, and it stays where the run left it"
    return 0
  fi
  { git -C "$top" reset -q --hard "$base" && git -C "$top" clean -fdq; } ||
    { say "canary score: could not put $top back at ${base:0:10}, so wt reap leaves it"; return 0; }
  # A repo the run made (its own .git directory) goes too; a submodule's copy (.git a file, its git dir in the
  # checkout's) stays, since what it holds is in no patch (ar-5933: clean -ff deleted muxpoon's).
  while IFS= read -r p; do
    [[ "$p" != */ ]] || [ ! -d "$top/$p.git" ] || rm -rf -- "${top:?}/$p"
  done < <(git -C "$top" -c core.quotePath=false ls-files --others --exclude-standard --directory)
  # Then back where canary start found it (canary_marked), so a session's tree is on its branch again (ar-5935).
  if orig=$(canary_marked "$top"); then
    canary_restore "$top" "$orig" || say "canary score: could not put $top back on $orig, so it stays at ${base:0:10}"
  fi
  [ -z "$(git -C "$top" status --porcelain)" ] ||
    say "canary score: $top keeps $(git -C "$top" -c core.quotePath=false status --porcelain | cut -c4- | paste -sd ' ') after its reset, so wt reap leaves it"
}

# canary verify [id...]: each oracle must fail at base and pass at merge (a task with no merge: with its
# known answer written in), in a throwaway worktree of the project's checkout; exit 1 when any does not (a task that cannot score anything)
canary_verify() {
  local tasks t id repo tmp log b m bad=0 root
  tasks=$(canary_tasks "$@") || return 2
  [ -n "$tasks" ] || { say "canary: no tasks in $BENCH_CANARY_DIR"; return 2; }
  root="${XDG_CACHE_HOME:-$HOME/.cache}/fleet-bench/canary-verify"; mkdir -p "$root"
  while IFS= read -r t; do
    id=$(jq -r .id <<<"$t")
    repo=$(canary_repo "$(jq -r .project <<<"$t")") || { echo "BAD $id: no checkout of $(jq -r .project <<<"$t")"; bad=1; continue; }
    tmp="$root/$id"; log="$root/$id.log"; : >"$log"
    git -C "$repo" worktree remove --force "$tmp" 2>/dev/null; rm -rf "$tmp"
    git -C "$repo" worktree add -q --detach "$tmp" "$(jq -r .base <<<"$t")" 2>>"$log" || { echo "BAD $id: no worktree at base"; bad=1; continue; }
    canary_vendor "$tmp" "$(jq -r .base <<<"$t")" 2>>"$log" || { echo "BAD $id: could not link tests/vendor"; bad=1; continue; }
    b=0; canary_oracle "$t" "$tmp" "$log" || b=$?
    m=0; canary_answer "$t" "$tmp" "$log" && { canary_oracle "$t" "$tmp" "$log" || m=$?; } || m=$?
    git -C "$repo" worktree remove --force "$tmp"
    after=merge; [ -n "$(jq -r '.merge // empty' <<<"$t")" ] || after=answer
    if [ "$b" -ne 0 ] && [ "$b" -ne 98 ] && [ "$m" -eq 0 ]; then echo "ok $id: base exit $b, $after passes"
    else echo "BAD $id: base exit $b, $after exit $m (log $log)"; bad=1; fi
  done <<<"$tasks"
  return "$bad"
}

# canary list [--by harness,model[,pts]] [--json]: each task with its newest score, or with --by one
# row per lane (and with pts, per lane and task size): runs, tasks covered, pass rate, and per run its
# minutes, turns, cost and tokens from the session's outcome row (a plan login has tokens and no cost)
canary_list() {
  local tasks by="" json=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --by) by="${2:?canary list: --by needs harness,model}"; shift 2 ;;
      --json) json=1; shift ;;
      *) say "usage: fleet-bench canary list [--by harness,model[,pts]] [--json]"; return 2 ;;
    esac
  done
  case "$by" in
    "") ;;
    harness,model) canary_lanes "$json"; return ;;
    harness,model,pts) canary_lanes "$json" pts; return ;;
    *) say "canary list: --by takes harness,model or harness,model,pts"; return 2 ;;
  esac
  tasks=$(canary_tasks) || return 2
  jq -nc --slurpfile k "$(kpi_canary)" --rawfile ts <(printf '%s' "$tasks") "$JQ_LIB"'
    ($k | canary_graded) as $k
    | $ts | split("\n") | map(select(length > 0) | fromjson) | map(. as $x
      | [$k[] | select(.id == $x.id)] as $rs | ($rs | max_by(.epoch)) as $l
      | {id, project, pr, pts, last_run: ($l.run // null), last_pass: $l.pass, last_end: ($l.end_reason // null),
         last_instrument: ($l.instrument // false), runs: ($rs | length)}) | .[]' |
    if [ -n "$json" ]; then cat; else
      jq -r '"\(.id)\t\(.pr // "-")\t\(.runs) runs\t\(if .last_run == null then "never scored" else "\(.last_run): \(if .last_instrument then "instrument" elif .last_pass == null then "not run (\(.last_end // "?"))" elif .last_pass then "pass" else "fail" end)" end)\t\(.pts) pts"'
    fi
}

# canary_lanes [json] [pts] -> one row per harness, model and effort over every score, joined to outcome
# rows; with pts, one row per lane and task size, the size read from the task file by id (a score whose
# task is gone has pts null). same_tasks are the tasks a lane shares with the claude lane (canary_base,
# as the canary_ KPIs read it): its pass rate and claude's over just those, each the mean of per-task
# pass rates so a task claude re-ran every week weighs one, the like-for-like comparison; null on a claude row.
# Rows are graded first (canary_graded): instrument counts the runs an instrument fault decided, in no rate.
# Each rate carries its Wilson interval (pass_ci over runs; pass_same_ci and claude_same_ci over the same
# tasks), and vs_claude ranks the lane on them: above or below only when they do not overlap.
canary_lanes() {
  local tasks=""
  if [ "${2:-}" = pts ]; then tasks=$(canary_tasks) || return 2; fi
  jq -nc --slurpfile k "$(kpi_canary)" --slurpfile o <(outcomes_newest) --rawfile ts <(printf '%s' "$tasks") \
    --arg by "${2:-}" "$JQ_LIB"'
    def mean(f): map(f | numbers) | if length == 0 then null else add / length end;
    def passed: map(select(.pass == true)) | length;
    def per_task($i): map(select(.id == $i)) | passed / length;   # a task weighs one, however many weeks ran it
    ($o | INDEX(.session_id)) as $os
    | ($k | canary_graded) as $k
    | ($ts | split("\n") | map(select(length > 0) | fromjson | {key: .id, value: .pts}) | from_entries) as $pts
    | [$k[] | select(canary_base and canary_ran)] as $base
    | ($base | map(.id) | unique) as $bt
    | $k | group_by([.harness // "claude", .model // "", .effort // ""] + (if $by == "pts" then [$pts[.id // ""] // 0] else [] end)) | map(
        (.[0] | {harness: (.harness // "claude"), model: (.model // null), effort: (.effort // null)}
          + (if $by == "pts" then {pts: $pts[.id // ""]} else {} end)) as $lane
        | any(.[]; canary_base) as $isbase
        | length as $all | map(select(.instrument)) as $inst
        | map(select(canary_ran))   # a run not run counts as not_run (an instrument fault as instrument), in no rate or mean below
        | [.[] | . as $r | {pass, id, o: $os[$r.session_id // ""]}] as $rs
        | (map(.id) | unique | map(select(IN($bt[])))) as $st
        | (if $isbase then null else (. as $l | $st | map(. as $i | $l | per_task($i)) | mean(.)) end) as $ps
        | (if $isbase then null else ($st | map(. as $i | $base | per_task($i)) | mean(.)) end) as $cs
        # Same-task rates weigh each task one, so their interval is over the tasks, not the runs.
        | (if $ps == null then null else wilson($ps * ($st | length); $st | length) end) as $pci
        | (if $cs == null then null else wilson($cs * ($st | length); $st | length) end) as $cci
        | $lane + {runs: length, not_run: ($all - length - ($inst | length)), instrument: ($inst | length),
           tasks: (map(.id) | unique | length), pass_rate: ratio(($rs | passed); length), pass_ci: wilson($rs | passed; length),
           same_tasks: (if $isbase then null else ($st | length) end),
           pass_rate_same: (if $ps then $ps | round2 else $ps end), pass_same_ci: $pci,
           claude_pass_rate_same: (if $cs then $cs | round2 else $cs end), claude_same_ci: $cci,
           vs_claude: vs_ci($pci; $cci),
           joined: ($rs | map(select(.o)) | length),
           min_per_run: ($rs | mean(.o.duration_s) | if . then . / 60 | round1 else . end),
           turns_per_run: ($rs | mean(.o.activity.api_messages) | if . then round1 else . end),
           cost_per_run: ($rs | mean(.o.cost_usd) | if . then round1 else . end),
           tokens_per_run: ($rs | mean(.o.tokens_total) | if . then round else . end)}) | .[]' |
    if [ -n "$1" ]; then cat; else
      jq -r "$JQ_LIB"'"\(.harness)/\(.model // "-")\(if .effort then "@\(.effort)" else "" end)\(if has("pts") then "\t\(.pts // "-") pts" else "" end)\t\(.runs) runs\(if .not_run > 0 then " (+\(.not_run) not run)" else "" end)\(if .instrument > 0 then " (+\(.instrument) instrument)" else "" end)\t\(.tasks) tasks\tpass \(ci_cell(.pass_rate; .pass_ci; .runs))\(if .same_tasks == null then "" else "\tsame \(.same_tasks): pass \(ci_cell(.pass_rate_same; .pass_same_ci; .same_tasks)) vs claude \(ci_cell(.claude_pass_rate_same; .claude_same_ci; .same_tasks))\(if .vs_claude then ", \(.vs_claude)" else "" end)" end)\t\(.joined) joined\t\(.min_per_run // "-") min\t\(.turns_per_run // "-") turns\t$\(.cost_per_run // "-")\t\(.tokens_per_run // "-") tokens"'
    fi
}

# canary_lanes_section: the canary lanes table, in the scorecard
canary_lanes_section() {
  local j
  echo "## Canary lanes"
  echo
  echo "Every lane that scored on the fixed canary set (\`fleet-bench canary list --by harness,model\`). Same is the tasks a lane shares with the claude lane, and its pass rate beside claude's on just those: the like-for-like number a lane graduates on. Not run is the runs whose session ended outside the model (a provider refusal, a limit, a cut, the timeout), kept out of every other column. Instrument is the runs the instrument, not the model, decided: a runner not found (rc 127), or a run in a week whose positive control failed (the claude baseline on a 1-point known-answer task); they count in no rate. Each rate shows its Wilson 95% interval and n (runs for Pass; tasks for the same-task rates, which weigh each task one, so their interval treats a task as one trial at its mean pass rate: an approximation, and wide on a few tasks). Vs claude ranks a lane against claude on the same tasks only when the intervals do not overlap (above, below); overlap is no rank. Minutes, turns, cost and tokens are per run, from the session's outcome row."
  echo
  j=$(canary_lanes json) || { echo "- canary lanes: ? (scores or outcomes unreadable)"; return 0; }
  [ -n "$j" ] || { echo "- canary lanes: no scores yet"; return 0; }
  echo "| Lane | Runs | Not run | Instrument | Tasks | Pass | Same | Pass on same | Claude on same | Vs claude | Min | Turns | Cost | Tokens |"
  echo "|---|---|---|---|---|---|---|---|---|---|---|---|---|---|"
  jq -r "$JQ_LIB"'def d: if . == null then "-" else tostring end;
    "| \(.harness)/\(.model // "-")\(if .effort then "@\(.effort)" else "" end) | \(.runs) | \(.not_run) | \(.instrument) | \(.tasks) | \(ci_cell(.pass_rate; .pass_ci; .runs)) | \(.same_tasks | d) | \(ci_cell(.pass_rate_same; .pass_same_ci; .same_tasks)) | \(ci_cell(.claude_pass_rate_same; .claude_same_ci; .same_tasks)) | \(.vs_claude | d) | \(.min_per_run | d) | \(.turns_per_run | d) | \(if .cost_per_run == null then "-" else "$\(.cost_per_run)" end) | \(.tokens_per_run | d) |"' <<<"$j"
}

# canary matrix [--harness h] [--days N] [--json]: the task matrix for one harness (default codex),
# from BENCH_MATRIX. A kind-by-stack cell counts that harness's canary scores on tasks of the kind and
# stack, and its own items done in the last N days (default 30; canaries come in by score, not item):
# a pass is a passed score or an item closed ok; a fail is a failed score or an item closed failed,
# except an end that says nothing about the model (UNRATED_ENDS; a score not run, canary_ran). Proven
# is a pass, failing is fails and no pass, excluded is BENCH_MATRIX's why (an entry naming a `harness`
# holds that one alone) or what route() refuses the harness by its harnesses.json entry (a stack none of
# whose projects its `projects` allowlist names, plan items when headless with no resume, and a mode or a
# stack's PR-opening kinds whose capability its `capabilities` list leaves out), no work is a cell no item
# on any harness touched in the window, empty is the rest. A kind and scope are a row's type and area from
# `notes row parse`, the grammar's one home (agent-queue add records them on an item); an untyped one is in
# no cell. Each mode is mode_of's test on the item
# (interactive: the harness's own outcome rows no item claims, a pass when it merged a PR; forgejo: a
# project whose checkout mirrors to GitHub from Forgejo, as fleet-dispatch forge_canonical reads it).
MATRIX_JQ='
  def kind_of: if tagged("research") then "research" else .type // null end;
  def stack_of($m): (.stack // null) as $own | (.area // null) as $sc | .project as $p
    | $own // first($m.stacks | to_entries[] | select(($sc != null) and ((.value.scopes // []) | index($sc))) | .key)
      // first($m.stacks | to_entries[] | select(.value.projects | index($p)) | .key) // null;
  def verdict: if .status == "ok" then "pass" elif .status == "failed" and (unrated | not) then "fail" else null end;
  def mode_of($os): [
    (select(.mode == "oneshot" and (tagged("night") | not) and (tagged("red") | not)) | "oneshot"),
    (select(tagged("night")) | "night"), (select(tagged("red")) | "red"), (select(.mode == "plan") | "plan"),
    (select((" " + (.tags // "")) | test(" ask:")) | "ask-resume"),
    (select((.salvage // "") != "") | "salvage-resume"),
    (select(sids | any(. as $s | $os[$s] | select(.harness == $h) | (.uses.subagents // {}) | length > 0)) | "fan-out"),
    (select(.project as $p | $forgejo | index($p)) | "forgejo")];
  def cell($rs): {pass: ($rs | map(select(.v == "pass")) | length), fail: ($rs | map(select(.v == "fail")) | length),
    evidence: ($rs | map(select(.v)) | sort_by(.at) | last | .ref // null)};
  def status($c; $ex; $work): if $ex then "excluded" elif $c.pass > 0 then "proven" elif $c.fail > 0 then "failing"
    elif $work == 0 then "no work" else "empty" end;
  ($items | map(select(.from != "canary"))) as $all
  | ($o | INDEX(.session_id)) as $os
  | ($ts | map({key: .id, value: {kind: kind_of, stack: stack_of($m)}}) | from_entries) as $tk
  | ([$k | canary_graded | .[] | select((.harness // "claude") == $h and (.epoch // 0) >= ($since + "T00:00:00Z" | fromdateiso8601))
      | . as $r | $tk[$r.id] | select(.)
      | {kind, stack, v: (if ($r | canary_ran | not) then null elif $r.pass then "pass" else "fail" end), at: ($r.epoch | todate), ref: $r.run}]) as $scores
  | ([$all[] | select((.agent // "claude") == $h)
      | {kind: kind_of, stack: stack_of($m), modes: mode_of($os), v: verdict, at: (.finished // ""), ref: .slug}]) as $live
  | ($all | map({kind: kind_of, stack: stack_of($m)})) as $demand
  | ($all | map(.sessions // "" | split(" ")[]) | map(select(. != "")) | INDEX(.)) as $claimed
  | ([$o[] | select(.harness == $h and ($claimed[.session_id // ""] | not))
      | {v: (if (.prs_merged // 0) > 0 then "pass" else null end), at: (.updated // ""), ref: .session_id}]) as $hand
  | ([$hd.lacks[]? | "\($h) lacks the \(.cap) capability (harnesses.json): \(.why // "")" as $w | select(.mode != null) | {mode, why: $w}]
      + [$hd.lacks[]? | "\($h) lacks the \(.cap) capability (harnesses.json): \(.why // "")" as $w | select(.stack != null) | .stack as $st
         | $m.kinds[] | select(. as $kd | ($prkinds // $m.kinds) | index($kd)) | {kind: ., stack: $st, why: $w}]) as $caps
  | ([$m.excluded[]? | select(.harness == null or .harness == $h)] + $xstacks + $caps
      + if $hd.headless == true and $hd.resume != true
        then [{mode: "plan", why: "\($h) runs headless and cannot resume, so it takes no plan item (harnesses.json)"}] else [] end) as $exs
  | def excluded($kind; $stack; $mode): first($exs[] | select((.kind // null) == $kind and (.stack // null) == $stack
      and (.mode // null) == $mode)) // first($exs[] | select(.stack == null and .mode == null and .kind == $kind and $stack != null))
      // first($exs[] | select(.kind == null and .mode == null and .stack == $stack and $kind != null)) // null;
  {harness: $h, since: $since, kinds: $m.kinds, stacks: ($m.stacks | keys_unsorted),
   cells: [$m.kinds[] as $kd | $m.stacks | keys_unsorted[] as $st
     | (($scores + $live) | map(select(.kind == $kd and .stack == $st))) as $rs | cell($rs) as $c
     | excluded($kd; $st; null) as $ex
     | {kind: $kd, stack: $st} + $c + {status: status($c; $ex; ($demand | map(select(.kind == $kd and .stack == $st)) | length)), why: ($ex.why // null)}],
   modes: [$m.modes[] as $md
     | (if $md == "interactive" then $hand else $live | map(select(.modes | index($md))) end) as $rs | cell($rs) as $c
     | excluded(null; null; $md) as $ex
     | {mode: $md} + $c + {status: status($c; $ex; 1), why: ($ex.why // null)}],
   excluded: [$exs[] | select((.kind // null) as $x | ($m.kinds | index($x)) | not)]}'

# The matrix json's renderers share these: a cell's mark with its passes of runs, and the empty count.
MATRIX_FMT_JQ='def mark: {proven: "P", failing: "F", excluded: "X", "no work": "-", empty: "."}[.status]
    + (if .pass + .fail > 0 then " \(.pass)/\(.pass + .fail)" else "" end);
  def empties: [.cells[], .modes[] | select(.status == "empty")] | length; '

canary_matrix() {
  local h=codex days=30 json="" since tasks parsed items forgejo p dir hd xstacks projects
  while [ $# -gt 0 ]; do
    case "$1" in
      --harness) h="${2:?canary matrix: --harness needs a value}"; shift 2 ;;
      --days) days="${2:-}"; [[ "$days" =~ ^[1-9][0-9]*$ ]] || { say "canary matrix: --days takes a whole number"; return 2; }; shift 2 ;;
      --json) json=1; shift ;;
      *) say "usage: fleet-bench canary matrix [--harness h] [--days N] [--json]"; return 2 ;;
    esac
  done
  jq -e '(.kinds | arrays) and (.stacks | objects) and (.modes | arrays)' "$BENCH_MATRIX" >/dev/null 2>&1 ||
    { say "canary matrix: $BENCH_MATRIX is not a matrix (kinds, stacks, modes)"; return 2; }
  # The harness's map entry adds what route() refuses it: a stack every project of which its projects
  # allowlist leaves out (harness_project_why, failing closed as route() does), and plan items (takes_plan).
  # A harness the map does not have (claude) adds none.
  hd='{}' xstacks='[]'
  if [ -e "$BENCH_HARNESSES" ]; then
    # lacks: each capability of the map's vocabulary the entry does not list, with its stack or mode.
    hd=$(jq -ce --arg h "$h" '(.capabilities // {}) as $voc | .harnesses[$h] as $e | ($e // {} | objects)
        + (if $e == null then {} else {lacks: [$voc | to_entries[] | select(.key as $k | ($e.capabilities // []) | any(. == $k) | not)
            | {cap: .key, stack: .value.stack, mode: .value.mode, why: .value.why}]} end)' "$BENCH_HARNESSES" 2>/dev/null) ||
      { say "canary matrix: $BENCH_HARNESSES is unreadable, or its $h entry is no object"; return 2; }
    if jq -e 'has("projects")' <<<"$hd" >/dev/null; then
      local st why rc refused
      while IFS=$'\t' read -r st projects; do
        refused=1
        for p in $projects; do
          why=$(harness_project_why "$BENCH_HARNESSES" "$h" "$p"); rc=$?
          [ "$rc" != 2 ] || { say "canary matrix: $h: $why"; return 2; }
          [ "$rc" = 1 ] || { refused=0; break; }
        done
        [ "$refused" = 0 ] || xstacks=$(jq -c --arg s "$st" --arg w "$h: none of its projects is in its projects allowlist (harnesses.json)" '. + [{stack: $s, why: $w}]' <<<"$xstacks")
      done < <(jq -r '.stacks | to_entries[] | select(.value.projects | length > 0) | "\(.key)\t\(.value.projects | join(" "))"' "$BENCH_MATRIX")
    fi
  fi
  # The kinds that open a PR, which a stack-bound capability (unity_gate) refuses a harness without it (route()).
  prkinds=$(jq -c '[to_entries[] | select((.value.exit // "") | . == "" or . == "pr") | .key]' "$BENCH_KINDS" 2>/dev/null) || prkinds=null
  since=$(date -u -d "@$(( $(now) - days * 86400 ))" +%F)
  tasks=$(canary_tasks) || return 2
  # A task's kind and scope, as an item's, are its row's type and area: one `notes row parse` of each first line.
  if [ -n "$tasks" ]; then
    parsed=$(jq -r '.task | split("\n")[0]' <<<"$tasks" | notes row parse) &&
      tasks=$(jq -cn --rawfile p <(printf '%s\n' "$parsed") --rawfile t <(printf '%s\n' "$tasks") '
        ($t | split("\n") | map(select(length > 0) | fromjson)) as $t | ($p | split("\n") | map(select(length > 0) | split("\t"))) as $p
        | if ($p | length) != ($t | length) then error("short") else range($t | length) as $i
          | $t[$i] + if $p[$i][3] == "1" then {type: $p[$i][0], area: ($p[$i][1] | if . == "-" then null else . end)} else {} end end') ||
      { say "canary matrix: notes row parse failed or answered short (an old notes? notes-bootstrap --build-only)"; return 1; }
  fi
  items=$(bench_read $BENCH_DONE_ITEMS_CMD --since "$since" 2>/dev/null | jq -c 'if type == "array" then .[] else . end') ||
    { say "canary matrix: the done items could not be read"; return 1; }
  forgejo=$(jq -r --slurpfile is <(printf '%s\n' "$items") '($is | map(.project) | unique) as $ps
              | .paths // {} | to_entries[] | select(.value as $p | $ps | index($p)) | "\(.key)\t\(.value)"' "$BENCH_PROJECT_MAP" 2>/dev/null |
            while IFS=$'\t' read -r dir p; do forge_canonical "$dir" && printf '%s\n' "$p"; done | jq -Rsc 'split("\n") | map(select(. != "")) | unique')
  jq -n --arg h "$h" --arg since "$since" --slurpfile m "$BENCH_MATRIX" --slurpfile k "$(kpi_canary)" --argjson forgejo "$forgejo" \
    --argjson hd "$hd" --argjson xstacks "$xstacks" --argjson prkinds "$prkinds" \
    --slurpfile o <(outcomes_newest | jq -c --arg since "$since" 'select((.updated // "") >= $since)') \
    --slurpfile items <(printf '%s\n' "$items") \
    --rawfile tsr <(printf '%s' "$tasks") \
    "$JQ_LIB"'($tsr | split("\n") | map(select(length > 0) | fromjson)) as $ts | $m[0] as $m | '"$MATRIX_JQ" |
    if [ -n "$json" ]; then cat; else canary_matrix_text; fi
}

# canary_matrix_section: the codex task matrix, in the scorecard
canary_matrix_section() {
  local j
  echo "## Task matrix"
  echo
  echo "Codex on every kind by stack, then each run mode (\`fleet-bench canary matrix\`, from \`~/.config/fleet-bench/matrix.json\`, a private file for its project names). P proven, F failing, X excluded, - no work on any harness in 30 days, . empty; n/m is passes of runs, from canary scores and Codex items."
  echo
  j=$(canary_matrix --json 2>/dev/null) || { echo "- task matrix: ? (matrix, scores or items unreadable)"; return 0; }
  jq -r "$MATRIX_FMT_JQ"'.cells as $cs | .stacks as $st
    | "| Kind | \($st | join(" | ")) |", "|---\($st | map("|---") | join(""))|",
      (.kinds[] as $k | "| \($k) | \([$cs[] | select(.kind == $k) | mark] | join(" | ")) |"),
      "", "| Mode | Status | Pass | Fail | Newest |", "|---|---|---|---|---|",
      (.modes[] | "| \(.mode) | \(.status) | \(.pass) | \(.fail) | \(.evidence // .why // "-") |"),
      "", "Excluded: \([.excluded[] | "\(.kind // .mode // .stack) (\(.why))"] | join("; ")). Empty cells: \(empties)."' <<<"$j"
}

# canary_matrix_text: the matrix json as a grid (P proven, F failing, X excluded, - no work, . empty)
# with the modes and the exclusions beneath; the scorecard prints the same in markdown
canary_matrix_text() {
  jq -r "$MATRIX_FMT_JQ"'.cells as $cs
    | "\(.harness) since \(.since): P proven, F failing, X excluded, - no work, . empty; n/m is passes of runs",
      (["kind"] + .stacks | join("\t")),
      (.kinds[] as $k | [$k] + [$cs[] | select(.kind == $k) | mark] | join("\t")),
      "",
      (.modes[] | "mode \(.mode)\t\(.status)\t\(.pass) pass \(.fail) fail\(if .evidence then "\t\(.evidence)" else "" end)\(if .why then "\t\(.why)" else "" end)"),
      (.excluded[] | "excluded \(.kind // .mode // .stack)\t\(.why)"),
      "empty: \(empties)"'
}

# canary_dream [--days N] [--json] -> one row per model dream's sweeps ran on over the last N days
# (default 14), from agentctl-dream's trial.tsv (date, project, model, session, cost, verdict,
# lessons added, memory refused): sweeps, cost and lessons added per sweep, the share with a memory
# refused, the share FAILED or STALLED. No file yet is an empty answer, so the writer can land later.
canary_dream() {
  local days=14 json="" since
  while [ $# -gt 0 ]; do
    case "$1" in
      --days) days="${2:-}"; [[ "$days" =~ ^[1-9][0-9]*$ ]] || { say "canary dream: --days takes a whole number"; return 2; }; shift 2 ;;
      --json) json=1; shift ;;
      *) say "usage: fleet-bench canary dream [--days N] [--json]"; return 2 ;;
    esac
  done
  [ -r "$DREAM_TRIAL" ] || { say "canary dream: no sweeps recorded yet ($DREAM_TRIAL)"; return 0; }
  since="$(date -u -d "@$(( $(now) - days * 86400 ))" +%F)"
  jq -Rnc --arg since "$since" "$JQ_LIB"'
    [inputs | split("\t") | select(length >= 8 and .[0] >= $since)
     | {model: .[2], cost: ((.[4] | tonumber?) // null), verdict: .[5],
        lessons: ((.[6] | tonumber?) // 0), refused: ((.[7] | tonumber?) // 0)}]
    | group_by(.model) | map(
        (map(.cost | select(. != null))) as $c
        | {model: .[0].model, sweeps: length, costed: ($c | length), cost_per_sweep: ratio($c | add // 0; $c | length),
           lessons_per_sweep: ratio(map(.lessons) | add; length),
           refused_share: ratio(map(select(.refused > 0)) | length; length),
           stalled_share: ratio(map(select(.verdict == "FAILED" or .verdict == "STALLED")) | length; length)}) | .[]' "$DREAM_TRIAL" |
    if [ -n "$json" ]; then cat; else
      jq -r '"\(.model)\t\(.sweeps) sweeps\t$\(.cost_per_sweep // "-")/sweep over \(.costed)\tlessons/sweep \(.lessons_per_sweep // "-")\trefused \(.refused_share // "-")\tfailed or stalled \(.stalled_share // "-")"'
    fi
}

# canary_shepherd [--days N] [--json] -> one row per model the shepherd's passes ran on over the
# last N days (default 7), from the lane columns fleet-shepherd's lane_cols appends to passes.tsv
# (model, nudges, survived, missed, wrong parks, parks; read by position here): passes,
# NOOP share, the nudges they made and the share that moved their session (no escalation due by
# the next run), lines left unhandled per pass, and parks made on a clear machine of all parks.
# Rows from before the lane columns, or with model `-` (launched by the old code), are left out.
# Every lane is cut to the span all of them ran in (latest first row to earliest last row, printed as
# from/to on each row), since a lane switched off mid-window would otherwise be scored against hours
# it never ran; lanes that never ran together are refused. Promote the canary model only on equal scores.
canary_shepherd() {
  local days=7 json="" since
  while [ $# -gt 0 ]; do
    case "$1" in
      --days) days="${2:-}"; [[ "$days" =~ ^[1-9][0-9]*$ ]] || { say "canary shepherd: --days takes a whole number"; return 2; }; shift 2 ;;
      --json) json=1; shift ;;
      *) say "usage: fleet-bench canary shepherd [--days N] [--json]"; return 2 ;;
    esac
  done
  [ -r "$SHEPHERD_PASSES" ] || { say "canary shepherd: no $SHEPHERD_PASSES"; return 1; }
  since="$(date -u -d "@$(( $(now) - days * 86400 ))" '+%F %H:%M')"
  jq -Rnc --arg since "$since" --arg days "$days" "$JQ_LIB"'
    [inputs | split("\t") | select(length >= 10 and .[0] >= $since and .[4] != "" and .[4] != "-")
     | {verdict: .[2], model: .[4], nudges: (.[5] | tonumber), survived: (.[6] | tonumber),
        missed: (.[7] | tonumber), wrong: (.[8] | tonumber), parks: (.[9] | tonumber), at: .[0]}]
    | group_by(.model) as $lanes
    | ($lanes | map(map(.at) | min) | max) as $from | ($lanes | map(map(.at) | max) | min) as $to
    | if $from > $to then "fleet-bench: canary shepherd: the lanes share no span (\($lanes | map("\(.[0].model) \(map(.at) | min) to \(map(.at) | max)") | join(", "))): they never ran together in these \($days) days\n" | halt_error(1) else . end
    | $lanes | map(map(select(.at >= $from and .at <= $to))) | map(
        (map(.nudges) | add) as $n | (map(.parks) | add) as $p
        | {model: .[0].model, from: $from, to: $to, passes: length, noop_share: ratio(map(select(.verdict == "NOOP")) | length; length),
           nudges: $n, progress_share: ratio($n - (map(.survived) | add); $n),
           missed_per_pass: ratio(map(.missed) | add; length), wrong_parks: (map(.wrong) | add), parks: $p}) | .[]' "$SHEPHERD_PASSES" |
    if [ -n "$json" ]; then cat; else
      jq -r '"\(.model)\t\(.passes) passes\tnoop \(.noop_share // "-")\t\(.nudges) nudges\tprogress \(.progress_share // "-")\tmissed/pass \(.missed_per_pass // "-")\twrong parks \(.wrong_parks)/\(.parks)\t\(.from) to \(.to)"'
    fi
}

cmd_canary() {
  case "${1:-}" in
    list) shift; canary_list "$@" ;;
    shepherd) shift; canary_shepherd "$@" ;;
    dream) shift; canary_dream "$@" ;;
    verify) shift; canary_verify "$@" ;;
    queue) shift; canary_queue "$@" ;;
    retire) shift; canary_retire "$@" ;;
    start) shift; canary_start "$@" ;;
    score) shift; canary_score "$@" ;;
    matrix) shift; canary_matrix "$@" ;;
    *) say "usage: fleet-bench canary list [--by harness,model[,pts]] [--json] | verify [id...] | queue [--harness h [--model m [--effort e]]] [--max N] [--task id[,id]] [--pts n[,n]] | retire | start <id> | score <id> [--end <reason>] | matrix [--harness h] [--days N] [--json] | shepherd [--days N] [--json] | dream [--days N] [--json]"; return 2 ;;
  esac
}

# usage: the verb list at the top of this file, through the line before its State note
usage() { awk 'NR > 1 { if (/^# State is/) exit; print }' "$0"; }

# epic_projects [project] -> one JSON line per project with its roadmap: {name, profile, dir, rm,
# ideas, briefs}, only the named one when given. A project whose roadmap cannot be read is left out
# and named on stderr.
epic_projects() {
  local stats name profile dir ideas briefs
  stats=$(bench_read $BENCH_PROJECTS_CMD 2>/dev/null | jq -ce --arg p "${1:-}" 'arrays | if $p == "" then . else map(select(.name == $p)) end') || return 1
  while IFS=$'\t' read -r name profile dir; do
    ideas=$(grep -c '^- \[ \]' "$dir/ideas.md" 2>/dev/null) || ideas=0
    briefs=$(for f in "$dir"/docs/briefs/*.md; do
        [ -f "$f" ] && jq -cn --arg f "$f" --arg e "$(brief_epic "$f")" '{file: $f, epic: $e}'
      done | jq -cs .)
    # the roadmap goes in on stdin: a big project's is past the length of one argument
    $BENCH_ROADMAP_CMD "$name" --json 2>/dev/null \
      | jq -ce --arg n "$name" --arg p "$profile" --arg d "$dir" --argjson i "$ideas" --argjson b "$briefs" \
          'arrays | {name: $n, profile: $p, dir: $d, rm: ., ideas: $i, briefs: $b}' \
      || say "epics: no roadmap for $name"
  done < <(jq -r '.[] | [.name, .profile // "", .dir // ""] | @tsv' <<<"$stats")
}

# epic_scores -> every epic score, oldest first (each project's outcomes/<p>/epics/scores.jsonl)
epic_scores() {
  local f
  for f in "$BENCH_OUTCOMES_DIR"/*/epics/scores.jsonl; do [ -s "$f" ] && cat "$f"; done
}

# epics_read_projects [project] -> epic_projects as one JSON array, nothing when the stats could not be read
epics_read_projects() { local out; out=$(epic_projects "${1:-}" | jq -cs .) && printf '%s\n' "$out"; }

# epics_read_items -> every queue item, done included, as one JSON array; nothing when the queue could not be read
epics_read_items() { local out; out=$(bench_read $BENCH_ALL_ITEMS_CMD 2>/dev/null | jq -cs .) && printf '%s\n' "$out"; }

# epics_read_forecast <now> -> the forecast's .items over the open queue items (an unread queue counts as
# none); null with no samples or when the forecast fails
epics_read_forecast() {
  local fc=null
  if [ -s "$PROGRESS" ]; then
    fc=$(forecast_json "$1" "" "$(bench_read $BENCH_ALL_ITEMS_CMD 2>/dev/null | jq -c 'select(.state != "done")')" items | jq -c '.items') || fc=null
  fi
  printf '%s\n' "${fc:-null}"
}

# epics_json <now> [project] -> one object: per project (only the named one when given) its flow counts, unlinked lists, ETA accuracy and
# epics; per epic its brief, plans and phases, leaf rows, items, PRs, the derived step, an ETA
# for open work, the newest frozen baseline, on track or behind, and its score once landed.
# An open leaf whose item is on the forecast takes that item's end; the rest (the open leaves
# with no scheduled item, or the plan phases no active item carries, whichever is more) run one
# after another, after the agent queue drains, at the repo's calibrated phase pace.
# The reads are side by side (par_go), one bench_read each, so the forecast's live rows and slots
# start with the roadmaps and the plans, not after them: one project's epics took 16s in a row,
# every Prefix+p preview move (ar-1140).
epics_json() {
  [ -n "${BENCH_READ_CACHE:-}" ] || { with_reads epics_json "$@"; return; }
  local t="$1" PAR PAR_PIDS pj items plans fc map=/dev/null
  par_open || return 1
  par_go pj epics_read_projects "${2:-}"
  par_go plans epic_plans
  par_go items epics_read_items
  # warms the forecast's two cached reads; without flock bench_read caches nothing, so it would run them twice
  if command -v flock >/dev/null; then
    par_go live bench_read latest_live
    par_go slots queue_slots
  fi
  par_go fc epics_read_forecast "$t"
  par_wait
  pj=$(<"$PAR/pj")
  [ -n "$pj" ] || return 1
  if [ "$pj" = "[]" ]; then
    if [ -n "${2:-}" ]; then say "epics: no project $2: not listed, or its roadmap could not be read"
    else say "epics: no project could be read"; fi
    return 1
  fi
  items=$(<"$PAR/items")
  [ -n "$items" ] || { say "epics: the agent queue could not be read"; items='[]'; }
  plans=$(jq -cs . "$PAR/plans")
  fc=$(<"$PAR/fc")
  [ -r "$BENCH_PROJECT_MAP" ] && map=$BENCH_PROJECT_MAP
  # the big inputs go in as files: the projects alone are past the length of one argument
  jq -cn --argjson t "$t" --slurpfile pj <(printf '%s\n' "$pj") --slurpfile items <(printf '%s\n' "$items") \
     --slurpfile plans <(printf '%s\n' "$plans") \
     --slurpfile fc <(printf '%s\n' "${fc:-null}") --slurpfile map "$map" --slurpfile base <(cat "$EPIC_BASELINES" 2>/dev/null) \
     --slurpfile sc <(epic_scores) "${CAL_ARGS[@]}" "$JQ_LIB$PLAN_ITEMS_JQ"'
    ($map[0] // {}) as $map | $pj[0] as $pj | $items[0] as $items | $plans[0] as $plans
    | $fc[0] as $fc
    | ($base | group_by([.project, .epic]) | map({key: "\(.[0].project)/\(.[0].epic)",
        value: (sort_by(.made_epoch) | last + {n: length})}) | from_entries) as $B
    | ($sc | map({key: "\(.project)/\(.epic)", value: .}) | from_entries) as $S
    | ($sc | accuracy($minn; $lo; $hi) | INDEX(.basis)) as $acc
    | ($items | map(select((.row // "") | test(":"))) | group_by(.row) | map({key: .[0].row, value: .}) | from_entries) as $byrow
    | ($items | map(select(.state != "done"))) as $act
    | {made_epoch: $t, made_at: ($t | iso),
       projects: [$pj[] | . as $P
      | ([$P.rm[].epics[]] | unique_by(.id) | map(. + {state: "open"})) as $open
      | ([$P.rm[].closed_epics[]] | unique_by(.id) | map(. + {state: "closed"})) as $closed
      | ([$P.rm[].rows[]] | unique_by(.id)) as $rows
      | (($open + $closed) | map(.id)) as $E
      | ($rows | INDEX(.id)) as $R
      # a leaf climbs its #of/ links to the epic above it, three levels at most (story, subtask)
      | def up($id; $n): ($R[$id].parent // "") as $p
          | if $p == "" then null elif ($E | index($p)) != null then $p elif $n > 0 then up($p; $n - 1) else null end;
      ($rows | map(. + {epic: up(.id; 2)})) as $lv
      | (($map.trackers // {})[$P.name].repo // $P.name) as $repo
      | (if $fc == null then null else ($fc.pace.repos[$repo] // $fc.pace.fleet) end) as $pace
      | [($open + $closed)[] | . as $e | "\($P.name)/\($e.id)" as $k
        | ($lv | map(select(.epic == $e.id))) as $er
        | ($er | map(. as $r | $byrow["\($P.name):\($r.id)"] // [] | .[]
                     | {slug, state, pr: (.pr // null), row: $r.id})) as $ei
        | ($plans | map(select(.epic == $e.id)) | map(. as $pl
            | ($act | map(select(names_plan($pl.file))) | length) as $na
            | {file, done: (.phases | map(select(.state != "open")) | length), total: (.phases | length),
               open: (.phases | map(select(.state == "open") | .name)), queued: $na})) as $ep
        | ($P.briefs | map(select(.epic == $e.id)) | first | .file // null) as $brief
        | ($e.state == "closed" or ($e | leaves_landed)) as $over
        | (if $e.state == "closed" and $e.verified then "verified" elif $over then "landed"
           elif ($er | length) > 0 then "rows" elif ($ep | length) > 0 then "plan" elif $brief != null then "brief" else "epic" end) as $step
        | (if $over then {eta: null, why: null}
           else ($er | map(select(.state != "done")) | map(. as $r
                   | ($byrow["\($P.name):\($r.id)"] // [] | map(select(.state != "done") | ($fc.ends // {})[.slug] // empty) | first))) as $ends
             | ($ends | map(select(. != null))) as $sch
             # the phases of a backfilled plan are the stories of its epic, so the two are the same work:
             # the larger count is the tail, never their sum
             | ([($ends | map(select(. == null)) | length), ($ep | map([(.open | length) - .queued, 0] | max) | add // 0)] | max) as $tail
             | if ($sch | length) == 0 and $tail == 0 then {eta: null, why: "no rows or plan phases filed"}
               elif $tail > 0 and $pace == null then {eta: null, why: "no phase pace measured yet"}
               else (if $tail == 0 then "queue" elif ($sch | length) == 0 then "pace(\($pace.basis))" else "queue+pace(\($pace.basis))" end) as $basis
                 | ([$sch[].p50] + (if $tail > 0 then [([$t, $fc.finish_p50 // $t] | max) + $tail * $pace.P] else [] end) | max | floor) as $p50
                 | ([$sch[].slow] + (if $tail > 0 then [([$t, $fc.finish_slow // $t] | max) + $tail * $pace.S] else [] end) | max | floor) as $slow
                 | ($acc[$basis | kind].factor) as $f
                 | {eta: {p50: $p50, slow: ([$slow, $p50] | max), basis: $basis, scheduled: ($sch | length), unscheduled: $tail,
                          factor: $f, cal_p50: (if $f == null then null else ($t + ($p50 - $t) * $f | floor) end)}, why: null}
               end end) as $x
        | $B[$k] as $b
        | {id: $e.id, title: $e.title, system: ($e.system // ""), version: $e.version, state: $e.state, verified: $e.verified, proof: $e.proof,
           open: $e.open, done: $e.done, open_weight: $e.open_weight, done_weight: $e.done_weight,
           progress: ratio($e.done_weight; $e.open_weight + $e.done_weight), step: $step, brief: $brief, plans: $ep,
           rows: ($er | map({id, kind, title, size, state, prs})), items: $ei,
           prs: ([$er[].prs[]?, ($ei[].pr | select(. != null) | tostring | split(" ")[])] | unique),
           eta: $x.eta, no_eta: $x.why,
           baseline: (if $b == null then null else $b | {made_epoch, reason, total, total_weight, p50, slow, basis, n} end),
           track: (if $b == null or $x.eta == null then null
                   elif $t > $b.p50 or $x.eta.p50 > $b.slow then "behind" else "on track" end),
           score: $S[$k]}] as $eps
      | ($sc | map(select(.project == $P.name and .ratio != null))) as $ps
      | {project: $P.name, profile: $P.profile, repo: $repo, pace: $pace,
         flow: {ideas: ($P.ideas + ($rows | map(select(.kind == "decide" and .state != "done")) | length)),
                briefs: ($P.briefs | length), plans: ($eps | map(.plans | length) | add // 0), epics: ($eps | length),
                rows: ($lv | map(select(.epic != null)) | length),
                landed: ($eps | map(select(.step == "landed")) | length), verified: ($eps | map(select(.step == "verified")) | length)},
         unlinked: {rows: ($lv | map(select(.epic == null and .state != "done") | .id)),
                    plans: ($act | map(select(.project == $P.name and (.plan // "") != "") | . as $i
                                        | select(all($plans[]; . as $pl | $i | names_plan($pl.file) | not)) | .plan) | unique)},
         accuracy: {scored: ($ps | length), median_ratio: ($ps | map(.ratio) | median),
                    on_time: ($ps | map(select(.verdict == "ahead")) | length), within_slow: ($ps | map(select(.within_slow)) | length)},
         epics: $eps}]}'
}

# epic_freeze <epics json> <now> -> a baseline line for each open epic with an ETA that has none
# yet (first seen: an epic is filed only on a human yes) or whose total moved since its newest
# (scope: a story added or dropped, or resized)
epic_freeze() {
  jq -c --argjson t "$2" '.projects[] | .project as $p | .epics[]
    | select(.eta != null and (.baseline == null or .baseline.total != (.open + .done)
                               or .baseline.total_weight != (.open_weight + .done_weight)))
    | {project: $p, epic: .id, title, made_epoch: $t, reason: (if .baseline == null then "first seen" else "scope" end),
       total: (.open + .done), total_weight: (.open_weight + .done_weight), done_weight,
       p50: .eta.p50, slow: .eta.slow, cal_p50: .eta.cal_p50, basis: .eta.basis}' <<<"$1"
}

# epic_score <epics json> <now> -> a score for each epic whose newest baseline has none and
# whose leaves have all landed (or that closed): actual against frozen, raw, as vs scores a
# forecast. Landing is seen by the sample, so it is as exact as the sample cadence.
epic_score() {
  jq -c --argjson t "$2" "$JQ_LIB"'.projects[] | .project as $p | .epics[]
    | select(.baseline != null and (.step == "landed" or .step == "verified")
             and (.score == null or .score.made_epoch != .baseline.made_epoch))
    | .baseline as $b
    | {project: $p, epic: .id, title, made_epoch: $b.made_epoch, reason: $b.reason, baselines: $b.n, basis: $b.basis,
       landed_epoch: $t, pred_p50: $b.p50, pred_slow: $b.slow,
       ratio: (if $b.p50 > $b.made_epoch then (($t - $b.made_epoch) / ($b.p50 - $b.made_epoch) | round2) else null end),
       error_min: (($t - $b.p50) / 60 | floor), within_slow: ($t <= $b.slow),
       verdict: (if $t <= $b.p50 then "ahead" else "behind" end), prs: .prs}' <<<"$1"
}

# epics_sample <now>: freeze the baselines and write the scores this sample owes, and say how
# many. Each score goes to its project's outcomes/<p>/epics/scores.jsonl.
epics_sample() {
  local t="$1" ej fr sc p
  ej=$(epics_json "$t") || return 1
  fr=$(epic_freeze "$ej" "$t") || return 1
  sc=$(epic_score "$ej" "$t") || return 1
  [ -n "$fr" ] && printf '%s\n' "$fr" >> "$EPIC_BASELINES"
  if [ -n "$sc" ]; then
    for p in $(jq -r .project <<<"$sc" | sort -u); do
      mkdir -p "$BENCH_OUTCOMES_DIR/$p/epics"
      jq -c --arg p "$p" 'select(.project == $p)' <<<"$sc" >> "$BENCH_OUTCOMES_DIR/$p/epics/scores.jsonl"
    done
  fi
  say "epics: $(grep -c . <<<"$fr") baselines frozen, $(grep -c . <<<"$sc") scored"
}

# cmd_epics [--json] [--project P]: each feature's chain and ETA, per project
cmd_epics() {
  local json=0 proj='' ej
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --project) proj="${2:-}"; [ -n "$proj" ] || { say "--project needs a name"; return 2; }; shift 2 ;;
      *) say "usage: fleet-bench epics [--json] [--project P]"; return 2 ;;
    esac
  done
  ej=$(epics_json "$(now)" "$proj") || return 1
  if [ "$json" = 1 ]; then printf '%s\n' "$ej"; return 0; fi
  jq -r "$JQ_LIB"'
    def cut($n): if length > $n then .[:$n - 3] + "..." else . end;
    def when: if .eta == null then "no ETA: \(.no_eta // "-")"
      else "ETA \(.eta.cal_p50 // .eta.p50 | hm) (slow \(.eta.slow | hm)) \(.eta.basis)\(if .eta.factor != null then " x\(.eta.factor)" else "" end)" end;
    .made_epoch as $t
    | (.projects | map(.epics[]) ) as $all
    | "epics \($t | hm): \($all | map(select(.state == "open" and .step != "landed")) | length) open, \($all | map(select(.step == "landed")) | length) landed, \($all | map(select(.step == "verified")) | length) verified, \($all | map(select(.score != null)) | length) scored",
      (.projects[] | select((.epics | length) > 0 or (.unlinked.plans | length) > 0)
       | "",
         "\(.project)  ideas \(.flow.ideas) | briefs \(.flow.briefs) | plans \(.flow.plans) | epics \(.flow.epics) | rows \(.flow.rows) | landed \(.flow.landed) | verified \(.flow.verified)"
           + (if .accuracy.scored > 0 then "  ETAs scored \(.accuracy.scored), median ratio \(.accuracy.median_ratio), \(.accuracy.on_time) on time" else "" end),
         (.epics | sort_by(.state != "open", .step == "landed", -(.eta.p50 // 0)) | .[]
          | "  \(.id)  \(.title | cut(48))  [\(.step)]  \(.done)/\(.open + .done)"
            + (if .state == "open" and .step != "landed" then "  \(when)\(if .track != null then ", \(.track)" else "" end)"
               elif .score != null then "  landed \(.score.landed_epoch | hm), ratio \(.score.ratio // "-"), \(.score.verdict)" else "" end)),
         (if (.unlinked.rows | length) > 0 then "  \(.unlinked.rows | length) open rows with no epic" else empty end),
         (if (.unlinked.plans | length) > 0 then "  plans with no epic: " + (.unlinked.plans | map(split("/") | last) | join(", ")) else empty end))' <<<"$ej"
}

main() {
  case "${1:-}" in
    sample) cmd_sample ;;
    eta) shift; cmd_eta "$@" ;;
    report) cmd_report ;;
    accuracy) shift; cmd_accuracy "$@" ;;
    headline) cmd_headline ;;
    scorecard) cmd_scorecard ;;
    sessions) shift; cmd_sessions "$@" ;;
    stats) shift; cmd_stats "$@" ;;
    review) shift; cmd_review "$@" ;;
    sections) shift; cmd_sections "$@" ;;
    asks) shift; cmd_asks "$@" ;;
    ledger) shift; cmd_ledger "$@" ;;
    rules) shift; cmd_rules "$@" ;;
    kpi) shift; cmd_kpi "$@" ;;
    chain) shift; cmd_chain "$@" ;;
    prio-defaults) shift; cmd_prio_defaults "$@" ;;
    inflow) shift; cmd_inflow "$@" ;;
    churn) shift; cmd_churn "$@" ;;
    startup) shift; cmd_startup "$@" ;;
    pipeline) shift; cmd_pipeline "$@" ;;
    bottleneck) shift; cmd_bottleneck "$@" ;;
    prs) shift; cmd_prs "$@" ;;
    effect) shift; cmd_effect "$@" ;;
    improve) shift; cmd_improve "$@" ;;
    retro) cmd_retro ;;
    canary) shift; cmd_canary "$@" ;;
    room) intake_room ;;
    triage) shift; cmd_triage "$@" ;;
    health) shift; cmd_health "$@" ;;
    reds) shift; cmd_reds "$@" ;;
    findings) shift; cmd_findings "$@" ;;
    respond) shift; cmd_respond "$@" ;;
    loop) shift; cmd_loop "$@" ;;
    throughput) shift; cmd_throughput "$@" ;;
    flow) shift; cmd_flow "$@" ;;
    forecast) shift; cmd_forecast "$@" ;;
    epics) shift; cmd_epics "$@" ;;
    vs) shift; cmd_vs "$@" ;;
    queue) shift; cmd_queue "$@" ;;
    requests) shift; cmd_requests "$@" ;;
    models) shift; cmd_models "$@" ;;
    skills) shift; cmd_skills "$@" ;;
    sources) shift; cmd_sources "$@" ;;
    sizes) shift; cmd_sizes "$@" ;;
    -h | --help) usage ;;
    *) usage >&2; return 2 ;;
  esac
}

