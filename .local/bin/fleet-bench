#!/usr/bin/env bash
# fleet-bench - record where every live session is, predict when it finishes, and score
# the prediction once it does. Model-free; the shepherd only reads it.
#
#   fleet-bench sample           one sample: progress line per live session, a new ETA for
#                                any session whose phase moved, score any that finished,
#                                the window per project as fleet_bench.prom, and each project's
#                                state and open release window as fleet_projects.prom
#   fleet-bench eta [--json]     the latest ETA per live session
#   fleet-bench report           live table, ETA accuracy so far, when the sampler last ran
#   fleet-bench accuracy --json  per basis: how far its raw ETAs ran, and the factor new ones get
#   fleet-bench headline         the last 24h in one line (the popup and the morning briefing)
#   fleet-bench scorecard        write the last 24h to <date>.md and latest.md in BENCH_SCORECARD_DIR
#   fleet-bench sessions --json  the scorecard's session rows, one JSON object each (day-log reads them)
#   fleet-bench stats --json [--since E]
#                                each session's whole life since E: minutes per bucket, nudges,
#                                escalations, phases ticked, peak context, merged PRs, lines, CI
#                                runs and reds (session-outcomes joins it into its row)
#   fleet-bench review [--days N]
#                                count failed CI runs (any workflow) before merge on PRs merged in the
#                                window (24h, or back to the last pass, review.last, at most BENCH_REVIEW_MAX_DAYS), and
#                                on a repo with section roots each PR's sections and gate runs; --days sets the window and
#                                recounts rows that lack them
#   fleet-bench sections [--days N] [--json]
#                                per section of a repo: PRs, first-try share, gate reds and minutes,
#                                greens lost, and the claiming session's cost and tokens per PR
#   fleet-bench asks [--write]
#                                pending asks in hub Home's order (hub needs --json), the ones
#                                holding a live session listed first; --write also writes
#                                asks.md and prints one line (hub needs --page pages them)
#   fleet-bench ledger [--json|--check|--launches DIR...|--unlisted]
#                                runners, timers, direct headless launches, verdict words,
#                                asks, open board rows; --check fails when one may only shrink grew,
#                                or on --unlisted's lines: a launch file with no row in the PIPELINES.md
#                                launch table (LEDGER_PIPELINES), or a row whose file no longer launches
#   fleet-bench rules [--json|--check|--scenarios|--gates [BASE]|--changed SINCE|--new [--days N|--since T] [--until D] [--json|--line]]
#                                the rule register (RULES_REGISTER): kinds, confidence, actions, and each
#                                rule's number re-measured; --check fails when one moved against its
#                                recorded confidence, its measure died, or a rule's text left its source,
#                                a rule row has no enforced_by that resolves (test:, hook:, ci: or review), the review rows outgrow
#                                RULES_PROSE_BASELINE (or sit under it), a global-file row applies to fewer than 2 repos or names no `applies`, a repo
#                                row restates a global one (`layer`), or a lesson found twice names no enforced_by check;
#                                --scenarios lists the hard scenarios a context trim must keep, 1 when any is stale;
#                                --gates lists the gate markers (# gate: <id>) with no register row, a hook that denies with none, and a refusal
#                                a diff against BASE (default origin/main) added with none: 1 when any; --check fails a gate row with no valid
#                                asked_by, or an agent-asked routes: human row that no removal item covers;
#                                --changed lists every rule line a PR merged since SINCE (epoch or a date) added
#                                or removed, read from GitHub, one tab-separated line each (the briefing's list);
#                                --new lists the gate rows whose `added` date is in the window (default the last 7 days),
#                                agent-added first: added, id, asked_by, repo #PR, rule; --line is the one sentence the
#                                briefing and day-log print ("N gates added since D, K by an agent without your ask"), none when no gate
#   fleet-bench kpi [--json] [--vitals | --at T | --trend DAYS | --check [ERE]]
#                                KPIs over 7d and 28d of human sessions (the token ones from the
#                                nightly token-usage snapshots, sandboxed_lane_pct from BENCH_CALLS, pool_busy_share from Prometheus,
#                                the churn_* rows from the notes ingest record and the dotfiles merge log),
#                                against KPI_THRESHOLDS;
#                                --vitals the BENCH_VITALS rows, the front page every view reads,
#                                --at as of a past time, --trend one row a day of the 7d values,
#                                --check exits 1 past a threshold, on the KPIs whose name matches ERE
#   fleet-bench chain [--json|--check] [--kpi <key>]
#                                the work-chain KPIs counted now (also in kpi); --check exits 1 past a threshold,
#                                2 with an unreadable: line for a KPI it could not count;
#                                --kpi one key, from a count up to CHAIN_SNAPSHOT_MAX_S old (its chain-<key> watch)
#   fleet-bench prio-defaults [--json]
#                                the open rows that rank by default (no priority tag or no #why/<reason>) by the filer
#                                that wrote them, most first, with sample ids: the rows behind the prio_default KPI
#   fleet-bench inflow [--project P] [--days N] [--json]
#                                every open agent-lane row of a project (default agent-runtime) attributed to its source (the ingest
#                                origin, else the #from/ a triage carried in, else self-check, else the writer; below the first logged
#                                id "pre-log"), with each source's arrivals per day over N days (INFLOW_DAYS, 14), how they ended
#                                (closed by PR, done with no PR, dropped, dup, still open) and the age of its open rows; --json lists each source's open_ids
#   fleet-bench churn [--days N] [--json|--check]
#                                agent-runtime's churn a local day (N, default 7, complete days and today so far): dotfiles merges, rows
#                                filed, closed, dropped, reopened and filed straight by a session; the rows behind the churn_* KPIs.
#                                --check exits 1 when filed exceeded closed on each of the last CHURN_RUN_DAYS complete days (the
#                                runtime-churn watch's probe)
#   fleet-bench startup [--json|--check]
#                                Claude Code start times (CLAUDE_STARTUP_LOG): medians over the last
#                                startup_rolling_n starts; --check exits 1 past startup_ready_ms_p50_max,
#                                2 with no SessionStart row in startup_stale_h or a start with no ready
#                                time (the claude-startup watch)
#   fleet-bench bottleneck [--json | --check [stalled|pools]]
#                                the scorecard's Bottlenecks table on its own, or its rows as JSON;
#                                --check with no name runs both, one line each, the worse exit code;
#                                --check pools (the pool-wait watch) exits 1 when any pool's waited job-hours
#                                over the window pass pool_wait_hours_max, naming each pool, 2 on no bound or
#                                no pool series;
#                                --check stalled exits 1 when the Sessions stalled hours over the window
#                                pass stalled_session_hours_max (a session the human holds open is HELD,
#                                not stalled), naming the top three, 2 on a stale sampler or no bound
#                                (the fleet-bottleneck watch)
#   fleet-bench pipeline [--json | --check cap|age|mix|held|owner|chain-lag]
#                                where every item sits, inbox to done: WIP and age per step, in and out,
#                                dwell, the bottleneck step and the record's drift from the queue folders,
#                                the admission cap and each class of service against its share;
#                                --check exits 1 on runnable over the cap, queued age p90 past its
#                                bound, a starved class while the mix is on, an item no session owns or an urgent or
#                                high chain whose handoff p90 over 24h (agent-queue stats chain.h24, ready to
#                                started) is past chain_handoff_p90_max, 2 when its source cannot be read (one
#                                Sentinel watch each)
#   fleet-bench prs [--json | --check stranded|blocked|aged|branches]
#                                the fleet's open PRs (one gh GraphQL search, plus every open PR of the
#                                Forgejo repos in the PR store) joined to the queue items that own them,
#                                idle counted from the last commit: stranded (no running, waiting or
#                                queued item, idle past pr_idle_h_max), blocked (red, conflicting or
#                                pending checks, idle past pr_blocked_h_max) and aged (a draft, or one
#                                opened before pr_window_d, that no live item works), then the pushed
#                                branches no PR owns, salvage/* included (land, open a PR or delete);
#                                --check exits 1 on any in that class, 2 unreadable (stranded and
#                                blocked are the pr-stranded and pr-blocked watches)
#   fleet-bench effect <T | owner/repo#N> [--days N] [--compare C] [--json]
#                                each windowed KPI over N days before a change landed against N after,
#                                beside the same split at C (default N days earlier) as a control
#   fleet-bench improve [--json] | file <kpi> <text> | claim <kpi> <ar-N|item:slug> | list [--json]
#                                the KPI furthest past its threshold that no live claim owns (exit 1
#                                when none, or BENCH_IMPROVE_MAX are live); file adds its row with a
#                                check and claims it, claim records a row or item that owns it (a
#                                row may claim each KPI its lever moves; the cap holds pick and file)
#   fleet-bench retro            a verdict on each claim whose PR landed BENCH_EFFECT_DAYS ago (a
#                                regression files a revert row), and one agent-board row per lesson
#                                that recurred in BENCH_GUARD_RECUR sessions or that dream found
#                                again in BENCH_GUARD_SEEN sweeps (a guard row), and
#                                retires earlier weeks' queued canaries and queues the week's canary run: the claude lane, then each lane in
#                                BENCH_CANARY_LANES whose source has room
#   fleet-bench canary list [--by harness,model[,pts]] [--json] | verify [id...] | queue [--harness h [--model m [--effort e]] [--task id[,id]] [--pts n[,n]]]
#                                | retire | start <id> | score <id> | matrix [--harness h] [--days N] [--json]
#                                | shepherd [--days N] [--json] | dream [--days N] [--json]
#                                the fixed eval set: tasks from merged PRs, the pre-merge commit and
#                                the PR's own tests as the oracle. queue adds one canary item per task
#                                a week (retro runs it), retire cancels an earlier week's queued ones, start puts the session's worktree at the
#                                task's base, score lays the oracle over it, records pass or fail once
#                                per run and puts the tree back where start found it, clean (its diff kept as <run>.patch); verify proves each oracle fails at base, passes at merge;
#                                shepherd compares the shepherd's pass lanes (its CANARY_MODEL) by model, over the span every lane ran;
#                                list --by sets each lane beside the claude lane on their shared tasks;
#                                matrix is BENCH_MATRIX's kind by stack grid and run modes for one
#                                harness: each cell proven, failing, excluded, no work, or empty
#   fleet-bench room             exit 1 while board_days is past board_days_max; information only,
#                                no filer holds on it
#   fleet-bench triage [--dry-run|--causes|--coverage|--route <key>...]
#                                one agent-board row per FAILED or STALLED scheduled runner, failed
#                                user unit, Sentinel watch tripped past TRIAGE_WATCH_AFTER, runner
#                                stderr error signature recurring in BENCH_GUARD_RECUR runs and
#                                cc:red_now item nothing here reads, plus one per red that started
#                                within HOLD_HOURS after a cleanup merge; TRIAGE_ROUTES decides where
#                                each one goes, and an agent route or any watch route but a human's
#                                queues a red fix. --route prints
#                                each key (watch X, runner X, unit X) with its route, skill and
#                                tags, filing nothing, and exits 2 when TRIAGE_ROUTES cannot be read; --causes prints, for each red it would queue, the
#                                tags it files the fix with and its key (fix-red step 5 tags a fix
#                                queued by hand with them); --coverage lists each standing watch,
#                                runner and the hold row no line resolves, each owned:<row> route
#                                whose row is not open, and each runner whose SKILL names nothing
#   fleet-bench health [--coverage]
#                                one row for each part of the fleet (the sections above the
#                                ARCHITECTURE Flows table and its rows): the Sentinel watches whose
#                                `flows:` names it and their state, then one verdict line. A part is
#                                TRIP or ERROR on its worst live watch, TRIP/Q when its worst is a
#                                red a live quarantine covers (a warning: the verdict reads GAPS),
#                                OK when each is, UNCOVERED
#                                when no watch probes it. Exit 1 on any TRIP or ERROR; --coverage
#                                prints only the UNCOVERED parts and any `flows:` name that is no
#                                part, and exits 1 on any
#   fleet-bench reds [--json] [--days N]
#                                each red fix queued in the last N days (REDS_DAYS) and what came
#                                of it: fixing, needs merge, fixed (merged, not red now), still red,
#                                came back (red again after the merge), alert route (red, but
#                                TRIAGE_ROUTES sends it to alert: its watch pages on a KPI no merge
#                                clears, so reds_unfixed leaves it out), cancelled (closed cancelled
#                                with no merge, as when handed to an owner), cleared (ok with no PR)
#                                or no fix (failed with no PR); and each
#                                merged cleanup item, its hold: holding (under HOLD_HOURS old), held,
#                                went red (a red now names it) or recovered (a red named it, now over)
#                                A cleanup hold it cannot read prints an unreadable: line first
#                                (on stderr with --json, which still exits 0)
#   fleet-bench findings [--open|--json|--run]
#                                conclusions that want a decision, from rules over counted facts
#                                on every machine; --run evaluates and appends (each sample does)
#   fleet-bench respond '<rule> <scope> @<episode>' <actor> <paged|asked|filed-row|cancelled|fixed> [ref]
#                                record what answered a finding (its fact), in responses.jsonl
#   fleet-bench loop [--json|--firing]
#                                each finding episode of the last 7d: minutes to its first response
#                                that is not a page, and DARK when it reached the human with only pages;
#                                --firing prints one sentence per dark episode still firing
#   fleet-bench throughput [--from T] [--to T]
#                                runs/h, failures, merges/h, pool wait and load on every host, and a
#                                `wait <pool>:` line for each exporter wait with no slots (unity-gate)
#   fleet-bench flow [--from T] [--to T] [--json] [--hourly]
#                                phases in (plans started, phases added) against phases ticked,
#                                open at each end, and whether the fleet is draining
#   fleet-bench forecast [--json] [--queue] [--baseline <label>]
#                                every open phase in expected order, all-done-by at the calibrated
#                                and the recent pace, the drain, and the agent queue's items on the
#                                dispatcher's slots; --baseline freezes it to compare
#   fleet-bench epics [--json] [--project P]
#                                each project's features from idea to verified: per epic its brief,
#                                plans, rows, items, PRs and step, an ETA for the open ones, frozen
#                                on first sight and on a scope change, and scored when it lands
#   fleet-bench vs [<label>|latest] [--json]
#                                a frozen forecast against what the fleet did since, per session
#   fleet-bench queue [--json]   the agent queue over BENCH_QUEUE_DAYS: done by outcome, PRs, per
#                                day, wait and time to PR, from `agent-queue stats`
#   fleet-bench models [--by class,lane] [--json] landed rate (real work only; canaries in their own column), redo rate, first-attempt approval, reverts, cost, CI reds, first-pass
#                                share and window points per PR by model over BENCH_QUEUE_DAYS: queue
#                                model= joined to outcomes, model-lane runs, pr-ci.jsonl and sources;
#                                --by class splits each pairing by the task class on its outcome rows,
#                                --by lane by the model-lane lane its run logged under, or both
#   fleet-bench skills [--days N] [--json]
#                                per skill, the queue items finished in the last N days (BENCH_QUEUE_DAYS)
#                                whose sessions ran it, and how they turned out: landed rate, held
#                                (landed, its PR not reverted), CI red per PR and first pass, landed
#                                after a fix-ci try, and reds held (fleet-bench reds), counts behind each
#   fleet-bench sources [--json] every claude-acct source over BENCH_QUEUE_DAYS: window points used,
#                                dollars, landed PRs, dollars and PRs per point, and the provider hold a source stands under
#                                beside its used percent (exit 1 unreadable)
#   fleet-bench sizes [--json|--check]
#                                work minutes per row size over BENCH_SIZES_DAYS against the weight
#                                the rollups use, and cycle and lead time per row kind; --check is the
#                                pts-bands watch's probe: exit 1 when, over BENCH_BANDS_DAYS of closes,
#                                the median l is not slower than m or m not slower than s
#   fleet-bench requests [--json] [--since T]
#                                the human's urgent requests, one row each (a plan chain is one row),
#                                then those finished since T: the head of every shepherd summary
# State is ~/.agent/bench/*.jsonl. Every number is counted, never a model's grade.
# Formulas, fields and outcomes: the fleet-bench skill.
# Seams: FLEET_BENCH_DIR, BENCH_NOW, BENCH_SESSIONS_CMD, BENCH_NEEDS_CMD, BENCH_LIB_DIR, BENCH_OUTCOMES_DIR,
# BENCH_CI_MATCH_CMD, BENCH_NOTES_CMD, BENCH_WAKES_CMD, BENCH_PROM_TSV, BENCH_MERGES_TSV, BENCH_RUNS_TSV, BENCH_PROJECT_MAP, BENCH_QUEUE_CMD,
# BENCH_ITEMS_CMD, BENCH_ADMISSION_CMD, BENCH_MIX_CMD, BENCH_CLASSES, BENCH_LESSONS_CMD, BENCH_DONE_ITEMS_CMD, BENCH_QUEUE_SLOTS, BENCH_DISPATCH_STATS_CMD, BENCH_FORECAST_HORIZON_H,
# BENCH_QUEUE_STATS_CMD, BENCH_QUEUE_DAYS, BENCH_TRAINEE_CMD, BENCH_LANE_LOG, BENCH_LANE_VOIDS, BENCH_SOURCES_CMD, BENCH_HOLDS_CMD, BENCH_HARNESSES, BENCH_ROOM_CMD, BENCH_CANARY_LANES, BENCH_CANARY_RETRIES, BENCH_BOARD_CMD, BENCH_PROJECTS_CMD, BENCH_HUB_PROJECTS_CMD, BENCH_ROADMAP_CMD, BENCH_ALL_ITEMS_CMD, PLAN_DIRS, BENCH_DOCS_CLEANUP_DIR, BENCH_SYSTEMS_CMD, BENCH_DOCTOR_LAST, CHAIN_DAYS,
# FLEET_STATE_FILE, FLEET_SHEPHERD_DIR, WORKTREE_GC_LOG, WORKTREE_GC_STALE_H, BENCH_FLEET_COST_CMD, BENCH_FLEET_COST_FILE, BENCH_FLEET_COST_EVERY_MIN, BENCH_FLEET_COST_TIMEOUT, BENCH_HUB_FIGURE_CMD, BENCH_BUDGET_CMD, BENCH_BUDGET_FILE,
#                                BENCH_BUDGET_EVERY_MIN, BENCH_BUDGET_TIMEOUT.

set -uo pipefail
# shellcheck source=../lib/end-reasons.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/end-reasons.sh"

# Each sample also publishes the window's numbers to Prometheus (fleet_bench.prom).
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/prom-textfile.sh"
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/prom.sh"
# shellcheck source=../lib/harness-projects.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/harness-projects.sh"   # harness_project_why: canary queue
# shellcheck source=../../.config/shared-hooks/project-name.sh
. "${PROJECT_NAME_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../../.config/shared-hooks/project-name.sh}"
# The forecast names each open phase from its plan with the one checklist parser.
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/plan-phases.sh"
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/main-state.sh"
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/test-pick.sh"
# shellcheck source=../lib/origin-repo.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/origin-repo.sh"   # forge_canonical, for the matrix
# shellcheck source=../lib/agent-merge-proof.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/agent-merge-proof.sh"   # merge_proof_ref, the branch merge_rows reads
# shellcheck source=../lib/board-keys.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/board-keys.sh"   # BOARD_KEY_ERE: the row keys triage_retire closes by
# shellcheck source=../lib/sentinel-watch.sh
. "${BENCH_LIB_DIR:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib}/sentinel-watch.sh" ||   # watch_severity, watch_is_stale: the rule every watch reader shares
  { echo "fleet-bench: cannot read sentinel-watch.sh" >&2; exit 1; }

: "${BENCH_DEFAULT_PHASE_MIN:=60}"   # before anything is measured: today's observed pace
: "${BENCH_CAL_MIN_N:=5}"            # scored ETAs a basis needs before its median ratio scales new ones
: "${BENCH_BASIS_MIN_N:=3}"          # measured phases a session or project needs before its median makes ETAs
: "${BENCH_CAL_MIN:=0.25}"           # clamp on that factor: a few odd runs cannot shrink an ETA to nothing
: "${BENCH_CAL_MAX:=4}"              # nor stretch it to days
: "${BENCH_SESSIONS_CMD:=fleet-sessions --write}" # also refreshes the fleet state document
: "${BENCH_CI_MATCH_CMD:=hub ci --pool-match}"   # given the wait (s) a job must have waited; hub_core::ci's pool match rows
: "${BENCH_NEEDS_CMD:=hub needs --json}"   # hub Home's ranked NEEDS YOU (hub_core::home::needs)
: "${BENCH_ASKS_ALL_CMD:=agent-ask list --all}"   # every ask, for the ask KPIs
: "${BENCH_WINDOW_H:=24}"            # what a scorecard and the headline cover, and review's first window
: "${BENCH_REVIEW_MAX_DAYS:=7}"      # review: how far back a held cursor reaches, so a PR that never counts drops out
: "${BENCH_GAP_CAP_MIN:=20}"         # two sampler cadences: a longer gap is a sampler outage, not time spent
: "${BENCH_SCORECARD_DIR:=$HOME/.notes/lab/projects/current/agent-runtime/docs/bench}"
: "${BENCH_OUTCOMES_DIR:=$HOME/.agent/outcomes}"
: "${BENCH_TIME_DAYS:=7}"
: "${BENCH_QUEUE_STATS_CMD:=agent-queue stats --json}"   # given --since <date>
: "${BENCH_QUEUE_DAYS:=7}"           # what the queue line and the scorecard's queue tables cover
: "${BENCH_KINDS:=${DISPATCH_KINDS:-$HOME/.config/fleet-dispatch/kinds.json}}"   # fleet-dispatch's kinds: canary matrix reads which kinds open a PR
: "${BENCH_TRAINEE_CMD:=timeout 120 fleet-dispatch trainee-pool --json}"   # the trainee pool and the floor's state, as dispatch reads them
: "${BENCH_SIZES_DAYS:=28}"          # the done items fleet-bench sizes calibrates on
: "${BENCH_SECTIONS_DAYS:=7}"        # the merged PRs fleet-bench sections covers
: "${BENCH_SECTIONS_TOP:=15}"        # sections the scorecard prints, by gate hours
: "${BENCH_SIZES_MIN:=10}"           # items with work_min a size needs before it is calibrated
: "${BENCH_BANDS_DAYS:=7}"           # the closes sizes --check orders the #pts bands over
: "${LEDGER_CONF_DIR:=$HOME/.config/agentctl/agents}"
: "${LEDGER_SRC:=$HOME/.dotfiles/.local:$HOME/.dotfiles/.config:$HOME/.dotfiles/.claude/skills:$HOME/.dotfiles-private/.local:$HOME/.dotfiles-private/.config:$HOME/.dotfiles-private/.claude/skills}"   # colon-separated
: "${LEDGER_BASELINE:=$HOME/.config/agentctl/ledger-baseline}"
: "${LEDGER_PIPELINES:=$HOME/.config/agentctl/PIPELINES.md}"   # its "Model calls outside agentctl-run" table: the files allowed to launch a model outside agentctl-run
: "${RULES_REGISTER:=$HOME/.config/agentctl/rules.jsonl}"
: "${RULES_PROSE_BASELINE:=$HOME/.config/agentctl/rules-prose-baseline}"   # review=N: the most rule rows that may name no check but review; lower it when rows gain one
: "${RULES_LESSON_SEEN:=2}"   # a lesson the dream sweep found again this many times must name its enforced_by (lessons seen)
: "${RULES_MEASURE_TIMEOUT:=20}"      # seconds one rule's measure may run
: "${RULES_GLOBAL_SOURCES:=~/.claude/CLAUDE.md:~/.dotfiles-private/.claude/CLAUDE.md}"   # the global rule files (colon list): a row sourced here must say where it applies (rules_states, `layer`)
# a transport failure on a stderr line naming github.com: GitHub did not answer a rule's measure (rules_states)
: "${RULES_UNANSWERED_RE:=HTTP 5[0-9][0-9]|connection (refused|reset)|i/o timeout|TLS handshake timeout|context deadline exceeded|unexpected EOF}"
# rules --changed: the files a session reads as rules (instruction-homes.json kinds global, repo, skill,
# role, shared-docs), as repo paths, and the generated copies of them that would list a change twice.
: "${RULES_CHANGED_ERE:=(^|/)(CLAUDE|AGENTS)\.md$|(^|/)SKILL\.md$|^\.claude/rules/|^\.config/rulesync-global/|^\.local/src/docs/|^\.config/agentctl/(roles|prompts)/|(^|/)docs/([^/]+/)*[^/]*standards\.md$}"
: "${RULES_CHANGED_SKIP_ERE:=^\.config/opencode/}"
# rules --gates: the code that holds a gate (a refusal, a deny, a block or a route to the human). Each
# one names its register row beside the refusal with `# gate: <id>`; `# gate: none` says an added
# refusal is a usage error, not a gate. GATE_ROOT is the repo they live in.
: "${GATE_ROOT:=$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../.." && pwd)}"
: "${GATE_TOOLS:=.local/bin/agent-ask .local/bin/agent-propose .local/bin/agent-queue .local/bin/agent-hold .local/bin/agent-land .local/bin/fleet-dispatch}"
