#!/usr/bin/env bash
# fleet-bench - record where every live session is, predict when it finishes, and score
# the prediction once it does. Model-free; the shepherd only reads it.
#
#   fleet-bench sample           one sample: progress line per live session, a new ETA for
#                                any session whose phase moved, score any that finished,
#                                and the window per project as fleet_bench.prom
#   fleet-bench eta [--json]     the latest ETA per live session
#   fleet-bench report           live table, ETA accuracy so far, when the sampler last ran
#   fleet-bench accuracy --json  per basis: how far its raw ETAs ran, and the factor new ones get
#   fleet-bench headline         the last 24h in one line (the popup and the morning briefing)
#   fleet-bench scorecard        write the last 24h to <date>.md and latest.md in BENCH_SCORECARD_DIR
#   fleet-bench sessions --json  the scorecard's session rows, one JSON object each (day-log reads them)
#   fleet-bench stats --json [--since E]
#                                each session's whole life since E: minutes per bucket, nudges,
#                                escalations, phases ticked, peak context, merged PRs, lines, CI
#                                runs and reds (session-outcomes joins it into its row)
#   fleet-bench review           count failed CI runs (any workflow) before merge on PRs merged in the window
#   fleet-bench asks [--write|--page]
#                                pending asks, the ones blocking a live session ranked first;
#                                --write also writes asks.md and prints one line, --page pages it
#   fleet-bench ledger [--json|--check|--launches DIR...]
#                                runners, timers, direct headless launches, verdict words,
#                                asks, open board rows; --check fails when one may only shrink grew
#   fleet-bench kpi [--json] [--at T | --trend DAYS]
#                                KPIs over 7d and 28d of human sessions, against KPI_THRESHOLDS;
#                                --at as of a past time, --trend one row a day of the 7d values
#   fleet-bench chain [--json|--check]
#                                the work-chain KPIs counted now (also in kpi); --check exits 1 past a threshold
#   fleet-bench effect <T | owner/repo#N> [--days N] [--json]
#                                each windowed KPI over N days before a change landed against N after
#   fleet-bench retro            one agent-board row per KPI whose 7d value is past its threshold,
#                                and per lesson that recurred in BENCH_GUARD_RECUR sessions (a guard row)
#   fleet-bench triage [--dry-run]
#                                one agent-board row per FAILED or STALLED scheduled runner, failed
#                                user unit, Sentinel watch tripped past TRIAGE_WATCH_AFTER and runner
#                                stderr error signature recurring in BENCH_GUARD_RECUR runs; a row a
#                                TRIAGE_CAUSES line explains is queued as a night fix
#   fleet-bench findings [--open|--json|--run]
#                                conclusions that want a decision, from rules over counted facts
#                                on every machine; --run evaluates and appends (each sample does)
#   fleet-bench respond '<rule> <scope> @<episode>' <actor> <paged|asked|filed-row|cancelled|fixed> [ref]
#                                record what answered a finding (its fact), in responses.jsonl
#   fleet-bench loop [--json|--firing]
#                                each finding episode of the last 7d: minutes to its first response
#                                that is not a page, and DARK when it reached the human with only pages;
#                                --firing prints one sentence per dark episode still firing
#   fleet-bench throughput [--from T] [--to T]
#                                runs/h, failures, merges/h, pool wait and load on every host
#   fleet-bench flow [--from T] [--to T] [--json] [--hourly]
#                                phases in (plans started, phases added) against phases ticked,
#                                open at each end, and whether the fleet is draining
#   fleet-bench forecast [--json] [--queue] [--baseline <label>]
#                                every open phase in expected order, all-done-by at the calibrated
#                                and the recent pace, the drain, and the agent queue's items on the
#                                dispatcher's slots; --baseline freezes it to compare
#   fleet-bench vs [<label>|latest] [--json]
#                                a frozen forecast against what the fleet did since, per session
#   fleet-bench queue [--json]   the agent queue over BENCH_QUEUE_DAYS: done by outcome, PRs, per
#                                day, wait and time to PR, from `agent-queue stats`
#   fleet-bench models [--json] landed rate, redo rate, reverts and cost per PR by model over
#                                BENCH_QUEUE_DAYS: queue model= joined to outcomes and model-lane runs
#   fleet-bench requests [--json] [--since T]
#                                the human's urgent requests, one row each (a plan chain is one row),
#                                then those finished since T: the head of every shepherd summary
# State is ~/.agent/bench/*.jsonl. Every number is counted, never a model's grade.
# Formulas, fields and outcomes: the fleet-bench skill.
# Seams: FLEET_BENCH_DIR, BENCH_NOW, BENCH_SESSIONS_CMD, BENCH_ASKS_CMD, BENCH_LIB_DIR, BENCH_OUTCOMES_DIR,
# BENCH_NOTES_CMD, BENCH_WAKES_CMD, BENCH_PROM_TSV, BENCH_MERGES_TSV, BENCH_RUNS_TSV, BENCH_PROJECT_MAP, BENCH_QUEUE_CMD,
# BENCH_ITEMS_CMD, BENCH_DONE_ITEMS_CMD, BENCH_QUEUE_SLOTS, BENCH_DISPATCH_CONF, BENCH_FORECAST_HORIZON_H,
# BENCH_QUEUE_STATS_CMD, BENCH_QUEUE_DAYS, BENCH_LANE_LOG, BENCH_BOARD_CMD, BENCH_PROJECTS_CMD, BENCH_DOCTOR_LAST, CHAIN_DAYS,
# FLEET_STATE_FILE, FLEET_SHEPHERD_DIR.

set -uo pipefail

# Each sample also publishes the window's numbers to Prometheus (fleet_bench.prom).
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/prom-textfile.sh"
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/prom.sh"
# The forecast names each open phase from its plan with the one checklist parser.
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/plan-phases.sh"

: "${BENCH_DEFAULT_PHASE_MIN:=60}"   # before anything is measured: today's observed pace
: "${BENCH_CAL_MIN_N:=5}"            # scored ETAs a basis needs before its median ratio scales new ones
: "${BENCH_BASIS_MIN_N:=3}"          # measured phases a session or project needs before its median makes ETAs
: "${BENCH_CAL_MIN:=0.25}"           # clamp on that factor: a few odd runs cannot shrink an ETA to nothing
: "${BENCH_CAL_MAX:=4}"              # nor stretch it to days
: "${BENCH_SESSIONS_CMD:=fleet-sessions --write}" # also refreshes the fleet state document
: "${BENCH_ASKS_CMD:=agent-ask list --all --pending}"
: "${BENCH_ASKS_ALL_CMD:=agent-ask list --all}"   # every ask, for the ask KPIs
: "${BENCH_WINDOW_H:=24}"            # what a scorecard and the headline cover
: "${BENCH_GAP_CAP_MIN:=20}"         # two sampler cadences: a longer gap is a sampler outage, not time spent
: "${BENCH_SCORECARD_DIR:=$HOME/.notes/lab/projects/current/agent-runtime/docs/bench}"
: "${BENCH_OUTCOMES_DIR:=$HOME/.agent/outcomes}"
: "${BENCH_TIME_DAYS:=7}"
: "${BENCH_QUEUE_STATS_CMD:=agent-queue stats --json}"   # given --since <date>
: "${BENCH_QUEUE_DAYS:=7}"           # what the queue line and the scorecard's queue tables cover
: "${LEDGER_CONF_DIR:=$HOME/.config/agentctl/agents}"
: "${LEDGER_TIMER_DIR:=$HOME/.config/systemd/user}"
: "${LEDGER_SRC:=$HOME/.dotfiles/.local:$HOME/.dotfiles/.config:$HOME/.dotfiles-private/.local:$HOME/.dotfiles-private/.config}"   # colon-separated
: "${LEDGER_BOARDS:=$HOME/.notes/lab/projects/current/*/agent/README.md}"
: "${LEDGER_BASELINE:=$HOME/.config/agentctl/ledger-baseline}"
: "${ASK_STALE_DAYS:=14}"            # a pending ask older than this is stale
: "${KPI_THRESHOLDS:=$HOME/.config/agentctl/kpi-thresholds}"
: "${KPI_BOARD:=agent-runtime}"       # the agent board retro files its rows on
: "${BENCH_EFFECT_DAYS:=14}"        # effect: the window on each side of a change
: "${BENCH_EFFECT_FLAT:=0.1}"       # effect: a relative move inside this is flat
: "${TRIAGE_SYSTEMCTL:=systemctl}"     # triage: failed user units
: "${TRIAGE_WATCH_STATE:=$HOME/.local/state/watch-companion}"   # triage: Sentinel's <watch>.state and .since
: "${TRIAGE_WATCHES:=$HOME/.agent/watches}"   # triage: each watch's manifest, for its severity and what
: "${TRIAGE_LOG_HOURS:=24}"        # triage: the runs whose stderr is read for error signatures
: "${TRIAGE_ERR_RE:=error|fatal|traceback|failed}"   # triage: a stderr line that may be an error (case-blind)
: "${TRIAGE_CAUSES:=$HOME/.config/agentctl/triage-causes}"   # triage: <ERE> TAB <fix> lines; a row they match is queued
: "${TRIAGE_PROMOTE_CMD:=fleet-dispatch promote}"   # triage: queue one board row as it stands
: "${TRIAGE_WATCH_AFTER:=21600}"     # triage: seconds a watch must stay TRIP before it is a row, Sentinel's 6h flap window
: "${BENCH_GUARD_RECUR:=2}"         # retro: sessions a lesson must recur in before it wants a guard
: "${BENCH_SO_LIB:=$HOME/.local/lib/session-outcomes.sh}"   # so_lesson_sigs
: "${BENCH_NOTES_CMD:=notes}"
: "${BENCH_WAKES_CMD:=agent-usage wakes}"   # given --since <window>h --json
: "${BENCH_TOKENS_CMD:=agent-usage tokens line}"   # the newest nightly token-usage snapshot's row
: "${BENCH_WEEK_CMD:=day-log week --line}"         # the newest stored week: what moved, against the week before
: "${BENCH_COMMS_CMD:=comms-lint}"                 # the newest nightly comms snapshot: `line` and `kpi --json`
: "${BENCH_JUDGE_CMD:=judge-eval}"                 # the judge lanes scored against their ground truth: `kpi --json`
: "${WAKE_CALLS_TARGET:=2}"          # calls a passing background-task wake should take: read the verdict, nothing else
: "${BENCH_PROJECT_MAP:=$HOME/.config/shared-hooks/project-map.json}"
: "${BENCH_FORECAST_HORIZON_H:=48}"   # a baseline still open this long is scored as a lower bound
: "${BENCH_QUEUE_CMD:=fleet-dispatch fill --dry-run --json}"   # rows dispatch would start after the live work
: "${BENCH_ITEMS_CMD:=agent-queue list --json --state active}"   # the queue's items: work already asked for
: "${BENCH_DONE_ITEMS_CMD:=agent-queue list --json --state done}"   # given --since <day>
: "${BENCH_LANE_LOG:=$HOME/.agent/model-lane/runs.jsonl}"   # model-lane log: one row per dispatched run, its outcome
: "${BENCH_BOARD_CMD:=notes board --json}"          # every open row, both lanes, every profile
: "${BENCH_PROJECTS_CMD:=notes projects --stats --json}"   # each project's open epics with their rollups
: "${BENCH_DOCTOR_LAST:=${XDG_STATE_HOME:-$HOME/.local/state}/agentctl/project-index/doctor.last}"   # the nightly notes doctor
: "${CHAIN_DAYS:=7}"                 # the merged PRs ledger_coverage counts
: "${BENCH_DISPATCH_CONF:=$HOME/.config/agentctl/agents/fleet-dispatch.conf}"   # DISPATCH_MAX_LIVE, the slots items run on
: "${BENCH_RUNS_TSV:=${XDG_STATE_HOME:-$HOME/.local/state}/unity-test-runs/runs.tsv}"
DIR="${FLEET_BENCH_DIR:-$HOME/.agent/bench}"
PROGRESS="$DIR/progress.jsonl"
ESTIMATES="$DIR/estimates.jsonl"
SCORES="$DIR/scores.jsonl"
CI="$DIR/pr-ci.jsonl"
FINDINGS="$DIR/findings.jsonl"
RESPONSES="$DIR/responses.jsonl"   # fleet-bench respond: what answered each finding
FORECASTS="$DIR/forecasts.jsonl"
FORECAST_SCORES="$DIR/forecast-scores.jsonl"
FINDINGS_PASS="$DIR/findings.last"   # epoch of the last evaluation: a healthy pass writes no findings row
STATE_FILE="${FLEET_STATE_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/fleet/state.json}"   # fleet-sessions --write
RUNDOWNS="${FLEET_SHEPHERD_DIR:-$HOME/.agent/shepherd}/rundowns"   # the newest one is the last summary
NAME="${AGENTCTL_NAME:-fleet-bench}"   # each agentctl runner publishes under its own name
CAL_ARGS=(--argjson minn "$BENCH_CAL_MIN_N" --argjson lo "$BENCH_CAL_MIN" --argjson hi "$BENCH_CAL_MAX")

say() { printf 'fleet-bench: %s\n' "$*" >&2; }

# agent-proof.sh owns the agentctl state dir and the last-outcome contract.
proof_lib() {
  local lib="${BENCH_LIB_DIR:-$HOME/.local/lib}/agent-proof.sh"
  # shellcheck source=/dev/null
  [ -f "$lib" ] && . "$lib"
}

report_outcome() { proof_lib && proof_outcome "$NAME" "$@"; }

now() { printf '%s' "${BENCH_NOW:-$(date +%s)}"; }

# jq helpers shared by every verb.
JQ_LIB='
def project: sub("^[^/]*/"; "") | sub(":[0-9]+$"; "") | sub("-agent-[0-9]+$"; "");
def median: sort | length as $n | if $n == 0 then null
  elif $n % 2 == 1 then .[($n - 1) / 2] else (.[$n / 2 - 1] + .[$n / 2]) / 2 end;
def iso: strflocaltime("%Y-%m-%dT%H:%M:%S%z");
def hm: if . == null then "-" else strflocaltime("%a %H:%M") end;
def round1: . * 10 | round / 10;
def round2: . * 100 | round / 100;
# agent-ask stamps date +%Y-%m-%dT%H:%M:%S%z; jq has no offset-aware parser
def ask_epoch: (.[0:19] + "Z" | fromdateiso8601)
  - ((if .[19:20] == "-" then -1 else 1 end) * ((.[20:22] | tonumber) * 3600 + (.[22:24] | tonumber) * 60));
def ratio($a; $b): if $b == 0 then null else ($a / $b * 1000 | round) / 1000 end;   # 3 places, null over none
def dur: if . >= 3600 then "\(. / 3600 | round1)h" else "\(. / 60 | round)m" end;
def run_rows: split("\n") | map(select(. != "") | split("\t")
  | {s: ((.[0] | tonumber) - (.[1] | tonumber)), res: .[2], branch: .[5], repo: .[6]});
def key: "\(.repo)#\(.number)";
def kind: sub("\\(.*"; "");
# the ETA an estimate publishes and how it was made: calibrated when a factor was applied;
# null for no estimate
def shown_eta: if . == null then null else .cal_eta_epoch // .eta_epoch end;
# the ETA column of a live row: the time, or how late it is once that time has passed
def eta_cell: if .late_min != null then "late \(.late_min * 60 | dur)" else (.eta | shown_eta | hm) end;
def basis_label: if . == null then null
  else .basis + (if .factor != null then " x\(.factor) (n=\(.factor_n))" else "" end) end;
# scores in -> one object per basis kind: how far its raw ETAs ran, and the calibration factor
# a new estimate of that kind gets (null below $minn scores with a ratio). Scores are raw, so
# the factor is made from raw ratios only.
def accuracy($minn; $lo; $hi):
  group_by(.basis | kind) | map(
    (map(.ratio // empty) | median | if . == null then null else (. * 100 | round) / 100 end) as $mr
    | (map(.ratio // empty) | length) as $nr
    | {basis: (.[0].basis | kind), n: length, n_ratio: $nr, median_ratio: $mr,
       median_error_min: (map(.error_min) | median),
       median_abs_error_min: (map(.error_min | fabs) | median),
       factor: (if $nr < $minn then null else [[$mr, $lo] | max, $hi] | min end)});
# per-phase minutes for each phase whose start and end were both sampled
def phase_minutes:
  sort_by(.epoch)
  | reduce .[] as $r ({prev: null, starts: []};
      if .prev != null and $r.phases_done != null and .prev.phases_done != null
         and $r.phases_done > .prev.phases_done
      then .starts += [{epoch: $r.epoch, from: .prev.phases_done, to: $r.phases_done}]
      else . end
      | .prev = $r)
  | .starts as $s
  | [range(1; $s | length) | ($s[.].epoch - $s[. - 1].epoch) / 60 / ($s[.].to - $s[.].from)];
def pct($q): sort | if length == 0 then null else .[((length - 1) * $q) | floor] end;
# live rows (latest_live) in -> each session with phases left and a measured pace, every open
# phase given a p50 end (per-phase minutes x the estimate factor) and a slow end (x $slow, the
# last window scored ratio), in plan order. A session past its ETA has its current phase due
# now and the rest after it. $names maps session_id to the open phase names of its plan.
def schedule($t; $slow; $names):
  map(select((.finished | not) and .phases_total != null and .phases_done != null and .eta != null)
    | (.phases_total - .phases_done) as $left | select($left > 0)
    | . as $r | ($r.eta.per_phase_min * 60) as $m
    | ($m * ($r.eta.factor // 1)) as $P | ($m * $slow) as $S
    | ([$r.eta.made_epoch + $P, $t] | max) as $p1 | ([$r.eta.made_epoch + $S, $t] | max) as $s1
    | ($names[$r.session_id] // []) as $nm
    | {session_id, target, project, bucket, phases_done, phases_total, left: $left, late_min,
       basis: ($r.eta | basis_label),
       phases: [range(0; $left) | {name: ($nm[.] // "phase \($r.phases_done + . + 1)"),
                                   p50: ($p1 + . * $P | floor), slow: ($s1 + . * $S | floor)}]}
    | . + {finish_p50: .phases[-1].p50, finish_slow: .phases[-1].slow});
def fleet_finish: {median_p50: (map(.finish_p50) | median | if . == null then null else floor end),
  p90_p50: (map(.finish_p50) | pct(0.9)), last_p50: (map(.finish_p50) | max),
  median_slow: (map(.finish_slow) | median | if . == null then null else floor end),
  p90_slow: (map(.finish_slow) | pct(0.9)), last_slow: (map(.finish_slow) | max)};
# queue items in (enriched by forecast_json: phases, P and S seconds a phase, start, live, after,
# why) -> each item placed on $K dispatcher slots on track $k ("P" or "S"). Running items hold a
# slot until they end (the finish of its live session when that is on the schedule). Each time
# the earliest slot frees, it goes to the first queued item in queue order whose after: parent
# has ended by then, or else to the one ready soonest: fleet-dispatch starts the runnable head.
# Items with a why, and those behind one, stay unplaced.
def qplace($t; $K; $k):
  (map(select(.state == "running")
       | . + {end: (if .live != null then .live[$k] else ([.start + .phases * .[$k], $t] | max | floor) end)})) as $run
  | ($run | map(.end)) as $busy
  | {done: ($run | map({key: .slug, value: .end}) | from_entries),
     free: ($busy + [range(0; [$K - ($busy | length), 0] | max) | $t] | sort),
     placed: ($run | map({slug, start, end})),
     todo: map(select(.state == "queued" and .why == null)), stuck: false}
  | until((.todo | length) == 0 or .stuck;
      . as $s
      | ($s.free[0] // $t) as $slot
      | [$s.todo | to_entries[] | select(.value.after == null or $s.done[.value.after] != null)
         | . + {ready: ([$s.done[.value.after // ""] // $t, $t] | max)}] as $can
      | (($can | map(select(.ready <= $slot)) | first) // ($can | min_by(.ready))) as $pick
      | if $pick == null then .stuck = true
        else $pick.value as $it
          | ([$pick.ready, $slot] | max) as $start
          | ($start + $it.phases * $it[$k] | floor) as $end
          | .free = (.free[1:] + [$end] | sort) | .done[$it.slug] = $end
          | .placed += [{slug: $it.slug, start: $start, end: $end}]
          | .todo = (.todo | del(.[$pick.key]))
        end)
  | {placed: (.placed | INDEX(.slug)), behind: (.todo | map(.slug))};
# progress rows in -> open phases in the newest sample at or before $t
def open_at($t): map(select(.epoch <= $t)) | (map(.epoch) | max) as $s
  | if $s == null then 0 else
      map(select(.epoch == $s and (.finished | not) and .phases_total != null and .phases_done != null)
          | .phases_total - .phases_done | select(. > 0)) | add // 0 end;
# progress rows in -> one step per sample of each (session, plan): the first sample of a plan
# starts it with its open phases; every later one ticks, adds or removes phases against the one before
def flow_steps: map(select(.phases_total != null and .phases_done != null))
  | group_by([.session_id, .plan_file]) | map(sort_by(.epoch) | . as $r
      | [{epoch: $r[0].epoch, session_id: $r[0].session_id, project: $r[0].project, start: 1, open: ([$r[0].phases_total - $r[0].phases_done, 0] | max),
          ticked: 0, added: 0, removed: 0}]
        + [range(1; length) | {epoch: $r[.].epoch, session_id: $r[.].session_id, project: $r[.].project, start: 0, open: 0,
          ticked: ([$r[.].phases_done - $r[. - 1].phases_done, 0] | max),
          added: ([$r[.].phases_total - $r[. - 1].phases_total, 0] | max),
          removed: ([$r[. - 1].phases_total - $r[.].phases_total, 0] | max)}]) | add // [];
def flow_sum: {ticked: (map(.ticked) | add // 0), added: (map(.added) | add // 0),
  removed: (map(.removed) | add // 0), started: (map(.start) | add // 0), started_open: (map(.open) | add // 0)}
  | . + {in: (.started_open + .added)};
# progress rows in -> what came in and what went out between $a and $b. dropped is the open
# phases that left with a session that ended unfinished: the remainder of the balance.
def flow($a; $b): . as $p | (($b - $a) / 3600) as $h
  | def per($x): if $h > 0 then $x / $h | round2 else null end;
  ($p | flow_steps | map(select(.epoch > $a and .epoch <= $b))) as $st
  | ($p | open_at($a)) as $o0 | ($p | open_at($b)) as $o1
  | ($st | flow_sum) as $f
  | {from: $a, to: $b, hours: ($h | round2)} + $f
  + {net_in: ($f.in - $f.removed), in_per_h: per($f.in), out_per_h: per($f.ticked),
     net_in_per_h: per($f.in - $f.removed), open_start: $o0, open_end: $o1,
     dropped: ($o0 + $f.in - $f.removed - $f.ticked - $o1),
     by_project: ($st | group_by(.project) | map({project: .[0].project} + flow_sum) | sort_by(-.ticked)),
     hourly: ($st | group_by(.epoch / 3600 | floor) | map({hour: ((.[0].epoch / 3600 | floor) * 3600)} + flow_sum)
       | reduce .[] as $x ({scope: $o0, done: 0, rows: []};
           .scope += ($x.in - $x.removed) | .done += $x.ticked
           | .rows += [$x + {scope: .scope, done: .done}]) | .rows)};
# progress rows in -> a frozen forecast $b against what happened by $t: per baseline session the
# phases expected by now (p50 and slow) against the phases it ticked, and the scope that came in.
def vs($b; $t): . as $p | $b.made_epoch as $m
  | ($p | map(select(.epoch <= $t)) | map(.epoch) | max) as $last
  | ($p | map(select(.epoch == $last)) | map({key: .session_id, value: .}) | from_entries) as $cur
  | ($p | flow_steps | map(select(.epoch > $m and .epoch <= $t))) as $st
  | ($b.schedule | map(.session_id)) as $ids
  | ($b.schedule | map(. as $s | $cur[$s.session_id] as $r
      | ($st | map(select(.session_id == $s.session_id))) as $mine
      | ([$s.phases[] | select(.p50 <= $t)] | length) as $exp
      | ([$mine | map(.ticked) | add // 0, $s.left] | min) as $act
      | {target: $s.target, session_id: $s.session_id, left: $s.left, expected: $exp,
         expected_slow: ([$s.phases[] | select(.slow <= $t)] | length), ticked: $act,
         added: ($mine | map(.added) | add // 0), removed: ($mine | map(.removed) | add // 0),
         new_plans: ($mine | map(.start) | add // 0),
         state: (if $r == null then "gone"
                 elif $r.finished or $act >= $s.left or ($r.phases_total != null and $r.phases_done != null and $r.phases_done >= $r.phases_total) then "finished"
                 elif $act > $exp then "ahead" elif $act < $exp then "behind" else "on track" end),
         next: ($s.phases[$act].name // null)}
      # behind: minutes since the phase it is on was due; ahead: minutes early on the last one it ticked
      | . + {min: (if .state == "behind" then (($t - $s.phases[$act].p50) / 60 | floor)
                   elif .state == "ahead" then (($s.phases[$act - 1].p50 - $t) / 60 | floor) else null end)})) as $rows
  | ($p | flow($m; $t)) as $f
  | {label: $b.label, made_epoch: $m, now: $t, hours: (($t - $m) / 3600 | round2),
     expected: ($rows | map(.expected) | add // 0), expected_slow: ($rows | map(.expected_slow) | add // 0),
     ticked: ($rows | map(.ticked) | add // 0), ticked_all: $f.ticked,
     states: ($rows | group_by(.state) | map({key: .[0].state, value: length}) | from_entries),
     added: ($rows | map(.added) | add // 0), removed: ($rows | map(.removed) | add // 0),
     new_plans: ($rows | map(.new_plans) | add // 0),
     started_since: ($st | map(select(.start == 1 and (.session_id as $i | $ids | index($i) | not)) | .session_id) | unique | length),
     in: $f.in, in_per_h: $f.net_in_per_h, in_per_h_frozen: $b.drain.in_per_h, out_per_h: $f.out_per_h,
     sessions: $rows};
# progress rows in -> the score of baseline $b at $t once it resolves: every one of its sessions
# finished or gone, or $hz hours passed. Nothing until then, so a baseline is scored once.
def forecast_score($b; $t; $hz): . as $p | $b.made_epoch as $m
  | ($p | map(select(.epoch <= $t)) | map(.epoch) | max) as $last
  | ($p | flow_steps | map(select(.epoch > $m and .epoch <= $t))) as $st
  | ($b.schedule | map(. as $s | ($p | map(select(.session_id == $s.session_id and .epoch > $m and .epoch <= $t))) as $r
      # done when it says so, or once it has ticked as many phases as it had open, as vs counts it
      | ([$st[] | select(.session_id == $s.session_id)] | sort_by(.epoch)
         | reduce .[] as $x ({n: 0, at: null}; .n += $x.ticked | if .at == null and .n >= $s.left then .at = $x.epoch else . end) | .at) as $ticked
      | ([($r | map(select(.finished or (.phases_total != null and .phases_done != null and .phases_done >= .phases_total))) | map(.epoch) | min), $ticked]
         | map(select(. != null)) | min) as $fin
      | ($r | map(.epoch) | max) as $seen
      | if $fin != null then {end: $fin, how: "finished"}
        # gone: ended by the first sample that no longer had it
        elif ($seen // $m) < $last then {end: ($p | map(.epoch | select(. > ($seen // $m))) | min), how: "gone"}
        else {end: null, how: "open"} end)) as $ends
  | ($ends | map(select(.end == null)) | length) as $open
  | select($open == 0 or $t - $m >= $hz * 3600)
  | (if $open == 0 then ($ends | map(.end) | max) else $t end) as $end
  | def ratio($pred): if $pred == null or $pred <= $m then null else (($end - $m) / ($pred - $m) | round2) end;
  {label: $b.label, made_epoch: $m, scored_epoch: $t, resolved_by: (if $open == 0 then "all done" else "horizon" end),
   sessions: ($ends | length), finished: ($ends | map(select(.how == "finished")) | length),
   gone: ($ends | map(select(.how == "gone")) | length), open: $open,
   actual_last: (if $open == 0 then $end else null end),
   bound: (if $open == 0 then "exact" else "lower" end),
   pred_last_p50: $b.last_p50, pred_last_slow: $b.last_slow, pred_drain: $b.drain.epoch,
   ratio_p50: ratio($b.last_p50), ratio_slow: ratio($b.last_slow),
   error_min: (if $b.last_p50 == null then null else (($end - $b.last_p50) / 60 | floor) end),
   within_slow: ($b.last_slow != null and $end <= $b.last_slow)}
  + ($p | flow($m; $end) | {in, ticked, in_per_h: .net_in_per_h, in_per_h_frozen: $b.drain.in_per_h});
'

# sample_rows -> the live fleet-sessions rows as progress lines (NIGHTLY rows have no session)
sample_rows() {
  local t="$1"
  $BENCH_SESSIONS_CMD | jq -c --argjson t "$t" "$JQ_LIB"'
    select(type == "object" and (.session_id // "") != "" and .bucket != "NIGHTLY")
    | {epoch: $t, at: ($t | iso), session_id, target, project: (.target | project), bucket,
       phases_done, phases_total, next_phase, finished: (.finished // false), idle_min,
       context_tokens, nudged, escalated, pr, plan_file}'
}

# new_estimates <now> -> an estimate for every live, unfinished session with a phase count
# that has no estimate yet. Reads the whole progress history for the medians. The raw ETA is
# what gets scored; the calibration factor is the median raw ratio of that basis kind's past
# scores, kept in its own fields, so it never feeds back into the ratios it is made from.
new_estimates() {
  local t="$1" est="$ESTIMATES" sc="$SCORES"
  [ -s "$est" ] || est=/dev/null
  [ -s "$sc" ] || sc=/dev/null
  jq -cn --argjson t "$t" --argjson def "$BENCH_DEFAULT_PHASE_MIN" --argjson minb "$BENCH_BASIS_MIN_N" \
     "${CAL_ARGS[@]}" --slurpfile p "$PROGRESS" --slurpfile e "$est" --slurpfile s "$sc" "$JQ_LIB"'
    ($p | group_by(.session_id) | map({key: .[0].session_id,
          value: (group_by(.plan_file) | map(phase_minutes) | add // [])}) | from_entries) as $bys
    | ($p | group_by(.project) | map({key: .[0].project,
          value: (group_by([.session_id, .plan_file]) | map(phase_minutes) | add // [])}) | from_entries) as $byp
    | ($e | map("\(.session_id)/\(.phases_done)/\(.phases_total)") | INDEX(.)) as $have
    | ($s | accuracy($minn; $lo; $hi) | INDEX(.basis)) as $acc
    | $p | map(select(.epoch == $t)) | .[]
    | select(.finished | not) | select(.phases_total != null and .phases_done != null)
    | select($have["\(.session_id)/\(.phases_done)/\(.phases_total)"] | not)
    | ($bys[.session_id] // []) as $s | ($byp[.project] // []) as $j
    | (if ($s | length) >= $minb then {m: ($s | median), basis: "session-median(\($s | length))"}
       elif ($j | length) >= $minb then {m: ($j | median), basis: "project-median(\($j | length))"}
       else {m: $def, basis: "default"} end) as $pp
    | ($t + (((.phases_total - .phases_done) * $pp.m * 60) | floor)) as $eta
    | ($acc[$pp.basis | kind].factor // null) as $f
    | {made_epoch: $t, made_at: ($t | iso), session_id, target, project, phases_done,
       phases_total, per_phase_min: ($pp.m | floor), eta_epoch: $eta, eta: ($eta | iso),
       basis: $pp.basis}
      + (if $f == null then {} else
           ($t + (($eta - $t) * $f | floor)) as $cal
           | {factor: $f, factor_n: $acc[$pp.basis | kind].n_ratio, cal_eta_epoch: $cal, cal_eta: ($cal | iso)} end)'
}

# new_scores -> a score for every estimate whose session has since finished. The finish is
# the first sample that read finished; when that was the session's first sample at all, the
# real finish was earlier and done_bound says "upper".
new_scores() {
  local sc="$SCORES"
  [ -s "$sc" ] || sc=/dev/null
  [ -s "$ESTIMATES" ] || return 0
  jq -cn --slurpfile p "$PROGRESS" --slurpfile e "$ESTIMATES" --slurpfile s "$sc" '
    ($p | group_by(.session_id) | map(sort_by(.epoch)
          | {key: .[0].session_id,
             value: {first: .[0].epoch,
                     done: (map(select(.finished)) | .[0].epoch // null)}})
        | from_entries) as $f
    | ($s | map("\(.session_id)/\(.made_epoch)") | INDEX(.)) as $have
    | $e[] | . as $x | ($f[.session_id] // null) as $d
    | select($d != null and $d.done != null and $d.done > .made_epoch)
    | select($have["\(.session_id)/\(.made_epoch)"] | not)
    | {session_id, target, project, basis, made_epoch, eta_epoch, done_epoch: $d.done,
       done_bound: (if $d.done == $d.first then "upper" else "sampled" end),
       horizon_min: ((.eta_epoch - .made_epoch) / 60 | floor),
       error_min: (($d.done - .eta_epoch) / 60 | floor),
       ratio: (if .eta_epoch > .made_epoch
               then (($d.done - .made_epoch) / (.eta_epoch - .made_epoch) * 100 | floor) / 100
               else null end)}
      + (if .cal_eta_epoch == null then {} else
           {factor, cal_eta_epoch, cal_error_min: (($d.done - .cal_eta_epoch) / 60 | floor),
            cal_ratio: (if .cal_eta_epoch > .made_epoch
                        then (($d.done - .made_epoch) / (.cal_eta_epoch - .made_epoch) * 100 | floor) / 100
                        else null end)} end)'
}

cmd_sample() {
  local t rows est sc
  mkdir -p "$DIR"
  exec 9>"$DIR/.lock"
  flock -n 9 || { say "another sample is running"; return 0; }
  t=$(now)
  if ! rows=$(sample_rows "$t"); then
    say "fleet-sessions failed; nothing written"
    report_outcome FAILED "fleet-sessions failed"
    return 1
  fi
  if [ -z "$rows" ]; then
    say "no live session"
    publish_window "$t"
    findings_run "$t"
    report_outcome NOOP "no live session"
    return 0
  fi
  printf '%s\n' "$rows" >> "$PROGRESS"
  est=$(new_estimates "$t") || { report_outcome FAILED "estimate step failed"; return 1; }
  [ -n "$est" ] && printf '%s\n' "$est" >> "$ESTIMATES"
  sc=$(new_scores) || { report_outcome FAILED "score step failed"; return 1; }
  [ -n "$sc" ] && printf '%s\n' "$sc" >> "$SCORES"
  local fs
  fs=$(new_forecast_scores "$t") || { report_outcome FAILED "forecast score step failed"; return 1; }
  [ -n "$fs" ] && printf '%s\n' "$fs" >> "$FORECAST_SCORES"
  local n e s
  n=$(grep -c . <<<"$rows"); e=$(grep -c . <<<"$est"); s=$(grep -c . <<<"$sc")
  say "$n sessions, $e new estimates, $s new scores"
  publish_window "$t"
  findings_run "$t"
  report_outcome WORKED "$n sessions, $e estimates, $s scores"
}

# latest_live -> the newest sample's rows joined with each session's newest estimate, and
# late_min when the ETA it shows is already behind that sample. The estimate is not redone:
# it is scored as it was made. phase_since_epoch is the first sample at the session's current
# phases_done: when its open phase started, as near as the sample cadence can say.
latest_live() {
  [ -s "$PROGRESS" ] || return 0
  local est="$ESTIMATES"
  [ -s "$est" ] || est=/dev/null
  jq -cn --slurpfile p "$PROGRESS" --slurpfile e "$est" "$JQ_LIB"'
    ($p | max_by(.epoch) | .epoch) as $last
    | ($e | group_by(.session_id) | map(max_by(.made_epoch) | {key: .session_id, value: .})
        | from_entries) as $eta
    | ($p | map(select(.epoch == $last) | .session_id)) as $live
    | ($p | map(select(.session_id | IN($live[]))) | group_by(.session_id)
        | map({key: .[0].session_id, value: map({epoch, phases_done})}) | from_entries) as $hist
    | $p[] | select(.epoch == $last)
    | . as $r
    | ([$hist[$r.session_id][] | select(.phases_done != $r.phases_done) | .epoch] | max) as $moved
    | . + {phase_since_epoch: ([$hist[$r.session_id][] | select($moved == null or .epoch > $moved) | .epoch] | min)}
    | . + {eta: (if .finished then null else $eta[.session_id] end)}
    | . + {late_min: ((.eta | shown_eta) as $s
                      | if $s != null and $s < $last then (($last - $s) / 60 | floor) else null end)}'
}

cmd_eta() {
  if [ "${1:-}" = --json ]; then
    latest_live | jq -c "$JQ_LIB"'{target, session_id, phases_done, phases_total, finished,
      eta: (.eta.cal_eta // .eta.eta // null), eta_epoch: (.eta | shown_eta),
      raw_eta_epoch: (.eta.eta_epoch // null), factor: (.eta.factor // null), late_min,
      phase_since_epoch,
      phase_min: (if .eta.per_phase_min == null then null else .eta.per_phase_min * (.eta.factor // 1) | floor end),
      basis: (.eta | basis_label)}'
    return
  fi
  latest_live | jq -r "$JQ_LIB"'[.target, "\(.phases_done // "-")/\(.phases_total // "-")",
      (if .finished then "finished" else eta_cell end), (.eta | basis_label // "-")] | @tsv' |
    awk -F'\t' '{ printf "%-42s %-6s %-10s %s\n", $1, $2, $3, $4 }'
}

cmd_report() {
  local last
  if [ ! -s "$PROGRESS" ]; then echo "no samples yet: run fleet-bench sample"; return 0; fi
  last=$(jq -rs "$JQ_LIB"'max_by(.epoch) | .epoch | hm' "$PROGRESS")
  echo "Live sessions (sampled $last; ETA from measured phase times, x the basis's measured ratio once it has $BENCH_CAL_MIN_N scores)"
  printf '%-42s %-6s %-8s %-10s %s\n' SESSION PHASE BUCKET ETA BASIS
  latest_live | jq -r "$JQ_LIB"'[.target, "\(.phases_done // "-")/\(.phases_total // "-")", .bucket,
      (if .finished then "finished" else eta_cell end), (.eta | basis_label // "-")] | @tsv' |
    awk -F'\t' '{ printf "%-42s %-6s %-8s %-10s %s\n", $1, $2, $3, $4, $5 }'
  echo
  echo "ETA accuracy (error = actual finish - predicted; ratio = actual/predicted duration)"
  if [ ! -s "$SCORES" ]; then
    echo "  nothing scored yet: an ETA is scored when its session finishes"
  else
    jq -rs "${CAL_ARGS[@]}" "$JQ_LIB"'
      def line($label; err; rat): if length == 0 then empty else
        "  \($label): \(length) scored, median error \(map(err) | median) min, median |error| \(map(err | fabs) | median) min, median ratio \(map(rat // empty) | median // "-")" end;
      def line($label): line($label; .error_min; .ratio);
      (accuracy($minn; $lo; $hi) | .[]
        | "  \(.basis): \(.n) scored, median error \(.median_error_min) min, median |error| \(.median_abs_error_min) min, median ratio \(.median_ratio // "-")"),
      (map(select(.cal_eta_epoch != null)) | group_by(.basis | kind) | .[]
        | line("\(.[0].basis | kind) calibrated"; .cal_error_min; .cal_ratio)),
      (map(select(.horizon_min < 120)) | line("horizon under 2h")),
      (map(select(.horizon_min >= 120 and .horizon_min < 480)) | line("horizon 2-8h")),
      (map(select(.horizon_min >= 480)) | line("horizon over 8h")),
      (map(select(.done_bound == "upper")) | if length > 0 then "  \(length) finished before their first sample, so their real error is smaller than shown" else empty end)
    ' "$SCORES"
  fi
  echo
  echo "Fleet forecast accuracy (ratio = actual over predicted time to the last session's finish)"
  if [ ! -s "$FORECAST_SCORES" ]; then
    echo "  nothing scored yet: a baseline is scored when its sessions are all done, or after ${BENCH_FORECAST_HORIZON_H}h"
  else
    jq -rs "$JQ_LIB"'
      "  \(length) baselines scored: median ratio \(map(.ratio_p50 // empty) | median // "-")x as calibrated, \(map(.ratio_slow // empty) | median // "-")x at the slow end; \(map(select(.within_slow)) | length) of \(length) done inside the slow end",
      (.[-3:][] | "  \(.label): \(.resolved_by), \(.ratio_p50 // "-")x\(if .bound == "lower" then " or more (\(.open) still open)" else "" end), error \(.error_min // "-") min, \(.in) phases came in at \(.in_per_h)/h against \(.in_per_h_frozen)/h frozen")' "$FORECAST_SCORES"
  fi
  echo
  local r st
  proof_lib || return 0
  for r in fleet-bench fleet-review briefing; do
    st="$(proof_state_dir)/$r/last-outcome"
    printf '%s last outcome: %s\n' "$r" "$(cat "$st" 2>/dev/null || echo 'none recorded (not run under agentctl yet)')"
  done
}

cmd_accuracy() {
  [ "${1:-}" = --json ] || { echo "usage: fleet-bench accuracy --json" >&2; return 2; }
  [ -s "$SCORES" ] || return 0
  jq -cs "${CAL_ARGS[@]}" "$JQ_LIB"'accuracy($minn; $lo; $hi) | .[]' "$SCORES"
}

# window_stats <now> [since] -> one JSON object per session seen since <since> (default: the
# window): phases ticked, minutes per bucket (each sample owns the gap to the next one,
# capped), nudges and escalations (a flag turning on), peak context, first and last sample.
window_stats() {
  local t="$1"
  jq -cn --argjson since "${2:-$(( t - BENCH_WINDOW_H * 3600 ))}" --argjson cap $(( BENCH_GAP_CAP_MIN * 60 )) \
     --slurpfile p "$PROGRESS" '
    $p | map(select(.epoch >= $since)) | group_by(.session_id) | .[] | sort_by(.epoch) | . as $r
    | [range(0; length - 1) | {b: $r[.].bucket,
         m: (([($r[. + 1].epoch - $r[.].epoch), $cap] | min) / 60)}] as $gaps
    | ($gaps | group_by(.b) | map({key: .[0].b, value: (map(.m) | add | floor)}) | from_entries) as $minutes
    | {session_id: .[0].session_id, target: (last.target), project: (last.project),
     plan: (last.plan_file // "" | sub(".*/"; "") | sub("\\.md$"; "")),
     phase: "\(last.phases_done // "-")/\(last.phases_total // "-")",
     ticked: (group_by(.plan_file) | map((last.phases_done // 0) - (map(.phases_done // 0) | min)) | add),
     working_min: ($minutes.WORKING // 0), waiting_min: ($minutes.NEEDS // 0), stalled_min: ($minutes.STALLED // 0),
     minutes: $minutes,
     nudges: ([range(1; length) | select($r[.].nudged == true and $r[. - 1].nudged != true)] | length),
     escalations: ([range(1; length) | select($r[.].escalated == true and $r[. - 1].escalated != true)] | length),
     peak_context: (map(.context_tokens // 0) | max), first_epoch: (.[0].epoch), last_epoch: (last.epoch)}'
}

# bench_prom <now> -> the fleet_bench.prom lines: the scorecard's window per project. Waiting
# and stalled hours are summed over the project's sessions, the ETA ratio is the median of
# the ETAs scored in the window (no series when none was), and CI reds count the PRs merged
# in the window by a session of that project. The KPIs ride along so a reader never runs `kpi`.
bench_prom() {
  local t="$1" kpis
  kpis=$(kpi_json "$t" "$(ledger_counts)") || kpis='{}'
  jq -rn --arg win "$BENCH_WINDOW_H" --slurpfile w <(window_stats "$t") --slurpfile e <(loop_episodes "$t" $((t - LOOP_WINDOW_S))) \
     --slurpfile s <(in_window "$SCORES" done_epoch "$t") --slurpfile c <(in_window "$CI" merged_epoch "$t") --argjson k "$kpis" \
     "$JQ_LIB$PROM_JQ"'
    def h: . / 60 * 100 | round / 100;
    ($w | map({key: .session_id, value: .project}) | from_entries) as $proj
    | ($w | map(.project) + ($s | map(.project)) | unique) as $ps
    | gauge("agent_bench_waiting_hours"; "Hours sessions sat in NEEDS over the last \($win)h.";
        $w | group_by(.project)[] | [{project: .[0].project}, (map(.waiting_min) | add | h)]),
      gauge("agent_bench_stalled_hours"; "Hours sessions sat in STALLED over the last \($win)h.";
        $w | group_by(.project)[] | [{project: .[0].project}, (map(.stalled_min) | add | h)]),
      gauge("agent_bench_eta_ratio"; "Median actual over predicted duration of ETAs scored in the last \($win)h.";
        $ps[] | . as $p | [{project: $p}, ($s | map(select(.project == $p) | .ratio // empty) | median)]),
      gauge("agent_bench_ci_reds_before_merge"; "CI reds on PRs merged in the last \($win)h, before they merged.";
        $c | map(. + {project: $proj[.session_id]}) | map(select(.project != null)) | group_by(.project)[]
        | [{project: .[0].project}, (map(.ci_red) | add)]),
      gauge("agent_bench_loop_dark_episodes"; "Finding episodes begun in the last 7d that reached the human with nothing but pages.";
        [{}, ($e | map(select(.dark)) | length)]),
      gauge("agent_bench_loop_first_response_minutes"; "Median minutes from a finding episode to its first response that is not a page, last 7d.";
        [{}, ($e | map(.first_response_min | numbers) | median)]),
      gauge("agent_bench_kpi"; "The KPIs `fleet-bench kpi` prints, by window.";
        $k | to_entries[] | .key as $n | .value as $v | ("7d", "28d") as $d | [{kpi: $n, window: $d}, $v[$d]]),
      gauge("agent_bench_kpi_limit"; "Each KPI'"'"'s threshold from kpi-thresholds.";
        $k | to_entries[] | [{kpi: .key}, .value.threshold]),
      gauge("agent_bench_kpi_past"; "1 when a KPI is past its threshold, as fleet-bench judged it.";
        $k | to_entries[] | select(.value.status != "-") | [{kpi: .key}, (if .value.status == "past" then 1 else 0 end)])'
}

# publish_window <now>: write bench_prom where node_exporter reads it.
publish_window() {
  [ -s "$PROGRESS" ] || return 0
  prom_textfile fleet_bench.prom bench_prom "$1" || say "could not write fleet_bench.prom"
}

# outcomes_newest -> the newest session-outcomes line per session_id (its own reader rule)
outcomes_newest() {
  if compgen -G "$BENCH_OUTCOMES_DIR/*/*.jsonl" >/dev/null; then
    cat "$BENCH_OUTCOMES_DIR"/*/*.jsonl
  fi | jq -c -s 'map(select(.session_id)) | group_by(.session_id) | map(last) | .[]'
}

outcomes_latest() {
  outcomes_newest | jq -cs 'map({key: .session_id, value: {prs_merged, reverted_7d, cost_usd, edits, activity, tool_errors: .hard_errors.tool_errors}}) | from_entries'
}

# in_window <file> <epoch field> <now> [since] -> the file's rows whose field falls since
# <since> (default: the window)
in_window() {
  [ -s "$1" ] || return 0
  jq -c --arg f "$2" --argjson since "${4:-$(( $3 - BENCH_WINDOW_H * 3600 ))}" 'select(.[$f] >= $since)' "$1"
}

cmd_headline() {
  local t; t=$(now)
  [ -s "$PROGRESS" ] || { echo "bench: no samples yet"; return 0; }
  jq -rn --arg win "$BENCH_WINDOW_H" --slurpfile w <(window_stats "$t") --slurpfile s <(in_window "$SCORES" done_epoch "$t") \
     --slurpfile c <(in_window "$CI" merged_epoch "$t") "$JQ_LIB"'
    def h: . / 60 * 10 | floor / 10;
    "bench \($win)h: \($w | length) sessions, \($w | map(.ticked) | add // 0) phases ticked, "
    + "\($w | map(.waiting_min) | add // 0 | h)h waiting on you, \($w | map(.stalled_min) | add // 0 | h)h stalled, "
    + (if ($s | length) == 0 then "no ETA finished yet"
       else "\($s | length) ETAs scored, median \($s | map(.ratio // empty) | median | round2)x of predicted"
         + ($s | map(.cal_ratio // empty) | if length == 0 then ""
            else " (\(length) calibrated, median \(median | round2)x)" end) end)
    + (if ($c | length) == 0 then ""
       else ", \($c | map(.ci_red) | add) failed CI runs before merge in \($c | length) PRs" end)'
}

# runs_between <from> <to> -> the run ledger's rows that ended in that time
runs_between() { awk -F'\t' -v a="$1" -v b="$2" '$1 > a && $1 <= b' "$BENCH_RUNS_TSV" 2>/dev/null; }

# prom_map <label> <promql> <epoch> -> {label value: number}; rc 1 when unreadable. A recorded
# series can only answer instant lookups, so a replay has no answer to these.
prom_map() {
  [ -z "${BENCH_PROM_TSV:-}" ] || return 1
  prom_q "$2" "$3" | jq -c --arg l "$1" '[.data.result[] | {key: (.metric[$l] // "-"), value: (.value[1] | tonumber)}] | from_entries'
}

# spend_by_session <now> -> {session id: dollars in the window}, from the counter Claude Code exports
spend_by_session() {
  prom_map session_id "sum by (session_id) (increase(claude_code_cost_usage_USD_total[${BENCH_WINDOW_H}h]))" "$1"
}

# session_rows <now> -> one JSON object per session in the window, most working time first:
# the scorecard's Sessions table, joined to session-outcomes and the CI reds.
session_rows() {
  local t="$1" spend
  spend=$(spend_by_session "$t") || spend=null
  # Through a file: the outcomes of a few thousand sessions are over the kernel's 128 KB limit on one argument.
  jq -cn --slurpfile w <(window_stats "$t") --slurpfile outcomes <(outcomes_latest) --argjson spend "$spend" \
     --slurpfile c <(in_window "$CI" merged_epoch "$t") "$JQ_LIB"'
    def h: . / 60 * 10 | floor / 10;
    ($c | group_by(.session_id) | map({key: .[0].session_id, value: (map(.ci_red) | add)}) | from_entries) as $red
    | $outcomes[0] as $o
    | $w | sort_by(-.working_min) | .[] | ($o[.session_id] // {}) as $x
    | {session_id, target, plan, phase, ticked, working_h: (.working_min | h), waiting_h: (.waiting_min | h),
       stalled_h: (.stalled_min | h), nudges, peak_k: (.peak_context / 1000 | floor),
       prs_merged: $x.prs_merged, ci_reds: $red[.session_id], reverts: $x.reverted_7d,
       cost_usd: (if $x.cost_usd then $x.cost_usd * 100 | floor / 100 else null end),
       cost_24h: ($spend[.session_id] // null | if . then round2 else . end),
       edits: $x.edits, activity: $x.activity, tool_errors: $x.tool_errors}'
}

cmd_sessions() {
  [ "${1:-}" = --json ] || { echo "usage: fleet-bench sessions --json" >&2; return 2; }
  [ -s "$PROGRESS" ] || return 0
  session_rows "$(now)"
}

# cmd_stats --json [--since E] -> one JSON object per session sampled or merging a PR since E
# (default: all of it): its whole life from this bench's two stores, the progress samples and
# pr-ci. merged is null on a session with no merged PR in pr-ci, and sampled is false on one
# the sampler never saw. session-outcomes keeps each row as its own row's delivery.
cmd_stats() {
  local json=0 since=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      --since) since="${2:-}"; shift ;;
      *) json=0; break ;;
    esac
    shift
  done
  { [ "$json" = 1 ] && [[ "$since" =~ ^[0-9]+$ ]]; } || { echo "usage: fleet-bench stats --json [--since <epoch>]" >&2; return 2; }
  jq -cn --slurpfile w <([ -s "$PROGRESS" ] && window_stats "$(now)" "$since") \
     --slurpfile c <(in_window "$CI" merged_epoch 0 "$since") '
    ($w | map({key: .session_id, value: del(.working_min, .waiting_min, .stalled_min)}) | from_entries) as $ws
    | ($c | group_by(.session_id)
       | map({key: .[0].session_id,
              value: {prs: length, lines_added: (map(.additions // 0) | add), lines_deleted: (map(.deletions // 0) | add),
                      ci_runs: (map(.ci_runs // 0) | add), ci_reds: (map(.ci_red // 0) | add)}})
       | from_entries) as $ci
    | (($ws | keys) + ($ci | keys) | unique)[] as $k
    | {session_id: $k} + ($ws[$k] // {sampled: false}) + {merged: ($ci[$k] // null)}'
}

cmd_scorecard() {
  local t day out counts
  t=$(now); day=$(date -d "@$t" +%F)
  [ -s "$PROGRESS" ] || { say "no samples yet"; return 1; }
  mkdir -p "$BENCH_SCORECARD_DIR" || return 1
  out="$BENCH_SCORECARD_DIR/$day.md"
  counts=$(ledger_counts)
  {
    echo "# Fleet bench, $day"
    echo
    echo "$(BENCH_NOW=$t cmd_headline)."
    echo
    echo "## KPIs"
    echo
    echo "Human sessions by when session-outcomes last saw them; (now) is a count taken at this run. Thresholds: $KPI_THRESHOLDS. \`fleet-bench retro\` files a board row for each one past it."
    echo
    kpi_table "$(kpi_json "$t" "$counts")"
    echo
    forecast_section "$t"
    echo
    wakes_lines
    report_line "$BENCH_TOKENS_CMD" tokens
    report_line "$BENCH_WEEK_CMD" week
    report_line "$BENCH_COMMS_CMD line" comms
    echo
    bottleneck_section "$t"
    echo
    time_section "$t"
    echo
    queue_section "$t"
    echo
    models_section "$t"
    echo
    echo "## Sessions"
    echo
    echo "Counted from samples every 10 minutes over the last ${BENCH_WINDOW_H}h, never graded by a model. Waiting on you is time a session sat in NEEDS, kept apart so your answer time is not counted against an agent. Fields and formulas: the fleet-bench skill."
    echo
    echo "| Session | Phase now | Ticked | Working h | Waiting on you h | Stalled h | Nudges | Peak context | PRs merged | CI reds | Reverts | Cost ${BENCH_WINDOW_H}h | Cost to last nightly |"
    echo "|---|---|---|---|---|---|---|---|---|---|---|---|---|"
    session_rows "$t" | jq -r '
      "| \(.target) | \(.phase) | \(.ticked) | \(.working_h) | \(.waiting_h) | \(.stalled_h) | \(.nudges) | \(.peak_k)k | \(.prs_merged // "-") | \(.ci_reds // "-") | \(.reverts // "-") | \(if .cost_24h then "$\(.cost_24h)" else "-" end) | \(if .cost_usd then "$\(.cost_usd)" else "-" end) |"'
    echo
    depth_section "$t"
    echo
    session_time_section "$t"
    echo
    echo "## ETA accuracy"
    echo
    echo "Error is actual finish minus predicted (positive ran long). Ratio is actual over predicted duration."
    echo
    cmd_report | sed -n '/^ETA accuracy/,/^$/p' | sed '1d;/^$/d;s/^  /- /'
    echo
    echo "## Consolidation ledger"
    echo
    echo "Runners, timers and direct headless launches may only shrink; the baseline is ~/.config/agentctl/ledger-baseline."
    echo
    ledger_section "$counts"
  } > "$out.tmp" && mv "$out.tmp" "$out" && cp "$out" "$BENCH_SCORECARD_DIR/latest.md" || return 1
  echo "$out"
}

# forecast_section <now>: when the live work should be done and in what order, then the newest
# baseline frozen at least an hour earlier (yesterday's daily one, at the 06:45 run) against what
# happened since. Markdown bullets of the same lines forecast and vs print.
forecast_section() {
  local t="$1" f b label
  echo "## Forecast"
  echo
  echo "Every open phase scheduled from its session's newest estimate, in plan order; the slow end is the last ${BENCH_WINDOW_H}h scored ratio. Inflow and the drain come from \`fleet-bench flow\`. Formulas: the fleet-bench skill."
  echo
  if f=$(BENCH_NOW=$t cmd_forecast 2>/dev/null); then
    sed 's/^    /  - /; t; s/^  /- /' <<<"$f"
  else
    echo "- ? the forecast could not be made (fleet-bench forecast)"
  fi
  [ -s "$FORECASTS" ] || return 0
  label=$(jq -rs --argjson t "$t" 'map(select(.made_epoch <= $t - 3600 and .made_epoch >= $t - 172800)) | last | .label // empty' "$FORECASTS")
  [ -n "$label" ] || return 0
  echo
  if b=$(BENCH_NOW=$t cmd_vs "$label" 2>/dev/null); then
    sed 's/^    /  - /; t; s/^  /- /' <<<"$b"
  else
    echo "- ? baseline $label could not be compared (fleet-bench vs $label)"
  fi
}

# bottleneck_section <now>: the hours lost in the window, biggest first, and the branches behind the
# failed runs. Waited hours come from the queue length sampled every 10 minutes, and low-water hours
# from fleet-dispatch stats' under_low_water gauge, sampled the same way.
bottleneck_section() {
  local t="$1" win="${BENCH_WINDOW_H}h" pool queued low
  pool=$(prom_map pool "sum_over_time(cc:pool_waiting[$win:10m]) / 6" "$t") || pool=null
  queued=$(prom_map host "sum_over_time(cc:host_local_queued[$win:10m]) / 6" "$t") || queued=null
  low=$(prom_map topic "sum_over_time(max by (topic) (mqtt_under_low_water{topic=~\"agents_.+_summary_dispatch\"})[$win:10m]) / 6" "$t") || low=null
  echo "## Bottlenecks"
  echo
  echo "Hours lost over the last $win, from counts. The units differ, so the order says where to look first and the rows do not add up."
  echo
  jq -rn --argjson pool "$pool" --argjson queued "$queued" --argjson low "$low" --slurpfile w <(window_stats "$t") \
      --rawfile r <(runs_between $((t - BENCH_WINDOW_H * 3600)) "$t") "$JQ_LIB"'
    def hours($k): map(.[$k]) | add // 0 | . / 60;
    def top($k): map(select(.[$k] > 0)) | sort_by(-.[$k]) | .[:3] | map("\(.target) \(.[$k] / 60 | round1)h") | join(", ");
    def bad: map(select(.res != "pass"));
    ($r | run_rows) as $runs
    | ($runs | map(.s) | add // 0 | . / 3600) as $editor
    | ($runs | bad | map(.s) | add // 0 | . / 3600) as $lost
    | ($runs | bad | group_by(.branch) | map({branch: .[0].branch, not_passed: length, h: (map(.s) | add / 3600)}) | sort_by(-.h)) as $branches
    | [ (if $pool == null then {what: "Pool queues", unit: "job-hours", detail: "prometheus unreadable"}
         else $pool | to_entries[] | select(.value >= 0.1) | {what: "Pool queue: \(.key)", h: .value, unit: "job-hours", detail: "jobs waiting, sampled every 10 minutes"} end),
        (if $queued == null then {what: "Local queue", unit: "run-hours", detail: "prometheus unreadable"}
         else $queued | to_entries[] | select(.value >= 0.1) | {what: "Local queue: \(.key)", h: .value, unit: "run-hours", detail: "runs waiting for a slot"} end),
        (if $low == null then {what: "Queue under low water", unit: "hours", detail: "prometheus unreadable"}
         else ([$low[]] | max // 0) as $h | select($h >= 0.1) | {what: "Queue under low water", h: $h, unit: "hours", detail: "runnable under DISPATCH_LOW_WATER, sampled every 10 minutes"} end),
        (select($lost > 0) | {what: "Local runs not passed", h: $lost, unit: "editor-hours", detail: "of \($editor | round1)h on all local runs"}),
        {what: "Sessions waiting on you", h: ($w | hours("waiting_min")), unit: "session-hours", detail: ($w | top("waiting_min"))},
        {what: "Sessions stalled", h: ($w | hours("stalled_min")), unit: "session-hours", detail: ($w | top("stalled_min"))} ]
    | "| Bottleneck | Hours | Unit | Detail |", "|---|---|---|---|",
      (sort_by(-(.h // -1)) | .[] | "| \(.what) | \(.h // "?" | if type == "number" then round1 else . end) | \(.unit) | \(.detail) |"),
      (if ($branches | length) == 0 then empty else
        "", "Branches by editor-hours on runs not passed. A suite is one run per class, so the run count alone overstates a retry.", "",
        "| Branch | Runs not passed | Hours |", "|---|---|---|",
        ($branches[:5][] | "| \(.branch) | \(.not_passed) | \(.h | round1) |") end)'
}

# time_section <now>: where the window went per project and per plan, for reading against what the
# human said matters. There is no join yet from a hand-launched session to a row's priority.
time_section() {
  local t="$1" since=$((t - BENCH_WINDOW_H * 3600)) spend merges
  spend=$(spend_by_session "$t") || spend=null
  merges=$(merge_rows "$t" "$since")
  echo "## Where the time went"
  echo
  jq -rn --argjson since "$since" --argjson t "$t" --argjson spend "$spend" --arg m "$merges" --arg win "${BENCH_WINDOW_H}h" \
      --slurpfile w <(window_stats "$t") --rawfile r <(runs_between "$since" "$t") "$JQ_LIB"'
    def hours($k): map(.[$k]) | add // 0 | . / 60 | round1;
    def cost: if $spend == null then "-" else "$\(map($spend[.session_id] // 0) | add // 0 | round2)" end;
    ($r | run_rows) as $runs
    | ($m | split("\n") | map(select(. != "") | split("\t"))) as $rows
    | [$rows[] | select(.[0] | startswith("!")) | .[0][1:]] as $unread
    | ($rows | map(select((.[0] | startswith("!") | not) and (.[1] | tonumber) > $since and (.[1] | tonumber) <= $t)) | group_by(.[0])
       | map({key: .[0][0], value: length}) | from_entries) as $merged
    | (if $spend == null then "Agent spend: prometheus unreadable."
       else "Agent spend over \($win): $\($spend | add // 0 | round2) by the Prometheus counter, not checked against a bill; "
         + "$\(($spend | add // 0) - ($w | map($spend[.session_id] // 0) | add // 0) | round2) of it on sessions no sample saw." end),
      "",
      "| Project | Sessions | Working h | Waiting h | Stalled h | Spend | Editor h | Editor h not passed | Merges |",
      "|---|---|---|---|---|---|---|---|---|",
      ((($w | map(.project)) + ($runs | map(.repo)) + ($merged | keys) | unique | map(select(. != null))) as $ps
       | $ps[] | . as $p | ($w | map(select(.project == $p))) as $g | ($runs | map(select(.repo == $p))) as $e
       | "| \($p) | \($g | length) | \($g | hours("working_min")) | \($g | hours("waiting_min")) | \($g | hours("stalled_min")) | \($g | cost) | "
         + "\($e | map(.s) | add // 0 | . / 3600 | round1) | \($e | map(select(.res != "pass") | .s) | add // 0 | . / 3600 | round1) | "
         + "\(if ($unread | index($p)) then "?" else ($merged[$p] // 0) end) |"),
      "",
      "| Plan | Project | Sessions | Working h | Phases ticked | Spend |",
      "|---|---|---|---|---|---|",
      ($w | group_by(.plan) | map({plan: (.[0].plan | if . == "" then "(no plan)" else . end), project: .[0].project, n: length,
          work: hours("working_min"), ticked: (map(.ticked // 0) | add), cost: cost}) | sort_by(-.work) | .[:10][]
       | "| \(.plan) | \(.project) | \(.n) | \(.work) | \(.ticked) | \(.cost) |")'
}

# depth_section <now>: how each session spent itself, top spenders of tokens first. Whole sessions as
# of the last nightly, so a session the nightly has not seen is not listed.
depth_section() {
  echo "## Agent depth"
  echo
  echo "Whole sessions as of the last nightly, counted from the transcript's structure. A test run is one command, and a suite is many runs. Spent after the last edit is the share of tokens past its last commit or edit, so a high share on a long session is time spent waiting or polling."
  echo
  session_rows "$1" | jq -rs "$JQ_LIB"'
    map(select(.activity != null)) | sort_by(-.activity.tokens) | .[:15]
    | if length == 0 then "_No session in this window has been through the nightly yet._"
      else ("| Session | Test runs | Test runs per PR | CI polls | Tool calls | Tool errors | API messages | Tokens (M) | Spent after last edit |",
            "|---|---|---|---|---|---|---|---|---|",
            (.[] | .activity as $a
             | "| \(.target) | \($a.test_runs) | \(if (.prs_merged // 0) > 0 then $a.test_runs / .prs_merged | round1 else "-" end) | \($a.ci_polls) | \($a.tool_calls) | "
               + "\(if $a.tool_calls > 0 then "\((.tool_errors // 0) * 100 / $a.tool_calls | round)%" else "-" end) | \($a.api_messages) | \($a.tokens / 1000000 | round1) | "
               + "\(if (.edits // 0) > 0 and $a.tokens > 0 then "\($a.tokens_after_last_edit * 100 / $a.tokens | round)%" else "-" end) |"))
      end'
}

# session_time_section <now>: per project, where the hours of human sessions went, from `agent-panel
# time-use` by way of the nightly. Whole sessions: a long one counts all its hours the week it ends.
session_time_section() {
  echo "## Session time"
  echo
  echo "Whole sessions the nightly saw in the last $BENCH_TIME_DAYS days, hours by what was running, counted from the transcript's structure. Gate and test are commands named in ~/.config/agent-panel/time-use.conf; jobs is anything else running; parked is nothing running."
  echo
  outcomes_newest | jq -rs --argjson since $(( $1 - BENCH_TIME_DAYS * 86400 )) "$JQ_LIB"'
    def h($k): map(.time_use[$k]) | add / 60 | round1;
    map(select(.time_use != null and .runner != true and .project != "_runner" and .updated_epoch >= $since))
    | group_by(.project) | sort_by(-(map(.time_use | add) | add))
    | if length == 0 then "_No session has a time split from the nightly in this window yet._"
      else ("| Project | Sessions | Work h | Gate h | Test h | Other jobs h | You h | Parked h |",
            "|---|---|---|---|---|---|---|---|",
            (.[] | "| \(.[0].project) | \(length) | \(h("work_min")) | \(h("gate_min")) | \(h("test_min")) | \(h("jobs_min")) | \(h("human_min")) | \(h("parked_min")) |"))
      end'
}

ledger_section() {
  local counts="$1" over
  sed 's/^\(.*\)=\(.*\)$/- \1: \2/' <<<"$counts"
  if over=$(ledger_check "$counts" 2>&1); then
    echo "- baseline: held"
  else
    echo "- baseline: ${over//$'\n'/; }"
  fi
}

# merged_new <now> -> repo, number and session_id (tab-separated) for every PR session-outcomes
# says merged in the window that pr-ci.jsonl has not counted yet
merged_new() {
  local ci="$CI"
  [ -s "$ci" ] || ci=/dev/null
  outcomes_newest | jq -rs --argjson since $(( $1 - BENCH_WINDOW_H * 3600 )) --slurpfile c "$ci" "$JQ_LIB"'
    ($c | INDEX(key)) as $have
    | [.[] | .session_id as $sid | (.prs // [])[]
       | select(.state == "MERGED" and .merged_at != null)
       | select((.merged_at | fromdateiso8601) >= $since)
       | {repo, number, session_id: $sid}]
    | unique_by(key) | map(select($have[key] | not)) | .[] | [.repo, .number, .session_id] | @tsv'
}

# pr_ci <repo> <number> <session> -> its size and the CI runs on its branch from its first
# commit to merge (earlier runs are a reused branch name); red is failure, timed_out or
# startup_failure, and cancelled is superseded, not red
pr_ci() {
  local pr runs
  pr=$(gh pr view "$2" -R "$1" --json headRefName,createdAt,mergedAt,additions,deletions,commits) || return 1
  runs=$(gh run list -R "$1" --branch "$(jq -r .headRefName <<<"$pr")" --limit 100 --json conclusion,createdAt) || return 1
  jq -cn --argjson pr "$pr" --argjson runs "$runs" --arg repo "$1" --argjson n "$2" --arg sid "$3" "$JQ_LIB"'
    ([$pr.createdAt, ($pr.commits // [])[].committedDate] | map(fromdateiso8601) | min) as $start
    | ($pr.mergedAt | fromdateiso8601) as $merged
    | ($runs | map(select((.createdAt | fromdateiso8601) as $c | $c >= $start and $c <= $merged))) as $r
    | {repo: $repo, number: $n, session_id: $sid, merged_epoch: $merged, merged_at: ($merged | iso),
       additions: ($pr.additions), deletions: ($pr.deletions), ci_runs: ($r | length),
       ci_red: ($r | map(select(.conclusion | IN("failure", "timed_out", "startup_failure"))) | length)}'
}

cmd_review() {
  local t new repo num sid row n=0 red=0 msg
  mkdir -p "$DIR"
  t=$(now)
  new=$(merged_new "$t") || { report_outcome FAILED "outcomes unreadable"; return 1; }
  while IFS=$'\t' read -r repo num sid; do
    [ -n "$repo" ] || continue
    if ! row=$(pr_ci "$repo" "$num" "$sid"); then
      say "gh failed counting $repo#$num"
      report_outcome FAILED "gh failed counting CI"
      return 1
    fi
    printf '%s\n' "$row" >> "$CI"
    n=$((n + 1)); red=$((red + $(jq .ci_red <<<"$row")))
  done <<<"$new"
  if [ "$n" -eq 0 ]; then
    report_outcome NOOP "nothing new merged in the window"
    return 0
  fi
  msg="$n PRs counted, $red CI reds"
  say "$msg"
  report_outcome WORKED "$msg"
}

# ask_rows <now> -> a JSON array of pending asks, each joined to the newest sample of the
# session that posted it (its claude_session; the tmux label only for an ask that predates it): those blocking a live session first, ranked by age h x (1 + phases left
# + open PR), then the rest oldest first.
ask_rows() {
  local asks
  asks=$($BENCH_ASKS_CMD) || return 1
  jq -n --argjson t "$1" --rawfile a <(printf '%s' "$asks") --slurpfile live <(latest_live) "$JQ_LIB"'
    def tsess: sub("^[^/]*/"; "") | sub(":[0-9]+$"; "");
    [$a | split("\n")[] | select(length > 0) | split("\t")
     | {id: .[0], project: .[1], kind: .[4], question: .[5], recommend: (.[10] // ""),
        session: (if (.[15] // "") != "" then .[15] else (.[12] // "") end), age_h: (if (.[11] // "") == "" then 0 else ($t - (.[11] | ask_epoch)) / 3600 end)}
     | .session as $s
     | (if $s == "" then null
        else [$live[] | select(.session_id == $s or (.target | tsess) == $s)] | sort_by(.target) | first end) as $l
     | . + {live: ($l != null), target: ($l.target // null),
            phases_left: (if $l.phases_total == null then 0 else $l.phases_total - $l.phases_done end),
            pr: (($l.pr // "-") != "-")}
     | . + {score: (if .live then .age_h * (1 + .phases_left + (if .pr then 1 else 0 end)) else 0 end)}]
    | (map(select(.live)) | sort_by(-.score)) + (map(select(.live | not)) | sort_by(-.age_h))'
}

# asks_md <rows> -> the digest page, the same text in the terminal and in asks.md
asks_md() {
  local last="never"
  [ -s "$PROGRESS" ] && last=$(jq -rs "$JQ_LIB"'max_by(.epoch) | .epoch | hm' "$PROGRESS")
  jq -r --arg last "$last" '
    def age: if . < 48 then "\(floor)h" else "\(. / 24 | floor)d" end;
    def cell: gsub("\\|"; "\\|") | if length > 140 then .[0:140] + "..." else . end;
    def waits: [if .phases_left > 0 then "\(.phases_left) phase\(if .phases_left > 1 then "s" else "" end) left" else empty end,
                if .pr then "open PR" else empty end] | if length == 0 then "-" else join(", ") end;
    "# Pending asks",
    "",
    "\(length) pending. Sessions as sampled \($last). Ranked by age in hours x (1 + phases left + open PR); fields: the fleet-bench skill.",
    "",
    "## Blocking a live session",
    "",
    (map(select(.live)) | if length == 0 then "None." else
      "| Ask | Session | Age | Waiting | Recommend | Question |", "|---|---|---|---|---|---|",
      (.[] | "| \(.id) | \(.target) | \(.age_h | age) | \(waits) | \(.recommend | if . == "" then "-" else . end) | \(.question | cell) |")
    end),
    "",
    "## No live session behind them",
    "",
    "Headless asks and asks whose session has ended, oldest first. Answer, or cancel with `agent-ask cancel <id>` when it no longer applies.",
    "",
    (map(select(.live | not)) | if length == 0 then "None." else
      "| Ask | Project | Kind | Age | Recommend | Question |", "|---|---|---|---|---|---|",
      (.[] | "| \(.id) | \(.project) | \(.kind) | \(.age_h | age) | \(.recommend | if . == "" then "-" else . end) | \(.question | cell) |")
    end)' <<<"$1"
}

# asks_line <rows> <top-n> <max-chars> -> one plain line (comms-standard): the count, the top
# few questions with their age and recommendation, as many as fit in max-chars (the first
# always), and where to see them all. Ids and session targets stay in asks.md; the line is
# read on a lock screen and in the briefing.
asks_line() {
  jq -r --argjson k "$2" --argjson max "$3" '
    def age: if . < 48 then "\(floor)h" else "\(. / 24 | floor)d" end;
    # The first sentence is the question; the rest is context. A question is never cut:
    # one too long for the line is named by its "topic:" label (else its project) and id instead.
    def name: ((.question | capture("^(?<t>[^:?.!]{3,60}): ") | .t) // "a \(.project) question") + ", ask \(.id)";
    def q: .question | gsub("\\s+"; " ") | ((capture("^(?<s>.*?[?.!])( |$)") | .s) // .);
    def meta: " (\(.age_h | age)" + (if .recommend != "" then ", recommend \(.recommend)" else "" end) + ")";
    (map(select(.live)) | length) as $l
    | ((if length == 1 then "1 question waits on you" else "\(length) questions wait on you" end)
      + (if $l == 0 then ", none holding up a session" else ", \($l) holding up a session" end)
      + ". Top: ") as $head
    | ". List: fleet-bench asks." as $tail
    | def fits($l): ($head + ($l | join("; ")) + $tail | length) <= $max;
      reduce (.[:$k][] | [q + meta, name + meta]) as [$full, $short] ([];
        if fits(. + [$full]) then . + [$full] elif length == 0 or fits(. + [$short]) then . + [$short] else . end)
    | $head + join("; ") + $tail' <<<"$1"
}

cmd_asks() {
  local mode="${1:-}" t rows out line
  case "$mode" in ""|--write|--page) ;; *) say "usage: fleet-bench asks [--write|--page]"; return 2 ;; esac
  t=$(now)
  if ! rows=$(ask_rows "$t"); then
    say "agent-ask list failed"
    [ "$mode" = --page ] && report_outcome FAILED "agent-ask list failed"
    return 1
  fi
  [ -n "$mode" ] || { asks_md "$rows"; return 0; }
  mkdir -p "$BENCH_SCORECARD_DIR" || return 1
  out="$BENCH_SCORECARD_DIR/asks.md"
  if ! { asks_md "$rows" > "$out.tmp" && mv "$out.tmp" "$out"; }; then
    [ "$mode" = --page ] && report_outcome FAILED "asks.md not written"
    return 1
  fi
  if [ "$(jq length <<<"$rows")" = 0 ]; then
    [ "$mode" = --page ] && report_outcome NOOP "no pending asks"
    return 0
  fi
  # --write is the morning briefing's step: one item of at most 160 chars, so the top one.
  # It puts the line in its own page, so the verdict and the page belong to the briefing run.
  # The budgets are channels.toml's: a briefing item (160) and a page (300).
  [ "$mode" = --write ] && { asks_line "$rows" 1 160; return 0; }
  line=$(asks_line "$rows" 3 300)
  command -v agent-notify >/dev/null 2>&1 && agent-notify -p normal -t asks "$line"
  say "$line"
  report_outcome WORKED "$out"
}

# ---------------------------------------------------------------- ledger
#
# The consolidation ledger. Every new need used to become a new runner, timer or launch
# path, so the fleet grew while it was being consolidated. These are counts, never a
# grade. --check holds the three that may only shrink to the committed baseline: to add
# one, retire one or raise the baseline in the same PR with a why.

LEDGER_GATED="runners timers launches_direct"

# headless_launches DIR... -> file:line of every executable line that starts a headless
# claude or opencode outside agentctl-run, or calls a model's HTTP API (an OpenAI-style chat/completions or
# Anthropic /v1/messages URL) with no registered agent at all. Comments, echo lines, docs and
# tests are not call sites, and agent-run's harnesses are the launcher itself.
# git grep honours .gitignore, so 1.8G of build output under .local/src is never read;
# it works on a plain directory too. runner_contract.bats calls this through
# `ledger --launches`, so there is one scan.
headless_launches() {
  local d
  for d in "$@"; do
    [ -d "$d" ] || continue
    (cd "$d" && git grep --no-index --exclude-standard -nIiE \
      '\b(claude|claude_bin)\b[^|#]* (-p|--print)( |$|")|\bopencode run\b|[A-Za-z0-9_}]/(v1/)?chat/completions|[A-Za-z0-9_}]/v1/messages\b' \
      -- . ':!*.md' ':!tests/**' ':!**/tests/**') \
      | sed "s|^|${d%/}/|"
  done | grep -vE '^[^:]+:[0-9]+:[[:space:]]*(#|echo )' | grep -v '/agent-run/harnesses/'
}

# scheduled_runner <conf> -> the runner's name, failing for one fired by hand. fleet-liveness's
# roster: a retired runner keeps its state dir, and a conf with no SCHEDULE or AUTOSTART=yes is
# fired by hand, so neither can count as bad. The caller has already skipped KIND=call and ENABLED=no.
scheduled_runner() {
  local name
  grep -qE '^SCHEDULE=["'"'"']?[^"'"'"' ]' "$1" || grep -qE '^AUTOSTART=["'"'"']?yes' "$1" || return 1
  name=$(sed -n 's/^NAME=//p' "$1" | head -1)
  printf '%s\n' "${name:-$(basename "$1" .conf)}"
}

# ledger_counts -> key=value lines
ledger_counts() {
  local c n_conf=0 n_on=0 n_bad=0 n_call=0 t rows src sd="" name
  proof_lib && sd=$(proof_state_dir)
  for c in "$LEDGER_CONF_DIR"/*.conf; do
    [ -e "$c" ] || continue
    # A KIND=call agent is a model call its caller starts, not a runner: no unit, no timer.
    grep -qE '^KIND=["'"'"']?call' "$c" && { n_call=$((n_call + 1)); continue; }
    n_conf=$((n_conf + 1))
    grep -qE '^ENABLED=["'"'"']?no' "$c" && continue
    n_on=$((n_on + 1))
    name=$(scheduled_runner "$c") || continue
    [ -n "$sd" ] && grep -qE '^(FAILED|STALLED)' "$sd/$name/last-outcome" 2>/dev/null && n_bad=$((n_bad + 1))
  done
  echo "runners=$n_conf"
  echo "runners_on=$n_on"
  echo "runners_bad=$n_bad"
  echo "agents_call=$n_call"
  echo "timers=$(find "$LEDGER_TIMER_DIR" -maxdepth 1 -name 'agentctl-*.timer' 2>/dev/null | wc -l)"
  IFS=: read -ra src <<<"$LEDGER_SRC"
  echo "launches_direct=$(headless_launches "${src[@]}" | cut -d: -f1 | sort -u | wc -l)"
  # awk, not cat: last-outcome has no trailing newline, so cat runs every verdict into one word
  echo "verdict_words=$([ -n "$sd" ] && awk '{print $1}' "$sd"/*/last-outcome 2>/dev/null | sort -u | grep -c .)"
  t=$(now)
  # proof_report writes "why: unrecorded" on a FAILED, STALLED or BLOCKED line its runner gave no
  # reason for; this counts those of the last 24h (local times, compared as text)
  if [ -n "$sd" ]; then
    echo "failed_unexplained=$(awk -v s="$(date -d "@$((t - 86400))" +%FT%T)" \
      'substr($1, 2, 19) > s && / outcome=(FAILED|STALLED|BLOCKED) / && / why: unrecorded$/' "$sd"/*/activity.log 2>/dev/null | grep -c .)"
  else
    echo "failed_unexplained=?"
  fi
  if rows=$(ask_rows "$t" 2>/dev/null); then
    jq -r --argjson d "$ASK_STALE_DAYS" '"asks_pending=\(length)", "asks_stale=\(map(select(.age_h > $d * 24)) | length)"' <<<"$rows"
  else
    echo "asks_pending=?"; echo "asks_stale=?"
  fi
  echo "board_open=$(compgen -G "$LEDGER_BOARDS" | while IFS= read -r c; do cat "$c"; done | grep -cE '^- \[[ /]\] ')"
  echo "loop_dark=$(loop_episodes "$t" $((t - LOOP_WINDOW_S)) | jq -s 'map(select(.dark and .open)) | length')"
  chain_counts "$t"
}

# The work chain, intake -> backlog row -> queue item -> session -> PR -> merge -> closed row, as
# counts taken now; each is 0 (or 1 for a share) when every link holds. ledger_coverage and
# untracked_merged_prs: of the PRs merged in the last CHAIN_DAYS (pr-ci.jsonl), how many an item
# names (owner/repo#N, a forge URL, or a bare N by number). board_orphan_started: started agent rows
# no active item names. merged_open_rows: done items with merge proof whose row is still open.
# ownerless_running: running items with no session. epic_linked_share: the agent rows filed under
# an epic (#of/) in the projects that have one open. landed_unverified: open epics whose every leaf
# is done, waiting on proof of the outcome. doctor_fail: FAIL lines in the last notes doctor.
KPI_CHAIN="ledger_coverage untracked_merged_prs board_orphan_started merged_open_rows ownerless_running epic_linked_share landed_unverified doctor_fail"

# chain_counts <now> -> one key=value line per KPI_CHAIN entry, ? when its source cannot be read
chain_counts() {
  local t=$1 since active done board projects ci
  since=$(date -d "@$((t - (CHAIN_DAYS + 1) * 86400))" +%F)
  active=$($BENCH_ITEMS_CMD 2>/dev/null | jq -sc .) || active=null
  done=$($BENCH_DONE_ITEMS_CMD --since "$since" 2>/dev/null | jq -sc .) || done=null
  board=$($BENCH_BOARD_CMD 2>/dev/null | jq -ce '.rows | arrays') || board=null
  projects=$($BENCH_PROJECTS_CMD 2>/dev/null | jq -ce 'arrays') || projects=null
  ci=null; [ -r "$CI" ] && ci=$(jq -sc --argjson t "$t" --argjson d "$CHAIN_DAYS" \
    'map(select(.merged_epoch > $t - $d * 86400 and .merged_epoch <= $t))' "$CI")
  jq -rn --slurpfile a <(printf '%s' "$active") --slurpfile d <(printf '%s' "$done") \
     --slurpfile b <(printf '%s' "$board") --slurpfile p <(printf '%s' "$projects") \
     --slurpfile c <(printf '%s' "$ci") "$JQ_LIB"'
    def rowkey: .row // ((.from // "") | select(startswith("board:")) | ltrimstr("board:"));
    def prkeys: [.pr, .prs] | map(strings) | join(" ") | ascii_downcase
      | ([scan("([a-z0-9_.-]+/[a-z0-9_.-]+)(?:#|/pulls?/)([0-9]+)") | "\(.[0])#\(.[1])"]
         + [gsub("[a-z0-9_.-]+/[a-z0-9_.-]+(?:#|/pulls?/)[0-9]+"; " ") | scan("[0-9]+") | "#\(.)"]);
    def n($v): if $v == null then "?" else $v end;
    $a[0] as $a | $d[0] as $d | $b[0] as $b | $p[0] as $p | $c[0] as $c
    | (if $a == null or $d == null or $c == null then null
       else (($a + $d) | map(prkeys[]) | INDEX(.)) as $refs
         | {total: ($c | length),
            hit: ($c | map(select($refs["\(.repo // "" | ascii_downcase)#\(.number)"] or $refs["#\(.number)"])) | length)} end) as $cov
    | ($b // [] | map(select(.lane == "agent"))) as $agent
    | ($b // [] | map("\(.project):\(.id)") | INDEX(.)) as $open
    | ($p // [] | map(select((.epics // []) | length > 0) | .name) | INDEX(.)) as $epicked
    | ($agent | map(select($epicked[.project] and .type != "epic"))) as $linkable
    | "ledger_coverage=\(n(if $cov == null then null else ratio($cov.hit; $cov.total) end))",
      "untracked_merged_prs=\(n(if $cov == null then null else $cov.total - $cov.hit end))",
      "board_orphan_started=\(n(if $a == null or $b == null then null else ($a | map(rowkey | strings) | INDEX(.)) as $live
        | $agent | map(select(.state == "doing" and ($live["\(.project):\(.id)"] | not))) | length end))",
      "merged_open_rows=\(n(if $d == null or $b == null then null
        else $d | map(select(.merged and any(rowkey | strings; $open[.] != null))) | length end))",
      "ownerless_running=\(n(if $a == null then null
        else $a | map(select(.state == "running" and (.session // "") == "" and (.sessions // "") == "")) | length end))",
      "epic_linked_share=\(n(if $b == null or $p == null then null
        else ratio($linkable | map(select(.tags | any(startswith("of/")))) | length; $linkable | length) end))",
      "landed_unverified=\(n(if $p == null then null else [$p[] | (.epics // [])[] | select(.open == 0 and .done > 0)] | length end))"'
  if [ -r "$BENCH_DOCTOR_LAST" ]; then echo "doctor_fail=$(grep -c '^FAIL' "$BENCH_DOCTOR_LAST")"; else echo "doctor_fail=?"; fi
}

# ledger_check <counts> -> one line per gated count over the baseline; exit 1 if any, 2 if no baseline
ledger_check() {
  local k cur base bad=0
  [ -r "$LEDGER_BASELINE" ] || { say "no ledger baseline at $LEDGER_BASELINE"; return 2; }
  for k in $LEDGER_GATED; do
    cur=$(sed -n "s/^$k=//p" <<<"$1")
    base=$(sed -n "s/^$k=//p" "$LEDGER_BASELINE" | tail -1)
    [ -n "$base" ] || { say "baseline has no $k"; bad=1; continue; }
    if [ "$cur" -gt "$base" ]; then
      echo "$k grew: $cur > baseline $base"
      bad=1
    fi
  done
  return "$bad"
}

cmd_ledger() {
  local counts
  case "${1:-}" in
    --launches) shift; headless_launches "$@"; return 0 ;;
  esac
  counts=$(ledger_counts)
  case "${1:-}" in
    --json) jq -Rn '[inputs | split("=") | {key: .[0], value: (.[1] | tonumber? // .)}] | from_entries' <<<"$counts" ;;
    --check) ledger_check "$counts" ;;
    "") echo "$counts" ;;
    *) say "ledger: unknown option $1"; return 2 ;;
  esac
}

# KPIs: ratios over the human sessions session-outcomes saw in the last 7 and 28 days, the comms
# standard's 7d and 28d numbers from the nightly comms snapshot (comms-lint owns the formulas), the
# judges' from judge-eval (it owns those; ~/.local/src/docs/judges.md), plus counts taken now. Headless runs are left out: they have no human to interrupt and their
# cost is the fleet's, not a session's. Each threshold is <kpi>_max or <kpi>_min.

KPI_NOW="runners_bad failed_unexplained board_open loop_dark $KPI_CHAIN"
KPI_COMMS="buzzes_per_day comms_pass_pct rows_pass_pct"
KPI_JUDGE="judge_errors judge_precision ask_answered_pct ask_false_defer_pct ask_unclear_pct"
KPI_ASKS="human_answered_per_day ask_wait_p90_min"

# comms_kpi -> the comms snapshot's KPI object, or {} when there is none or it is stale, so both
# KPIs show - rather than an old number
comms_kpi() { $BENCH_COMMS_CMD kpi --json 2>/dev/null | jq -ce 'objects' 2>/dev/null || echo '{}'; }
# judge_kpi -> judge-eval's KPI object, the same shape, or {} when it cannot score
judge_kpi() { $BENCH_JUDGE_CMD kpi --json 2>/dev/null | jq -ce 'objects' 2>/dev/null || echo '{}'; }
# ask_kpi <now> -> the ask KPIs, the same shape, or {} when agent-ask cannot be read.
# human_answered_per_day: asks the human answered in the window, a day. An answer with no answered_by
# is an in-session capture from before the field existed, so the human's.
# ask_wait_p90_min: p90 minutes from post to answer or close over the asks posted in the window, a
# pending one counted to now, so an ask nobody answers raises it (this replaced asks_stale).
# A cancelled ask was withdrawn by its asker and waited on no one.
ask_kpi() {
  local asks
  asks=$($BENCH_ASKS_ALL_CMD 2>/dev/null) || { echo '{}'; return 0; }
  jq -nc --argjson t "$1" --rawfile a <(printf '%s' "$asks") "$JQ_LIB"'
    def p90: sort | if length == 0 then null else .[(length * 0.9 | ceil) - 1] end;   # nearest rank
    [$a | split("\n")[] | select(length > 0) | split("\t")
     | {status: .[3], by: (.[17] // ""), c: (.[11] // ""), a: (.[8] // ""), x: (.[13] // "")}
     | select(.c != "")
     | .c |= ask_epoch | .a |= (if . == "" then null else ask_epoch end)
     | .x |= (if . == "" then null else ask_epoch end)] as $r
    | def w($d): ($t - $d * 86400) as $s
        | {human_answered_per_day: ([$r[] | select(.status == "answered" and (.by == "" or .by == "human")
                                                  and .a != null and .a > $s and .a <= $t)] | length / $d | round1),
           ask_wait_p90_min: ([$r[] | select(.status != "cancelled" and .c > $s and .c <= $t)
                               | (([.a // .x // $t, $t] | min) - .c) / 60] | p90 | if . == null then null else round end)};
    w(7) as $x | w(28) as $y | $x | keys_unsorted | map({(.): {"7d": $x[.], "28d": $y[.]}}) | add'
}

# KPI_DEFS: the windowed KPIs as jq, shared by kpi, its --trend and effect. win($t; $d) is every
# ratio over the human sessions whose last update fell in the $d days up to $t, with $o the outcome
# rows and $c the CI rows (slurped). Older lines have no runner field; _runner is where headless
# runs are filed.
KPI_DEFS="$JQ_LIB"'
  def total(f): map(f // 0) | add // 0;
  def bots: $o | map(select(.runner == true or .project == "_runner") | .session_id) | INDEX(.);
  def win($t; $d): bots as $bot | ($t - $d * 86400) as $since
    | ($o | map(select(($bot[.session_id] | not) and .updated_epoch != null
                       and .updated_epoch > $since and .updated_epoch <= $t))) as $s
    | ($c | map(select(.merged_epoch > $since and .merged_epoch <= $t and ($bot[.session_id // ""] | not)))) as $ci
    | ($s | total(.prs_merged)) as $prs
    | {sessions: ($s | length), prs_per_session: ratio($prs; $s | length),
       revert_rate: ratio(($s | total(.reverted_7d)); $prs),
       interrupts_per_session: ratio(($s | total(.corrections.interrupts)); $s | length),
       cost_per_pr: ratio(($s | total(.cost_usd)); $prs),
       ci_red_per_pr: ratio(($ci | total(.ci_red)); $ci | length),
       plan_gate_deny_rate: ratio(($s | total(.plan_gate.denied)); $s | total(.plan_gate.exits))};
  # which way is better: -1 lower, 1 higher, 0 neither (sessions is volume, not quality)
  def better: {sessions: 0, prs_per_session: 1, revert_rate: -1, interrupts_per_session: -1,
               cost_per_pr: -1, ci_red_per_pr: -1, plan_gate_deny_rate: -1};'

# kpi_ci -> the CI rows file, or /dev/null when there are none
kpi_ci() { [ -s "$CI" ] && printf '%s' "$CI" || printf /dev/null; }

# kpi_json <now> <ledger counts> [historic] -> one object keyed by KPI, in table order. historic=1
# (kpi --at) leaves the comms and the counted-now KPIs null: nothing records them as of a past time.
kpi_json() {
  local lim='{}' cm='{}'
  [ -r "$KPI_THRESHOLDS" ] && lim=$(grep -E '^[a-z0-9_]+=' "$KPI_THRESHOLDS" | kv_json)
  [ "${3:-0}" = 1 ] || cm=$(jq -sc 'add' <(comms_kpi) <(judge_kpi) <(ask_kpi "$1"))
  jq -n --argjson t "$1" --slurpfile o <(outcomes_newest) --slurpfile c "$(kpi_ci)" \
     --argjson pit "$(kv_json <<<"$2")" --argjson lim "$lim" --arg nowkeys "$KPI_NOW" \
     --argjson cm "$cm" --arg commskeys "$KPI_COMMS $KPI_JUDGE $KPI_ASKS" "$KPI_DEFS"'
    win($t; 7) as $w7 | win($t; 28) as $w28
    | [($w7 | keys_unsorted[] | {key: ., value: {"7d": $w7[.], "28d": $w28[.], now: false}}),
       ($commskeys | split(" ")[] | {key: ., value: {"7d": ((($cm[.] // {})["7d"] | numbers) // null),
                                                     "28d": ((($cm[.] // {})["28d"] | numbers) // null), now: false}}),
       ($nowkeys | split(" ")[] | {key: ., value: {"7d": (($pit[.] | numbers) // null), "28d": null, now: true}})]
    | map(.key as $k | .value |= (
        (($lim[$k + "_max"] | numbers) // null) as $max | (($lim[$k + "_min"] | numbers) // null) as $min
        | . + {threshold: ($max // $min),
               bound: (if $max != null then "max" elif $min != null then "min" else null end)}
        | . + {status: (if .threshold == null or .["7d"] == null then "-"
                        elif (.bound == "max" and .["7d"] > .threshold)
                          or (.bound == "min" and .["7d"] < .threshold) then "past"
                        else "ok" end)}))
    | from_entries'
}

# kpi_trend <now> <days> -> one object a day, oldest first: {date, <kpi>: its 7d value as of that
# day's end}. The outcome rows are the history, so a trend needs no store of its own.
kpi_trend() {
  jq -nc --argjson t "$1" --argjson n "$2" --slurpfile o <(outcomes_newest) --slurpfile c "$(kpi_ci)" "$KPI_DEFS"'
    range($n - 1; -1; -1) as $i | ($t - $i * 86400) as $at
    | {date: ($at | strflocaltime("%Y-%m-%d"))} + win($at; 7)'
}

# kv_json -> key=value lines on stdin as one object; a value that is not a number is null
kv_json() { jq -Rn '[inputs | select(length > 0) | split("=") | {key: .[0], value: (.[1] | tonumber? // null)}] | from_entries'; }

# kpi_table <kpi json> -> the markdown table kpi prints and the scorecard carries
kpi_table() {
  jq -r '"| KPI | 7d | 28d | threshold | status |", "|---|---|---|---|---|",
    (to_entries[] | .value as $v
     | "| \(.key)\(if $v.now then " (now)" else "" end) | \($v["7d"] // "-") | \($v["28d"] // "-") | \(if $v.bound then "\($v.bound) \($v.threshold)" else "-" end) | \($v.status) |")' <<<"$1"
}

# wakes_lines -> the calls-per-wake lines under the KPI table, from `agent-usage wakes` over the
# scorecard window. Each API call re-reads the session's whole context, so calls per wake is the cost.
# A background-task wake whose run passed has nothing left to decide: its target is WAKE_CALLS_TARGET.
# queue_stats <now>: agent-queue's own stats over the last BENCH_QUEUE_DAYS days, or a failure
# when it cannot be read. agent-queue owns the store and the formulas; this only reads them.
queue_stats() {
  local since
  since=$(date -d "@$(( $1 - BENCH_QUEUE_DAYS * 86400 ))" +%F)
  $BENCH_QUEUE_STATS_CMD --since "$since" 2>/dev/null | jq -ce 'select(.done and .by_project)' 2>/dev/null
}

# queue_line < stats: the window in one line (the briefing prints it as is)
queue_line() {
  jq -r --argjson days "$BENCH_QUEUE_DAYS" '
    def m($v): if $v == null then "-" elif $v >= 120 then "\($v / 60 | floor)h" else "\($v)m" end;
    ([.done[]] | add // 0) as $n
    | "queue \($days)d: \($n) done (\(.done.ok // 0) ok, \(.done.failed // 0) failed, \(.done.cancelled // 0) cancelled), "
      + "\([.by_project[].prs] | add // 0) with a PR, \($n / $days * 10 | round / 10)/day, "
      + "wait median \(m(.wait_minutes_median)) p90 \(m(.wait_minutes_p90)) (\(.started_at_once // 0) started at once), "
      + "to PR median \(m(.to_pr_minutes_median))"
      + (.sitting | if . == null then "" else "; sitting: \(.runnable) can start, oldest \(m(.oldest_runnable[0].minutes)), \(.held) held" end)'
}

cmd_queue() {
  local s
  case "${1:-}" in ""|--json) ;; *) say "usage: fleet-bench queue [--json]"; return 2 ;; esac
  s=$(queue_stats "$(now)") || { say "agent-queue stats unreadable"; return 1; }
  if [ "${1:-}" = --json ]; then printf '%s\n' "$s"; else queue_line <<<"$s"; fi
}

# Items in, with $sessions (the state document's rows), $etas (a cell per target) and $since:
# the requests. A request is an urgent item from the human or the shepherd; `<prefix>-pN` items
# linked by after: are one request, and n of m reads their phase numbers, so a plan queued from
# phase 3 says 3 of 6. The shepherd's own intake leads, each group in queue order: sorted by source
# alone a morning of human-queued items would bury the ask, and newest first would let the next ask
# bury it (ci-cleanup fell to third within the hour).
REQUESTS_JQ='
def prefix: sub("-p[0-9]+$"; "");
def pnum: (capture("-p(?<n>[0-9]+)$").n | tonumber) // null;
def asked: .priority == "urgent" and (.from == "human" or .from == "shepherd");
def live: .state != "done";
def open: any(.[]; live and asked);
def keyed: . as $all | map(. as $i | ($i.slug | prefix) as $p
  | . + {key: (if any($all[]; (.slug == $i.after or .after == $i.slug) and (.slug | prefix) == $p)
               then $p else $i.slug end)});
def session_row($c): ($c.session // "" | (if test(":") then sub(":"; "/") else "lab/" + . end) + ":") as $at
  | ($sessions[0] | map(select(.target | startswith($at)))) as $rows
  | ($rows | map(select((.dispatch // "") | endswith(": " + $c.slug))) | first)
    // (if ($rows | length) == 1 then $rows[0] else null end);
def active_row: sort_by(.slug | pnum // 0) as $c
  | ($c | map(select(live)) | sort_by(.state == "queued") | first) as $cur
  | session_row($cur) as $s
  | ([$c[].slug | pnum] + [$c[] | (.phases // "") | split(" ")[] | tonumber?] | max) as $m
  | {request: $c[0].key, slugs: ($c | map(.slug)), project: $cur.project, from: $cur.from,
     queued: $cur.queued, slug: $cur.slug, n: ($cur.slug | pnum), m: $m, state: $cur.state,
     session: $cur.session, bucket: $s.bucket,
     pr: (if $s.pr_state == "OPEN" then $s.pr else null end), ci: (if $s.pr_state == "OPEN" then $s.ci else null end),
     eta: (if $s == null then null else $etas[0][$s.target] end),
     waits: (if $cur.state == "queued" then $cur.hold // "a dispatch slot"
             elif $s != null and $s.bucket != "WORKING" then $s.reason | sub("^waiting on "; "") else null end),
     report: ([$c[].report // empty] | last)};
def finished_row: sort_by(.finished) as $c
  | {request: $c[0].key, slugs: ($c | map(.slug)), project: $c[0].project, from: $c[0].from,
     finished: $c[-1].finished,
     outcome: (($c | map(.status // "unknown" | select(. != "ok")) | first) // "ok"),
     prs: ($c | map(.pr // empty)), report: ([$c[].report // empty] | last)};
group_by(.slug) | map(sort_by(live, .finished) | last) | keyed | group_by(.key)
| {since: $since,
   active: (map(select(open) | active_row)
            | sort_by(.from != "shepherd", .queued)),
   finished: (map(select(open | not) | map(select(.state == "done" and asked
                and (.finished // "1970-01-01T00:00:00Z" | fromdateiso8601) >= $since))
                | select(length > 0) | finished_row) | sort_by(.finished) | reverse)}
'

# The rows as the block that heads a summary. Every fact it cannot read stays out of its row.
REQUESTS_TEXT_JQ='
def cell($label; $v): if $v == null then empty else "\($label)\($v)" end;
"## Your requests", "",
(if (.active | length) == 0 then "No urgent request is active."
 else .active[] | "- " + ([.request,
     (if .n == null then empty else "\(.n) of \(.m)" end),
     (.state + (if .bucket == null then "" else "/\(.bucket)" end)),
     cell(""; .session),
     (if .pr == null then "no open PR" else "PR #\(.pr) CI \(.ci // "not read")" end),
     (if .eta == null then "no ETA" else "ETA \(.eta)" end),
     cell("waits on: "; .waits), cell("report: "; .report)] | join(", ")) end),
"", "Finished since \(.since | hm):",
(if (.finished | length) == 0 then "- nothing"
 else .finished[] | "- " + ([.request, .outcome,
     (if (.prs | length) == 0 then "no PR" else (.prs | map("#\(.)") | join(" ")) end),
     (.finished | fromdateiso8601 | hm), cell("report: "; .report)] | join(", ")) end)
'

# cmd_requests [--json] [--since T]: the human's requests, from the queue, the fleet state document
# and the ETAs. T defaults to the last rundown, so a finished request is told once.
cmd_requests() {
  local json=0 since='' t items first done_items sessions='[]' etas last out
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --since) since=$(throughput_epoch "${2:-}") || return 2; shift 2 ;;
      *) say "usage: fleet-bench requests [--json] [--since T]"; return 2 ;;
    esac
  done
  t=$(now)
  if [ -z "$since" ]; then
    last=$(ls -t "$RUNDOWNS"/*.md 2>/dev/null | head -1)
    if [ -n "$last" ]; then since=$(stat -c %Y "$last"); else since=$((t - BENCH_WINDOW_H * 3600)); fi
  fi
  items=$($BENCH_ITEMS_CMD) || { say "the agent queue is unreadable"; return 1; }
  # Done items go back to the oldest live chain as well as to T: an earlier phase holds its report.
  first=$(jq -rs --argjson s "$since" '[$s] + [.[] | select(.priority == "urgent" and .after != null) | .queued | fromdateiso8601] | min' <<<"$items")
  done_items=$($BENCH_DONE_ITEMS_CMD --since "$(date -d "@$first" +%F)") || { say "the agent queue's done items are unreadable"; return 1; }
  [ -r "$STATE_FILE" ] && sessions=$(jq -c '.sessions // []' "$STATE_FILE")
  etas=$(latest_live | jq -cs "$JQ_LIB"'map(select(.eta != null or .finished)
    | {key: .target, value: (if .finished then "finished" else eta_cell end)}) | from_entries')
  out=$(printf '%s\n%s\n' "$items" "$done_items" | jq -cs --argjson since "$since" \
    --slurpfile sessions <(printf '%s\n' "$sessions") --slurpfile etas <(printf '%s\n' "$etas") "$REQUESTS_JQ") || return 1
  if [ "$json" = 1 ]; then printf '%s\n' "$out"; else jq -r "$JQ_LIB$REQUESTS_TEXT_JQ" <<<"$out"; fi
}

# queue_section <now>: the queue line, what is active now, and the outcomes by project and by
# source (human, shepherd, board, ...), in the scorecard
queue_section() {
  local s
  echo "## Queue"
  echo
  s=$(queue_stats "$1") || { echo "- queue ${BENCH_QUEUE_DAYS}d: ? (\`agent-queue stats\` unreadable)"; return 0; }
  echo "Items agent-queue finished in the last ${BENCH_QUEUE_DAYS} days, from its own timestamps (\`agent-queue stats\`). Wait is queued to started; to PR is queued to finished, for items that recorded a PR."
  echo
  jq -r 'def l: to_entries | map("\(.key) \(.value)") | join(", ") | if . == "" then "none" else . end;
    "- active now: \(.active | l)", "- per day: \(.per_day | l)"' <<<"$s"
  queue_line <<<"$s" | sed 's/^/- /'
  local by
  for by in project source; do
    echo
    echo "| ${by^} | Done | OK | Failed | Cancelled | PRs | Wait median | To PR median |"
    echo "|---|---|---|---|---|---|---|---|"
    jq -r --arg k "by_$by" 'def m($v): if $v == null then "-" else "\($v)m" end;
      .[$k] | to_entries | sort_by(-.value.done, .key)[] | .key as $n | .value
      | "| \($n) | \(.done) | \(.ok) | \(.failed) | \(.cancelled) | \(.prs) | \(m(.wait_minutes_median)) | \(m(.to_pr_minutes_median)) |"' <<<"$s"
  done
}

# models_json <now>: per model and harness (the item's agent, claude when unset), the queue items
# finished in the last BENCH_QUEUE_DAYS days (the model= fleet-dispatch stamped at start) joined to
# their sessions' outcomes (cost_usd, reverts), and model-lane's runs in the same days by the model
# and harness they ran on (redo). Landed is done ok with a PR; a cancel counts against no pairing.
# An item's gateway_cost_usd beats its sessions' sum: one is metered dollars, the other a list-price
# estimate. A session counts once per row, however many items of a chain it ran. source says which
# a row's cost is, and mixed means it holds both. cost_per_pr divides by priced, the landed items with a known cost: a landed item with none would pass as free and pull
# the row under pairings that are fully priced. This is the evidence a lane graduates or demotes on.
models_json() {
  local since; since=$(( $1 - BENCH_QUEUE_DAYS * 86400 ))
  jq -cn --argjson days "$BENCH_QUEUE_DAYS" --argjson since "$since" \
     --slurpfile items <($BENCH_DONE_ITEMS_CMD --since "$(date -d "@$since" +%F)" 2>/dev/null) \
     --slurpfile outcomes <(outcomes_latest) \
     --slurpfile runs <(jq -c 'select(.id and .ts)' "$BENCH_LANE_LOG" 2>/dev/null) '
    def ratio($a; $b): if $b > 0 then ($a / $b * 100 | round / 100) else null end;
    def sids: (.sessions // "") | split(" ") | map(select(. != ""));
    def landed: .status == "ok" and (.pr // "") != "";
    def metered: (.gateway_cost_usd // "") != "";
    ($outcomes[0] // {}) as $o
    | ($items | map(select(.status != "cancelled") | . + {m: (.model // "unrecorded"), h: (.agent // "claude")})) as $done
    | ($runs | map(select((.ts | sub("\\+00:00$"; "Z") | fromdateiso8601) >= $since) | . + {h: (.harness // "claude")})) as $rs
    | ([$done[] | [.m, .h]] + [$rs[] | [.ran, .h]] | unique) as $pairs
    | {days: $days, models: ($pairs | map(. as [$m, $h]
        | ($done | map(select(.m == $m and .h == $h))) as $it
        | ($it | map(select(landed)) | length) as $landed
        | ($it | map(sids[]) | unique | map($o[.] // empty)) as $sess
        | ($it | map({landed: landed, source: (if metered then "gateway" elif any(sids[]; $o[.] != null) then "list" else null end)})) as $priced_items
        | ($rs | map(select(.ran == $m and .h == $h))) as $r
        | ($r | map(select(.outcome)) | length) as $rated
        | ($r | map(select(.outcome == "redo")) | length) as $redo
        | (($it | map(select(metered) | .gateway_cost_usd | tonumber) | add // 0)
           + ($it | map(select(metered | not) | sids[]) | unique | map($o[.].cost_usd // 0) | add // 0)) as $cost
        | ($priced_items | map(.source // empty) | unique) as $src
        | ($priced_items | map(select(.landed and .source)) | length) as $priced
        | {model: $m, harness: $h, done: ($it | length), landed: $landed, landed_rate: ratio($landed; $it | length),
           failed: ($it | map(select(.status == "failed")) | length),
           runs: ($r | length), rated: $rated, redo: $redo, redo_rate: ratio($redo; $rated),
           reverts: ($sess | map(.reverted_7d // 0) | add // 0),
           cost_usd: ($cost * 100 | round / 100), priced: $priced, cost_per_pr: (if $priced > 0 then ($cost / $priced * 100 | round / 100) else null end),
           source: (if ($src | length) > 1 then "mixed" else ($src[0] // "-") end)}))}'
}

# models_section <now>: the models table, in the scorecard
models_section() {
  local j
  echo "## Models"
  echo
  echo "Queue items finished in the last ${BENCH_QUEUE_DAYS} days by the model and harness they started on, joined to their sessions' outcomes; redo is model-lane's runs on that pairing that were put back in the queue (\`model-lane report\`). Landed is done ok with a PR. Source says what a cost is: list is an estimate at list price, not money paid; gateway is dollars metered at the LiteLLM gateway; mixed holds both. Per PR counts only PRs with a known cost. Counts, not a winner: pairings ran different tasks."
  echo
  j=$(models_json "$1") || { echo "- models: ? (queue or outcomes unreadable)"; return 0; }
  echo "| Model | Harness | Done | Landed | Rate | Failed | Redo | Reverts | Cost | Per PR | Source |"
  echo "|---|---|---|---|---|---|---|---|---|---|---|"
  jq -r 'def d: if . == null then "-" else tostring end;
    .models | sort_by(-.done)[]
    | "| \(.model) | \(.harness) | \(.done) | \(.landed) | \(.landed_rate | d) | \(.failed) | \(.redo) | \(.reverts) | $\(.cost_usd) | \(if .cost_per_pr == null then "-" else "$\(.cost_per_pr)" end) | \(.source) |"' <<<"$j"
}

cmd_models() {
  local j
  case "${1:-}" in ""|--json) ;; *) say "usage: fleet-bench models [--json]"; return 2 ;; esac
  j=$(models_json "$(now)") || { say "the queue or the outcomes are unreadable"; return 1; }
  if [ "${1:-}" = --json ]; then printf '%s\n' "$j"; else models_section "$(now)" | sed '1,4d'; fi
}

wakes_lines() {
  local w win="${BENCH_WINDOW_H}h"
  w=$($BENCH_WAKES_CMD --since "$win" --json 2>/dev/null) && jq -e .all <<<"$w" >/dev/null 2>&1 \
    || { echo "- calls per passing wake ($win): ? (\`agent-usage wakes\` unreadable)"; echo "- calls per wake, all ($win): ?"; return 0; }
  jq -r --argjson target "$WAKE_CALLS_TARGET" --arg win "$win" '
    (.rows | map(select(.trigger == "background-task" and .verdict == "pass")) | first) as $p
    | (if $p == null then "- calls per passing wake (\($win)): - (no passing background-task wake)"
       else "- calls per passing wake (\($win)): median \($p.median) over \($p.wakes) wakes, target \($target) or fewer: \(if $p.median > $target then "past" else "ok" end)" end),
      "- calls per wake, all (\($win)): " + (if .all.wakes == 0 then "-"
        else "median \(.all.median), p90 \(.all.p90) over \(.all.wakes) wakes" end)' <<<"$w"
}

# report_line <command> <label>: one scorecard row another tool writes (the nightly token-usage
# row, the newest stored week from day-log).
report_line() {
  local l
  l=$($1 2>/dev/null) && [ -n "$l" ] || l="$2: ? (\`$1\` unreadable)"
  echo "- $l"
}

cmd_kpi() {
  local json=0 at='' trend='' t
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      --at) at="${2:?--at needs a time}"; shift ;;
      --trend) trend="${2:?--trend needs a day count}"; shift ;;
      *) say "usage: fleet-bench kpi [--json] [--at T | --trend DAYS]"; return 2 ;;
    esac
    shift
  done
  t=$(now)
  [ -z "$at" ] || t=$(throughput_epoch "$at") || { say "kpi: cannot read the time $at"; return 2; }
  if [ -n "$trend" ]; then
    [[ "$trend" =~ ^[1-9][0-9]*$ ]] || { say "kpi: --trend takes a day count"; return 2; }
    local rows; rows=$(kpi_trend "$t" "$trend") || return 1
    if [ "$json" = 1 ]; then printf '%s\n' "$rows"; return 0; fi
    jq -rs '(.[0] | keys_unsorted) as $k | ($k | join(" | ") | "| \(.) |"), ($k | map("---") | join("|") | "|\(.)|"),
      (.[] | [.[$k[]] | if . == null then "-" else tostring end] | join(" | ") | "| \(.) |")' <<<"$rows"
    return 0
  fi
  if [ -n "$at" ]; then t=$(kpi_json "$t" "" 1); else t=$(kpi_json "$t" "$(ledger_counts)"); fi || return 1
  if [ "$json" = 1 ]; then jq -c . <<<"$t"; else kpi_table "$t"; fi
}

# chain [--json|--check] -- the KPI_CHAIN rows of the KPI table, counted now. --check prints one
# line per chain KPI past its threshold and exits 1 when any is: the board-chain watch's probe.
cmd_chain() {
  local t json
  case "${1:-}" in ""|--json|--check) ;; *) say "usage: fleet-bench chain [--json|--check]"; return 2 ;; esac
  t=$(now)
  json=$(kpi_json "$t" "$(chain_counts "$t")" | jq -c --arg k "$KPI_CHAIN" '($k | split(" ")) as $ks | with_entries(select(.key | IN($ks[])))') || return 1
  case "${1:-}" in
    --json) printf '%s\n' "$json" ;;
    --check) jq -re 'to_entries | map(select(.value.status == "past")
        | "\(.key) \(.value["7d"]) (\(.value.bound) \(.value.threshold))") | if length == 0 then empty else .[] end' <<<"$json" && return 1
      return 0 ;;
    *) kpi_table "$json" ;;
  esac
}

# effect <T | owner/repo#N> [--days N] [--json] -- what changed after a change landed: each windowed
# KPI over the N days (BENCH_EFFECT_DAYS, 14) up to T against the N days after it. A PR is read as
# its merge time. Verdict per KPI: improved or regressed when it moved more than BENCH_EFFECT_FLAT
# (10%) the way better says, flat inside that, pending until the after window has ended, - when
# either side has no value. Many changes land in any window, so a verdict is a lead to look at,
# never proof one change did it.
cmd_effect() {
  local ref='' days="$BENCH_EFFECT_DAYS" json=0 t info
  while [ $# -gt 0 ]; do
    case "$1" in
      --days) days="${2:?--days needs a count}"; shift ;;
      --json) json=1 ;;
      -*) say "usage: fleet-bench effect <T | owner/repo#N> [--days N] [--json]"; return 2 ;;
      *) ref="$1" ;;
    esac
    shift
  done
  [ -n "$ref" ] || { say "usage: fleet-bench effect <T | owner/repo#N> [--days N] [--json]"; return 2; }
  [[ "$days" =~ ^[1-9][0-9]*$ ]] || { say "effect: --days takes a day count"; return 2; }
  if [[ "$ref" == */*#* ]]; then
    info=$(gh pr view "${ref##*#}" -R "${ref%#*}" --json mergedAt -q '.mergedAt // ""' 2>/dev/null) ||
      { say "effect: gh cannot read $ref"; return 1; }
    [ -n "$info" ] || { say "effect: $ref is not merged"; return 1; }
    t=$(date -d "$info" +%s)
  elif [[ "$ref" =~ ^[0-9]{1,9}$ ]]; then
    say "effect: $ref reads as a PR number; give it as owner/repo#$ref"; return 2
  else
    t=$(throughput_epoch "$ref") || { say "effect: cannot read the time $ref"; return 2; }
  fi
  local out
  out=$(jq -n --argjson t "$t" --argjson d "$days" --argjson now "$(now)" --argjson flat "$BENCH_EFFECT_FLAT" \
        --arg ref "$ref" --slurpfile o <(outcomes_newest) --slurpfile c "$(kpi_ci)" "$KPI_DEFS"'
    win($t; $d) as $b | win($t + $d * 86400; $d) as $a | ($now >= $t + $d * 86400) as $done
    | {ref: $ref, at: ($t | todate), days: $d, kpis: [$b | keys_unsorted[] as $k | better[$k] as $dir
        | {kpi: $k, before: $b[$k], after: (if $done then $a[$k] else null end),
           verdict: (if ($done | not) then "pending"
                     elif $b[$k] == null or $a[$k] == null or $dir == 0 then "-"
                     else (if $b[$k] == 0 then (if $a[$k] == 0 then 0 else ($a[$k] | if . > 0 then 1 else -1 end) end)
                           else ($a[$k] - $b[$k]) / ($b[$k] | fabs) end) as $rel
                     | if ($rel | fabs) <= $flat then "flat" elif $rel * $dir > 0 then "improved" else "regressed" end end)}]}') || return 1
  if [ "$json" = 1 ]; then jq -c . <<<"$out"; return 0; fi
  jq -r '"effect of \(.ref) at \(.at), \(.days)d before vs after:", "| KPI | before | after | verdict |", "|---|---|---|---|",
    (.kpis[] | "| \(.kpi) | \(.before // "-") | \(.after // "-") | \(.verdict) |")' <<<"$out"
}

# retro_rows <kpi json> -> key, row text and priority (tab-separated) for each KPI past its
# threshold; more than 2x past it is #high
retro_rows() {
  jq -r 'to_entries[] | select(.value.status == "past") | .key as $k | .value
    | (if .bound == "max" then .["7d"] > 2 * .threshold else .["7d"] < .threshold / 2 end) as $far
    | "check(kpi): \($k) past threshold" as $key
    | [$key, "\($key): "
        + (if .now then "now \(.["7d"]) (\(.bound) \(.threshold))"
           else "7d \(.["7d"]) (28d \(.["28d"] // "-"), \(.bound) \(.threshold))" end),
       (if $far then "#high" else "#low" end)] | @tsv' <<<"$1"
}

# One open row per KPI, folded by its title prefix: the numbers are refreshed in place, and
# rows for a KPI back inside its threshold are left for whoever owns them.
# retro_guard_rows -> one "check(lesson): guard <hash>:<TAB>text<TAB>priority" line per lesson whose sig
# (so_lesson_sigs) hit in BENCH_GUARD_RECUR or more sessions after it was written: a lesson the
# fleet keeps relearning wants a hook, test or lint, and the lesson goes once that lands.
retro_guard_rows() {
  local sigs sig claim since file n h key
  # shellcheck source=/dev/null
  . "$BENCH_SO_LIB" || return 1
  sigs=$(so_lesson_sigs) || return 1
  jq -r --argjson min "$BENCH_GUARD_RECUR" --slurpfile o <(outcomes_newest) '
    .[] as $s | ([$o[] | select(((.lesson_hits // {})[$s.sig] // 0) > 0)] | length) as $n
    | select($n >= $min) | [$s.sig, $s.claim, $s.since, $s.file, $n] | @tsv' <<<"$sigs" |
  while IFS=$'\t' read -r sig claim since file n; do
    h=$(printf '%s' "$sig" | sha1sum | cut -c1-8)
    key="check(lesson): guard $h:"
    printf '%s\t%s lesson "%s" (%s, %s) recurred in %s sessions; make it a hook, test or lint, then delete the lesson\t%s\n' \
      "$key" "$key" "$claim" "$file" "$since" "$n" "$( [ "$n" -ge $((BENCH_GUARD_RECUR * 2)) ] && echo '#high' || echo '#low')"
  done
}

# retro keeps exactly one open agent-board row per finding, keyed by its prefix: a KPI past its
# threshold (`check(kpi): <k> past threshold`) or a lesson that keeps recurring
# (`check(lesson): guard <hash>:`). A row whose numbers moved is edited in place; one that
# matches writes nothing. An add that exits 3 found the row already open (a near-dup), so it
# counts as filed.
cmd_retro() {
  local json rows='' grows why=()
  if [ -r "$KPI_THRESHOLDS" ]; then
    json=$(kpi_json "$(now)" "$(ledger_counts)") || { report_outcome FAILED "kpi unreadable"; return 1; }
    rows=$(retro_rows "$json")
    [ -n "$rows" ] || why+=("every KPI inside its threshold")
  else
    say "no KPI thresholds at $KPI_THRESHOLDS; retro checks no KPI"
    why+=("no KPI thresholds file")
  fi
  grows=$(retro_guard_rows) || { report_outcome FAILED "lesson sigs unreadable"; return 1; }
  [ -n "$grows" ] || why+=("no lesson recurred")
  rows=$(printf '%s\n%s\n' "$rows" "$grows" | grep .)
  if [ -z "$rows" ]; then
    say "${why[*]}"
    report_outcome NOOP "$(IFS=';'; echo "${why[*]}")"
    return 0
  fi
  board_upsert "$rows" || return 1
  upsert_report "$rows"
}

# board_upsert <rows: key TAB text TAB priority, one a line> keeps exactly one open agent-board
# row per key, matched as a lowercase title prefix: a row whose text moved is edited in place, one
# that matches writes nothing, and an add that exits 3 found its twin already open (a near-dup), so
# it counts as filed. A row whose condition cleared is left for whoever owns it. Every row is
# #size/s. Leaves the counts in UPSERT_ADDED and UPSERT_EDITED; FAILED is reported here.
board_upsert() {
  local board p text pri have rc added=0 edited=0
  UPSERT_ADDED=0; UPSERT_EDITED=0
  board=$($BENCH_NOTES_CMD ptask "$KPI_BOARD" --agent list) || { report_outcome FAILED "$KPI_BOARD agent board unreadable"; return 1; }
  while IFS=$'\t' read -r p text pri; do
    text+=" #size/s"
    have=$(awk -F'\t' -v p="${p,,}" 'index($3, p) == 1 { print $3; exit }' <<<"$board")
    if [ -z "$have" ]; then
      rc=0
      $BENCH_NOTES_CMD ptask "$KPI_BOARD" --agent add "$text $pri" >/dev/null || rc=$?
      case $rc in
        0) added=$((added + 1)) ;;
        3) ;;
        *) report_outcome FAILED "add failed for $p"; return 1 ;;
      esac
    elif [ "$have" != "${text,,}" ]; then
      $BENCH_NOTES_CMD ptask "$KPI_BOARD" --agent edit "$p" --text "$text" >/dev/null \
        || { report_outcome FAILED "edit failed for $p"; return 1; }
      edited=$((edited + 1))
    fi
  done <<<"$1"
  UPSERT_ADDED=$added; UPSERT_EDITED=$edited
}

# upsert_report <rows> [more]: the one line and the outcome after board_upsert; NOOP when it wrote nothing
upsert_report() {
  local did="$UPSERT_ADDED added, $UPSERT_EDITED refreshed${2:+, $2}"
  say "$(grep -c . <<<"$1") rows due: $did"
  if [ $((UPSERT_ADDED + UPSERT_EDITED)) -eq 0 ] && [ -z "${2:-}" ]; then
    report_outcome NOOP "every row already current"
  else
    report_outcome WORKED "$did"
  fi
}

# triage_rows -> key, text and priority (tab-separated) for each runtime fault that persists: a
# scheduled runner whose last-outcome is FAILED or STALLED, a failed user unit, and a Sentinel
# watch held at TRIP past TRIAGE_WATCH_AFTER. FAILED, a failed unit and a high or urgent watch
# are #high. Sentinel stays observe-only: this reads its state files.
triage_rows() {
  local c name sd v detail u res load f n since sev what t
  t=$(now)
  proof_lib && sd=$(proof_state_dir)
  for c in "$LEDGER_CONF_DIR"/*.conf; do
    [ -e "$c" ] && [ -n "$sd" ] || continue
    grep -qE '^KIND=["'"'"']?call' "$c" && continue
    grep -qE '^ENABLED=["'"'"']?no' "$c" && continue
    name=$(scheduled_runner "$c") || continue
    v=$(awk 'NR == 1 { print $1 }' "$sd/$name/last-outcome" 2>/dev/null)
    case "$v" in FAILED|STALLED) ;; *) continue ;; esac
    detail=$(grep "outcome=$v" "$sd/$name/activity.log" 2>/dev/null | tail -1 \
      | sed -E 's/^\[([0-9-]{10})[^]]*\] outcome=[A-Z]+ ?/\1 /' | cut -c1-100)
    printf 'fix(runner): %s is\tfix(runner): %s is %s: %s\t%s\n' "$name" "$name" "$v" "${detail:-no detail}" \
      "$([ "$v" = FAILED ] && echo '#high' || echo '#low')"
  done
  $TRIAGE_SYSTEMCTL --user list-units --failed --plain --no-legend 2>/dev/null | awk '{ print $1 }' |
  while read -r u; do
    [ -n "$u" ] || continue
    res=$($TRIAGE_SYSTEMCTL --user show -p Result --value "$u" 2>/dev/null)
    load=$($TRIAGE_SYSTEMCTL --user show -p LoadState --value "$u" 2>/dev/null)
    printf 'fix(unit): %s failed\tfix(unit): %s failed: %s%s\t#high\n' "$u" "$u" "${res:-unknown}" \
      "$([ "$load" = not-found ] && echo ', the unit file is gone')"
  done
  for f in "$TRIAGE_WATCH_STATE"/*.state; do
    [ -e "$f" ] || continue
    [ "$(cat "$f")" = TRIP ] || continue
    n=$(basename "$f" .state)
    since=$(cat "$TRIAGE_WATCH_STATE/$n.since" 2>/dev/null) || continue
    [[ "$since" =~ ^[0-9]+$ ]] && [ $((t - since)) -ge "$TRIAGE_WATCH_AFTER" ] || continue
    sev=$(sed -n 's/^severity:[[:space:]]*//p' "$TRIAGE_WATCHES/$n.yaml" 2>/dev/null | head -1)
    # `what:` is one line or a folded block whose first sentence is the healthy state; Sentinel keeps
    # no probe output, so the row says what was expected
    what=$(awk '/^what:/ { sub(/^what:[[:space:]]*(>-?|\|-?)?[[:space:]]*/, ""); on = 1; if ($0 != "") print; next }
                on && /^[[:space:]]/ { sub(/^[[:space:]]+/, ""); print; next } on { exit }' "$TRIAGE_WATCHES/$n.yaml" 2>/dev/null \
      | tr '\n' ' ' | sed -E 's/\. .*/./; s/[[:space:]]+$//' | cut -c1-100)
    printf 'check(watch): %s tripped since\tcheck(watch): %s tripped since %s, expected: %s\t%s\n' "$n" "$n" \
      "$(date -d "@$since" +%Y-%m-%d)" "${what:-no manifest}" \
      "$(case "$sev" in high|urgent) echo '#high' ;; *) echo '#low' ;; esac)"
  done
}

# log_norm: a stderr line with what varies between runs taken out, so one error is one signature:
# a leading timestamp, quoted strings, paths, hex ids and numbers become placeholders.
log_norm() {
  sed -E 's/^\[[^]]*\][[:space:]]*//; s/"[^"]*"/"Q"/g; s/'"'"'[^'"'"']*'"'"'/'"'"'Q'"'"'/g
          s#(~|\.)?(/[^[:space:]/:"'"'"']+)+/?#P#g; s/\b[0-9a-f]{7,}\b/H/g; s/[0-9]+/N/g; s/[[:space:]]+/ /g; s/ $//'
}

# triage_log_rows -> one row per runner stderr error signature seen in BENCH_GUARD_RECUR or more
# runs of the last TRIAGE_LOG_HOURS. Each run's bytes come from its runs.jsonl err range; a range
# past the end of the log was rotated away and is skipped. #high at twice the recurrence.
triage_log_rows() {
  local sd t ledger name a b f sig
  proof_lib && sd=$(proof_state_dir)
  [ -n "$sd" ] && [ -r "$sd/runs.jsonl" ] || return 0
  t=$(now)
  ledger=$(jq -r --argjson s $((t - TRIAGE_LOG_HOURS * 3600)) \
    'select((.finished // 0) >= $s and (.err[1] // 0) > (.err[0] // 0)) | [.name, .err[0], .err[1]] | @tsv' "$sd/runs.jsonl" 2>/dev/null)
  while IFS=$'\t' read -r name a b; do
    [ -n "$name" ] || continue
    f="$sd/$name.stderr.log"
    [ -r "$f" ] && [ "$(stat -c %s "$f")" -ge "$b" ] || continue
    tail -c +$((a + 1)) "$f" | head -c $((b - a)) | grep -aiE -- "$TRIAGE_ERR_RE" | tr -d '\t\r' |
      while IFS= read -r line; do printf '%s\t%s\t%s\t%s\n' "$name" "$a" "$(log_norm <<<"$line")" "$line"; done
  done <<<"$ledger" |
  awk -F'\t' -v min="$BENCH_GUARD_RECUR" '
    { k = $1 FS $3; if (!((k, $2) in seen)) { seen[k, $2] = 1; n[k]++ } if (!(k in s)) s[k] = $4 }
    END { for (k in n) if (n[k] >= min) print k FS n[k] FS s[k] }' |
  while IFS=$'\t' read -r name norm n sample; do
    sig=$(printf '%s\t%s' "$name" "$norm" | sha1sum | cut -c1-8)
    # a # would read as a tag on the board
    sample=$(sed -E 's/^\[[^]]*\][[:space:]]*//; s/#/no./g' <<<"$sample" | cut -c1-80)
    printf 'fix(logs): %s error %s:\tfix(logs): %s error %s: %s\t%s\n' "$name" "$sig" "$name" "$sig" "$sample" \
      "$( [ "$n" -ge $((BENCH_GUARD_RECUR * 2)) ] && echo '#high' || echo '#low')"
  done | sort
}

# triage_causes <rows> -> the rows, each one a TRIAGE_CAUSES line matches carrying "; known cause:
# <fix>" and a fourth field, 1. The table is content: <ERE> TAB <fix>, # comments.
triage_causes() {
  local key text pri re fix hit
  while IFS=$'\t' read -r key text pri; do
    hit=''
    if [ -r "$TRIAGE_CAUSES" ]; then
      while IFS=$'\t' read -r re fix; do
        [[ -n "$re" && "$re" != \#* && -n "$fix" ]] || continue
        grep -qE -- "$re" <<<"$text" && { hit=$fix; break; }
      done < "$TRIAGE_CAUSES"
    fi
    if [ -n "$hit" ]; then
      printf '%s\t%s; known cause: %s\t%s\t1\n' "$key" "$text" "${hit//#/no.}" "$pri"
    else
      printf '%s\t%s\t%s\t0\n' "$key" "$text" "$pri"
    fi
  done <<<"$1"
}

# triage_promote <rows with the cause flag> -> how many it queued: each known-cause row still open
# and not yet started is promoted as it stands on the board, tagged night (a fix at tier 3 stops at
# a PR). A started row is already someone's.
triage_promote() {
  local board key raw n=0
  board=$($BENCH_NOTES_CMD ptask "$KPI_BOARD" --agent list) || { echo 0; return 0; }
  while IFS=$'\t' read -r key _ _ known; do
    [ "$known" = 1 ] || continue
    raw=$(awk -F'\t' -v p="${key,,}" 'index($3, p) == 1 { print $4; exit }' <<<"$board")
    [[ "$raw" == '- [ ]'* ]] || continue
    $TRIAGE_PROMOTE_CMD --agent --project "$KPI_BOARD" --tags night --raw "$raw" >/dev/null 2>&1 && n=$((n + 1))
  done <<<"$1"
  echo "$n"
}

# triage [--dry-run] files one agent-board row per runtime fault (triage_rows) through
# board_upsert, so a fault that persists is one row refreshed in place, never a row a day.
# --dry-run prints the rows and writes nothing.
cmd_triage() {
  local rows dry=0 q
  case "${1:-}" in
    "") ;;
    --dry-run) dry=1 ;;
    *) say "usage: fleet-bench triage [--dry-run]"; return 2 ;;
  esac
  rows=$({ triage_rows; triage_log_rows; } | grep .)
  [ -n "$rows" ] && rows=$(triage_causes "$rows")
  if [ "$dry" = 1 ]; then
    [ -z "$rows" ] || awk -F'\t' '{ print $2, $3 ($4 == 1 ? " (queued as a night fix)" : "") }' <<<"$rows"
    return 0
  fi
  if [ -z "$rows" ]; then
    say "no runner, unit, watch or log error at fault"
    report_outcome NOOP "no runner, unit, watch or log error at fault"
    return 0
  fi
  board_upsert "$(cut -f1-3 <<<"$rows")" || return 1
  q=$(triage_promote "$rows")
  upsert_report "$rows" "$([ "$q" -gt 0 ] && echo "$q queued as night fixes")"
}

# Findings: conclusions that want a decision, reached by rules over counted facts, every machine
# included. fleet-assess decides for this box alone; these read the pool and the other hosts too.
# On 2026-10-29 the pool queue was an hour old at 09:30, local runs starved from 13:00 and merges
# collapsed at 14:20; the human found it at 19:59, because nothing read any of these for a decision.

FINDING_METRICS='cc:host_load1|cc:host_cores|cc:host_cpu_busy_ratio|cc:host_local_queued|cc:pool_waiting|cc:pool_busy|cc:pool_slots|cc:pool_oldest_wait_seconds'
# A rule whose series is missing cannot fire, so its absence must not read as healthy. cc:pool_oldest_wait_seconds
# is left out: it is only there while something waits.
FINDING_REQUIRED='["cc:host_load1","cc:host_cores","cc:host_cpu_busy_ratio","cc:host_local_queued","cc:pool_waiting","cc:pool_busy","cc:pool_slots"]'
FINDING_SAMPLE_S=600   # snapshots this far apart: the sampler's cadence, so "on 2 samples" holds on replay
# Starting points set from the 10-29 replay; kpi-thresholds overrides any of them.
FINDING_DEFAULTS='{"finding_queued_min":5,"finding_local_idle_min":0.3,"finding_pool_wait_s":3600,
  "finding_pool_idle_share":0.75,"finding_merge_ratio":0.5,"finding_demand_ratio":0.7,"finding_merge_floor_h":2,
  "finding_host_load_per_core":2,"finding_clear_min":60,"finding_human_after_min":60}'

finding_limits() {
  local file='{}'
  [ -r "$KPI_THRESHOLDS" ] && file=$(grep -E '^finding_[a-z_]+=' "$KPI_THRESHOLDS" | kv_json)
  jq -cn --argjson d "$FINDING_DEFAULTS" --argjson f "$file" '$d + ($f | with_entries(select(.value != null)))'
}

# prom_rows <epoch> -> metric, label, value (tab-separated) at that moment; rc 1 when unreadable.
# BENCH_PROM_TSV is a recorded series (metric, label, epoch, value), so a replay needs no server.
prom_rows() {
  local t="$1" out
  if [ -n "${BENCH_PROM_TSV:-}" ]; then
    out=$(awk -F'\t' -v t="$t" -v old="$FINDING_SAMPLE_S" '$3 <= t && $3 > t - old { v[$1 "\t" $2] = $4 }
      END { for (k in v) print k "\t" v[k] }' "$BENCH_PROM_TSV")
  else
    out=$(prom_q "{__name__=~\"$FINDING_METRICS\"}" "$t" | jq -r '.data.result[]
      | [.metric.__name__, (.metric.host // .metric.pool // "-"), (.value[1] | tonumber)] | @tsv') || return 1
    # Which repos' jobs wait in each pool, as "<pool>/<repo>": a starved pool holds only the work
    # that feeds it. Unread, a starved pool names no repos, and whoever reads it must assume all.
    out+=$'\n'$(prom_q "count by (pool, repo) ($W (github_actions_job_waiting{stuck!=\"true\"}))" "$t" |
      jq -r '.data.result[] | select(.metric.pool and .metric.repo) | ["cc:pool_waiting_repo", "\(.metric.pool)/\(.metric.repo)", (.value[1] | tonumber)] | @tsv' 2>/dev/null)
    out=$(grep . <<<"$out")
  fi
  [ -n "$out" ] && printf '%s\n' "$out"
}

# prom_snapshot <epoch> -> {metric: {label: value}}; rc 1 when unreadable
prom_snapshot() {
  local rows
  rows=$(prom_rows "$1") || return 1
  jq -Rn 'reduce (inputs | split("\t")) as $r ({}; .[$r[0]][$r[1]] = ($r[2] | tonumber))' <<<"$rows"
}

# merge_rows <until> [since] -> project, merge epoch (tab-separated) for each project sampled in that
# time, default 24h. A project whose merges cannot be read prints "!project": no repo in the map, or a
# failed fetch, whose old refs would otherwise read as no merges. A name the map lacks is a worktree's,
# `<repo>-<slug>` (the `project` def strips only -agent-N, so unity-core-playground-agent-40-b gets
# here whole): the longest registered checkout basename or alias it starts with names it, as
# project-name.sh does for a reaped worktree, and its merges count under that name.
merge_rows() {
  local until="$1" since="${2:-$(($1 - 86400))}" p path head
  if [ -n "${BENCH_MERGES_TSV:-}" ]; then cat "$BENCH_MERGES_TSV"; return; fi
  [ -s "$PROGRESS" ] || return 0
  [ -r "$BENCH_PROJECT_MAP" ] || { echo '!project-map'; return 0; }
  while read -r p path; do
    [ -n "$path" ] || { printf '!%s\n' "$p"; continue; }
    head=$(git -C "$path" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) || head=origin/main
    if ! timeout 30 git -C "$path" fetch -q origin "${head#origin/}" 2>/dev/null; then printf '!%s\n' "$p"; continue; fi
    git -C "$path" log "$head" --first-parent --since="$since" --until="$until" --format=%ct | sed "s/^/$p\t/"
  done < <(jq -rn --argjson since "$since" --slurpfile m "$BENCH_PROJECT_MAP" '
    ($m[0].paths | to_entries | map({key: .value, value: .key}) | from_entries) as $path
    | ($m[0].aliases // {}) as $alias
    | ([$m[0].paths | to_entries[] | {b: (.key | split("/") | last | ltrimstr(".")), p: .key}]
       + [$alias | to_entries[] | {b: .key, p: ($path[.value] // "")}] | map(select(.b != "" and .p != ""))) as $bases
    | [inputs | select(.epoch >= $since) | .project | select(. != "")] | unique
    | [.[] | . as $n | ($path[$alias[$n] // $n] // "") as $direct
       | if $direct != "" then "\($n) \($direct)"
         else ([$bases[] | select(.b as $b | $n | startswith($b + "-"))] | max_by(.b | length)) as $hit
           | if $hit then "\($hit.b) \($hit.p)" else "\($n) " end end] | unique[]' "$PROGRESS")
}

# finding_facts <now> -> everything the rules read, as one object; a source that could not be read is
# null. Demand is the time average of live sessions, so a straggler on an empty project is not a full load.
finding_facts() {
  local t="$1" s0 s1 s2 merges live='' src=/dev/null
  s0=$(prom_snapshot "$t") && s1=$(prom_snapshot $((t - FINDING_SAMPLE_S))) && s2=$(prom_snapshot $((t - 2 * FINDING_SAMPLE_S))) \
    || s0='null' s1='null' s2='null'
  merges=$(merge_rows "$t")
  [ -s "$PROGRESS" ] && src=$PROGRESS
  live=$(jq -c --argjson since $((t - 86400)) --argjson t "$t" \
    'select(.epoch > $since and .epoch <= $t and (.bucket == "WORKING" or .bucket == "STALLED")) | {epoch, project}' "$src") || return 1
  jq -cn --argjson t "$t" --argjson s0 "$s0" --argjson s1 "$s1" --argjson s2 "$s2" --arg m "$merges" \
      --argjson every "$FINDING_SAMPLE_S" --slurpfile p <(printf '%s\n' "$live") '
    def avg_live($span): map(select(.epoch > $t - $span)) | length * $every / $span;
    ($m | split("\n") | map(select(. != "") | split("\t"))) as $rows
    | {t: $t, prom: [$s0, $s1, $s2],
       unfetched: [$rows[] | select(.[0] | startswith("!")) | .[0][1:]],
       merges: ($rows | map(select(.[0] | startswith("!") | not)) | group_by(.[0]) | map({key: .[0][0], value: map(.[1] | tonumber)}) | from_entries),
       live: ($p | group_by(.project) | map({key: .[0].project, value: {avg_24h: avg_live(86400), avg_2h: avg_live(7200)}}) | from_entries)}'
}

# finding_rows <facts> -> one object per rule firing now. Pure: the same facts give the same rows.
finding_rows() {
  jq -c --argjson l "$(finding_limits)" --argjson required "$FINDING_REQUIRED" "$JQ_LIB"'
    def pct: . * 100 | round;
    def row($rule; $scope; $class; $numbers; $window; $source; $conclusion; $cost):
      {rule: $rule, scope: $scope, decision_class: $class, evidence: {numbers: $numbers, window: $window, source: $source},
       conclusion: $conclusion, cost: $cost};
    .t as $t | .prom as $p | .
    | ( .unfetched[] | row("blind"; "merges:\(.)"; "report"; {}; "now"; "git log";
          "merges for \(.) unreadable (no mapped repo, or the fetch failed), so throughput-drop is off for it"; "") ),
      ( if $p[0] == null then row("blind"; "prom"; "report"; {}; "now"; "prometheus";
          "prometheus unreadable, so starved and host-overload are off"; "") else empty end ),
      ( select($p[0] != null) | $p[0] as $a | $required[] | select($a[.] == null)
        | row("blind"; "prom:\(.)"; "report"; {}; "now"; "prometheus"; "\(.) is missing, so the rules that read it are off"; "") ),
      ( select($p[0] != null) | $p[0] as $a | $p[1] as $b | $p[2] as $c
        | ( ($a["cc:host_local_queued"] // {}) | to_entries[] | .key as $h | .value as $q
            | (($b["cc:host_local_queued"][$h]) // 0) as $q1 | ($a["cc:host_cpu_busy_ratio"][$h]) as $busy
            | select($q >= $l.finding_queued_min and $q1 >= $l.finding_queued_min
                     and $busy != null and (1 - $busy) > $l.finding_local_idle_min)
            | row("starved"; $h; "shepherd"; {queued: $q, idle: (1 - $busy | pct)}; "2 samples"; "cc:host_local_queued, cc:host_cpu_busy_ratio";
                "\($q) local runs queued with the CPU \(1 - $busy | pct)% idle: a slot limit binds, not the machine"; "\($q) runs waiting") ),
          ( ($a["cc:pool_oldest_wait_seconds"] // {}) | to_entries[] | .key as $pool | .value as $w
            | (($a["cc:pool_waiting"][$pool]) // 0) as $n | ($a["cc:pool_busy"][$pool]) as $u | ($a["cc:pool_slots"][$pool]) as $s
            | select($w >= $l.finding_pool_wait_s and $n > 0)
            | ([($a["cc:pool_waiting_repo"] // {}) | keys[] | select(startswith($pool + "/")) | ltrimstr($pool + "/")]
               | if length > 0 then . else null end) as $repos
            # bind: capacity when the pool is full, labels when slots sit free or the jobs carry no
            # pool label (pool "other": pinned to one host, say), so more sessions add no demand to it.
            | (if $pool == "other" or ($u != null and $s != null and $s > 0 and ($u / $s) < $l.finding_pool_idle_share)
               then "labels" else "capacity" end) as $bind
            | row("starved"; "pool:\($pool)"; "shepherd"; {waiting: $n, busy: $u, slots: $s, oldest_s: $w}; "now"; "cc:pool_*";
                "oldest job waited \($w | dur) with \($u // "?")/\($s // "?") slots busy: "
                + (if $bind == "labels" then "admission or labels bind, not capacity" else "demand is over the pool'"'"'s capacity" end);
                "\($n) jobs waiting") + {repos: $repos, bind: $bind} ),
          ( ($a["cc:host_load1"] // {}) | to_entries[] | .key as $h | .value as $v | ($a["cc:host_cores"][$h]) as $n
            | select($n != null and $n > 0)
            | [$v, ($b["cc:host_load1"][$h]), ($c["cc:host_load1"][$h])] as $vs
            | select(($vs | all(. != null and . / $n >= $l.finding_host_load_per_core)))
            | row("host-overload"; $h; "report"; {load: $v, cores: $n, per_core: ($v / $n | round1)}; "3 samples"; "cc:host_load1, cc:host_cores";
                "load \($v | round1) on \($n) cores for 20m (\($v / $n | round1)x)"; "") ) ),
      ( .unfetched as $u | .live as $live | .merges | to_entries[] | .key as $proj | .value as $e
        | select(($u | index($proj)) == null) | ($live[$proj]) as $d
        | ($e | map(select(. > $t - 86400 and . <= $t)) | length / 24) as $base
        | ($e | map(select(. > $t - 7200 and . <= $t)) | length / 2) as $now
        | select($d != null and $base >= $l.finding_merge_floor_h and $now < $l.finding_merge_ratio * $base
                 and $d.avg_2h >= $l.finding_demand_ratio * $d.avg_24h)
        | row("throughput-drop"; $proj; "human"; {merges_h_2h: $now, merges_h_24h: ($base | round1), live_2h: ($d.avg_2h | round1), live_24h: ($d.avg_24h | round1)};
            "2h against 24h"; "git log --first-parent, progress.jsonl";
            "merges \($now)/h against \($base | round1)/h with sessions still working (\($d.avg_2h | round1) live, usual \($d.avg_24h | round1)): something between gate and merge binds";
            "\(($base - $now) * 2 | round) merges behind in 2h") )' <<<"$1"
}

# finding_stamp <now> -> rows on stdin with their episode. An episode is the time a rule first fired
# for a scope, and it outlives a gap shorter than finding_clear_min, so a rule that flickers is one
# episode and a recurrence is a new one. The fact is what the ledger pages once.
finding_stamp() {
  local t="$1" prior=/dev/null
  [ -s "$FINDINGS" ] && prior=$FINDINGS
  jq -c --argjson t "$t" --argjson l "$(finding_limits)" --slurpfile p "$prior" "$JQ_LIB"'
    ($p | map(select(.epoch < $t and .epoch >= $t - $l.finding_clear_min * 60)) | group_by([.rule, .scope])
     | map(max_by(.epoch) | {key: "\(.rule)/\(.scope)", value: .}) | from_entries) as $last
    | ($last["\(.rule)/\(.scope)"].episode // $t) as $ep
    | . + {epoch: $t, at: ($t | iso), episode: $ep, fact: "\(.rule) \(.scope) @\($ep)"}
    | if (.rule == "starved" or .rule == "host-overload") and $t - $ep >= $l.finding_human_after_min * 60
      then .decision_class = "human" else . end'
}

# finding_blind <scope> <source> <conclusion> -> one unstamped row, for a source no rule could read
finding_blind() {
  jq -cn --arg s "$1" --arg src "$2" --arg c "$3" \
    '{rule: "blind", scope: $s, decision_class: "report", evidence: {numbers: {}, window: "now", source: $src}, conclusion: $c, cost: ""}'
}

# findings_run <now>: evaluate and append. Never fails the sample that calls it, and a failed evaluation
# leaves a row, because no rows is what a healthy pass looks like.
findings_run() {
  local facts rows
  mkdir -p "$DIR"
  { facts=$(finding_facts "$1") && [ -n "$facts" ] && rows=$(finding_rows "$facts" | finding_stamp "$1"); } \
    || rows=$(finding_blind findings "fleet-bench" "the rules could not be evaluated, so nothing here is a healthy read" | finding_stamp "$1")
  [ -z "$rows" ] || printf '%s\n' "$rows" >> "$FINDINGS"
  printf '%s\n' "$1" > "$FINDINGS_PASS"
}

# findings_open <now> -> the newest row of each finding still inside its episode, worst class first. A
# store nobody has evaluated lately says so first, because its emptiness is not health.
findings_open() {
  local t="$1" limits last store=/dev/null
  limits=$(finding_limits)
  [ -s "$FINDINGS" ] && store=$FINDINGS
  last=$(cat "$FINDINGS_PASS" 2>/dev/null)
  if [ $((t - ${last:-0})) -gt "$(jq '.finding_clear_min * 60 | floor' <<<"$limits")" ]; then
    finding_blind sampler "findings.last" "no evaluation since $(jq -rn --argjson e "${last:-0}" "$JQ_LIB"'$e | if . == 0 then "ever" else hm end'), so this list is not current" | finding_stamp "$t"
  fi
  jq -cn --argjson t "$t" --argjson l "$limits" --slurpfile f "$store" '
    $f | map(select(.epoch <= $t)) | group_by([.rule, .scope]) | map(max_by(.epoch))
    | map(select($t - .epoch <= $l.finding_clear_min * 60))
    | sort_by(({human: 0, shepherd: 1, report: 2}[.decision_class]), .episode) | .[]'
}

cmd_findings() {
  case "${1:-}" in
    --run) findings_run "$(now)"; return ;;
    --json) findings_open "$(now)"; return ;;
    ""|--open) ;;
    *) say "usage: fleet-bench findings [--open|--json|--run]"; return 2 ;;
  esac
  local rows
  rows=$(findings_open "$(now)")
  [ -n "$rows" ] || { echo "findings: none open"; return 0; }
  jq -r "$JQ_LIB"'[.decision_class, .rule, .scope, "since \(.episode | hm)", .conclusion + (if .cost != "" then " (\(.cost))" else "" end)] | @tsv' <<<"$rows" |
    awk -F'\t' '{ printf "%-8s %-15s %-24s %-15s %s\n", $1, $2, $3, $4, $5 }'
}

# The loop: what answered each finding. A finding of class human goes on the human's page once (the
# ledger's escalate records it as paged); what the fleet did about it is a response: asked,
# filed-row, cancelled or fixed. An episode that reached class human with nothing but pages is dark:
# the loop saw it and nothing acted. On 2026-11-05 starved pools paged from 23:31 to 06:07 and no
# pass did anything else, which no number showed.
RESPONSE_ACTIONS="paged asked filed-row cancelled fixed"
LOOP_WINDOW_S=$((7 * 86400))   # the KPI table's 7d

cmd_respond() {
  local fact="${1:-}" actor="${2:-}" action="${3:-}" ref="${4:-}"
  if ! [[ "$fact" =~ ^[a-z-]+\ [^\ ]+\ @[0-9]+$ ]] || [ -z "$actor" ] || [[ " $RESPONSE_ACTIONS " != *" $action "* ]]; then
    say "usage: fleet-bench respond '<rule> <scope> @<episode>' <actor> <${RESPONSE_ACTIONS// /|}> [ref]"
    return 2
  fi
  mkdir -p "$DIR"
  jq -cn --argjson t "$(now)" --arg f "$fact" --arg a "$actor" --arg x "$action" --arg r "$ref" \
    '{epoch: $t, fact: $f, actor: $a, action: $x, ref: $r}' >> "$RESPONSES"
}

# loop_episodes <now> <since> -> one object per finding episode begun since <since> and seen on two
# samples or more (one is noise, as fleet-lead reads it), report class left out: when it reached class
# human, its responses, minutes from the episode to its first response that is not a page, whether
# it still fires, and dark.
loop_episodes() {
  local f=/dev/null r=/dev/null
  [ -s "$FINDINGS" ] && f=$FINDINGS
  [ -s "$RESPONSES" ] && r=$RESPONSES
  jq -cn --argjson t "$1" --argjson since "$2" --argjson l "$(finding_limits)" --slurpfile f "$f" --slurpfile r "$r" '
    ($r | map(select(.epoch <= $t)) | group_by(.fact) | map({key: .[0].fact, value: .}) | from_entries) as $resp
    | $f | map(select(.decision_class != "report" and .episode >= $since and .epoch <= $t)) | group_by(.fact)[]
    | select(length > 1)
    | (map(select(.decision_class == "human")) | min_by(.epoch) | .epoch?) as $human
    | ($resp[.[0].fact] // []) as $rs
    | ($rs | map(select(.action != "paged")) | min_by(.epoch) | .epoch?) as $acted
    | (max_by(.epoch) | .epoch) as $last
    | {fact: .[0].fact, rule: .[0].rule, scope: .[0].scope, episode: .[0].episode, last: $last,
       open: ($t - $last <= $l.finding_clear_min * 60), human_at: $human, responses: ($rs | sort_by(.epoch) | map(.action)),
       first_response_min: (if $acted == null then null else ($acted - .[0].episode) / 60 | round end),
       dark: ($human != null and $acted == null)}'
}

cmd_loop() {
  local t rows
  case "${1:-}" in ""|--json|--firing) ;; *) say "usage: fleet-bench loop [--json|--firing]"; return 2 ;; esac
  t=$(now)
  rows=$(loop_episodes "$t" $((t - LOOP_WINDOW_S))) || return 1
  if [ "${1:-}" = --json ]; then [ -z "$rows" ] || printf '%s\n' "$rows"; return 0; fi
  # The daily briefing's Needs you line: one sentence per dark episode still firing, nothing when none.
  if [ "${1:-}" = --firing ]; then
    [ -z "$rows" ] || jq -rs --argjson t "$t" 'sort_by(.episode)[] | select(.dark and .open)
      | "Finding \(.fact) has been yours for \((($t - .human_at) / 60) | floor)m and still fires, with nothing done but a page. Run fleet-bench loop."' <<<"$rows"
    return 0
  fi
  [ -n "$rows" ] || { echo "loop: no finding episodes in 7d"; return 0; }
  jq -rs "$JQ_LIB"'
    "loop, 7d: \(length) episodes, \(map(select(.dark)) | length) dark (\(map(select(.dark and .open)) | length) still firing), \(map(.first_response_min | numbers) | median | if . == null then "no act recorded" else "first response after \(.)m median" end)",
    (sort_by(.episode)[] | [(if .dark then "DARK" elif .first_response_min != null then "\(.first_response_min)m" else "-" end),
       (if .open then "firing" else "cleared" end), .fact,
       (.responses | if length == 0 then "no response" else join(",") end)] | @tsv)' <<<"$rows" |
    awk -F'\t' 'NR == 1 { print; next } { printf "%-6s %-8s %-40s %s\n", $1, $2, $3, $4 }'
}

# throughput_epoch <text> -> an epoch, from an epoch or anything `date -d` reads
throughput_epoch() { [[ "$1" =~ ^[0-9]+$ ]] && printf '%s' "$1" || date -d "$1" +%s; }

# The before and after any slot, hold or pace change has to state: load and idle are proxies, and the
# outcome is merges per hour and queue wait (dotfiles lessons, 2026-10-30).
cmd_throughput() {
  local from='' to='' snap='null' merges queue=''
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) from=$(throughput_epoch "${2:-}") || return 2; shift 2 ;;
      --to) to=$(throughput_epoch "${2:-}") || return 2; shift 2 ;;
      *) say "usage: fleet-bench throughput [--from T] [--to T]"; return 2 ;;
    esac
  done
  [ -n "$to" ] || to=$(now)
  [ -n "$from" ] || from=$((to - 7200))
  [ "$to" -gt "$from" ] || { say "--to must be after --from"; return 2; }
  snap=$(prom_snapshot "$to") || snap='null'
  merges=$(merge_rows "$to" "$from" | grep -v '^!')
  # The exporter's own quantiles over the jobs finished in 24h; a recorded fixture has none.
  [ -n "${BENCH_PROM_TSV:-}" ] || queue=$(prom_q github_job_queue_seconds "$to" | jq -r '.data.result[] | [.metric.pool, .metric.quantile, .value[1]] | @tsv')
  jq -rn --argjson a "$from" --argjson b "$to" --argjson s "$snap" --arg m "$merges" --arg q "$queue" \
      --rawfile r <(runs_between "$from" "$to") "$JQ_LIB"'
    (($b - $a) / 3600) as $h
    | ($q | split("\n") | map(select(. != "") | split("\t")) | reduce .[] as $x ({}; .[$x[0]][$x[1]] = ($x[2] | tonumber))) as $wait
    | ($r | run_rows) as $runs
    | ($runs | map(select(.res != "pass"))) as $bad
    | "window: \($a | hm) -> \($b | hm) (\($h | round1)h)",
      (if ($runs | length) == 0 then "local runs: none recorded"
       else "local runs: \($runs | length / $h | round1)/h, \($bad | length * 100 / ($runs | length) | round)% not passed, editor \(($runs | map(.s) | add) / 3600 | round1)h, of which on runs not passed \((($bad | map(.s) | add) // 0) / 3600 | round1)h" end),
      ($m | split("\n") | map(select(. != "") | split("\t")) | map(select((.[1] | tonumber) > $a and (.[1] | tonumber) <= $b)) | group_by(.[0])
       | if length == 0 then "merges: none" else "merges/h: " + (map("\(.[0][0]) \(length / $h | round1)") | join(", ")) end),
      (if $s == null then "pool and hosts: prometheus unreadable"
       else ($s["cc:pool_slots"] // {} | keys[] | . as $p | select(($s["cc:pool_slots"][$p] // 0) > 0)
             | "pool \($p): \($s["cc:pool_waiting"][$p] // 0) waiting, \($s["cc:pool_busy"][$p] // 0)/\($s["cc:pool_slots"][$p]) busy"
               + (if $s["cc:pool_oldest_wait_seconds"][$p] then ", oldest \($s["cc:pool_oldest_wait_seconds"][$p] | dur)" else "" end)
               + (if $wait[$p] then ", finished jobs waited p50 \($wait[$p]["0.5"] | dur), p90 \($wait[$p]["0.9"] | dur) (24h)" else "" end)),
            "local: \($s["cc:host_local_queued"].workstation // "-") queued",
            "hosts, load per core: " + ($s["cc:host_load1"] // {} | to_entries | map(select(($s["cc:host_cores"][.key] // 0) > 0) | {k: .key, v: (.value / $s["cc:host_cores"][.key])})
               | map(select(.v >= 0.5)) | sort_by(-.v) | if length == 0 then "all under 0.5x" else map("\(.k) \(.v | round1)x") | join(", ") end)
       end)'
}

# queue_slots -> how many sessions fleet-dispatch keeps live: BENCH_QUEUE_SLOTS, else its conf's
# DISPATCH_MAX_LIVE, else the default in fleet-dispatch itself. One source, read, never restated.
queue_slots() {
  local n="${BENCH_QUEUE_SLOTS:-}" fd
  [ -n "$n" ] || n=$(sed -n 's/^DISPATCH_MAX_LIVE=\([0-9][0-9]*\).*/\1/p' "$BENCH_DISPATCH_CONF" 2>/dev/null | tail -1)
  if [ -z "$n" ] && fd=$(command -v fleet-dispatch); then
    n=$(sed -n 's/^: "\${DISPATCH_MAX_LIVE:=\([0-9][0-9]*\)}".*/\1/p' "$fd" | head -1)
  fi
  [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -gt 0 ] && printf '%s' "$n"
}

# forecast_json <now> [queue json lines] [items json lines|"!"] -> one object: the schedule of
# every open phase, the fleet's all-done-by at both ends of the band, the drain against the
# last window's flow, the board rows behind the live work, and the agent queue's items placed
# on the dispatcher's slots ("!" when the queue could not be read, null in .items).
forecast_json() {
  local t="$1" queue="${2:-}" items="${3:-}" live names iphases sc="$SCORES" map=/dev/null slots
  live=$(latest_live)
  [ -s "$sc" ] || sc=/dev/null
  [ -r "$BENCH_PROJECT_MAP" ] && map=$BENCH_PROJECT_MAP
  slots=$(queue_slots) || slots=''
  names=$(jq -r '[.session_id, .plan_file // ""] | @tsv' <<<"$live" | while IFS=$'\t' read -r sid pf; do
      [ -n "$pf" ] && printf '{"%s":%s}\n' "$sid" "$(plan_phase_list "$pf" | jq -c 'map(select(.state == "open") | .name)')"
    done | jq -cs 'add // {}')
  # an item with `phases:` (agent-queue add --plan) counts those; one that only names its plan, its plan's open phases
  iphases=$( [ "$items" = "!" ] || jq -r 'select((.plan // "") != "" and (.phases // "") == "") | [.slug, .plan] | @tsv' <<<"$items" 2>/dev/null \
    | while IFS=$'\t' read -r slug pf; do
        printf '{"%s":%s}\n' "$slug" "$(plan_phase_list "$pf" | jq 'map(select(.state == "open")) | length')"
      done | jq -cs 'add // {}')
  jq -cn --argjson t "$t" --argjson win "$BENCH_WINDOW_H" --slurpfile nm <(printf '%s\n' "$names") --rawfile queue <(printf '%s' "$queue") \
     --rawfile items <(printf '%s' "$items") --argjson ip "${iphases:-"{}"}" --arg slots "$slots" \
     --argjson def "$BENCH_DEFAULT_PHASE_MIN" --argjson minb "$BENCH_BASIS_MIN_N" "${CAL_ARGS[@]}" --slurpfile map "$map" \
     --slurpfile live <(printf '%s\n' "$live") --slurpfile p "$PROGRESS" --slurpfile s "$sc" "$JQ_LIB"'
    $nm[0] as $names
    | ($s | map(select(.done_epoch >= $t - $win * 3600) | .ratio // empty) | median) as $r24
    | ($p | flow($t - $win * 3600; $t)) as $f
    | ($live | schedule($t; $r24 // 1; $names)) as $sch
    | ($sch | map(.left) | add // 0) as $open
    | ($f.out_per_h - $f.net_in_per_h) as $net
    | ($queue | split("\n") | map(select(. != "") | fromjson)) as $q
    | ($p | map(select(.phases_total != null)) | group_by([.session_id, .plan_file]) | map(map(.phases_total) | max) | median) as $ppp
    | {made_epoch: $t, made_at: ($t | iso), slow_ratio: $r24,
       sessions: ($sch | length),
       unscheduled: ($live | map(select((.finished | not) and (.phases_total == null or .eta == null))) | length),
       open: $open}
      + ($sch | fleet_finish)
      + {drain: {out_per_h: $f.out_per_h, in_per_h: $f.net_in_per_h,
                 epoch: (if $net > 0 then ($t + $open / $net * 3600 | floor) else null end)},
         queue: (if $queue == "" then null else {rows: ($q | length), ready: ($q | map(select(.state == "ready")) | length),
                 phases_per_plan: $ppp, phases: (($q | length) * ($ppp // 0) | floor)} end),
         schedule: $sch}
      + {items: (if $items == "!" then null else
          ($items | split("\n") | map(select(. != "") | fromjson)) as $it
          | ($it | map(.slug) | INDEX(.)) as $active
          | ($p | group_by(.project) | map({key: .[0].project,
                value: (group_by([.session_id, .plan_file]) | map(phase_minutes) | add // [])}) | from_entries) as $byp
          | ($byp | [.[]] | add // []) as $every
          | ($s | accuracy($minn; $lo; $hi) | INDEX(.basis)) as $acc
          | ($sch | map({key: (.target | sub(":[0-9]+$"; "")), value: {P: .finish_p50, S: .finish_slow}}) | from_entries) as $onsch
          | ($slots | if . == "" then 1 else tonumber end) as $K
          | ($it | map(
              (($map[0].trackers // {})[.project].repo // .project) as $repo
              | ($byp[$repo] // []) as $j
              | (if ($j | length) >= $minb then {m: ($j | median), basis: "project-median(\($j | length))"}
                 elif ($every | length) >= $minb then {m: ($every | median), basis: "fleet-median(\($every | length))"}
                 else {m: $def, basis: "default"} end) as $pp
              | ($acc[$pp.basis | kind].factor // 1) as $fac
              | (.hold // "") as $h | ($h | sub("^after "; "")) as $par
              | {slug, project, state, mode,
                 phases: ((.phases // "" | [splits(" +")] | map(select(. != "")) | length | select(. > 0)) // $ip[.slug] // (if .mode == "plan" then ($ppp // 1) else 1 end)),
                 P: ($pp.m * 60 * $fac), S: ($pp.m * 60 * ($r24 // 1)),
                 basis: ($pp.basis + (if $fac != 1 then " x\($fac)" else "" end)),
                 start: ((.started // .queued) | fromdateiso8601? // $t),
                 live: (if .state == "running" then $onsch[(.session // "") | if test(":") then sub(":"; "/") else "lab/" + . end] else null end),
                 after: (if ($h | startswith("after ")) and $active[$par] != null then $par else null end),
                 why: (if .state == "waiting" then "waiting on you"
                       elif ($h | startswith("after ")) and $active[$par] == null then "after \($par), which did not finish ok"
                       elif $h != "" and ($h | startswith("after ") | not) then "held: \($h)"
                       else null end)})) as $e
          | ($e | qplace($t; $K; "P")) as $a | ($e | qplace($t; $K; "S")) as $b
          | ($e | map(select(.live == null and $a.placed[.slug] != null)
                      | {slug, project, state, phases, basis, start: $a.placed[.slug].start,
                         p50: $a.placed[.slug].end, slow: $b.placed[.slug].end})) as $rows
          | {count: ($it | length), running: ($it | map(select(.state == "running")) | length),
             queued: ($it | map(select(.state == "queued")) | length),
             waiting: ($it | map(select(.state == "waiting")) | length),
             slots: $K, slots_known: ($slots != ""), on_schedule: ($e | map(select(.live != null)) | length),
             phases: ($rows | map(.phases) | add // 0),
             finish_p50: ($rows | map(.p50) | max), finish_slow: ($rows | map(.slow) | max),
             not_scheduled: ($e | map(select(.why != null) | {slug, why})
                             + ($a.behind | map({slug: ., why: "behind an item that is not scheduled"}))),
             schedule: ($rows | sort_by(.p50))} end)}'
}

# cmd_forecast [--json] [--queue] [--baseline <label>]: when the live work should be done, and in
# what order. --baseline freezes it into forecasts.jsonl, queue included, for vs to compare.
cmd_forecast() {
  local json=0 withq=0 label='' t fc queue='' items
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --queue) withq=1; shift ;;
      --baseline) label="${2:-}"; [ -n "$label" ] || { say "--baseline needs a label"; return 2; }; withq=1; shift 2 ;;
      *) say "usage: fleet-bench forecast [--json] [--queue] [--baseline <label>]"; return 2 ;;
    esac
  done
  [ -s "$PROGRESS" ] || { say "no samples yet: run fleet-bench sample"; return 1; }
  t=$(now)
  [ "$withq" = 0 ] || queue=$($BENCH_QUEUE_CMD 2>/dev/null) || { say "the dispatch queue could not be read; forecast without it"; queue=''; }
  items=$($BENCH_ITEMS_CMD 2>/dev/null) || { say "the agent queue could not be read; forecast without its items"; items='!'; }
  [ -z "$items" ] || [ "$items" = "!" ] || queue_slots >/dev/null || say "the dispatcher's slot count could not be read; placing queue items on 1 slot"
  fc=$(forecast_json "$t" "$queue" "$items") || return 1
  if [ -n "$label" ]; then
    mkdir -p "$DIR"
    jq -c --arg l "$label" '{label: $l} + .' <<<"$fc" >> "$FORECASTS"
    say "baseline $label frozen in $FORECASTS"
  fi
  if [ "$json" = 1 ]; then printf '%s\n' "$fc"; return 0; fi
  jq -r "$JQ_LIB"'
    "forecast \(.made_epoch | hm): \(.sessions) sessions with a plan, \(.open) phases open"
      + (if .unscheduled > 0 then " (\(.unscheduled) more with no plan or no estimate)" else "" end),
    "  all done by: median \(.median_p50 | hm), p90 \(.p90_p50 | hm), last \(.last_p50 | hm) (each estimate as calibrated)",
    "        slow: median \(.median_slow | hm), p90 \(.p90_slow | hm), last \(.last_slow | hm) (at the last 24h scored ratio, \(.slow_ratio // "none, so 1")x)",
    "  drain: " + (if .drain.epoch != null
      then "\(.drain.epoch | hm) at \(.drain.out_per_h)/h out against \(.drain.in_per_h)/h in (last 24h)"
      else "not draining at current inflow (in \(.drain.in_per_h)/h, out \(.drain.out_per_h)/h): no time until one of them changes" end),
    (if .items == null then "  agent queue: unreadable"
     elif .items.count == 0 then "  agent queue: empty"
     else .items as $i
       | "  agent queue: \($i.count) items (\($i.running) running, \($i.queued) queued, \($i.waiting) waiting on you), \($i.phases) phases on \($i.slots) dispatch slots"
         + (if ($i.schedule | length) > 0 then ": all done by \($i.finish_p50 | hm), slow \($i.finish_slow | hm)" else "" end)
         + (if $i.on_schedule > 0 then " (\($i.on_schedule) running already counted above)" else "" end),
         (if ($i.not_scheduled | length) > 0
          then "    not scheduled: \($i.not_scheduled | length): " + ($i.not_scheduled | group_by(.why) | map("\(length) \(.[0].why)") | join(", "))
          else empty end) end),
    (if .queue != null then "  queued after this: \(.queue.rows) board rows (\(.queue.ready) ready to start), about \(.queue.phases) phases at the median \(.queue.phases_per_plan // "-") per plan" else empty end),
    ([(.schedule[] | . as $s | .phases[] | {t: .p50, slow, target: $s.target, name}),
      (.items.schedule // [] | .[] | {t: .p50, slow, target: "queue:\(.project)", name: .slug})] | sort_by(.t)) as $all
    | .made_epoch as $now | ($all | map(select(.t <= $now))) as $due
    | (if ($due | length) > 0 then "  due now, past their estimate: \($due | length) phases in \($due | map(.target) | unique | length) sessions" else empty end),
      "  next phases, in expected order:",
      ($all | map(select(.t > $now)) | .[:10][]
        | "    \(.t | hm)  (slow \(.slow | hm))  \(.target | sub("^[^/]*/"; ""))  \(.name | if length > 70 then .[:67] + "..." else . end)")' <<<"$fc"
}

# progress_since <epoch>: the progress rows from an hour before it on, so a flow from that epoch
# has the sample before it and the 9 MB history is not slurped whole.
progress_since() { jq -c --argjson a "$(($1 - 3600))" 'select(.epoch >= $a)' "$PROGRESS"; }

# baseline_pick [label|latest] -> the newest frozen forecast with that label, or the newest of all
baseline_pick() {
  local l="${1:-latest}"
  [ -s "$FORECASTS" ] || return 1
  jq -cs --arg l "$l" 'map(select($l == "latest" or .label == $l)) | last // empty' "$FORECASTS" | grep .
}

# cmd_vs [<label>|latest] [--json]: a frozen forecast against what the fleet did since
cmd_vs() {
  local json=0 label=latest b t
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      -*) say "usage: fleet-bench vs [<label>|latest] [--json]"; return 2 ;;
      *) label="$1"; shift ;;
    esac
  done
  b=$(baseline_pick "$label") || { say "no baseline $label: freeze one with fleet-bench forecast --baseline <label>"; return 1; }
  t=$(now)
  local v
  v=$(progress_since "$(jq -r .made_epoch <<<"$b")" | jq -cs --slurpfile b <(printf '%s\n' "$b") --argjson t "$t" "$JQ_LIB"'vs($b[0]; $t)') || return 1
  if [ "$json" = 1 ]; then printf '%s\n' "$v"; return 0; fi
  jq -r "$JQ_LIB"'
    "vs baseline \(.label) (frozen \(.made_epoch | hm), \(.hours)h ago)",
    "  ticked: \(.ticked) of the \(.expected) phases expected by now (\(.expected_slow) at the slow end), \(.ticked_all) fleet-wide",
    "  sessions: " + ([("finished", "ahead", "on track", "behind", "gone") as $k | select(.states[$k] != null) | "\(.states[$k]) \($k)"] | join(", ")),
    "  scope: +\(.added) added to baseline plans, -\(.removed) removed, \(.new_plans) new plans in them, \(.started_since) sessions started since",
    "  inflow: \(.in_per_h)/h since against \(.in_per_h_frozen)/h when frozen, out \(.out_per_h)/h",
    (.sessions | map(select(.state == "behind")) | sort_by(-.min) | if length > 0 then "  behind:", (.[] | "    \(.target | sub("^[^/]*/"; "")): \(.ticked) of \(.expected) expected, \(.min)m past due on \(.next)") else empty end),
    (.sessions | map(select(.state == "ahead")) | sort_by(-.min) | if length > 0 then "  ahead:", (.[] | "    \(.target | sub("^[^/]*/"; "")): \(.ticked) of \(.expected) expected, \(.min)m early") else empty end)' <<<"$v"
}

# new_forecast_scores <now> -> a score for each frozen forecast that resolved and has none yet
new_forecast_scores() {
  local t="$1" b k min
  [ -s "$FORECASTS" ] || return 0
  local todo
  todo=$(jq -cs --slurpfile d <(cat "$FORECAST_SCORES" 2>/dev/null) '
    ($d | map("\(.label) \(.made_epoch)")) as $done | .[] | select(("\(.label) \(.made_epoch)") as $k | $done | index($k) | not)' "$FORECASTS")
  [ -n "$todo" ] || return 0
  min=$(jq -s 'map(.made_epoch) | min' <<<"$todo")
  progress_since "$min" | jq -cs --slurpfile todo <(printf '%s\n' "$todo") --argjson t "$t" --argjson hz "$BENCH_FORECAST_HORIZON_H" "$JQ_LIB"'
    . as $p | $todo[] as $b | $p | forecast_score($b; $t; $hz)'
}

# cmd_flow [--from T] [--to T] [--json] [--hourly]: phases in against phases out over a window
cmd_flow() {
  local from='' to='' json=0 hourly=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) from=$(throughput_epoch "${2:-}") || return 2; shift 2 ;;
      --to) to=$(throughput_epoch "${2:-}") || return 2; shift 2 ;;
      --json) json=1; shift ;;
      --hourly) hourly=1; shift ;;
      *) say "usage: fleet-bench flow [--from T] [--to T] [--json] [--hourly]"; return 2 ;;
    esac
  done
  [ -n "$to" ] || to=$(now)
  [ -n "$from" ] || from=$((to - BENCH_WINDOW_H * 3600))
  [ "$to" -gt "$from" ] || { say "--to must be after --from"; return 2; }
  [ -s "$PROGRESS" ] || { [ "$json" = 1 ] && echo null || echo "flow: no samples yet"; return 0; }
  if [ "$json" = 1 ]; then
    jq -cs --argjson a "$from" --argjson b "$to" --argjson hr "$hourly" "$JQ_LIB"'
      flow($a; $b) | if $hr == 1 then . else del(.hourly) end' "$PROGRESS"
    return
  fi
  jq -rs --argjson a "$from" --argjson b "$to" --argjson hr "$hourly" "$JQ_LIB"'
    flow($a; $b) as $f
    | "flow \($a | hm) -> \($b | hm) (\($f.hours | round1)h)",
      "  out: \($f.ticked) phases ticked (\($f.out_per_h)/h)",
      "  in:  \($f.in) phases (\($f.in_per_h)/h): \($f.started) plans started with \($f.started_open) open, \($f.added) added to running plans; \($f.removed) removed by rewrites",
      "  open: \($f.open_start) at start, \($f.open_end) at end\(if $f.dropped > 0 then "; \($f.dropped) left open by plans that ended or were switched away from" else "" end)",
      "  net: " + (($f.out_per_h - $f.net_in_per_h) as $d
        | if $d > 0 then "draining \($d | round2)/h" else "not draining (in \($f.net_in_per_h)/h, out \($f.out_per_h)/h)" end),
      ($f.by_project[] | "  \(.project): \(.ticked) out, \(.in) in, \(.removed) removed"),
      (if $hr == 1 then ($f.hourly[] | "  \(.hour | hm)  +\(.in) -\(.removed) in, \(.ticked) out, scope \(.scope), done \(.done)") else empty end)
  ' "$PROGRESS"
}

main() {
  case "${1:-}" in
    sample) cmd_sample ;;
    eta) shift; cmd_eta "$@" ;;
    report) cmd_report ;;
    accuracy) shift; cmd_accuracy "$@" ;;
    headline) cmd_headline ;;
    scorecard) cmd_scorecard ;;
    sessions) shift; cmd_sessions "$@" ;;
    stats) shift; cmd_stats "$@" ;;
    review) shift; cmd_review "$@" ;;
    asks) shift; cmd_asks "$@" ;;
    ledger) shift; cmd_ledger "$@" ;;
    kpi) shift; cmd_kpi "$@" ;;
    chain) shift; cmd_chain "$@" ;;
    effect) shift; cmd_effect "$@" ;;
    retro) cmd_retro ;;
    triage) shift; cmd_triage "$@" ;;
    findings) shift; cmd_findings "$@" ;;
    respond) shift; cmd_respond "$@" ;;
    loop) shift; cmd_loop "$@" ;;
    throughput) shift; cmd_throughput "$@" ;;
    flow) shift; cmd_flow "$@" ;;
    forecast) shift; cmd_forecast "$@" ;;
    vs) shift; cmd_vs "$@" ;;
    queue) shift; cmd_queue "$@" ;;
    requests) shift; cmd_requests "$@" ;;
    models) shift; cmd_models "$@" ;;
    -h | --help) sed -n '2,61p' "$0" ;;
    *) sed -n '2,59p' "$0" >&2; return 2 ;;
  esac
}

# Sourceable for tests; runs main only when executed.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
