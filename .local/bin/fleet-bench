#!/usr/bin/env bash
# fleet-bench - record where every live session is, predict when it finishes, and score
# the prediction once it does. Model-free; the shepherd only reads it.
#
#   fleet-bench sample           one sample: progress line per live session, a new ETA for
#                                any session whose phase moved, score any that finished,
#                                and the window per project as fleet_bench.prom
#   fleet-bench eta [--json]     the latest ETA per live session
#   fleet-bench report           live table, ETA accuracy so far, when the sampler last ran
#   fleet-bench accuracy --json  per basis: how far its raw ETAs ran, and the factor new ones get
#   fleet-bench headline         the last 24h in one line (the popup and the morning briefing)
#   fleet-bench scorecard        write the last 24h to <date>.md and latest.md in BENCH_SCORECARD_DIR
#   fleet-bench sessions --json  the scorecard's session rows, one JSON object each (day-log reads them)
#   fleet-bench stats --json [--since E]
#                                each session's whole life since E: minutes per bucket, nudges,
#                                escalations, phases ticked, peak context, merged PRs, lines, CI
#                                runs and reds (session-outcomes joins it into its row)
#   fleet-bench review [--days N]
#                                count failed CI runs (any workflow) before merge on PRs merged in the
#                                window, and on a repo with section roots each PR's sections and gate
#                                runs; --days widens the window and recounts rows that lack them
#   fleet-bench sections [--days N] [--json]
#                                per section of a repo: PRs, first-try share, gate reds and minutes,
#                                greens lost, and the claiming session's cost and tokens per PR
#   fleet-bench asks [--write]
#                                pending asks in hub Home's order (hub needs --json), the ones
#                                holding a live session listed first; --write also writes
#                                asks.md and prints one line (hub needs --page pages them)
#   fleet-bench ledger [--json|--check|--launches DIR...]
#                                runners, timers, direct headless launches, verdict words,
#                                asks, open board rows; --check fails when one may only shrink grew
#   fleet-bench rules [--json|--check|--scenarios]
#                                the rule register (RULES_REGISTER): kinds, confidence, actions, and each
#                                rule's number re-measured; --check fails when one moved against its
#                                recorded confidence, its measure died, or a rule's text left its source;
#                                --scenarios lists the hard scenarios a context trim must keep, 1 when any is stale
#   fleet-bench kpi [--json] [--vitals | --at T | --trend DAYS | --check [ERE]]
#                                KPIs over 7d and 28d of human sessions (the token ones from the
#                                nightly token-usage snapshots, sandboxed_lane_pct from BENCH_CALLS),
#                                against KPI_THRESHOLDS;
#                                --vitals the BENCH_VITALS rows, the front page every view reads,
#                                --at as of a past time, --trend one row a day of the 7d values,
#                                --check exits 1 past a threshold, on the KPIs whose name matches ERE
#   fleet-bench chain [--json|--check]
#                                the work-chain KPIs counted now (also in kpi); --check exits 1 past a threshold
#   fleet-bench startup [--json|--check]
#                                Claude Code start times (CLAUDE_STARTUP_LOG): medians over the last
#                                startup_rolling_n starts; --check exits 1 past startup_ready_ms_p50_max,
#                                2 with no SessionStart row in startup_stale_h or a start with no ready
#                                time (the claude-startup watch)
#   fleet-bench pipeline [--json]
#                                where every item sits, inbox to done: WIP and age per step, in and out,
#                                dwell, the bottleneck step and the record's drift from the queue folders
#   fleet-bench effect <T | owner/repo#N> [--days N] [--compare C] [--json]
#                                each windowed KPI over N days before a change landed against N after,
#                                beside the same split at C (default N days earlier) as a control
#   fleet-bench improve [--json] | file <kpi> <text> | claim <kpi> <ar-N|item:slug> | list [--json]
#                                the KPI furthest past its threshold that no live claim owns (exit 1
#                                when none, or BENCH_IMPROVE_MAX are live); file adds its row with a
#                                check and claims it, claim records a row or item that owns it (a
#                                row may claim each KPI its lever moves; the cap holds pick and file)
#   fleet-bench retro            a verdict on each claim whose PR landed BENCH_EFFECT_DAYS ago (a
#                                regression files a revert row), and one agent-board row per lesson
#                                that recurred in BENCH_GUARD_RECUR sessions (a guard row), and
#                                queues the week's canary run: the claude lane, then each lane in
#                                BENCH_CANARY_LANES whose source has room
#   fleet-bench canary list [--by harness,model] [--json] | verify [id...] | queue [--harness h [--model m [--effort e]]]
#                                | start <id> | score <id> | matrix [--harness h] [--days N] [--json]
#                                | shepherd [--days N] [--json] | dream [--days N] [--json]
#                                the fixed eval set: tasks from merged PRs, the pre-merge commit and
#                                the PR's own tests as the oracle. queue adds one night item per task
#                                a week (retro runs it), start puts the session's worktree at the
#                                task's base, score lays the oracle over it and records pass or fail
#                                once per run; verify proves each oracle fails at base, passes at merge;
#                                shepherd compares the shepherd's pass lanes (its CANARY_MODEL) by model;
#                                list --by sets each lane beside the claude lane on their shared tasks;
#                                matrix is BENCH_MATRIX's kind by stack grid and run modes for one
#                                harness: each cell proven, failing, excluded, no work, or empty
#   fleet-bench room             exit 1 while board_open is past board_open_max; information only,
#                                no filer holds on it (the board-open watch alerts)
#   fleet-bench triage [--dry-run|--coverage|--route <key>...]
#                                one agent-board row per FAILED or STALLED scheduled runner, failed
#                                user unit, Sentinel watch tripped past TRIAGE_WATCH_AFTER, runner
#                                stderr error signature recurring in BENCH_GUARD_RECUR runs and
#                                cc:red_now item nothing here reads, plus one per red that started
#                                within HOLD_HOURS after a cleanup merge; TRIAGE_ROUTES decides where
#                                each one goes, and an agent route or any watch route but a human's
#                                queues a red fix. --route prints
#                                each key (watch X, runner X, unit X) with its route, skill and
#                                tags, filing nothing
#   fleet-bench reds [--json] [--days N]
#                                each red fix queued in the last N days (REDS_DAYS) and what came
#                                of it: fixing, needs merge, fixed (merged, not red now), still red,
#                                came back (red again after the merge), alert route (red, but
#                                TRIAGE_ROUTES sends it to alert: its watch pages on a KPI no merge
#                                clears, so reds_unfixed leaves it out), cancelled (closed cancelled
#                                with no merge, as when handed to an owner), cleared (ok with no PR)
#                                or no fix (failed with no PR); and each
#                                merged cleanup item, its hold: holding (under HOLD_HOURS old), held,
#                                went red (a red now names it) or recovered (a red named it, now over)
#   fleet-bench findings [--open|--json|--run]
#                                conclusions that want a decision, from rules over counted facts
#                                on every machine; --run evaluates and appends (each sample does)
#   fleet-bench respond '<rule> <scope> @<episode>' <actor> <paged|asked|filed-row|cancelled|fixed> [ref]
#                                record what answered a finding (its fact), in responses.jsonl
#   fleet-bench loop [--json|--firing]
#                                each finding episode of the last 7d: minutes to its first response
#                                that is not a page, and DARK when it reached the human with only pages;
#                                --firing prints one sentence per dark episode still firing
#   fleet-bench throughput [--from T] [--to T]
#                                runs/h, failures, merges/h, pool wait and load on every host
#   fleet-bench flow [--from T] [--to T] [--json] [--hourly]
#                                phases in (plans started, phases added) against phases ticked,
#                                open at each end, and whether the fleet is draining
#   fleet-bench forecast [--json] [--queue] [--baseline <label>]
#                                every open phase in expected order, all-done-by at the calibrated
#                                and the recent pace, the drain, and the agent queue's items on the
#                                dispatcher's slots; --baseline freezes it to compare
#   fleet-bench epics [--json] [--project P]
#                                each project's features from idea to verified: per epic its brief,
#                                plans, rows, items, PRs and step, an ETA for the open ones, frozen
#                                on first sight and on a scope change, and scored when it lands
#   fleet-bench vs [<label>|latest] [--json]
#                                a frozen forecast against what the fleet did since, per session
#   fleet-bench queue [--json]   the agent queue over BENCH_QUEUE_DAYS: done by outcome, PRs, per
#                                day, wait and time to PR, from `agent-queue stats`
#   fleet-bench models [--by class,lane] [--json] landed rate, redo rate, reverts, cost, CI reds, first-pass
#                                share and window points per PR by model over BENCH_QUEUE_DAYS: queue
#                                model= joined to outcomes, model-lane runs, pr-ci.jsonl and sources;
#                                --by class splits each pairing by the task class on its outcome rows,
#                                --by lane by the model-lane lane its run logged under, or both
#   fleet-bench sources [--json] every claude-acct source over BENCH_QUEUE_DAYS: window points used,
#                                dollars, landed PRs, dollars and PRs per point (exit 1 unreadable)
#   fleet-bench sizes [--json]  work minutes per row size over BENCH_SIZES_DAYS against the weight
#                                the rollups use, and cycle and lead time per row kind
#   fleet-bench requests [--json] [--since T]
#                                the human's urgent requests, one row each (a plan chain is one row),
#                                then those finished since T: the head of every shepherd summary
# State is ~/.agent/bench/*.jsonl. Every number is counted, never a model's grade.
# Formulas, fields and outcomes: the fleet-bench skill.
# Seams: FLEET_BENCH_DIR, BENCH_NOW, BENCH_SESSIONS_CMD, BENCH_NEEDS_CMD, BENCH_LIB_DIR, BENCH_OUTCOMES_DIR,
# BENCH_CI_MATCH_CMD, BENCH_NOTES_CMD, BENCH_WAKES_CMD, BENCH_PROM_TSV, BENCH_MERGES_TSV, BENCH_RUNS_TSV, BENCH_PROJECT_MAP, BENCH_QUEUE_CMD,
# BENCH_ITEMS_CMD, BENCH_ADMISSION_CMD, BENCH_LESSONS_CMD, BENCH_DONE_ITEMS_CMD, BENCH_QUEUE_SLOTS, BENCH_DISPATCH_CONF, BENCH_FORECAST_HORIZON_H,
# BENCH_QUEUE_STATS_CMD, BENCH_QUEUE_DAYS, BENCH_LANE_LOG, BENCH_LANE_VOIDS, BENCH_SOURCES_CMD, BENCH_HARNESSES, BENCH_ROOM_CMD, BENCH_CANARY_LANES, BENCH_BOARD_CMD, BENCH_PROJECTS_CMD, BENCH_ROADMAP_CMD, BENCH_ALL_ITEMS_CMD, BENCH_PLAN_DIRS, BENCH_DOCS_CLEANUP_DIR, BENCH_DOCTOR_LAST, CHAIN_DAYS,
# FLEET_STATE_FILE, FLEET_SHEPHERD_DIR, WORKTREE_GC_LOG, WORKTREE_GC_STALE_H, BENCH_FLEET_COST_CMD, BENCH_FLEET_COST_FILE, BENCH_FLEET_COST_EVERY_MIN, BENCH_FLEET_COST_TIMEOUT, BENCH_BUDGET_CMD, BENCH_BUDGET_FILE,
#                                BENCH_BUDGET_EVERY_MIN, BENCH_BUDGET_TIMEOUT.

set -uo pipefail
# shellcheck source=../lib/end-reasons.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/end-reasons.sh"

# Each sample also publishes the window's numbers to Prometheus (fleet_bench.prom).
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/prom-textfile.sh"
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/prom.sh"
# shellcheck source=../lib/harness-projects.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/harness-projects.sh"   # harness_project_why: canary queue
# shellcheck source=../../.config/shared-hooks/project-name.sh
. "${PROJECT_NAME_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../../.config/shared-hooks/project-name.sh}"
# The forecast names each open phase from its plan with the one checklist parser.
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/plan-phases.sh"
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/main-state.sh"
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/test-pick.sh"
# shellcheck source=../lib/origin-repo.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/origin-repo.sh"   # forge_canonical, for the matrix

: "${BENCH_DEFAULT_PHASE_MIN:=60}"   # before anything is measured: today's observed pace
: "${BENCH_CAL_MIN_N:=5}"            # scored ETAs a basis needs before its median ratio scales new ones
: "${BENCH_BASIS_MIN_N:=3}"          # measured phases a session or project needs before its median makes ETAs
: "${BENCH_CAL_MIN:=0.25}"           # clamp on that factor: a few odd runs cannot shrink an ETA to nothing
: "${BENCH_CAL_MAX:=4}"              # nor stretch it to days
: "${BENCH_SESSIONS_CMD:=fleet-sessions --write}" # also refreshes the fleet state document
: "${BENCH_CI_MATCH_CMD:=hub ci --pool-match}"   # given the wait (s) a job must have waited; hub_core::ci's pool match rows
: "${BENCH_NEEDS_CMD:=hub needs --json}"   # hub Home's ranked NEEDS YOU (hub_core::home::needs)
: "${BENCH_ASKS_ALL_CMD:=agent-ask list --all}"   # every ask, for the ask KPIs
: "${BENCH_WINDOW_H:=24}"            # what a scorecard and the headline cover
: "${BENCH_GAP_CAP_MIN:=20}"         # two sampler cadences: a longer gap is a sampler outage, not time spent
: "${BENCH_SCORECARD_DIR:=$HOME/.notes/lab/projects/current/agent-runtime/docs/bench}"
: "${BENCH_OUTCOMES_DIR:=$HOME/.agent/outcomes}"
: "${BENCH_TIME_DAYS:=7}"
: "${BENCH_QUEUE_STATS_CMD:=agent-queue stats --json}"   # given --since <date>
: "${BENCH_QUEUE_DAYS:=7}"           # what the queue line and the scorecard's queue tables cover
: "${BENCH_SIZES_DAYS:=28}"          # the done items fleet-bench sizes calibrates on
: "${BENCH_SECTIONS_DAYS:=7}"        # the merged PRs fleet-bench sections covers
: "${BENCH_SECTIONS_TOP:=15}"        # sections the scorecard prints, by gate hours
: "${BENCH_SIZES_MIN:=10}"           # items with work_min a size needs before it is calibrated
: "${LEDGER_CONF_DIR:=$HOME/.config/agentctl/agents}"
: "${LEDGER_SRC:=$HOME/.dotfiles/.local:$HOME/.dotfiles/.config:$HOME/.dotfiles/.claude/skills:$HOME/.dotfiles-private/.local:$HOME/.dotfiles-private/.config:$HOME/.dotfiles-private/.claude/skills}"   # colon-separated
: "${LEDGER_BASELINE:=$HOME/.config/agentctl/ledger-baseline}"
: "${RULES_REGISTER:=$HOME/.config/agentctl/rules.jsonl}"
: "${RULES_MEASURE_TIMEOUT:=20}"      # seconds one rule's measure may run
: "${ASK_STALE_DAYS:=14}"            # a pending ask older than this is stale
: "${KPI_THRESHOLDS:=$HOME/.config/agentctl/kpi-thresholds}"
: "${KPI_BOARD:=agent-runtime}"       # the agent board improve, retro and triage file rows on
: "${BENCH_EFFECT_DAYS:=14}"        # effect: the window on each side of a change
: "${BENCH_EFFECT_FLAT:=0.1}"       # effect: a relative move inside this is flat
: "${BENCH_IMPROVE_MAX:=3}"         # improve: live claims at which the pick and file go quiet (the WIP cap)
: "${BENCH_LOG_CMD:=notes log --json}"   # improve: the row and item record, given --days N
: "${TRIAGE_SYSTEMCTL:=systemctl}"     # triage: failed user units
: "${TRIAGE_WATCH_STATE:=$HOME/.local/state/watch-companion}"   # triage: Sentinel's <watch>.state and .since
: "${TRIAGE_WATCHES:=$HOME/.agent/watches}"   # triage: each watch's manifest, for its severity and what
: "${TRIAGE_LOG_HOURS:=24}"        # triage: the runs whose stderr is read for error signatures
: "${TRIAGE_ERR_RE:=error|fatal|traceback|failed}"   # triage: a stderr line that may be an error (case-blind)
: "${TRIAGE_ROUTES:=$HOME/.config/agentctl/triage-routes}"   # triage: where each red goes; the format is in the file
: "${TRIAGE_FIX_CAP:=4}"            # triage: red fixes queued a day, every route together but a tripped watch's (one item a watch at a time bounds those)
: "${TRIAGE_FIX_DAYS:=7}"           # triage: the window a cause's fix items are counted in
: "${TRIAGE_FIX_TRIES:=2}"          # triage: fix items a cause gets in the window before it goes to the human
: "${REDS_DAYS:=7}"                 # reds: days of red fixes the report and its KPIs read
: "${HOLD_HOURS:=24}"               # reds: hours after a cleanup merge that a new red counts against it
: "${TRIAGE_HOLD_CMD:=agent-hold check dispatch}"   # triage: a dispatch hold stops queueing, never filing
: "${TRIAGE_ITEMS_CMD:=agent-queue list --json --state all}"   # triage: given --since <date>
: "${TRIAGE_RED_CMD:=red_items}"    # triage: given the epoch, the cc:red_now items that stayed red
: "${TRIAGE_NOTIFY_CMD:=agent-notify}"   # triage: pages a human route once, when its row lands
: "${TRIAGE_PROMOTE_CMD:=fleet-dispatch promote}"   # triage: queue one board row as it stands
: "${TRIAGE_WATCH_AFTER:=1800}"      # triage: seconds a watch must stay TRIP before it is a row and a red item: two dispatch passes, so its owner runs the hour it trips (human, 2026-11-10, ar-1531)
: "${TRIAGE_WATCH_HIGH_AFTER:=900}" # triage: the same for a high or urgent watch: one dispatch pass, so one flap is not a row
: "${BENCH_GUARD_RECUR:=2}"         # retro: sessions a lesson must recur in before it wants a guard
: "${BENCH_SO_LIB:=$HOME/.local/lib/session-outcomes.sh}"   # so_lesson_sigs, so_forgejo_pr
: "${BENCH_CANARY_DIR:=$HOME/.config/fleet-bench/canary}"   # canary: one <id>.json per task (content as data)
: "${BENCH_CANARY_QUEUE_CMD:=agent-queue}"   # canary queue: show and add
: "${BENCH_CANARY_TIMEOUT:=900}"   # canary: seconds an oracle may run
: "${BENCH_CANARY_WRAP:=}"   # canary score: a shell prefix the oracle command runs inside (fleet-dispatch: a sandboxed lane's srt line)
: "${BENCH_CANARY_CONFIG_REPOS:=$HOME/.dotfiles:$HOME/.dotfiles-private}"   # canary score: the config a run ran under, by HEAD (colon-separated)
: "${BENCH_CANARY_LANES:=$HOME/.config/fleet-bench/canary-lanes}"   # retro: the lanes canaried beside claude, `harness model [effort]` a line (content as data)
: "${BENCH_MATRIX:=$HOME/.config/fleet-bench/matrix.json}"   # canary matrix: kinds, stacks, modes and excluded cells (content as data)
: "${BENCH_HARNESSES:=$HOME/.config/agentctl/harnesses.json}"   # each harness's `source`: a lane's capacity, a session's and an item's source
: "${BENCH_ROOM_CMD:=claude-acct room}"   # retro: exit 0 when a Claude account has room, or with --source <name>, when that source has
: "${BENCH_SOURCES_CMD:=claude-acct status --json}"   # sources: every source's row, the one writer's
: "${BENCH_NOTES_CMD:=notes}"
: "${BENCH_WAKES_CMD:=agent-usage wakes}"   # given --since <window>h --json
: "${BENCH_TOKENS_CMD:=agent-usage tokens line}"   # the newest nightly token-usage snapshot's row
: "${WORKTREE_GC_LOG:=$HOME/.agent/telemetry/worktree-gc.jsonl}"   # one row a night: trees by state (agentctl-worktree-gc is its writer)
: "${WORKTREE_GC_STALE_H:=48}"                                   # a last row older than this reads ?, a dead runner is not a flat count
: "${CLAUDE_STARTUP_LOG:=$HOME/.agent/telemetry/claude-startup.jsonl}"   # one row per SessionStart (startup-telemetry.sh)
: "${BENCH_CALLS:=${AGENTCTL_CALLS:-${XDG_STATE_HOME:-$HOME/.local/state}/agentctl/calls.jsonl}}"   # one row per agent call (agent-run lib/calls.sh)
: "${BENCH_TOKENS_DIR:=$HOME/.agent/token-usage}"  # the nightly token-usage snapshots: the token KPIs' days
: "${BENCH_WEEK_CMD:=day-log week --line}"         # the newest stored week: what moved, against the week before
: "${BENCH_COMMS_CMD:=comms-lint}"                 # the newest nightly comms snapshot: `line` and `kpi --json`
: "${BENCH_JUDGE_CMD:=judge-eval}"                 # the judge lanes scored against their ground truth: `kpi --json`
: "${WAKE_CALLS_TARGET:=2}"          # calls a passing background-task wake should take: read the verdict, nothing else
: "${BENCH_PROJECT_MAP:=$(project_map_file)}"
: "${BENCH_FORECAST_HORIZON_H:=48}"   # a baseline still open this long is scored as a lower bound
: "${BENCH_QUEUE_CMD:=fleet-dispatch fill --dry-run --json}"   # rows dispatch would start after the live work
: "${BENCH_ITEMS_CMD:=agent-queue list --json --state active}"   # the queue's items: work already asked for
: "${BENCH_ADMISSION_CMD:=agent-queue admission --json}"   # the queue's admission: automated adds it held
: "${BENCH_VITALS:=output=merged_prs flow=queue_net_24h,step_age_p90_queued quality=rework_candidate_7d,first_pass_share you=human_answered_per_day,buzzes_per_day cost=points_per_pr trust=ledger_coverage,loop_dark_7d outcome=requested_unstarted_h,landed_unverified}"   # the front page: question=kpi,kpi in order; every view reads this list
: "${BENCH_LESSONS_CMD:=agentctl-session-outcomes lessons --cached --json}"   # each lesson with a sig: did it hold
: "${BENCH_DONE_ITEMS_CMD:=agent-queue list --json --state done}"   # given --since <day>
: "${BENCH_LANE_LOG:=$HOME/.agent/model-lane/runs.jsonl}"   # model-lane log: one row per dispatched run, its outcome
: "${BENCH_LANE_VOIDS:=${BENCH_LANE_LOG%/*}/voids.jsonl}"   # model-lane's voids beside it: runs to rate no more (`model-lane void`)
: "${BENCH_INGEST:=$HOME/.local/state/notes/ingest.jsonl}"   # the notes CLI's record of every row it wrote: who, from where
: "${BENCH_PROFILE:=}"                             # the profile board_open counts; empty asks `notes config`
: "${BENCH_BOARD_CMD:=notes board --json}"          # every open row, both lanes, every profile (board_open reads one: board_open_count)
: "${BENCH_PROJECTS_CMD:=notes projects --stats --json}"   # each project's open epics with their rollups
: "${BENCH_DOCS_CLEANUP_DIR:=${XDG_STATE_HOME:-$HOME/.local/state}/agentctl/docs-cleanup}"   # the nightly docs-cleanup baselines, one dated dir each
: "${BENCH_DOCTOR_LAST:=${XDG_STATE_HOME:-$HOME/.local/state}/agentctl/project-index/doctor.last}"   # the nightly notes doctor
: "${BENCH_STEPS_CMD:=notes log --steps --json}"   # the record replayed per step: flows, dwell, the items it holds
: "${BENCH_INBOX_CMD:=inbox_lines}"                # how many lines wait untriaged
: "${BENCH_STOPPED_CMD:=fleet-dispatch stopped --json}"   # why nothing is leaving the queue, when dispatch has stopped
: "${PIPELINE_SNAPSHOT:=${XDG_STATE_HOME:-$HOME/.local/state}/agentctl/pipeline/pipeline.json}"   # what the Queue tab's pipeline line reads
: "${CHAIN_DAYS:=7}"                 # the merged PRs ledger_coverage counts
# A Sentinel probe's fix watermark (SENTINEL_SINCE, set by watch-companion-loop resolve), an epoch, 0 for
# none. ledger_coverage, untracked_merged_prs, wants_unstamped and reds_unfixed count from the later of
# their window start and this, so a watch's fixed red stops counting the events before its fix; a row
# with no readable time still counts, so a watermark never hides it. The step ages and the other
# chain KPIs read the state now, which a watermark would only hide.
FIX_SINCE=0; if [[ "${SENTINEL_SINCE:-}" =~ ^[0-9]+$ ]]; then FIX_SINCE=$SENTINEL_SINCE; fi
: "${BENCH_LEAD_DAYS:=28}"            # request_to_live_h: days of done items read back, so a merge released this week counts
: "${BENCH_FLEET_COST_CMD:=agent-usage fleet-cost --json}"
: "${BENCH_FLEET_COST_FILE:=${XDG_STATE_HOME:-$HOME/.local/state}/fleet/fleet-cost.json}"
: "${BENCH_FLEET_COST_EVERY_MIN:=30}"
: "${BENCH_FLEET_COST_TIMEOUT:=240}"
: "${BENCH_BUDGET_CMD:=agent-usage budget --json}"   # this month's cash, by bill: the Costs Budget tab and fleet-budget-pace read the file
: "${BENCH_BUDGET_FILE:=${XDG_STATE_HOME:-$HOME/.local/state}/fleet/budget.json}"
: "${BENCH_BUDGET_EVERY_MIN:=30}"
: "${BENCH_BUDGET_TIMEOUT:=120}"
: "${BENCH_RELEASES_CMD:=hub releases --json}"   # request_to_live_h: a project with a row goes live at its tag's first deploy (hub_core::release_graph), one without on its merge
: "${BENCH_RELEASED_CMD:=release-state released}"     # given <project> <sha>...: the first tag of its line holding each
: "${BENCH_LEAD_TRUST=ledger_coverage epic_linked_share}"   # request_to_live_h reads ? until each is inside its kpi-thresholds bound; set empty, no gate
: "${BENCH_SKILL_CMD:=agentctl skill --dangling}"   # each runner whose SKILL= names no skill, as "<runner> SKILL=<name>"
: "${BENCH_DISPATCH_CONF:=$HOME/.config/agentctl/agents/fleet-dispatch.conf}"   # DISPATCH_TARGET_PRESENT, the slots items run on
: "${BENCH_VERDICTS_CMD:=fleet-dispatch verdicts}"   # the judge's latest verdict per row: next_up_blocked
: "${BENCH_RUNS_TSV:=${XDG_STATE_HOME:-$HOME/.local/state}/unity-test-runs/runs.tsv}"
: "${BENCH_ROADMAP_CMD:=notes projects --roadmap}"   # given <project> --json: open and closed epics, leaf rows
: "${BENCH_ALL_ITEMS_CMD:=agent-queue list --json --state all}"   # every item, done included: an epic's items and PRs
: "${BENCH_PLAN_DIRS:=$HOME/.claude/plans:$HOME/.claude-personal/plans:$HOME/.agent/plans}"   # an epic's plans, by their epic: line; the first dir wins a name
DIR="${FLEET_BENCH_DIR:-$HOME/.agent/bench}"
PROGRESS="$DIR/progress.jsonl"
ESTIMATES="$DIR/estimates.jsonl"
SCORES="$DIR/scores.jsonl"
CI="$DIR/pr-ci.jsonl"
FINDINGS="$DIR/findings.jsonl"
CANARY="$DIR/canary.jsonl"   # canary: one score row per run; append-only, fleet-bench score the one writer
EFFECT="$DIR/effect.jsonl"   # improve: claims (each with its baseline) and verdicts; append-only, fleet-bench the one writer
RESPONSES="$DIR/responses.jsonl"   # fleet-bench respond: what answered each finding
FORECASTS="$DIR/forecasts.jsonl"
FORECAST_SCORES="$DIR/forecast-scores.jsonl"
EPIC_BASELINES="$DIR/epic-baselines.jsonl"   # an open epic's ETA, frozen when first seen and on each scope change
FINDINGS_PASS="$DIR/findings.last"   # epoch of the last evaluation: a healthy pass writes no findings row
STATE_FILE="${FLEET_STATE_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/fleet/state.json}"   # fleet-sessions --write
RUNDOWNS="${FLEET_SHEPHERD_DIR:-$HOME/.agent/shepherd}/rundowns"   # the newest one is the last summary
SHEPHERD_PASSES="${FLEET_SHEPHERD_DIR:-$HOME/.agent/shepherd}/passes.tsv"   # one scored pass a row, fleet-shepherd the writer
DREAM_TRIAL="${DREAM_TRIAL_FILE:-$HOME/.agent/dreams/trial.tsv}"   # one counted sweep a row, agentctl-dream the writer
NAME="${AGENTCTL_NAME:-fleet-bench}"   # each agentctl runner publishes under its own name
CAL_ARGS=(--argjson minn "$BENCH_CAL_MIN_N" --argjson lo "$BENCH_CAL_MIN" --argjson hi "$BENCH_CAL_MAX")

say() { printf 'fleet-bench: %s\n' "$*" >&2; }

# agent-proof.sh owns the agentctl state dir and the last-outcome contract.
proof_lib() {
  local lib="${BENCH_LIB_DIR:-$HOME/.local/lib}/agent-proof.sh"
  # shellcheck source=/dev/null
  [ -f "$lib" ] && . "$lib"
}

report_outcome() { proof_lib && proof_outcome "$NAME" "$@"; }

now() { printf '%s' "${BENCH_NOW:-$(date +%s)}"; }

# jq helpers shared by every verb.
VITALS_JQ='def vitals($v): [$v | splits("\\s+") | select(test("^[^=]+=[^=]+$")) | split("=") | {question: .[0], kpi: (.[1] | split(",")[])}];'
JQ_LIB='
def median: sort | length as $n | if $n == 0 then null
  elif $n % 2 == 1 then .[($n - 1) / 2] else (.[$n / 2 - 1] + .[$n / 2]) / 2 end;
def iso: strflocaltime("%Y-%m-%dT%H:%M:%S%z");
def hm: if . == null then "-" else strflocaltime("%a %H:%M") end;
def round1: . * 10 | round / 10;
def round2: . * 100 | round / 100;
def ownerless: select((.state == "running" or .state == "review" or .state == "waiting") and (.session // "") == "" and (.sessions // "") == "");
def ep: if . == null or . == "" then null else (sub("\\.[0-9]+"; "") | fromdateiso8601? // null) end;   # a queue or gh time
def tagged($t): (" " + (.tags // "") + " ") | contains(" \($t) ");
# A canary score on the claude baseline: claude as dispatch runs it. A claude lane pins an effort (canary queue), so it is never pooled in.
def canary_base: (.harness // "claude") == "claude" and (.effort // "") == "";
# An end that says nothing about the model (UNRATED_ENDS, lib/end-reasons.sh) is no evidence for or against it.
def unrated: (.end_reason // "") | IN('"$(unrated_json)"'[]);
def hold_key: "fix(hold): \(.name) went red";
# an epic (notes projects rollup) whose every leaf has closed: ready to verify
def leaves_landed: .open == 0 and .done > 0;
# agent-ask stamps date +%Y-%m-%dT%H:%M:%S%z; jq has no offset-aware parser
def ask_epoch: (.[0:19] + "Z" | fromdateiso8601)
  - ((if .[19:20] == "-" then -1 else 1 end) * ((.[20:22] | tonumber) * 3600 + (.[22:24] | tonumber) * 60));
# iso_epoch: an ISO time with a Z, +HH:MM or +HHMM offset (date -Iseconds writes the colon form)
def iso_epoch: if endswith("Z") then fromdateiso8601 else sub(":(?<m>[0-9]{2})$"; "\(.m)") | ask_epoch end;
def ratio($a; $b): if $b == 0 then null else ($a / $b * 1000 | round) / 1000 end;   # 3 places, null over none
# move($before; $after; $dir; $flat): improved or regressed when the value moved more than $flat
# (relative) the way $dir says (-1 lower is better, 1 higher), flat inside that, - with no value
def move($b; $a; $dir; $flat): if $b == null or $a == null or $dir == 0 then "-"
  else (if $b == 0 then (if $a == 0 then 0 else ($a | if . > 0 then 1 else -1 end) end)
        else ($a - $b) / ($b | fabs) end) as $rel
  | if ($rel | fabs) <= $flat then "flat" elif $rel * $dir > 0 then "improved" else "regressed" end end;
def dur: if . >= 3600 then "\(. / 3600 | round1)h" else "\(. / 60 | round)m" end;
def run_rows: split("\n") | map(select(. != "") | split("\t")
  | {s: ((.[0] | tonumber) - (.[1] | tonumber)), res: .[2], branch: .[5], repo: .[6]});
def total(f): map(f // 0) | add // 0;
def key: "\(.repo)#\(.number)";
# the lowercase owner/repo#N an item names (prkeys); the repo of a Forgejo row also carries its host
def itemkey: "\(.repo // "" | split("/") | .[-2:] | join("/") | ascii_downcase)#\(.number)";
# every PR an item names (pr and prs, owner/repo#N or a pull URL), lowercase owner/repo#N. A bare
# number names no repo, so it credits nothing: PR numbers repeat across repos.
def prkeys: [.pr, .prs] | map(strings) | join(" ") | ascii_downcase
  | [scan("([a-z0-9_.-]+/[a-z0-9_.-]+)(?:#|/pulls?/)([0-9]+)") | "\(.[0])#\(.[1])"];
# the "<project>:<id>" board row a queue item works: its row, else the board: it came from
def rowkey: .row // ((.from // "") | select(startswith("board:")) | ltrimstr("board:"));
def claimed: (.session_id // "") != "";
def ran_gate: (.gate_runs // 0) > 0;
def first_try: .gate_red == 0;
def kind: sub("\\(.*"; "");
# the ETA an estimate publishes and how it was made: calibrated when a factor was applied;
# null for no estimate
def shown_eta: if . == null then null else .cal_eta_epoch // .eta_epoch end;
# the ETA column of a live row: the time, or how late it is once that time has passed
def eta_cell: if .late_min != null then "late \(.late_min * 60 | dur)" else (.eta | shown_eta | hm) end;
def basis_label: if . == null then null
  else .basis + (if .factor != null then " x\(.factor) (n=\(.factor_n))" else "" end) end;
# scores in -> one object per basis kind: how far its raw ETAs ran, and the calibration factor
# a new estimate of that kind gets (null below $minn scores with a ratio). Scores are raw, so
# the factor is made from raw ratios only.
def accuracy($minn; $lo; $hi):
  group_by(.basis | kind) | map(
    (map(.ratio // empty) | median | if . == null then null else (. * 100 | round) / 100 end) as $mr
    | (map(.ratio // empty) | length) as $nr
    | {basis: (.[0].basis | kind), n: length, n_ratio: $nr, median_ratio: $mr,
       median_error_min: (map(.error_min) | median),
       median_abs_error_min: (map(.error_min | fabs) | median),
       factor: (if $nr < $minn then null else [[$mr, $lo] | max, $hi] | min end)});
# per-phase minutes for each phase whose start and end were both sampled
def phase_minutes:
  sort_by(.epoch)
  | reduce .[] as $r ({prev: null, starts: []};
      if .prev != null and $r.phases_done != null and .prev.phases_done != null
         and $r.phases_done > .prev.phases_done
      then .starts += [{epoch: $r.epoch, from: .prev.phases_done, to: $r.phases_done}]
      else . end
      | .prev = $r)
  | .starts as $s
  | [range(1; $s | length) | ($s[.].epoch - $s[. - 1].epoch) / 60 / ($s[.].to - $s[.].from)];
def pct($q): sort | if length == 0 then null else .[((length - 1) * $q) | floor] end;
# live rows (latest_live) in -> each session with phases left and a measured pace, every open
# phase given a p50 end (per-phase minutes x the estimate factor) and a slow end (x $slow, the
# last window scored ratio), in plan order. A session past its ETA has its current phase due
# now and the rest after it. $names maps session_id to the open phase names of its plan.
def schedule($t; $slow; $names):
  map(select((.finished | not) and .phases_total != null and .phases_done != null and .eta != null)
    | (.phases_total - .phases_done) as $left | select($left > 0)
    | . as $r | ($r.eta.per_phase_min * 60) as $m
    | ($m * ($r.eta.factor // 1)) as $P | ($m * $slow) as $S
    | ([$r.eta.made_epoch + $P, $t] | max) as $p1 | ([$r.eta.made_epoch + $S, $t] | max) as $s1
    | ($names[$r.session_id] // []) as $nm
    | {session_id, target, project, bucket, phases_done, phases_total, left: $left, late_min,
       basis: ($r.eta | basis_label),
       phases: [range(0; $left) | {name: ($nm[.] // "phase \($r.phases_done + . + 1)"),
                                   p50: ($p1 + . * $P | floor), slow: ($s1 + . * $S | floor)}]}
    | . + {finish_p50: .phases[-1].p50, finish_slow: .phases[-1].slow});
def fleet_finish: {median_p50: (map(.finish_p50) | median | if . == null then null else floor end),
  p90_p50: (map(.finish_p50) | pct(0.9)), last_p50: (map(.finish_p50) | max),
  median_slow: (map(.finish_slow) | median | if . == null then null else floor end),
  p90_slow: (map(.finish_slow) | pct(0.9)), last_slow: (map(.finish_slow) | max)};
# queue items in (enriched by forecast_json: phases, P and S seconds a phase, start, live, after,
# why) -> each item placed on $K dispatcher slots on track $k ("P" or "S"). Running items hold a
# slot until they end (the finish of its live session when that is on the schedule). Each time
# the earliest slot frees, it goes to the first queued item in queue order whose after: parents
# have all ended by then, or else to the one ready soonest: fleet-dispatch starts the runnable head.
# Items with a why, and those behind one, stay unplaced.
def qplace($t; $K; $k):
  (map(select(.state == "running")
       | . + {end: (if .live != null then .live[$k] else ([.start + .phases * .[$k], $t] | max | floor) end)})) as $run
  | ($run | map(.end)) as $busy
  | {done: ($run | map({key: .slug, value: .end}) | from_entries),
     free: ($busy + [range(0; [$K - ($busy | length), 0] | max) | $t] | sort),
     placed: ($run | map({slug, start, end})),
     todo: map(select(.state == "queued" and .why == null)), stuck: false}
  | until((.todo | length) == 0 or .stuck;
      . as $s
      | ($s.free[0] // $t) as $slot
      | [$s.todo | to_entries[] | (.value.after // []) as $par | select(all($par[]; $s.done[.] != null))
         | . + {ready: ([$par[] | $s.done[.]] + [$t] | max)}] as $can
      | (($can | map(select(.ready <= $slot)) | first) // ($can | min_by(.ready))) as $pick
      | if $pick == null then .stuck = true
        else $pick.value as $it
          | ([$pick.ready, $slot] | max) as $start
          | ($start + $it.phases * $it[$k] | floor) as $end
          | .free = (.free[1:] + [$end] | sort) | .done[$it.slug] = $end
          | .placed += [{slug: $it.slug, start: $start, end: $end}]
          | .todo = (.todo | del(.[$pick.key]))
        end)
  | {placed: (.placed | INDEX(.slug)), behind: (.todo | map(.slug))};
# progress rows in -> open phases in the newest sample at or before $t
def open_at($t): map(select(.epoch <= $t)) | (map(.epoch) | max) as $s
  | if $s == null then 0 else
      map(select(.epoch == $s and (.finished | not) and .phases_total != null and .phases_done != null)
          | .phases_total - .phases_done | select(. > 0)) | add // 0 end;
# progress rows in -> one step per sample of each (session, plan): the first sample of a plan
# starts it with its open phases; every later one ticks, adds or removes phases against the one before
def flow_steps: map(select(.phases_total != null and .phases_done != null))
  | group_by([.session_id, .plan_file]) | map(sort_by(.epoch) | . as $r
      | [{epoch: $r[0].epoch, session_id: $r[0].session_id, project: $r[0].project, start: 1, open: ([$r[0].phases_total - $r[0].phases_done, 0] | max),
          ticked: 0, added: 0, removed: 0}]
        + [range(1; length) | {epoch: $r[.].epoch, session_id: $r[.].session_id, project: $r[.].project, start: 0, open: 0,
          ticked: ([$r[.].phases_done - $r[. - 1].phases_done, 0] | max),
          added: ([$r[.].phases_total - $r[. - 1].phases_total, 0] | max),
          removed: ([$r[. - 1].phases_total - $r[.].phases_total, 0] | max)}]) | add // [];
def flow_sum: {ticked: (map(.ticked) | add // 0), added: (map(.added) | add // 0),
  removed: (map(.removed) | add // 0), started: (map(.start) | add // 0), started_open: (map(.open) | add // 0)}
  | . + {in: (.started_open + .added)};
# progress rows in -> what came in and what went out between $a and $b. dropped is the open
# phases that left with a session that ended unfinished: the remainder of the balance.
def flow($a; $b): . as $p | (($b - $a) / 3600) as $h
  | def per($x): if $h > 0 then $x / $h | round2 else null end;
  ($p | flow_steps | map(select(.epoch > $a and .epoch <= $b))) as $st
  | ($p | open_at($a)) as $o0 | ($p | open_at($b)) as $o1
  | ($st | flow_sum) as $f
  | {from: $a, to: $b, hours: ($h | round2)} + $f
  + {net_in: ($f.in - $f.removed), in_per_h: per($f.in), out_per_h: per($f.ticked),
     net_in_per_h: per($f.in - $f.removed), open_start: $o0, open_end: $o1,
     dropped: ($o0 + $f.in - $f.removed - $f.ticked - $o1),
     by_project: ($st | group_by(.project) | map({project: .[0].project} + flow_sum) | sort_by(-.ticked)),
     hourly: ($st | group_by(.epoch / 3600 | floor) | map({hour: ((.[0].epoch / 3600 | floor) * 3600)} + flow_sum)
       | reduce .[] as $x ({scope: $o0, done: 0, rows: []};
           .scope += ($x.in - $x.removed) | .done += $x.ticked
           | .rows += [$x + {scope: .scope, done: .done}]) | .rows)};
# progress rows in -> a frozen forecast $b against what happened by $t: per baseline session the
# phases expected by now (p50 and slow) against the phases it ticked, and the scope that came in.
def vs($b; $t): . as $p | $b.made_epoch as $m
  | ($p | map(select(.epoch <= $t)) | map(.epoch) | max) as $last
  | ($p | map(select(.epoch == $last)) | map({key: .session_id, value: .}) | from_entries) as $cur
  | ($p | flow_steps | map(select(.epoch > $m and .epoch <= $t))) as $st
  | ($b.schedule | map(.session_id)) as $ids
  | ($b.schedule | map(. as $s | $cur[$s.session_id] as $r
      | ($st | map(select(.session_id == $s.session_id))) as $mine
      | ([$s.phases[] | select(.p50 <= $t)] | length) as $exp
      | ([$mine | map(.ticked) | add // 0, $s.left] | min) as $act
      | {target: $s.target, session_id: $s.session_id, left: $s.left, expected: $exp,
         expected_slow: ([$s.phases[] | select(.slow <= $t)] | length), ticked: $act,
         added: ($mine | map(.added) | add // 0), removed: ($mine | map(.removed) | add // 0),
         new_plans: ($mine | map(.start) | add // 0),
         state: (if $r == null then "gone"
                 elif $r.finished or $act >= $s.left or ($r.phases_total != null and $r.phases_done != null and $r.phases_done >= $r.phases_total) then "finished"
                 elif $act > $exp then "ahead" elif $act < $exp then "behind" else "on track" end),
         next: ($s.phases[$act].name // null)}
      # behind: minutes since the phase it is on was due; ahead: minutes early on the last one it ticked
      | . + {min: (if .state == "behind" then (($t - $s.phases[$act].p50) / 60 | floor)
                   elif .state == "ahead" then (($s.phases[$act - 1].p50 - $t) / 60 | floor) else null end)})) as $rows
  | ($p | flow($m; $t)) as $f
  | {label: $b.label, made_epoch: $m, now: $t, hours: (($t - $m) / 3600 | round2),
     expected: ($rows | map(.expected) | add // 0), expected_slow: ($rows | map(.expected_slow) | add // 0),
     ticked: ($rows | map(.ticked) | add // 0), ticked_all: $f.ticked,
     states: ($rows | group_by(.state) | map({key: .[0].state, value: length}) | from_entries),
     added: ($rows | map(.added) | add // 0), removed: ($rows | map(.removed) | add // 0),
     new_plans: ($rows | map(.new_plans) | add // 0),
     started_since: ($st | map(select(.start == 1 and (.session_id as $i | $ids | index($i) | not)) | .session_id) | unique | length),
     in: $f.in, in_per_h: $f.net_in_per_h, in_per_h_frozen: $b.drain.in_per_h, out_per_h: $f.out_per_h,
     sessions: $rows};
# progress rows in -> the score of baseline $b at $t once it resolves: every one of its sessions
# finished or gone, or $hz hours passed. Nothing until then, so a baseline is scored once.
def forecast_score($b; $t; $hz): . as $p | $b.made_epoch as $m
  | ($p | map(select(.epoch <= $t)) | map(.epoch) | max) as $last
  | ($p | flow_steps | map(select(.epoch > $m and .epoch <= $t))) as $st
  | ($b.schedule | map(. as $s | ($p | map(select(.session_id == $s.session_id and .epoch > $m and .epoch <= $t))) as $r
      # done when it says so, or once it has ticked as many phases as it had open, as vs counts it
      | ([$st[] | select(.session_id == $s.session_id)] | sort_by(.epoch)
         | reduce .[] as $x ({n: 0, at: null}; .n += $x.ticked | if .at == null and .n >= $s.left then .at = $x.epoch else . end) | .at) as $ticked
      | ([($r | map(select(.finished or (.phases_total != null and .phases_done != null and .phases_done >= .phases_total))) | map(.epoch) | min), $ticked]
         | map(select(. != null)) | min) as $fin
      | ($r | map(.epoch) | max) as $seen
      | if $fin != null then {end: $fin, how: "finished"}
        # gone: ended by the first sample that no longer had it
        elif ($seen // $m) < $last then {end: ($p | map(.epoch | select(. > ($seen // $m))) | min), how: "gone"}
        else {end: null, how: "open"} end)) as $ends
  | ($ends | map(select(.end == null)) | length) as $open
  | select($open == 0 or $t - $m >= $hz * 3600)
  | (if $open == 0 then ($ends | map(.end) | max) else $t end) as $end
  | def ratio($pred): if $pred == null or $pred <= $m then null else (($end - $m) / ($pred - $m) | round2) end;
  {label: $b.label, made_epoch: $m, scored_epoch: $t, resolved_by: (if $open == 0 then "all done" else "horizon" end),
   sessions: ($ends | length), finished: ($ends | map(select(.how == "finished")) | length),
   gone: ($ends | map(select(.how == "gone")) | length), open: $open,
   actual_last: (if $open == 0 then $end else null end),
   bound: (if $open == 0 then "exact" else "lower" end),
   pred_last_p50: $b.last_p50, pred_last_slow: $b.last_slow, pred_drain: $b.drain.epoch,
   ratio_p50: ratio($b.last_p50), ratio_slow: ratio($b.last_slow),
   error_min: (if $b.last_p50 == null then null else (($end - $b.last_p50) / 60 | floor) end),
   within_slow: ($b.last_slow != null and $end <= $b.last_slow)}
  + ($p | flow($m; $end) | {in, ticked, in_per_h: .net_in_per_h, in_per_h_frozen: $b.drain.in_per_h});
'

# sample_rows -> the live fleet-sessions rows as progress lines (NIGHTLY, CHECKOUT and SHARED rows have no session)
sample_rows() {
  local t="$1"
  $BENCH_SESSIONS_CMD | jq -c --argjson t "$t" "$JQ_LIB"'
    select(type == "object" and (.session_id // "") != "" and (.bucket | IN("NIGHTLY", "CHECKOUT", "SHARED") | not))
    | {epoch: $t, at: ($t | iso), session_id, target, project, bucket,
       phases_done, phases_total, next_phase, finished: (.finished // false), idle_min,
       context_tokens, nudged, escalated, pr, plan_file}'
}

# new_estimates <now> -> an estimate for every live, unfinished session with a phase count
# that has no estimate yet. Reads the whole progress history for the medians. The raw ETA is
# what gets scored; the calibration factor is the median raw ratio of that basis kind's past
# scores, kept in its own fields, so it never feeds back into the ratios it is made from.
new_estimates() {
  local t="$1" est="$ESTIMATES" sc="$SCORES"
  [ -s "$est" ] || est=/dev/null
  [ -s "$sc" ] || sc=/dev/null
  jq -cn --argjson t "$t" --argjson def "$BENCH_DEFAULT_PHASE_MIN" --argjson minb "$BENCH_BASIS_MIN_N" \
     "${CAL_ARGS[@]}" --slurpfile p "$PROGRESS" --slurpfile e "$est" --slurpfile s "$sc" "$JQ_LIB"'
    ($p | group_by(.session_id) | map({key: .[0].session_id,
          value: (group_by(.plan_file) | map(phase_minutes) | add // [])}) | from_entries) as $bys
    | ($p | group_by(.project) | map({key: .[0].project,
          value: (group_by([.session_id, .plan_file]) | map(phase_minutes) | add // [])}) | from_entries) as $byp
    | ($e | map("\(.session_id)/\(.phases_done)/\(.phases_total)") | INDEX(.)) as $have
    | ($s | accuracy($minn; $lo; $hi) | INDEX(.basis)) as $acc
    | $p | map(select(.epoch == $t)) | .[]
    | select(.finished | not) | select(.phases_total != null and .phases_done != null)
    | select($have["\(.session_id)/\(.phases_done)/\(.phases_total)"] | not)
    | ($bys[.session_id] // []) as $s | ($byp[.project] // []) as $j
    | (if ($s | length) >= $minb then {m: ($s | median), basis: "session-median(\($s | length))"}
       elif ($j | length) >= $minb then {m: ($j | median), basis: "project-median(\($j | length))"}
       else {m: $def, basis: "default"} end) as $pp
    | ($t + (((.phases_total - .phases_done) * $pp.m * 60) | floor)) as $eta
    | ($acc[$pp.basis | kind].factor // null) as $f
    | {made_epoch: $t, made_at: ($t | iso), session_id, target, project, phases_done,
       phases_total, per_phase_min: ($pp.m | floor), eta_epoch: $eta, eta: ($eta | iso),
       basis: $pp.basis}
      + (if $f == null then {} else
           ($t + (($eta - $t) * $f | floor)) as $cal
           | {factor: $f, factor_n: $acc[$pp.basis | kind].n_ratio, cal_eta_epoch: $cal, cal_eta: ($cal | iso)} end)'
}

# new_scores -> a score for every estimate whose session has since finished. The finish is
# the first sample that read finished; when that was the session's first sample at all, the
# real finish was earlier and done_bound says "upper".
new_scores() {
  local sc="$SCORES"
  [ -s "$sc" ] || sc=/dev/null
  [ -s "$ESTIMATES" ] || return 0
  jq -cn --slurpfile p "$PROGRESS" --slurpfile e "$ESTIMATES" --slurpfile s "$sc" '
    ($p | group_by(.session_id) | map(sort_by(.epoch)
          | {key: .[0].session_id,
             value: {first: .[0].epoch,
                     done: (map(select(.finished)) | .[0].epoch // null)}})
        | from_entries) as $f
    | ($s | map("\(.session_id)/\(.made_epoch)") | INDEX(.)) as $have
    | $e[] | . as $x | ($f[.session_id] // null) as $d
    | select($d != null and $d.done != null and $d.done > .made_epoch)
    | select($have["\(.session_id)/\(.made_epoch)"] | not)
    | {session_id, target, project, basis, made_epoch, eta_epoch, done_epoch: $d.done,
       done_bound: (if $d.done == $d.first then "upper" else "sampled" end),
       horizon_min: ((.eta_epoch - .made_epoch) / 60 | floor),
       error_min: (($d.done - .eta_epoch) / 60 | floor),
       ratio: (if .eta_epoch > .made_epoch
               then (($d.done - .made_epoch) / (.eta_epoch - .made_epoch) * 100 | floor) / 100
               else null end)}
      + (if .cal_eta_epoch == null then {} else
           {factor, cal_eta_epoch, cal_error_min: (($d.done - .cal_eta_epoch) / 60 | floor),
            cal_ratio: (if .cal_eta_epoch > .made_epoch
                        then (($d.done - .made_epoch) / (.cal_eta_epoch - .made_epoch) * 100 | floor) / 100
                        else null end)} end)'
}

cmd_sample() {
  local t rows est sc
  mkdir -p "$DIR"
  exec 9>"$DIR/.lock"
  flock -n 9 || { say "another sample is running"; return 0; }
  t=$(now)
  if ! rows=$(sample_rows "$t"); then
    say "fleet-sessions failed; nothing written"
    report_outcome FAILED "fleet-sessions failed"
    return 1
  fi
  if [ -z "$rows" ]; then
    say "no live session"
    publish_window "$t"
    findings_run "$t"
    epics_step "$t"
    fleet_cost_step
    budget_step
    report_outcome NOOP "no live session"
    return 0
  fi
  printf '%s\n' "$rows" >> "$PROGRESS"
  est=$(new_estimates "$t") || { report_outcome FAILED "estimate step failed"; return 1; }
  [ -n "$est" ] && printf '%s\n' "$est" >> "$ESTIMATES"
  sc=$(new_scores) || { report_outcome FAILED "score step failed"; return 1; }
  [ -n "$sc" ] && printf '%s\n' "$sc" >> "$SCORES"
  local fs
  fs=$(new_forecast_scores "$t") || { report_outcome FAILED "forecast score step failed"; return 1; }
  [ -n "$fs" ] && printf '%s\n' "$fs" >> "$FORECAST_SCORES"
  local n e s
  n=$(grep -c . <<<"$rows"); e=$(grep -c . <<<"$est"); s=$(grep -c . <<<"$sc")
  say "$n sessions, $e new estimates, $s new scores"
  publish_window "$t"
  findings_run "$t"
  epics_step "$t"
  fleet_cost_step
  budget_step
  report_outcome WORKED "$n sessions, $e estimates, $s scores"
}

# state_file_step <file> <every min> <timeout s> <name> <cmd...>: run cmd at most every <every> minutes
# and keep its JSON (it must have .total) as <file>. A failed run keeps the last file and waits the
# same interval (touch), so a reader's outage (Prometheus, gh, a bill's API) costs one attempt per
# interval; its as_of_epoch then reads stale on the Costs tab, in the KPI and in
# `agent-usage budget check`.
state_file_step() {
  local file=$1 every=$2 limit=$3 name=$4
  shift 4
  [ -z "$(find "$file" -mmin "-$every" 2>/dev/null)" ] || return 0
  mkdir -p "$(dirname "$file")"
  local tmp="$file.$$.tmp"
  if timeout "$limit" "$@" > "$tmp" 2>/dev/null && jq -e .total "$tmp" >/dev/null 2>&1; then
    mv "$tmp" "$file"
  else
    rm -f "$tmp"
    touch -c "$file"
    say "$name: the run failed; the last file stays"
  fi
}

# fleet_cost_step: the whole fleet's list-price estimate over 24h.
fleet_cost_step() {
  # shellcheck disable=SC2086  # the command is words
  state_file_step "$BENCH_FLEET_COST_FILE" "$BENCH_FLEET_COST_EVERY_MIN" "$BENCH_FLEET_COST_TIMEOUT" fleet-cost $BENCH_FLEET_COST_CMD
}

# budget_step: this month's cash by bill. A bill its reader cannot read is an `unread` line in a fresh
# file, never the last good figure; BUDGET_JSON points the command at this file, whose unread_since it
# carries forward (the only record of how long a reader has failed).
budget_step() {
  # shellcheck disable=SC2086  # the command is words
  BUDGET_JSON=$BENCH_BUDGET_FILE state_file_step "$BENCH_BUDGET_FILE" "$BENCH_BUDGET_EVERY_MIN" "$BENCH_BUDGET_TIMEOUT" budget $BENCH_BUDGET_CMD
}

# epics_step <now>: freeze the epic baselines and write the scores this sample owes. A failure is
# said and the sample goes on: the session ETAs do not wait on the roadmaps.
epics_step() {
  epics_sample "$1" || say "epics: the step failed; nothing frozen or scored"
}

# latest_live -> the newest sample's rows joined with each session's newest estimate, and
# late_min when the ETA it shows is already behind that sample. The estimate is not redone:
# it is scored as it was made. phase_since_epoch is the first sample at the session's current
# phases_done: when its open phase started, as near as the sample cadence can say.
latest_live() {
  [ -s "$PROGRESS" ] || return 0
  local est="$ESTIMATES"
  [ -s "$est" ] || est=/dev/null
  jq -cn --slurpfile p "$PROGRESS" --slurpfile e "$est" "$JQ_LIB"'
    ($p | max_by(.epoch) | .epoch) as $last
    | ($e | group_by(.session_id) | map(max_by(.made_epoch) | {key: .session_id, value: .})
        | from_entries) as $eta
    | ($p | map(select(.epoch == $last) | .session_id)) as $live
    | ($p | map(select(.session_id | IN($live[]))) | group_by(.session_id)
        | map({key: .[0].session_id, value: map({epoch, phases_done})}) | from_entries) as $hist
    | $p[] | select(.epoch == $last)
    | . as $r
    | ([$hist[$r.session_id][] | select(.phases_done != $r.phases_done) | .epoch] | max) as $moved
    | . + {phase_since_epoch: ([$hist[$r.session_id][] | select($moved == null or .epoch > $moved) | .epoch] | min)}
    | . + {eta: (if .finished then null else $eta[.session_id] end)}
    | . + {late_min: ((.eta | shown_eta) as $s
                      | if $s != null and $s < $last then (($last - $s) / 60 | floor) else null end)}'
}

cmd_eta() {
  if [ "${1:-}" = --json ]; then
    latest_live | jq -c "$JQ_LIB"'{target, session_id, phases_done, phases_total, finished,
      eta: (.eta.cal_eta // .eta.eta // null), eta_epoch: (.eta | shown_eta),
      raw_eta_epoch: (.eta.eta_epoch // null), factor: (.eta.factor // null), late_min,
      phase_since_epoch,
      phase_min: (if .eta.per_phase_min == null then null else .eta.per_phase_min * (.eta.factor // 1) | floor end),
      basis: (.eta | basis_label)}'
    return
  fi
  latest_live | jq -r "$JQ_LIB"'[.target, "\(.phases_done // "-")/\(.phases_total // "-")",
      (if .finished then "finished" else eta_cell end), (.eta | basis_label // "-")] | @tsv' |
    awk -F'\t' '{ printf "%-42s %-6s %-10s %s\n", $1, $2, $3, $4 }'
}

cmd_report() {
  local last
  if [ ! -s "$PROGRESS" ]; then echo "no samples yet: run fleet-bench sample"; return 0; fi
  last=$(jq -rs "$JQ_LIB"'max_by(.epoch) | .epoch | hm' "$PROGRESS")
  echo "Live sessions (sampled $last; ETA from measured phase times, x the basis's measured ratio once it has $BENCH_CAL_MIN_N scores)"
  printf '%-42s %-6s %-8s %-10s %s\n' SESSION PHASE BUCKET ETA BASIS
  latest_live | jq -r "$JQ_LIB"'[.target, "\(.phases_done // "-")/\(.phases_total // "-")", .bucket,
      (if .finished then "finished" else eta_cell end), (.eta | basis_label // "-")] | @tsv' |
    awk -F'\t' '{ printf "%-42s %-6s %-8s %-10s %s\n", $1, $2, $3, $4, $5 }'
  echo
  echo "ETA accuracy (error = actual finish - predicted; ratio = actual/predicted duration)"
  if [ ! -s "$SCORES" ]; then
    echo "  nothing scored yet: an ETA is scored when its session finishes"
  else
    jq -rs "${CAL_ARGS[@]}" "$JQ_LIB"'
      def line($label; err; rat): if length == 0 then empty else
        "  \($label): \(length) scored, median error \(map(err) | median) min, median |error| \(map(err | fabs) | median) min, median ratio \(map(rat // empty) | median // "-")" end;
      def line($label): line($label; .error_min; .ratio);
      (accuracy($minn; $lo; $hi) | .[]
        | "  \(.basis): \(.n) scored, median error \(.median_error_min) min, median |error| \(.median_abs_error_min) min, median ratio \(.median_ratio // "-")"),
      (map(select(.cal_eta_epoch != null)) | group_by(.basis | kind) | .[]
        | line("\(.[0].basis | kind) calibrated"; .cal_error_min; .cal_ratio)),
      (map(select(.horizon_min < 120)) | line("horizon under 2h")),
      (map(select(.horizon_min >= 120 and .horizon_min < 480)) | line("horizon 2-8h")),
      (map(select(.horizon_min >= 480)) | line("horizon over 8h")),
      (map(select(.done_bound == "upper")) | if length > 0 then "  \(length) finished before their first sample, so their real error is smaller than shown" else empty end)
    ' "$SCORES"
  fi
  echo
  echo "Fleet forecast accuracy (ratio = actual over predicted time to the last session's finish)"
  if [ ! -s "$FORECAST_SCORES" ]; then
    echo "  nothing scored yet: a baseline is scored when its sessions are all done, or after ${BENCH_FORECAST_HORIZON_H}h"
  else
    jq -rs "$JQ_LIB"'
      "  \(length) baselines scored: median ratio \(map(.ratio_p50 // empty) | median // "-")x as calibrated, \(map(.ratio_slow // empty) | median // "-")x at the slow end; \(map(select(.within_slow)) | length) of \(length) done inside the slow end",
      (.[-3:][] | "  \(.label): \(.resolved_by), \(.ratio_p50 // "-")x\(if .bound == "lower" then " or more (\(.open) still open)" else "" end), error \(.error_min // "-") min, \(.in) phases came in at \(.in_per_h)/h against \(.in_per_h_frozen)/h frozen")' "$FORECAST_SCORES"
  fi
  echo
  local r st
  proof_lib || return 0
  for r in fleet-bench fleet-review briefing; do
    st="$(proof_state_dir)/$r/last-outcome"
    printf '%s last outcome: %s\n' "$r" "$(cat "$st" 2>/dev/null || echo 'none recorded (not run under agentctl yet)')"
  done
}

cmd_accuracy() {
  [ "${1:-}" = --json ] || { echo "usage: fleet-bench accuracy --json" >&2; return 2; }
  [ -s "$SCORES" ] || return 0
  jq -cs "${CAL_ARGS[@]}" "$JQ_LIB"'accuracy($minn; $lo; $hi) | .[]' "$SCORES"
}

# window_stats <now> [since] -> one JSON object per session seen since <since> (default: the
# window): phases ticked, minutes per bucket (each sample owns the gap to the next one,
# capped), nudges and escalations (a flag turning on), peak context, first and last sample.
window_stats() {
  local t="$1"
  jq -cn --argjson since "${2:-$(( t - BENCH_WINDOW_H * 3600 ))}" --argjson cap $(( BENCH_GAP_CAP_MIN * 60 )) \
     --slurpfile p "$PROGRESS" '
    $p | map(select(.epoch >= $since)) | group_by(.session_id) | .[] | sort_by(.epoch) | . as $r
    | [range(0; length - 1) | {b: $r[.].bucket,
         m: (([($r[. + 1].epoch - $r[.].epoch), $cap] | min) / 60)}] as $gaps
    | ($gaps | group_by(.b) | map({key: .[0].b, value: (map(.m) | add | floor)}) | from_entries) as $minutes
    | {session_id: .[0].session_id, target: (last.target), project: (last.project),
     plan: (last.plan_file // "" | sub(".*/"; "") | sub("\\.md$"; "")),
     phase: "\(last.phases_done // "-")/\(last.phases_total // "-")",
     ticked: (group_by(.plan_file) | map((last.phases_done // 0) - (map(.phases_done // 0) | min)) | add),
     working_min: ($minutes.WORKING // 0), waiting_min: ($minutes.NEEDS // 0), stalled_min: ($minutes.STALLED // 0),
     minutes: $minutes,
     nudges: ([range(1; length) | select($r[.].nudged == true and $r[. - 1].nudged != true)] | length),
     escalations: ([range(1; length) | select($r[.].escalated == true and $r[. - 1].escalated != true)] | length),
     peak_context: (map(.context_tokens // 0) | max), first_epoch: (.[0].epoch), last_epoch: (last.epoch)}'
}

# bench_prom <now> -> the fleet_bench.prom lines: the scorecard's window per project. Waiting
# and stalled hours are summed over the project's sessions, the ETA ratio is the median of
# the ETAs scored in the window (no series when none was), and CI reds count the PRs merged
# in the window by a session of that project. The KPIs ride along so a reader never runs `kpi`.
bench_prom() {
  local t="$1" pl="$2" kpis
  kpis=$(kpi_json "$t" "$(ledger_counts)") || kpis='{}'
  jq -rn --arg win "$BENCH_WINDOW_H" --argjson pl "$pl" --slurpfile w <(window_stats "$t") --slurpfile e <(loop_episodes "$t" $((t - LOOP_WINDOW_S))) \
     --slurpfile s <(in_window "$SCORES" done_epoch "$t") --slurpfile c <(ci_window "$t") --argjson k "$kpis" \
     --slurpfile ef <(effect_lines) --arg vitals "$BENCH_VITALS" "$JQ_LIB$IMPROVE_JQ$PROM_JQ$VITALS_JQ"'
    def h: . / 60 * 100 | round / 100;
    ($w | map({key: .session_id, value: .project}) | from_entries) as $proj
    | ($w | map(.project) + ($s | map(.project)) | unique) as $ps
    | gauge("agent_bench_waiting_hours"; "Hours sessions sat in NEEDS over the last \($win)h.";
        $w | group_by(.project)[] | [{project: .[0].project}, (map(.waiting_min) | add | h)]),
      gauge("agent_bench_stalled_hours"; "Hours sessions sat in STALLED over the last \($win)h.";
        $w | group_by(.project)[] | [{project: .[0].project}, (map(.stalled_min) | add | h)]),
      gauge("agent_bench_eta_ratio"; "Median actual over predicted duration of ETAs scored in the last \($win)h.";
        $ps[] | . as $p | [{project: $p}, ($s | map(select(.project == $p) | .ratio // empty) | median)]),
      gauge("agent_bench_ci_reds_before_merge"; "CI reds on PRs merged in the last \($win)h, before they merged.";
        $c | map(. + {project: $proj[.session_id]}) | map(select(.project != null)) | group_by(.project)[]
        | [{project: .[0].project}, (map(.ci_red) | add)]),
      gauge("agent_bench_loop_dark_episodes"; "Finding episodes begun in the last 7d that reached the human with nothing but pages.";
        [{}, ($e | map(select(.dark)) | length)]),
      gauge("agent_bench_loop_first_response_minutes"; "Median minutes from a finding episode to its first response that is not a page, last 7d.";
        [{}, ($e | map(.first_response_min | numbers) | median)]),
      gauge("agent_bench_kpi"; "The KPIs `fleet-bench kpi` prints, by window.";
        $k | to_entries[] | .key as $n | .value as $v | ("7d", "28d") as $d | [{kpi: $n, window: $d}, $v[$d]]),
      gauge("agent_bench_kpi_limit"; "Each KPI'"'"'s threshold from kpi-thresholds.";
        $k | to_entries[] | [{kpi: .key}, .value.threshold]),
      gauge("agent_bench_kpi_past"; "1 when a KPI is past its threshold, as fleet-bench judged it.";
        $k | to_entries[] | select(.value.status != "-") | [{kpi: .key}, (if .value.status == "past" then 1 else 0 end)]),
      gauge("agent_bench_vital"; "The front-page KPIs from BENCH_VITALS, by the question each answers; the value is its row. Read each one from agent_bench_kpi.";
        vitals($vitals) | to_entries[] | [{question: .value.question, kpi: .value.kpi}, .key]),
      gauge("agent_bench_improve"; "Improvement claims live now, and verdicts of each kind, from effect.jsonl.";
        [{state: "live"}, ($ef | live | length)],
        (("improved", "flat", "regressed", "unproven") as $v
         | [{state: $v}, ([$ef[] | select(.type == "verdict" and .verdict == $v)] | length)])),
      gauge("agent_chain_wip"; "Items at each step of the work chain now, from the state files.";
        $pl.steps[] | [{step}, .wip]),
      gauge("agent_chain_age_minutes"; "Minutes the items at each step have sat there, p50 and p90.";
        $pl.steps[] | {step} as $l | (["p50", .age_p50_min], ["p90", .age_p90_min]) | [$l + {quantile: .[0]}, .[1]]),
      gauge("agent_chain_age_ratio"; "Each step'"'"'s age p90 over its bound in kpi-thresholds; past 1 is a bottleneck.";
        $pl.steps[] | [{step}, .ratio]),
      gauge("agent_chain_moves"; "Items each step took in and let out over the last hour, from the record.";
        $pl.steps[] | {step} as $l | (["in", .in_1h], ["out", .out_1h]) | [$l + {dir: .[0]}, .[1]]),
      gauge("agent_chain_dwell_minutes"; "Minutes in the step of the items that left it in the last 24h, p50 and p90.";
        $pl.steps[] | {step} as $l | (["p50", .dwell_p50_min], ["p90", .dwell_p90_min]) | [$l + {quantile: .[0]}, .[1]]),
      gauge("agent_chain_drift"; "Queue items the record and the queue folders place at different steps.";
        [{}, $pl.drift])'
}

# pipeline_snapshot <json>: the file the pipeline line reads, renamed into place so no reader
# sees half of it. A failed build or write leaves the last one, whose as_of shows its age.
pipeline_snapshot() {
  local dir=${PIPELINE_SNAPSHOT%/*} tmp
  mkdir -p "$dir" && tmp=$(mktemp "$dir/.pipeline.XXXXXX") || return 1
  if printf '%s\n' "$1" >"$tmp" && chmod 0644 "$tmp" && mv -f "$tmp" "$PIPELINE_SNAPSHOT"; then return 0; fi
  rm -f "$tmp"
  return 1
}

# publish_window <now>: one pipeline_json for the snapshot and the gauges, so the line and Grafana
# cannot disagree, then bench_prom where node_exporter reads it. The snapshot comes first: it does
# not depend on the session progress the gauges need.
publish_window() {
  local pl
  if pl=$(pipeline_json "$1"); then
    pipeline_snapshot "$pl" || say "could not write $PIPELINE_SNAPSHOT"
  else
    say "pipeline: the rollup failed; the last snapshot stays"
    pl='{"steps": []}'
  fi
  [ -s "$PROGRESS" ] || return 0
  prom_textfile fleet_bench.prom bench_prom "$1" "$pl" || say "could not write fleet_bench.prom"
}

# outcomes_newest -> the newest session-outcomes line per session_id (its own reader rule)
outcomes_newest() {
  if compgen -G "$BENCH_OUTCOMES_DIR/*/*.jsonl" >/dev/null; then
    cat "$BENCH_OUTCOMES_DIR"/*/*.jsonl
  fi | jq -c -s 'map(select(.session_id)) | group_by(.session_id) | map(last) | .[]'
}

outcomes_latest() {
  outcomes_newest | jq -cs 'map({key: .session_id, value: {prs_merged, reverted_7d, cost_usd, cost_by_model, models, edits, activity, class, tool_errors: .hard_errors.tool_errors}}) | from_entries'
}

# in_window <file> <epoch field> <now> [since] -> the file's rows whose field falls since
# <since> (default: the window)
in_window() {
  [ -s "$1" ] || return 0
  jq -c --arg f "$2" --argjson since "${4:-$(( $3 - BENCH_WINDOW_H * 3600 ))}" 'select(.[$f] >= $since)' "$1"
}

# ci_claimed -> the pr-ci rows a session claims; a repo with sections also holds every other merged
# PR, and only `sections` and the review itself read those
ci_claimed() { [ ! -s "$CI" ] || jq -c "$JQ_LIB"'select(claimed)' "$CI"; }
# ci_window <now> [since] -> the same rows, merged in the window
ci_window() { in_window "$CI" merged_epoch "$@" | jq -c "$JQ_LIB"'select(claimed)'; }

cmd_headline() {
  local t; t=$(now)
  [ -s "$PROGRESS" ] || { echo "bench: no samples yet"; return 0; }
  jq -rn --arg win "$BENCH_WINDOW_H" --slurpfile w <(window_stats "$t") --slurpfile s <(in_window "$SCORES" done_epoch "$t") \
     --slurpfile c <(ci_window "$t") "$JQ_LIB"'
    def h: . / 60 * 10 | floor / 10;
    "bench \($win)h: \($w | length) sessions, \($w | map(.ticked) | add // 0) phases ticked, "
    + "\($w | map(.waiting_min) | add // 0 | h)h waiting on you, \($w | map(.stalled_min) | add // 0 | h)h stalled, "
    + (if ($s | length) == 0 then "no ETA finished yet"
       else "\($s | length) ETAs scored, median \($s | map(.ratio // empty) | median | round2)x of predicted"
         + ($s | map(.cal_ratio // empty) | if length == 0 then ""
            else " (\(length) calibrated, median \(median | round2)x)" end) end)
    + (if ($c | length) == 0 then ""
       else ", \($c | map(.ci_red) | add) failed CI runs before merge in \($c | length) PRs" end)'
}

# runs_between <from> <to> -> the run ledger's rows that ended in that time
runs_between() { awk -F'\t' -v a="$1" -v b="$2" '$1 > a && $1 <= b' "$BENCH_RUNS_TSV" 2>/dev/null; }

# prom_map <label> <promql> <epoch> -> {label value: number}; rc 1 when unreadable. A recorded
# series can only answer instant lookups, so a replay has no answer to these.
prom_map() {
  [ -z "${BENCH_PROM_TSV:-}" ] || return 1
  prom_q "$2" "$3" | jq -c --arg l "$1" '[.data.result[] | {key: (.metric[$l] // "-"), value: (.value[1] | tonumber)}] | from_entries'
}

# spend_by_session <now> -> {session id: dollars in the window}, from the counter Claude Code exports
spend_by_session() {
  prom_map session_id "sum by (session_id) (increase(claude_code_cost_usage_USD_total[${BENCH_WINDOW_H}h]))" "$1"
}

# session_rows <now> -> one JSON object per session in the window, most working time first:
# the scorecard's Sessions table, joined to session-outcomes and the CI reds.
session_rows() {
  local t="$1" spend
  spend=$(spend_by_session "$t") || spend=null
  # Through a file: the outcomes of a few thousand sessions are over the kernel's 128 KB limit on one argument.
  jq -cn --slurpfile w <(window_stats "$t") --slurpfile outcomes <(outcomes_latest) --argjson spend "$spend" \
     --slurpfile c <(ci_window "$t") "$JQ_LIB"'
    def h: . / 60 * 10 | floor / 10;
    ($c | group_by(.session_id) | map({key: .[0].session_id, value: (map(.ci_red) | add)}) | from_entries) as $red
    | $outcomes[0] as $o
    | $w | sort_by(-.working_min) | .[] | ($o[.session_id] // {}) as $x
    | {session_id, target, plan, phase, ticked, working_h: (.working_min | h), waiting_h: (.waiting_min | h),
       stalled_h: (.stalled_min | h), nudges, peak_k: (.peak_context / 1000 | floor),
       prs_merged: $x.prs_merged, ci_reds: $red[.session_id], reverts: $x.reverted_7d,
       cost_usd: (if $x.cost_usd then $x.cost_usd * 100 | floor / 100 else null end),
       cost_24h: ($spend[.session_id] // null | if . then round2 else . end),
       edits: $x.edits, activity: $x.activity, tool_errors: $x.tool_errors}'
}

cmd_sessions() {
  [ "${1:-}" = --json ] || { echo "usage: fleet-bench sessions --json" >&2; return 2; }
  [ -s "$PROGRESS" ] || return 0
  session_rows "$(now)"
}

# cmd_stats --json [--since E] -> one JSON object per session sampled or merging a PR since E
# (default: all of it): its whole life from this bench's two stores, the progress samples and
# pr-ci. merged is null on a session with no merged PR in pr-ci, and sampled is false on one
# the sampler never saw. session-outcomes keeps each row as its own row's delivery.
cmd_stats() {
  local json=0 since=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      --since) since="${2:-}"; shift ;;
      *) json=0; break ;;
    esac
    shift
  done
  { [ "$json" = 1 ] && [[ "$since" =~ ^[0-9]+$ ]]; } || { echo "usage: fleet-bench stats --json [--since <epoch>]" >&2; return 2; }
  jq -cn --slurpfile w <([ -s "$PROGRESS" ] && window_stats "$(now)" "$since") \
     --slurpfile c <(ci_window 0 "$since") '
    ($w | map({key: .session_id, value: del(.working_min, .waiting_min, .stalled_min)}) | from_entries) as $ws
    | ($c | group_by(.session_id)
       | map({key: .[0].session_id,
              value: {prs: length, lines_added: (map(.additions // 0) | add), lines_deleted: (map(.deletions // 0) | add),
                      ci_runs: (map(.ci_runs // 0) | add), ci_reds: (map(.ci_red // 0) | add)}})
       | from_entries) as $ci
    | (($ws | keys) + ($ci | keys) | unique)[] as $k
    | {session_id: $k} + ($ws[$k] // {sampled: false}) + {merged: ($ci[$k] // null)}'
}

cmd_scorecard() {
  local t day out counts kpis SOURCE_ATTR_JSON=""
  t=$(now); day=$(date -d "@$t" +%F)
  [ -s "$PROGRESS" ] || { say "no samples yet"; return 1; }
  mkdir -p "$BENCH_SCORECARD_DIR" || return 1
  out="$BENCH_SCORECARD_DIR/$day.md"
  SOURCE_ATTR_JSON=$(source_attr "$t")   # counts, models and sources all read it: one status probe, one Prometheus read
  counts=$(ledger_counts)
  kpis=$(kpi_json "$t" "$counts")
  {
    echo "# Fleet bench, $day"
    echo
    echo "$(BENCH_NOW=$t cmd_headline)."
    echo
    echo "## Vitals"
    echo
    vitals_table "$kpis"
    echo
    echo "## KPIs"
    echo
    echo "Human sessions by when session-outcomes last saw them; (now) is a count taken at this run. Thresholds: $KPI_THRESHOLDS. \`fleet-bench retro\` files a board row for each one past it."
    echo
    kpi_table "$kpis"
    echo
    forecast_section "$t"
    echo
    wakes_lines
    report_line "$BENCH_TOKENS_CMD" tokens
    report_line "$BENCH_WEEK_CMD" week
    report_line "$BENCH_COMMS_CMD line" comms
    echo
    bottleneck_section "$t"
    echo
    time_section "$t"
    echo
    queue_section "$t"
    echo
    epics_section "$t"
    echo
    models_section "$t"
    echo
    sources_section "$t"
    echo
    canary_lanes_section
    echo
    canary_matrix_section
    echo
    sizes_section "$t"
    echo
    sections_section "$t"
    echo
    echo "## Sessions"
    echo
    echo "Counted from samples every 10 minutes over the last ${BENCH_WINDOW_H}h, never graded by a model. Waiting on you is time a session sat in NEEDS, kept apart so your answer time is not counted against an agent. Fields and formulas: the fleet-bench skill."
    echo
    echo "| Session | Phase now | Ticked | Working h | Waiting on you h | Stalled h | Nudges | Peak context | PRs merged | CI reds | Reverts | Cost ${BENCH_WINDOW_H}h | Cost to last nightly |"
    echo "|---|---|---|---|---|---|---|---|---|---|---|---|---|"
    session_rows "$t" | jq -r '
      "| \(.target) | \(.phase) | \(.ticked) | \(.working_h) | \(.waiting_h) | \(.stalled_h) | \(.nudges) | \(.peak_k)k | \(.prs_merged // "-") | \(.ci_reds // "-") | \(.reverts // "-") | \(if .cost_24h then "$\(.cost_24h)" else "-" end) | \(if .cost_usd then "$\(.cost_usd)" else "-" end) |"'
    echo
    depth_section "$t"
    echo
    session_time_section "$t"
    echo
    echo "## ETA accuracy"
    echo
    echo "Error is actual finish minus predicted (positive ran long). Ratio is actual over predicted duration."
    echo
    cmd_report | sed -n '/^ETA accuracy/,/^$/p' | sed '1d;/^$/d;s/^  /- /'
    echo
    echo "## Consolidation ledger"
    echo
    echo "Runners, timers and direct headless launches may only shrink; the baseline is ~/.config/agentctl/ledger-baseline."
    echo
    ledger_section "$counts"
    echo
    echo "## Rule numbers"
    echo
    echo "Each provisional rule's number, re-measured; a moved one gets a cleanup item (standards.md, the last rule)."
    echo
    cmd_rules | sed 's/^\([a-z_]*\)=/- \1: /; /^- /!s/^/- /'
  } > "$out.tmp" && mv "$out.tmp" "$out" && cp "$out" "$BENCH_SCORECARD_DIR/latest.md" || return 1
  echo "$out"
}

# forecast_section <now>: when the live work should be done and in what order, then the newest
# baseline frozen at least an hour earlier (yesterday's daily one, at the 06:45 run) against what
# happened since. Markdown bullets of the same lines forecast and vs print.
forecast_section() {
  local t="$1" f b label
  echo "## Forecast"
  echo
  echo "Every open phase scheduled from its session's newest estimate, in plan order; the slow end is the last ${BENCH_WINDOW_H}h scored ratio. Inflow and the drain come from \`fleet-bench flow\`. Formulas: the fleet-bench skill."
  echo
  if f=$(BENCH_NOW=$t cmd_forecast 2>/dev/null); then
    sed 's/^    /  - /; t; s/^  /- /' <<<"$f"
  else
    echo "- ? the forecast could not be made (fleet-bench forecast)"
  fi
  [ -s "$FORECASTS" ] || return 0
  label=$(jq -rs --argjson t "$t" 'map(select(.made_epoch <= $t - 3600 and .made_epoch >= $t - 172800)) | last | .label // empty' "$FORECASTS")
  [ -n "$label" ] || return 0
  echo
  if b=$(BENCH_NOW=$t cmd_vs "$label" 2>/dev/null); then
    sed 's/^    /  - /; t; s/^  /- /' <<<"$b"
  else
    echo "- ? baseline $label could not be compared (fleet-bench vs $label)"
  fi
}

# epics_section <now>: per project how its epic ETAs ran (each scored against its newest frozen
# baseline), the epics scored in the window, and the open ones behind their baseline.
epics_section() {
  local t="$1" ej
  echo "## Epic ETAs"
  echo
  echo "An open epic's ETA is when its last leaf row should land, frozen when the epic is first seen and again on each scope change, then scored once every leaf has landed. Ratio is actual over predicted duration. Formulas: the fleet-bench skill."
  echo
  if ! ej=$(epics_json "$t" 2>/dev/null); then
    echo "- ? the epics could not be read (fleet-bench epics)"
    return 0
  fi
  jq -r --argjson t "$t" --argjson win "$BENCH_WINDOW_H" "$JQ_LIB"'
    (.projects | map(select(.accuracy.scored > 0 or ([.epics[] | select(.baseline != null)] | length) > 0))) as $ps
    | if ($ps | length) == 0 then "- no epic has a frozen ETA yet" else
      ($ps[] | "- \(.project): \(.accuracy.scored) scored"
        + (if .accuracy.scored > 0 then ", median ratio \(.accuracy.median_ratio // "-"), \(.accuracy.on_time) on time, \(.accuracy.within_slow) within the slow end" else "" end)
        + ", \([.epics[] | select(.track == "behind")] | length) open behind, \([.epics[] | select(.track == "on track")] | length) on track"),
      (.projects[] | .project as $p | .epics[] | select(.score != null and .score.landed_epoch >= $t - $win * 3600)
        | "  - \($p) \(.id) \(.title): landed \(.score.landed_epoch | hm), predicted \(.score.pred_p50 | hm), ratio \(.score.ratio // "-"), \(.score.verdict)"),
      (.projects[] | .project as $p | .epics[] | select(.track == "behind")
        | "  - \($p) \(.id) \(.title): behind, frozen \(.baseline.p50 | hm), now \(.eta.cal_p50 // .eta.p50 | hm)")
      end' <<<"$ej"
}

# bottleneck_section <now>: the hours lost in the window, biggest first, and the branches behind the
# failed runs. Waited hours come from the queue length sampled every 10 minutes, and low-water hours
# from fleet-dispatch stats' under_low_water gauge, sampled the same way.
bottleneck_section() {
  local t="$1" win="${BENCH_WINDOW_H}h" pool queued low
  pool=$(prom_map pool "sum_over_time(cc:pool_waiting[$win:10m]) / 6" "$t") || pool=null
  queued=$(prom_map host "sum_over_time(cc:host_local_queued[$win:10m]) / 6" "$t") || queued=null
  low=$(prom_map topic "sum_over_time(max by (topic) (mqtt_under_low_water{topic=~\"agents_.+_summary_dispatch\"})[$win:10m]) / 6" "$t") || low=null
  echo "## Bottlenecks"
  echo
  echo "Hours lost over the last $win, from counts. The units differ, so the order says where to look first and the rows do not add up."
  echo
  jq -rn --argjson pool "$pool" --argjson queued "$queued" --argjson low "$low" --slurpfile w <(window_stats "$t") \
      --rawfile r <(runs_between $((t - BENCH_WINDOW_H * 3600)) "$t") "$JQ_LIB"'
    def hours($k): map(.[$k]) | add // 0 | . / 60;
    def top($k): map(select(.[$k] > 0)) | sort_by(-.[$k]) | .[:3] | map("\(.target) \(.[$k] / 60 | round1)h") | join(", ");
    def bad: map(select(.res != "pass"));
    ($r | run_rows) as $runs
    | ($runs | map(.s) | add // 0 | . / 3600) as $editor
    | ($runs | bad | map(.s) | add // 0 | . / 3600) as $lost
    | ($runs | bad | group_by(.branch) | map({branch: .[0].branch, not_passed: length, h: (map(.s) | add / 3600)}) | sort_by(-.h)) as $branches
    | [ (if $pool == null then {what: "Pool queues", unit: "job-hours", detail: "prometheus unreadable"}
         else $pool | to_entries[] | select(.value >= 0.1) | {what: "Pool queue: \(.key)", h: .value, unit: "job-hours", detail: "jobs waiting, sampled every 10 minutes"} end),
        (if $queued == null then {what: "Local queue", unit: "run-hours", detail: "prometheus unreadable"}
         else $queued | to_entries[] | select(.value >= 0.1) | {what: "Local queue: \(.key)", h: .value, unit: "run-hours", detail: "runs waiting for a slot"} end),
        (if $low == null then {what: "Queue under low water", unit: "hours", detail: "prometheus unreadable"}
         else ([$low[]] | max // 0) as $h | select($h >= 0.1) | {what: "Queue under low water", h: $h, unit: "hours", detail: "runnable under DISPATCH_LOW_WATER, sampled every 10 minutes"} end),
        (select($lost > 0) | {what: "Local runs not passed", h: $lost, unit: "editor-hours", detail: "of \($editor | round1)h on all local runs"}),
        {what: "Sessions waiting on you", h: ($w | hours("waiting_min")), unit: "session-hours", detail: ($w | top("waiting_min"))},
        {what: "Sessions stalled", h: ($w | hours("stalled_min")), unit: "session-hours", detail: ($w | top("stalled_min"))} ]
    | "| Bottleneck | Hours | Unit | Detail |", "|---|---|---|---|",
      (sort_by(-(.h // -1)) | .[] | "| \(.what) | \(.h // "?" | if type == "number" then round1 else . end) | \(.unit) | \(.detail) |"),
      (if ($branches | length) == 0 then empty else
        "", "Branches by editor-hours on runs not passed. A suite is one run per class, so the run count alone overstates a retry.", "",
        "| Branch | Runs not passed | Hours |", "|---|---|---|",
        ($branches[:5][] | "| \(.branch) | \(.not_passed) | \(.h | round1) |") end)'
}

# time_section <now>: where the window went per project and per plan, for reading against what the
# human said matters. There is no join yet from a hand-launched session to a row's priority.
time_section() {
  local t="$1" since=$((t - BENCH_WINDOW_H * 3600)) spend merges
  spend=$(spend_by_session "$t") || spend=null
  merges=$(merge_rows "$t" "$since")
  echo "## Where the time went"
  echo
  jq -rn --argjson since "$since" --argjson t "$t" --argjson spend "$spend" --arg m "$merges" --arg win "${BENCH_WINDOW_H}h" \
      --slurpfile w <(window_stats "$t") --rawfile r <(runs_between "$since" "$t") "$JQ_LIB"'
    def hours($k): map(.[$k]) | add // 0 | . / 60 | round1;
    def cost: if $spend == null then "-" else "$\(map($spend[.session_id] // 0) | add // 0 | round2)" end;
    ($r | run_rows) as $runs
    | ($m | split("\n") | map(select(. != "") | split("\t"))) as $rows
    | [$rows[] | select(.[0] | startswith("!")) | .[0][1:]] as $unread
    | ($rows | map(select((.[0] | startswith("!") | not) and (.[1] | tonumber) > $since and (.[1] | tonumber) <= $t)) | group_by(.[0])
       | map({key: .[0][0], value: length}) | from_entries) as $merged
    | (if $spend == null then "Agent spend: prometheus unreadable."
       else "Agent spend over \($win): $\($spend | add // 0 | round2) by the Prometheus counter, not checked against a bill; "
         + "$\(($spend | add // 0) - ($w | map($spend[.session_id] // 0) | add // 0) | round2) of it on sessions no sample saw." end),
      "",
      "| Project | Sessions | Working h | Waiting h | Stalled h | Spend | Editor h | Editor h not passed | Merges |",
      "|---|---|---|---|---|---|---|---|---|",
      ((($w | map(.project)) + ($runs | map(.repo)) + ($merged | keys) | unique | map(select(. != null))) as $ps
       | $ps[] | . as $p | ($w | map(select(.project == $p))) as $g | ($runs | map(select(.repo == $p))) as $e
       | "| \($p) | \($g | length) | \($g | hours("working_min")) | \($g | hours("waiting_min")) | \($g | hours("stalled_min")) | \($g | cost) | "
         + "\($e | map(.s) | add // 0 | . / 3600 | round1) | \($e | map(select(.res != "pass") | .s) | add // 0 | . / 3600 | round1) | "
         + "\(if ($unread | index($p)) then "?" else ($merged[$p] // 0) end) |"),
      "",
      "| Plan | Project | Sessions | Working h | Phases ticked | Spend |",
      "|---|---|---|---|---|---|",
      ($w | group_by(.plan) | map({plan: (.[0].plan | if . == "" then "(no plan)" else . end), project: .[0].project, n: length,
          work: hours("working_min"), ticked: (map(.ticked // 0) | add), cost: cost}) | sort_by(-.work) | .[:10][]
       | "| \(.plan) | \(.project) | \(.n) | \(.work) | \(.ticked) | \(.cost) |")'
}

# depth_section <now>: how each session spent itself, top spenders of tokens first. Whole sessions as
# of the last nightly, so a session the nightly has not seen is not listed.
depth_section() {
  echo "## Agent depth"
  echo
  echo "Whole sessions as of the last nightly, counted from the transcript's structure. A test run is one command, and a suite is many runs. Spent after the last edit is the share of tokens past its last commit or edit, so a high share on a long session is time spent waiting or polling."
  echo
  session_rows "$1" | jq -rs "$JQ_LIB"'
    map(select(.activity != null)) | sort_by(-(.activity.tokens // 0)) | .[:15]
    | if length == 0 then "_No session in this window has been through the nightly yet._"
      else ("| Session | Test runs | Test runs per PR | CI polls | Tool calls | Tool errors | API messages | Tokens (M) | Spent after last edit |",
            "|---|---|---|---|---|---|---|---|---|",
            (.[] | .activity as $a
             | "| \(.target) | \($a.test_runs) | \(if (.prs_merged // 0) > 0 then $a.test_runs / .prs_merged | round1 else "-" end) | \($a.ci_polls) | \($a.tool_calls) | "
               + "\(if $a.tool_calls > 0 then "\((.tool_errors // 0) * 100 / $a.tool_calls | round)%" else "-" end) | \($a.api_messages // "-") | \(($a.tokens // 0) / 1000000 | round1) | "
               + "\(if (.edits // 0) > 0 and ($a.tokens // 0) > 0 and $a.tokens_after_last_edit != null then "\($a.tokens_after_last_edit * 100 / $a.tokens | round)%" else "-" end) |"))
      end'
}

# session_time_section <now>: per project, where the hours of human sessions went, from `agent-panel
# time-use` by way of the nightly. Whole sessions: a long one counts all its hours the week it ends.
session_time_section() {
  echo "## Session time"
  echo
  echo "Whole sessions the nightly saw in the last $BENCH_TIME_DAYS days, hours by what was running, counted from the transcript's structure. Gate and test are commands named in ~/.config/agent-panel/time-use.conf; jobs is anything else running; parked is nothing running."
  echo
  outcomes_newest | jq -rs --argjson since $(( $1 - BENCH_TIME_DAYS * 86400 )) "$JQ_LIB"'
    def h($k): map(.time_use[$k]) | add / 60 | round1;
    map(select(.time_use != null and .runner != true and .project != "_runner" and .updated_epoch >= $since))
    | group_by(.project) | sort_by(-(map(.time_use | add) | add))
    | if length == 0 then "_No session has a time split from the nightly in this window yet._"
      else ("| Project | Sessions | Work h | Gate h | Test h | Other jobs h | You h | Parked h |",
            "|---|---|---|---|---|---|---|---|",
            (.[] | "| \(.[0].project) | \(length) | \(h("work_min")) | \(h("gate_min")) | \(h("test_min")) | \(h("jobs_min")) | \(h("human_min")) | \(h("parked_min")) |"))
      end'
}

ledger_section() {
  local counts="$1" over
  sed 's/^\(.*\)=\(.*\)$/- \1: \2/' <<<"$counts"
  if over=$(ledger_check "$counts" 2>&1); then
    echo "- baseline: held"
  else
    echo "- baseline: ${over//$'\n'/; }"
  fi
}

# ci_file -> the CI rows file, or /dev/null when there are none
ci_file() { [ -s "$CI" ] && printf '%s' "$CI" || printf /dev/null; }

# section_cfg -> the `sections` block of every tracker that has one, keyed by repo: {repo, gate,
# roots}. Roots decide a path's section, gate names the workflow that first-try means.
section_cfg() {
  [ -r "$BENCH_PROJECT_MAP" ] || { echo '{}'; return 0; }
  jq -c '[.trackers[] | objects | .sections // empty] | INDEX(.repo)' "$BENCH_PROJECT_MAP"
}

# merged_new <since> <cfg> -> repo, number and session_id (tab-separated) for every PR to count:
# what session-outcomes says merged since then, plus on a repo with sections whatever merged
# there, since about a third of those no session claims. A PR is counted once, except that a row
# from before its repo had sections or from before a session claimed it counts again, and
# ci_keep_newest drops the old one. A recount keeps the session an older row had. A sections repo's
# merges come from the PR store (`schedules-sync prs`), which holds its whole history, so no list is cut.
merged_new() {
  local repo prs listed='[]'
  for repo in $(jq -r 'keys[]' <<<"$2"); do
    prs=$("$SCHEDULES_SYNC" prs "$repo" --state merged --since "$(date -u -d "@$1" +%FT%TZ)") || return 1
    listed=$(jq -c --argjson l "$listed" --arg r "$repo" --argjson since "$1" \
      '$l + map(select(.merged_at and (.merged_at | fromdateiso8601) >= $since) | {repo: $r, number, session_id: ""})' <<<"$prs") || return 1
  done
  outcomes_newest | jq -rs --argjson since "$1" --argjson cfg "$2" --argjson listed "$listed" --slurpfile c "$(ci_file)" "$JQ_LIB"'
    ($c | INDEX(key)) as $old
    | ($c | map(select($cfg[.repo] == null or .sections != null)) | INDEX(key)) as $have
    | [.[] | .session_id as $sid | (.prs // [])[]
       | select(.state == "MERGED" and .merged_at != null)
       | select((.merged_at | fromdateiso8601) >= $since)
       | {repo, number, session_id: $sid}] + $listed
    | unique_by(key)
    | map(if claimed then . else .session_id = ($old[key].session_id // "") end)
    | map(. as $pr | $have[key] as $row | select($row == null or (($row | claimed | not) and ($pr | claimed))))
    | .[] | [.repo, .number, .session_id] | @tsv'
}

# ci_keep_newest -> the newest line per PR stays, so a recount replaces its row
ci_keep_newest() {
  [ -s "$CI" ] || return 0
  jq -cs "$JQ_LIB"'group_by(key) | map(last) | sort_by(.merged_epoch) | .[]' "$CI" > "$CI.tmp" && mv "$CI.tmp" "$CI"
}

# commit_paths <owner/repo> <merge sha> -> what the merge changed: the merge commit, not
# pulls/N/files, which is a 422 on a diff too big to generate (#1403, 2.7M lines), nor `pr view
# --json files`, which stops at 100. A squash holds the whole PR; a multi-commit rebase merge would
# list its last commit only, and main has none.
commit_paths() {
  gh api --paginate "repos/$1/commits/$2?per_page=100" --jq '.files[].filename'
}

# pr_ci <repo> <number> <session> <cfg> -> its size and the CI runs on its branch from its first
# commit to merge (earlier runs are a reused branch name), read from the run ledger (schedules-sync
# runs; exit 3 when the ledger does not sync the repo, 4 when it has not synced past the merge yet,
# 1 when it is unreadable or stale); red is failure, timed_out or
# startup_failure, and cancelled is superseded, not red. A Forgejo PR (repo host/owner/repo,
# session-outcomes.sh SO_PR_JQ) is read through that host's API, since gh speaks only to GitHub, and
# keeps its outcomes name on the row; the ledger names it forgejo:owner/repo. A repo with sections
# adds the PR's sections and its gate workflow's runs; green_lost is a green gate on an earlier head that a later
# commit replaced, main moving or a review change alike. A path inside no root is `other`.
pr_ci() {
  local pr runs paths='' ledger=$1
  if [[ "$1" == */*/* ]]; then
    pr=$(so_forgejo_pr "$1" "$2") || return 1
    ledger=forgejo:${1#*/}
  else
    pr=$(gh pr view "$2" -R "$1" --json headRefName,createdAt,mergedAt,additions,deletions,commits,mergeCommit) || return 1
  fi
  runs=$("$SCHEDULES_SYNC" runs "$ledger" --branch "$(jq -r .headRefName <<<"$pr")" --until "$(jq -r .mergedAt <<<"$pr")") || return
  runs=$(jq -c 'map({conclusion, workflowName: .workflow, headSha: .sha, createdAt: .created_at,
    startedAt: (.started_at // .created_at), updatedAt: (.ended_at // .started_at // .created_at)})' <<<"$runs") || return 1
  if jq -e --arg r "$1" 'has($r)' <<<"$4" >/dev/null; then
    paths=$(commit_paths "$1" "$(jq -r .mergeCommit.oid <<<"$pr")") || return 1
  fi
  jq -cn --argjson pr "$pr" --argjson runs "$runs" --arg repo "$1" --argjson n "$2" --arg sid "$3" \
     --argjson cfg "$4" --arg paths "$paths" "$JQ_LIB"'
    def red: .conclusion | IN("failure", "timed_out", "startup_failure");
    def section($roots): split("/") as $c
      | first($roots[] | split("/") as $r
          | select(($c | length) > ($r | length) and ([range($r | length) as $i | $r[$i] == "*" or $r[$i] == $c[$i]] | all))
          | $c[:$r | length] | join("/")) // "other";
    ([$pr.createdAt, ($pr.commits // [])[].committedDate] | map(fromdateiso8601) | min) as $start
    | ($pr.mergedAt | fromdateiso8601) as $merged
    | ($runs | map(select((.createdAt | fromdateiso8601) as $c | $c >= $start and $c <= $merged))) as $r
    | {repo: $repo, number: $n, session_id: $sid, merged_epoch: $merged, merged_at: ($merged | iso),
       additions: ($pr.additions), deletions: ($pr.deletions), ci_runs: ($r | length),
       ci_red: ($r | map(select(red)) | length)}
      + ($cfg[$repo] as $s | if $s == null then {} else
          ($r | map(select(.workflowName == $s.gate))) as $g
          | {sections: ($paths | split("\n") | map(select(. != "") | section($s.roots)) | unique),
             gate_runs: ($g | length), gate_red: ($g | map(select(red)) | length),
             gate_min: ($g | map((.updatedAt | fromdateiso8601) - (.startedAt | fromdateiso8601)) | add // 0 | . / 60 | round),
             green_lost: ([0, ($g | map(select(.conclusion == "success") | .headSha) | unique | length) - 1] | max)}
        end)'
}

# forgejo_ready <host/owner/repo> -> the lib loaded and the token read in this shell, so the
# subshell each pr_ci runs in inherits them and a review reads the token once, a failed read too
forgejo_ready() {
  [ -z "${SO_FORGEJO_ERR:-}" ] || return 1
  # shellcheck source=/dev/null
  declare -F so_forgejo_auth >/dev/null || . "$BENCH_SO_LIB" || return 1
  so_forgejo_auth "$1" || { say "$SO_FORGEJO_ERR"; return 1; }
}

cmd_review() {
  local t since cfg new repo num sid row rc n=0 red=0 failed=0 unsynced=0 later=0 msg days='' off=' '
  case "${1:-}" in
    '') ;;
    --days) days=${2:-}; [[ "$days" =~ ^[1-9][0-9]*$ ]] || { say "usage: fleet-bench review [--days N]"; return 2; } ;;
    *) say "usage: fleet-bench review [--days N]"; return 2 ;;
  esac
  mkdir -p "$DIR"
  t=$(now)
  since=$(( t - BENCH_WINDOW_H * 3600 )); [ -z "$days" ] || since=$(( t - days * 86400 ))
  cfg=$(section_cfg) || { report_outcome FAILED "project map unreadable"; return 1; }
  new=$(merged_new "$since" "$cfg") || { report_outcome FAILED "merged PRs unreadable"; return 1; }
  # a recount leaves two lines for a PR until this runs, so it runs however the loop ends
  [ -z "$new" ] || { trap ci_keep_newest EXIT; trap 'exit 143' TERM INT HUP; }
  while IFS=$'\t' read -r repo num sid; do
    [ -n "$repo" ] || continue
    # a repo the ledger does not sync is learnt once per review, not paid a gh call per PR
    case "$off" in *" $repo "*) unsynced=$((unsynced + 1)); continue ;; esac
    rc=0
    if [[ "$repo" == */*/* ]] && ! forgejo_ready "$repo"; then rc=1
    else row=$(pr_ci "$repo" "$num" "$sid" "$cfg") || rc=$?; fi
    case $rc in
      0) ;;
      3) unsynced=$((unsynced + 1)); off+="$repo "; continue ;;
      4) later=$((later + 1)); continue ;;
      *) say "cannot count $repo#$num"; failed=$((failed + 1)); continue ;;
    esac
    printf '%s\n' "$row" >> "$CI"
    n=$((n + 1)); red=$((red + $(jq .ci_red <<<"$row")))
  done <<<"$new"
  # a PR with no row is picked up by the next run, so one bad PR never holds back the rest
  # a repo the run ledger does not sync has no CI facts: day-log-ci lists the repos it syncs
  [ "$unsynced" -eq 0 ] || say "$unsynced PRs left out: their repos are not in the run ledger (day-log-ci)"
  # a PR merged after the ledger's last sync is counted by the next review, once its runs are in
  [ "$later" -eq 0 ] || say "$later PRs merged after the run ledger's last sync, left for the next review"
  if [ "$failed" -gt 0 ]; then
    report_outcome FAILED "cannot count $failed PRs (gh, Forgejo or the run ledger), $n counted"
    return 1
  fi
  if [ "$n" -eq 0 ]; then
    report_outcome NOOP "nothing new merged in the window"
    return 0
  fi
  msg="$n PRs counted, $red CI reds"
  say "$msg"
  report_outcome WORKED "$msg"
}

# sections_json <now> <days> -> what each section cost over the window. A row is a merged PR with
# sections; its session is whichever claims it in outcomes now (the row may predate the claim),
# and takes an equal share of that session's cost, tokens and work minutes. A session with no
# price stays out of the cost mean rather than counting as free.
sections_json() {
  outcomes_newest | jq -cs --argjson t "$1" --argjson days "$2" --slurpfile c "$(ci_file)" "$JQ_LIB"'
    def gated: map(select(ran_gate));
    def mean(f): map(f | numbers) | ratio(add // 0; length);
    def stats: gated as $g | {prs: length, gated: ($g | length), with_session: (map(select(.share)) | length),
      first_try: ratio($g | map(select(first_try)) | length; $g | length),
      reds_per_pr: ratio($g | total(.gate_red); $g | length),
      gate_min_per_pr: ratio($g | total(.gate_min); $g | length),
      gate_h: ($g | total(.gate_min) / 60 | round), green_lost: total(.green_lost),
      cost_per_pr: mean(.share.cost), tokens_per_pr: (mean(.share.tokens) | if . then round else . end),
      work_min_per_pr: mean(.share.work)};
    def per($n): if . then . / $n else null end;
    ([.[] | . as $s | ((.prs // []) | map(select(.state == "MERGED"))) as $m | ($m | length) as $n | $m[]
      | {key: key, share: {cost: ($s.cost_usd | per($n)), tokens: ($s.tokens_total | per($n)), work: ($s.time_use.work_min | per($n))}}]
     | unique_by(.key) | INDEX(.key)) as $claimed
    | ($c | map(select(.sections != null and .merged_epoch > $t - $days * 86400 and .merged_epoch <= $t)
                | . + {share: $claimed[key].share})) as $rows
    | {days: $days, all: ($rows | stats),
       sections: ([$rows[] | .sections[] as $n | . + {section: $n}] | group_by(.section)
                  | map({section: .[0].section} + stats) | sort_by(-.gate_h, -.prs))}'
}

# sections_table <json> <top, 0 for all>
sections_table() {
  jq -r --argjson top "$2" "$JQ_LIB"'def d: if . == null then "-" else tostring end;
    def mins: if . == null then "-" else round | tostring end;
    def usd: if . == null then "-" else "$\(round2)" end;
    def mtok: if . == null then "-" else "\(. / 1000000 | round1)M" end;
    def row($n): "| \($n) | \(.prs) | \(.first_try | d) | \(.reds_per_pr | d) | \(.gate_min_per_pr | mins) | \(.gate_h) | \(.green_lost) | \(.cost_per_pr | usd) | \(.tokens_per_pr | mtok) | \(.work_min_per_pr | mins) |";
    "| Section | PRs | First try | Gate reds per PR | Gate min per PR | Gate h | Greens lost | Cost per PR | Tokens per PR | Work min per PR |",
    "|---|---|---|---|---|---|---|---|---|---|",
    (.all | row("All PRs")),
    ((if $top > 0 then .sections[:$top] else .sections end)[] | row(.section)),
    "",
    "- A PR counts in every section it touches, so sections sum past All PRs. Greens lost is a green head a later commit replaced, for any reason. Gate columns cover the \(.all.gated) PRs that ran a gate, and cost, tokens and work the \(.all.with_session) of \(.all.prs) a session claims.",
    (if $top > 0 and (.sections | length) > $top then "- \(.sections | length - $top) more: `fleet-bench sections`." else empty end)' <<<"$1"
}

sections_section() {
  local j
  echo "## Sections"
  echo
  echo "Merged PRs in the last ${BENCH_SECTIONS_DAYS} days by section of the repo, from the paths each changed, the most gate hours first. First try is a PR whose gate never went red."
  echo
  j=$(sections_json "$1" "$BENCH_SECTIONS_DAYS") || { echo "- sections: ? (outcomes or pr-ci.jsonl unreadable)"; return 0; }
  [ "$(jq .all.prs <<<"$j")" -gt 0 ] || { echo "_No PR merged in a repo with sections in this window._"; return 0; }
  sections_table "$j" "$BENCH_SECTIONS_TOP"
}

cmd_sections() {
  local json=0 days="$BENCH_SECTIONS_DAYS" j
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      --days) days=${2:-}; shift ;;
      *) say "usage: fleet-bench sections [--days N] [--json]"; return 2 ;;
    esac
    shift
  done
  [[ "$days" =~ ^[1-9][0-9]*$ ]] || { say "usage: fleet-bench sections [--days N] [--json]"; return 2; }
  j=$(sections_json "$(now)" "$days") || return 1
  if [ "$json" = 1 ]; then printf '%s\n' "$j"; else sections_table "$j" 0; fi
}

# ask_rows -> a JSON array of pending asks in the order hub Home ranks them
# (hub_core::home::needs: what each holds times how long it waited), with the facts that score
# counted. Fails when hub could not read agent-ask, rather than report no asks.
ask_rows() {
  local needs
  needs=$($BENCH_NEEDS_CMD) || return 1
  jq -ce 'if any(.errors[]; test("agent-ask")) then error("agent-ask unreadable") else . end
    | [.needs[] | select(.kind == "ask")
       | {id, project, question: .text, recommend: (.recommend // ""), target,
          live: .score.session, phases_left: .score.phases, holds: .score.holds,
          age_h: (.score.age_min / 60)}]' <<<"$needs" 2>/dev/null
}

# asks_md <rows> -> the digest page, the same text in the terminal and in asks.md
asks_md() {
  local last="never"
  [ -s "$PROGRESS" ] && last=$(jq -rs "$JQ_LIB"'max_by(.epoch) | .epoch | hm' "$PROGRESS")
  jq -r --arg last "$last" '
    def age: if . < 48 then "\(floor)h" else "\(. / 24 | floor)d" end;
    def cell: gsub("\\|"; "\\|") | if length > 140 then .[0:140] + "..." else . end;
    def holds: if .holds == "" then "-" else .holds end;
    "# Pending asks",
    "",
    "\(length) pending. Sessions as sampled \($last). In hub Home'"'"'s order: what each holds (its session, plan phases left, queued items after it) times how long it waited; fields: the fleet-bench skill.",
    "",
    "## Blocking a live session",
    "",
    (map(select(.live)) | if length == 0 then "None." else
      "| Ask | Session | Age | Holds | Recommend | Question |", "|---|---|---|---|---|---|",
      (.[] | "| \(.id) | \(.target) | \(.age_h | age) | \(holds) | \(.recommend | if . == "" then "-" else . end) | \(.question | cell) |")
    end),
    "",
    "## No live session behind them",
    "",
    "Headless asks and asks whose session has ended. Answer, or cancel with `agent-ask cancel <id>` when it no longer applies.",
    "",
    (map(select(.live | not)) | if length == 0 then "None." else
      "| Ask | Project | Age | Holds | Recommend | Question |", "|---|---|---|---|---|---|",
      (.[] | "| \(.id) | \(.project) | \(.age_h | age) | \(holds) | \(.recommend | if . == "" then "-" else . end) | \(.question | cell) |")
    end)' <<<"$1"
}

# asks_line <rows> <top-n> <max-chars> -> one plain line (comms-standard): the count, the top
# few questions with their age and recommendation, as many as fit in max-chars (the first
# always), and where to see them all. Ids and session targets stay in asks.md; the line is
# read on a lock screen and in the briefing.
asks_line() {
  jq -r --argjson k "$2" --argjson max "$3" '
    def age: if . < 48 then "\(floor)h" else "\(. / 24 | floor)d" end;
    # The first sentence is the question; the rest is context. A question is never cut:
    # one too long for the line is named by its "topic:" label (else its project) and id instead.
    def name: ((.question | capture("^(?<t>[^:?.!]{3,60}): ") | .t) // "a \(.project) question") + ", ask \(.id)";
    def q: .question | gsub("\\s+"; " ") | ((capture("^(?<s>.*?[?.!])( |$)") | .s) // .);
    def meta: " (\(.age_h | age)" + (if .recommend != "" then ", recommend \(.recommend)" else "" end) + ")";
    (map(select(.live)) | length) as $l
    | ((if length == 1 then "1 question waits on you" else "\(length) questions wait on you" end)
      + (if $l == 0 then ", none holding up a session" else ", \($l) holding up a session" end)
      + ". Top: ") as $head
    | ". List: fleet-bench asks." as $tail
    | def fits($l): ($head + ($l | join("; ")) + $tail | length) <= $max;
      reduce (.[:$k][] | [q + meta, name + meta]) as [$full, $short] ([];
        if fits(. + [$full]) then . + [$full] elif length == 0 or fits(. + [$short]) then . + [$short] else . end)
    | $head + join("; ") + $tail' <<<"$1"
}

# The page for these asks is hub's (`hub needs --page`, after every fleet-state pass).
cmd_asks() {
  local mode="${1:-}" rows out
  case "$mode" in ""|--write) ;; *) say "usage: fleet-bench asks [--write]"; return 2 ;; esac
  if ! rows=$(ask_rows); then
    say "hub needs failed or could not read agent-ask"
    return 1
  fi
  [ -n "$mode" ] || { asks_md "$rows"; return 0; }
  mkdir -p "$BENCH_SCORECARD_DIR" || return 1
  out="$BENCH_SCORECARD_DIR/asks.md"
  asks_md "$rows" > "$out.tmp" && mv "$out.tmp" "$out" || return 1
  [ "$(jq length <<<"$rows")" = 0 ] && return 0
  # --write is the morning briefing's step: one item of at most 160 chars, so the top one
  # (channels.toml: a briefing item is 160).
  asks_line "$rows" 1 160
}

# ---------------------------------------------------------------- ledger
#
# The consolidation ledger. Every new need used to become a new runner, timer or launch
# path, so the fleet grew while it was being consolidated. These are counts, never a
# grade. --check holds the three that may only shrink to the committed baseline: to add
# one, retire one or raise the baseline in the same PR with a why.

: "${LEDGER_GATED:=runners timers launches_direct}"

# headless_launches DIR... -> file:line of every executable line that starts a headless
# claude, opencode or codex outside agentctl-run, or calls a model's HTTP API (an OpenAI-style chat/completions or
# Anthropic /v1/messages URL, or a chat body with a "model" key and a "messages" list on one line,
# for a caller that reads its URL from config) with no registered agent at all. Comments, echo
# lines, docs, yaml and tests are not call sites, and agent-run's harnesses are the launcher itself.
# git grep honours .gitignore, so 1.8G of build output under .local/src is never read;
# it works on a plain directory too. runner_contract.bats calls this through
# `ledger --launches`, so there is one scan.
headless_launches() {
  local d
  for d in "$@"; do
    [ -d "$d" ] || continue
    (cd "$d" && git grep --no-index --exclude-standard -nIiE \
      '\b(claude|claude_bin)\b[^|#]* (-p|--print)( |$|")|\bopencode run\b|\b(codex|codex_bin)\b[^|#]* exec( |$|")|[A-Za-z0-9_}]/(v1/)?chat/completions|[A-Za-z0-9_}]/v1/messages\b|"model"[[:space:]]*:[^|#]*"messages"[[:space:]]*:[[:space:]]*\[' \
      -- . ':!*.md' ':!*.yaml' ':!*.yml' ':!tests/**' ':!**/tests/**') \
      | sed "s|^|${d%/}/|"
  done | grep -vE '^[^:]+:[0-9]+:[[:space:]]*(#|echo )' | grep -v '/agent-run/harnesses/'
}

# scheduled_runner <conf> -> the runner's name, failing for one fired by hand. fleet-liveness's
# roster: a retired runner keeps its state dir, and a conf with no SCHEDULE or AUTOSTART=yes is
# fired by hand, so neither can count as bad. The caller has already skipped KIND=call and ENABLED=no.
scheduled_runner() {
  local name
  grep -qE '^SCHEDULE=["'"'"']?[^"'"'"' ]' "$1" || grep -qE '^AUTOSTART=["'"'"']?yes' "$1" || return 1
  name=$(sed -n 's/^NAME=//p' "$1" | head -1)
  printf '%s\n' "${name:-$(basename "$1" .conf)}"
}

# board_open_count -> the open and started agent-lane rows on the active profile's boards
# (BENCH_BOARD_CMD feeds every profile; BENCH_PROFILE overrides the profile `notes config` names).
# One profile is the unit dispatch pulls from and the unit board_open_max was measured against,
# so a second profile's boards do not add to it. A project with automation off is left out; ?
# when the feed or the profile cannot be read.
board_open_count() {
  [ -n "${BENCH_PROFILE:-}" ] || BENCH_PROFILE=$(notes config 2>/dev/null | awk '$1 == "profile" { print $2; exit }')
  [ -n "$BENCH_PROFILE" ] || { echo '?'; return; }
  $BENCH_BOARD_CMD 2>/dev/null | jq -er --arg p "$BENCH_PROFILE" '.rows | if type == "array" then . else error("no rows") end
    | map(select(.profile == $p and .lane == "agent" and (.state == "open" or .state == "doing") and .automation != false)) | length' 2>/dev/null || echo '?'
}

# intake_room -> one line; 1 when board_open is past board_open_max in KPI_THRESHOLDS. Information
# only: nothing holds a filer on it. A full board means dispatch is not pulling, which the
# board-open watch alerts on; no threshold is no limit.
intake_room() {
  local n max
  n=$(board_open_count)
  [ "$n" = '?' ] && { echo "room: board_open ?, the board feed is unreadable"; return 0; }
  max=$(sed -n 's/^board_open_max=//p' "$KPI_THRESHOLDS" 2>/dev/null | tail -1)
  if [ -z "$max" ]; then echo "room: board_open $n, no board_open_max"; return 0; fi
  if awk -v n="$n" -v m="$max" 'BEGIN { exit !(n > m) }'; then
    echo "full: board_open $n past board_open_max $max"; return 1
  fi
  echo "room: board_open $n of board_open_max $max"
}

# ledger_roster -> the roster's key=value lines, read from the confs and the source tree alone,
# so CI can count a checkout (the ledger workflow): `--check` reads only these. A timer is
# counted where `agentctl reload` writes one, a switched-on oneshot with a SCHEDULE; reload
# removes any other, so the live timer dir holds the same count once reloaded.
ledger_roster() {
  local c n_conf=0 n_on=0 n_bad=0 n_call=0 n_timer=0 src sd="" name
  proof_lib && sd=$(proof_state_dir)
  for c in "$LEDGER_CONF_DIR"/*.conf; do
    [ -e "$c" ] || continue
    # A KIND=call agent is a model call its caller starts, not a runner: no unit, no timer.
    grep -qE '^KIND=["'"'"']?call' "$c" && { n_call=$((n_call + 1)); continue; }
    n_conf=$((n_conf + 1))
    grep -qE '^ENABLED=["'"'"']?no' "$c" && continue
    n_on=$((n_on + 1))
    grep -qE '^KIND=["'"'"']?oneshot' "$c" && grep -qE '^SCHEDULE=["'"'"']?[^"'"'"' ]' "$c" && n_timer=$((n_timer + 1))
    name=$(scheduled_runner "$c") || continue
    [ -n "$sd" ] && grep -qE '^(FAILED|STALLED)' "$sd/$name/last-outcome" 2>/dev/null && n_bad=$((n_bad + 1))
  done
  echo "runners=$n_conf"
  echo "runners_on=$n_on"
  echo "runners_bad=$n_bad"
  echo "agents_call=$n_call"
  echo "timers=$n_timer"
  IFS=: read -ra src <<<"$LEDGER_SRC"
  echo "launches_direct=$(headless_launches "${src[@]}" | cut -d: -f1 | sort -u | wc -l)"
}

# ledger_counts -> key=value lines: the roster, then the fleet's live counts
ledger_counts() {
  local t rows sd=""
  ledger_roster
  proof_lib && sd=$(proof_state_dir)
  # awk, not cat: last-outcome has no trailing newline, so cat runs every verdict into one word
  echo "verdict_words=$([ -n "$sd" ] && awk '{print $1}' "$sd"/*/last-outcome 2>/dev/null | sort -u | grep -c .)"
  t=$(now)
  # proof_report writes "why: unrecorded" on a FAILED, STALLED or BLOCKED line its runner gave no
  # reason for; this counts those of the last 24h (local times, compared as text)
  if [ -n "$sd" ]; then
    echo "failed_unexplained=$(awk -v s="$(date -d "@$((t - 86400))" +%FT%T)" \
      'substr($1, 2, 19) > s && / outcome=(FAILED|STALLED|BLOCKED) / && / why: unrecorded$/' "$sd"/*/activity.log 2>/dev/null | grep -c .)"
  else
    echo "failed_unexplained=?"
  fi
  if rows=$(ask_rows 2>/dev/null); then
    jq -r --argjson d "$ASK_STALE_DAYS" '"asks_pending=\(length)", "asks_stale=\(map(select(.age_h > $d * 24)) | length)"' <<<"$rows"
  else
    echo "asks_pending=?"; echo "asks_stale=?"
  fi
  echo "board_open=$(board_open_count)"
  # points_per_pr: Claude weekly points per landed PR, the plans' real price; other sources bill in other units
  echo "points_per_pr=$(sources_json "$t" 2>/dev/null | jq -er '[.sources[] | select(.kind == "claude" and .points != null)]
    | (map(.landed // 0) | add // 0) as $n | if $n > 0 then (map(.points // 0) | add) / $n * 100 | round / 100 else "?" end' 2>/dev/null || echo '?')"
  # loop_dark is the alert (still firing); loop_dark_7d counts the cleared ones too, which loop_dark reads as ok
  loop_episodes "$t" $((t - LOOP_WINDOW_S)) | jq -sr '"loop_dark=\(map(select(.dark and .open)) | length)", "loop_dark_7d=\(map(select(.dark)) | length)"'
  # lesson_held_share: of the lessons with a sig whose before and after windows are both read, the share
  # that held (session-outcomes lessons); ? when none has a verdict yet or the cache cannot be read
  echo "lesson_held_share=$($BENCH_LESSONS_CMD 2>/dev/null | jq -er '(.held + .recurring) as $n
    | if $n > 0 then .held / $n * 100 | round / 100 else "?" end' 2>/dev/null || echo '?')"
  # worktrees_held, worktrees_held_over_7d: trees held with nobody in them, and those idle past 7 days, from
  # the newest worktree-gc row; ? with no row, one older than WORKTREE_GC_STALE_H, or one dated in the future
  jq -nrR --argjson t "$t" --argjson h "$WORKTREE_GC_STALE_H" '
    ([inputs] | last // "" | try fromjson catch null) as $r
    | if ($r | type) == "object" and ($r.epoch | numbers) != null and $r.epoch > $t - $h * 3600 and $r.epoch <= $t + 3600
      then "worktrees_held=\($r.held // "?")", "worktrees_held_over_7d=\($r.held_over_7d // "?")"
      else "worktrees_held=?", "worktrees_held_over_7d=?" end' < <(tail -n 1 "$WORKTREE_GC_LOG" 2>/dev/null)
  chain_counts "$t"
}

# The work chain, intake -> backlog row -> queue item -> session -> PR -> merge -> closed row, as
# counts taken now; each is 0 (or 1 for a share) when every link holds. ledger_coverage and
# untracked_merged_prs: of the PRs merged in the last CHAIN_DAYS (pr-ci.jsonl), how many an item
# names (owner/repo#N, a forge URL, or a bare N by number). board_orphan_started: started agent rows
# no active item names. merged_open_rows: done items with merge proof whose row is still open.
# ownerless_running: running or waiting items with no session (reap flags them).
# epic_linked_share: the agent rows filed under an epic (#of/), over every project automation manages;
# a project with no epic yet counts, all its rows unlinked, since the link pass gives each row one.
# landed_unverified: open epics whose every leaf is done, waiting on proof of the outcome. doctor_fail: FAIL lines in the last notes doctor.
# dup_pairs: instructions two homes restate, from the newest nightly docs-cleanup night's dups.json
# (skill-drift --dups); the bound is dup_pairs_max, the same row skill-drift --dups --check holds.
# chain_drift and step_age_p90_<step>: pipeline_json's drift and each step's age p90, in minutes.
# plans_unqueued: approved plans with open phases and no session or item (plans_orphaned).
# requested_unstarted_h: hours the oldest #requested agent row has sat open and unstarted.
# orphan_request_rows, next_up_blocked, stale_urgent_d, playtest_waiting_d and done_inline_old: the
# rows the board holds that no step will move, from board_links (which says what each counts).
# request_to_live_h: the p50 hours from request to live (lead_time_json), ? until every
# BENCH_LEAD_TRUST KPI holds its bound (lead_untrusted).
# wants_unstamped: of the agent-lane rows the human's channels added over the last CHAIN_DAYS
# (ingest.jsonl: an added or filed event the human wrote by hand, writer "human" or unnamed, or one
# naming its channel, `want` from `ptask --want`, whichever runner wrote it; only an agent row can
# carry #requested), the share that carry no #requested. A `want` event was stamped by the writer.
# A runner's own row is not a channel: `notes` names its writer (AGENTCTL_NAME) since #1688.
# routes_unresolved: standing watches, runners and the hold row no triage-routes line resolves, and runners whose SKILL= names nothing (triage_coverage).
# reds_unfixed: red fixes merged in the last REDS_DAYS whose red is still or again red (reds_json),
# leaving out a red TRIAGE_ROUTES sends to alert, which no merge can clear.
# admission_held: automated adds the queue's admission held in the last 7 days (agent-queue admit).
# cost_per_merged_item rides the same read but is not a link: the work ledger's spend per landed
# item, cost_usd (the nightly outcomes pass sums it over the item's sessions) plus gateway_cost_usd,
# over the done items with merge proof that finished in the last CHAIN_DAYS and carry a cost. An
# item with no cost yet is left out, never counted as free.
# release_overdue and version_tag_drift are the release link (release_kpis): a sheet-counter project a
# day past its cadence due date with done rows and no cut, and a tagged project whose sheet is not its
# tag plus one patch.
KPI_CHAIN="ledger_coverage untracked_merged_prs board_orphan_started merged_open_rows ownerless_running epic_linked_share landed_unverified release_overdue version_tag_drift doctor_fail dup_pairs plans_unqueued routes_unresolved reds_unfixed requested_unstarted_h orphan_request_rows next_up_blocked stale_urgent_d playtest_waiting_d done_inline_old request_to_live_h wants_unstamped admission_held chain_drift step_age_p90_backlog step_age_p90_queued step_age_p90_running step_age_p90_review step_age_p90_waiting queue_net_24h estimated_token_share"

# wants_stats <now> -> {total, unstamped, by_project: {<from>: {total, unstamped}}} over the last
# CHAIN_DAYS of the notes ingest record; nothing and a failure when the record cannot be read.
wants_stats() {
  [ -r "$BENCH_INGEST" ] || return 1
  jq -Rnc --arg since "$(date -d "@$(( $1 - CHAIN_DAYS * 86400 ))" +%F)" --argjson fix "$FIX_SINCE" "$JQ_LIB"'
    [inputs | fromjson? | ((.want // "") != "") as $want | select((.ts // "")[0:10] >= $since and ($fix == 0 or ((try ((.ts // "") | sub("\\.[0-9]+"; "") | iso_epoch) catch $fix) >= $fix)) and .lane == "agent" and (.action | IN("added", "filed")) and (((.by // "") | IN("", "human")) or $want))
         | {from: (.from // "?"), stamped: ($want or ((.text // "") | test("#requested")))}] as $w
    | {total: ($w | length), unstamped: ($w | map(select(.stamped | not)) | length),
       by_project: ($w | group_by(.from) | map({key: .[0].from, value: {total: length, unstamped: map(select(.stamped | not)) | length}}) | from_entries)}' "$BENCH_INGEST"
}

# lead_time_json <now> -> {hours, p50, at_merge, in_release, unreleased, unknown}: request to live
# for the items the human asked for (from: human) with merge proof, finished in the last
# BENCH_LEAD_DAYS. Request is the item's queued time. Live is the item's finished time (agent-land
# closes it at the merge) in a project release-state has no row for, since its merge is its
# deploy; else the first tag of the project's line holding every merged commit (release-state
# released), live at the first deploy the release graph records for that tag (hub releases
# --json, each history row's reached), or at the tag's own time when none is. hours and p50 cover those live in the last
# CHAIN_DAYS; unreleased counts the merged ones no tag holds yet, unknown the ones whose commit
# the checkout lacks (one of an item's merges in another repo makes it unknown too), both over
# the whole BENCH_LEAD_DAYS. A failure when the queue or the
# release graph cannot be read.
lead_time_json() {
  local t=$1 items graph rel deployed p released=() shas
  items=$($BENCH_DONE_ITEMS_CMD --since "$(date -d "@$((t - BENCH_LEAD_DAYS * 86400))" +%F)" 2>/dev/null \
    | jq -sc 'map(select(.from == "human" and (.merged // "") != "") | {project, merged, queued, finished})') || return 1
  # hub exits 1 on any fault, a channel not probed included, so its exit says nothing here: a read
  # with no rows and an error is a snapshot that did not read.
  graph=$($BENCH_RELEASES_CMD 2>/dev/null)
  rel=$(jq -ce 'if (.rows | length) == 0 and (.errors | length) > 0 then error("unread") else [.rows[].project] | unique end' <<<"$graph") || return 1
  # {project: {tag: the first deploy's epoch, null when none is recorded}}
  deployed=$(jq -c '[.apps[]? | {key: .project, value: ([.history[]? | {key: .tag, value: ([.reached[]?.at | values] | min)}] | from_entries)}] | from_entries' <<<"$graph") || return 1
  for p in $(jq -r --argjson r "$rel" '[.[].project | select(IN($r[]))] | unique[]' <<<"$items"); do
    mapfile -t shas < <(jq -r --arg p "$p" '.[] | select(.project == $p) | .merged | splits(" +") | select(. != "")' <<<"$items")
    released+=("$($BENCH_RELEASED_CMD "$p" "${shas[@]}" 2>/dev/null | jq -sc .)")
  done
  jq -c --argjson t "$t" --argjson days "$CHAIN_DAYS" --argjson r "$rel" --argjson d "$deployed" \
     --slurpfile x <(printf '%s\n' "${released[@]}" '[]') "$JQ_LIB"'
    . as $a | ($x | add | map(select(.sha)) | INDEX(.sha)) as $tag
    | [$a[] | [.merged | splits(" +") | select(. != "")] as $s | .project as $p
       | (.queued | ep) as $q
       | if (.project | IN($r[])) | not then {kind: "at_merge", at: (.finished | ep)}
         elif any($s[]; $tag[.] == null or $tag[.].error != null) then {kind: "unknown"}
         elif any($s[]; $tag[.].at == null) then {kind: "unreleased"}
         else {kind: "in_release", at: ([$s[] | $tag[.] | $d[$p][.tag] // .at] | max)} end
       | . + {q: $q}] as $rows
    | ($rows | map(select(.at != null and .q != null and .at > $t - $days * 86400 and .at <= $t))) as $live
    | ($live | map((.at - .q) / 3600 | round1)) as $h
    | {hours: $h, p50: ($h | median | if . == null then null else round1 end),
       at_merge: ($live | map(select(.kind == "at_merge")) | length),
       in_release: ($live | map(select(.kind == "in_release")) | length),
       unreleased: ($rows | map(select(.kind == "unreleased")) | length),
       unknown: ($rows | map(select(.kind == "unknown")) | length)}' <<<"$items"
}

# lead_untrusted <key=value lines> -> one "<kpi> <value> (min <bound>)" line per BENCH_LEAD_TRUST
# KPI that is unread, has no min in kpi-thresholds, or sits under it; nothing when all hold, and
# request_to_live_h reads its value only then (a lead time over a ledger that misses half the
# merges is not one).
lead_untrusted() {
  local kv=$1 k v min
  for k in $BENCH_LEAD_TRUST; do
    v=$(sed -n "s/^$k=//p" <<<"$kv" | tail -1)
    min=$(sed -n "s/^${k}_min=//p" "$KPI_THRESHOLDS" 2>/dev/null | tail -1)
    if [ -z "$min" ]; then echo "$k ${v:-?} (no min)"
    elif ! awk -v v="$v" -v m="$min" 'BEGIN { exit !(v ~ /^[0-9.]+$/ && v + 0 >= m + 0) }'; then echo "$k ${v:-?} (min $min)"; fi
  done
}

# playtest_blame <board json> -> "<sheet>\t<line>\t<epoch>" for each line of every playtest sheet
# with an open check on a managed board: the author time git blame gives the line, as a check
# carries no date of its own (an uncommitted line reads now); "<sheet>\t?\t?" for a sheet git cannot blame
playtest_blame() {
  local s
  jq -r '[.rows[]? | select(.lane == "playtest" and .state == "open" and .automation != false) | .sheet | strings] | unique[]' <<<"$1" |
    while IFS= read -r s; do
      git -C "${s%/*}" blame --line-porcelain -M -- "${s##*/}" 2>/dev/null | awk -v s="$s" '
        substr($0, 1, 1) != "\t" && length($1) >= 40 && $1 ~ /^[0-9a-f]+$/ && NF >= 3 { l = $3 }
        /^author-time / { print s "\t" l "\t" $2; n++ }
        END { if (!n) print s "\t?\t?" }'
    done
}

# board_links <now> -> one object naming the rows behind five chain KPIs, a field null when its
# source cannot be read; nothing and rc 1 when the board feed (BENCH_BOARD_CMD) cannot be read.
# Rows of a project with automation off are never counted.
#   orphans (orphan_request_rows): open rows with an id whose #of/ parent is no open row, or that a
#     done item with merge proof (the done items merged_open_rows reads) names as its subject while
#     it worked another row. The subject is agent-queue named_row's, over the title, else the task's
#     first line: its first word, or the one id in brackets. The item that worked the row itself is
#     merged_open_rows; a merged PR reaches a row through its item. A row an active item works
#     (BENCH_ITEMS_CMD) is that item's to move, so it is no orphan of the merged one.
#   blocked (next_up_blocked): open agent rows the dispatch judge's latest verdict (BENCH_VERDICTS_CMD)
#     skipped for a split (plan: a DISPATCH_PLAN_RULES rule) over 24h ago, and that split never ran
#   urgent (stale_urgent_d): the oldest triaged #urgent agent row not yet started (open, or Next up:
#     its item queued), in whole days since it was filed
#   playtest (playtest_waiting_d): each game's oldest open playtest check, days since git blame dates it
#   done_old (done_inline_old): closed rows past the Done window that the next sweep rolls off
board_links() {
  local t=$1 feed done verdicts blame active
  feed=$($BENCH_BOARD_CMD 2>/dev/null | jq -ce 'select(.rows | arrays)') || return 1
  active=$($BENCH_ITEMS_CMD 2>/dev/null | jq -sc .) || active=null
  done=$($BENCH_DONE_ITEMS_CMD --since "$(date -d "@$((t - (CHAIN_DAYS + 1) * 86400))" +%F)" 2>/dev/null | jq -sc .) || done=null
  verdicts=$($BENCH_VERDICTS_CMD 2>/dev/null | jq -sc .) || verdicts=null
  blame=$(playtest_blame "$feed" | jq -Rsc 'split("\n") | map(select(. != "") | split("\t"))')
  jq -c --argjson t "$t" --slurpfile d <(printf '%s' "$done") --slurpfile v <(printf '%s' "$verdicts") \
     --slurpfile a <(printf '%s' "$active") --argjson blame "${blame:-[]}" "$JQ_LIB"'
    def subject: [(capture("^\\s*(?<i>[a-z]{2,4}-[0-9]+)([:\\s]|$)"; "i") | .i), (scan("[(\\[]([a-z]{2,4}-[0-9]+)[)\\]]"; "i") | .[0])]
      | map(ascii_downcase) | unique | if length == 1 then .[0] else null end;
    def live: .state == "open" or .state == "doing";
    $d[0] as $d | $v[0] as $v | ($a[0] | if . == null then null else map(rowkey | strings) | INDEX(.) end) as $worked
    | [.rows[] | select(.id != null and live)] as $live
    | ($live | map({key: "\(.project):\(.id)", value: .}) | from_entries) as $open
    | ($live | group_by(.id) | map({key: .[0].id, value: .}) | from_entries) as $byid
    | [.rows[] | select(.automation != false)] as $rows
    | {orphans: (if $d == null or $worked == null then null else
         [($rows[] | select(.id != null and live and .parent != null and $open["\(.project):\(.parent)"] == null)
             | {project, id, why: "its parent \(.parent) is closed"}),
          ($d[] | select((.merged // "") != "")
             | ((.title | select(. != "")) // (.task // "" | split("\n")[0]) // "" | subject) as $s | select($s != null) | $byid[$s][]? as $o
             | select($o.automation != false and ([rowkey | strings] | index(["\($o.project):\($s)"]) == null)
                      and $worked["\($o.project):\($s)"] == null)
             | {project: $o.project, id: $s, why: "\(.slug) landed it"})]
         | unique_by([.project, .id]) end),
       blocked: (if $v == null then null else
         ($v | map(select(.lane == "agent" and .plan == true))
              | map({key: "\(.project)\t\(.key)", value: .}) | from_entries) as $by
         | [$rows[] | select(.lane == "agent" and .state == "open" and .id != null)
             | $by["\(.project)\t\(.id)"] as $x | select($x != null)
             | (($x.at // "") | try iso_epoch catch null) as $at | select($at != null and $at < $t - 86400)
             | {project, id, rule: $x.rule, at: $x.at}] end),
       urgent: ([$rows[] | select(.lane == "agent" and .priority == "urgent" and .untriaged != true
                   and (.state == "open" or .section == "next") and ((.since // "") | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")))
                 | {project, id, since, days: (($t - (.since + "T00:00:00Z" | fromdate)) / 86400 | floor)}]
                | sort_by(-.days) | first),
       playtest: (if any($blame[]; .[1] == "?") then null else
         ($blame | map({key: "\(.[0])\t\(.[1])", value: (.[2] | tonumber)}) | from_entries) as $at
         | [$rows[] | select(.lane == "playtest" and .state == "open") | $at["\(.sheet)\t\(.line)"] as $e | select($e != null)
             | {project, game: (.game // "-"), days: (($t - $e) / 86400 | floor)}]
         | group_by([.project, .game]) | map(max_by(.days)) | sort_by(-.days) end),
       done_old: (.projects // null | if . == null then null
         else map(select(.automation != false) | .done_old) | if any(. == null) then null else add // 0 end end)}' <<<"$feed"
}

# chain_notes <now> <chain json>: the lines under the chain table that say which rows sit behind
# its numbers, the lead time's raw value while its trust KPIs hold it at ? among them
chain_notes() {
  local t=$1 stats lead held
  $BENCH_ITEMS_CMD 2>/dev/null | jq -rs "$JQ_LIB"'
    map(ownerless | .slug) | select(. != []) | "ownerless_running: \(join(", "))"' 2>/dev/null
  $BENCH_BOARD_CMD 2>/dev/null | jq -r --argjson t "$t" '
    [.rows[]? | select(.lane == "agent" and .requested and .state == "open" and ((.since // "") | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")))]
    | sort_by(.since) | first // empty
    | "requested_unstarted_h: oldest is \(.project):\(.id), open since \(.since) (\(($t - (.since + "T00:00:00Z" | fromdate)) / 3600 | floor)h)"' 2>/dev/null
  board_links "$t" | jq -r 'def few: (.[0:8] | join(", ")) + (if length > 8 then ", \(length - 8) more" else "" end);
    (.orphans // [] | select(. != []) | "orphan_request_rows: " + (map("\(.project):\(.id) (\(.why))") | few)),
    (.blocked // [] | select(. != []) | sort_by(.at) | "next_up_blocked: skipped for a split over 24h ago, oldest first: " + (map("\(.project):\(.id) (\(.rule) \(.at[0:10]))") | few)),
    (.urgent // empty | "stale_urgent_d: oldest is \(.project):\(.id), filed \(.since) (\(.days)d)"),
    (.playtest // [] | select(. != []) | "playtest_waiting_d: oldest open check per game: " + (map("\(.project) \(.game) \(.days)d") | few))' 2>/dev/null
  local projects
  projects=$($BENCH_PROJECTS_CMD 2>/dev/null | jq -ce 'arrays') && release_kpis "$t" "$projects" | jq -r '
    (.overdue | select(. != []) | "release_overdue: " + (map("\(.project) \(.version) due since \(.due_on)") | join(", "))),
    (.drift | select(. != []) | "version_tag_drift: " + (map("\(.project) sheet \(.sheet), tag \(.tag)") | join(", ")))' 2>/dev/null
  held=$(lead_untrusted "$(jq -r 'to_entries[] | "\(.key)=\(.value["7d"] // "?")"' <<<"$2")" | paste -sd, - | sed 's/,/, /g')
  if lead=$(lead_time_json "$t"); then
    jq -r --argjson d "$CHAIN_DAYS" --argjson lead "$BENCH_LEAD_DAYS" --arg held "$held" '"request_to_live_h: p50 \(.p50 // "-")h over \(.hours | length) live in \($d)d"
      + " (\(.at_merge) on merge, \(.in_release) in a tag); of those merged in \($lead)d, \(.unreleased) in no tag yet, \(.unknown) unknown"
      + (if $held == "" then "" else "; reads ? until \($held)" end)' <<<"$lead"
  else
    echo "request_to_live_h: the done items or the release graph (hub releases --json) unreadable"
  fi
  if stats=$(wants_stats "$t") && [ -n "$stats" ]; then
    jq -r --argjson d "$CHAIN_DAYS" '"wants_unstamped: \(.unstamped) of \(.total) human-channel agent rows added in \($d)d carry no #requested, by project"
      + (if .total == 0 then "" else " (" + ([.by_project | to_entries | sort_by(-.value.unstamped)[] | "\(.key) \(.value.unstamped)/\(.value.total)"] | join(", ")) + ")" end)' <<<"$stats"
  else
    echo "wants_unstamped: $BENCH_INGEST unreadable"
  fi
}

# release_kpis <now> <projects json> -> {overdue: [{project, version, due_on}], drift: [{project, sheet,
# tag}]}, the release link over `notes projects --stats --json` (stages.md, "Versions"). overdue: a project
# whose own sheet counter owns its version (project_version_owner) still due a day after its due date, so
# a wave-roll pass had all day to cut it; its `.release.due` already means done rows waited out the
# cadence. drift: a project a vX.Y.Z tag owns whose sheet is neither that tag (the roll is pending) nor a
# next open version above it (git_version_next_ok, what wave-roll may open). A game waiting on its first
# tag counts in neither, and so does a profile with `automation = false`.
release_kpis() {
  local today prof name ver due_on shipped
  today=$(date -d "@$1" +%F)
  jq -r '.[] | select(.automation != false) | [.profile, .name, (.version // "-"), (if .release.due then .release.due_on // "-" else "-" end)] | join("|")' <<<"$2" |
  while IFS='|' read -r prof name ver due_on; do
    shipped=$(project_release_version "$name")
    case "$(project_version_owner "$name" "$shipped")" in
      sheet) [ "$due_on" != - ] && [[ "$due_on" < "$today" ]] &&
               jq -cn --arg p "$prof/$name" --arg v "$ver" --arg d "$due_on" '{overdue: {project: $p, version: $v, due_on: $d}}' ;;
      tag) [[ "$shipped" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] && [ "$ver" != "$shipped" ] &&
             project_release_lib && ! git_version_next_ok "$shipped" "$ver" &&
             jq -cn --arg p "$prof/$name" --arg v "$ver" --arg s "$shipped" '{drift: {project: $p, sheet: $v, tag: $s}}' ;;
    esac
    :   # a project that counts in neither is no failed pass, under pipefail
  done | jq -sc '{overdue: map(.overdue // empty), drift: map(.drift // empty)}'
}

# chain_counts <now> -> one key=value line per KPI_CHAIN entry, ? when its source cannot be read
chain_counts() {
  local t=$1 since active done board projects ci links lead
  since=$(date -d "@$((t - (CHAIN_DAYS + 1) * 86400))" +%F)
  active=$($BENCH_ITEMS_CMD 2>/dev/null | jq -sc .) || active=null
  done=$($BENCH_DONE_ITEMS_CMD --since "$since" 2>/dev/null | jq -sc .) || done=null
  board=$($BENCH_BOARD_CMD 2>/dev/null | jq -ce '.rows | arrays') || board=null
  projects=$($BENCH_PROJECTS_CMD 2>/dev/null | jq -ce 'arrays') || projects=null
  ci=null; [ -r "$CI" ] && ci=$(ci_claimed | jq -sc --argjson t "$t" --argjson d "$CHAIN_DAYS" --argjson fix "$FIX_SINCE" \
    'map(select(.merged_epoch > ([$t - $d * 86400, $fix] | max) and .merged_epoch <= $t))')
  links=$(jq -rn --argjson t "$t" --argjson days "$CHAIN_DAYS" --slurpfile a <(printf '%s' "$active") --slurpfile d <(printf '%s' "$done") \
     --slurpfile b <(printf '%s' "$board") --slurpfile p <(printf '%s' "$projects") \
     --slurpfile c <(printf '%s' "$ci") "$JQ_LIB"'
    def n($v): if $v == null then "?" else $v end;
    $a[0] as $a | $d[0] as $d | $b[0] as $b | $p[0] as $p | $c[0] as $c
    | (if $a == null or $d == null or $c == null then null
       else (($a + $d) | map(prkeys[]) | INDEX(.)) as $refs
         | {total: ($c | length),
            hit: ($c | map(select($refs[itemkey])) | length)} end) as $cov
    | ($b // [] | map(select(.lane == "agent"))) as $agent
    | ($b // [] | map("\(.project):\(.id)") | INDEX(.)) as $open
    | ($agent | map(select(.automation != false and .type != "epic"))) as $linkable
    | "ledger_coverage=\(n(if $cov == null then null else ratio($cov.hit; $cov.total) end))",
      "untracked_merged_prs=\(n(if $cov == null then null else $cov.total - $cov.hit end))",
      "board_orphan_started=\(n(if $a == null or $b == null then null else ($a | map(rowkey | strings) | INDEX(.)) as $live
        | $agent | map(select(.state == "doing" and ($live["\(.project):\(.id)"] | not))) | length end))",
      "merged_open_rows=\(n(if $d == null or $b == null then null
        else $d | map(select(.merged and any(rowkey | strings; $open[.] != null))) | length end))",
      "ownerless_running=\(n(if $a == null then null
        else $a | map(ownerless) | length end))",
      "epic_linked_share=\(n(if $b == null or $p == null then null
        else ratio($linkable | map(select(.tags | any(startswith("of/")))) | length; $linkable | length) end))",
      "landed_unverified=\(n(if $p == null then null else [$p[] | (.epics // [])[] | select(leaves_landed)] | length end))",
      "requested_unstarted_h=\(n(if $b == null then null else [$agent[] | select(.requested and .state == "open" and ((.since // "") | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")))
        | ($t - (.since + "T00:00:00Z" | fromdate)) / 3600 | floor] | max // 0 end))",
      "cost_per_merged_item=\(n(if $d == null then null else [$d[] | select(.merged and (.finished // "" | fromdateiso8601? // 0) > $t - $days * 86400)
        | [.cost_usd, .gateway_cost_usd] | map(tonumber? // empty) | select(length > 0) | add]
        | if length == 0 then null else add / length * 100 | round / 100 end end))"')
  [ -n "$links" ] && printf '%s\n' "$links"
  local rel
  if [ "$projects" != null ] && rel=$(release_kpis "$t" "$projects"); then
    jq -r '"release_overdue=\(.overdue | length)", "version_tag_drift=\(.drift | length)"' <<<"$rel"
  else printf '%s=?\n' release_overdue version_tag_drift; fi
  if [ -n "$(lead_untrusted "$links")" ]; then echo "request_to_live_h=?"
  elif lead=$(lead_time_json "$t"); then jq -r '"request_to_live_h=\(.p50 // "?")"' <<<"$lead"
  else echo "request_to_live_h=?"; fi
  local bl
  if bl=$(board_links "$t"); then
    jq -r '"orphan_request_rows=\(.orphans | if . == null then "?" else length end)",
      "next_up_blocked=\(.blocked | if . == null then "?" else length end)",
      "stale_urgent_d=\(.urgent.days // 0)",
      "playtest_waiting_d=\(.playtest | if . == null then "?" else map(.days) | max // 0 end)",
      "done_inline_old=\(.done_old // "?")"' <<<"$bl"
  else printf '%s=?\n' orphan_request_rows next_up_blocked stale_urgent_d playtest_waiting_d done_inline_old; fi
  if [ -r "$BENCH_DOCTOR_LAST" ]; then echo "doctor_fail=$(grep -c '^FAIL' "$BENCH_DOCTOR_LAST")"; else echo "doctor_fail=?"; fi
  # older than four tries is an estimator that stopped, not today's share
  echo "estimated_token_share=$(jq -r --argjson oldest "$((t - BENCH_FLEET_COST_EVERY_MIN * 240))" 'if (.as_of_epoch // 0) < $oldest then "?" else .coverage.estimated_token_share // "?" end' "$BENCH_FLEET_COST_FILE" 2>/dev/null || echo '?')"
  local orphans dups
  # the newest night only: a runner that stopped must read ?, never an older night's count as now
  dups=$(ls -d "$BENCH_DOCS_CLEANUP_DIR"/*/ 2>/dev/null | tail -1)
  if [ -n "$dups" ] && dups=$(jq -er '.pairs | numbers' "${dups}dups.json" 2>/dev/null); then echo "dup_pairs=$dups"; else echo "dup_pairs=?"; fi
  if orphans=$(plans_orphaned); then echo "plans_unqueued=$(grep -c . <<<"$orphans")"; else echo "plans_unqueued=?"; fi
  echo "routes_unresolved=$(triage_coverage | grep -c .)"
  local wants
  if wants=$(wants_stats "$t"); then jq -r '"wants_unstamped=\(if .total == 0 then 0 else (.unstamped / .total * 1000 | round) / 1000 end)"' <<<"$wants"; else echo "wants_unstamped=?"; fi
  local held
  held=$($BENCH_ADMISSION_CMD 2>/dev/null | jq -er '.held_7d | numbers' 2>/dev/null) || held='?'
  echo "admission_held=$held"
  reds_counts "$1"
  pipeline_json "$t" | jq -r 'def n: if . == null then "?" else . end;
    "chain_drift=\(.drift | n)",
    (.steps[] | select(.step | IN("backlog", "queued", "running", "review", "waiting")) | "step_age_p90_\(.step)=\(.age_p90_min | n)"),
    (.steps[] | select(.step == "queued") | "queue_net_24h=\(if .in_24h == null or .out_24h == null then "?" else .in_24h - .out_24h end)")'
}

# The work chain's steps, in order: an untriaged line, an open agent-board row, a queue item
# queued, running, on its PR (review) or waiting on the human, and done.
PIPELINE_STEPS="inbox backlog queued running review waiting done"

# inbox_lines -> how many lines wait untriaged: the outbox plus every project's `## Inbox`
inbox_lines() {
  local out p
  out=$($BENCH_NOTES_CMD outbox list) || return 1
  for p in $($BENCH_PROJECTS_CMD | jq -r '.[].name'); do
    $BENCH_NOTES_CMD ptask "$p" inbox --json 2>/dev/null || echo '[]'
  done | jq -s --argjson n "$(grep -c . <<<"$out")" '$n + (map(length) | add // 0)'
}

# pipeline_json <now> -> where every item sits: {since, drift, bottleneck, steps}, one step object
# each in PIPELINE_STEPS order. WIP and the age of what sits in a step (p50, p90, oldest, minutes)
# come from the state files: the inbox count, open agent rows no active item has started (aged
# from the day they were filed), the queue items by state (aged from queued, started, waiting), and
# the items finished in the last 24h. In, out and dwell come from the record (`notes log --steps`),
# which cannot see work older than its start (since). drift counts the queue items the record and
# the queue folders place apart: at another step, held by the record but gone from the queue, or
# queued after the record began with no event of it. The bottleneck is the step whose age p90 is
# furthest past its step_age_p90_<step>_max in kpi-thresholds, null while every step is inside its
# bound. A source that cannot be read leaves its numbers null.
pipeline_json() {
  local t=$1 items fin board rec inbox stopped lim='{}'
  stopped=$($BENCH_STOPPED_CMD 2>/dev/null | jq -r '.line // empty' 2>/dev/null)
  items=$($BENCH_ITEMS_CMD 2>/dev/null | jq -sc .) || items=null
  fin=$($BENCH_DONE_ITEMS_CMD --since "$(date -d "@$((t - 86400))" +%F)" 2>/dev/null | jq -sc .) || fin=null
  board=$($BENCH_BOARD_CMD 2>/dev/null | jq -ce '.rows | arrays') || board=null
  rec=$($BENCH_STEPS_CMD 2>/dev/null | jq -ce 'select(.steps | arrays)') || rec=null
  inbox=$($BENCH_INBOX_CMD 2>/dev/null | jq -e 'numbers') || inbox=null
  [ -r "$KPI_THRESHOLDS" ] && lim=$(grep -E '^[a-z0-9_]+=' "$KPI_THRESHOLDS" | kv_json)
  jq -cn --argjson t "$t" --arg steps "$PIPELINE_STEPS" --argjson lim "$lim" --argjson inbox "$inbox" --arg stopped "$stopped" \
     --slurpfile a <(printf '%s' "$items") --slurpfile d <(printf '%s' "$fin") \
     --slurpfile b <(printf '%s' "$board") --slurpfile r <(printf '%s' "$rec") "$JQ_LIB"'
    def epoch: strings | sub("\\.[0-9]+"; "") | fromdateiso8601? // empty;
    def mins: ($t - .) / 60 | floor;
    def pct($p): sort | if length == 0 then null else .[([length * $p / 100 | ceil, 1] | max) - 1] end;
    $a[0] as $a | $d[0] as $d | $b[0] as $b | $r[0] as $r
    | def held($s; $f): if $a == null then null else $a | map(select(.state == $s)) | {n: length, ages: map(.[$f] | epoch | mins)} end;
    ($a // [] | map(rowkey | strings) | INDEX(.)) as $live
    | {inbox: (if $inbox == null then null else {n: $inbox, ages: []} end),
       backlog: (if $b == null or $a == null then null
                 else $b | map(select(.lane == "agent" and .state == "open" and ($live["\(.project):\(.id)"] | not)))
                   | {n: length, ages: map((.since // "") + "T00:00:00Z" | epoch | mins)} end),
       queued: held("queued"; "queued"), running: held("running"; "started"), review: held("review"; "review"),
       waiting: held("waiting"; "waiting"),
       done: (if $d == null then null else {n: ($d | map(select((.finished | epoch) > $t - 86400)) | length), ages: []} end)} as $now
    | ($r.steps // [] | INDEX(.step)) as $flow
    | [$steps | split(" ")[] | . as $s | $now[$s] as $w | ($flow[$s] // {}) as $f
       | (($lim["step_age_p90_\($s)_max"] | numbers) // null) as $bound | ($w.ages // [] | pct(90)) as $p90
       | {step: $s, wip: $w.n, age_p50_min: ($w.ages // [] | pct(50)), age_p90_min: $p90, oldest_min: ($w.ages // [] | max),
          in_1h: $f.in_1h, out_1h: $f.out_1h, in_24h: $f.in_24h, out_24h: $f.out_24h,
          dwell_p50_min: $f.dwell_p50_min, dwell_p90_min: $f.dwell_p90_min, bound: $bound,
          ratio: (if $bound == null or $bound <= 0 or $p90 == null then null else $p90 / $bound * 100 | round / 100 end),
          problems_n: $f.problems_n, problems: ($f.problems // []),
          blocked: (if $s == "queued" and $stopped != "" then $stopped else null end)}] as $rows
    | (if $a == null or $r == null then null
       else ($r.steps | map(.step as $s | (.items // [])[] | {key: ., value: $s}) | from_entries) as $rec
         | ($a | map({key: .slug, value: .state}) | from_entries) as $st
         | ([$a[] | select(if $rec[.slug] then $rec[.slug] != .state else (.queued // "") >= ($r.items_since // "~") end)] | length)
           + ([$rec | keys[] | select($st[.] == null)] | length) end) as $drift
    | {as_of: $t, since: $r.since, items_since: $r.items_since, drift: $drift,
       bottleneck: ($rows | map(select((.ratio // 0) > 1)) | max_by(.ratio) | if . then {step, age_p90_min, bound, ratio} else null end),
       steps: $rows}'
}

# pipeline [--json] -- pipeline_json, or a table of it with the bottleneck, the steps taking in more
# than they let out over 24h, and the drift.
cmd_pipeline() {
  local json
  case "${1:-}" in ""|--json) ;; *) say "usage: fleet-bench pipeline [--json]"; return 2 ;; esac
  json=$(pipeline_json "$(now)") || return 1
  [ "${1:-}" = --json ] && { printf '%s\n' "$json"; return 0; }
  jq -r 'def m: if . == null then "-" elif . >= 1440 then "\(. / 144 | round / 10)d" elif . >= 60 then "\(. / 6 | round / 10)h" else "\(.)m" end;
    def c: if . == null then "-" else tostring end;
    "step       wip   age p50   p90  oldest   in/out 1h  in/out 24h  dwell p50   p90   bound",
    (.steps[] | "\(.step | . + "         " | .[0:8]) \(.wip | c | " " * (5 - length) + .) \(.age_p50_min | m | " " * (9 - length) + .) \(.age_p90_min | m | " " * (5 - length) + .) \(.oldest_min | m | " " * (7 - length) + .) \("\(.in_1h | c)/\(.out_1h | c)" | " " * (11 - length) + .) \("\(.in_24h | c)/\(.out_24h | c)" | " " * (11 - length) + .) \(.dwell_p50_min | m | " " * (10 - length) + .) \(.dwell_p90_min | m | " " * (5 - length) + .) \(.bound | m | " " * (7 - length) + .)"),
    "",
    (.bottleneck | if . then "bottleneck: \(.step), age p90 \(.age_p90_min | m) against a bound of \(.bound | m) (\(.ratio)x)"
                   else "bottleneck: none, every step with a bound is inside it" end),
    (.steps[] | select(.blocked) | "blocked at \(.step): \(.blocked)"),
    ([.steps[] | select(.in_24h != null and .step != "done" and .in_24h > .out_24h) | "\(.step) +\(.in_24h - .out_24h)"]
      | if length > 0 then "growing over 24h: \(join(", "))" else empty end),
    ([.steps[] | select((.problems_n // 0) > 0) | "\(.step) \(.problems_n)"]
      | if length > 0 then "problems over 24h: \(join(", "))" else empty end),
    "drift: \(.drift | c) queue items the record and the queue folders place apart (it sees queue items from \(.items_since // "-"))"' <<<"$json"
}

# ledger_check <counts> -> one line per gated count over the baseline; exit 1 if any, 2 if no baseline
ledger_check() {
  local k cur base bad=0
  [ -r "$LEDGER_BASELINE" ] || { say "no ledger baseline at $LEDGER_BASELINE"; return 2; }
  for k in $LEDGER_GATED; do
    cur=$(sed -n "s/^$k=//p" <<<"$1"); cur=${cur//[[:blank:]]/}   # BSD wc pads its count
    base=$(sed -n "s/^$k=//p" "$LEDGER_BASELINE" | tail -1)
    # A missing or non-numeric value fails: `[ "" -gt 8 ]` errors and reads as not grown.
    [[ $base =~ ^[0-9]+$ ]] || { say "baseline has no number for $k: '$base'"; bad=1; continue; }
    [[ $cur =~ ^[0-9]+$ ]] || { say "no single count for $k: '$cur'"; bad=1; continue; }
    if [ "$cur" -gt "$base" ]; then
      echo "$k grew: $cur > baseline $base"
      bad=1
    fi
  done
  return "$bad"
}

cmd_ledger() {
  local counts
  case "${1:-}" in
    --launches) shift; headless_launches "$@"; return 0 ;;
    --check) ledger_check "$(ledger_roster)"; return ;;
  esac
  counts=$(ledger_counts)
  case "${1:-}" in
    --json) jq -Rn '[inputs | split("=") | {key: .[0], value: (.[1] | tonumber? // .)}] | from_entries' <<<"$counts" ;;
    "") echo "$counts" ;;
    *) say "ledger: unknown option $1"; return 2 ;;
  esac
}

# ---------------------------------------------------------------- rules

# The rule register: one JSON row per rule, its kind, the number it rests on, a confidence and a
# revisit trigger (~/.local/src/docs/standards.md, the last rule). A row with `measure` and `max` or
# `min` re-measures itself here: `measure` prints a number, `holds` says it is inside the bound.
# confidence low records a number known not to hold, so `moved` is a change from what the register
# says, never a number merely being past its line. `anchored` is the rule's text still being in its
# source; null when the source is not on this machine. A row's optional `scenario` is the hard
# situation the rule decides: the must-keep list a context trim is checked against (context-trim skill).

# rules_states -> each register row, one JSON object a line, with anchored, value, holds, moved, dead.
rules_states() {
  [ -s "$RULES_REGISTER" ] || return 0
  local src anchor cmd value anchored
  while IFS=$'\x1f' read -r src anchor cmd; do
    src="${src/#\~/$HOME}"
    if [ ! -f "$src" ]; then anchored=null
    elif grep -qF -- "$anchor" "$src"; then anchored=true
    else anchored=false
    fi
    value=""
    [ -z "$cmd" ] || value=$(timeout "$RULES_MEASURE_TIMEOUT" bash -c "$cmd" 2>/dev/null </dev/null | tail -1)
    printf '%s\x1f%s\n' "$anchored" "$value"
  done < <(jq -r '[.source, .anchor, (.measure // "")] | map(gsub("\n"; " ")) | join("\u001f")' "$RULES_REGISTER") |
    jq -cRn --slurpfile rows "$RULES_REGISTER" '
      [inputs | split("\u001f")] as $seen
      | range($rows | length) as $i
      | $rows[$i] + {anchored: ($seen[$i][0] | fromjson), value: ($seen[$i][1] | tonumber? // null)}
      | (.max != null or .min != null) as $bounded
      | .dead = ($bounded and .value == null)
      | .holds = (if $bounded and .value != null
          then ((.max == null or .value <= .max) and (.min == null or .value >= .min)) else null end)
      | .moved = (.holds != null and .holds != (.confidence != "low"))'
}

# rules_problems <states array> -> one line per row --check fails on.
rules_problems() {
  jq -r '.[] | (.source | split("/") | last) as $f
    | if .anchored == false then "stale: \($f): \(.anchor)"
      elif .dead then "dead measure: \($f): \(.anchor)"
      elif .moved then "moved: \($f): \(.anchor): \(.value) against \(if .max != null then "max \(.max)" else "min \(.min)" end), recorded \(.confidence)"
      else empty end' <<<"$1"
}

# rules_summary <states array> -> the counts, key=value.
rules_summary() {
  jq -r 'def n($k; $v): map(select(.[$k] == $v)) | length;
    ["rules=\(length)", "invariant=\(n("kind"; "invariant"))", "provisional=\(n("kind"; "provisional"))",
     "confidence_high=\(n("confidence"; "high"))", "confidence_med=\(n("confidence"; "med"))", "confidence_low=\(n("confidence"; "low"))",
     "keep=\(n("action"; "keep"))", "rewrite=\(n("action"; "rewrite"))", "drop=\(n("action"; "drop"))",
     "measured=\(map(select(.holds != null)) | length)", "holds=\(n("holds"; true))", "past=\(n("holds"; false))",
     "scenarios=\(map(select((.scenario // "") != "")) | length)"] | .[]' <<<"$1"
}

# rules_scenarios <states array> -> one line per hard scenario: ok, stale or absent (source not here),
# the source file, the scenario, and the anchor that must stay.
# One line per scenario, with its full source (three files here are called CLAUDE.md); 1 when any is stale.
rules_scenarios() {
  local out
  out=$(jq -r '.[] | select((.scenario // "") != "")
    | "\(if .anchored == true then "ok" elif .anchored == false then "stale" else "absent" end)\t\(.source)\t\(.scenario)\t\(.anchor)"' <<<"$1")
  [ -z "$out" ] || printf '%s\n' "$out"
  ! grep -q '^stale' <<<"$out"
}

cmd_rules() {
  local states problems
  states=$(rules_states | jq -s .)
  problems=$(rules_problems "$states")
  case "${1:-}" in
    --json) echo "$states" ;;
    --check) [ -z "$problems" ] || { echo "$problems"; return 1; } ;;
    --scenarios) rules_scenarios "$states" ;;
    "") rules_summary "$states"; [ -z "$problems" ] || echo "$problems" ;;
    *) say "rules: unknown option $1"; return 2 ;;
  esac
}

# KPIs: ratios over the human sessions session-outcomes saw in the last 7 and 28 days, the comms
# standard's 7d and 28d numbers from the nightly comms snapshot (comms-lint owns the formulas), the
# judges' from judge-eval (it owns those; ~/.local/src/docs/judges.md), plus counts taken now. Headless runs are left out: they have no human to interrupt and their
# cost is the fleet's, not a session's. Each threshold is <kpi>_max or <kpi>_min.

KPI_NOW="runners_bad failed_unexplained board_open points_per_pr loop_dark loop_dark_7d $KPI_CHAIN cost_per_merged_item red_fix_min_p50 lesson_held_share worktrees_held worktrees_held_over_7d"
KPI_COMMS="buzzes_per_day comms_pass_pct rows_pass_pct pages_held_per_day"
KPI_JUDGE="judge_errors judge_precision ask_answered_pct ask_false_defer_pct ask_unclear_pct dispatch_false_defer_pct"
KPI_ASKS="human_answered_per_day ask_wait_p90_min"
KPI_STARTUP="startup_ready_ms_p50"
KPI_SANDBOX="sandboxed_lane_pct"
# Each scored runner's runner_score_<name> is judge-eval's too, listed from its output and the
# thresholds rather than here: the runner confs' SCORE= is the one list of lanes.

# comms_kpi -> the comms snapshot's KPI object, or {} when there is none or it is stale, so both
# KPIs show - rather than an old number
comms_kpi() { $BENCH_COMMS_CMD kpi --json 2>/dev/null | jq -ce 'objects' 2>/dev/null || echo '{}'; }
# judge_kpi -> judge-eval's KPI object, the same shape, or {} when it cannot score
judge_kpi() { $BENCH_JUDGE_CMD kpi --json 2>/dev/null | jq -ce 'objects' 2>/dev/null || echo '{}'; }
# ask_kpi <now> -> the ask KPIs, the same shape, or {} when agent-ask cannot be read.
# human_answered_per_day: asks the human answered in the window, a day, outside the chat that asked
# them, so it counts interrupts: an answer typed into the asking session (answer_note "in session: ",
# closed_reason "replied in session") or with no answered_by (an in-session capture from before the
# field existed) is the conversation, not an interrupt (the human's pick in ask Go78lB, 2026-11-10).
# ask_wait_p90_min: p90 minutes from post to answer or close over the asks posted in the window, a
# pending one counted to now, so an ask nobody answers raises it (this replaced asks_stale).
# A cancelled ask was withdrawn by its asker and waited on no one.
ask_kpi() {
  local asks
  asks=$($BENCH_ASKS_ALL_CMD 2>/dev/null) || { echo '{}'; return 0; }
  jq -nc --argjson t "$1" --rawfile a <(printf '%s' "$asks") "$JQ_LIB"'
    def p90: sort | if length == 0 then null else .[(length * 0.9 | ceil) - 1] end;   # nearest rank
    [$a | split("\n")[] | select(length > 0) | split("\t")
     | {status: .[3], by: (.[17] // ""), c: (.[11] // ""), a: (.[8] // ""), x: (.[13] // ""),
        chat: (((.[23] // "") | startswith("in session")) or ((.[14] // "") | test("replied in session")))}
     | select(.c != "")
     | .c |= ask_epoch | .a |= (if . == "" then null else ask_epoch end)
     | .x |= (if . == "" then null else ask_epoch end)] as $r
    | def w($d): ($t - $d * 86400) as $s
        | {human_answered_per_day: ([$r[] | select(.status == "answered" and .by == "human" and (.chat | not)
                                                  and .a != null and .a > $s and .a <= $t)] | length / $d | round1),
           ask_wait_p90_min: ([$r[] | select(.status != "cancelled" and .c > $s and .c <= $t)
                               | (([.a // .x // $t, $t] | min) - .c) / 60] | p90 | if . == null then null else round end)};
    w(7) as $x | w(28) as $y | $x | keys_unsorted | map({(.): {"7d": $x[.], "28d": $y[.]}}) | add'
}

# startup_rows -> every SessionStart row, oldest first; jq's starts keeps the process starts
startup_rows() {
  [ -s "$CLAUDE_STARTUP_LOG" ] || return 0
  jq -c 'objects' "$CLAUDE_STARTUP_LOG" 2>/dev/null || true
}
STARTUP_JQ='def starts: map(select(.source == "startup" and (.ready_ms | numbers)));'

# startup_kpi <now> -> the startup KPI object, the same shape as comms_kpi: the median ms from a
# process start to the turn-1 context over the starts in the window, all sessions (a headless start
# is as slow as a human one)
startup_kpi() {
  jq -nc --argjson t "$1" --slurpfile r <(startup_rows) "$JQ_LIB$STARTUP_JQ"'
    def w($d): [$r | starts[] | select(.epoch > $t - $d * 86400 and .epoch <= $t) | .ready_ms] | median;
    {startup_ready_ms_p50: {"7d": w(7), "28d": w(28)}}'
}

# sandbox_kpi <now> -> the lane sandbox KPI object, the same shape as comms_kpi. sandboxed_lane_pct: of
# the named lanes that ran claude or codex in the window (calls.jsonl, agent-run lib/calls.sh), the
# percent whose newest call ran under a lane sandbox profile (the record's sandbox field). A refused
# run makes no call (lib/sandbox.sh records it elsewhere). A raw-harness call has no shell to confine.
sandbox_kpi() {
  [ -s "$BENCH_CALLS" ] || { echo '{}'; return 0; }
  jq -nc --argjson t "$1" "$JQ_LIB"'
    [inputs | objects | select((.agent // "") != "" and (.harness == "claude" or .harness == "codex") and (.at | type) == "string")
     | {agent, sb: ((.sandbox // "") != ""), e: (try (.at | iso_epoch) catch null)} | select(.e)] as $c
    | def w($d): [$c[] | select(.e > $t - $d * 86400 and .e <= $t)] | group_by(.agent) | map(max_by(.e).sb)
        | if length == 0 then null else (map(select(.)) | length) * 100 / length | round1 end;
    {sandboxed_lane_pct: {"7d": w(7), "28d": w(28)}}' "$BENCH_CALLS" 2>/dev/null || echo '{}'
}

# KPI_DEFS: the windowed KPIs as jq, shared by kpi, its --trend and effect. win($t; $d) is every
# ratio over the human sessions whose last update fell in the $d days up to $t, with $o the outcome
# rows, $c the CI rows and $k the canary score rows (slurped). The token KPIs are sums over the
# nightly token-usage snapshots ($tk) of the whole days in the window, all sessions (start_context_median
# is the median of those days' first-turn context medians), so a token lever gets the same kpi, improve
# and effect verdicts as a process one. Older lines have no runner field;
# _runner is where headless runs are filed. A canary session is an eval, not work: it leaves the
# human KPIs and makes the canary_ ones, scored by the oracle and costed from its outcome row.
# The rework KPIs are shares of merged PRs (session-outcomes.sh "rework") that a fix rewrote within
# 7 days (candidate) or rewrote within 30 days and named (verified). Each reads the cohort that has
# had its whole window: sessions that ended 7 or 30 days (rework_kpi .lag) before the window, counting only PRs observed
# that long after their merge. A candidate is a lead, not a defect.
KPI_DEFS="$JQ_LIB"'
  def bots: ($o | map(select(.runner == true or .project == "_runner") | .session_id))
    + ($k | map(.session_id // empty)) | INDEX(.);
  # the human sessions that ended in ($since, $t]
  def humans($bot; $since; $t): $o | map(select(($bot[.session_id] | not) and .updated_epoch != null
                                               and .updated_epoch > $since and .updated_epoch <= $t));
  # each rework KPI: its lag in days and the flag session-outcomes sets on each PR rework
  def rework_kpi: {rework_candidate_7d: {lag: 7, flag: "candidate"}, rework_verified_30d: {lag: 30, flag: "verified"}};
  def reworked($bot; $t; $d; $k): rework_kpi[$k] as $r | ($t - $r.lag * 86400) as $u
    | [humans($bot; $u - $d * 86400; $u)[] | .prs[]? | .rework | select(. and .seen_days >= $r.lag)]
    | ratio(map(select(.[$r.flag])) | length; length);
  def win($t; $d): bots as $bot | ($t - $d * 86400) as $since
    | humans($bot; $since; $t) as $s
    | ($c | map(select(.merged_epoch > $since and .merged_epoch <= $t and ($bot[.session_id] | not)))) as $ci
    | ($k | map(select(canary_base and .epoch > $since and .epoch <= $t))) as $kw
    | ($o | INDEX(.session_id)) as $os | [$kw[] | $os[.session_id // ""] // empty] as $ks
    | ($s | total(.prs_merged)) as $prs
    | ($since | strflocaltime("%Y-%m-%d")) as $d0 | ($t | strflocaltime("%Y-%m-%d")) as $d1
    | ($tk | map(select((.date // "") >= $d0 and .date < $d1))) as $tw
    | ($tw | map(select(.merged_prs | numbers))) as $tp
    | ($tw | map(select(.context_split.start | numbers))) as $ts
    | {sessions: ($s | length), merged_prs: ($c | map(select(.merged_epoch > $since and .merged_epoch <= $t)) | unique_by([.repo, .number]) | length),
       revert_rate: ratio(($s | total(.reverted_7d)); $prs),
       interrupts_per_day: ratio(($s | total(.corrections.interrupts)); $d),
       cost_per_pr: ratio(($s | total(.cost_usd)); $prs),
       ci_red_per_pr: ratio(($ci | total(.ci_red)); $ci | length),
       first_pass_share: ($ci | map(select(ran_gate)) as $ran | ratio($ran | map(select(first_try)) | length; $ran | length)),
       plan_gate_deny_rate: ratio(($s | total(.plan_gate.denied)); $s | total(.plan_gate.exits)),
       canary_runs: ($kw | length), canary_pass_rate: ratio(($kw | map(select(.pass == true)) | length); $kw | length),
       canary_cost_per_task: ratio(($ks | total(.cost_usd)); $ks | length),
       canary_min_per_task: ratio(($ks | total(.duration_s)) / 60; $ks | length),
       canary_turns_per_task: ($ks | map(.activity.api_messages | numbers) | ratio(add // 0; length)),
       responses_per_merged_pr: ratio(($tp | total(.totals.responses)); $tp | total(.merged_prs)),
       context_per_merged_pr: (ratio(($tp | total(.totals.context)); $tp | total(.merged_prs)) | if . then round else . end),
       tool_chars_per_call: ratio(($tw | total(.totals.tool_chars)); $tw | total(.totals.tool_calls)),
       locate_read_share: ratio(($tw | total(.reads.locate_then_read)); $tw | total(.reads.reads)),
       reread_share: ratio(($tw | total(.reads.reread_same_lines)); $tw | total(.reads.reads)),
       cache_write_share: ratio(($tw | total(.totals.cache_write)); $tw | total(.totals.context)),
       start_share: ratio(($ts | total(.context_split.start)); $ts | total(.totals.context)),
       start_context_median: ($tw | map(.start_context_median | numbers) | median),
       compactions_per_session: ratio(($tw | total(.compactions)); $tw | total(.sessions)),
       rework_candidate_7d: reworked($bot; $t; $d; "rework_candidate_7d"),
       rework_verified_30d: reworked($bot; $t; $d; "rework_verified_30d")};
  # which way is better: -1 lower, 1 higher, 0 neither (sessions is volume, not quality)
  def better: {sessions: 0, merged_prs: 0, revert_rate: -1, interrupts_per_day: -1,
               cost_per_pr: -1, ci_red_per_pr: -1, first_pass_share: 1, plan_gate_deny_rate: -1, canary_runs: 0, canary_pass_rate: 1,
               canary_cost_per_task: -1, canary_min_per_task: -1, canary_turns_per_task: -1,
               responses_per_merged_pr: -1, context_per_merged_pr: -1, tool_chars_per_call: -1,
               locate_read_share: -1, reread_share: -1, cache_write_share: -1, start_share: -1, start_context_median: -1,
               compactions_per_session: -1, rework_candidate_7d: -1, rework_verified_30d: -1};'

# kpi_canary -> the canary score rows file, or /dev/null when there are none
kpi_canary() { [ -s "$CANARY" ] && printf '%s' "$CANARY" || printf /dev/null; }
# kpi_tokens -> each nightly token-usage snapshot (agent-usage tokens snapshot is its one writer), cut
# to the token KPIs' inputs, one a line; nothing when there are none
kpi_tokens() {
  local f=("$BENCH_TOKENS_DIR"/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].json)
  [ -e "${f[0]}" ] || return 0
  jq -c '{date, merged_prs, compactions, context_split, reads, start_context_median, sessions: ([.by_kind[]?.sessions | numbers] | add),
           totals: (.totals // {} | {responses, context, cache_write, tool_chars, tool_calls})}' "${f[@]}" 2>/dev/null || true
}

# kpi_json <now> <ledger counts> [historic] -> one object keyed by KPI, in table order. historic=1
# (kpi --at) leaves the comms and the counted-now KPIs null: nothing records them as of a past time.
kpi_json() {
  local lim='{}' cm='{}'
  [ -r "$KPI_THRESHOLDS" ] && lim=$(grep -E '^[a-z0-9_]+=' "$KPI_THRESHOLDS" | kv_json)
  [ "${3:-0}" = 1 ] || cm=$(jq -sc 'add' <(comms_kpi) <(judge_kpi) <(ask_kpi "$1") <(startup_kpi "$1") <(sandbox_kpi "$1"))
  jq -n --argjson t "$1" --slurpfile o <(outcomes_newest) --slurpfile c <(ci_claimed) --slurpfile k "$(kpi_canary)" --slurpfile tk <(kpi_tokens) \
     --argjson pit "$(kv_json <<<"$2")" --argjson lim "$lim" --arg nowkeys "$KPI_NOW" \
     --argjson cm "$cm" --arg commskeys "$KPI_COMMS $KPI_JUDGE $KPI_ASKS $KPI_STARTUP $KPI_SANDBOX" "$KPI_DEFS"'
    win($t; 7) as $w7 | win($t; 28) as $w28
    | [($w7 | keys_unsorted[] | {key: ., value: {"7d": $w7[.], "28d": $w28[.], now: false}}),
       ((($commskeys | split(" ")) + ([$cm, $lim | keys[] | select(startswith("runner_score_")) | sub("_(min|max)$"; "")] | unique))[]
        | {key: ., value: {"7d": ((($cm[.] // {})["7d"] | numbers) // null),
                           "28d": ((($cm[.] // {})["28d"] | numbers) // null), now: false}}),
       ($nowkeys | split(" ")[] | {key: ., value: {"7d": (($pit[.] | numbers) // null), "28d": null, now: true}})]
    | map(.key as $k | .value |= (
        (($lim[$k + "_max"] | numbers) // null) as $max | (($lim[$k + "_min"] | numbers) // null) as $min
        | . + {threshold: ($max // $min),
               bound: (if $max != null then "max" elif $min != null then "min" else null end)}
        | . + {status: (if .threshold == null or .["7d"] == null then "-"
                        elif (.bound == "max" and .["7d"] > .threshold)
                          or (.bound == "min" and .["7d"] < .threshold) then "past"
                        else "ok" end)}))
    | from_entries'
}

# kpi_trend <now> <days> -> one object a day, oldest first: {date, <kpi>: its 7d value as of that
# day's end}. The outcome rows are the history, so a trend needs no store of its own.
kpi_trend() {
  jq -nc --argjson t "$1" --argjson n "$2" --slurpfile o <(outcomes_newest) --slurpfile c <(ci_claimed) --slurpfile k "$(kpi_canary)" --slurpfile tk <(kpi_tokens) "$KPI_DEFS"'
    range($n - 1; -1; -1) as $i | ($t - $i * 86400) as $at
    | {date: ($at | strflocaltime("%Y-%m-%d"))} + win($at; 7)'
}

# kv_json -> key=value lines on stdin as one object; a value that is not a number is null
kv_json() { jq -Rn '[inputs | select(length > 0) | split("=") | {key: .[0], value: (.[1] | tonumber? // null)}] | from_entries'; }

# kpi_table <kpi json> -> the markdown table kpi prints and the scorecard carries
kpi_table() {
  jq -r '"| KPI | 7d | 28d | threshold | status |", "|---|---|---|---|---|",
    (to_entries[] | .value as $v
     | "| \(.key)\(if $v.now then " (now)" else "" end) | \($v["7d"] // "-") | \($v["28d"] // "-") | \(if $v.bound then "\($v.bound) \($v.threshold)" else "-" end) | \($v.status) |")' <<<"$1"
}

# vitals_json <kpi json> -> the BENCH_VITALS rows in their order, each with the question it answers. A key
# kpi_json does not carry stays as a row with no value: a dropped row reads as a healthy one.
vitals_json() {
  jq -c --arg v "$BENCH_VITALS" "$VITALS_JQ"'. as $k | [vitals($v)[] | {"7d": null, "28d": null, threshold: null, bound: null, status: "-", now: false} + ($k[.kpi] // {}) + .]' <<<"$1"
}

# vitals_table <kpi json> -> the front page: the scorecard's first table and `kpi --vitals`
vitals_table() {
  vitals_json "$1" | jq -r '"| Question | KPI | 7d | 28d | threshold | status |", "|---|---|---|---|---|---|",
    (.[] | "| \(.question) | \(.kpi)\(if .now then " (now)" else "" end) | \(.["7d"] // "-") | \(.["28d"] // "-") | \(if .bound then "\(.bound) \(.threshold)" else "-" end) | \(.status) |")'
}

# wakes_lines -> the calls-per-wake lines under the KPI table, from `agent-usage wakes` over the
# scorecard window. Each API call re-reads the session's whole context, so calls per wake is the cost.
# A background-task wake whose run passed has nothing left to decide: its target is WAKE_CALLS_TARGET.
# queue_stats <now>: agent-queue's own stats over the last BENCH_QUEUE_DAYS days, or a failure
# when it cannot be read. agent-queue owns the store and the formulas; this only reads them.
queue_stats() {
  local since
  since=$(date -d "@$(( $1 - BENCH_QUEUE_DAYS * 86400 ))" +%F)
  $BENCH_QUEUE_STATS_CMD --since "$since" 2>/dev/null | jq -ce 'select(.done and .by_project)' 2>/dev/null
}

# queue_line < stats: the window in one line (the briefing prints it as is)
queue_line() {
  jq -r --argjson days "$BENCH_QUEUE_DAYS" '
    def m($v): if $v == null then "-" elif $v >= 120 then "\($v / 60 | floor)h" else "\($v)m" end;
    ([.done[]] | add // 0) as $n
    | "queue \($days)d: \($n) done (\(.done.ok // 0) ok, \(.done.failed // 0) failed, \(.done.cancelled // 0) cancelled), "
      + "\([.by_project[].prs] | add // 0) with a PR, \($n / $days * 10 | round / 10)/day, "
      + "wait median \(m(.wait_minutes_median)) p90 \(m(.wait_minutes_p90)) (\(.started_at_once // 0) started at once), "
      + "to PR median \(m(.to_pr_minutes_median))"
      + (.sitting | if . == null then "" else "; sitting: \(.runnable) can start, oldest \(m(.oldest_runnable[0].minutes)), \(.held) held" end)'
}

cmd_queue() {
  local s
  case "${1:-}" in ""|--json) ;; *) say "usage: fleet-bench queue [--json]"; return 2 ;; esac
  s=$(queue_stats "$(now)") || { say "agent-queue stats unreadable"; return 1; }
  if [ "${1:-}" = --json ]; then printf '%s\n' "$s"; else queue_line <<<"$s"; fi
}

# Items in, with $sessions (the state document's rows), $etas (a cell per target) and $since:
# the requests. An item finds its live session row by the Claude session ids its `sessions:`
# lists (the ledger join), never by window name: the newest such row when it has several.
# A request is an urgent item from the human or the shepherd; `<prefix>-pN` items
# linked by after: are one request, and n of m reads their phase numbers, so a plan queued from
# phase 3 says 3 of 6. The shepherd's own intake leads, each group in queue order: sorted by source
# alone a morning of human-queued items would bury the ask, and newest first would let the next ask
# bury it (ci-cleanup fell to third within the hour).
REQUESTS_JQ='
def prefix: sub("-p[0-9]+$"; "");
def pnum: (capture("-p(?<n>[0-9]+)$").n | tonumber) // null;
def asked: .priority == "urgent" and (.from == "human" or .from == "shepherd");
def live: .state != "done";
def open: any(.[]; live and asked);
def afters: .after // "" | split(" ") | map(select(. != ""));
def keyed: . as $all | map(. as $i | ($i.slug | prefix) as $p
  | . + {key: (if any($all[]; . as $o | (($i | afters | index([$o.slug])) != null or ($o | afters | index([$i.slug])) != null)
                 and ($o.slug | prefix) == $p)
               then $p else $i.slug end)});
def session_row($c): ($c.sessions // "" | split(" ") | map(select(. != ""))) as $ids
  | [$sessions[0][] | select(.session_id as $s | $ids | index($s))] | last;
def active_row: sort_by(.slug | pnum // 0) as $c
  | ($c | map(select(live)) | sort_by(.state == "queued") | first) as $cur
  | session_row($cur) as $s
  | ([$c[].slug | pnum] + [$c[] | (.phases // "") | split(" ")[] | tonumber?] | max) as $m
  | {request: $c[0].key, slugs: ($c | map(.slug)), project: $cur.project, from: $cur.from,
     queued: $cur.queued, slug: $cur.slug, n: ($cur.slug | pnum), m: $m, state: $cur.state,
     session: $cur.session, bucket: $s.bucket,
     pr: (if $s.pr_state == "OPEN" then $s.pr else null end), ci: (if $s.pr_state == "OPEN" then $s.ci else null end),
     eta: (if $s == null then null else $etas[0][$s.target] end),
     waits: (if $cur.state == "queued" then $cur.hold // "a dispatch slot"
             elif $s != null and $s.bucket != "WORKING" then $s.reason | sub("^waiting on "; "") else null end),
     report: ([$c[].report // empty] | last)};
def finished_row: sort_by(.finished) as $c
  | {request: $c[0].key, slugs: ($c | map(.slug)), project: $c[0].project, from: $c[0].from,
     finished: $c[-1].finished,
     outcome: (($c | map(.status // "unknown" | select(. != "ok")) | first) // "ok"),
     prs: ($c | map(.pr // empty)), report: ([$c[].report // empty] | last)};
group_by(.slug) | map(sort_by(live, .finished) | last) | keyed | group_by(.key)
| {since: $since,
   active: (map(select(open) | active_row)
            | sort_by(.from != "shepherd", .queued)),
   finished: (map(select(open | not) | map(select(.state == "done" and asked
                and (.finished // "1970-01-01T00:00:00Z" | fromdateiso8601) >= $since))
                | select(length > 0) | finished_row) | sort_by(.finished) | reverse)}
'

# The rows as the block that heads a summary. Every fact it cannot read stays out of its row.
REQUESTS_TEXT_JQ='
def cell($label; $v): if $v == null then empty else "\($label)\($v)" end;
"## Your requests", "",
(if (.active | length) == 0 then "No urgent request is active."
 else .active[] | "- " + ([.request,
     (if .n == null then empty else "\(.n) of \(.m)" end),
     (.state + (if .bucket == null then "" else "/\(.bucket)" end)),
     cell(""; .session),
     (if .pr == null then "no open PR" else "PR #\(.pr) CI \(.ci // "not read")" end),
     (if .eta == null then "no ETA" else "ETA \(.eta)" end),
     cell("waits on: "; .waits), cell("report: "; .report)] | join(", ")) end),
"", "Finished since \(.since | hm):",
(if (.finished | length) == 0 then "- nothing"
 else .finished[] | "- " + ([.request, .outcome,
     (if (.prs | length) == 0 then "no PR" else (.prs | map("#\(.)") | join(" ")) end),
     (.finished | fromdateiso8601 | hm), cell("report: "; .report)] | join(", ")) end)
'

# cmd_requests [--json] [--since T]: the human's requests, from the queue, the fleet state document
# and the ETAs. T defaults to the last rundown, so a finished request is told once.
cmd_requests() {
  local json=0 since='' t items first done_items sessions='[]' etas last out
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --since) since=$(throughput_epoch "${2:-}") || return 2; shift 2 ;;
      *) say "usage: fleet-bench requests [--json] [--since T]"; return 2 ;;
    esac
  done
  t=$(now)
  if [ -z "$since" ]; then
    last=$(ls -t "$RUNDOWNS"/*.md 2>/dev/null | head -1)
    if [ -n "$last" ]; then since=$(stat -c %Y "$last"); else since=$((t - BENCH_WINDOW_H * 3600)); fi
  fi
  items=$($BENCH_ITEMS_CMD) || { say "the agent queue is unreadable"; return 1; }
  # Done items go back to the oldest live chain as well as to T: an earlier phase holds its report.
  first=$(jq -rs --argjson s "$since" '[$s] + [.[] | select(.priority == "urgent" and .after != null) | .queued | fromdateiso8601] | min' <<<"$items")
  done_items=$($BENCH_DONE_ITEMS_CMD --since "$(date -d "@$first" +%F)") || { say "the agent queue's done items are unreadable"; return 1; }
  [ -r "$STATE_FILE" ] && sessions=$(jq -c '.sessions // []' "$STATE_FILE")
  etas=$(latest_live | jq -cs "$JQ_LIB"'map(select(.eta != null or .finished)
    | {key: .target, value: (if .finished then "finished" else eta_cell end)}) | from_entries')
  out=$(printf '%s\n%s\n' "$items" "$done_items" | jq -cs --argjson since "$since" \
    --slurpfile sessions <(printf '%s\n' "$sessions") --slurpfile etas <(printf '%s\n' "$etas") "$REQUESTS_JQ") || return 1
  if [ "$json" = 1 ]; then printf '%s\n' "$out"; else jq -r "$JQ_LIB$REQUESTS_TEXT_JQ" <<<"$out"; fi
}

# queue_section <now>: the queue line, what is active now, and the outcomes by project and by
# source (human, shepherd, board, ...), in the scorecard
queue_section() {
  local s
  echo "## Queue"
  echo
  s=$(queue_stats "$1") || { echo "- queue ${BENCH_QUEUE_DAYS}d: ? (\`agent-queue stats\` unreadable)"; return 0; }
  echo "Items agent-queue finished in the last ${BENCH_QUEUE_DAYS} days, from its own timestamps (\`agent-queue stats\`). Wait is queued to started; to PR is queued to finished, for items that recorded a PR."
  echo
  jq -r 'def l: to_entries | map("\(.key) \(.value)") | join(", ") | if . == "" then "none" else . end;
    "- active now: \(.active | l)", "- per day: \(.per_day | l)"' <<<"$s"
  queue_line <<<"$s" | sed 's/^/- /'
  local by
  for by in project source; do
    echo
    echo "| ${by^} | Done | OK | Failed | Cancelled | PRs | Wait median | To PR median |"
    echo "|---|---|---|---|---|---|---|---|"
    jq -r --arg k "by_$by" 'def m($v): if $v == null then "-" else "\($v)m" end;
      .[$k] | to_entries | sort_by(-.value.done, .key)[] | .key as $n | .value
      | "| \($n) | \(.done) | \(.ok) | \(.failed) | \(.cancelled) | \(.prs) | \(m(.wait_minutes_median)) | \(m(.to_pr_minutes_median)) |"' <<<"$s"
  done
}

# models_json <now> [by]: per model and harness (the item's agent, claude when unset), the queue items
# finished in the last BENCH_QUEUE_DAYS days (the model= fleet-dispatch stamped at start) joined to
# their sessions' outcomes (cost_usd, reverts), and model-lane's runs in the same days by the model
# and harness they ran on (redo). Landed is done ok with a PR; a cancel counts against no pairing.
# An item started before fleet-dispatch stamped model= takes the model its sessions spent most on
# (cost_by_model), or with no cost the one their rows name most (models), as the alias an item names
# (claude-opus-5-5 is opus); unrecorded is an item none of whose sessions has an outcomes row.
# An item's gateway_cost_usd beats its sessions' sum: one is metered dollars, the other a list-price
# estimate. A session counts once per row, however many items of a chain it ran. source says which
# a row's cost is, and mixed means it holds both. cost_per_pr divides by priced, the landed items with a known cost: a landed item with none would pass as free and pull
# the row under pairings that are fully priced. ci_prs are the landed items' PRs (prkeys) that
# have a pr-ci row: ci_red_per_pr is its red CI runs per PR, first_pass_share the
# share of those that ran a gate with no red gate run (the KPI of that name). points are the
# window points (source_attr) of the landed items' sessions, per pointed item: one with a known share.
# An item whose end_reason is unrated (UNRATED_ENDS: the run ended for a cause outside the
# model) is counted in unrated, and left out of landed_rate and failed. A run model-lane voided
# (voids.jsonl, `model-lane void`) is left out of runs, rated and redo; it still names its item's lane.
# by is a comma list of class and lane. lane is the model-lane lane the item's run logged under (the
# run its lane_run= names; unrouted when it has none), so a lane's trial candidate is scored on its
# own lane's landings; with lane alone, redo counts the runs of that lane. This is the evidence a
# lane graduates or demotes on.
models_json() {
  local since by="${2:-}"; since=$(( $1 - BENCH_QUEUE_DAYS * 86400 ))
  jq -cn --arg by "$by" --argjson days "$BENCH_QUEUE_DAYS" --argjson since "$since" \
     --slurpfile items <($BENCH_DONE_ITEMS_CMD --since "$(date -d "@$since" +%F)" 2>/dev/null) \
     --slurpfile outcomes <(outcomes_latest) \
     --slurpfile runs <(jq -c 'select(.id and .ts)' "$BENCH_LANE_LOG" 2>/dev/null) \
     --slurpfile voids <([ ! -s "$BENCH_LANE_VOIDS" ] || jq -cR 'fromjson? | select(.id)' "$BENCH_LANE_VOIDS" 2>/dev/null) \
     --slurpfile ci <([ ! -s "$CI" ] || jq -c 'select(.repo and .number)' "$CI" 2>/dev/null) \
     --slurpfile sa <(source_attr "$1" | jq -c '.sessions') "$JQ_LIB"'
    def ratio($a; $b): if $b > 0 then ($a / $b * 100 | round / 100) else null end;
    ($by | split(",")) as $bys | ($bys | index("class") != null) as $cl | ($bys | index("lane") != null) as $ln
    | ($runs | INDEX(.id)) as $rix | ($voids | INDEX(.id)) as $vix
    | ($ci | INDEX(itemkey)) as $cix | ($sa[0] // {}) as $sp |
    def sids: (.sessions // "") | split(" ") | map(select(. != ""));
    def landed: .status == "ok" and (.pr // "") != "";
    def metered: (.gateway_cost_usd // "") != "";
    def alias: capture("^claude-(?<f>[a-z]+)-").f // .;
    ($outcomes[0] // {}) as $o
    | def cls: ([sids[] | $o[.].class // empty] | first) as $c
        | if $c then "\($c.kind // "untyped")/\($c.size // "-")" else "unclassed" end;
      def spent_most: [sids[] | $o[.] // empty] as $rows
        | ([$rows[] | .cost_by_model // {} | to_entries[] | select(.value > 0 and (.key | startswith("<") | not))]
            | group_by(.key) | map({key: .[0].key, usd: (map(.value) | add)}) | max_by(.usd) | .key)
          // ([$rows[] | .models // [] | .[] | select(startswith("<") | not)] | group_by(.) | max_by(length) | .[0]);
      ($items | map(select(.status != "cancelled")
        | . + {m: (((.model // spent_most) | if . then alias else . end) // "unrecorded"), h: (.agent // "claude"),
               c: (if $cl then cls else null end), l: (if $ln then $rix[.lane_run // ""].lane // "unrouted" else null end)})) as $done
    | ($runs | map(select(($vix[.id] | not) and (.ts | sub("\\+00:00$"; "Z") | fromdateiso8601) >= $since)
        | . + {h: (.harness // "claude"), ran: (.ran | if . then alias else . end), lane: (.lane // "unrouted")})) as $rs
    | ([$done[] | {m, h, c, l}] + (if $cl then [] else [$rs[] | {m: .ran, h, c: null, l: (if $ln then .lane else null end)}] end) | unique_by([.m, .h, .c, .l])) as $pairs
    | {days: $days, models: ($pairs | map(. as {m: $m, h: $h, c: $c, l: $l}
        | ($done | map(select(.m == $m and .h == $h and .c == $c and .l == $l))) as $it
        | ($it | map(select(landed)) | length) as $landed
        | ($it | map(sids[]) | unique | map($o[.] // empty)) as $sess
        | ($it | map({landed: landed, source: (if metered then "gateway" elif any(sids[]; $o[.].cost_usd != null) then "list" else null end)})) as $priced_items
        | ($rs | map(select(($cl | not) and .ran == $m and .h == $h and (($ln | not) or .lane == $l)))) as $r
        | ($r | map(select(.outcome)) | length) as $rated
        | ($r | map(select(.outcome == "redo")) | length) as $redo
        | (($it | map(select(metered) | .gateway_cost_usd | tonumber) | add // 0)
           + ($it | map(select(metered | not) | sids[]) | unique | map($o[.].cost_usd // 0) | add // 0)) as $cost
        | ($priced_items | map(.source // empty) | unique) as $src
        | ($priced_items | map(select(.landed and .source)) | length) as $priced
        | ($it | map(select(landed))) as $li
        | [$li | map(prkeys[]) | unique[] | $cix[.] // empty] as $cr
        | ($li | map(sids[]) | unique | map($sp[.].points // empty)) as $pt
        | ($li | map(select(any(sids[]; $sp[.].points != null))) | length) as $pointed
        | ($it | map(select(unrated)) | length) as $unrated
        | {model: $m, harness: $h, done: ($it | length), landed: $landed, landed_rate: ratio($landed; ($it | length) - $unrated),
           failed: ($it | map(select(.status == "failed" and (unrated | not))) | length), unrated: $unrated,
           runs: ($r | length), rated: $rated, redo: $redo, redo_rate: ratio($redo; $rated),
           reverts: ($sess | map(.reverted_7d // 0) | add // 0),
           cost_usd: ($cost * 100 | round / 100), priced: $priced, cost_per_pr: (if $priced > 0 then ($cost / $priced * 100 | round / 100) else null end),
           source: (if ($src | length) > 1 then "mixed" else ($src[0] // "-") end),
           ci_prs: ($cr | length), ci_red_per_pr: ratio($cr | map(.ci_red // 0) | add // 0; $cr | length),
           first_pass_share: ($cr | map(select(ran_gate)) as $ran | ratio($ran | map(select(first_try)) | length; $ran | length)),
           points: (if $pointed > 0 then ($pt | add | round2) else null end),
           points_per_pr: (if $pointed > 0 then ($pt | add / $pointed | round2) else null end)}
          + (if $cl then {class: $c, runs: null, rated: null, redo: null, redo_rate: null} else {} end)
          + (if $ln then {lane: $l} else {} end)))}'
}

# models_section <now> [by]: the models table, in the scorecard; by (a comma list) splits each pairing
# by class, the task class stamped on its sessions' outcome rows (kind/size, from the item's roadmap
# row), and by lane, the model-lane lane its run logged under
models_section() {
  local j by="${2:-}" cols="" lead=""
  echo "## Models"
  echo
  echo "Queue items finished in the last ${BENCH_QUEUE_DAYS} days by the model and harness they started on, joined to their sessions' outcomes; redo is model-lane's runs on that pairing that were put back in the queue (\`model-lane report\`), less the runs \`model-lane void\` voided. Landed is done ok with a PR. Source says what a cost is: list is an estimate at list price, not money paid; gateway is dollars metered at the LiteLLM gateway; mixed holds both. Per PR counts only PRs with a known cost. CI red is red CI runs per landed PR with a \`pr-ci\` row, first pass the share of those green first time. Points are percent points of the pairing's sources' weekly windows its landed items' sessions used (\`fleet-bench sources\`), per PR with a known share. Counts, not a winner: pairings ran different tasks."
  echo
  j=$(models_json "$1" "$by") || { echo "- models: ? (queue or outcomes unreadable)"; return 0; }
  case ",$by," in *,class,*)
    echo "Class is kind/size of the item's roadmap row, stamped on its sessions' outcome rows by \`agentctl-session-outcomes\`; unclassed is an item none of whose sessions carries one (a row written before the stamp, or no row). Redo is model-lane's and has no class, so it is left out."
    echo
    cols="Class | "; lead='\(.class) | ' ;;
  esac
  case ",$by," in *,lane,*)
    echo "Lane is the model-lane lane the item's run logged under (the run its \`lane_run=\` names); unrouted is an item that started with none."
    echo
    cols="${cols}Lane | "; lead="${lead}"'\(.lane) | ' ;;
  esac
  echo "An item that ended for a cause outside the model (\`end_reason\` ${UNRATED_ENDS// /, }: a quota end, a provider failure, a kill) counts in Done but not in Rate or Failed; \`models --json\` has it as \`unrated\`."
  echo
  local redo_h="Redo | " redo_c='\(.redo) | ' hdr
  case ",$by," in *,class,*) redo_h="" redo_c="" ;; esac
  hdr="${cols}Model | Harness | Done | Landed | Rate | Failed | ${redo_h}Reverts | Cost | Per PR | Source | CI red | First pass | Points | Points per PR"
  echo "| $hdr |"
  echo "|$(sed 's/[^|][^|]*/---/g' <<<"$hdr")|"
  jq -r 'def d: if . == null then "-" else tostring end;
    .models | sort_by(.class, .lane, -.done)[]
    | "| '"$lead"'\(.model) | \(.harness) | \(.done) | \(.landed) | \(.landed_rate | d) | \(.failed) | '"$redo_c"'\(.reverts) | $\(.cost_usd) | \(if .cost_per_pr == null then "-" else "$\(.cost_per_pr)" end) | \(.source) | \(.ci_red_per_pr | d) | \(.first_pass_share | d) | \(.points | d) | \(.points_per_pr | d) |"' <<<"$j"
}

cmd_models() {
  local j by="" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --by) case "${2:-}" in
              class | lane) by=$2 ;;
              class,lane | lane,class) by=class,lane ;;
              *) say "models: --by takes class, lane or class,lane"; return 2 ;;
            esac; shift 2 ;;
      *) say "usage: fleet-bench models [--by class,lane] [--json]"; return 2 ;;
    esac
  done
  j=$(models_json "$(now)" "$by") || { say "the queue or the outcomes are unreadable"; return 1; }
  if [ "$json" = 1 ]; then printf '%s\n' "$j"; else models_section "$(now)" "$by" | sed '1,4d'; fi
}

# source_attr <now> -> every claude-acct source over the last BENCH_QUEUE_DAYS, and which source each
# session and landed item spent from. Points are percent points of a source's own window: the sum of
# every 15-minute rise in its published used percent (a reset is a fall, so it adds nothing, and the
# step it falls in loses what was spent after it). A pool's points hold its keys' spend, so its landed
# counts its keys' items too. A session
# is on its harness's harnesses.json `source`, or for claude on its account (the outcome row's config
# dir); an item on its agent's source, its `account:`, else its sessions'. A session's share of its
# source's points is its share of the tokens all of that source's sessions in the window used: an
# estimate, and the only per-session measure every harness records; tokens_total is the session's
# whole life, so one that began before the window is over-weighted. Dollars: a Claude account's are
# Claude Code's list-price cost counter by login email (null with no email), a dollar-capped source's are its points of
# its budget (metered at the gateway), and Codex has none. Each part that cannot be read is null.
source_attr() {
  local t="$1" days="$BENCH_QUEUE_DAYS" since rows pts usd hs
  [ -z "${SOURCE_ATTR_JSON:-}" ] || { printf '%s\n' "$SOURCE_ATTR_JSON"; return 0; }   # the scorecard reads it once
  since=$(( t - days * 86400 ))
  rows=$($BENCH_SOURCES_CMD 2>/dev/null | jq -ce 'arrays' 2>/dev/null) || rows=null
  pts=$(prom_map account "sum by (account) (sum_over_time((clamp_min(max by (account) (claude_account_week_used_percent) - max by (account) (claude_account_week_used_percent offset 15m), 0))[${days}d:15m]))" "$t" 2>/dev/null) || pts=null
  usd=$(prom_map user_email "sum by (user_email) (increase(claude_code_cost_usage_USD_total[${days}d]))" "$t" 2>/dev/null) || usd=null
  hs=$(jq -ce '.harnesses // {} | map_values(.source)' "$BENCH_HARNESSES" 2>/dev/null) || hs='{}'
  jq -cn --argjson rows "${rows:-null}" --argjson pts "${pts:-null}" --argjson usd "${usd:-null}" --argjson hs "$hs" \
     --argjson since "$since" --argjson t "$t" --argjson days "$days" \
     --slurpfile o <(outcomes_newest) \
     --slurpfile items <($BENCH_DONE_ITEMS_CMD --since "$(date -d "@$since" +%F)" 2>/dev/null) "$JQ_LIB"'
    def dirkey: if (.dir // "") == "" then "claude" else .dir | sub("/+$"; "") | split("/") | last | ltrimstr(".") end;
    ($rows // []) as $R
    | ([$R[] | select(.kind == "claude") | {key: dirkey, value: .name}, {key: .name, value: .name}] | from_entries) as $acct
    | def acct: $acct[(. // "") | ltrimstr(".")];
      def on: (.harness // "claude") as $h | if $h == "claude" then .account | acct else $hs[$h] end;
      ($o | INDEX(.session_id)) as $os
    | ($o | map(select((.updated_epoch // 0) > $since and .updated_epoch <= $t)
              | {sid: .session_id, src: on, w: (.tokens_total // 0)} | select(.src))) as $ws
    | ($ws | group_by(.src) | map({key: .[0].src, value: (map(.w) | add)}) | from_entries) as $wsum
    | ($ws | map({key: .sid, value: {source: .src,
        points: (if $pts[.src] == null or ($wsum[.src] // 0) == 0 then null else $pts[.src] * .w / $wsum[.src] end)}}) | from_entries) as $sess
    | def item_src: (.agent // "claude") as $h
        | if $h != "claude" then $hs[$h]
          else (.account | acct) // ([(.sessions // "") | split(" ")[] | select(. != "") | $os[.] // empty | on // empty] | first) end;
      [$items[] | select(.status == "ok" and (.pr // "") != "") | item_src] as $landed
    | ($R | map({key: .name, value: .parent}) | from_entries) as $parent
    | {days: $days, read: {sources: ($rows != null), points: ($pts != null), usd: ($usd != null)}, sessions: $sess,
       unattributed: ($landed | map(select(. == null)) | length),
       sources: [$R[] | .name as $n | ($pts[$n] | if . == null then . else round2 end) as $p
         | (if .usd_max != null then (if $p == null then null else $p * .usd_max / 100 end)
            elif .kind == "claude" then (if $usd == null or (.email // "") == "" then null else $usd[.email] // 0 end)
            else null end) as $d
         | ([$landed[] | select(. == $n or $parent[. // ""] == $n)] | length) as $l
         | {name: $n, kind, parent, used: .week_used, points: $p,
            usd: ($d | if . == null then . else round2 end),
            usd_src: (if .usd_max != null then "gateway" elif .kind == "claude" then "list" else null end),
            landed: $l,
            usd_per_point: (if $d == null or ($p // 0) <= 0 then null else ($d / $p | round2) end),
            prs_per_point: (if ($p // 0) <= 0 then null else ratio($l; $p) end),
            points_per_pr: (if $p == null or $l == 0 then null else ($p / $l | round2) end)}]}'
}

# sources_json <now> -> source_attr without the per-session map; rc 1 when the sources are unreadable
sources_json() {
  source_attr "$1" | jq -ce 'select(.read.sources) | del(.sessions)'
}

# sources_section <now>: the sources table, in the scorecard
sources_section() {
  local j
  echo "## Sources"
  echo
  echo "Every model source \`claude-acct\` lists, over the last ${BENCH_QUEUE_DAYS} days. Points are percent points of the source's own window used (the sum of its rises), so a plan and a budget compare in one unit; a key spends inside its parent pool, so the pool's points hold its keys'. Dollars: list is Claude Code's list price (no money paid on a plan), gateway is metered spend. Landed is queue items done ok with a PR, by the source they ran on. Dollars and PRs per point say what a point of each source buys: the number a purchase is decided on."
  echo
  j=$(sources_json "$1") || { echo "- sources: ? (claude-acct status unreadable)"; return 0; }
  sources_table "$j"
}

# sources_table <sources json>: the table sources prints and the scorecard carries
sources_table() {
  jq -r 'def d: if . == null then "-" else tostring end;
    (if .read.points then empty else "- points: ? (Prometheus unreadable)", "" end),
    "| Source | Kind | Used now | Points | Dollars | Landed | $ per point | PRs per point | Points per PR | Parent |",
    "|---|---|---|---|---|---|---|---|---|---|",
    (.sources[] | "| \(.name) | \(.kind) | \(.used | if . == null then "-" else "\(. | floor)%" end) | \(.points | d) | \(if .usd == null then "-" else "$\(.usd) \(.usd_src)" end) | \(.landed) | \(if .usd_per_point == null then "-" else "$\(.usd_per_point)" end) | \(.prs_per_point | d) | \(.points_per_pr | d) | \(.parent // "-") |"),
    (if .unattributed > 0 then "", "- landed on no source: \(.unattributed) (a harness with no harnesses.json source, or no account recorded)" else empty end)' <<<"$1"
}

cmd_sources() {
  local j json=0
  case "${1:-}" in
    '') ;;
    --json) json=1 ;;
    *) say "usage: fleet-bench sources [--json]"; return 2 ;;
  esac
  j=$(sources_json "$(now)") || { say "the sources are unreadable (claude-acct status)"; return 1; }
  if [ "$json" = 1 ]; then printf '%s\n' "$j"; else sources_table "$j"; fi
}

# sizes_json <now> -> the size calibration and per-kind cycle time over BENCH_SIZES_DAYS: each
# done item (cancelled left out) joined through its `row:` to that row on its project's roadmap,
# which gives the size, the weight and the kind (the item's own `type:` when no row is found).
# A size is calibrated at BENCH_SIZES_MIN or more items with work_min; its measured weight is its
# median work over the median of the calibrated weight-1 size with the most items. Percentiles
# are nearest rank.
sizes_json() {
  local since rows projects p items
  since=$(( $1 - BENCH_SIZES_DAYS * 86400 ))
  items=$($BENCH_DONE_ITEMS_CMD --since "$(date -d "@$since" +%F)" 2>/dev/null | jq -cs .) || return 1
  projects=$(jq -r '.[].row // empty | select(test(":")) | split(":")[0]' <<<"$items" | sort -u)
  # the roadmaps go in as a file: a big project's is past the length of one argument
  rows=$(for p in $projects; do
      $BENCH_ROADMAP_CMD "$p" --json 2>/dev/null | jq -c --arg p "$p" 'arrays | .[].rows[]? | {key: "\($p):\(.id)", value: {size, weight, kind}}'
    done | jq -cs 'from_entries')
  jq -cn --argjson days "$BENCH_SIZES_DAYS" --argjson min "$BENCH_SIZES_MIN" --argjson since "$since" \
     --slurpfile items <(printf '%s\n' "$items") --slurpfile rows <(printf '%s\n' "$rows") '
    def pct($p): sort | if length == 0 then null else .[((length * $p) | ceil) - 1] end;
    def epoch: if . == null or . == "" then null else (sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601) end;
    def hours: if . == null then null else (. / 3600 * 10 | round / 10) end;
    $rows[0] as $R
    | [$items[0][] | select(.status != "cancelled" and ((.finished | epoch) // 0) >= $since)
       | ($R[.row // ""]) as $r
       | {size: ($r.size // ""), weight: $r.weight, kind: ($r.kind // .type // "untyped" | if . == "" then "untyped" else . end),
          landed: (.status == "ok" and (.pr // "") != ""),
          work: (.work_min // "" | tonumber? // null),
          cycle: (if (.started | epoch) and (.finished | epoch) then (.finished | epoch) - (.started | epoch) else null end),
          lead: (if (.queued | epoch) and (.finished | epoch) then (.finished | epoch) - (.queued | epoch) else null end)}] as $all
    | ($all | map(select(.work != null))) as $timed
    | ($timed | map(select(.size != "")) | group_by(.size)
       | map({size: .[0].size, weight: .[0].weight, n: length, calibrated: (length >= $min),
              work_p50: (map(.work) | pct(0.5)), work_p75: (map(.work) | pct(0.75))})) as $sz
    | ($sz | map(select(.calibrated and .weight == 1)) | sort_by(-.n) | first) as $base
    | {days: $days, min_n: $min, base: ($base.size // null),
       sizes: ($sz | sort_by(.weight, .size) | map(. + {
         per_point: (if .calibrated then (.work_p50 / .weight * 10 | round / 10) else null end),
         measured_weight: (if .calibrated and $base != null and $base.work_p50 > 0 then (.work_p50 / $base.work_p50 * 10 | round / 10) else null end)})),
       unsized: ($timed | map(select(.size == "")) | length),
       kinds: ($all | group_by(.kind) | map({kind: .[0].kind, done: length, landed: (map(select(.landed)) | length),
         work_p50: (map(.work // empty) | pct(0.5)),
         cycle_p50_h: (map(.cycle // empty) | pct(0.5) | hours), cycle_p90_h: (map(.cycle // empty) | pct(0.9) | hours),
         lead_p50_h: (map(.lead // empty) | pct(0.5) | hours)}) | sort_by(-.done, .kind))}'
}

# sizes_section <now>: the size calibration and the per-kind cycle time, in the scorecard
sizes_section() {
  local j
  echo "## Sizes and kinds"
  echo
  echo "Queue items finished in the last ${BENCH_SIZES_DAYS} days, joined through their \`row:\` to the row's size and kind on its roadmap. Work is the items' work_min (minutes a session was working). A size is calibrated at ${BENCH_SIZES_MIN} or more items; its measured weight is its median work over the base size's, to set beside the weight the rollups use. Cycle is started to finished, lead is queued to finished."
  echo
  j=$(sizes_json "$1") || { echo "- sizes: ? (the done queue items are unreadable)"; return 0; }
  jq -r 'def d: if . == null then "-" else tostring end;
    "| Size | Weight | Items | Work p50 min | Work p75 min | Min per point | Measured weight |",
    "|---|---|---|---|---|---|---|",
    (.min_n as $m | .sizes[] | "| \(.size) | \(.weight) | \(.n) | " + (if .calibrated
       then "\(.work_p50) | \(.work_p75) | \(.per_point) | \(.measured_weight | d) |"
       else "- | - | - | too few (\(.n) of \($m)) |" end)),
    "",
    "- base size: \(.base // "none calibrated"); items with work_min and no sized row: \(.unsized)",
    "",
    "| Kind | Done | Landed | Work p50 min | Cycle p50 h | Cycle p90 h | Lead p50 h |",
    "|---|---|---|---|---|---|---|",
    (.kinds[] | "| \(.kind) | \(.done) | \(.landed) | \(.work_p50 | d) | \(.cycle_p50_h | d) | \(.cycle_p90_h | d) | \(.lead_p50_h | d) |")' <<<"$j"
}

cmd_sizes() {
  local j
  case "${1:-}" in ""|--json) ;; *) say "usage: fleet-bench sizes [--json]"; return 2 ;; esac
  j=$(sizes_json "$(now)") || { say "sizes: the done queue items are unreadable"; return 1; }
  if [ "${1:-}" = --json ]; then printf '%s\n' "$j"; else sizes_section "$(now)" | sed '1,4d'; fi
}

wakes_lines() {
  local w win="${BENCH_WINDOW_H}h"
  w=$($BENCH_WAKES_CMD --since "$win" --json 2>/dev/null) && jq -e .all <<<"$w" >/dev/null 2>&1 \
    || { echo "- calls per passing wake ($win): ? (\`agent-usage wakes\` unreadable)"; echo "- calls per wake, all ($win): ?"; return 0; }
  jq -r --argjson target "$WAKE_CALLS_TARGET" --arg win "$win" '
    (.rows | map(select(.trigger == "background-task" and .verdict == "pass")) | first) as $p
    | (if $p == null then "- calls per passing wake (\($win)): - (no passing background-task wake)"
       else "- calls per passing wake (\($win)): median \($p.median) over \($p.wakes) wakes, target \($target) or fewer: \(if $p.median > $target then "past" else "ok" end)" end),
      "- calls per wake, all (\($win)): " + (if .all.wakes == 0 then "-"
        else "median \(.all.median), p90 \(.all.p90) over \(.all.wakes) wakes" end)' <<<"$w"
}

# report_line <command> <label>: one scorecard row another tool writes (the nightly token-usage
# row, the newest stored week from day-log).
report_line() {
  local l
  l=$($1 2>/dev/null) && [ -n "$l" ] || l="$2: ? (\`$1\` unreadable)"
  echo "- $l"
}

# kpi_past <json>: one line per KPI in it past its threshold, and exit 1 when any is: what each
# --check prints.
kpi_past() {
  jq -re 'to_entries | map(select(.value.status == "past")
    | "\(.key) \(.value["7d"]) (\(.value.bound) \(.value.threshold))") | if length == 0 then empty else .[] end' <<<"$1" && return 1
  return 0
}

cmd_kpi() {
  local json=0 vitals=0 at='' trend='' check='' re='' t
  local usage="usage: fleet-bench kpi [--json] [--vitals | --at T | --trend DAYS | --check [ERE]]"
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      --vitals) vitals=1 ;;
      --at) at="${2:?--at needs a time}"; shift ;;
      --trend) trend="${2:?--trend needs a day count}"; shift ;;
      --check) check=1; if [ $# -gt 1 ] && [[ "$2" != --* ]]; then re=$2; shift; fi ;;
      *) say "$usage"; return 2 ;;
    esac
    shift
  done
  [ -z "$check" ] || [ -z "$at$trend" ] || { say "$usage"; return 2; }
  [ "$vitals" = 0 ] || [ -z "$at$trend$check" ] || { say "$usage"; return 2; }
  t=$(now)
  [ -z "$at" ] || t=$(throughput_epoch "$at") || { say "kpi: cannot read the time $at"; return 2; }
  if [ -n "$trend" ]; then
    [[ "$trend" =~ ^[1-9][0-9]*$ ]] || { say "kpi: --trend takes a day count"; return 2; }
    local rows; rows=$(kpi_trend "$t" "$trend") || return 1
    if [ "$json" = 1 ]; then printf '%s\n' "$rows"; return 0; fi
    jq -rs '(.[0] | keys_unsorted) as $k | ($k | join(" | ") | "| \(.) |"), ($k | map("---") | join("|") | "|\(.)|"),
      (.[] | [.[$k[]] | if . == null then "-" else tostring end] | join(" | ") | "| \(.) |")' <<<"$rows"
    return 0
  fi
  if [ -n "$at" ]; then t=$(kpi_json "$t" "" 1); else t=$(kpi_json "$t" "$(ledger_counts)"); fi || return 1
  if [ -n "$check" ]; then
    # A scope that names no KPI is a typo, not a pass: a watch on it would never trip.
    t=$(jq -c --arg re "$re" 'with_entries(select(.key | test($re)))' <<<"$t") || { say "kpi: --check takes an ERE"; return 2; }
    [ "$t" != "{}" ] || { say "kpi: no KPI matches $re"; return 2; }
    kpi_past "$t"
    return
  fi
  if [ "$vitals" = 1 ]; then
    if [ "$json" = 1 ]; then vitals_json "$t"; else vitals_table "$t"; fi
  elif [ "$json" = 1 ]; then jq -c . <<<"$t"; else kpi_table "$t"; fi
}

# chain [--json|--check] -- the KPI_CHAIN rows of the KPI table, counted now. --check prints one
# line per chain KPI past its threshold and exits 1 when any is: the board-chain watch's probe.
cmd_chain() {
  local t json
  case "${1:-}" in ""|--json|--check) ;; *) say "usage: fleet-bench chain [--json|--check]"; return 2 ;; esac
  t=$(now)
  json=$(kpi_json "$t" "$(chain_counts "$t")" | jq -c --arg k "$KPI_CHAIN" '($k | split(" ")) as $ks | with_entries(select(.key | IN($ks[])))') || return 1
  case "${1:-}" in
    --json) printf '%s\n' "$json" ;;
    --check) kpi_past "$json" ;;
    *) kpi_table "$json"; chain_notes "$t" "$json" ;;
  esac
}

# startup [--json|--check] -- Claude Code start times over the last startup_rolling_n (20) starts:
# the medians of ready, process (harness boot) and hook ms, each hook phase and each MCP server's
# spawn. The threshold and window are kpi-thresholds keys, the same startup_ready_ms_p50_max the KPI
# table uses. --check is the claude-startup watch's probe: exit 1 past the threshold, 2 when no
# SessionStart row (a resume counts) is newer than startup_stale_h (48) or the newest start has no
# ready time: a quiet or blind recorder trips too.
cmd_startup() {
  local lim='{}' json
  case "${1:-}" in ""|--json|--check) ;; *) say "usage: fleet-bench startup [--json|--check]"; return 2 ;; esac
  [ -r "$KPI_THRESHOLDS" ] && lim=$(grep -E '^[a-z0-9_]+=' "$KPI_THRESHOLDS" | kv_json)
  json=$(jq -nc --argjson t "$(now)" --argjson lim "$lim" --slurpfile r <(startup_rows) "$JQ_LIB$STARTUP_JQ"'
    def p50(f): map(f | numbers) | median | if . == null then null else round end;
    def p50by(s): [s] | group_by(.key) | map({key: .[0].key, value: p50(.value)}) | from_entries;
    ($lim.startup_rolling_n // 20) as $n | ($lim.startup_stale_h // 48) as $stale
    | ($r | starts | .[-$n:]) as $w | $lim.startup_ready_ms_p50_max as $max
    | ($w | p50(.ready_ms)) as $ready | ($r | last | .epoch) as $newest
    | {starts: ($w | length), newest_epoch: $newest, ready_ms_p50: $ready,
       process_ms_p50: ($w | p50(.process_ms)), hook_ms_p50: ($w | p50(.hook_ms)),
       phases_p50: p50by($w[] | .hooks[]? | .name as $h | .phases // {} | to_entries[] | {key: "\($h).\(.key)", value}),
       mcp_spawn_ms_p50: p50by($w[] | .mcp[]? | {key: .name, value: .spawn_ms}),
       threshold: $max, window: $n, stale_h: $stale,
       status: (if $newest == null or $newest < $t - $stale * 3600 then "stale"
                elif ([$r[] | select(.source == "startup")] | last | .ready_ms | type) != "number" then "blind"
                elif $max != null and $ready > $max then "past" else "ok" end)}') || return 1
  [ "${1:-}" = --json ] && { printf '%s\n' "$json"; return 0; }
  jq -r "$JQ_LIB"'
    def s: if . == null then "-" else "\(. / 1000 | round2)s" end;
    if .status == "stale" then
      if .newest_epoch == null then "startup: no Claude Code start recorded, is startup-telemetry.sh deployed?"
      else "startup: no Claude Code start recorded in \(.stale_h)h (newest \(.newest_epoch | todate))" end
    elif .status == "blind" then "startup: rows are written but the newest start has no ready time: is its claude process found?"
    else "startup: ready p50 \(.ready_ms_p50 | s) over the last \(.starts) starts"
         + (if .threshold == null then ", no startup_ready_ms_p50_max"
            elif .status == "past" then ", past startup_ready_ms_p50_max \(.threshold | s)"
            else " (max \(.threshold | s))" end)
         + ": process \(.process_ms_p50 | s), hooks \(.hook_ms_p50 | s)"
         + ([.phases_p50 | to_entries | sort_by(-.value) | .[:3][] | "\(.key) \(.value | s)"]
            | if length > 0 then " (" + join(", ") + ")" else "" end)
         + ([.mcp_spawn_ms_p50 | to_entries[] | "\(.key) \(.value | s)"]
            | if length > 0 then ", mcp spawn " + join(", ") else "" end)
    end' <<<"$json"
  [ "${1:-}" = --check ] || return 0
  case "$(jq -r .status <<<"$json")" in ok) return 0 ;; past) return 1 ;; *) return 2 ;; esac
}

# effect <T | owner/repo#N> [--days N] [--compare C] [--json] -- what changed after a change landed:
# each windowed KPI over the N days (BENCH_EFFECT_DAYS, 14) up to T against the N days after it. A
# PR is read as its merge time. Verdict per KPI: improved or regressed when it moved more than
# BENCH_EFFECT_FLAT (10%) the way better says, flat inside that, pending until the after window has
# ended, - when either side has no value. control is the same split at C, a time with no such
# change (default T - N days, the drift just before it), and net is the verdict unless control
# moved the same way, when it reads "as control": the KPI was moving anyway. A rework KPI reads
# each side lag days later (KPI_DEFS), so it is pending that much longer. Many changes land in any
# window, so even net is a lead to look at, never proof one change did it.
cmd_effect() {
  local ref='' days="$BENCH_EFFECT_DAYS" json=0 t info compare='' c
  local use="usage: fleet-bench effect <T | owner/repo#N> [--days N] [--compare C] [--json]"
  while [ $# -gt 0 ]; do
    case "$1" in
      --days) days="${2:?--days needs a count}"; shift ;;
      --compare) compare="${2:?--compare needs a time}"; shift ;;
      --json) json=1 ;;
      -*) say "$use"; return 2 ;;
      *) ref="$1" ;;
    esac
    shift
  done
  [ -n "$ref" ] || { say "$use"; return 2; }
  [[ "$days" =~ ^[1-9][0-9]*$ ]] || { say "effect: --days takes a day count"; return 2; }
  if [[ "$ref" == */*#* ]]; then
    info=$(gh pr view "${ref##*#}" -R "${ref%#*}" --json mergedAt -q '.mergedAt // ""' 2>/dev/null) ||
      { say "effect: gh cannot read $ref"; return 1; }
    [ -n "$info" ] || { say "effect: $ref is not merged"; return 1; }
    t=$(date -d "$info" +%s)
  elif [[ "$ref" =~ ^[0-9]{1,9}$ ]]; then
    say "effect: $ref reads as a PR number; give it as owner/repo#$ref"; return 2
  else
    t=$(throughput_epoch "$ref") || { say "effect: cannot read the time $ref"; return 2; }
  fi
  local cmp out
  cmp=$(throughput_epoch "${compare:-$((t - days * 86400))}") || { say "effect: cannot read the compare time ${compare:-T - $days days}"; return 2; }
  # a control split within N days of T would hold the change it is the control for
  [ $(( cmp > t ? cmp - t : t - cmp )) -ge $((days * 86400)) ] || { say "effect: --compare must be $days days or more from the change"; return 2; }
  out=$(jq -n --argjson t "$t" --argjson cmp "$cmp" --argjson d "$days" --argjson now "$(now)" --argjson flat "$BENCH_EFFECT_FLAT" \
        --arg ref "$ref" --slurpfile o <(outcomes_newest) --slurpfile c <(ci_claimed) --slurpfile k "$(kpi_canary)" --slurpfile tk <(kpi_tokens) "$KPI_DEFS"'
    bots as $bot
    # one change point: {x, b, a}, its time and the windows either side of it, each read once
    | def point($x): {x: $x, b: win($x; $d), a: win($x + $d * 86400; $d)};
    # a rework KPI reads its cohort lag days later, so it is pending that much longer
    def split($p; $k; $dir): (rework_kpi[$k].lag // 0) as $l | ($now >= $p.x + ($d + $l) * 86400) as $done
      | (if $l > 0 then [reworked($bot; $p.x + $l * 86400; $d; $k), reworked($bot; $p.x + ($d + $l) * 86400; $d; $k)]
         else [$p.b[$k], $p.a[$k]] end) as [$b, $a]
      | {before: $b, after: (if $done then $a else null end),
         verdict: (if ($done | not) then "pending" else move($b; $a; $dir; $flat) end)};
    point($t) as $pt | point($cmp) as $pc
    | {ref: $ref, at: ($t | todate), days: $d, compare: ($cmp | todate),
       kpis: [$pt.b | keys_unsorted[] as $k | better[$k] as $dir | split($pt; $k; $dir) as $x | split($pc; $k; $dir).verdict as $ctl
         | {kpi: $k, before: $x.before, after: $x.after, verdict: $x.verdict, control: $ctl,
            net: (if ($x.verdict | IN("improved", "regressed")) and $x.verdict == $ctl then "as control" else $x.verdict end)}]}') || return 1
  if [ "$json" = 1 ]; then jq -c . <<<"$out"; return 0; fi
  jq -r '"effect of \(.ref) at \(.at), \(.days)d before vs after; control: the same split at \(.compare):",
    "| KPI | before | after | verdict | control | net |", "|---|---|---|---|---|---|",
    (.kpis[] | "| \(.kpi) | \(.before // "-") | \(.after // "-") | \(.verdict) | \(.control) | \(.net) |")' <<<"$out"
}

# --- improve: one KPI past its threshold at a time, each with a check written before the work ---
# effect.jsonl holds two kinds of line. A claim, {type: "claim", at, kpi, subject, from, bound,
# threshold}, names the row (ar-N) or queue item (item:<slug>) that owns a KPI and the 7d value it
# started from. A verdict, {type: "verdict", at, kpi, subject, verdict, from, after, pr, bound,
# threshold}, ends it. A claim is live until its subject has a verdict after it: identity is the
# subject, never a row's title. The verdict compares values, never the status, so an edit to
# kpi-thresholds cannot turn a flat result into a pass.
IMPROVE_JQ='
def live: group_by([.subject, .kpi]) | map(sort_by(.at) | last | select(.type == "claim"));
def last_verdict($k): map(select(.type == "verdict" and .kpi == $k)) | sort_by(.at) | last
  | if . == null then null else {subject, verdict} end;
# how far past its threshold a KPI is, relative to the threshold
def gap: (.threshold | fabs | if . == 0 then 1 else . end) as $d
  | (if .bound == "max" then .["7d"] - .threshold else .threshold - .["7d"] end) / $d;
'

effect_lines() { cat "$EFFECT" 2>/dev/null || true; }

# improve_pick <kpi json> -> the KPI furthest past its threshold that no live claim owns, as
# {kpi, value, threshold, bound, last}; nothing when none is, or BENCH_IMPROVE_MAX claims are live.
# board_open is never picked: a full board is the board-open watch's alert, and a session whose job
# is shrinking the board would delete rows the human filled on purpose.
improve_pick() {
  jq -c --slurpfile e <(effect_lines) --argjson max "$BENCH_IMPROVE_MAX" "$IMPROVE_JQ"'
    ($e | live) as $live | ($live | map(.kpi)) as $owned
    | if ($live | length) >= $max then empty else
        [to_entries[] | select(.value.status == "past" and .key != "board_open" and (.key | IN($owned[]) | not))
         | {kpi: .key, value: .value["7d"], threshold: .value.threshold, bound: .value.bound, gap: (.value | gap)}]
        | sort_by(-.gap) | first // empty
        | del(.gap) | . + {last: (.kpi as $k | $e | last_verdict($k))} end' <<<"$1"
}

# improve_target <kpi json> <kpi> [subject] -> the KPI as {kpi, value, threshold, bound}, or a why
# and a failure: it must be past its threshold and unclaimed, and with no subject (file: new work)
# under the cap. A subject (claim) records a row or item that already exists, so the cap does not
# hold it, and one subject may claim each KPI its lever moves.
improve_target() {
  local why
  why=$(jq -r --arg k "$2" --arg s "${3:-}" --slurpfile e <(effect_lines) --argjson max "$BENCH_IMPROVE_MAX" "$IMPROVE_JQ"'
    ($e | live) as $live | .[$k] as $v
    | if $v == null then "no KPI named \($k)"
      elif $v.status != "past" then "\($k) is not past its threshold (\($v.status))"
      elif ($live | any(.kpi == $k)) then "\($k) is already claimed by \([$live[] | select(.kpi == $k) | .subject] | first)"
      elif $s == "" and ($live | length) >= $max then "\($live | length) claims are live (BENCH_IMPROVE_MAX \($max)); one must end first"
      else empty end' <<<"$1") || return 1
  [ -z "$why" ] || { say "improve: $why"; return 1; }
  jq -c --arg k "$2" '.[$k] | {kpi: $k, value: .["7d"], threshold, bound}' <<<"$1"
}

# improve_claim_write <subject> <{kpi, value, threshold, bound}>: append the claim, its baseline
improve_claim_write() {
  mkdir -p "$DIR"
  jq -c --argjson at "$(now)" --arg s "$1" \
    '{type: "claim", at: $at, kpi, subject: $s, from: .value, bound, threshold}' <<<"$2" >> "$EFFECT"
}

# improve_add <text> <detail> -> the new row's id on the agent board; 3 when its twin is open
improve_add() {
  local out rc=0
  out=$($BENCH_NOTES_CMD ptask "$KPI_BOARD" --agent add "$1" --detail "$2") || rc=$?
  [ "$rc" = 0 ] || return "$rc"
  grep -oE '<!-- id:[a-z]+-[0-9]+' <<<"$out" | head -1 | sed 's/^<!-- id://' | grep . ||
    { say "improve: the row was added but notes printed no id, so nothing claims it"; return 1; }
}

improve_kpis() { kpi_json "$(now)" "$(ledger_counts)" || { say "improve: kpi unreadable"; return 2; }; }

# improve [--json]: the pick; exit 1 when nothing is due
improve_show() {
  local json pick
  json=$(improve_kpis) || return 2
  pick=$(improve_pick "$json") || return 2
  [ -n "$pick" ] || return 1
  if [ "$1" = --json ]; then printf '%s\n' "$pick"; return 0; fi
  jq -r '"\(.kpi) 7d \(.value) past \(.bound) \(.threshold)" + (if .last then ", last \(.last.subject) \(.last.verdict)" else "" end)' <<<"$pick"
}

# improve file <kpi> <text>: add the row tagged #kpi/<kpi> with its check as a detail line, and
# claim it with the KPI's 7d value now as the baseline
improve_file() {
  local json t text id rc=0
  json=$(improve_kpis) || return 2
  t=$(improve_target "$json" "$1") || return 1
  text="$2 #kpi/$1"
  [[ "$text" == *"#size/"* ]] || text+=" #size/s"
  id=$(improve_add "$text" "$(jq -r --argjson d "$BENCH_EFFECT_DAYS" \
    '"check: kpi \(.kpi) from \(.value) (\(.bound) \(.threshold)), read \($d)d after the PR lands; kpi-thresholds is not edited"' <<<"$t")") || rc=$?
  case $rc in
    0) ;;
    3) say "improve: a row with that text is already open; claim it: fleet-bench improve claim $1 <its id>"; return 3 ;;
    *) say "improve: the add failed ($rc)"; return 1 ;;
  esac
  improve_claim_write "$id" "$t"
  printf '%s claims %s from %s\n' "$id" "$1" "$(jq -r .value <<<"$t")"
}

# improve claim <kpi> <ar-N|item:slug>: record a row or queue item that already owns the KPI; the
# board is not written
improve_claim() {
  local json t
  [[ "$2" =~ ^([a-z]+-[0-9]+|item:[a-z0-9][a-z0-9-]*)$ ]] || { say "improve: claim takes a row id (ar-N) or item:<slug>, not $2"; return 2; }
  json=$(improve_kpis) || return 2
  t=$(improve_target "$json" "$1" "$2") || return 1
  improve_claim_write "$2" "$t"
  printf '%s claims %s from %s\n' "$2" "$1" "$(jq -r .value <<<"$t")"
}

# improve list [--json]: the live claims with their age, and the newest verdicts
improve_list() {
  local rows
  rows=$(effect_lines | jq -sc --argjson now "$(now)" "$IMPROVE_JQ"'
    {live: (live | map(. + {age_d: (($now - .at) / 86400 | floor)})),
     verdicts: (map(select(.type == "verdict")) | sort_by(.at) | reverse | .[:20])}') || return 1
  if [ "$1" = --json ]; then printf '%s\n' "$rows"; return 0; fi
  jq -r --argjson max "$BENCH_IMPROVE_MAX" '"live claims: \(.live | length) of \($max)",
    (.live[] | "  \(.subject) \(.kpi) from \(.from) (\(.bound) \(.threshold)), \(.age_d)d"),
    "verdicts:", (.verdicts[] | "  \(.subject) \(.kpi) \(.verdict) \(.from) -> \(.after // "-")\(if .pr then " (pr:\(.pr))" else "" end)")' <<<"$rows"
}

# improve_check: retro's read of each live claim. A row closed with a PR, or an item moved to done
# with one, BENCH_EFFECT_DAYS or more ago gets a verdict from the KPI's 7d value now against the
# claim's (move, the bound gives the direction); one closed with no PR, dropped, a dup or cancelled
# is unproven; one still open stays live. Regressed files one #high revert row and claims it; flat
# and unproven end the claim, so the pick names the KPI again. Leaves IMPROVE_LINE (the outcome
# part), IMPROVE_WHY (when nothing was checked) and IMPROVE_FAIL.
improve_check() {
  local claims days log json v line verdict id n=0 imp=0 flt=0 reg=0 unp=0
  IMPROVE_LINE='' IMPROVE_WHY='' IMPROVE_FAIL=''
  claims=$(effect_lines | jq -sc "$IMPROVE_JQ"'live') || { IMPROVE_FAIL="effect ledger unreadable"; return 1; }
  if [ "$claims" = "[]" ]; then IMPROVE_WHY="no live improvement claim"; return 0; fi
  days=$(jq -r --argjson now "$(now)" '($now - (map(.at) | min)) / 86400 | floor + 2' <<<"$claims")
  log=$($BENCH_LOG_CMD --days "$days") || { IMPROVE_FAIL="notes log unreadable"; return 1; }
  json=$(kpi_json "$(now)" "$(ledger_counts)") || { IMPROVE_FAIL="kpi unreadable"; return 1; }
  v=$(jq -c --argjson now "$(now)" --argjson d "$BENCH_EFFECT_DAYS" --argjson flat "$BENCH_EFFECT_FLAT" \
      --argjson k "$json" --slurpfile log <(printf '%s\n' "$log") "$JQ_LIB"'
    def log_epoch: sub("\\.[0-9]+"; "")
      | iso_epoch;
    .[] | . as $c | ($c.subject | ltrimstr("item:")) as $slug | ($c.subject | startswith("item:")) as $item
    | [$log[] | select(if $item then .item == $slug and ((.action == "item-moved" and .to == "done") or .action == "item-cancelled")
                       else .id == $c.subject and (.action | IN("done", "dropped", "dup")) end)
       | {at: (.ts | log_epoch),
          pr: (if $item then .pr else first((.why // "") | capture("pr:(?<p>[^ ;]+)") | .p) end // null)}]
    | (sort_by(.at) | last) as $close
    | if $close == null then empty
      elif $close.pr == null then {verdict: "unproven", after: null}
      elif $now < $close.at + $d * 86400 then empty
      else (($k[$c.kpi] // {})["7d"]) as $a
        | move($c.from; $a; (if $c.bound == "max" then -1 else 1 end); $flat) as $m
        | if $m == "-" then empty else {verdict: $m, after: $a} end end
    | {type: "verdict", at: $now, kpi: $c.kpi, subject: $c.subject, from: $c.from, pr: $close.pr,
       bound: $c.bound, threshold: $c.threshold} + .' <<<"$claims") || { IMPROVE_FAIL="check unreadable"; return 1; }
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    verdict=$(jq -r .verdict <<<"$line") id=''
    if [ "$verdict" = regressed ]; then
      local rc=0 text
      text=$(jq -r '"fix(kpi): revert \(.pr), \(.kpi) went from \(.from) to \(.after) #kpi/\(.kpi) #high #size/s"' <<<"$line")
      id=$(improve_add "$text" "$(jq -r --argjson d "$BENCH_EFFECT_DAYS" \
        '"check: kpi \(.kpi) from \(.after) (\(.bound) \(.threshold)), read \($d)d after the PR lands; kpi-thresholds is not edited"' <<<"$line")") || rc=$?
      case $rc in 0|3) ;; *) IMPROVE_FAIL="the revert row for $(jq -r .subject <<<"$line") failed"; return 1 ;; esac
    fi
    printf '%s\n' "$line" >> "$EFFECT"
    [ -z "$id" ] || improve_claim_write "$id" "$(jq -c '{kpi, value: .after, threshold, bound}' <<<"$line")"
    n=$((n + 1))
    case $verdict in improved) imp=$((imp + 1)) ;; flat) flt=$((flt + 1)) ;; regressed) reg=$((reg + 1)) ;; *) unp=$((unp + 1)) ;; esac
  done <<<"$v"
  if [ "$n" = 0 ]; then IMPROVE_WHY="$(jq length <<<"$claims") improvement claims not yet due"; return 0; fi
  IMPROVE_LINE="$n checked: $imp improved, $flt flat, $reg regressed, $unp unproven"
}

# improve [--json] | file <kpi> <text> | claim <kpi> <ar-N|item:slug> | list [--json]
cmd_improve() {
  local usage="usage: fleet-bench improve [--json] | file <kpi> <text> | claim <kpi> <ar-N|item:slug> | list [--json]"
  case "${1:-}" in
    ""|--json) improve_show "${1:-}" ;;
    file) [ $# -eq 3 ] && [ -n "$3" ] || { say "$usage"; return 2; }; improve_file "$2" "$3" ;;
    claim) [ $# -eq 3 ] || { say "$usage"; return 2; }; improve_claim "$2" "$3" ;;
    list) improve_list "${2:-}" ;;
    *) say "$usage"; return 2 ;;
  esac
}

# retro_guard_rows -> one "check(lesson): guard <hash>:<TAB>text<TAB>priority" line per lesson whose sig
# (so_lesson_sigs) hit in BENCH_GUARD_RECUR or more sessions after it was written: a lesson the
# fleet keeps relearning wants a hook, test or lint, and the lesson goes once that lands.
retro_guard_rows() {
  local sigs sig claim since file n h key
  # shellcheck source=/dev/null
  . "$BENCH_SO_LIB" || return 1
  sigs=$(so_lesson_sigs) || return 1
  jq -r --argjson min "$BENCH_GUARD_RECUR" --slurpfile o <(outcomes_newest) '
    .[] as $s | ([$o[] | select(((.lesson_hits // {})[$s.sig] // 0) > 0)] | length) as $n
    | select($n >= $min) | [$s.sig, $s.claim, $s.since, $s.file, $n] | @tsv' <<<"$sigs" |
  while IFS=$'\t' read -r sig claim since file n; do
    h=$(printf '%s' "$sig" | sha1sum | cut -c1-8)
    key="check(lesson): guard $h:"
    printf '%s\t%s lesson "%s" (%s, %s) recurred in %s sessions; make it a hook, test or lint, then delete the lesson\t%s\n' \
      "$key" "$key" "$claim" "$file" "$since" "$n" "$( [ "$n" -ge $((BENCH_GUARD_RECUR * 2)) ] && echo '#high' || echo '#low')"
  done
}

# retro reads each live improvement claim (improve_check), queues the week's canary run
# (canary_queue) and one on every lane with room (canary_queue_lanes), and keeps exactly one open agent-board row per lesson that keeps recurring
# (`check(lesson): guard <hash>:`). A KPI past its threshold gets
# no row here: `fleet-bench improve` names one at a time, and its row carries the check.
cmd_retro() {
  local grows why=()
  improve_check || { report_outcome FAILED "$IMPROVE_FAIL"; return 1; }
  if [ -n "$IMPROVE_LINE" ]; then say "$IMPROVE_LINE"; else why+=("$IMPROVE_WHY"); fi
  # The week's canary run rides this weekly pass; a failure to queue it is said, never fatal here.
  canary_queue || say "canary: could not queue this week's run"
  canary_queue_lanes || say "canary: could not queue every lane's run"
  grows=$(retro_guard_rows) || { report_outcome FAILED "lesson sigs unreadable"; return 1; }
  if [ -z "$grows" ]; then
    why+=("no lesson recurred")
    if [ -n "$IMPROVE_LINE" ]; then report_outcome WORKED "$IMPROVE_LINE"; return 0; fi
    say "${why[*]}"
    report_outcome NOOP "$(IFS=';'; echo "${why[*]}")"
    return 0
  fi
  board_upsert "$grows" || return 1
  upsert_report "$grows" "$IMPROVE_LINE"
}

# board_upsert <rows: key TAB text TAB priority, one a line> keeps exactly one open agent-board
# row per key, matched as a lowercase title prefix: a row whose text moved is edited in place, one
# that matches writes nothing, and an add that exits 3 found its twin already open (a near-dup), so
# it counts as filed. A row whose condition cleared is triage_retire's. Every row is
# #size/s. Leaves the counts in UPSERT_ADDED and UPSERT_EDITED; FAILED is reported here.
board_upsert() {
  local board p text pri have rc added=0 edited=0
  UPSERT_ADDED=0; UPSERT_EDITED=0
  board=$($BENCH_NOTES_CMD ptask "$KPI_BOARD" --agent list) || { report_outcome FAILED "$KPI_BOARD agent board unreadable"; return 1; }
  while IFS=$'\t' read -r p text pri; do
    [[ "$text" == *'#size/'* ]] || text+=" #size/s"
    have=$(awk -F'\t' -v p="${p,,}" 'index($3, p) == 1 { print $3; exit }' <<<"$board")
    if [ -z "$have" ]; then
      rc=0
      $BENCH_NOTES_CMD ptask "$KPI_BOARD" --agent add "$text $pri" >/dev/null || rc=$?
      case $rc in
        0) added=$((added + 1)) ;;
        3) ;;
        *) report_outcome FAILED "add failed for $p"; return 1 ;;
      esac
    elif [ "$have" != "${text,,}" ]; then
      $BENCH_NOTES_CMD ptask "$KPI_BOARD" --agent edit "$p" --text "$text" >/dev/null \
        || { report_outcome FAILED "edit failed for $p"; return 1; }
      edited=$((edited + 1))
    fi
  done <<<"$1"
  UPSERT_ADDED=$added; UPSERT_EDITED=$edited
}

# upsert_report <rows> [more]: the one line and the outcome after board_upsert; NOOP when it wrote nothing
upsert_report() {
  local did="$UPSERT_ADDED added, $UPSERT_EDITED refreshed"
  did+="${2:+, $2}"
  say "$(grep -c . <<<"$1") rows due: $did"
  if [ $((UPSERT_ADDED + UPSERT_EDITED)) -eq 0 ] && [ -z "${2:-}" ]; then
    report_outcome NOOP "every row already current"
  else
    report_outcome WORKED "$did"
  fi
}

# watch_sev <name> -> the severity in its manifest. watch_after <severity> -> seconds it must stay
# at TRIP before it is a red.
watch_sev() { sed -n 's/^severity:[[:space:]]*//p' "$TRIAGE_WATCHES/$1.yaml" 2>/dev/null | head -1; }
watch_after() { case "$1" in high|urgent) echo "$TRIAGE_WATCH_HIGH_AFTER" ;; *) echo "$TRIAGE_WATCH_AFTER" ;; esac; }

# watch_tripped_since <name> <now> -> when the watch tripped, once it is past triage's patience
watch_tripped_since() {
  local since
  [ "$(cat "$TRIAGE_WATCH_STATE/$1.state" 2>/dev/null)" = TRIP ] || return 1
  since=$(cat "$TRIAGE_WATCH_STATE/$1.since" 2>/dev/null) || return 1
  [[ "$since" =~ ^[0-9]+$ ]] && [ $(($2 - since)) -ge "$(watch_after "$(watch_sev "$1")")" ] || return 1
  printf '%s\n' "$since"
}

# triage_rows -> key, text and priority (tab-separated) for each runtime fault that persists: a
# scheduled runner whose last-outcome is FAILED or STALLED, a failed user unit, and a Sentinel
# watch held at TRIP past TRIAGE_WATCH_AFTER, or TRIAGE_WATCH_HIGH_AFTER when high or urgent.
# FAILED, a failed unit and a high or urgent watch are #high. Sentinel stays observe-only: this
# reads its state files.
triage_rows() {
  local c name sd v detail u res load f n since sev what why t
  t=$(now)
  proof_lib && sd=$(proof_state_dir)
  for c in "$LEDGER_CONF_DIR"/*.conf; do
    [ -e "$c" ] && [ -n "$sd" ] || continue
    grep -qE '^KIND=["'"'"']?call' "$c" && continue
    grep -qE '^ENABLED=["'"'"']?no' "$c" && continue
    name=$(scheduled_runner "$c") || continue
    v=$(awk 'NR == 1 { print $1 }' "$sd/$name/last-outcome" 2>/dev/null)
    case "$v" in FAILED|STALLED) ;; *) continue ;; esac
    detail=$(grep "outcome=$v" "$sd/$name/activity.log" 2>/dev/null | tail -1 \
      | sed -E 's/^\[([0-9-]{10})[^]]*\] outcome=[A-Z]+ ?/\1 /; s/^([0-9-]{10}) .* (why: .*)$/\1 \2/' | cut -c1-100)
    printf 'fix(runner): %s is\tfix(runner): %s is %s: %s\t%s\n' "$name" "$name" "$v" "${detail:-no detail}" \
      "$([ "$v" = FAILED ] && echo '#high' || echo '#low')"
  done
  $TRIAGE_SYSTEMCTL --user list-units --failed --plain --no-legend 2>/dev/null | awk '{ print $1 }' |
  while read -r u; do
    [ -n "$u" ] || continue
    res=$($TRIAGE_SYSTEMCTL --user show -p Result --value "$u" 2>/dev/null)
    load=$($TRIAGE_SYSTEMCTL --user show -p LoadState --value "$u" 2>/dev/null)
    printf 'fix(unit): %s failed\tfix(unit): %s failed: %s%s\t#high\n' "$u" "$u" "${res:-unknown}" \
      "$([ "$load" = not-found ] && echo ', the unit file is gone')"
  done
  for f in "$TRIAGE_WATCH_STATE"/*.state; do
    [ -e "$f" ] || continue
    n=$(basename "$f" .state)
    since=$(watch_tripped_since "$n" "$t") || continue
    sev=$(watch_sev "$n")
    # `what:` is one line or a folded block whose first sentence is the healthy state
    what=$(awk '/^what:/ { sub(/^what:[[:space:]]*(>-?|\|-?)?[[:space:]]*/, ""); on = 1; if ($0 != "") print; next }
                on && /^[[:space:]]/ { sub(/^[[:space:]]+/, ""); print; next } on { exit }' "$TRIAGE_WATCHES/$n.yaml" 2>/dev/null \
      | tr '\n' ' ' | sed -E 's/\. .*/./; s/[[:space:]]+$//' | cut -c1-100)
    # A probe that prints one OK or RED line a stage (unity-core-playground's release-ready.py)
    # names its first RED line; otherwise the last line of the redacted evidence, usually the
    # error. Normalized, so a new pid or timestamp in it does not edit the row every pass.
    o="$TRIAGE_WATCH_STATE/$n.out"
    why=$({ grep -m 1 -E '^RED[[:space:]]' "$o" || grep -v '^[[:space:]]*$' "$o" | tail -n 1; } 2>/dev/null \
      | log_norm | tr -d '#' | cut -c1-100)
    printf 'check(watch): %s tripped since\tcheck(watch): %s tripped since %s, expected: %s%s\t%s\n' "$n" "$n" \
      "$(date -d "@$since" +%Y-%m-%d)" "${what:-no manifest}" \
      "${why:+, why: $why, evidence: watch-companion-loop list --long $n}" \
      "$(case "$sev" in high|urgent) echo '#high' ;; *) echo '#low' ;; esac)"
  done
}

# log_norm: a stderr line with what varies between runs taken out, so one error is one signature:
# a leading timestamp, quoted strings, paths, hex ids and numbers become placeholders.
log_norm() {
  sed -E 's/^\[[^]]*\][[:space:]]*//; s/"[^"]*"/"Q"/g; s/'"'"'[^'"'"']*'"'"'/'"'"'Q'"'"'/g
          s#(~|\.)?(/[^[:space:]/:"'"'"']+)+/?#P#g; s/\b[0-9a-f]{7,}\b/H/g; s/[0-9]+/N/g; s/[[:space:]]+/ /g; s/ $//'
}

# triage_log_rows -> one row per runner stderr error signature seen in BENCH_GUARD_RECUR or more
# runs of the last TRIAGE_LOG_HOURS, one of them among the runner's newest BENCH_GUARD_RECUR readable
# runs: a cause fixed earlier in the window is not red now, and cause_tries would count its merged
# fix as one that did not hold. That many runs outlast a dispatch pass for the fastest runner, so an
# intermittent error is still seen. Each run's bytes come from its runs.jsonl err range; a range past
# the end of the log was rotated away and is skipped. #high at twice the recurrence.
triage_log_rows() {
  local sd t ledger name a b f sig
  proof_lib && sd=$(proof_state_dir)
  [ -n "$sd" ] && [ -r "$sd/runs.jsonl" ] || return 0
  t=$(now)
  ledger=$(jq -rs --argjson s $((t - TRIAGE_LOG_HOURS * 3600)) \
    'map(select((.finished // 0) >= $s and (.err[0] | type) == "number" and (.err[1] | type) == "number"
      and .err[1] >= .err[0])) | sort_by(.finished)[] | [.name, .err[0], .err[1]] | @tsv' "$sd/runs.jsonl" 2>/dev/null)
  while IFS=$'\t' read -r name a b; do
    [ -n "$name" ] || continue
    f="$sd/$name.stderr.log"
    [ -r "$f" ] && [ "$(stat -c %s "$f")" -ge "$b" ] || continue
    # a readable run, quiet or not, oldest first
    printf '%s\t%s\n' "$name" "$a"
    [ "$b" -gt "$a" ] || continue
    # one dd reads the range: `tail | head -c` cut the pipe early, and under systemd (SIGPIPE
    # ignored) tail logged a Broken pipe per range into the very logs this reads
    dd if="$f" iflag=skip_bytes,count_bytes skip="$a" count=$((b - a)) status=none |
      grep -aiE -- "$TRIAGE_ERR_RE" | tr -d '\t\r' |
      while IFS= read -r line; do printf '%s\t%s\t%s\t%s\n' "$name" "$a" "$(log_norm <<<"$line")" "$line"; done
  done <<<"$ledger" |
  awk -F'\t' -v min="$BENCH_GUARD_RECUR" '
    NF == 2 { run[$1, ++runs[$1]] = $2; next }
    { k = $1 FS $3; r[k] = $1; if (!((k, $2) in seen)) { seen[k, $2] = 1; n[k]++ } if (!(k in s)) s[k] = $4 }
    END { for (k in n) if (n[k] >= min) for (j = runs[r[k]]; j > 0 && j > runs[r[k]] - min; j--)
            if ((k, run[r[k], j]) in seen) { print k FS n[k] FS s[k]; break } }' |
  while IFS=$'\t' read -r name norm n sample; do
    sig=$(printf '%s\t%s' "$name" "$norm" | sha1sum | cut -c1-8)
    # a # would read as a tag on the board
    sample=$(sed -E 's/^\[[^]]*\][[:space:]]*//; s/#/no./g' <<<"$sample" | cut -c1-80)
    printf 'fix(logs): %s error %s:\tfix(logs): %s error %s: %s\t%s\n' "$name" "$sig" "$name" "$sig" "$sample" \
      "$( [ "$n" -ge $((BENCH_GUARD_RECUR * 2)) ] && echo '#high' || echo '#low')"
  done | sort
}

# red_items <epoch> -> the cc:red_now items red now and TRIAGE_WATCH_AFTER ago, the same patience a
# watch gets, because the rule has no "since" to read.
red_items() {
  prom_q "cc:red_now and (cc:red_now offset ${TRIAGE_WATCH_AFTER}s)" "$1" 2>/dev/null | jq -r '.data.result[]?.metric.item // empty'
}

# triage_red_rows -> a row for each cc:red_now item with no state on this machine: reds another host
# watches, such as the voice pucks. A watch or runner with local state already has its own row.
triage_red_rows() {
  local item n
  $TRIAGE_RED_CMD "$(now)" | while IFS= read -r item; do
    [ -n "$item" ] || continue
    n=${item#* }; n=${n//_/-}
    [ -e "$TRIAGE_WATCH_STATE/$n.state" ] || [ -e "$LEDGER_CONF_DIR/$n.conf" ] && continue
    printf 'check(red): %s is red\tcheck(red): %s is red\t#low\n' "$item" "$item"
  done
}

# triage_line <text>: the first TRIAGE_ROUTES line whose ERE matches, into the caller's re, route,
# skill, fix and tags. Status 1 when none does.
triage_line() {
  [ -r "$TRIAGE_ROUTES" ] || return 1
  while IFS=$'\t' read -r re route skill fix tags; do
    [[ -n "$re" && "$re" != \#* && -n "$fix" ]] || continue
    [[ "$1" =~ $re ]] && return 0
  done < "$TRIAGE_ROUTES"
  return 1
}

# triage_shape <kind> <name>: the row a failure of that kind files, into the caller's text, with
# its date and cause as stand-ins: the shape the route table matches on.
triage_shape() {
  case "$1" in
    watch) text="check(watch): $2 tripped since 2026-01-01, expected: -" ;;
    runner) text="fix(runner): $2 is FAILED: -" ;;
    unit) text="fix(unit): $2 failed: failed" ;;
    hold) text="fix(hold): $2 went red after cleanup merge -: -" ;;
    *) text= ;;
  esac
}

# triage_route <rows> -> key, text, priority, route, cause, item tags. The first TRIAGE_ROUTES line
# whose ERE matches the row decides; no match, or a route it does not know, is route "-" and cause
# "-", or for a watch check(watch):<name> hashed. The cause is that line's ERE hashed, so every row one line explains is one cause. A line with a capture group
# names one cause per value, such as one per runner or watch, and that cause is the row's kind (its
# text to the first colon; every triage_shape row has one) plus the value, not the ERE: the watch
# line lists every watch it routes, so each edit to it gave every watch a new cause, cause_tries
# counted 0 again and triage_spent never sent a red two fixes did not hold to the human
# (board-chain and runner-score, 2026-11-07).
triage_route() {
  local key text pri re route skill fix tags t note hit cause extra
  while IFS=$'\t' read -r key text pri; do
    hit=0 cause=- extra=
    triage_line "$text" && hit=1
    if [ "$hit" = 1 ]; then
      fix=${fix//#/no.}
      case "$route" in
        agent) note="fix${skill:+ with $skill}: $fix"; [ "$skill" != - ] || note="fix: $fix" ;;
        script) note="script: $fix" ;;
        human:?*) note="for the human: $fix" ;;
        alert | owned:?*) note='' ;;
        *) say "triage: $TRIAGE_ROUTES: no such route: $route"; hit=0 ;;
      esac
    fi
    if [ "$hit" = 0 ]; then
      # An unrouted watch is still queued (triage_queues), so it is a cause of its own, named as a
      # capture-group line names it, so a line added for it later keeps its tries.
      if [[ "$key" == 'check(watch): '* ]]; then
        cause=${key#'check(watch): '}; cause=$(printf 'check(watch):%s' "${cause%% *}" | sha256sum | cut -c1-8)
      fi
      printf '%s\t%s\t%s\t-\t%s\t\n' "$key" "$text" "$pri" "$cause"
      continue
    fi
    if [[ "$text" =~ $re ]] && [ -n "${BASH_REMATCH[1]:-}" ]; then
      if [[ "$text" == *:* ]]; then re="${text%%:*}:${BASH_REMATCH[1]}"; else re+=${BASH_REMATCH[1]}; fi
    fi
    cause=$(printf '%s' "$re" | sha256sum | cut -c1-8)
    if [[ "$key" == 'check(watch): '* ]]; then
      case "$route" in
        alert) note="the human decides: $fix; own it: file that decision as one agent-ask with a recommendation, and fix what is not theirs" ;;
        owned:?*) note="owned by ${route#owned:}: $fix; get that work running, or fix it here" ;;
      esac
    fi
    text+="${note:+; $note}"
    for t in ${tags:-}; do
      case "$t" in -) ;; \#*) text+=" $t" ;; *) extra+="${extra:+ }$t" ;; esac
    done
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$key" "$text" "$pri" "$route" "$cause" "$extra"
  done <<<"$1"
}

# triage_queues <key> <route>: the row is queued as a red item. An agent route is; so is a tripped
# watch on any route but a human's, so every tripped watch has an owner (TRIAGE_WATCH_AFTER): an
# alert or owned watch's session files the decision or chases the owner.
triage_queues() { [ "$2" = agent ] || { [[ "$1" == 'check(watch): '* ]] && [[ "$2" != human:* ]]; }; }

# triage_filed <rows> -> the rows for the agent board: every one triage_queues, and an unrouted or
# script row. Any other alert, owned or human red takes no agent row: dispatch would read an open one as work.
triage_filed() {
  local line key route
  while IFS= read -r line; do
    IFS=$'\t' read -r key _ _ route _ <<<"$line"
    case "$route" in - | script) ;; *) triage_queues "$key" "$route" || continue ;; esac
    printf '%s\n' "$line"
  done <<<"$1"
}

# triage_human <rows>: a human route's row on that sheet, paged once, the day it lands.
triage_human() {
  local key text pri route sheet have n=0
  while IFS=$'\t' read -r key text pri route _; do
    case "$route" in human:?*) sheet=${route#human:} ;; *) continue ;; esac
    have=$($BENCH_NOTES_CMD ptask "$sheet" list 2>/dev/null) || continue
    awk -F'\t' -v p="${key,,}" 'index(tolower($3), p) == 1 { f = 1 } END { exit !f }' <<<"$have" && continue
    $BENCH_NOTES_CMD ptask "$sheet" add "$text #size/s $pri" >/dev/null 2>&1 || continue
    $TRIAGE_NOTIFY_CMD -t 'Needs you' "$sheet sheet: $key" >/dev/null 2>&1
    n=$((n + 1))
  done <<<"$1"
  echo "$n"
}

# cause_tries <items> <cause> [trip] -> -1 while an item stands for the cause: queued, running or
# waiting, or closed with a PR that is not merged (it waits on a merge, and a second session would
# only repeat it), or, given the epoch an alert or owned watch tripped at, closed ok since then (its
# job was the ask or the owner, not the red, so a PR it merged fixed something beside the red; the
# TRIAGE_FIX_DAYS window bounds it, and the watch re-pages on its own). Else how many items the window
# queued for it.
# Every row triage reads is red now, so an item that closed cancelled or failed, or merged with its
# red still here on an agent route or before the trip, did not hold.
cause_tries() {
  jq --arg c " cause:$2 " --arg trip "${3:-}" "$JQ_LIB"'[.[] | select((" " + (.tags // "") + " ") | contains($c))]
    | if any(.[]; .state == "queued" or .state == "running" or .state == "review" or .state == "waiting"
                or (.state == "done" and .pr != null and (.merged // "") == "" and .status != "cancelled")
                or ($trip != "" and .state == "done" and .status == "ok"
                    and ((.queued | ep) // 0) >= ($trip | tonumber)))
      then -1 else length end' <<<"$1"
}

# watch_trip <key> <route> -> the epoch an alert or owned watch row's watch tripped at; nothing for
# any other row. 2026-11-11: playground-release-ready's alert item closed ok with the watch still
# red, triage queued a second 4 minutes later, and the third pass would page "red fixes that did
# not hold" for a red no session was asked to clear.
watch_trip() {
  [[ "$1" == 'check(watch): '* ]] || return 0
  case "$2" in alert | owned:?*) ;; *) return 0 ;; esac
  local n=${1#'check(watch): '}
  sed -n '1{/^[0-9][0-9]*$/p}' "$TRIAGE_WATCH_STATE/${n%% *}.since" 2>/dev/null
}

# cause_slugs <items> <cause> -> the slugs of the window's items for the cause, oldest first, comma-joined
cause_slugs() {
  jq -r --arg c " cause:$2 " '[.[] | select((" " + (.tags // "") + " ") | contains($c))] | sort_by(.queued // "") | map(.slug) | join(",")' <<<"$1"
}

# triage_items -> the queue items of the last TRIAGE_FIX_DAYS as one array; rc 1 when unreadable
triage_items() {
  $TRIAGE_ITEMS_CMD --since "$(date -d "@$(( $(now) - TRIAGE_FIX_DAYS * 86400 ))" +%F)" 2>/dev/null | jq -cs .
}

# triage_promote <rows> -> how many rows triage_queues were queued as red fixes. A red fix opens its PR at
# any hour and stops there (policy 2026-11-06), so each guard here keeps that from running away: a
# dispatch hold or an unreadable queue queues nothing, TRIAGE_FIX_CAP bounds the day's other reds, an
# item in hand stands for its cause (cause_tries), and a cause gets at most TRIAGE_FIX_TRIES items in
# the window. A tripped watch's item is tagged `watch` and is outside the cap: each watch is one cause,
# so the watches bound it, and fleet-dispatch widens its red floor by one for each.
# A later try is tagged `retry:<earlier slugs>` so its session starts from what did not hold; a cause
# whose tries are spent goes to the human (triage_spent).
triage_promote() {
  local board key raw route cause tags items used tries more kind n=0 capped=0 seen=' '
  $TRIAGE_HOLD_CMD >/dev/null 2>&1 || { echo 0; return 0; }
  items=$(triage_items) || { echo 0; return 0; }
  used=$(jq --arg d "$(date -u -d "@$(now)" +%F)" \
    "$JQ_LIB"'[.[] | select(tagged("red") and (tagged("watch") | not) and (.queued // "" | startswith($d)))] | length' <<<"$items")
  board=$($BENCH_NOTES_CMD ptask "$KPI_BOARD" --agent list) || { echo 0; return 0; }
  while IFS=$'\t' read -r key _ _ route cause tags; do
    triage_queues "$key" "$route" || continue
    kind=''; [[ "$key" == 'check(watch): '* ]] && kind=' watch'
    [ -n "$kind" ] || [ $((used + capped)) -lt "$TRIAGE_FIX_CAP" ] || continue
    [[ "$seen" != *" $cause "* ]] || continue
    seen+="$cause "
    tries=$(cause_tries "$items" "$cause" "$(watch_trip "$key" "$route")")
    [ "$tries" -ge 0 ] && [ "$tries" -lt "$TRIAGE_FIX_TRIES" ] || continue
    more=''; [ "$tries" -eq 0 ] || more=" retry:$(cause_slugs "$items" "$cause")"
    raw=$(awk -F'\t' -v p="${key,,}" 'index($3, p) == 1 { print $4; exit }' <<<"$board")
    [[ "$raw" == '- [ ]'* ]] || continue
    $TRIAGE_PROMOTE_CMD --agent --project "$KPI_BOARD" --tags "red$kind cause:$cause$more${tags:+ $tags}" --raw "$raw" >/dev/null 2>&1 || continue
    n=$((n + 1)); [ -n "$kind" ] || capped=$((capped + 1))
  done <<<"$1"
  echo "$n"
}

# triage_spent <rows> -> a human route row on the KPI board's sheet for each row triage_queues whose cause
# had TRIAGE_FIX_TRIES items in the window and is red still: those sessions did not hold it, so the
# next step is the human's. triage_human files it and pages once.
triage_spent() {
  local items key text pri route cause seen=' '
  items=$(triage_items) || return 0
  while IFS=$'\t' read -r key text pri route cause _; do
    triage_queues "$key" "$route" || continue
    [[ "$seen" != *" $cause "* ]] || continue
    seen+="$cause "
    [ "$(cause_tries "$items" "$cause" "$(watch_trip "$key" "$route")")" -ge "$TRIAGE_FIX_TRIES" ] || continue
    printf '%s\t%s (red fixes that did not hold: %s)\t%s\thuman:%s\n' "$key" "$text" "$(cause_slugs "$items" "$cause")" "$pri" "$KPI_BOARD"
  done <<<"$1"
}

# triage_coverage -> each standing watch and each runner no TRIAGE_ROUTES line resolves, and each
# runner whose SKILL names nothing (agentctl skill --dangling), one a line.
# It builds the row each would file, so a line that stops matching the real row text counts too. A
# watch with an expiry is a bake or a one-off: it pages and goes, so it needs no line.
triage_coverage() {
  local f n text out rows=
  # Exit 1 is the answer "some are dangling"; any other failure means the check did not run, which
  # counts too, so a missing agentctl cannot read as clean.
  out=$(AGENTCTL_CONF_DIR="$LEDGER_CONF_DIR" $BENCH_SKILL_CMD 2>&1) || [ $? -eq 1 ] || out="the SKILL check failed: $out"
  [ -z "$out" ] || sed 's/^/skill /' <<<"$out"
  for f in "$TRIAGE_WATCHES"/*.yaml; do
    [ -e "$f" ] || continue
    grep -qE '^expiry: *[^n[:space:]]' "$f" && continue
    n=${f##*/} n=${n%.yaml}
    triage_shape watch "$n"
    rows+="watch $n"$'\t'"$text"$'\t-\n'
  done
  for f in "$LEDGER_CONF_DIR"/*.conf; do
    [ -e "$f" ] || continue
    n=${f##*/} n=${n%.conf}
    triage_shape runner "$n"
    rows+="runner $n"$'\t'"$text"$'\t-\n'
  done
  [ -n "$rows" ] || return 0
  triage_shape hold ci-0
  rows+="hold"$'\t'"$text"$'\t-\n'
  triage_route "${rows%$'\n'}" | awk -F'\t' '$4 == "-" { print $1 }'
}

# A cleanup item merges itself at any hour behind the red-fix gate (policy.md), so nobody is there
# when it breaks something: these are its post-merge guard. Each red reads as one record naming
# every merge it could be, because one red that queued a fix per merge would be a stampede.

# hold_ledger <owner/repo> -> "<ledger name> <base branch>" from day-log-ci, the one list of watched
# repos: a GitHub line as written, else a Forgejo line as forgejo:owner/repo (the name pr_ci uses),
# else the repo and main, which the ledger then answers for.
hold_ledger() {
  cat "${SCHEDULES_REPOS:-$HOME/.config/agentctl/day-log-ci}" 2>/dev/null | awk -v want="$(tr '[:upper:]' '[:lower:]' <<<"$1")" -v fallback="$1 main" '
    /^#/ || NF < 2 { next }
    tolower($1) == want { print $1, $2; found = 1; exit }
    tolower($1) ~ /^forgejo:/ { n = tolower($1); sub(/^forgejo:[^\/]+\//, "", n); if (n == want) forge = "forgejo:" n " " $2 }
    END { if (!found) print (forge != "" ? forge : fallback) }'
}

# hold_runs <owner/repo> -> the runs main's pushes started, from main_runs (exit 3: the run ledger
# does not sync the repo). A scheduled run is left out: it fails on the environment moving, not on
# a merge.
hold_runs() {
  local runs name base
  read -r name base < <(hold_ledger "$1")
  runs=$(main_runs "$name" "$base") || return
  jq -c 'map(select(.event == "push"))' <<<"$runs"
}

# hold_memo <key> <command...> -> the command's output, kept for a read that cannot change (a run's
# log, a commit's files, a file at a sha): a red stands for many passes and every hub refresh and KPI
# sample reads it, on the REST budget of 2026-10-29. A failed read is not kept.
hold_memo() {
  local file="$MAIN_CACHE/hold_$1" out
  shift
  [ -e "$file" ] && { cat "$file"; return; }
  out=$("$@") || return 1
  mkdir -p "$MAIN_CACHE"
  find "$MAIN_CACHE" -maxdepth 1 -name 'hold_*' -mtime +"$REDS_DAYS" -delete
  printf '%s\n' "$out" > "$file.$$" && mv "$file.$$" "$file"
  printf '%s\n' "$out"
}

# hold_failed <owner/repo> <run id> -> the bats files that failed in that run, repo-relative; rc 1
# when its log cannot be read, or is not there yet. gh cannot read a Forgejo run's log, so one names
# no file and counts against the merges since the last green, like any red that names none.
hold_failed() {
  local log
  [[ $(hold_ledger "$1") != forgejo:* ]] || return 0
  log=$(gh run view "$2" -R "$1" --log-failed 2>/dev/null) && [ -n "$log" ] || return 1
  { grep -oE 'in test file [^,]+\.bats' <<<"$log" || true; } | sed -E 's#.*[ /](unit|integ|ui)/#tests/\1/#' | sort -u
}

# hold_test <owner/repo> <sha> <file> -> the file's text at that sha
hold_test() {
  gh api -H 'Accept: application/vnd.github.raw+json' "repos/$1/contents/$3?ref=$2" 2>/dev/null
}

# hold_streak <owner/repo> <streak> <runs> <merges> -> the record for main's red streak, if it counts
# against a merge: one landed at or before the first red and within HOLD_HOURS of it. A merge's time
# is its own run's, since the item finishes after the push. The failed bats files narrow that to the
# merges whose area they are, the ones the Stop hook would pick for what each changed; a red that names none (lint, rust, a timeout) leaves only the merges
# in last green..first red. The runs reach jq by file, since main's push runs pass the 128 KB
# one-argument limit (ar-1619).
hold_streak() {
  local repo=$1 streak=$2 near id failed sha msha m f paths hits unread=0
  local -A body
  near=$(jq -c --arg repo "$repo" --argjson s "$streak" --slurpfile runs <(printf '%s\n' "$3") --argjson h "$((HOLD_HOURS * 3600))" "$JQ_LIB"'
    ($s.red.createdAt | ep) as $red | .[] | select(.repo == $repo)
    | . as $m | .at = (([$runs[0][] | select(.workflowPath == $s.red.workflowPath and .headSha == $m.sha) | .createdAt | ep] | first) // $m.at)
    | select(.at <= $red and $red - .at <= $h)' <<<"$4")
  [ -n "$near" ] || return 0
  id=$(jq -r .red.id <<<"$streak")
  failed=$(hold_memo "failed_${repo//\//_}_$id" hold_failed "$repo" "$id") ||
    { say "hold: cannot read the log of run $id on $repo"; return 1; }
  sha=$(jq -r .red.headSha <<<"$streak")
  if [ -n "$failed" ]; then
    while IFS= read -r f; do
      body[$f]=$(hold_memo "test_${repo//\//_}_${sha}_${f//\//_}" hold_test "$repo" "$sha" "$f") ||
        { say "hold: cannot read $f on $repo at ${sha:0:8}"; unread=1; }
    done <<<"$failed"
    hits=$(rc=0; while IFS= read -r m; do
      msha=$(jq -r .sha <<<"$m")
      paths=$(hold_memo "files_${repo//\//_}_$msha" commit_paths "$repo" "$msha" 2>/dev/null) ||
        { say "hold: cannot read the files of $repo ${msha:0:8}"; rc=1; continue; }
      for f in "${!body[@]}"; do
        test_picked "$paths" "$f" <<<"${body[$f]}" && { printf '%s\n' "$m"; break; }
      done
    done <<<"$near"; exit "$rc") || unread=1
  else
    hits=$(jq -c --argjson s "$streak" "$JQ_LIB"'select(.at > ($s.green.createdAt | ep))' <<<"$near")
  fi
  [ -n "$hits" ] || return "$unread"
  jq -cs --argjson s "$streak" --arg failed "$failed" '
    {name: "ci-\($s.red.headSha[0:8])-\($s.workflow | ascii_downcase | gsub("[^a-z0-9]+"; "-"))",
     what: "\($s.workflow) red at \($s.red.headSha[0:8])\(if $failed == "" then ", no bats file named" else ": " + ($failed | split("\n") | join(", ")) end)",
     merges: .}' <<<"$hits"
  return "$unread"
}

# repo_path <file> -> "owner/repo<TAB>path" for the checkout holding the file, links followed, so a
# stowed script lands in the repo it was written in, and a link a merge left dangling still names
# the path it removed; rc 1 when it is in no checkout with an origin
repo_path() {
  local f top url
  f=$(readlink -f "$1") && [ -d "${f%/*}" ] || return 1
  top=$(git -C "${f%/*}" rev-parse --show-toplevel 2>/dev/null) || return 1
  url=$(git -C "$top" remote get-url origin 2>/dev/null) || return 1
  url=${url%/}; url=${url%.git}
  printf '%s\t%s\n' "$(sed -E 's#.*[:/]([^/:]+/[^/:]+)$#\1#' <<<"$url" | tr '[:upper:]' '[:lower:]')" "${f#"$top"/}"
}

# liveness_reach -> repo_path of each file a runner the fleet-liveness probe names runs from: its
# conf and each $HOME-, ~- or /-rooted word of its COMMAND; rc 1 when the probe's output cannot be
# read. The probe prints one "<runner>: <fault>" line each; a line naming no runner conf (a fleet
# pause) reaches nothing.
liveness_reach() {
  local n c cmd w words o="$TRIAGE_WATCH_STATE/fleet-liveness.out"
  [ -r "$o" ] || return 1
  { grep -oE '^[A-Za-z0-9_.-]+:' "$o" || true; } | tr -d : | sort -u |
  while IFS= read -r n; do
    for c in "$LEDGER_CONF_DIR"/*.conf; do
      [ -e "$c" ] || continue
      [ "$(sed -n 's/^NAME=//p' "$c" | head -1 | tr -d "\"'")" = "$n" ] || [ "$(basename "$c" .conf)" = "$n" ] || continue
      repo_path "$c" || true
      cmd=$(sed -n 's/^COMMAND=//p' "$c" | head -1 | tr -d "\"'")
      read -ra words <<<"$cmd"
      for w in "${words[@]}"; do
        w=${w//'${HOME}'/$HOME}; w=${w//'$HOME'/$HOME}; [[ "$w" == '~/'* ]] && w=$HOME/${w#'~/'}
        [[ "$w" == /* ]] && { repo_path "$w" || true; }
      done
      break
    done
  done
}

# hold_reaching <merges> <reach> -> each merge, a line, that changed a file of the reach in its repo;
# rc 1 when a merge's files cannot be read
hold_reaching() {
  local m repo msha paths rc=0
  [ -n "$2" ] || return 0
  while IFS= read -r m; do
    repo=$(jq -r .repo <<<"$m"); msha=$(jq -r .sha <<<"$m")
    awk -F'\t' -v r="${repo,,}" '$1 == r { f = 1 } END { exit !f }' <<<"$2" || continue
    paths=$(hold_memo "files_${repo//\//_}_$msha" commit_paths "$repo" "$msha" 2>/dev/null) ||
      { say "hold: cannot read the files of $repo ${msha:0:8}"; rc=1; continue; }
    awk -F'\t' -v r="${repo,,}" 'NR == FNR { if ($1 == r) want[$2]; next } $0 in want { f = 1; exit } END { exit !f }' \
      <(printf '%s\n' "$2") <(printf '%s\n' "$paths") && printf '%s\n' "$m"
  done < <(jq -c '.[]' <<<"$1")
  return "$rc"
}

# hold_reds <now> <queue items> -> one record a line for each red now that counts against a cleanup
# merge: {name, what, merges}. fleet-liveness counts once it is past triage's patience, so a flap
# stays out, and only against a merge liveness_reach says could reach a runner its probe names.
# A repo or run that cannot be read, or that the run ledger does not hold, says so and
# counts as nothing, and the return is 1 so a caller that needs "not red" can tell that from "unknown".
hold_reds() {
  local t=$1 merges repo runs rc streak since near hits='' reach w=fleet-liveness h=$((HOLD_HOURS * 3600)) unread=0
  # pr: and merged: are lists in step, one PR per repo (agent-land)
  merges=$(jq -c "$JQ_LIB"'[.[] | select(tagged("cleanup") and (.merged // "") != "" and (.finished | ep) != null)
    | . as $i | [(.pr | tostring | split(" ")), (.merged | tostring | split(" "))] | transpose[]
    | select((.[0] // "" | test("^[^/# ]+/[^/# ]+#[0-9]+$")) and .[1] != null)
    | {slug: $i.slug, repo: (.[0] | split("#")[0]), n: (.[0] | split("#")[1]), sha: .[1], at: ($i.finished | ep)}]' <<<"$2") || return 1
  [ "$merges" != '[]' ] || return 0
  if since=$(watch_tripped_since "$w" "$t"); then
    near=$(jq -c --argjson s "$since" --argjson h "$h" 'map(select(.at <= $s and $s - .at <= $h))' <<<"$merges")
    if [ "$near" != '[]' ]; then
      reach=$(liveness_reach) || { say "hold: cannot read the fleet-liveness probe output"; unread=1; }
      hits=$(hold_reaching "$near" "$reach") || unread=1
    fi
    [ -z "$hits" ] || jq -cs --argjson s "$since" --arg w "$w" \
      '{name: "liveness-\($s)", what: "\($w) tripped, evidence: watch-companion-loop list --long \($w)", merges: .}' <<<"$hits"
  fi
  while IFS= read -r repo; do
    rc=0; runs=$(hold_runs "$repo") || rc=$?
    if [ "$rc" -eq 3 ]; then say "hold: $repo is not in the run ledger (day-log-ci), so nothing guards its main"; unread=1; continue; fi
    [ "$rc" -eq 0 ] || { say "hold: cannot read the runs on $repo main"; unread=1; continue; }
    while IFS= read -r streak; do
      hold_streak "$repo" "$streak" "$runs" "$merges" || unread=1
    done < <(jq -c "$MAIN_STREAKS"' | select(.green)' <<<"$runs")
  done < <(jq -r 'map(.repo) | unique[]' <<<"$merges")
  return "$unread"
}

# reds_items <now> -> the queue items of the last REDS_DAYS as one array; rc 1 when unreadable
reds_items() {
  $TRIAGE_ITEMS_CMD --since "$(date -d "@$(($1 - REDS_DAYS * 86400))" +%F)" 2>/dev/null | jq -cs .
}

# triage_hold_rows -> a row per red that counts against a cleanup merge, naming each merge
triage_hold_rows() {
  local t items
  t=$(now)
  items=$(reds_items "$t") || return 0
  hold_reds "$t" "$items" | jq -r "$JQ_LIB"'(.merges | map("\(.slug) (PR \(.n) at \(.sha[0:8]))") | join(", ")) as $m
    | "\(hold_key)\t\(hold_key) after cleanup merge\(if (.merges | length) > 1 then "s" else "" end) \($m): \(.what)\t#high"'
}

# reds_live <hold_reds records> -> the row key of each thing red right now, one a line: every triage
# row, every hold, plus every watch at TRIP whatever its age, so a fix that came back counts before
# triage would file it.
reds_live() {
  { triage_rows; triage_log_rows; triage_red_rows; } | cut -f1
  jq -r "$JQ_LIB"'hold_key' <<<"$1"
  watch_keys TRIP
}

# watch_keys <state> -> the row key of every watch in that Sentinel state, one a line
watch_keys() {
  local f
  for f in "$TRIAGE_WATCH_STATE"/*.state; do
    [ -e "$f" ] && [ "$(cat "$f")" = "$1" ] || continue
    f=${f##*/}
    printf 'check(watch): %s tripped since\n' "${f%.state}"
  done
}

# red_titles <items> -> {<title>: {area, name}} for each red item whose title parses as
# `type(area): <name> ...` with a name word, from one `notes row parse` (the grammar's home); fails, saying so,
# when the verb fails or answers short. A newline in a title reads as a space, as in reds_json.
red_titles() {
  local titles parsed
  titles=$(jq -c "$JQ_LIB"'[.[] | select(tagged("red")) | .title // .task // "" | gsub("\n"; " ")] | unique' <<<"$1") || return 1
  [ "$titles" != '[]' ] || { echo '{}'; return 0; }
  parsed=$(jq -r '.[]' <<<"$titles" | notes row parse) &&
    jq -cRn --argjson t "$titles" '[inputs | split("\t")] as $p | if ($p | length) != ($t | length) then error("short") else . end
      | [range($t | length) as $i | select($p[$i][3] == "1")
         | {key: $t[$i], value: {area: $p[$i][1], name: ([$p[$i][2] | capture("^(?<n>[^ ,;]+)").n][0])}}
         | select(.value.name != null)] | from_entries' <<<"$parsed" 2>/dev/null ||
    { say "reds: notes row parse failed or answered short (an old notes? notes-bootstrap --build-only)"; return 1; }
}

# alert_titles <items> -> the titles of the red items whose row TRIAGE_ROUTES sends to alert, as a
# JSON array: their watch pages the human on a KPI past its bound, so no merge can clear it.
alert_titles() {
  jq -r "$JQ_LIB"'.[] | select(tagged("red")) | .title // .task // "" | gsub("\n"; " ")' <<<"$1" | sort -u |
    while IFS= read -r title; do
      if triage_line "$title" && [ "$route" = alert ]; then printf '%s\n' "$title"; fi
    done | jq -Rsc 'split("\n") | map(select(. != ""))'
}

# reds_json <now> -> one JSON object a line per red queue item queued in the last REDS_DAYS, then
# per merged cleanup item (cleanup: true, its outcome the hold: the reds line of the usage above): what
# was red, its cause, when it was queued and finished, its PR and merge, and its outcome. A merged
# fix is "fixed" only while nothing it was queued for is red now; red again with the watch's trip
# after the merge is "came back", red the whole time is "still red", and red now with its row routed
# to alert is "alert route" (its watch pages, and the KPI it trips on is not a merge's to clear).
# Counted, never judged.
reds_json() {
  local t="$1" items holds live watches='{}' f n parsed alerted
  items=$(reds_items "$t") || { say "reds: cannot read the queue ($TRIAGE_ITEMS_CMD)"; return 1; }
  parsed=$(red_titles "$items") || return 1
  alerted=$(alert_titles "$items") || return 1
  holds=$(hold_reds "$t" "$items" | jq -cs .)
  live=$(reds_live "$(jq -c '.[]' <<<"$holds")" | sort -u | jq -Rsc 'split("\n") | map(select(. != ""))')
  for f in "$TRIAGE_WATCH_STATE"/*.since; do
    [ -e "$f" ] || continue
    n=${f##*/} n=${n%.since}
    watches=$(jq -c --arg n "$n" --arg s "$(cat "$f")" '. + {($n): ($s | tonumber? // 0)}' <<<"$watches")
  done
  jq -c --argjson live "$live" --argjson w "$watches" --argjson holds "$holds" --argjson clock "$t" \
    --argjson parsed "$parsed" --argjson alerted "$alerted" --argjson h "$((HOLD_HOURS * 3600))" "$JQ_LIB"'
    def title: .title // .task // "";
    ([$holds[].merges[].slug]) as $went
    | ([.[] | select(tagged("red")) | title | select(startswith("fix(hold): "))]) as $held
    | ([.[] | select(tagged("cleanup") and (tagged("red") | not) and (.merged // "") != "")
        | {slug, project: (.project // ""), red: ("cleanup " + (title[0:60])), cause: null, state, queued, finished, pr, merged,
           fix_min: null, cleanup: true,
           outcome: (.slug as $s | if $s | IN($went[]) then "went red"
                     elif any($held[]; contains(" \($s) (")) then "recovered"
                     elif $clock - ((.finished | ep) // 0) < $h then "holding" else "held" end)}]) as $cleanups
    | (.[] | select(tagged("red")) | title as $t
    | ($parsed[$t | gsub("\n"; " ")] // {}) as $r
    | ((" " + (.tags // "") + " ") | capture(" cause:(?<c>[^ ]+) ").c // null) as $cause
    | ([$live[] as $k | select($t | startswith($k))] | length > 0) as $red
    | (.finished | ep) as $fin
    | {slug, project: (.project // ""), red: (if $r.name then "\($r.area) \($r.name)" else $t[0:60] end), cause: $cause, state,
       queued, finished, pr, merged,
       fix_min: (if .merged != null and $fin != null and (.queued | ep) != null then ((($fin - (.queued | ep)) / 60) | floor) else null end),
       outcome: (
         if .state == "queued" then "queued"
         elif .state == "running" or .state == "review" or .state == "waiting" then "fixing"
         elif .merged != null then
           (if $red | not then "fixed"
            elif $t | gsub("\n"; " ") | IN($alerted[]) then "alert route"
            elif $r.area == "watch" and $fin != null and ($w[$r.name] // 0) > $fin then "came back"
            else "still red" end)
         elif .status == "cancelled" then "cancelled"
         elif .pr != null then "needs merge"
         elif .status == "ok" then "cleared"
         else "no fix" end)}), $cleanups[]' <<<"$items"
}

# reds_counts <now> -> the KPI lines: merged fixes whose red is back or never went (reds_unfixed),
# and the median minutes from queued to merged (red_fix_min_p50), ? when the queue cannot be read
reds_counts() {
  local rows
  rows=$(reds_json "$1" | jq -cs .) || { echo "reds_unfixed=?"; echo "red_fix_min_p50=?"; return 0; }
  jq -r --argjson fix "$FIX_SINCE" "$JQ_LIB"'"reds_unfixed=\([.[] | select((.outcome == "still red" or .outcome == "came back")
      and ((.finished | ep) // $fix) >= $fix)] | length)",
    "red_fix_min_p50=\([.[] | .fix_min // empty] | sort | if length == 0 then "?" else .[(length - 1) / 2 | floor] end)"' <<<"$rows"
}

cmd_reds() {
  local json=0 rows
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      --days) REDS_DAYS="${2:?--days needs a count}"; shift ;;
      *) say "usage: fleet-bench reds [--json] [--days N]"; return 2 ;;
    esac
    shift
  done
  [[ "$REDS_DAYS" =~ ^[1-9][0-9]*$ ]] || { say "reds: --days takes a day count"; return 2; }
  rows=$(reds_json "$(now)") || return 1   # reds_json said why
  if [ "$json" = 1 ]; then [ -z "$rows" ] || printf '%s\n' "$rows"; return 0; fi
  [ -n "$rows" ] || { echo "no red fix queued in the last $REDS_DAYS days"; return 0; }
  jq -rs --arg d "$REDS_DAYS" '
    def words: group_by(.outcome) | map("\(length) \(.[0].outcome)") | join(", ");
    map(select(.cleanup | not)) as $f | map(select(.cleanup)) as $c
    | (if $f == [] then empty else "\($f | length) red fix\(if ($f | length) == 1 then "" else "es" end) in \($d)d: \($f | words)" end),
    (if $c == [] then empty else "\($c | length) cleanup merge\(if ($c | length) == 1 then "" else "s" end) in \($d)d: \($c | words)" end),
    "", "| item | red | outcome | queued | fix min | PR |", "|---|---|---|---|---|---|",
    (.[] | "| \(.slug) | \(.red) | \(.outcome) | \(.queued // "-" | .[0:16]) | \(.fix_min // "-") | \(.pr // "-") |")' <<<"$rows"
}

# triage_retire <dry> -> closes each check(watch) or fix(hold) row nobody started whose key left
# reds_live, so a recovered fault stops reading as a red; if it comes back, triage files it again.
# Only a reading that says "not red" closes a row. These stay open: every row when the queue or the
# board cannot be read, a watch whose probe could not run (ERROR), every hold row when a repo's runs
# could not be read, and a ci- hold whose merge has left the REDS_DAYS window hold_reds reads. A row
# that fails to close is said and tried again next pass: retiring never stops new reds being filed.
# Leaves the count in TRIAGE_RETIRED.
triage_retire() {
  local dry=$1 t items holds holds_read=1 live board slugs title raw key
  local shape='^(check\(watch\): [^ ]+ tripped since|fix\(hold\): [^ ]+ went red)'
  local merge='after cleanup merges? ([^ ]+) \('
  TRIAGE_RETIRED=0
  [ -d "$TRIAGE_WATCH_STATE" ] || return 0
  t=$(now)
  items=$(reds_items "$t") || return 0
  holds=$(hold_reds "$t" "$items") || holds_read=0
  live=$({ reds_live "$holds"; watch_keys ERROR; } | tr '[:upper:]' '[:lower:]')
  board=$($BENCH_NOTES_CMD ptask "$KPI_BOARD" --agent list) || { say "retire: $KPI_BOARD agent board unreadable"; return 0; }
  slugs=$(jq -r '.[].slug' <<<"$items")
  while IFS=$'\t' read -r _ _ title raw; do
    [[ $title =~ $shape ]] || continue
    key=${BASH_REMATCH[1]}
    [[ $raw == '- [ ]'* ]] && ! grep -qxF -- "$key" <<<"$live" || continue
    if [[ $key == 'fix(hold): '* ]]; then
      [ "$holds_read" = 1 ] || continue
      if [[ $key == 'fix(hold): ci-'* ]]; then
        [[ $raw =~ $merge ]] && grep -qxF -- "${BASH_REMATCH[1]}" <<<"$slugs" || continue
      fi
    fi
    if [ "$dry" = 1 ]; then echo "retire: $key"; TRIAGE_RETIRED=$((TRIAGE_RETIRED + 1)); continue; fi
    if $BENCH_NOTES_CMD ptask "$KPI_BOARD" --agent done "$key" --proof "run:fleet-bench-triage-$(date -d "@$t" +%F)" >/dev/null; then
      TRIAGE_RETIRED=$((TRIAGE_RETIRED + 1))
    else
      say "retire: could not close $key"
    fi
  done <<<"$board"
}

cmd_triage() {
  local rows filed dry=0 q h text re route skill fix tags key extra
  case "${1:-}" in
    "") ;;
    --dry-run) dry=1 ;;
    --route)
      # The route table as a query, one row key an argument: the Schedules tab's triage column.
      shift
      for key in "$@"; do
        triage_shape "${key%% *}" "${key#* }"
        if triage_line "$text"; then
          printf '%s\t%s\t%s\t%s\n' "$key" "$route" "$skill" "$tags"
        else
          printf '%s\t-\t-\t\n' "$key"
        fi
      done
      return 0
      ;;
    --coverage)
      rows=$(triage_coverage)
      [ -z "$rows" ] || { echo "$rows"; return 1; }
      return 0
      ;;
    *) say "usage: fleet-bench triage [--dry-run|--coverage|--route <key>...]"; return 2 ;;
  esac
  rows=$({ triage_rows; triage_log_rows; triage_red_rows; triage_hold_rows; } | grep .)
  # A liveness hold row is the same red as the watch's own row, with its suspects named: one fix.
  grep -q '^fix(hold): liveness-' <<<"$rows" && rows=$(grep -v '^check(watch): fleet-liveness tripped since' <<<"$rows")
  [ -n "$rows" ] && rows=$(triage_route "$rows")
  if [ "$dry" = 1 ]; then
    [ -z "$rows" ] || awk -F'\t' '{ print $2, $3 ($4 == "-" ? "" : " (" $4 ")") }' <<<"$rows"
    triage_retire 1
    return 0
  fi
  triage_retire 0
  if [ -z "$rows" ]; then
    say "no runner, unit, watch or log error at fault"
    if [ "$TRIAGE_RETIRED" -gt 0 ]; then report_outcome WORKED "$TRIAGE_RETIRED recovered rows closed"
    else report_outcome NOOP "no runner, unit, watch or log error at fault"; fi
    return 0
  fi
  filed=$(triage_filed "$rows")
  if [ -n "$filed" ]; then board_upsert "$(cut -f1-3 <<<"$filed")" || return 1; else UPSERT_ADDED=0; UPSERT_EDITED=0; fi
  h=$(triage_human "$rows"$'\n'"$(triage_spent "$rows")")
  q=$(triage_promote "$rows")
  extra=$(printf '%s' "$([ "$q" -gt 0 ] && echo "$q queued as red fixes")${h:+$([ "$h" -gt 0 ] && echo " $h for the human")}$([ "$TRIAGE_RETIRED" -gt 0 ] && echo " $TRIAGE_RETIRED recovered rows closed")" | sed 's/^ //')
  upsert_report "$rows" "$extra"
}

# Findings: conclusions that want a decision, reached by rules over counted facts, every machine
# included. fleet-assess decides for this box alone; these read the pool and the other hosts too.
# On 2026-10-29 the pool queue was an hour old at 09:30, local runs starved from 13:00 and merges
# collapsed at 14:20; the human found it at 19:59, because nothing read any of these for a decision.

FINDING_METRICS='cc:host_load1|cc:host_cores|cc:host_cpu_busy_ratio|cc:host_local_queued|cc:pool_waiting|cc:pool_busy|cc:pool_slots|cc:pool_oldest_wait_seconds'
# A rule whose series is missing cannot fire, so its absence must not read as healthy. cc:pool_oldest_wait_seconds
# is left out: it is only there while something waits.
FINDING_REQUIRED='["cc:host_load1","cc:host_cores","cc:host_cpu_busy_ratio","cc:host_local_queued","cc:pool_waiting","cc:pool_busy","cc:pool_slots"]'
FINDING_SAMPLE_S=600   # snapshots this far apart: the sampler's cadence, so "on 2 samples" holds on replay
# Starting points set from the 10-29 replay; kpi-thresholds overrides any of them.
FINDING_DEFAULTS='{"finding_queued_min":5,"finding_local_idle_min":0.3,"finding_pool_wait_s":3600,
  "finding_pool_idle_share":0.75,"finding_merge_ratio":0.5,"finding_demand_ratio":0.7,"finding_merge_floor_h":2,
  "finding_host_load_per_core":2,"finding_clear_min":60,"finding_human_after_min":60}'

finding_limits() {
  local file='{}'
  [ -r "$KPI_THRESHOLDS" ] && file=$(grep -E '^finding_[a-z_]+=' "$KPI_THRESHOLDS" | kv_json)
  jq -cn --argjson d "$FINDING_DEFAULTS" --argjson f "$file" '$d + ($f | with_entries(select(.value != null)))'
}

# prom_match_rows -> cc:pool_match_{slots,busy,runners} per pool and cc:pool_match_labels "<pool>/<label sets>":
# the slots that can take the jobs the pool has long waited on. A job runs only on a runner holding all
# its labels (GitHub compares them without case), so a pool's total busy/slots says nothing about a
# job that fits two of its ten runners (2026-11-05: razer-laptop-unity-pool-1/2 were the only ones that
# matched while mac-studio slots sat idle). The join is hub_core::ci, the one copy the hub and agent-web
# draw too; this only asks it. Empty when nothing waits long or it is unread: the rule then falls back
# to the pool's own totals. It reads Prometheus now, which is the newest sample the one reader of this asks for.
prom_match_rows() {
  $BENCH_CI_MATCH_CMD "$(finding_limits | jq -r .finding_pool_wait_s)" 2>/dev/null
}

# prom_rows <epoch> [match] -> metric, label, value (tab-separated) at that moment; rc 1 when unreadable.
# "match" adds the cc:pool_match_* rows, which only the newest sample of a finding reads.
# BENCH_PROM_TSV is a recorded series (metric, label, epoch, value), so a replay needs no server.
prom_rows() {
  local t="$1" out
  if [ -n "${BENCH_PROM_TSV:-}" ]; then
    out=$(awk -F'\t' -v t="$t" -v old="$FINDING_SAMPLE_S" '$3 <= t && $3 > t - old { v[$1 "\t" $2] = $4 }
      END { for (k in v) print k "\t" v[k] }' "$BENCH_PROM_TSV")
  else
    out=$(prom_q "{__name__=~\"$FINDING_METRICS\"}" "$t" | jq -r '.data.result[]
      | [.metric.__name__, (.metric.host // .metric.pool // "-"), (.value[1] | tonumber)] | @tsv') || return 1
    # Which repos' jobs wait in each pool, as "<pool>/<repo>": a starved pool holds only the work
    # that feeds it. Unread, a starved pool names no repos, and whoever reads it must assume all.
    out+=$'\n'$(prom_q "count by (pool, repo) ($W (github_actions_job_waiting{stuck!=\"true\"}))" "$t" |
      jq -r '.data.result[] | select(.metric.pool and .metric.repo) | ["cc:pool_waiting_repo", "\(.metric.pool)/\(.metric.repo)", (.value[1] | tonumber)] | @tsv' 2>/dev/null)
    [ -n "${2:-}" ] && out+=$'\n'$(prom_match_rows)
    out=$(grep . <<<"$out")
  fi
  [ -n "$out" ] && printf '%s\n' "$out"
}

# prom_snapshot <epoch> [match] -> {metric: {label: value}}; rc 1 when unreadable
prom_snapshot() {
  local rows
  rows=$(prom_rows "$@") || return 1
  jq -Rn 'reduce (inputs | split("\t")) as $r ({}; .[$r[0]][$r[1]] = ($r[2] | tonumber))' <<<"$rows"
}

# merge_rows <until> [since] -> project, merge epoch (tab-separated) for each project sampled in that
# time, default 24h. A project whose merges cannot be read prints "!project": no repo in the map, or a
# failed fetch, whose old refs would otherwise read as no merges. A name the map lacks is an app inside
# a repo (project-name.sh resolves a bnb-platform worktree to its app) or a progress line written before
# rows carried their project, a worktree's `<repo>-<slug>`: the longest spelling in the name index
# (project_index_json) it starts with names it, and its merges count under that name.
merge_rows() {
  local until="$1" since="${2:-$(($1 - 86400))}" p path head
  if [ -n "${BENCH_MERGES_TSV:-}" ]; then cat "$BENCH_MERGES_TSV"; return; fi
  [ -s "$PROGRESS" ] || return 0
  [ -r "$BENCH_PROJECT_MAP" ] || { echo '!project-map'; return 0; }
  while read -r p path; do
    [ -n "$path" ] || { printf '!%s\n' "$p"; continue; }
    head=$(git -C "$path" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) || head=origin/main
    if ! timeout 30 git -C "$path" fetch -q origin "${head#origin/}" 2>/dev/null; then printf '!%s\n' "$p"; continue; fi
    git -C "$path" log "$head" --first-parent --since="$since" --until="$until" --format=%ct | sed "s/^/$p\t/"
  done < <(jq -rn --argjson since "$since" --slurpfile m "$BENCH_PROJECT_MAP" \
      --argjson idx "$(PROJECT_MAP_FILE="$BENCH_PROJECT_MAP" project_index_json)" '
    ($m[0].paths | to_entries | map({key: .value, value: .key}) | from_entries) as $path
    | [$idx | to_entries[] | {b: .key, p: ($path[.value] // "")} | select(.b != "" and .p != "")] as $bases
    | [inputs | select(.epoch >= $since) | .project | select(. != "")] | unique
    | [.[] | . as $n | ($path[$idx[$n | ascii_downcase] // $n] // "") as $direct
       | if $direct != "" then "\($n) \($direct)"
         else ([$bases[] | select(.b as $b | $n | ascii_downcase | startswith($b + "-"))] | max_by(.b | length)) as $hit
           | if $hit then "\($hit.b) \($hit.p)" else "\($n) " end end] | unique[]' "$PROGRESS")
}

# finding_facts <now> -> everything the rules read, as one object; a source that could not be read is
# null. Demand is the time average of live sessions, so a straggler on an empty project is not a full load.
finding_facts() {
  local t="$1" s0 s1 s2 merges live='' src=/dev/null
  s0=$(prom_snapshot "$t" match) && s1=$(prom_snapshot $((t - FINDING_SAMPLE_S))) && s2=$(prom_snapshot $((t - 2 * FINDING_SAMPLE_S))) \
    || s0='null' s1='null' s2='null'
  merges=$(merge_rows "$t")
  [ -s "$PROGRESS" ] && src=$PROGRESS
  live=$(jq -c --argjson since $((t - 86400)) --argjson t "$t" \
    'select(.epoch > $since and .epoch <= $t and (.bucket == "WORKING" or .bucket == "STALLED")) | {epoch, project}' "$src") || return 1
  jq -cn --argjson t "$t" --argjson s0 "$s0" --argjson s1 "$s1" --argjson s2 "$s2" --arg m "$merges" \
      --argjson every "$FINDING_SAMPLE_S" --slurpfile p <(printf '%s\n' "$live") '
    def avg_live($span): map(select(.epoch > $t - $span)) | length * $every / $span;
    ($m | split("\n") | map(select(. != "") | split("\t"))) as $rows
    | {t: $t, prom: [$s0, $s1, $s2],
       unfetched: [$rows[] | select(.[0] | startswith("!")) | .[0][1:]],
       merges: ($rows | map(select(.[0] | startswith("!") | not)) | group_by(.[0]) | map({key: .[0][0], value: map(.[1] | tonumber)}) | from_entries),
       live: ($p | group_by(.project) | map({key: .[0].project, value: {avg_24h: avg_live(86400), avg_2h: avg_live(7200)}}) | from_entries)}'
}

# finding_rows <facts> -> one object per rule firing now. Pure: the same facts give the same rows.
finding_rows() {
  jq -c --argjson l "$(finding_limits)" --argjson required "$FINDING_REQUIRED" "$JQ_LIB"'
    def pct: . * 100 | round;
    def row($rule; $scope; $class; $numbers; $window; $source; $conclusion; $cost):
      {rule: $rule, scope: $scope, decision_class: $class, evidence: {numbers: $numbers, window: $window, source: $source},
       conclusion: $conclusion, cost: $cost};
    .t as $t | .prom as $p | .
    | ( .unfetched[] | row("blind"; "merges:\(.)"; "report"; {}; "now"; "git log";
          "merges for \(.) unreadable (no mapped repo, or the fetch failed), so throughput-drop is off for it"; "") ),
      ( if $p[0] == null then row("blind"; "prom"; "report"; {}; "now"; "prometheus";
          "prometheus unreadable, so starved and host-overload are off"; "") else empty end ),
      ( select($p[0] != null) | $p[0] as $a | $required[] | select($a[.] == null)
        | row("blind"; "prom:\(.)"; "report"; {}; "now"; "prometheus"; "\(.) is missing, so the rules that read it are off"; "") ),
      ( select($p[0] != null) | $p[0] as $a | $p[1] as $b | $p[2] as $c
        | ( ($a["cc:host_local_queued"] // {}) | to_entries[] | .key as $h | .value as $q
            | (($b["cc:host_local_queued"][$h]) // 0) as $q1 | ($a["cc:host_cpu_busy_ratio"][$h]) as $busy
            | select($q >= $l.finding_queued_min and $q1 >= $l.finding_queued_min
                     and $busy != null and (1 - $busy) > $l.finding_local_idle_min)
            | row("starved"; $h; "shepherd"; {queued: $q, idle: (1 - $busy | pct)}; "2 samples"; "cc:host_local_queued, cc:host_cpu_busy_ratio";
                "\($q) local runs queued with the CPU \(1 - $busy | pct)% idle: a slot limit binds, not the machine"; "\($q) runs waiting") ),
          ( ($a["cc:pool_oldest_wait_seconds"] // {}) | to_entries[] | .key as $pool | .value as $w
            | (($a["cc:pool_waiting"][$pool]) // 0) as $n | ($a["cc:pool_busy"][$pool]) as $u | ($a["cc:pool_slots"][$pool]) as $s
            | select($w >= $l.finding_pool_wait_s and $n > 0)
            | ([($a["cc:pool_waiting_repo"] // {}) | keys[] | select(startswith($pool + "/")) | ltrimstr($pool + "/")]
               | if length > 0 then . else null end) as $repos
            # The slots that can take the waiting jobs, when the reader could tell: the other slots of
            # the pool may lack their labels, so its total busy/slots says nothing about those jobs.
            | ($a["cc:pool_match_slots"][$pool]) as $ms | ($a["cc:pool_match_busy"][$pool]) as $mu | ($a["cc:pool_match_runners"][$pool]) as $mr
            | ([($a["cc:pool_match_labels"] // {}) | keys[] | select(startswith($pool + "/")) | ltrimstr($pool + "/")] | first) as $want
            | (if $ms != null and $mu != null then {u: $mu, s: $ms} else {u: $u, s: $s} end) as $k
            # bind: capacity when the slots that fit are full, labels when slots sit free, none can
            # take the job, or the jobs carry no pool label (pool "other": pinned to one host, say), so
            # more sessions add no demand to it.
            | (if $pool == "other" or ($ms != null and $k.s == 0 and $mr == 0) or ($k.u != null and $k.s != null and $k.s > 0 and ($k.u / $k.s) < $l.finding_pool_idle_share)
               then "labels" else "capacity" end) as $bind
            # Jobs pinned to a host (a host-<name> label) wait on the slots of that host by choice:
            # with those all busy, no label or admission is wrong.
            | ($pool == "other" and $ms != null and $ms > 0 and $mu >= $ms
               and (($want // "") | split(" | ") | length > 0 and all(.[]; test("(^|,)host-")))) as $pinned
            | row("starved"; "pool:\($pool)"; "shepherd"; {waiting: $n, busy: $k.u, slots: $k.s, oldest_s: $w}
                + (if $ms != null then {pool_busy: $u, pool_slots: $s, labels: $want} else {} end); "now"; "cc:pool_*";
                "oldest job waited \($w | dur) with \($k.u // "?")/\($k.s // "?") slots busy"
                + (if $ms != null then " among those matching its labels (\($want // "?")), \($u // "?")/\($s // "?") in the pool" else "" end) + ": "
                + (if $pinned then "the jobs are pinned to a host, so the slots of the pin bind, not the pool" elif $bind == "labels" then "admission or labels bind, not capacity" else "demand is over the \(if $ms != null then "matching slots'"'"'" else "pool'"'"'s" end) capacity" end);
                "\($n) jobs waiting") + {repos: $repos, bind: $bind} ),
          ( ($a["cc:host_load1"] // {}) | to_entries[] | .key as $h | .value as $v | ($a["cc:host_cores"][$h]) as $n
            | select($n != null and $n > 0)
            | [$v, ($b["cc:host_load1"][$h]), ($c["cc:host_load1"][$h])] as $vs
            | select(($vs | all(. != null and . / $n >= $l.finding_host_load_per_core)))
            | row("host-overload"; $h; "report"; {load: $v, cores: $n, per_core: ($v / $n | round1)}; "3 samples"; "cc:host_load1, cc:host_cores";
                "load \($v | round1) on \($n) cores for 20m (\($v / $n | round1)x)"; "") ) ),
      ( .unfetched as $u | .live as $live | .merges | to_entries[] | .key as $proj | .value as $e
        | select(($u | index($proj)) == null) | ($live[$proj]) as $d
        | ($e | map(select(. > $t - 86400 and . <= $t)) | length / 24) as $base
        | ($e | map(select(. > $t - 7200 and . <= $t)) | length / 2) as $now
        | select($d != null and $base >= $l.finding_merge_floor_h and $now < $l.finding_merge_ratio * $base
                 and $d.avg_2h >= $l.finding_demand_ratio * $d.avg_24h)
        | row("throughput-drop"; $proj; "human"; {merges_h_2h: $now, merges_h_24h: ($base | round1), live_2h: ($d.avg_2h | round1), live_24h: ($d.avg_24h | round1)};
            "2h against 24h"; "git log --first-parent, progress.jsonl";
            "merges \($now)/h against \($base | round1)/h with sessions still working (\($d.avg_2h | round1) live, usual \($d.avg_24h | round1)): something between gate and merge binds";
            "\(($base - $now) * 2 | round) merges behind in 2h") )' <<<"$1"
}

# finding_stamp <now> -> rows on stdin with their episode. An episode is the time a rule first fired
# for a scope, and it outlives a gap shorter than finding_clear_min, so a rule that flickers is one
# episode and a recurrence is a new one. The fact is what the ledger pages once.
finding_stamp() {
  local t="$1" prior=/dev/null
  [ -s "$FINDINGS" ] && prior=$FINDINGS
  jq -c --argjson t "$t" --argjson l "$(finding_limits)" --slurpfile p "$prior" "$JQ_LIB"'
    ($p | map(select(.epoch < $t and .epoch >= $t - $l.finding_clear_min * 60)) | group_by([.rule, .scope])
     | map(max_by(.epoch) | {key: "\(.rule)/\(.scope)", value: .}) | from_entries) as $last
    | ($last["\(.rule)/\(.scope)"].episode // $t) as $ep
    | . + {epoch: $t, at: ($t | iso), episode: $ep, fact: "\(.rule) \(.scope) @\($ep)"}
    | if (.rule == "starved" or .rule == "host-overload") and $t - $ep >= $l.finding_human_after_min * 60
      then .decision_class = "human" else . end'
}

# finding_blind <scope> <source> <conclusion> -> one unstamped row, for a source no rule could read
finding_blind() {
  jq -cn --arg s "$1" --arg src "$2" --arg c "$3" \
    '{rule: "blind", scope: $s, decision_class: "report", evidence: {numbers: {}, window: "now", source: $src}, conclusion: $c, cost: ""}'
}

# findings_run <now>: evaluate and append. Never fails the sample that calls it, and a failed evaluation
# leaves a row, because no rows is what a healthy pass looks like.
findings_run() {
  local facts rows
  mkdir -p "$DIR"
  { facts=$(finding_facts "$1") && [ -n "$facts" ] && rows=$(finding_rows "$facts" | finding_stamp "$1"); } \
    || rows=$(finding_blind findings "fleet-bench" "the rules could not be evaluated, so nothing here is a healthy read" | finding_stamp "$1")
  [ -z "$rows" ] || printf '%s\n' "$rows" >> "$FINDINGS"
  printf '%s\n' "$1" > "$FINDINGS_PASS"
}

# findings_open <now> -> the newest row of each finding still inside its episode, worst class first. A
# store nobody has evaluated lately says so first, because its emptiness is not health.
findings_open() {
  local t="$1" limits last store=/dev/null
  limits=$(finding_limits)
  [ -s "$FINDINGS" ] && store=$FINDINGS
  last=$(cat "$FINDINGS_PASS" 2>/dev/null)
  if [ $((t - ${last:-0})) -gt "$(jq '.finding_clear_min * 60 | floor' <<<"$limits")" ]; then
    finding_blind sampler "findings.last" "no evaluation since $(jq -rn --argjson e "${last:-0}" "$JQ_LIB"'$e | if . == 0 then "ever" else hm end'), so this list is not current" | finding_stamp "$t"
  fi
  jq -cn --argjson t "$t" --argjson l "$limits" --slurpfile f "$store" '
    $f | map(select(.epoch <= $t)) | group_by([.rule, .scope]) | map(max_by(.epoch))
    | map(select($t - .epoch <= $l.finding_clear_min * 60))
    | sort_by(({human: 0, shepherd: 1, report: 2}[.decision_class]), .episode) | .[]'
}

cmd_findings() {
  case "${1:-}" in
    --run) findings_run "$(now)"; return ;;
    --json) findings_open "$(now)"; return ;;
    ""|--open) ;;
    *) say "usage: fleet-bench findings [--open|--json|--run]"; return 2 ;;
  esac
  local rows
  rows=$(findings_open "$(now)")
  [ -n "$rows" ] || { echo "findings: none open"; return 0; }
  jq -r "$JQ_LIB"'[.decision_class, .rule, .scope, "since \(.episode | hm)", .conclusion + (if .cost != "" then " (\(.cost))" else "" end)] | @tsv' <<<"$rows" |
    awk -F'\t' '{ printf "%-8s %-15s %-24s %-15s %s\n", $1, $2, $3, $4, $5 }'
}

# The loop: what answered each finding. A finding of class human goes on the human's page once (the
# ledger's escalate records it as paged); what the fleet did about it is a response: asked,
# filed-row, cancelled or fixed. An episode that reached class human with nothing but pages is dark:
# the loop saw it and nothing acted. On 2026-11-05 starved pools paged from 23:31 to 06:07 and no
# pass did anything else, which no number showed.
RESPONSE_ACTIONS="paged asked filed-row cancelled fixed"
LOOP_WINDOW_S=$((7 * 86400))   # the KPI table's 7d

cmd_respond() {
  local fact="${1:-}" actor="${2:-}" action="${3:-}" ref="${4:-}"
  if ! [[ "$fact" =~ ^[a-z-]+\ [^\ ]+\ @[0-9]+$ ]] || [ -z "$actor" ] || [[ " $RESPONSE_ACTIONS " != *" $action "* ]]; then
    say "usage: fleet-bench respond '<rule> <scope> @<episode>' <actor> <${RESPONSE_ACTIONS// /|}> [ref]"
    return 2
  fi
  mkdir -p "$DIR"
  jq -cn --argjson t "$(now)" --arg f "$fact" --arg a "$actor" --arg x "$action" --arg r "$ref" \
    '{epoch: $t, fact: $f, actor: $a, action: $x, ref: $r}' >> "$RESPONSES"
}

# loop_episodes <now> <since> -> one object per finding episode begun since <since> and seen on two
# samples or more (one is noise, as fleet-lead reads it), report class left out: when it reached class
# human, its responses, minutes from the episode to its first response that is not a page, whether
# it still fires, and dark.
loop_episodes() {
  local f=/dev/null r=/dev/null
  [ -s "$FINDINGS" ] && f=$FINDINGS
  [ -s "$RESPONSES" ] && r=$RESPONSES
  jq -cn --argjson t "$1" --argjson since "$2" --argjson l "$(finding_limits)" --slurpfile f "$f" --slurpfile r "$r" '
    ($r | map(select(.epoch <= $t)) | group_by(.fact) | map({key: .[0].fact, value: .}) | from_entries) as $resp
    | $f | map(select(.decision_class != "report" and .episode >= $since and .epoch <= $t)) | group_by(.fact)[]
    | select(length > 1)
    | (map(select(.decision_class == "human")) | min_by(.epoch) | .epoch?) as $human
    | ($resp[.[0].fact] // []) as $rs
    | ($rs | map(select(.action != "paged")) | min_by(.epoch) | .epoch?) as $acted
    | (max_by(.epoch) | .epoch) as $last
    | {fact: .[0].fact, rule: .[0].rule, scope: .[0].scope, episode: .[0].episode, last: $last,
       open: ($t - $last <= $l.finding_clear_min * 60), human_at: $human, responses: ($rs | sort_by(.epoch) | map(.action)),
       first_response_min: (if $acted == null then null else ($acted - .[0].episode) / 60 | round end),
       dark: ($human != null and $acted == null)}'
}

cmd_loop() {
  local t rows
  case "${1:-}" in ""|--json|--firing) ;; *) say "usage: fleet-bench loop [--json|--firing]"; return 2 ;; esac
  t=$(now)
  rows=$(loop_episodes "$t" $((t - LOOP_WINDOW_S))) || return 1
  if [ "${1:-}" = --json ]; then [ -z "$rows" ] || printf '%s\n' "$rows"; return 0; fi
  # The daily briefing's Needs you line: one sentence per dark episode still firing, nothing when none.
  if [ "${1:-}" = --firing ]; then
    [ -z "$rows" ] || jq -rs --argjson t "$t" 'sort_by(.episode)[] | select(.dark and .open)
      | "Finding \(.fact) has been yours for \((($t - .human_at) / 60) | floor)m and still fires, with nothing done but a page. Run fleet-bench loop."' <<<"$rows"
    return 0
  fi
  [ -n "$rows" ] || { echo "loop: no finding episodes in 7d"; return 0; }
  jq -rs "$JQ_LIB"'
    "loop, 7d: \(length) episodes, \(map(select(.dark)) | length) dark (\(map(select(.dark and .open)) | length) still firing), \(map(.first_response_min | numbers) | median | if . == null then "no act recorded" else "first response after \(.)m median" end)",
    (sort_by(.episode)[] | [(if .dark then "DARK" elif .first_response_min != null then "\(.first_response_min)m" else "-" end),
       (if .open then "firing" else "cleared" end), .fact,
       (.responses | if length == 0 then "no response" else join(",") end)] | @tsv)' <<<"$rows" |
    awk -F'\t' 'NR == 1 { print; next } { printf "%-6s %-8s %-40s %s\n", $1, $2, $3, $4 }'
}

# throughput_epoch <text> -> an epoch, from an epoch or anything `date -d` reads
throughput_epoch() { [[ "$1" =~ ^[0-9]+$ ]] && printf '%s' "$1" || date -d "$1" +%s; }

# The before and after any slot, hold or pace change has to state: load and idle are proxies, and the
# outcome is merges per hour and queue wait (dotfiles lessons, 2026-10-30).
cmd_throughput() {
  local from='' to='' snap='null' merges queue=''
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) from=$(throughput_epoch "${2:-}") || return 2; shift 2 ;;
      --to) to=$(throughput_epoch "${2:-}") || return 2; shift 2 ;;
      *) say "usage: fleet-bench throughput [--from T] [--to T]"; return 2 ;;
    esac
  done
  [ -n "$to" ] || to=$(now)
  [ -n "$from" ] || from=$((to - 7200))
  [ "$to" -gt "$from" ] || { say "--to must be after --from"; return 2; }
  snap=$(prom_snapshot "$to") || snap='null'
  merges=$(merge_rows "$to" "$from" | grep -v '^!')
  # The exporter's own quantiles over the jobs finished in 24h; a recorded fixture has none.
  [ -n "${BENCH_PROM_TSV:-}" ] || queue=$(prom_q github_job_queue_seconds "$to" | jq -r '.data.result[] | [.metric.pool, .metric.quantile, .value[1]] | @tsv')
  jq -rn --argjson a "$from" --argjson b "$to" --argjson s "$snap" --arg m "$merges" --arg q "$queue" \
      --rawfile r <(runs_between "$from" "$to") "$JQ_LIB"'
    (($b - $a) / 3600) as $h
    | ($q | split("\n") | map(select(. != "") | split("\t")) | reduce .[] as $x ({}; .[$x[0]][$x[1]] = ($x[2] | tonumber))) as $wait
    | ($r | run_rows) as $runs
    | ($runs | map(select(.res != "pass"))) as $bad
    | "window: \($a | hm) -> \($b | hm) (\($h | round1)h)",
      (if ($runs | length) == 0 then "local runs: none recorded"
       else "local runs: \($runs | length / $h | round1)/h, \($bad | length * 100 / ($runs | length) | round)% not passed, editor \(($runs | map(.s) | add) / 3600 | round1)h, of which on runs not passed \((($bad | map(.s) | add) // 0) / 3600 | round1)h" end),
      ($m | split("\n") | map(select(. != "") | split("\t")) | map(select((.[1] | tonumber) > $a and (.[1] | tonumber) <= $b)) | group_by(.[0])
       | if length == 0 then "merges: none" else "merges/h: " + (map("\(.[0][0]) \(length / $h | round1)") | join(", ")) end),
      (if $s == null then "pool and hosts: prometheus unreadable"
       else ($s["cc:pool_slots"] // {} | keys[] | . as $p | select(($s["cc:pool_slots"][$p] // 0) > 0)
             | "pool \($p): \($s["cc:pool_waiting"][$p] // 0) waiting, \($s["cc:pool_busy"][$p] // 0)/\($s["cc:pool_slots"][$p]) busy"
               + (if $s["cc:pool_oldest_wait_seconds"][$p] then ", oldest \($s["cc:pool_oldest_wait_seconds"][$p] | dur)" else "" end)
               + (if $wait[$p] then ", finished jobs waited p50 \($wait[$p]["0.5"] | dur), p90 \($wait[$p]["0.9"] | dur) (24h)" else "" end)),
            "local: \($s["cc:host_local_queued"].workstation // "-") queued",
            "hosts, load per core: " + ($s["cc:host_load1"] // {} | to_entries | map(select(($s["cc:host_cores"][.key] // 0) > 0) | {k: .key, v: (.value / $s["cc:host_cores"][.key])})
               | map(select(.v >= 0.5)) | sort_by(-.v) | if length == 0 then "all under 0.5x" else map("\(.k) \(.v | round1)x") | join(", ") end)
       end)'
}

# queue_slots -> how many sessions fleet-dispatch keeps live: BENCH_QUEUE_SLOTS, else its conf's
# DISPATCH_TARGET_PRESENT (the pace target while the human is here, the steady state), else the
# default in fleet-dispatch itself. One source, read, never restated.
queue_slots() {
  local n="${BENCH_QUEUE_SLOTS:-}" fd
  [ -n "$n" ] || n=$(sed -n 's/^DISPATCH_TARGET_PRESENT=\([0-9][0-9]*\).*/\1/p' "$BENCH_DISPATCH_CONF" 2>/dev/null | tail -1)
  if [ -z "$n" ] && fd=$(command -v fleet-dispatch); then
    n=$(sed -n 's/^: "\${DISPATCH_TARGET_PRESENT:=\([0-9][0-9]*\)}".*/\1/p' "$fd" | head -1)
  fi
  [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -gt 0 ] && printf '%s' "$n"
}

# forecast_json <now> [queue json lines] [items json lines|"!"] -> one object: the schedule of
# every open phase, the fleet's all-done-by at both ends of the band, the drain against the
# last window's flow, the board rows behind the live work, and the agent queue's items placed
# on the dispatcher's slots ("!" when the queue could not be read, null in .items).
forecast_json() {
  local t="$1" queue="${2:-}" items="${3:-}" live names iphases sc="$SCORES" map=/dev/null slots
  live=$(latest_live)
  [ -s "$sc" ] || sc=/dev/null
  [ -r "$BENCH_PROJECT_MAP" ] && map=$BENCH_PROJECT_MAP
  slots=$(queue_slots) || slots=''
  names=$(jq -r '[.session_id, .plan_file // ""] | @tsv' <<<"$live" | while IFS=$'\t' read -r sid pf; do
      [ -n "$pf" ] && printf '{"%s":%s}\n' "$sid" "$(plan_phase_list "$pf" | jq -c 'map(select(.state == "open") | .name)')"
    done | jq -cs 'add // {}')
  # an item with `phases:` (agent-queue add --plan) counts those; one that only names its plan, its plan's open phases
  iphases=$( [ "$items" = "!" ] || jq -r 'select((.plan // "") != "" and (.phases // "") == "") | [.slug, .plan] | @tsv' <<<"$items" 2>/dev/null \
    | while IFS=$'\t' read -r slug pf; do
        printf '{"%s":%s}\n' "$slug" "$(plan_phase_list "$pf" | jq 'map(select(.state == "open")) | length')"
      done | jq -cs 'add // {}')
  jq -cn --argjson t "$t" --argjson win "$BENCH_WINDOW_H" --slurpfile nm <(printf '%s\n' "$names") --rawfile queue <(printf '%s' "$queue") \
     --rawfile items <(printf '%s' "$items") --argjson ip "${iphases:-"{}"}" --arg slots "$slots" \
     --argjson def "$BENCH_DEFAULT_PHASE_MIN" --argjson minb "$BENCH_BASIS_MIN_N" "${CAL_ARGS[@]}" --slurpfile map "$map" \
     --slurpfile live <(printf '%s\n' "$live") --slurpfile p "$PROGRESS" --slurpfile s "$sc" "$JQ_LIB"'
    $nm[0] as $names
    | ($s | map(select(.done_epoch >= $t - $win * 3600) | .ratio // empty) | median) as $r24
    | ($p | flow($t - $win * 3600; $t)) as $f
    | ($live | schedule($t; $r24 // 1; $names)) as $sch
    | ($sch | map(.left) | add // 0) as $open
    | ($f.out_per_h - $f.net_in_per_h) as $net
    | ($queue | split("\n") | map(select(. != "") | fromjson)) as $q
    | ($p | map(select(.phases_total != null)) | group_by([.session_id, .plan_file]) | map(map(.phases_total) | max) | median) as $ppp
    | {made_epoch: $t, made_at: ($t | iso), slow_ratio: $r24,
       sessions: ($sch | length),
       unscheduled: ($live | map(select((.finished | not) and (.phases_total == null or .eta == null))) | length),
       open: $open}
      + ($sch | fleet_finish)
      + {drain: {out_per_h: $f.out_per_h, in_per_h: $f.net_in_per_h,
                 epoch: (if $net > 0 then ($t + $open / $net * 3600 | floor) else null end)},
         queue: (if $queue == "" then null else {rows: ($q | length), ready: ($q | map(select(.state == "ready")) | length),
                 phases_per_plan: $ppp, phases: (($q | length) * ($ppp // 0) | floor)} end),
         schedule: $sch}
      + {items: (if $items == "!" then null else
          ($items | split("\n") | map(select(. != "") | fromjson)) as $it
          | ($it | map(.slug) | INDEX(.)) as $active
          | ($p | group_by(.project) | map({key: .[0].project,
                value: (group_by([.session_id, .plan_file]) | map(phase_minutes) | add // [])}) | from_entries) as $byp
          | ($byp | [.[]] | add // []) as $every
          | ($s | accuracy($minn; $lo; $hi) | INDEX(.basis)) as $acc
          | ($sch | map({key: (.target | sub(":[0-9]+$"; "")), value: {P: .finish_p50, S: .finish_slow}}) | from_entries) as $onsch
          | ($slots | if . == "" then 1 else tonumber end) as $K
          # seconds a phase takes on each repo with enough measured phases, else the fleet: P as
          # calibrated, S at the slow ratio
          | def pace_of($pp): ($acc[$pp.basis | kind].factor // 1) as $fac
              | {P: ($pp.m * 60 * $fac), S: ($pp.m * 60 * ($r24 // 1)),
                 basis: ($pp.basis + (if $fac != 1 then " x\($fac)" else "" end))};
          ($byp | map_values(select(length >= $minb) | pace_of({m: median, basis: "project-median(\(length))"}))) as $prp
          | (if ($every | length) >= $minb then {m: ($every | median), basis: "fleet-median(\($every | length))"}
             else {m: $def, basis: "default"} end | pace_of(.)) as $flp
          | ($it | map(
              (($map[0].trackers // {})[.project].repo // .project) as $repo
              | ($prp[$repo] // $flp) as $pp
              | (.hold // "") as $h | ($h | sub("^after "; "") | sub(" closed .*$"; "") | split(" ")) as $pars
              | {slug, project, state, mode,
                 phases: ((.phases // "" | [splits(" +")] | map(select(. != "")) | length | select(. > 0)) // $ip[.slug] // (if .mode == "plan" then ($ppp // 1) else 1 end)),
                 P: $pp.P, S: $pp.S, basis: $pp.basis,
                 start: ((.started // .queued) | fromdateiso8601? // $t),
                 live: (if .state == "running" then $onsch[(.session // "") | if test(":") then sub(":"; "/") else "lab/" + . end] else null end),
                 after: (if ($h | startswith("after ")) and all($pars[]; $active[.] != null) then $pars else null end),
                 why: (if .state == "waiting" then "waiting on you"
                       elif .state == "review" then "on a PR"
                       elif ($h | startswith("after ")) and any($pars[]; $active[.] == null) then "after \($pars | join(" ")), which did not finish ok"
                       elif $h != "" and ($h | startswith("after ") | not) then "held: \($h)"
                       else null end)})) as $e
          | ($e | qplace($t; $K; "P")) as $a | ($e | qplace($t; $K; "S")) as $b
          | ($e | map(select(.live == null and $a.placed[.slug] != null)
                      | {slug, project, state, phases, basis, start: $a.placed[.slug].start,
                         p50: $a.placed[.slug].end, slow: $b.placed[.slug].end})) as $rows
          | {count: ($it | length), running: ($it | map(select(.state == "running")) | length),
             queued: ($it | map(select(.state == "queued")) | length),
             review: ($it | map(select(.state == "review")) | length),
             waiting: ($it | map(select(.state == "waiting")) | length),
             slots: $K, slots_known: ($slots != ""), on_schedule: ($e | map(select(.live != null)) | length),
             phases: ($rows | map(.phases) | add // 0),
             finish_p50: ($rows | map(.p50) | max), finish_slow: ($rows | map(.slow) | max),
             not_scheduled: ($e | map(select(.why != null) | {slug, why})
                             + ($a.behind | map({slug: ., why: "behind an item that is not scheduled"}))),
             schedule: ($rows | sort_by(.p50)),
             # when each scheduled item ends, live or placed, and the pace per repo (fleet-bench epics)
             ends: ($e | map(if .live != null then {key: .slug, value: {p50: .live.P, slow: .live.S}}
                             elif $a.placed[.slug] != null then {key: .slug, value: {p50: $a.placed[.slug].end, slow: $b.placed[.slug].end}}
                             else empty end) | from_entries),
             pace: {repos: $prp, fleet: $flp}} end)}'
}

# cmd_forecast [--json] [--queue] [--baseline <label>]: when the live work should be done, and in
# what order. --baseline freezes it into forecasts.jsonl, queue included, for vs to compare.
cmd_forecast() {
  local json=0 withq=0 label='' t fc queue='' items
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --queue) withq=1; shift ;;
      --baseline) label="${2:-}"; [ -n "$label" ] || { say "--baseline needs a label"; return 2; }; withq=1; shift 2 ;;
      *) say "usage: fleet-bench forecast [--json] [--queue] [--baseline <label>]"; return 2 ;;
    esac
  done
  [ -s "$PROGRESS" ] || { say "no samples yet: run fleet-bench sample"; return 1; }
  t=$(now)
  [ "$withq" = 0 ] || queue=$($BENCH_QUEUE_CMD 2>/dev/null) || { say "the dispatch queue could not be read; forecast without it"; queue=''; }
  items=$($BENCH_ITEMS_CMD 2>/dev/null) || { say "the agent queue could not be read; forecast without its items"; items='!'; }
  [ -z "$items" ] || [ "$items" = "!" ] || queue_slots >/dev/null || say "the dispatcher's slot count could not be read; placing queue items on 1 slot"
  fc=$(forecast_json "$t" "$queue" "$items") || return 1
  if [ -n "$label" ]; then
    mkdir -p "$DIR"
    jq -c --arg l "$label" '{label: $l} + .' <<<"$fc" >> "$FORECASTS"
    say "baseline $label frozen in $FORECASTS"
  fi
  if [ "$json" = 1 ]; then printf '%s\n' "$fc"; return 0; fi
  jq -r "$JQ_LIB"'
    "forecast \(.made_epoch | hm): \(.sessions) sessions with a plan, \(.open) phases open"
      + (if .unscheduled > 0 then " (\(.unscheduled) more with no plan or no estimate)" else "" end),
    "  all done by: median \(.median_p50 | hm), p90 \(.p90_p50 | hm), last \(.last_p50 | hm) (each estimate as calibrated)",
    "        slow: median \(.median_slow | hm), p90 \(.p90_slow | hm), last \(.last_slow | hm) (at the last 24h scored ratio, \(.slow_ratio // "none, so 1")x)",
    "  drain: " + (if .drain.epoch != null
      then "\(.drain.epoch | hm) at \(.drain.out_per_h)/h out against \(.drain.in_per_h)/h in (last 24h)"
      else "not draining at current inflow (in \(.drain.in_per_h)/h, out \(.drain.out_per_h)/h): no time until one of them changes" end),
    (if .items == null then "  agent queue: unreadable"
     elif .items.count == 0 then "  agent queue: empty"
     else .items as $i
       | "  agent queue: \($i.count) items (\($i.running) running, \($i.queued) queued, \($i.review) on a PR, \($i.waiting) waiting on you), \($i.phases) phases on \($i.slots) dispatch slots"
         + (if ($i.schedule | length) > 0 then ": all done by \($i.finish_p50 | hm), slow \($i.finish_slow | hm)" else "" end)
         + (if $i.on_schedule > 0 then " (\($i.on_schedule) running already counted above)" else "" end),
         (if ($i.not_scheduled | length) > 0
          then "    not scheduled: \($i.not_scheduled | length): " + ($i.not_scheduled | group_by(.why) | map("\(length) \(.[0].why)") | join(", "))
          else empty end) end),
    (if .queue != null then "  queued after this: \(.queue.rows) board rows (\(.queue.ready) ready to start), about \(.queue.phases) phases at the median \(.queue.phases_per_plan // "-") per plan" else empty end),
    ([(.schedule[] | . as $s | .phases[] | {t: .p50, slow, target: $s.target, name}),
      (.items.schedule // [] | .[] | {t: .p50, slow, target: "queue:\(.project)", name: .slug})] | sort_by(.t)) as $all
    | .made_epoch as $now | ($all | map(select(.t <= $now))) as $due
    | (if ($due | length) > 0 then "  due now, past their estimate: \($due | length) phases in \($due | map(.target) | unique | length) sessions" else empty end),
      "  next phases, in expected order:",
      ($all | map(select(.t > $now)) | .[:10][]
        | "    \(.t | hm)  (slow \(.slow | hm))  \(.target | sub("^[^/]*/"; ""))  \(.name | if length > 70 then .[:67] + "..." else . end)")' <<<"$fc"
}

# progress_since <epoch>: the progress rows from an hour before it on, so a flow from that epoch
# has the sample before it and the 9 MB history is not slurped whole.
progress_since() { jq -c --argjson a "$(($1 - 3600))" 'select(.epoch >= $a)' "$PROGRESS"; }

# baseline_pick [label|latest] -> the newest frozen forecast with that label, or the newest of all
baseline_pick() {
  local l="${1:-latest}"
  [ -s "$FORECASTS" ] || return 1
  jq -cs --arg l "$l" 'map(select($l == "latest" or .label == $l)) | last // empty' "$FORECASTS" | grep .
}

# cmd_vs [<label>|latest] [--json]: a frozen forecast against what the fleet did since
cmd_vs() {
  local json=0 label=latest b t
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      -*) say "usage: fleet-bench vs [<label>|latest] [--json]"; return 2 ;;
      *) label="$1"; shift ;;
    esac
  done
  b=$(baseline_pick "$label") || { say "no baseline $label: freeze one with fleet-bench forecast --baseline <label>"; return 1; }
  t=$(now)
  local v
  v=$(progress_since "$(jq -r .made_epoch <<<"$b")" | jq -cs --slurpfile b <(printf '%s\n' "$b") --argjson t "$t" "$JQ_LIB"'vs($b[0]; $t)') || return 1
  if [ "$json" = 1 ]; then printf '%s\n' "$v"; return 0; fi
  jq -r "$JQ_LIB"'
    "vs baseline \(.label) (frozen \(.made_epoch | hm), \(.hours)h ago)",
    "  ticked: \(.ticked) of the \(.expected) phases expected by now (\(.expected_slow) at the slow end), \(.ticked_all) fleet-wide",
    "  sessions: " + ([("finished", "ahead", "on track", "behind", "gone") as $k | select(.states[$k] != null) | "\(.states[$k]) \($k)"] | join(", ")),
    "  scope: +\(.added) added to baseline plans, -\(.removed) removed, \(.new_plans) new plans in them, \(.started_since) sessions started since",
    "  inflow: \(.in_per_h)/h since against \(.in_per_h_frozen)/h when frozen, out \(.out_per_h)/h",
    (.sessions | map(select(.state == "behind")) | sort_by(-.min) | if length > 0 then "  behind:", (.[] | "    \(.target | sub("^[^/]*/"; "")): \(.ticked) of \(.expected) expected, \(.min)m past due on \(.next)") else empty end),
    (.sessions | map(select(.state == "ahead")) | sort_by(-.min) | if length > 0 then "  ahead:", (.[] | "    \(.target | sub("^[^/]*/"; "")): \(.ticked) of \(.expected) expected, \(.min)m early") else empty end)' <<<"$v"
}

# new_forecast_scores <now> -> a score for each frozen forecast that resolved and has none yet
new_forecast_scores() {
  local t="$1" b k min
  [ -s "$FORECASTS" ] || return 0
  local todo
  todo=$(jq -cs --slurpfile d <(cat "$FORECAST_SCORES" 2>/dev/null) '
    ($d | map("\(.label) \(.made_epoch)")) as $done | .[] | select(("\(.label) \(.made_epoch)") as $k | $done | index($k) | not)' "$FORECASTS")
  [ -n "$todo" ] || return 0
  min=$(jq -s 'map(.made_epoch) | min' <<<"$todo")
  progress_since "$min" | jq -cs --slurpfile todo <(printf '%s\n' "$todo") --argjson t "$t" --argjson hz "$BENCH_FORECAST_HORIZON_H" "$JQ_LIB"'
    . as $p | $todo[] as $b | $p | forecast_score($b; $t; $hz)'
}

# cmd_flow [--from T] [--to T] [--json] [--hourly]: phases in against phases out over a window
cmd_flow() {
  local from='' to='' json=0 hourly=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) from=$(throughput_epoch "${2:-}") || return 2; shift 2 ;;
      --to) to=$(throughput_epoch "${2:-}") || return 2; shift 2 ;;
      --json) json=1; shift ;;
      --hourly) hourly=1; shift ;;
      *) say "usage: fleet-bench flow [--from T] [--to T] [--json] [--hourly]"; return 2 ;;
    esac
  done
  [ -n "$to" ] || to=$(now)
  [ -n "$from" ] || from=$((to - BENCH_WINDOW_H * 3600))
  [ "$to" -gt "$from" ] || { say "--to must be after --from"; return 2; }
  [ -s "$PROGRESS" ] || { [ "$json" = 1 ] && echo null || echo "flow: no samples yet"; return 0; }
  if [ "$json" = 1 ]; then
    jq -cs --argjson a "$from" --argjson b "$to" --argjson hr "$hourly" "$JQ_LIB"'
      flow($a; $b) | if $hr == 1 then . else del(.hourly) end' "$PROGRESS"
    return
  fi
  jq -rs --argjson a "$from" --argjson b "$to" --argjson hr "$hourly" "$JQ_LIB"'
    flow($a; $b) as $f
    | "flow \($a | hm) -> \($b | hm) (\($f.hours | round1)h)",
      "  out: \($f.ticked) phases ticked (\($f.out_per_h)/h)",
      "  in:  \($f.in) phases (\($f.in_per_h)/h): \($f.started) plans started with \($f.started_open) open, \($f.added) added to running plans; \($f.removed) removed by rewrites",
      "  open: \($f.open_start) at start, \($f.open_end) at end\(if $f.dropped > 0 then "; \($f.dropped) left open by plans that ended or were switched away from" else "" end)",
      "  net: " + (($f.out_per_h - $f.net_in_per_h) as $d
        | if $d > 0 then "draining \($d | round2)/h" else "not draining (in \($f.net_in_per_h)/h, out \($f.out_per_h)/h)" end),
      ($f.by_project[] | "  \(.project): \(.ticked) out, \(.in) in, \(.removed) removed"),
      (if $hr == 1 then ($f.hourly[] | "  \(.hour | hm)  +\(.in) -\(.removed) in, \(.ticked) out, scope \(.scope), done \(.done)") else empty end)
  ' "$PROGRESS"
}

# --- canary: a fixed eval set run weekly, so "the agents got better" reads apart from "the task
# mix changed". A task is one merged PR as data in BENCH_CANARY_DIR/<id>.json: {id, project, pr,
# base (the commit before it), merge, task (its row text), accept (the oracle's test names),
# oracle: {paths, cmd}}. The oracle is the PR's own tests, laid over the session's tree from
# merge, so a session can neither see nor edit what scores it. A score row in canary.jsonl is
# {epoch, run, id, project, pr, session_id, harness, model, effort, pass, rc, config}; cost, minutes,
# turns and tokens come from the session's outcome row by session_id, never copied here. A lane is
# a harness, model and effort (null: the harness's own default): the same tasks run under each, so
# lanes compare on equal work. A task may name its `stack` (else its project's, by BENCH_MATRIX);
# its kind is its task text's prefix. The canary_
# KPIs read the claude lane alone (a row without harness is claude), one baseline week to week.

# canary_tasks [id...] -> one compact task a line, by id; every listed id must exist
canary_tasks() {
  local f id
  if [ $# -eq 0 ]; then
    compgen -G "$BENCH_CANARY_DIR/*.json" >/dev/null || return 0
    set -- "$BENCH_CANARY_DIR"/*.json
  else
    for id in "$@"; do
      [ -f "$BENCH_CANARY_DIR/$id.json" ] || { say "canary: no task $id in $BENCH_CANARY_DIR"; return 2; }
    done
    set -- "${@/#/$BENCH_CANARY_DIR/}"; set -- "${@/%/.json}"
  fi
  for f in "$@"; do
    jq -ce 'select((.id | strings) and (.project | strings) and (.base | strings) and (.merge | strings)
                   and (.task | strings) and (.oracle.paths | arrays) and (.oracle.cmd | arrays))' "$f" 2>/dev/null ||
      { say "canary: $f is not a task (id, project, base, merge, task, oracle.paths, oracle.cmd)"; return 2; }
  done
}

canary_task() { canary_tasks "$1"; }
canary_week() { date -d "@$(now)" +%Gw%V; }

# canary_repo <project> -> the project's checkout from the project map, else the caller's repo
canary_repo() {
  local dir
  dir=$(jq -r --arg p "$1" 'first(.paths // {} | to_entries[] | select(.value == $p) | .key) // empty' "$BENCH_PROJECT_MAP" 2>/dev/null)
  [ -n "$dir" ] && [ -d "$dir" ] || dir=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  printf '%s' "$dir"
}

# canary_oracle <task> <tree> <log> -> lays the oracle paths from merge over the tree, runs its
# command there under BENCH_CANARY_TIMEOUT (inside BENCH_CANARY_WRAP when set) and returns its exit
# (98 when the overlay fails: a broken task, not a failed session)
canary_oracle() {
  local merge paths=() cmd=() wrap=()
  merge=$(jq -r .merge <<<"$1")
  mapfile -t paths < <(jq -r '.oracle.paths[]' <<<"$1")
  mapfile -t cmd < <(jq -r '.oracle.cmd[]' <<<"$1")
  git -C "$2" checkout -q "$merge" -- "${paths[@]}" 2>>"$3" || return 98
  [ -z "$BENCH_CANARY_WRAP" ] || wrap=(bash -c "$BENCH_CANARY_WRAP \"\$@\"" oracle)
  (cd "$2" && timeout "$BENCH_CANARY_TIMEOUT" "${wrap[@]}" "${cmd[@]}") >>"$3" 2>&1
}

# canary_brief <task> <slug> [sandboxed] -> the night item's whole task: no /one-shot, no PR (fleet-dispatch
# starts a `canary` item on this text as it is). A run in its harness's own lane sandbox sees its
# worktree alone, so fleet-dispatch runs the start, score and done steps around it and its brief is
# the task alone.
canary_brief() {
  [ -z "${3:-}" ] || { jq -r '
    "Canary eval \(.id): a fixed task from \(.pr // "a merged PR"), run each week to score the fleet. It is not a change to ship: open no PR, push nothing, and read nothing later than that PR (not git log past HEAD, not origin/main, not the PR).",
    "This worktree is already at the commit before that PR, and it is scored by that PR'"'"'s own tests once you end. Your shell sees this worktree and nothing else of the machine.",
    "Do this task here, as you would on main: \(.task)",
    (if (.accept // []) | length > 0 then "Done when these tests pass: \(.accept | join("; ")) (in \(.oracle.paths | join(" ")))." else empty end),
    "Then end the session."' <<<"$1"; return; }
  jq -r --arg slug "$2" '
    "Canary eval \(.id): a fixed task from \(.pr // "a merged PR"), run each week to score the fleet. It is not a change to ship: open no PR, push nothing, touch no board or sheet row, and read nothing later than that PR (not git log past HEAD, not origin/main, not the PR).",
    "1. Run `fleet-bench canary start \(.id)` here: it puts this worktree at the commit before that PR.",
    "2. Do this task there, as you would on main: \(.task)",
    (if (.accept // []) | length > 0 then "   Done when these tests pass: \(.accept | join("; ")) (in \(.oracle.paths | join(" ")))." else empty end),
    "3. Run `fleet-bench canary score \(.id)` once: it lays that PR'"'"'s own tests over your tree, runs them and records the score. Its result is final.",
    "4. agent-queue move \($slug) done --status ok, then wind down (in Claude Code, the wind-down skill; in any other harness, end the session)."' <<<"$1"
}

# canary queue [--harness h [--model m]]: one night item per task for this ISO week, none for a
# task whose item exists in any state, so a second retro the same week queues nothing. `from:
# canary` files no story row. With no flags it is the weekly claude lane; another lane's items are
# canary-<id>-<week>-<h>[-<m>], carrying agent and model for fleet-dispatch to start them on.
# A lane that spends a Claude account queues at high, the queue's working priority: at low it sat
# behind every runnable item, and the week-46 claude run started none of its 14 tasks in 3 nights.
# Another harness's lane stays low: it starts as overflow while its own source has room.
# canary_slug <id> <week> [lane] -> the item slug, built to survive agent-queue's slugify (lowercase,
# a-z0-9 and single dashes, cut at 40): the lane suffix stays whole and the id is what gets shortened,
# so lanes never collapse into one another and `show`, `set` and the brief name the item as stored.
# A lane with an effort ends in its first two letters (me, hi, lo, mi, xh): the whole word would
# leave the id too few letters to tell the tasks apart. For the same reason a claude lane with a model
# is named by the model alone, as the baseline lane names no harness. Retro refuses a lane whose slug
# repeats one before it.
# canary_lane_name <harness> [model] [effort] -> the lane part of the slug, as canary_slug keeps it whole
canary_lane_name() {
  local h=$1; [ "$h" != claude ] || [ -z "$2" ] || h=''
  printf '%s' "$h${2:+${h:+-}$2}${3:+-${3:0:2}}"
}

canary_slug() {
  local id tail
  tail=$(printf '%s' "-$2${3:+-$3}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | tr -s '-')
  id=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | tr -s '-' | sed 's/^-//')
  id=$(printf '%s' "${id:0:$((40 - 7 - ${#tail}))}" | sed 's/-*$//')
  [ -n "$id" ] || return 1
  printf 'canary-%s%s' "$id" "$tail"
}

canary_queue() {
  local tasks t id slug week why lane="" label="" harness="" model="" effort="" prio=high added=0 had=0 off=0
  local -A seen=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --harness) harness="${2:?canary queue: --harness needs a value}"; shift 2 ;;
      --model) model="${2:?canary queue: --model needs a value}"; shift 2 ;;
      --effort) effort="${2:?canary queue: --effort needs a value}"; shift 2 ;;
      *) say "usage: fleet-bench canary queue [--harness h [--model m [--effort e]]]"; return 2 ;;
    esac
  done
  [ -z "$model" ] || [ -n "$harness" ] || { say "canary queue: --model needs --harness"; return 2; }
  [ -z "$effort" ] || [ -n "$model" ] || { say "canary queue: --effort needs --model"; return 2; }
  [ "$harness" != claude ] || [ -z "$model" ] || [ -n "$effort" ] || { say "canary queue: a claude lane needs --effort, which keeps its scores out of the claude baseline"; return 2; }
  [ -z "$harness" ] || { lane=$(canary_lane_name "$harness" "$model" "$effort"); label="$harness${model:+/$model}${effort:+@$effort}"; }
  [ -z "$harness" ] || [ "$harness" = claude ] || prio=low
  tasks=$(canary_tasks) || return 1
  [ -n "$tasks" ] || return 0   # no set yet: nothing to run, and nothing to say on every retro
  week=$(canary_week)
  # A harness lane replays only the tasks its harness may run: with a project allowlist (ocfree:
  # public input only) only those projects', and with a malformed one nothing, since fleet-dispatch
  # would refuse every one on every pass. A claude lane, and a harness the map lacks (fleet-dispatch
  # refuses it at start), are held by no list here.
  local held='' sbx=''
  if [ -n "$harness" ] && [ "$harness" != claude ] &&
    jq -e --arg h "$harness" '.harnesses[$h] | type == "object"' "$BENCH_HARNESSES" >/dev/null 2>&1; then
    held=1
    # A harness in its own lane sandbox: fleet-dispatch runs the steps around it by the item's canary id.
    sbx=$(jq -r --arg h "$harness" '.harnesses[$h].sandbox // empty' "$BENCH_HARNESSES")
    why=$(harness_project_why "$BENCH_HARNESSES" "$harness" "")
    [ $? != 2 ] || { say "canary: $label queues nothing: $why"; return 1; }
  fi
  while IFS= read -r t; do
    id=$(jq -r .id <<<"$t")
    [ -z "$held" ] || harness_project_why "$BENCH_HARNESSES" "$harness" "$(jq -r '.project // ""' <<<"$t")" >/dev/null ||
      { off=$((off + 1)); continue; }
    slug=$(canary_slug "$id" "$week" "$lane") || { say "canary: lane '$lane' leaves no room for $id in a 40-char slug"; return 1; }
    [ -z "${seen[$slug]:-}" ] || { say "canary: $id and ${seen[$slug]} share the slug $slug"; return 1; }
    seen[$slug]=$id
    if $BENCH_CANARY_QUEUE_CMD show "$slug" >/dev/null 2>&1; then had=$((had + 1)); continue; fi
    $BENCH_CANARY_QUEUE_CMD add --project "$(jq -r .project <<<"$t")" --from canary --tags 'night canary' \
      --priority "$prio" --weight light ${harness:+--agent "$harness"} --slug "$slug" --title "check(canary): $id $week${label:+ $label}" \
      -- "$(canary_brief "$t" "$slug" "$sbx")" >/dev/null || { say "canary: could not queue $slug"; return 1; }
    [ -z "$model$sbx" ] || $BENCH_CANARY_QUEUE_CMD set "$slug" ${model:+"model=$model"} ${effort:+"effort=$effort"} ${sbx:+"canary=$id"} >/dev/null ||
      { say "canary: queued $slug, but could not set its model and canary id"; return 1; }
    added=$((added + 1))
  done <<<"$tasks"
  local note=''; [ "$off" = 0 ] || note=", $off outside $harness's projects"
  say "canary: $added queued, $had already queued$note for $week${label:+ ($label)}"
}

# canary_queue_lanes: the week's run on each lane in BENCH_CANARY_LANES (`harness model [effort]` a
# line, # comments), when the source its harness spends from (harnesses.json `source`) has room by
# BENCH_ROOM_CMD; a lane with no source or no room is said and skipped, so retro never queues a run
# its source cannot carry. A claude lane spends a Claude account, so it asks for any with room, as a
# start does. Returns 1 when any lane could not be queued.
canary_queue_lanes() {
  local h m e src why label lane rc=0
  local -A lanes=()
  [ -r "$BENCH_CANARY_LANES" ] || return 0
  while read -r h m e _ <&3 || [ -n "$h" ]; do
    [ -n "$h" ] && [ "${h:0:1}" != "#" ] || continue
    label="$h${m:+/$m}${e:+@$e}" lane=$(canary_lane_name "$h" "$m" "$e")
    if [ -n "${lanes[$lane]:-}" ]; then say "canary: $label not queued, its slug is ${lanes[$lane]}'s"; continue; fi
    lanes[$lane]=$label
    if [ "$h" = claude ]; then
      if ! why=$($BENCH_ROOM_CMD 2>&1); then say "canary: $label not queued, no Claude account has room${why:+: $why}"; continue; fi
    else
      src=$(jq -r --arg h "$h" '.harnesses[$h].source // empty' "$BENCH_HARNESSES" 2>/dev/null)
      if [ -z "$src" ]; then say "canary: $label not queued, $h has no source in $BENCH_HARNESSES"; continue; fi
      if ! why=$($BENCH_ROOM_CMD --source "$src" 2>&1); then say "canary: $label not queued, ${why:-$src has no room}"; continue; fi
    fi
    canary_queue --harness "$h" ${m:+--model "$m"} ${e:+--effort "$e"} || rc=1
  done 3<"$BENCH_CANARY_LANES"
  return "$rc"
}

# canary_lane -> {harness, model, effort, session_id} of the run scoring now: harness, model and effort from its
# queue item (fleet-dispatch records what it started), else codex when CODEX_THREAD_ID is set, else
# claude. The session is that harness's own id, else the newest one claimed on the item.
canary_lane() {
  local it=null
  [ -z "${AGENT_QUEUE_ITEM:-}" ] || it=$($BENCH_CANARY_QUEUE_CMD show "$AGENT_QUEUE_ITEM" --json 2>/dev/null | jq -ce objects) || it=null
  jq -nc --argjson it "$it" --arg cx "${CODEX_THREAD_ID:-}" --arg cl "${CLAUDE_CODE_SESSION_ID:-}" '
    def nz: if . == "" then null else . end;
    ($it.agent // (if $cx != "" then "codex" else "claude" end)) as $h
    | {harness: $h, model: ($it.model // null | nz), effort: ($it.effort // null | nz),
       session_id: ((if $h == "claude" then $cl elif $h == "codex" then $cx else "" end | nz)
                    // ($it.sessions // "" | split(" ") | map(select(length > 0)) | last))}'
}

# canary start <id>: the session's own worktree, clean, moved to the task's base (detached)
canary_start() {
  local t top base
  t=$(canary_task "${1:?usage: fleet-bench canary start <id>}") || return 2
  top=$(git rev-parse --show-toplevel 2>/dev/null) || { say "canary start: not in a git worktree"; return 2; }
  base=$(jq -r .base <<<"$t")
  git -C "$top" cat-file -e "$base^{commit}" 2>/dev/null || { say "canary start: $top has no commit $base"; return 2; }
  [ -z "$(git -C "$top" status --porcelain)" ] || { say "canary start: $top has uncommitted changes"; return 2; }
  git -C "$top" checkout -q --detach "$base" || return 1
  printf 'canary %s: %s is at %s\n%s\n' "$1" "$top" "${base:0:10}" "$(jq -r .task <<<"$t")"
}

# canary score <id>: run the oracle over the session's tree and append one score row. A run is the
# queue item ($AGENT_QUEUE_ITEM) or the task and week, and it scores once: a second score is refused.
canary_score() {
  local t top run log rc=0 cfg r repos lane
  t=$(canary_task "${1:?usage: fleet-bench canary score <id>}") || return 2
  top=$(git rev-parse --show-toplevel 2>/dev/null) || { say "canary score: not in a git worktree"; return 2; }
  run=${AGENT_QUEUE_ITEM:-canary-$1-$(canary_week)}
  if [ -s "$CANARY" ] && jq -e --arg r "$run" 'select(.run == $r)' "$CANARY" >/dev/null 2>&1; then
    say "canary score: $run is already scored"; return 3
  fi
  mkdir -p "$DIR/canary"; log="$DIR/canary/$run.log"; : >"$log"
  canary_oracle "$t" "$top" "$log" || rc=$?
  [ "$rc" != 98 ] || { say "canary score: the oracle could not be laid over $top (log $log)"; return 1; }
  IFS=: read -ra repos <<<"$BENCH_CANARY_CONFIG_REPOS"
  cfg=$(for r in "${repos[@]}"; do
          printf '%s\t%s\n' "$(basename "$r")" "$(git -C "$r" rev-parse --short=12 HEAD 2>/dev/null || echo null)"
        done | jq -Rn '[inputs | split("\t") | {key: .[0], value: .[1]}] | from_entries')
  lane=$(canary_lane)
  jq -nc --argjson t "$t" --argjson e "$(now)" --arg run "$run" --argjson rc "$rc" --argjson l "$lane" \
    --argjson cfg "$cfg" '{epoch: $e, run: $run, id: $t.id, project: $t.project, pr: ($t.pr // null),
      session_id: $l.session_id, harness: $l.harness, model: $l.model, effort: $l.effort, pass: ($rc == 0), rc: $rc, config: $cfg}' >>"$CANARY"
  printf 'canary %s: %s (exit %s), log %s\n' "$1" "$([ "$rc" = 0 ] && echo pass || echo fail)" "$rc" "$log"
}

# canary verify [id...]: each oracle must fail at base and pass at merge, in a throwaway worktree
# of the project's checkout; exit 1 when any does not (a task that cannot score anything)
canary_verify() {
  local tasks t id repo tmp log b m bad=0 root
  tasks=$(canary_tasks "$@") || return 2
  [ -n "$tasks" ] || { say "canary: no tasks in $BENCH_CANARY_DIR"; return 2; }
  root="${XDG_CACHE_HOME:-$HOME/.cache}/fleet-bench/canary-verify"; mkdir -p "$root"
  while IFS= read -r t; do
    id=$(jq -r .id <<<"$t")
    repo=$(canary_repo "$(jq -r .project <<<"$t")") || { echo "BAD $id: no checkout of $(jq -r .project <<<"$t")"; bad=1; continue; }
    tmp="$root/$id"; log="$root/$id.log"; : >"$log"
    git -C "$repo" worktree remove --force "$tmp" 2>/dev/null; rm -rf "$tmp"
    git -C "$repo" worktree add -q --detach "$tmp" "$(jq -r .base <<<"$t")" 2>>"$log" || { echo "BAD $id: no worktree at base"; bad=1; continue; }
    b=0; canary_oracle "$t" "$tmp" "$log" || b=$?
    git -C "$tmp" checkout -q -f --detach "$(jq -r .merge <<<"$t")" 2>>"$log" && git -C "$tmp" clean -qfd
    m=0; canary_oracle "$t" "$tmp" "$log" || m=$?
    git -C "$repo" worktree remove --force "$tmp"
    if [ "$b" -ne 0 ] && [ "$b" -ne 98 ] && [ "$m" -eq 0 ]; then echo "ok $id: base exit $b, merge passes"
    else echo "BAD $id: base exit $b, merge exit $m (log $log)"; bad=1; fi
  done <<<"$tasks"
  return "$bad"
}

# canary list [--by harness,model] [--json]: each task with its newest score, or with --by one row
# per lane: runs, tasks covered, pass rate, and per run its minutes, turns, cost and tokens from the
# session's outcome row (a plan login has tokens and no cost)
canary_list() {
  local tasks by="" json=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --by) by="${2:?canary list: --by needs harness,model}"; shift 2 ;;
      --json) json=1; shift ;;
      *) say "usage: fleet-bench canary list [--by harness,model] [--json]"; return 2 ;;
    esac
  done
  [ -z "$by" ] || [ "$by" = harness,model ] || { say "canary list: --by takes harness,model"; return 2; }
  if [ -n "$by" ]; then canary_lanes "$json"; return; fi
  tasks=$(canary_tasks) || return 2
  jq -nc --slurpfile k "$(kpi_canary)" --rawfile ts <(printf '%s' "$tasks") '
    $ts | split("\n") | map(select(length > 0) | fromjson) | map(. as $x
      | [$k[] | select(.id == $x.id)] as $rs | ($rs | max_by(.epoch)) as $l
      | {id, project, pr, last_run: ($l.run // null), last_pass: ($l.pass // null), runs: ($rs | length)}) | .[]' |
    if [ -n "$json" ]; then cat; else
      jq -r '"\(.id)\t\(.pr // "-")\t\(.runs) runs\t\(if .last_run == null then "never scored" else "\(.last_run): \(if .last_pass then "pass" else "fail" end)" end)"'
    fi
}

# canary_lanes [json] -> one row per harness, model and effort over every score, joined to outcome rows.
# same_tasks are the tasks a lane shares with the claude lane (canary_base, as the canary_ KPIs
# read it): its pass rate and claude's over just those, each the mean of per-task pass rates so a
# task claude re-ran every week weighs one, the like-for-like comparison; null on a claude row.
canary_lanes() {
  jq -nc --slurpfile k "$(kpi_canary)" --slurpfile o <(outcomes_newest) "$JQ_LIB"'
    def mean(f): map(f | numbers) | if length == 0 then null else add / length end;
    def passed: map(select(.pass == true)) | length;
    def per_task($i): map(select(.id == $i)) | passed / length;   # a task weighs one, however many weeks ran it
    ($o | INDEX(.session_id)) as $os
    | [$k[] | select(canary_base)] as $base
    | ($base | map(.id) | unique) as $bt
    | $k | group_by([.harness // "claude", .model // "", .effort // ""]) | map(
        [.[] | . as $r | {pass, id, o: $os[$r.session_id // ""]}] as $rs
        | any(.[]; canary_base) as $isbase
        | (map(.id) | unique | map(select(IN($bt[])))) as $st
        | {harness: (.[0].harness // "claude"), model: (.[0].model // null), effort: (.[0].effort // null), runs: length,
           tasks: (map(.id) | unique | length), pass_rate: ratio(($rs | passed); length),
           same_tasks: (if $isbase then null else ($st | length) end),
           pass_rate_same: (if $isbase then null else (. as $l | $st | map(. as $i | $l | per_task($i)) | mean(.) | if . then round2 else . end) end),
           claude_pass_rate_same: (if $isbase then null else ($st | map(. as $i | $base | per_task($i)) | mean(.) | if . then round2 else . end) end),
           joined: ($rs | map(select(.o)) | length),
           min_per_run: ($rs | mean(.o.duration_s) | if . then . / 60 | round1 else . end),
           turns_per_run: ($rs | mean(.o.activity.api_messages) | if . then round1 else . end),
           cost_per_run: ($rs | mean(.o.cost_usd) | if . then round1 else . end),
           tokens_per_run: ($rs | mean(.o.tokens_total) | if . then round else . end)}) | .[]' |
    if [ -n "$1" ]; then cat; else
      jq -r '"\(.harness)/\(.model // "-")\(if .effort then "@\(.effort)" else "" end)\t\(.runs) runs\t\(.tasks) tasks\tpass \(.pass_rate // "-")\(if .same_tasks == null then "" else "\tsame \(.same_tasks): pass \(.pass_rate_same // "-") vs claude \(.claude_pass_rate_same // "-")" end)\t\(.joined) joined\t\(.min_per_run // "-") min\t\(.turns_per_run // "-") turns\t$\(.cost_per_run // "-")\t\(.tokens_per_run // "-") tokens"'
    fi
}

# canary_lanes_section: the canary lanes table, in the scorecard
canary_lanes_section() {
  local j
  echo "## Canary lanes"
  echo
  echo "Every lane that scored on the fixed canary set (\`fleet-bench canary list --by harness,model\`). Same is the tasks a lane shares with the claude lane, and its pass rate beside claude's on just those: the like-for-like number a lane graduates on. Minutes, turns, cost and tokens are per run, from the session's outcome row."
  echo
  j=$(canary_lanes json) || { echo "- canary lanes: ? (scores or outcomes unreadable)"; return 0; }
  [ -n "$j" ] || { echo "- canary lanes: no scores yet"; return 0; }
  echo "| Lane | Runs | Tasks | Pass | Same | Pass on same | Claude on same | Min | Turns | Cost | Tokens |"
  echo "|---|---|---|---|---|---|---|---|---|---|---|"
  jq -r 'def d: if . == null then "-" else tostring end;
    "| \(.harness)/\(.model // "-")\(if .effort then "@\(.effort)" else "" end) | \(.runs) | \(.tasks) | \(.pass_rate | d) | \(.same_tasks | d) | \(.pass_rate_same | d) | \(.claude_pass_rate_same | d) | \(.min_per_run | d) | \(.turns_per_run | d) | \(if .cost_per_run == null then "-" else "$\(.cost_per_run)" end) | \(.tokens_per_run | d) |"' <<<"$j"
}

# canary matrix [--harness h] [--days N] [--json]: the task matrix for one harness (default codex),
# from BENCH_MATRIX. A kind-by-stack cell counts that harness's canary scores on tasks of the kind and
# stack, and its own items done in the last N days (default 30; canaries come in by score, not item):
# a pass is a passed score or an item closed ok; a fail is a failed score or an item closed failed,
# except an end that says nothing about the model (UNRATED_ENDS). Proven
# is a pass, failing is fails and no pass, excluded is BENCH_MATRIX's why, no work is a cell no item
# on any harness touched in the window, empty is the rest. A kind and scope are a row's type and area from
# `notes row parse`, the grammar's one home (agent-queue add records them on an item); an untyped one is in
# no cell. Each mode is mode_of's test on the item
# (interactive: the harness's own outcome rows no item claims, a pass when it merged a PR; forgejo: a
# project whose checkout mirrors to GitHub from Forgejo, as fleet-dispatch forge_canonical reads it).
MATRIX_JQ='
  def kind_of: if tagged("research") then "research" else .type // null end;
  def stack_of($m): (.stack // null) as $own | (.area // null) as $sc | .project as $p
    | $own // first($m.stacks | to_entries[] | select(($sc != null) and ((.value.scopes // []) | index($sc))) | .key)
      // first($m.stacks | to_entries[] | select(.value.projects | index($p)) | .key) // null;
  def verdict: if .status == "ok" then "pass" elif .status == "failed" and (unrated | not) then "fail" else null end;
  def mode_of($os): [
    (select(.mode == "oneshot" and (tagged("night") | not) and (tagged("red") | not)) | "oneshot"),
    (select(tagged("night")) | "night"), (select(tagged("red")) | "red"), (select(.mode == "plan") | "plan"),
    (select((" " + (.tags // "")) | test(" ask:")) | "ask-resume"),
    (select((.salvage // "") != "") | "salvage-resume"),
    (select((.sessions // "") | split(" ") | any(. as $s | $os[$s] | select(.harness == $h) | (.uses.subagents // {}) | length > 0)) | "fan-out"),
    (select(.project as $p | $forgejo | index($p)) | "forgejo")];
  def cell($rs): {pass: ($rs | map(select(.v == "pass")) | length), fail: ($rs | map(select(.v == "fail")) | length),
    evidence: ($rs | map(select(.v)) | sort_by(.at) | last | .ref // null)};
  def status($c; $ex; $work): if $ex then "excluded" elif $c.pass > 0 then "proven" elif $c.fail > 0 then "failing"
    elif $work == 0 then "no work" else "empty" end;
  ($items | map(select(.from != "canary"))) as $all
  | ($o | INDEX(.session_id)) as $os
  | ($ts | map({key: .id, value: {kind: kind_of, stack: stack_of($m)}}) | from_entries) as $tk
  | ([$k[] | select((.harness // "claude") == $h and (.epoch // 0) >= ($since + "T00:00:00Z" | fromdateiso8601))
      | . as $r | $tk[$r.id] | select(.)
      | {kind, stack, v: (if $r.pass then "pass" else "fail" end), at: ($r.epoch | todate), ref: $r.run}]) as $scores
  | ([$all[] | select((.agent // "claude") == $h)
      | {kind: kind_of, stack: stack_of($m), modes: mode_of($os), v: verdict, at: (.finished // ""), ref: .slug}]) as $live
  | ($all | map({kind: kind_of, stack: stack_of($m)})) as $demand
  | ($all | map(.sessions // "" | split(" ")[]) | map(select(. != "")) | INDEX(.)) as $claimed
  | ([$o[] | select(.harness == $h and ($claimed[.session_id // ""] | not))
      | {v: (if (.prs_merged // 0) > 0 then "pass" else null end), at: (.updated // ""), ref: .session_id}]) as $hand
  | def excluded($kind; $stack; $mode): first($m.excluded[]? | select((.kind // null) == $kind and (.stack // null) == $stack
      and (.mode // null) == $mode)) // first($m.excluded[]? | select(.stack == null and .mode == null and .kind == $kind and $stack != null))
      // first($m.excluded[]? | select(.kind == null and .mode == null and .stack == $stack and $kind != null)) // null;
  {harness: $h, since: $since, kinds: $m.kinds, stacks: ($m.stacks | keys_unsorted),
   cells: [$m.kinds[] as $kd | $m.stacks | keys_unsorted[] as $st
     | (($scores + $live) | map(select(.kind == $kd and .stack == $st))) as $rs | cell($rs) as $c
     | excluded($kd; $st; null) as $ex
     | {kind: $kd, stack: $st} + $c + {status: status($c; $ex; ($demand | map(select(.kind == $kd and .stack == $st)) | length)), why: ($ex.why // null)}],
   modes: [$m.modes[] as $md
     | (if $md == "interactive" then $hand else $live | map(select(.modes | index($md))) end) as $rs | cell($rs) as $c
     | excluded(null; null; $md) as $ex
     | {mode: $md} + $c + {status: status($c; $ex; 1), why: ($ex.why // null)}],
   excluded: [$m.excluded[]? | select((.kind // null) as $x | ($m.kinds | index($x)) | not) | select(.stack == null or .kind != null)]}'

# The matrix json's renderers share these: a cell's mark with its passes of runs, and the empty count.
MATRIX_FMT_JQ='def mark: {proven: "P", failing: "F", excluded: "X", "no work": "-", empty: "."}[.status]
    + (if .pass + .fail > 0 then " \(.pass)/\(.pass + .fail)" else "" end);
  def empties: [.cells[], .modes[] | select(.status == "empty")] | length; '

canary_matrix() {
  local h=codex days=30 json="" since tasks parsed items forgejo p dir
  while [ $# -gt 0 ]; do
    case "$1" in
      --harness) h="${2:?canary matrix: --harness needs a value}"; shift 2 ;;
      --days) days="${2:-}"; [[ "$days" =~ ^[1-9][0-9]*$ ]] || { say "canary matrix: --days takes a whole number"; return 2; }; shift 2 ;;
      --json) json=1; shift ;;
      *) say "usage: fleet-bench canary matrix [--harness h] [--days N] [--json]"; return 2 ;;
    esac
  done
  jq -e '(.kinds | arrays) and (.stacks | objects) and (.modes | arrays)' "$BENCH_MATRIX" >/dev/null 2>&1 ||
    { say "canary matrix: $BENCH_MATRIX is not a matrix (kinds, stacks, modes)"; return 2; }
  since=$(date -u -d "@$(( $(now) - days * 86400 ))" +%F)
  tasks=$(canary_tasks) || return 2
  # A task's kind and scope, as an item's, are its row's type and area: one `notes row parse` of each first line.
  if [ -n "$tasks" ]; then
    parsed=$(jq -r '.task | split("\n")[0]' <<<"$tasks" | notes row parse) &&
      tasks=$(jq -cn --rawfile p <(printf '%s\n' "$parsed") --rawfile t <(printf '%s\n' "$tasks") '
        ($t | split("\n") | map(select(length > 0) | fromjson)) as $t | ($p | split("\n") | map(select(length > 0) | split("\t"))) as $p
        | if ($p | length) != ($t | length) then error("short") else range($t | length) as $i
          | $t[$i] + if $p[$i][3] == "1" then {type: $p[$i][0], area: ($p[$i][1] | if . == "-" then null else . end)} else {} end end') ||
      { say "canary matrix: notes row parse failed or answered short (an old notes? notes-bootstrap --build-only)"; return 1; }
  fi
  items=$($BENCH_DONE_ITEMS_CMD --since "$since" 2>/dev/null | jq -c 'if type == "array" then .[] else . end') ||
    { say "canary matrix: the done items could not be read"; return 1; }
  forgejo=$(jq -r --slurpfile is <(printf '%s\n' "$items") '($is | map(.project) | unique) as $ps
              | .paths // {} | to_entries[] | select(.value as $p | $ps | index($p)) | "\(.key)\t\(.value)"' "$BENCH_PROJECT_MAP" 2>/dev/null |
            while IFS=$'\t' read -r dir p; do forge_canonical "$dir" && printf '%s\n' "$p"; done | jq -Rsc 'split("\n") | map(select(. != "")) | unique')
  jq -n --arg h "$h" --arg since "$since" --slurpfile m "$BENCH_MATRIX" --slurpfile k "$(kpi_canary)" --argjson forgejo "$forgejo" \
    --slurpfile o <(outcomes_newest | jq -c --arg since "$since" 'select((.updated // "") >= $since)') \
    --slurpfile items <(printf '%s\n' "$items") \
    --rawfile tsr <(printf '%s' "$tasks") \
    "$JQ_LIB"'($tsr | split("\n") | map(select(length > 0) | fromjson)) as $ts | $m[0] as $m | '"$MATRIX_JQ" |
    if [ -n "$json" ]; then cat; else canary_matrix_text; fi
}

# canary_matrix_section: the codex task matrix, in the scorecard
canary_matrix_section() {
  local j
  echo "## Task matrix"
  echo
  echo "Codex on every kind by stack, then each run mode (\`fleet-bench canary matrix\`, from \`~/.config/fleet-bench/matrix.json\`, a private file for its project names). P proven, F failing, X excluded, - no work on any harness in 30 days, . empty; n/m is passes of runs, from canary scores and Codex items."
  echo
  j=$(canary_matrix --json 2>/dev/null) || { echo "- task matrix: ? (matrix, scores or items unreadable)"; return 0; }
  jq -r "$MATRIX_FMT_JQ"'.cells as $cs | .stacks as $st
    | "| Kind | \($st | join(" | ")) |", "|---\($st | map("|---") | join(""))|",
      (.kinds[] as $k | "| \($k) | \([$cs[] | select(.kind == $k) | mark] | join(" | ")) |"),
      "", "| Mode | Status | Pass | Fail | Newest |", "|---|---|---|---|---|",
      (.modes[] | "| \(.mode) | \(.status) | \(.pass) | \(.fail) | \(.evidence // .why // "-") |"),
      "", "Excluded: \([.excluded[] | "\(.kind // .mode) (\(.why))"] | join("; ")). Empty cells: \(empties)."' <<<"$j"
}

# canary_matrix_text: the matrix json as a grid (P proven, F failing, X excluded, - no work, . empty)
# with the modes and the exclusions beneath; the scorecard prints the same in markdown
canary_matrix_text() {
  jq -r "$MATRIX_FMT_JQ"'.cells as $cs
    | "\(.harness) since \(.since): P proven, F failing, X excluded, - no work, . empty; n/m is passes of runs",
      (["kind"] + .stacks | join("\t")),
      (.kinds[] as $k | [$k] + [$cs[] | select(.kind == $k) | mark] | join("\t")),
      "",
      (.modes[] | "mode \(.mode)\t\(.status)\t\(.pass) pass \(.fail) fail\(if .evidence then "\t\(.evidence)" else "" end)\(if .why then "\t\(.why)" else "" end)"),
      (.excluded[] | "excluded \(.kind // .mode)\t\(.why)"),
      "empty: \(empties)"'
}

# canary_dream [--days N] [--json] -> one row per model dream's sweeps ran on over the last N days
# (default 14), from agentctl-dream's trial.tsv (date, project, model, session, cost, verdict,
# lessons added, memory refused): sweeps, cost and lessons added per sweep, the share with a memory
# refused, the share FAILED or STALLED. No file yet is an empty answer, so the writer can land later.
canary_dream() {
  local days=14 json="" since
  while [ $# -gt 0 ]; do
    case "$1" in
      --days) days="${2:-}"; [[ "$days" =~ ^[1-9][0-9]*$ ]] || { say "canary dream: --days takes a whole number"; return 2; }; shift 2 ;;
      --json) json=1; shift ;;
      *) say "usage: fleet-bench canary dream [--days N] [--json]"; return 2 ;;
    esac
  done
  [ -r "$DREAM_TRIAL" ] || { say "canary dream: no sweeps recorded yet ($DREAM_TRIAL)"; return 0; }
  since="$(date -u -d "@$(( $(now) - days * 86400 ))" +%F)"
  jq -Rnc --arg since "$since" "$JQ_LIB"'
    [inputs | split("\t") | select(length >= 8 and .[0] >= $since)
     | {model: .[2], cost: ((.[4] | tonumber?) // null), verdict: .[5],
        lessons: ((.[6] | tonumber?) // 0), refused: ((.[7] | tonumber?) // 0)}]
    | group_by(.model) | map(
        (map(.cost | select(. != null))) as $c
        | {model: .[0].model, sweeps: length, costed: ($c | length), cost_per_sweep: ratio($c | add // 0; $c | length),
           lessons_per_sweep: ratio(map(.lessons) | add; length),
           refused_share: ratio(map(select(.refused > 0)) | length; length),
           stalled_share: ratio(map(select(.verdict == "FAILED" or .verdict == "STALLED")) | length; length)}) | .[]' "$DREAM_TRIAL" |
    if [ -n "$json" ]; then cat; else
      jq -r '"\(.model)\t\(.sweeps) sweeps\t$\(.cost_per_sweep // "-")/sweep over \(.costed)\tlessons/sweep \(.lessons_per_sweep // "-")\trefused \(.refused_share // "-")\tfailed or stalled \(.stalled_share // "-")"'
    fi
}

# canary_shepherd [--days N] [--json] -> one row per model the shepherd's passes ran on over the
# last N days (default 7), from the lane columns fleet-shepherd's lane_cols appends to passes.tsv
# (model, nudges, survived, missed, wrong parks, parks; read by position here): passes,
# NOOP share, the nudges they made and the share that moved their session (no escalation due by
# the next run), lines left unhandled per pass, and parks made on a clear machine of all parks.
# Rows from before the lane columns are left out. Promote the canary model only on equal scores.
canary_shepherd() {
  local days=7 json="" since
  while [ $# -gt 0 ]; do
    case "$1" in
      --days) days="${2:-}"; [[ "$days" =~ ^[1-9][0-9]*$ ]] || { say "canary shepherd: --days takes a whole number"; return 2; }; shift 2 ;;
      --json) json=1; shift ;;
      *) say "usage: fleet-bench canary shepherd [--days N] [--json]"; return 2 ;;
    esac
  done
  [ -r "$SHEPHERD_PASSES" ] || { say "canary shepherd: no $SHEPHERD_PASSES"; return 1; }
  since="$(date -u -d "@$(( $(now) - days * 86400 ))" '+%F %H:%M')"
  jq -Rnc --arg since "$since" "$JQ_LIB"'
    [inputs | split("\t") | select(length >= 10 and .[0] >= $since and .[4] != "")
     | {verdict: .[2], model: .[4], nudges: (.[5] | tonumber), survived: (.[6] | tonumber),
        missed: (.[7] | tonumber), wrong: (.[8] | tonumber), parks: (.[9] | tonumber)}]
    | group_by(.model) | map(
        (map(.nudges) | add) as $n | (map(.parks) | add) as $p
        | {model: .[0].model, passes: length, noop_share: ratio(map(select(.verdict == "NOOP")) | length; length),
           nudges: $n, progress_share: ratio($n - (map(.survived) | add); $n),
           missed_per_pass: ratio(map(.missed) | add; length), wrong_parks: (map(.wrong) | add), parks: $p}) | .[]' "$SHEPHERD_PASSES" |
    if [ -n "$json" ]; then cat; else
      jq -r '"\(.model)\t\(.passes) passes\tnoop \(.noop_share // "-")\t\(.nudges) nudges\tprogress \(.progress_share // "-")\tmissed/pass \(.missed_per_pass // "-")\twrong parks \(.wrong_parks)/\(.parks)"'
    fi
}

cmd_canary() {
  case "${1:-}" in
    list) shift; canary_list "$@" ;;
    shepherd) shift; canary_shepherd "$@" ;;
    dream) shift; canary_dream "$@" ;;
    verify) shift; canary_verify "$@" ;;
    queue) shift; canary_queue "$@" ;;
    start) shift; canary_start "$@" ;;
    score) shift; canary_score "$@" ;;
    matrix) shift; canary_matrix "$@" ;;
    *) say "usage: fleet-bench canary list [--by harness,model] [--json] | verify [id...] | queue [--harness h [--model m [--effort e]]] | start <id> | score <id> | matrix [--harness h] [--days N] [--json] | shepherd [--days N] [--json] | dream [--days N] [--json]"; return 2 ;;
  esac
}

# usage: the verb list at the top of this file, through the line before its State note
usage() { awk 'NR > 1 { if (/^# State is/) exit; print }' "$0"; }

# epic_plans -> one JSON line per plan whose `epic:` line names an epic: {file, epic, phases}.
# The dirs in BENCH_PLAN_DIRS are read in order and the first file of a name wins, so a plan in
# ~/.claude/plans beats its ~/.agent/plans cache copy.
epic_plans() {
  local d f e seen=" " dirs
  IFS=: read -ra dirs <<<"$BENCH_PLAN_DIRS"
  for d in "${dirs[@]}"; do
    [ -d "$d" ] || continue
    while IFS= read -r f; do
      case "$seen" in *" ${f##*/} "*) continue ;; esac
      seen+="${f##*/} "
      e=$(plan_epic "$f"); [ -n "$e" ] || continue
      jq -cn --arg f "$f" --arg e "$e" --argjson ph "$(plan_phase_list "$f")" '{file: $f, epic: $e, phases: $ph}'
    done < <(grep -rl --include='*.md' '^epic:' "$d" 2>/dev/null | sort)
  done
}

# epic_projects -> one JSON line per project with its roadmap: {name, profile, dir, rm, ideas,
# briefs}. A project whose roadmap cannot be read is left out and named on stderr.
epic_projects() {
  local stats name profile dir ideas briefs
  stats=$($BENCH_PROJECTS_CMD 2>/dev/null | jq -ce 'arrays') || return 1
  while IFS=$'\t' read -r name profile dir; do
    ideas=$(grep -c '^- \[ \]' "$dir/ideas.md" 2>/dev/null) || ideas=0
    briefs=$(for f in "$dir"/docs/briefs/*.md; do
        [ -f "$f" ] && jq -cn --arg f "$f" --arg e "$(brief_epic "$f")" '{file: $f, epic: $e}'
      done | jq -cs .)
    # the roadmap goes in on stdin: a big project's is past the length of one argument
    $BENCH_ROADMAP_CMD "$name" --json 2>/dev/null \
      | jq -ce --arg n "$name" --arg p "$profile" --arg d "$dir" --argjson i "$ideas" --argjson b "$briefs" \
          'arrays | {name: $n, profile: $p, dir: $d, rm: ., ideas: $i, briefs: $b}' \
      || say "epics: no roadmap for $name"
  done < <(jq -r '.[] | [.name, .profile // "", .dir // ""] | @tsv' <<<"$stats")
}

# epic_scores -> every epic score, oldest first (each project's outcomes/<p>/epics/scores.jsonl)
epic_scores() {
  local f
  for f in "$BENCH_OUTCOMES_DIR"/*/epics/scores.jsonl; do [ -s "$f" ] && cat "$f"; done
}

# epics_json <now> -> one object: per project its flow counts, unlinked lists, ETA accuracy and
# epics; per epic its brief, plans and phases, leaf rows, items, PRs, the derived step, an ETA
# for open work, the newest frozen baseline, on track or behind, and its score once landed.
# An open leaf whose item is on the forecast takes that item's end; the rest (the open leaves
# with no scheduled item, or the plan phases no active item carries, whichever is more) run one
# after another, after the agent queue drains, at the repo's calibrated phase pace.
epics_json() {
  local t="$1" pj items active plans fc=null map=/dev/null
  pj=$(epic_projects | jq -cs .) || return 1
  [ "$pj" != "[]" ] || { say "epics: no project could be read"; return 1; }
  items=$($BENCH_ALL_ITEMS_CMD 2>/dev/null | jq -cs .) || { say "epics: the agent queue could not be read"; items='[]'; }
  active=$(jq -c '.[] | select(.state != "done")' <<<"$items")
  plans=$(epic_plans | jq -cs .)
  if [ -s "$PROGRESS" ]; then
    fc=$(forecast_json "$t" "" "$active" | jq -c '.items') || fc=null
  fi
  [ -r "$BENCH_PROJECT_MAP" ] && map=$BENCH_PROJECT_MAP
  # the big inputs go in as files: the projects alone are past the length of one argument
  jq -cn --argjson t "$t" --slurpfile pj <(printf '%s\n' "$pj") --slurpfile items <(printf '%s\n' "$items") \
     --slurpfile plans <(printf '%s\n' "$plans") \
     --slurpfile fc <(printf '%s\n' "$fc") --slurpfile map "$map" --slurpfile base <(cat "$EPIC_BASELINES" 2>/dev/null) \
     --slurpfile sc <(epic_scores) "${CAL_ARGS[@]}" "$JQ_LIB$PLAN_ITEMS_JQ"'
    ($map[0] // {}) as $map | $pj[0] as $pj | $items[0] as $items | $plans[0] as $plans
    | $fc[0] as $fc
    | ($base | group_by([.project, .epic]) | map({key: "\(.[0].project)/\(.[0].epic)",
        value: (sort_by(.made_epoch) | last + {n: length})}) | from_entries) as $B
    | ($sc | map({key: "\(.project)/\(.epic)", value: .}) | from_entries) as $S
    | ($sc | accuracy($minn; $lo; $hi) | INDEX(.basis)) as $acc
    | ($items | map(select((.row // "") | test(":"))) | group_by(.row) | map({key: .[0].row, value: .}) | from_entries) as $byrow
    | ($items | map(select(.state != "done"))) as $act
    | {made_epoch: $t, made_at: ($t | iso),
       projects: [$pj[] | . as $P
      | ([$P.rm[].epics[]] | unique_by(.id) | map(. + {state: "open"})) as $open
      | ([$P.rm[].closed_epics[]] | unique_by(.id) | map(. + {state: "closed"})) as $closed
      | ([$P.rm[].rows[]] | unique_by(.id)) as $rows
      | (($open + $closed) | map(.id)) as $E
      | ($rows | INDEX(.id)) as $R
      # a leaf climbs its #of/ links to the epic above it, three levels at most (story, subtask)
      | def up($id; $n): ($R[$id].parent // "") as $p
          | if $p == "" then null elif ($E | index($p)) != null then $p elif $n > 0 then up($p; $n - 1) else null end;
      ($rows | map(. + {epic: up(.id; 2)})) as $lv
      | (($map.trackers // {})[$P.name].repo // $P.name) as $repo
      | (if $fc == null then null else ($fc.pace.repos[$repo] // $fc.pace.fleet) end) as $pace
      | [($open + $closed)[] | . as $e | "\($P.name)/\($e.id)" as $k
        | ($lv | map(select(.epic == $e.id))) as $er
        | ($er | map(. as $r | $byrow["\($P.name):\($r.id)"] // [] | .[]
                     | {slug, state, pr: (.pr // null), row: $r.id})) as $ei
        | ($plans | map(select(.epic == $e.id)) | map(. as $pl
            | ($act | map(select(names_plan($pl.file))) | length) as $na
            | {file, done: (.phases | map(select(.state != "open")) | length), total: (.phases | length),
               open: (.phases | map(select(.state == "open") | .name)), queued: $na})) as $ep
        | ($P.briefs | map(select(.epic == $e.id)) | first | .file // null) as $brief
        | ($e.state == "closed" or ($e | leaves_landed)) as $over
        | (if $e.state == "closed" and $e.verified then "verified" elif $over then "landed"
           elif ($er | length) > 0 then "rows" elif ($ep | length) > 0 then "plan" elif $brief != null then "brief" else "epic" end) as $step
        | (if $over then {eta: null, why: null}
           else ($er | map(select(.state != "done")) | map(. as $r
                   | ($byrow["\($P.name):\($r.id)"] // [] | map(select(.state != "done") | ($fc.ends // {})[.slug] // empty) | first))) as $ends
             | ($ends | map(select(. != null))) as $sch
             # the phases of a backfilled plan are the stories of its epic, so the two are the same work:
             # the larger count is the tail, never their sum
             | ([($ends | map(select(. == null)) | length), ($ep | map([(.open | length) - .queued, 0] | max) | add // 0)] | max) as $tail
             | if ($sch | length) == 0 and $tail == 0 then {eta: null, why: "no rows or plan phases filed"}
               elif $tail > 0 and $pace == null then {eta: null, why: "no phase pace measured yet"}
               else (if $tail == 0 then "queue" elif ($sch | length) == 0 then "pace(\($pace.basis))" else "queue+pace(\($pace.basis))" end) as $basis
                 | ([$sch[].p50] + (if $tail > 0 then [([$t, $fc.finish_p50 // $t] | max) + $tail * $pace.P] else [] end) | max | floor) as $p50
                 | ([$sch[].slow] + (if $tail > 0 then [([$t, $fc.finish_slow // $t] | max) + $tail * $pace.S] else [] end) | max | floor) as $slow
                 | ($acc[$basis | kind].factor) as $f
                 | {eta: {p50: $p50, slow: ([$slow, $p50] | max), basis: $basis, scheduled: ($sch | length), unscheduled: $tail,
                          factor: $f, cal_p50: (if $f == null then null else ($t + ($p50 - $t) * $f | floor) end)}, why: null}
               end end) as $x
        | $B[$k] as $b
        | {id: $e.id, title: $e.title, system: ($e.system // ""), version: $e.version, state: $e.state, verified: $e.verified, proof: $e.proof,
           open: $e.open, done: $e.done, open_weight: $e.open_weight, done_weight: $e.done_weight,
           progress: ratio($e.done_weight; $e.open_weight + $e.done_weight), step: $step, brief: $brief, plans: $ep,
           rows: ($er | map({id, kind, title, size, state, prs})), items: $ei,
           prs: ([$er[].prs[]?, ($ei[].pr | select(. != null) | tostring | split(" ")[])] | unique),
           eta: $x.eta, no_eta: $x.why,
           baseline: (if $b == null then null else $b | {made_epoch, reason, total, total_weight, p50, slow, basis, n} end),
           track: (if $b == null or $x.eta == null then null
                   elif $t > $b.p50 or $x.eta.p50 > $b.slow then "behind" else "on track" end),
           score: $S[$k]}] as $eps
      | ($sc | map(select(.project == $P.name and .ratio != null))) as $ps
      | {project: $P.name, profile: $P.profile, repo: $repo, pace: $pace,
         flow: {ideas: ($P.ideas + ($rows | map(select(.kind == "decide" and .state != "done")) | length)),
                briefs: ($P.briefs | length), plans: ($eps | map(.plans | length) | add // 0), epics: ($eps | length),
                rows: ($lv | map(select(.epic != null)) | length),
                landed: ($eps | map(select(.step == "landed")) | length), verified: ($eps | map(select(.step == "verified")) | length)},
         unlinked: {rows: ($lv | map(select(.epic == null and .state != "done") | .id)),
                    plans: ($act | map(select(.project == $P.name and (.plan // "") != "") | . as $i
                                        | select(all($plans[]; . as $pl | $i | names_plan($pl.file) | not)) | .plan) | unique)},
         accuracy: {scored: ($ps | length), median_ratio: ($ps | map(.ratio) | median),
                    on_time: ($ps | map(select(.verdict == "ahead")) | length), within_slow: ($ps | map(select(.within_slow)) | length)},
         epics: $eps}]}'
}

# epic_freeze <epics json> <now> -> a baseline line for each open epic with an ETA that has none
# yet (first seen: an epic is filed only on a human yes) or whose total moved since its newest
# (scope: a story added or dropped, or resized)
epic_freeze() {
  jq -c --argjson t "$2" '.projects[] | .project as $p | .epics[]
    | select(.eta != null and (.baseline == null or .baseline.total != (.open + .done)
                               or .baseline.total_weight != (.open_weight + .done_weight)))
    | {project: $p, epic: .id, title, made_epoch: $t, reason: (if .baseline == null then "first seen" else "scope" end),
       total: (.open + .done), total_weight: (.open_weight + .done_weight), done_weight,
       p50: .eta.p50, slow: .eta.slow, cal_p50: .eta.cal_p50, basis: .eta.basis}' <<<"$1"
}

# epic_score <epics json> <now> -> a score for each epic whose newest baseline has none and
# whose leaves have all landed (or that closed): actual against frozen, raw, as vs scores a
# forecast. Landing is seen by the sample, so it is as exact as the sample cadence.
epic_score() {
  jq -c --argjson t "$2" "$JQ_LIB"'.projects[] | .project as $p | .epics[]
    | select(.baseline != null and (.step == "landed" or .step == "verified")
             and (.score == null or .score.made_epoch != .baseline.made_epoch))
    | .baseline as $b
    | {project: $p, epic: .id, title, made_epoch: $b.made_epoch, reason: $b.reason, baselines: $b.n, basis: $b.basis,
       landed_epoch: $t, pred_p50: $b.p50, pred_slow: $b.slow,
       ratio: (if $b.p50 > $b.made_epoch then (($t - $b.made_epoch) / ($b.p50 - $b.made_epoch) | round2) else null end),
       error_min: (($t - $b.p50) / 60 | floor), within_slow: ($t <= $b.slow),
       verdict: (if $t <= $b.p50 then "ahead" else "behind" end), prs: .prs}' <<<"$1"
}

# epics_sample <now>: freeze the baselines and write the scores this sample owes, and say how
# many. Each score goes to its project's outcomes/<p>/epics/scores.jsonl.
epics_sample() {
  local t="$1" ej fr sc p
  ej=$(epics_json "$t") || return 1
  fr=$(epic_freeze "$ej" "$t") || return 1
  sc=$(epic_score "$ej" "$t") || return 1
  [ -n "$fr" ] && printf '%s\n' "$fr" >> "$EPIC_BASELINES"
  if [ -n "$sc" ]; then
    for p in $(jq -r .project <<<"$sc" | sort -u); do
      mkdir -p "$BENCH_OUTCOMES_DIR/$p/epics"
      jq -c --arg p "$p" 'select(.project == $p)' <<<"$sc" >> "$BENCH_OUTCOMES_DIR/$p/epics/scores.jsonl"
    done
  fi
  say "epics: $(grep -c . <<<"$fr") baselines frozen, $(grep -c . <<<"$sc") scored"
}

# cmd_epics [--json] [--project P]: each feature's chain and ETA, per project
cmd_epics() {
  local json=0 proj='' ej
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --project) proj="${2:-}"; [ -n "$proj" ] || { say "--project needs a name"; return 2; }; shift 2 ;;
      *) say "usage: fleet-bench epics [--json] [--project P]"; return 2 ;;
    esac
  done
  ej=$(epics_json "$(now)") || return 1
  [ -z "$proj" ] || ej=$(jq -c --arg p "$proj" '.projects |= map(select(.project == $p))' <<<"$ej")
  if [ "$json" = 1 ]; then printf '%s\n' "$ej"; return 0; fi
  jq -r "$JQ_LIB"'
    def cut($n): if length > $n then .[:$n - 3] + "..." else . end;
    def when: if .eta == null then "no ETA: \(.no_eta // "-")"
      else "ETA \(.eta.cal_p50 // .eta.p50 | hm) (slow \(.eta.slow | hm)) \(.eta.basis)\(if .eta.factor != null then " x\(.eta.factor)" else "" end)" end;
    .made_epoch as $t
    | (.projects | map(.epics[]) ) as $all
    | "epics \($t | hm): \($all | map(select(.state == "open" and .step != "landed")) | length) open, \($all | map(select(.step == "landed")) | length) landed, \($all | map(select(.step == "verified")) | length) verified, \($all | map(select(.score != null)) | length) scored",
      (.projects[] | select((.epics | length) > 0 or (.unlinked.plans | length) > 0)
       | "",
         "\(.project)  ideas \(.flow.ideas) | briefs \(.flow.briefs) | plans \(.flow.plans) | epics \(.flow.epics) | rows \(.flow.rows) | landed \(.flow.landed) | verified \(.flow.verified)"
           + (if .accuracy.scored > 0 then "  ETAs scored \(.accuracy.scored), median ratio \(.accuracy.median_ratio), \(.accuracy.on_time) on time" else "" end),
         (.epics | sort_by(.state != "open", .step == "landed", -(.eta.p50 // 0)) | .[]
          | "  \(.id)  \(.title | cut(48))  [\(.step)]  \(.done)/\(.open + .done)"
            + (if .state == "open" and .step != "landed" then "  \(when)\(if .track != null then ", \(.track)" else "" end)"
               elif .score != null then "  landed \(.score.landed_epoch | hm), ratio \(.score.ratio // "-"), \(.score.verdict)" else "" end)),
         (if (.unlinked.rows | length) > 0 then "  \(.unlinked.rows | length) open rows with no epic" else empty end),
         (if (.unlinked.plans | length) > 0 then "  plans with no epic: " + (.unlinked.plans | map(split("/") | last) | join(", ")) else empty end))' <<<"$ej"
}

main() {
  case "${1:-}" in
    sample) cmd_sample ;;
    eta) shift; cmd_eta "$@" ;;
    report) cmd_report ;;
    accuracy) shift; cmd_accuracy "$@" ;;
    headline) cmd_headline ;;
    scorecard) cmd_scorecard ;;
    sessions) shift; cmd_sessions "$@" ;;
    stats) shift; cmd_stats "$@" ;;
    review) shift; cmd_review "$@" ;;
    sections) shift; cmd_sections "$@" ;;
    asks) shift; cmd_asks "$@" ;;
    ledger) shift; cmd_ledger "$@" ;;
    rules) shift; cmd_rules "$@" ;;
    kpi) shift; cmd_kpi "$@" ;;
    chain) shift; cmd_chain "$@" ;;
    startup) shift; cmd_startup "$@" ;;
    pipeline) shift; cmd_pipeline "$@" ;;
    effect) shift; cmd_effect "$@" ;;
    improve) shift; cmd_improve "$@" ;;
    retro) cmd_retro ;;
    canary) shift; cmd_canary "$@" ;;
    room) intake_room ;;
    triage) shift; cmd_triage "$@" ;;
    reds) shift; cmd_reds "$@" ;;
    findings) shift; cmd_findings "$@" ;;
    respond) shift; cmd_respond "$@" ;;
    loop) shift; cmd_loop "$@" ;;
    throughput) shift; cmd_throughput "$@" ;;
    flow) shift; cmd_flow "$@" ;;
    forecast) shift; cmd_forecast "$@" ;;
    epics) shift; cmd_epics "$@" ;;
    vs) shift; cmd_vs "$@" ;;
    queue) shift; cmd_queue "$@" ;;
    requests) shift; cmd_requests "$@" ;;
    models) shift; cmd_models "$@" ;;
    sources) shift; cmd_sources "$@" ;;
    sizes) shift; cmd_sizes "$@" ;;
    -h | --help) usage ;;
    *) usage >&2; return 2 ;;
  esac
}

# Sourceable for tests; runs main only when executed.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
