#!/usr/bin/env bash
# agent-usage - what a Claude session actually cost: tokens, models, wall time, USD.
#
#   agent-usage session <id> [--json]        one session's rollup
#   agent-usage rows <project> [--since E]   TSV for the cockpit (registry, no recompute)
#   agent-usage changelog <project> --since E [--until E]   markdown for a version note
#   agent-usage backfill <project|--all>     fill telemetry into existing registry lines
#
# TWO SOURCES, AND THEY ARE NOT EQUIVALENT.
#
#   1. Prometheus (primary). Claude Code's own OTel metrics, keyed by the `session_id`
#      label - which is the SAME uuid as the transcript filename and sessions.jsonl's
#      .session_id. Complete: it counts `main` + `subagent` + `auxiliary` work, and it
#      reports real USD that Claude Code computed, so there is no price table to drift.
#
#   2. The transcript (fallback). Local, instant, and retroactive to before telemetry
#      was switched on - but it holds ONLY the main thread. Measured on one real
#      session: transcript-deduped output == Prometheus query_source="main" output
#      EXACTLY (227,983), while that session's subagents burned another 7.4M tokens and
#      $10.32 that the transcript cannot see - 16% of its true cost. A subagent-heavy
#      session (a /workflow, a bug-bash) is far worse.
#
# So a transcript-sourced figure is an UNDERCOUNT, not an alternative measurement, and
# is always flagged `partial: true` / rendered with a trailing `~`. Do not "simplify"
# this by dropping the Prometheus path - it silently understates every fan-out session.
#
# DEDUPE BY requestId. A streamed response writes one transcript record per chunk and
# every one of them repeats the SAME cumulative usage object (verified: 542 assistant
# records, 272 distinct requestIds, identical usage within a requestId). Summing rows
# instead of requests roughly doubles the total.
#
# Nothing here is on a render path: the cockpit reads the registry, which stop-post.d/
# 80-session-register.sh fills by calling this once when a session ends.

set -uo pipefail

SESS_ROOT="$HOME/.agent/sessions"
PROJECTS_ROOT="$HOME/.claude/projects"

# Where Claude Code's OTel metrics ended up. Machine-local, never hardcoded here:
# this repo is public, and the endpoint is an internal host. Same convention as
# notes-cockpit's ~/.config/notes-cockpit/llm.env.
#
#   $PROM_URL, else ~/.config/agent-usage/config  (a shell fragment: PROM_URL=...)
#
# With neither, the Prometheus path is simply skipped and everything falls back to
# the transcript - which is the correct behaviour on a machine that has no metrics
# stack anyway.
AU_CONF="${AGENT_USAGE_CONF:-$HOME/.config/agent-usage/config}"
if [ -z "${PROM_URL:-}" ] && [ -f "$AU_CONF" ]; then
  # shellcheck disable=SC1090
  . "$AU_CONF"
fi
PROM_URL="${PROM_URL:-}"
# Kept short on purpose: every caller has a working fallback, and no one should wait on
# a Prometheus that is unreachable because we are off-LAN.
PROM_TIMEOUT="${PROM_TIMEOUT:-3}"
TAB="$(printf '\t')"

command -v jq >/dev/null 2>&1 || { echo "agent-usage: jq is required" >&2; exit 1; }

# --- helpers ---------------------------------------------------------------

# THERE IS DELIBERATELY NO PRICE TABLE. The obvious move for a session that predates
# telemetry is to multiply its tokens by list prices, and it was tried: against a
# session whose true cost Claude Code reported as $68.49, a hand-built opus table said
# $164.66 - 2.4x over. The token sums were not the problem (transcript main-thread total
# 89,704,703 matches Prometheus query_source="main" exactly); the published per-model
# rates simply do not reconstruct what is actually billed, and they change over time.
#
# A wrong dollar figure in a release changelog is worse than an absent one, so a session
# without telemetry reports cost `null` and renders as `-`. Every session from here on
# has real reported cost, which is what the changelog is for.

# prom <promql> -> the scalar value of the first result, or nothing.
prom() {
  [ -n "$PROM_URL" ] || return 0
  curl -s --get "$PROM_URL/api/v1/query" \
    --connect-timeout 2 --max-time "$PROM_TIMEOUT" \
    --data-urlencode "query=$1" 2>/dev/null \
    | jq -r '.data.result[0].value[1] // empty' 2>/dev/null
}

# prom_by <label> <promql> -> "<label-value>\t<value>" per line.
prom_by() {
  [ -n "$PROM_URL" ] || return 0
  curl -s --get "$PROM_URL/api/v1/query" \
    --connect-timeout 2 --max-time "$PROM_TIMEOUT" \
    --data-urlencode "query=$2" 2>/dev/null \
    | jq -r --arg l "$1" '.data.result[]? | "\(.metric[$l] // "-")\t\(.value[1])"' 2>/dev/null
}

# transcript_of <id> -> path, or nothing. The registry knows it; otherwise search.
transcript_of() {
  local id="$1" t
  t="$(grep -rhF "\"session_id\":\"$id\"" "$SESS_ROOT"/*/sessions.jsonl 2>/dev/null \
       | jq -r '.transcript // empty' 2>/dev/null | head -1)"
  [ -n "$t" ] && [ -f "$t" ] && { printf '%s\n' "$t"; return 0; }
  t="$(find "$PROJECTS_ROOT" -maxdepth 2 -name "$id.jsonl" 2>/dev/null | head -1)"
  [ -n "$t" ] && printf '%s\n' "$t"
}

# human <n> -> 1.2B / 1.2M / 340k / 512
human() {
  awk -v n="${1:-0}" 'BEGIN{
    if (n >= 1000000000) printf "%.1fB", n/1000000000;
    else if (n >= 1000000) printf "%.1fM", n/1000000;
    else if (n >= 1000) printf "%.0fk", n/1000;
    else printf "%d", n }'
}

# dur <seconds> -> 1h12m / 58m / 42s
dur() {
  awk -v s="${1:-0}" 'BEGIN{
    s = int(s);
    if (s >= 3600) printf "%dh%02dm", s/3600, (s%3600)/60;
    else if (s >= 60) printf "%dm", s/60;
    else printf "%ds", s }'
}

# --- the rollup ------------------------------------------------------------

# From the transcript: tokens (main thread only), models, wall duration.
# Emits "in out cw cr nreq duration_s models_csv".
_from_transcript() { # $1=transcript path
  local t="$1" first last d=0
  [ -f "$t" ] || { echo "0 0 0 0 0 0 -"; return 0; }

  first="$(grep -m1 -o '"timestamp":"[^"]*"' "$t" 2>/dev/null | head -1 | sed 's/.*:"//;s/"$//')"
  last="$(tac "$t" 2>/dev/null | grep -m1 -o '"timestamp":"[^"]*"' | sed 's/.*:"//;s/"$//')"
  if [ -n "$first" ] && [ -n "$last" ]; then
    local a b
    a="$(date -d "$first" +%s 2>/dev/null)" ; b="$(date -d "$last" +%s 2>/dev/null)"
    [ -n "$a" ] && [ -n "$b" ] && [ "$b" -ge "$a" ] 2>/dev/null && d=$(( b - a ))
  fi

  # Stream (no `jq -s`: these files reach hundreds of MB), then fold in awk keyed by
  # requestId so repeated chunk records of one response are counted once.
  jq -rc 'select(.type=="assistant" and .requestId != null)
          | [ .requestId, (.message.model // "-"),
              (.message.usage.input_tokens // 0),
              (.message.usage.output_tokens // 0),
              (.message.usage.cache_creation_input_tokens // 0),
              (.message.usage.cache_read_input_tokens // 0) ] | @tsv' "$t" 2>/dev/null \
  | awk -F'\t' -v d="$d" '
      { k=$1; mdl[$2]=1; i[k]=$3; o[k]=$4; cc[k]=$5; cr[k]=$6 }
      END {
        for (k in i) { I+=i[k]; O+=o[k]; CC+=cc[k]; CR+=cr[k]; n++ }
        ms=""; for (m in mdl) ms = (ms=="" ? m : ms "," m)
        printf "%d %d %d %d %d %d %s\n", I+0, O+0, CC+0, CR+0, n+0, d, (ms==""?"-":ms) }'
}

# From Prometheus: tokens by type (all query_sources), models, real USD.
# Emits "in out cw cr cost models_csv" or nothing when Prometheus is unreachable/empty.
_from_prom() { # $1=session id
  local id="$1" toks cost models i=0 o=0 cc=0 cr=0

  toks="$(prom_by type "sum by (type) (claude_code_token_usage_tokens_total{session_id=\"$id\"})")"
  [ -n "$toks" ] || return 1

  while IFS="$TAB" read -r ty val; do
    val="${val%%.*}"
    case "$ty" in
      input)         i="$val" ;;
      output)        o="$val" ;;
      cacheCreation) cc="$val" ;;
      cacheRead)     cr="$val" ;;
    esac
  done <<< "$toks"

  cost="$(prom "sum(claude_code_cost_usage_USD_total{session_id=\"$id\"})")"
  models="$(prom_by model "sum by (model) (claude_code_token_usage_tokens_total{session_id=\"$id\"})" \
            | cut -f1 | sort -u | paste -sd, -)"

  printf '%s %s %s %s %s %s\n' "$i" "$o" "$cc" "$cr" "${cost:-0}" "${models:--}"
}

cmd_session() {
  local id="" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      -*) echo "agent-usage: unknown flag '$1'" >&2; return 2 ;;
      *) id="$1" ;;
    esac
    shift
  done
  [ -n "$id" ] || { echo "usage: agent-usage session <id> [--json]" >&2; return 2; }

  local t; t="$(transcript_of "$id")"
  # Always read the transcript: it is the only source of wall-clock duration, and its
  # request count is a useful sanity check on the metrics.
  local tr; tr="$(_from_transcript "${t:-/nonexistent}")"
  local t_in t_out t_cw t_cr nreq duration t_models
  read -r t_in t_out t_cw t_cr nreq duration t_models <<< "$tr"

  local in out cw cr cost models source partial
  local pr; pr="$(_from_prom "$id")"
  if [ -n "$pr" ]; then
    read -r in out cw cr cost models <<< "$pr"
    source="otel"; partial=false
    [ "$models" = "-" ] && models="$t_models"
  else
    in="$t_in"; out="$t_out"; cw="$t_cw"; cr="$t_cr"; models="$t_models"
    source="transcript"; partial=true; cost=""
  fi

  local total=$(( in + out + cw + cr ))

  if [ "$json" -eq 1 ]; then
    jq -nc \
      --arg id "$id" --arg src "$source" --arg models "$models" \
      --arg cost "${cost:-}" --argjson partial "$partial" \
      --argjson i "$in" --argjson o "$out" --argjson cw "$cw" --argjson cr "$cr" \
      --argjson total "$total" --argjson d "${duration:-0}" --argjson n "${nreq:-0}" \
      '{session_id:$id,
        cost_usd:(if $cost == "" then null else ($cost | tonumber) end),
        usage_source:$src, usage_partial:$partial, duration_s:$d, requests:$n,
        models:($models | split(",") | map(select(. != "-"))),
        tokens:{input:$i, output:$o, cacheCreation:$cw, cacheRead:$cr, total:$total}}'
    return 0
  fi

  printf 'session   %s\n' "$id"
  printf 'models    %s\n' "$models"
  printf 'tokens    in %s  out %s  cacheWrite %s  cacheRead %s  (total %s)\n' \
    "$(human "$in")" "$(human "$out")" "$(human "$cw")" "$(human "$cr")" "$(human "$total")"
  printf 'requests  %s\n' "$nreq"
  printf 'duration  %s\n' "$(dur "$duration")"
  if [ "$partial" = true ]; then
    printf 'cost      -  (no telemetry for this session; tokens above are main thread only)\n'
  else
    printf 'cost      $%.2f  (reported by Claude Code, incl. subagents)\n' "$cost"
  fi
}

# --- registry-backed verbs -------------------------------------------------

# One TSV row per finished session, newest first. Straight out of the registry: this is
# what the cockpit calls, so it must not recompute or touch the network.
#   id \t updated \t edits \t cost \t nocost \t tokens \t models \t duration \t label
# `nocost` is 1 when that session has no telemetry, so a caller can render `-` instead
# of a `$0.00` that would read as "this was free".
#
# Empty fields are emitted as "-", never blank. TAB is IFS *whitespace* in bash, so
# `read` collapses runs of it: one empty middle field (a session with no model recorded)
# silently shifts every later field left, and the label lands in the duration variable.
# Same reason `sessions:live_lines` sentinels its columns.
cmd_rows() {
  local project="" since=0 limit=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --since) since="${2:-0}"; shift ;;
      --limit) limit="${2:-0}"; shift ;;
      -*) echo "agent-usage: unknown flag '$1'" >&2; return 2 ;;
      *) project="$1" ;;
    esac
    shift
  done
  [ -n "$project" ] || { echo "usage: agent-usage rows <project> [--since E]" >&2; return 2; }

  local f="$SESS_ROOT/$project/sessions.jsonl"
  [ -f "$f" ] || return 0

  jq -rc --argjson since "$since" '
    select(.session_id and ((.updated // 0) >= $since))
    | [ .session_id, (.updated // 0), (.edits // 0),
        (.cost_usd // 0), (if .cost_usd == null then "1" else "0" end),
        ((.tokens.total) // 0),
        ((.models // []) | join(",")),
        (.duration_s // 0),
        ((.title // "") | select(. != "") // .head_commit // .first_prompt // "-") ]
    | map(tostring | if . == "" then "-" else . end) | @tsv' "$f" 2>/dev/null \
  | sort -t"$TAB" -k2,2rn \
  | { [ "$limit" -gt 0 ] 2>/dev/null && head -n "$limit" || cat; }
}

cmd_changelog() {
  local project="" since=0 until=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --since) since="${2:-0}"; shift ;;
      --until) until="${2:-0}"; shift ;;
      -*) echo "agent-usage: unknown flag '$1'" >&2; return 2 ;;
      *) project="$1" ;;
    esac
    shift
  done
  [ -n "$project" ] || { echo "usage: agent-usage changelog <project> --since E" >&2; return 2; }

  local rows; rows="$(cmd_rows "$project" --since "$since")"
  [ -n "$rows" ] || return 0
  if [ "${until:-0}" -gt 0 ] 2>/dev/null; then
    rows="$(printf '%s\n' "$rows" | awk -F'\t' -v u="$until" '$2 <= u')"
  fi
  [ -n "$rows" ] || return 0

  local n edits toks cost nocost
  read -r n edits toks cost nocost <<< "$(printf '%s\n' "$rows" \
    | awk -F'\t' '{n++; e+=$3; c+=$4; if($5=="1") u++; t+=$6}
                  END{printf "%d %d %d %.2f %d\n", n, e, t, c, u+0}')"

  printf '## Agent work\n\n'
  printf '%s session%s - %s edits - %s tokens - $%.2f\n\n' \
    "$n" "$([ "$n" = 1 ] || echo s)" "$edits" "$(human "$toks")" "$cost"

  # No duration on these lines: the transcript's first-to-last span counts the hours a
  # resumed session sat idle overnight, so it reads as "this took 201h" when the agent
  # worked for two. Wall span is on `agent-usage session`, where it can be labelled.
  local id _u ed cost1 nc tok1 models d label
  while IFS="$TAB" read -r id _u ed cost1 nc tok1 models d label; do
    [ -n "$id" ] || continue
    [ "$models" = "-" ] && models=""
    # <synthetic> is a Claude Code internal, not a model anyone chose.
    models="$(printf '%s' "$models" | tr ',' '\n' | grep -v '^<' | paste -sd+ -)"
    printf -- '- `%s` %s\n' "${id:0:8}" "$(printf '%s' "$label" | sed 's/[[:space:]]*$//')"
    printf '  %s edits - %s tok - %s%s\n' \
      "$ed" "$(human "$tok1")" \
      "$([ "$nc" = 1 ] && echo 'cost not tracked' || printf '$%.2f' "$cost1")" \
      "$([ -z "$models" ] || echo " - $models")"
  done <<< "$rows"

  if [ "${nocost:-0}" -gt 0 ] 2>/dev/null; then
    printf '\n%s session%s ran before telemetry was enabled; %s cost is not recoverable and is excluded from the total above.\n' \
      "$nocost" "$([ "$nocost" = 1 ] || echo s)" "$([ "$nocost" = 1 ] && echo its || echo their)"
  fi
  return 0
}

# Fill telemetry into registry lines that predate it. Rewrites each sessions.jsonl in
# place via a temp file - never edits a line by hand.
cmd_backfill() {
  local target="${1:-}"
  [ -n "$target" ] || { echo "usage: agent-usage backfill <project|--all>" >&2; return 2; }

  local files
  if [ "$target" = "--all" ]; then
    files="$(find "$SESS_ROOT" -mindepth 2 -maxdepth 2 -name sessions.jsonl 2>/dev/null)"
  else
    files="$SESS_ROOT/$target/sessions.jsonl"
  fi

  local f n=0
  for f in $files; do
    [ -f "$f" ] || continue
    local tmp; tmp="$(mktemp)"
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      local id has
      id="$(printf '%s' "$line" | jq -r '.session_id // empty' 2>/dev/null)"
      has="$(printf '%s' "$line" | jq -r 'has("cost_usd") and has("title")' 2>/dev/null)"
      if [ -z "$id" ] || [ "$has" = "true" ]; then
        printf '%s\n' "$line" >> "$tmp"; continue
      fi
      local u; u="$(cmd_session "$id" --json 2>/dev/null)"
      if [ -n "$u" ]; then
        local tx title
        tx="$(transcript_of "$id")"
        title="$([ -n "$tx" ] && tac "$tx" 2>/dev/null | grep -m1 '"type":"ai-title"' \
                 | jq -rc '.aiTitle // empty' 2>/dev/null \
                 | tr '\n' ' ' | cut -c1-100 | sed 's/[[:space:]]*$//')"
        printf '%s' "$line" | jq -c --argjson u "$u" --arg title "$title" \
          '. + {cost_usd:$u.cost_usd, usage_source:$u.usage_source,
                usage_partial:$u.usage_partial, tokens:$u.tokens, models:$u.models,
                duration_s:$u.duration_s}
             + (if $title == "" then {} else {title:$title} end)' >> "$tmp" 2>/dev/null \
          || printf '%s\n' "$line" >> "$tmp"
        n=$(( n + 1 ))
      else
        printf '%s\n' "$line" >> "$tmp"
      fi
    done < "$f"
    mv "$tmp" "$f" && chmod 600 "$f"
  done
  echo "agent-usage: backfilled $n session(s)" >&2
}

# --- dispatch --------------------------------------------------------------

usage() { sed -n '3,8p' "$0" | sed 's/^# \{0,1\}//'; }

# Sourced (by the test suite) rather than run: every function is defined, nothing runs.
[[ "${BASH_SOURCE[0]}" != "$0" ]] && return 0

sub="${1:-}"; shift 2>/dev/null || true
case "$sub" in
  session)   cmd_session "$@" ;;
  rows)      cmd_rows "$@" ;;
  changelog) cmd_changelog "$@" ;;
  backfill)  cmd_backfill "$@" ;;
  -h|--help|help|'') usage ;;
  *) echo "agent-usage: unknown command '$sub'" >&2; usage; exit 1 ;;
esac
