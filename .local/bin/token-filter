#!/usr/bin/env python3
"""token-filter - pick, check and measure the Bash output filter (.claude/hooks/token-filter.sh).

Usage:
  token-filter status                       current method, rewrites and failures today
  token-filter use off|rtk|rtk-vcs [--reason R]
  token-filter skip [list | add ERE --why W | rm N]
  token-filter doctor                       health checks; exit 1 when something is broken
  token-filter verify [--days N] [--limit N] [--apply] [--json]
  token-filter report [--days N]            token use by method (claude-recall tool-output)

verify replays recent read-only Bash commands from the transcripts twice, as written and as
rtk rewrites them, with stdin a socket like Claude Code's Bash tool, and flags a changed exit
code, a hang, lost output, growth or an rtk error. --apply writes a skip rule for each failing
command shape, so the hook stops rewriting it. Docs: .claude/hooks/README.md "Token filter".
"""

import argparse
import concurrent.futures as cf
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path

HOME = Path.home()
STATE = Path(os.environ.get("TOKEN_FILTER_STATE", HOME / ".agent" / "token-filter"))
CACHE = Path(os.environ.get("TOKEN_FILTER_CACHE",
                            Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "token-filter"))
CONF = Path(os.environ.get("TOKEN_FILTER_CONF",
                           Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "token-filter"))
METHODS = ("off", "rtk", "rtk-vcs")
SETTINGS = Path(os.environ.get("TOKEN_FILTER_SETTINGS", HOME / ".claude" / "settings.json"))
HOOK = "token-filter.sh"
RTK_PIN = "1.1.0"
# rtk-vcs leaves these alone: they touch file reads and searches, where exact text matters.
VCS_SKIP = re.compile(r"(^|[;&|(] *)rtk (grep|rg|read|ls|find|tree|wc|jq|json|log|diff)\b")
RTK_ERR = re.compile(r"^\[rtk\] (error|warning: filter panicked)|^rtk: |^error: (unexpected|unrecognized|invalid)|^Usage: rtk", re.M)


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def read_jsonl(path, since=""):
    try:
        with open(path, errors="replace") as fh:
            for line in fh:
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if rec.get("ts", "") >= since:
                    yield rec
    except OSError:
        return


def mode():
    try:
        m = (STATE / "mode").read_text().strip()
    except OSError:
        return "off"
    return m if m in METHODS else "off"


def set_mode(method, reason, by="token-filter use"):
    STATE.mkdir(parents=True, exist_ok=True)
    prev = mode()
    (STATE / "mode").write_text(method + "\n")
    with open(STATE / "methods.jsonl", "a") as fh:
        fh.write(json.dumps({"ts": now(), "method": method, "from": prev, "by": by,
                             "reason": reason}) + "\n")
    return prev


def skips(where=None):
    """Skip EREs: tracked defaults ($CONF/skip) then local additions ($STATE/skip)."""
    out = []
    for d in ([where] if where else [CONF, STATE]):
        try:
            out += [l for l in (d / "skip").read_text().splitlines() if l and not l.startswith("#")]
        except OSError:
            pass
    return out


def add_skip(ere, why):
    re.compile(ere)
    STATE.mkdir(parents=True, exist_ok=True)
    if ere in skips():
        return False
    with open(STATE / "skip", "a") as fh:
        fh.write(f"# {now()[:10]} {why}\n{ere}\n")
    return True


def rtk_version():
    if not shutil.which("rtk"):
        return None
    try:
        out = subprocess.run(["rtk", "--version"], capture_output=True, text=True, timeout=5).stdout
        return out.split()[1] if out.startswith("rtk ") else out.strip()
    except (OSError, subprocess.SubprocessError, IndexError):
        return None


def rewrite(cmd, method="rtk"):
    """The command as the hook would send it, or None when it would leave it alone."""
    if method == "off" or "RTK_DISABLED=1" in cmd or cmd.startswith("rtk "):
        return None
    if any(re.search(s, cmd) for s in skips()):
        return None
    try:
        p = subprocess.run(["rtk", "rewrite", cmd], capture_output=True, text=True, timeout=5,
                           env={**os.environ, "RTK_SUPPRESS_HOOK_WARNING": "1"})
    except (OSError, subprocess.SubprocessError):
        return None
    new = p.stdout.strip()
    if p.returncode not in (0, 3) or not new or new == cmd:
        return None
    if method == "rtk-vcs" and VCS_SKIP.search(new):
        return None
    return new


def hook_registered():
    """{event: bool} for the token-filter hook in the live settings file."""
    try:
        hooks = json.loads(SETTINGS.read_text()).get("hooks", {})
    except (OSError, ValueError):
        return {}
    found = {}
    for ev in ("PreToolUse", "PostToolUse", "PostToolUseFailure"):
        found[ev] = any(HOOK in (h.get("command") or "")
                        for m in hooks.get(ev, []) for h in m.get("hooks", []))
    return found


def cmd_status(a):
    day = (datetime.now(timezone.utc) - timedelta(days=1)).strftime("%Y-%m-%dT%H:%M:%SZ")
    last = None
    for last in read_jsonl(STATE / "methods.jsonl"):
        pass
    rew = list(read_jsonl(CACHE / "rewrites.jsonl", day))
    fails = list(read_jsonl(CACHE / "failures.jsonl", day))
    print(f"method     {mode()}" + (f"  (since {last['ts']} by {last.get('by')}: {last.get('reason')})" if last else ""))
    print(f"rtk        {rtk_version() or 'MISSING'}")
    print(f"hook       {', '.join(e for e, ok in hook_registered().items() if ok) or 'NOT REGISTERED'} in {SETTINGS}")
    print(f"skips      {len(skips())}")
    print(f"last 24h   {len(rew)} rewrites, {len(fails)} failures")
    for f in fails[-5:]:
        print(f"  {f['ts']} {f['kind']}: {f.get('detail', '')[:120]}")
    return 0


def cmd_use(a):
    if a.method != "off" and not rtk_version():
        print("token-filter: rtk is not on PATH; install_rtk in base_functions.sh installs it", file=sys.stderr)
        return 1
    prev = set_mode(a.method, a.reason or "")
    print(f"method {prev} -> {a.method}")
    return 0


def cmd_skip(a):
    rules = skips(STATE)
    if a.op == "add":
        if not a.ere or not a.why:
            print("token-filter skip add ERE --why W", file=sys.stderr)
            return 2
        print("added" if add_skip(a.ere, a.why) else "already there")
    elif a.op == "rm":
        n = int(a.ere)
        lines = (STATE / "skip").read_text().splitlines()
        target = rules[n - 1]
        i = lines.index(target)
        if i > 0 and lines[i - 1].startswith("#"):
            del lines[i - 1:i + 1]
        else:
            del lines[i]
        (STATE / "skip").write_text("\n".join(lines) + ("\n" if lines else ""))
        print(f"removed {target}")
    else:
        for r in skips(CONF):
            print(f"  -  {r}   (tracked: {CONF / 'skip'})")
        for i, r in enumerate(rules, 1):
            print(f"{i:>3}  {r}")
    return 0


def run_hook(payload, state, cache, path=None):
    hook = Path(__file__).resolve().parent.parent.parent / ".claude" / "hooks" / HOOK
    if not hook.exists():
        hook = HOME / ".claude" / "hooks" / HOOK
    env = {**os.environ, "TOKEN_FILTER_STATE": str(state), "TOKEN_FILTER_CACHE": str(cache),
           "TOKEN_FILTER_CONF": str(state)}
    if path is not None:
        env["PATH"] = path
    t = time.monotonic()
    p = subprocess.run(["bash", str(hook)], input=json.dumps(payload), capture_output=True,
                       text=True, timeout=10, env=env)
    return p, time.monotonic() - t


def cmd_doctor(a):
    import tempfile
    bad = []
    v = rtk_version()
    if not v:
        bad.append("rtk is not on PATH")
    elif v != RTK_PIN:
        bad.append(f"rtk {v} is not the pinned {RTK_PIN} (base_functions.sh RTK_VERSION)")
    if not shutil.which("jq"):
        bad.append("jq is missing: the hook cannot read its payload")
    reg = hook_registered()
    for ev in ("PreToolUse", "PostToolUse"):
        if not reg.get(ev):
            bad.append(f"{HOOK} is not a {ev} hook in {SETTINGS}")
    with tempfile.TemporaryDirectory() as td:
        st, ca = Path(td, "s"), Path(td, "c")
        st.mkdir()
        (st / "mode").write_text("rtk\n")
        pre = {"hook_event_name": "PreToolUse", "tool_name": "Bash", "session_id": "doctor",
               "tool_use_id": "doctor-1", "tool_input": {"command": "git status", "description": "x"}}
        if v:
            p, dt = run_hook(pre, st, ca)
            try:
                out = json.loads(p.stdout)["hookSpecificOutput"]
                ok = out["updatedInput"]["command"] == "rtk git status" and "permissionDecision" not in out \
                    and out["updatedInput"].get("description") == "x"
            except (ValueError, KeyError, TypeError):
                ok = False
            if not ok:
                bad.append(f"hook smoke: git status was not rewritten cleanly (stdout {p.stdout[:120]!r})")
            if dt > 1.0:
                bad.append(f"hook smoke took {dt:.2f}s; every Bash call pays this")
            post = {**pre, "hook_event_name": "PostToolUse",
                    "tool_response": {"stdout": "", "stderr": "error: unexpected argument '--x' found\n\nUsage: rtk git status"}}
            p, _ = run_hook(post, st, ca)
            if "RTK_DISABLED=1 git status" not in p.stdout:
                bad.append("hook smoke: an rtk error was not turned into a re-run hint")
        # fail-open: no rtk on PATH must leave the command alone and exit 0
        p, _ = run_hook({**pre, "tool_use_id": "doctor-2"}, st, ca, path="/usr/bin:/bin")
        if p.returncode != 0 or p.stdout.strip():
            bad.append("hook smoke: without rtk the hook did not pass the command through")
    fails = list(read_jsonl(CACHE / "failures.jsonl",
                            (datetime.now(timezone.utc) - timedelta(days=1)).strftime("%Y-%m-%dT%H:%M:%SZ")))
    trips = [m for m in read_jsonl(STATE / "methods.jsonl") if m.get("by") == "breaker"]
    print(f"method {mode()}, rtk {v or '-'}, {len(fails)} failures in 24h, {len(trips)} breaker trips ever")
    for b in bad:
        print(f"  FAIL {b}")
    if not bad:
        print("  ok: rtk pinned, jq present, hook registered, rewrite + error hint + fail-open smoke pass")
    return 1 if bad else 0


# --- verify ---------------------------------------------------------------------------
SAFE = {"grep", "rg", "cat", "head", "tail", "ls", "find", "wc", "sed", "git", "jq", "cut",
        "sort", "uniq", "tr", "cd", "echo", "printf", "true", "diff", "stat", "basename",
        "dirname", "realpath", "readlink", "tree", "column", "nl", "comm", "file"}
GIT_SAFE = {"status", "log", "diff", "show", "grep", "rev-parse", "ls-files", "blame", "rev-list",
            "describe", "shortlog", "cat-file", "ls-tree", "merge-base"}
UNSAFE = re.compile(r"`|\$\(|<\(|>\(|<<|\bsudo\b|--in-place|-delete\b|-exec|-ok\b|-fprint|-fls\b|"
                    r"--output|--pre\b|\bxargs\b|(?<![&|>])&(?![&>])|\n")
# flags that make an otherwise read-only tool write a file, per tool
WRITES = {"sed": re.compile(r"^-[a-zA-Z]*i"), "sort": re.compile(r"^-[a-zA-Z]*o"),
          "tree": re.compile(r"^-o$"), "git": re.compile(r"^(-O|--open-files-in-pager)")}
REDIRS = re.compile(r"\d?>\s*/dev/null|2>&1|&>\s*/dev/null")


def replay_safe(cmd):
    if UNSAFE.search(cmd):
        return False
    bare = REDIRS.sub("", cmd)
    if ">" in bare or "<" in bare:
        return False
    for seg in re.split(r"&&|\|\||;|\|", bare):
        w = seg.split()
        while w and re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", w[0]):
            w = w[1:]
        if not w:
            continue
        if w[0] not in SAFE:
            return False
        if w[0] in WRITES and any(WRITES[w[0]].match(x) for x in w[1:]):
            return False
        if w[0] == "git":
            args = w[1:]
            while args and args[0] in ("-C", "-c", "--no-pager"):
                args = args[1:] if args[0] == "--no-pager" else args[2:]
            if not args or args[0] not in GIT_SAFE:
                return False
    return True


def corpus(days, limit):
    """Distinct (cmd, cwd) pairs from recent transcripts, round-robin over command heads."""
    roots = [Path(p) for p in os.environ.get("CLAUDE_TRANSCRIPTS", "").split(":") if p] or \
        [HOME / ".claude" / "projects", HOME / ".claude-work" / "projects"]
    cut = time.time() - days * 86400
    seen, by_head = set(), {}
    for root in roots:
        for f in sorted(root.rglob("*.jsonl"), key=lambda p: -p.stat().st_mtime if p.exists() else 0):
            try:
                if f.stat().st_mtime < cut:
                    continue
                fh = f.open(errors="replace")
            except OSError:
                continue
            with fh:
                for line in fh:
                    if '"name":"Bash"' not in line:
                        continue
                    try:
                        rec = json.loads(line)
                    except ValueError:
                        continue
                    cwd = rec.get("cwd") or ""
                    for b in (rec.get("message") or {}).get("content") or []:
                        if not isinstance(b, dict) or b.get("name") != "Bash":
                            continue
                        cmd = ((b.get("input") or {}).get("command") or "").strip()
                        if not cmd or (cmd, cwd) in seen or not os.path.isdir(cwd) or not replay_safe(cmd):
                            continue
                        seen.add((cmd, cwd))
                        head = cmd.split()[0]
                        by_head.setdefault(head, []).append((cmd, cwd))
    out, i = [], 0
    pools = [v for _, v in sorted(by_head.items(), key=lambda kv: -len(kv[1]))]
    while len(out) < limit and any(i < len(p) for p in pools):
        for p in pools:
            if i < len(p) and len(out) < limit:
                out.append(p[i])
        i += 1
    return out


def run_like_claude(cmd, cwd, timeout):
    """Run under bash with stdin an open, silent socket, as the Bash tool does."""
    a, b = socket.socketpair()
    t = time.monotonic()
    try:
        p = subprocess.run(["bash", "-c", cmd], cwd=cwd, stdin=a.fileno(), capture_output=True,
                           timeout=timeout, env={**os.environ, "GIT_OPTIONAL_LOCKS": "0",
                                                 "GIT_PAGER": "cat", "PAGER": "cat"})
        out = (p.stdout + p.stderr).decode(errors="replace")
        return p.returncode, out, time.monotonic() - t
    except subprocess.TimeoutExpired:
        return None, "", timeout
    finally:
        a.close()
        b.close()


def shape_skip(new):
    """A skip ERE for the one rewritten segment, or None when several were (blame is unclear)."""
    if len(re.findall(r"(?:^|[;&|(] *)rtk ", new)) != 1:
        return None
    m = re.search(r"rtk (git|gh|cargo|npm|pnpm|go|docker|kubectl) +([a-z-]+)", new)
    if m:
        return rf"(^|[;&|(] *){m.group(1)} +{m.group(2)}\b"
    m = re.search(r"rtk ([a-z-]+)", new)
    head = {"read": "(cat|head|tail)"}.get(m.group(1), m.group(1)) if m else None
    return rf"(^|[;&|(] *){head}\b" if head else None


def check(cmd, cwd, method, timeout):
    new = rewrite(cmd, method)
    if not new:
        return None
    rc0, out0, t0 = run_like_claude(cmd, cwd, timeout)
    if rc0 is None:
        return {"cmd": cmd, "cwd": cwd, "new": new, "verdict": "inconclusive", "why": "raw timed out"}
    rc1, out1, t1 = run_like_claude(new, cwd, timeout)
    r = {"cmd": cmd, "cwd": cwd, "new": new, "raw": len(out0), "filtered": len(out1),
         "t_raw": round(t0, 3), "t_filtered": round(t1, 3)}
    err = RTK_ERR.search(out1)
    if rc1 is None:
        r.update(verdict="hang", why=f"raw {t0:.1f}s, filtered timed out at {timeout}s")
    elif err:
        r.update(verdict="rtk-error", why=err.group(0))
    elif rc1 != rc0:
        r.update(verdict="exit-code", why=f"raw {rc0}, filtered {rc1}")
    elif out0.strip() and not out1.strip():
        r.update(verdict="lost-output", why=f"raw {len(out0)} chars, filtered empty")
    elif len(out1) > len(out0) * 1.1 + 200:
        r.update(verdict="grew", why=f"{len(out0)} -> {len(out1)} chars")
    elif t1 > t0 * 3 + 2:
        r.update(verdict="slow", why=f"{t0:.1f}s -> {t1:.1f}s")
    else:
        r.update(verdict="ok")
    return r


def cmd_verify(a):
    if not rtk_version():
        print("token-filter verify: rtk is not on PATH", file=sys.stderr)
        return 1
    pairs = corpus(a.days, a.limit)
    results = []
    with cf.ThreadPoolExecutor(max_workers=a.jobs) as ex:
        for r in ex.map(lambda p: check(p[0], p[1], a.method, a.timeout), pairs):
            if r:
                results.append(r)
    bad = [r for r in results if r["verdict"] not in ("ok", "inconclusive")]
    ok = [r for r in results if r["verdict"] == "ok"]
    raw = sum(r["raw"] for r in ok)
    filt = sum(r["filtered"] for r in ok)
    summary = {"ts": now(), "method": a.method, "replayed": len(pairs), "rewritten": len(results),
               "ok": len(ok), "bad": len(bad), "raw_chars": raw, "filtered_chars": filt,
               "saved_pct": round(100 * (raw - filt) / raw, 1) if raw else 0.0}
    added = []
    if a.apply:
        for r in bad:
            ere = shape_skip(r["new"])
            if ere and add_skip(ere, f"verify {r['verdict']}: {r['why']} | {r['cmd'][:100]}"):
                added.append(ere)
    CACHE.mkdir(parents=True, exist_ok=True)
    with open(CACHE / "verify.jsonl", "a") as fh:
        fh.write(json.dumps({**summary, "bad_cmds": [{k: r[k] for k in ("cmd", "verdict", "why")} for r in bad],
                             "skips_added": added}) + "\n")
    by_head = {}
    for r in ok:
        h = re.search(r"rtk ([a-z]+(?: (?:-[a-zA-Z]+|[a-z]+(?=\s|$)))?)", r["new"])
        x = by_head.setdefault(h.group(1) if h else "?", [0, 0, 0])
        x[0] += 1
        x[1] += r["raw"]
        x[2] += r["filtered"]
    if a.json:
        print(json.dumps({**summary, "by_tool": by_head, "bad_cmds": bad, "skips_added": added}))
        return 1 if bad and not a.apply else 0
    print(f"{a.method}: replayed {len(pairs)} safe commands, rtk rewrote {len(results)}: "
          f"{len(ok)} ok, {len(bad)} bad")
    print(f"output on the ok ones: {raw:,} -> {filt:,} chars ({summary['saved_pct']}% saved)")
    for k, (n, r0, r1) in sorted(by_head.items(), key=lambda kv: -(kv[1][1] - kv[1][2]))[:15]:
        print(f"  {k:<18} {n:>4} cmds  {r0:>9,} -> {r1:>9,}  {100 * (r0 - r1) / r0 if r0 else 0:5.1f}%")
    for r in bad:
        print(f"  BAD {r['verdict']}: {r['why']}\n      {r['cmd'][:140]}\n      -> {r['new'][:140]}")
    for e in added:
        print(f"  skip added: {e}")
    return 1 if bad and not a.apply else 0


def cmd_report(a):
    recall = shutil.which("claude-recall") or str(Path(__file__).resolve().parent / "claude-recall")
    return subprocess.call([recall, "tool-output", "--days", str(a.days), "--by", "method"])


def main():
    p = argparse.ArgumentParser(prog="token-filter", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status").set_defaults(func=cmd_status)
    u = sub.add_parser("use")
    u.add_argument("method", choices=METHODS)
    u.add_argument("--reason")
    u.set_defaults(func=cmd_use)
    s = sub.add_parser("skip")
    s.add_argument("op", nargs="?", choices=["list", "add", "rm"], default="list")
    s.add_argument("ere", nargs="?")
    s.add_argument("--why")
    s.set_defaults(func=cmd_skip)
    sub.add_parser("doctor").set_defaults(func=cmd_doctor)
    v = sub.add_parser("verify")
    v.add_argument("--days", type=int, default=7)
    v.add_argument("--limit", type=int, default=300)
    v.add_argument("--method", choices=["rtk", "rtk-vcs"], default="rtk")
    v.add_argument("--timeout", type=float, default=10)
    v.add_argument("--jobs", type=int, default=4)
    v.add_argument("--apply", action="store_true")
    v.add_argument("--json", action="store_true")
    v.set_defaults(func=cmd_verify)
    r = sub.add_parser("report")
    r.add_argument("--days", type=int, default=7)
    r.set_defaults(func=cmd_report)
    a = p.parse_args()
    sys.exit(a.func(a) or 0)


if __name__ == "__main__":
    main()
