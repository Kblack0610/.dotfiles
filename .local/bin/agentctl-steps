#!/usr/bin/env bash
# agentctl-steps - run one runner's steps in order, each with its own outcome, then the runner's.
#
#   agentctl-steps [STEPS]    run each step of STEPS (default: $STEPS, which the conf sets)
# A runner is one job class on one cadence, and each source or pass of that class is a step of it
# (standards.md, the runner rule). The conf lists them as STEPS='<step>=<command> [args]; ...';
# a command is a PATH name plus plain words, no shell. Every step runs, in order, whatever the one
# before it did: a later step may read what an earlier one wrote, and one failing source must not
# hide the others. Under agentctl each step runs as AGENTCTL_NAME=<step>, so the outcome it
# declares lands in its own state dir (<state>/<step>/last-outcome and activity.log). A step that
# declares none is STALLED, BLOCKED on exit 75 or FAILED on another non-zero exit, and one that
# declares WORKED or NOOP but exits non-zero is overruled the same way. The runner's word is the
# worst step's (FAILED, STALLED, BLOCKED, WORKED, NOOP in that order), its words name each step,
# and its reason is the reasons of the steps at that word, so a hold keeps the step's own reason.
# Run by hand (no AGENTCTL_NAME), nothing is recorded and a step's word is its exit code.
# Exit: 0 for WORKED or NOOP, 75 for BLOCKED (a held gate, not a failed unit), 1 otherwise.
set -uo pipefail

# shellcheck source=../lib/agent-proof.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/agent-proof.sh"

RUNNER="${AGENTCTL_NAME:-}"
STATE="$(proof_state_dir)"

die() { echo "agentctl-steps: $*" >&2; proof_runner_outcome FAILED "$*"; exit 2; }

# A hung step must not hold up the ones after it: each runs under timeout(1) for STEP_TIMEOUT
# seconds (the conf may set it; 3600 is 6x the longest step on 2026-11-19, token-usage at 587 s),
# and one that runs past it is FAILED, saying so.
LIMIT="${STEP_TIMEOUT:-3600}"
[[ "$LIMIT" =~ ^[1-9][0-9]*$ ]] || die "STEP_TIMEOUT='$LIMIT' is not a whole number of seconds"
exit_words() { case "$1" in 124) printf 'ran past STEP_TIMEOUT=%ss' "$LIMIT" ;; *) printf 'exit %s' "$1" ;; esac; }

# rank WORD -> how bad a step's word is; the runner takes the highest.
rank() {
  case "$1" in
    NOOP) echo 0 ;; WORKED) echo 1 ;; BLOCKED) echo 2 ;; STALLED) echo 3 ;; *) echo 4 ;;
  esac
}

# step_words STEP -> the words of the step's newest outcome line, without its stamp and word.
step_words() {
  local line
  line="$(grep ' outcome=' "$STATE/$1/activity.log" 2>/dev/null | tail -n 1)"
  line="${line#* outcome=}"
  case "$line" in *' '*) printf '%s' "${line#* }" ;; esac
}

steps="${1:-${STEPS:-}}"
[ -n "${steps//[[:space:];]/}" ] || die "no STEPS: the conf lists them as STEPS='<step>=<command> [args]; ...'"

names=() cmds=()
IFS=';' read -ra parts <<<"$steps"
for part in "${parts[@]}"; do
  part="${part#"${part%%[![:space:]]*}"}"
  part="${part%"${part##*[![:space:]]}"}"
  [ -n "$part" ] || continue
  name="${part%%=*}"
  [[ "$part" == *=* && "$name" =~ ^[a-z0-9][a-z0-9-]*$ && -n "${part#*=}" ]] ||
    die "bad step '$part': each is <step>=<command> [args], the step a lowercase name"
  [ "$name" != "$RUNNER" ] || die "step '$name' has the runner's name: they would share one state dir"
  for n in "${names[@]}"; do [ "$n" != "$name" ] || die "step '$name' is listed twice"; done
  names+=("$name") cmds+=("${part#*=}")
done

worst=NOOP summary=() words_of=() why_of=()
for i in "${!names[@]}"; do
  name="${names[$i]}"
  read -ra argv <<<"${cmds[$i]}"
  echo "agentctl-steps: $name: ${cmds[$i]}"
  case "$RUNNER" in
    '')
      timeout -k 60 "$LIMIT" "${argv[@]}"
      rc=$?
      case "$rc" in 0) word=WORKED ;; 75) word=BLOCKED ;; *) word=FAILED ;; esac
      words="$(exit_words "$rc")"
      ;;
    *)
      mkdir -p "$STATE/$name"
      printf 'PENDING' > "$STATE/$name/last-outcome"
      AGENTCTL_NAME="$name" timeout -k 60 "$LIMIT" "${argv[@]}"
      rc=$?
      case "$rc" in 0) by_rc= ;; 75) by_rc=BLOCKED ;; *) by_rc=FAILED ;; esac
      word="$(cat "$STATE/$name/last-outcome" 2>/dev/null)"
      case "$word" in
        PENDING) word="${by_rc:-STALLED}"; proof_outcome "$name" "$word" "declared no outcome ($(exit_words "$rc"))" ;;
        WORKED | NOOP)
          [ -z "$by_rc" ] || { proof_outcome "$name" "$by_rc" "declared $word, then exited $rc"; word="$by_rc"; } ;;
        BLOCKED | STALLED | FAILED) ;;
        *) proof_outcome "$name" FAILED "left '$word' as its outcome, not a verdict (exit $rc)"; word=FAILED ;;
      esac
      words="$(step_words "$name")"
      ;;
  esac
  echo "agentctl-steps: $name: exit $rc, $word"
  summary+=("$name $word${words:+: $words}")
  words_of+=("$word")
  case "$words" in *'why: '*) why_of+=("${words#*why: }") ;; *) why_of+=("$words") ;; esac
  [ "$(rank "$word")" -le "$(rank "$worst")" ] || worst="$word"
done

joined="$(printf '%s; ' "${summary[@]}")"
if [ -n "$RUNNER" ]; then
  # A bad runner word carries the reasons of the steps that set it, word for word, so a hold's
  # held_why is the step's own reason and proof_unhold can match it.
  case "$worst" in
    WORKED | NOOP) ;;
    *) for i in "${!names[@]}"; do [ "${words_of[$i]}" != "$worst" ] || proof_why "${why_of[$i]}"; done ;;
  esac
  proof_report "$RUNNER" "$worst" "${joined%; }"
fi
case "$worst" in
  WORKED | NOOP) exit 0 ;;
  BLOCKED) exit 75 ;;
  *) exit 1 ;;
esac
