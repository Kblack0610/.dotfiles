#!/usr/bin/env bash
# desk: which part fills each desktop slot (the bar, the notifier), and the one way
# anything talks to whichever part is running. Usage doc: docs/desk.md.
#
#   desk current                  slot=part, one line per slot
#   desk get <slot>               the part in one slot
#   desk parts [<slot>]           what each slot accepts: slot part unit
#   desk use <slot> <part>        record the part and switch to it now
#   desk start                    start every slot's part (desk.service, at login)
#   desk signal <module-id>...    re-run the bar chips on each module's signal number
#   desk notify close|close-all|history|dnd
#   desk notify show <tag> <notify-send args>   one popup per tag, replaced in place; prints a --wait click
#   desk notify drop <tag>        close that tag's popup
#   desk chip <module-id> [run|stream]   a waybar chip for the Noctalia bar: how to run
#                                 it, one run's output, or its stream kept running
#   desk panel <custom/chip|panel-id> [context]   toggle a bar panel: a chip's dropdown or a
#                                 Noctalia panel (Noctalia only; Super+A b)
#   desk panel letters '<module>=<key> ...'|off   show or clear each chip's key in the bar
#
# systemd runs the parts and desk only picks; it never enables or masks a unit, because
# ~/.config/systemd is this repo. State: ~/.local/state/desk/parts, slot=part lines.
set -euo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/desk/parts"

die() { echo "desk: $1" >&2; exit "${2:-1}"; }

# config.base is where every chip's signal number lives. Resolved from this script's
# own checkout, so a worktree or the test sandbox reads its own copy.
waybar_dir() {
    [[ -n "${DESK_WAYBAR_DIR:-}" ]] && { echo "$DESK_WAYBAR_DIR"; return; }
    echo "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../.config/waybar"
}

# slot part unit binary. The first row of a slot is its default.
parts() {
    cat <<'EOF'
bar waybar-classic waybar.service waybar
bar waybar-modern waybar.service waybar
bar noctalia noctalia.service noctalia
notify dunst dunst.service dunst
notify swaync swaync.service swaync
EOF
}

row_of() { parts | awk -v s="$1" -v p="$2" '$1 == s && $2 == p'; }
slots() { parts | awk '!seen[$1]++ { print $1 }'; }

get() {
    local slot="$1" part=""
    parts | awk -v s="$slot" '$1 == s { found = 1 } END { exit !found }' || die "no slot '$slot' (slots: $(slots | xargs))" 2
    [[ -r "$STATE" ]] && part="$(awk -F= -v s="$slot" '$1 == s { p = $2 } END { print p }' "$STATE")"
    # A part this checkout no longer knows falls back to the default, so a stale
    # state file never leaves a slot empty.
    if [[ -z "$part" || -z "$(row_of "$slot" "$part")" ]]; then
        part="$(parts | awk -v s="$slot" '$1 == s { print $2; exit }')"
    fi
    echo "$part"
}

unit_of() { row_of "$1" "$2" | awk '{ print $3 }'; }

use() {
    local slot="${1:?usage: desk use <slot> <part>}" part="${2:?usage: desk use <slot> <part>}" row bin old="" was
    was="$(get "$slot")"
    row="$(row_of "$slot" "$part")"
    [[ -n "$row" ]] || die "'$part' is not a $slot part (parts: $(parts | awk -v s="$slot" '$1 == s { print $2 }' | xargs))" 2
    bin="$(awk '{ print $4 }' <<<"$row")"
    command -v "$bin" >/dev/null || die "$part needs $bin, which is not installed"
    mkdir -p "$(dirname "$STATE")"
    [[ -r "$STATE" ]] && old="$(cat "$STATE")"
    # Recorded before the restart, because a part's launcher reads its own choice
    # (waybar's launch.sh picks the layout); put back if the restart fails.
    { [[ -n "$old" ]] && grep -v "^$slot=" <<<"$old" || true; echo "$slot=$part"; } > "$STATE.tmp"
    mv "$STATE.tmp" "$STATE"
    # restart, not start: two parts can share a unit (waybar's layouts), and restart
    # starts a stopped unit, whose Conflicts= then stops the slot's other part.
    if ! systemctl --user restart "$(unit_of "$slot" "$part")"; then
        if [[ -n "$old" ]]; then printf '%s\n' "$old" > "$STATE"; else rm -f "$STATE"; fi
        die "$part did not start; $slot stays $(get "$slot")"
    fi
    # The custom/notify chip streams from the notifier it found at start, on every bar,
    # so a new notifier needs the bar to start again to show (or drop) that chip.
    if [[ "$slot" == notify && "$part" != "$was" ]]; then
        systemctl --user restart "$(unit_of bar "$(get bar)")" || echo "desk: the bar did not restart; its notify chip shows after the next one" >&2
    fi
    echo "$slot: $part"
}

start() {
    local slot failed=0
    for slot in $(slots); do
        systemctl --user start "$(unit_of "$slot" "$(get "$slot")")" || { echo "desk: $slot did not start" >&2; failed=1; }
    done
    return "$failed"
}

# The signal number a module listens on, from its "signal" key in config.base or the
# pin's config. Comment lines are skipped: config.base quotes "signal": 10 in prose.
signal_of() {
    local dir; dir="$(waybar_dir)"
    awk -v id="$1" '
        FNR == 1 { key = "" }
        /^[[:space:]]*\/\// { next }
        match($0, /^    "[^"]+"[[:space:]]*:/) { key = substr($0, 6); sub(/".*/, "", key) }
        key == id && match($0, /"signal"[[:space:]]*:[[:space:]]*[0-9]+/) {
            n = substr($0, RSTART, RLENGTH); sub(/.*:[[:space:]]*/, "", n); print n; exit
        }' "$dir/config.base" "$dir/config.pin-full"
}

# Every id that has a number is signalled even when another has none; the unknown
# ones are named and make the exit 2.
signal() {
    [[ $# -gt 0 ]] || die "usage: desk signal <module-id>..." 2
    local id n nums=() missing=0
    for id in "$@"; do
        n="$(signal_of "$id")"
        if [[ -n "$n" ]]; then nums+=("$n"); else echo "desk: no signal for '$id' in config.base" >&2; missing=1; fi
    done
    case "$(get bar)" in
        waybar-*)
            # -x: the process name only. -f would match any command line holding "waybar",
            # this script's callers included. Both bars (main and pin) get it.
            for n in $(printf '%s\n' "${nums[@]}" | sort -un); do
                pkill "-RTMIN+$n" -x waybar 2>/dev/null || true
            done ;;
        # The dotfiles-chips plugin's widgets re-run on the same number (chip.luau onIpc).
        noctalia)
            for n in $(printf '%s\n' "${nums[@]}" | sort -un); do
                noctalia msg plugin dotfiles/chips:chip all refresh "$n" >/dev/null 2>&1 || true
            done ;;
    esac
    [[ "$missing" == 0 ]] || exit 2
}

# show and drop work the same under every notifier. x-canonical-private-synchronous is the
# replace hint dunst and swaync both honour; swaync ignores x-dunst-stack-tag and a -r id it
# did not hand out. The server's id is kept so drop can close the popup over D-Bus.
# show keeps "<id> <bus owner>": an id is unique only within one notifier process, so drop
# closes it only while the same process owns the notification name. A restarted or switched
# notifier counts from 1 again, and the old id could be someone else's page.
# A tag is any text (agent-notify uses the page title), so a / in it is kept out of the path.
notify_file() {
    local dir="${XDG_RUNTIME_DIR:?desk notify needs XDG_RUNTIME_DIR}/desk"
    mkdir -p "$dir" && echo "$dir/notify-${1//\//%}.id"
}
notify_owner() {
    gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.GetNameOwner org.freedesktop.Notifications 2>/dev/null
}
# notify-send -p prints the id first. With --wait it prints the clicked action once the popup
# closes; show passes that on, so a caller that waits for a click reads it from show. The id is
# kept before the wait, so a drop meanwhile closes the popup and ends the wait.
notify_show() {
    [[ -n "${1:-}" ]] || die "usage: desk notify show <tag> <notify-send args>" 2
    local tag="$1" f id
    shift
    f="$(notify_file "$tag")" || exit 1
    rm -f "$f"
    {
        read -r id || return 1
        printf '%s %s\n' "$id" "$(notify_owner)" > "$f"
        cat
    } < <(notify-send -p -h "string:x-canonical-private-synchronous:$tag" "$@")
}
notify_drop() {
    [[ -n "${1:-}" ]] || die "usage: desk notify drop <tag>" 2
    local f id owner
    f="$(notify_file "$1")" || exit 1
    [[ -s "$f" ]] || return 0
    read -r id owner < "$f"
    rm -f "$f"
    [[ "$id" =~ ^[0-9]+$ && "$owner" == "$(notify_owner)" ]] || return 0
    gdbus call --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications \
        --method org.freedesktop.Notifications.CloseNotification "$id" >/dev/null 2>&1 || true
}

notify() {
    local verb="${1:-}"
    case "$verb" in
        show) shift; notify_show "$@"; return ;;
        drop) shift; notify_drop "$@"; return ;;
    esac
    case "$(get notify):$verb" in
        dunst:close)     dunstctl close ;;
        dunst:close-all) dunstctl close-all ;;
        dunst:history)   dunstctl history-pop ;;
        dunst:dnd)       dunstctl set-paused toggle ;;
        # hide, not close: a hidden popup stays in the panel, as dunst keeps a closed one
        # in its history. -sw: answer now, not after the panel animation.
        swaync:close)     swaync-client --hide-latest ;;
        swaync:close-all) swaync-client --hide-all ;;
        swaync:history)   swaync-client -t -sw ;;
        swaync:dnd)       swaync-client -d -sw ;;
        *) die "usage: desk notify close|close-all|history|dnd|show|drop" 2 ;;
    esac
}

# The Noctalia bar draws waybar's custom/* chips through the dotfiles-chips plugin
# (.local/share/noctalia/plugins/dotfiles-chips), which asks desk what each chip is, so
# config.base stays the one definition of every chip. Without a verb: how to run it, as
# {"mode": "poll|once|stream", "interval": seconds, "signal": n, "click", "right_click",
# "middle_click": cmd}. `run`: one run's output, a {"text", "tooltip", "class"} line per
# update, laid out by the module's "format" and "format-icons" as waybar does, markup
# stripped (Noctalia draws plain text). An exec-if that fails prints one empty chip, which
# hides it. `stream`: `run` again whenever it ends, as long as the bar reads it.
chip() {
    local id="${1:?usage: desk chip <module-id> [run|stream]}" conf
    # shellcheck source=../lib/waybar-config.sh
    . "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/waybar-config.sh"
    conf="$(waybar_config_json "$(waybar_dir)" | jq -c --arg m "$id" '.[$m] // empty')"
    [[ -n "$conf" ]] || die "no module '$id' in config.base" 2
    case "${2:-}" in
        "") jq -c '{
                mode: (if .interval == "once" then "once" elif (.interval | type) == "number" then "poll" else "stream" end),
                interval: (if (.interval | type) == "number" then .interval else 0 end),
                signal: (.signal // 0), click: (."on-click" // ""), right_click: (."on-click-right" // ""),
                middle_click: (."on-click-middle" // "")
            }' <<<"$conf" ;;
        run) chip_run "$id" "$conf" ;;
        stream) chip_stream "$id" "$conf" ;;
        *) die "usage: desk chip <module-id> [run|stream]" 2 ;;
    esac
}

chip_run() {
    local id="$1" conf="$2" cmd cond
    cmd="$(jq -r '.exec // empty' <<<"$conf")"
    [[ -n "$cmd" ]] || die "'$id' has no exec; Noctalia has its own widget for it" 2
    cond="$(jq -r '."exec-if" // empty' <<<"$conf")"
    if [[ -n "$cond" ]] && ! sh -c "$cond" >/dev/null 2>&1; then echo '{"text":"","tooltip":"","class":""}'; return; fi
    # A line that is not a JSON object is the chip's text, as waybar reads a plain chip.
    # {icon} looks up format-icons by the chip's alt, then "default". --unbuffered: a
    # streaming chip's lines reach the bar as they come.
    sh -c "$cmd" | jq -R -c --unbuffered --argjson m "$conf" '
        def ents: gsub("&lt;"; "<") | gsub("&gt;"; ">") | gsub("&quot;"; "\"")
            | gsub("&apos;"; "'"'"'") | gsub("&amp;"; "&");
        def plain: gsub("<[^>]*>"; "") | ents;
        # The pango subset the chip scripts write, as lines of styled runs for the detail panel:
        # t text, c colour (#rrggbb only: the panel takes no named or short colour, and bgcolor
        # is not a text colour), a alpha (0..1), b bold, m monospace (<tt>), i italic. Only known
        # tags are markup, so a stray "<" in a line stays text. Markup with no text is no detail.
        def tagstyle: if test("^<b>") then {b: true} elif test("^<tt>") then {m: true}
            elif test("^<i>") then {i: true}
            elif test("^<span") then
                ((capture("\\s(?:fgcolor|color|foreground)=[\\x22\\x27](?<c>#[0-9a-fA-F]{6})[\\x22\\x27]").c // null) as $c
                | (capture("\\s(?:fg)?alpha=[\\x22\\x27](?<a>[0-9]+)%").a // null) as $a
                | (if $c then {c: $c} else {} end) + (if $a then {a: ($a | tonumber / 100)} else {} end)
                + (if test("weight=[\\x22\\x27]bold") then {b: true} else {} end))
            else {} end;
        def detail: reduce scan("</?(?:b|i|u|s|tt|big|small|span)(?:\\s[^>]*)?>|[^<]+|<") as $tok
            ({lines: [[]], st: [{}]};
             if ($tok | test("^</[a-z]")) then (if (.st | length) > 1 then .st |= .[:-1] else . end)
             elif ($tok | test("^<[a-z]")) then .st += [.st[-1] + ($tok | tagstyle)]
             else .st[-1] as $s | ($tok | ents | split("\n")) as $parts
                 | reduce range(0; $parts | length) as $i (.;
                     (if $i > 0 then .lines += [[]] else . end)
                     | if $parts[$i] == "" then . else .lines[-1] += [$s + {t: $parts[$i]}] end)
             end) | .lines | if all(.[]; length == 0) then [] else . end;
        ((fromjson? | objects) // {text: .})
        | ((.text // "") | tostring) as $t | ((.alt // "") | tostring) as $alt
        | (if ($m."format-icons" | type) == "object" then ($m."format-icons"[$alt] // $m."format-icons".default // "") else "" end) as $icon
        | {text: (($m.format // "{}") | gsub("\\{(text)?\\}"; $t) | gsub("\\{icon\\}"; $icon) | gsub("\\{alt\\}"; $alt) | plain),
           tooltip: ((.tooltip // "") | tostring | plain),
           detail: ((.tooltip // "") | tostring | if . == "" then [] else detail end),
           class: (if (.class | type) == "array" then (.class[0] // "") else (.class // "") end)}'
}

# Waybar starts a stream once (again only with restart-interval); Noctalia's runStream
# never learns that it ended, so a chip whose watcher died, or whose exec-if failed while
# a dependency was not up yet, would hold its last value until the bar restarts. This runs
# it again after restart-interval, a documented cadence (default 5 s). It ends when the
# bar stops reading (SIGPIPE, status 141) or stops it, taking the chip's processes along.
STREAM_RESTART_DEFAULT=5
chip_stream() {
    local id="$1" conf="$2" wait_s pid rc
    wait_s="$(jq -r --argjson d "$STREAM_RESTART_DEFAULT" '."restart-interval" // $d' <<<"$conf")"
    trap 'kill_tree $$; exit 0' TERM INT HUP
    while :; do
        # In the background, so the trap runs at once instead of after the pipeline.
        chip_run "$id" "$conf" & pid=$!
        rc=0; wait "$pid" || rc=$?
        [[ "$rc" == 141 ]] && exit 0
        sleep "$wait_s" & wait $! || true
    done
}

# The bar's panels from a keybind (Super+A b, leader.lua). A custom/* chip opens its
# dropdown, the plugin's detail panel with the chip as context; anything else is a Noctalia
# panel id. `letters` sends each chip its key to show, or `off` to clear it (chip.luau onIpc).
# waybar has no panels to open, only hover tooltips, so it is refused there.
panel() {
    [[ $# -gt 0 ]] || die "usage: desk panel <custom/chip|panel-id> [context] | letters '<module>=<key> ...'|off" 2
    local bar
    bar="$(get bar)"
    [[ "$bar" == noctalia ]] || die "panels are on the noctalia bar, and the bar is $bar (desk use bar noctalia)" 2
    case "$1" in
        letters)  noctalia msg plugin dotfiles/chips:chip all letters "${2:?usage: desk panel letters <spec>|off}" >/dev/null ;;
        custom/*) noctalia msg panel-toggle dotfiles/chips:detail "$1" >/dev/null ;;
        *)        noctalia msg panel-toggle "$@" >/dev/null ;;
    esac
}

# kill_tree <pid>: every descendant of <pid>, deepest first (not <pid> itself).
kill_tree() {
    local c
    for c in $(pgrep -P "$1"); do kill_tree "$c"; kill "$c" 2>/dev/null || true; done
}

cmd="${1:-current}"
shift || true
case "$cmd" in
    current) for s in $(slots); do echo "$s=$(get "$s")"; done ;;
    get)     get "${1:?usage: desk get <slot>}" ;;
    parts)   if [[ $# -gt 0 ]]; then parts | awk -v s="$1" '$1 == s { print $1, $2, $3 }'; else parts | awk '{ print $1, $2, $3 }'; fi ;;
    use)     use "$@" ;;
    start)   start ;;
    signal)  signal "$@" ;;
    notify)  notify "$@" ;;
    chip)    chip "$@" ;;
    panel)   panel "$@" ;;
    -h|--help|help) awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0" ;;
    *)       die "unknown command '$cmd' (desk --help)" 2 ;;
esac
