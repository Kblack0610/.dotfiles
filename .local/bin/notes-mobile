#!/usr/bin/env bash
# notes-mobile: one-tap entry into today's daily note.
#
# With a PC named in ~/.config/notes-mobile/host, a tap opens that PC's hub on today's
# daily note (`tmx root hub`, what Prefix+N does there): one note, one editor, nothing to
# sync. Without one, or when the PC cannot be reached, it pulls, opens today's `~/.notes`
# daily note in neovim inside a persistent tmux session here, then pushes on exit.
# Designed for the Termux:Widget home-screen shortcut (~/.shortcuts/notes) but works on
# any machine for testing.
#
# The persistent `notes` tmux session is what makes it "stay there": reopening
# the phone reattaches to the same nvim, switched to today's note once the day
# has turned. It is also the seam the future mobile roadmap (swipeable panels/views) hangs off.
#
# No new sync logic: reuses notes-sync + the `notes` CLI + the notes.nvim plugin
# (loads automatically when nvim opens a file under ~/.notes).
#
# Env overrides:
#   NOTES_SYNC_CMD              sync command (default: ~/.local/bin/notes-sync)
#   NOTES_MIRROR_CMD            widget mirror command (default: ~/.local/bin/notes-mirror-shared)
#   NOTES_MOBILE_TMUX_SESSION   tmux session name (default: notes)
#   NOTES_MOBILE_HOST_FILE      file naming the hub PC (default: ~/.config/notes-mobile/host)

set -uo pipefail

SYNC_CMD="${NOTES_SYNC_CMD:-$HOME/.local/bin/notes-sync}"
SESSION="${NOTES_MOBILE_TMUX_SESSION:-notes}"

sync() {
    # Best-effort: offline or an unreachable remote must never block the editor.
    [ -x "$SYNC_CMD" ] && "$SYNC_CMD" >/dev/null 2>&1 || true
}

resolve_daily() {
    # `notes today` is idempotent (creates + links refs/backlogs); `notes path
    # daily` prints the profile-aware path. When the Rust CLI isn't built on this
    # device (e.g. a bare Termux phone), fall back to the personal-profile daily
    # path computed from the date so we still land on TODAY's note, not the root.
    local daily=""
    if command -v notes >/dev/null 2>&1; then
        notes today >/dev/null 2>&1 || true
        daily="$(notes path daily 2>/dev/null || true)"
    fi
    if [ -z "$daily" ]; then
        daily="$HOME/.notes/journal/daily/$(date +%F).md"
        mkdir -p "$(dirname "$daily")"
    fi
    printf '%s' "$daily"
}

# 0. The hub PC, when one is named: its first word is an ssh destination (an alias or a
#    LAN address). BatchMode so a missing key fails at once instead of asking for a password;
#    accept-new so the first tap trusts the PC instead of failing on an unknown host key.
#    ssh exits 255 only when it cannot connect, and then the phone copy opens, with a line
#    saying why. Any other exit is the hub session ending, and the tap is done.
HOST_FILE="${NOTES_MOBILE_HOST_FILE:-$HOME/.config/notes-mobile/host}"
HUB_HOST=""
[ -r "$HOST_FILE" ] && HUB_HOST="$(awk '!/^[[:space:]]*#/ && NF {print $1; exit}' "$HOST_FILE")"
if [ -n "$HUB_HOST" ]; then
    # shellcheck disable=SC2088 # the ~ is the PC's home, expanded by its shell
    ssh -t -o ConnectTimeout=4 -o BatchMode=yes -o StrictHostKeyChecking=accept-new "$HUB_HOST" '~/.local/bin/tmx root hub'
    rc=$?
    [ "$rc" -eq 255 ] || exit "$rc"
    printf 'hub unreachable (%s): opening the phone copy\n' "$HUB_HOST" >&2
    # A UI timer, not a wait on work: the editor would cover the line at once.
    [ -t 0 ] && read -r -t 3 _ 2>/dev/null
fi

# 1. Pull latest before opening.
sync

# 2. Resolve today's note.
DAILY="$(resolve_daily)"

# 3. One editor in one tmux session, always on today's note. nvim listens on a socket so
#    a later tap points the running editor at today (a session left open overnight would
#    otherwise reattach to yesterday's note). -D detaches the client in the previous Termux
#    session: that copy of this script then syncs and exits 0, and Termux closes a session
#    whose command exits 0, so taps never pile up sessions.
SOCK="${TMPDIR:-/tmp}/notes-mobile-$SESSION.sock"
if command -v tmux >/dev/null 2>&1; then
    if tmux has-session -t "=$SESSION" 2>/dev/null; then
        # Probe first: with no server behind the socket, `--remote` opens a local nvim instead
        # of failing. No answer means a session from before the socket, or its nvim is gone:
        # start over; unsaved edits survive in nvim's swap file, offered on the next open.
        # The timeout keeps a frozen nvim from hanging the tap. A failed switch (nvim at a
        # prompt) still attaches, so the human sees and answers it; an unsaved buffer does not
        # block it, since 'hidden' (on by default) keeps yesterday's edits in a hidden buffer.
        if timeout 3 nvim --server "$SOCK" --remote-expr 1 >/dev/null 2>&1 </dev/null; then
            timeout 3 nvim --server "$SOCK" --remote "$DAILY" >/dev/null 2>&1 </dev/null
        else
            tmux kill-session -t "=$SESSION"
        fi
    fi
    tmux has-session -t "=$SESSION" 2>/dev/null || rm -f "$SOCK"
    tmux new-session -A -D -s "$SESSION" nvim --listen "$SOCK" "$DAILY"
else
    nvim "$DAILY"
fi

# 4. Push whatever changed on detach/exit.
sync

# 5. Refresh the home-screen widget mirror (Termux only; self-skips elsewhere). By path
#    like SYNC_CMD: Termux's PATH has no ~/.local/bin, where notes-phone-setup installs it.
MIRROR_CMD="${NOTES_MIRROR_CMD:-$HOME/.local/bin/notes-mirror-shared}"
[ -x "$MIRROR_CMD" ] && "$MIRROR_CMD" >/dev/null 2>&1 || true
