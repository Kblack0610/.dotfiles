#!/usr/bin/env bash
# coord-watch - the event stream a /coordinate session waits on: one line per chain event
# (~/.local/state/notes/ingest.jsonl) on a row, item or PR the session still tracks.
#
#   coord-watch --until <plan.md> [--from <writer>]...   print the first events, then exit 0 (exit 3: no open line, 4: the record ended first)
#   coord-watch <plan.md> [--from <writer>]...   follow the record, one line per event (exit 3: no open line)
#   coord-watch filter <plan.md> [--from w]... [--since ts] [--cursor file] [--batch s]   the filter over stdin
#   coord-watch ids <plan.md>                    the tracked tokens, one per line
#
# Tracked: the first word of each open `- [ ]` line under the plan's `## Follow-through`. An event
# matches on its id, item or a pr word, or on text carrying `#from/<writer>` (triage acting on the
# session's outbox follow-ups). Writers: $AGENT_QUEUE_ITEM, $CLAUDE_CODE_SESSION_ID's first 8
# characters (notes-cli ingest.rs writer()), each --from. The session's own writes and bookkeeping
# actions drop; every other action passes, so an unlisted failure still reaches the coordinator.
# A cursor (the ts of the last event read) makes each re-arm replay what landed while unarmed.
# Follow mode also writes session-<CLAUDE_CODE_SESSION_ID>.pid (its pid and the plan) while it runs.
set -euo pipefail

: "${COORD_WATCH_LOG:=$HOME/.local/state/notes/ingest.jsonl}"
: "${COORD_WATCH_STATE:=${XDG_STATE_HOME:-$HOME/.local/state}/coord-watch}"
# Lines re-read on each arm before the cursor filter: about two weeks of the record's usual rate.
REPLAY_LINES=20000
# --until: after the first event, how long to keep reading so a burst (merged, done) wakes the
# session once. A cap on one batch, not a poll: the wait for the first event has no timeout.
: "${COORD_WATCH_BATCH_S:=5}"
# Actions that record bookkeeping, not progress: never a coordinator's cue.
NOISE='["item-set","tagged","edited","detailed","sweep","sweep-stopped","item-claimed","running"]'

usage() { grep '^#   coord-watch ' "$0" | sed 's/^#   //' >&2; exit 2; }

ids() {
  [ -f "$1" ] || { echo "coord-watch: no plan at $1" >&2; exit 2; }
  grep -qE '^## Follow-through[[:space:]]*$' "$1" ||
    { echo "coord-watch: $1 has no '## Follow-through' section" >&2; exit 2; }
  awk '/^## /{on = ($0 ~ /^## Follow-through[[:space:]]*$/); next}
       on && /^[[:space:]]*- \[ \] /{sub(/^[[:space:]]*- \[ \] /, ""); split($0, w, /[[:space:]]+/)
         gsub(/^[`*]+|[`*:,.;]+$/, "", w[1]); if (w[1] != "") print w[1]}' "$1"
}

filter() {
  local plan="$1"; shift
  # printed: each match already printed. A prune replaces the record and `tail -F` re-reads it
  # whole, so a match seen again is a replay. A set, not a newest ts: two writers can append out
  # of ts order, and a newest-ts skip would drop the later-written one.
  local writers=("") since="" cursor="" batch="" deadline="" left tracked kind ts out any=
  local -A printed=()
  [ -n "${AGENT_QUEUE_ITEM:-}" ] && writers+=("$AGENT_QUEUE_ITEM")
  [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && writers+=("${CLAUDE_CODE_SESSION_ID:0:8}")
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) [ -n "${2:-}" ] || usage; writers+=("$2"); shift 2 ;;
      --since) since="${2:-}"; shift 2 ;;
      --cursor) [ -n "${2:-}" ] || usage; cursor="$2"; shift 2 ;;
      --batch) [[ "${2:-}" =~ ^[0-9]+$ ]] || usage; batch="$2"; shift 2 ;;
      *) usage ;;
    esac
  done
  tracked="$(ids "$plan" | jq -R . | jq -sc .)"
  # One output line per event read, unit-separated (a tab is IFS whitespace, so read would merge an
  # empty ts): R ts for a skip, E ts text for a match, so the
  # cursor advances past every event read, matched or not. ts compares as text: the record writes
  # one local ISO form, off by the hour only across a DST change.
  # A process substitution, not a pipe, so a --batch loop that ends can kill jq: a pipeline would
  # wait on jq, which waits on a quiet tail -F forever.
  events() { jq --unbuffered -rR --argjson ids "$tracked" --argjson noise "$NOISE" --arg since "$since" \
    --argjson writers "$(printf '%s\n' "${writers[@]}" | jq -R 'select(. != "")' | jq -sc .)" '
    def s: if . == null then "" else tostring end;
    fromjson? // empty
    | select(type == "object")
    | (.ts | s) as $ts
    | select($since == "" or $ts > $since)
    | (.text | s) as $text | (.why | s) as $why | (.pr | s) as $pr
    | ([(.id | s), (.item | s)] + [$pr | splits("[ ]+")] | map(select(. != ""))) as $keys
    | if ((.action | s) as $a | $noise | index($a)) or ((.by | s) as $b | $writers | index($b))
         or ((any($keys[]; . as $k | $ids | index($k))
              or any($writers[]; . as $w | $text | test("#from/" + $w + "([^A-Za-z0-9_.-]|$)"))) | not)
      then "R\u001f\($ts)"
      else "E\u001f\($ts)\u001f" +([(.action | s), ((.id // .item) | s | if . == "" then "-" else . end),
             (if (.item | s) != "" and (.id | s) != "" then "item=\(.item)" else empty end),
             (if $pr != "" then "pr=\($pr)" else empty end),
             (if (.to | s) != "" then "to=\(.to)" else empty end),
             (if $why != "" then "why=\($why[0:300])" else empty end),
             "| \($text[0:160])"] | join(" ") | gsub("[\n\u001f]"; " "))
      end'; }
  while :; do
    # --batch: the first match starts the window; reading stops at its end, so the cursor stays
    # on the last event read and a re-arm replays whatever came after.
    if [ -n "$deadline" ]; then
      left=$((deadline - EPOCHSECONDS))
      [ "$left" -gt 0 ] && IFS=$'\x1f' read -r -t "$left" kind ts out || break
    else
      IFS=$'\x1f' read -r kind ts out || break
    fi
    [ -n "$cursor" ] && [ -n "$ts" ] && printf '%s\n' "$ts" > "$cursor"
    [ "$kind" = E ] || continue
    if [ -n "$ts" ]; then
      [ -n "${printed["$ts $out"]+x}" ] && continue
      printed["$ts $out"]=1
    fi
    printf '%s\n' "$out"; any=1
    [ -z "$batch" ] || [ -n "$deadline" ] || deadline=$((EPOCHSECONDS + batch))
  done < <(events)
  # The subshell running this still waits on jq at exit, and jq waits on a quiet tail -F.
  [ -z "$batch" ] || kill "$!" 2>/dev/null || true
  # The window opens only on a print, so a --batch loop that printed nothing ended on EOF: the tail
  # died. An exit 0 there would read as an empty wake, and a re-arm on it as the loop this mode ends.
  [ -z "$batch" ] || [ -n "$any" ] || { echo "coord-watch: the record stream ended with no event (tail -F of $COORD_WATCH_LOG exited)" >&2; return 4; }
  return 0
}

case "${1:-}" in
  ''|-h|--help) usage ;;
  ids) [ -n "${2:-}" ] || usage; ids "$2" ;;
  filter) [ -n "${2:-}" ] || usage; shift; filter "$@" ;;
  *)
    until=""
    if [ "$1" = --until ]; then until=1; shift; [ -n "${1:-}" ] || usage; fi
    plan="$1"; shift
    # A ledger with every line ticked tracks nothing, so a watch on it is a 30 minute timer that only wakes
    # the session: 2026-11-22 a coordinator re-armed one 58 times over 29h waiting on its validation ask.
    # The validation wait is coordinate step 6 (the ask with reopen-on-answer), not a watch.
    open="$(ids "$plan")" || exit $?
    mkdir -p "$COORD_WATCH_STATE"
    # The session's plan, kept past the watch's exit (the mark below goes with it), so the Stop check
    # can tell a ticked ledger from a missing watch. Coordinate step 7 removes it.
    [ -z "${CLAUDE_CODE_SESSION_ID:-}" ] ||
      printf '%s\n' "$(cd "$(dirname "$plan")" && pwd)/$(basename "$plan")" > "$COORD_WATCH_STATE/session-$CLAUDE_CODE_SESSION_ID.plan"
    [ -n "$open" ] || {
      echo "coord-watch: no open line under '## Follow-through' in $plan, so there is nothing to watch; the validation wait is coordinate step 6" >&2
      exit 3; }
    # A row id or slug (lowercase words joined by '-', one with a digit) that no event ever carried, no
    # board row has and no queue item is named can never match: 2026-11-23 a ledger named a phase by a
    # slug its item never had (the events carried ar-4707), and its coordinator waited on it all day.
    # Outbox text (`2FA`, `v2`) is not that shape, and an owner/repo#N is a PR, matched on pr words.
    # A board that cannot be read refuses nothing: an unverified id is not a known-bad one.
    unknown="$(grep -E '^[a-z0-9]+(-[a-z0-9]+)+$' <<<"$open" | grep '[0-9]' || true)"
    if [ -n "$unknown" ]; then
      seen="$(grep -ohF -f <(sed 's/.*/"&"/' <<<"$unknown") "$COORD_WATCH_LOG" 2>/dev/null | tr -d '"' | sort -u || true)"
      unknown="$(grep -vxF -f <(printf '%s\n' "$seen") <<<"$unknown" || true)"
    fi
    if [ -n "$unknown" ]; then
      if rows="$(notes board --json 2>/dev/null | jq -er '[.. | objects | select(has("id") and has("text")) | .id] | .[]' 2>/dev/null)"; then
        unknown="$(grep -vxF -f <(printf '%s\n' "$rows") <<<"$unknown" || true)"
        unknown="$(while read -r w; do agent-queue show "$w" >/dev/null 2>&1 || echo "$w"; done <<<"$unknown")"
      else
        echo "coord-watch: notes board gave no rows, so $(paste -sd' ' <<<"$unknown") went unchecked" >&2; unknown=""
      fi
    fi
    [ -z "$unknown" ] || {
      echo "coord-watch: no event, board row or queue item carries $(paste -sd' ' <<<"$unknown") in $plan, so those lines can never match; name the row id (ar-N) the chain events carry" >&2
      exit 2; }
    # The armed mark: stop-post.d/89-coord-watch.sh blocks a coordinator's turn end while no live
    # watch of its own session is recorded here. A kill that skips the trap leaves the file; the
    # reader checks the pid is a live coord-watch, so a stale file never passes. A re-arm overlaps
    # the old watch, so an exit removes the mark only while it still records this pid.
    if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
      mark="$COORD_WATCH_STATE/session-$CLAUDE_CODE_SESSION_ID.pid"
      printf '%s %s\n' "$$" "$(cd "$(dirname "$plan")" && pwd)/$(basename "$plan")" > "$mark"
      trap '[ "$(cut -d" " -f1 "$mark" 2>/dev/null)" != "$$" ] || rm -f "$mark"' EXIT
    else
      echo "coord-watch: no CLAUDE_CODE_SESSION_ID, so no armed mark for the Stop check" >&2
    fi
    cursor="$COORD_WATCH_STATE/$(basename "$plan" .md).ts"
    since="$(cat "$cursor" 2>/dev/null || date +%Y-%m-%dT%H:%M:%S.%N%:z)"
    # The filter runs in the background so a TERM (TaskStop, a Monitor's expiry) ends this script at
    # once: bash defers a trap while a foreground command runs, and a script left alive would keep
    # the mark of a watch nobody reads. tail is a process substitution, not a pipe, because a wait
    # on a pipeline waits for all of it, and tail -F on a quiet record never ends.
    exec 5< <(tail -n "$REPLAY_LINES" -F "$COORD_WATCH_LOG" 2>/dev/null)
    tailpid=$!
    filter "$plan" "$@" --since "$since" --cursor "$cursor" ${until:+--batch "$COORD_WATCH_BATCH_S"} <&5 5<&- &
    trap 'kill "$tailpid" $(jobs -p) 2>/dev/null; exit 143' TERM INT HUP
    rc=0; wait "$!" || rc=$?
    kill "$tailpid" 2>/dev/null || true
    exit "$rc" ;;
esac
