#!/usr/bin/env bash
# agentctl-claude - the ONE place an agentctl runner invokes Claude.
#
# Resolves $AGENTCTL_ROLE (or $ROLE) into the flags that give a runner exactly the
# capability its role needs, then execs claude. Every runner calls this instead of
# `claude -p` directly.
#
# WHY A WRAPPER AND NOT PER-SCRIPT FLAGS
# There are 17 `claude -p` call sites across 7 runner scripts. Scoping them
# individually drifts, and we have proof: on 2026-07-28 an --mcp-config fix was
# applied directly to delivery-loop and was silently WIPED TWICE within the hour
# when that script was rewritten underneath it. A capability restriction that can
# be lost by an unrelated edit is not a restriction. One choke point, or none.
#
# THE TWO LEVERS (they are not interchangeable)
#   --mcp-config X --strict-mcp-config   controls which servers SPAWN
#   --allowedTools                       controls which tools may be CALLED
# An allowlist alone still starts every user-scope server: that is how 11 idle
# sessions each ended up holding a HEADED browser nobody asked for. A strict MCP
# config alone would leave a role able to call any built-in tool. Roles set both.
#
# FAILS CLOSED. An unknown/missing role exits non-zero WITHOUT running claude. A
# typo in a .conf must not silently restore full privilege - the whole point is
# that the restriction holds when someone is not looking.
#
# Usage:  AGENTCTL_ROLE=builder agentctl-claude -p "<prompt>" [--max-turns N ...]
#         agentctl-claude --role observer -p "<prompt>"
#         agentctl-claude --explain builder     # print resolved flags, run nothing
#
# Roles live in $AGENTCTL_ROLES (default ~/.config/agentctl/roles/<role>.role),
# MCP sets in ~/.config/agentctl/mcp/<name>.json.
set -euo pipefail

ROLES_DIR="${AGENTCTL_ROLES:-$HOME/.config/agentctl/roles}"
MCP_DIR="${AGENTCTL_MCP:-$HOME/.config/agentctl/mcp}"

die() { echo "agentctl-claude: $*" >&2; exit 78; }  # 78 = EX_CONFIG

explain=""
role="${AGENTCTL_ROLE:-${ROLE:-}}"
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --role)    role="${2:?--role needs a value}"; shift 2 ;;
    --explain) explain="${2:-$role}"; role="${explain}"; shift 2 || shift ;;
    *)         args+=("$1"); shift ;;
  esac
done

[ -n "$role" ] || die "no role set. Pass --role <name> or set AGENTCTL_ROLE in the agent's .conf.
Available: $(ls -1 "$ROLES_DIR" 2>/dev/null | sed 's/\.role$//' | tr '\n' ' ')"

role_file="$ROLES_DIR/$role.role"
[ -r "$role_file" ] || die "unknown role '$role' (no $role_file).
Available: $(ls -1 "$ROLES_DIR" 2>/dev/null | sed 's/\.role$//' | tr '\n' ' ')"

# Defaults exist so a role file missing a key fails loudly below rather than
# silently inheriting everything.
ROLE_DESC=""; ROLE_MCP=""; ROLE_TOOLS=""; ROLE_PERMISSION_MODE=""
# shellcheck source=/dev/null
. "$role_file"

[ -n "$ROLE_TOOLS" ] || die "role '$role' defines no ROLE_TOOLS. Refusing to run unrestricted."
[ -n "$ROLE_MCP" ]   || die "role '$role' defines no ROLE_MCP (use 'none' or 'inherit' to be explicit)."

flags=(--allowedTools "$ROLE_TOOLS")
[ -n "$ROLE_PERMISSION_MODE" ] && flags+=(--permission-mode "$ROLE_PERMISSION_MODE")

case "$ROLE_MCP" in
  inherit)
    # Deliberate: see comms.role. Enforcement is allowlist-only for OAuth remotes
    # that cannot be expressed as stdio entries in an --mcp-config file.
    ;;
  *)
    mcp_file="$MCP_DIR/$ROLE_MCP.json"
    [ -r "$mcp_file" ] || die "role '$role' wants MCP set '$ROLE_MCP' but $mcp_file is unreadable.
Failing closed rather than inheriting the full user-scope server list."
    flags+=(--mcp-config "$mcp_file" --strict-mcp-config)
    ;;
esac

# Headless by definition: there is no human on a timer to answer a prompt or read
# a plan. Mirrors the prompt agentctl-dream and agentctl-nightly-sync already use.
flags+=(--append-system-prompt 'You are running headless on a timer with no human present. Never enter plan mode, never write a plan file, and never ask for approval - there is nobody to answer. Execute the task directly and report what you did.')

if [ -n "$explain" ]; then
  printf 'role:        %s\n' "$role"
  printf 'description: %s\n' "$ROLE_DESC"
  printf 'mcp:         %s\n' "$ROLE_MCP"
  printf 'flags:       claude'
  printf ' %q' "${flags[@]}"
  printf '\n'
  exit 0
fi

exec claude "${flags[@]}" "${args[@]}"
