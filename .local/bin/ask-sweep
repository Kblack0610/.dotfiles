#!/usr/bin/env bash
# ask-sweep: the catch for work that fell off, a runner four times a day. A session files what did
# not land when it winds down; this finds what still slipped past that.
#
#   ask-sweep run [--dry-run]   file rows for unfinished plans and missed asks
#
# Plans: a plan with unticked phases, no live session and no change for a day gets one row, keyed
# by its slug so it is never filed twice. No model. Plans older than the first run are not
# back-filled. A plan with no checklist and no Results is only counted, since many of those landed.
# Asks: the human's messages from quiet sessions in every repo with a board and no client (the
# registry: project_board, project_inherited client), grouped by board, one model call per board
# that has new ones, matched against that board's open rows and its repos' merged PRs. A live
# session is left to its own wind-down. Each transcript keeps a watermark in since/<board>, moved
# only when its board's call succeeds, so a failed board is asked again and an idle one costs no
# call. It never closes a row, and files at most ASK_SWEEP_MAX rows a run.
set -uo pipefail

: "${ASK_SWEEP_DIR:=$HOME/.agent/ask-sweep}"
: "${ASK_SWEEP_PLANS:=$HOME/.claude/plans}"
: "${ASK_SWEEP_PLAN_CACHE:=$HOME/.agent/plans}"
: "${ASK_SWEEP_TRANSCRIPTS:=$HOME/.claude/projects}"
: "${ASK_SWEEP_LOOKBACK_MIN:=2880}"            # a message older than this is never read
: "${ASK_SWEEP_MAX:=15}"
: "${ASK_SWEEP_MSG_BYTES:=70000}"
: "${ASK_SWEEP_QUIET_MIN:=60}"                  # a transcript written this recently is a live session
: "${ASK_SWEEP_CMD:=agentctl-run --agent ask-sweep}"
NAME="${AGENTCTL_NAME:-ask-sweep}"

HERE="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
# shellcheck source=/dev/null
. "$HERE/../lib/agent-proof.sh"
# shellcheck source=/dev/null
. "$HERE/../lib/plan-phases.sh"
# The registry's resolver: this tree's project-name.sh (PROJECT_NAME_LIB when the script runs
# outside it, as fleet-dispatch and agent-queue take it).
# shellcheck source=../../.config/shared-hooks/project-name.sh
. "${PROJECT_NAME_LIB:-$HERE/../../.config/shared-hooks/project-name.sh}"

DRY=0; FILED=0; OVER=0; PLANS_OPEN=0; PLANS_UNCHECKED=0; ASKED=0; FAULT=0
declare -A NO_BOARD=()

say() { printf 'ask-sweep: %s\n' "$*" >&2; }
ascii() { tr -cd ' -~' | tr -d '#' | cut -c1-"${1:-200}"; }
sig() { sha256sum | cut -c1-12; }

# file_row [--sheet] <board> <text>: one row within the run's cap. Returns 1 when not filed;
# an open twin already on the board (`ptask add` exit 3) counts as filed.
file_row() {
  local lane=(--agent); [ "$1" = --sheet ] && { lane=(); shift; }
  local board="$1" text="$2"
  if [ "$FILED" -ge "$ASK_SWEEP_MAX" ]; then OVER=$((OVER + 1)); return 1; fi
  FILED=$((FILED + 1))
  if [ "$DRY" = 1 ]; then printf 'would file [%s] %s\n' "$board" "$text"; return 0; fi
  notes ptask "$board" "${lane[@]}" add "$text" >/dev/null 2>&1
  local rc=$?
  [ "$rc" = 0 ] || [ "$rc" = 3 ]
}

# board_of <project> -> its board, or nothing (project-name.sh's project_board)
board_of() { project_board "$1"; }

sweep_plans() {
  local first live f slug done_n total next project board
  first="$ASK_SWEEP_DIR/first-run"
  # The first real run only starts the clock, and a dry run before it has nothing to report.
  if [ ! -f "$first" ]; then
    [ "$DRY" = 1 ] || touch "$first"
    return 0
  fi
  live="$(fleet-sessions --json 2>/dev/null | jq -r '.. | .plan_file? // empty' 2>/dev/null)"
  while IFS= read -r -d '' f; do
    [ "$f" -ot "$first" ] && continue
    IFS=$'\t' read -r done_n total next < <(plan_phases "$f")
    slug="$(basename "$f" .md)"
    if [ "$total" = - ]; then
      grep -qi '^## results' "$f" || PLANS_UNCHECKED=$((PLANS_UNCHECKED + 1))
      continue
    fi
    [ "$done_n" -lt "$total" ] || continue
    PLANS_OPEN=$((PLANS_OPEN + 1))
    grep -qxF "$f" <<<"$live" && continue
    grep -qxF "$slug" "$ASK_SWEEP_DIR/plans-filed" 2>/dev/null && continue
    project="$(find "$ASK_SWEEP_PLAN_CACHE" -mindepth 2 -maxdepth 2 -name "$slug.md" -printf '%h\n' -quit 2>/dev/null)"
    [ -n "$project" ] || continue
    board="$(board_of "$(basename "$project")")"
    [ -n "$board" ] || continue
    if notes ptask "$board" --agent list 2>/dev/null | grep -qF "$slug"; then
      [ "$DRY" = 1 ] || echo "$slug" >> "$ASK_SWEEP_DIR/plans-filed"
      continue
    fi
    if file_row "$board" "chore(plan): finish $slug: $((total - done_n)) phases left, next: $(ascii 100 <<<"$next") #requested #tier/2 #size/m"; then
      [ "$DRY" = 1 ] || echo "$slug" >> "$ASK_SWEEP_DIR/plans-filed"
    fi
  done < <(find "$ASK_SWEEP_PLANS" -maxdepth 1 -name '*.md' -mmin +1440 -print0 2>/dev/null)
}

# transcripts -> "<board>\t<checkout>\t<file>" for each quiet transcript written inside the lookback,
# in a repo with a board and no client. A session's cwd names its project (resolve_project_name),
# read once a dir; the checkout is where that project's merged PRs are listed.
transcripts() {
  local d f cwd p b r
  while IFS= read -r d; do
    f="$(find "$d" -maxdepth 1 -name '*.jsonl' -print -quit)"
    cwd="$(head -n 50 "$f" | jq -r 'select(.cwd? | type == "string") | .cwd' 2>/dev/null | head -1)"
    [ -n "$cwd" ] || continue
    p="$(resolve_project_name "$cwd")"
    [ -z "$(project_inherited "$p" client)" ] || continue
    b="$(board_of "$p")"
    [ -n "$b" ] || { NO_BOARD["$p"]=1; continue; }
    r="$(project_repo_path "$p")"
    find "$d" -maxdepth 1 -name '*.jsonl' -mmin +"$ASK_SWEEP_QUIET_MIN" -mmin -"$ASK_SWEEP_LOOKBACK_MIN" -printf "$b\t${r:--}\t%p\n"
  done < <(find "$ASK_SWEEP_TRANSCRIPTS" -mindepth 2 -maxdepth 2 -name '*.jsonl' \
             -mmin +"$ASK_SWEEP_QUIET_MIN" -mmin -"$ASK_SWEEP_LOOKBACK_MIN" -printf '%h\n' 2>/dev/null | sort -u)
}

# human_messages <since file> <file>...: "<file>\t<timestamp>\t<message as a JSON string>" for what
# the human typed after each file's watermark (else the lookback's start).
human_messages() {
  local since="$1" floor f from; shift
  floor="$(date -u -d "-$ASK_SWEEP_LOOKBACK_MIN min" +%FT%T)"
  for f in "$@"; do
    from="$(awk -F'\t' -v f="$f" '$1 == f { t = $2 } END { print t }' "$since" 2>/dev/null)"
    [[ "${from:-}" > "$floor" ]] || from="$floor"
    jq -r --arg from "$from" --arg f "$f" '
      select(.type == "user" and (.isSidechain | not) and (.isMeta | not)
        and ((.timestamp // "") > $from))
      | .timestamp as $ts
      | .message.content
      | if type == "array" then
          if any(.[]; .type? == "tool_result") then empty
          else map(select(.type? == "text") | .text) | join(" ") end
        else . end
      | select(type == "string") | gsub("^\\s+"; "")
      | select(startswith("<") or startswith("Base directory") or startswith("This session")
          or contains("system-reminder") or startswith("[Request interrupted") | not)
      | select(length > 0) | "\($f)\t\($ts)\t\(.[0:800] | tojson)"' "$f" 2>/dev/null
  done
}

# sweep_board <board> <checkouts> <file>...: one model call over the board's new messages; files
# its rows and moves the watermarks only when the call answered.
sweep_board() {
  local board="$1" repos="$2" since msgs text open_rows prs prompt wd out rc line quote row tier size
  local done_is human key tags asked floor r; shift 2
  since="$ASK_SWEEP_DIR/since/$board"
  # Oldest first up to ASK_SWEEP_MSG_BYTES: the prompt is one argument, and Linux limits one to
  # 128 KB. What does not fit is past the watermarks this call moves, so the next run reads it.
  msgs="$(human_messages "$since" "$@" | sort -t$'\t' -k2,2 \
    | awk -F'\t' -v max="$ASK_SWEEP_MSG_BYTES" '{ n += length($3) + 1 } n > max { cut++; next } { print }
        END { if (cut) printf "%d\n", cut > "/dev/stderr" }' 2>"$ASK_SWEEP_DIR/.cut")"
  [ -s "$ASK_SWEEP_DIR/.cut" ] && say "$board: $(cat "$ASK_SWEEP_DIR/.cut") messages wait for the next run"
  rm -f -- "$ASK_SWEEP_DIR/.cut"
  [ -n "$msgs" ] || return 0
  ASKED=$((ASKED + 1))
  text="$(cut -f3 <<<"$msgs" | awk '!seen[$0]++')"
  open_rows="$({ notes ptask "$board" --agent list 2>/dev/null; notes ptask "$board" list 2>/dev/null; } | cut -f4 | cut -c1-90)"
  floor="$(cut -f2 <<<"$msgs" | sort | head -1)"
  prs="$(while IFS= read -r r; do
      [ -d "$r" ] && (cd "$r" && gh pr list --state merged --limit 200 --search "merged:>=${floor:0:10}" --json title -q '.[].title' 2>/dev/null)
    done <<<"$repos")"
  # The instructions are the ask-sweep agent's PROMPT file; agentctl-run puts them ahead of this.
  prompt="## Messages ($board)
$text

## Open rows
$open_rows

## Merged PRs
$prs"
  wd="$(mktemp -d)"
  # shellcheck disable=SC2086 # a word list by design, overridable in tests
  # An empty directory, so no repo's Stop hook answers in place of the model.
  out="$(cd "$wd" && $ASK_SWEEP_CMD -p "$prompt" 2>/dev/null)"; rc=$?
  rm -rf -- "$wd"
  case "$rc" in
    0) ;;
    75) say "$board: stopped at its budget"; proof_why "$board: stopped at its budget"; return 1 ;;
    *) FAULT=1; say "$board: model call failed (exit $rc)"; proof_why "$board: model call failed (exit $rc)"; return 1 ;;
  esac
  grep -qx 'ASK-SWEEP-START' <<<"$out" || { FAULT=1; say "$board: model returned no answer block"; proof_why "$board: the model returned no answer block"; return 1; }
  while IFS= read -r line; do
    jq -e 'type == "object" and (.row | type) == "string" and (.quote | type) == "string"' <<<"$line" >/dev/null 2>&1 || continue
    quote="$(jq -r .quote <<<"$line" | ascii 80)"
    row="$(jq -r .row <<<"$line" | ascii 150)"
    tier="$(jq -r '.tier // 3 | floor' <<<"$line" 2>/dev/null)"; [[ "$tier" =~ ^[123]$ ]] || tier=3
    size="$(jq -r '.size // "L"' <<<"$line")"; [[ "$size" =~ ^[SML]$ ]] || size=L
    done_is="$(jq -r '.done_is_stated // false' <<<"$line")"
    human="$(jq -r '.human_only // false' <<<"$line")"
    [ -n "$row" ] || continue
    # The same words on a later run, or the same run twice, are never filed again.
    key="$(printf '%s' "$quote" | tr '[:upper:]' '[:lower:]' | sig)"
    grep -qxF "$key" "$ASK_SWEEP_DIR/asks-filed" 2>/dev/null && continue
    # The day the quoted message was sent, else the newest message's.
    asked="$(awk -F'\t' -v q="$(tr '[:upper:]' '[:lower:]' <<<"$quote")" 'index(tolower($3), q) { print $2; exit }' <<<"$msgs")"
    [ -n "$asked" ] || asked="$(cut -f2 <<<"$msgs" | sort | tail -1)"
    asked="${asked:5:5}"
    tags="#requested #tier/$tier #size/${size,,}"
    [ "$tier" -le 2 ] && [ "$size" = S ] && [ "$done_is" = true ] && [ "$human" != true ] && tags+=" #worker/requested"
    if [ "$human" = true ]; then
      file_row --sheet "$board" "$row; asked $asked \"$quote\" #low" || continue
    else
      file_row "$board" "$row; asked $asked \"$quote\" $tags" || continue
    fi
    [ "$DRY" = 1 ] || echo "$key" >> "$ASK_SWEEP_DIR/asks-filed"
  done < <(sed -n '/^ASK-SWEEP-START$/,/^ASK-SWEEP-END$/p' <<<"$out" | sed '1d;$d')
  [ "$DRY" = 1 ] && return 0
  # The newest message read is each file's watermark; one older than the lookback is dropped.
  mkdir -p "$ASK_SWEEP_DIR/since"
  floor="$(date -u -d "-$ASK_SWEEP_LOOKBACK_MIN min" +%FT%T)"
  { cat "$since" 2>/dev/null; cut -f1,2 <<<"$msgs"; } \
    | awk -F'\t' -v floor="$floor" '$2 > floor && $2 > t[$1] { t[$1] = $2 } END { for (f in t) print f "\t" t[f] }' \
    | sort > "$since.tmp" && mv "$since.tmp" "$since"
}

sweep_asks() {
  local rc=0 board repo file files list
  local -A by=() repos=()
  # Into a file, not a pipe: transcripts counts into this shell's NO_BOARD and FAULT.
  list="$(mktemp)"; transcripts > "$list"
  while IFS=$'\t' read -r board repo file; do
    [ -n "$file" ] || continue
    by["$board"]+="$file"$'\n'; repos["$board"]+="$repo"$'\n'
  done < "$list"
  rm -f -- "$list"
  for board in "${!by[@]}"; do
    mapfile -t files < <(printf '%s' "${by[$board]}" | sort -u)
    sweep_board "$board" "$(printf '%s' "${repos[$board]}" | sort -u)" "${files[@]}" || rc=1
  done
  return "$rc"
}

cmd_run() {
  local rc=0 summary verdict
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY=1; shift ;;
      *) say "unknown argument: $1"; return 2 ;;
    esac
  done
  mkdir -p "$ASK_SWEEP_DIR"
  sweep_plans
  sweep_asks || rc=1
  [ "$FAULT" = 0 ] || rc=1
  summary="asked $ASKED boards, filed $FILED, over the cap $OVER, ${#NO_BOARD[@]} projects with no board, open plans $PLANS_OPEN, no checklist $PLANS_UNCHECKED"
  say "$summary"
  [ "$DRY" = 1 ] && return "$rc"
  verdict=NOOP
  [ "$FILED" -gt 0 ] && verdict=WORKED
  # A budget stop alone is the cap holding, not a fault; the watermarks resume it next run.
  [ "$rc" != 0 ] && verdict=BLOCKED
  [ "$FAULT" = 1 ] && verdict=FAILED
  proof_report "$NAME" "$verdict" "$summary"
  return "$rc"
}

main() {
  case "${1:-}" in
    run) shift; cmd_run "$@" ;;
    *) sed -n '2,5p' "$0" >&2; return 2 ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
