#!/usr/bin/env bash
# ask-sweep: the catch for work that fell off, a runner four times a day. A session files what did
# not land when it winds down; this finds what still slipped past that.
#
#   ask-sweep run [--dry-run]   file rows for unfinished plans and missed asks
#
# Plans: a plan fleet-dispatch reap has not filed (reconcile_plans, its plans-filed record), with unticked
# phases, no live session and no change for a day is filed via agent-queue add --plan; an open row that names
# its slug already stops a second one, and so does an open row each open phase takes (plan_rows_hold).
# A plan whose Phases checklist agent-queue cannot read gets a `fix(plan)` row instead (file_plan).
# No model. Plans older than the first run are not back-filled. A plan with no checklist and no Results
# is only counted, since many of those landed.
# Asks: the human's messages from quiet sessions in every repo with a board and no client (the
# registry: project_board, project_inherited client), grouped by board, one model call per board
# that has new ones, matched against that board's open rows and its repos' merged PRs. A live
# session is left to its own wind-down. Each transcript keeps a watermark in since/<board>, moved
# only when its board's call succeeds, so a failed board is asked again and an idle one costs no
# call. It never closes a row, and files at most ASK_SWEEP_MAX rows a run.
set -uo pipefail

: "${ASK_SWEEP_DIR:=$HOME/.agent/ask-sweep}"
: "${ASK_SWEEP_PLANS:=$HOME/.claude/plans}"
: "${ASK_SWEEP_PLAN_CACHE:=$HOME/.agent/plans}"
: "${ASK_SWEEP_TRANSCRIPTS:=$HOME/.claude/projects}"
: "${ASK_SWEEP_LOOKBACK_MIN:=2880}"            # a message older than this is never read
: "${ASK_SWEEP_MAX:=15}"
: "${ASK_SWEEP_MSG_BYTES:=70000}"
: "${ASK_SWEEP_QUIET_MIN:=60}"                  # a transcript written this recently is a live session
: "${ASK_SWEEP_CMD:=agentctl-run --agent ask-sweep}"
NAME="${AGENTCTL_NAME:-ask-sweep}"
TYPES=""   # the row types from `notes row types`, read once a pass

HERE="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
# shellcheck source=/dev/null
. "$HERE/../lib/agent-proof.sh"
# shellcheck source=/dev/null
. "$HERE/../lib/plan-phases.sh"
# systems_of: the board's system ids, the area vocabulary its rows are filed in.
# shellcheck source=/dev/null
. "$HERE/../lib/inbox-epics.sh"
# The registry's resolver: this tree's project-name.sh (PROJECT_NAME_LIB when the script runs
# outside it, as fleet-dispatch and agent-queue take it).
# shellcheck source=../../.config/shared-hooks/project-name.sh
. "${PROJECT_NAME_LIB:-$HERE/../../.config/shared-hooks/project-name.sh}"

DRY=0; FILED=0; OVER=0; PLANS_OPEN=0; PLANS_UNCHECKED=0; PLANS_NO_COPY=0; ASKED=0; FAULT=0; STOPPED=0
# What was read, so a run that read nothing never reports the zeros of a clean read.
PLANS_READ=0; READ=0; UNREAD=0; MSGS=0
declare -A NO_BOARD=()

say() { printf 'ask-sweep: %s\n' "$*" >&2; }
ascii() { tr -cd ' -~' | tr -d '#' | cut -c1-"${1:-200}"; }

# file_row [--sheet] <board> <text>: one row within the run's cap. Returns 1 when not filed;
# an open twin already on the board (`ptask add` exit 3) counts as filed. Every row is a want by
# the `ask` channel, so the notes writer stamps #requested and no caller composes the tag.
# A third argument is the priority reason (priority-reasons.tsv) for a row whose text names its own #low.
file_row() {
  local lane=(--agent) why=(); [ "$1" = --sheet ] && { lane=(); shift; }
  local board="$1" text="$2"
  [ -z "${3:-}" ] || why=(--why "$3")
  if [ "$FILED" -ge "$ASK_SWEEP_MAX" ]; then OVER=$((OVER + 1)); return 1; fi
  FILED=$((FILED + 1))
  if [ "$DRY" = 1 ]; then printf 'would file [%s] %s\n' "$board" "$text"; return 0; fi
  notes ptask "$board" "${lane[@]}" add --want ask "${why[@]}" "$text" >/dev/null 2>&1
  local rc=$?
  [ "$rc" = 0 ] || [ "$rc" = 3 ]
}

# board_of <project> -> its board, or nothing (project-name.sh's project_board)
board_of() { project_board "$1"; }

# plan_rows_hold <plan file>: succeeds when every open phase takes a board row (`takes ucp-2951`,
# phase_takes) and at least one row each takes is still open or started on some board. Those rows carry
# the phase, so a plan row would repeat their work (2026-11-23: yes-i-think-mossy-abelson's last phase
# was split into four ucp rows, ar-2617). Once a phase's rows all close, the plan is filed again so a
# session ticks it. The board feed is read once a run, and only for a plan that names a row; an
# unreadable feed counts as held, since unreadable is not "no row".
BOARD_OPEN='' BOARD_READ=0
plan_rows_hold() {
  local names n id hit
  names=$(plan_phase_list "$1" | jq -r '.[] | select(.state == "open") | .name') && [ -n "$names" ] || return 1
  while IFS= read -r n; do [ -n "$(phase_takes "$n")" ] || return 1; done <<<"$names"
  if [ "$BOARD_READ" = 0 ]; then
    BOARD_READ=1
    BOARD_OPEN=$(notes board --json 2>/dev/null | jq -r '.rows[]? | select(.state != "done") | .id' 2>/dev/null) || BOARD_READ=bad
  fi
  [ "$BOARD_READ" != bad ] || return 0
  while IFS= read -r n; do
    hit=''
    while IFS= read -r id; do grep -qxF -- "$id" <<<"$BOARD_OPEN" && { hit=1; break; }; done < <(phase_takes "$n")
    [ -n "$hit" ] || return 1
  done <<<"$names"
}

# file_plan <board> <project> <plan-file>: the plan's row within the run's cap, filed as fleet-dispatch's
# reconcile_plans files one: agent-queue add --plan from a filer puts one untagged row on the board (the priority rubric judges it), "plan
# <slug>: run its open phases", and exits 5; dispatch's promote turns it into the plan's chain. It is
# no human's want, so it carries no #requested. Returns 1 when not filed. A plan agent-queue refuses (a
# Phases checklist it cannot read) is its author's fault, not the sweep's: it gets one `fix(plan)` row
# on its board naming its slug and agent-queue's reason, inside the cap like any row, so that board owns
# the fix and the next run, finding the slug on an open row, files nothing more. Any other failed add,
# or a fix row that cannot be filed, is a fault. Why: one plan's bad marker held the runner FAILED, and fleet-liveness red (11-23, 11-24, ar-5133).
file_plan() {
  local board="$1" p="$2" planf="$3" out rc=0 slug why
  if [ "$FILED" -ge "$ASK_SWEEP_MAX" ]; then OVER=$((OVER + 1)); return 1; fi
  slug="$(basename "$planf" .md)"
  if [ "$DRY" = 1 ]; then
    FILED=$((FILED + 1)); printf 'would file [%s] plan %s: run its open phases\n' "$board" "$slug"; return 0
  fi
  out=$(agent-queue add --plan "$planf" --project "$p" --from auto:ask-sweep 2>&1 </dev/null) || rc=$?
  if [ "$rc" -eq 0 ] || [ "$rc" -eq 5 ]; then FILED=$((FILED + 1)); return 0; fi
  why="${out##*$'\n'}"; why="${why#agent-queue: }"; why="${why#--plan *: }"
  case "$why" in
    "could not read its Phases checklist: "*) why="${why#could not read its Phases checklist: }" ;;
    *) FAULT=1; say "could not file the plan $planf: ${out##*$'\n'}"; proof_why "plan $slug: agent-queue add failed (exit $rc)"; return 1 ;;
  esac
  say "agent-queue refused the plan $planf: $why"
  rc=0
  notes ptask "$board" --agent add --why upkeep "fix(plan): $slug: agent-queue refuses its Phases checklist ($(ascii 160 <<<"$why")); fix it, then agent-queue add --plan $planf #size/s #low" \
    >/dev/null 2>&1 || rc=$?
  # 3: an open twin; 4: the outbox took it, where inbox-triage joins a later twin.
  case "$rc" in 0|3|4) FILED=$((FILED + 1)); return 0 ;; esac
  FAULT=1; say "could not file the fix row for the refused plan $planf (notes exit $rc)"; proof_why "plan $slug refused by agent-queue, and its fix row could not be filed"
  return 1
}

sweep_plans() {
  local first live filed f slug canon stub done_n total project board rows
  first="$ASK_SWEEP_DIR/first-run"
  [ -d "$ASK_SWEEP_PLANS" ] || { FAULT=1; say "no plans dir: $ASK_SWEEP_PLANS"; proof_why "no plans dir"; return 0; }
  # The first real run only starts the clock, and a dry run before it has nothing to report.
  if [ ! -f "$first" ]; then
    [ "$DRY" = 1 ] || touch "$first"
    return 0
  fi
  # By name: a session names its plan through its account's link (~/.claude-bnb/plans/<name>) or a
  # project entry, and each of those is the one file of that name in _live.
  live="$(fleet-sessions --json 2>/dev/null | jq -r '.. | .plan_file? // empty | strings | sub(".*/"; "")' 2>/dev/null)"
  # A plan fleet-dispatch reap filed (reconcile_plans: an approved plan its session left) is homed; this
  # sweep asks only about the rest, by name, since the record may hold the plan or its pointer stub.
  filed="$(sed 's#.*/##; s#\.md$##' "${FLEET_DISPATCH_DIR:-$HOME/.agent/dispatch}/plans-filed" 2>/dev/null)"
  while IFS= read -r -d '' f; do
    [ "$f" -ot "$first" ] && continue
    PLANS_READ=$((PLANS_READ + 1))
    # A pointer stub owns no phases: it is swept as the plan it names, whose one row it shares.
    IFS=$'\t' read -r canon _ < <(plan_pointer "$f") || true
    stub="$f"; [ -z "${canon:-}" ] || f="$canon"
    plan_superseded "$f" && continue   # another plan owns its open phases now
    IFS=$'\t' read -r done_n total _ < <(plan_phases "$f")
    slug="$(basename "$f" .md)"
    if [ "$total" = - ]; then
      grep -qi '^## results' "$f" || PLANS_UNCHECKED=$((PLANS_UNCHECKED + 1))
      continue
    fi
    [ "$done_n" -lt "$total" ] || continue
    PLANS_OPEN=$((PLANS_OPEN + 1))
    grep -qxF -e "${f##*/}" -e "${stub##*/}" <<<"$live" && continue
    grep -qxF -e "$slug" -e "$(basename "$stub" .md)" <<<"$filed" && continue
    project="$(find "$ASK_SWEEP_PLAN_CACHE" -mindepth 2 -maxdepth 2 -name "$slug.md" -not -path "$ASK_SWEEP_PLAN_CACHE/_*" -printf '%h\n' -quit 2>/dev/null)"
    # An open plan with no cache copy has no project to file under: counted, never dropped unseen.
    [ -n "$project" ] || { PLANS_NO_COPY=$((PLANS_NO_COPY + 1)); continue; }
    board="$(board_of "$(basename "$project")")"
    [ -n "$board" ] || { NO_BOARD["$(basename "$project")"]=1; continue; }
    # A variable, not a pipe: under pipefail `grep -q` quits at its match, `notes` dies of SIGPIPE on a
    # long list and the 141 reads as "no row" (2026-11-10..14: one plan filed seven times).
    rows="$(notes ptask "$board" --agent list 2>/dev/null)" || continue   # unreadable is not "no row"
    grep -qF "$slug" <<<"$rows" && continue
    plan_rows_hold "$f" && continue
    file_plan "$board" "$(basename "$project")" "$f"
  done < <(find "$ASK_SWEEP_PLANS/" -maxdepth 1 -name '*.md' -mmin +1440 -print0 2>/dev/null)   # /: the dir is a link
}

# transcripts -> "<board>\t<checkout>\t<file>" for each quiet transcript written inside the lookback,
# in a repo with a board and no client. A session's cwd names its project (resolve_project_name),
# read once a dir from the first of its quiet transcripts that has one; the checkout is where that
# project's merged PRs are listed. A dir where none has a cwd counts them all as unreadable. Run it
# in this shell: it counts into UNREAD, NO_BOARD and FAULT.
transcripts() {
  local d f cwd p b r ws
  [ -d "$ASK_SWEEP_TRANSCRIPTS" ] || {
    FAULT=1; say "no transcripts dir: $ASK_SWEEP_TRANSCRIPTS"; proof_why "no transcripts dir"; return 0; }
  while IFS= read -r d; do
    mapfile -t ws < <(quiet "$d" -maxdepth 1)
    cwd=""
    for f in "${ws[@]}"; do
      cwd="$(jq -Rrn 'first(limit(50; inputs) | fromjson? | objects | select(.cwd? | type == "string") | .cwd)' "$f" 2>/dev/null)"
      [ -n "$cwd" ] && break
    done
    [ -n "$cwd" ] || { UNREAD=$((UNREAD + ${#ws[@]})); continue; }
    p="$(resolve_project_name "$cwd")"
    [ -z "$(project_inherited "$p" client)" ] || continue
    b="$(board_of "$p")"
    [ -n "$b" ] || { NO_BOARD["$p"]=1; continue; }
    r="$(project_repo_path "$p")"
    for f in "${ws[@]}"; do printf '%s\t%s\t%s\n' "$b" "${r:--}" "$f"; done
  done < <(quiet "$ASK_SWEEP_TRANSCRIPTS" -mindepth 2 -maxdepth 2 | sed 's|/[^/]*$||' | sort -u)
}

# quiet <dir> <depth args>: the transcripts under it a sweep reads, quiet and inside the lookback.
quiet() {
  local d="$1"; shift
  find "$d" "$@" -name '*.jsonl' -mmin +"$ASK_SWEEP_QUIET_MIN" -mmin -"$ASK_SWEEP_LOOKBACK_MIN" 2>/dev/null
}

# human_messages <since file> <file>...: "<file>\t<timestamp>\t<message as a JSON string>" for what
# the human typed after each file's watermark (else the lookback's start). Line by line, so one
# bad line (a session killed mid-write) does not hide the messages after it.
human_messages() {
  local since="$1" floor f from; shift
  floor="$(date -u -d "-$ASK_SWEEP_LOOKBACK_MIN min" +%FT%T)"
  for f in "$@"; do
    from="$(awk -F'\t' -v f="$f" '$1 == f { t = $2 } END { print t }' "$since" 2>/dev/null)"
    [[ "${from:-}" > "$floor" ]] || from="$floor"
    jq -Rr --arg from "$from" --arg f "$f" '
      fromjson? | objects
      | select(.type == "user" and (.isSidechain | not) and (.isMeta | not)
        and ((.timestamp // "") > $from))
      | .timestamp as $ts
      | .message.content
      | if type == "array" then
          if any(.[]; .type? == "tool_result") then empty
          else map(select(.type? == "text") | .text) | join(" ") end
        else . end
      | select(type == "string") | gsub("^\\s+"; "")
      | select(startswith("<") or startswith("Base directory") or startswith("This session")
          or contains("system-reminder") or startswith("[Request interrupted") | not)
      | select(length > 0) | "\($f)\t\($ts)\t\(.[0:800] | tojson)"' "$f" 2>/dev/null
  done
}

# sweep_board <board> <checkouts> <file>...: one model call over the board's new messages; files
# its rows and moves the watermarks only when the call answered.
sweep_board() {
  local board="$1" repos="$2" since msgs text open_rows prs prompt wd out rc line quote row tier size
  local done_is human tags asked floor r; shift 2
  since="$ASK_SWEEP_DIR/since/$board"
  # Oldest first up to ASK_SWEEP_MSG_BYTES: the prompt is one argument, and Linux limits one to
  # 128 KB. What does not fit is past the watermarks this call moves, so the next run reads it.
  msgs="$(human_messages "$since" "$@" | sort -t$'\t' -k2,2 \
    | awk -F'\t' -v max="$ASK_SWEEP_MSG_BYTES" '{ n += length($3) + 1 } n > max { cut++; next } { print }
        END { if (cut) printf "%d\n", cut > "/dev/stderr" }' 2>"$ASK_SWEEP_DIR/.cut")"
  [ -s "$ASK_SWEEP_DIR/.cut" ] && say "$board: $(cat "$ASK_SWEEP_DIR/.cut") messages wait for the next run"
  rm -f -- "$ASK_SWEEP_DIR/.cut"
  [ -n "$msgs" ] || return 0
  MSGS=$((MSGS + $(wc -l <<<"$msgs")))
  # The grammar's one home names the types, once a run; with none the model would file any word.
  [ -n "$TYPES" ] || { TYPES="$(notes row types 2>/dev/null)" && [ -n "$TYPES" ]; } || {
    FAULT=1; say "$board: notes row types failed (an old notes? notes-bootstrap --build-only)"
    proof_why "$board: notes row types failed"; return 1; }
  ASKED=$((ASKED + 1))
  text="$(cut -f3 <<<"$msgs" | awk '!seen[$0]++')"
  open_rows="$({ notes ptask "$board" --agent list 2>/dev/null; notes ptask "$board" list 2>/dev/null; } | cut -f4 | cut -c1-90)"
  floor="$(cut -f2 <<<"$msgs" | sort | awk 'NR==1')"
  prs="$(while IFS= read -r r; do
      [ -d "$r" ] && (cd "$r" && gh pr list --state merged --limit 200 --search "merged:>=${floor:0:10}" --json title -q '.[].title' 2>/dev/null)
    done <<<"$repos")"
  # The instructions are the ask-sweep agent's PROMPT file; agentctl-run puts them ahead of this.
  prompt="## Messages ($board)
$text

## Open rows
$open_rows

## Merged PRs
$prs

## Row types
$TYPES

## Systems
$(systems_of "$board")"
  wd="$(mktemp -d)"
  # shellcheck disable=SC2086 # a word list by design, overridable in tests
  # An empty directory, so no repo's Stop hook answers in place of the model. The prompt goes on
  # stdin: a board's open rows outgrow the kernel's 128 KiB cap on one argument (E2BIG, exit 126).
  out="$(cd "$wd" && $ASK_SWEEP_CMD -p <<<"$prompt" 2>/dev/null)"; rc=$?
  rm -rf -- "$wd"
  case "$rc" in
    0) ;;
    75) STOPPED=1; say "$board: stopped at its budget"; proof_why "$board: stopped at its budget"; return 1 ;;
    *) FAULT=1; say "$board: model call failed (exit $rc)"; proof_why "$board: model call failed (exit $rc)"; return 1 ;;
  esac
  grep -qx 'ASK-SWEEP-START' <<<"$out" || { FAULT=1; say "$board: model returned no answer block"; proof_why "$board: the model returned no answer block"; return 1; }
  while IFS= read -r line; do
    jq -e 'type == "object" and (.row | type) == "string" and (.quote | type) == "string"' <<<"$line" >/dev/null 2>&1 || continue
    quote="$(jq -r .quote <<<"$line" | ascii 80)"
    row="$(jq -r .row <<<"$line" | ascii 150)"
    tier="$(jq -r '.tier // 3 | floor' <<<"$line" 2>/dev/null)"; [[ "$tier" =~ ^[123]$ ]] || tier=3
    size="$(jq -r '.size // "L"' <<<"$line")"; [[ "$size" =~ ^[SML]$ ]] || size=L
    done_is="$(jq -r '.done_is_stated // false' <<<"$line")"
    human="$(jq -r '.human_only // false' <<<"$line")"
    [ -n "$row" ] || continue
    # The day the quoted message was sent, else the newest message's.
    asked="$(awk -F'\t' -v q="$(tr '[:upper:]' '[:lower:]' <<<"$quote")" 'index(tolower($3), q) { print $2; exit }' <<<"$msgs")"
    [ -n "$asked" ] || asked="$(cut -f2 <<<"$msgs" | sort | tail -1)"
    asked="${asked:5:5}"
    tags="#tier/$tier #size/${size,,}"
    [ "$tier" -le 2 ] && [ "$size" = S ] && [ "$done_is" = true ] && [ "$human" != true ] && tags+=" #worker/requested"
    if [ "$human" = true ]; then
      file_row --sheet "$board" "$row; asked $asked \"$quote\" #low" upkeep
    else
      file_row "$board" "$row; asked $asked \"$quote\" $tags"
    fi
  done < <(sed -n '/^ASK-SWEEP-START$/,/^ASK-SWEEP-END$/p' <<<"$out" | sed '1d;$d')
  [ "$DRY" = 1 ] && return 0
  # The newest message read is each file's watermark; one older than the lookback is dropped.
  mkdir -p "$ASK_SWEEP_DIR/since"
  floor="$(date -u -d "-$ASK_SWEEP_LOOKBACK_MIN min" +%FT%T)"
  { cat "$since" 2>/dev/null; cut -f1,2 <<<"$msgs"; } \
    | awk -F'\t' -v floor="$floor" '$2 > floor && $2 > t[$1] { t[$1] = $2 } END { for (f in t) print f "\t" t[f] }' \
    | sort > "$since.tmp" && mv "$since.tmp" "$since"
}

sweep_asks() {
  local rc=0 board repo file files list
  local -A by=() repos=()
  # Into a file, not a pipe: transcripts counts into this shell's NO_BOARD and FAULT.
  list="$(mktemp)"; transcripts > "$list"
  while IFS=$'\t' read -r board repo file; do
    [ -n "$file" ] || continue
    [ -r "$file" ] || { UNREAD=$((UNREAD + 1)); continue; }
    READ=$((READ + 1))
    by["$board"]+="$file"$'\n'; repos["$board"]+="$repo"$'\n'
  done < "$list"
  rm -f -- "$list"
  for board in "${!by[@]}"; do
    mapfile -t files < <(printf '%s' "${by[$board]}" | sort -u)
    sweep_board "$board" "$(printf '%s' "${repos[$board]}" | sort -u)" "${files[@]}" || rc=1
  done
  return "$rc"
}

cmd_run() {
  local rc=0 summary verdict
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY=1; shift ;;
      *) say "unknown argument: $1"; return 2 ;;
    esac
  done
  mkdir -p "$ASK_SWEEP_DIR"
  sweep_plans
  sweep_asks || rc=1
  # Transcripts found and none readable is no read at all, not a quiet one.
  [ "$READ" = 0 ] && [ "$UNREAD" -gt 0 ] && {
    FAULT=1; say "no transcript was readable"; proof_why "$UNREAD transcripts, none readable"; }
  [ "$FAULT" = 0 ] || rc=1
  summary="read $PLANS_READ plans and $READ transcripts ($UNREAD unreadable, $MSGS new messages), asked $ASKED boards, filed $FILED, over the cap $OVER, ${#NO_BOARD[@]} projects with no board, open plans $PLANS_OPEN, no checklist $PLANS_UNCHECKED, no cache copy $PLANS_NO_COPY"
  say "$summary"
  [ "$DRY" = 1 ] && return "$rc"
  verdict=NOOP
  [ "$FILED" -gt 0 ] && verdict=WORKED
  # A budget stop alone is the cap holding, not a fault; the watermarks resume it next run.
  [ "$rc" != 0 ] && verdict=BLOCKED
  [ "$FAULT" = 1 ] && verdict=FAILED
  # "budget: " is what agentctl-briefing reads on the last outcome line.
  [ "$verdict" = BLOCKED ] && [ "$STOPPED" = 1 ] && { rc=75; summary="budget: $summary"; }
  proof_report "$NAME" "$verdict" "$summary"
  return "$rc"
}

main() {
  case "${1:-}" in
    run) shift; cmd_run "$@" ;;
    *) sed -n '2,5p' "$0" >&2; return 2 ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
