#!/usr/bin/env bash
# fleet-shepherd - the shepherd as a scheduled runner, over the fleet state document.
#
#   fleet-shepherd run     one scheduled pass (agentctl runner `shepherd`): refresh the state
#                          document, score the last pass and start a fresh `/fleet-lead pass` in
#                          its place, in the same pane of window hub:shepherd on the hub
#                          server (Prefix o). A run starts nothing while the
#                          lease holder is mid-sweep and nobody is talking to it, or while the
#                          human is talking to the pass and it is answering or under
#                          FLEET_SHEPHERD_PASS_MAX_MIN old
#   fleet-shepherd open    go to the pass running now, to watch it or talk to it; with no pass
#                          pane, to hub:shepherd or session hub. It never starts or resumes a session
#   fleet-shepherd passes [n]
#                          the pass running now and the last n scored, newest first
#   fleet-shepherd stats   one JSON object of shepherd numbers for the feed (agent-mqtt-publish
#                          `summary shepherd`, agent-web's Shepherd tab): open, unhandled,
#                          skipped and paged due lines, 24h nudges, escalations and skips from
#                          log.md, passes, the pass running now (id, status, age, attach line),
#                          the last scored one (id, verdict) and why the shepherd is stuck, if it is
#   fleet-shepherd stuck   exit 1 naming why when the shepherd has stopped passing: lines due and
#                          no pass started in FLEET_SHEPHERD_STUCK_MIN, or an unhandled line at
#                          two checks in a row; exit 0 otherwise. Sentinel's watch shepherd-stuck
#   fleet-shepherd check   refresh the state document and samples as `run` does, take each queue
#                          session's budget checkpoint (budget_sample: carry on, or park and
#                          page), then print what is due; exit 0 if anything, 1 if nothing (paging "settled"
#                          once), 2 if it could not refresh. A /loop shepherd tick runs it first
#                          and ends the turn on 1, so a quiet tick costs one call, not a pass
#   fleet-shepherd due     print what a pass would move, one line each; exit 0 if anything,
#                          1 if nothing. Reads the document and the blocked sample as they
#                          are, writes nothing
#   fleet-shepherd skip "<due line>" "<why>"
#                          answer a due line by leaving it: it stays out of check while it is
#                          due. check leads with `unhandled: <line>` for any line the last pass
#                          was given and neither moved nor skipped
#   fleet-shepherd infra   print what is wrong with the cluster right now, live: red k3s domain,
#                          or Prometheus not answering; exit 0 if anything, 1 if not. Read by
#                          fleet-dispatch's gate
#   fleet-shepherd sweep-cancel '<starved pool:<p> @<episode>>'
#                          clear a pool held by a failing sweep: when one workflow_dispatch run on a
#                          sweep/* branch holds more than half the pool's busy runners and more than
#                          half its finished jobs failed, cancel it, record it against the finding
#                          (fleet-bench respond ... cancelled) and print who to tell; exit 0 when it
#                          cancelled, 1 naming why it left the pool alone
#   fleet-shepherd lease   record that this session is the shepherd pass running now and tag its
#                          tmux pane @shepherd; every pass calls it first (fleet-lead, pass step 0)
#   fleet-shepherd holds   exit 0 when this session may act for the shepherd, 3 naming the pass
#                          that holds the lease when another live one does. lease, skip, log and
#                          fleet-sessions mark and escalate refuse the same way
#   fleet-shepherd log [--heading] <text>
#                          append to the rundown ($LEDGER/log.md) stamped with the clock's
#                          time: a `## <date time> <text>` heading, or a `- <time>: <text>` line
#   fleet-shepherd log - < lines
#                          one `- <time>: <line>` per stdin line, so a pass logs its moves
#                          in one call
#   fleet-shepherd log --rundown <title> < body
#                          keep a rundown or a chat answer as its own record,
#                          $LEDGER/rundowns/<date>T<hhmm>Z.md, and point at it from log.md.
#                          What the human asked for in chat survives compaction and restarts,
#                          and agent-web's Shepherd tab lists these records. Each one leads with
#                          `fleet-bench requests`, written here so no answer can leave it out
#
# A pass starts with a fresh context (about 60k), where one long /loop chat re-read 100k+ on every
# tick and compacted 12 times on 2026-11-03. There is one pass window, and each pass replaces the
# last in the same pane (respawn-pane), so there is never a second shepherd window or session to
# close: on 2026-11-05 a replaced pass kept a window of its own and read as a second shepherd.
# Talking holds a run only while the pass is answering or young: on 2026-11-04 the human talked
# to a pass for 70 minutes and no sweep ran. What they said goes to the next pass as a handover.
# Lease, orders and routing: the fleet-lead skill, "Verb: pass".

set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

: "${FLEET_SHEPHERD_LEASE_MIN:=30}" # how long a human turn reads as talking and a pane's tag stays live
NAME="${AGENTCTL_NAME:-shepherd}"
LEDGER="${FLEET_SHEPHERD_DIR:-$HOME/.agent/shepherd}"
STATE_FILE="${FLEET_STATE_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/fleet/state.json}"
LEASE="$LEDGER/.lease"
BLOCKED="$LEDGER/.blocked"   # this pass's `fleet-assess --blocked` rows; .prev holds the last pass's
INFRA="$LEDGER/.infra"       # this pass's infra and watch lines
DUE_LAST="$LEDGER/.due"      # <key>\t<role>\t<first seen epoch>\t<line>: what the last check handed to a pass
SKIPPED="$LEDGER/.skipped"   # <key>\t<why>\t<epoch>: due lines a pass chose to leave, and why
PAGED="$LEDGER/.paged"       # <key>: unhandled lines already paged, kept while they stay due
UNHANDLED="$LEDGER/.unhandled"  # how many checks in a row found an unhandled line
PASS="$LEDGER/.pass"          # <id>\t<start epoch>\t<due count>\t<pane>: the pass running now
NOROOM="$LEDGER/.noroom"      # present while no account has room, so that is paged once
PASSES="$LEDGER/passes.tsv"   # <start>\t<id>\t<verdict>\t<detail>: every pass, once scored
# The pass is window shepherd of session hub, on the hub server. The runner owns that window, not
# hub.conf: a declared window would get a shell or a second pass from tmx ensure. A run makes it
# once and after that only respawns its pane, so it creates and kills no windows in hub; the
# window churn of one window per pass is why passes had a server of their own from 2026-11-04 to
# 2026-11-05, and the hub crash that day was Prefix+w tree mode, fixed in the patched tmux.
SESSION="${FLEET_SHEPHERD_SESSION:-hub}"
SERVER="${FLEET_SHEPHERD_SERVER:-$(tmux-world session "$SESSION")}"  # hub; Prefix o (fleet-shepherd open) goes to the pass from any world
WINDOW="${FLEET_SHEPHERD_WINDOW:-shepherd}"
PASS_CWD="${FLEET_SHEPHERD_CWD:-$HOME/.dotfiles}"
ATTACH="tmux -L $SERVER attach -t $SESSION:$WINDOW"
: "${FLEET_SHEPHERD_PASS_MAX_MIN:=30}" # a pass still working this long, with no human on it, is STALLED and closed
: "${FLEET_SHEPHERD_LIMIT_IDLE:=5}" # minutes idle before a pane is read for the usage-limit stop
: "${FLEET_SHEPHERD_OVERDUE_MIN:=60}" # the least a phase runs before it can be overdue, whatever its eta
: "${FLEET_SHEPHERD_UNHANDLED_MIN:=60}" # a due line left this long with no answer pages the human, once
# Every 15-minute run starts a pass, so 60 is three runs missed and room for a late timer.
: "${FLEET_SHEPHERD_STUCK_MIN:=60}" # lines due and no pass started this long: stuck
# A queue session's budget, by its item's #size/ tag; unsized is most items. A budget is a
# checkpoint, not a wall (Ken, 2026-11-05: development comes first): see budget_sample.
: "${FLEET_SHEPHERD_BUDGET_S:=12}" "${FLEET_SHEPHERD_BUDGET_M:=25}" "${FLEET_SHEPHERD_BUDGET_L:=50}"
: "${FLEET_SHEPHERD_BUDGET_USD:=25}" # an item with no size tag
: "${FLEET_SHEPHERD_BUDGET_EXTEND:=3}" # a session still WORKING is parked only at this many budgets
# A CHAT row is the human's own conversation: nothing is due on it until it has sat this long, by
# the smaller of its idle and age (an epoch-0 idle on a new session cannot fire it early), and
# then it gets one wind-down nudge. The human set 24h when approving the CHAT bucket, 2026-11-05.
: "${FLEET_CHAT_CLOSE_H:=24}"
BUDGETS="$LEDGER/.budget"     # <item>\t<budgets reached>\t<extended|parked|pending|left>: each checkpoint, once
LIMIT_RE='weekly limit|usage limit|hit your .*limit|/login' # as the skill's step 1 names them

die() { echo "fleet-shepherd: $*" >&2; exit 2; }

# publish <verdict> <detail>: the run's outcome, and the pass it started as the runner's item, so
# `agentctl status shepherd` names it (each run clears the item).
publish() {
  local id
  { read -r id _; } 2>/dev/null < "$PASS" || true
  [ -z "${id:-}" ] || agentctl report --name "$NAME" "item=pass ${id:0:8}: $ATTACH" >/dev/null 2>&1 || true
  # shellcheck source=/dev/null
  . "$HOME/.local/lib/agent-proof.sh" 2>/dev/null || return 0
  proof_outcome "$NAME" "$1" "$2" 2>/dev/null || true
}

# lease: "<holder> <epoch> <session id>". The runner exports FLEET_SHEPHERD_HOLDER=runner to its
# pass, so the Shepherd tab tells a pass from a human's loop. The session id is the claude session
# that holds it (`-` from outside claude): the runner writes the new pass's at launch, and the pass
# renews it at its step 0. Only that session acts (cmd_holds).
cmd_lease() {
  mkdir -p "$LEDGER" || die "cannot create $LEDGER"
  write_lease "${FLEET_SHEPHERD_HOLDER:-interactive}" "${CLAUDE_CODE_SESSION_ID:--}"
  tag_pane $(( $(date +%s) + FLEET_SHEPHERD_LEASE_MIN * 60 ))
}

write_lease() { printf '%s %s %s\n' "$1" "$(date +%s)" "$2" > "$LEASE"; }

# holds: exit 0 when the calling session may act for the shepherd: it holds the lease, nothing live
# holds it, or the caller is no claude session (a shell or a script is not a pass). Otherwise exit 3,
# naming the pass that holds it. Identity is the claude session id, not the pane: a resume moves a
# pass to another pane and keeps its id. The pass the runner just started holds it before its claude
# registers, for a lease window, so the pass it replaced cannot act in those seconds.
cmd_holds() {
  local me="${CLAUDE_CODE_SESSION_ID:-}" id at cur
  [ -n "$me" ] || return 0
  { read -r _ at id _; } 2>/dev/null < "$LEASE" || return 0
  [ -n "${id:-}" ] && [ "$id" != - ] && [ "$id" != "$me" ] || return 0
  if [ "$(pass_status "$id")" = gone ]; then
    { read -r cur _; } 2>/dev/null < "$PASS" || cur=""
    [ "$id" = "$cur" ] && [ $(( $(date +%s) - ${at:-0} )) -lt $(( FLEET_SHEPHERD_LEASE_MIN * 60 )) ] || return 0
  fi
  echo "fleet-shepherd: refused: pass ${id:0:8} holds the shepherd lease, not this session (${me:0:8}), and only the holder acts. The pass running now is in window $WINDOW of session $SESSION (Prefix o); do nothing more here." >&2
  return 3
}

# tag_pane <expires> [pane]: exactly one tmux pane carries @shepherd, the one an interactive
# lease was taken from, and its value is the epoch the lease goes stale. A pane option, because
# one tmux session holds many agents, and a session option reads as set on every pane in it.
# Readers show the tag only while that is in the future (.tmux.conf @shepherd_live, agent-panel),
# so a shepherd that stopped renewing drops its tag with no cleanup. Every server in the socket
# dir is swept, found the way agent-panel finds them (tmux.rs socket_dir). The pane argument is a
# pane on $SERVER: the runner tags the pass it starts, so the tag is there before the pass's own
# lease call. A lease taken outside tmux has no pane, so it only clears.
tag_pane() {
  local dir sock pid val
  dir="${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)"
  [ -z "${TMUX:-}" ] || dir="$(dirname "${TMUX%%,*}")"
  for sock in "$dir"/*; do
    [ -S "$sock" ] || continue
    tmux -S "$sock" list-panes -a -F '#{pane_id} #{@shepherd}' 2>/dev/null |
      while read -r pid val; do
        [ -z "$val" ] || tmux -S "$sock" set-option -p -t "$pid" -u @shepherd 2>/dev/null
      done
  done
  if [ -n "${2:-}" ]; then
    tmux -L "$SERVER" set-option -p -t "$2" @shepherd "$1" 2>/dev/null || true
    return 0
  fi
  [ -n "${TMUX:-}" ] || return 0
  # Bare tmux under $TMUX is the server this pass runs in; $TMUX_PANE names its pane.
  tmux set-option -p ${TMUX_PANE:+-t "$TMUX_PANE"} @shepherd "$1" 2>/dev/null || true
}

# The shepherd skill's nudge rules (steps 3 and 4), over the document, by each bucket's actor in
# the fleet-states.md bucket table: a manual row is never moved; DONE, LANDED and STALLED are
# nudged once, and CHAT once past FLEET_CHAT_CLOSE_H; a NEEDS row, a nudged row whose fact
# survived, or a test red on several branches (shared), is escalated once. PARKED is fleet-pace's, below.
cmd_due() {
  [ -r "$STATE_FILE" ] || die "no state document at $STATE_FILE"
  local out
  out="$(jq -r --argjson chat "$((FLEET_CHAT_CLOSE_H * 60))" '
    ( (.main // [])[] | select(.escalated | not) | "nightly red: \(.repo) (\(.reason // "-"))" )
  , ( (.shared // [])[] | select(.escalated | not)
      | "shared red: \(.reason); then: fleet-sessions escalate \(.id) \"\(.fact)\"" )
  , ( (.sessions // [])[]
      | select((.labels // []) | index("manual") | not)
      | ([.idle_min // 0, .age_min // 0] | min) as $quiet
      | if (.bucket | IN("DONE","LANDED","STALLED")) and (.nudged | not) then
          "nudge \(.bucket): \(.target) \(.fact // "")"
        elif .bucket == "CHAT" and (.nudged | not) and $quiet >= $chat then
          "nudge CHAT: \(.target) \(.fact // "")"
        elif (.bucket == "NEEDS" or ((.bucket | IN("DONE","LANDED","STALLED","CHAT")) and .nudged))
             and (.escalated | not) then
          "escalate \(.bucket): \(.target) \(.reason // "")"
        else empty end )
  ' "$STATE_FILE")" || die "unreadable state document $STATE_FILE"
  # A hold the machine no longer needs is a GO decision, and a machine over budget with no
  # hold is a hold decision; both are the shepherd's step 1. So is a parked session on a CLEAR
  # machine with no hold: nothing else ever resumes it. One the budget checkpoint parked is left
  # out, since that park pages the human and only they resume it.
  local verdict holds parked
  verdict="$(fleet-assess 2>/dev/null | sed -n 's/^verdict: \([A-Z]*\).*/\1/p')"
  holds="$(agent-hold list 2>/dev/null | cut -f1 | paste -sd, -)"
  if [ -n "$holds" ] && [ "$verdict" = CLEAR ]; then
    out+="${out:+$'\n'}pace: hold $holds while the machine reads CLEAR"
  elif [ -z "$holds" ] && [ "$verdict" = HOLD ]; then
    out+="${out:+$'\n'}pace: machine reads HOLD with no hold set"
  elif [ -z "$holds" ] && [ "$verdict" = CLEAR ]; then
    parked="$(jq -r --rawfile b <(cat "$BUDGETS" 2>/dev/null) '
      ($b | split("\n") | map(split("\t")) | map(select(.[2] == "parked") | .[0])) as $budget
      | [(.sessions // [])[] | select(.bucket == "PARKED" and ((.labels // []) | index("manual") | not)
          and (((.dispatch // "") | sub("^[^:]*: "; "")) as $slug | $budget | all(. != $slug)))
        | .target] | join(", ")' "$STATE_FILE" 2>/dev/null)"
    [ -z "$parked" ] || out+="${out:+$'\n'}pace: parked $parked while the machine reads CLEAR with no hold; then: claude-acct unpark each"
  fi
  local b
  b="$(blocked_due)"
  [ -z "$b" ] || out+="${out:+$'\n'}$b"
  b="$(limit_due)"
  [ -z "$b" ] || out+="${out:+$'\n'}$b"
  b="$(overdue_due)"
  [ -z "$b" ] || out+="${out:+$'\n'}$b"
  b="$(improve_due)"
  [ -z "$b" ] || out+="${out:+$'\n'}$b"
  # Shared faults lead the sessions: on 2026-10-29 passes moved sessions for 8 hours of a gate stall.
  b="$(findings_due)"
  [ -z "$b" ] || out="$b${out:+$'\n'}$out"
  # Infra leads: on 2026-10-31 eight hours of passes moved sessions and never named the disk.
  b="$(infra_due)"
  [ -z "$b" ] || out="$b${out:+$'\n'}$out"
  [ -n "$out" ] || return 1
  printf '%s\n' "$out"
}

# findings_due -> a line per open finding that wants a decision and has not gone out. Report-class
# findings are not due, and a finding on one sample is not either: on 2026-11-01 throughput-drop
# fired once on a morning of sessions still starting, and cleared on the next sample. The ledger
# key holds the class, so a finding promoted from shepherd to human is news.
findings_due() {
  local rows id key text
  rows="$(fleet-bench findings --json 2>/dev/null)" || {
    echo "finding: fleet-bench findings unreadable, so shared faults are unread"
    return 0
  }
  [ -n "$rows" ] || return 0
  while IFS=$'\t' read -r id key text; do
    [ "$(sed -n 's/^escalated: //p' "$LEDGER/$id" 2>/dev/null)" = "$key" ] && continue
    printf 'finding %s; then: fleet-sessions escalate %s "%s"\n' "$text" "$id" "$key"
  done < <(jq -r 'select(.decision_class != "report" and .epoch > .episode)
    | [("finding-\(.rule)-\(.scope)" | gsub("/"; "-")), "\(.fact) \(.decision_class)",
       "\(.decision_class): \(.rule) \(.scope): \(.conclusion)" + (if (.cost // "") != "" then " (\(.cost))" else "" end)]
    | @tsv' <<<"$rows")
}

# improve_due -> one line for the KPI furthest past its threshold that no live row owns
# (`fleet-bench improve`), so a pass files a defined row with a check, or claims the row or plan
# that already owns it. The line carries no measured value, so its due_key holds still while the
# number moves. Silent when fleet-bench fails: findings_due already names it unreadable.
improve_due() {
  local pick
  pick="$(fleet-bench improve --json 2>/dev/null)" || return 0
  [ -n "$pick" ] || return 0
  jq -r '"improve: \(.kpi) past \(.bound) \(.threshold), no live row"
    + (if .last then ", last \(.last.subject) \(.last.verdict)" else "" end)
    + "; then: fleet-bench improve file \(.kpi) \"<defined fix>\", or claim \(.kpi) <id> when a row or plan already owns it"' \
    <<<"$pick" 2>/dev/null || true
}

# overdue_due -> a line per WORKING session, or NEEDS one carrying on past its question, not
# mid-turn (activity busy), whose open phase has run twice its fleet-bench estimate and at least
# FLEET_SHEPHERD_OVERDUE_MIN. No other line looks at a WORKING row: on 2026-11-03 agent-53 sat 22h
# at 0/4 and agent-8 at 1/8 and no pass named either. The fact is the phase, so it is nudged once;
# once the nudge is a phase-length old (at least the floor) and the phase has not moved, it goes to
# the human, once.
overdue_due() {
  local eta now sid key line esc at
  eta="$(fleet-bench eta --json 2>/dev/null)" || {
    echo "overdue: fleet-bench eta unreadable, so phase ages are unread"
    return 0
  }
  [ -n "$eta" ] || return 0
  now="$(date +%s)"
  while IFS=$'\t' read -r sid key line; do
    esc="$(sed -n 's/^escalated: //p' "$LEDGER/$sid" 2>/dev/null)"
    [ "$esc" = "$key" ] && continue
    if [ "$(sed -n 's/^fact: //p' "$LEDGER/$sid" 2>/dev/null)" = "$key" ]; then
      at="$(date -d "$(sed -n 's/^at: //p' "$LEDGER/$sid" 2>/dev/null)" +%s 2>/dev/null)" || continue
      [ $(( (now - at) / 60 )) -ge "${line%%$'\x1f'*}" ] || continue
      printf 'escalate overdue: %s, nudged and not moved; then: fleet-sessions escalate %s "%s"\n' "${line#*$'\x1f'}" "$sid" "$key"
    else
      printf 'overdue: %s; then: fleet-sessions mark %s "%s"\n' "${line#*$'\x1f'}" "$sid" "$key"
    fi
  done < <(jq -rn --argjson now "$now" --argjson floor "$FLEET_SHEPHERD_OVERDUE_MIN" \
      --slurpfile s "$STATE_FILE" --arg eta "$eta" '
    ($s[0].sessions // [] | map(select((.bucket == "WORKING" or (.bucket == "NEEDS" and ((.reason // "") | endswith("carrying on"))))
                                       and .activity != "busy"
                                       and ((.labels // []) | index("manual") | not)))
       | map({key: .session_id, value: .}) | from_entries) as $w
    | $eta | split("\n")[] | select(length > 0) | fromjson
    | select((.finished | not) and .phase_min != null and .phase_since_epoch != null and $w[.session_id] != null
           and .phases_done < .phases_total)
    | ([2 * .phase_min, $floor] | max) as $limit | (($now - .phase_since_epoch) / 60 | floor) as $age
    | select($age >= $limit)
    | "phase \(.phases_done + 1)/\(.phases_total)" as $ph
    | [.session_id, "overdue \($ph)",
       "\([.phase_min, $floor] | max)\u001f\(.target) \($ph) '"'"'\($w[.session_id].next_phase // "-")'"'"' open \($age)m, expected \(.phase_min)m (\(.basis // "-"))"]
    | @tsv')
}

# limit_due -> what a pass moves off an account that is out of usage. Each account at its week or
# 5h cap (`claude-acct status`) gets a line per live session on it: an idle one moves to the account
# `claude-acct room` names, one in a dialog is listed for the human, and a busy one or one with
# shells running waits for a later pass (a move would stop its gate or test). No room anywhere is
# one line per capped account, for the human. A session the account read does not cover (its
# account unread, or not in the row) still gets the pane line: only the pane says it stopped. An
# escalated row is left out of the pane line, since that is where a pass puts one no account has
# room for, and only the human can add room.
limit_due() {
  local rows capped room room_name target pane server
  rows="$(claude-acct status --json 2>/dev/null)" || rows=''
  capped="$(jq -c '[.[]? | select(.state == "ok" and ((.week_used // 0) >= 100 or (.five_hour // 0) >= 100)) | .name]' \
    <<<"${rows:-[]}" 2>/dev/null)" || capped='[]'
  if [ "${capped:-[]}" != '[]' ]; then
    room_name=''
    room="$(claude-acct room 2>/dev/null)" \
      && room_name="$(jq -r --arg d "$room" 'first(.[] | select(.dir == $d) | .name) // empty' <<<"$rows")"
    jq -r --argjson capped "$capped" --arg room "$room_name" '
      (.sessions // []) | map((.account // "") as $a
        | select(((.labels // []) | index("manual") | not) and ($capped | index($a)) != null))
      | (.[] | select(.activity == "idle" and $room != "")
             | "limit: \(.target) idle on \(.account), out of usage; then: claude-acct move \(.target) --to \($room)"),
        (.[] | select(.activity == "waiting")
             | "limit: \(.target) on \(.account), out of usage, is in a dialog; then: list it for the human, and fleet-shepherd skip it"),
        (if $room == "" then group_by(.account)[] | select(any(.activity == "idle"))
           | "limit: \(.[0].account) is out of usage and no account has room; then: tell the human once (\(length) live on it), and fleet-shepherd skip it"
         else empty end)' "$STATE_FILE" 2>/dev/null
  fi
  while IFS=$'\t' read -r target pane; do
    server=''
    case "$target" in */*) server="${target%%/*}" ;; esac
    tmux ${server:+-L "$server"} capture-pane -p -t "$pane" 2>/dev/null \
      | grep -v '^[[:space:]]*$' | tail -n 6 | grep -qiE "$LIMIT_RE" \
      && echo "limit: $target stopped on the usage limit"
  done < <(jq -r --argjson idle "$FLEET_SHEPHERD_LIMIT_IDLE" --argjson capped "${capped:-[]}" '(.sessions // [])[]
    | select((.labels // []) | index("manual") | not)
    | select((.account // "") as $a | ($capped | index($a)) == null)
    | select(((.idle_min // 0) | tonumber? // 0) >= $idle and (.escalated | not) and (.pane // "") != "")
    | [.target, .pane] | @tsv' "$STATE_FILE" 2>/dev/null)
}

# blocked_sample: rotate the blocked rows, so each pass compares itself with the one before.
# Only `run` calls it; `due` reads the two files as they are.
blocked_sample() {
  [ ! -e "$BLOCKED" ] || mv -f "$BLOCKED" "$BLOCKED.prev"
  fleet-assess --blocked > "$BLOCKED" 2>/dev/null || true
}

# blocked_due -> a `blocked:` line per process stuck on I/O in this pass and the last one. One
# sample alone is not enough: an editor reading a font is in D for a moment. Fifteen minutes
# stuck is a walk of a network share or a hung mount (2026-10-29, three searches from `/`).
blocked_due() {
  [ -s "$BLOCKED" ] && [ -s "$BLOCKED.prev" ] || return 0
  awk -F'\t' 'NR == FNR { seen[$1] = 1; next }
    ($1 in seen) { printf "blocked: pid %s %s, %s threads on I/O for %s, %s session %s (%s), open %s\n", $1, $4, $2, $3, $5, $6, $7, $9 }' \
    "$BLOCKED.prev" "$BLOCKED"
}

# infra_now -> a line when the cluster is red or cannot be read. Unreadable counts: Prometheus
# ran on the node that filled, so silence here is what the outage looked like.
infra_now() {
  local json status
  # shellcheck source=/dev/null
  . "${PROM_LIB:-$HOME/.local/lib/prom.sh}" 2>/dev/null || { echo "infra: no Prometheus reader"; return 0; }
  json="$(prom_q 'cc:domain_status{domain="k3s"}')" || { echo "infra: Prometheus not answering"; return 0; }
  status="$(jq -r '.data.result[0].value[1] // "none"' <<< "$json")"
  case "${status%%.*}" in
    2) echo "infra: k3s domain red" ;;
    none) echo "infra: no k3s status series" ;;
  esac
}

# sweep_holder <pool> -> "<owner/repo> <run id> <branch> <held> <busy>" for the workflow_dispatch run
# on a sweep/* branch holding more than half the pool's busy runners, or nothing. Read from the
# runner exporter (github_runner_state, one series per runner, the job's url carrying the run), so
# the pool is the exporter's and no label mapping is copied here.
sweep_holder() {
  local json
  # shellcheck source=/dev/null
  . "${PROM_LIB:-$HOME/.local/lib/prom.sh}" 2>/dev/null || return 2
  json="$(prom_q "github_runner_state{pool=\"$1\",state=\"running\"}")" || return 2
  jq -r '.data.result | length as $busy
    | map(.metric | select(.event == "workflow_dispatch" and ((.branch // "") | startswith("sweep/")))
        | ((.url // "") | capture("github\\.com/(?<slug>[^/]+/[^/]+)/actions/runs/(?<id>[0-9]+)")?) + {branch})
    | group_by(.id) | map({slug: .[0].slug, id: .[0].id, branch: .[0].branch, held: length})
    | (max_by(.held) // empty) | select(.held * 2 > $busy)
    | "\(.slug) \(.id) \(.branch) \(.held) \($busy)"' <<<"$json"
}

# A starved pool held by one failing sweep is the shepherd's to clear: a sweep reruns, a held pool
# costs hours. On 2026-11-05 7 of 8 frame-sweep shards failed over 7h on the razer slots while
# every pass paged instead. Failures come from the run's jobs, since a run GitHub reports as
# queued can hold running ones.
cmd_sweep_cancel() {
  local fact="${1:-}" pool holder slug id branch held busy jobs finished failed url
  [[ "$fact" =~ ^starved\ pool:([^\ ]+)\ @[0-9]+$ ]] || { echo "usage: fleet-shepherd sweep-cancel 'starved pool:<pool> @<episode>'" >&2; return 2; }
  pool="${BASH_REMATCH[1]}"
  holder="$(sweep_holder "$pool")" || { echo "sweep-cancel: the runner exporter is unreadable, so pool $pool stays"; return 1; }
  read -r slug id branch held busy <<<"$holder"
  [ -n "$id" ] || { echo "sweep-cancel: no sweep run holds most of pool $pool"; return 1; }
  jobs="$(gh api "repos/$slug/actions/runs/$id/jobs" --paginate -q '.jobs[] | select(.status == "completed") | .conclusion' 2>/dev/null)" \
    || { echo "sweep-cancel: run $id's jobs are unreadable, so it stays"; return 1; }
  finished="$(grep -c . <<<"$jobs")"; failed="$(grep -cx failure <<<"$jobs")"
  if ((failed * 2 <= finished)); then
    echo "sweep-cancel: run $id ($branch) holds $held of $busy $pool runners, but $failed of $finished finished jobs failed: it stays"
    return 1
  fi
  gh run cancel "$id" -R "$slug" >/dev/null 2>&1 || { echo "sweep-cancel: gh run cancel $id -R $slug failed"; return 1; }
  url="https://github.com/$slug/actions/runs/$id"
  fleet-bench respond "$fact" shepherd cancelled "$url" >/dev/null 2>&1 || true
  cmd_log "cancelled sweep run $id ($branch): it held $held of $busy $pool runners and $failed of $finished finished jobs failed"
  echo "cancelled $url: held $held of $busy $pool runners, $failed of $finished finished jobs failed"
  echo "tell the session on $branch: its sweep run $id was cancelled because it held pool $pool with $failed of $finished jobs failed; fix the failure before rerunning it"
}

cmd_infra() {
  local out
  out="$(infra_now)"
  [ -n "$out" ] || return 1
  printf '%s\n' "$out"
}

# infra_sample: this pass's cluster state and the Sentinel trips the shepherd hears (high and
# urgent, `watch-companion-loop tripped`). On 2026-11-04 queue-starved was high, so the shepherd
# never heard that dispatch had started nothing for 7.5h.
infra_sample() {
  {
    infra_now
    watch-companion-loop tripped 2>/dev/null | awk -F'\t' 'NF { printf "watch: %s tripped (%s)\n", $1, $2 }'
  } > "$INFRA"
}

# infra_due -> the sampled lines. Like every due line, one stays due until a pass answers it (a
# fix, or `skip` with the why), so a standing red is answered once, not by every pass.
infra_due() {
  [ ! -s "$INFRA" ] || cat "$INFRA"
}

# budget_sample: hold each queue session to its item's budget, as checkpoints. Each whole budget
# an item's sessions pass is one checkpoint, handled once: a WORKING session carries on (logged)
# up to FLEET_SHEPHERD_BUDGET_EXTEND budgets; one STALLED at a checkpoint, or still
# WORKING past the last, is parked (`claude-acct park`, resumable) and the human is paged once. A
# park refused because the turn is running is pending and retried every sample until its turn
# ends. A session waiting on the human, or finished, costs nothing more, so it is only logged.
# An unpark buys one more budget before the next checkpoint. No cost read means no checkpoint.
budget_sample() {
  local costs target bucket slug sids item size cap usd n had st why out
  costs="$(claude-acct cost 2>/dev/null)" && [ -n "$costs" ] || return 0
  touch "$BUDGETS" 2>/dev/null || return 0
  while IFS=$'\t' read -r target bucket slug sids; do
    item="$(agent-queue show "$slug" --json 2>/dev/null)" || continue
    size="$(jq -r '(.task // "" | capture("#size/(?<s>[sml])\\b") | .s) // ""' <<<"$item")"
    case "$size" in s) cap=$FLEET_SHEPHERD_BUDGET_S ;; m) cap=$FLEET_SHEPHERD_BUDGET_M ;;
                    l) cap=$FLEET_SHEPHERD_BUDGET_L ;; *) cap=$FLEET_SHEPHERD_BUDGET_USD; size=unsized ;; esac
    read -r usd n < <(jq -r --argjson c "$costs" --arg sids "$sids" --argjson cap "$cap" '
      ([(.sessions // "" | split(" ")[]), ($sids | split(" ")[])] | map(select(. != "")) | unique
       | map($c[.] // 0) | add // 0) as $u | "\($u * 100 | round / 100) \($u / $cap | floor)"' <<<"$item")
    read -r had st < <(awk -F'\t' -v k="$slug" '$1 == k { n = $2; s = $3 } END { print n + 0, (s == "" ? "-" : s) }' "$BUDGETS")
    why="$slug spent \$$usd, ${n}x its \$$cap $size budget"
    if [ "$st" != pending ]; then
      [ "$n" -gt "$had" ] || continue
      case "$bucket" in
        WORKING) [ "$n" -ge "$FLEET_SHEPHERD_BUDGET_EXTEND" ] || {
                   budget_mark "$slug" "$n" extended "budget: $target ($why), still working: carries on to $((n + 1))x"; continue; } ;;
        STALLED) ;;
        *) budget_mark "$slug" "$n" left "budget: $target ($why), $bucket: not parked, it is not spending"; continue ;;
      esac
    fi
    if out="$(claude-acct park "$target" 2>&1)"; then
      budget_mark "$slug" "$n" parked "budget: parked $target ($why, $bucket)"
      [ "$st" = pending ] || budget_page "$target parked at its budget" "$why, $bucket. Resume it with claude-acct unpark $target; it runs one more budget before the next checkpoint."
    elif [[ "$out" == *"busy mid-turn"* || "$out" == *"background shells"* ]]; then
      [ "$st" = pending ] && continue
      budget_mark "$slug" "$n" pending "budget: $target ($why, $bucket) parks once its turn ends"
      budget_page "$target is past its budget" "$why, $bucket. It parks once its turn ends; claude-acct unpark $target resumes it."
    else
      budget_mark "$slug" "$n" left "budget: could not park $target ($why): ${out##*: }"
    fi
  done < <(jq -r '(.sessions // [])[] | select(.dispatch != null and ((.labels // []) | index("manual") | not))
    | [.target, .bucket, (.dispatch | sub("^[^:]*: "; "")), (.session_id // "")] | @tsv' "$STATE_FILE" 2>/dev/null)
}

# budget_mark <item> <budgets> <state> <log line>: one checkpoint handled, in the ledger and log.md
budget_mark() {
  { grep -v "^$1"$'\t' "$BUDGETS"; printf '%s\t%s\t%s\n' "$1" "$2" "$3"; } > "$BUDGETS.tmp" && mv "$BUDGETS.tmp" "$BUDGETS"
  cmd_log "$4" >/dev/null
}
budget_page() { agent-notify -p high -t "$1" -r "file:$LEDGER/log.md" "$2" >/dev/null 2>&1 || true; }

# log [--heading] <text>: the rundown's only writer of times. A model that types the time
# guesses it: on 2026-10-28 entries stamped 00:55 and 01:00 UTC 10-29 were written at 23:44 UTC.
cmd_log() {
  local heading=0
  [ "${1:-}" = --rundown ] && { shift; log_rundown "$@"; return; }
  [ "${1:-}" = --heading ] && { heading=1; shift; }
  if [ "$*" = - ]; then
    local line
    while IFS= read -r line; do [ -z "$line" ] || cmd_log "$line"; done
    return 0
  fi
  [ -n "$*" ] || die "usage: fleet-shepherd log [--heading] <text>"
  mkdir -p "$LEDGER" || die "cannot create $LEDGER"
  if [ "$heading" = 1 ]; then
    printf '\n## %s %s\n' "$(date -u '+%F %H:%M UTC')" "$*" >> "$LEDGER/log.md"
  else
    printf -- '- %s: %s\n' "$(date -u '+%H:%M UTC %m-%d')" "$*" >> "$LEDGER/log.md"
  fi
}

# log --rundown <title> < body: one record per rundown or chat answer. The body is read
# before anything is written, so an empty one leaves no file and no log line. The human's requests
# go in here, not in the body: the 22:50Z rundown of 2026-11-04 was a narrow answer that left out
# the CI cleanup they had just asked for. They are read before the new file exists, because
# `requests` counts finished ones from the last rundown.
log_rundown() {
  [ -n "$*" ] || die "usage: fleet-shepherd log --rundown <title> < body"
  local body requests stamp name f n=1
  body="$(cat)"
  [ -n "${body//[[:space:]]/}" ] || die "log --rundown: the body comes on stdin and was empty"
  requests="$(fleet-bench requests 2>&1)" || requests="## Your requests

Unreadable, so this record does not say what the human is waiting on: $requests"
  stamp="$(date -u '+%F %H:%M UTC')"
  name="$(printf '%s' "$stamp" | sed -E 's/^([0-9-]+) ([0-9]{2}):([0-9]{2}).*/\1T\2\3Z/')"
  mkdir -p "$LEDGER/rundowns" || die "cannot create $LEDGER/rundowns"
  f="$LEDGER/rundowns/$name.md"
  while [ -e "$f" ]; do n=$((n + 1)); f="$LEDGER/rundowns/$name-$n.md"; done
  printf '# %s\n\n%s\n\n%s\n\n%s\n' "$*" "$stamp" "$requests" "$body" > "$f.tmp" && mv "$f.tmp" "$f" \
    || die "cannot write $f"
  printf -- '- %s: rundown: %s (rundowns/%s)\n' "$(date -u '+%H:%M UTC %m-%d')" "$*" "${f##*/}" >> "$LEDGER/log.md"
  echo "$f"
}

# Nothing to move and nothing working is the settled fleet: page that once, as the skill's
# settled rule does, so a quiet fleet still says it is quiet.
settle() {
  local working
  working="$(jq '[(.sessions // [])[] | select(.bucket == "WORKING")] | length' "$STATE_FILE" 2>/dev/null)"
  if [ "${working:-1}" -gt 0 ]; then rm -f "$LEDGER/.settled"; return 0; fi
  [ -e "$LEDGER/.settled" ] && return 0
  : > "$LEDGER/.settled"
  # The count is Home's NEEDS YOU list (hub_core::home::needs), less what a machine can answer.
  local n
  n="$(hub needs --json | jq '[.needs[] | select(.score.human)] | length')" || n="?"
  agent-notify -p normal -t shepherd -r "file:$LEDGER/log.md" "fleet settled: $n need you; rundown in $LEDGER/log.md" || true
}

# check: the refresh and gate a pass starts with, shared by the runner and a /loop tick.
# Exit 1 is nothing to move. Exit 2 is a document it could not refresh or read, which is not
# a quiet fleet.
cmd_check() {
  mkdir -p "$LEDGER" || die "cannot create $LEDGER"
  fleet-sessions --write >/dev/null || { echo "$NAME: fleet-sessions --write failed" >&2; return 2; }
  blocked_sample
  infra_sample
  # Parks act on sessions, so only the runner or the lease holder takes the checkpoint.
  cmd_holds 2>/dev/null && budget_sample
  local due due_rc=0
  due="$(cmd_due)" || due_rc=$?
  [ "$due_rc" = 0 ] || [ "$due_rc" = 1 ] || return "$due_rc"
  due="$(receipts <<<"$due")"
  if [ -z "$due" ]; then settle; return 1; fi
  rm -f "$LEDGER/.settled"
  printf '%s\n' "$due"
}

# due_key <line> -> the line's identity across passes: no `unhandled:` lead, no ledger call, and
# minute counts as Nm, so an overdue phase an hour older is still the same line.
due_key() { sed -E 's/^unhandled: //; s/; then: .*$//; s/[0-9]+m/Nm/g' <<<"$1"; }

# receipts: due lines in, out the ones a pass still owes. Every line a pass is given is answered
# by moving it (a mark or escalate, so it is no longer due) or by `fleet-shepherd skip`: a skipped
# line stays out while it is still due, and a line the last pass was given and left as it was
# comes back first, as `unhandled:`. That is the proof the shepherd handled what it saw. While the
# last pass is still working it may yet reach a line, so its lines come back plain and nothing is
# counted against it. A line owed for FLEET_SHEPHERD_UNHANDLED_MIN pages the human high, once: on 2026-11-04 the passes
# reported "dispatch NOOP" for 6.5h and nobody was told.
receipts() {
  local line key out="" owed="" keys="" rows="" now seen early=""
  touch "$DUE_LAST" "$SKIPPED" "$PAGED"
  now="$(date +%s)"
  ! last_working || early=1
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    key="$(due_key "$line")"
    keys+="$key"$'\n'
    cut -f1 "$SKIPPED" | grep -qxF -- "$key" && continue
    seen="$(awk -F'\t' -v k="$key" '$1 == k { print $3; exit }' "$DUE_LAST")"
    if [ -n "$seen" ] && [ -z "$early" ]; then
      owed+="unhandled: $line"$'\n'
      if [ $(( (now - seen) / 60 )) -ge "$FLEET_SHEPHERD_UNHANDLED_MIN" ] && ! grep -qxF -- "$key" "$PAGED"; then
        # A session's due line is cmd_due's "<verb> <BUCKET>: <server>/<session>:<window> ...",
        # so its target is where the page points; other lines (pace, infra) point nowhere.
        ref=""
        [[ "$key" =~ ^(nudge|escalate)\ [A-Z]+:\ ([^ /]+/[^ ]+:[0-9]+) ]] && ref="tmux:${BASH_REMATCH[2]}"
        agent-notify -p high -t shepherd ${ref:+-r "$ref"} "unhandled $(( (now - seen) / 60 ))m: $key" >/dev/null 2>&1 || true
        printf '%s\n' "$key" >> "$PAGED"
      fi
    else
      out+="$line"$'\n'
    fi
    rows+="$key"$'\t'"$(line_role "$line")"$'\t'"${seen:-$now}"$'\t'"$([ -n "$seen" ] && [ -z "$early" ] && printf 'unhandled: ')$line"$'\n'
  done
  # a skip lasts while its line is due; once it is not, the next time it is due is a new one
  awk -F'\t' 'NR == FNR { if ($0 != "") k[$0] = 1; next } $1 in k' <(printf '%s' "$keys") "$SKIPPED" > "$SKIPPED.tmp" \
    && mv -f "$SKIPPED.tmp" "$SKIPPED"
  awk 'NR == FNR { if ($0 != "") k[$0] = 1; next } $0 in k' <(printf '%s' "$keys") "$PAGED" > "$PAGED.tmp" \
    && mv -f "$PAGED.tmp" "$PAGED"
  printf '%s' "$rows" > "$DUE_LAST"   # agent-web's Shepherd tab reads it (hub_core::boards::due)
  if [ -n "$owed" ]; then
    seen="$(cat "$UNHANDLED" 2>/dev/null)"
    echo $(( ${seen//[!0-9]/} + 1 )) > "$UNHANDLED"
  elif [ -z "$early" ]; then
    rm -f "$UNHANDLED"
  fi
  printf '%s%s' "$owed" "$out" | sed '/^$/d'
}

# last_working -> 0 when the pass running now is still at it.
last_working() {
  local id st
  { read -r id _; } 2>/dev/null < "$PASS" || id=""
  [ -n "$id" ] || return 1
  st="$(pass_status "$id")"
  [ "$st" != idle ] && [ "$st" != gone ]
}

# skip <due line> <why>: answer a due line by leaving it, with the reason, until it stops being due.
# It logs the skip, so a pass whose only answer was a skip did something and is not STALLED.
cmd_skip() {
  [ -n "${1:-}" ] && [ -n "${2:-}" ] || die 'usage: fleet-shepherd skip "<due line>" "<why>"'
  mkdir -p "$LEDGER" || die "cannot create $LEDGER"
  printf '%s\t%s\t%s\n' "$(due_key "$1")" "${2//[$'\t\n']/ }" "$(date +%s)" >> "$SKIPPED"
  cmd_log "skipped: $(due_key "$1"): ${2//[$'\t\n']/ }"   # a receipt the rundown shows, like a nudge
}

# line_role <due line> -> the role skill that answers it (fleet-lead, "Route"); finding, infra
# and improve lines are fleet-lead's own.
line_role() {
  case "${1#unhandled: }" in
    nudge*|escalate*|overdue*|"nightly red"*|"shared red"*) echo shepherd ;;
    pace:*|blocked:*|limit:*) echo fleet-pace ;;
    "watch: queue-starved "*) echo fleet-dispatch ;;   # its "Starved queue" self-heal
    *) echo fleet-lead ;;
  esac
}

# The role skills a pass needs for these due lines, so a headless pass loads only those.
roles_for() {
  local r
  r="$(while IFS= read -r l; do [ -z "$l" ] || line_role "$l"; done <<< "$1" \
    | grep -vx fleet-lead | sort -u -r | paste -sd, - | sed 's/,/, /g')"
  printf '%s\n' "${r:-none}"
}

# --- the pass: an interactive claude in one tmux pane, a fresh one per run --------------------
# A pass is a fresh `/fleet-lead pass` session in window $WINDOW of session $SESSION on server
# $SERVER, so the human can attach, watch it work and type to it (`fleet-shepherd open`). The runner
# does not wait for it: the next run scores it and starts the next in the same pane.

# pass_entry <id> -> the registry file of the live claude holding session <id>; exit 1 when none.
pass_entry() {
  local f pid
  for f in "$HOME/.claude/sessions"/*.json; do
    grep -qF "\"$1\"" "$f" 2>/dev/null && [ "$(jq -r '.sessionId // empty' "$f" 2>/dev/null)" = "$1" ] || continue
    pid="$(jq -r '.pid // empty' "$f")"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || continue
    echo "$f"
    return 0
  done
  return 1
}

# pass_status <id> -> the session's claude status (idle, busy, shell, waiting), or gone.
pass_status() {
  local f
  if f="$(pass_entry "$1")"; then jq -r '.status // "idle"' "$f"; else echo gone; fi
}

# pass_place <id> [recorded pane] -> "<pane>\t<session>\t<window index>\t<window name>\t<dead 0|1>"
# on $SERVER; exit 1 when the pass has no pane there. Identity is the pane, never the window name:
# hub resumed a pass on 2026-11-04 in a window named by its session id, and every surface read
# "no pass running". The registry's `tmux` field (<session>:@<window>.%<pane>) follows a resume.
# Its session has to match, because pane ids are per server and it does not name one.
# list-panes, because display-message falls back to another pane when its target is gone.
pass_place() {
  local f at="" panes row
  panes="$(tmux -L "$SERVER" list-panes -a -F "#{pane_id}"$'\t'"#{session_name}"$'\t'"#{window_index}"$'\t'"#{window_name}"$'\t'"#{pane_dead}" 2>/dev/null)"
  f="$(pass_entry "$1")" && at="$(jq -r '.tmux // empty' "$f")"
  if [ -n "$at" ]; then
    row="$(awk -F'\t' -v p="%${at##*%}" -v s="${at%%:*}" '$1 == p && $2 == s' <<<"$panes")"
    [ -z "$row" ] || { echo "$row"; return 0; }
  fi
  [ -n "${2:-}" ] || return 1
  row="$(awk -F'\t' -v p="$2" '$1 == p' <<<"$panes")"
  [ -n "$row" ] && echo "$row"
}

pass_transcript() {
  local f
  for f in "$HOME/.claude/projects"/*/"$1.jsonl"; do [ -e "$f" ] && { echo "$f"; return 0; }; done
  return 0
}

# The jq for a transcript entry's text, and for one of the human's own turns.
JQ_TURNS='def said: (.message.content? // "") | if type == "string" then . else (map(select(.type == "text") | .text) | join("\n")) end;
  def human: .type == "user" and .turnOrigin == "human";'

# talking <id> -> 0 when the human typed into the pass in the last lease window. The pass's own
# prompt is the first human-origin entry, so it never counts; tool results carry no origin.
talking() {
  local tp at
  tp="$(pass_transcript "$1")"
  [ -n "$tp" ] || return 1
  at="$(jq -r "$JQ_TURNS"' select(human) | .timestamp' "$tp" 2>/dev/null | tail -n +2 | grep . | tail -n 1)"
  # Checked first: `date -d ""` is midnight today, which read as talking for a lease after it.
  [ -n "$at" ] && at="$(date -d "$at" +%s 2>/dev/null)" || return 1
  [ $(( $(date +%s) - at )) -lt $(( FLEET_SHEPHERD_LEASE_MIN * 60 )) ]
}

# conversation <id> <since epoch> -> what the human said to the pass after <since> and what it
# answered, oldest first, the answer being the last thing it wrote before their next turn. It
# starts at the human's first turn: the pass's own prompt, the first human-origin entry, and the
# sweep it runs from it are left out, so a pass nobody talked to has no conversation.
conversation() {
  local tp
  tp="$(pass_transcript "$1")"
  [ -n "$tp" ] || return 0
  jq -rs --argjson since "$2" "$JQ_TURNS"'
    def at: (.timestamp? // "") | sub("\\.[0-9]+Z$"; "Z") | (try fromdate catch 0);
    map(select(human or (.type == "assistant" and (said != "")))) as $all
    | ($all | map(.type) | indices("user")) as $turns
    | if ($turns | length) < 2 then empty else $all[$turns[1]:] end
    | map(select(at > $since) | {type, text: said})
    | reduce .[] as $e ([];
        if $e.type == "user" then . + [{human: $e.text, answer: ""}]
        elif length == 0 then [{human: "", answer: $e.text}]
        else .[-1].answer = $e.text end)
    | .[-40:][]
    | (if .human != "" then "## The human\n\n\(.human)\n" else empty end),
      (if .answer != "" then "## The pass answered\n\n\(.answer)\n" else empty end)' "$tp" 2>/dev/null
}

# score_pass <id> <start> <due count> [why] -> "<verdict>\t<detail>" for the finished pass, by the
# shared verdict over log.md (every move is logged) and its assistant turns (a plan is STALLED).
# A pass given nothing has no move to log: NOOP. A why is a pass that never finished. It is
# recorded in passes.tsv and the pass's files go.
score_pass() {
  local id="$1" start="$2" n="$3" why="${4:-}" verdict detail log tp
  # shellcheck source=/dev/null
  . "$HOME/.local/lib/agent-proof.sh" 2>/dev/null || return 0
  proof_restore "$LEDGER/.proof-$id" || proof_watch "$LEDGER/log.md"
  log="$(mktemp)"
  tp="$(pass_transcript "$id")"
  [ -z "$tp" ] || jq -r 'select(.type == "assistant") | .message.content[]? | (.text // .name // empty)' "$tp" > "$log" 2>/dev/null
  if [ -n "$why" ]; then verdict=STALLED
  elif [ "$n" = 0 ]; then verdict=NOOP
  else verdict="$(proof_verdict "$log" 0)"
  fi
  rm -f "$log"
  detail="pass ${id:0:8}: $n due, $(( ($(date +%s) - start) / 60 ))m${why:+, $why}"
  printf '%s\t%s\t%s\t%s\n' "$(date -u -d "@$start" '+%F %H:%M')" "$id" "$verdict" "$detail" >> "$PASSES"
  rm -f "$LEDGER/.proof-$id" "$LEDGER/.handover-$id" "$LEDGER/labels/$id"
  printf '%s\t%s\n' "$verdict" "$detail"
}

# pass_prompt <due> [handover file]
pass_prompt() {
  printf '/fleet-lead pass\n\nRoles due: %s\n\nDue this pass (from fleet-shepherd due):\n%s\n' "$(roles_for "$1")" "${1:-nothing}"
  [ -z "${2:-}" ] || printf '\nHandover: %s\n' "$2"
}

# pass_account -> the config dir a pass starts on, empty for the main account: the one claude-acct
# room names. With none it is the best there is, so the pass still runs, and the human hears once,
# at normal: the pass carries on as before. The page is room's own line, which names that account
# and how far past its pace it is; "no account has room" alone read as every account being full.
# room's stdout (the dir) goes out as ours through fd 3, so one call gives both.
pass_account() {
  local why
  if { why="$(claude-acct room 2>&1 >&3 3>&-)"; } 3>&1; then
    rm -f "$NOROOM"
    return 0
  fi
  if [ ! -e "$NOROOM" ]; then
    : > "$NOROOM"
    why="$(tail -n 1 <<<"$why")"; why="${why#claude-acct: }"
    agent-notify -p normal -t "No account has room for new starts" \
      "Passes keep running on the closest account and dispatch starts nothing new.${why:+ ${why^}.}" >/dev/null 2>&1 || true
  fi
  claude-acct pick 2>/dev/null || true
}

# launch_pass <id> <due> [handover file] [pane]: write the pane's launcher and start it in <pane>,
# the last pass's, with respawn-pane -k, so the new pass takes its place in the same window. With
# no pane, a new window of the pass session. The launcher carries the runner's environment, since
# a tmux pane gets the server's, not the caller's.
launch_pass() {
  local id="$1" n acct v cmd pane
  n="$(printf '%s\n' "$2" | grep -c .)"
  acct="$(pass_account)"
  {
    echo '#!/usr/bin/env bash'
    echo "# fleet-shepherd pass $id, $(date -u '+%F %H:%M UTC'). The tmux pane runs this."
    for v in PATH AGENTCTL_NAME AGENTCTL_INBOX AGENTCTL_STATE AGENTCTL_STATE_DIR CLAUDE_TELEMETRY_SERVICE \
             MODEL HARNESS ROUTE DATA_CLASS FLEET_SHEPHERD_DIR FLEET_STATE_FILE FLEET_SHEPHERD_LEASE_MIN; do
      [ -z "${!v:-}" ] || printf 'export %s=%q\n' "$v" "${!v}"
    done
    echo 'export FLEET_SHEPHERD_HOLDER=runner'
    # agentctl-run spends from AGENTCTL_ACCOUNT ("default" is main) and ignores CLAUDE_CONFIG_DIR.
    printf 'export AGENTCTL_ACCOUNT=%q\n' "${acct:-default}"
    # shellcheck disable=SC2016
    echo '. "$HOME/.config/shared-hooks/claude-telemetry.sh" 2>/dev/null || true'
    printf 'exec agentctl-run --role observe --session-id %q %q\n' "$id" "$(pass_prompt "$2" "${3:-}")"
  } > "$LEDGER/.pass.sh" || return 1
  # shellcheck source=/dev/null
  . "$HOME/.local/lib/agent-proof.sh" 2>/dev/null && proof_watch "$LEDGER/log.md" && proof_mark "$LEDGER/.proof-$id"
  cmd="bash $(printf '%q' "$LEDGER/.pass.sh")"
  if ! tmux -L "$SERVER" has-session -t "=$SESSION" 2>/dev/null; then
    # The session is made from its world's manifest, as tmx makes every world. With no server,
    # one started from the runner's unit would die with the unit, so it gets a scope.
    if tmux -L "$SERVER" list-sessions >/dev/null 2>&1 || ! command -v systemd-run >/dev/null 2>&1; then
      tmx ensure "$SERVER" "$SESSION" >/dev/null 2>&1
    else
      systemd-run --user --scope --quiet tmx ensure "$SERVER" "$SESSION" >/dev/null 2>&1
    fi
  fi
  pane="${4:-}"
  if [ -n "$pane" ]; then
    tmux -L "$SERVER" respawn-pane -k -t "$pane" -c "$PASS_CWD" "$cmd" || pane=""
  else
    pane="$(tmux -L "$SERVER" new-window -d -P -F '#{pane_id}' -t "=$SESSION:" -n "$WINDOW" -c "$PASS_CWD" "$cmd")" || pane=""
  fi
  [ -n "$pane" ] || { rm -f "$LEDGER/.proof-$id"; return 1; }
  printf '%s\t%s\t%s\t%s\n' "$id" "$(date +%s)" "$n" "$pane" > "$PASS"
  # The pass is the shepherd: no pass moves it, and fleet-sessions counts it apart from the agent
  # sessions. fleet-sessions label needs a live session, and this one is still starting, so the
  # labels are written as fleet-sessions keeps them.
  mkdir -p "$LEDGER/labels" && printf 'manual\nshepherd\n' > "$LEDGER/labels/$id"
  # The lease moves to the new pass now, before it runs: from here the last pass is refused.
  write_lease runner "$id"
  tag_pane $(( $(date +%s) + FLEET_SHEPHERD_LEASE_MIN * 60 )) "$pane"
  claude-acct trust "$SERVER" "$pane" "bypass permissions on" >/dev/null 2>&1 ||
    echo "$NAME: claude did not show bypass mode; look at the pane: $ATTACH" >&2
}

# sweeping -> "<id>\t<status>\t<minutes>" for the lease holder or the last pass when it is mid-sweep:
# working, nobody talking to it, under PASS_MAX_MIN. A second pass then would act on the same due
# lines. The last pass's age runs from its start, a holder's from its lease.
sweeping() {
  local hid at id start st age now
  now="$(date +%s)"
  { read -r _ at hid _; } 2>/dev/null < "$LEASE" || true
  { read -r id start _; } 2>/dev/null < "$PASS" || true
  [ "${hid:--}" != - ] && [ "$hid" != "${id:-}" ] || hid=""
  for id in ${id:+"$id"} ${hid:+"$hid"}; do
    [ "$id" = "$hid" ] && start="$at"
    st="$(pass_status "$id")"
    [ "$st" != idle ] && [ "$st" != gone ] || continue
    age=$(( (now - ${start:-0}) / 60 ))
    [ "$age" -lt "$FLEET_SHEPHERD_PASS_MAX_MIN" ] || continue
    ! talking "$id" || continue
    printf '%s\t%s\t%s\n' "$id" "$st" "$age"
    return 0
  done
  return 1
}

# with_human -> "<id>\t<status>\t<minutes>" when the human is talking to the pass running now
# and replacing it would cut them off: it is answering, or it is under PASS_MAX_MIN old. An idle
# pass past that is replaced like any other, and what they said goes to the next pass, so a long
# talk does not stop the sweeps (70 minutes with none on 2026-11-04).
with_human() {
  local id start st age
  { read -r id start _; } 2>/dev/null < "$PASS" || return 1
  [ -n "${id:-}" ] && talking "$id" || return 1
  st="$(pass_status "$id")"
  [ "$st" != gone ] || return 1
  age=$(( ($(date +%s) - ${start:-0}) / 60 ))
  [ "$st" != idle ] || [ "$age" -lt "$FLEET_SHEPHERD_PASS_MAX_MIN" ] || return 1
  printf '%s\t%s\t%s\n' "$id" "$st" "$age"
}

# replace_pass <id> <start> <due count> <pane>: score the pass the run replaces (STALLED when it is
# still working: sweeping and with_human already let a young one be) and settle its pane. In the
# pass session, alive or dead, the pane is reused: reuse is set to it. Elsewhere (a pass resumed
# into another session) it closes. A gone pass whose pane runs something else is left alone,
# since that is no longer the pass. Sets reuse, sd, and sv to a verdict that fails the run.
replace_pass() {
  local id="$1" st place p sess dead why="" scored
  st="$(pass_status "$id")"
  [ "$st" = idle ] || [ "$st" = gone ] || why="still $st, replaced"
  if place="$(pass_place "$id" "$4")"; then
    IFS=$'\t' read -r p sess _ _ dead <<<"$place"
    if [ "$st" != gone ] || [ "$dead" = 1 ]; then
      if [ "$sess" = "$SESSION" ]; then reuse="$p"; else tmux -L "$SERVER" kill-pane -t "$p" 2>/dev/null; fi
    fi
  fi
  scored="$(score_pass "$id" "$2" "$3" "$why")"
  [ -n "$scored" ] || return 0
  echo "$NAME: ${scored%%$'\t'*} ${scored#*$'\t'}"
  case "$scored" in FAILED*|STALLED*) sv="${scored%%$'\t'*}" ;; esac
  sd+="${sd:+; }${scored#*$'\t'}"
}

cmd_run() {
  [ -n "$SERVER" ] || die "no world declares session $SESSION"
  mkdir -p "$LEDGER" || die "cannot create $LEDGER"
  local id start n pane st busy sv="" sd=""
  # Never two passes at once: the holder mid-sweep finishes, and the next run looks again.
  if busy="$(sweeping)"; then
    IFS=$'\t' read -r id st n <<<"$busy"
    echo "$NAME: pass ${id:0:8} is mid-sweep ($st, ${n}m) and nobody is talking to it: no new pass"
    publish WORKED "pass ${id:0:8} mid-sweep, ${n}m: no new pass"
    return 0
  fi
  if busy="$(with_human)"; then
    IFS=$'\t' read -r id st n <<<"$busy"
    echo "$NAME: the human is talking to pass ${id:0:8} ($st, ${n}m): no new pass"
    publish WORKED "pass ${id:0:8} talking to the human, ${n}m: no new pass"
    return 0
  fi
  # A document it could not refresh is the pass's first problem, not a reason to have no pass.
  local due due_rc=0 trouble=""
  due="$(cmd_check)" || due_rc=$?
  if [ "$due_rc" -gt 1 ]; then
    trouble="could not refresh or read the state document"
    due="$trouble: fleet-sessions --write, $STATE_FILE"
  fi
  [ -z "$due" ] || printf '%s: due\n%s\n' "$NAME" "$due"
  local new hand turns reuse=""
  new="$(cat /proc/sys/kernel/random/uuid)" || return 1
  hand="$LEDGER/.handover-$new"
  # The last pass is replaced in its own pane, and what the human said to it goes to the new one.
  if { read -r id start n pane; } 2>/dev/null < "$PASS" && [ -n "$id" ]; then
    turns="$(conversation "$id" "$start")"
    [ -z "$turns" ] || printf '# Pass %s\n\n%s\n\n' "${id:0:8}" "$turns" > "$hand"
    replace_pass "$id" "$start" "$n" "$pane"
    rm -f "$PASS"
  fi
  if ! launch_pass "$new" "$due" "$([ ! -s "$hand" ] || echo "$hand")" "$reuse"; then
    rm -f "$hand"
    publish FAILED "${sd:+$sd; }could not start a pass in tmux -L $SERVER session $SESSION"
    return 1
  fi
  echo "$NAME: started pass ${new:0:8}: $ATTACH"
  local detail
  detail="${sd:+$sd; }started pass ${new:0:8}: $(printf '%s\n' "$due" | grep -c .) due, $ATTACH"
  if [ -n "$trouble" ]; then publish FAILED "$trouble; $detail"; return "$due_rc"; fi
  publish "${sv:-WORKED}" "$detail"
  [ -z "$sv" ]
}

# open: the pane of the pass running now, wherever it is; with none, the pass window, else the
# pass session. It never starts or resumes a session: a key that did made a second shepherd on
# 2026-11-05.
cmd_open() {
  local id="" pane="" place t
  { read -r id _ _ pane; } 2>/dev/null < "$PASS" || true
  if [ -n "$id" ] && place="$(pass_place "$id" "$pane")"; then
    t="$(cut -f2,3 --output-delimiter=: <<<"$place")"
  else
    tmux -L "$SERVER" has-session -t "=$SESSION" 2>/dev/null || die "no pass running (fleet-shepherd passes)"
    t="$SESSION:"
    ! tmux -L "$SERVER" list-windows -t "=$SESSION" -F '#{window_name}' 2>/dev/null | grep -qxF "$WINDOW" ||
      t="$SESSION:$WINDOW"
  fi
  if [ -n "${TMUX:-}" ] && command -v agent-panel >/dev/null 2>&1; then
    agent-panel jump "$SERVER/$t"
  else
    exec tmux -L "$SERVER" attach -t "=$t"
  fi
}

# passes [n]: the pass running now, then the last n scored, newest first.
cmd_passes() {
  local id start n
  if { read -r id start n _; } 2>/dev/null < "$PASS" && [ -n "$id" ]; then
    printf '%s\t%s\tnow\t%s due, %s\n' "$(date -u -d "@$start" '+%F %H:%M')" "$id" "$n" "$(pass_status "$id")"
  elif [ ! -s "$PASSES" ]; then
    echo "no passes yet: the runner starts one every run (agentctl status shepherd)"
    return 0
  fi
  tail -n "${1:-20}" "$PASSES" 2>/dev/null | tac
  return 0
}

lines() { local c; c="$(grep -c . "$1" 2>/dev/null)"; echo "${c:-0}"; }

# stats: the numbers, read from the ledgers as they are; writes nothing. A 24h count reads log.md's
# `- HH:MM UTC MM-DD: <verb> ...` receipts, so a pass that moved a line without logging it is not counted.
cmd_stats() {
  local now id="" start="" where="" pane="" place last="" lstart lid lverdict st=""
  now=$(date +%s)
  { read -r id start _ pane; } 2>/dev/null < "$PASS" || true
  last="$(tail -n 1 "$PASSES" 2>/dev/null)"
  IFS=$'\t' read -r lstart lid lverdict _ <<<"$last"
  [ -z "$lstart" ] || lstart="$(date -u -d "$lstart" +%s 2>/dev/null)" || lstart=""
  if [ -n "$id" ]; then
    st="$(pass_status "$id")"
    place="$(pass_place "$id" "$pane")" && where="$(cut -f2,3 --output-delimiter=: <<<"$place")"
  fi
  { [ ! -r "$LEDGER/log.md" ] || awk -v now="$(date -u '+%m-%d %H:%M')" -v cut="$(date -u -d '24 hours ago' '+%m-%d %H:%M')" '
    match($0, /^- [0-9][0-9]:[0-9][0-9] UTC [0-9][0-9]-[0-9][0-9]: /) {
      k = substr($0, 13, 5) " " substr($0, 3, 5)
      if (cut <= now ? (k < cut || k > now) : (k < cut && k > now)) next
      v = $5; sub(/:$/, "", v); print v
    }' "$LEDGER/log.md"; } |
    jq -Rsc --argjson now "$now" --argjson pstart "${start:-null}" --argjson lstart "${lstart:-null}" \
      --arg verdict "$lverdict" --arg lid "$lid" --arg id "$id" --arg st "$st" \
      --arg attach "tmux -L $SERVER attach -t ${where:-$SESSION:$WINDOW}" \
      --argjson due "$(lines "$DUE_LAST")" \
      --argjson unhandled "$(cut -f4 "$DUE_LAST" 2>/dev/null | grep -c '^unhandled: ')" \
      --argjson streak "$(c="$(cat "$UNHANDLED" 2>/dev/null)"; echo "${c//[!0-9]/}" | grep . || echo 0)" \
      --argjson skipped "$(lines "$SKIPPED")" \
      --argjson paged "$(lines "$PAGED")" \
      --argjson passes "$(awk -F'\t' -v c="$(date -u -d '24 hours ago' '+%F %H:%M')" '$1 >= c' "$PASSES" 2>/dev/null | grep -c .)" \
      --argjson stuckmin "$FLEET_SHEPHERD_STUCK_MIN" '
      (split("\n") | map(select(length > 0))) as $v
      | def n(w): $v | map(select(. == w)) | length;
      def nul: if . == "" then null else . end;
      ($pstart // $lstart) as $start
      | (if $start == null then null else $now - $start end) as $age
      | (if $due > 0 and ($age == null or $age > $stuckmin * 60)
           then "\($due) due and no pass started in \(if $age == null then "the ledger" else "\($age / 60 | floor)m" end)"
         elif $streak >= 2 then "an unhandled due line at \($streak) checks in a row"
         else null end) as $stuck
      | {state: $due, due: $due, unhandled: $unhandled, unhandled_checks: $streak, skipped: $skipped, paged: $paged,
         nudges_24h: n("nudged"), escalations_24h: n("escalated"), skips_24h: n("skipped"),
         passes_24h: $passes, pass_running: ($id != ""),
         pass_id: ($id | nul), pass_status: ($st | nul),
         pass_age_s: (if $pstart == null then null else $now - $pstart end),
         attach: (if $id == "" then null else $attach end),
         last_pass_epoch: $start, last_pass_age_s: $age,
         last_pass_id: ($lid | nul), last_verdict: ($verdict | nul),
         stuck: ($stuck != null), stuck_why: $stuck}'
}

# stuck: exit 1 naming why when the shepherd has stopped passing, else 0 (stats decides; the
# Sentinel watch shepherd-stuck runs it). The output is what the page carries.
cmd_stuck() {
  local s
  s="$(cmd_stats)" && [ -n "$s" ] || die "could not read the shepherd's ledger at $LEDGER"
  if [ "$(jq -r .stuck <<<"$s")" != true ]; then
    jq -r '"passing: \(.due) due, last pass \(if .last_pass_age_s then "\(.last_pass_age_s / 60 | floor)m ago" else "none on record" end)"' <<<"$s"
    return 0
  fi
  jq -r '"stuck: \(.stuck_why)",
    "last pass: \(.last_pass_id // "none" | .[:8]) \(.last_verdict // "")",
    (if .pass_id then "pass now: \(.pass_id[:8]) \(.pass_status), \(.pass_age_s // 0 | . / 60 | floor)m: \(.attach)" else empty end)' <<<"$s"
  cut -f4 "$DUE_LAST" 2>/dev/null | head -n 5
  return 1
}

case "${1:-}" in
  run)   cmd_run ;;
  stats) cmd_stats ;;
  stuck) cmd_stuck ;;
  open)  shift; cmd_open "$@" ;;
  passes) shift; cmd_passes "$@" ;;
  check) cmd_check ;;
  due)   cmd_due ;;
  infra) cmd_infra ;;
  holds) cmd_holds ;;
  # Only the pass that holds the lease acts (cmd_holds).
  lease) cmd_holds || exit; cmd_lease ;;
  skip)  cmd_holds || exit; shift; cmd_skip "$@" ;;
  log)   cmd_holds || exit; shift; cmd_log "$@" ;;
  sweep-cancel) cmd_holds || exit; shift; cmd_sweep_cancel "$@" ;;
  -h|--help|"") sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown verb: $1 (run|open|passes|stats|stuck|check|due|skip|infra|lease|holds|log|sweep-cancel)" ;;
esac
