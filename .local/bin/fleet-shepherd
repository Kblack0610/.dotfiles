#!/usr/bin/env bash
# fleet-shepherd - the shepherd as a scheduled runner, gated on the fleet state document.
#
#   fleet-shepherd run     one scheduled pass (agentctl runner `shepherd`): defer to a live
#                          interactive shepherd, refresh the state document, and run a headless
#                          `/fleet-lead pass` only when the document holds
#                          something to move
#   fleet-shepherd check   refresh the state document and samples as `run` does, then print
#                          what is due; exit 0 if anything, 1 if nothing (paging "settled"
#                          once), 2 if it could not refresh. A /loop shepherd tick runs it first
#                          and ends the turn on 1, so a quiet tick costs one call, not a pass
#   fleet-shepherd due     print what a pass would move, one line each; exit 0 if anything,
#                          1 if nothing. Reads the document and the blocked sample as they
#                          are, writes nothing
#   fleet-shepherd skip "<due line>" "<why>"
#                          answer a due line by leaving it: it stays out of check while it is
#                          due. check leads with `unhandled: <line>` for any line the last pass
#                          was given and neither moved nor skipped
#   fleet-shepherd infra   print what is wrong with the cluster right now, live: red k3s domain,
#                          or Prometheus not answering; exit 0 if anything, 1 if not. Read by
#                          fleet-dispatch's gate
#   fleet-shepherd lease   record that a shepherd pass is running now and tag its tmux pane
#                          @shepherd; every pass calls it first (fleet-lead, pass step 0)
#   fleet-shepherd log [--heading] <text>
#                          append to the rundown ($LEDGER/log.md) stamped with the clock's
#                          time: a `## <date time> <text>` heading, or a `- <time>: <text>` line
#   fleet-shepherd log --rundown <title> < body
#                          keep a rundown or a chat answer as its own record,
#                          $LEDGER/rundowns/<date>T<hhmm>Z.md, and point at it from log.md.
#                          What the human asked for in chat survives compaction and restarts,
#                          and agent-web's Shepherd tab lists these records
#
# Most passes find nothing to move, and deciding that is a jq query, not a model run. An
# interactive shepherd loop holds the human's latest word in context, so its lease wins.
# Lease, orders and routing: the fleet-lead skill, "Verb: pass".

set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

: "${FLEET_SHEPHERD_LEASE_MIN:=30}" # two loop intervals: one missed pass does not hand over
NAME="${AGENTCTL_NAME:-shepherd}"
LEDGER="${FLEET_SHEPHERD_DIR:-$HOME/.agent/shepherd}"
STATE_FILE="${FLEET_STATE_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/fleet/state.json}"
LEASE="$LEDGER/.lease"
BLOCKED="$LEDGER/.blocked"   # this pass's `fleet-assess --blocked` rows; .prev holds the last pass's
INFRA="$LEDGER/.infra"       # this pass's infra lines
INFRA_SEEN="$LEDGER/.infra-seen" # the ones a finished pass has already reported
DUE_LAST="$LEDGER/.due"      # <key>\t<role>\t<first seen epoch>\t<line>: what the last check handed to a pass
SKIPPED="$LEDGER/.skipped"   # <key>\t<why>\t<epoch>: due lines a pass chose to leave, and why
MAX_TURNS="${SHEPHERD_MAX_TURNS:-40}"
: "${FLEET_SHEPHERD_LIMIT_IDLE:=5}" # minutes idle before a pane is read for the usage-limit stop
: "${FLEET_SHEPHERD_OVERDUE_MIN:=60}" # the least a phase runs before it can be overdue, whatever its eta
LIMIT_RE='weekly limit|usage limit|hit your .*limit|/login' # as the skill's step 1 names them

die() { echo "fleet-shepherd: $*" >&2; exit 2; }

publish() {
  # shellcheck source=/dev/null
  . "$HOME/.local/lib/agent-proof.sh" 2>/dev/null || return 0
  proof_report "$NAME" "$1" "$2" 2>/dev/null || true
}

# lease: "<holder> <epoch>". The runner exports FLEET_SHEPHERD_HOLDER=runner to its pass, so
# the step-0 call inside a headless pass never reads as a human's loop.
cmd_lease() {
  mkdir -p "$LEDGER" || die "cannot create $LEDGER"
  local holder="${FLEET_SHEPHERD_HOLDER:-interactive}" now
  now="$(date +%s)"
  printf '%s %s\n' "$holder" "$now" > "$LEASE"
  tag_pane "$holder" $(( now + FLEET_SHEPHERD_LEASE_MIN * 60 ))
}

# tag_pane <holder> <expires>: exactly one tmux pane carries @shepherd, the one an interactive
# lease was taken from, and its value is the epoch the lease goes stale. A pane option, because
# one tmux session holds many agents, and a session option reads as set on every pane in it.
# Readers show the tag only while that is in the future (.tmux.conf @shepherd_live, agent-panel),
# so a shepherd that stopped renewing drops its tag with no cleanup. Every server in the socket
# dir is swept, found the way agent-panel finds them (tmux.rs socket_dir). A headless pass has
# no pane, so it only clears.
tag_pane() {
  local dir sock pid val
  dir="${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)"
  [ -z "${TMUX:-}" ] || dir="$(dirname "${TMUX%%,*}")"
  for sock in "$dir"/*; do
    [ -S "$sock" ] || continue
    tmux -S "$sock" list-panes -a -F '#{pane_id} #{@shepherd}' 2>/dev/null |
      while read -r pid val; do
        [ -z "$val" ] || tmux -S "$sock" set-option -p -t "$pid" -u @shepherd 2>/dev/null
      done
  done
  [ "$1" = interactive ] && [ -n "${TMUX:-}" ] || return 0
  # Bare tmux under $TMUX is the server this pass runs in; $TMUX_PANE names its pane.
  tmux set-option -p ${TMUX_PANE:+-t "$TMUX_PANE"} @shepherd "$2" 2>/dev/null || true
}

# interactive_age -> minutes since a live interactive pass, or nothing when there is none.
interactive_age() {
  local holder at
  read -r holder at < "$LEASE" 2>/dev/null || return 0
  [ "$holder" = interactive ] && [[ "$at" =~ ^[0-9]+$ ]] || return 0
  echo $(( ($(date +%s) - at) / 60 ))
}

# The shepherd skill's nudge rules (steps 3 and 4), over the document: a hands-off row is never
# moved; DONE, LANDED and STALLED are nudged once; a row for the human is escalated once.
cmd_due() {
  [ -r "$STATE_FILE" ] || die "no state document at $STATE_FILE"
  local out
  out="$(jq -r '
    ( (.main // [])[] | select(.escalated | not) | "nightly red: \(.repo) (\(.reason // "-"))" )
  , ( (.sessions // [])[]
      | select((.labels // []) | index("hands-off") | not)
      | if (.bucket | IN("DONE","LANDED","STALLED")) and (.nudged | not) then
          "nudge \(.bucket): \(.target) \(.fact // "")"
        elif ((.bucket | IN("NEEDS","UNCLEAR")) or ((.bucket | IN("DONE","LANDED","STALLED")) and .nudged))
             and (.escalated | not) then
          "escalate \(.bucket): \(.target) \(.reason // "")"
        else empty end )
  ' "$STATE_FILE")" || die "unreadable state document $STATE_FILE"
  # A hold the machine no longer needs is a GO decision, and a machine over budget with no
  # hold is a hold decision; both are the shepherd's step 1.
  local verdict holds
  verdict="$(fleet-assess 2>/dev/null | sed -n 's/^verdict: \([A-Z]*\).*/\1/p')"
  holds="$(agent-hold list 2>/dev/null | cut -f1 | paste -sd, -)"
  if [ -n "$holds" ] && [ "$verdict" = CLEAR ]; then
    out+="${out:+$'\n'}pace: hold $holds while the machine reads CLEAR"
  elif [ -z "$holds" ] && [ "$verdict" = HOLD ]; then
    out+="${out:+$'\n'}pace: machine reads HOLD with no hold set"
  fi
  local b
  b="$(blocked_due)"
  [ -z "$b" ] || out+="${out:+$'\n'}$b"
  b="$(limit_due)"
  [ -z "$b" ] || out+="${out:+$'\n'}$b"
  b="$(overdue_due)"
  [ -z "$b" ] || out+="${out:+$'\n'}$b"
  # Shared faults lead the sessions: on 2026-10-29 passes moved sessions for 8 hours of a gate stall.
  b="$(findings_due)"
  [ -z "$b" ] || out="$b${out:+$'\n'}$out"
  # Infra leads: on 2026-10-31 eight hours of passes moved sessions and never named the disk.
  b="$(infra_due)"
  [ -z "$b" ] || out="$b${out:+$'\n'}$out"
  [ -n "$out" ] || return 1
  printf '%s\n' "$out"
}

# findings_due -> a line per open finding that wants a decision and has not gone out. Report-class
# findings are not due, and a finding on one sample is not either: on 2026-11-01 throughput-drop
# fired once on a morning of sessions still starting, and cleared on the next sample. The ledger
# key holds the class, so a finding promoted from shepherd to human is news.
findings_due() {
  local rows id key text
  rows="$(fleet-bench findings --json 2>/dev/null)" || {
    echo "finding: fleet-bench findings unreadable, so shared faults are unread"
    return 0
  }
  [ -n "$rows" ] || return 0
  while IFS=$'\t' read -r id key text; do
    [ "$(sed -n 's/^escalated: //p' "$LEDGER/$id" 2>/dev/null)" = "$key" ] && continue
    printf 'finding %s; then: fleet-sessions escalate %s "%s"\n' "$text" "$id" "$key"
  done < <(jq -r 'select(.decision_class != "report" and .epoch > .episode)
    | [("finding-\(.rule)-\(.scope)" | gsub("/"; "-")), "\(.fact) \(.decision_class)",
       "\(.decision_class): \(.rule) \(.scope): \(.conclusion)" + (if (.cost // "") != "" then " (\(.cost))" else "" end)]
    | @tsv' <<<"$rows")
}

# overdue_due -> a line per WORKING session, not mid-turn, whose open phase has run twice its
# fleet-bench estimate and at least FLEET_SHEPHERD_OVERDUE_MIN. No other line looks at a WORKING
# row: on 2026-11-03 agent-53 sat 22h at 0/4 and agent-8 at 1/8 and no pass named either. The fact
# is the phase, so it is nudged once; once the nudge is a phase-length old (at least the floor) and
# the phase has not moved, it goes to the human, once.
overdue_due() {
  local eta now sid key line esc at
  eta="$(fleet-bench eta --json 2>/dev/null)" || {
    echo "overdue: fleet-bench eta unreadable, so phase ages are unread"
    return 0
  }
  [ -n "$eta" ] || return 0
  now="$(date +%s)"
  while IFS=$'\t' read -r sid key line; do
    esc="$(sed -n 's/^escalated: //p' "$LEDGER/$sid" 2>/dev/null)"
    [ "$esc" = "$key" ] && continue
    if [ "$(sed -n 's/^fact: //p' "$LEDGER/$sid" 2>/dev/null)" = "$key" ]; then
      at="$(date -d "$(sed -n 's/^at: //p' "$LEDGER/$sid" 2>/dev/null)" +%s 2>/dev/null)" || continue
      [ $(( (now - at) / 60 )) -ge "${line%%$'\x1f'*}" ] || continue
      printf 'escalate overdue: %s, nudged and not moved; then: fleet-sessions escalate %s "%s"\n' "${line#*$'\x1f'}" "$sid" "$key"
    else
      printf 'overdue: %s; then: fleet-sessions mark %s "%s"\n' "${line#*$'\x1f'}" "$sid" "$key"
    fi
  done < <(jq -rn --argjson now "$now" --argjson floor "$FLEET_SHEPHERD_OVERDUE_MIN" \
      --slurpfile s "$STATE_FILE" --arg eta "$eta" '
    ($s[0].sessions // [] | map(select(.bucket == "WORKING" and ((.reason // "") | startswith("busy") | not)
                                       and ((.labels // []) | index("hands-off") | not)))
       | map({key: .session_id, value: .}) | from_entries) as $w
    | $eta | split("\n")[] | select(length > 0) | fromjson
    | select((.finished | not) and .phase_min != null and .phase_since_epoch != null and $w[.session_id] != null
           and .phases_done < .phases_total)
    | ([2 * .phase_min, $floor] | max) as $limit | (($now - .phase_since_epoch) / 60 | floor) as $age
    | select($age >= $limit)
    | "phase \(.phases_done + 1)/\(.phases_total)" as $ph
    | [.session_id, "overdue \($ph)",
       "\([.phase_min, $floor] | max)\u001f\(.target) \($ph) '"'"'\($w[.session_id].next_phase // "-")'"'"' open \($age)m, expected \(.phase_min)m (\(.basis // "-"))"]
    | @tsv')
}

# limit_due -> a line per session stopped on the account's usage limit. Only the pane says so: no
# transcript record or session status does. An escalated row is left alone, since that is where a
# pass puts one no account has room for, and only the human can add room.
limit_due() {
  local target pane server
  while IFS=$'\t' read -r target pane; do
    server=''
    case "$target" in */*) server="${target%%/*}" ;; esac
    tmux ${server:+-L "$server"} capture-pane -p -t "$pane" 2>/dev/null \
      | grep -v '^[[:space:]]*$' | tail -n 6 | grep -qiE "$LIMIT_RE" \
      && echo "limit: $target stopped on the usage limit"
  done < <(jq -r --argjson idle "$FLEET_SHEPHERD_LIMIT_IDLE" '(.sessions // [])[]
    | select((.labels // []) | index("hands-off") | not)
    | select(((.idle_min // 0) | tonumber? // 0) >= $idle and (.escalated | not) and (.pane // "") != "")
    | [.target, .pane] | @tsv' "$STATE_FILE" 2>/dev/null)
}

# blocked_sample: rotate the blocked rows, so each pass compares itself with the one before.
# Only `run` calls it; `due` reads the two files as they are.
blocked_sample() {
  [ ! -e "$BLOCKED" ] || mv -f "$BLOCKED" "$BLOCKED.prev"
  fleet-assess --blocked > "$BLOCKED" 2>/dev/null || true
}

# blocked_due -> a `blocked:` line per process stuck on I/O in this pass and the last one. One
# sample alone is not enough: an editor reading a font is in D for a moment. Fifteen minutes
# stuck is a walk of a network share or a hung mount (2026-10-29, three searches from `/`).
blocked_due() {
  [ -s "$BLOCKED" ] && [ -s "$BLOCKED.prev" ] || return 0
  awk -F'\t' 'NR == FNR { seen[$1] = 1; next }
    ($1 in seen) { printf "blocked: pid %s %s, %s threads on I/O for %s, %s session %s (%s), open %s\n", $1, $4, $2, $3, $5, $6, $7, $9 }' \
    "$BLOCKED.prev" "$BLOCKED"
}

# infra_now -> a line when the cluster is red or cannot be read. Unreadable counts: Prometheus
# ran on the node that filled, so silence here is what the outage looked like.
infra_now() {
  local json status
  # shellcheck source=/dev/null
  . "${PROM_LIB:-$HOME/.local/lib/prom.sh}" 2>/dev/null || { echo "infra: no Prometheus reader"; return 0; }
  json="$(prom_q 'cc:domain_status{domain="k3s"}')" || { echo "infra: Prometheus not answering"; return 0; }
  status="$(jq -r '.data.result[0].value[1] // "none"' <<< "$json")"
  case "${status%%.*}" in
    2) echo "infra: k3s domain red" ;;
    none) echo "infra: no k3s status series" ;;
  esac
}

cmd_infra() {
  local out
  out="$(infra_now)"
  [ -n "$out" ] || return 1
  printf '%s\n' "$out"
}

# infra_sample: this pass's cluster state and urgent Sentinel trips. A line that cleared leaves
# the seen list, so the same trip coming back is news again.
infra_sample() {
  {
    infra_now
    watch-companion-loop urgent 2>/dev/null | sed 's/^/infra: urgent watch tripped: /'
  } > "$INFRA"
  [ -e "$INFRA_SEEN" ] || return 0
  grep -Fxf "$INFRA" "$INFRA_SEEN" > "$INFRA_SEEN.new"
  mv -f "$INFRA_SEEN.new" "$INFRA_SEEN"
}

# infra_due -> the sampled lines no finished pass has reported. Once per trip: a standing red
# would otherwise start a model pass every 15 minutes with nothing new to say.
infra_due() {
  [ -s "$INFRA" ] || return 0
  if [ -e "$INFRA_SEEN" ]; then grep -Fxvf "$INFRA_SEEN" "$INFRA"; else cat "$INFRA"; fi
}

# log [--heading] <text>: the rundown's only writer of times. A model that types the time
# guesses it: on 2026-10-28 entries stamped 00:55 and 01:00 UTC 10-29 were written at 23:44 UTC.
cmd_log() {
  local heading=0
  [ "${1:-}" = --rundown ] && { shift; log_rundown "$@"; return; }
  [ "${1:-}" = --heading ] && { heading=1; shift; }
  [ -n "$*" ] || die "usage: fleet-shepherd log [--heading] <text>"
  mkdir -p "$LEDGER" || die "cannot create $LEDGER"
  if [ "$heading" = 1 ]; then
    printf '\n## %s %s\n' "$(date -u '+%F %H:%M UTC')" "$*" >> "$LEDGER/log.md"
  else
    printf -- '- %s: %s\n' "$(date -u '+%H:%M UTC %m-%d')" "$*" >> "$LEDGER/log.md"
  fi
}

# log --rundown <title> < body: one record per rundown or chat answer. The body is read
# before anything is written, so an empty one leaves no file and no log line.
log_rundown() {
  [ -n "$*" ] || die "usage: fleet-shepherd log --rundown <title> < body"
  local body stamp name f n=1
  body="$(cat)"
  [ -n "${body//[[:space:]]/}" ] || die "log --rundown: the body comes on stdin and was empty"
  stamp="$(date -u '+%F %H:%M UTC')"
  name="$(printf '%s' "$stamp" | sed -E 's/^([0-9-]+) ([0-9]{2}):([0-9]{2}).*/\1T\2\3Z/')"
  mkdir -p "$LEDGER/rundowns" || die "cannot create $LEDGER/rundowns"
  f="$LEDGER/rundowns/$name.md"
  while [ -e "$f" ]; do n=$((n + 1)); f="$LEDGER/rundowns/$name-$n.md"; done
  printf '# %s\n\n%s\n\n%s\n' "$*" "$stamp" "$body" > "$f.tmp" && mv "$f.tmp" "$f" \
    || die "cannot write $f"
  printf -- '- %s: rundown: %s (rundowns/%s)\n' "$(date -u '+%H:%M UTC %m-%d')" "$*" "${f##*/}" >> "$LEDGER/log.md"
  echo "$f"
}

# Nothing to move and nothing working is the settled fleet: page that once, as the skill's
# settled rule does, so a quiet fleet still says it is quiet.
settle() {
  local working
  working="$(jq '[(.sessions // [])[] | select(.bucket == "WORKING")] | length' "$STATE_FILE" 2>/dev/null)"
  if [ "${working:-1}" -gt 0 ]; then rm -f "$LEDGER/.settled"; return 0; fi
  [ -e "$LEDGER/.settled" ] && return 0
  : > "$LEDGER/.settled"
  local n
  n="$(jq '[(.sessions // [])[] | select(.bucket | IN("NEEDS","UNCLEAR"))] | length' "$STATE_FILE")"
  agent-notify -p normal -t shepherd "fleet settled: $n need you; rundown in $LEDGER/log.md" || true
}

# check: the refresh and gate a pass starts with, shared by the runner and a /loop tick.
# Exit 1 is nothing to move. Exit 2 is a document it could not refresh or read, which is not
# a quiet fleet.
cmd_check() {
  mkdir -p "$LEDGER" || die "cannot create $LEDGER"
  fleet-sessions --write >/dev/null || { echo "$NAME: fleet-sessions --write failed" >&2; return 2; }
  blocked_sample
  infra_sample
  local due due_rc=0
  due="$(cmd_due)" || due_rc=$?
  [ "$due_rc" = 0 ] || [ "$due_rc" = 1 ] || return "$due_rc"
  due="$(receipts <<<"$due")"
  if [ -z "$due" ]; then settle; return 1; fi
  rm -f "$LEDGER/.settled"
  printf '%s\n' "$due"
}

# due_key <line> -> the line's identity across passes: no `unhandled:` lead, no ledger call, and
# minute counts as Nm, so an overdue phase an hour older is still the same line.
due_key() { sed -E 's/^unhandled: //; s/; then: .*$//; s/[0-9]+m/Nm/g' <<<"$1"; }

# receipts: due lines in, out the ones a pass still owes. Every line a pass is given is answered
# by moving it (a mark or escalate, so it is no longer due) or by `fleet-shepherd skip`: a skipped
# line stays out while it is still due, and a line the last pass was given and left as it was
# comes back first, as `unhandled:`. That is the proof the shepherd handled what it saw.
receipts() {
  local line key out="" owed="" keys="" rows="" now seen
  touch "$DUE_LAST" "$SKIPPED"
  now="$(date +%s)"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    key="$(due_key "$line")"
    keys+="$key"$'\n'
    cut -f1 "$SKIPPED" | grep -qxF -- "$key" && continue
    seen="$(awk -F'\t' -v k="$key" '$1 == k { print $3; exit }' "$DUE_LAST")"
    if [ -n "$seen" ]; then owed+="unhandled: $line"$'\n'; else out+="$line"$'\n'; fi
    rows+="$key"$'\t'"$(line_role "$line")"$'\t'"${seen:-$now}"$'\t'"$([ -n "$seen" ] && printf 'unhandled: ')$line"$'\n'
  done
  # a skip lasts while its line is due; once it is not, the next time it is due is a new one
  awk -F'\t' 'NR == FNR { if ($0 != "") k[$0] = 1; next } $1 in k' <(printf '%s' "$keys") "$SKIPPED" > "$SKIPPED.tmp" \
    && mv -f "$SKIPPED.tmp" "$SKIPPED"
  printf '%s' "$rows" > "$DUE_LAST"   # agent-web's Shepherd tab reads it (hub_core::boards::due)
  printf '%s%s' "$owed" "$out" | sed '/^$/d'
}

# skip <due line> <why>: answer a due line by leaving it, with the reason, until it stops being due.
# It logs the skip, so a pass whose only answer was a skip did something and is not STALLED.
cmd_skip() {
  [ -n "${1:-}" ] && [ -n "${2:-}" ] || die 'usage: fleet-shepherd skip "<due line>" "<why>"'
  mkdir -p "$LEDGER" || die "cannot create $LEDGER"
  printf '%s\t%s\t%s\n' "$(due_key "$1")" "${2//[$'\t\n']/ }" "$(date +%s)" >> "$SKIPPED"
  cmd_log "skipped: $(due_key "$1"): ${2//[$'\t\n']/ }"   # a receipt the rundown shows, like a nudge
}

# line_role <due line> -> the role skill that answers it (fleet-lead, "Route"); finding and
# infra lines are fleet-lead's own.
line_role() {
  case "${1#unhandled: }" in
    nudge*|escalate*|overdue*|"nightly red"*) echo shepherd ;;
    pace:*|blocked:*|limit:*) echo fleet-pace ;;
    *) echo fleet-lead ;;
  esac
}

# The role skills a pass needs for these due lines, so a headless pass loads only those.
roles_for() {
  local r
  r="$(while IFS= read -r l; do [ -z "$l" ] || line_role "$l"; done <<< "$1" \
    | grep -vx fleet-lead | sort -u -r | paste -sd, - | sed 's/,/, /g')"
  printf '%s\n' "${r:-none}"
}

cmd_run() {
  mkdir -p "$LEDGER" || die "cannot create $LEDGER"
  local age
  age="$(interactive_age)"
  if [ -n "$age" ] && [ "$age" -lt "$FLEET_SHEPHERD_LEASE_MIN" ]; then
    echo "$NAME: an interactive shepherd passed ${age}m ago - standing down."
    publish NOOP "interactive shepherd live (${age}m)"
    return 0
  fi
  local due due_rc=0
  due="$(cmd_check)" || due_rc=$?
  if [ "$due_rc" = 1 ]; then
    echo "$NAME: nothing to move."
    publish NOOP "nothing to move"
    return 0
  elif [ "$due_rc" != 0 ]; then
    publish FAILED "could not refresh or read the state document"
    return "$due_rc"
  fi
  printf '%s: due\n%s\n' "$NAME" "$due"
  export FLEET_SHEPHERD_HOLDER=runner
  # Scored here, by the shared verdict: a pass that was due moves something, and every
  # move is logged, so log.md is the artifact. Unchanged after a due pass is STALLED.
  # shellcheck source=/dev/null
  . "$HOME/.local/lib/agent-proof.sh" 2>/dev/null && proof_watch "$LEDGER/log.md"
  local rc=0 log verdict
  log="$(mktemp)"; trap "rm -f '$log'" EXIT # expanded now: $log is local, and gone by EXIT
  agentctl-run --role observe -p "/fleet-lead pass

Roles due: $(roles_for "$due")

Due this pass (from fleet-shepherd due):
$due" --max-turns "$MAX_TURNS" 2>&1 | tee "$log" | tail -40 || rc=$?
  [ "$rc" != 0 ] || cp -f "$INFRA" "$INFRA_SEEN"
  verdict="$(proof_verdict "$log" "$rc" 2>/dev/null)" || true
  publish "${verdict:-FAILED}" "$(printf '%s' "$due" | wc -l | tr -d ' ') due$([ "$rc" = 0 ] || printf ' (exit %s)' "$rc")"
  return "$rc"
}

case "${1:-}" in
  run)   cmd_run ;;
  check) cmd_check ;;
  due)   cmd_due ;;
  infra) cmd_infra ;;
  lease) cmd_lease ;;
  skip)  shift; cmd_skip "$@" ;;
  log)   shift; cmd_log "$@" ;;
  -h|--help|"") sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown verb: $1 (run|check|due|skip|infra|lease|log)" ;;
esac
