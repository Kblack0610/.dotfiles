#!/usr/bin/env bash
# fleet-shepherd - the shepherd as a scheduled runner, over the fleet state document.
#
#   fleet-shepherd run     one scheduled pass (agentctl runner `shepherd`): refresh the state
#                          document, score the last pass and start a fresh `/<skill> pass` (the conf's SKILL=, fleet-lead) in
#                          its place, in the same pane of window hub:shepherd on the hub
#                          server (Prefix o). A run starts nothing while the
#                          lease holder is mid-sweep and nobody is talking to it, or while the
#                          human is talking to the pass and it is answering or under
#                          FLEET_SHEPHERD_PASS_MAX_MIN old. With nothing due it starts none, and
#                          with only lines FLEET_SHEPHERD_URGENT_RE does not match it waits until
#                          FLEET_SHEPHERD_DEBOUNCE_MIN after the last pass started (the check costs
#                          no model; a fresh pass does). The pass starts lean (PASS_TOOLS, skills
#                          outside the routing table by name only) and every CANARY_EVERY-th one
#                          runs on CANARY_MODEL: `fleet-bench canary shepherd` compares the lanes
#   fleet-shepherd open    go to the pass running now, to watch it or talk to it; with no pass
#                          pane, to hub:shepherd or session hub. It never starts or resumes a session
#   fleet-shepherd passes [n]
#                          the pass running now and the last n scored, newest first
#   fleet-shepherd stats   one JSON object of shepherd numbers for the feed (agent-mqtt-publish
#                          `summary shepherd`, agent-web's Shepherd tab): open, unhandled,
#                          skipped and paged due lines, 24h nudges, escalations and skips from
#                          log.md, passes, the pass running now (id, status, age, attach line),
#                          the last scored one (id, verdict) and why the shepherd is stuck, if it is
#   fleet-shepherd budget <task text>
#                          an item's `<size> <usd>` budget, by its task's #size/ tag, which hub_core::session_page shows
#   fleet-shepherd stuck   exit 1 naming why when the shepherd has stopped passing: lines due and
#                          no pass started in FLEET_SHEPHERD_STUCK_MIN, or an unhandled line at
#                          two checks in a row that would start a pass; exit 0 otherwise. Sentinel's watch shepherd-stuck
#   fleet-shepherd check   refresh the state document and samples as `run` does, take each queue
#                          session's budget checkpoint (budget_sample: carry on, or park and
#                          page), close the window of a STALLED row still unmoved past its nudge (takeover_sample),
#                          type /wind-down into each session whose close verdict is now, and close the window
#                          of one still closable an hour after its close was typed, its own asks set
#                          to reopen it on the answer (close_sample),
#                          then print what is due; exit 0 if anything, 1 if nothing (paging "settled"
#                          once, when nothing is working), 2 if it could not refresh, 75 if a run held the run lock
#                          past FLEET_SHEPHERD_CHECK_WAIT seconds (a check and a run never sample at once). Each due line is followed by
#                          the skill and section that answer it (the routing table). A fleet-lead pass runs it first
#                          and ends the turn on 1, so a quiet pass costs one call
#   fleet-shepherd route "<due line>"
#                          the skill and section that answer the line, tab separated, from the routing
#                          table .config/fleet-lead/functions.tsv
#   fleet-shepherd due     print what a pass would move, one line each; exit 0 if anything,
#                          1 if nothing. Reads the document and the blocked sample as they
#                          are, writes nothing. A session's nudge line waits while the human
#                          typed into it in the last LEASE_MIN or it was nudged in the last NUDGE_GAP_MIN
#   fleet-shepherd say <host>@<server>/%<pane>|<target> [--fact <fact>] "<text>"
#                          type a nudge into a session's pane, a fleet worker's over the one ssh path
#                          (pane_run, agent-panel send), and only once it was sent claim it
#                          (fleet-sessions mark <sid> <fact>, the row's own fact unless --fact names one).
#                          A worker row's nudge line ends in this call, since ListAgents does not list
#                          a worker's sessions. Exit 0 sent and marked, 1 already nudged or the send
#                          failed, 3 typed but its Enter not taken (the text waits in its box, unmarked),
#                          4 sent but the mark not recorded, 75 nothing sent and nothing marked,
#                          so a later pass sends it: `unreachable: <host>` (ssh's 255), or its prompt
#                          takes no keys, or another send holds the pane
#   fleet-shepherd skip "<due line>" "<why>"
#                          answer a due line by leaving it: it stays out of check while it is
#                          due. check leads with `unhandled: <line>` for any line the last pass
#                          was given (.handed) and neither moved nor skipped. A line that is not
#                          due now is refused (exit 2) naming the nearest due lines, so a
#                          shortened line never lands in .skipped; copy it as check printed it
#   fleet-shepherd infra   print what is wrong with the cluster right now, live: a red k3s node or other non-watch component,
#                          or Prometheus not answering; exit 0 if anything, 1 if not. Read by
#                          fleet-dispatch's gate
#   fleet-shepherd sweep-cancel '<starved pool:<p> @<episode>>'
#                          clear a pool held by a failing sweep: when one workflow_dispatch run on a
#                          sweep/* branch holds more than half the pool's busy runners and more than
#                          half its finished jobs failed, cancel it, record it against the finding
#                          (fleet-bench respond ... cancelled) and print who to tell; exit 0 when it
#                          cancelled, 1 naming why it left the pool alone
#   fleet-shepherd ghost-runs
#                          judge each GitHub run the runner exporter lists as stuck (queued, no jobs)
#                          for FLEET_SHEPHERD_GHOST_AGE_H or more, as GitHub reads it now: still
#                          queued, made that long ago and with no job is a ghost. Each verdict is a
#                          line of $LEDGER/ghost-runs.tsv. Only with FLEET_SHEPHERD_GHOST_CANCEL=1 a
#                          ghost is cancelled, force-cancelled when cancel answers HTTP 409, and
#                          deleted when force-cancel answers 409 too and GitHub still reads it as a
#                          ghost; else it is logged as would-cancel (dry run). Every run calls it
#                          first; exit 1 when the exporter is unreadable
#   fleet-shepherd lease   record that this session is the shepherd pass running now and tag its
#                          tmux pane @shepherd; every pass calls it first (fleet-lead, pass step 0)
#   fleet-shepherd holds   exit 0 when this session may act for the shepherd, 3 naming the pass
#                          that holds the lease when another live one does. lease, skip, log and
#                          fleet-sessions mark and escalate refuse the same way
#   fleet-shepherd log [--heading] <text>
#                          append to the rundown ($LEDGER/log.md) stamped with the clock's
#                          time: a `## <date time> <text>` heading, or a `- <time>: <text>` line
#   fleet-shepherd log - < lines
#                          one `- <time>: <line>` per stdin line, so a pass logs its moves
#                          in one call
#   fleet-shepherd log --rundown <title> < body
#                          keep a rundown or a chat answer as its own record,
#                          $LEDGER/rundowns/<date>T<hhmm>Z.md, and point at it from log.md.
#                          What the human asked for in chat survives compaction and restarts,
#                          and agent-web's Shepherd tab lists these records. Each one leads with
#                          `fleet-bench requests`, written here so no answer can leave it out
#
# A pass starts with a fresh context (about 60k), where one long /loop chat re-read 100k+ on every
# tick and compacted 12 times on 2026-11-03. There is one pass window, and each pass replaces the
# last in the same pane (respawn-pane). On 2026-11-05 a replaced pass kept a window of its own and
# read as a second shepherd, so one run at a time holds a lock, and each closes every other pane a
# pass ran in on the pass server and renames any other window called shepherd.
# A pass's fresh start is most of its cost, so a run with nothing due starts none and a non-urgent
# line waits for the debounce (FLEET_SHEPHERD_DEBOUNCE_MIN, below, has the numbers).
# Talking holds a run only while the pass is answering or young: on 2026-11-04 the human talked
# to a pass for 70 minutes and no sweep ran. What they said goes to the next pass as a handover.
# Lease, orders and routing: the fleet-lead skill, "Verb: pass".

set -uo pipefail

: "${FLEET_SHEPHERD_LEASE_MIN:=30}" # how long a human turn reads as talking and a pane's tag stays live
: "${FLEET_SHEPHERD_NUDGE_GAP_MIN:=60}" # no nudge line for a session sent one this recently, whatever the fact (ar-1576)
: "${FLEET_SHEPHERD_CHECK_WAIT:=120}" # seconds a check waits for a run that holds the run lock; past it the check exits 75
: "${FLEET_SHEPHERD_USAGE_WAIT:=20}" # seconds pass_cost waits on `agent-usage session` (Prometheus), so a hung query never holds the run lock
# Set only for the child the run-lock holder starts (run_locked). Unset at once, so nothing that
# child starts (a pass, a tmux server it makes) inherits it and skips the lock.
RUN_LOCKED="${FLEET_SHEPHERD_RUN_LOCKED:-}"; unset FLEET_SHEPHERD_RUN_LOCKED
NAME="${AGENTCTL_NAME:-shepherd}"
LEDGER="${FLEET_SHEPHERD_DIR:-$HOME/.agent/shepherd}"
STATE_FILE="${FLEET_STATE_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/fleet/state.json}"
LEASE="$LEDGER/.lease"
BLOCKED="$LEDGER/.blocked"   # this pass's `fleet-assess --blocked` rows; .prev holds the last pass's
INFRA="$LEDGER/.infra"       # this pass's infra and watch lines
DUE_LAST="$LEDGER/.due"      # <key>\t<role>\t<first seen epoch>\t<line>: what the last check found due
HANDED="$LEDGER/.handed"     # <key>\t<epoch>: due lines handed to a pass and when, so only those can come back unhandled
SKIPPED="$LEDGER/.skipped"   # <key>\t<why>\t<epoch>: due lines a pass chose to leave, and why
PAGED="$LEDGER/.paged"       # <key>: unhandled lines already paged, kept while they stay due
UNHANDLED="$LEDGER/.unhandled"  # <key>\t<checks>: each owed line and how many checks in a row (that would start a pass) found it unhandled
PASS="$LEDGER/.pass"          # <id>\t<start epoch>\t<due count>\t<pane>: the pass running now
NOROOM="$LEDGER/.noroom"      # present while no account has room, so that is paged once
GHOSTS="$LEDGER/ghost-runs.tsv" # <epoch>\t<verdict>\t<run url>\t<why>[; <GitHub's refusal>]: every run ghost-runs judged
PASSES="$LEDGER/passes.tsv"   # <start>\t<id>\t<verdict>\t<detail>\t<lane_cols>: every pass, once scored; fleet-bench canary shepherd reads the lane columns by position
# shellcheck source=../lib/tmux-servers.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/tmux-servers.sh" || exit 1   # tmux_servers_all
# agentctl-run's lib, beside this script: calls.sh writes each pass's cost line (pass_cost) and
# budget.sh checks the conf's day and hour caps over those lines before a pass starts.
AGENT_RUN_LIB="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../src/agent-run/lib"
# The pass is window shepherd of session hub, on the hub server. The runner owns that window, not
# hub.conf: a declared window would get a shell or a second pass from tmx ensure. A run makes it
# once and after that only respawns its pane, so it creates and kills no windows in hub; the
# window churn of one window per pass is why passes had a server of their own from 2026-11-04 to
# 2026-11-05, and the hub crash that day was Prefix+w tree mode, fixed in the patched tmux.
SESSION="${FLEET_SHEPHERD_SESSION:-hub}"
SERVER="${FLEET_SHEPHERD_SERVER:-$(tmux-world session "$SESSION")}"  # hub; Prefix o (fleet-shepherd open) goes to the pass from any world
WINDOW="${FLEET_SHEPHERD_WINDOW:-shepherd}"
PASS_CWD="${FLEET_SHEPHERD_CWD:-$HOME/.dotfiles}"
ATTACH="tmux -L $SERVER attach -t $SESSION:$WINDOW"
: "${FLEET_SHEPHERD_PASS_MAX_MIN:=30}" # a pass still working this long, with no human on it, is STALLED and closed
: "${FLEET_SHEPHERD_LIMIT_IDLE:=5}" # minutes idle before a pane is read for the usage-limit stop
# A landing wait this long is its own line (landing_due): a slot turn is up to 45m (gate-line.py SLOT_MINUTES), so two
# hours is a queue several turns deep or a holder that is stuck. Confidence low, from one incident (2026-11-15, 3.5h);
# revisit when SLOT_MINUTES moves or when skipped landing lines outnumber acted-on ones in the shepherd log.
: "${FLEET_SHEPHERD_LANDING_WAIT_MIN:=120}"
# A held PR that #high or #urgent rows wait on (fleet-sessions' `critical`) is its own line this long into its wait
# (critical_due): an hour is more than a slot turn's 45m plus the merge. Confidence low, from one incident (2026-11-19:
# ucp-2712 waited 5h on P1 #2935 in the slot); revisit when SLOT_MINUTES moves or critical lines are mostly skipped.
: "${FLEET_SHEPHERD_CRITICAL_MIN:=60}"
# A NEEDS row on its own pending ask, its session idle this long, gets one nudge (needs_nudge): the
# ask sits on the human's asks board and the session is told nothing, so a session whose ask had an agent route sat on it
# (bd-35, 2026-11-19: personal-sites-agent-1 waited 18h on ask 62HFZu, "fix GitHub billing or merge without CI";
# the route was the repo's home runners, ar-3971, taken only after the human asked why it was never nudged).
# Provisional, 2026-11-24: two hours is past a judge's answer and the human's first page; revisit when most
# NEEDS nudges are answered "no route".
: "${FLEET_SHEPHERD_NEEDS_NUDGE_MIN:=120}"
# A run GitHub lists as queued with no job this long is a ghost: no runner will ever take it, and
# each one is a high row on Alerts (plan waht-noise-would-you-jolly-cosmos p2: 23 runs 10 to 12 days
# old on 2026-11-23, every one made 2026-11-11 or 11-13 and still on GitHub, so the exporter was right).
# A run queued for a busy self-hosted pool has jobs, so the age and "no jobs" must both hold. Only
# forge="github" rows: a Forgejo row is stuck because no live runner takes its labels, a runner to
# bring back, and is never cancelled. A jobless run has no test job, so it is no gate on any branch
# (ci.md). Provisional, 2026-11-23: 24h is the plan's floor (the exporter calls a jobless run stuck at
# 1h). Cancels are off until a day of the dry-run log (GHOSTS) has been read; the conf turns them on.
: "${FLEET_SHEPHERD_GHOST_AGE_H:=24}"
: "${FLEET_SHEPHERD_GHOST_CANCEL:=0}"
: "${FLEET_SHEPHERD_UNHANDLED_MIN:=60}" # a due line left this long with no answer pages the human, once; DEBOUNCE_MIN more for a line the debounce can hold
# A skip lasts while its line is due, and at most this long; then the line goes to the next pass
# plain, with the old why in the log, to act on or skip again. Provisional, 2026-11-18: %247 sat
# 10h unnudged on a skip whose blocker item finished an hour after the skip. Revisit if the same
# key is re-skipped more than 3 times a day.
: "${FLEET_SHEPHERD_SKIP_MAX_MIN:=240}"
# A run starts a pass only when something is due, and then only this long after the last pass
# started, unless a due line is urgent. Measured 2026-11-07: a median pass cost $0.89, $0.54 of it
# the fresh start's 68K cache-write tokens, and 40 of 275 scored passes were given nothing.
: "${FLEET_SHEPHERD_DEBOUNCE_MIN:=60}"
# The pass start lands about a minute after its runner tick (measured 2026-11-08: 7 of 18 debounced
# runs read one minute short), so the run DEBOUNCE_MIN later would read DEBOUNCE_MIN-1 and wait one more
# tick. The age counts this much extra, so the debounce lands on the tick it names (ar-1082).
: "${FLEET_SHEPHERD_TICK_SLACK_MIN:=1}"
# Urgent lines start a pass on the next run: a red (nightly, shared, infra, a tripped watch), a
# STALLED row (past fleet-sessions' stall threshold already) and a usage-limit stop. A line the last
# pass left unhandled is as urgent as the line itself: on 2026-11-09 any leftover skipped the debounce,
# which started 59 passes a day. An answered ask has no line: ask-resume hands the answer to its session.
# A critical: line is urgent too: its #high row has already waited FLEET_SHEPHERD_CRITICAL_MIN (ar-3761).
# A pace: machine reads HOLD line is urgent too: an overloaded machine (fleet-assess HOLD) with no hold set
# should not wait the debounce for a pass to set one (ar-3285).
: "${FLEET_SHEPHERD_URGENT_RE:=^(unhandled: )?(nightly red|shared red|infra:|watch:|limit:|nudge STALLED|critical:|pace: machine reads HOLD)}"
# An urgent line starts a pass within a run or two, so 60 is a fault; only a line the debounce can
# hold gets DEBOUNCE_MIN on top (stuck_min).
: "${FLEET_SHEPHERD_STUCK_MIN:=60}" # lines due and no pass started this long: stuck
# A queue session's budget, by its item's #size/ tag; unsized is most items. A budget is a
# checkpoint, not a wall (Ken, 2026-11-05: development comes first): see budget_sample.
: "${FLEET_SHEPHERD_BUDGET_S:=12}" "${FLEET_SHEPHERD_BUDGET_M:=25}" "${FLEET_SHEPHERD_BUDGET_L:=50}"
: "${FLEET_SHEPHERD_BUDGET_USD:=25}" # an item with no size tag
: "${FLEET_SHEPHERD_BUDGET_EXTEND:=3}" # a session still WORKING is parked only at this many budgets
# A STALLED row nudged and still unmoved this long, quiet since, has its window closed so a fresh agent
# takes its step over (takeover_sample); a branch taken over this many times that stalls again pages the
# human instead. Provisional, 2026-11-20: 60 matches UNHANDLED_MIN, low confidence, nothing measured yet;
# revisit when `fleet-shepherd stats` shows takeovers_24h and takeovers_failed_24h for a week. The tries
# are the human's (ar-3741: two failed takeovers, then a page).
: "${FLEET_SHEPHERD_TAKEOVER_MIN:=60}" "${FLEET_SHEPHERD_TAKEOVER_TRIES:=2}"
TAKEOVERS="$LEDGER/.takeover" # close\t<branch>\t<epoch>\t<sid>: each window closed for takeover; page\t<sid>\t<fact>: each failed takeover, paged once
BUDGETS="$LEDGER/.budget"     # <item>\t<budgets reached>\t<extended|parked|pending|left>: each checkpoint, once
SHARED_ITEMS="$LEDGER/.shared"  # <fact>\t<item slug | row:<board row>>: what owns each shared red episode
# The project a shared red's item is filed on: the test failures fleet-sessions reads are the
# playground's gates, local (UNITY_TEST_FAILURES) and on the runner pool (UNITY_POOL_FAILURES,
# from pool-test-failures), so that repo owns the quarantine and the fix.
: "${FLEET_SHARED_RED_PROJECT:=unity-core-playground}"
# Main's quarantine as schedules-sync last read it (its SCHEDULES_QUARANTINE): each lane's
# report.tests[] is {test, ends, row}, and a test quarantined there already has an owner row.
: "${FLEET_SHEPHERD_QUARANTINE:=${XDG_STATE_HOME:-$HOME/.local/state}/ci/quarantine.json}"
LIMIT_RE='weekly limit|usage limit|hit your .*limit|/login' # as the skill's step 1 names them
GATEWAY_LIMIT_RE='Budget has been exceeded'                 # the gateway's 429, matched only on a gateway session

die() { echo "fleet-shepherd: $*" >&2; exit 2; }

# publish <verdict> <detail>: the run's outcome, and the pass it started as the runner's item, so
# `agentctl status shepherd` names it (each run clears the item).
publish() {
  local id
  { read -r id _; } 2>/dev/null < "$PASS" || true
  [ -z "${id:-}" ] || agentctl report --name "$NAME" "item=pass ${id:0:8}: $ATTACH" >/dev/null 2>&1 || true
  # shellcheck source=/dev/null
  . "$HOME/.local/lib/agent-proof.sh" 2>/dev/null || return 0
  proof_outcome "$NAME" "$1" "$2" 2>/dev/null || true
}

# lease: "<holder> <epoch> <session id>". The runner exports FLEET_SHEPHERD_HOLDER=runner to its
# pass, so the Shepherd tab tells a pass from a human's loop. The session id is the claude session
# that holds it (`-` from outside claude): the runner writes the new pass's at launch, and the pass
# renews it at its step 0. Only that session acts (cmd_holds).
cmd_lease() {
  mkdir -p "$LEDGER" || die "cannot create $LEDGER"
  write_lease "${FLEET_SHEPHERD_HOLDER:-interactive}" "${CLAUDE_CODE_SESSION_ID:--}"
  tag_pane $(( $(date +%s) + FLEET_SHEPHERD_LEASE_MIN * 60 ))
}

write_lease() { printf '%s %s %s\n' "$1" "$(date +%s)" "$2" > "$LEASE"; }

# holds: exit 0 when the calling session may act for the shepherd: it holds the lease, nothing live
# holds it, or the caller is no claude session (a shell or a script is not a pass). Otherwise exit 3,
# naming the pass that holds it. Identity is the claude session id, not the pane: a resume moves a
# pass to another pane and keeps its id. The pass the runner just started holds it before its claude
# registers, for a lease window, so the pass it replaced cannot act in those seconds.
cmd_holds() {
  local me="${CLAUDE_CODE_SESSION_ID:-}" id at cur
  [ -n "$me" ] || return 0
  { read -r _ at id _; } 2>/dev/null < "$LEASE" || return 0
  [ -n "${id:-}" ] && [ "$id" != - ] && [ "$id" != "$me" ] || return 0
  if [ "$(pass_status "$id")" = gone ]; then
    { read -r cur _; } 2>/dev/null < "$PASS" || cur=""
    [ "$id" = "$cur" ] && [ $(( $(date +%s) - ${at:-0} )) -lt $(( FLEET_SHEPHERD_LEASE_MIN * 60 )) ] || return 0
  fi
  echo "fleet-shepherd: refused: pass ${id:0:8} holds the shepherd lease, not this session (${me:0:8}), and only the holder acts. The pass running now is in window $WINDOW of session $SESSION (Prefix o); do nothing more here." >&2
  return 3
}

# tag_pane <expires> [pane]: exactly one tmux pane carries @shepherd, the one an interactive
# lease was taken from, and its value is the epoch the lease goes stale. A pane option, because
# one tmux session holds many agents, and a session option reads as set on every pane in it.
# Readers show the tag only while that is in the future (.tmux.conf @shepherd_live, agent-panel),
# so a shepherd that stopped renewing drops its tag with no cleanup. Every server in the socket
# dir is swept, found by tmux_servers_all. The pane argument is a
# pane on $SERVER: the runner tags the pass it starts, so the tag is there before the pass's own
# lease call. A lease taken outside tmux has no pane, so it only clears.
tag_pane() {
  local srv pid val
  while IFS= read -r srv; do
    tmux -L "$srv" list-panes -a -F '#{pane_id} #{@shepherd}' 2>/dev/null |
      while read -r pid val; do
        [ -z "$val" ] || tmux -L "$srv" set-option -p -t "$pid" -u @shepherd 2>/dev/null
      done
  done < <(tmux_servers_all)
  if [ -n "${2:-}" ]; then
    tmux -L "$SERVER" set-option -p -t "$2" @shepherd "$1" 2>/dev/null || true
    return 0
  fi
  [ -n "${TMUX:-}" ] || return 0
  # Bare tmux under $TMUX is the server this pass runs in; $TMUX_PANE names its pane.
  tmux set-option -p ${TMUX_PANE:+-t "$TMUX_PANE"} @shepherd "$1" 2>/dev/null || true
}

# The shepherd skill's nudge rules (steps 3 and 4), over the document, by each bucket's actor in
# the fleet-states.md bucket table and the row's close verdict (`close`, the close flow there): a
# kept row (KEPT_JQ: manual or stay) is not nudged (its close verdict keeps manual for good and stay until quiet FLEET_CHAT_CLOSE_H, then close_sample owns it); a row whose close verdict is now is close_sample's alone (it types the
# close; a pass sends none), and a row holding an open ask it filed is otherwise left alone, its window
# being where the question waits; a STALLED row not yet closable gets its bucket nudge once, and so
# does a DONE or LANDED row the close flow keeps for work left here (`close.left`: its own item still
# running or never closed); any other LANDED one closes on the quiet timer, and fleet-dispatch reap
# files its open phases; a
# NEEDS row on a dialog or plan approval is escalated once, and one on its own pending ask is not: the ask is the
# human's on the asks board, and a line the shepherd cannot clear came back every check and counted as due (ar-2763);
# a STALLED row whose nudge survived is taken over (takeover_sample), a DONE, LANDED or CHAT one closes (close_sample). A test red on several
# branches (shared) is owned by the queue item or quarantine row shared_sample found or filed,
# and its sessions are told once; only one with no owner escalates.
# PARKED is fleet-pace's, below.
# FIN_JQ: finished -> true for a session row whose bucket the state document's vocab.finished lists
# (fleet-sessions BUCKET_FINISHED, the one home of that set). It binds the document first, so every
# program that uses the defs below starts with it, on the state document as its input.
FIN_JQ='(.vocab.finished // []) as $fin | def finished: .bucket as $b | any($fin[]; . == $b);'
# CLOSE_NUDGE_JQ: close_nudge -> CLOSE, DONE, CHAT or PARKED for a session row a close is owed to (its close
# verdict now, its close not yet sent (a manual row never reads now, a stay row only once quiet FLEET_CHAT_CLOSE_H); CLOSE when it holds an open ask it filed; PARKED when
# its claude is gone and nothing is left to land, so there is nothing to type into), null
# otherwise. close_sample types it, and cmd_due gives a pass no line for it; one rule for both.
CLOSE_NUDGE_JQ='def close_nudge:
  if .close_sent or ((.close.verdict // "") != "now") then null
  elif .bucket == "PARKED" then "PARKED"
  elif (.own_asks // 0) > 0 then "CLOSE"
  elif .bucket == "CHAT" then "CHAT"
  elif finished or .bucket == "STALLED" then "DONE"
  else null end;'
# CLOSE_REFUSED_JQ: close_refused -> true for a session row typed its close that is still open: its
# close sent (close_sample's claim), its close verdict still now (CLOSE_JQ in fleet-sessions keeps
# every fact that would lose work or a prompt, and now needs FLEET_IDLE_CLOSE_MIN quiet);
# open plan phases hold nothing, since reap files them. An open ask of its own holds nothing either:
# close_sample sets each to reopen the session on the answer first, the step /wind-down auto takes.
# A NEEDS row reaches a close verdict of now only on its own ask (CLOSE_JQ keeps a dialog). Since
# #2377 nothing else holds it open, so close_sample closes its window (WINDOW) rather than escalating it to the
# human every day (2026-11-18: hub/dotfiles:3 turned down its close on a retired coordinator
# keep, and the shepherd paged "close its window" instead).
CLOSE_REFUSED_JQ='def close_refused:
  .close_sent and (.close.verdict // "") == "now"
  and (finished or (.bucket | IN("STALLED","CHAT","NEEDS","PARKED")));'
# KEPT_JQ: kept -> true for a row held open on the human's word (`manual` or `stay`; the one definition is
# .local/lib/kept.jq, which fleet-bench reads too). The shepherd sends such a row no nudge, overdue,
# landing, critical, limit, park or budget line, and takes none over; whether it closes is its close
# verdict's (CLOSE_JQ in fleet-sessions: manual never, stay once quiet FLEET_CHAT_CLOSE_H).
KEPT_JQ="$(grep -v '^#' "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/kept.jq")" || exit 1
# TAKEOVER_JQ (after the two above): takeover_row -> true for a STALLED row whose nudge survived and that
# is not the human's (kept, plan mode, an open ask) and not already on the close path above, on this
# machine or a fleet worker (takeover_sample reaches a worker's over ssh: a worker's row left out sat
# STALLED for days holding one of its fleet_max_live, ar-4973). takeover_sample reads it.
TAKEOVER_JQ="$KEPT_JQ"'def takeover_row:
  .bucket == "STALLED" and .nudged and (kept | not)
  and ((.in_plan_mode // false) | not) and (.own_asks // 0) == 0
  and close_nudge == null and (close_refused | not);'

# ptag: a session row's tmux pane id as " [%37]", beside its target. The target's window index
# renumbers when an earlier window closes (renumber-windows is on), so on 2026-11-12 the open lines
# named hub/dotfiles:6/7/9 while the pass before had handled :5/6/8; the pane id stays. due_key keys
# the line by it, and the target stays for a reader to act on. A row with no pane gets no tag.
PANE_TAG_JQ='def ptag: if (.pane // "") != "" then " [\(.pane)]" else "" end;'
# SAY_JQ: say_tail -> "; then: fleet-shepherd say <ref> ..." for a fleet worker's row (`host` set),
# "" for this machine's: ListAgents lists no worker session, so a pass's SendMessage to one reached
# nothing while its mark claimed the nudge (ar-3987: razer-laptop@lab/dotfiles-agent-12:1 sat STALLED).
# The ref is the pane, not the target, whose window index renumbers (ptag). overdue_due writes its
# own tail, with the --fact its ledger key needs.
SAY_JQ='def say_ref: if (.pane // "") != "" then "\(.target | split("/")[0])/\(.pane)" else .target end;
  def say_tail: if (.host // "") == "" then "" else "; then: fleet-shepherd say \(say_ref) \"<the nudge>\"" end;'
# ASK_WAIT_JQ: ask_wait -> true for a NEEDS row waiting on its own pending ask (fleet-sessions' reason `N pending
# ask(s)`, carrying on or not). Keyed on the reason, as CLOSE_JQ's dialog step is, not on own_asks: a session
# held in a dialog or plan approval can hold an ask too, and the dialog is still the human's to hear about. The
# ask is the human's on the asks board, so the shepherd escalates no such row and probes none for a limit (ar-2763).
ASK_WAIT_JQ='def ask_wait: .bucket == "NEEDS" and ((.reason // "") | test("pending ask"));'
# NEEDS_NUDGE_JQ (after KEPT_JQ and CLOSE_NUDGE_JQ): needs_nudge -> true for a NEEDS row not
# yet nudged for its fact, not the human's and not the close flow's, holding an ask its session filed, the session
# idle FLEET_SHEPHERD_NEEDS_NUDGE_MIN or more (needs $needs_min; idle time, not the ask's age). A dialog or plan
# approval holds no ask of its own; one carrying on past its ask is overdue_due's, which keys the same fact slot.
NEEDS_NUDGE_JQ='def needs_nudge: .bucket == "NEEDS" and (.nudged | not) and (.close_sent | not)
  and (kept | not) and (close_nudge | not) and ((.reason // "") | endswith("carrying on") | not)
  and (.own_asks // 0) > 0 and (.activity // "") == "idle" and (.idle_min // 0) >= $needs_min;'
# HELD_JQ: held -> true for a DONE or LANDED row the close flow keeps for work left here
# (`close.left`, set by CLOSE_JQ's unlanded, only-item and held steps), so it is nudged though its
# bucket reason names the plan, not the item that keeps it open (2026-11-19: agent-29 sat LANDED on
# its running item, never nudged).
HELD_JQ='def held: finished and (.close.left // null) != null;'

cmd_due() {
  [ -r "$STATE_FILE" ] || die "no state document at $STATE_FILE"
  local out
  out="$(jq -r --argjson items "$(shared_items)" --argjson off "$(nudge_held_off)" --argjson needs_min "$FLEET_SHEPHERD_NEEDS_NUDGE_MIN" \
    "$FIN_JQ$KEPT_JQ$CLOSE_NUDGE_JQ$PANE_TAG_JQ$SAY_JQ$ASK_WAIT_JQ$HELD_JQ$NEEDS_NUDGE_JQ"'
    ( (.main // [])[] | select((.escalated | not) and (.owners // []) == [])
      | "nightly red: \(.repo) (\(.reason // "-"))" )
  , ( (.shared // [])[] | select(.escalated | not) | . as $r
      | ($items[$r.fact] // null) as $item
      | if $item == null then
          "shared red: \(.reason); then: fleet-sessions escalate \(.id) \"\(.fact)\""
        elif (.nudged | not) and ((.owners // []) | length) > 0 and ($item | startswith("row:")) then
          "nudge SHARED: \(.test) is quarantined on main under board row \($item[4:]); tell \(.owners | join(",")): do not gate again on it, merge main to take the quarantine; then: fleet-sessions mark \(.id) \"\(.fact)\""
        elif (.nudged | not) and ((.owners // []) | length) > 0 and ($item | startswith("board:")) then
          ($item[6:] | split(":")) as $b
          | "nudge SHARED: \(.test) is owned by board row \($b[1]) on \($b[0]), which dispatch starts; tell \(.owners | join(",")): do not gate again on it, merge main once it lands; then: fleet-sessions mark \(.id) \"\(.fact)\""
        elif (.nudged | not) and ((.owners // []) | length) > 0 then
          "nudge SHARED: \(.test) is owned by queue item \($item); tell \(.owners | join(",")): do not gate again on it, merge main once \($item) lands; then: fleet-sessions mark \(.id) \"\(.fact)\""
        else empty end )
  , ( (.sessions // [])[]
      | select(kept | not)
      | ((.own_asks // 0) > 0) as $ask
      | if close_nudge then empty
        elif (finished or (.bucket | IN("STALLED","CHAT"))) and (.nudged | not) then
          if ($ask | not) and (.bucket == "STALLED" or held) and (.session_id as $sid | $off | index($sid) | not)
          then "nudge \(.bucket): \(.target)\(ptag) \(.fact // "")\(say_tail)" else empty end
        elif .bucket == "NEEDS" and (.escalated | not) and (ask_wait | not) then
          "escalate \(.bucket): \(.target)\(ptag) \(.reason // ""); then: fleet-sessions escalate \(.session_id) \"\(.fact)\""
        elif needs_nudge and (.session_id as $sid | $off | index($sid) | not) then
          "nudge NEEDS: \(.target)\(ptag) \(.fact // "")\(say_tail)"
        else empty end )
  ' "$STATE_FILE")" || die "unreadable state document $STATE_FILE"
  # A hold the machine no longer needs is a GO decision, and a machine over budget with no
  # hold is a hold decision; both are the shepherd's step 1. So is a parked session on a CLEAR
  # machine with no hold: nothing else ever resumes it. A park that has an owner (its ledger
  # why) is left out: a budget park (why=budget) paged the human, who decides when it resumes, and
  # fleet-dispatch resumes its preempts (why=preempt) once their run units free.
  # Only load holds count: a resource hold (bad RAM until a memtest) or a desktop claim is not
  # about load, so a CLEAR machine is no reason to lift it (ar-2605).
  local verdict holds parked owned
  verdict="$(fleet-assess 2>/dev/null | sed -n 's/^verdict: \([A-Z]*\).*/\1/p')"
  # Every machine, not only this one: a host over its busy mark, or an agent host with a unit
  # outside its CPU cap (home-config agent-host-budget), is a pace line of its own, cut to the
  # hosts so the line stays the same while they do (a skip matches its text); the numbers and
  # units are in `fleet-assess --fleet`, which the pace check reads.
  local fleet
  if ! fleet="$(fleet-assess --fleet 2>/dev/null)"; then
    fleet="$(sed -nE 's/^(fleet: OVER [^(]*[^ (]) \(.*/pace: \1/p; s/^(cap: [^ ]+ NOT live).*/pace: \1/p' <<<"$fleet")"
    [ -z "$fleet" ] || out+="${out:+$'\n'}$fleet"
  fi
  holds="$(agent-hold list --kind load 2>/dev/null | cut -f1 | paste -sd, -)"
  # A hold past its --until (every hold by: human has one) is over whatever the verdict: check and
  # list already read it free, and its release restores what it lowered and removes the file.
  local ended; ended="$(agent-hold list --expired 2>/dev/null | cut -f1 | paste -sd, -)"
  [ -z "$ended" ] || out+="${out:+$'\n'}pace: ended hold $ended (past its until); then: agent-hold release each"
  # `restore` is fleet-dispatch restore's own: it wakes its next batch on CLEAR and lifts the hold
  # itself once none waits, so a CLEAR under it is that pacer's turn, not a go for this pass.
  local lift; lift="$(tr , '\n' <<<"$holds" | grep -vx restore | paste -sd, -)"
  if [ -n "$lift" ] && [ "$verdict" = CLEAR ]; then
    out+="${out:+$'\n'}pace: hold $lift while the machine reads CLEAR"
  elif [ -z "$holds" ] && [ "$verdict" = HOLD ]; then
    # FLEET_SHEPHERD_URGENT_RE matches this text: reword both together.
    out+="${out:+$'\n'}pace: machine reads HOLD with no hold set"
  elif [ -z "$holds" ] && [ "$verdict" = CLEAR ]; then
    # The pace line owns only why=park parks (a missing why is a park); any other why's owner resumes it.
    local f; owned=""
    for f in "${CLAUDE_ACCT_PARKED_DIR:-$HOME/.agent/parked}"/*; do
      [ -f "$f" ] && owned+="$(awk -F= '$1=="why"{w=$2} $1=="target"{t=$2} END{if (w!="" && w!="park") print t}' "$f")"$'\n'
    done
    parked="$(jq -r --arg owned "$owned" "$KEPT_JQ$PANE_TAG_JQ"'
      ($owned | split("\n")) as $owned
      | [(.sessions // [])[] | select(.bucket == "PARKED" and (kept | not)
          and (.target as $t | $owned | index($t) | not))
        | "\(.target)\(ptag)"] | join(", ")' "$STATE_FILE" 2>/dev/null)"
    [ -z "$parked" ] || out+="${out:+$'\n'}pace: parked $parked while the machine reads CLEAR with no hold; then: claude-acct unpark each"
  fi
  local b
  b="$(blocked_due)"
  [ -z "$b" ] || out+="${out:+$'\n'}$b"
  b="$(limit_due)"
  [ -z "$b" ] || out+="${out:+$'\n'}$b"
  b="$(overdue_due)"
  [ -z "$b" ] || out+="${out:+$'\n'}$b"
  b="$(landing_due)"
  [ -z "$b" ] || out+="${out:+$'\n'}$b"
  b="$(critical_due)"
  [ -z "$b" ] || out+="${out:+$'\n'}$b"
  b="$(improve_due)"
  [ -z "$b" ] || out+="${out:+$'\n'}$b"
  # Shared faults lead the sessions: on 2026-10-29 passes moved sessions for 8 hours of a gate stall.
  b="$(findings_due)"
  [ -z "$b" ] || out="$b${out:+$'\n'}$out"
  # Infra leads: on 2026-10-31 eight hours of passes moved sessions and never named the disk.
  b="$(infra_due)"
  [ -z "$b" ] || out="$b${out:+$'\n'}$out"
  [ -n "$out" ] || return 1
  printf '%s\n' "$out"
}

# findings_due -> a line per open finding that wants a decision and has not gone out. Report-class
# findings are not due, and a finding on one sample is not either: on 2026-11-01 throughput-drop
# fired once on a morning of sessions still starting, and cleared on the next sample. The ledger
# key holds the class, so a finding promoted from shepherd to human is news.
findings_due() {
  local rows id key text
  rows="$(fleet-bench findings --json 2>/dev/null)" || {
    echo "finding: fleet-bench findings unreadable, so shared faults are unread"
    return 0
  }
  [ -n "$rows" ] || return 0
  while IFS=$'\t' read -r id key text; do
    [ "$(sed -n 's/^escalated: //p' "$LEDGER/$id" 2>/dev/null)" = "$key" ] && continue
    printf 'finding %s; then: fleet-sessions escalate %s "%s"\n' "$text" "$id" "$key"
  done < <(jq -r 'select(.decision_class != "report" and .epoch > .episode)
    | [("finding-\(.rule)-\(.scope)" | gsub("/"; "-")), "\(.fact) \(.decision_class)",
       "\(.decision_class): \(.rule) \(.scope): \(.conclusion)" + (if (.cost // "") != "" then " (\(.cost))" else "" end)]
    | @tsv' <<<"$rows")
}

# improve_due -> one line for the KPI furthest past its threshold that no live row owns
# (`fleet-bench improve`), so a pass files a defined row with a check, or claims the row or plan
# that already owns it. The line carries no measured value, so its due_key holds still while the
# number moves. Silent when fleet-bench fails: findings_due already names it unreadable.
improve_due() {
  local pick
  pick="$(fleet-bench improve --json 2>/dev/null)" || return 0
  [ -n "$pick" ] || return 0
  jq -r '"improve: \(.kpi) past \(.bound) \(.threshold), no live row"
    + (if .last then ", last \(.last.subject) \(.last.verdict)" else "" end)
    + "; then: fleet-bench improve file \(.kpi) \"<defined fix>\", or claim \(.kpi) <id> when a row or plan already owns it"' \
    <<<"$pick" 2>/dev/null || true
}

# overdue_due -> a line per session whose `overdue` verdict is set (fleet-sessions overdue_of holds the
# rule: twice its fleet-bench estimate and at least FLEET_OVERDUE_MIN, not while a landing wait or a queue
# gate holds it, on the session running the phase) and that can take a nudge now: WORKING, or NEEDS
# carrying on past its question, not mid-turn (activity busy), not kept (KEPT_JQ). No other line looks at a
# WORKING row: on 2026-11-03 agent-53 sat 22h at 0/4 and agent-8 at 1/8 and no pass named either. The
# fact is the phase, so it is nudged once; once the nudge is escalate_min old (a phase-length, at least
# the floor) and the phase has not moved, it goes to the human, once.
overdue_due() {
  local now sid key line ref esc at gone
  # The verdict needs both fleet-bench's phase ages and the rule itself; a failure of either is named.
  gone="$(jq -r '(.unreadable // []) | map(select(. == "fleet-bench eta" or . == "overdue verdicts")) | join(" and ")' "$STATE_FILE" 2>/dev/null)"
  if [ -n "$gone" ]; then
    echo "overdue: $gone unreadable, so no phase is checked for overdue"
    return 0
  fi
  now="$(date +%s)"
  while IFS=$'\t' read -r sid key line ref; do
    esc="$(sed -n 's/^escalated: //p' "$LEDGER/$sid" 2>/dev/null)"
    [ "$esc" = "$key" ] && continue
    if [ "$(sed -n 's/^fact: //p' "$LEDGER/$sid" 2>/dev/null)" = "$key" ]; then
      at="$(date -d "$(sed -n 's/^at: //p' "$LEDGER/$sid" 2>/dev/null)" +%s 2>/dev/null)" || continue
      [ $(( (now - at) / 60 )) -ge "${line%%$'\x1f'*}" ] || continue
      printf 'escalate overdue: %s, nudged and not moved; then: fleet-sessions escalate %s "%s"\n' "${line#*$'\x1f'}" "$sid" "$key"
    elif [ "$ref" != - ]; then
      # A worker's session: say types the message and marks the key once it was sent (SAY_JQ).
      printf 'overdue: %s; then: fleet-shepherd say %s --fact "%s" "<the nudge>"\n' "${line#*$'\x1f'}" "$ref" "$key"
    else
      printf 'overdue: %s; then: fleet-sessions mark %s "%s"\n' "${line#*$'\x1f'}" "$sid" "$key"
    fi
  done < <(jq -r "$KEPT_JQ$PANE_TAG_JQ$SAY_JQ"'
    (.sessions // [])[]
    | select(.overdue != null and .activity != "busy" and (kept | not)
             and (.bucket == "WORKING" or (.bucket == "NEEDS" and ((.reason // "") | endswith("carrying on")))))
    | .overdue as $v
    | [.session_id, "overdue \($v.phase)",
       "\($v.escalate_min)\u001f\(.target)\(ptag) \($v.phase) '"'"'\($v.name)'"'"' open \($v.age_min)m, expected \($v.expected_min)m (\($v.basis // "-"))",
       (if (.host // "") == "" then "-" else say_ref end)]
    | @tsv' "$STATE_FILE" 2>/dev/null)
}

# landing_due -> a line per project whose longest landing wait (fleet-sessions' wait_min: how long a
# session's oldest queue gate has run) is FLEET_SHEPHERD_LANDING_WAIT_MIN or more, with how many of its
# sessions wait their turn and how many PRs carry the landing-queue label (landing_queue). overdue_due
# leaves these rows out, so without this a multi-hour wait behind a stuck slot holder is named by no
# line (ar-2525). A kept session is the human's, as in overdue_due. The line is keyed by its project
# alone (due_key): a skip holds while the queue stays slow, not until the head waiter changes.
landing_due() {
  jq -r --argjson min "$FLEET_SHEPHERD_LANDING_WAIT_MIN" "$KEPT_JQ$PANE_TAG_JQ"'
    [(.sessions // [])[] | select(.bucket != "PARKED" and .wait_min != null
                                  and (kept | not))]
    | group_by(.project // "-")[]
    | max_by(.wait_min) as $l
    | select($l.wait_min >= $min)
    | ([.[].landing_queue | numbers] | max) as $d
    | "landing: \($l.project // "-") longest wait \($l.target)\($l | ptag)"
      + (if $l.wait_repo != null then (if $l.wait_pr != null then " PR \($l.wait_repo)#\($l.wait_pr)" else " gate in \($l.wait_repo)" end)
         elif $l.wait_pr != null then " PR #\($l.wait_pr)"
         elif ($l.pr // "-") != "-" then " PR #\($l.pr)" else "" end) + " \($l.wait_min)m"
      + ", \(length) waiting their landing turn"
      + (if $d != null then ", \($d) PRs in the landing queue" else "" end)
      + "; then: read what holds the landing slot and its session; when it is moving, fleet-shepherd skip this line naming it"' \
    "$STATE_FILE" 2>/dev/null || true
}

# critical_due -> a line per session whose held PR is the critical path of #high or #urgent rows (fleet-sessions'
# `critical`: rows gated #after/ on its item's row, and its place for the slot), once it has waited
# FLEET_SHEPHERD_CRITICAL_MIN: its queue gate's wait (wait_min, "waited"), else how long the session has been idle
# ("idle"): a PR with no gate driving it has no measured wait, and the store keeps no label time. Its bucket reads WORKING (a queue gate, or
# "waiting on the landing queue"), so without this the rows behind it are named by no line (ar-3761: on 2026-11-19
# P1 #2935 read WORKING while ucp-2712 waited 5h). A PR the slot refused (`behind the slot holder #H`, ar-3596) points
# at #H, since its own landing cannot move until #H lets go. A kept session is the human's. Keyed by target and PR (due_key),
# so the line holds while its place moves.
critical_due() {
  jq -r --argjson min "$FLEET_SHEPHERD_CRITICAL_MIN" "$KEPT_JQ$PANE_TAG_JQ"'
    (.sessions // [])[] | select(.critical != null and .bucket != "PARKED" and (kept | not))
    | (.wait_min // .idle_min // 0) as $w | select($w >= $min)
    | .critical.place as $p
    | "critical: \(.target)\(ptag) PR #\(.pr) \($p), \(if .wait_min != null then "waited" else "idle" end) \($w)m; \(.critical.rows | join(", ")) wait on it; then: "
      + (if ($p | test("^(about|waiting)")) then
           "agent-queue bump \(.item.slug // "<its item>") urgent (gate-line.py seats an urgent item first from its next poll; read the place next pass), or take its landing over from its worktree"
         elif ($p | test("^behind the slot holder #")) then
           "read #\($p | capture("#(?<h>[0-9]+)$").h), the PR whose landing slot refused this one: if it is not moving, take its landing over from its worktree; the refused PR runs its Checks again once it lets go"
         else "read what holds the slot; if it is not moving, take its landing over from its worktree" end)' \
    "$STATE_FILE" 2>/dev/null || true
}

# limit_due -> what a pass moves off an account that is out of usage. Each account whose published
# verdict says capped (`room.capped` in `claude-acct room --json`: its week or 5h window spent, or for
# `gateway` the team budget) gets a line per live session on it: an idle one moves to the account
# that answer picks (the best with room), one in a dialog is listed for the human, and a busy one or one with
# shells running waits for a later pass (a move would stop its gate or test). No room anywhere is
# one line per capped account, for the human. A session the account read does not cover (its
# account unread, or not in the row) still gets the pane line: only the pane says it stopped. An
# escalated row is left out of the pane line, since that is where a pass puts one no account has
# room for, and only the human can add room; so is a row waiting on its own ask (ask_wait), which the human answers.
limit_due() {
  local rows capped room_name target pane server account re
  # One ask: room --json exits 1 or 2 when no account has room, and still prints every verdict.
  rows="$(claude-acct room --json 2>/dev/null)"
  # A session on the gateway is on no account (agent-panel names it `gateway`), and every key it can
  # run on spends inside the team budget, so a spent team is that name out of usage.
  capped="$(jq -c '[(.accounts // [])[] | select(.room.capped) | .name]
    + (if any((.sources // [])[]; .kind == "litellm-team" and .room.capped) then ["gateway"] else [] end)' <<<"${rows:-null}" 2>/dev/null)" || capped='[]'
  room_name="$(jq -r '.pick // empty' <<<"${rows:-null}" 2>/dev/null)"
  if [ "${capped:-[]}" != '[]' ]; then
    jq -r --argjson capped "$capped" --arg room "$room_name" "$KEPT_JQ$PANE_TAG_JQ"'
      (.sessions // []) | map((.account // "") as $a
        | select((kept | not) and ($capped | index($a)) != null))
      | (.[] | select(.activity == "idle" and $room != "")
             | "limit: \(.target)\(ptag) idle on \(.account), out of usage; then: claude-acct move \(.target) --to \($room)"),
        (.[] | select(.activity == "waiting")
             | "limit: \(.target)\(ptag) on \(.account), out of usage, is in a dialog; then: list it for the human, and fleet-shepherd skip it"),
        (if $room == "" then group_by(.account)[] | select(any(.activity == "idle"))
           | "limit: \(.[0].account) is out of usage and no account has room; then: tell the human once (\(length) live on it), and fleet-shepherd skip it"
         else empty end)' "$STATE_FILE" 2>/dev/null
  fi
  while IFS=$'\t' read -r target pane account; do
    server=''
    re="$LIMIT_RE"
    [ "$account" = gateway ] && re="$re|$GATEWAY_LIMIT_RE"
    case "$target" in */*) server="${target%%/*}" ;; esac
    tmux ${server:+-L "$server"} capture-pane -p -t "$pane" 2>/dev/null \
      | grep -v '^[[:space:]]*$' | tail -n 6 | grep -qiE "$re" || continue
    if [ "$account" = gateway ] && [ -n "$room_name" ]; then
      echo "limit: $target [$pane] stopped on its gateway budget; then: claude-acct move $target --to $room_name"
    else
      echo "limit: $target [$pane] stopped on the usage limit"
    fi
  done < <(jq -r --argjson idle "$FLEET_SHEPHERD_LIMIT_IDLE" --argjson capped "${capped:-[]}" "$KEPT_JQ$ASK_WAIT_JQ"'(.sessions // [])[]
    | select(kept | not)
    | select((.account // "") as $a | ($capped | index($a)) == null)
    | select(((.idle_min // 0) | tonumber? // 0) >= $idle and (.escalated | not) and (ask_wait | not) and (.pane // "") != "")
    | [.target, .pane, (.account // "")] | @tsv' "$STATE_FILE" 2>/dev/null)
}

# blocked_sample: rotate the blocked rows, so each pass compares itself with the one before.
# Only `run` calls it; `due` reads the two files as they are.
blocked_sample() {
  [ ! -e "$BLOCKED" ] || mv -f "$BLOCKED" "$BLOCKED.prev"
  fleet-assess --blocked > "$BLOCKED" 2>/dev/null || true
}

# blocked_due -> a `blocked:` line per process stuck on I/O in this pass and the last one. One
# sample alone is not enough: an editor reading a font is in D for a moment. Fifteen minutes
# stuck is a walk of a network share or a hung mount (2026-10-29, three searches from `/`).
# The time on the line is the gap between the two samples (a file's mtime: mv keeps the older
# one), the most D time that is known: a process could be in D at both and in S between them, so
# the line says "at two samples", never "for". The process age in fleet-assess's row is not it: a
# daemon up 18h caught in D twice read "for 1092m" (ar-3070). Whether to act is the skill's call
# on what the process is (fleet-pace: kill a recursive search, report anything else).
blocked_due() {
  [ -s "$BLOCKED" ] && [ -s "$BLOCKED.prev" ] || return 0
  local gap=$(( ($(stat -c %Y "$BLOCKED" 2>/dev/null || echo 0) - $(stat -c %Y "$BLOCKED.prev" 2>/dev/null || echo 0)) / 60 ))
  awk -F'\t' -v gap="$gap" 'NR == FNR { seen[$1] = 1; next }
    ($1 in seen) { printf "blocked: pid %s %s, %s threads on I/O at two samples %sm apart, %s session %s (%s), open %s\n", $1, $4, $2, gap, $5, $6, $7, $9 }' \
    "$BLOCKED.prev" "$BLOCKED"
}

# infra_now -> a line when the cluster itself is red or cannot be read: `nodes` at 1 or more (its
# rule reports 1 for any NotReady node and never 2), or any other k3s component but `watches` at 2
# (down; a warn holds nothing, as with the domain rollup this replaced). Unreadable counts:
# Prometheus ran on the node that filled, so silence here is what the outage looked like.
# The watches component is left out on purpose: a watch alone (trivy criticals, a failing
# cluster-janitor) turned the domain red and held cluster work while every node answered (ar-1608).
# A k3s watch trip holds no cluster work at any severity: its red item owns it (fix-red), and a high
# or urgent one also reaches the shepherd as its own `watch:` line (infra_sample).
infra_now() {
  local json kind red
  # shellcheck source=/dev/null
  . "${PROM_LIB:-$HOME/.local/lib/prom.sh}" 2>/dev/null || { echo "infra: no Prometheus reader"; return 0; }
  json="$(prom_q 'cc:component_status{domain="k3s"}')" || { echo "infra: Prometheus not answering"; return 0; }
  IFS=$'\t' read -r kind red < <(jq -r '[(.data.result // [])[] | select(.metric.component != "watches")]
    | if length == 0 then "none\t"
      else "read\t" + (map((.metric.component // "unnamed") as $c | (.value[1] | tonumber? // 2) as $v
          | select($v >= (if $c == "nodes" then 1 else 2 end)) | $c) | unique | join(", ")) end' <<< "$json" 2>/dev/null)
  case "$kind" in
    read) [ -z "$red" ] || echo "infra: k3s $red red" ;;
    none) echo "infra: no k3s component series" ;;
    *) echo "infra: Prometheus answer unreadable" ;;
  esac
}

# ghost_candidates -> "<owner/repo> <run id>" for each GitHub run the runner exporter lists as stuck
# (queued with no jobs, `waiting{stuck="true"}`, whose value is its age) for GHOST_AGE_H or more, once
# each: a run has a series per workflow job name. Exit 2 when the exporter cannot be read.
ghost_candidates() {
  local json
  # shellcheck source=/dev/null
  . "${PROM_LIB:-$HOME/.local/lib/prom.sh}" 2>/dev/null || return 2
  json="$(prom_q "github_actions_job_waiting{stuck=\"true\",forge=\"github\"} >= $((FLEET_SHEPHERD_GHOST_AGE_H * 3600))")" || return 2
  jq -r '.data.result[] | (.metric.url // "") | capture("github\\.com/(?<slug>[^/]+/[^/]+)/actions/runs/(?<id>[0-9]+)")? | "\(.slug) \(.id)"' <<<"$json" | sort -u
}

# ghost_check <owner/repo> <run id> -> the run's age in hours when GitHub says it is still queued, was
# made GHOST_AGE_H or more ago and has no job; else why it is no ghost, exit 1. Exit 2 when GitHub
# cannot be read, so the run is asked about again next time rather than judged.
ghost_check() {
  local run status created age jobs
  run="$(gh api "repos/$1/actions/runs/$2" --jq '[.status, .created_at] | @tsv' 2>/dev/null)" || { echo "run unreadable"; return 2; }
  IFS=$'\t' read -r status created <<<"$run"
  [ "$status" = queued ] || { echo "status $status"; return 1; }
  created="$(date -d "$created" +%s 2>/dev/null)" || { echo "no created_at"; return 2; }
  age=$(( ($(date +%s) - created) / 3600 ))
  [ "$age" -ge "$FLEET_SHEPHERD_GHOST_AGE_H" ] || { echo "queued ${age}h"; return 1; }
  jobs="$(gh api "repos/$1/actions/runs/$2/jobs" --jq .total_count 2>/dev/null)" || { echo "jobs unreadable"; return 2; }
  [ "$jobs" = 0 ] || { echo "$jobs jobs"; return 1; }
  echo "${age}h"
}

# ghost_judged <run url> -> exit 0 when the run was judged in the last GHOST_AGE_H hours and that
# verdict still stands: any verdict in a dry run, and any but would-cancel once cancels are on, so the
# first live run ends what the dry runs found. A run is asked about at most once a GHOST_AGE_H, which
# keeps GitHub calls to the new ghosts and each kept run's log to a line a day.
ghost_judged() {
  [ -s "$GHOSTS" ] || return 1
  awk -F'\t' -v u="$1" -v since="$(( $(date +%s) - FLEET_SHEPHERD_GHOST_AGE_H * 3600 ))" -v live="$FLEET_SHEPHERD_GHOST_CANCEL" '
    $3 == u { t = $1; v = $2 }
    END { exit !(t >= since && !(live == 1 && (v == "would-cancel" || v == "cancel-failed"))) }' "$GHOSTS"
}

# ghost_last <run url> -> the run's last verdict in GHOSTS, or nothing.
ghost_last() { awk -F'\t' -v u="$1" '$3 == u { v = $2 } END { print v }' "$GHOSTS" 2>/dev/null; }

# A ghost run is the reaper's to end: nothing else ever finishes it, and Alerts shows it high until
# someone does. A dry run (GHOST_CANCEL unset) logs what it would do. GitHub's cancel is tried
# first; a run it refuses as not cancellable (HTTP 409; a ghost often is) gets force-cancel, the
# API's call for a run that no longer answers cancel. A run force-cancel refuses as not cancellable
# too is deleted, the one call left that ends it: a ghost has no job and no log to lose (2026-11-24:
# GitHub answered both cancels on 26 ghosts with HTTP 409; the human chose delete, ask 44Ljyz). A
# delete cannot be undone, so GitHub is asked again just before it: a run that took a job or left
# the queue is kept, and one GitHub does not answer about is asked again next run. The log says
# which call ended a run. Any other refusal (auth, rate limit), or a refused delete, is cancel-failed
# with GitHub's answer in its verdict, and tried again next run, logged once.
cmd_ghost_runs() {
  local cand slug id url why rc verdict out refusal unread=""
  mkdir -p "$LEDGER" || die "cannot create $LEDGER"
  case "$FLEET_SHEPHERD_GHOST_CANCEL" in
    0|1) ;;
    *) echo "ghost-runs: FLEET_SHEPHERD_GHOST_CANCEL is '$FLEET_SHEPHERD_GHOST_CANCEL', not 0 or 1, so this is a dry run"
       FLEET_SHEPHERD_GHOST_CANCEL=0 ;;
  esac
  cand="$(ghost_candidates)" || { echo "ghost-runs: the runner exporter is unreadable, so no run was judged"; return 1; }
  while read -r slug id; do
    [ -n "$id" ] || continue
    url="https://github.com/$slug/actions/runs/$id"
    ! ghost_judged "$url" || continue
    why="$(ghost_check "$slug" "$id")"; rc=$? refusal=""
    case $rc in
      0)
        if [ "$FLEET_SHEPHERD_GHOST_CANCEL" != 1 ]; then verdict=would-cancel
        elif out="$(gh api -X POST "repos/$slug/actions/runs/$id/cancel" 2>&1 >/dev/null)"; then verdict=cancelled
        elif [[ "$out" != *"HTTP 409"* ]]; then verdict=cancel-failed
        elif out="$(gh api -X POST "repos/$slug/actions/runs/$id/force-cancel" 2>&1 >/dev/null)"; then verdict=force-cancelled
        elif [[ "$out" != *"HTTP 409"* ]]; then verdict=cancel-failed out="force-cancel: $out"
        else
          why="$(ghost_check "$slug" "$id")"; rc=$?
          case $rc in
            0) if out="$(gh api -X DELETE "repos/$slug/actions/runs/$id" 2>&1 >/dev/null)"; then verdict=deleted
               else verdict=cancel-failed out="delete: $out"
               fi ;;
            1) verdict=kept ;;
            *) unread+=" $url ($why)"; continue ;;
          esac
        fi
        # GitHub's last refusal goes in the ledger, the verdict line and the first log line, so a run
        # that keeps failing names its cause: 822 cancel-failed lines on 16 runs carried none (ar-244).
        if [ "$verdict" = cancel-failed ]; then
          refusal="${out//[$'\t\r\n']/ }" refusal="${refusal:-no answer from gh}" refusal="${refusal:0:200}"
        fi ;;
      1) verdict=kept ;;
      *) unread+=" $url ($why)"; continue ;;
    esac
    # A cancel is an act, so the rundown carries it as sweep-cancel's does, a failed one once; a
    # verdict alone stays in GHOSTS.
    case $verdict in
      cancelled|force-cancelled) cmd_log "ghost run $url: $verdict, queued $why with no jobs" ;;
      deleted) cmd_log "ghost run $url: deleted, queued $why with no jobs; cancel and force-cancel answered HTTP 409" ;;
      cancel-failed) [ "$(ghost_last "$url")" = cancel-failed ] || cmd_log "ghost run $url: cancel-failed, queued $why with no jobs ($refusal); tried again each run" ;;
    esac
    printf '%s\t%s\t%s\t%s\n' "$(date +%s)" "$verdict" "$url" "$why${refusal:+; $refusal}" >> "$GHOSTS"
    echo "ghost-runs: $verdict $url ($why${refusal:+; $refusal})"
  done <<<"$cand"
  # One line for every run GitHub did not answer about: none is judged, each is asked again next run.
  [ -z "$unread" ] || echo "ghost-runs: GitHub did not answer, asked again next run:$unread"
}

# sweep_holder <pool> -> "<owner/repo> <run id> <branch> <held> <busy>" for the workflow_dispatch run
# on a sweep/* branch holding more than half the busy runners running the pool's kind of job, or
# nothing. Read from the runner exporter: github_runner_state (one series per runner, the job's url
# carrying the run) kept where ci_runner_job's kind is the pool, so the job's kind is the exporter's
# and no label mapping is copied here. A runner row is never keyed by its job's kind: a slot that
# takes unity, light and heavy runs any of them.
sweep_holder() {
  local json
  # shellcheck source=/dev/null
  . "${PROM_LIB:-$HOME/.local/lib/prom.sh}" 2>/dev/null || return 2
  json="$(prom_q "github_runner_state{state=\"running\"} and on (name) label_replace(ci_runner_job{kind=\"$1\"}, \"name\", \"\$1\", \"runner\", \"(.+)\")")" || return 2
  jq -r '.data.result | length as $busy
    | map(.metric | select(.event == "workflow_dispatch" and ((.branch // "") | startswith("sweep/")))
        | ((.url // "") | capture("github\\.com/(?<slug>[^/]+/[^/]+)/actions/runs/(?<id>[0-9]+)")?) + {branch})
    | group_by(.id) | map({slug: .[0].slug, id: .[0].id, branch: .[0].branch, held: length})
    | (max_by(.held) // empty) | select(.held * 2 > $busy)
    | "\(.slug) \(.id) \(.branch) \(.held) \($busy)"' <<<"$json"
}

# A starved pool held by one failing sweep is the shepherd's to clear: a sweep reruns, a held pool
# costs hours. On 2026-11-05 7 of 8 frame-sweep shards failed over 7h on the razer slots while
# every pass paged instead. Failures come from the run's jobs, since a run GitHub reports as
# queued can hold running ones.
cmd_sweep_cancel() {
  local fact="${1:-}" pool holder slug id branch held busy jobs finished failed url
  [[ "$fact" =~ ^starved\ pool:([^\ ]+)\ @[0-9]+$ ]] || { echo "usage: fleet-shepherd sweep-cancel 'starved pool:<pool> @<episode>'" >&2; return 2; }
  pool="${BASH_REMATCH[1]}"
  holder="$(sweep_holder "$pool")" || { echo "sweep-cancel: the runner exporter is unreadable, so pool $pool stays"; return 1; }
  read -r slug id branch held busy <<<"$holder"
  [ -n "$id" ] || { echo "sweep-cancel: no sweep run holds most of pool $pool"; return 1; }
  jobs="$(gh api "repos/$slug/actions/runs/$id/jobs" --paginate -q '.jobs[] | select(.status == "completed") | .conclusion' 2>/dev/null)" \
    || { echo "sweep-cancel: run $id's jobs are unreadable, so it stays"; return 1; }
  finished="$(grep -c . <<<"$jobs")"; failed="$(grep -cx failure <<<"$jobs")"
  if ((failed * 2 <= finished)); then
    echo "sweep-cancel: run $id ($branch) holds $held of $busy $pool runners, but $failed of $finished finished jobs failed: it stays"
    return 1
  fi
  gh run cancel "$id" -R "$slug" >/dev/null 2>&1 || { echo "sweep-cancel: gh run cancel $id -R $slug failed"; return 1; }
  url="https://github.com/$slug/actions/runs/$id"
  fleet-bench respond "$fact" shepherd cancelled "$url" >/dev/null 2>&1 || true
  cmd_log "cancelled sweep run $id ($branch): it held $held of $busy $pool runners and $failed of $finished finished jobs failed"
  echo "cancelled $url: held $held of $busy $pool runners, $failed of $finished finished jobs failed"
  echo "tell the session on $branch: its sweep run $id was cancelled because it held pool $pool with $failed of $finished jobs failed; fix the failure before rerunning it"
}

cmd_infra() {
  local out
  out="$(infra_now)"
  [ -n "$out" ] || return 1
  printf '%s\n' "$out"
}

# infra_sample: this pass's cluster state and the Sentinel trips the shepherd hears: the high and
# urgent ones of `watch-companion-loop tripped`, which lists every TRIP watch. On 2026-11-04 the
# shepherd heard urgent only, so queue-starved (high) never reached it. Every other trip is owned by
# its fleet-bench triage red item, or by the human sheet on a human route, so it raises no line here.
# A watch whose `red` item is running or queued unheld has an owner, so it raises no line either; a
# held one does not, as fleet-dispatch watch_reds gives it no slot. A watch with an unexpired
# quarantine (`watch-companion-loop quarantined`, in force only) is owned by the ask or row it names,
# so it raises none either until the quarantine ends (an `alert:` silence row names no watch, so it
# owns none; the call is bounded, as it asks Alertmanager too); then it is a due line like any red (ar-4585).
infra_sample() {
  local owned
  owned=$({ agent-queue list --json 2>/dev/null | jq -r 'select(((" " + (.tags // "") + " ") | contains(" red ")))
    | select(.state != "queued" or (.hold // "") == "") | .task' \
    | sed -n 's/^check(watch): \([^ ]*\) tripped.*/\1/p'
    timeout 20 watch-companion-loop quarantined 2>/dev/null | cut -f1; })
  {
    infra_now
    watch-companion-loop tripped 2>/dev/null | awk -F'\t' -v owned="$owned" '
      BEGIN { n = split(owned, o, "\n"); for (i = 1; i <= n; i++) has[o[i]] = 1 }
      ($2 == "high" || $2 == "urgent") && !($1 in has) { printf "watch: %s tripped (%s)\n", $1, $2 }'
  } > "$INFRA"
}

# infra_due -> the sampled lines. Like every due line, one stays due until a pass answers it (a
# fix, or `skip` with the why), so a standing red is answered once, not by every pass.
infra_due() {
  [ ! -s "$INFRA" ] || cat "$INFRA"
}

# item_budget <item json>: print its `<size> <usd>`, by the `#size/` tag of its task
item_budget() {
  local size
  size="$(jq -r '(.task // "" | capture("#size/(?<s>[sml])\\b") | .s) // ""' <<<"$1")"
  case "$size" in
    s) echo "s $FLEET_SHEPHERD_BUDGET_S" ;;
    m) echo "m $FLEET_SHEPHERD_BUDGET_M" ;;
    l) echo "l $FLEET_SHEPHERD_BUDGET_L" ;;
    *) echo "unsized $FLEET_SHEPHERD_BUDGET_USD" ;;
  esac
}

# budget_sample: hold each queue session to its item's budget, as checkpoints. Each whole budget
# an item's sessions pass is one checkpoint, handled once: a WORKING session carries on (logged)
# up to FLEET_SHEPHERD_BUDGET_EXTEND budgets; one STALLED at a checkpoint, or still
# WORKING past the last, is parked (`claude-acct park`, resumable) and the human is paged once. A
# park refused because the turn is running is pending and retried every sample until its turn
# ends. A session waiting on the human, or finished, costs nothing more, so it is only logged.
# An unpark buys one more budget before the next checkpoint. No cost read means no checkpoint.
budget_sample() {
  local costs target bucket slug sids item size cap usd n had st why out
  costs="$(claude-acct cost 2>/dev/null)" && [ -n "$costs" ] || return 0
  touch "$BUDGETS" 2>/dev/null || return 0
  while IFS=$'\t' read -r target bucket slug sids; do
    item="$(agent-queue show "$slug" --json 2>/dev/null)" || continue
    read -r size cap < <(item_budget "$item")
    read -r usd n < <(jq -r --argjson c "$costs" --arg sids "$sids" --argjson cap "$cap" '
      ([(.sessions // "" | split(" ")[]), ($sids | split(" ")[])] | map(select(. != "")) | unique
       | map($c[.] // 0) | add // 0) as $u | "\($u * 100 | round / 100) \($u / $cap | floor)"' <<<"$item")
    read -r had st < <(awk -F'\t' -v k="$slug" '$1 == k { n = $2; s = $3 } END { print n + 0, (s == "" ? "-" : s) }' "$BUDGETS")
    why="$slug spent \$$usd, ${n}x its \$$cap $size budget"
    if [ "$st" != pending ]; then
      [ "$n" -gt "$had" ] || continue
      case "$bucket" in
        WORKING) [ "$n" -ge "$FLEET_SHEPHERD_BUDGET_EXTEND" ] || {
                   budget_mark "$slug" "$n" extended "budget: $target ($why), still working: carries on to $((n + 1))x"; continue; } ;;
        STALLED) ;;
        *) budget_mark "$slug" "$n" left "budget: $target ($why), $bucket: not parked, it is not spending"; continue ;;
      esac
    fi
    if out="$(claude-acct park "$target" --why budget 2>&1)"; then
      budget_mark "$slug" "$n" parked "budget: parked $target ($why, $bucket)"
      [ "$st" = pending ] || budget_page "$target parked at its budget" "$why, $bucket. Resume it with claude-acct unpark $target; it runs one more budget before the next checkpoint."
    elif [[ "$out" == *"busy mid-turn"* || "$out" == *"background shells"* ]]; then
      [ "$st" = pending ] && continue
      budget_mark "$slug" "$n" pending "budget: $target ($why, $bucket) parks once its turn ends"
      budget_page "$target is past its budget" "$why, $bucket. It parks once its turn ends; claude-acct unpark $target resumes it."
    else
      budget_mark "$slug" "$n" left "budget: could not park $target ($why): ${out##*: }"
    fi
  done < <(jq -r "$KEPT_JQ"'(.sessions // [])[] | select(.dispatch != null and (kept | not))
    | [.target, .bucket, (.dispatch | sub("^[^:]*: "; "")), (.session_id // "")] | @tsv' "$STATE_FILE" 2>/dev/null)
}

# budget_mark <item> <budgets> <state> <log line>: one checkpoint handled, in the ledger and log.md
budget_mark() {
  { grep -v "^$1"$'\t' "$BUDGETS"; printf '%s\t%s\t%s\n' "$1" "$2" "$3"; } > "$BUDGETS.tmp" && mv "$BUDGETS.tmp" "$BUDGETS"
  cmd_log "$4" >/dev/null
}
budget_page() { agent-notify -p high -t "$1" -r "file:$LEDGER/log.md" "$2" >/dev/null 2>&1 || true; }

# takeover_sample: the takeover step (ar-3741). A STALLED row (TAKEOVER_JQ) whose nudge is FLEET_SHEPHERD_TAKEOVER_MIN
# old and which has been quiet that long has its window closed through wind-down.sh close, the one closer
# close_sample's WINDOW path uses, once its work is safe: a clean tree, commits on a remote, a branch off
# the trunk and a queue item of its own. fleet-dispatch reap then gives the step to a fresh agent
# (own_parked_pr, takeover_branch); the shepherd starts nothing. Only a pane at an empty idle prompt is
# closed, so a draft is left. A row it cannot hand over, a close that fails, or a branch already taken over
# FLEET_SHEPHERD_TAKEOVER_TRIES times pages once per fact: since a STALLED row no longer escalates, that
# page is the only one it gets. The tries are counted on the branch in $TAKEOVERS, since a taker is a
# new session. A fleet worker's row is read and closed on its machine over the one ssh path (pane_run),
# by its own stowed wind-down.sh as close_sample does; a worker that does not answer (ssh's 255) is
# neither closed nor paged, and the next check tries again.
# takeover_blocker <branch> <cwd> <dirty> <item> <host|-> -> why no fresh agent can take the row over,
# nothing when one can; exit 2, nothing printed, when its worker did not answer over ssh.
takeover_blocker() {
  local branch="$1" cwd="$2" dirty="$3" item="$4" host="$5" n out rc=0
  [ "$item" != - ] || { echo "no queue item owns it, so no agent would take it over"; return; }
  case "$branch" in -|main|master|HEAD) echo "it holds no branch of its own"; return ;; esac
  [ "$dirty" != x ] || { echo "its tree state could not be read"; return; }
  [ "$dirty" = 0 ] || { echo "its tree has uncommitted changes"; return; }
  pane_run "$host" git -C "$cwd" rev-parse -q --verify HEAD >/dev/null 2>&1 || rc=$?
  [ "$host" = - ] || [ "$rc" != 255 ] || return 2
  [ "$rc" = 0 ] || { echo "its checkout cannot be read"; return; }
  rc=0; out="$(pane_run "$host" git -C "$cwd" branch -r --contains HEAD 2>/dev/null)" || rc=$?
  [ "$host" = - ] || [ "$rc" != 255 ] || return 2
  [ -n "$(grep -m 1 . <<<"$out")" ] || { echo "its commits are not pushed"; return; }
  n="$(awk -F'\t' -v b="$branch" '$1 == "close" && $2 == b { n++ } END { print n + 0 }' "$TAKEOVERS")"
  [ "$n" -lt "$FLEET_SHEPHERD_TAKEOVER_TRIES" ] || echo "branch $branch was taken over $n times and stalled again"
}

takeover_sample() {
  local sid target pane fact idle branch cwd dirty item at when now why rc n srv host wdc acted=""
  local wd="${FLEET_WIND_DOWN:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../src/tmux/wind-down.sh}"
  now="$(date +%s)"
  touch "$TAKEOVERS" 2>/dev/null || return 0
  while IFS=$'\t' read -r sid target pane fact idle branch cwd dirty item; do
    case "$sid" in ''|*/*|.|..) continue ;; esac
    srv="$(pane_server "$target")"; [ -n "$srv" ] && [[ "$pane" == %* ]] || continue
    at="$(sed -n '/^at: /{s///p;q;}' "$LEDGER/$sid" 2>/dev/null)"
    when="$(date -d "$at" +%s 2>/dev/null)" || continue
    [ $((now - when)) -ge $((FLEET_SHEPHERD_TAKEOVER_MIN * 60)) ] && [ "$idle" -ge "$FLEET_SHEPHERD_TAKEOVER_MIN" ] || continue
    awk -F'\t' -v s="$sid" -v f="$fact" '$1 == "page" && $2 == s && $3 == f { found = 1 } END { exit !found }' "$TAKEOVERS" && continue
    host="$(pane_host "$target")"
    [ "$host" = - ] || pane_lib || continue
    rc=0; why="$(takeover_blocker "$branch" "$cwd" "$dirty" "$item" "$host")" || rc=$?
    [ "$rc" != 2 ] || continue
    if [ -z "$why" ]; then
      pane_takes_keys "$host" "$srv" "$pane" || continue
      wdc=("$wd"); [ "$host" = - ] || wdc=(sh -c 'exec "$HOME/.local/src/tmux/wind-down.sh" "$@"' wind-down)
      rc=0; pane_run "$host" "${wdc[@]}" close --server "$srv" --pane "$pane" --sid "$sid" >/dev/null 2>&1 || rc=$?
      [ "$host" = - ] || [ "$rc" != 255 ] || continue
      if [ "$rc" = 0 ]; then
        n="$(awk -F'\t' -v b="$branch" '$1 == "close" && $2 == b { n++ } END { print n + 0 }' "$TAKEOVERS")"
        printf 'close\t%s\t%s\t%s\n' "$branch" "$now" "$sid" >> "$TAKEOVERS"
        cmd_log "takeover: $target: closed its window, quiet ${idle}m past its nudge; item $item takes branch $branch over (try $((n + 1)) of $FLEET_SHEPHERD_TAKEOVER_TRIES)" >/dev/null
        acted=1
        continue
      fi
      why="closing its window failed (exit $rc)"
    fi
    # A page agent-notify refused is not recorded, so the next check tries it again.
    agent-notify -p high -k decision -t "$target: stalled and not taken over" -r "tmux:$target" \
      "$target has sat STALLED ${idle}m past its nudge and no fresh agent can take it over: $why. Finish or close it by hand." >/dev/null 2>&1 || continue
    printf 'page\t%s\t%s\n' "$sid" "$fact" >> "$TAKEOVERS"
    cmd_log "takeover-failed: $target: paged, $why" >/dev/null
  done < <(jq -r "$FIN_JQ$CLOSE_NUDGE_JQ$CLOSE_REFUSED_JQ$TAKEOVER_JQ"'(.sessions // [])[] | select(takeover_row)
    | select(all(.session_id, .target, .pane; type == "string" and . != "" and (test("[\t\n]") | not)))
    | [.session_id, .target, .pane, ((.fact // "-") | tostring | gsub("[\t\n]"; " ")), ((.idle_min // 0) | floor),
       (.branch // "-"), (.cwd // "-"), (.dirty // "x"), (.item.slug // "-")]
    | map(tostring | if . == "" then "-" else gsub("[\t\n]"; " ") end) | @tsv' "$STATE_FILE" 2>/dev/null)
  [ -z "$acted" ] || fleet-sessions --write >/dev/null || true
}

# close_items_sample: the only-item step's named step, done. A row whose only blocker is its own queue
# item, still open with every phase done or queued (`close.items`, CLOSE_JQ's only-item step), once quiet
# FLEET_IDLE_CLOSE_MIN gets `agent-queue move <slug> done --status ok --if running`, so its close verdict
# reads now and close_sample closes it in the same pass (2026-11-18: agent-22 sat 7h on its item, nudged
# and never closed). Not manual (its verdict is keep, as is a fresh stay), not a worker's row (its queue is on its machine),
# AGENT_QUEUE_START=0 (the shepherd starts nothing; the close still queues the rows after its item, pull_after). agent-queue refuses an item with a partial landing or
# an open PR: that refusal is logged and left to the nudge and escalation, and tried again after FLEET_IDLE_CLOSE_MIN
# (a marker file in .item-close-failed/). A row that wakes itself (`wake`) keeps its item: its wake needs it.
close_items_sample() {
  local sid target slug out rc acted="" failed="$LEDGER/.item-close-failed"
  mkdir -p "$failed" 2>/dev/null
  while IFS=$'\t' read -r sid target slug; do
    case "$sid.$slug" in */*|*..*|.*|*.) continue ;; esac
    # A refused or failed move waits FLEET_IDLE_CLOSE_MIN before the next try: a lock held for a moment is
    # retried, and a refusal is logged once an hour, not at every check.
    [ -z "$(find "$failed/$sid.$slug" -mmin "-${FLEET_IDLE_CLOSE_MIN:-60}" 2>/dev/null)" ] || continue
    rc=0; out="$(AGENT_QUEUE_START=0 agent-queue move "$slug" done --status ok --if running 2>&1)" || rc=$?
    case "$rc" in
      0) acted=1; cmd_log "close: $target: closed its item $slug, every phase is done or queued" >/dev/null ;;
      3) ;;   # the item left running meanwhile: nothing to close
      *) : > "$failed/$sid.$slug"
         cmd_log "close: $target: could not close its item $slug ($(tail -n 1 <<<"$out" | cut -c1-200)); the nudge carries it" >/dev/null ;;
    esac
  done < <(jq -r --argjson idle "${FLEET_IDLE_CLOSE_MIN:-60}" '(.sessions // [])[]
    | select(.host == null and ((.close.items // []) | length) > 0 and .wake == null
        and ((if .bucket == "PARKED" then (.idle_min // 0) else ([.idle_min // 0, .age_min // 0] | min) end) >= $idle)
        and all(.session_id, .target; type == "string" and . != "" and (test("[\t\n]") | not)))
    | . as $r | $r.close.items[] | [$r.session_id, $r.target, .] | @tsv' "$STATE_FILE" 2>/dev/null)
  [ -z "$acted" ] || fleet-sessions --write >/dev/null || true
}

# close_page <sid> <target> <fact>: the page for a window close that failed. Once per session: nothing
# escalates a DONE, LANDED or CHAT row any more (#2806), so this page is the only one it gets. One agent-notify
# refused is not recorded in .close-paged, so the next check tries it again.
close_page() {
  local sid="$1" target="$2" fact="$3" paged="$LEDGER/.close-paged"
  grep -qxF "$sid" "$paged" 2>/dev/null && return 0
  agent-notify -p high -k decision -t "$target: its window will not close" -r "tmux:$target" \
    "Closing the window of $target failed ($fact). Look at it and close it by hand." >/dev/null 2>&1 || return 0
  printf '%s\n' "$sid" >> "$paged"
  cmd_log "close-failed: $target: paged, closing its window failed ($fact)" >/dev/null
}

# close_sample: the timer closer. Every row it reads already has a close verdict of now (CLOSE_JQ in
# fleet-sessions: quiet FLEET_IDLE_CLOSE_MIN, nothing that would lose work), so it re-proves none of it.
# - Empty prompt, nothing typed yet: claim (mark --close, once per session) and type /wind-down auto,
#   /wind-down for CHAT. Typing is the one model-free way in; a SendMessage to another permission mode
#   waits unseen. A pane another send holds (exit 75) gives its claim back.
# - Prompt not typeable (a draft, a dialog, copy mode), nothing typed yet: close its window.
# - Manual (investigate-only) permission mode, nothing typed yet: its hook denies every write, so a
#   typed /wind-down auto is wasted (ar-4046); close its window the same way, no keystrokes.
# - Typed FLEET_IDLE_CLOSE_MIN ago and still due (WINDOW, CLOSE_REFUSED_JQ): whatever it did with the
#   close (a red stopped it), it is quiet again with nothing to land: close it.
# A window closes only unshown, with Claude in front (an editor's buffer is not in the scrollback) and
# no turn running in its footer, by wind-down.sh close (scrollback, window, a reap that refuses a dirty
# tree), its own open asks set to reopen it first (logged once in .reopen-failed when one cannot be).
# A failed close is recorded in .close-failed (not tried again) and paged once (close_page). A worker's pane goes over
# ssh (pane_run). Having acted, it refreshes the document so cmd_due reads it.
close_sample() {
  local sid target pane close fact asks nasks man host server cmd when now rc wdc how st mode att wa fg screen
  local acted="" failed="$LEDGER/.close-failed"
  local wd="${FLEET_WIND_DOWN:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../src/tmux/wind-down.sh}"
  now="$(date +%s)"
  close_items_sample
  while IFS=$'\t' read -r sid target pane close fact asks nasks man; do
    case "$sid" in */*|.|..) continue ;; esac
    host="$(pane_host "$target")"; server="$(pane_server "$target")"
    [ -n "$server" ] && [[ "$pane" == %* ]] || continue
    # Loaded and the roster read here, once, so the $(...) reads below inherit both.
    [ "$host" = - ] || pane_lib || continue
    st="$(pane_tmux "$host" "$server" display-message -p -t "$pane" '#{pane_in_mode} #{session_attached} #{window_active} #{pane_current_command}' 2>/dev/null)" || continue
    read -r mode att wa fg <<<"$st"
    screen="$(pane_tmux "$host" "$server" capture-pane -p -t "$pane" 2>/dev/null)" || continue
    how=""
    if [ "$close" = PARKED ]; then
      how="parked: its claude is gone and nothing is left to land, so there is no prompt to type into"
    elif [ "$close" = WINDOW ]; then
      when="$(stat -c %Y "$LEDGER/.closed/$sid" 2>/dev/null)" || continue
      [ $((now - when)) -ge $(( ${FLEET_IDLE_CLOSE_MIN:-60} * 60 )) ] || continue
      how="still due ${FLEET_IDLE_CLOSE_MIN:-60}m after its close was typed"
    elif [ "$man" = 1 ]; then
      how="manual (investigate-only) mode: it cannot write a wind-down note, so no close is typed into it"
    elif [ "${mode:-1}" != 0 ] || ! idle_prompt "$screen"; then
      how="its prompt not idle (a draft, a dialog, tmux mode or an unreadable screen), kept in its saved scrollback"
    fi
    if [ -n "$how" ]; then
      # Shown (its session attached and its window the current one), not Claude in front, or a turn running.
      # tmux session_attached and window_active, read live here, are the live form of the row's `attached`; session-close-overdue skips such a row (ar-4271).
      [ "${att:-1}" != 0 ] && [ "${wa:-1}" = 1 ] && continue
      if [ "$close" != PARKED ]; then
        case "$fg" in claude|node) ;; *) continue ;; esac
        working_footer "$screen" && continue
      fi
      if grep -qxF "$sid" "$failed" 2>/dev/null; then close_page "$sid" "$target" "$fact"; continue; fi
      if ! reopen_own_asks "$sid" "$asks" "$nasks"; then
        if ! grep -qxF "$sid $asks" "$LEDGER/.reopen-failed" 2>/dev/null; then
          printf '%s %s\n' "$sid" "$asks" >> "$LEDGER/.reopen-failed"
          cmd_log "close: $target: its asks ($asks) could not be set to reopen it, so its window stays for the next check ($fact)" >/dev/null
        fi
        continue
      fi
      # On a worker, its own stowed wind-down.sh (not on PATH there either).
      wdc=("$wd"); [ "$host" = - ] || wdc=(sh -c 'exec "$HOME/.local/src/tmux/wind-down.sh" "$@"' wind-down)
      rc=0; pane_run "$host" "${wdc[@]}" close --server "$server" --pane "$pane" --sid "$sid" >/dev/null 2>&1 || rc=$?
      if [ "$rc" = 0 ]; then
        acted=1
        cmd_log "close: $target: closed its window, $how ($fact)" >/dev/null
      elif [ "$host" != - ] && [ "$rc" = 255 ]; then
        # ssh's own failure, not the close's: the next check tries again.
        cmd_log "close: $target: its machine did not answer over ssh; the next check closes its window ($fact)" >/dev/null
      else
        printf '%s\n' "$sid" >> "$failed"
        cmd_log "close: $target: closing its window failed ($fact)" >/dev/null
        close_page "$sid" "$target" "$fact"
      fi
      continue
    fi
    fleet-sessions mark --close "$sid" >/dev/null 2>&1 || continue
    cmd="/wind-down auto"; [ "$close" = CHAT ] && cmd="/wind-down"
    # --wait 0: a pane another send holds is not waited on, so the screen just read is the one typed
    # into; nothing was typed, so the claim goes back and the next check types it.
    rc=0; pane_run "$host" agent-panel send --wait 0 --pane "$server/$pane" "$cmd" >/dev/null 2>&1 || rc=$?
    case "$rc" in
      0) acted=1; cmd_log "close: $target $close: typed $cmd ($fact)" >/dev/null ;;
      3) acted=1; cmd_log "close: $target $close: typed $cmd, but its Enter was not taken; the window close, ${FLEET_IDLE_CLOSE_MIN:-60}m on if it is still due, carries it" >/dev/null ;;
      75) fleet-sessions mark --release "$sid" && acted=1
          cmd_log "close: $target $close: another send held its pane; the next check types it" >/dev/null ;;
      # ssh failed (255). A link dropped after the keys landed would see them typed twice, but by
      # then the pane is busy or gone, and the next check types only into an idle, empty prompt.
      255) fleet-sessions mark --release "$sid" && acted=1
          cmd_log "close: $target $close: its machine did not answer over ssh; the next check types it" >/dev/null ;;
      *) cmd_log "close: $target $close: marked, but typing $cmd failed ($rc); the window close, ${FLEET_IDLE_CLOSE_MIN:-60}m on if it is still due, carries it" >/dev/null ;;
    esac
  done < <(jq -r "$FIN_JQ$CLOSE_NUDGE_JQ$CLOSE_REFUSED_JQ"'(.sessions // [])[]
    | (close_nudge // (if close_refused then "WINDOW" else null end)) as $close | select($close)
    | select(all(.session_id, .target, .pane; type == "string" and . != "" and (test("[\t\n]") | not)))
    | [.session_id, .target, .pane, $close, ((.fact // "-") | tostring | gsub("[\t\n]"; " ")),
       ([(.blockers // [])[] | strings | capture("^open ask (?<id>[A-Za-z0-9_-]+)$").id] | join(",") | if . == "" then "-" else . end),
       ((.asks // 0) | floor), (if .in_manual_mode then 1 else 0 end)]
    | @tsv' "$STATE_FILE" 2>/dev/null)
  [ -z "$acted" ] || fleet-sessions --write >/dev/null || true
}

# reopen_own_asks <sid> <ids|-> <asks>: set each of the session's open asks (comma separated) to
# reopen it on the answer, as the closing session itself would (CLAUDE_CODE_SESSION_ID names it to
# agent-ask). Fails when fewer ids were read than the row's `asks` counts, so an ask the blockers
# do not name is never left without its session, and on the first that cannot be set: answered
# meanwhile or no session named. An ask with its own resume counts as set: the answer runs it.
# `asks`, not `own_asks`: an ask a queue item holds (its ask:<id> tag) is in own_asks but not in the
# blockers, and needs no reopen: the queue restarts that item on the answer, so no `reopen:` line is
# written for it (ar-4271: lab/dotfiles-agent-4 refused its close every pass on ask poGHJB).
reopen_own_asks() {
  local id ids=()
  [ "$2" = - ] || IFS=, read -ra ids <<<"$2"
  [ "${#ids[@]}" -ge "${3:-0}" ] || return 1
  for id in "${ids[@]}"; do
    CLAUDE_CODE_SESSION_ID="$1" agent-ask reopen-on-answer "$id" >/dev/null 2>&1 || return 1
  done
}

# A session row's target is <server>/<session>:<window> here, <host>@<server>/... on a fleet worker
# (fleet-hosts.sh fleet_host_panel). pane_host -> the worker, or - for this machine; pane_server ->
# the tmux server; empty when the target names none.
pane_host() { local t="${1%%/*}"; [ "$t" != "$1" ] && [[ $t == *@* ]] && echo "${t%%@*}" || echo -; }
pane_server() { local t="${1%%/*}"; [ "$t" != "$1" ] || return 0; echo "${t#*@}"; }
# pane_run <host|-> <cmd...>: the command on the pane's machine, a worker's over the one ssh path.
# pane_tmux <host|-> <server> <tmux args...>: tmux on that machine's server.
# pane_lib: fleet-hosts.sh loaded and its roster read, in the calling shell, so subshells inherit both.
pane_lib() {
  declare -F fleet_host_run >/dev/null || . "${FLEET_HOSTS_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/fleet-hosts.sh}" || return 1
  fleet_hosts >/dev/null
}
pane_run() {
  local h="$1"; shift
  [ "$h" != - ] || { "$@"; return; }
  declare -F fleet_host_run >/dev/null || pane_lib || return 1
  fleet_host_run "$h" "$@"
}
pane_tmux() { local h="$1" s="$2"; shift 2; pane_run "$h" tmux -L "$s" "$@"; }

# pane_takes_keys <host|-> <server> <pane> -> exit 0 when the pane is in no tmux mode at an idle prompt.
# A pane on this machine in a mode (copy mode, the choose-tree picker, stacked) that no client shows,
# its session detached or its window not the current one, is left first with leave_mode (`copy-mode
# -q` resets every mode, where `send-keys -X cancel` does nothing in tree mode; ar-3949: hub/dotfiles:11
# sat skipped 4.5h). A shown pane keeps its mode, and a worker's pane in one is not touched (leave_mode
# runs tmux here). The caller has checked the pane quiet.
pane_takes_keys() {
  local h="$1" s="$2" p="$3" st mode att wa
  declare -F leave_mode >/dev/null || . "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/tmux-pane.sh" || return 1
  st="$(pane_tmux "$h" "$s" display-message -p -t "$p" '#{pane_in_mode} #{session_attached} #{window_active}' 2>/dev/null)" || return 1
  read -r mode att wa _ <<<"$st"
  if [ "${mode:-1}" != 0 ]; then
    [ "$h" = - ] || return 1
    [ "${att:-1}" = 0 ] || [ "${wa:-1}" != 1 ] || return 1
    leave_mode "$s" "$p" || return 1
    # Not the verb "takeover": cmd_stats counts that verb, and this line is no takeover (ar-4619).
    cmd_log "mode-left: $s/$p: left its tmux mode on an unwatched pane" >/dev/null
  fi
  idle_prompt "$(pane_tmux "$h" "$s" capture-pane -p -t "$p" 2>/dev/null)"
}

# cmd_say <ref> [--fact <fact>] <text>: a pass's nudge, typed into the row's pane by agent-panel send
# (the one typer, under its pane lock) on the row's machine (pane_run), then claimed with
# fleet-sessions mark. The mark comes after the send, not before as for a SendMessage, so a worker that
# did not answer leaves the row unmarked for the next pass instead of nudged with nothing delivered
# (ar-3987). <ref> is <host>@<server>/%<pane> or a row's target, matched in the state document.
cmd_say() {
  local ref="${1:-}" fact="" text row sid target pane own host server
  shift || true
  if [ "${1:-}" = --fact ]; then fact="${2:-}"; shift 2 || true; [ -n "$fact" ] || die "say: --fact needs a fact"; fi
  text="${1:-}"
  [ -n "$ref" ] && [ -n "$text" ] && [ $# -eq 1 ] || die 'usage: fleet-shepherd say <host>@<server>/%<pane>|<target> [--fact <fact>] "<text>"'
  [ "$text" != "<the nudge>" ] || die "say: write the nudge in place of <the nudge> (the shepherd skill's message for its fact)"
  [ -r "$STATE_FILE" ] || die "no state document at $STATE_FILE"
  row="$(jq -r --arg r "$ref" "$SAY_JQ"'[(.sessions // [])[] | select((.target | type) == "string") | select(.target == $r or say_ref == $r)]
    | if length == 1 then .[0] | [.session_id, .target, .pane, .fact]
        | map(. // "" | tostring | gsub("[\t\n]"; " ") | if . == "" then "-" else . end) | @tsv
      else length end' "$STATE_FILE")" || die "unreadable state document $STATE_FILE"
  case "$row" in
    0) die "say: no session row is $ref in $STATE_FILE" ;;
    *$'\t'*) ;;
    *) die "say: $row session rows match $ref; name its pane, <host>@<server>/%<pane>" ;;
  esac
  IFS=$'\t' read -r sid target pane own <<<"$row"
  [ -n "$fact" ] || fact="$own"
  [ "$sid" != - ] && [ "$fact" != - ] || die "say: the row $ref has no session id or fact to mark"
  host="$(pane_host "$target")"; server="$(pane_server "$target")"
  [ -n "$server" ] && [[ "$pane" == %* ]] || die "say: $target has no tmux pane to type into"
  [ "$host" = - ] || pane_lib || die "say: cannot load the fleet hosts library"
  mkdir -p "$LEDGER" || die "cannot create $LEDGER"
  # One say at a time, and the ledger (not the state document, a minute old) read under that lock, so
  # a retry or a second call before the document refreshes types nothing twice.
  ( flock 9; say_send "$sid" "$target" "$pane" "$host" "$server" "$fact" "$text" ) 9>"$LEDGER/say.lock"
}

# say_send <sid> <target> <pane> <host|-> <server> <fact> <text>: cmd_say's send and mark, under its lock.
say_send() {
  local sid="$1" target="$2" pane="$3" host="$4" server="$5" fact="$6" text="$7" rc=0
  if fleet-sessions nudged "$sid" "$fact"; then
    echo "fleet-shepherd: $target was already nudged for this fact; nothing sent" >&2; return 1
  fi
  # ssh's own 255 is told apart from a pane that cannot take keys: only the first is `unreachable`.
  pane_tmux "$host" "$server" display-message -p -t "$pane" '#{pane_id}' >/dev/null 2>&1 || rc=$?
  if [ "$host" != - ] && [ "$rc" = 255 ]; then echo "unreachable: $host"; return 75; fi
  [ "$rc" = 0 ] || { echo "fleet-shepherd: say: $target: its pane $pane is gone" >&2; return 2; }
  if ! pane_takes_keys "$host" "$server" "$pane"; then
    echo "busy: $target: its prompt takes no keys (a draft, a dialog, a mode or a turn running); nothing sent"; return 75
  fi
  rc=0; pane_run "$host" agent-panel send --wait 0 --pane "$server/$pane" "$text" >/dev/null 2>&1 || rc=$?
  case "$rc" in
    0) fleet-sessions mark "$sid" "$fact" >/dev/null || { echo "fleet-shepherd: $target: sent, but its mark was not recorded" >&2; return 4; }
       echo "said: $target" ;;
    3) echo "fleet-shepherd: $target: typed, but its Enter was not taken; the text waits in its input box, unmarked" >&2; return 3 ;;
    75) echo "busy: $target: another send holds its pane; nothing typed"; return 75 ;;
    255) [ "$host" = - ] || { echo "unreachable: $host"; return 75; }
         echo "fleet-shepherd: $target: typing failed (exit 255)" >&2; return 1 ;;
    *) echo "fleet-shepherd: $target: typing failed (exit $rc)" >&2; return 1 ;;
  esac
}

# working_footer <screen> -> exit 0 when the footer, the lines below the last rule, says a turn runs ("esc to
# interrupt", its head, as a narrow pane cuts it). Only the footer: the conversation above can quote
# the words (3e7d9635 sat closable 11h on one). A screen with no rule is read whole.
working_footer() {
  awk '/^─/ { n = NR } { l[NR] = $0 }
    END { for (i = n + 1; i <= NR; i++) if (index(l[i], "esc to inter")) f = 1; exit !f }' <<<"$1"
}

# idle_prompt <screen> -> exit 0 only on Claude's input box (the lines between the screen's last two
# rules, the top one may carry the session's name) holding nothing but the prompt glyph, with no turn
# running. A draft, a ghost suggestion, a dialog or a screen it cannot read all fail.
idle_prompt() {
  working_footer "$1" && return 1
  awk -v nb=$'\xc2\xa0' '
    { l[NR] = $0 }
    /^───/ && /─ *$/ { r2 = r1; r1 = NR }
    END {
      if (!r2 || r1 - r2 < 2) exit 1
      for (i = r2 + 1; i < r1; i++) { s = l[i]; gsub(/❯/, "", s); gsub(nb, " ", s); out = out s }
      exit (out ~ /[^ \t]/)
    }' <<<"$1"
}

# shared_items -> {fact: owner} from $SHARED_ITEMS, as JSON for cmd_due.
shared_items() {
  [ -s "$SHARED_ITEMS" ] || { echo '{}'; return; }
  jq -Rn '[inputs | split("\t") | select(length == 2) | {(.[0]): .[1]}] | add // {}' "$SHARED_ITEMS"
}

# shared_sample: one owner holds each shared red episode (ar-623); who counts as an owner is the
# SHARED row of .local/src/docs/fleet-states.md (ar-2448, ar-2523). An owner that stops being one
# is dropped and the fact matched again; a test with no owner of its own goes to its class's
# (shared_class_owner, ar-5285), and with neither, one is filed for it. Only the board fills
# the queue (QUEUE.md "Admission"), so the add leaves a board row, which owns the test while it is
# open and hands it to the item dispatch makes of it (shared_board_owner). A failed add, or one
# whose slug is taken by an item that does not own the test, files nothing, so the row stays a
# `shared red:` line the pass escalates; a queue that reads empty or a document that cannot be
# read changes nothing.
# SHARED_WORD_JQ: `word`, a name as a regex that matches it whole, not inside a longer name or a dotted path.
SHARED_WORD_JQ='def word: gsub("(?<c>[^A-Za-z0-9_])"; "\\\(.c)") | "(^|[^A-Za-z0-9_.])" + . + "($|[^A-Za-z0-9_])";'
# SHARED_OWNER_JQ: the active items as inputs, $t the test without its parameters, $q main's
# unexpired quarantine entries, $full the test as it failed; each owning item's slug out, then
# row:<row> per quarantine row. A quarantine entry with no parameters covers every case.
SHARED_OWNER_JQ="$SHARED_WORD_JQ"'
  ($t | split(".")) as $p | ($p[-2:] | join(".")) as $cm
  | [$q[] | select(.test == $full or .test == $t) | .row // "" | select(. != "")] as $rows
  | select($t != "")
  | ( inputs | select((.priority // "") != "low")
      | ((.task // "") + " " + (.title // "")) as $text
      | select(($text | test($t | word) or test($cm | word))
          or ((.slug // "" | startswith("nightly-fix-")) and ($p | length) > 1
              and ($text | test($p[-1] | word) and test($p[-2] | word)))
          or (.type == "fix" and (.row // "" | sub("^[^:]*:"; "") | IN($rows[]))))
      | .slug ),
    ($rows | unique[] | "row:" + .)'
# shared_quarantine: main's quarantine entries that have not ended, as one JSON array. A lane
# whose last read failed is skipped: its entries may have left main since.
shared_quarantine() {
  jq -c --arg today "$(date +%F)" '[.repos[]? | select(.error == null) | .report.tests[]?
    | select((.ends // "") >= $today)]' "$FLEET_SHEPHERD_QUARANTINE" 2>/dev/null || echo '[]'
}
# shared_owners <test>: what owns it, from the items in $active and the entries in $quarantine.
shared_owners() {
  jq -rn --arg t "${1%%(*}" --arg full "$1" --argjson q "${quarantine:-[]}" "$SHARED_OWNER_JQ" <<<"$active" 2>/dev/null
}
# One owner per test class (ar-5285): on 2026-11-24 DodgeballCourtPlayTests had an item per red
# method (ucp-3390, ucp-3391), and ShapeCityTiersPlayTests one beside its class's fix item (ucp-3180
# by ucp-3170). A test no item names as Class.Method goes to an owner of its class, and its evidence
# is appended there (shared_fold): the owner a sibling method's episode holds, else a live fix item
# that is not low and whose title names the class, else an open fix row on the board that names it
# and no live item works. An item that only cites the class in its brief, or is no fix, owns nothing.
# SHARED_CLASS_JQ: the active items as inputs, $c the class; each owning item's slug out.
SHARED_CLASS_JQ="$SHARED_WORD_JQ"'
  select($c != "") | inputs | select((.priority // "") != "low" and .type == "fix")
  | select(.title // "" | test($c | word)) | .slug'
# SHARED_CLASS_ROW_JQ: the board as input, $worked the rows live items work, $p the project, $c the
# class; the open agent-lane fix rows (the lane shared_fold edits) that name it and no live item
# works, as board:<project>:<id>.
SHARED_CLASS_ROW_JQ="$SHARED_WORD_JQ"'
  .rows[]? | select(.project == $p and .lane == "agent" and .type == "fix" and (.priority // "") != "low")
  | select((.project + ":" + .id) | IN($worked[]) | not)
  | select(.text // "" | test($c | word)) | "board:" + .project + ":" + .id'
# shared_class <test>: the class a test method is in, parameters off; empty unless the name is
# Namespace.Class.Method, so a class or namespace that failed whole is not read as one.
shared_class() {
  local t="${1%%(*}"
  [[ "$t" == *.*.* ]] || return 0
  t="${t%.*}"; echo "${t##*.}"
}
# shared_class_owners <class>: the live items that own a red in that class (SHARED_CLASS_JQ).
shared_class_owners() {
  jq -rn --arg c "$1" "$SHARED_CLASS_JQ" <<<"$active" 2>/dev/null
}
# shared_sibling_owners <class> [<fact>]: the owners on record for the other live episodes of that
# class, from $rows and $SHARED_ITEMS; a quarantine row owns only its own test.
shared_sibling_owners() {
  local f t o
  [ -n "$1" ] || return 0
  while IFS=$'\t' read -r f t _; do
    [ -n "$f" ] && [ "$f" != "${2:-}" ] && [ "$(shared_class "$t")" = "$1" ] || continue
    o="$(awk -F'\t' -v f="$f" '$1 == f { s = $2 } END { print s }' "$SHARED_ITEMS")"
    case "$o" in '' | row:*) ;; *) printf '%s\t%s\n' "$o" "$t" ;; esac
  done <<<"$rows"
}
# shared_class_owned <owner> <test> <fact>: whether that owner holds the test through its class, the
# predicate shared_class_owner files by and the keep loop keeps by: a live item of the class
# (SHARED_CLASS_JQ), or one that still owns a sibling episode outright.
shared_class_owned() {
  local c o t
  c="$(shared_class "$2")"
  [ -n "$c" ] || return 1
  shared_class_owners "$c" | grep -qxF -- "$1" && return 0
  while IFS=$'\t' read -r o t; do
    [ "$o" = "$1" ] && shared_owners "$t" | grep -qxF -- "$1" && return 0
  done < <(shared_sibling_owners "$c" "$3")
  return 1
}
# shared_class_owner <class>: the one owner a red in that class goes to, or nothing, from $rows,
# $SHARED_ITEMS, $active and $board (shared_board_read, which the caller runs).
shared_class_owner() {
  local c="$1" o
  [ -n "$c" ] || return 0
  o="$(shared_sibling_owners "$c" | awk -F'\t' 'NR==1 { print $1 }')"
  [ -z "$o" ] || { echo "$o"; return; }
  o="$(shared_class_owners "$c" | awk 'NR==1')"
  [ -z "$o" ] || { echo "$o"; return; }
  [ -n "$board" ] || return 0
  jq -r --arg c "$c" --arg p "$FLEET_SHARED_RED_PROJECT" --argjson worked "$(jq -sc '[.[].row // empty]' <<<"$active" 2>/dev/null || echo '[]')" \
    "$SHARED_CLASS_ROW_JQ" <<<"$board" 2>/dev/null | awk 'NR==1'
}
# shared_board_read [--again]: $board from `notes board --json`, read once a sample unless --again
# (a row filed since the read); a board that cannot be read leaves it as it was.
shared_board_read() {
  local b
  [ "${1:-}" = --again ] || [ -z "$board_read" ] || return 0
  board_read=1
  b="$(notes board --json 2>/dev/null)" && [ -n "$b" ] && board="$b"
  return 0
}
# shared_row_profile <project:id>: the notes profile an open row of $board is on, or nothing.
shared_row_profile() {
  jq -r --arg p "${1%%:*}" --arg k "${1#*:}" 'first(.rows[]? | select(.project == $p and .id == $k) | .profile) // empty' <<<"${board:-null}" 2>/dev/null
}
# shared_fold <owner> <class> <reason>: append a red's evidence to the owner of its class. A queued
# item is retasked, so its session is briefed with it and its row says it too; a started item or a
# board-only row gets it as a detail line on its row, the record. Logged either way.
shared_fold() {
  local o="$1" c="$2" reason="$3" line item row="" prof out="" a
  line="Also red on several branches at once, $(date +%F): $reason. fleet-shepherd appended it here, as one owner per test class (ar-5285)."
  case "$o" in
    board:*) row="${o#board:}" ;;
    *) item="$(jq -cn --arg s "$o" 'first(inputs | select(.slug == $s)) // empty' <<<"$active" 2>/dev/null)"
       if [ -z "$item" ]; then
         # filed this sample: the queue read before the add does not have it
         a="$(agent-queue list --json --state active 2>/dev/null)" && [ -n "$a" ] && active="$a"
         item="$(jq -cn --arg s "$o" 'first(inputs | select(.slug == $s)) // empty' <<<"$active" 2>/dev/null)"
       fi
       if [ "$(jq -r '.state // empty' <<<"$item")" = queued ] &&
          out="$(agent-queue retask "$o" "$(jq -r '.task // empty' <<<"$item")"$'\n\n'"$line" 2>&1)"; then
         cmd_log "shared red: $reason; appended to $(shared_owner_name "$o"), which owns a red in $c" >/dev/null
         return 0
       fi
       row="$(jq -r '.row // empty' <<<"$item")" ;;
  esac
  if [ -n "$row" ]; then
    prof="$(shared_row_profile "$row")"
    [ -n "$prof" ] || { shared_board_read --again; prof="$(shared_row_profile "$row")"; }
    if [ -n "$prof" ] && out="$(notes --profile "$prof" ptask "${row%%:*}" --agent edit "${row#*:}" --detail "$line" 2>&1)"; then
      cmd_log "shared red: $reason; appended to $(shared_owner_name "$o")${item:+ on its row ${row#*:}}, which owns a red in $c" >/dev/null
      return 0
    fi
    [ -n "$prof" ] || out="row ${row#*:} is not open on the board"
  fi
  cmd_log "shared red: $reason; owned by $(shared_owner_name "$o") for its class $c, but the evidence could not be appended: ${out:-it has no board row}" >/dev/null
}
# shared_owner_name <owner>: an owner as a reader names it.
shared_owner_name() {
  case "$1" in
    row:*) echo "board row ${1#row:} (quarantined on main)" ;;
    board:*) local r="${1#board:}"; echo "board row ${r#*:} on ${r%%:*}" ;;
    *) echo "queue item $1" ;;
  esac
}
# shared_board_owner <board:project:id>: what a filed board row is now, from $active and $board
# (shared_sample reads the board once): the item dispatch made of the row, else the row while it
# is open, else nothing (closed or dropped). A board that could not be read keeps the row.
shared_board_owner() {
  local r="${1#board:}" item
  item="$(jq -rn --arg r "$r" 'first(inputs | select(.row == $r) | .slug) // empty' <<<"$active")"
  [ -z "$item" ] || { echo "$item"; return; }
  [ -n "$board" ] || { echo "$1"; return; }
  jq -e --arg p "${r%%:*}" --arg k "${r#*:}" 'any(.rows[]?; .project == $p and .id == $k)' <<<"$board" >/dev/null && echo "$1"
}
shared_sample() {
  local fact test reason cm cls active quarantine slug out keep rows now board="" board_read=""
  touch "$SHARED_ITEMS" 2>/dev/null || return 0
  active="$(agent-queue list --json --state active 2>/dev/null)" || return 0
  # One read of the board (every open row, every profile) a sample, only while a row owns a red.
  ! grep -q $'\tboard:' "$SHARED_ITEMS" || { board="$(notes board --json 2>/dev/null)" && board_read=1; } || board=""
  quarantine="$(shared_quarantine)"
  rows="$(jq -r '(.shared // [])[] | select(.escalated | not) | [.fact, .test, .reason] | @tsv' "$STATE_FILE" 2>/dev/null)" || return 0
  # Keep the mappings of the document's live facts whose item still owns the test. A queue that
  # reads empty proves no owner gone, so it keeps every mapping and only files for the rest.
  [ -n "$active" ] && keep="$(while IFS=$'\t' read -r fact test reason; do
      slug="$(awk -F'\t' -v f="$fact" '$1 == f { s = $2 } END { print s }' "$SHARED_ITEMS")"
      [ -n "$fact" ] && [ -n "$slug" ] || continue
      now="$slug"
      case "$slug" in board:*) now="$(shared_board_owner "$slug")" ;; esac
      if [ -n "$now" ] && [ "$now" = "$slug" ] && [ "${slug#board:}" != "$slug" ]; then
        printf '%s\t%s\n' "$fact" "$slug"
      elif [ -n "$now" ] && { shared_owners "$test" | grep -qxF -- "$now" || shared_class_owned "$now" "$test" "$fact"; }; then
        [ "$now" = "$slug" ] || cmd_log "shared red: $test is owned by queue item $now, started from $(shared_owner_name "$slug")" >/dev/null
        printf '%s\t%s\n' "$fact" "$now"
      else
        cmd_log "shared red: $test is no longer owned by $(shared_owner_name "$slug"): it landed, is low, does not name the test, or its quarantine ended" >/dev/null
      fi
    done <<<"$rows")" &&
    { printf '%s' "${keep:+$keep$'\n'}" > "$SHARED_ITEMS.tmp" && mv "$SHARED_ITEMS.tmp" "$SHARED_ITEMS"; }
  while IFS=$'\t' read -r fact test reason; do
    [ -n "$fact" ] || continue
    awk -F'\t' -v f="$fact" '$1 == f { found = 1 } END { exit !found }' "$SHARED_ITEMS" && continue
    cm="${test%%(*}"; cm="$(awk -F. '{ print (NF > 1 ? $(NF - 1) "." : "") $NF }' <<<"$cm")"
    slug="$(shared_owners "$test" | awk 'NR==1')"
    if [ -z "$slug" ]; then
      cls="$(shared_class "$test")"
      [ -z "$cls" ] || shared_board_read  # here, not in the subshell below, so a sample reads it once
      slug="$(shared_class_owner "$cls")"
      if [ -n "$slug" ]; then
        shared_fold "$slug" "$cls" "$reason"
        printf '%s\t%s\n' "$fact" "$slug" >> "$SHARED_ITEMS"
        continue
      fi
      out="$(agent-queue add --priority high --from shepherd --project "$FLEET_SHARED_RED_PROJECT" --tags '#size/s' \
        --slug "shared-red-$cm" --repeat --title "fix(test): $cm red on several branches at once" \
        "$reason. One test red on several branches at once is a shared cause, not any one branch's work, and every branch gates again into it until it is owned. You own it: reproduce $test on a clean origin/main first. If it fails there, land a quarantine line for it in scripts/test/quarantine.txt (an expiry and this item's board row, docs/operations/ci.md rule 5) through a normal gate, then fix the cause and remove the line. If it passes on main, it is the branches' shared base (a pin, an asset): name it on the agent board and close this item." 2>&1)"
      # A queued add prints its slug; a board-only one (agent-queue overflow_row) `held <slug> -> <board>:<id>`,
      # and that row owns the test until dispatch starts it.
      slug="$(sed -n '/^held [^ ]* -> \([^ ]*:[^ ]*\).*/{s//board:\1/p;q;};/^[a-z]* \([^ ]*\) -> .*/{s//\1/p;q;}' <<<"$out")"
      if [ -z "$slug" ]; then
        # taken, slugs being cut to 40 characters: another test's item, or this one's at low
        slug="$(sed -n '/.*already in the queue: /{s///p;q;}' <<<"$out")"
        [ -z "$slug" ] || shared_owners "$test" | grep -qxF -- "$slug" || slug=""
      fi
    fi
    [ -n "$slug" ] || { cmd_log "shared red: could not file an owner for $test: ${out##*: }" >/dev/null; continue; }
    printf '%s\t%s\n' "$fact" "$slug" >> "$SHARED_ITEMS"
    cmd_log "shared red: $reason; owned by $(shared_owner_name "$slug")" >/dev/null
  done <<<"$rows"
}

# log [--heading] <text>: the rundown's only writer of times. A model that types the time
# guesses it: on 2026-10-28 entries stamped 00:55 and 01:00 UTC 10-29 were written at 23:44 UTC.
cmd_log() {
  local heading=0
  [ "${1:-}" = --rundown ] && { shift; log_rundown "$@"; return; }
  [ "${1:-}" = --heading ] && { heading=1; shift; }
  if [ "$*" = - ]; then
    local line
    while IFS= read -r line; do [ -z "$line" ] || cmd_log "$line"; done
    return 0
  fi
  [ -n "$*" ] || die "usage: fleet-shepherd log [--heading] <text>"
  mkdir -p "$LEDGER" || die "cannot create $LEDGER"
  if [ "$heading" = 1 ]; then
    printf '\n## %s %s\n' "$(date -u '+%F %H:%M UTC')" "$*" >> "$LEDGER/log.md"
  else
    printf -- '- %s: %s\n' "$(date -u '+%H:%M UTC %m-%d')" "$*" >> "$LEDGER/log.md"
  fi
}

# log --rundown <title> < body: one record per rundown or chat answer. The body is read
# before anything is written, so an empty one leaves no file and no log line. The human's requests
# go in here, not in the body: the 22:50Z rundown of 2026-11-04 was a narrow answer that left out
# the CI cleanup they had just asked for. They are read before the new file exists, because
# `requests` counts finished ones from the last rundown.
log_rundown() {
  [ -n "$*" ] || die "usage: fleet-shepherd log --rundown <title> < body"
  local body requests stamp name f n=1
  body="$(cat)"
  [ -n "${body//[[:space:]]/}" ] || die "log --rundown: the body comes on stdin and was empty"
  requests="$(fleet-bench requests 2>&1)" || requests="## Your requests

Unreadable, so this record does not say what the human is waiting on: $requests"
  stamp="$(date -u '+%F %H:%M UTC')"
  name="$(printf '%s' "$stamp" | sed -E 's/^([0-9-]+) ([0-9]{2}):([0-9]{2}).*/\1T\2\3Z/')"
  mkdir -p "$LEDGER/rundowns" || die "cannot create $LEDGER/rundowns"
  f="$LEDGER/rundowns/$name.md"
  while [ -e "$f" ]; do n=$((n + 1)); f="$LEDGER/rundowns/$name-$n.md"; done
  printf '# %s\n\n%s\n\n%s\n\n%s\n' "$*" "$stamp" "$requests" "$body" > "$f.tmp" && mv "$f.tmp" "$f" \
    || die "cannot write $f"
  printf -- '- %s: rundown: %s (rundowns/%s)\n' "$(date -u '+%H:%M UTC %m-%d')" "$*" "${f##*/}" >> "$LEDGER/log.md"
  echo "$f"
}

# Nothing to move and nothing working is the settled fleet: page that once, as the skill's
# settled rule does, so a quiet fleet still says it is quiet.
settle() {
  local working
  # The Sessions card's Working part (hub_core::cards::sessions), every host and less the fleet's own
  # sessions such as this one: counted in hub-core, not over the state document here. A figure that
  # cannot be read is not a quiet fleet, so it does not settle.
  # Once settled, a pass only watches for work coming back, so it reads the cached figure (a hub
  # read is about 10s); the page itself waits for a fresh one.
  if [ -e "$LEDGER/.settled" ]; then
    working="$(hub-figure sessions_working 2>/dev/null)" || working=1
    [ "${working:-1}" -gt 0 ] && rm -f "$LEDGER/.settled"
    return 0
  fi
  working="$(hub-figure --fresh sessions_working 2>/dev/null)" || working=1
  [ "${working:-1}" -gt 0 ] && return 0
  : > "$LEDGER/.settled"
  # The count is the Needs you card's Only you part (hub_core::home::ONLY_YOU): Home's rows less
  # what a machine can answer, counted in hub-core, not filtered here. "?" when unread.
  local n
  n="$(hub-figure --fresh needs_only_you)" || n="?"
  agent-notify -p normal -t shepherd -r "file:$LEDGER/log.md" "fleet settled: $n need you; rundown in $LEDGER/log.md" || true
}

# check: the refresh and gate a pass starts with, shared by the runner and a fleet-lead pass.
# Exit 1 is nothing to move. Exit 2 is a document it could not refresh or read, which is not
# a quiet fleet.
cmd_check() {
  require_table
  mkdir -p "$LEDGER" || die "cannot create $LEDGER"
  fleet-sessions --write >/dev/null || { echo "$NAME: fleet-sessions --write failed" >&2; return 2; }
  blocked_sample
  infra_sample
  # Parks act on sessions, so only the runner or the lease holder takes the checkpoint.
  cmd_holds 2>/dev/null && budget_sample
  # So is filing a shared red's owner: one writer of $SHARED_ITEMS.
  cmd_holds 2>/dev/null && shared_sample
  # And so is closing a session (typing its close, or closing its window once it stayed quiet after
  # one): one writer of its claim.
  cmd_holds 2>/dev/null && close_sample
  cmd_holds 2>/dev/null && takeover_sample
  local due due_rc=0
  due="$(cmd_due)" || due_rc=$?
  [ "$due_rc" = 0 ] || [ "$due_rc" = 1 ] || return "$due_rc"
  due="$(receipts <<<"$due")"
  if [ -z "$due" ]; then settle; return 1; fi
  rm -f "$LEDGER/.settled"
  printf '%s\n' "$due"
}

# due_key <line> -> the line's identity across passes: no `unhandled:` lead, no ledger call, the
# target's window index replaced by its pane id (`hub/dotfiles:6 [%37]` -> `hub/%37`; every
# line that names a target carries the tag: nudge, escalate, overdue, limit, pace: parked), minute
# counts as Nm, and an overdue line's basis dropped: its `(project-median(274) x1.06 (n=1019))`
# moves whenever a phase closes, so a skip stored under it stopped matching. A landing line keeps its project
# alone, a critical line its target and PR.
due_key() {
  sed -E 's/^unhandled: //; s/; then: .*$//; s#^(((nudge|escalate) )?[A-Za-z]+: )([^ /]+/)[^ ]+ \[(%[0-9]+)\]#\1\4\5#
          /^pace: parked /s#([^ /,]+/)[^ ,]+ \[(%[0-9]+)\]#\1\2#g
          s/^(landing: [^ ]+) .*/\1/
          s/^(critical: [^ ]+ PR #[0-9]+) .*/\1/
          s/(, expected [0-9]+m) \(([^()]|\([^()]*\))*\)/\1/; s/[0-9]+m/Nm/g' <<<"$1"
}

# receipts: due lines in, out the ones a pass still owes. Every line a pass is given is answered
# by moving it (a mark or escalate, so it is no longer due) or by `fleet-shepherd skip`: a skipped
# line stays out while it is still due, and a line the last pass was given and left as it was
# comes back first, as `unhandled:`. That is the proof the shepherd handled what it saw. Only a
# line handed to a pass ($HANDED) can be owed: a run that starts no pass (no_pass_why) checks with
# FLEET_SHEPHERD_HAND=0, so a line it held back comes to the next pass plain. While the
# last pass is still working it may yet reach a line, so its lines come back plain and nothing is
# counted against it. A line owed FLEET_SHEPHERD_UNHANDLED_MIN after it was handed (not after it was
# first due: the debounce may hold it first) pages the human high, once: on 2026-11-04 the passes
# reported "dispatch NOOP" for 6.5h and nobody was told.
receipts() {
  local line key out="" owed="" owed_keys="" keys="" given="" rows="" now seen owe handed early=""
  touch "$DUE_LAST" "$SKIPPED" "$PAGED" "$HANDED"
  now="$(date +%s)"
  ! last_working || early=1
  expire_skips "$now"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    key="$(due_key "$line")"
    keys+="$key"$'\n'
    cut -f1 "$SKIPPED" | grep -qxF -- "$key" && continue
    given+="$key"$'\n'
    seen="$(awk -F'\t' -v k="$key" '$1 == k { print $3; exit }' "$DUE_LAST")"
    owe=""
    handed="$(awk -F'\t' -v k="$key" '$1 == k { print $2; exit }' "$HANDED")"
    if [ -z "$early" ] && [ -n "$handed" ]; then
      owe=1
      owed+="unhandled: $line"$'\n'
      owed_keys+="$key"$'\n'
      if [ $(( (now - handed) / 60 )) -ge "$(unhandled_min "$line")" ] && ! grep -qxF -- "$key" "$PAGED"; then
        # A session's due line is cmd_due's "<verb> <BUCKET>: <server>/<session>:<window> ...",
        # so its target is where the page points; other lines (pace, infra) point nowhere.
        ref=""
        [[ "$line" =~ ^(nudge|escalate)\ [A-Z]+:\ ([^ /]+/[^ ]+:[0-9]+) ]] && ref="tmux:${BASH_REMATCH[2]}"
        agent-notify -p high -t shepherd ${ref:+-r "$ref"} "unhandled $(( (now - handed) / 60 ))m: ${line%%; then: *}" >/dev/null 2>&1 || true
        printf '%s\n' "$key" >> "$PAGED"
      fi
    else
      out+="$line"$'\n'
    fi
    rows+="$key"$'\t'"$(line_role "$line")"$'\t'"${seen:-$now}"$'\t'"$([ -n "$owe" ] && printf 'unhandled: ')$line"$'\n'
  done
  # a skip lasts while its line is due; once it is not, the next time it is due is a new one
  awk -F'\t' 'NR == FNR { if ($0 != "") k[$0] = 1; next } $1 in k' <(printf '%s' "$keys") "$SKIPPED" > "$SKIPPED.tmp" \
    && mv -f "$SKIPPED.tmp" "$SKIPPED"
  awk 'NR == FNR { if ($0 != "") k[$0] = 1; next } $0 in k' <(printf '%s' "$keys") "$PAGED" > "$PAGED.tmp" \
    && mv -f "$PAGED.tmp" "$PAGED"
  # what is handed stays handed while it is due; a check a pass runs hands it what it sees
  awk -F'\t' 'NR == FNR { if ($0 != "") k[$0] = 1; next } $1 in k' <(printf '%s' "$keys") "$HANDED" > "$HANDED.tmp" \
    && mv -f "$HANDED.tmp" "$HANDED"
  [ "${FLEET_SHEPHERD_HAND:-1}" = 0 ] || hand_keys "$given"
  printf '%s' "$rows" > "$DUE_LAST.tmp" && mv -f "$DUE_LAST.tmp" "$DUE_LAST"   # agent-web's Shepherd tab reads it (hub_core::boards::due); a rename, because skip reads it too
  if [ -n "$owed" ]; then
    # A line the debounce holds is waiting its turn, so that check is not one more in the streak.
    # Each owed line carries its own count, so two passes that each leave a different line are
    # no streak; only the same line left again is (2026-11-11: disjoint lines read as stuck).
    if ! no_pass_why "$owed$out" >/dev/null; then
      touch "$UNHANDLED"
      awk -F'\t' 'FILENAME == ARGV[1] { n[$1] = $2; next } $0 != "" { print $0 "\t" (n[$0] + 1) }' \
        "$UNHANDLED" <(printf '%s' "$owed_keys") > "$UNHANDLED.tmp" && mv -f "$UNHANDLED.tmp" "$UNHANDLED"
    fi
  elif [ -z "$early" ]; then
    rm -f "$UNHANDLED"
  fi
  printf '%s%s' "$owed" "$out" | sed '/^$/d'
}

# cmd_check_routed: cmd_check's lines, each followed by the skill and section that answers it, for a
# pass run by hand (a runner pass has them in its prompt). `run` takes the bare lines from cmd_check.
cmd_check_routed() {
  local out rc=0 l skill section
  require_table
  out="$(cmd_check)" || rc=$?
  while IFS= read -r l; do
    [ -n "$l" ] || continue
    printf '%s\n' "$l"
    IFS=$'\t' read -r skill section < <(line_route "$l")
    printf '  -> %s (~/.claude/skills/%s/SKILL.md), "%s"\n' "$skill" "$skill" "$section"
  done <<< "$out"
  return "$rc"
}

# last_working -> 0 when the pass running now is still at it.
last_working() {
  local id st
  { read -r id _; } 2>/dev/null < "$PASS" || id=""
  [ -n "$id" ] || return 1
  st="$(pass_status "$id")"
  [ "$st" != idle ] && [ "$st" != gone ]
}

# skip_known <key>: 0 when the key is a line due now. Anything else is refused with the nearest due
# lines, because a skip stored under a shortened or reworded line never matches the due line, which
# then comes back as unhandled (2026-11-09: a pass skipped 'overdue: lab/...-agent-58:1' and the
# next check reported agent-58 and agent-59 unhandled). The due lines are the ones the last check
# wrote to $DUE_LAST plus the lines already skipped (a skipped line is left out of .due while it is
# still due): cmd_due rebuilds them all, too slow for an interactive verb, and a pass is only ever
# handed lines a check wrote. A line that came due since is refused here and reaches the next check.
skip_known() {
  local key="$1" k n bestn=-1 near="" cnt=0 pre="" suf="" keys
  [ -n "$key" ] || { echo "fleet-shepherd: not skipped: the line is empty" >&2; return 1; }
  keys="$({ cut -f4- "$DUE_LAST" 2>/dev/null; cut -f1 "$SKIPPED" 2>/dev/null; } | while IFS= read -r k; do [ -z "$k" ] || due_key "$k"; done)"
  # exact, whole-line compare: grep would treat a multi-line key as several patterns
  KEY="$key" awk 'ENVIRON["KEY"] == $0 { f = 1 } END { exit !f }' <<<"$keys" && return 0
  if [ -z "$keys" ]; then
    echo "fleet-shepherd: not skipped: '$key' is not a due line, and the last check found nothing due" >&2
    return 1
  fi
  # an elided line ('lab/...-agent-58:1') matches a due line holding both ends of it
  if [[ "$key" == *...* ]]; then pre="${key%%...*}"; suf="${key#*...}"; fi
  while IFS= read -r k; do
    n=0
    while [ "$n" -lt "${#k}" ] && [ "$n" -lt "${#key}" ] && [ "${k:n:1}" = "${key:n:1}" ]; do n=$((n + 1)); done
    [ -z "$suf" ] || [[ "$k" != "$pre"* || "$k" != *"$suf"* ]] || n=$((n + 1000))
    if [ "$n" -gt "$bestn" ]; then bestn=$n; near="$k"; cnt=1
    elif [ "$n" -eq "$bestn" ] && [ "$cnt" -lt 5 ]; then near+="'; '$k"; cnt=$((cnt + 1)); fi
  done <<<"$keys"
  echo "fleet-shepherd: not skipped: '$key' is not a due line; nearest due: '$near'. Skip a line exactly as check printed it (exit 2, nothing stored)." >&2
  return 1
}

# expire_skips <now>: drop each skip older than FLEET_SHEPHERD_SKIP_MAX_MIN, its key from $PAGED, and from $HANDED,
# so the line comes back plain and is handed afresh; kept in $HANDED it would come back unhandled,
# aged from its first handing, and page the human high at once. The log keeps the old why.
expire_skips() {
  local cut=$(( $1 - FLEET_SHEPHERD_SKIP_MAX_MIN * 60 )) gone k why t
  gone="$(awk -F'\t' -v c="$cut" '$3 != "" && $3 < c' "$SKIPPED")"
  [ -n "$gone" ] || return 0
  awk -F'\t' -v c="$cut" '!($3 != "" && $3 < c)' "$SKIPPED" > "$SKIPPED.tmp" && mv -f "$SKIPPED.tmp" "$SKIPPED"
  awk -F'\t' 'NR == FNR { g[$1] = 1; next } !($1 in g)' <(printf '%s\n' "$gone") "$HANDED" > "$HANDED.tmp" \
    && mv -f "$HANDED.tmp" "$HANDED"
  # and from $PAGED: a line paged before its skip may page again if it is left once more
  awk -F'\t' 'NR == FNR { g[$1] = 1; next } !($0 in g)' <(printf '%s\n' "$gone") "$PAGED" > "$PAGED.tmp" \
    && mv -f "$PAGED.tmp" "$PAGED"
  while IFS=$'\t' read -r k why t; do
    cmd_log "skip expired after $(( ($1 - t) / 3600 ))h: $k (was: $why)"
  done <<<"$gone"
}

# skip <due line> <why>: answer a due line by leaving it, with the reason, until it stops being due
# or FLEET_SHEPHERD_SKIP_MAX_MIN passes (expire_skips), whichever comes first.
# It logs the skip, so a pass whose only answer was a skip did something and is not STALLED.
cmd_skip() {
  [ -n "${1:-}" ] && [ -n "${2:-}" ] || die 'usage: fleet-shepherd skip "<due line>" "<why>"'
  mkdir -p "$LEDGER" || die "cannot create $LEDGER"
  skip_known "$(due_key "$1")" || exit 2
  printf '%s\t%s\t%s\n' "$(due_key "$1")" "${2//[$'\t\n']/ }" "$(date +%s)" >> "$SKIPPED"
  cmd_log "skipped: $(due_key "$1"): ${2//[$'\t\n']/ }"   # a receipt the rundown shows, like a nudge
}

# The routing table: function -> skill -> due-line prefixes -> section, one row per function.
# `.config/fleet-lead/functions.tsv` in the checkout this script lives in (a stow link resolves to it),
# so there is no second copy to drift; a missing table fails loudly.
FUNCTIONS="${FLEET_LEAD_FUNCTIONS:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../.config/fleet-lead/functions.tsv}"

# require_table: exit 2 unless the table is readable and has a default row. Called at the top level of
# every verb that routes, because a die inside a $( ) subshell would only empty the role column.
require_table() {
  [ -r "$FUNCTIONS" ] || die "no routing table at $FUNCTIONS"
  [ -n "$(lead_skill)" ] || die "routing table $FUNCTIONS has no default (*) row"
}

# line_route <due line> -> "<skill>\t<section>" of the first table row with a prefix the line starts
# with (after any `unhandled: `), ending at a word boundary (so `nudge` does not claim `nudged`); a bare *
# prefix is the default row. The line goes in by ENVIRON: awk -v would read backslashes in it.
line_route() {
  [ -r "$FUNCTIONS" ] || die "no routing table at $FUNCTIONS"
  ROUTE_LINE="${1#unhandled: }" awk -F'\t' 'BEGIN { l = ENVIRON["ROUTE_LINE"] } /^#/ || $3 == "" { next }
    { n = split($3, p, "|"); for (i = 1; i <= n; i++) {
        rest = substr(l, length(p[i]) + 1)
        if (p[i] == "*" || (index(l, p[i]) == 1 && rest !~ /^[A-Za-z0-9_-]/)) { print $2 "\t" $4; exit } } }' "$FUNCTIONS"
}

# line_role <due line> -> the skill that answers it; the default row is the lead's own.
line_role() { line_route "$1" | cut -f1; }

# lead_skill -> the skill of the default row: the one running the pass, so it is never loaded as a role.
lead_skill() { awk -F'\t' '!/^#/ && $3 ~ /(^|\|)\*($|\|)/ { print $2; exit }' "$FUNCTIONS"; }

# routes_for <due lines> -> "<skill>\t<section>", once each, for the role skills these lines need.
routes_for() {
  local lead l
  lead="$(lead_skill)"
  while IFS= read -r l; do [ -z "$l" ] || line_route "$l"; done <<< "$1" | awk -F'\t' -v lead="$lead" '$1 != lead && !seen[$0]++'
}

# roles_for <routes_for output> -> the role skills a pass needs, so a headless pass loads only those.
roles_for() {
  local r
  r="$(cut -f1 <<<"$1" | sort -u -r | paste -sd, - | sed 's/,/, /g')"
  printf '%s\n' "${r:-none}"
}

# route_block <routes_for output> -> where to read for each role: the skill's path and the section. A headless
# pass lists no unlisted skill (`paths:`), so the path is what it opens.
route_block() {
  awk -F'\t' '{ printf "  %s: ~/.claude/skills/%s/SKILL.md, \"%s\"\n", $1, $1, $2 }' <<<"$1"
}

# --- the pass: an interactive claude in one tmux pane, a fresh one per run --------------------
# A pass is a fresh `/<skill> pass` session (the conf's SKILL=, fleet-lead) in window $WINDOW of session $SESSION on server
# $SERVER, so the human can attach, watch it work and type to it (`fleet-shepherd open`). The runner
# does not wait for it: the next run scores it and starts the next in the same pane.

# pass_entry <id> -> the registry file of the live claude holding session <id>; exit 1 when none.
pass_entry() {
  local f pid
  for f in "$HOME/.claude/sessions"/*.json; do
    grep -qF "\"$1\"" "$f" 2>/dev/null && [ "$(jq -r '.sessionId // empty' "$f" 2>/dev/null)" = "$1" ] || continue
    pid="$(jq -r '.pid // empty' "$f")"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || continue
    echo "$f"
    return 0
  done
  return 1
}

# pass_status <id> -> the session's claude status (idle, busy, shell, waiting), or gone.
pass_status() {
  local f
  if f="$(pass_entry "$1")"; then jq -r '.status // "idle"' "$f"; else echo gone; fi
}

# pass_place <id> [recorded pane] -> "<pane>\t<session>\t<window index>\t<window name>\t<dead 0|1>"
# on $SERVER; exit 1 when the pass has no pane there. Identity is the pane, never the window name:
# hub resumed a pass on 2026-11-04 in a window named by its session id, and every surface read
# "no pass running". The registry's `tmux` field (<session>:@<window>.%<pane>) follows a resume.
# Its session has to match, because pane ids are per server and it does not name one.
# list-panes, because display-message falls back to another pane when its target is gone.
pass_place() {
  local f at="" panes row
  panes="$(tmux -L "$SERVER" list-panes -a -F "#{pane_id}"$'\t'"#{session_name}"$'\t'"#{window_index}"$'\t'"#{window_name}"$'\t'"#{pane_dead}" 2>/dev/null)"
  f="$(pass_entry "$1")" && at="$(jq -r '.tmux // empty' "$f")"
  if [ -n "$at" ]; then
    row="$(awk -F'\t' -v p="%${at##*%}" -v s="${at%%:*}" '$1 == p && $2 == s' <<<"$panes")"
    [ -z "$row" ] || { echo "$row"; return 0; }
  fi
  [ -n "${2:-}" ] || return 1
  row="$(awk -F'\t' -v p="$2" '$1 == p' <<<"$panes")"
  [ -n "$row" ] && echo "$row"
}

pass_transcript() {
  local f
  for f in "$HOME/.claude/projects"/*/"$1.jsonl"; do [ -e "$f" ] && { echo "$f"; return 0; }; done
  return 0
}

# The jq for a transcript entry's text, and for one of the human's own turns.
JQ_TURNS='def said: (.message.content? // "") | if type == "string" then . else (map(select(.type == "text") | .text) | join("\n")) end;
  def human: .type == "user" and .turnOrigin == "human";'

# talking <id> -> 0 when the human typed into the pass in the last lease window. The pass's own
# prompt is the first human-origin entry, so it never counts; tool results carry no origin.
talking() {
  local at
  at="$(last_human_epoch "$1" 2)" || return 1
  [ $(( $(date +%s) - at )) -lt $(( FLEET_SHEPHERD_LEASE_MIN * 60 )) ]
}

# last_human_epoch <id> <first entry to count> -> the epoch of the human's last turn in the session's
# transcript, exit 1 with none. A pass skips entry 1 (its own prompt); a hand-started session counts it.
last_human_epoch() {
  local tp at
  tp="$(pass_transcript "$1")"
  [ -n "$tp" ] || return 1
  at="$(jq -r "$JQ_TURNS"' select(human) | .timestamp' "$tp" 2>/dev/null | tail -n +"$2" | grep . | tail -n 1)"
  # Checked first: `date -d ""` is midnight today, which read as talking for a lease after it.
  [ -n "$at" ] && date -d "$at" +%s 2>/dev/null
}

# nudge_held_off -> the JSON array of session ids a nudge line waits on (ar-1576, 2026-11-10: three
# passes sent one hand-started session the plan-finished nudge in minutes, the human still in it):
# the human typed into the session in the last FLEET_SHEPHERD_LEASE_MIN, or it was sent any nudge in
# the last FLEET_SHEPHERD_NUDGE_GAP_MIN. Only a row a nudge line could name is read; a remote
# session has no local transcript, so only the gap holds it.
nudge_held_off() {
  local sid at t now held=""
  now="$(date +%s)"
  while read -r sid; do
    [ -n "$sid" ] || continue
    at="$(last_human_epoch "$sid" 1)" && [ $((now - at)) -lt $((FLEET_SHEPHERD_LEASE_MIN * 60)) ] && { held+="$sid"$'\n'; continue; }
    # The newest claim, not the last line: store-sync merges two machines' lines as a union, so order is not time.
    at=0
    while read -r t; do
      t="$(date -d "$t" +%s 2>/dev/null)" && [ "$t" -gt "$at" ] && at="$t"
    done < <([ -r "$LEDGER/nudges.jsonl" ] && jq -R --arg s "$sid" 'fromjson? | select(.kind == "nudge" and .sid == $s) | .at' -r "$LEDGER/nudges.jsonl" 2>/dev/null)
    [ "$at" -gt 0 ] && [ $((now - at)) -lt $((FLEET_SHEPHERD_NUDGE_GAP_MIN * 60)) ] && held+="$sid"$'\n'
  done < <(jq -r --argjson needs_min "$FLEET_SHEPHERD_NEEDS_NUDGE_MIN" "$FIN_JQ$KEPT_JQ$CLOSE_NUDGE_JQ$HELD_JQ$NEEDS_NUDGE_JQ"'(.sessions // [])[]
    | select(kept | not) | select(close_nudge | not)
    | select(needs_nudge or ((finished or (.bucket | IN("STALLED","CHAT"))) and (.nudged | not)
        and (.own_asks // 0) == 0 and (.bucket == "STALLED" or held)))
    | .session_id' "$STATE_FILE" 2>/dev/null)
printf '%s' "$held" | jq -Rsc 'split("\n") | map(select(. != ""))'
}

# conversation <id> <since epoch> -> what the human said to the pass after <since> and what it
# answered, oldest first, the answer being the last thing it wrote before their next turn. It
# starts at the human's first turn: the pass's own prompt, the first human-origin entry, and the
# sweep it runs from it are left out, so a pass nobody talked to has no conversation.
conversation() {
  local tp
  tp="$(pass_transcript "$1")"
  [ -n "$tp" ] || return 0
  jq -rs --argjson since "$2" "$JQ_TURNS"'
    def at: (.timestamp? // "") | sub("\\.[0-9]+Z$"; "Z") | (try fromdate catch 0);
    map(select(human or (.type == "assistant" and (said != "")))) as $all
    | ($all | map(.type) | indices("user")) as $turns
    | if ($turns | length) < 2 then empty else $all[$turns[1]:] end
    | map(select(at > $since) | {type, text: said})
    | reduce .[] as $e ([];
        if $e.type == "user" then . + [{human: $e.text, answer: ""}]
        elif length == 0 then [{human: "", answer: $e.text}]
        else .[-1].answer = $e.text end)
    | .[-40:][]
    | (if .human != "" then "## The human\n\n\(.human)\n" else empty end),
      (if .answer != "" then "## The pass answered\n\n\(.answer)\n" else empty end)' "$tp" 2>/dev/null
}

# score_pass <id> <start> <due count> [why] -> "<verdict>\t<detail>" for the finished pass, by the
# shared verdict over log.md (every move is logged) and its assistant turns (a plan is STALLED).
# A pass given nothing has no move to log: NOOP. A why is a pass that never finished. It is
# recorded in passes.tsv and the pass's files go.
score_pass() {
  local id="$1" start="$2" n="$3" why="${4:-}" verdict detail log tp
  # shellcheck source=/dev/null
  . "$HOME/.local/lib/agent-proof.sh" 2>/dev/null || return 0
  proof_restore "$LEDGER/.proof-$id" || proof_watch "$LEDGER/log.md"
  log="$(mktemp)"
  tp="$(pass_transcript "$id")"
  # The log is the pass's tool calls, each written tool:<name>, then its last text block alone: a
  # report quoting another session ("would you like me to proceed?") is not the pass asking.
  [ -z "$tp" ] || jq -Rrn '[inputs | fromjson? | select(.type == "assistant") | .message.content[]?] as $c
    | ($c[] | select(.name) | "tool:\(.name)"), ([$c[] | .text // empty] | last // empty)' "$tp" > "$log" 2>/dev/null
  if [ -n "$why" ]; then verdict=STALLED
  elif [ "$n" = 0 ]; then verdict=NOOP
  # The plan check is the plan-mode tool call and the pass ending on asking leave, never the
  # shared approval phrases: a pass reports sessions whose plans wait on the human, and "plan
  # awaiting your approval" in its report scored passes 2916535a and 5416cf0e STALLED with every
  # move logged (ar-646). A pass that only planned logs no move, so it is STALLED all the same.
  else verdict="$(AGENT_PROOF_STALL_RE='^tool:ExitPlanMode$|would you like me to proceed' proof_verdict "$log" 0)"
  fi
  rm -f "$log"
  detail="pass ${id:0:8}: $n due, $(( ($(date +%s) - start) / 60 ))m${why:+, $why}"
  printf '%s\t%s\t%s\t%s\t%s\n' "$(date -u -d "@$start" '+%F %H:%M')" "$id" "$verdict" "$detail" "$(lane_cols "$id" "$start" "$tp")" >> "$PASSES"
  pass_cost "$id" "$start" "$tp"
  rm -f "$LEDGER/.proof-$id" "$LEDGER/.handover-$id" "$LEDGER/labels/$id"
  printf '%s\t%s\n' "$verdict" "$detail"
}

# pass_cost <id> <start> [transcript]: the pass's spend as one calls.jsonl line under the runner's
# name, measured by `agent-usage session`. A pass is an interactive session, so agentctl-run never
# recorded it, and until 2026-11-19 the conf's BUDGET_DAY_USD and `agentctl budget` saw $0 of
# about $40 a day. A pass with no measured cost writes no line and says so on stderr, so a dead
# telemetry feed reads as a gap in the journal, never as a quiet day under the cap. The line is under
# $NAME even for a hand run, which budget_check does not hold: the spend is real either way.
pass_cost() {
  local usage end src
  usage="$(timeout "$FLEET_SHEPHERD_USAGE_WAIT" agent-usage session "$1" --json 2>/dev/null)" || usage=""
  if ! jq -e '(.cost_usd // 0) > 0' >/dev/null 2>&1 <<<"$usage"; then
    src="$(jq -r '.usage_source // "none"' 2>/dev/null <<<"$usage")"
    echo "$NAME: pass ${1:0:8} has no measured cost (agent-usage source: ${src:-failed}); calls.jsonl and the day cap miss it" >&2
    return 0
  fi
  end="$(stat -c %Y "${3:-/nonexistent}" 2>/dev/null || date +%s)"
  # shellcheck source=../src/agent-run/lib/calls.sh
  ( . "$AGENT_RUN_LIB/calls.sh" && calls_session "$NAME" "$2" "$(( (end - $2) * 1000 ))" "$usage" ) 2>/dev/null || true
}

# lane_cols <id> <start> [transcript] -> "<model>\t<nudges>\t<survived>\t<missed>\t<wrong>\t<parks>\t<missed kinds>", the
# pass's canary score for passes.tsv, from the lines the machine computed and never from the pass's
# own words, so both models are scored alike. It reads .lane-<id> (its model, then the keys it was
# started with, from hand_due) and SCORE_DUE (this run's check, which cmd_run sets). The keys are a
# snapshot: .handed loses a line once it is not due, which is what a moved nudge does. nudges: the session nudge lines it was handed
# that are gone now; survived: those whose session is due an escalation now (the fact outlived the
# nudge, no progress); missed: the lines it left unhandled; wrong parks: the parks it made (park
# files written while it ran) that this check's pace line calls parked on a clear machine.
lane_cols() {
  local id="$1" start="$2" model end k t nudges=0 survived=0 missed parks=0 wrong=0 now_keys p clear kinds
  model="$(head -n 1 "$LEDGER/.lane-$id" 2>/dev/null)"
  now_keys="$(while IFS= read -r k; do [ -z "$k" ] || due_key "$k"; done <<<"${SCORE_DUE:-}")"
  while IFS= read -r k; do
    [[ "$k" =~ ^nudge\ STALLED:\ ([^ ]+) ]] || continue
    grep -qxF -- "$k" <<<"$now_keys" && continue
    nudges=$((nudges + 1)); t="${BASH_REMATCH[1]}"
    awk -v t="$t" '$1 == "escalate" && $3 == t { f = 1 } END { exit !f }' <<<"$now_keys" &&
      survived=$((survived + 1))
  done < <(tail -n +2 "$LEDGER/.lane-$id" 2>/dev/null)
  rm -f "$LEDGER/.lane-$id"
  missed="$(grep -c '^unhandled: ' <<<"${SCORE_DUE:-}")"
  end="$(stat -c %Y "${3:-/nonexistent}" 2>/dev/null || date +%s)"
  # the targets (<server>/<session>:<window>) the pace line calls parked on a clear machine, and
  # each one's session alone, since a park file is named <session> or <session>:%<pane>, and a window
  # ledger by the window its target recorded
  clear="$(sed -nE 's/^(unhandled: )?pace: parked (.*) while the machine reads CLEAR.*/\2/p' <<<"${SCORE_DUE:-}" |
    tr ',' '\n' | sed -E 's/^ *[^/]*\///; s/ *\[%[0-9]+\]//; s/ *$//' | awk 'NF { print; s = $0; sub(/:.*/, "", s); print s }')"
  for p in "${CLAUDE_ACCT_PARKED_DIR:-$HOME/.agent/parked}"/*; do
    [ -f "$p" ] || continue
    t="$(stat -c %Y "$p")"; [ "$t" -ge "$start" ] && [ "$t" -le "$end" ] || continue
    parks=$((parks + 1))
    [ -z "$clear" ] || ! { grep -qxF -- "${p##*/}" <<<"$clear" ||
      grep -qxF -- "$(sed -n '/^target=[^/]*\//{s///p;q;}' "$p")" <<<"$clear"; } || wrong=$((wrong + 1))
  done
  # the kind of each missed line (watch, overdue, escalate NEEDS, ...), comma-joined, so a week of
  # passes splits missed lines by kind and hour, not only by count
  # One kind per missed line: the due_key prefix, else the line's first word.
  kinds="$(sed -nE 's/^unhandled: (((nudge|escalate) )?[A-Za-z]+( red)?):.*/\1/p; t; s/^unhandled: ([^ :]+).*/\1/p' <<<"${SCORE_DUE:-}" | paste -sd, -)"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s' "${model:--}" "$nudges" "$survived" "${missed:-0}" "$wrong" "$parks" "${kinds:--}"
}

# pass_skill -> the skill a pass runs: the one this runner's conf names, so a rename is one edit there.
pass_skill() {
  local skill
  skill="$(agentctl skill "$NAME" 2>/dev/null)" && [ -n "$skill" ] && { printf '%s\n' "$skill"; return 0; }
  echo "fleet-shepherd: no SKILL= in the $NAME conf (agentctl skill $NAME)" >&2
  return 1
}

# pass_prompt <skill> <due> [handover file]
pass_prompt() {
  local routes roles
  routes="$(routes_for "$2")"
  roles="$(roles_for "$routes")"
  printf '/%s pass\n\nRoles due: %s\n' "$1" "$roles"
  [ "$roles" = none ] || printf 'Read, per role:\n%s\n' "$(route_block "$routes")"
  printf '\nDue this pass (from fleet-shepherd due):\n%s\n' "${2:-nothing}"
  [ -z "${3:-}" ] || printf '\nHandover: %s\n' "$3"
}

# pass_account -> the config dir a pass starts on, empty for the main account: the one claude-acct
# room names. With none it is the best there is, so the pass still runs, and the human hears once,
# at normal: the pass carries on as before. The page is room's own line, which names that account
# and how far past its pace it is; "no account has room" alone read as every account being full.
# room's stdout (the dir) goes out as ours through fd 3, so one call gives both.
pass_account() {
  local why
  if { why="$(claude-acct room 2>&1 >&3 3>&-)"; } 3>&1; then
    rm -f "$NOROOM"
    return 0
  fi
  if [ ! -e "$NOROOM" ]; then
    : > "$NOROOM"
    why="$(tail -n 1 <<<"$why")"; why="${why#claude-acct: }"
    agent-notify -p normal -t "No account has room for new starts" \
      "Passes keep running on the closest account and dispatch starts nothing new.${why:+ ${why^}.}" >/dev/null 2>&1 || true
  fi
  claude-acct pick 2>/dev/null || true
}

# pass_panes -> "<pane>\t<session>\t<window name>\t<1 when a pass, 0 when only marked>" for every
# pane on $SERVER a pass was launched in. launch_pass marks each with the pane option
# @shepherd_pass, which respawn-pane keeps: a pane id reused after a server restart, or a window
# that only carries the name, does not have it. A marked pane is still a pass while its start
# command is the launcher; one respawned into something else is not. Only the launcher's name is
# matched, because tmux re-quotes the command and a ledger path with a space never matched whole.
pass_panes() {
  tmux -L "$SERVER" list-panes -a -F "#{pane_id}"$'\t'"#{session_name}"$'\t'"#{window_name}"$'\t'"#{@shepherd_pass}"$'\t'"#{pane_start_command}" 2>/dev/null |
    awk -F'\t' '$4 != "" { print $1 "\t" $2 "\t" $3 "\t" (index($5, "/.pass.sh") ? 1 : 0) }'
}

# one_pass <pane>: the pane the new pass runs in is the only shepherd on $SERVER. Every other pass
# pane closes (one the runner lost track of, wherever it is); a marked pane now running something
# else loses the mark and keeps running. Another window named $WINDOW in $SESSION, holding no pass,
# takes its command's name, so neither the panel nor the human reads a second shepherd. On
# 2026-11-05 two read as shepherd at once.
one_pass() {
  local p is keep wid name
  while IFS=$'\t' read -r p _ _ is; do
    [ -n "$p" ] && [ "$p" != "$1" ] || continue
    if [ "$is" = 1 ]; then tmux -L "$SERVER" kill-pane -t "$p" 2>/dev/null || true
    else tmux -L "$SERVER" set-option -p -u -t "$p" @shepherd_pass 2>/dev/null || true; fi
  done < <(pass_panes)
  keep="$(tmux -L "$SERVER" display-message -p -t "$1" '#{window_id}' 2>/dev/null)"
  while IFS=$'\t' read -r wid name; do
    [ "$name" = "$WINDOW" ] && [ "$wid" != "$keep" ] || continue
    name="$(tmux -L "$SERVER" display-message -p -t "$wid" '#{pane_current_command}' 2>/dev/null)"
    [ -n "$name" ] && [ "$name" != "$WINDOW" ] || name="$WINDOW-stray"
    tmux -L "$SERVER" rename-window -t "$wid" "$name" 2>/dev/null || true
  done < <(tmux -L "$SERVER" list-windows -t "=$SESSION" -F "#{window_id}"$'\t'"#{window_name}" 2>/dev/null)
}

# pass_model -> the model this pass runs on: the conf's CANARY_MODEL on every CANARY_EVERY-th pass
# (counted by passes.tsv), its MODEL otherwise. The canary lane is scored by lane_cols and compared
# by `fleet-bench canary shepherd`; the conf's MODEL changes only after a week of equal scores.
pass_model() {
  local every="${CANARY_EVERY:-0}"
  if [ -n "${CANARY_MODEL:-}" ] && [[ "$every" =~ ^[1-9][0-9]*$ ]] && [ $(( ($(lines "$PASSES") + 1) % every )) -eq 0 ]; then
    printf '%s' "$CANARY_MODEL"
  else
    printf '%s' "${MODEL:-}"
  fi
}

# lean_flags -> the claude flags that start a pass with only what its roles use (agentctl-run passes
# them through): --tools from the conf's PASS_TOOLS, and every deployed skill and command the routing
# table names no row for listed by name only, so the human talking to a pass can still call one.
# Measured 2026-11-07: a pass listed 112 skills in 21,404 chars and used four, all in the table.
lean_flags() {
  local keep f
  if [ -n "${PASS_TOOLS:-}" ]; then
    if [[ "$PASS_TOOLS" =~ ^[A-Za-z0-9_]+(,[A-Za-z0-9_]+)*$ ]]; then printf ' --tools %q' "$PASS_TOOLS"
    else echo "$NAME: PASS_TOOLS is not a comma list of tool names: $PASS_TOOLS; the pass gets every tool" >&2; fi
  fi
  keep="$(awk -F'\t' '!/^#/ && NF >= 2 { print $2 }' "$FUNCTIONS")"
  f="$({ for f in "$HOME/.claude/skills"/*/SKILL.md; do [ ! -e "$f" ] || { f="${f%/SKILL.md}"; echo "${f##*/}"; }; done
        [ ! -d "$HOME/.claude/commands" ] || (cd "$HOME/.claude/commands" && find -L . -name '*.md' | sed 's|^\./||; s|\.md$||; s|/|:|g')
      } | grep -vxF -f <(printf '%s\n' "$keep") |
      jq -Rnc '[inputs | select(length > 0) | {(.): "name-only"}] | add // {} | if . == {} then empty else {skillOverrides: .} end')"
  [ -z "$f" ] || printf ' --settings %q' "$f"
}

# launch_pass <id> <due> [handover file] [pane]: write the pane's launcher and start it in <pane>,
# the last pass's, with respawn-pane -k, so the new pass takes its place in the same window. With
# no pane, a pass pane already in the pass window (pass_panes) is taken the same way, and only
# with neither does the pass session get a new window. one_pass then closes any other. The
# launcher carries the runner's environment, since a tmux pane gets the server's, not the caller's.
# That includes the conf's caps: agentctl-run checks them again in the pane, and without them it
# holds the pass to lib/budget.sh's defaults, not the caps the shepherd's own check read.
launch_pass() {
  local id="$1" n acct v cmd pane skill model
  skill="$(pass_skill)" || return 1
  n="$(printf '%s\n' "$2" | grep -c .)"
  acct="$(pass_account)"
  model="$(pass_model)"
  {
    echo '#!/usr/bin/env bash'
    echo "# fleet-shepherd pass $id, $(date -u '+%F %H:%M UTC'). The tmux pane runs this."
    # SSH_AUTH_SOCK is the runner's agent: a worker takes only an agent key over BatchMode ssh, and a
    # hub pane holds whatever the last client to attach brought (an ssh attach with no forwarding
    # unset it, so 2026-11-27's passes skipped every razer-laptop nudge as unreachable, ar-5878).
    for v in PATH SSH_AUTH_SOCK AGENTCTL_NAME AGENTCTL_INBOX AGENTCTL_STATE AGENTCTL_STATE_DIR CLAUDE_TELEMETRY_SERVICE \
             HARNESS ROUTE DATA_CLASS FLEET_SHEPHERD_DIR FLEET_STATE_FILE FLEET_SHEPHERD_LEASE_MIN \
             BUDGET_CALL_USD BUDGET_DAY_USD MAX_CALLS_HOUR; do
      [ -z "${!v:-}" ] || printf 'export %s=%q\n' "$v" "${!v}"
    done
    echo 'export FLEET_SHEPHERD_HOLDER=runner'
    # MODEL is this pass's lane (pass_model), not always the conf's
    [ -z "$model" ] || printf 'export MODEL=%q\n' "$model"
    # agentctl-run spends from AGENTCTL_ACCOUNT ("default" is main) and ignores CLAUDE_CONFIG_DIR.
    printf 'export AGENTCTL_ACCOUNT=%q\n' "${acct:-default}"
    # shellcheck disable=SC2016
    echo '. "$HOME/.config/shared-hooks/claude-telemetry.sh" 2>/dev/null || true'
    printf 'exec agentctl-run --role observe --session-id %q%s %q\n' "$id" "$(lean_flags)" "$(pass_prompt "$skill" "$2" "${3:-}")"
  } > "$LEDGER/.pass.sh" || return 1
  printf '%s\n' "${model:--}" > "$LEDGER/.lane-$id"
  # shellcheck source=/dev/null
  . "$HOME/.local/lib/agent-proof.sh" 2>/dev/null && proof_watch "$LEDGER/log.md" && proof_mark "$LEDGER/.proof-$id"
  cmd="bash $(printf '%q' "$LEDGER/.pass.sh")"
  if ! tmux -L "$SERVER" has-session -t "=$SESSION" 2>/dev/null; then
    # The session is made from its world's manifest, as tmx makes every world. With no server,
    # one started from the runner's unit would die with the unit, so it gets a scope. A server keeps
    # its starter's environment and hands it to every session it makes: started from this runner's,
    # every hub session read as the shepherd (AGENTCTL_NAME, PASS_TOOLS; 2026-11-20). So it starts
    # with the user manager's environment, as one started at login does; a value systemd prints
    # escaped ($'...') is left out rather than passed as a literal.
    if tmux -L "$SERVER" list-sessions >/dev/null 2>&1 || ! command -v systemd-run >/dev/null 2>&1; then
      tmx ensure "$SERVER" "$SESSION" >/dev/null 2>&1
    else
      local -a uenv
      mapfile -t uenv < <(systemctl --user show-environment 2>/dev/null | grep -v "^[A-Za-z_0-9]*=\\$'")
      # No user manager to read (boot catch-up without a bus): say so rather than start a server with
      # no HOME or PATH, or fall back to the runner's environment and leak it again.
      printf '%s\n' "${uenv[@]}" | grep -q '^PATH=' \
        || { echo "$NAME: no user manager environment (systemctl --user show-environment); the $SERVER server is not started" >&2; return 1; }
      systemd-run --user --scope --quiet env -i "${uenv[@]}" "$(command -v tmx)" ensure "$SERVER" "$SESSION" >/dev/null 2>&1
    fi
  fi
  pane="${4:-}"
  [ -n "$pane" ] || pane="$(pass_panes | awk -F'\t' -v s="$SESSION" -v w="$WINDOW" '$2 == s && $3 == w && $4 == 1 { print $1; exit }')"
  if [ -n "$pane" ]; then
    tmux -L "$SERVER" respawn-pane -k -t "$pane" -c "$PASS_CWD" "$cmd" || pane=""
  else
    pane="$(tmux -L "$SERVER" new-window -d -P -F '#{pane_id}' -t "=$SESSION:" -n "$WINDOW" -c "$PASS_CWD" "$cmd")" || pane=""
  fi
  [ -n "$pane" ] || { rm -f "$LEDGER/.proof-$id"; return 1; }
  tmux -L "$SERVER" set-option -p -t "$pane" @shepherd_pass 1 2>/dev/null ||
    echo "$NAME: could not mark pane $pane as the pass, so a run that loses .pass cannot find it: $ATTACH" >&2
  printf '%s\t%s\t%s\t%s\n' "$id" "$(date +%s)" "$n" "$pane" > "$PASS"
  # The pass is the shepherd: no pass moves it, and fleet-sessions counts it apart from the agent
  # sessions. fleet-sessions label needs a live session, and this one is still starting, so the
  # labels are written as fleet-sessions keeps them.
  mkdir -p "$LEDGER/labels" && printf 'manual\nshepherd\n' > "$LEDGER/labels/$id"
  # The lease moves to the new pass now, before it runs: from here the last pass is refused.
  write_lease runner "$id"
  one_pass "$pane"
  tag_pane $(( $(date +%s) + FLEET_SHEPHERD_LEASE_MIN * 60 )) "$pane"
  claude-acct trust "$SERVER" "$pane" "bypass permissions on" >/dev/null 2>&1 ||
    echo "$NAME: claude did not show bypass mode; look at the pane: $ATTACH" >&2
}

# sweeping -> "<id>\t<status>\t<minutes>" for the lease holder or the last pass when it is mid-sweep:
# working, nobody talking to it, under PASS_MAX_MIN. A second pass then would act on the same due
# lines. The last pass's age runs from its start, a holder's from its lease.
sweeping() {
  local hid at id start st age now
  now="$(date +%s)"
  { read -r _ at hid _; } 2>/dev/null < "$LEASE" || true
  { read -r id start _; } 2>/dev/null < "$PASS" || true
  [ "${hid:--}" != - ] && [ "$hid" != "${id:-}" ] || hid=""
  for id in ${id:+"$id"} ${hid:+"$hid"}; do
    [ "$id" = "$hid" ] && start="$at"
    st="$(pass_status "$id")"
    [ "$st" != idle ] && [ "$st" != gone ] || continue
    age=$(( (now - ${start:-0}) / 60 ))
    [ "$age" -lt "$FLEET_SHEPHERD_PASS_MAX_MIN" ] || continue
    ! talking "$id" || continue
    printf '%s\t%s\t%s\n' "$id" "$st" "$age"
    return 0
  done
  return 1
}

# with_human -> "<id>\t<status>\t<minutes>" when the human is talking to the pass running now
# and replacing it would cut them off: it is answering, or it is under PASS_MAX_MIN old. An idle
# pass past that is replaced like any other, and what they said goes to the next pass, so a long
# talk does not stop the sweeps (70 minutes with none on 2026-11-04).
with_human() {
  local id start st age
  { read -r id start _; } 2>/dev/null < "$PASS" || return 1
  [ -n "${id:-}" ] && talking "$id" || return 1
  st="$(pass_status "$id")"
  [ "$st" != gone ] || return 1
  age=$(( ($(date +%s) - ${start:-0}) / 60 ))
  [ "$st" != idle ] || [ "$age" -lt "$FLEET_SHEPHERD_PASS_MAX_MIN" ] || return 1
  printf '%s\t%s\t%s\n' "$id" "$st" "$age"
}

# replace_pass <id> <start> <due count> <pane>: score the pass the run replaces (STALLED when it is
# still working: sweeping and with_human already let a young one be) and settle its pane. In the
# pass session, alive or dead, the pane is reused: reuse is set to it. Elsewhere (a pass resumed
# into another session) it closes. A gone pass whose pane runs something else is left alone,
# since that is no longer the pass. Sets reuse, sd, and sv to a verdict that fails the run.
replace_pass() {
  local id="$1" st place p sess dead why="" scored
  st="$(pass_status "$id")"
  [ "$st" = idle ] || [ "$st" = gone ] || why="still $st, replaced"
  if place="$(pass_place "$id" "$4")"; then
    IFS=$'\t' read -r p sess _ _ dead <<<"$place"
    if [ "$st" != gone ] || [ "$dead" = 1 ]; then
      if [ "$sess" = "$SESSION" ]; then reuse="$p"; else tmux -L "$SERVER" kill-pane -t "$p" 2>/dev/null; fi
    fi
  fi
  scored="$(score_pass "$id" "$2" "$3" "$why")"
  [ -n "$scored" ] || return 0
  echo "$NAME: ${scored%%$'\t'*} ${scored#*$'\t'}"
  case "$scored" in FAILED*|STALLED*) sv="${scored%%$'\t'*}" ;; esac
  sd+="${sd:+; }${scored#*$'\t'}"
}

# unhandled_min <line> -> minutes a handed line may go unanswered before it pages.
unhandled_min() {
  if grep -qE -- "$FLEET_SHEPHERD_URGENT_RE" <<<"$1"; then echo "$FLEET_SHEPHERD_UNHANDLED_MIN"
  else echo $(( FLEET_SHEPHERD_UNHANDLED_MIN + FLEET_SHEPHERD_DEBOUNCE_MIN )); fi
}

# stuck_min -> minutes with lines due and no pass before the shepherd reads as stuck.
stuck_min() {
  if cut -f4 "$DUE_LAST" 2>/dev/null | grep -E -- "$FLEET_SHEPHERD_URGENT_RE" >/dev/null; then echo "$FLEET_SHEPHERD_STUCK_MIN"
  else echo $(( FLEET_SHEPHERD_STUCK_MIN + FLEET_SHEPHERD_DEBOUNCE_MIN )); fi
}

# no_pass_why <due> -> why this run starts no pass; exit 1 when it should start one. Nothing due
# starts none; something due starts one once FLEET_SHEPHERD_DEBOUNCE_MIN (less the tick slack) has
# passed since the last pass started, or at once for a line FLEET_SHEPHERD_URGENT_RE matches.
no_pass_why() {
  local start="" age slack
  [ -n "$1" ] || { echo "nothing due"; return 0; }
  grep -qE -- "$FLEET_SHEPHERD_URGENT_RE" <<<"$1" && return 1
  { read -r _ start _; } 2>/dev/null < "$PASS" || true
  [ -n "$start" ] || return 1
  age=$(( ($(date +%s) - start) / 60 ))
  # the slack never exceeds half the debounce, so a short DEBOUNCE_MIN is not disabled by it
  slack=$(( FLEET_SHEPHERD_TICK_SLACK_MIN < FLEET_SHEPHERD_DEBOUNCE_MIN / 2 ? FLEET_SHEPHERD_TICK_SLACK_MIN : FLEET_SHEPHERD_DEBOUNCE_MIN / 2 ))
  [ $(( age + slack )) -lt "$FLEET_SHEPHERD_DEBOUNCE_MIN" ] || return 1
  echo "$(grep -c . <<<"$1") due, none urgent, last pass ${age}m ago"
}

# hand_keys <keys>: record due keys as handed now; a key already handed keeps its first time.
# The one writer of .handed rows (receipts prunes them).
hand_keys() {
  touch "$HANDED"
  { cat "$HANDED"; awk -v t="$(date +%s)" 'NF { print $0 "\t" t }' <<<"$1"; } | awk -F'\t' '!s[$1]++' > "$HANDED.tmp" \
    && mv -f "$HANDED.tmp" "$HANDED"
}

# hand_due <id> <due>: the lines pass <id> was started with are handed to it, so the next check can
# hold the ones it leaves against it, and its lane file keeps them for its score (lane_cols).
hand_due() {
  local l keys
  keys="$(while IFS= read -r l; do [ -z "$l" ] || due_key "$l"; done <<<"$2")"
  hand_keys "$keys"
  [ ! -e "$LEDGER/.lane-$1" ] || printf '%s\n' "$keys" >> "$LEDGER/.lane-$1"
}

# run_locked <run|check>: cmd_run or cmd_check_routed, one at a time. Two runs (the timer and a hand
# run) would each read the same .pass and start a pass, and a check beside a run (a fleet-lead
# pass's check while the runner samples) rewrites the samples' ledgers (.budget,
# $SHARED_ITEMS, the close claims) under it and can park or page twice. flock -o holds the lock in
# flock itself, so nothing the run starts (a tmux server, a page sent in the background) inherits
# it and holds it past the run. A run that loses starts nothing; a check waits CHECK_WAIT for it,
# since its caller wants the due lines, then exits 75. A run that hangs holding it shows as `stuck`
# (no pass started in STUCK_MIN).
run_locked() {
  require_table
  local fn=cmd_run wait=(-n) rc=0
  [ "$1" = run ] || { fn=cmd_check_routed; wait=(-w "$FLEET_SHEPHERD_CHECK_WAIT"); }
  if [ -n "$RUN_LOCKED" ]; then "$fn"; return; fi
  [ "$fn" = cmd_check_routed ] || [ -n "$SERVER" ] || die "no world declares session $SESSION"
  mkdir -p "$LEDGER" || die "cannot create $LEDGER"
  FLEET_SHEPHERD_RUN_LOCKED=1 flock "${wait[@]}" -o -E 75 "$LEDGER/.run.lock" "$0" "$1" || rc=$?
  [ "$rc" = 75 ] || return "$rc"
  if [ "$fn" = cmd_check_routed ]; then
    echo "$NAME: a run held the run lock past ${FLEET_SHEPHERD_CHECK_WAIT}s: no check; run it again once that run ends" >&2
    return 75
  fi
  echo "$NAME: a run or a check holds the run lock now: no second pass"
  publish WORKED "a run or a check held the run lock: no second pass"
}

# close_early: a run that starts no pass because one is mid-sweep or with the human still closes
# what is closable. cmd_check is where close_sample normally runs, and these returns come before
# it, so a pass busy for the whole cadence (a pass takes about as long as a run interval) left a
# DONE, LANDED or stalled-with-nothing-to-land row untyped until a run found the pass idle. The
# document is refreshed first, as cmd_check does, so the verdicts are this run's.
close_early() {
  fleet-sessions --write >/dev/null || { echo "$NAME: fleet-sessions --write failed: no close this run" >&2; return 0; }
  cmd_holds 2>/dev/null && close_sample
  cmd_holds 2>/dev/null && takeover_sample
  return 0
}

cmd_run() {
  [ -n "$SERVER" ] || die "no world declares session $SESSION"
  mkdir -p "$LEDGER" || die "cannot create $LEDGER"
  local id start n pane st busy sv="" sd=""
  # Ghost runs first: deterministic, and owed every run whether or not a pass starts.
  cmd_ghost_runs
  # Never two passes at once: the holder mid-sweep finishes, and the next run looks again.
  if busy="$(sweeping)"; then
    IFS=$'\t' read -r id st n <<<"$busy"
    echo "$NAME: pass ${id:0:8} is mid-sweep ($st, ${n}m) and nobody is talking to it: no new pass"
    close_early
    publish WORKED "pass ${id:0:8} mid-sweep, ${n}m: no new pass"
    return 0
  fi
  if busy="$(with_human)"; then
    IFS=$'\t' read -r id st n <<<"$busy"
    echo "$NAME: the human is talking to pass ${id:0:8} ($st, ${n}m): no new pass"
    close_early
    publish WORKED "pass ${id:0:8} talking to the human, ${n}m: no new pass"
    return 0
  fi
  # A document it could not refresh is the pass's first problem, not a reason to have no pass.
  local due due_rc=0 trouble="" hold
  due="$(FLEET_SHEPHERD_HAND=0 cmd_check)" || due_rc=$?
  SCORE_DUE="$due"
  if [ "$due_rc" -gt 1 ]; then
    trouble="could not refresh or read the state document"
    due="$trouble: fleet-sessions --write, $STATE_FILE"
  fi
  [ -z "$due" ] || printf '%s: due\n%s\n' "$NAME" "$due"
  if [ -z "$trouble" ] && hold="$(no_pass_why "$due")"; then
    echo "$NAME: $hold: no new pass"
    publish WORKED "$hold: no new pass"
    return 0
  fi
  # The conf's day and hour caps (BUDGET_DAY_USD, MAX_CALLS_HOUR) over the passes' cost lines
  # (pass_cost), as agentctl-run checks a print call: over either, no new pass, and budget_stop
  # reports BLOCKED and pages the raise once a day. A hand run (no AGENTCTL_NAME) is not checked,
  # per the repo CLAUDE.md hard limit. The running pass is costed when it is replaced below, so the
  # check lags one pass (under $1): a checkpoint, as the caps are.
  # A subshell, since budget_stop exits 75 (EX_BUDGET), which run_locked reads as a held run lock;
  # any other failure is the check's own fault, said, and the pass still starts.
  local over brc=0
  # shellcheck source=../src/agent-run/lib/budget.sh
  over="$( . "$AGENT_RUN_LIB/budget.sh" && budget_check 2>&1 )" || brc=$?
  if [ "$brc" = 75 ]; then echo "$NAME: no new pass: ${over#agentctl-run: }"; return 0; fi
  [ "$brc" = 0 ] || echo "$NAME: budget check failed (exit $brc): ${over:-no output}; starting the pass anyway" >&2
  local new hand turns reuse="" skill
  # Before the last pass is replaced: a conf naming no skill must not cost the pass that is running.
  skill="$(pass_skill)" || { publish FAILED "no SKILL= in the $NAME conf"; return 1; }
  new="$(cat /proc/sys/kernel/random/uuid)" || return 1
  hand="$LEDGER/.handover-$new"
  # The last pass is replaced in its own pane, and what the human said to it goes to the new one.
  if { read -r id start n pane; } 2>/dev/null < "$PASS" && [ -n "$id" ]; then
    turns="$(conversation "$id" "$start")"
    [ -z "$turns" ] || printf '# Pass %s\n\n%s\n\n' "${id:0:8}" "$turns" > "$hand"
    replace_pass "$id" "$start" "$n" "$pane"
    rm -f "$PASS"
  fi
  if ! launch_pass "$new" "$due" "$([ ! -s "$hand" ] || echo "$hand")" "$reuse"; then
    rm -f "$hand"
    publish FAILED "${sd:+$sd; }could not start a pass in tmux -L $SERVER session $SESSION"
    return 1
  fi
  hand_due "$new" "$due"
  echo "$NAME: started pass ${new:0:8}: $ATTACH"
  local detail
  detail="${sd:+$sd; }started pass ${new:0:8}: $(printf '%s\n' "$due" | grep -c .) due, $ATTACH"
  if [ -n "$trouble" ]; then publish FAILED "$trouble; $detail"; return "$due_rc"; fi
  publish "${sv:-WORKED}" "$detail"
  [ -z "$sv" ]
}

# open: the pane of the pass running now, wherever it is; with none, the pass window, else the
# pass session. It never starts or resumes a session: a key that did made a second shepherd on
# 2026-11-05.
cmd_open() {
  local id="" pane="" place t
  { read -r id _ _ pane; } 2>/dev/null < "$PASS" || true
  if [ -n "$id" ] && place="$(pass_place "$id" "$pane")"; then
    t="$(cut -f2,3 --output-delimiter=: <<<"$place")"
  else
    tmux -L "$SERVER" has-session -t "=$SESSION" 2>/dev/null || die "no pass running (fleet-shepherd passes)"
    t="$SESSION:"
    ! tmux -L "$SERVER" list-windows -t "=$SESSION" -F '#{window_name}' 2>/dev/null | grep -qxF "$WINDOW" ||
      t="$SESSION:$WINDOW"
  fi
  if [ -n "${TMUX:-}" ] && command -v agent-panel >/dev/null 2>&1; then
    agent-panel jump "$SERVER/$t"
  else
    exec tmux -L "$SERVER" attach -t "=$t"
  fi
}

# passes [n]: the pass running now, then the last n scored, newest first.
cmd_passes() {
  local id start n
  if { read -r id start n _; } 2>/dev/null < "$PASS" && [ -n "$id" ]; then
    printf '%s\t%s\tnow\t%s due, %s\n' "$(date -u -d "@$start" '+%F %H:%M')" "$id" "$n" "$(pass_status "$id")"
  elif [ ! -s "$PASSES" ]; then
    echo "no passes yet: the runner starts one when something is due (agentctl status shepherd)"
    return 0
  fi
  tail -n "${1:-20}" "$PASSES" 2>/dev/null | tac
  return 0
}

lines() { local c; c="$(grep -c . "$1" 2>/dev/null)"; echo "${c:-0}"; }

# stats: the numbers, read from the ledgers as they are; writes nothing. A 24h count reads log.md's
# `- HH:MM UTC MM-DD: <verb> ...` receipts, so a pass that moved a line without logging it is not counted.
cmd_stats() {
  local now id="" start="" where="" pane="" place last="" lstart lid lverdict st=""
  now=$(date +%s)
  { read -r id start _ pane; } 2>/dev/null < "$PASS" || true
  last="$(tail -n 1 "$PASSES" 2>/dev/null)"
  IFS=$'\t' read -r lstart lid lverdict _ <<<"$last"
  [ -z "$lstart" ] || lstart="$(date -u -d "$lstart" +%s 2>/dev/null)" || lstart=""
  if [ -n "$id" ]; then
    st="$(pass_status "$id")"
    place="$(pass_place "$id" "$pane")" && where="$(cut -f2,3 --output-delimiter=: <<<"$place")"
  fi
  { [ ! -r "$LEDGER/log.md" ] || awk -v now="$(date -u '+%m-%d %H:%M')" -v cut="$(date -u -d '24 hours ago' '+%m-%d %H:%M')" '
    match($0, /^- [0-9][0-9]:[0-9][0-9] UTC [0-9][0-9]-[0-9][0-9]: /) {
      k = substr($0, 13, 5) " " substr($0, 3, 5)
      if (cut <= now ? (k < cut || k > now) : (k < cut && k > now)) next
      v = $5; sub(/:$/, "", v); print v
    }' "$LEDGER/log.md"; } |
    jq -Rsc --argjson now "$now" --argjson pstart "${start:-null}" --argjson lstart "${lstart:-null}" \
      --arg verdict "$lverdict" --arg lid "$lid" --arg id "$id" --arg st "$st" \
      --arg attach "tmux -L $SERVER attach -t ${where:-$SESSION:$WINDOW}" \
      --argjson due "$(lines "$DUE_LAST")" \
      --argjson unhandled "$(cut -f4 "$DUE_LAST" 2>/dev/null | grep -c '^unhandled: ')" \
      --argjson streak "$(cat "$UNHANDLED" 2>/dev/null | awk -F'\t' '$2 + 0 > m { m = $2 + 0 } END { print m + 0 }')" \
      --argjson skipped "$(lines "$SKIPPED")" \
      --argjson paged "$(lines "$PAGED")" \
      --argjson passes "$(awk -F'\t' -v c="$(date -u -d '24 hours ago' '+%F %H:%M')" '$1 >= c' "$PASSES" 2>/dev/null | grep -c .)" \
      --argjson stuckmin "$(stuck_min)" '
      (split("\n") | map(select(length > 0))) as $v
      | def n(w): $v | map(select(. == w)) | length;
      def nul: if . == "" then null else . end;
      ($pstart // $lstart) as $start
      | (if $start == null then null else $now - $start end) as $age
      | (if $due > 0 and ($age == null or $age > $stuckmin * 60)
           then "\($due) due and no pass started in \(if $age == null then "the ledger" else "\($age / 60 | floor)m" end)"
         elif $streak >= 2 then "an unhandled due line at \($streak) checks in a row"
         else null end) as $stuck
      | {state: $due, due: $due, unhandled: $unhandled, unhandled_checks: $streak, skipped: $skipped, paged: $paged,
         nudges_24h: n("nudged"), escalations_24h: n("escalated"), skips_24h: n("skipped"),
         takeovers_24h: n("takeover"), takeovers_failed_24h: n("takeover-failed"),
         passes_24h: $passes, pass_running: ($id != ""),
         pass_id: ($id | nul), pass_status: ($st | nul),
         pass_age_s: (if $pstart == null then null else $now - $pstart end),
         attach: (if $id == "" then null else $attach end),
         last_pass_epoch: $start, last_pass_age_s: $age,
         last_pass_id: ($lid | nul), last_verdict: ($verdict | nul),
         stuck: ($stuck != null), stuck_why: $stuck}'
}

# stuck: exit 1 naming why when the shepherd has stopped passing, else 0 (stats decides; the
# Sentinel watch shepherd-stuck runs it). The output is what the page carries.
cmd_stuck() {
  local s
  s="$(cmd_stats)" && [ -n "$s" ] || die "could not read the shepherd's ledger at $LEDGER"
  if [ "$(jq -r .stuck <<<"$s")" != true ]; then
    jq -r '"passing: \(.due) due, last pass \(if .last_pass_age_s then "\(.last_pass_age_s / 60 | floor)m ago" else "none on record" end)"' <<<"$s"
    return 0
  fi
  jq -r '"stuck: \(.stuck_why)",
    "last pass: \(.last_pass_id // "none" | .[:8]) \(.last_verdict // "")",
    (if .pass_id then "pass now: \(.pass_id[:8]) \(.pass_status), \(.pass_age_s // 0 | . / 60 | floor)m: \(.attach)" else empty end)' <<<"$s"
  head -n 5 "$DUE_LAST" 2>/dev/null | cut -f4
  return 1
}

# cmd_budget <task text>: its size and budget, for the session page
cmd_budget() {
  [ $# -eq 1 ] || die "usage: fleet-shepherd budget <task text>"
  item_budget "$(jq -n --arg task "$1" '{$task}')"
}

case "${1:-}" in
  run)   run_locked run ;;
  stats) cmd_stats ;;
  budget) shift; cmd_budget "$@" ;;
  stuck) cmd_stuck ;;
  open)  shift; cmd_open "$@" ;;
  passes) shift; cmd_passes "$@" ;;
  check) run_locked check ;;
  route) shift; line_route "${1:-}" ;;
  due)   cmd_due ;;
  infra) cmd_infra ;;
  holds) cmd_holds ;;
  # Only the pass that holds the lease acts (cmd_holds).
  lease) cmd_holds || exit; cmd_lease ;;
  skip)  cmd_holds || exit; shift; cmd_skip "$@" ;;
  log)   cmd_holds || exit; shift; cmd_log "$@" ;;
  sweep-cancel) cmd_holds || exit; shift; cmd_sweep_cancel "$@" ;;
  ghost-runs) cmd_holds || exit; cmd_ghost_runs ;;
  say)   cmd_holds || exit; shift; cmd_say "$@" ;;
  -h|--help|"") sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown verb: $1 (run|open|passes|stats|budget|stuck|check|due|say|skip|infra|lease|holds|log|sweep-cancel|ghost-runs)" ;;
esac
