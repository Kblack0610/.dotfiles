#!/usr/bin/env bash
# project-map-doctor - referential integrity for project-map.json.
#
# The map is the registry: it decides what a project IS. Nothing validated it, and the
# cost was not theoretical. Four projects (notes-cockpit, gsuite-comms, boot-runtime-admin,
# media_player_fleet) existed ONLY as a `<!-- canonical: NAME -->` marker in ~/.notes and
# appeared nowhere in this file. `resolve_project_name` can never return those strings, so
# the marker was not pointing into the runtime namespace - it was MINTING names the
# registry had never heard of, which is how ~/.agent/plans/notes-cockpit came to exist.
#
# Every failure mode here is silent by construction: a name that resolves to nothing does
# not error, it returns zero rows, and zero rows is indistinguishable from "no work". So
# this script exists to turn that silence into an exit code.
#
# SKIP IS NOT PASS. Checks that need the private overlay (lab roots) or a populated
# ~/.agent report SKIP when they cannot look. A doctor that reports green because it was
# blindfolded is the same disease it is meant to catch.
#
# Usage: project-map-doctor [MAP_FILE]
# Exit:  0 = every check passed (skips allowed), 1 = at least one FAIL.

set -uo pipefail

MAP_FILE="${1:-${PROJECT_MAP_FILE:-$HOME/.config/shared-hooks/project-map.json}}"
AGENT_DIR="${AGENT_DIR:-$HOME/.agent}"

fails=0
pass() { printf 'PASS  %s\n' "$*"; }
fail() { printf 'FAIL  %s\n' "$*"; fails=$((fails + 1)); }
skip() { printf 'SKIP  %s\n' "$*"; }
warn() { printf 'WARN  %s\n' "$*"; warns=$((warns + 1)); }
warns=0

command -v jq >/dev/null 2>&1 || { printf 'FAIL  jq is not installed; cannot read the map\n'; exit 1; }
[ -f "$MAP_FILE" ] || { printf 'FAIL  no project map at %s\n' "$MAP_FILE"; exit 1; }

if ! jq -e . "$MAP_FILE" >/dev/null 2>&1; then
  fail "map is not valid JSON: $MAP_FILE"
  exit 1
fi
pass "map is valid JSON ($MAP_FILE)"

# The set of names the registry considers real comes from `project_keys`, the one
# definition (`default` is a tracker fallback, not a project, so every typo'd name does not
# "resolve"). Overridable because the deployed copy is a stow symlink into ~/.dotfiles, so
# a worktree editing the library cannot verify its own change without pointing at it.
PROJECT_NAME_LIB="${PROJECT_NAME_LIB:-$HOME/.config/shared-hooks/project-name.sh}"
if [ ! -r "$PROJECT_NAME_LIB" ]; then
  fail "$PROJECT_NAME_LIB not found; is the dotfiles stow current?"
  exit 1
fi
# shellcheck source=/dev/null
. "$PROJECT_NAME_LIB"
export PROJECT_MAP_FILE="$MAP_FILE"
KNOWN="$(project_keys)"
is_known() { grep -qxF -- "$1" <<<"$KNOWN"; }

# --- 1. every `path` has a `repo` ----------------------------------------------------
# resolve_project_name maps a directory to a project only through a `repo` + `path` pair.
# A `path` with no `repo` is never consulted: sessions there silently file under the repo.
# (Check 3 below covers a `repo` naming no registered project.)
n=0
while IFS= read -r line; do
  [ -n "$line" ] || continue
  name="${line%%	*}"; rest="${line#*	}"; repo="${rest%%	*}"; path="${rest#*	}"
  n=$((n + 1))
  [ -n "$repo" ] || fail "trackers.$name has path \"$path\" but no repo, so no directory resolves to it"
done < <(jq -r '(.trackers // {}) | to_entries[] | select(.value | type == "object") | select(.value.path)
  | "\(.key)\t\(.value.repo // "")\t\(.value.path)"' "$MAP_FILE" 2>/dev/null)
[ "$n" -gt 0 ] && pass "all $n app paths have a repo" || skip "no app paths to check"

# --- 2. every `inherits` names a real tracker ---------------------------------------
n=0
while IFS= read -r line; do
  [ -n "$line" ] || continue
  name="${line%%	*}"; parent="${line#*	}"
  n=$((n + 1))
  jq -e --arg p "$parent" '(.trackers // {}) | has($p)' "$MAP_FILE" >/dev/null 2>&1 \
    || fail "trackers.$name inherits \"$parent\", which is not a tracker"
done < <(jq -r '(.trackers // {}) | to_entries[] | select(.value | type == "object") | select(.value.inherits) | "\(.key)\t\(.value.inherits)"' "$MAP_FILE" 2>/dev/null)
[ "$n" -gt 0 ] && pass "all $n inherits targets exist" || skip "no inherits to check"

# --- 3. every `repo` relation names a registered project ----------------------------
# This is the relation the lab join now rides on: a project with no code declares the repo
# whose runtime state it shares. A dangling one silently reads an empty namespace.
n=0
while IFS= read -r line; do
  [ -n "$line" ] || continue
  name="${line%%	*}"; repo="${line#*	}"
  n=$((n + 1))
  is_known "$repo" || fail "trackers.$name has repo \"$repo\", which names no registered project"
done < <(jq -r '(.trackers // {}) | to_entries[] | select(.value | type == "object") | select(.value.repo != null) | "\(.key)\t\(.value.repo)"' "$MAP_FILE" 2>/dev/null)
[ "$n" -gt 0 ] && pass "all $n repo relations resolve" || skip "no repo relations to check"

# --- 4. aliases point at real projects, and never shadow one ------------------------
n=0
while IFS= read -r line; do
  [ -n "$line" ] || continue
  a="${line%%	*}"; target="${line#*	}"
  n=$((n + 1))
  is_known "$target" || fail "alias \"$a\" points at \"$target\", which is not a registered project"
  # An alias whose own name is a project name is unreachable-or-worse: resolution order
  # decides which wins, and the loser is invisible.
  if jq -e --arg a "$a" '[(.paths // {}) | to_entries[] | .value] | index($a)' "$MAP_FILE" >/dev/null 2>&1; then
    fail "alias \"$a\" collides with a project of the same name"
  fi
done < <(jq -r '(.aliases // {}) | to_entries[] | "\(.key)\t\(.value)"' "$MAP_FILE" 2>/dev/null)
[ "$n" -gt 0 ] && pass "all $n aliases resolve and none shadow a project" || skip "no aliases to check"

# --- 5. every key under ~/.agent is a registered project ---------------------------
# Plans, lessons, sessions, asks, outcomes, dreams and evals are filed per project. A key
# the registry does not know is runtime state no project reads: a lesson no preflight
# injects, a board no daemon polls, a corpus the dream sweeps on its own. A leading `_`
# marks a key that is deliberately no project (_unscoped, _runner, _archive).
if [ -d "$AGENT_DIR" ]; then
  n=0; bad=0
  strays="$(
    for kind in anchors plans lessons sessions asks outcomes dreams evals; do
      for e in "$AGENT_DIR/$kind"/*; do
        [ -e "$e" ] || continue
        name="$(basename "$e")"
        if [ -f "$e" ]; then
          case "$name" in *.md) name="${name%.md}"; name="${name%.decisions}" ;; *) continue ;; esac
        fi
        case "$name" in _* | README) continue ;; esac
        printf '%s\t%s\n' "$name" "$kind"
      done
    done | sort
  )"
  while IFS=$'\t' read -r name kinds; do
    [ -n "$name" ] || continue
    n=$((n + 1))
    if ! is_known "$name"; then
      fail "runtime key \"$name\" ($kinds) under ~/.agent names no registered project: register its repo in paths, or move it under ~/.agent/_archive/"
      bad=$((bad + 1))
    fi
  done < <(awk -F'\t' '{k[$1] = k[$1] (k[$1] ? " " : "") $2} END {for (x in k) print x "\t" k[x]}' <<<"$strays" | sort)
  if [ "$n" -eq 0 ]; then
    skip "no keys under $AGENT_DIR to check"
  elif [ "$bad" -eq 0 ]; then
    pass "all $n runtime keys under ~/.agent are registered projects"
  fi
else
  skip "no $AGENT_DIR; cannot check runtime keys"
fi

# --- 5b. every project has an anchor, inside its budget --------------------------------
# The anchor is what the session preflight injects first. A key with none starts every
# session with no key facts, plans or lessons digest. One past the budget overflows Claude
# Code's ~10 KB hook-output cap with the rest of the preflight, which then reaches the model
# as a 2 KB preview. The budget counts what is injected: anchor-lib.sh swaps the decisions
# log for a pointer line, so it is left out.
ANCHOR_MAX=6144 FACTS_MAX=2048
if [ -d "$AGENT_DIR/anchors" ]; then
  n=0; bad=0
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    n=$((n + 1)); a="$AGENT_DIR/anchors/$name.md"
    if [ ! -f "$a" ]; then
      fail "project \"$name\" has no anchor (regen-anchor.sh $name scaffolds one)"
      bad=$((bad + 1)); continue
    fi
    read -r injected facts < <(LC_ALL=C awk '
      /^## / { sec = substr($0, 4) }
      sec !~ /^Decisions log/ { t += length($0) + 1 }
      sec ~ /^Key URLs/ { f += length($0) + 1 }
      END { print t + 0, f + 0 }' "$a")
    if [ "$injected" -gt "$ANCHOR_MAX" ]; then
      fail "anchor $name injects $injected bytes, over the $ANCHOR_MAX budget (move history to lessons or a dated session note)"
      bad=$((bad + 1))
    elif [ "$facts" -gt "$FACTS_MAX" ]; then
      fail "anchor $name has $facts bytes of key facts, over the $FACTS_MAX budget"
      bad=$((bad + 1))
    fi
  done < <(project_anchor_keys)
  [ "$bad" -eq 0 ] && pass "all $n projects have an anchor inside the budget ($ANCHOR_MAX B injected, $FACTS_MAX B key facts)"
else
  skip "no $AGENT_DIR/anchors; cannot check anchors"
fi

# --- 6. every lab project is registered ---------------------------------------------
# Needs the private overlay. This is the check that would have caught all four minted
# names at the moment they were created.
if [ -r "${LAB_ROOTS_LIB:-$HOME/.config/shared-hooks/lab-roots.sh}" ]; then
  # shellcheck source=/dev/null
  . "${LAB_ROOTS_LIB:-$HOME/.config/shared-hooks/lab-roots.sh}"
fi
if declare -F lab_roots >/dev/null 2>&1; then
  n=0; bad=0; seen_names=""
  while IFS= read -r root; do
    [ -d "$root" ] || continue
    for d in "$root"/*/; do
      [ -d "$d" ] || continue
      name="$(basename "$d")"
      n=$((n + 1))
      seen_names="$seen_names$name
"
      if ! is_known "$name"; then
        fail "lab project \"$name\" names no registered project (it can only mint one)"
        bad=$((bad + 1))
      fi
    done
  done < <(lab_roots)
  if [ "$n" -eq 0 ]; then
    skip "lab roots present but empty"
  elif [ "$bad" -eq 0 ]; then
    pass "all $n lab projects are registered"
  fi
else
  skip "lab-roots.sh unavailable (private overlay); cannot check lab projects"
fi

# --- 6b. no lab project lives in TWO roots -------------------------------------------
# A name is supposed to resolve to exactly one bus root. When it resolves to two, every
# consumer picks whichever one its own lookup order reaches first, and they disagree
# silently. 2026-08-11: an app had a dir in both `lab/projects/current` (a stub with an
# empty wave) and a second root (the live sheet). lab-sync wrote the release feed to the
# stub, `notes ptask` wrote tasks to the real one, `notes board` rendered the project
# twice, and the human spent a week typing next-wave items into the copy nothing read.
#
# Check 6 could not see it: it asks whether each name is REGISTERED, and both copies of a
# duplicate answer yes. This asks the different question - how many roots hold it.
#
# FAIL, not WARN: the two copies drift from the moment the second one exists, and which
# one a given tool believes is not something the human can see from either file.
if [ -n "${seen_names:-}" ]; then
  dups="$(printf '%s' "$seen_names" | sort | uniq -d)"
  if [ -n "$dups" ]; then
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      roots="$(while IFS= read -r root; do
        [ -d "$root/$name" ] && printf '%s ' "$root"
      done < <(lab_roots))"
      fail "lab project \"$name\" lives in more than one root: $roots(delete the stale one)"
    done <<<"$dups"
  else
    pass "no lab project name resolves in two roots"
  fi
fi

# --- 6c. every lab project declares a stage, and a `prod` claim is backed by a tag ----
# The `#prod` / `#alpha` hashtag in a project's HEAD (above its first `##`) is a DECLARED
# fact no tool can derive: a toy app and a load-bearing one both ship real git tags at
# similar version numbers, and only a human knows breaking one is a shrug and the other an
# incident.
#
# It is hand-editable on purpose - it is the thing you change, and it sits with the `#high`
# tags already on every wave row. `<!-- canonical: NAME -->` drifted because NOTHING
# checked it, not because a person could type it, so THIS is the check that makes the tag
# safe to type: closed vocabulary, and the one half that IS derivable -- whether anything
# shipped at all -- verified against git rather than taken on trust.
#
# `prod` with a repo and no tag is a FAIL: the claim is refutable and refuted. `prod` with
# no repo at all is a WARN, because agent-runtime and notes-cockpit are notes-only by
# design and have no product tag to find.
STAGE_VOCAB="draft alpha beta prod"
if declare -F lab_roots >/dev/null 2>&1; then
  # Overridable like PROJECT_NAME_LIB above, for the same worktree reason.
  # shellcheck source=/dev/null
  [ -r "${LAB_FEED_LIB:-$HOME/.local/lib/lab-feed.sh}" ] \
    && . "${LAB_FEED_LIB:-$HOME/.local/lib/lab-feed.sh}"
  n=0; bad=0; stage_warns=0
  while IFS= read -r root; do
    [ -d "$root" ] || continue
    for d in "$root"/*/; do
      [ -f "$d/summary.md" ] || continue
      name="$(basename "$d")"
      n=$((n + 1))
      if declare -F lab_head_tag >/dev/null 2>&1; then
        stage="$(lab_head_tag "$(lab_front_page "$d")" $STAGE_VOCAB)"
      else
        skip "lab-feed.sh unavailable; cannot read \"$name\" stage tag"
        continue
      fi

      if [ -z "$stage" ]; then
        warn "lab project \"$name\" declares no stage (tag its sheet #draft, or: notes projects --stage $name --set draft)"
        stage_warns=$((stage_warns + 1))
        continue
      fi
      # No "invalid value" branch, because there cannot be one: `lab_head_tag` only ever
      # returns a member of the vocabulary, so a mistyped `#prd` is not a bad stage - it is
      # no stage, and the WARN above already says exactly that and names the fix. A tag the
      # vocabulary does not know has to be ignorable, or a `#urgent` in a project's prose
      # would fail this gate.
      [ "$stage" = prod ] || continue

      repo="$(project_repo_path "$name" 2>/dev/null || true)"
      if [ -z "$repo" ]; then
        warn "lab project \"$name\" claims prod but resolves no repo - nothing can verify it"
        stage_warns=$((stage_warns + 1))
      elif [ -z "$(project_release_version "$name" 2>/dev/null || true)" ]; then
        fail "lab project \"$name\" claims prod but $repo has shipped no tag for it"
        bad=$((bad + 1))
      fi
    done
  done < <(lab_roots)
  if [ "$n" -eq 0 ]; then
    skip "lab roots present but empty; no stages to check"
  elif [ "$bad" -eq 0 ] && [ "$stage_warns" -eq 0 ]; then
    pass "all $n lab projects declare a valid stage, and every prod claim ships a tag"
  fi
else
  skip "lab-roots.sh unavailable (private overlay); cannot check project stages"
fi

# --- 7. lab and type: the schema, and lab dirs match the registry both ways ----------
# The registry owns each project's wiring (`lab`, `type`, ...), which a cockpit marker in
# the project's summary.md used to carry. A marker nothing checked drifted; these checks
# are what make the registry copy safe to rely on.
#
# Every `lab` names a real notes profile, every entry with a lab declares a type from the
# closed set, every such entry has its directory under that profile, and every directory
# under a profile's projects says that profile. A dir moved between profiles with the
# registry left behind fails here instead of reading the wrong org's state.
TYPES="game app infra"
profiles=""
command -v notes >/dev/null 2>&1 && profiles="$(notes config --profiles 2>/dev/null || true)"
n=0; bad=0
while IFS=$'\037' read -r name lab type; do
  [ -n "$name" ] || continue
  n=$((n + 1))
  if [ -n "$type" ]; then
    case " $TYPES " in
      *" $type "*) ;;
      *) fail "trackers.$name has type \"$type\" (one of: $TYPES)"; bad=$((bad + 1)) ;;
    esac
  fi
  [ -n "$lab" ] || continue
  if [ -z "$type" ]; then
    fail "trackers.$name has lab \"$lab\" but no type (one of: $TYPES)"
    bad=$((bad + 1))
  fi
  [ -n "$profiles" ] || continue
  if ! printf '%s\n' "$profiles" | grep -qxF -- "$lab"; then
    fail "trackers.$name has lab \"$lab\", which is not a notes profile ($(printf '%s' "$profiles" | tr '\n' ' '))"
    bad=$((bad + 1))
    continue
  fi
  root="$(notes --profile "$lab" path projects 2>/dev/null || true)"
  # A profile whose vault is not on this machine cannot be looked at; that is a skip.
  [ -n "$root" ] && [ -d "$root" ] || continue
  if [ ! -d "$root/$name" ] && [ ! -d "$(dirname "$root")/archived/$name" ]; then
    fail "trackers.$name has lab \"$lab\" but $root has no $name/ (current or archived)"
    bad=$((bad + 1))
  fi
done < <(jq -r '(.trackers // {}) | to_entries[] | select(.value | type == "object")
  | select(.value.lab or .value.type)
  | "\(.key)\u001f\(.value.lab // "")\u001f\(.value.type // "")"' "$MAP_FILE" 2>/dev/null)

if [ -n "$profiles" ]; then
  while IFS= read -r prof; do
    [ -n "$prof" ] || continue
    root="$(notes --profile "$prof" path projects 2>/dev/null || true)"
    [ -n "$root" ] && [ -d "$root" ] || continue
    for d in "$root"/*/; do
      [ -d "$d" ] || continue
      name="$(basename "$d")"
      lab="$(jq -r --arg n "$name" '(.trackers[$n] // {}) | if type == "object" then .lab // "" else "" end' "$MAP_FILE" 2>/dev/null)"
      if [ "$lab" != "$prof" ]; then
        fail "lab project \"$name\" sits under profile $prof but trackers.$name.lab is \"${lab:-unset}\""
        bad=$((bad + 1))
      fi
    done
  done <<<"$profiles"
fi

if [ "$n" -eq 0 ]; then
  skip "no registry entry declares a lab or type"
elif [ -z "$profiles" ]; then
  [ "$bad" -eq 0 ] && pass "all $n lab/type declarations use known types"
  skip "notes CLI unavailable; cannot match lab dirs to the registry"
elif [ "$bad" -eq 0 ]; then
  pass "all $n lab/type declarations are valid, and lab dirs match the registry both ways"
fi

printf '\n'
if [ "$fails" -gt 0 ]; then
  printf '%s check(s) FAILED\n' "$fails"
  exit 1
fi
printf 'all checks passed\n'
exit 0
