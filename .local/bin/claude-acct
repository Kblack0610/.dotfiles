#!/usr/bin/env bash
#
# claude-acct - start each `cl` session on the Claude account whose week is cheapest to spend from
#
# Usage:
#   claude-acct pick [name]   # print the CLAUDE_CONFIG_DIR to use (empty = main account);
#                             # with a name, that account's dir (`cl --acct <name>`)
#   claude-acct run [--acct <name>] [claude args]
#                             # exec claude on the account pick returns: the one launcher for a
#                             # human start (`cl`, `sessions` resume, the fzf picker, the hub)
#   claude-acct scope <command...>
#                             # exec the command in its own systemd user scope, agent-<project>-<item>-<pid>.scope;
#                             # run and every pane launch line (claude-telemetry.sh) start claude through it
#   claude-acct setup-token [--renew] [name]
#                        # walk each account (or the one named): say which email to sign in as, run
#                        # `claude setup-token`, verify the printed token with one tiny call, and store
#                        # it in rbw as claude-oauth-<name>. Never echoes the token. An account that
#                        # already has a token is skipped without --renew
#   claude-acct token [name|dir]     # print that account's token (empty arg = main); exit 1 when it has none
#   claude-acct token push <host...> # copy every token from this rbw to each host (0600, over ssh stdin),
#                        # for a machine with no unlocked rbw; it reads that copy
#   claude-acct token-prefix [dir]   # the launch-line prefix that hands a pane its account's token, or
#                        # nothing; the token is read when the pane's shell runs it, never typed into it
#   claude-acct status [--json]   # every source: window used, window gone, run-out, live sessions,
#                                 # 24h dollars, burn and sustainable points an hour, when it is back
#                                 # on pace, and one fleet line: live, burn against what the windows carry
#   claude-acct textfile [dir]    # write <dir>/claude_acct.prom for node_exporter (default: the collector's dir,
#                                 # on the fleet-lease holder only; fleet-lease renew removes another's copy)
#   claude-acct gateway [--out FILE]
#                        # snapshot the gateway's teams, keys (never a key's secret or hash), the
#                        # sources and the config's aliases and fallbacks into FILE (default
#                        # $CACHE/gateway.json) for the Costs tab's Consumers; a gateway that cannot
#                        # be read keeps the old file and exits 1
#   claude-acct room [--json]
#                        # for automatic starts: the account with room, as pick prints it; --json
#                        # prints every account's verdict (ok, reason, every refusal, why, points
#                        # past the line, capped)
#                        # exit 1 when none has room, 2 when none has room and one cannot be read
#   claude-acct room --source <name> [--model <gateway model>] [--json]
#                        # the verdict of one source (a Claude account or a row of the sources file)
#                        # as one sentence (--json: its row); exit 0 room, 1 refused, 2 unread, 3 no such source;
#                        # --model also asks the gateway whether that model's route is past its deployment budget
#   claude-acct models <source>
#                        # the model ids a litellm-key source's key may call (the gateway's /v1/models), one a line;
#                        # exit 1 when the gateway cannot be read, 3 when the source is none or not a litellm-key row
#   claude-acct check tokens # one line, exit 1 when a token is missing, expired or inside TOKEN_WARN_DAYS (pace.conf), 2 when rbw cannot be read
#   claude-acct check usage  # one line, exit 1 when an account cannot be read live, cache or not (the Sentinel watch probes)
#   claude-acct check pace   # one line, exit 1 when a source is past its pace line or in its reserve (one marked alert=off only when unread)
#   claude-acct check underuse [source...]
#                        # one line, exit 1 when a paced source resets within UNDERUSE_HOURS with
#                        # its use UNDERUSE_GAP_PCT points or more under its week gone (pace.conf)
#   claude-acct cost     # {"<session id>": dollars} over CLAUDE_ACCT_COST_WINDOW (7d), from
#                        # Prometheus; exit 2 when it cannot be read. fleet-shepherd's budgets read it
#   claude-acct link     # share the main ~/.claude setup into every other account dir, and mark
#                        # first-run done in each account (hasCompletedOnboarding)
#   claude-acct plans-store [--init]
#                        # link ~/.claude/plans to ~/.agent/plans/_live, the one plan store, once
#                        # git has brought _live (--init on the first machine creates it); link runs it
#   claude-acct move <target> [--server S] [--to <account>] [--stop-shells] [--dry-run]
#                        # exit that target's claude and resume it on the account pick
#                        # returns (or the one --to names), in the same pane: park, then unpark.
#                        # A claude on the Lazer gateway moves onto that account too; park refuses one
#   claude-acct park <target> [--server S] [--why <reason>] [--for <slug>] [--stop-shells] [--dry-run]
#                        # exit that target's claude so it costs nothing while it waits,
#                        # keeping the pane; the resume goes to ~/.agent/parked/<key>, with
#                        # why=<reason>, the park's owner (default park, which takes only a
#                        # dispatched session; human, the hub's Park of any session; fleet-dispatch's
#                        # preempt writes preempt, fleet-shepherd's budget checkpoint budget) and
#                        # for=<slug>, the queue item the park made room for
#   claude-acct unpark <target>|--all
#                        # resume a parked session in its pane, on the account pick returns now;
#                        # --all leaves preempt parks to fleet-dispatch and budget parks to an
#                        # unpark by name
#                        # <target> is [server/]session[:window] or a pane id (%N). A session
#                        # holds one claude; a window or pane picks one claude in a shared
#                        # session (hub/dotfiles:2). The ledger <key> is the session, or
#                        # session:%pane for a window or pane target (its pane id, which a closed window does not renumber).
#   claude-acct trust <server> <pane> <ready text>
#                        # wait for a claude just started in that pane to show <ready text>
#                        # (its mode footer), answering the folder trust prompt on the way
#
# Accounts: ~/.config/claude-acct/accounts, one `name dir` per line (`-` = default).
# Sources: ~/.config/claude-acct/sources, one `name kind ref [reserve=N] [max_live=N] [rpm=N run_rpm=N] [run_usd=N] [parent=name] [alert=off] [priority=must|low] [host=a,b]`
# per line (host: the row exists only on those hosts, by hostname; CLAUDE_ACCT_HOST overrides it), for every source that is not a Claude account (read by this script only; cl and
# agent-panel read accounts). Kinds: codex (ref: the Codex sessions dir; the plan's rate limits come
# from the newest rollout), agy (ref: an AI Pro quota group's bucket stem; its windows from
# `agy -p /usage`), litellm-key (ref: a key file; its budget from /key/info), litellm-team
# (ref: a key file of a member; the team's budget from /team/info). reserve overrides RESERVE_PCT,
# max_live caps the running queue items on the source; rpm (the provider's request limit) over run_rpm
# (what one run draws) caps them too, the lower of the two winning; run_usd (what one run costs) paces
# a route with a deployment budget to the runs that budget carries a window (route_paced); parent names a pool the source spends inside:
# a source has room only when its parent does. A harness is tied to its source by `source` in
# harnesses.json. Every kind is normalized to the one usage row, so room, status and the textfile
# treat all sources alike. Each source is in exactly one of the two files.
# One account per session via CLAUDE_CONFIG_DIR, signed in by its setup token: a long-lived token in
# rbw (`claude-acct setup-token`) that every launch exports as CLAUDE_CODE_OAUTH_TOKEN. There is no
# /login and no .credentials.json read: nothing here signs an account in any other way.
# Only setup-token writes a credential, and only into rbw. docs/operations/claude-acct-tokens.md.
# Usage comes from the rate-limit headers of one 1-token call on the account's setup token (fetch),
# so each answer is cached for CLAUDE_ACCT_TTL seconds.

set -uo pipefail

# shellcheck source=../lib/chain-event.sh
. "${CHAIN_EVENT_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/chain-event.sh}"
# shellcheck source=../lib/audit.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/audit.sh"
# shellcheck source=../lib/tmux-pane.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/tmux-pane.sh"   # leave_mode
# shellcheck source=../lib/tmux-servers.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/tmux-servers.sh"   # tmux_servers_all
# shellcheck source=../lib/wake-pace.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/wake-pace.sh"   # wake_take: unpark --all is a bulk wake

CONF="${CLAUDE_ACCT_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/claude-acct/accounts}"
SRC_CONF="${CLAUDE_ACCT_SOURCES:-$(dirname "$CONF")/sources}"
# The gateway's url and the harness -> source map (harnesses.json `source`).
HARNESSES="${CLAUDE_ACCT_HARNESSES:-${XDG_CONFIG_HOME:-$HOME/.config}/agentctl/harnesses.json}"
CACHE="${CLAUDE_ACCT_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/claude-acct}"
TTL="${CLAUDE_ACCT_TTL:-300}"
NUM_RE='^[0-9]*\.?[0-9]+$'   # a sources-file number: rpm, run_rpm, run_usd, and a route's max_budget
MAIN_DIR="$HOME/.claude"
USAGE_URL="https://api.anthropic.com/api/oauth/usage"   # refuses a setup token; setup-token records that
MESSAGES_URL="https://api.anthropic.com/v1/messages"
# usage_probe -> fetch's 1-token call, whose answer's headers carry the plan's windows. Its model is
# harnesses.json models.claude.haiku, the one home of the model ids; a file without it is no call.
usage_probe() {
    jq -ce '.models.claude.haiku | strings | {model: ., max_tokens: 1,
        system: "You are Claude Code, Anthropic'"'"'s official CLI for Claude.", messages: [{role: "user", content: "hi"}]}' \
        "$HARNESSES" 2>/dev/null
}
# rbw entry per account: the token is the password, the notes carry email, minted, expires.
TOKEN_ENTRY="claude-oauth-"
# A machine with no unlocked rbw (a fleet worker: headless, rebooted with nobody to unlock it) reads
# a 0600 copy here, written only by `claude-acct token push` from a machine whose rbw is unlocked.
TOKEN_DIR="${CLAUDE_ACCT_TOKEN_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/claude-acct/tokens}"
TOKEN_LEN=108   # sk-ant-oat01- and 95 more; a shorter scrape is a wrapped line, so setup-token asks for a paste

# What every account shares with the main one. Everything else (.credentials.json,
# .claude.json, stats, other runtime dirs) stays per account. sessions/ is the machine's
# live-session registry (<pid>.json, read by agent-panel, ListAgents and the fleet tools),
# so a split copy hides every session on the other account.
SHARED=(settings.json settings.local.json CLAUDE.md PERSONAS.md commands hooks skills
        agents plugins output-styles themes docs mcp-profiles projects plans
        sessions)
# Shared dirs keyed by pid: an account's own copy is merged into main, not parked, since
# its files belong to sessions running right now and pids cannot collide.
MERGE=(sessions)

usage() {
    sed -n '3,/^$/s/^# \{0,1\}//p' "$0"
}

# accounts -> "name US dir" lines (US = \037, never collapsed like a tab), dir empty = default
accounts() {
    [[ -f "$CONF" ]] || return 0
    local name dir
    while read -r name dir; do
        [[ -z "$name" || "$name" == \#* ]] && continue
        [[ "$dir" == "-" ]] && dir=""
        printf '%s\037%s\n' "$name" "${dir/#\~/$HOME}"
    done < "$CONF"
}

# sources_elsewhere -> the name of each row that sources() skips for its host= option
sources_elsewhere() {
    [[ -f "$SRC_CONF" ]] || return 0
    awk -v me="${CLAUDE_ACCT_HOST:-${HOSTNAME%%.*}}" '
        /^[ \t]*#/ || NF < 3 { next }
        { for (i = 4; i <= NF; i++) if ($i ~ /^host=/) { h = "," substr($i, 6) ","; if (index(h, "," me ",") == 0) print $1 } }' "$SRC_CONF"
}

# sources -> "name US kind US ref US reserve US max_live US parent US alert US priority US run_usd US basis" per line of the
# sources file, max_live the computed cap (cap_of) and basis how it was reached. A
# line that cannot be read says so on stderr and is skipped, so a typo never becomes a silent row.
sources() {
    [[ -f "$SRC_CONF" ]] || return 0
    local name kind ref opts opt reserve max_live parent alert priority rpm run_rpm run_usd basis seen=''
    while read -r name kind ref opts; do
        [[ -z "$name" || "$name" == \#* ]] && continue
        if [[ ! "$name" =~ ^[A-Za-z0-9_-]+$ || -z "$kind" || -z "$ref" ]]; then
            echo "claude-acct: $SRC_CONF: skipped '$name $kind $ref': want name kind ref" >&2; continue
        fi
        if accounts | cut -d$'\037' -f1 | grep -qxF -- "$name"; then
            echo "claude-acct: $SRC_CONF: $name is also an account; skipped" >&2; continue
        fi
        if [[ " $seen " == *" $name "* ]]; then
            echo "claude-acct: $SRC_CONF: $name is listed twice; the later line is skipped" >&2; continue
        fi
        seen+=" $name"
        reserve='' max_live='' parent='' alert='' priority='' host='' rpm='' run_rpm='' run_usd=''
        for opt in $opts; do
            case "$opt" in
                host=*) host=${opt#host=} ;;
                reserve=*) reserve=${opt#reserve=} ;;
                max_live=*) max_live=${opt#max_live=} ;;
                rpm=*) rpm=${opt#rpm=} ;;
                run_rpm=*) run_rpm=${opt#run_rpm=} ;;
                run_usd=*) run_usd=${opt#run_usd=} ;;
                parent=*) parent=${opt#parent=} ;;
                alert=on|alert=off) alert=${opt#alert=} ;;
                priority=must|priority=low) priority=${opt#priority=} ;;
                *) echo "claude-acct: $SRC_CONF: $name: unknown option '$opt'" >&2 ;;
            esac
        done
        # a row for another host's source is not this host's, and says nothing here
        [[ -z "$host" || ",$host," == *",${CLAUDE_ACCT_HOST:-${HOSTNAME%%.*}},"* ]] || continue
        [[ -z "$reserve" || "$reserve" =~ ^[0-9]+(\.[0-9]+)?$ ]] || { echo "claude-acct: $SRC_CONF: $name: reserve is not a number" >&2; reserve=''; }
        [[ -z "$max_live" || "$max_live" =~ ^[0-9]+$ ]] || { echo "claude-acct: $SRC_CONF: $name: max_live is not a whole number" >&2; max_live=''; }
        [[ -z "$run_usd" || "$run_usd" =~ $NUM_RE && ! "$run_usd" =~ ^0*\.?0*$ ]] || { echo "claude-acct: $SRC_CONF: $name: run_usd is not a number over 0" >&2; run_usd=''; }
        IFS=$'\t' read -r max_live basis < <(cap_of "$name" "$max_live" "$rpm" "$run_rpm")
        printf '%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n' "$name" "$kind" "${ref/#\~/$HOME}" "$reserve" "$max_live" "$parent" "$alert" "$priority" "$run_usd" "$basis"
    done < "$SRC_CONF"
}

# cap_of <name> <max_live> <rpm> <run_rpm> -> "max_live TAB basis": the source's live cap, the lower of max_live
# and rpm / run_rpm rounded down (1 at least: a run that alone draws past the limit still runs, the provider
# slows it), and the words saying which bound set it; both empty with neither. An rpm without its run_rpm, or
# one that is not a number over 0, is named on stderr and left out.
cap_of() {
    local by_rpm=''
    if [[ -n "$3$4" ]]; then
        if [[ "$3" =~ $NUM_RE && "$4" =~ $NUM_RE ]] && awk -v a="$3" -v b="$4" 'BEGIN { exit !(a > 0 && b > 0) }'; then
            by_rpm=$(runs_in "$3" "$4")
        else
            echo "claude-acct: $SRC_CONF: $1: rpm and run_rpm are both numbers over 0, or neither is set; the rpm cap is left out" >&2
        fi
    fi
    if [[ -n "$by_rpm" ]] && { [[ -z "$2" ]] || (( by_rpm < $2 )); }; then
        printf '%s\t%s rpm over %s a run\n' "$by_rpm" "$3" "$4"
    elif [[ -n "$2" ]]; then printf '%s\tmax_live\n' "$2"
    else printf '\t\n'; fi
}

# runs_in <total> <per run> -> the whole runs the total carries, 1 at least: the rpm cap (cap_of) and a
# priced route's starts a window (route_paced).
runs_in() { awk -v a="$1" -v b="$2" 'BEGIN { n = int(a / b); print (n < 1 ? 1 : n) }'; }

# rows_in -> "name US kind US ref US reserve US max_live US parent US alert US priority US run_usd US basis" for every row usage_json reads:
# the Claude accounts (kind claude, ref their dir), then the sources when USAGE_SOURCES=1
rows_in() {
    local name dir row
    while IFS=$'\037' read -r name dir; do
        usage_wants "$name" || continue
        printf '%s\037claude\037%s\037\037\037\037\037\037\037\n' "$name" "$dir"
    done < <(accounts)
    if [[ "${USAGE_SOURCES:-0}" == 1 ]]; then
        while IFS= read -r row; do
            usage_wants "${row%%$'\037'*}" && printf '%s\n' "$row"
        done < <(sources)
    fi
    return 0
}

# usage_wants <name> -> 0 when USAGE_ONLY (space-separated names) is unset or names it, so a verdict
# for one source reads that source and its parent, not every account's token and every key's gateway.
usage_wants() { [[ -z "${USAGE_ONLY:-}" ]] || [[ " $USAGE_ONLY " == *" $1 "* ]]; }

# fetch <name> -> usage JSON on stdout, in the usage endpoint's shape; exit 0 = fresh data, 1 = unread.
# Read with the account's setup token. The usage endpoint refuses that token (403, the rbw entry's
# usage_endpoint note), but every call on it answers with the plan's windows in its
# anthropic-ratelimit-unified-* headers, so one 1-token call reads them. The call must look like
# Claude Code's own (its system line and user agent): any other is refused 429 with no headers.
# A call refused at the limit still carries them, so only the headers are read.
# No token is no call: acct_token's own line (rbw locked) passes through, so a failed read names its
# fix and is not taken for a refused probe (2026-11-19: `rbw config set` stopped the agent).
fetch() {
    local name="$1" cache="$CACHE/$1.json" token ver tmp hdrs probe
    if [[ -s "$cache" ]] && (( $(date +%s) - $(stat -c %Y "$cache") < TTL )); then
        cat "$cache"
        return 0
    fi
    token=$(acct_token "$name") || return 1
    probe=$(usage_probe) || {
        printf 'claude-acct: %s usage read failed: %s names no models.claude.haiku for the probe\n' "$name" "$HARNESSES" >&2
        return 1
    }
    ver=$(claude --version 2>/dev/null | awk '{print $1}')
    mkdir -p "$CACHE"
    tmp=$(mktemp "$CACHE/.$name.XXXXXX")
    # The header goes in on stdin (-K -): argv is readable by every process on the machine.
    hdrs=$(printf 'header = "Authorization: Bearer %s"\n' "$token" |
        curl -sS -m 10 -K - -D - -o /dev/null "$MESSAGES_URL" \
            -H "anthropic-version: 2023-06-01" -H "anthropic-beta: oauth-2025-04-20" \
            -H "User-Agent: claude-cli/${ver:-2} (external, cli)" -H "x-app: cli" \
            -H "content-type: application/json" -d "$probe" 2>/dev/null)
    if ratelimit_usage <<<"$hdrs" > "$tmp"; then
        mv "$tmp" "$cache"
        cat "$cache"
        return 0
    fi
    rm -f "$tmp"
    # say why, so a refused probe (no headers) and a dead network do not read alike
    printf "claude-acct: %s usage read failed: %s\n" "$name" "$(head -n 1 <<<"$hdrs" | tr -d "\r" | grep . || echo "no answer")" >&2
    return 1
}

# ratelimit_usage < response headers -> {five_hour, seven_day, reached}: each window's utilization
# (a fraction in the header, a percent here) and resets_at (ISO), null when its header is absent;
# reached when the plan refuses calls now. Exits non-zero (jq -e) with no weekly window.
ratelimit_usage() {
    tr -d '\r' | jq -Rnce '
        [inputs | capture("^anthropic-ratelimit-unified-(?<k>[^:]+):\\s*(?<v>.*)$"; "i")
         | {key: (.k | ascii_downcase), value: .v}] | from_entries as $h
        | def win($w): if $h["\($w)-utilization"] == null then null
              else {utilization: ($h["\($w)-utilization"] | tonumber * 1000 | round / 10),
                    resets_at: ($h["\($w)-reset"] | if . == null then null else tonumber | todate end)} end;
        {five_hour: win("5h"), seven_day: win("7d"), reached: ($h.status == "rejected")}
        | select(.seven_day != null)'
}

# --- source readers -------------------------------------------------------------------
# Each kind prints the usage endpoint's shape, `seven_day` being the source's one window and
# `five_hour` its short one, plus window (seconds), paced (false for a dollar budget, which is a
# ceiling and not a weekly allowance), reached, usd_used and usd_max when the kind has them. That is
# the only per-kind code; usage_json treats every row alike. Exit 1 when the source cannot be read.

# read_codex <sessions dir> -> the plan's rate limits from the newest rollout with a windowed record:
# every token_count event carries them as of that call, and Codex has no usage endpoint to ask. Only
# the plan's own limit counts (limit_id "codex", or none in older rollouts); Codex also logs records
# with no window (limit_id "premium"), often last, so each file is read from its end for the newest
# record with a window; a line that does not parse (a rollout mid-write) is skipped. Only rollouts
# written within the week ($WEEK) of now are read, newest first, until one has a window: no window
# outlives a week, so an older reading is unused anyway, and no rollout in the week reads as unused
# (idle). Rollouts in the week that carry neither a reading nor a refusal read as unread.
# A run refused at the usage limit ends with error codex_error_info "usage_limit_exceeded" and logs
# only a windowless record. Every rollout of the week is searched for refusals, since a concurrent
# run can write after one, and the newest is held against the reading by time: when it is newer,
# the window that can reset soonest after it (its logged reset, or the refusal plus the window's
# length when that reset had already passed) reads full and reached until then, and a run after
# that is the probe. With no reading in the week a refusal holds the shortest window Codex logs
# (5h); a refusal with no time reads unread.
# A window is named by its length, never its slot: Plus logs the 5h window as primary and the week
# as secondary, Pro logs the week as primary and no 5h window at all. Up to 6h is the 5h window and
# 10000-10200 minutes the week (rollouts log 10080 and 10081); any other length, or none, makes the
# source unread, so it blocks instead of being paced on a guess.
# A window whose reset has passed reads as unused, with no reset until a rollout says when.
# codex_refusal < rollout paths, one a line -> the epoch of the newest usage_limit_exceeded refusal in
# them, null when none, "undated" when one carries no time. The one reader of a refusal's record.
codex_refusal() {
    { xargs -r -d '\n' grep -h -F '"usage_limit_exceeded"' -- || true; } |
        jq -nR '[inputs | fromjson? | objects
                 | select(((.payload.error? | objects | .codex_error_info) // null) == "usage_limit_exceeded")
                 | .payload.completed_at // (.timestamp // "" | .[:19] + "Z" | fromdateiso8601?) // "undated"]
                | if any(.[]; . == "undated") then "undated" else max end'
}

read_codex() {
    local now="${CLAUDE_ACCT_NOW:-$(date +%s)}" found mt f reading refused
    [[ -d "$1" ]] || { echo "claude-acct: codex: no sessions dir $1" >&2; return 1; }
    found=$(find "$1" -name 'rollout-*.jsonl' -newermt "@$((now - WEEK))" -printf '%T@ %p\n') ||
        { echo "claude-acct: codex: cannot list $1" >&2; return 1; }
    if [[ -z "$found" ]]; then
        echo '{"plan":null,"five_hour":null,"seven_day":{"utilization":0,"resets_at":null},"paced":true,"reached":false}'
        return 0
    fi
    found=$(sort -rn <<< "$found")
    # Newest file first, each from its end, each behind an "@<mtime>" line that dates a record with
    # no timestamp. A torn last line gets its newline first, or tac glues it to the record before.
    # jq stops at the first reading; the writers upstream then die of the closed pipe, not a failure.
    reading=$({ while read -r mt f; do
                    printf '@%s\n' "${mt%.*}"
                    if [[ -n "$(tail -c1 -- "$f")" ]]; then { cat -- "$f"; echo; } | tac; else tac -- "$f"; fi || break
                done <<< "$found" | grep -E '^@|"rate_limits"' || true; } |
        jq -ncR 'def stamp: .[:19] + "Z" | fromdateiso8601?;
            first(foreach inputs as $l (0; if $l | startswith("@") then $l[1:] | tonumber else . end;
                . as $m | $l | select(startswith("@") | not) | fromjson? | objects | (.timestamp // "") as $ts
                | .payload.rate_limits? | objects | select((.limit_id // "codex") == "codex")
                | select(.primary or .secondary) | {r: ., at: (($ts | stamp) // $m)})) // null') || return 1
    refused=$(cut -d' ' -f2- <<< "$found" | codex_refusal) || return 1
    [[ "$refused" == '"undated"' ]] && { echo "claude-acct: codex: a refusal with no time under $1" >&2; return 1; }
    jq -cn --argjson now "$now" --argjson read "$reading" --argjson refused "$refused" --arg dir "$1" '
        def win(w): if w == null then null
            elif (w.resets_at // 0) <= $now then {utilization: 0, resets_at: null}
            else {utilization: w.used_percent, resets_at: (w.resets_at | todate)} end;
        def name(w): w.window_minutes as $m
            | if $m == null then null elif $m <= 360 then "five_hour"
              elif $m >= 10000 and $m <= 10200 then "seven_day" else null end;
        def named(ws; n): ws | map(select(name(.) == n)) | max_by(.used_percent);
        def fail(m): "claude-acct: codex: \(m)\n" | halt_error(1);
        ($read.r // null) as $r
        # the refusal that came after the reading, if one did
        | (if $refused != null and ($read == null or $refused > $read.at) then $refused else null end) as $t
        # when a window can next reset after the refusal at $t
        | def after: if (.resets_at // 0) > $t then .resets_at else $t + .window_minutes * 60 end;
        if $r == null then
            if $t == null then fail("no reading or refusal in the rollouts of the last week under \($dir)")
            elif $t + 300 * 60 > $now then {plan: null, five_hour: null, seven_day: null, paced: true, reached: true}
            else {plan: null, five_hour: null, seven_day: {utilization: 0, resets_at: null}, paced: true, reached: false} end
        else [$r.primary, $r.secondary] | map(select(. != null)) as $ws
        | if any($ws[]; name(.) == null) then
            fail("a window of unknown length \([$ws[].window_minutes] | tojson) minutes in a rollout under \($dir)")
          else (if $t == null then null else $ws | map(after) | min end) as $hold
            | (if $hold == null then $ws
               else $ws | map(if after == $hold then .used_percent = 100 | .resets_at = $hold else . end) end) as $held
            | {plan: $r.plan_type, five_hour: win(named($held; "five_hour")),
               seven_day: win(named($held; "seven_day")), paced: true,
               reached: (($r.rate_limit_reached_type != null
                          and ($ws | map(.resets_at | select(. != null)) | min // 0) > $now)
                         or ($hold != null and $hold > $now))}
          end
        end'
}

# read_agy <bucket stem> -> one AI Pro quota group from `agy -p /usage` (a slash command: no model
# call, no quota). It lists groups of buckets, each with an id, a window (weekly or 5h), the
# remaining_fraction and its reset_time; the source's buckets are those whose id is <stem>-<window>
# (gemini: gemini-weekly and gemini-5h). A logged-out agy waits for a login instead of failing, so the
# call is bounded (CLAUDE_ACCT_AGY_TIMEOUT, 30 s: it answers in about 4), and a failed read is
# remembered for TTL ($CACHE/agy-<stem>.failed), so a logged-out agy costs one wait per TTL, not one
# per status call. No weekly bucket of the stem, a window of another name, a bucket with no number
# left, or an answer that is not SUCCESS makes the source unread, so it blocks rather than being
# paced on a guess. A bucket at 0 remaining reads reached.
read_agy() {
    local out rc=0 failed="$CACHE/agy-$1.failed"
    if [[ -f "$failed" ]] && (( $(date +%s) - $(stat -c %Y "$failed") < TTL )); then
        echo "claude-acct: agy: $(cat "$failed") (read $(( $(date +%s) - $(stat -c %Y "$failed") )) s ago; retried after ${TTL} s)" >&2
        return 1
    fi
    mkdir -p "$CACHE" || return 1
    out=$(cd "$CACHE" &&
        timeout -k 5 "${CLAUDE_ACCT_AGY_TIMEOUT:-30}" "${CLAUDE_ACCT_AGY:-agy}" --output-format json -p /usage </dev/null 2>/dev/null) || rc=$?
    if (( rc != 0 )); then
        printf '/usage failed or timed out (exit %s): not logged in, or not installed' "$rc" > "$failed"
    elif ! out=$(jq -cn --argjson u "$out" --arg stem "$1" '
        def fail(m): "\(m)" | halt_error(1);
        def win: {utilization: ((1 - .remaining_fraction) * 1000 | round / 10), resets_at: .reset_time};
        if $u.status != "SUCCESS" then fail("/usage answered \($u.status // "nothing"): \($u.error // "")") else . end
        | [$u.command.data.groups[]?.buckets[]? | select(.window as $w | .id == "\($stem)-\($w)")] as $b
        | if all($b[]; .window != "weekly") then fail("no bucket \($stem)-weekly in /usage")
          elif any($b[]; .window != "weekly" and .window != "5h") then fail("a window of unknown name \([$b[].window] | tojson) in \($stem)")
          elif any($b[]; .remaining_fraction | type != "number") then fail("a bucket of \($stem) with no remaining_fraction")
          else {plan: null, five_hour: ($b | map(select(.window == "5h")) | first | if . == null then null else win end),
                seven_day: ($b | map(select(.window == "weekly")) | first | win),
                paced: true, reached: any($b[]; .remaining_fraction <= 0)} end' 2>"$failed"); then
        [[ -s "$failed" ]] || echo "/usage answered no JSON" > "$failed"
    else
        rm -f "$failed"; printf '%s\n' "$out"; return 0
    fi
    echo "claude-acct: agy: $(cat "$failed")" >&2
    return 1
}

# gateway_curl <key file> <path> [curl args] -> the gateway's answer to that key. The key goes in on
# stdin, off the process list.
gateway_curl() {
    local url key file=$1 path=$2
    shift 2
    url=$(jq -er '.gateway.url' "$HARNESSES" 2>/dev/null) && key=$(cat "$file" 2>/dev/null) || return 1
    curl -sS -m 10 -K - "$@" "$url$path" <<< "header = \"Authorization: Bearer $key\"" 2>/dev/null
}

# gateway_get <key file> <path> -> the gateway's JSON for that key.
gateway_get() { gateway_curl "$1" "$2" -f; }

# gateway_refused <key file> <model> <team|key> -> the spend the gateway refuses this key at for that
# budget, nothing while it admits it. The gateway enforces a counter it publishes nowhere: on
# 2026-11-08 it refused at $380 with /team/info at $204, so a refusal is its only reader, and
# count_tokens passes the same check and bills nothing. The model is one the key may call, or the
# refusal would be about the model.
gateway_refused() {
    local body re='Budget has been exceeded! '
    [[ -n "$2" ]] || { echo "claude-acct: ${1##*/}: no model to run the budget probe with; the spend is the recorded one" >&2; return 0; }
    [[ "$3" == team ]] && re+='Team=[^ ]+ '
    re+='Current cost: ([0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?),'
    body=$(gateway_curl "$1" /v1/messages/count_tokens -X POST -H 'content-type: application/json' \
        -d "$(jq -nc --arg m "$2" '{model: $m, messages: [{role: "user", content: "x"}]}')")
    if [[ "$body" =~ $re ]]; then
        printf '%s' "${BASH_REMATCH[1]}"
    elif [[ "$body" != *'Budget has been exceeded'* && ( -z "$body" || "$body" == *'"error"'* ) ]]; then
        echo "claude-acct: ${1##*/}: the budget probe could not tell; the spend is the recorded one" >&2
    fi
}

# route_refused <key file> <model> -> why the gateway refuses that model's route now, nothing while it
# admits it or cannot say. A deployment budget (litellm_params max_budget per budget_duration, which
# /v1/model/info shows the key) is the router's, not the key's: /key/info never carries it and
# count_tokens skips the router, so a run past it retried "No deployments available - crossed budget"
# while room said ok (ar-165, 2026-11-18: go (glm-5.3) at $3.05 of $2.85 per 5h, its key at $13.85 of
# $68.80). Only a route with a budget_duration, or one the gateway sheds now (route_shed), is probed,
# with one completion capped at 1 token: the router refuses it before any call when the window is spent,
# the upstream answers 429 while it rate-limits the route, and it bills a few tokens when neither.
# The verdict is cached for TTL like a source's reading, so a pass's retries send one probe.
route_refused() {
    local info='' body cache="$CACHE/route-${2//[^A-Za-z0-9._-]/_}.txt" why='' re='crossed budget.*: ([0-9]+(\.[0-9]+)?) >= ([0-9]+[smhdw])'
    if [[ -f "$cache" ]] && (( $(date +%s) - $(stat -c %Y "$cache") < TTL )); then cat "$cache"; return 0; fi
    # A route with no budget that is not shed is cached as room too, so a pass asks Prometheus once a TTL.
    if ! info=$(route_info "$1" "$2"); then
        info=''
        route_shed "$1" "$2" || { mkdir -p "$CACHE" && : > "$cache"; return 0; }
    fi
    body=$(gateway_curl "$1" /v1/chat/completions -m 30 -X POST -H 'content-type: application/json' \
        -d "$(jq -nc --arg m "$2" '{model: $m, max_tokens: 1, messages: [{role: "user", content: "x"}]}')")
    if [[ "$body" =~ $re ]]; then
        why=$(printf 'the gateway refuses %s: its deployment budget of $%s per %s is spent ($%.2f)' "$2" \
            "$(jq -r '.max_budget // "?"' <<< "${info:-null}")" "${BASH_REMATCH[3]}" "${BASH_REMATCH[1]}")
    elif [[ "$body" == *'crossed budget'* ]]; then
        why="the gateway refuses $2: its deployment budget is spent"
    # Only on a shed route: on a budgeted one a 429 that Prometheus does not show may be a passing one.
    elif [[ -z "$info" && "$body" == *RateLimitError* ]]; then
        why="the upstream refuses $2: it answers 429, a rate limit or a spent quota"
    elif [[ -z "$body" || "$body" != *'"choices"'* ]]; then
        echo "claude-acct: ${1##*/}: the route probe for $2 could not tell; its deployment budget is not read" >&2
        return 0
    fi
    mkdir -p "$CACHE" && printf '%s' "$why" > "$cache"
    printf '%s' "$why"
}

# route_entry <key file> <model> -> the route's /v1/model/info entry as {params: its litellm_params, id:
# its model_info.id}, rc 1 when the gateway lists no such route or does not answer. Cached for TTL, since
# route_refused and route_paced both ask it on one start.
route_entry() {
    local cache="$CACHE/route-entry-${2//[^A-Za-z0-9._-]/_}.json" info
    if [[ -s "$cache" ]] && (( $(date +%s) - $(stat -c %Y "$cache") < TTL )); then cat "$cache"; return 0; fi
    info=$(gateway_get "$1" /v1/model/info | jq -ce --arg m "$2" '[.data[]? | select(.model_name == $m)
        | {params: (.litellm_params // {}), id: (.model_info.id // null)}] | first // empty') || return 1
    mkdir -p "$CACHE" && printf '%s\n' "$info" > "$cache"
    printf '%s\n' "$info"
}

# route_info <key file> <model> -> the route's litellm_params when it has a deployment budget (a
# budget_duration), rc 1 when it has none or the gateway does not answer.
route_info() { route_entry "$1" "$2" | jq -ce '.params | select(.budget_duration != null)'; }

# route_shed <key file> <model> -> rc 0 when the gateway sheds the route now: Prometheus reads its
# deployment (model_info.id) at litellm_deployment_state above 0, the reading LiteLLMUpstreamUnhealthy
# fires on; rc 1 while it reads 0 or cannot be read. A free route has no budget for route_refused to
# probe, so dispatch started runs into beam-free on 11-20 and 11-21 while OpenCode answered 429 past its
# daily quota (ar-4229). A route that serves costs no probe; a shed one is probed, and the probe's first
# 200 once the upstream recovers puts the deployment back at state 0.
route_shed() {
    local id out
    id=$(route_entry "$1" "$2" | jq -re '.id // empty') && [[ "$id" =~ ^[A-Za-z0-9._-]+$ ]] || return 1
    out=$(prom_q "max(litellm_deployment_state{model_id=\"$id\"}) > 0") ||
        { echo "claude-acct: ${1##*/}: Prometheus is unreadable, so whether the gateway sheds $2 is not read" >&2; return 1; }
    jq -e '.data.result | length > 0' <<< "$out" >/dev/null 2>&1
}

# route_paced <key file> <model> <source> <run_usd> -> why the route takes no more starts this window,
# nothing while it does: its deployment budget (max_budget per budget_duration, route_info) over what
# one run costs (the source's run_usd) is the runs a window carries, 1 at least, and that many runs on
# the route started inside the last budget_duration (any state: a run that ended still spent the window).
# A run is on the route when its harness spends <source> and maps its model to <model> (harnesses.json
# models, an opencode id less its provider). The 11-19 go canary lane started 8 runs into one $2.85
# window, each refused at its first message (ar-3902): this paces every start on the source, canaries too.
route_paced() {
    local info max dur secs cap n now day
    info=$(route_info "$1" "$2") || return 0
    IFS=$'\t' read -r max dur < <(jq -r '[.max_budget // "", .budget_duration // ""] | @tsv' <<< "$info")
    [[ "$max" =~ $NUM_RE && "$dur" =~ ^([0-9]+)([smhdw])$ ]] || return 0
    local -A unit=([s]=1 [m]=60 [h]=3600 [d]=86400 [w]=604800)
    secs=$(( BASH_REMATCH[1] * unit[${BASH_REMATCH[2]}] ))
    cap=$(runs_in "$max" "$4")
    now="${CLAUDE_ACCT_NOW:-$(date +%s)}"; day=$(date -d "@$((now - secs))" +%F)
    n=$(agent-queue list --json --state all --since "$day" 2>/dev/null | jq -s --slurpfile H "$HARNESSES" --arg s "$3" --arg m "$2" --argjson cut $((now - secs)) '
        [.[] | select(.started != null and ((.started | sub("\\.[0-9]+"; "") | fromdateiso8601? // 0) >= $cut))
         | ($H[0].harnesses[.agent // ""] // {}) as $h | select($h.source == $s)
         | (($h.models // {})[.model // ""] // "") | if $h.launcher == "opencode" then sub("^[^/]*/"; "") else . end
         | select(. == $m)] | length' 2>/dev/null) || return 0
    [[ "$n" =~ ^[0-9]+$ ]] && (( n >= cap )) || return 0
    printf '%s runs started on %s in the last %s, all its $%s a window carries at $%s a run' "$n" "$2" "$dur" "$max" "$4"
}

# budget_usage [refused spend] -> a LiteLLM budget object (spend, max_budget, budget_reset_at) in the
# usage shape: percent of the budget spent, the reset, no pace line. A refused spend replaces the
# recorded one, being the number the gateway acts on.
budget_usage() {
    jq -ce --argjson refused "${1:-null}" '.spend = ($refused // .spend) | {seven_day: {utilization: (if (.max_budget // 0) > 0 then .spend / .max_budget * 100 else 0 end),
                         resets_at: (.budget_reset_at // null)},
             five_hour: null, paced: false, usd_used: .spend, usd_max: .max_budget}'
}

# codex_refused_since <sessions dir> <cache file> -> rc 0 when a refusal (codex_refusal) is dated after
# the cache, or cannot be dated: the cached reading predates it, and the next start must see the source
# reached (ar-1120: six starts in two minutes on 2026-11-08 behind a cached reading). Only rollouts
# written since the cache are searched; an older refusal in one of them keeps the cache.
codex_refused_since() {
    local t
    t=$(find "$1" -name 'rollout-*.jsonl' -newer "$2" 2>/dev/null | codex_refusal) || return 0
    [[ "$t" != null ]] || return 1
    [[ "$t" =~ ^[0-9]+$ ]] || return 0
    (( t >= $(stat -c %Y "$2") ))
}

# fetch_source <name> <kind> <ref> -> the usage JSON of one source, cached for TTL like fetch, except
# that a codex refusal written since the cache makes it stale (codex_refused_since)
fetch_source() {
    local name="$1" kind="$2" ref="$3" cache="$CACHE/$1.json" out tmp info refused
    if [[ -s "$cache" ]] && (( $(date +%s) - $(stat -c %Y "$cache") < TTL )) &&
        ! { [[ "$kind" == codex ]] && codex_refused_since "$ref" "$cache"; }; then cat "$cache"; return 0; fi
    case "$kind" in
        codex) out=$(read_codex "$ref") ;;
        litellm-key|litellm-team)
            [[ -r "$ref" ]] || { echo "claude-acct: $name: no key file $ref" >&2; return 1; }
            info=$(gateway_get "$ref" /key/info | jq -e .info) ||
                { echo "claude-acct: $name: could not read the key's info from the gateway" >&2; return 1; }
            refused=$(gateway_refused "$ref" "$(jq -r '.models[0] // empty' <<< "$info")" "${kind#litellm-}")
            if [[ "$kind" == litellm-key ]]; then
                out=$(budget_usage "$refused" <<< "$info")
            else
                local team
                team=$(jq -er .team_id <<< "$info") ||
                    { echo "claude-acct: $name: the key is in no team" >&2; return 1; }
                out=$(gateway_get "$ref" "/team/info?team_id=$team" | jq -e .team_info | budget_usage "$refused") ||
                    { echo "claude-acct: $name: could not read team $team from the gateway" >&2; return 1; }
            fi ;;
        agy) out=$(read_agy "$ref") ;;
        *) echo "claude-acct: $name: unknown kind '$kind' (codex, agy, litellm-key, litellm-team)" >&2; return 1 ;;
    esac || return 1
    [[ -n "$out" ]] || return 1
    mkdir -p "$CACHE"
    tmp=$(mktemp "$CACHE/.$name.XXXXXX") && printf '%s\n' "$out" > "$tmp" && mv "$tmp" "$cache" || return 1
    printf '%s\n' "$out"
}

# source_live -> {"<source>": running queue items whose harness maps to it (harnesses.json source)}
source_live() {
    local agents
    agents=$(agent-queue list --json --state running 2>/dev/null | jq -s '[flatten[] | .agent // "claude"]' 2>/dev/null) || agents='[]'
    jq -c --argjson a "${agents:-[]}" '[$a[] as $x | .harnesses[$x].source // empty] | group_by(.) | map({key: .[0], value: length}) | from_entries' \
        "$HARNESSES" 2>/dev/null || echo '{}'
}

# scores -> "rank US score US name US dir US note" per account that can be scored. Lower rank is
# better (see usage_json); score is the fuller of the two windows, which `move` compares to 100.
scores() {
    usage_json nospend | jq -r '
        select(.state != "unread") |
        def p: if . == null then "-" else "\(floor)%" end;
        [.rank, ([.five_hour // 0, .week_used // 0] | max), .name, .dir,
         "5h \(.five_hour | p), 7d \(.week_used | p)"]
        | map(tostring) | join("\u001f")'
}

# first_run_done <name> <dir> -- mark Claude Code's first-run screens done for the account at <dir>
# (empty: main, ~/.claude.json), so a session nobody watches (a fleet worker on a pushed setup token)
# opens on its prompt, not the theme picker. Sets hasCompletedOnboarding and touches no other key:
# never a token, oauthAccount or folder trust. A file that is not JSON is left alone.
first_run_done() {
    local f="$HOME/.claude.json" tmp
    if [[ -n "$2" ]]; then [[ -d "$2" ]] || return 0; f="$2/.claude.json"; fi
    # Write through a symlinked config, never over the link; an empty file is a config not made yet.
    f=$(readlink -f "$f") || return 0
    [[ -s "$f" ]] || { printf '{"hasCompletedOnboarding": true}\n' > "$f"; return 0; }
    jq -e '.hasCompletedOnboarding == true' "$f" >/dev/null 2>&1 && return 0
    tmp=$(mktemp "$f.XXXXXX") || return 0
    if jq '.hasCompletedOnboarding = true' "$f" > "$tmp" 2>/dev/null; then
        mv "$tmp" "$f"
    else
        rm -f "$tmp"
        echo "claude-acct: $1: $f is not JSON, first-run left as is" >&2
    fi
}

cmd_link() {
    local name dir e src dst bk
    plans_store   # first, so the accounts below share the linked store
    while IFS=$'\037' read -r name dir; do
        first_run_done "$name" "$dir"
        [[ -n "$dir" && -d "$dir" ]] || continue
        for e in "${SHARED[@]}"; do
            # One hop to the real file: Claude Code follows a single symlink and renames a
            # temp file over its target, so linking to a stow link would replace that link.
            [[ -e "$MAIN_DIR/$e" ]] || continue
            src="$(readlink -f "$MAIN_DIR/$e")" dst="$dir/$e"
            if [[ -L "$dst" && "$(readlink -f "$dst")" == "$src" ]]; then
                # Already shares main's entry; repoint a two-hop link at the real file.
                [[ "$(readlink "$dst")" == "$src" ]] || ln -sfn "$src" "$dst"
                continue
            fi
            if [[ -d "$dst" && ! -L "$dst" && " ${MERGE[*]} " == *" $e "* ]]; then
                find "$dst" -mindepth 1 -maxdepth 1 -exec mv -n -t "$src" {} +
                rmdir "$dst" 2>/dev/null   # anything left (a name clash) is parked below
            fi
            if [[ -e "$dst" || -L "$dst" ]]; then
                # Never delete what an account already had: park it for a manual merge.
                bk="$dir/.pre-share-$(date +%F)"
                mkdir -p "$bk"
                [[ -e "$bk/$e" ]] && bk="$bk/$$" && mkdir -p "$bk"
                mv "$dst" "$bk/$e"
                echo "claude-acct: $name: moved existing $e to $bk/" >&2
            fi
            ln -s "$src" "$dst"
        done
    done < <(accounts)
}

# plans_store [--init]: Claude Code writes plans to ~/.claude/plans; the one store is
# ~/.agent/plans/_live, which store-sync versions and carries to peers, and ~/.claude/plans is a
# link to it. A project's entry in ~/.agent/plans/<project>/ is a relative link ../_live/<name>
# (85-sync-plans.sh), so it resolves in every clone. A machine links only once _live exists,
# which on a peer means git brought it; the first machine passes --init. Two machines each
# creating _live would collide on every plan name in the merge.
plans_store() {
    local root="$HOME/.agent/plans" live main="$MAIN_DIR/plans" e f n parked
    local -a ents
    live="$root/_live"
    if [[ "$(readlink "$main" 2>/dev/null)" != "$live" ]]; then
        if [[ ! -d "$live" ]]; then
            [[ "${1:-}" == --init ]] || return 0
            if [[ -d "$main" && ! -L "$main" ]]; then mkdir -p "$root" && mv "$main" "$live" || return 1
            else mkdir -p "$live" || return 1; fi
        fi
        # Still here: a peer's own plans dir, or the old link to ~/.agent/plans (setup_ai_memory
        # made it), whose top-level plans were the store. Each joins _live: a name _live lacks,
        # or a newer copy.
        if [[ -L "$main" && -d "$main" ]]; then ents=("$main"/*.md)
        elif [[ -d "$main" ]]; then ents=("$main"/* "$main"/.[!.]*); fi
        for e in ${ents[@]+"${ents[@]}"}; do   # the + form: bash 3.2 (mac) calls an empty array unset
            [[ -e "$e" || -L "$e" ]] || continue
            n=${e##*/}
            [[ -e "$live/$n" && ! "$e" -nt "$live/$n" ]] || cp -pR "$e" "$live/" || return 1
        done
        if [[ -d "$main" && ! -L "$main" ]]; then
            parked="$main.pre-live-$(date +%F)"
            [[ -e "$parked" ]] && parked="$parked.$$"
            mv "$main" "$parked" || return 1
            echo "claude-acct: merged $main into $live, the old dir is $parked" >&2
        fi
        [[ -e "$main" && ! -L "$main" ]] && { echo "claude-acct: $main is not a dir, left as is" >&2; return 1; }
        mkdir -p "${main%/*}" && ln -sfn "$live" "$main" || return 1
    fi
    # A project's own copy of a _live plan becomes the link; a newer copy is the one kept, the
    # older text stays in ~/.agent git. The reserved project keys (_unscoped, _runner) are
    # projects too; only the store and the archive are skipped (ar-3294: 25 _unscoped twins).
    while IFS= read -r f; do
        n=${f##*/}
        [[ -f "$live/$n" && ! -L "$live/$n" ]] || continue
        [[ "$f" -nt "$live/$n" ]] && { cp -p "$f" "$live/$n" || continue; }
        ln -sfn "../_live/$n" "$f"
    done < <(find "$root" -maxdepth 2 \( -path "$live" -o -path "$root/_archive" \) -prune -o -path "$root/*/*" -type f -name '*.md' -print 2>/dev/null)
}
# best -> "score US name US dir US note" of the account whose week is cheapest to spend from,
# nothing without data
best() {
    # Stable sort keeps file order on a tie, so the first account (main) wins it.
    scores | sort -s -t$'\037' -g -k1,1 | awk 'NR==1' | cut -d$'\037' -f2-
}

cmd_pick() {
    cmd_link
    local b name dir note
    if [[ -n "${1:-}" ]]; then
        while IFS=$'\037' read -r name dir; do
            [[ "$name" == "$1" ]] && { printf '%s\n' "$dir"; return 0; }
        done < <(accounts)
        echo "claude-acct: no account '$1' in $CONF (have: $(accounts | cut -d$'\037' -f1 | paste -sd' '))" >&2
        return 1
    fi
    b=$(best)
    if [[ -z "$b" ]]; then
        echo "claude-acct: no usage data, using the default account" >&2
        return 0
    fi
    IFS=$'\037' read -r _ name dir note <<< "$b"
    echo "claude-acct: $name ($note)" >&2
    # Told, never refused: a human start goes ahead whatever the pace, and never moves to the
    # paid Lazer reserve on its own; the hint names it, `cl --lazer` is the human's choice. The
    # one automatic path onto Lazer is a dispatch run pass routing an item there (fleet-dispatch start_item).
    local rows
    rows=$(usage_json nospend | jq -s .)
    local picked
    picked=$(jq -c --arg n "$name" '.[] | select(.name == $n)' <<< "$rows")
    if [[ -n "$picked" && "$(jq -r .room.ok <<< "$picked")" == false ]]; then
        echo "claude-acct: $name would be refused an automatic start, $(jq -r .room.why <<< "$picked"); this start goes ahead" >&2
    fi
    if jq -e 'length > 0 and all(.[]; .room.capped)' <<< "$rows" >/dev/null; then
        echo "claude-acct: every account is spent; cl --lazer runs Sonnet on the Lazer reserve, where dispatch passes already route Sonnet-lane items" >&2
    fi
    printf '%s\n' "$dir"
}

# --- long-lived tokens ------------------------------------------------------------------
# `claude setup-token` mints a token that lasts about a year; rbw holds one per account, and the
# one reader is acct_token. A machine without an unlocked rbw reads the 0600 copy `token push` wrote in TOKEN_DIR; none is ever put on a command line: a pane's
# launch line carries `$(claude-acct token ...)`, which its shell runs at the moment of launch.

# acct_name <name|dir> -> the account's name ('' when it is none); empty arg and "-" are main
acct_name() {
    local want="${1:-}" name dir
    [[ "$want" == "-" ]] && want=""
    want=$(norm_dir "${want/#\~/$HOME}")
    while IFS=$'\037' read -r name dir; do
        [[ "$name" == "${1:-}" ]] && { printf '%s' "$name"; return 0; }
        [[ "$(norm_dir "$dir")" == "$want" ]] && { printf '%s' "$name"; return 0; }
    done < <(accounts)
    return 1
}

# acct_token <name> -> the token on stdout; exit 1 and nothing when the account has none. Silent
# for "never set up"; one line on stderr when rbw is locked (it would prompt, which an unattended
# start cannot answer); the session then starts with no token, and the line names the fix.
acct_token() {
    local t
    if ! command -v rbw >/dev/null 2>&1 || ! rbw unlocked >/dev/null 2>&1; then
        t=$(cat "$TOKEN_DIR/$1" 2>/dev/null) || t=''
        if [[ "$t" == sk-ant-oat* ]]; then printf '%s' "$t"; return 0; fi
        command -v rbw >/dev/null 2>&1 &&
            echo "claude-acct: rbw is locked and this machine has no pushed copy, so $1 starts with no setup token: rbw unlock, or claude-acct token push here" >&2
        return 1
    fi
    t=$(rbw get "$TOKEN_ENTRY$1" 2>/dev/null) || return 1
    [[ "$t" == sk-ant-oat* ]] || return 1
    printf '%s' "$t"
}

# token [name|dir]
cmd_token() {
    local name
    name=$(acct_name "${1:-}") || { echo "claude-acct token: no account '${1:-}' in $CONF" >&2; return 1; }
    acct_token "$name"
}

# push_shell <host> <cmd>: run cmd (stdin passed through) on host: here for localhost or this
# machine's own name, else over ssh with no prompt
push_shell() {
    case "$1" in
        localhost|127.0.0.1|"$(hostname -s 2>/dev/null)"|"$(hostname 2>/dev/null)") bash -c "$2" ;;
        *) ssh -T -o BatchMode=yes -o ConnectTimeout=10 "$1" "$2" ;;
    esac
}

# token push <host...>: copy every account's token from this machine's unlocked rbw to each host's
# TOKEN_DIR (0600), over ssh stdin: never an argument, never a pane. Then ask the host's own
# claude-acct for each, so a host whose dotfiles predate the copy reads as failed. Exit 1 when any
# host failed, 2 when rbw cannot be read here.
cmd_token_push() {
    (($#)) || { echo "usage: claude-acct token push <host...>" >&2; return 2; }
    command -v rbw >/dev/null 2>&1 && rbw unlocked >/dev/null 2>&1 ||
        { echo "claude-acct token push: rbw is locked or missing here; rbw unlock, then re-run" >&2; return 2; }
    local host n dir t sum fail=0 ok
    # the host's TOKEN_DIR, expanded there; on its own line so the headless-launch scan reads no `claude -p`
    local rdir='${XDG_CONFIG_HOME:-$HOME/.config}/claude-acct/tokens'
    local -a have=()
    while IFS=$'\037' read -r n dir; do
        if [[ "$(rbw get "$TOKEN_ENTRY$n" 2>/dev/null)" == sk-ant-oat* ]]; then have+=("$n")
        else echo "claude-acct token push: $n has no token in rbw: claude-acct setup-token $n" >&2; fail=1; fi
    done < <(accounts)
    for host in "$@"; do
        [[ "$host" == -* ]] && { echo "claude-acct token push: '$host' is not a host" >&2; fail=1; continue; }
        ok=()
        for n in "${have[@]}"; do
            t=$(rbw get "$TOKEN_ENTRY$n" 2>/dev/null) || t=''
            sum=$(printf '%s' "$t" | cksum)
            # one ssh: write the copy from stdin, compare its bytes with ours, then check that the
            # host's claude-acct is new enough to read a copy. This machine (localhost or its own
            # name) runs the same command here: ssh to itself needs a host key nobody accepted.
            if printf '%s' "$t" | push_shell "$host" \
                "umask 077 && d=$rdir && mkdir -p \"\$d\" && cat > \"\$d/.$n.tmp\" && mv -f \"\$d/.$n.tmp\" \"\$d/$n\" && [ \"\$(cksum < \"\$d/$n\")\" = '$sum' ] && PATH=\$HOME/.local/bin:\$PATH claude-acct token $n >/dev/null 2>&1"; then
                ok+=("$n")
            else
                echo "claude-acct token push: $host: $n failed (ssh, a short write, or its claude-acct does not read the copy: pull its dotfiles)" >&2
                fail=1
            fi
        done
        t=''
        echo "$host: ${ok[*]:-none} read back"
    done
    return "$fail"
}

# token-prefix [dir] -> `CLAUDE_CODE_OAUTH_TOKEN="$(claude-acct token <dir>)" ` when that account has a
# token now (from rbw, or the pushed copy where rbw is locked), else nothing: an account without one
# starts signed out (acct_token says why on stderr; check tokens trips on it). The pane's shell
# reads the token again at launch.
cmd_token_prefix() {
    local name
    name=$(acct_name "${1:-}") || return 0
    acct_token "$name" >/dev/null 2>&1 || return 0
    printf 'CLAUDE_CODE_OAUTH_TOKEN="$(claude-acct token %q)" ' "${1:--}"
}

# token_expiry <name> -> the YYYY-MM-DD in the entry's notes (empty when none); exit 1 when rbw has no
# entry for the account
token_expiry() {
    local raw
    raw=$(rbw get --raw "$TOKEN_ENTRY$1" 2>/dev/null) || return 1
    jq -r '(.notes // "") | capture("(?m)^expires: (?<d>[0-9-]+)").d // empty' <<< "$raw" 2>/dev/null
    return 0
}

# check_tokens: one line; exit 1 when a token is missing, expired or inside TOKEN_WARN_DAYS, 2 when rbw cannot
# be read. An account with no token trips it too: the token is its only sign-in, so a session on it
# stops on "Not logged in". The claude-acct-tokens Sentinel watch runs this hourly. A locked rbw says
# `unreadable:`, which the watch reads as UNKNOWN (ERROR past its hold), not a token trip: the
# 2026-11-24 reboot locked it and the watch paged a token fault with every token good (ar-3611).
check_tokens() {
    local warn now="${CLAUDE_ACCT_NOW:-$(date +%s)}" name dir exp end days ok=0 out=''
    local -a none=() soon=()
    warn=$(pace_get TOKEN_WARN_DAYS)
    [[ -n "$warn" ]] || { echo "unreadable: TOKEN_WARN_DAYS is not set"; return 2; }
    if ! command -v rbw >/dev/null 2>&1 || ! rbw unlocked >/dev/null 2>&1; then
        echo "unreadable: rbw is missing or locked, so no token was checked (rbw unlock)"; return 2
    fi
    while IFS=$'\037' read -r name dir; do
        if ! exp=$(token_expiry "$name"); then none+=("$name"); continue; fi
        if [[ -z "$exp" ]] || ! end=$(date -d "$exp" +%s 2>/dev/null); then soon+=("$name expiry unknown"); continue; fi
        days=$(( (end - now) / 86400 ))
        if (( end < now )); then soon+=("$name expired $exp")
        elif (( days <= ${warn%.*} )); then soon+=("$name expires $exp, in ${days}d")
        else ok=$((ok + 1)); fi
    done < <(accounts)
    # A read that failed because rbw locked mid-loop is no missing token.
    if (( ${#none[@]} )) && ! rbw unlocked >/dev/null 2>&1; then
        echo "unreadable: rbw locked while tokens were read (rbw unlock)"; return 2
    fi
    if (( ${#soon[@]} )); then out="token: $(printf '%s; ' "${soon[@]}")"; out="${out%; }"; fi
    if (( ${#none[@]} )); then out+="${out:+; }no token: ${none[*]} (claude-acct setup-token <name>)"; fi
    echo "${out:-$ok tokens good}"
    (( ${#soon[@]} + ${#none[@]} == 0 ))
}

# setup_one <name> <dir> <renew> -> mint, verify and store one account's token. Exit 0 stored or
# already held, 1 failed (the reason printed). The token lives in a shell variable and in the 0600
# files of one mktemp -d, removed on return or by the trap if the run is interrupted; it is never an argument and never printed here.
setup_one() {
    local name="$1" dir="$2" renew="$3" email tok='' tmp pty ent ed other code exp note
    email=$(email_of "$dir")
    echo "== $name: sign in as ${email:-the account you use for $name (its email is unknown here)} =="
    if [[ "$renew" != 1 ]] && acct_token "$name" >/dev/null 2>&1; then
        echo "   $name already has a token (rbw $TOKEN_ENTRY$name); --renew replaces it"; return 0
    fi
    tmp=$(mktemp -d) || return 1
    SETUP_TMP="$tmp"   # removed by cmd_setup_token's trap if the run is interrupted
    chmod 700 "$tmp"
    pty="$tmp/pty.log"
    echo "   claude setup-token opens a browser: sign in as ${email:-that account}, approve, and the token prints."
    # claude runs on a scratch config dir: minting a token must not touch the account's login state.
    if command -v script >/dev/null 2>&1; then
        # claude draws at the terminal's own width, so a token it wraps is cut short in the capture:
        # only a whole one (TOKEN_LEN) is taken, else the hidden paste below asks for it.
        script -qf -c "env CLAUDE_CONFIG_DIR=$(printf %q "$tmp/cfg") claude setup-token" "$pty" || true
        tok=$(sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' "$pty" 2>/dev/null | tr -d '\r' |
            grep -oE 'sk-ant-oat[0-9]*-[A-Za-z0-9_-]+' | awk -v n="$TOKEN_LEN" 'length($0) == n { t = $0 } END { print t }')
    else
        CLAUDE_CONFIG_DIR="$tmp/cfg" claude setup-token || true
    fi
    if [[ -z "$tok" ]]; then
        printf '   token not read from the screen; paste it (hidden): '
        read -rs tok || true; echo
    fi
    if [[ "$tok" != sk-ant-oat* ]]; then
        echo "   $name: no token (it starts sk-ant-oat); nothing stored" >&2; rm -rf "$tmp"; return 1
    fi
    # Verify: one tiny call that must bill the subscription, so no API key may be in play.
    if [[ -n "${ANTHROPIC_API_KEY:-}${ANTHROPIC_AUTH_TOKEN:-}" ]]; then
        echo "   $name: ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN is set, so the call would not bill the subscription; unset it and re-run" >&2
        rm -rf "$tmp"; return 1
    fi
    if ! env -u ANTHROPIC_BASE_URL CLAUDE_CONFIG_DIR="$tmp/cfg" CLAUDE_CODE_OAUTH_TOKEN="$tok" \
            claude -p 'Reply with the word ok' --model haiku --max-turns 1 >"$tmp/probe.out" 2>&1 || ! grep -qiw ok "$tmp/probe.out"; then
        echo "   $name: the token did not run a call; nothing stored" >&2; rm -rf "$tmp"; return 1
    fi
    echo "   verified: one haiku call ran on the token"
    # The header goes in on stdin (-K -): argv is readable by every process on the machine.
    code=$(printf 'header = "Authorization: Bearer %s"\n' "$tok" |
        curl -sS -m 10 -K - -o /dev/null -w '%{http_code}' "$USAGE_URL" -H "anthropic-beta: oauth-2025-04-20" 2>/dev/null) || code=000
    if [[ "$code" == 200 ]]; then note=accepted; else note="rejected (HTTP $code)"; fi
    echo "   usage endpoint: $note"
    exp=$(date -d '+365 days' +%F)
    note=$(printf 'email: %s\nminted: %s\nexpires: %s\nusage_endpoint: %s' "${email:-unknown}" "$(date +%F)" "$exp" "$note")
    # rbw add/edit open $EDITOR on a temp file; ours copies the entry in, so the token is never an argument.
    ent="$tmp/entry"; ed="$tmp/editor"
    printf '%s\n\n%s\n' "$tok" "$note" > "$ent"
    printf '#!/bin/sh\ncat %q > "$1"\n' "$ent" > "$ed"; chmod 700 "$ed"
    if rbw get "$TOKEN_ENTRY$name" >/dev/null 2>&1; then
        EDITOR="$ed" VISUAL="$ed" rbw edit "$TOKEN_ENTRY$name" || { echo "   $name: rbw edit failed" >&2; rm -rf "$tmp"; return 1; }
    else
        EDITOR="$ed" VISUAL="$ed" rbw add "$TOKEN_ENTRY$name" || { echo "   $name: rbw add failed" >&2; rm -rf "$tmp"; return 1; }
    fi
    if [[ "$(rbw get "$TOKEN_ENTRY$name" 2>/dev/null)" != "$tok" ]]; then
        echo "   $name: rbw does not hold the token it was given; check the vault entry $TOKEN_ENTRY$name" >&2
        rm -rf "$tmp"; return 1
    fi
    rm -rf "$tmp"
    echo "   stored: rbw $TOKEN_ENTRY$name, expires $exp"
}

# setup-token [--renew] [name]
cmd_setup_token() {
    local renew=0 want="" name dir n row fail=0
    while (( $# )); do
        case "$1" in
            --renew) renew=1 ;;
            -*) echo "usage: claude-acct setup-token [--renew] [name]" >&2; return 2 ;;
            *) want="$1" ;;
        esac
        shift
    done
    # The pty transcript and the entry file hold the token while a run lasts; an interrupt removes them.
    trap 'rm -rf "${SETUP_TMP:-}"; exit 130' INT TERM
    trap 'rm -rf "${SETUP_TMP:-}"' EXIT
    command -v rbw >/dev/null 2>&1 || { echo "claude-acct setup-token: rbw is not installed" >&2; return 1; }
    rbw unlocked >/dev/null 2>&1 || { echo "claude-acct setup-token: rbw is locked; run rbw unlock first" >&2; return 1; }
    command -v claude >/dev/null 2>&1 || { echo "claude-acct setup-token: claude is not on PATH" >&2; return 1; }
    if [[ -n "$want" ]]; then
        name=$(acct_name "$want") || { echo "claude-acct setup-token: no account '$want' in $CONF" >&2; return 1; }
    fi
    # Rows are read first: a loop fed from accounts would hand setup_one's paste prompt that file as stdin.
    local -a rows
    mapfile -t rows < <(accounts)
    for row in "${rows[@]}"; do
        IFS=$'\037' read -r n dir <<< "$row"
        [[ -z "$want" || "$n" == "$name" ]] || continue
        setup_one "$n" "$dir" "$renew" || fail=1
    done
    return "$fail"
}

# --- usage -----------------------------------------------------------------------------
# The weekly percent is what stops work, so pace is read against it: under the line the account
# can keep this use up until it resets. Dollars are the OTel list-price estimate, for scale only.
WEEK=604800
# The numbers live in .config/claude-acct/pace.conf and nowhere else (pace_get, pace-conf.sh), so every
# reader of the verdict sees the same line (the machine-mode level scales them, by column name). A dispatch floor lifts the pace reason from the
# published verdict (room.reasons), never by moving the slack.
# shellcheck source=../lib/pace-conf.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/pace-conf.sh"
PACE_SLACK_PCT="$(pace_get PACE_SLACK_PCT)"
RESERVE_PCT="$(pace_get RESERVE_PCT)"
# shellcheck source=../lib/machine-mode.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/machine-mode.sh"   # level_scale, for room
SESSION_RATE="${CLAUDE_ACCT_SESSION_RATE:-$(pace_get SESSION_RATE)}"
MODEL_WEIGHT_SONNET="$(pace_get MODEL_WEIGHT_SONNET)"
MODEL_WEIGHT_HAIKU="$(pace_get MODEL_WEIGHT_HAIKU)"
CLAUDE_SESSION_RATE="${CLAUDE_ACCT_SESSION_RATE:-$(pace_get CLAUDE_SESSION_RATE)}"
ACTIVE_MIN="$(pace_get ACTIVE_MIN)"
# The allowance in force: a window or standing override set by pace-conf, else the line in pace.conf
# (pace_get reads all three). Exported for jq: room and FLEET_JQ read it in OVER_JQ.
export CLAUDE_ACCT_BURN_OVER_PCT="$(pace_get BURN_OVER_PCT)"
BURN_OVER_SRC="$(pace_source BURN_OVER_PCT)"
# BURN_OVER_PCT as a factor: how far past what the week sustains the working sessions may burn
# before room calls an account committed, and the allowance dispatch's spare reads. The one jq
# prefix room and FLEET_JQ share.
OVER_JQ='def over: 1 + ($ENV.CLAUDE_ACCT_BURN_OVER_PCT // "0" | tonumber) / 100;'
[[ -n "$PACE_SLACK_PCT" && -n "$RESERVE_PCT" && -n "$SESSION_RATE" && -n "$CLAUDE_SESSION_RATE" && -n "$MODEL_WEIGHT_SONNET" && -n "$MODEL_WEIGHT_HAIKU" && -n "$ACTIVE_MIN" && -n "$CLAUDE_ACCT_BURN_OVER_PCT" ]] || exit 1
RATE_TTL="${CLAUDE_ACCT_RATE_TTL:-3600}"
# The one bash Prometheus reader (prom_q, PROM_URL from the hub's own env file). A dead endpoint
# costs a start 5s at most, and only the spend paths ask.
# shellcheck source=../lib/prom.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/prom.sh"
PROM_TIMEOUT="${PROM_TIMEOUT:-5}"
# shellcheck source=../lib/prom-textfile.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/prom-textfile.sh"


# email_of <dir> -> the address that account is logged in as, empty if unknown
email_of() {
    local f="$HOME/.claude.json"
    [[ -n "$1" ]] && f="$1/.claude.json"
    jq -r '.oauthAccount.emailAddress // empty' "$f" 2>/dev/null
}

# live_of -> one line per running claude, "@" and the account dir it runs under, "~@" instead when
# the session registry says it is idle or waiting on the human: it spends nothing until someone
# types, so it is live but not working (busy, running a shell, or not in the registry, as a
# `claude -p` is not). A registered session whose statusUpdatedAt is older than ACTIVE_MIN (pace.conf)
# is "~@" too: a LANDED or CHAT claude left on "shell" or "busy" for hours spends nothing (ar-1018).
# A tab and its model's weight follow (weight_of). The "@" keeps the main
# account's line non-empty: a trailing empty line is lost to $(...), and none at all reads as one
# main session. A claude on the Lazer gateway spends no account, so it is not one. Builtins only per
# /proc entry: every agentctl-run call pays for this loop through pick.
live_of() {
    local c comm pid reg mark w
    local re_updated='"statusUpdatedAt":[[:space:]]*([0-9]+)' now="${CLAUDE_ACCT_NOW:-}"
    [[ -n "$now" ]] || printf -v now '%(%s)T' -1
    for c in "$PROC"/[0-9]*/comm; do
        comm=""
        read -r comm 2>/dev/null < "$c"
        [[ "$comm" == claude ]] || continue
        c="${c%/comm}"; pid="${c##*/}"
        [[ -z "$(gateway_of "$pid")" ]] || continue
        reg="" mark="@"
        read -r -d '' reg 2>/dev/null < "$REGISTRY/$pid.json"
        [[ "$reg" =~ \"status\":[[:space:]]*\"(idle|waiting)\" ]] && mark="~@"
        [[ "$mark" == "@" && "$reg" =~ $re_updated ]] && ((now - BASH_REMATCH[1] / 1000 > ACTIVE_MIN * 60)) && mark="~@"
        weight_of "$pid" w
        printf '%s%s\t%s\n' "$mark" "$(config_dir_of "$pid")" "$w"
    done
}

# weight_of <pid> <var> -- sets var to what an hour of that claude spends against an hour of Opus,
# by the --model on its command line (pace.conf MODEL_WEIGHT_*): a Sonnet or Haiku session uses less
# of the week, so burn and the rate count Opus-equivalents (ar-3230). No --model, or one it does not
# name, is 1: an unknown model is never read as cheap. Builtins only, as live_of.
weight_of() {
    local -a args=()
    local i m=""
    mapfile -d '' -t args 2>/dev/null < "$PROC/$1/cmdline"
    for ((i = 0; i < ${#args[@]}; i++)); do
        case "${args[i]}" in
            --model) m="${args[i + 1]:-}"; break ;;
            --model=*) m="${args[i]#--model=}"; break ;;
        esac
    done
    case "${m,,}" in
        *haiku*) printf -v "$2" '%s' "$MODEL_WEIGHT_HAIKU" ;;
        *sonnet*) printf -v "$2" '%s' "$MODEL_WEIGHT_SONNET" ;;
        *) printf -v "$2" '%s' 1 ;;
    esac
}

# spend_24h -> {"email": dollars}, or null when Prometheus cannot be read: dollars are for scale,
# never load-bearing, so the percents still print
spend_24h() {
    local out
    out=$(prom_q 'sum by (user_email) (increase(claude_code_cost_usage_USD_total[24h]))' |
        jq -c '[.data.result[] | {key: (.metric.user_email // ""), value: (.value[1] | tonumber)}] | from_entries' 2>/dev/null)
    echo "${out:-null}"
}

# cost -> {"<session id>": dollars} for every session with spend in the window. increase(), not
# the counter's value, so a session resumed in a new process (its counter restarted) still sums
# its whole spend. Exit 2 when Prometheus cannot be read: no answer is not "spent nothing".
cmd_cost() {
    local out
    out=$(prom_q "sum by (session_id) (increase(claude_code_cost_usage_USD_total[${CLAUDE_ACCT_COST_WINDOW:-7d}]))" |
        jq -ce '[.data.result[] | select(.metric.session_id != null)
                 | {key: .metric.session_id, value: (.value[1] | tonumber * 100 | round / 100)}] | from_entries' 2>/dev/null) ||
        { echo "claude-acct: cost: cannot read Prometheus" >&2; return 2; }
    printf '%s\n' "$out"
}

# session_rate [nospend] [source] -> points of an account's week one working Opus session uses an hour:
# the fleet's last 6h from Prometheus, cached for RATE_TTL (a miss too), CLAUDE_SESSION_RATE when it cannot be
# read (a source's own: SESSION_RATE, the unit of a running queue item, which ACTIVE_MIN never touched). A reset inside the window reads low, never high. nospend reads the cache at any age and never
# asks Prometheus; the claude-acct-usage timer's `textfile` keeps the cache fresh. With a source name
# it is that source's own 6h change in used percent per working session, SESSION_RATE until it has history.
# Working, not live, as burn multiplies it by (live_of): a rate per live session counts idle ones in.
# The divisor is working_cost, the working sessions weighted by model (weight_of), so a Sonnet-heavy
# 6h does not read as cheap Opus (ar-3230).
# Each account is one series (max by account) before the offset and the average: a label added to the
# textfile (kind, #1488) leaves the new series no partner 6h back, and a raw subtraction reads nothing.
session_rate() {
    local f="$CACHE/session_rate" r q sel='kind=~"claude|"' dflt="$CLAUDE_SESSION_RATE"
    if [[ -n "${2:-}" ]]; then f="$CACHE/session_rate.$2" sel="account=\"$2\"" dflt="$SESSION_RATE"; fi
    q="sum(clamp_min(max by (account) (claude_account_week_used_percent{$sel}) - max by (account) (claude_account_week_used_percent{$sel} offset 6h), 0))"
    # only the accounts the numerator has a 6h-old sample for count their working sessions
    q+=" / sum(avg_over_time((max by (account) (claude_account_working_cost{$sel}))[6h:5m])"
    q+=" and on (account) max by (account) (claude_account_week_used_percent{$sel} offset 6h)) / 6"
    if [[ -s "$f" ]] && { [[ "${1:-}" == nospend ]] || (( $(date +%s) - $(stat -c %Y "$f") < RATE_TTL )); }; then
        cat "$f"; return
    fi
    if [[ "${1:-}" == nospend ]]; then echo "$dflt"; return; fi
    r=$(prom_q "$q" |
        jq -er '.data.result[0].value[1] | tonumber | select(. > 0 and . < 10)' 2>/dev/null) || r="$dflt"
    mkdir -p "$CACHE" && printf '%s\n' "$r" > "$f"
    printf '%s\n' "$r"
}

# usage_json [nospend] -> one JSON object per Claude account; with USAGE_SOURCES=1 (all_json) also
# one per source, in the same shape. state: ok or unread.
# nospend skips Prometheus, so a `cl` off the LAN does not wait out its timeout.
usage_json() {
    local name kind dir json rc state now resets start gone used over live spend lives rate slack reserve
    local own_reserve max_live parent win paced srclive row_reserve email working cost read_at run_usd basis
    srclive='{}'; [[ "${USAGE_SOURCES:-0}" == 1 ]] && srclive=$(source_live)
    # The room verdict is for automatic starts, so the machine-mode level scales its slack and reserve;
    # pick's rank, which `cl` uses, keeps the conf's own reserve.
    read -r slack reserve < <(level_scale CLAUDE_ACCT_PACE_SLACK_PCT "$PACE_SLACK_PCT" CLAUDE_ACCT_RESERVE_PCT "$RESERVE_PCT")
    now="${CLAUDE_ACCT_NOW:-$(date +%s)}"
    if [[ "${1:-}" == nospend ]]; then spend=null; else spend=$(spend_24h); fi
    lives=$(live_of)
    while IFS=$'\037' read -r name kind dir own_reserve max_live parent alert _ run_usd basis; do
        case "$kind" in
            claude) json=$(fetch "$name"); rc=$?; rate=$(session_rate "${1:-}") ;;
            litellm-*) json=$(fetch_source "$name" "$kind" "$dir"); rc=$?; rate=$SESSION_RATE ;; # a dollar budget has no pace
            *) json=$(fetch_source "$name" "$kind" "$dir"); rc=$?; rate=$(session_rate "${1:-}" "$name") ;;
        esac
        read_at=""
        if (( rc == 0 )); then state=ok; else
            state=unread; json='{}'
            # the cache file outlives its TTL, so its age is when the account was last read
            [[ "$kind" == claude ]] && read_at=$(stat -c %Y "$CACHE/$name.json" 2>/dev/null)
        fi
        used=$(jq -r '.seven_day.utilization // empty' <<< "$json")
        resets=$(jq -r '.seven_day.resets_at // empty' <<< "$json")
        resets=$([[ -n "$resets" ]] && date -d "$resets" +%s 2>/dev/null)
        gone=""
        win=$(jq -r '.window // empty' <<< "$json"); win=${win:-$WEEK}
        paced=$(jq -r 'if .paced == false then false else true end' <<< "$json")
        if [[ -n "$resets" && -n "$used" && "$paced" == true ]]; then
            start=$((resets - win))
            gone=$(awk -v n="$now" -v s="$start" -v w="$win" 'BEGIN { g = (n - s) * 100 / w; print (g < 0 ? 0 : g > 100 ? 100 : g) }')
        fi
        if [[ "$kind" == claude ]]; then
            read -r live working cost < <(LC_ALL=C awk -F'\t' -v w="@$dir" -v i="~@$dir" '
                $1 == w { n++; c += $2 } $1 == i { l++ } END { printf "%d %d %s\n", n + l, n, c + 0 }' <<< "$lives")
            email=$(email_of "$dir")
        else live=$(jq -r --arg n "$name" '.[$n] // 0' <<< "$srclive"); working=$live cost=$live; email=""; fi
        # A source's own reserve is scaled by the machine-mode level like the default one.
        row_reserve=$reserve
        [[ -z "$own_reserve" ]] || read -r _ row_reserve < <(level_scale CLAUDE_ACCT_PACE_SLACK_PCT "$PACE_SLACK_PCT" CLAUDE_ACCT_RESERVE_PCT "$own_reserve")
        jq -cn --arg name "$name" --arg dir "$dir" --arg email "$email" --arg state "$state" \
            --arg kind "$kind" --argjson window "$win" --argjson paced "$paced" --arg parent "$parent" --arg max_live "$max_live" --arg alert "$alert" --arg basis "$basis" --arg run_usd "$run_usd" \
            --argjson usage "$json" --arg used "$used" --arg gone "$gone" \
            --arg resets "$resets" --arg read_at "$read_at" --argjson live "${live:-0}" --argjson working "${working:-0}" --argjson cost "${cost:-0}" --argjson spend "$spend" \
            --argjson now "$now" --argjson reserve "${own_reserve:-$RESERVE_PCT}" --argjson rate "$rate" \
            --argjson room_slack "$slack" --argjson room_reserve "$row_reserve" "$OVER_JQ"'
            def num: if . == "" then null else tonumber end;
            # What is left of the week, as points an hour to the reset, less what the live sessions
            # there already burn: lower is better. One hour per spare point, so the account whose
            # remainder would otherwise be lost at its reset gets the work. An account its sessions
            # already empty before the reset ranks behind every one with room, and among those the
            # one its sessions empty last goes first. A 5h window near full goes last.
            # Points an hour the rest of the week can carry to the reset, landing at 100% on it.
            def sustain: (100 - (.week_used // 0)) / (if .resets == null then $window / 3600 else ([(.resets - $now) / 3600, 0.1] | max) end);
            # When used falls back to the week gone plus the slack, the moment room drops `pace`:
            # with no spend the clock catches up at 100 points a week; at this burn, only when burn
            # is under that line. null when it is after the reset (the reset puts it on pace anyway).
            def on_pace($b):
                if .week_used == null or .week_gone == null then null
                elif .week_used <= .week_gone + $room_slack then $now
                else ((100 * 3600 / $window) - $b) as $g
                    | if $g <= 0 then null
                      else ($now + (.week_used - .week_gone - $room_slack) / $g * 3600 | floor) as $t
                        | if .resets != null and $t >= .resets then null else $t end
                      end
                end;
            # When the working sessions empty the window at their burn now (working x rate, the estimator
            # room judges committed by); null with no burn, or when it lasts to the reset. Past the
            # limit it is a time already gone, as capped says.
            def run_out:
                if .week_used == null or .resets == null or (.paced | not) or .burn <= 0 then null
                else ($now + (100 - .week_used) / .burn * 3600 | floor) as $t
                    | if $t >= .resets then null else $t end
                end;
            def rank:
                (.week_used // 0) as $u
                | sustain as $carry
                | (if $u >= 100 then 1e9
                   elif $carry > .burn then ([1 / ($carry - .burn), 999] | min)
                   else 1e3 + .burn / (100 - $u) end)
                  + (if (.five_hour // 0) >= 100 - $reserve then 1e6 else 0 end);
            # The verdict on an automatic start, the one place the rule is written. reasons lists every
            # refusal, in this order: unread, capped (window empty, or the plan says its limit is
            # reached), reserve (inside the last of the window), pace (past the line after slack),
            # five_hour (its window inside the reserve), committed (its working sessions already use the
            # rest of the window, past BURN_OVER_PCT), max_live (as many running items as the source allows); reason is
            # the first, or ok. A source whose parent pool is spent also gets `parent`, after reserve
            # (all_json). A dollar budget (paced false) has no pace line and no committed burn. A
            # dispatch floor may lift pace only, so it reads reasons == ["pace"]. over_points is the points past the
            # line after slack; headroom_points the same, signed (for a budget: points left before the
            # reserve) and null with no window.
            def room($slack; $reserve):
                .week_used as $u | (.week_gone // 0) as $g | (.five_hour // 0) as $f
                | (if .state == "unread" then ["unread"] else
                     [if ($u != null and $u >= 100) or .reached then "capped" else empty end,
                      if $u != null and $u >= 100 - $reserve and $u < 100 then "reserve" else empty end,
                      if .paced and $u != null and $u > $g + $slack then "pace" else empty end,
                      if $f >= 100 - $reserve then "five_hour" else empty end,
                      if .paced and sustain * over <= .burn then "committed" else empty end,
                      if .max_live != null and .live >= .max_live then "max_live" else empty end]
                   end) as $no
                | {ok: ($no == []), reason: ($no[0] // "ok"), reasons: $no,
                   over_points: (if $u == null or (.paced | not) then 0 else ([$u - $g - $slack, 0] | max) end),
                   headroom_points: (if $u == null then null elif .paced then $g + $slack - $u else 100 - $reserve - $u end),
                   capped: (($u // 0) >= 100 or $f >= 100 or .reached), slack: $slack, reserve: $reserve};
            # why: the first refusal in a sentence, for every reader that says it (room, pick,
            # dispatch); "it has room" when there is none.
            def room_why:
                def pts: ceil | "\(.) point\(if . == 1 then "" else "s" end)";
                .room as $r
                | if $r.reason == "unread" then "its usage cannot be read"
                  elif $r.reason == "capped" then "out of its week"
                  elif $r.reason == "reserve" then "\(.week_used | floor)% of its week used, inside the last \($r.reserve)% kept for the human"
                  elif $r.reason == "pace" then
                    "\($r.over_points | pts) over its weekly pace (\(.week_used | floor)% used, \((.week_gone // 0) | floor)% of its week gone, \($r.slack | pts) of slack)"
                  elif $r.reason == "five_hour" then (if (.five_hour // 0) >= 100 then "its 5h window is spent" else "its 5h window at \(.five_hour | floor)%" end)
                  elif $r.reason == "committed" then "its \(.working) working sessions use the rest of its week before the reset"
                  elif $r.reason == "max_live" then "its \(.live) live sessions are all it takes (\(if $basis == "" or $basis == "max_live" then "max_live \(.max_live)" else $basis end))"
                  else "it has room" end;
            {name: $name, kind: $kind, dir: $dir, email: $email, state: $state,
             paced: $paced, window: $window, reserve: $room_reserve, plan: ($usage.plan // null), reached: ($usage.reached // false),
             parent: (if $parent == "" then null else $parent end), alert: ($alert != "off"), max_live: (if $max_live == "" then null else ($max_live | tonumber) end),
             max_live_basis: (if $basis == "" then null else $basis end), run_usd: (if $run_usd == "" then null else ($run_usd | tonumber) end),
             usd_used: ($usage.usd_used // null), usd_max: ($usage.usd_max // null),
             five_hour: ($usage.five_hour.utilization // null),
             five_hour_resets: ($usage.five_hour.resets_at // null | if . == null then null else (sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601? // null) end),
             week_used: ($used | num), week_gone: ($gone | num),
             resets: ($resets | num), read_at: ($read_at | num), live: $live, working: $working, working_cost: $cost,
             # points an hour its working sessions burn: their Opus-equivalents (working_cost) times
             # the fleet rate per Opus session (an idle or waiting session spends nothing, ar-1682; a
             # Sonnet one less than an Opus one, ar-3230)
             burn: ($cost * $rate), rate: $rate,
             usd_24h: (if $email == "" or $spend == null then null else ($spend[$email] // 0) end)}
            | .sustain = (if .week_used == null or (.paced | not) then null else sustain end)
            | .run_out = run_out
            | .on_pace_idle = on_pace(0) | .on_pace_burn = on_pace(.burn)
            | .rank = rank
            | .room = room($room_slack; $room_reserve)
            | .room.why = room_why'
    done < <(rows_in)
}

# all_json [nospend] -> usage_json over the Claude accounts and the sources, a source whose parent
# pool is spent, unread or inside its reserve refused for `parent`: one key of a pool has room only
# when the pool does.
all_json() {
    USAGE_SOURCES=1 usage_json "$@" | jq -c -s '
        (INDEX(.[]; .name)) as $by
        | .[]
        | ($by[.parent // ""].room.reasons // []) as $p
        | if (.parent // "") != "" and ($by[.parent] == null) then
            .room.reasons = ["parent"] + [.room.reasons[] | select(. != "parent")]
            | .room.ok = false | .room.reason = "parent"
            | .room.why = "its parent \(.parent) is not a source in the sources file"
          elif ($p | any(. == "unread" or . == "capped" or . == "reserve")) then
            def first_group: . == "unread" or . == "capped" or . == "reserve";
            .room.reasons |= ([.[] | select(first_group)] + ["parent"] + [.[] | select(first_group | not) | select(. != "parent")])
            | .room.ok = false | .room.reason = .room.reasons[0]
            | if .room.reason == "parent" then .room.why = "its pool \(.parent) is spent or inside its reserve" else . end
          else . end'
}

# day_time <epoch> -> "Thu 19:00", or - when there is none
day_time() { if [[ -n "$1" && "$1" != null ]]; then date -d "@$1" '+%a %H:%M'; else printf -- -; fi; }

# cmd_run [--acct <name>] [claude args]: exec claude on the account cmd_pick chooses. Main is the
# unset dir, so an alt account inherited from a parent session is dropped, not passed on. The
# project label is added per launch, as claude-telemetry.sh asks. Unattended runs pick through
# agentctl-run instead; runner_contract.bats fails on a claude started any other way.
cmd_run() {
    local dir
    if [[ "${1:-}" == --acct ]]; then
        dir=$(cmd_pick "${2:?claude-acct run: --acct needs an account name}") || return 1
        shift 2
    else
        dir=$(cmd_pick)
    fi
    if [[ -n "$dir" ]]; then export CLAUDE_CONFIG_DIR="$dir"; else unset CLAUDE_CONFIG_DIR; fi
    # The account's own token, or none: one inherited from a parent session is another account's.
    unset CLAUDE_CODE_OAUTH_TOKEN
    local tok
    if tok=$(cmd_token "${dir:--}") && [[ -n "$tok" ]]; then export CLAUDE_CODE_OAUTH_TOKEN="$tok"; fi
    tok=''
    # An account session's harness is claude, which the Stop hook records when none is set: a
    # gateway parent's AGENT_HARNESS (claude-lazer) must not label it.
    unset AGENT_HARNESS
    set +u
    # shellcheck source=/dev/null
    . "$HOME/.config/shared-hooks/claude-telemetry.sh" 2>/dev/null
    set -u
    if declare -F claude_telemetry_launch >/dev/null; then
        OTEL_RESOURCE_ATTRIBUTES="$(claude_telemetry_launch)"; export OTEL_RESOURCE_ATTRIBUTES
    fi
    cmd_scope claude "$@"
}

# cmd_scope <command...>: move this process into its own systemd user scope, named
# agent-<project>-<item>-<pid>.scope (each part systemd-escaped, so a literal '-' only separates them;
# the item is empty for a hand start), then exec the command, so its pid (a dispatch pane's pid) stays
# the same. node-inventory-metrics (home-config) reports each scope's CPU and memory with its project
# and queue item, and agent-host-budget's agent-.scope drop-in holds it to the agent CPUs. In a tmux
# pane the description reads as tmux's own, "tmux child pane <pid> ... launched by process <server
# pid>", so `wt orphans` ends what the session left once the pane closes (worktree.sh
# wt_closed_pane_scopes reads both pids by word position: keep the shape).
# A hand start outside tmux is the human's own terminal session: it stays in that terminal's scope,
# which agent-hold never lowers and the agent CPU cap never holds. With no user manager (macOS, a
# shell with no XDG_RUNTIME_DIR), or when the manager refuses the scope, the command runs unscoped,
# and on Linux says so.
cmd_scope() {
    [[ $# -gt 0 ]] || { echo "claude-acct scope: name a command" >&2; return 2; }
    [[ "$(uname -s)" == Linux ]] || exec "$@"
    local p i u d spid pane pp
    i=${AGENT_QUEUE_ITEM:-}
    if [[ -n "${TMUX:-}" ]]; then
        # TMUX is "<socket>,<server pid>,<session>"; the pane's pid is the ancestor the server started.
        spid=${TMUX#*,}; spid=${spid%%,*}; pane=$$
        while pp=$(awk '/^PPid:/ { print $2 }' "/proc/$pane/status" 2>/dev/null) && [[ -n "$pp" && "$pp" != "$spid" && "$pp" -gt 1 ]]; do
            pane=$pp
        done
    fi
    [[ -n "$i" || "${pp:-}" == "${spid:-x}" ]] || exec "$@"
    if ! command -v busctl >/dev/null || [[ ! -S "${XDG_RUNTIME_DIR:-/nonexistent}/systemd/private" ]]; then
        echo "claude-acct scope: no systemd user manager here, so this session runs in no agent scope" >&2
        exec "$@"
    fi
    # shellcheck disable=SC2016
    p=$(bash -c '. "$1" && resolve_project_name "$2"' _ "${PROJECT_NAME_LIB:-$HOME/.config/shared-hooks/project-name.sh}" "$PWD" 2>/dev/null)
    u="agent-$(systemd-escape -- "$p")-$(systemd-escape -- "$i")-$$.scope"
    d="agent session for ${p:-no project}${i:+ item $i}"
    [[ "${pp:-}" != "${spid:-x}" ]] || d="tmux child pane $pane runs $d launched by process $spid"
    # systemd-run --scope would exec the command itself, and a scope it fails to start (a name a
    # leftover scope still holds, a manager that refuses it) would then start no session at all.
    busctl --user call org.freedesktop.systemd1 /org/freedesktop/systemd1 org.freedesktop.systemd1.Manager \
        StartTransientUnit 'ssa(sv)a(sa(sv))' "$u" fail 3 PIDs au 1 "$$" Description s "$d" \
        CollectMode s inactive-or-failed 0 >/dev/null ||
        echo "claude-acct scope: the user manager did not start $u, so this session runs in no agent scope" >&2
    exec "$@"
}

cmd_status() {
    if [[ "${1:-}" == --json ]]; then
        all_json | jq -s .
        return
    fi
    local line state rows
    rows=$(all_json)
    printf '%-8s %-4s %-5s %-5s %-10s %-10s %-5s %-7s %-6s %-7s %-11s %-10s %-13s %s\n' \
        SOURCE 5H WEEK GONE RUNS-OUT RESETS LIVE '24H-$' BURN/H KEEPS/H ON-PACE ROOM KIND DETAIL
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        state=$(jq -r .state <<< "$line")
        if [[ "$state" != ok ]]; then
            printf '%-8s fetch failed (%s live)\n' "$(jq -r .name <<< "$line")" "$(jq -r .live <<< "$line")"
            continue
        fi
        printf '%-8s %-4s %-5s %-5s %-10s %-10s %-5s %-7s %-6s %-7s %-11s %-10s %-13s %s\n' \
            "$(jq -r .name <<< "$line")" \
            "$(jq -r 'if .five_hour == null then "-" else "\(.five_hour | floor)%" end' <<< "$line")" \
            "$(jq -r 'if .week_used == null then "-" else "\(.week_used | floor)%" end' <<< "$line")" \
            "$(jq -r 'if .week_gone == null then "-" else "\(.week_gone | floor)%" end' <<< "$line")" \
            "$(day_time "$(jq -r .run_out <<< "$line")")" \
            "$(day_time "$(jq -r .resets <<< "$line")")" \
            "$(jq -r .live <<< "$line")" \
            "$(jq -r 'if .usd_24h == null then "-" else "$\(.usd_24h | floor)" end' <<< "$line")" \
            "$(jq -r '.burn * 100 | round / 100' <<< "$line")" \
            "$(jq -r 'if .sustain == null then "-" else (.sustain * 100 | round / 100) end' <<< "$line")" \
            "$(on_pace_word "$(jq -r .on_pace_burn <<< "$line")" "$(jq -r .resets <<< "$line")")" \
            "$(jq -r 'if .room.ok then "ok" else .room.reason end' <<< "$line")" \
            "$(jq -r .kind <<< "$line")" \
            "$(jq -r 'if .usd_max != null then "$\(.usd_used * 100 | round / 100) of $\(.usd_max | floor)" elif .kind == "claude" then .email else .plan // "-" end' <<< "$line")"
    done <<< "$rows"
    fleet_line "$rows"
}

# on_pace_word <epoch|null> <resets|null> -> "now", "Sat 01:00", or "after-reset" when it is not
# before the reset at this burn
on_pace_word() {
    local now="${CLAUDE_ACCT_NOW:-$(date +%s)}"
    if [[ -z "$1" || "$1" == null ]]; then
        [[ -n "$2" && "$2" != null ]] && printf after-reset || printf -
    elif (( $1 <= now )); then printf now
    else day_time "$1"; fi
}

# The Claude fleet sum, one definition for the fleet line, check pace and the textfile's
# claude_fleet_* series (hub-core burn.rs reads those and does not re-sum the rows). Claude accounts
# only: the session rate is theirs, and a codex or Lazer point is a different budget. Burn sums the
# readable paced rows; null when there is none, so an unread fleet publishes no figure rather than a
# quiet one. `rows` is those rows, for the back-on-pace times; `rate` is the points one working Opus
# session burns an hour, and `working_cost` the working sessions in Opus-equivalents (weight_of).
# `unread` is each Claude account that could not be read, with its live sessions and when it was last
# read: those sessions are in no burn figure, so the fleet line names it instead of reading low (bnb
# was unread five hours on 2026-11-18, and the sum counted 3 of 4 weeks without a word).
# The accounts are one pool, since a session moves to any of them (claude-acct move), and each one's
# reset refills it. A step is the moment just before an account's reset: what the pool holds then is
# every account's points left above its reserve (scaled by the machine-mode level, as in its room),
# plus a full week (less the reserve) for each account that reset before it. `keeps` is the steadiest
# burn the pool carries without going into the reserve: the lowest of each step's points over its
# hours from now, and of what the weeks give an hour for good, the reserve kept. `runs_out` is when this burn empties the pool into the reserve, null when it
# lasts to the last account's reset (the horizon: past it every week is fresh, and keeps says whether
# the burn fits). `spare` is how many more working Opus sessions the pool carries on top of this
# burn at the allowance ((keeps x over - burn) / rate, below 0 when the burn is past it):
# fleet-dispatch's pace target, so a Sonnet or Haiku session, burning less, leaves room for more
# (ar-3230). 2026-11-10: keeps was each account's points left over its own reset, which read 1.9/h
# with no reset counted, while the four weeks carried 2.1/h (ar-1529).
FLEET_JQ="$OVER_JQ"'
def fleet($now): [.[] | select(.kind == "claude")] as $c
    | [$c[] | select(.state == "ok" and .week_used != null and .paced)] as $a
    | ([$a[] | select(.resets != null)
        | ((.resets - $now) / 3600) as $at | (.window / 3600) as $h | (100 - .reserve) as $w
        # a cached read from before its reset: the week is fresh, and the next reset a window on
        | if $at > 0 then {left: ([$w - .week_used, 0] | max), week: $w, at: $at, hours: $h}
          else {left: $w, week: $w, at: ($at + $h), hours: $h} end] | sort_by(.at)) as $p
    | (if $a == [] then null else [$a[].burn] | add end) as $burn
    | ([$p[].left] | add // 0) as $left
    | [range(0; $p | length) as $k | {at: $p[$k].at, has: ($left + ([$p[0:$k][].week] | add // 0))}] as $steps
    | (if $p == [] then null
       else ([[$p[] | .week / .hours] | add] + [$steps[] | select(.at > 0) | .has / .at]) | min end) as $keeps
    | ($c[0].rate // null) as $rate
    | {live: ([$c[].live] | add // 0), working: ([$c[].working] | add // 0), working_cost: ([$c[].working_cost] | add // 0),
       rows: $a, rate: $rate, burn: $burn, keeps: $keeps,
       unread: [$c[] | select(.state == "unread") | {name, working, since: .read_at}],
       allowed: (if $keeps == null then null else $keeps * over end),
       spare: (if $keeps == null or $burn == null or ($rate // 0) <= 0 then null else ($keeps * over - $burn) / $rate | floor end),
       runs_out: (if $p == [] or $burn == null or $burn <= 0 then null
                  else first($steps[] | select(.has / $burn < .at) | $now + .has / $burn * 3600 | floor) // null end)};'

# allowance_text -> the allowance in force and where it comes from, for the fleet line: "400%
# (default)", "300% (override)", or "300% to Tue 22:00" for a window
allowance_text() {
    case "$BURN_OVER_SRC" in
        window\ *) printf '%s%% to %s' "$CLAUDE_ACCT_BURN_OVER_PCT" "$(date -d "@${BURN_OVER_SRC#window }" '+%a %H:%M')" ;;
        *) printf '%s%% (%s)' "$CLAUDE_ACCT_BURN_OVER_PCT" "$BURN_OVER_SRC" ;;
    esac
}

# fleet_line <usage rows> -> the Claude accounts in one line (FLEET_JQ): live sessions, burn against
# what the windows can carry, how many sessions that is at the allowance in force, and when the
# first one is back on pace, at this burn and with every session stopped.
fleet_line() {
    local j now="${CLAUDE_ACCT_NOW:-$(date +%s)}"
    j=$(jq -sc --argjson now "$now" "$FLEET_JQ"' fleet($now)
        | {live, working, working_cost, rate, burn: (.burn // 0), keeps: (.keeps // 0), spare, runs_out, unread,
           burn_at: ([.rows[] | select(.on_pace_burn != null) | {name, t: .on_pace_burn}] | min_by(.t)),
           idle_at: ([.rows[] | select(.on_pace_idle != null) | {name, t: .on_pace_idle}] | min_by(.t))}' <<< "$1") || return 0
    jq -r --argjson now "$now" --arg allow "$(allowance_text)" '
        def at: if .t <= $now then "\(.name) now" else "\(.name) \(.t | strflocaltime("%a %H:%M"))" end;
        "fleet: \(.live) live (\(.working) working"
        + (if (.working_cost * 10 | round) != .working * 10 then ", \(.working_cost * 10 | round / 10) at Opus cost" else "" end)
        + "), burn \(.burn * 10 | round / 10)/h vs \(.keeps * 10 | round / 10)/h sustainable"
        + " (" + ([if .keeps > 0 then "\(.burn / .keeps * 10 | round / 10)x" else empty end,
                  if .rate != null and .rate > 0 then "carries ~\(.keeps / .rate | floor) Opus" else empty end,
                  "allowance \($allow)",
                  if .spare == null then empty elif .spare > 0 then "room for ~\(.spare) more" else "no room" end]
                 | join(", ")) + ")"
        + (if .runs_out != null then ", into the reserve \(.runs_out | strflocaltime("%a %H:%M")) before the resets"
           else ", lasts to the resets" end)
        + ", back on pace: "
        + (if .burn_at != null then (.burn_at | at) else "not at this burn" end)
        + (if .idle_at != null then "; if idle \(.idle_at | at)" else "" end)
        + (.unread | map("; \(.name) unread"
            + (if .since != null then " since \(.since as $s | $s | strflocaltime(if $now - $s < 72000 then "%H:%M" else "%a %H:%M" end))" else "" end)
            + (if .working > 0 then ", its \(.working) working session\(if .working == 1 then "" else "s" end) not in the burn" else "" end)) | join(""))' <<< "$j"
}

# textfile [dir]: written to a temp file and renamed, so a scrape never reads half. With no dir
# it is the machine's collector dir (prom-textfile.sh), and a machine with none is skipped.
# With no dir it is also a fleet singleton: the file holds every source and the fleet sum, and
# the hub merges the series by account, so a second host's copy overwrites the first. Only the
# fleet-lease holder publishes; on another machine `fleet-lease renew` removes the copy, with the
# other singletons' textfiles (a fleet worker, with setup tokens only, read every source unread
# and blanked every Burn row, 2026-11-18), and one that cannot tell leaves it.
cmd_textfile() {
    local dir tmp lease=0
    dir=$(prom_textfile_target "${1:-}") || return 0
    if [[ -z "${1:-}" ]]; then
        # the units' own path (ExecCondition=%h/.local/bin/fleet-lease): a fleet worker's systemd
        # PATH has no ~/.local/bin, and a PATH lookup's 127 kept its stale copy
        "$HOME/.local/bin/fleet-lease" claude-acct-usage >/dev/null 2>&1 || lease=$?
        (( lease == 1 )) && return 0
        (( lease == 0 )) || { echo "claude-acct: textfile skipped, fleet-lease cannot tell who holds the lease (exit $lease)" >&2; return 0; }
    fi
    tmp=$(mktemp "$dir/.claude_acct.prom.XXXXXX") || return 1
    if all_json | jq -rs --argjson now "${CLAUDE_ACCT_NOW:-$(date +%s)}" "$FLEET_JQ"'
        # the Anthropic account rides every series as email, so usage history follows the account and
        # not the folder name; a row with no known email (non-Claude kinds, a logged-out dir) has none
        def lbls: "account=\"\(.name)\",kind=\"\(.kind)\"" + (if (.email // "") != "" then ",email=\"\(.email | gsub("\\\\"; "\\\\") | gsub("\""; "\\\"") | gsub("\n"; "\\n"))\"" else "" end);
        def rows($metric; f):
            .[] | f as $v | select($v != null) | "\($metric){\(lbls)} \($v)";
        (rows("claude_account_read_ok"; if .state == "unread" then 0 else 1 end)),
        (rows("claude_account_week_used_percent"; .week_used)),
        (rows("claude_account_week_gone_percent"; .week_gone)),
        (rows("claude_account_room"; if .state == "unread" then null elif .room.ok then 1 else 0 end)),
        (rows("claude_account_room_headroom_points"; .room.headroom_points)),
        (rows("claude_account_reserve_percent"; .room.reserve)),
        # 0 for a dollar budget, which has no pace line: its burn, keeps and back-on-pace are not read
        (rows("claude_account_paced"; if .paced == false then 0 else 1 end)),
        (.[] | select(.parent != null) | "claude_account_parent{\(lbls),parent=\"\(.parent)\"} 1"),
        # each refusal as a label, 1 on every reason that holds the account now (ok when it has room)
        (.[] | select(.state != "unread") | lbls as $l | (.room.reasons | if . == [] then ["ok"] else . end)[]
            | "claude_account_room_reason{\($l),reason=\"\(.)\"} 1"),
        (rows("claude_account_five_hour_percent"; .five_hour)),
        (rows("claude_account_five_hour_resets_timestamp_seconds"; .five_hour_resets)),
        (rows("claude_account_resets_timestamp_seconds"; .resets)),
        (rows("claude_account_run_out_timestamp_seconds"; .run_out)),
        (rows("claude_account_live_sessions"; .live)),
        (rows("claude_account_working_cost"; .working_cost)),
        (rows("claude_account_burn_points_per_hour"; if .week_used == null then null else .burn end)),
        (rows("claude_account_sustain_points_per_hour"; .sustain)),
        (rows("claude_account_on_pace_idle_timestamp_seconds"; .on_pace_idle)),
        (rows("claude_account_on_pace_burn_timestamp_seconds"; .on_pace_burn)),
        # the fleet sum (FLEET_JQ); no burn or sustain line when no Claude account was summed
        (fleet($now) | (.rate // empty | "claude_fleet_session_rate_points_per_hour \(.)"),
            "claude_fleet_live_sessions \(.live)",
            (.burn // empty | "claude_fleet_burn_points_per_hour \(.)"),
            (.keeps // empty | "claude_fleet_sustain_points_per_hour \(.)"),
            # the allowance in force times what the pool sustains, and the sessions more it carries
            # (spare, the pace target of dispatch), so a surface shows them without a second formula
            (.allowed // empty | "claude_fleet_allowed_points_per_hour \(.)"),
            (.spare // empty | "claude_fleet_spare_sessions \(.)"),
            (.runs_out // empty | "claude_fleet_run_out_timestamp_seconds \(.)")),
        (rows("claude_account_cost_24h_usd"; .usd_24h)),
        (rows("claude_account_usd_used"; .usd_used)),
        (rows("claude_account_usd_budget"; .usd_max))' >> "$tmp" &&
        chmod 0644 "$tmp" && mv -f "$tmp" "$dir/claude_acct.prom"; then
        return 0
    fi
    rm -f "$tmp"
    return 1
}

# gateway [--out FILE] -> one JSON snapshot of who spends on the gateway, read with the viewer key
# (harnesses.json gateway.reader_key_file): teams and keys with their spend, budget and the
# metadata.consumer and metadata.priority the keys were minted with; the sources file's rows; and the
# config's model_group_alias and fallbacks (the viewer key reads neither, so they come from
# apps/litellm/config.yaml at the home-config clone's upstream tip, ${HOME_CONFIG:-~/dev/home/home-config},
# not its working tree, which may sit on a branch; CLAUDE_ACCT_GATEWAY_CONFIG names a file instead;
# null when neither reads). Only
# named fields are copied, so a key's secret and token hash never reach the file. Written to a temp
# file and renamed; a team or key list that cannot be read leaves the old snapshot and exits 1.
cmd_gateway() {
    local out="$CACHE/gateway.json" reader teams keys conf routing=null srcs tmp name kind ref reserve parent priority alias
    case "${1:-}" in
        --out) out=${2:?usage: claude-acct gateway [--out FILE]} ;;
        "") ;;
        *) echo "usage: claude-acct gateway [--out FILE]" >&2; return 2 ;;
    esac
    reader=$(jq -er '.gateway.reader_key_file' "$HARNESSES" 2>/dev/null) ||
        { echo "claude-acct: gateway: $HARNESSES names no gateway.reader_key_file" >&2; return 1; }
    reader=${reader/#\~/$HOME}
    teams=$(gateway_get "$reader" /team/list) && keys=$(gateway_get "$reader" "/key/list?return_full_object=true&size=100") ||
        { echo "claude-acct: gateway: the team or key list could not be read; $out is unchanged" >&2; return 1; }
    # One page of 100 keys covers the gateway many times over; a second page fails loudly rather
    # than show a Consumers table with keys missing.
    if jq -e '(.total_pages // 1) > 1 or (.total_count // 0) > ((.keys // []) | length)' <<<"$keys" >/dev/null 2>&1; then
        echo "claude-acct: gateway: more keys than one page (size=100); $out is unchanged" >&2; return 1
    fi
    local hc=${HOME_CONFIG:-$HOME/dev/home/home-config} yml
    if [[ -n "${CLAUDE_ACCT_GATEWAY_CONFIG:-}" ]]; then
        conf=$CLAUDE_ACCT_GATEWAY_CONFIG; yml=$(cat "$conf" 2>/dev/null)
    else
        conf="$hc @{upstream}:apps/litellm/config.yaml"; yml=$(git -C "$hc" show '@{upstream}:apps/litellm/config.yaml' 2>/dev/null)
    fi
    if [[ -z "$yml" ]]; then
        echo "claude-acct: gateway: $conf could not be read; aliases and fallbacks are null" >&2; conf=''
    elif ! routing=$(python3 -I -c '
import json, sys, yaml
r = (yaml.safe_load(sys.stdin) or {}).get("router_settings") or {}
fb = {}
for edge in r.get("fallbacks") or []:
    fb.update(edge)
print(json.dumps({"aliases": r.get("model_group_alias") or {}, "fallbacks": fb}))' <<<"$yml" 2>/dev/null); then
        echo "claude-acct: gateway: $conf could not be read; aliases and fallbacks are null" >&2; routing=null; conf=''
    fi
    # A litellm-key source names its key by file; its alias, which the key list carries, comes from
    # /key/info on that key, so the Consumers row of the key can show the source's room.
    srcs=$(sources | while IFS=$'\037' read -r name kind ref reserve _ parent _ priority _; do
        alias=''
        [[ "$kind" == litellm-key ]] && alias=$(gateway_get "$ref" /key/info | jq -r '.info.key_alias // empty' 2>/dev/null)
        jq -nc --arg name "$name" --arg kind "$kind" --arg reserve "$reserve" --arg parent "$parent" \
            --arg priority "$priority" --arg key "$alias" 'def n: if . == "" then null else . end;
            {name: $name, kind: $kind, reserve: ($reserve | tonumber? // null), parent: ($parent | n),
             priority: ($priority | n), key: ($key | n)}'
    done | jq -s .)
    mkdir -p "$(dirname "$out")" || return 1
    tmp=$(mktemp "$(dirname "$out")/.gateway.json.XXXXXX") || return 1
    if jq -n --argjson teams "$teams" --argjson keys "$keys" --argjson srcs "$srcs" --argjson routing "$routing" \
        --arg url "$(jq -r .gateway.url "$HARNESSES")" --arg conf "$conf" --argjson at "${CLAUDE_ACCT_NOW:-$(date +%s)}" '
        def budget: {spend, max_budget, blocked: (.blocked // false), budget_duration, budget_reset_at};
        ($teams | if type == "array" then . else (.teams // .data // []) end) as $t
        | ($t | map({(.team_id): .team_alias}) | add // {}) as $alias
        | {at: $at, url: $url, config: (if $conf == "" then null else $conf end),
           teams: [$t[] | {alias: .team_alias, id: .team_id} + budget
                   + {priority: .metadata.priority, note: .metadata.note}],
           keys: [($keys.keys // [])[] | select(type == "object") | {alias: .key_alias, team: $alias[.team_id // ""]} + budget
                  + {models: (.models // []), consumer: .metadata.consumer, priority: .metadata.priority, note: .metadata.note}],
           sources: $srcs, aliases: $routing.aliases, fallbacks: $routing.fallbacks}' > "$tmp"; then
        mv "$tmp" "$out"
    else
        rm -f "$tmp"; echo "claude-acct: gateway: the answer was not the expected JSON; $out is unchanged" >&2; return 1
    fi
}

# room_source <name> [--json] -> the verdict of one source (a Claude account or a row of the sources
# file) as a sentence on stdout: "<name>: room, ..." and exit 0, or why not and exit 1 (2 when it cannot
# be read, 3 when no such source). A refused `parent` says which pool. --json prints the source's row
# instead (its room.reasons: agentctl-run refuses a headless call on some reasons only), same exit.
room_source() {
    local name="$1" json='' model='' row parent='' kind='' ref='' why
    shift
    while (( $# )); do
        case "$1" in
            --json) json=1 ;;
            --model) model=${2:?usage: claude-acct room --source <name> [--model <gateway model>] [--json]}; shift ;;
            *) echo "usage: claude-acct room --source <name> [--model <gateway model>] [--json]" >&2; return 3 ;;
        esac
        shift
    done
    IFS=$'\037' read -r _ kind ref _ _ parent _ < <(sources 2>/dev/null | awk -F'\037' -v n="$name" '$1 == n')
    row=$(USAGE_ONLY="$name $parent" all_json nospend | jq -c --arg n "$name" 'select(.name == $n)')
    if [[ -z "$row" ]]; then
        echo "claude-acct: no source '$name' in $CONF or $SRC_CONF" >&2
        return 3
    fi
    # The model's own route: a spent deployment window refuses a start the key's budget admits.
    if [[ -n "$model" && "$kind" == litellm-* ]] && jq -e .room.ok <<< "$row" >/dev/null &&
        why=$(route_refused "$ref" "$model") && [[ -n "$why" ]]; then
        row=$(jq -c --arg w "$why" '.room += {ok: false, reason: "route", reasons: ((.room.reasons // []) + ["route"]), why: $w}' <<< "$row")
    fi
    # The route's pace: a window budget carries so many runs at the source's run_usd (route_paced).
    local run_usd
    run_usd=$(jq -r '.run_usd // empty' <<< "$row")
    if [[ -n "$model" && -n "$run_usd" && "$kind" == litellm-* ]] && jq -e .room.ok <<< "$row" >/dev/null &&
        why=$(route_paced "$ref" "$model" "$name" "$run_usd") && [[ -n "$why" ]]; then
        row=$(jq -c --arg w "$why" '.room += {ok: false, reason: "route_pace", reasons: ((.room.reasons // []) + ["route_pace"]), why: $w}' <<< "$row")
    fi
    if [[ -n "$json" ]]; then jq -c . <<< "$row"
    else jq -r '"\(.name): " + (if .room.ok then "room, \(.week_used // 0 | floor)% of its window used"
        + (if .usd_max != null then " ($\(.usd_used * 100 | round / 100) of $\(.usd_max | floor))" else "" end)
        else .room.why end)' <<< "$row"
    fi
    jq -e '.room.ok' <<< "$row" >/dev/null && return 0
    [[ "$(jq -r .room.reason <<< "$row")" == unread ]] && return 2
    return 1
}

# room [--json]: where an automatic start may go. Only automatic starts ask this: `cl`, a running
# session and a hand start are never refused. The verdict is each usage row's `room` object, written
# once in usage_json; this picks the best account whose room is ok and says why when none is. --json
# prints the same answer for readers: {pick (that account's name, or null), why (the refusal
# sentence, or null), accounts (every account's name, dir, state, rank, live and room), sources (every
# row of the sources file, the same fields with its kind: fleet-dispatch routes over them), fleet
# (FLEET_JQ's keeps, rate, burn, working_cost and spare, and carries: the working Opus sessions the
# accounts sustain at pace, null unread; spare is fleet-dispatch's pace target)}.
cmd_room() {
    local all rows json=0 pick pdir pline unread closest cwhy within why=''
    case "${1:-}" in
        "") ;;
        --json) json=1 ;;
        --source) shift; room_source "${1:?usage: claude-acct room --source <name> [--model <gateway model>] [--json]}" "${@:2}"; return ;;
        *) echo "usage: claude-acct room [--json | --source <name> [--model <gateway model>] [--json]]" >&2; return 3 ;;
    esac
    # Only --json has a reader for the sources; the sentence is about the accounts alone.
    if (( json )); then all=$(all_json nospend | jq -s .); else all=$(usage_json nospend | jq -s .); fi
    rows=$(jq '[.[] | select(.kind == "claude")]' <<< "$all")
    # One read: the best account with room, whether one is unread, and the account a refused start
    # would fall back to (pick's best) with its own why and clock (tail: the RUNS-OUT or RESETS column
    # of status, from the same row). `within` adds, in rank order, every other account refused while
    # within its weekly pace (its live sessions, 5h window or max_live alone): a committed account
    # ranks behind every paced one, so naming the closest alone hid why a mostly unused week was
    # refused. Only a committed one carries the week clock, which is what refuses it. \x1f, not a
    # tab: read collapses a run of tabs, so an empty field would shift the rest.
    IFS=$'\x1f' read -r pick pdir pline unread closest cwhy within < <(jq -r '
        def tail: if .run_out != null then ", runs out \(.run_out | strflocaltime("%a %H:%M")) at this rate"
                  elif .resets != null then ", lasts to its reset \(.resets | strflocaltime("%a %H:%M"))" else "" end;
        ([.[] | select(.room.ok)] | sort_by(.rank) | first) as $p
        | ([.[] | select(.state != "unread")] | sort_by(.rank) | first) as $c
        | [($p.name // ""), ($p.dir // ""),
           ($p // {} | "\(.name) (\(.week_used // "?")% of its week, \(.week_gone // "?" | if type == "number" then floor else . end)% gone)"),
           any(.[]; .state == "unread"), ($c.name // ""), ($c // {} | if .room == null then "" else .room.why + tail end),
           ([.[] | select(.state != "unread" and .name != $c.name and (.room.ok | not)
                          and (.room.reasons - ["committed", "five_hour", "max_live"]) == [])]
            | sort_by(.rank)
            | map("; \(.name) is within its weekly pace but \(.room.why)\(if .room.reason == "committed" then tail else "" end)")
            | join(""))]
        | map(tostring) | join("\u001f")' <<< "$rows")
    if [[ -n "$pick" ]]; then :
    elif [[ "$unread" == true ]]; then why="no account has room and one cannot be read"
    elif [[ -z "$closest" ]]; then why="no account has room under its weekly pace and after its working sessions"
    else
        # Name the account a start would fall back to and why room refused it, from its own row: "no
        # account has room" alone read as every account being full (2026-11-05).
        why="no account has room; $closest is the closest, $cwhy$within"
    fi
    if (( json )); then
        jq --arg p "$pick" --arg w "$why" --argjson now "${CLAUDE_ACCT_NOW:-$(date +%s)}" "$FLEET_JQ"'{pick: (if $p == "" then null else $p end), why: (if $w == "" then null else $w end),
            accounts: [.[] | select(.kind == "claude") | {name, dir, state, rank, live, week_used, week_gone, five_hour, room}],
            sources: [.[] | select(.kind != "claude") | {name, kind, state, rank, live, max_live, max_live_basis, alert, week_used, week_gone, room}],
            fleet: (fleet($now) | {keeps, rate, burn, working_cost, spare, carries: (if .keeps != null and (.rate // 0) > 0 then (.keeps / .rate | floor) else null end)})}' <<< "$all"
    elif [[ -n "$pick" ]]; then
        echo "claude-acct: room on $pline" >&2
        printf '%s\n' "$pdir"
    else
        echo "claude-acct: $why" >&2
    fi
    [[ -n "$pick" ]] && return 0
    [[ "$unread" == true ]] && return 2
    return 1
}

# models <source>: the ids the source's key may call, one a line, from the gateway's /v1/models (ladder-scout's catalog).
cmd_models() {
    local name="${1:?usage: claude-acct models <source>}" kind='' ref='' out
    IFS=$'\037' read -r _ kind ref _ < <(sources 2>/dev/null | awk -F'\037' -v n="$name" '$1 == n')
    if [[ "$kind" != litellm-key ]]; then
        echo "claude-acct: no litellm-key source '$name' in $SRC_CONF for this host" >&2
        return 3
    fi
    out=$(gateway_get "$ref" /v1/models | jq -r '.data | map(.id) | .[]') || {
        echo "claude-acct: could not read $name's models from the gateway" >&2
        return 1
    }
    [[ -z "$out" ]] || printf '%s\n' "$out"
}

# check usage: can every account be read? A failed read sends every start to the default account
# without a word, which is how the 2026-10-30 API change went two days unseen.
cmd_check() {
    local rows
    case "${1:-}" in
        usage)
            # TTL=0 in the subshell: every account is read live, so a read that fails now trips even
            # while an earlier success is still cached (the cache is for starts, not for this judge)
            rows=$(TTL=0; usage_json nospend | jq -s .)
            jq -r 'map(select(.state == "unread") | .name) as $bad |
                if ($bad | length) > 0 then "cannot read usage of \($bad | join(", "))"
                else "usage read on \(length) accounts" end' <<< "$rows"
            [[ "$(jq 'any(.state == "unread")' <<< "$rows")" == false ]] ;;
        pace)
            # A source past its line is the room verdict's own words (pace, reserve, capped), never a
            # second formula. The Claude accounts are one pool (FLEET_JQ): one account past its own
            # line trips nothing while the pool lasts to the resets, since a session moves and each
            # reset refills it; the pool running into the reserve before then trips. An unread source
            # cannot be told on pace, so it trips too; a Claude account's unread is check usage's (the
            # claude-acct-usage watch), so it is not named twice. A source marked alert=off (a test
            # pool) is never over pace here, though an unread one still trips: dispatch keeps to its
            # room either way.
            local now="${CLAUDE_ACCT_NOW:-$(date +%s)}"
            rows=$(all_json nospend | jq -sc --argjson now "$now" "$FLEET_JQ"' (fleet($now) | .runs_out) as $out
                | {pool: $out, rows: [.[] | {name, unread: (.state == "unread" and .kind != "claude"),
                    over: (if .alert and .kind != "claude" then [(.room.reasons // [])[] | select(. == "pace" or . == "reserve" or . == "capped")] else [] end)}]}')
            jq -r '.pool as $out | .rows | (map(select(.unread) | .name)) as $u | (map(select(.over != [])) | map("\(.name) \(.over | join("+"))")) as $o
                | if length == 0 then "no sources read"
                  elif $u == [] and $o == [] and $out == null then "every source on pace (\(length) sources)"
                  else [if $u != [] then "unread: \($u | join(", "))" else empty end,
                        if $out != null then "the Claude accounts run into the reserve \($out | strflocaltime("%a %H:%M")), before the resets" else empty end,
                        if $o != [] then "over pace: \($o | join(", "))" else empty end] | join("; ") end' <<< "$rows"
            # no row at all is nothing read, never a quiet green
            [[ "$(jq '.pool == null and (.rows | length > 0 and all(.unread == false and .over == []))' <<< "$rows")" == true ]] ;;
        underuse)
            # The other side of pace: a plan source (Codex) whose week resets within UNDERUSE_HOURS
            # with its use UNDERUSE_GAP_PCT or more points under the week gone loses that use at the
            # reset. Names the sources to judge (default every paced source); an unread one is
            # check pace's, and a name not in the sources is nothing read, never a quiet green.
            local hours gap now="${CLAUDE_ACCT_NOW:-$(date +%s)}"
            hours=$(pace_get UNDERUSE_HOURS); gap=$(pace_get UNDERUSE_GAP_PCT)
            [[ -n "$hours" && -n "$gap" ]] || return 2
            shift
            rows=$(all_json nospend | jq -s --argjson now "$now" --argjson hours "$hours" --argjson gap "$gap" --args '
                ($ARGS.positional) as $want
                | [.[] | select(.kind != "claude" and .paced and (($want == []) or (.name as $n | $want | index($n))))] as $rs
                | {missing: [$want[] | select(. as $n | $rs | map(.name) | index($n) | not)],
                   under: [$rs[] | select(.state != "unread" and .resets != null and .week_used != null and .week_gone != null
                       and (.resets - $now) <= $hours * 3600 and (.week_gone - .week_used) >= $gap)
                     | "\(.name) \(.week_used | floor)% used, \(.week_gone | floor)% of its week gone, resets in \((.resets - $now) / 3600 | floor)h"],
                   n: ($rs | length)}' "$@")
            # a name that is another host's row (host=) is not read here, and the probe says so, not a fault
            jq -r --argjson elsewhere "$(sources_elsewhere | jq -R . | jq -sc .)" \
                'if .missing != [] and (.missing - $elsewhere) == [] then "unreadable: \(.missing | join(", ")) is a source of another host (host= in the sources file)"
                elif .missing != [] then "not a paced source: \(.missing | join(", "))"
                elif .n == 0 then "no sources read"
                elif .under != [] then "under-used near its reset: \(.under | join("; "))"
                else "no source under-used near its reset (\(.n) sources)" end' <<< "$rows"
            [[ "$(jq '.missing == [] and .n > 0 and .under == []' <<< "$rows")" == true ]] ;;
        tokens) check_tokens ;;
        *) echo "usage: claude-acct check usage|pace|underuse|tokens [source...]" >&2; return 2 ;;
    esac
}

# --- move ------------------------------------------------------------------------------
# A session stopped on one account's limit carries on from the other: the accounts share
# projects/ (the transcripts) and sessions/ (the live registry), so `claude --resume <id>`
# continues the same conversation from either one.

PROC="${CLAUDE_ACCT_PROC:-/proc}"
REGISTRY="$MAIN_DIR/sessions"
# A TUI dialog and a new registry entry have no event to await, so move looks at the pane and
# the registry on this one cadence, for at most MOVE_TIMEOUT seconds each.
MOVE_POLL="${CLAUDE_ACCT_POLL:-0.5}"
MOVE_TIMEOUT="${CLAUDE_ACCT_MOVE_TIMEOUT:-60}"
# Flags a resumed claude keeps from the one it replaces; the rest (a brief, --resume) are spent.
CARRY_VALUE=(--model --permission-mode --disallowedTools)
CARRY_BARE=(--dangerously-skip-permissions --allow-dangerously-skip-permissions)
# The from= of a session that ran on the gateway, the name agent-panel gives it: never an account dir.
GATEWAY_FROM=gateway

# norm_dir <dir> -> the account dir as accounts() spells it: empty for the main account
norm_dir() {
    local d="${1%/}"
    [[ "$d" == "$MAIN_DIR" ]] && d=""
    printf '%s' "$d"
}

# config_dir_of <pid> -> the CLAUDE_CONFIG_DIR that process runs under, empty = main
config_dir_of() {
    norm_dir "$(env_of "$1" CLAUDE_CONFIG_DIR)"
}

# gateway_of <pid> -> the ANTHROPIC_BASE_URL that process runs on (claude-lazer), empty = an account
gateway_of() {
    env_of "$1" ANTHROPIC_BASE_URL
}

# env_of <pid> <name> -> the first value of that variable in the process environment, read with
# builtins (live_of calls it for every running claude)
env_of() {
    local kv
    while IFS= read -r -d '' kv || [[ -n "$kv" ]]; do
        [[ "$kv" == "$2="* ]] && { printf '%s' "${kv#"$2="}"; return 0; }
    done 2>/dev/null < "$PROC/$1/environ"
    return 0
}

# ppid_of <pid> -- the fourth field of stat, read after the comm, which may hold spaces
ppid_of() {
    local st
    st=$(cat "$PROC/$1/stat" 2>/dev/null) || return 1
    st="${st##*) }"
    printf '%s' "$st" | cut -d' ' -f2
}

# descends <pid> <ancestor> -- the process is the ancestor or runs somewhere under it
descends() {
    local p="$1" n
    for ((n = 0; n < 16; n++)); do
        [[ "$p" == "$2" ]] && return 0
        p=$(ppid_of "$p") || return 1
        [[ -n "$p" && "$p" != 0 && "$p" != 1 ]] || return 1
    done
    return 1
}

# name_of <dir> -> the account's name in the accounts file, or the dir itself
name_of() {
    local name dir
    while IFS=$'\037' read -r name dir; do
        [[ "$dir" == "$1" ]] && { printf '%s' "$name"; return; }
    done < <(accounts)
    printf '%s' "${1:-default}"
}

# carry_flags <pid> -> the CARRY_* flags from its command line, shell-quoted
carry_flags() {
    local -a argv out=()
    local i a f
    mapfile -d '' -t argv < "$PROC/$1/cmdline" 2>/dev/null || return 0
    for ((i = 1; i < ${#argv[@]}; i++)); do
        a="${argv[i]}"
        for f in "${CARRY_BARE[@]}"; do [[ "$a" == "$f" ]] && out+=("$a"); done
        for f in "${CARRY_VALUE[@]}"; do
            if [[ "$a" == "$f" && -n "${argv[i+1]:-}" ]]; then out+=("$a" "${argv[i+1]}"); ((i++))
            elif [[ "$a" == "$f="* ]]; then out+=("$f" "${a#*=}"); fi
        done
    done
    ((${#out[@]})) && printf '%q ' "${out[@]}"
    return 0
}

# hold_refusal <verb> <status> <stop shells 0|1> -> why this session's claude must not exit
#   now, or nothing (exit 1) when it may
# A session with background shells exits only with --stop-shells. The /exit dialog's other
# way out, "Move to background", forks the conversation into a `claude daemon` session that
# stays on the old account: a second agent in the same worktree once that account resets,
# and on 2026-10-29 it did not keep agent-35's shell alive either.
hold_refusal() {
    case "$2" in
        busy)    echo "busy mid-turn; $1 it once the turn ends"; return 0 ;;
        waiting) echo "waiting in a permission or question dialog; answer it first"; return 0 ;;
        shell)   [[ "${3:-0}" == 1 ]] || { echo "background shells are running; $1 it once they finish, or pass --stop-shells to stop them"; return 0; } ;;
        idle) ;;
        *)       echo "unknown session status '${2:-none}'"; return 0 ;;
    esac
    return 1
}

# refusal <status> <from dir> <to dir> <score> <name> <note> <stop shells 0|1> [chosen]
#   -> why this session must not move, or nothing (exit 1) when it may: hold_refusal, then
#   whether the account it would move to has room for it. That account is the best one, or
#   with `chosen` set, the one --to named.
refusal() {
    hold_refusal move "$1" "${7:-0}" && return 0
    if [[ -n "${8:-}" ]]; then
        if [[ -z "$4" ]]; then echo "no usage data for $5, so it is not known to have room"; return 0; fi
        if awk -v s="$4" 'BEGIN { exit !(s >= 100) }'; then echo "$5 has no room ($6)"; return 0; fi
        if [[ "$2" == "$3" ]]; then echo "already on $5 ($6)"; return 0; fi
        return 1
    fi
    if [[ -z "$4" ]]; then echo "no usage data, so no account is known to have room"; return 0; fi
    if awk -v s="$4" 'BEGIN { exit !(s >= 100) }'; then
        echo "no account has room (the best is $5: $6)"; return 0
    fi
    if [[ "$2" == "$3" ]]; then echo "already on $5, the account with the most room ($6)"; return 0; fi
    return 1
}

# shell_kind <command> -> local, remote or other. local is a gate, suite or Unity run on this
# machine: stopping it throws the run away. remote is a wait on GitHub (`gh-run-wait`, `gh run
# watch`, `gh pr checks --watch`, an `until ... gh ...; do sleep` loop): the run goes on without it,
# and a resumed session re-checks it in one call. A command that is both is local.
shell_kind() {
    local re_local='(^|[^[:alnum:]_.-])(ci-gate|suite|run)\.sh([^[:alnum:]_.-]|$)|(^|[/[:space:]])Unity([[:space:]]|$)|-batchmode'
    local re_loop='(^|[;&|({[:space:]])(until|while)[[:space:]].*gh[[:space:]].*;[[:space:]]*do[[:space:]].*sleep'
    local re_waiter='(^|[^[:alnum:]_.-])gh-run-wait([^[:alnum:]_.-]|$)'
    if [[ "$1" =~ $re_local ]]; then echo local
    elif [[ "$1" =~ $re_waiter || "$1" =~ gh[[:space:]]+run[[:space:]]+watch || "$1" =~ $re_loop ||
            ( "$1" =~ gh[[:space:]]+pr[[:space:]]+checks && "$1" == *--watch* ) ]]; then echo remote
    else echo other; fi
}

# shells_refusal <bg_shells lines> -> why park must not stop these shells, or nothing (exit 1)
# when every one is a remote wait. A local run is named first: it is the costly one to lose.
shells_refusal() {
    local kind pid cmd
    for kind in local other; do
        while read -r pid cmd; do
            [[ -n "$pid" && "$(shell_kind "$cmd")" == "$kind" ]] || continue
            if [[ "$kind" == local ]]; then
                echo "a local gate or suite is running ($pid: ${cmd:0:80}); stopping it throws the run away, so park it once the run ends"
            else
                echo "a background shell is not a remote wait ($pid: ${cmd:0:80}); park it once it ends"
            fi
            return 0
        done <<< "$1"
    done
    return 1
}

# dialog_choice <screen> -> the number of /exit's "Exit and stop tasks" option
dialog_choice() {
    grep -oE '([0-9])\. Exit and stop tasks' <<< "$1" | awk 'NR==1' | cut -c1
}

# bg_shells <pid> -> "pid  command" for each background shell that claude runs: a child
# shell sourcing one of its shell snapshots, the way the Bash tool starts a command. The whole
# command, since shell_kind reads its tail; a listing cuts it.
bg_shells() {
    local f st c
    for f in "$PROC"/[0-9]*/stat; do
        { read -r st < "$f"; } 2>/dev/null || continue   # a process may end mid-scan
        st="${st##*) }"; st="${st#* }"
        [[ "${st%% *}" == "$1" ]] || continue
        c=$(tr '\0' ' ' < "${f%/stat}/cmdline" 2>/dev/null)
        [[ "$c" == *shell-snapshots* ]] || continue
        [[ "$c" == *"eval '"* ]] && c="${c#*eval \'}"
        f="${f%/stat}"
        printf '%s  %s\n' "${f##*/}" "$c"
    done
}

# find_claude <server> <session> [window] [pane] -> "pid US pane US pane_pid US registry file US
# window index" for each live claude in the session's panes (only that window's, by index or
# name, or only that pane, when given): one whose registered pid is the pane's process or under it.
find_claude() {
    local pane ppid widx wname f pid
    while read -r pane ppid widx wname; do
        [[ -z "${4:-}" || "$pane" == "$4" ]] || continue
        [[ -z "${3:-}" || "$widx" == "$3" || "$wname" == "$3" ]] || continue
        for f in "$REGISTRY"/*.json; do
            [[ -f "$f" ]] || continue
            pid=$(jq -r '.pid // empty' "$f" 2>/dev/null)
            [[ -n "$pid" && -d "$PROC/$pid" ]] || continue
            descends "$pid" "$ppid" || continue
            printf '%s\037%s\037%s\037%s\037%s\n' "$pid" "$pane" "$ppid" "$f" "$widx"
        done
    done < <(tmux -L "$1" list-panes -s -t "=$2:" -F '#{pane_id} #{pane_pid} #{window_index} #{window_name}' 2>/dev/null)
}

# has_window <server> <session> <window> -- the session has that window, by index or name
has_window() {
    tmux -L "$1" list-windows -t "=$2:" -F '#{window_index} #{window_name}' 2>/dev/null |
        awk -v w="$3" '{ i = $1; sub(/^[^ ]* /, ""); if (i == w || $0 == w) f = 1 } END { exit !f }'
}

# pane_session <server> <pane id> -> the tmux session that pane is in; fails when the server has
# no such pane
pane_session() {
    local s
    s=$(tmux -L "$1" display-message -p -t "$2" '#{session_name}' 2>/dev/null) && [[ -n "$s" ]] && printf '%s' "$s"
}

# await <what> <command...> -- run the command every MOVE_POLL seconds until it succeeds
await() {
    local what="$1" end=$(( $(date +%s) + MOVE_TIMEOUT ))
    shift
    until "$@" > /dev/null; do
        (( $(date +%s) >= end )) && { echo "claude-acct: timed out after ${MOVE_TIMEOUT}s waiting for $what" >&2; return 1; }
        sleep "$MOVE_POLL"
    done
}

# exited <server> <pane> <pid> <stop shells 0|1> -- the claude is gone; with --stop-shells
# it answers the background-shell dialog on the way with "Exit and stop tasks", once per claude:
# the dialog stays on screen until claude is gone, and a second answer would be typed into the
# pane's shell ahead of the resume (ar-5592). A dialog that closes and comes back is answered
# again; an answer lost while it stays drawn is not resent, and the move times out on it.
# EXIT_ANSWERED lives across polls only because await runs exited in this shell, never a subshell.
EXIT_ANSWERED=""
exited() {
    [[ -d "$PROC/$3" ]] || return 0
    [[ "$4" == 1 ]] || return 1
    local n
    n=$(dialog_choice "$(tmux -L "$1" capture-pane -p -t "$2" 2>/dev/null)")
    [[ -n "$n" ]] || { EXIT_ANSWERED=""; return 1; }
    [[ "$EXIT_ANSWERED" != "$3" ]] && tmux -L "$1" send-keys -t "$2" "$n" && EXIT_ANSWERED=$3
    return 1
}

# trust_step <server> <pane> -- one step through Claude's folder trust prompt, taken from what
# the pane shows: the cursor on "No, exit" (the default) gets Down, on "Yes, I trust this folder"
# gets Enter. One key a call, each sent only once the redraw of the last one shows: two keys
# sent back to back can lose the first. An account that never opened a folder (or, for a
# worktree, its main checkout) asks; Claude keeps that trust per account in .claude.json, whose
# trust keys claude-acct never writes. Fails when the pane shows no trust prompt.
TRUST_CURSOR=$'\xe2\x9d\xaf'
trust_step() {
    local screen
    screen=$(tmux -L "$1" capture-pane -p -t "$2" 2>/dev/null)
    grep -qF 'Yes, I trust this folder' <<<"$screen" || return 1
    leave_mode "$1" "$2" || return 0
    if grep -qE "$TRUST_CURSOR *Yes, I trust this folder" <<<"$screen"; then
        tmux -L "$1" send-keys -t "$2" Enter
    else
        tmux -L "$1" send-keys -t "$2" Down
    fi
}

# resumed <session id> <old pid> <to dir> -- a new claude registered that session id on the
# target account; prints "pid status" for it
# resumed_or_trusted <server> <pane> <resumed args...> -- resumed, stepping through the folder
# trust prompt on the way. The same conversation already ran in that folder on its old account,
# so the trust carries over.
resumed_or_trusted() {
    local server="$1" pane="$2"
    shift 2
    resumed "$@" && return 0
    trust_step "$server" "$pane"
    return 1
}

# ready_or_trusted <server> <pane> <ready text> -- the pane shows <ready text> and no trust
# prompt; a trust prompt gets its next step.
ready_or_trusted() {
    trust_step "$1" "$2" && return 1
    tmux -L "$1" capture-pane -p -t "$2" 2>/dev/null | grep -qF -- "$3"
}

# cmd_trust <server> <pane> <ready text> -- for a launcher that started a claude in a fresh
# folder (fleet-dispatch start): wait for it, answering the trust prompt once.
cmd_trust() {
    (($# == 3)) || { echo "usage: claude-acct trust <server> <pane> <ready text>" >&2; return 2; }
    await "claude in $1 $2 to show \"$3\"" ready_or_trusted "$1" "$2" "$3"
}
resumed() {
    local f pid
    for f in "$REGISTRY"/*.json; do
        [[ -f "$f" ]] || continue
        [[ "$(jq -r '.sessionId // empty' "$f" 2>/dev/null)" == "$1" ]] || continue
        pid=$(jq -r '.pid // empty' "$f")
        [[ -n "$pid" && "$pid" != "$2" && -d "$PROC/$pid" ]] || continue
        [[ "$(config_dir_of "$pid")" == "$3" ]] || continue
        printf '%s %s\n' "$pid" "$(jq -r '.status // "-"' "$f")"
        return 0
    done
    return 1
}

# --- park and unpark -------------------------------------------------------------------
# A parked session costs nothing: its claude has exited, so no background task finishing and
# no peer's message can wake it to re-read its context (on 2026-11-02, 48% of the fleet's
# tokens were such wakes on sessions waiting on CI). park exits it and writes a ledger with
# what unpark needs; unpark resumes it in the same pane on the account best() names then.
# move is park and unpark back to back, so there is one exit path and one resume path.
PARKED="${CLAUDE_ACCT_PARKED_DIR:-$HOME/.agent/parked}"

# park_lock <tmux session> -- one park, move or unpark of a session's ledgers at a time, held on
# fd PARK_FD until park_unlock or exit. fleet-dispatch's preempt and its unpark, fleet-shepherd's
# budget park, fleet-pace and the human each decide from their own read of the pane; two at once
# would type two resumes into one pane. A holder runs at most two awaits (a move), so a wait of
# three sees its result; past that the caller is refused. A dot file, so ledger readers skip it.
park_lock() {
    park_unlock
    mkdir -p "$PARKED" && exec {PARK_FD}>"$PARKED/.lock.$1" || { refuse "cannot write to $PARKED"; return; }
    flock -w "$((3 * MOVE_TIMEOUT))" "$PARK_FD" && return 0
    park_unlock
    refuse "another park or unpark of $1 still runs after $((3 * MOVE_TIMEOUT))s; try again once it ends"
}
park_unlock() { [[ -z "${PARK_FD:-}" ]] || exec {PARK_FD}>&-; PARK_FD=""; }

# record <ledger key> <what happened> [parked|unparked <session id>] -- park, move and unpark
# change the fleet the way a hold does, so each pages low with a `park: <session>` title, as
# agent-hold does with `hold:` and `go:`, and writes a line on the audit log, which keeps the
# history (the ledger is removed on unpark). With an action it is also a dispatch step on the
# notes ingest record, under the queue item that session works, so `notes log --item` shows the
# stop and the resume.
record() {
    local by="" item="" action=park.dropped
    [[ -n "${TMUX:-}" ]] && by=$(tmux display-message -p '#S' 2>/dev/null)
    [[ -n "${3:-}" ]] && action="session.$3"
    agent-notify -p low -t "park: $1" "$2 (by ${by:-${PWD##*/}})" >/dev/null 2>&1 || true
    audit_append "${by:-${PWD##*/}}" "$action" "$1" ok "$2"
    [[ -n "${3:-}" ]] || return 0
    [[ -n "${4:-}" ]] && item=$(agent-queue mine --sid "$4" --newest 2>/dev/null)
    chain_event dispatch "$3" "-" "$2" --item "$item" --why "$1" --by claude-acct
}

# ledger_get <file> <key> -> that key's value in a park ledger (one key=value per line)
ledger_get() { sed -n "/^$2=/{s///p;q;}" "$1" 2>/dev/null; }

# ledger_session <file> -> the tmux session a park ledger is filed under (a window key is session:%pane)
ledger_session() { local s b="${1##*/}"; s=$(ledger_get "$1" session); printf %s "${s:-${b%%:*}}"; }

# refuse <why...> -- one line naming the caller's $verb and its target ($what, else $session), exit 1
refuse() { echo "claude-acct: $verb ${what:-$session}: $*" >&2; return 1; }

# split_target <target> -> "server US session US window US pane" from [server/]session[:window]
# or [server/]%pane; fails on anything else
split_target() {
    local t="$1" srv="" ses="" win="" pane=""
    if [[ "$t" == */* ]]; then srv="${t%%/*}"; t="${t#*/}"; [[ -n "$srv" ]] || return 1; fi
    [[ -n "$t" && "$t" != */* ]] || return 1
    if [[ "$t" == %* ]]; then
        [[ "$t" =~ ^%[0-9]+$ ]] || return 1
        pane="$t"
    elif [[ "$t" == *:* ]]; then
        ses="${t%%:*}" win="${t#*:}"
        [[ -n "$ses" && -n "$win" && "$win" != *:* ]] || return 1
    else
        ses="$t"
    fi
    printf '%s\037%s\037%s\037%s\n' "$srv" "$ses" "$win" "$pane"
}

# resume_prompt <move|park> <from name> <to name> <status> -> what the resumed session is told
resume_prompt() {
    local p old="the $2 Claude account" why="$2 is out of usage"
    if [[ "$1" == move ]]; then
        [[ "$2" == "$GATEWAY_FROM" ]] && { old="the Lazer gateway"; why="the gateway refused it on budget"; }
        p="This session was moved from $old to $3, because $why. Nothing else changed: same conversation, same worktree. Pick up where you left off."
        [[ "$4" == shell ]] && p+=" The move stopped your background shells: restart any you still need."
    else
        local cause="to save Claude usage: its claude exited while it waited"
        [[ "$1" == preempt ]] && cause="so an urgent queue item could take its run unit: its claude exited at the end of a turn"
        [[ "$1" == budget ]] && cause="at a budget checkpoint, its queue item past its budget: its claude exited at the end of a turn, and it now runs one more budget before the next"
        [[ "$1" == human ]] && cause="by the human (the hub's Park)"
        p="This session was parked $cause, and it is now resumed on the $3 account. Same conversation, same worktree. Whatever you were waiting on (CI, a PR, a review, a hold) may have moved while you were parked, so re-check it before you carry on."
        [[ "$4" == shell ]] && p+=" Parking stopped your background waits: check what they watched directly instead of restarting them."
    fi
    printf '%s' "$p"
}

# launch_env <cwd> [item] -> the launch-line prefix for a claude that is its pane's own process, which
# runs no rc file: its queue item, then claude-telemetry.sh's claude_launch_env. Says so on stderr when
# it cannot build one.
launch_env() {
    local f="$HOME/.config/shared-hooks/claude-telemetry.sh" env
    [[ -z "${2:-}" ]] || printf 'AGENT_QUEUE_ITEM=%q ' "$2"
    # shellcheck disable=SC2016
    env=$(cd "$1" 2>/dev/null && AGENT_QUEUE_ITEM=${2:-} bash -c '. "$1" >/dev/null && claude_launch_env' _ "$f") ||
        { echo "claude-acct: no launch env from $f; the resume exports no telemetry" >&2; return 0; }
    printf '%s' "$env"
}

# resume_cmd <direct 0|1> <cwd> <to dir> <claude ... --resume <id>> <prompt> [item] -> the command
# that resumes the session on that account: run as the pane's process, with launch_env, when direct,
# typed into the pane's shell (after a cd) when not
resume_cmd() {
    local c
    # The token goes straight before claude, so launch_env's `env -u CLAUDE_CODE_OAUTH_TOKEN` (which
    # drops an inherited one) comes first and does not drop this one.
    c="$(cmd_token_prefix "$3")$4 $(printf %q "$5")"
    [[ "$1" == 1 ]] && c="$(launch_env "$2" "${6:-}")$c"
    if [[ -n "$3" ]]; then c="CLAUDE_CONFIG_DIR=$(printf %q "$3") $c"
    else c="env -u CLAUDE_CONFIG_DIR $c"; fi
    [[ "$1" == 1 ]] || c="cd $(printf %q "$2") && $c"
    printf '%s' "$c"
}

# drop_legacy_ledgers -- drop each legacy session:window_index park ledger (written before #2116 keyed
# a window ledger by pane id, so its pane id is a tmux restart old) that can no longer be resumed: its
# worktree is gone, or its tmux session now hosts a different live claude (a recycled session name).
# Every ledger made since is keyed session or session:%pane, so none of those is touched.
drop_legacy_ledgers() {
    local f key server session sid cwd reg why resume
    for f in "$PARKED"/*:*; do
        [[ -f "$f" ]] || continue
        key="${f##*/}"
        [[ "$key" == *:%* ]] && continue
        server=$(ledger_get "$f" server); session=$(ledger_get "$f" session); sid=$(ledger_get "$f" session_id)
        cwd=$(ledger_get "$f" cwd); resume=$(ledger_get "$f" resume); why=""
        if [[ -n "$cwd" && ! -d "$cwd" ]]; then
            why="its worktree $cwd is gone"
        elif [[ -n "$server" && -n "$session" && -n "$sid" ]]; then
            # another claude is live there and none is this ledger's own session
            local other=0 own=0
            while IFS=$'\037' read -r _ _ _ reg _; do
                if [[ "$(jq -r '.sessionId // empty' "$reg" 2>/dev/null)" == "$sid" ]]; then own=1; else other=1; fi
            done < <(find_claude "$server" "$session")
            ((other && !own)) && why="its tmux session now hosts another claude"
        fi
        [[ -n "$why" ]] || continue
        rm -f "$f"
        echo "claude-acct: dropped the legacy ledger $key: $why; session $sid was: $resume" >&2
        audit_append "${PWD##*/}" park.dropped "$key" ok "dropped legacy ledger: $why; session $sid, $resume"
    done
    return 0
}

# park_flow <park|move> <target> [--server S] [--to <account>] [--why <reason>] [--for <slug>] [--stop-shells] [--dry-run]
park_flow() {
    local verb="$1" what="" session="" window="" pane_t="" key="" server="" dry=0 stop=0 to_name="" to_dir="" srv reason="" for_item=""
    shift
    while (($#)); do
        case "$1" in
            --server) [[ -n "${2:-}" ]] || { echo "claude-acct: $verb: --server needs a value" >&2; return 2; }
                      server="$2"; shift 2 ;;
            --to) [[ "$verb" == move ]] || { echo "claude-acct: $verb: --to is for move" >&2; return 2; }
                  [[ -n "${2:-}" ]] || { echo "claude-acct: $verb: --to needs an account name" >&2; return 2; }
                  to_name="$2"; shift 2 ;;
            --why|--for)
                [[ "$verb" == park ]] || { echo "claude-acct: $verb: $1 is for park" >&2; return 2; }
                [[ "${2:-}" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || { echo "claude-acct: $verb: $1 needs a lowercase word" >&2; return 2; }
                if [[ "$1" == --why ]]; then reason="$2"; else for_item="$2"; fi
                shift 2 ;;
            --dry-run) dry=1; shift ;;
            --stop-shells) stop=1; shift ;;
            -*) echo "claude-acct: $verb: unknown flag '$1'" >&2; return 2 ;;
            *) [[ -z "$what" ]] || { echo "claude-acct: $verb: one session at a time" >&2; return 2; }
               what="$1"; shift ;;
        esac
    done
    [[ -n "$what" ]] || { echo "claude-acct: $verb: name the tmux session, window or pane to $verb" >&2; return 2; }
    srv=$(split_target "$what") ||
        { echo "claude-acct: $verb: '$what' is not [server/]session[:window] or a pane id" >&2; return 2; }
    IFS=$'\037' read -r srv session window pane_t <<< "$srv"
    if [[ -n "$srv" ]]; then
        [[ -z "$server" || "$server" == "$srv" ]] || { echo "claude-acct: $verb: '$what' names server $srv, --server $server" >&2; return 2; }
        server="$srv"
    fi
    [[ "$verb" == park && "$dry" == 0 ]] && drop_legacy_ledgers
    if [[ -n "$to_name" ]]; then
        local n d known=0
        while IFS=$'\037' read -r n d; do
            [[ "$n" == "$to_name" ]] && { known=1; to_dir="$d"; }
        done < <(accounts)
        ((known)) || { echo "claude-acct: $verb: no account '$to_name' in $CONF (have: $(accounts | cut -d$'\037' -f1 | paste -sd' '))" >&2; return 2; }
    fi

    if [[ -z "$server" ]]; then
        local s found=()
        while read -r s; do
            if [[ -n "$pane_t" ]]; then pane_session "$s" "$pane_t" > /dev/null && found+=("$s")
            else tmux -L "$s" has-session -t "=$session" 2>/dev/null && found+=("$s"); fi
        done < <(tmux_servers_all)
        case ${#found[@]} in
            0) [[ -n "$pane_t" ]] && { refuse "no tmux server has that pane"; return; }
               refuse "no tmux server has that session"; return ;;
            1) server="${found[0]}" ;;
            *) refuse "on servers ${found[*]}; pass --server"; return ;;
        esac
    fi
    if [[ -n "$pane_t" ]]; then
        session=$(pane_session "$server" "$pane_t") || { refuse "no such pane on server $server"; return; }
    fi
    tmux -L "$server" has-session -t "=$session" 2>/dev/null || { refuse "no such session on server $server"; return; }
    if [[ -n "$window" ]] && ! has_window "$server" "$session" "$window"; then
        refuse "no window $window in session $session on server $server"; return
    fi
    # Every check from here reads the pane and the ledger as they are under the lock.
    ((dry)) || park_lock "$session" || return
    # A session target's ledger is the session; a window or pane is one claude among others, so
    # its ledger is session:%pane, and only that window or pane is searched.
    local hits pid pane pane_pid reg win
    hits=$(find_claude "$server" "$session" "$window" "$pane_t")
    if [[ -z "$hits" ]]; then
        if [[ -z "$window$pane_t" && -f "$PARKED/$session" ]]; then
            refuse "no live claude in its panes: it is parked (claude-acct unpark $session)"; return
        fi
        refuse "no live claude in its panes"; return
    fi
    if (( $(wc -l <<< "$hits") > 1 )); then
        [[ -n "$window$pane_t" ]] && { refuse "more than one claude in that window; name the pane"; return; }
        refuse "more than one claude in its panes; name the window (${session}:N) or the pane"; return
    fi
    IFS=$'\037' read -r pid pane pane_pid reg win <<< "$hits"
    key="$session"
    if [[ -n "$window$pane_t" ]]; then
        [[ -n "$win" ]] || { refuse "cannot read the window index of pane $pane"; return; }
        # The pane id outlives a renumber; a window index does not, and keyed by it one pane
        # could be filed under two names, or two panes under one.
        key="$session:$pane"
    fi
    what="$key"
    # Pane ids restart with the tmux server, so a ledger that outlived a reboot can hold the
    # same key: it is another claude's resume, never overwritten.
    if [[ "$key" != "$session" && -f "$PARKED/$key" ]] && [[ "$(ledger_get "$PARKED/$key" session_id)" != "$(jq -r '.sessionId // empty' "$reg")" ]]; then
        refuse "ledger $PARKED/$key holds another session; unpark it or delete it first"; return
    fi

    local status sid cwd from b score name to note why shells=""
    status=$(jq -r '.status // empty' "$reg"); sid=$(jq -r '.sessionId // empty' "$reg"); cwd=$(jq -r '.cwd // empty' "$reg")
    [[ -n "$sid" && -d "$cwd" ]] || { refuse "its registry entry $reg has no session id or cwd"; return; }
    from=$(config_dir_of "$pid")
    # A claude-lazer pane (a dispatch start routed to Lazer, a `cl --lazer`) is on no account. A move
    # puts it on one on purpose; an unpark would do that unasked, so park refuses.
    if [[ -n "$(gateway_of "$pid")" ]]; then
        [[ "$verb" == move ]] || { refuse "it runs on the Lazer gateway, not an account; a resume would put it on one (claude-acct move does that on purpose)"; return; }
        from=$GATEWAY_FROM
    fi
    [[ "$status" == shell ]] && shells=$(bg_shells "$pid")
    if [[ "$verb" == move && -n "$to_name" ]]; then
        # The named account's own score line, the same numbers best() ranks.
        b=$(scores | awk -F'\037' -v n="$to_name" '$3 == n && !c++' | cut -d$'\037' -f2-)
        IFS=$'\037' read -r score name to note <<< "$b"
        name="$to_name" to="$to_dir"
        why=$(refusal "$status" "$from" "$to" "$score" "$name" "$note" "$stop" chosen)
    elif [[ "$verb" == move ]]; then
        b=$(best)
        IFS=$'\037' read -r score name to note <<< "$b"
        why=$(refusal "$status" "$from" "$to" "$score" "$name" "$note" "$stop")
    else
        why=$(hold_refusal park "$status" "$stop") || why=$(shells_refusal "$shells")
    fi
    if [[ -n "$why" ]]; then
        refuse "$why"
        [[ -n "$shells" ]] && cut -c1-100 <<< "$shells" | sed 's/^/  shell /' >&2
        return 1
    fi
    # A plain park (why=park, what a load hold or an agent asks for) takes only a dispatched
    # session, whose claude carries AGENT_QUEUE_ITEM. A hand start is the human's work: a hold
    # lowers it (agent-hold lower) and never stops it. The human's own park is --why human (the hub's
    # Park), and budget and preempt keep their own rules. Why: 2026-11-18 13:42 a cpu hold parked
    # the human's hub windows, which read as /exit.
    if [[ "$verb" == park && "${reason:-park}" == park ]] &&
        ! tr '\0' '\n' 2>/dev/null < "$PROC/$pid/environ" | grep -q '^AGENT_QUEUE_ITEM=.'; then
        refuse "it is a hand-started session (its claude has no AGENT_QUEUE_ITEM): a load hold lowers it with agent-hold lower, never parks it; the human parks their own with --why human"
        return 1
    fi

    local direct=0 base win
    [[ "$pid" == "$pane_pid" ]] && direct=1
    base="claude $(carry_flags "$pid")--resume $(printf %q "$sid")"
    # A shell that exported these would otherwise keep the resume on the gateway.
    [[ "$from" == "$GATEWAY_FROM" ]] && base="env -u ANTHROPIC_BASE_URL -u ANTHROPIC_AUTH_TOKEN $base"
    # The queue item a pane claude's launch line carried (fleet-dispatch's), for its respawn.
    local item=""
    ((direct)) && item=$(tr '\0' '\n' 2>/dev/null < "$PROC/$pid/environ" | sed -n 's/^AGENT_QUEUE_ITEM=//p' | awk 'NR==1')
    if [[ "$verb" == move ]]; then
        echo "claude-acct: move $key ($server $pane, claude $pid, $status) from $(name_of "$from") to $name ($note)"
    else
        echo "claude-acct: park $key ($server $pane, claude $pid, $status) on $(name_of "$from")"
    fi
    if ((direct)); then
        echo "  claude is the pane's own process: keep the pane on exit, respawn it in $cwd"
    else
        echo "  claude runs under the pane's shell: exit it and type the resume there"
    fi
    if [[ "$status" == shell ]]; then
        echo "  --stop-shells: answer /exit's dialog with 'Exit and stop tasks', stopping:"
        cut -c1-100 <<< "$shells" | sed 's/^/    /'
    fi
    if [[ "$verb" == move ]]; then
        echo "  then: $(resume_cmd "$direct" "$cwd" "$to" "$base" "$(resume_prompt move "$(name_of "$from")" "$name" "$status")" "$item")"
    else
        echo "  then: write $PARKED/$key; claude-acct unpark $key resumes it with $base, on the account with room then"
    fi
    ((dry)) && return 0
    leave_mode "$server" "$pane" || { refuse "pane $pane is in a tmux mode that did not close, or its mode cannot be read; typed nothing"; return; }

    # Written beside the ledger and renamed into place once the claude is gone, so a reader
    # never sees half of one, and a claude that would not exit leaves none.
    local tmp
    if ! mkdir -p "$PARKED" || ! tmp=$(mktemp "$PARKED/.$key.XXXXXX"); then refuse "cannot write to $PARKED"; return; fi
    printf '%s\n' "session=$session" "server=$server" "target=$server/$session${win:+:$win}" "pane=$pane" \
        "direct=$direct" "pid=$pid" "session_id=$sid" "cwd=$cwd" "from=$from" "status=$status" \
        "why=${reason:-$verb}" "for=$for_item" "parked=$(date +%s)" "resume=$base" "item=$item" > "$tmp"

    # A fleet-dispatch pane closes with its claude, and with it the session, its @dispatch
    # label and the name its ledger is filed under; held open, it is respawned in place.
    ((direct)) && tmux -L "$server" set-option -p -t "$pane" remain-on-exit on
    tmux -L "$server" send-keys -t "$pane" Escape
    tmux -L "$server" send-keys -t "$pane" -l /exit
    tmux -L "$server" send-keys -t "$pane" Enter
    if ! await "claude $pid to exit" exited "$server" "$pane" "$pid" "$stop"; then
        rm -f "$tmp"
        tmux -L "$server" send-keys -t "$pane" Escape   # closes a dialog left open
        ((direct)) && tmux -L "$server" set-option -p -u -t "$pane" remain-on-exit
        refuse "claude $pid did not exit; look at the pane"; return
    fi
    mv -f "$tmp" "$PARKED/$key"
    if [[ "$verb" == park ]]; then
        park_unlock
        echo "claude-acct: parked $key: $PARKED/$key; claude-acct unpark $key resumes it"
        record "$key" "parked on $(name_of "$from") ($status)${reason:+, $reason}${for_item:+ for $for_item}" parked "$sid"
        return 0
    fi
    unpark_ledger move "$PARKED/$key" "$to" "$name" "$note"
}

# unpark_ledger <verb> <ledger> [<to dir> <to name> <note>] -- resume the parked session in its
# pane, on that account or else the one best() names now, await it, then delete the ledger.
# A failure keeps the ledger, so `claude-acct unpark` can try again.
unpark_ledger() {
    local verb="$1" file="$2" what session server pane direct pid sid cwd from status why base item to name note b cmd got scope
    local created parked
    what="${file##*/}"
    [[ -f "$file" ]] || { refuse "not parked: no $file"; return; }
    session=$(ledger_session "$file")
    server=$(ledger_get "$file" server); pane=$(ledger_get "$file" pane); direct=$(ledger_get "$file" direct)
    pid=$(ledger_get "$file" pid); sid=$(ledger_get "$file" session_id); cwd=$(ledger_get "$file" cwd)
    from=$(ledger_get "$file" from); status=$(ledger_get "$file" status); why=$(ledger_get "$file" why)
    base=$(ledger_get "$file" resume); item=$(ledger_get "$file" item)
    [[ -n "$server" && -n "$pane" && -n "$sid" && -n "$cwd" && -n "$base" ]] || { refuse "$file is missing a field"; return; }
    # claude finds a session by its folder, so with the worktree gone nothing can resume it; the
    # ledger would only fail every later unpark (and unpark --all). Checked before tmux, since
    # the worktree and its tmux session usually go together (wt done). The page and the
    # message carry the session id and resume command, so an unmounted folder is not a loss.
    if [[ ! -d "$cwd" ]]; then
        if [[ "$direct" == 1 ]] && tmux -L "$server" has-session -t "=$session" 2>/dev/null &&
            [[ "$(tmux -L "$server" display-message -p -t "$pane" '#{pane_dead}' 2>/dev/null)" == 1 ]]; then
            tmux -L "$server" kill-pane -t "$pane"
        fi
        rm -f "$file"; park_unlock
        echo "claude-acct: $verb $what: its worktree $cwd is gone, so session $sid cannot resume; dropped $file (it was: $base)" >&2
        record "$what" "dropped: worktree $cwd is gone; session $sid, $base"
        [[ "$verb" == move ]] && return 1
        return 0
    fi
    if (($# > 2)); then
        to="$3" name="$4" note="$5"
    elif b=$(best) && [[ -n "$b" ]]; then
        IFS=$'\037' read -r _ name to note <<< "$b"
    else
        to="" name=$(name_of "") note="no usage data"
    fi
    tmux -L "$server" has-session -t "=$session" 2>/dev/null ||
        { refuse "its tmux session is gone from server $server; resume it by hand in $cwd with $base"; return; }
    # A park keeps its pane, so a pane that is gone, or whose session was made after the park, is a
    # server restart: pane ids restart with it, and resuming into that id would reach a live window
    # (ar-2679; fleet-sessions park_pane_gone is the same test).
    created=$(tmux -L "$server" display-message -p -t "$pane" '#{session_created}' 2>/dev/null) ||
        { refuse "its pane $pane is gone from session $session since the server restarted; resume it by hand in $cwd with $base"; return; }
    parked=$(ledger_get "$file" parked)
    if [[ "$created" =~ ^[0-9]+$ && "$parked" =~ ^[0-9]+$ ]] && ((created > parked)); then
        refuse "its tmux session was made after the park, so pane $pane is not the parked one; resume it by hand in $cwd with $base"; return
    fi
    # A session ledger owns the session's panes; a window ledger only its own pane, since the
    # rest of a shared session runs other claudes.
    scope=""; [[ "$what" == *:* ]] && scope="$pane"
    [[ -z "$(find_claude "$server" "$session" "" "$scope")" ]] ||
        { refuse "a claude is already live in ${scope:-its panes}; delete $file if it is this session"; return; }
    cmd=$(resume_cmd "$direct" "$cwd" "$to" "$base" "$(resume_prompt "${why:-park}" "$(name_of "$from")" "$name" "$status")" "$item")

    cmd_link
    if [[ "$direct" == 1 ]]; then
        tmux -L "$server" respawn-pane -t "$pane" -c "$cwd" "$cmd" || { refuse "respawn-pane failed; the pane is held open, dead"; return; }
        tmux -L "$server" set-option -p -u -t "$pane" remain-on-exit
    else
        leave_mode "$server" "$pane" ||
            { refuse "pane $pane is in a tmux mode that did not close, or its mode cannot be read; typed nothing ($file is kept)"; return; }
        tmux -L "$server" send-keys -t "$pane" -l "$cmd"
        tmux -L "$server" send-keys -t "$pane" Enter
    fi
    await "session $sid to register on $name" resumed_or_trusted "$server" "$pane" "$sid" "$pid" "$to" ||
        { refuse "resume did not register; look at the pane ($file is kept for claude-acct unpark)"; return; }
    rm -f "$file"; park_unlock
    # Its item bills this account now; left as the gateway harness it would keep a max_live slot.
    if [[ "$from" == "$GATEWAY_FROM" ]]; then
        local item
        item=$(agent-queue mine --sid "$sid" --newest 2>/dev/null)
        [[ -z "$item" ]] || agent-queue set "$item" agent=claude "account=$name" >/dev/null 2>&1 ||
            echo "claude-acct: $item still reads as on the gateway: agent-queue set failed" >&2
    fi
    got=$(resumed "$sid" "$pid" "$to")
    if [[ "$verb" == move ]]; then
        echo "claude-acct: moved $what to $name: claude ${got% *}, ${got#* }"
        record "$what" "moved from $(name_of "$from") to $name" unparked "$sid"
    else
        echo "claude-acct: unparked $what on $name ($note): claude ${got% *}, ${got#* }"
        record "$what" "unparked on $name" unparked "$sid"
    fi
}

cmd_park() { park_flow park "$@"; }
cmd_move() { park_flow move "$@"; }

# window_ledgers <session> <window> -> the window ledgers of that session whose pane is in that
# window now (by index or name; the window its ledger recorded when the pane is gone)
window_ledgers() {
    local f srv cur w
    for f in "$PARKED/$1":*; do
        [[ -f "$f" ]] || continue
        srv=$(ledger_get "$f" server)
        cur=$(tmux -L "$srv" display-message -p -t "$(ledger_get "$f" pane)" '#{window_index} #{window_name}' 2>/dev/null)
        if [[ -z "$cur" ]]; then w=$(ledger_get "$f" target); cur="${w##*:} "; fi
        [[ "${cur%% *}" == "$2" || "${cur#* }" == "$2" ]] && printf '%s\n' "$f"
    done
    return 0
}

# unpark <target>|--all -- the target names its ledger: session, session:window (the window its
# pane is in now), or a pane id, which matches the ledger that holds that pane
cmd_unpark() {
    local verb=unpark session="" what="" f rc=0 n=0 srv win pane_t
    case "${1:-}" in
        "") echo "claude-acct: unpark: name the tmux session, or --all" >&2; return 2 ;;
        --all)
            (($# == 1)) || { echo "claude-acct: unpark: --all takes no session" >&2; return 2; }
            drop_legacy_ledgers
            # A bulk wake, so it takes each from the shared budget (wake-pace.sh); the rest stay parked.
            # A park's why is its owner, and --all owns only why=park: fleet-dispatch resumes its
            # preempts once their run units fit (unpark_preempted), and any other owner (budget: a choice
            # to spend more) waits for an unpark by name.
            local left=0 owned=() k why
            for f in "$PARKED"/*; do
                [[ -f "$f" ]] || continue
                ((n++)); k="${f##*/}"; why=$(ledger_get "$f" why)
                case "${why:-park}" in
                    park) ;;
                    preempt) owned+=("$k (preempt: fleet-dispatch resumes it)"); continue ;;
                    *) owned+=("$k ($why: claude-acct unpark $k)"); continue ;;
                esac
                # wake_take refuses every later call once it refuses one: skip the lock wait for those.
                ((WAKE_REFUSED == 0)) || { ((left++)); continue; }
                what="$k"; park_lock "$(ledger_session "$f")" || { rc=1; continue; }
                # Read before the lock: an unpark that held it may have resumed this one already.
                [[ -f "$f" ]] || { park_unlock; ((n--)); continue; }
                if wake_take unpark "$k"; then unpark_ledger unpark "$f" || rc=1; else ((left++)); fi
                park_unlock
            done
            ((n)) || echo "claude-acct: unpark: nothing is parked"
            ((${#owned[@]} == 0)) || printf 'claude-acct: unpark: left to its owner: %s\n' "${owned[@]}"
            ((left == 0)) || echo "claude-acct: unpark: $left stay parked: the wake budget is $WAKE_BUDGET per $WAKE_SETTLE_MIN min, none while fleet-assess reads HOLD; run unpark --all again then"
            return "$rc" ;;
        -*) echo "claude-acct: unpark: unknown flag '$1'" >&2; return 2 ;;
    esac
    (($# == 1)) || { echo "claude-acct: unpark: one session at a time" >&2; return 2; }
    drop_legacy_ledgers
    srv=$(split_target "$1") ||
        { echo "claude-acct: unpark: '$1' is not [server/]session[:window] or a pane id" >&2; return 2; }
    IFS=$'\037' read -r srv session win pane_t <<< "$srv"
    if [[ -n "$pane_t" ]]; then
        what="$1"
        for f in "$PARKED"/*; do
            [[ -f "$f" && "$(ledger_get "$f" pane)" == "$pane_t" ]] || continue
            [[ -z "$srv" || "$(ledger_get "$f" server)" == "$srv" ]] || continue
            ((n++)) && { refuse "more than one ledger holds that pane; name its ledger (session:%pane)"; return; }
            session="${f##*/}"
        done
        ((n)) || { refuse "not parked: no ledger holds that pane"; return; }
        win=""
    fi
    f="$PARKED/$session${win:+:$win}"
    if [[ -n "$win" && ! -f "$f" ]]; then
        # a window is named by where its pane is now, not by the index its ledger was written under
        local hits
        hits=$(window_ledgers "$session" "$win")
        (($(grep -c . <<< "$hits") > 1)) && { what="$1"; refuse "more than one ledger holds that window; unpark it by pane id"; return; }
        [[ -z "$hits" ]] || f="$hits"
    fi
    [[ -z "$srv" || ! -f "$f" || "$(ledger_get "$f" server)" == "$srv" ]] ||
        { what="$1"; refuse "parked on server $(ledger_get "$f" server), not $srv"; return; }
    [[ ! -f "$f" ]] || park_lock "$(ledger_session "$f")" || return
    unpark_ledger unpark "$f"
}

# Sourceable for tests; the dispatch runs only when executed.
[[ "${BASH_SOURCE[0]}" != "$0" ]] && return 0

case "${1:-}" in
    pick)   shift; cmd_pick "$@" ;;
    run)    shift; cmd_run "$@" ;;
    scope)  shift; cmd_scope "$@" ;;
    status) shift; cmd_status "$@" ;;
    textfile) shift; cmd_textfile "$@" ;;
    gateway) shift; cmd_gateway "$@" ;;
    room)   shift; cmd_room "$@" ;;
    check)  shift; cmd_check "$@" ;;
    models) shift; cmd_models "$@" ;;
    setup-token) shift; cmd_setup_token "$@" ;;
    token)  shift; if [[ "${1:-}" == push ]]; then shift; cmd_token_push "$@"; else cmd_token "$@"; fi ;;
    token-prefix) shift; cmd_token_prefix "$@" ;;
    cost)   cmd_cost ;;
    link)   cmd_link ;;
    plans-store) shift; plans_store "$@" ;;
    move)   shift; cmd_move "$@" ;;
    park)   shift; cmd_park "$@" ;;
    unpark) shift; cmd_unpark "$@" ;;
    trust)  shift; cmd_trust "$@" ;;
    -h|--help|"") usage ;;
    *) echo "claude-acct: unknown verb '$1'" >&2; usage >&2; exit 1 ;;
esac
