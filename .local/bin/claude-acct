#!/usr/bin/env bash
#
# claude-acct - start each `cl` session on the Claude account whose week is cheapest to spend from
#
# Usage:
#   claude-acct pick [name]   # print the CLAUDE_CONFIG_DIR to use (empty = main account);
#                             # with a name, that account's dir (`cl --acct <name>`)
#   claude-acct run [--acct <name>] [claude args]
#                             # exec claude on the account pick returns: the one launcher for a
#                             # human start (`cl`, `sessions` resume, the fzf picker, the hub)
#   claude-acct status [--json]   # every source: window used, window gone, run-out, live sessions,
#                                 # 24h dollars, burn and sustainable points an hour, when it is back
#                                 # on pace, and one fleet line: live, burn against what the windows carry
#   claude-acct textfile <dir>    # write <dir>/claude_acct.prom for node_exporter
#   claude-acct room [--json]
#                        # for automatic starts: the account with room, as pick prints it; --json
#                        # prints every account's verdict (ok, reason, every refusal, why, points
#                        # past the line, capped)
#                        # exit 1 when none has room, 2 when none has room and one cannot be read
#   claude-acct room --source <name>
#                        # the verdict of one source (a Claude account or a row of the sources file)
#                        # as one sentence; exit 0 room, 1 refused, 2 unread, 3 no such source
#   claude-acct check usage  # one line, exit 1 when tripped (the Sentinel watch probes)
#   claude-acct check pace   # one line, exit 1 when a source is past its pace line or in its reserve
#   claude-acct cost     # {"<session id>": dollars} over CLAUDE_ACCT_COST_WINDOW (7d), from
#                        # Prometheus; exit 2 when it cannot be read. fleet-shepherd's budgets read it
#   claude-acct link     # share the main ~/.claude setup into every other account dir
#   claude-acct move <target> [--server S] [--to <account>] [--stop-shells] [--dry-run]
#                        # exit that target's claude and resume it on the account pick
#                        # returns (or the one --to names), in the same pane: park, then unpark.
#                        # A claude on the Lazer gateway moves onto that account too; park refuses one
#   claude-acct park <target> [--server S] [--stop-shells] [--dry-run]
#                        # exit that target's claude so it costs nothing while it waits,
#                        # keeping the pane; the resume goes to ~/.agent/parked/<key>
#   claude-acct unpark <target>|--all
#                        # resume a parked session in its pane, on the account pick returns now
#                        # <target> is [server/]session[:window] or a pane id (%N). A session
#                        # holds one claude; a window or pane picks one claude in a shared
#                        # session (hub/dotfiles:2). The ledger <key> is the session, or
#                        # session:window for a window or pane target.
#   claude-acct trust <server> <pane> <ready text>
#                        # wait for a claude just started in that pane to show <ready text>
#                        # (its mode footer), answering the folder trust prompt on the way
#
# Accounts: ~/.config/claude-acct/accounts, one `name dir` per line (`-` = default).
# Sources: ~/.config/claude-acct/sources, one `name kind ref [reserve=N] [max_live=N] [parent=name]`
# per line, for every source that is not a Claude account (read by this script only; cl and
# agent-panel read accounts). Kinds: codex (ref: the Codex sessions dir; the plan's rate limits come
# from the newest rollout), litellm-key (ref: a key file; its budget from /key/info), litellm-team
# (ref: a key file of a member; the team's budget from /team/info). reserve overrides RESERVE_PCT,
# max_live caps the running queue items on the source, parent names a pool the source spends inside:
# a source has room only when its parent does. A harness is tied to its source by `source` in
# harnesses.json. Every kind is normalized to the one usage row, so room, status and the textfile
# treat all sources alike. Each source is in exactly one of the two files.
# One account per session via CLAUDE_CONFIG_DIR; nothing here writes a credential,
# Claude refreshes each account's token itself when a session starts in that dir.
# Usage comes from the endpoint behind /usage, which rate-limits per token, so each
# answer is cached for CLAUDE_ACCT_TTL seconds.

set -uo pipefail

# shellcheck source=../lib/chain-event.sh
. "${CHAIN_EVENT_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/chain-event.sh}"

CONF="${CLAUDE_ACCT_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/claude-acct/accounts}"
SRC_CONF="${CLAUDE_ACCT_SOURCES:-$(dirname "$CONF")/sources}"
# The gateway's url and the harness -> source map (harnesses.json `source`).
HARNESSES="${CLAUDE_ACCT_HARNESSES:-${XDG_CONFIG_HOME:-$HOME/.config}/agentctl/harnesses.json}"
CACHE="${CLAUDE_ACCT_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/claude-acct}"
TTL="${CLAUDE_ACCT_TTL:-300}"
MAIN_DIR="$HOME/.claude"
USAGE_URL="https://api.anthropic.com/api/oauth/usage"

# What every account shares with the main one. Everything else (.credentials.json,
# .claude.json, stats, other runtime dirs) stays per account. sessions/ is the machine's
# live-session registry (<pid>.json, read by agent-panel, ListAgents and the fleet tools),
# so a split copy hides every session on the other account.
SHARED=(settings.json settings.local.json CLAUDE.md PERSONAS.md commands hooks skills
        agents plugins output-styles themes docs mcp-profiles projects plans
        sessions)
# Shared dirs keyed by pid: an account's own copy is merged into main, not parked, since
# its files belong to sessions running right now and pids cannot collide.
MERGE=(sessions)

usage() {
    sed -n '3,/^$/s/^# \{0,1\}//p' "$0"
}

# accounts -> "name US dir" lines (US = \037, never collapsed like a tab), dir empty = default
accounts() {
    [[ -f "$CONF" ]] || return 0
    local name dir
    while read -r name dir; do
        [[ -z "$name" || "$name" == \#* ]] && continue
        [[ "$dir" == "-" ]] && dir=""
        printf '%s\037%s\n' "$name" "${dir/#\~/$HOME}"
    done < "$CONF"
}

# sources -> "name US kind US ref US reserve US max_live US parent" per line of the sources file. A
# line that cannot be read says so on stderr and is skipped, so a typo never becomes a silent row.
sources() {
    [[ -f "$SRC_CONF" ]] || return 0
    local name kind ref opts opt reserve max_live parent seen=''
    while read -r name kind ref opts; do
        [[ -z "$name" || "$name" == \#* ]] && continue
        if [[ ! "$name" =~ ^[A-Za-z0-9_-]+$ || -z "$kind" || -z "$ref" ]]; then
            echo "claude-acct: $SRC_CONF: skipped '$name $kind $ref': want name kind ref" >&2; continue
        fi
        if accounts | cut -d$'\037' -f1 | grep -qxF -- "$name"; then
            echo "claude-acct: $SRC_CONF: $name is also an account; skipped" >&2; continue
        fi
        if [[ " $seen " == *" $name "* ]]; then
            echo "claude-acct: $SRC_CONF: $name is listed twice; the later line is skipped" >&2; continue
        fi
        seen+=" $name"
        reserve='' max_live='' parent=''
        for opt in $opts; do
            case "$opt" in
                reserve=*) reserve=${opt#reserve=} ;;
                max_live=*) max_live=${opt#max_live=} ;;
                parent=*) parent=${opt#parent=} ;;
                *) echo "claude-acct: $SRC_CONF: $name: unknown option '$opt'" >&2 ;;
            esac
        done
        [[ -z "$reserve" || "$reserve" =~ ^[0-9]+(\.[0-9]+)?$ ]] || { echo "claude-acct: $SRC_CONF: $name: reserve is not a number" >&2; reserve=''; }
        [[ -z "$max_live" || "$max_live" =~ ^[0-9]+$ ]] || { echo "claude-acct: $SRC_CONF: $name: max_live is not a whole number" >&2; max_live=''; }
        printf '%s\037%s\037%s\037%s\037%s\037%s\n' "$name" "$kind" "${ref/#\~/$HOME}" "$reserve" "$max_live" "$parent"
    done < "$SRC_CONF"
}

# rows_in -> "name US kind US ref US reserve US max_live US parent" for every row usage_json reads:
# the Claude accounts (kind claude, ref their dir), then the sources when USAGE_SOURCES=1
rows_in() {
    local name dir row
    while IFS=$'\037' read -r name dir; do
        usage_wants "$name" || continue
        printf '%s\037claude\037%s\037\037\037\n' "$name" "$dir"
    done < <(accounts)
    if [[ "${USAGE_SOURCES:-0}" == 1 ]]; then
        while IFS= read -r row; do
            usage_wants "${row%%$'\037'*}" && printf '%s\n' "$row"
        done < <(sources)
    fi
    return 0
}

# usage_wants <name> -> 0 when USAGE_ONLY (space-separated names) is unset or names it, so a verdict
# for one source reads that source and its parent, not every account's token and every key's gateway.
usage_wants() { [[ -z "${USAGE_ONLY:-}" ]] || [[ " $USAGE_ONLY " == *" $1 "* ]]; }

# fetch <name> <dir> -> usage JSON on stdout
#   exit 0 = fresh data, 2 = token expired, 1 = never logged in or fetch failed
fetch() {
    local name="$1" dir="$2" cache="$CACHE/$1.json"
    if [[ -s "$cache" ]] && (( $(date +%s) - $(stat -c %Y "$cache") < TTL )); then
        cat "$cache"
        return 0
    fi
    local creds="${dir:-$MAIN_DIR}/.credentials.json" token exp
    [[ -f "$creds" ]] || return 1
    token=$(jq -r '.claudeAiOauth.accessToken // empty' "$creds" 2>/dev/null)
    exp=$(jq -r '.claudeAiOauth.expiresAt // 0' "$creds" 2>/dev/null)
    [[ -n "$token" ]] && (( ${exp:-0} > $(date +%s) * 1000 )) || return 2

    local ver tmp
    ver=$(claude --version 2>/dev/null | awk '{print $1}')
    mkdir -p "$CACHE"
    tmp=$(mktemp "$CACHE/.$name.XXXXXX")
    if curl -fsS -m 5 "$USAGE_URL" \
        -H "Authorization: Bearer $token" \
        -H "anthropic-beta: oauth-2025-04-20" \
        -H "User-Agent: claude-code/${ver:-2}" > "$tmp" 2>/dev/null \
        && jq -e '.five_hour or .seven_day' "$tmp" >/dev/null 2>&1; then
        mv "$tmp" "$cache"
        cat "$cache"
        return 0
    fi
    rm -f "$tmp"
    return 1
}

# --- source readers -------------------------------------------------------------------
# Each kind prints the usage endpoint's shape, `seven_day` being the source's one window and
# `five_hour` its short one, plus window (seconds), paced (false for a dollar budget, which is a
# ceiling and not a weekly allowance), reached, usd_used and usd_max when the kind has them. That is
# the only per-kind code; usage_json treats every row alike. Exit 1 when the source cannot be read.

# read_codex <sessions dir> -> the plan's rate limits from the newest rollout with a windowed record:
# every token_count event carries them as of that call, and Codex has no usage endpoint to ask. Only
# the plan's own limit counts (limit_id "codex", or none in older rollouts); Codex also logs records
# with no window (limit_id "premium"), often last, so each file is read from its end for the newest
# record with a window; a line that does not parse (a rollout mid-write) is skipped. Every rollout is
# a candidate, newest first, until one has a window: a run refused at the usage limit logs only a
# windowless record, and any number of them may follow the last reading.
# A window is named by its length, never its slot: Plus logs the 5h window as primary and the week
# as secondary, Pro logs the week as primary and no 5h window at all. Up to 6h is the 5h window and
# 10000-10200 minutes the week (rollouts log 10080 and 10081); any other length, or none, makes the
# source unread, so it blocks instead of being paced on a guess. The week's length is $WEEK.
# A window whose reset has passed reads as unused, with no reset until a rollout says when.
read_codex() {
    local now="${CLAUDE_ACCT_NOW:-$(date +%s)}" f out
    while IFS= read -r f; do
        out=$(tac "$f" | grep '"rate_limits"' | jq -cR --argjson now "$now" '
            def win(w): if w == null then null
                elif (w.resets_at // 0) <= $now then {utilization: 0, resets_at: null}
                else {utilization: w.used_percent, resets_at: (w.resets_at | todate)} end;
            def name(w): w.window_minutes as $m
                | if $m == null then null elif $m <= 360 then "five_hour"
                  elif $m >= 10000 and $m <= 10200 then "seven_day" else null end;
            def named(ws; n): ws | map(select(name(.) == n)) | max_by(.used_percent);
            fromjson? | .payload.rate_limits? | objects | select((.limit_id // "codex") == "codex")
            | select(.primary or .secondary) | . as $r
            | [$r.primary, $r.secondary] | map(select(. != null)) as $ws
            | if any($ws[]; name(.) == null) then {unknown_window: [$ws[].window_minutes]}
              else {plan: $r.plan_type, five_hour: win(named($ws; "five_hour")),
                    seven_day: win(named($ws; "seven_day")), paced: true,
                    reached: ($r.rate_limit_reached_type != null
                              and ($ws | map(.resets_at | select(. != null)) | min // 0) > $now)}
              end' |
            head -n1)
        if jq -e 'has("unknown_window")' <<< "${out:-null}" >/dev/null 2>&1; then
            echo "claude-acct: codex: a window of unknown length $(jq -c .unknown_window <<< "$out") minutes in $f" >&2
            return 1
        fi
        [[ -n "$out" ]] && { printf '%s\n' "$out"; return 0; }
    done < <(find "$1" -name 'rollout-*.jsonl' -printf '%T@ %p\n' 2>/dev/null | sort -rn | cut -d' ' -f2-)
    return 1
}

# gateway_curl <key file> <path> [curl args] -> the gateway's answer to that key. The key goes in on
# stdin, off the process list.
gateway_curl() {
    local url key file=$1 path=$2
    shift 2
    url=$(jq -er '.gateway.url' "$HARNESSES" 2>/dev/null) && key=$(cat "$file" 2>/dev/null) || return 1
    curl -sS -m 10 -K - "$@" "$url$path" <<< "header = \"Authorization: Bearer $key\"" 2>/dev/null
}

# gateway_get <key file> <path> -> the gateway's JSON for that key.
gateway_get() { gateway_curl "$1" "$2" -f; }

# gateway_refused <key file> <model> <team|key> -> the spend the gateway refuses this key at for that
# budget, nothing while it admits it. The gateway enforces a counter it publishes nowhere: on
# 2026-11-08 it refused at $380 with /team/info at $204, so a refusal is its only reader, and
# count_tokens passes the same check and bills nothing. The model is one the key may call, or the
# refusal would be about the model.
gateway_refused() {
    local body re='Budget has been exceeded! '
    [[ -n "$2" ]] || { echo "claude-acct: ${1##*/}: no model to run the budget probe with; the spend is the recorded one" >&2; return 0; }
    [[ "$3" == team ]] && re+='Team=[^ ]+ '
    re+='Current cost: ([0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?),'
    body=$(gateway_curl "$1" /v1/messages/count_tokens -X POST -H 'content-type: application/json' \
        -d "$(jq -nc --arg m "$2" '{model: $m, messages: [{role: "user", content: "x"}]}')")
    if [[ "$body" =~ $re ]]; then
        printf '%s' "${BASH_REMATCH[1]}"
    elif [[ "$body" != *'Budget has been exceeded'* && ( -z "$body" || "$body" == *'"error"'* ) ]]; then
        echo "claude-acct: ${1##*/}: the budget probe could not tell; the spend is the recorded one" >&2
    fi
}

# budget_usage [refused spend] -> a LiteLLM budget object (spend, max_budget, budget_reset_at) in the
# usage shape: percent of the budget spent, the reset, no pace line. A refused spend replaces the
# recorded one, being the number the gateway acts on.
budget_usage() {
    jq -ce --argjson refused "${1:-null}" '.spend = ($refused // .spend) | {seven_day: {utilization: (if (.max_budget // 0) > 0 then .spend / .max_budget * 100 else 0 end),
                         resets_at: (.budget_reset_at // null)},
             five_hour: null, paced: false, usd_used: .spend, usd_max: .max_budget}'
}

# fetch_source <name> <kind> <ref> -> the usage JSON of one source, cached for TTL like fetch
fetch_source() {
    local name="$1" kind="$2" ref="$3" cache="$CACHE/$1.json" out tmp info refused
    if [[ "$kind" == codex ]]; then read_codex "$ref"; return; fi   # local files: nothing to rate-limit
    if [[ -s "$cache" ]] && (( $(date +%s) - $(stat -c %Y "$cache") < TTL )); then cat "$cache"; return 0; fi
    case "$kind" in
        litellm-key|litellm-team)
            info=$(gateway_get "$ref" /key/info | jq -e .info) || return 1
            refused=$(gateway_refused "$ref" "$(jq -r '.models[0] // empty' <<< "$info")" "${kind#litellm-}")
            if [[ "$kind" == litellm-key ]]; then
                out=$(budget_usage "$refused" <<< "$info")
            else
                local team
                team=$(jq -er .team_id <<< "$info") &&
                    out=$(gateway_get "$ref" "/team/info?team_id=$team" | jq -e .team_info | budget_usage "$refused")
            fi ;;
        *) echo "claude-acct: $name: unknown kind '$kind' (codex, litellm-key, litellm-team)" >&2; return 1 ;;
    esac || return 1
    [[ -n "$out" ]] || return 1
    mkdir -p "$CACHE"
    tmp=$(mktemp "$CACHE/.$name.XXXXXX") && printf '%s\n' "$out" > "$tmp" && mv "$tmp" "$cache" || return 1
    printf '%s\n' "$out"
}

# source_live -> {"<source>": running queue items whose harness maps to it (harnesses.json source)}
source_live() {
    local agents
    agents=$(agent-queue list --json --state running 2>/dev/null | jq -s '[flatten[] | .agent // "claude"]' 2>/dev/null) || agents='[]'
    jq -c --argjson a "${agents:-[]}" '[$a[] as $x | .harnesses[$x].source // empty] | group_by(.) | map({key: .[0], value: length}) | from_entries' \
        "$HARNESSES" 2>/dev/null || echo '{}'
}

# scores -> "rank US score US name US dir US note" per account that can be scored. Lower rank is
# better (see usage_json); score is the fuller of the two windows, which `move` compares to 100.
scores() {
    usage_json nospend | jq -r '
        select(.state != "unread") |
        def p: if . == null then "-" else "\(floor)%" end;
        [.rank, ([.five_hour // 0, .week_used // 0] | max), .name, .dir,
         # An idle account token expires; launching it is what refreshes it.
         (if .state == "expired" then "token expired, refreshes on launch"
          else "5h \(.five_hour | p), 7d \(.week_used | p)" end)]
        | map(tostring) | join("\u001f")'
}

cmd_link() {
    local name dir e src dst bk
    while IFS=$'\037' read -r name dir; do
        [[ -n "$dir" && -d "$dir" ]] || continue
        for e in "${SHARED[@]}"; do
            src="$MAIN_DIR/$e" dst="$dir/$e"
            [[ -e "$src" ]] || continue
            [[ -L "$dst" && "$(readlink "$dst")" == "$src" ]] && continue
            if [[ -d "$dst" && ! -L "$dst" && " ${MERGE[*]} " == *" $e "* ]]; then
                find "$dst" -mindepth 1 -maxdepth 1 -exec mv -n -t "$src" {} +
                rmdir "$dst" 2>/dev/null   # anything left (a name clash) is parked below
            fi
            if [[ -e "$dst" || -L "$dst" ]]; then
                # Never delete what an account already had: park it for a manual merge.
                bk="$dir/.pre-share-$(date +%F)"
                mkdir -p "$bk"
                [[ -e "$bk/$e" ]] && bk="$bk/$$" && mkdir -p "$bk"
                mv "$dst" "$bk/$e"
                echo "claude-acct: $name: moved existing $e to $bk/" >&2
            fi
            ln -s "$src" "$dst"
        done
    done < <(accounts)
}

# best -> "score US name US dir US note" of the account whose week is cheapest to spend from,
# nothing without data
best() {
    # Stable sort keeps file order on a tie, so the first account (main) wins it.
    scores | sort -s -t$'\037' -g -k1,1 | head -n1 | cut -d$'\037' -f2-
}

cmd_pick() {
    cmd_link
    local b name dir note
    if [[ -n "${1:-}" ]]; then
        while IFS=$'\037' read -r name dir; do
            [[ "$name" == "$1" ]] && { printf '%s\n' "$dir"; return 0; }
        done < <(accounts)
        echo "claude-acct: no account '$1' in $CONF (have: $(accounts | cut -d$'\037' -f1 | paste -sd' '))" >&2
        return 1
    fi
    b=$(best)
    if [[ -z "$b" ]]; then
        echo "claude-acct: no usage data, using the default account" >&2
        return 0
    fi
    IFS=$'\037' read -r _ name dir note <<< "$b"
    echo "claude-acct: $name ($note)" >&2
    # Told, never refused: a human start goes ahead whatever the pace, and never moves to the
    # paid Lazer reserve on its own; the hint names it, `cl --lazer` is the human's choice. The
    # one automatic path onto Lazer is a dispatch run pass routing an item there (fleet-dispatch start_item).
    local rows
    rows=$(usage_json nospend | jq -s .)
    local picked
    picked=$(jq -c --arg n "$name" '.[] | select(.name == $n)' <<< "$rows")
    if [[ -n "$picked" && "$(jq -r .room.ok <<< "$picked")" == false ]]; then
        echo "claude-acct: $name would be refused an automatic start, $(jq -r .room.why <<< "$picked"); this start goes ahead" >&2
    fi
    if jq -e 'length > 0 and all(.[]; .room.capped)' <<< "$rows" >/dev/null; then
        echo "claude-acct: every account is spent; cl --lazer runs Sonnet on the Lazer reserve, where dispatch passes already route Sonnet-lane items" >&2
    fi
    printf '%s\n' "$dir"
}

# --- usage -----------------------------------------------------------------------------
# The weekly percent is what stops work, so pace is read against it: under the line the account
# can keep this use up until it resets. Dollars are the OTel list-price estimate, for scale only.
WEEK=604800
# The numbers live in .config/claude-acct/pace.conf and nowhere else: no env override, so every
# reader of the verdict sees the same line (the machine-mode level scales them, by column name). A dispatch floor lifts the pace reason from the
# published verdict (room.reasons), never by moving the slack.
PACE_CONF="${CLAUDE_ACCT_PACE_CONF:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../.config/claude-acct/pace.conf}"
# pace_get KEY -> the value; empty and a line naming the file when it is not set or not a plain
# number, which stops the script below: a missing number must not quietly become a default
pace_get() {
    local v
    v=$(sed -n "s/^$1=//p" "$PACE_CONF" 2>/dev/null | head -1)
    if [[ ! "$v" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        echo "claude-acct: $1 is not set to a number in $PACE_CONF" >&2
        return 0
    fi
    printf '%s' "$v"
}
PACE_SLACK_PCT="$(pace_get PACE_SLACK_PCT)"
RESERVE_PCT="$(pace_get RESERVE_PCT)"
# shellcheck source=../lib/machine-mode.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/machine-mode.sh"   # level_scale, for room
SESSION_RATE="${CLAUDE_ACCT_SESSION_RATE:-$(pace_get SESSION_RATE)}"
[[ -n "$PACE_SLACK_PCT" && -n "$RESERVE_PCT" && -n "$SESSION_RATE" ]] || exit 1
RATE_TTL="${CLAUDE_ACCT_RATE_TTL:-3600}"
# The one bash Prometheus reader (prom_q, PROM_URL from the hub's own env file). A dead endpoint
# costs a start 5s at most, and only the spend paths ask.
# shellcheck source=../lib/prom.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/prom.sh"
PROM_TIMEOUT="${PROM_TIMEOUT:-5}"

# email_of <dir> -> the address that account is logged in as, empty if unknown
email_of() {
    local f="$HOME/.claude.json"
    [[ -n "$1" ]] && f="$1/.claude.json"
    jq -r '.oauthAccount.emailAddress // empty' "$f" 2>/dev/null
}

# live_of -> one line per running claude, "@" and the account dir it runs under. The "@" keeps the
# main account's line non-empty: a trailing empty line is lost to $(...), and none at all reads as
# one main session to grep. A claude on the Lazer gateway spends no account, so it is not one.
# Builtins only per /proc entry: every agentctl-run call pays for this loop through pick.
live_of() {
    local c comm
    for c in "$PROC"/[0-9]*/comm; do
        comm=""
        read -r comm 2>/dev/null < "$c"
        [[ "$comm" == claude ]] || continue
        c="${c%/comm}"
        [[ -z "$(gateway_of "${c##*/}")" ]] || continue
        printf '@%s\n' "$(config_dir_of "${c##*/}")"
    done
}

# spend_24h -> {"email": dollars}, or null when Prometheus cannot be read: dollars are for scale,
# never load-bearing, so the percents still print
spend_24h() {
    local out
    out=$(prom_q 'sum by (user_email) (increase(claude_code_cost_usage_USD_total[24h]))' |
        jq -c '[.data.result[] | {key: (.metric.user_email // ""), value: (.value[1] | tonumber)}] | from_entries' 2>/dev/null)
    echo "${out:-null}"
}

# cost -> {"<session id>": dollars} for every session with spend in the window. increase(), not
# the counter's value, so a session resumed in a new process (its counter restarted) still sums
# its whole spend. Exit 2 when Prometheus cannot be read: no answer is not "spent nothing".
cmd_cost() {
    local out
    out=$(prom_q "sum by (session_id) (increase(claude_code_cost_usage_USD_total[${CLAUDE_ACCT_COST_WINDOW:-7d}]))" |
        jq -ce '[.data.result[] | select(.metric.session_id != null)
                 | {key: .metric.session_id, value: (.value[1] | tonumber * 100 | round / 100)}] | from_entries' 2>/dev/null) ||
        { echo "claude-acct: cost: cannot read Prometheus" >&2; return 2; }
    printf '%s\n' "$out"
}

# session_rate [nospend] [source] -> points of an account's week one live session uses an hour: the
# fleet's last 6h from Prometheus, cached for RATE_TTL (a miss too), SESSION_RATE when it cannot be
# read. A reset inside the window reads low, never high. nospend reads the cache at any age and never
# asks Prometheus; the claude-acct-usage timer's `textfile` keeps the cache fresh. With a source name
# it is that source's own 6h change in used percent per live session, SESSION_RATE until it has history.
# Each account is one series (max by account) before the offset and the average: a label added to the
# textfile (kind, #1488) leaves the new series no partner 6h back, and a raw subtraction reads nothing.
session_rate() {
    local f="$CACHE/session_rate" r q sel='kind=~"claude|"'
    if [[ -n "${2:-}" ]]; then f="$CACHE/session_rate.$2" sel="account=\"$2\""; fi
    q="sum(clamp_min(max by (account) (claude_account_week_used_percent{$sel}) - max by (account) (claude_account_week_used_percent{$sel} offset 6h), 0))"
    # only the accounts the numerator has a 6h-old sample for count their live sessions
    q+=" / sum(avg_over_time((max by (account) (claude_account_live_sessions{$sel}))[6h:5m])"
    q+=" and on (account) max by (account) (claude_account_week_used_percent{$sel} offset 6h)) / 6"
    if [[ -s "$f" ]] && { [[ "${1:-}" == nospend ]] || (( $(date +%s) - $(stat -c %Y "$f") < RATE_TTL )); }; then
        cat "$f"; return
    fi
    if [[ "${1:-}" == nospend ]]; then echo "$SESSION_RATE"; return; fi
    r=$(prom_q "$q" |
        jq -er '.data.result[0].value[1] | tonumber | select(. > 0 and . < 10)' 2>/dev/null) || r="$SESSION_RATE"
    mkdir -p "$CACHE" && printf '%s\n' "$r" > "$f"
    printf '%s\n' "$r"
}

# usage_json [nospend] -> one JSON object per Claude account; with USAGE_SOURCES=1 (all_json) also
# one per source, in the same shape. state: ok, expired (idle, refreshes on launch) or unread.
# nospend skips Prometheus, so a `cl` off the LAN does not wait out its timeout.
usage_json() {
    local name kind dir json rc state now resets start gone used over live spend lives rate slack reserve
    local own_reserve max_live parent win paced srclive row_reserve email
    srclive='{}'; [[ "${USAGE_SOURCES:-0}" == 1 ]] && srclive=$(source_live)
    # The room verdict is for automatic starts, so the machine-mode level scales its slack and reserve;
    # pick's rank, which `cl` uses, keeps the conf's own reserve.
    read -r slack reserve < <(level_scale CLAUDE_ACCT_PACE_SLACK_PCT "$PACE_SLACK_PCT" CLAUDE_ACCT_RESERVE_PCT "$RESERVE_PCT")
    now="${CLAUDE_ACCT_NOW:-$(date +%s)}"
    if [[ "${1:-}" == nospend ]]; then spend=null; else spend=$(spend_24h); fi
    lives=$(live_of)
    while IFS=$'\037' read -r name kind dir own_reserve max_live parent; do
        case "$kind" in
            claude) json=$(fetch "$name" "$dir"); rc=$?; rate=$(session_rate "${1:-}") ;;
            litellm-*) json=$(fetch_source "$name" "$kind" "$dir"); rc=$?; rate=$SESSION_RATE ;; # a dollar budget has no pace
            *) json=$(fetch_source "$name" "$kind" "$dir"); rc=$?; rate=$(session_rate "${1:-}" "$name") ;;
        esac
        case $rc in
            0) state=ok ;;
            2) state=expired; json='{}' ;;
            *) state=unread; json='{}' ;;
        esac
        used=$(jq -r '.seven_day.utilization // empty' <<< "$json")
        resets=$(jq -r '.seven_day.resets_at // empty' <<< "$json")
        resets=$([[ -n "$resets" ]] && date -d "$resets" +%s 2>/dev/null)
        gone=""
        win=$(jq -r '.window // empty' <<< "$json"); win=${win:-$WEEK}
        paced=$(jq -r 'if .paced == false then false else true end' <<< "$json")
        if [[ -n "$resets" && -n "$used" && "$paced" == true ]]; then
            start=$((resets - win))
            gone=$(awk -v n="$now" -v s="$start" -v w="$win" 'BEGIN { g = (n - s) * 100 / w; print (g < 0 ? 0 : g > 100 ? 100 : g) }')
        fi
        if [[ "$kind" == claude ]]; then live=$(grep -cxF -- "@$dir" <<< "$lives"); email=$(email_of "$dir")
        else live=$(jq -r --arg n "$name" '.[$n] // 0' <<< "$srclive"); email=""; fi
        # A source's own reserve is scaled by the machine-mode level like the default one.
        row_reserve=$reserve
        [[ -z "$own_reserve" ]] || read -r _ row_reserve < <(level_scale CLAUDE_ACCT_PACE_SLACK_PCT "$PACE_SLACK_PCT" CLAUDE_ACCT_RESERVE_PCT "$own_reserve")
        jq -cn --arg name "$name" --arg dir "$dir" --arg email "$email" --arg state "$state" \
            --arg kind "$kind" --argjson window "$win" --argjson paced "$paced" --arg parent "$parent" --arg max_live "$max_live" \
            --argjson usage "$json" --arg used "$used" --arg gone "$gone" \
            --arg resets "$resets" --argjson live "${live:-0}" --argjson spend "$spend" \
            --argjson now "$now" --argjson reserve "${own_reserve:-$RESERVE_PCT}" --argjson rate "$rate" \
            --argjson room_slack "$slack" --argjson room_reserve "$row_reserve" '
            def num: if . == "" then null else tonumber end;
            # What is left of the week, as points an hour to the reset, less what the live sessions
            # there already burn: lower is better. One hour per spare point, so the account whose
            # remainder would otherwise be lost at its reset gets the work. An account its sessions
            # already empty before the reset ranks behind every one with room, and among those the
            # one its sessions empty last goes first. A 5h window near full goes last.
            # Points an hour the rest of the week can carry to the reset, landing at 100% on it.
            def sustain: (100 - (.week_used // 0)) / (if .resets == null then $window / 3600 else ([(.resets - $now) / 3600, 0.1] | max) end);
            # When used falls back to the week gone plus the slack, the moment room drops `pace`:
            # with no spend the clock catches up at 100 points a week; at this burn, only when burn
            # is under that line. null when it is after the reset (the reset puts it on pace anyway).
            def on_pace($b):
                if .week_used == null or .week_gone == null then null
                elif .week_used <= .week_gone + $room_slack then $now
                else ((100 * 3600 / $window) - $b) as $g
                    | if $g <= 0 then null
                      else ($now + (.week_used - .week_gone - $room_slack) / $g * 3600 | floor) as $t
                        | if .resets != null and $t >= .resets then null else $t end
                      end
                end;
            # When the live sessions empty the window at their burn now (live x rate, the estimator
            # room judges committed by); null with no burn, or when it lasts to the reset. Past the
            # limit it is a time already gone, as capped says.
            def run_out:
                if .week_used == null or .resets == null or (.paced | not) or .burn <= 0 then null
                else ($now + (100 - .week_used) / .burn * 3600 | floor) as $t
                    | if $t >= .resets then null else $t end
                end;
            def rank:
                (.week_used // 0) as $u
                | sustain as $carry
                | (if .state == "expired" then 0
                   elif $u >= 100 then 1e9
                   elif $carry > .burn then ([1 / ($carry - .burn), 999] | min)
                   else 1e3 + .burn / (100 - $u) end)
                  + (if (.five_hour // 0) >= 100 - $reserve then 1e6 else 0 end);
            # The verdict on an automatic start, the one place the rule is written. reasons lists every
            # refusal, in this order: unread, capped (window empty, or the plan says its limit is
            # reached), reserve (inside the last of the window), pace (past the line after slack),
            # five_hour (its window inside the reserve), committed (its live sessions already use the
            # rest of the window), max_live (as many running items as the source allows); reason is
            # the first, or ok. A source whose parent pool is spent also gets `parent`, after reserve
            # (all_json). A dollar budget (paced false) has no pace line and no committed burn. A
            # dispatch floor may lift pace only, so it reads reasons == ["pace"]. An expired token is
            # idle and launching it refreshes it, so it has room. over_points is the points past the
            # line after slack; headroom_points the same, signed (for a budget: points left before the
            # reserve) and null with no window.
            def room($slack; $reserve):
                .week_used as $u | (.week_gone // 0) as $g | (.five_hour // 0) as $f
                | (if .state == "unread" then ["unread"] else
                     [if ($u != null and $u >= 100) or .reached then "capped" else empty end,
                      if $u != null and $u >= 100 - $reserve and $u < 100 then "reserve" else empty end,
                      if .paced and $u != null and $u > $g + $slack then "pace" else empty end,
                      if $f >= 100 - $reserve then "five_hour" else empty end,
                      if .paced and .state != "expired" and sustain <= .burn then "committed" else empty end,
                      if .max_live != null and .live >= .max_live then "max_live" else empty end]
                   end) as $no
                | {ok: ($no == []), reason: ($no[0] // "ok"), reasons: $no,
                   over_points: (if $u == null or (.paced | not) then 0 else ([$u - $g - $slack, 0] | max) end),
                   headroom_points: (if $u == null then null elif .paced then $g + $slack - $u else 100 - $reserve - $u end),
                   capped: (($u // 0) >= 100 or $f >= 100 or .reached), slack: $slack, reserve: $reserve};
            # why: the first refusal in a sentence, for every reader that says it (room, pick,
            # dispatch); "it has room" when there is none.
            def room_why:
                def pts: ceil | "\(.) point\(if . == 1 then "" else "s" end)";
                .room as $r
                | if $r.reason == "unread" then "its usage cannot be read"
                  elif $r.reason == "capped" then "out of its week"
                  elif $r.reason == "reserve" then "\(.week_used | floor)% of its week used, inside the last \($r.reserve)% kept for the human"
                  elif $r.reason == "pace" then
                    "\($r.over_points | pts) over its weekly pace (\(.week_used | floor)% used, \((.week_gone // 0) | floor)% of its week gone, \($r.slack | pts) of slack)"
                  elif $r.reason == "five_hour" then (if (.five_hour // 0) >= 100 then "its 5h window is spent" else "its 5h window at \(.five_hour | floor)%" end)
                  elif $r.reason == "committed" then "its \(.live) live sessions use the rest of its week before the reset"
                  elif $r.reason == "max_live" then "its \(.live) live sessions are all it takes (max_live \(.max_live))"
                  else "it has room" end;
            {name: $name, kind: $kind, dir: $dir, email: $email, state: $state,
             paced: $paced, window: $window, plan: ($usage.plan // null), reached: ($usage.reached // false),
             parent: (if $parent == "" then null else $parent end), max_live: (if $max_live == "" then null else ($max_live | tonumber) end),
             usd_used: ($usage.usd_used // null), usd_max: ($usage.usd_max // null),
             five_hour: ($usage.five_hour.utilization // null),
             five_hour_resets: ($usage.five_hour.resets_at // null | if . == null then null else (sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601? // null) end),
             week_used: ($used | num), week_gone: ($gone | num),
             resets: ($resets | num), live: $live,
             # points an hour its live sessions burn: their count times the fleet rate
             burn: ($live * $rate), rate: $rate,
             usd_24h: (if $email == "" or $spend == null then null else ($spend[$email] // 0) end)}
            | .sustain = (if .week_used == null or (.paced | not) then null else sustain end)
            | .run_out = run_out
            | .on_pace_idle = on_pace(0) | .on_pace_burn = on_pace(.burn)
            | .rank = rank
            | .room = room($room_slack; $room_reserve)
            | .room.why = room_why'
    done < <(rows_in)
}

# all_json [nospend] -> usage_json over the Claude accounts and the sources, a source whose parent
# pool is spent, unread or inside its reserve refused for `parent`: one key of a pool has room only
# when the pool does.
all_json() {
    USAGE_SOURCES=1 usage_json "$@" | jq -c -s '
        (INDEX(.[]; .name)) as $by
        | .[]
        | ($by[.parent // ""].room.reasons // []) as $p
        | if (.parent // "") != "" and ($by[.parent] == null) then
            .room.reasons = ["parent"] + [.room.reasons[] | select(. != "parent")]
            | .room.ok = false | .room.reason = "parent"
            | .room.why = "its parent \(.parent) is not a source in the sources file"
          elif ($p | any(. == "unread" or . == "capped" or . == "reserve")) then
            def first_group: . == "unread" or . == "capped" or . == "reserve";
            .room.reasons |= ([.[] | select(first_group)] + ["parent"] + [.[] | select(first_group | not) | select(. != "parent")])
            | .room.ok = false | .room.reason = .room.reasons[0]
            | if .room.reason == "parent" then .room.why = "its pool \(.parent) is spent or inside its reserve" else . end
          else . end'
}

# day_time <epoch> -> "Thu 19:00", or - when there is none
day_time() { if [[ -n "$1" && "$1" != null ]]; then date -d "@$1" '+%a %H:%M'; else printf -- -; fi; }

# cmd_run [--acct <name>] [claude args]: exec claude on the account cmd_pick chooses. Main is the
# unset dir, so an alt account inherited from a parent session is dropped, not passed on. The
# project label is added per launch, as claude-telemetry.sh asks. Unattended runs pick through
# agentctl-run instead; runner_contract.bats fails on a claude started any other way.
cmd_run() {
    local dir
    if [[ "${1:-}" == --acct ]]; then
        dir=$(cmd_pick "${2:?claude-acct run: --acct needs an account name}") || return 1
        shift 2
    else
        dir=$(cmd_pick)
    fi
    if [[ -n "$dir" ]]; then export CLAUDE_CONFIG_DIR="$dir"; else unset CLAUDE_CONFIG_DIR; fi
    # An account session's harness is claude, which the Stop hook records when none is set: a
    # gateway parent's AGENT_HARNESS (claude-lazer) must not label it.
    unset AGENT_HARNESS
    set +u
    # shellcheck source=/dev/null
    . "$HOME/.config/shared-hooks/claude-telemetry.sh" 2>/dev/null
    set -u
    if declare -F claude_telemetry_launch >/dev/null; then
        OTEL_RESOURCE_ATTRIBUTES="$(claude_telemetry_launch)"; export OTEL_RESOURCE_ATTRIBUTES
    fi
    exec claude "$@"
}

cmd_status() {
    if [[ "${1:-}" == --json ]]; then
        all_json | jq -s .
        return
    fi
    local line state rows
    rows=$(all_json)
    printf '%-8s %-4s %-5s %-5s %-10s %-10s %-5s %-7s %-6s %-7s %-11s %-10s %-13s %s\n' \
        SOURCE 5H WEEK GONE RUNS-OUT RESETS LIVE '24H-$' BURN/H KEEPS/H ON-PACE ROOM KIND DETAIL
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        state=$(jq -r .state <<< "$line")
        if [[ "$state" != ok ]]; then
            [[ "$state" == expired ]] && state="token expired" || state="fetch failed"
            printf '%-8s %s (%s live)\n' "$(jq -r .name <<< "$line")" "$state" "$(jq -r .live <<< "$line")"
            continue
        fi
        printf '%-8s %-4s %-5s %-5s %-10s %-10s %-5s %-7s %-6s %-7s %-11s %-10s %-13s %s\n' \
            "$(jq -r .name <<< "$line")" \
            "$(jq -r 'if .five_hour == null then "-" else "\(.five_hour | floor)%" end' <<< "$line")" \
            "$(jq -r 'if .week_used == null then "-" else "\(.week_used | floor)%" end' <<< "$line")" \
            "$(jq -r 'if .week_gone == null then "-" else "\(.week_gone | floor)%" end' <<< "$line")" \
            "$(day_time "$(jq -r .run_out <<< "$line")")" \
            "$(day_time "$(jq -r .resets <<< "$line")")" \
            "$(jq -r .live <<< "$line")" \
            "$(jq -r 'if .usd_24h == null then "-" else "$\(.usd_24h | floor)" end' <<< "$line")" \
            "$(jq -r '.burn * 100 | round / 100' <<< "$line")" \
            "$(jq -r 'if .sustain == null then "-" else (.sustain * 100 | round / 100) end' <<< "$line")" \
            "$(on_pace_word "$(jq -r .on_pace_burn <<< "$line")" "$(jq -r .resets <<< "$line")")" \
            "$(jq -r 'if .room.ok then "ok" else .room.reason end' <<< "$line")" \
            "$(jq -r .kind <<< "$line")" \
            "$(jq -r 'if .usd_max != null then "$\(.usd_used * 100 | round / 100) of $\(.usd_max | floor)" elif .kind == "claude" then .email else .plan // "-" end' <<< "$line")"
    done <<< "$rows"
    fleet_line "$rows"
}

# on_pace_word <epoch|null> <resets|null> -> "now", "Sat 01:00", or "after-reset" when it is not
# before the reset at this burn
on_pace_word() {
    local now="${CLAUDE_ACCT_NOW:-$(date +%s)}"
    if [[ -z "$1" || "$1" == null ]]; then
        [[ -n "$2" && "$2" != null ]] && printf after-reset || printf -
    elif (( $1 <= now )); then printf now
    else day_time "$1"; fi
}

# The Claude fleet sum, one definition for the fleet line and the textfile's claude_fleet_* series
# (hub-core burn.rs reads those and does not re-sum the rows). Claude accounts only: the session
# rate is theirs, and a codex or Lazer point is a different budget. Burn and keeps sum the same
# rows, the readable paced ones with a week, and are null when there is none, so an unread fleet
# publishes no figure rather than a quiet one. `rows` is those rows, for the back-on-pace times;
# `rate` is the points one live session burns an hour.
FLEET_JQ='def fleet: [.[] | select(.kind == "claude")] as $c
    | [$c[] | select(.state == "ok" and .week_used != null and .paced)] as $a
    | {live: ([$c[].live] | add // 0), rows: $a, rate: ($c[0].rate // null),
       burn: (if $a == [] then null else [$a[].burn] | add end),
       keeps: (if $a == [] then null else [$a[].sustain] | add end)};'

# fleet_line <usage rows> -> the Claude accounts in one line (FLEET_JQ): live sessions, burn against
# what the windows can carry, how many sessions that is, and when the first one is back on pace, at
# this burn and with every session stopped.
fleet_line() {
    local j now="${CLAUDE_ACCT_NOW:-$(date +%s)}"
    j=$(jq -sc "$FLEET_JQ"' fleet
        | {live, rate, burn: (.burn // 0), keeps: (.keeps // 0),
           burn_at: ([.rows[] | select(.on_pace_burn != null) | {name, t: .on_pace_burn}] | min_by(.t)),
           idle_at: ([.rows[] | select(.on_pace_idle != null) | {name, t: .on_pace_idle}] | min_by(.t))}' <<< "$1") || return 0
    jq -r --argjson now "$now" '
        def at: if .t <= $now then "\(.name) now" else "\(.name) \(.t | strflocaltime("%a %H:%M"))" end;
        "fleet: \(.live) live, burn \(.burn * 10 | round / 10)/h vs \(.keeps * 10 | round / 10)/h sustainable"
        + (if .keeps > 0 then " (\(.burn / .keeps * 10 | round / 10)x" else " (" end)
        + (if .rate != null and .rate > 0 then ", carries ~\(.keeps / .rate | floor))" else ")" end)
        + ", back on pace: "
        + (if .burn_at != null then (.burn_at | at) else "not at this burn" end)
        + (if .idle_at != null then "; if idle \(.idle_at | at)" else "" end)' <<< "$j"
}

# textfile <dir>: written to a temp file and renamed, so a scrape never reads half.
cmd_textfile() {
    local dir="${1:?usage: claude-acct textfile <dir>}" tmp
    tmp=$(mktemp "$dir/.claude_acct.prom.XXXXXX") || return 1
    if all_json | jq -rs "$FLEET_JQ"'
        def rows($metric; f):
            .[] | f as $v | select($v != null) | "\($metric){account=\"\(.name)\",kind=\"\(.kind)\"} \($v)";
        (rows("claude_account_read_ok"; if .state == "unread" then 0 else 1 end)),
        (rows("claude_account_week_used_percent"; .week_used)),
        (rows("claude_account_week_gone_percent"; .week_gone)),
        (rows("claude_account_room"; if .state == "unread" then null elif .room.ok then 1 else 0 end)),
        (rows("claude_account_room_headroom_points"; .room.headroom_points)),
        (rows("claude_account_reserve_percent"; .room.reserve)),
        # 0 for a dollar budget, which has no pace line: its burn, keeps and back-on-pace are not read
        (rows("claude_account_paced"; if .paced == false then 0 else 1 end)),
        (.[] | select(.parent != null) | "claude_account_parent{account=\"\(.name)\",kind=\"\(.kind)\",parent=\"\(.parent)\"} 1"),
        # each refusal as a label, 1 on every reason that holds the account now (ok when it has room)
        (.[] | select(.state != "unread") | .name as $n | .kind as $k | (.room.reasons | if . == [] then ["ok"] else . end)[]
            | "claude_account_room_reason{account=\"\($n)\",kind=\"\($k)\",reason=\"\(.)\"} 1"),
        (rows("claude_account_five_hour_percent"; .five_hour)),
        (rows("claude_account_five_hour_resets_timestamp_seconds"; .five_hour_resets)),
        (rows("claude_account_resets_timestamp_seconds"; .resets)),
        (rows("claude_account_run_out_timestamp_seconds"; .run_out)),
        (rows("claude_account_live_sessions"; .live)),
        (rows("claude_account_burn_points_per_hour"; if .week_used == null then null else .burn end)),
        (rows("claude_account_sustain_points_per_hour"; .sustain)),
        (rows("claude_account_on_pace_idle_timestamp_seconds"; .on_pace_idle)),
        (rows("claude_account_on_pace_burn_timestamp_seconds"; .on_pace_burn)),
        # the fleet sum (FLEET_JQ); no burn or sustain line when no Claude account was summed
        (fleet | (.rate // empty | "claude_fleet_session_rate_points_per_hour \(.)"),
            "claude_fleet_live_sessions \(.live)",
            (.burn // empty | "claude_fleet_burn_points_per_hour \(.)"),
            (.keeps // empty | "claude_fleet_sustain_points_per_hour \(.)")),
        (rows("claude_account_cost_24h_usd"; .usd_24h)),
        (rows("claude_account_usd_used"; .usd_used)),
        (rows("claude_account_usd_budget"; .usd_max))' > "$tmp" &&
        chmod 0644 "$tmp" && mv -f "$tmp" "$dir/claude_acct.prom"; then
        return 0
    fi
    rm -f "$tmp"
    return 1
}

# room_source <name> -> the verdict of one source (a Claude account or a row of the sources file) as
# a sentence on stdout: "<name>: room, ..." and exit 0, or why not and exit 1 (2 when it cannot be
# read, 3 when no such source). A refused `parent` says which pool.
room_source() {
    local row parent
    parent=$(sources 2>/dev/null | awk -F'\037' -v n="$1" '$1 == n { print $6 }')
    row=$(USAGE_ONLY="$1 $parent" all_json nospend | jq -c --arg n "$1" 'select(.name == $n)')
    if [[ -z "$row" ]]; then
        echo "claude-acct: no source '$1' in $CONF or $SRC_CONF" >&2
        return 3
    fi
    jq -r '"\(.name): " + (if .room.ok then "room, \(.week_used // 0 | floor)% of its window used"
        + (if .usd_max != null then " ($\(.usd_used * 100 | round / 100) of $\(.usd_max | floor))" else "" end)
        else .room.why end)' <<< "$row"
    jq -e '.room.ok' <<< "$row" >/dev/null && return 0
    [[ "$(jq -r .room.reason <<< "$row")" == unread ]] && return 2
    return 1
}

# room [--json]: where an automatic start may go. Only automatic starts ask this: `cl`, a running
# session and a hand start are never refused. The verdict is each usage row's `room` object, written
# once in usage_json; this picks the best account whose room is ok and says why when none is. --json
# prints the same answer for readers: {pick (that account's name, or null), why (the refusal
# sentence, or null), accounts (every account's name, dir, state, rank, live and room), sources (every
# row of the sources file, the same fields with its kind: fleet-dispatch routes over them)}.
cmd_room() {
    local all rows json=0 pick pdir pline unread closest cwhy run_out resets why='' t=''
    case "${1:-}" in
        "") ;;
        --json) json=1 ;;
        --source) room_source "${2:?usage: claude-acct room --source <name>}"; return ;;
        *) echo "usage: claude-acct room [--json | --source <name>]" >&2; return 3 ;;
    esac
    # Only --json has a reader for the sources; the sentence is about the accounts alone.
    if (( json )); then all=$(all_json nospend | jq -s .); else all=$(usage_json nospend | jq -s .); fi
    rows=$(jq '[.[] | select(.kind == "claude")]' <<< "$all")
    # One read: the best account with room, whether one is unread, and the account a refused start
    # would fall back to (pick's best) with its own why and clock. \x1f, not a tab: read collapses
    # a run of tabs, so an empty field would shift the rest.
    IFS=$'\x1f' read -r pick pdir pline unread closest cwhy run_out resets < <(jq -r '
        ([.[] | select(.room.ok)] | sort_by(.rank) | first) as $p
        | ([.[] | select(.state != "unread")] | sort_by(.rank) | first) as $c
        | [($p.name // ""), ($p.dir // ""),
           ($p // {} | "\(.name) (\(.week_used // "?")% of its week, \(.week_gone // "?" | if type == "number" then floor else . end)% gone)"),
           any(.[]; .state == "unread"), ($c.name // ""), ($c.room.why // ""), ($c.run_out // "-"), ($c.resets // "-")]
        | map(tostring) | join("\u001f")' <<< "$rows")
    if [[ -n "$pick" ]]; then :
    elif [[ "$unread" == true ]]; then why="no account has room and one cannot be read"
    elif [[ -z "$closest" ]]; then why="no account has room under its weekly pace and after its live sessions"
    else
        # Name the account a start would fall back to and why room refused it, from its own row: "no
        # account has room" alone read as every account being full (2026-11-05). The tail is the
        # RUNS-OUT or RESETS column of status, from the same row.
        if [[ "$run_out" != - ]]; then t=", runs out $(day_time "$run_out") at this rate"
        elif [[ "$resets" != - ]]; then t=", lasts to its reset $(day_time "$resets")"; fi
        why="no account has room; $closest is the closest, $cwhy$t"
    fi
    if (( json )); then
        jq --arg p "$pick" --arg w "$why" '{pick: (if $p == "" then null else $p end), why: (if $w == "" then null else $w end),
            accounts: [.[] | select(.kind == "claude") | {name, dir, state, rank, live, week_used, week_gone, five_hour, room}],
            sources: [.[] | select(.kind != "claude") | {name, kind, state, rank, live, max_live, week_used, week_gone, room}]}' <<< "$all"
    elif [[ -n "$pick" ]]; then
        echo "claude-acct: room on $pline" >&2
        printf '%s\n' "$pdir"
    else
        echo "claude-acct: $why" >&2
    fi
    [[ -n "$pick" ]] && return 0
    [[ "$unread" == true ]] && return 2
    return 1
}

# check usage: can every account be read? A failed read sends every start to the default account
# without a word, which is how the 2026-10-30 API change went two days unseen.
cmd_check() {
    local rows
    case "${1:-}" in
        usage)
            rows=$(usage_json nospend | jq -s .)
            jq -r 'map(select(.state == "unread") | .name) as $bad |
                if ($bad | length) > 0 then "cannot read usage of \($bad | join(", "))"
                else "usage read on \(length) accounts" end' <<< "$rows"
            [[ "$(jq 'any(.state == "unread")' <<< "$rows")" == false ]] ;;
        pace)
            # Over pace is the room verdict's own words (pace, reserve, capped), never a second
            # formula. An unread source cannot be told on pace, so it trips too; a Claude account's
            # unread is check usage's (the claude-acct-usage watch), so it is not named twice.
            rows=$(all_json nospend | jq -s '[.[] | {name, unread: (.state == "unread" and .kind != "claude"),
                over: [(.room.reasons // [])[] | select(. == "pace" or . == "reserve" or . == "capped")]}]')
            jq -r '(map(select(.unread) | .name)) as $u | (map(select(.over != [])) | map("\(.name) \(.over | join("+"))")) as $o
                | if length == 0 then "no sources read"
                  elif $u == [] and $o == [] then "every source on pace (\(length) sources)"
                  else [if $u != [] then "unread: \($u | join(", "))" else empty end,
                        if $o != [] then "over pace: \($o | join(", "))" else empty end] | join("; ") end' <<< "$rows"
            # no row at all is nothing read, never a quiet green
            [[ "$(jq 'length > 0 and all(.unread == false and .over == [])' <<< "$rows")" == true ]] ;;
        *) echo "usage: claude-acct check usage|pace" >&2; return 2 ;;
    esac
}

# --- move ------------------------------------------------------------------------------
# A session stopped on one account's limit carries on from the other: the accounts share
# projects/ (the transcripts) and sessions/ (the live registry), so `claude --resume <id>`
# continues the same conversation from either one.

PROC="${CLAUDE_ACCT_PROC:-/proc}"
REGISTRY="$MAIN_DIR/sessions"
# A TUI dialog and a new registry entry have no event to await, so move looks at the pane and
# the registry on this one cadence, for at most MOVE_TIMEOUT seconds each.
MOVE_POLL="${CLAUDE_ACCT_POLL:-0.5}"
MOVE_TIMEOUT="${CLAUDE_ACCT_MOVE_TIMEOUT:-60}"
# Flags a resumed claude keeps from the one it replaces; the rest (a brief, --resume) are spent.
CARRY_VALUE=(--model --permission-mode --disallowedTools)
CARRY_BARE=(--dangerously-skip-permissions --allow-dangerously-skip-permissions)
# The from= of a session that ran on the gateway, the name agent-panel gives it: never an account dir.
GATEWAY_FROM=gateway

# norm_dir <dir> -> the account dir as accounts() spells it: empty for the main account
norm_dir() {
    local d="${1%/}"
    [[ "$d" == "$MAIN_DIR" ]] && d=""
    printf '%s' "$d"
}

# config_dir_of <pid> -> the CLAUDE_CONFIG_DIR that process runs under, empty = main
config_dir_of() {
    norm_dir "$(env_of "$1" CLAUDE_CONFIG_DIR)"
}

# gateway_of <pid> -> the ANTHROPIC_BASE_URL that process runs on (claude-lazer), empty = an account
gateway_of() {
    env_of "$1" ANTHROPIC_BASE_URL
}

# env_of <pid> <name> -> the first value of that variable in the process environment, read with
# builtins (live_of calls it for every running claude)
env_of() {
    local kv
    while IFS= read -r -d '' kv || [[ -n "$kv" ]]; do
        [[ "$kv" == "$2="* ]] && { printf '%s' "${kv#"$2="}"; return 0; }
    done 2>/dev/null < "$PROC/$1/environ"
    return 0
}

# ppid_of <pid> -- the fourth field of stat, read after the comm, which may hold spaces
ppid_of() {
    local st
    st=$(cat "$PROC/$1/stat" 2>/dev/null) || return 1
    st="${st##*) }"
    printf '%s' "$st" | cut -d' ' -f2
}

# descends <pid> <ancestor> -- the process is the ancestor or runs somewhere under it
descends() {
    local p="$1" n
    for ((n = 0; n < 16; n++)); do
        [[ "$p" == "$2" ]] && return 0
        p=$(ppid_of "$p") || return 1
        [[ -n "$p" && "$p" != 0 && "$p" != 1 ]] || return 1
    done
    return 1
}

# name_of <dir> -> the account's name in the accounts file, or the dir itself
name_of() {
    local name dir
    while IFS=$'\037' read -r name dir; do
        [[ "$dir" == "$1" ]] && { printf '%s' "$name"; return; }
    done < <(accounts)
    printf '%s' "${1:-default}"
}

# carry_flags <pid> -> the CARRY_* flags from its command line, shell-quoted
carry_flags() {
    local -a argv out=()
    local i a f
    mapfile -d '' -t argv < "$PROC/$1/cmdline" 2>/dev/null || return 0
    for ((i = 1; i < ${#argv[@]}; i++)); do
        a="${argv[i]}"
        for f in "${CARRY_BARE[@]}"; do [[ "$a" == "$f" ]] && out+=("$a"); done
        for f in "${CARRY_VALUE[@]}"; do
            if [[ "$a" == "$f" && -n "${argv[i+1]:-}" ]]; then out+=("$a" "${argv[i+1]}"); ((i++))
            elif [[ "$a" == "$f="* ]]; then out+=("$f" "${a#*=}"); fi
        done
    done
    ((${#out[@]})) && printf '%q ' "${out[@]}"
    return 0
}

# hold_refusal <verb> <status> <stop shells 0|1> -> why this session's claude must not exit
#   now, or nothing (exit 1) when it may
# A session with background shells exits only with --stop-shells. The /exit dialog's other
# way out, "Move to background", forks the conversation into a `claude daemon` session that
# stays on the old account: a second agent in the same worktree once that account resets,
# and on 2026-10-29 it did not keep agent-35's shell alive either.
hold_refusal() {
    case "$2" in
        busy)    echo "busy mid-turn; $1 it once the turn ends"; return 0 ;;
        waiting) echo "waiting in a permission or question dialog; answer it first"; return 0 ;;
        shell)   [[ "${3:-0}" == 1 ]] || { echo "background shells are running; $1 it once they finish, or pass --stop-shells to stop them"; return 0; } ;;
        idle) ;;
        *)       echo "unknown session status '${2:-none}'"; return 0 ;;
    esac
    return 1
}

# refusal <status> <from dir> <to dir> <score> <name> <note> <stop shells 0|1> [chosen]
#   -> why this session must not move, or nothing (exit 1) when it may: hold_refusal, then
#   whether the account it would move to has room for it. That account is the best one, or
#   with `chosen` set, the one --to named.
refusal() {
    hold_refusal move "$1" "${7:-0}" && return 0
    if [[ -n "${8:-}" ]]; then
        if [[ -z "$4" ]]; then echo "no usage data for $5, so it is not known to have room"; return 0; fi
        if awk -v s="$4" 'BEGIN { exit !(s >= 100) }'; then echo "$5 has no room ($6)"; return 0; fi
        if [[ "$2" == "$3" ]]; then echo "already on $5 ($6)"; return 0; fi
        return 1
    fi
    if [[ -z "$4" ]]; then echo "no usage data, so no account is known to have room"; return 0; fi
    if awk -v s="$4" 'BEGIN { exit !(s >= 100) }'; then
        echo "no account has room (the best is $5: $6)"; return 0
    fi
    if [[ "$2" == "$3" ]]; then echo "already on $5, the account with the most room ($6)"; return 0; fi
    return 1
}

# shell_kind <command> -> local, remote or other. local is a gate, suite or Unity run on this
# machine: stopping it throws the run away. remote is a wait on GitHub (`gh-run-wait`, `gh run
# watch`, `gh pr checks --watch`, an `until ... gh ...; do sleep` loop): the run goes on without it,
# and a resumed session re-checks it in one call. A command that is both is local.
shell_kind() {
    local re_local='(^|[^[:alnum:]_.-])(ci-gate|suite|run)\.sh([^[:alnum:]_.-]|$)|(^|[/[:space:]])Unity([[:space:]]|$)|-batchmode'
    local re_loop='(^|[;&|({[:space:]])(until|while)[[:space:]].*gh[[:space:]].*;[[:space:]]*do[[:space:]].*sleep'
    local re_waiter='(^|[^[:alnum:]_.-])gh-run-wait([^[:alnum:]_.-]|$)'
    if [[ "$1" =~ $re_local ]]; then echo local
    elif [[ "$1" =~ $re_waiter || "$1" =~ gh[[:space:]]+run[[:space:]]+watch || "$1" =~ $re_loop ||
            ( "$1" =~ gh[[:space:]]+pr[[:space:]]+checks && "$1" == *--watch* ) ]]; then echo remote
    else echo other; fi
}

# shells_refusal <bg_shells lines> -> why park must not stop these shells, or nothing (exit 1)
# when every one is a remote wait. A local run is named first: it is the costly one to lose.
shells_refusal() {
    local kind pid cmd
    for kind in local other; do
        while read -r pid cmd; do
            [[ -n "$pid" && "$(shell_kind "$cmd")" == "$kind" ]] || continue
            if [[ "$kind" == local ]]; then
                echo "a local gate or suite is running ($pid: ${cmd:0:80}); stopping it throws the run away, so park it once the run ends"
            else
                echo "a background shell is not a remote wait ($pid: ${cmd:0:80}); park it once it ends"
            fi
            return 0
        done <<< "$1"
    done
    return 1
}

# dialog_choice <screen> -> the number of /exit's "Exit and stop tasks" option
dialog_choice() {
    grep -oE '([0-9])\. Exit and stop tasks' <<< "$1" | head -n1 | cut -c1
}

# bg_shells <pid> -> "pid  command" for each background shell that claude runs: a child
# shell sourcing one of its shell snapshots, the way the Bash tool starts a command. The whole
# command, since shell_kind reads its tail; a listing cuts it.
bg_shells() {
    local f st c
    for f in "$PROC"/[0-9]*/stat; do
        { read -r st < "$f"; } 2>/dev/null || continue   # a process may end mid-scan
        st="${st##*) }"; st="${st#* }"
        [[ "${st%% *}" == "$1" ]] || continue
        c=$(tr '\0' ' ' < "${f%/stat}/cmdline" 2>/dev/null)
        [[ "$c" == *shell-snapshots* ]] || continue
        [[ "$c" == *"eval '"* ]] && c="${c#*eval \'}"
        f="${f%/stat}"
        printf '%s  %s\n' "${f##*/}" "$c"
    done
}

# tmux_servers -> the name of every tmux socket in this user's socket dir
tmux_servers() {
    local d="${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)" s
    for s in "$d"/*; do [[ -S "$s" ]] && printf '%s\n' "${s##*/}"; done
    return 0
}

# find_claude <server> <session> [window] [pane] -> "pid US pane US pane_pid US registry file US
# window index" for each live claude in the session's panes (only that window's, by index or
# name, or only that pane, when given): one whose registered pid is the pane's process or under it.
find_claude() {
    local pane ppid widx wname f pid
    while read -r pane ppid widx wname; do
        [[ -z "${4:-}" || "$pane" == "$4" ]] || continue
        [[ -z "${3:-}" || "$widx" == "$3" || "$wname" == "$3" ]] || continue
        for f in "$REGISTRY"/*.json; do
            [[ -f "$f" ]] || continue
            pid=$(jq -r '.pid // empty' "$f" 2>/dev/null)
            [[ -n "$pid" && -d "$PROC/$pid" ]] || continue
            descends "$pid" "$ppid" || continue
            printf '%s\037%s\037%s\037%s\037%s\n' "$pid" "$pane" "$ppid" "$f" "$widx"
        done
    done < <(tmux -L "$1" list-panes -s -t "=$2:" -F '#{pane_id} #{pane_pid} #{window_index} #{window_name}' 2>/dev/null)
}

# has_window <server> <session> <window> -- the session has that window, by index or name
has_window() {
    tmux -L "$1" list-windows -t "=$2:" -F '#{window_index} #{window_name}' 2>/dev/null |
        awk -v w="$3" '{ i = $1; sub(/^[^ ]* /, ""); if (i == w || $0 == w) f = 1 } END { exit !f }'
}

# pane_session <server> <pane id> -> the tmux session that pane is in; fails when the server has
# no such pane
pane_session() {
    local s
    s=$(tmux -L "$1" display-message -p -t "$2" '#{session_name}' 2>/dev/null) && [[ -n "$s" ]] && printf '%s' "$s"
}

# await <what> <command...> -- run the command every MOVE_POLL seconds until it succeeds
await() {
    local what="$1" end=$(( $(date +%s) + MOVE_TIMEOUT ))
    shift
    until "$@" > /dev/null; do
        (( $(date +%s) >= end )) && { echo "claude-acct: timed out after ${MOVE_TIMEOUT}s waiting for $what" >&2; return 1; }
        sleep "$MOVE_POLL"
    done
}

# leave_mode <server> <pane> -- take the pane out of any tmux mode before keys are typed into
# it; fails if it is still in one. Copy mode swallows typed keys, and the session picker
# (choose-tree) acts on them: its x then y kill a session. `copy-mode -q` cancels every mode,
# and does nothing to a pane in none.
leave_mode() {
    tmux -L "$1" copy-mode -q -t "$2" 2>/dev/null
    [[ "$(tmux -L "$1" display-message -p -t "$2" '#{pane_in_mode}' 2>/dev/null)" != 1 ]]
}

# exited <server> <pane> <pid> <stop shells 0|1> -- the claude is gone; with --stop-shells
# it answers the background-shell dialog on the way with "Exit and stop tasks".
exited() {
    [[ -d "$PROC/$3" ]] || return 0
    [[ "$4" == 1 ]] || return 1
    local n
    n=$(dialog_choice "$(tmux -L "$1" capture-pane -p -t "$2" 2>/dev/null)")
    [[ -n "$n" ]] && tmux -L "$1" send-keys -t "$2" "$n"
    return 1
}

# trust_step <server> <pane> -- one step through Claude's folder trust prompt, taken from what
# the pane shows: the cursor on "No, exit" (the default) gets Down, on "Yes, I trust this folder"
# gets Enter. One key a call, each sent only once the redraw of the last one shows: two keys
# sent back to back can lose the first. An account that never opened a folder (or, for a
# worktree, its main checkout) asks; Claude keeps that trust per account in .claude.json,
# which claude-acct never writes. Fails when the pane shows no trust prompt.
TRUST_CURSOR=$'\xe2\x9d\xaf'
trust_step() {
    local screen
    screen=$(tmux -L "$1" capture-pane -p -t "$2" 2>/dev/null)
    grep -qF 'Yes, I trust this folder' <<<"$screen" || return 1
    leave_mode "$1" "$2" || return 0
    if grep -qE "$TRUST_CURSOR *Yes, I trust this folder" <<<"$screen"; then
        tmux -L "$1" send-keys -t "$2" Enter
    else
        tmux -L "$1" send-keys -t "$2" Down
    fi
}

# resumed <session id> <old pid> <to dir> -- a new claude registered that session id on the
# target account; prints "pid status" for it
# resumed_or_trusted <server> <pane> <resumed args...> -- resumed, stepping through the folder
# trust prompt on the way. The same conversation already ran in that folder on its old account,
# so the trust carries over.
resumed_or_trusted() {
    local server="$1" pane="$2"
    shift 2
    resumed "$@" && return 0
    trust_step "$server" "$pane"
    return 1
}

# ready_or_trusted <server> <pane> <ready text> -- the pane shows <ready text> and no trust
# prompt; a trust prompt gets its next step.
ready_or_trusted() {
    trust_step "$1" "$2" && return 1
    tmux -L "$1" capture-pane -p -t "$2" 2>/dev/null | grep -qF -- "$3"
}

# cmd_trust <server> <pane> <ready text> -- for a launcher that started a claude in a fresh
# folder (fleet-dispatch start): wait for it, answering the trust prompt once.
cmd_trust() {
    (($# == 3)) || { echo "usage: claude-acct trust <server> <pane> <ready text>" >&2; return 2; }
    await "claude in $1 $2 to show \"$3\"" ready_or_trusted "$1" "$2" "$3"
}
resumed() {
    local f pid
    for f in "$REGISTRY"/*.json; do
        [[ -f "$f" ]] || continue
        [[ "$(jq -r '.sessionId // empty' "$f" 2>/dev/null)" == "$1" ]] || continue
        pid=$(jq -r '.pid // empty' "$f")
        [[ -n "$pid" && "$pid" != "$2" && -d "$PROC/$pid" ]] || continue
        [[ "$(config_dir_of "$pid")" == "$3" ]] || continue
        printf '%s %s\n' "$pid" "$(jq -r '.status // "-"' "$f")"
        return 0
    done
    return 1
}

# --- park and unpark -------------------------------------------------------------------
# A parked session costs nothing: its claude has exited, so no background task finishing and
# no peer's message can wake it to re-read its context (on 2026-11-02, 48% of the fleet's
# tokens were such wakes on sessions waiting on CI). park exits it and writes a ledger with
# what unpark needs; unpark resumes it in the same pane on the account best() names then.
# move is park and unpark back to back, so there is one exit path and one resume path.
PARKED="${CLAUDE_ACCT_PARKED_DIR:-$HOME/.agent/parked}"

# record <session> <what> -- park, move and unpark change the fleet the way a hold does, so each
# pages low with a `park: <session>` title, as agent-hold does with `hold:` and `go:`. The
# ledger is removed on unpark; agent-notify's log is what keeps the history.
# record <ledger key> <what happened> [parked|unparked <session id>] -- a low page, and with an
# action a dispatch step on the notes ingest record, under the queue item that session works,
# so `notes log --item` shows the stop and the resume.
record() {
    local by="" item=""
    [[ -n "${TMUX:-}" ]] && by=$(tmux display-message -p '#S' 2>/dev/null)
    agent-notify -p low -t "park: $1" "$2 (by ${by:-${PWD##*/}})" >/dev/null 2>&1 || true
    [[ -n "${3:-}" ]] || return 0
    [[ -n "${4:-}" ]] && item=$(agent-queue mine --sid "$4" 2>/dev/null)
    chain_event dispatch "$3" "-" "$2" --item "$item" --why "$1" --by claude-acct
}

# ledger_get <file> <key> -> that key's value in a park ledger (one key=value per line)
ledger_get() { sed -n "s/^$2=//p" "$1" 2>/dev/null | head -n1; }

# refuse <why...> -- one line naming the caller's $verb and its target ($what, else $session), exit 1
refuse() { echo "claude-acct: $verb ${what:-$session}: $*" >&2; return 1; }

# split_target <target> -> "server US session US window US pane" from [server/]session[:window]
# or [server/]%pane; fails on anything else
split_target() {
    local t="$1" srv="" ses="" win="" pane=""
    if [[ "$t" == */* ]]; then srv="${t%%/*}"; t="${t#*/}"; [[ -n "$srv" ]] || return 1; fi
    [[ -n "$t" && "$t" != */* ]] || return 1
    if [[ "$t" == %* ]]; then
        [[ "$t" =~ ^%[0-9]+$ ]] || return 1
        pane="$t"
    elif [[ "$t" == *:* ]]; then
        ses="${t%%:*}" win="${t#*:}"
        [[ -n "$ses" && -n "$win" && "$win" != *:* ]] || return 1
    else
        ses="$t"
    fi
    printf '%s\037%s\037%s\037%s\n' "$srv" "$ses" "$win" "$pane"
}

# resume_prompt <move|park> <from name> <to name> <status> -> what the resumed session is told
resume_prompt() {
    local p old="the $2 Claude account" why="$2 is out of usage"
    if [[ "$1" == move ]]; then
        [[ "$2" == "$GATEWAY_FROM" ]] && { old="the Lazer gateway"; why="the gateway refused it on budget"; }
        p="This session was moved from $old to $3, because $why. Nothing else changed: same conversation, same worktree. Pick up where you left off."
        [[ "$4" == shell ]] && p+=" The move stopped your background shells: restart any you still need."
    else
        p="This session was parked to save Claude usage: its claude exited while it waited, and it is now resumed on the $3 account. Same conversation, same worktree. Whatever you were waiting on (CI, a PR, a review, a hold) may have moved while you were parked, so re-check it before you carry on."
        [[ "$4" == shell ]] && p+=" Parking stopped your background waits: check what they watched directly instead of restarting them."
    fi
    printf '%s' "$p"
}

# launch_env <cwd> [item] -> the launch-line prefix for a claude that is its pane's own process, which
# runs no rc file: its queue item, then claude-telemetry.sh's claude_launch_env. Says so on stderr when
# it cannot build one.
launch_env() {
    local f="$HOME/.config/shared-hooks/claude-telemetry.sh" env
    [[ -z "${2:-}" ]] || printf 'AGENT_QUEUE_ITEM=%q ' "$2"
    # shellcheck disable=SC2016
    env=$(cd "$1" 2>/dev/null && AGENT_QUEUE_ITEM=${2:-} bash -c '. "$1" >/dev/null && claude_launch_env' _ "$f") ||
        { echo "claude-acct: no launch env from $f; the resume exports no telemetry" >&2; return 0; }
    printf '%s' "$env"
}

# resume_cmd <direct 0|1> <cwd> <to dir> <claude ... --resume <id>> <prompt> [item] -> the command
# that resumes the session on that account: run as the pane's process, with launch_env, when direct,
# typed into the pane's shell (after a cd) when not
resume_cmd() {
    local c
    c="$4 $(printf %q "$5")"
    [[ "$1" == 1 ]] && c="$(launch_env "$2" "${6:-}")$c"
    if [[ -n "$3" ]]; then c="CLAUDE_CONFIG_DIR=$(printf %q "$3") $c"
    else c="env -u CLAUDE_CONFIG_DIR $c"; fi
    [[ "$1" == 1 ]] || c="cd $(printf %q "$2") && $c"
    printf '%s' "$c"
}

# park_flow <park|move> <target> [--server S] [--to <account>] [--stop-shells] [--dry-run]
park_flow() {
    local verb="$1" what="" session="" window="" pane_t="" key="" server="" dry=0 stop=0 to_name="" to_dir="" srv
    shift
    while (($#)); do
        case "$1" in
            --server) [[ -n "${2:-}" ]] || { echo "claude-acct: $verb: --server needs a value" >&2; return 2; }
                      server="$2"; shift 2 ;;
            --to) [[ "$verb" == move ]] || { echo "claude-acct: $verb: --to is for move" >&2; return 2; }
                  [[ -n "${2:-}" ]] || { echo "claude-acct: $verb: --to needs an account name" >&2; return 2; }
                  to_name="$2"; shift 2 ;;
            --dry-run) dry=1; shift ;;
            --stop-shells) stop=1; shift ;;
            -*) echo "claude-acct: $verb: unknown flag '$1'" >&2; return 2 ;;
            *) [[ -z "$what" ]] || { echo "claude-acct: $verb: one session at a time" >&2; return 2; }
               what="$1"; shift ;;
        esac
    done
    [[ -n "$what" ]] || { echo "claude-acct: $verb: name the tmux session, window or pane to $verb" >&2; return 2; }
    srv=$(split_target "$what") ||
        { echo "claude-acct: $verb: '$what' is not [server/]session[:window] or a pane id" >&2; return 2; }
    IFS=$'\037' read -r srv session window pane_t <<< "$srv"
    if [[ -n "$srv" ]]; then
        [[ -z "$server" || "$server" == "$srv" ]] || { echo "claude-acct: $verb: '$what' names server $srv, --server $server" >&2; return 2; }
        server="$srv"
    fi
    if [[ -n "$to_name" ]]; then
        local n d known=0
        while IFS=$'\037' read -r n d; do
            [[ "$n" == "$to_name" ]] && { known=1; to_dir="$d"; }
        done < <(accounts)
        ((known)) || { echo "claude-acct: $verb: no account '$to_name' in $CONF (have: $(accounts | cut -d$'\037' -f1 | paste -sd' '))" >&2; return 2; }
    fi

    if [[ -z "$server" ]]; then
        local s found=()
        while read -r s; do
            if [[ -n "$pane_t" ]]; then pane_session "$s" "$pane_t" > /dev/null && found+=("$s")
            else tmux -L "$s" has-session -t "=$session" 2>/dev/null && found+=("$s"); fi
        done < <(tmux_servers)
        case ${#found[@]} in
            0) [[ -n "$pane_t" ]] && { refuse "no tmux server has that pane"; return; }
               refuse "no tmux server has that session"; return ;;
            1) server="${found[0]}" ;;
            *) refuse "on servers ${found[*]}; pass --server"; return ;;
        esac
    fi
    if [[ -n "$pane_t" ]]; then
        session=$(pane_session "$server" "$pane_t") || { refuse "no such pane on server $server"; return; }
    fi
    tmux -L "$server" has-session -t "=$session" 2>/dev/null || { refuse "no such session on server $server"; return; }
    if [[ -n "$window" ]] && ! has_window "$server" "$session" "$window"; then
        refuse "no window $window in session $session on server $server"; return
    fi

    # A session target's ledger is the session; a window or pane is one claude among others, so
    # its ledger is session:window, and only that window or pane is searched.
    local hits pid pane pane_pid reg win
    hits=$(find_claude "$server" "$session" "$window" "$pane_t")
    if [[ -z "$hits" ]]; then
        if [[ -z "$window$pane_t" && -f "$PARKED/$session" ]]; then
            refuse "no live claude in its panes: it is parked (claude-acct unpark $session)"; return
        fi
        refuse "no live claude in its panes"; return
    fi
    if (( $(wc -l <<< "$hits") > 1 )); then
        [[ -n "$window$pane_t" ]] && { refuse "more than one claude in that window; name the pane"; return; }
        refuse "more than one claude in its panes; name the window (${session}:N) or the pane"; return
    fi
    IFS=$'\037' read -r pid pane pane_pid reg win <<< "$hits"
    key="$session"
    if [[ -n "$window$pane_t" ]]; then
        [[ -n "$win" ]] || { refuse "cannot read the window index of pane $pane"; return; }
        key="$session:$win"
    fi
    if [[ "$key" != "$session" && -f "$PARKED/$key" && "$(ledger_get "$PARKED/$key" pane)" != "$pane" ]]; then
        refuse "window $key already holds a parked pane ($(ledger_get "$PARKED/$key" pane)); unpark it first"; return
    fi
    what="$key"

    local status sid cwd from b score name to note why shells=""
    status=$(jq -r '.status // empty' "$reg"); sid=$(jq -r '.sessionId // empty' "$reg"); cwd=$(jq -r '.cwd // empty' "$reg")
    [[ -n "$sid" && -d "$cwd" ]] || { refuse "its registry entry $reg has no session id or cwd"; return; }
    from=$(config_dir_of "$pid")
    # A claude-lazer pane (a dispatch start routed to Lazer, a `cl --lazer`) is on no account. A move
    # puts it on one on purpose; an unpark would do that unasked, so park refuses.
    if [[ -n "$(gateway_of "$pid")" ]]; then
        [[ "$verb" == move ]] || { refuse "it runs on the Lazer gateway, not an account; a resume would put it on one (claude-acct move does that on purpose)"; return; }
        from=$GATEWAY_FROM
    fi
    [[ "$status" == shell ]] && shells=$(bg_shells "$pid")
    if [[ "$verb" == move && -n "$to_name" ]]; then
        # The named account's own score line, the same numbers best() ranks.
        b=$(scores | awk -F'\037' -v n="$to_name" '$3 == n' | head -n1 | cut -d$'\037' -f2-)
        IFS=$'\037' read -r score name to note <<< "$b"
        name="$to_name" to="$to_dir"
        why=$(refusal "$status" "$from" "$to" "$score" "$name" "$note" "$stop" chosen)
    elif [[ "$verb" == move ]]; then
        b=$(best)
        IFS=$'\037' read -r score name to note <<< "$b"
        why=$(refusal "$status" "$from" "$to" "$score" "$name" "$note" "$stop")
    else
        why=$(hold_refusal park "$status" "$stop") || why=$(shells_refusal "$shells")
    fi
    if [[ -n "$why" ]]; then
        refuse "$why"
        [[ -n "$shells" ]] && cut -c1-100 <<< "$shells" | sed 's/^/  shell /' >&2
        return 1
    fi

    local direct=0 base win
    [[ "$pid" == "$pane_pid" ]] && direct=1
    base="claude $(carry_flags "$pid")--resume $(printf %q "$sid")"
    # A shell that exported these would otherwise keep the resume on the gateway.
    [[ "$from" == "$GATEWAY_FROM" ]] && base="env -u ANTHROPIC_BASE_URL -u ANTHROPIC_AUTH_TOKEN $base"
    # The queue item a pane claude's launch line carried (fleet-dispatch's), for its respawn.
    local item=""
    ((direct)) && item=$(tr '\0' '\n' 2>/dev/null < "$PROC/$pid/environ" | sed -n 's/^AGENT_QUEUE_ITEM=//p' | head -n1)
    if [[ "$verb" == move ]]; then
        echo "claude-acct: move $key ($server $pane, claude $pid, $status) from $(name_of "$from") to $name ($note)"
    else
        echo "claude-acct: park $key ($server $pane, claude $pid, $status) on $(name_of "$from")"
    fi
    if ((direct)); then
        echo "  claude is the pane's own process: keep the pane on exit, respawn it in $cwd"
    else
        echo "  claude runs under the pane's shell: exit it and type the resume there"
    fi
    if [[ "$status" == shell ]]; then
        echo "  --stop-shells: answer /exit's dialog with 'Exit and stop tasks', stopping:"
        cut -c1-100 <<< "$shells" | sed 's/^/    /'
    fi
    if [[ "$verb" == move ]]; then
        echo "  then: $(resume_cmd "$direct" "$cwd" "$to" "$base" "$(resume_prompt move "$(name_of "$from")" "$name" "$status")" "$item")"
    else
        echo "  then: write $PARKED/$key; claude-acct unpark $key resumes it with $base, on the account with room then"
    fi
    ((dry)) && return 0
    leave_mode "$server" "$pane" || { refuse "pane $pane is in a tmux mode that did not close; typed nothing"; return; }

    # Written beside the ledger and renamed into place once the claude is gone, so a reader
    # never sees half of one, and a claude that would not exit leaves none.
    local tmp
    if ! mkdir -p "$PARKED" || ! tmp=$(mktemp "$PARKED/.$key.XXXXXX"); then refuse "cannot write to $PARKED"; return; fi
    printf '%s\n' "session=$session" "server=$server" "target=$server/$session${win:+:$win}" "pane=$pane" \
        "direct=$direct" "pid=$pid" "session_id=$sid" "cwd=$cwd" "from=$from" "status=$status" \
        "why=$verb" "parked=$(date +%s)" "resume=$base" "item=$item" > "$tmp"

    # A fleet-dispatch pane closes with its claude, and with it the session, its @dispatch
    # label and the name its ledger is filed under; held open, it is respawned in place.
    ((direct)) && tmux -L "$server" set-option -p -t "$pane" remain-on-exit on
    tmux -L "$server" send-keys -t "$pane" Escape
    tmux -L "$server" send-keys -t "$pane" -l /exit
    tmux -L "$server" send-keys -t "$pane" Enter
    if ! await "claude $pid to exit" exited "$server" "$pane" "$pid" "$stop"; then
        rm -f "$tmp"
        tmux -L "$server" send-keys -t "$pane" Escape   # closes a dialog left open
        ((direct)) && tmux -L "$server" set-option -p -u -t "$pane" remain-on-exit
        refuse "claude $pid did not exit; look at the pane"; return
    fi
    mv -f "$tmp" "$PARKED/$key"
    if [[ "$verb" == park ]]; then
        echo "claude-acct: parked $key: $PARKED/$key; claude-acct unpark $key resumes it"
        record "$key" "parked on $(name_of "$from") ($status)" parked "$sid"
        return 0
    fi
    unpark_ledger move "$PARKED/$key" "$to" "$name" "$note"
}

# unpark_ledger <verb> <ledger> [<to dir> <to name> <note>] -- resume the parked session in its
# pane, on that account or else the one best() names now, await it, then delete the ledger.
# A failure keeps the ledger, so `claude-acct unpark` can try again.
unpark_ledger() {
    local verb="$1" file="$2" what session server pane direct pid sid cwd from status why base item to name note b cmd got scope
    what="${file##*/}"
    [[ -f "$file" ]] || { refuse "not parked: no $file"; return; }
    session=$(ledger_get "$file" session); session="${session:-${what%%:*}}"
    server=$(ledger_get "$file" server); pane=$(ledger_get "$file" pane); direct=$(ledger_get "$file" direct)
    pid=$(ledger_get "$file" pid); sid=$(ledger_get "$file" session_id); cwd=$(ledger_get "$file" cwd)
    from=$(ledger_get "$file" from); status=$(ledger_get "$file" status); why=$(ledger_get "$file" why)
    base=$(ledger_get "$file" resume); item=$(ledger_get "$file" item)
    [[ -n "$server" && -n "$pane" && -n "$sid" && -n "$cwd" && -n "$base" ]] || { refuse "$file is missing a field"; return; }
    # claude finds a session by its folder, so with the worktree gone nothing can resume it; the
    # ledger would only fail every later unpark (and unpark --all). Checked before tmux, since
    # the worktree and its tmux session usually go together (wt done). The page and the
    # message carry the session id and resume command, so an unmounted folder is not a loss.
    if [[ ! -d "$cwd" ]]; then
        if [[ "$direct" == 1 ]] && tmux -L "$server" has-session -t "=$session" 2>/dev/null &&
            [[ "$(tmux -L "$server" display-message -p -t "$pane" '#{pane_dead}' 2>/dev/null)" == 1 ]]; then
            tmux -L "$server" kill-pane -t "$pane"
        fi
        rm -f "$file"
        echo "claude-acct: $verb $what: its worktree $cwd is gone, so session $sid cannot resume; dropped $file (it was: $base)" >&2
        record "$what" "dropped: worktree $cwd is gone; session $sid, $base"
        [[ "$verb" == move ]] && return 1
        return 0
    fi
    if (($# > 2)); then
        to="$3" name="$4" note="$5"
    elif b=$(best) && [[ -n "$b" ]]; then
        IFS=$'\037' read -r _ name to note <<< "$b"
    else
        to="" name=$(name_of "") note="no usage data"
    fi
    tmux -L "$server" has-session -t "=$session" 2>/dev/null ||
        { refuse "its tmux session is gone from server $server; resume it by hand in $cwd with $base"; return; }
    # A session ledger owns the session's panes; a window ledger only its own pane, since the
    # rest of a shared session runs other claudes.
    scope=""; [[ "$what" == *:* ]] && scope="$pane"
    [[ -z "$(find_claude "$server" "$session" "" "$scope")" ]] ||
        { refuse "a claude is already live in ${scope:-its panes}; delete $file if it is this session"; return; }
    cmd=$(resume_cmd "$direct" "$cwd" "$to" "$base" "$(resume_prompt "${why:-park}" "$(name_of "$from")" "$name" "$status")" "$item")

    cmd_link
    if [[ "$direct" == 1 ]]; then
        tmux -L "$server" respawn-pane -t "$pane" -c "$cwd" "$cmd" || { refuse "respawn-pane failed; the pane is held open, dead"; return; }
        tmux -L "$server" set-option -p -u -t "$pane" remain-on-exit
    else
        leave_mode "$server" "$pane" ||
            { refuse "pane $pane is in a tmux mode that did not close; typed nothing ($file is kept)"; return; }
        tmux -L "$server" send-keys -t "$pane" -l "$cmd"
        tmux -L "$server" send-keys -t "$pane" Enter
    fi
    await "session $sid to register on $name" resumed_or_trusted "$server" "$pane" "$sid" "$pid" "$to" ||
        { refuse "resume did not register; look at the pane ($file is kept for claude-acct unpark)"; return; }
    rm -f "$file"
    # Its item bills this account now; left as the gateway harness it would keep a max_live slot.
    if [[ "$from" == "$GATEWAY_FROM" ]]; then
        local item
        item=$(agent-queue mine --sid "$sid" 2>/dev/null)
        [[ -z "$item" ]] || agent-queue set "$item" agent=claude "account=$name" >/dev/null 2>&1 ||
            echo "claude-acct: $item still reads as on the gateway: agent-queue set failed" >&2
    fi
    got=$(resumed "$sid" "$pid" "$to")
    if [[ "$verb" == move ]]; then
        echo "claude-acct: moved $what to $name: claude ${got% *}, ${got#* }"
        record "$what" "moved from $(name_of "$from") to $name" unparked "$sid"
    else
        echo "claude-acct: unparked $what on $name ($note): claude ${got% *}, ${got#* }"
        record "$what" "unparked on $name" unparked "$sid"
    fi
}

cmd_park() { park_flow park "$@"; }
cmd_move() { park_flow move "$@"; }

# unpark <target>|--all -- the target names its ledger: session, session:window, or a pane id,
# which matches the ledger that holds that pane
cmd_unpark() {
    local verb=unpark session="" what="" f rc=0 n=0 srv win pane_t
    case "${1:-}" in
        "") echo "claude-acct: unpark: name the tmux session, or --all" >&2; return 2 ;;
        --all)
            (($# == 1)) || { echo "claude-acct: unpark: --all takes no session" >&2; return 2; }
            for f in "$PARKED"/*; do
                [[ -f "$f" ]] || continue
                ((n++))
                unpark_ledger unpark "$f" || rc=1
            done
            ((n)) || echo "claude-acct: unpark: nothing is parked"
            return "$rc" ;;
        -*) echo "claude-acct: unpark: unknown flag '$1'" >&2; return 2 ;;
    esac
    (($# == 1)) || { echo "claude-acct: unpark: one session at a time" >&2; return 2; }
    srv=$(split_target "$1") ||
        { echo "claude-acct: unpark: '$1' is not [server/]session[:window] or a pane id" >&2; return 2; }
    IFS=$'\037' read -r srv session win pane_t <<< "$srv"
    if [[ -n "$pane_t" ]]; then
        what="$1"
        for f in "$PARKED"/*; do
            [[ -f "$f" && "$(ledger_get "$f" pane)" == "$pane_t" ]] || continue
            [[ -z "$srv" || "$(ledger_get "$f" server)" == "$srv" ]] || continue
            ((n++)) && { refuse "more than one ledger holds that pane; unpark it by session:window"; return; }
            session="${f##*/}"
        done
        ((n)) || { refuse "not parked: no ledger holds that pane"; return; }
        win=""
    fi
    f="$PARKED/$session${win:+:$win}"
    [[ -z "$srv" || ! -f "$f" || "$(ledger_get "$f" server)" == "$srv" ]] ||
        { what="$1"; refuse "parked on server $(ledger_get "$f" server), not $srv"; return; }
    unpark_ledger unpark "$f"
}

# Sourceable for tests; the dispatch runs only when executed.
[[ "${BASH_SOURCE[0]}" != "$0" ]] && return 0

case "${1:-}" in
    pick)   shift; cmd_pick "$@" ;;
    run)    shift; cmd_run "$@" ;;
    status) shift; cmd_status "$@" ;;
    textfile) shift; cmd_textfile "$@" ;;
    room)   shift; cmd_room "$@" ;;
    check)  shift; cmd_check "$@" ;;
    cost)   cmd_cost ;;
    link)   cmd_link ;;
    move)   shift; cmd_move "$@" ;;
    park)   shift; cmd_park "$@" ;;
    unpark) shift; cmd_unpark "$@" ;;
    trust)  shift; cmd_trust "$@" ;;
    -h|--help|"") usage ;;
    *) echo "claude-acct: unknown verb '$1'" >&2; usage >&2; exit 1 ;;
esac
