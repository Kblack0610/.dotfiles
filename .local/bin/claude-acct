#!/usr/bin/env bash
#
# claude-acct - start each `cl` session on the Claude account whose week is cheapest to spend from
#
# Usage:
#   claude-acct pick [name]   # print the CLAUDE_CONFIG_DIR to use (empty = main account);
#                             # with a name, that account's dir (`cl --acct <name>`)
#   claude-acct status [--json]   # week used, week gone, pace, run-out, live sessions, 24h dollars
#   claude-acct textfile <dir>    # write <dir>/claude_acct.prom for node_exporter
#   claude-acct room     # for automatic starts: the account under its weekly pace, as pick prints it
#                        # exit 1 when none has room, 2 when none has room and one cannot be read
#   claude-acct check usage|burn  # one line, exit 1 when tripped (the Sentinel watch probes)
#   claude-acct link     # share the main ~/.claude setup into every other account dir
#   claude-acct move <tmux-session> [--server S] [--to <account>] [--stop-shells] [--dry-run]
#                        # exit that session's claude and resume it on the account pick
#                        # returns (or the one --to names), in the same pane: park, then unpark
#   claude-acct park <tmux-session> [--server S] [--stop-shells] [--dry-run]
#                        # exit that session's claude so it costs nothing while it waits,
#                        # keeping the pane; the resume goes to ~/.agent/parked/<tmux-session>
#   claude-acct unpark <tmux-session>|--all
#                        # resume a parked session in its pane, on the account pick returns now
#
# Accounts: ~/.config/claude-acct/accounts, one `name dir` per line (`-` = default).
# One account per session via CLAUDE_CONFIG_DIR; nothing here writes a credential,
# Claude refreshes each account's token itself when a session starts in that dir.
# Usage comes from the endpoint behind /usage, which rate-limits per token, so each
# answer is cached for CLAUDE_ACCT_TTL seconds.

set -uo pipefail

CONF="${CLAUDE_ACCT_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/claude-acct/accounts}"
CACHE="${CLAUDE_ACCT_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/claude-acct}"
TTL="${CLAUDE_ACCT_TTL:-300}"
MAIN_DIR="$HOME/.claude"
USAGE_URL="https://api.anthropic.com/api/oauth/usage"

# What every account shares with the main one. Everything else (.credentials.json,
# .claude.json, stats, other runtime dirs) stays per account. sessions/ is the machine's
# live-session registry (<pid>.json, read by agent-panel, ListAgents and the fleet tools),
# so a split copy hides every session on the other account.
SHARED=(settings.json settings.local.json CLAUDE.md PERSONAS.md commands hooks skills
        agents plugins output-styles themes docs mcp-profiles projects plans
        sessions)
# Shared dirs keyed by pid: an account's own copy is merged into main, not parked, since
# its files belong to sessions running right now and pids cannot collide.
MERGE=(sessions)

usage() {
    sed -n '3,/^$/s/^# \{0,1\}//p' "$0"
}

# accounts -> "name US dir" lines (US = \037, never collapsed like a tab), dir empty = default
accounts() {
    [[ -f "$CONF" ]] || return 0
    local name dir
    while read -r name dir; do
        [[ -z "$name" || "$name" == \#* ]] && continue
        [[ "$dir" == "-" ]] && dir=""
        printf '%s\037%s\n' "$name" "${dir/#\~/$HOME}"
    done < "$CONF"
}

# fetch <name> <dir> -> usage JSON on stdout
#   exit 0 = fresh data, 2 = token expired, 1 = never logged in or fetch failed
fetch() {
    local name="$1" dir="$2" cache="$CACHE/$1.json"
    if [[ -s "$cache" ]] && (( $(date +%s) - $(stat -c %Y "$cache") < TTL )); then
        cat "$cache"
        return 0
    fi
    local creds="${dir:-$MAIN_DIR}/.credentials.json" token exp
    [[ -f "$creds" ]] || return 1
    token=$(jq -r '.claudeAiOauth.accessToken // empty' "$creds" 2>/dev/null)
    exp=$(jq -r '.claudeAiOauth.expiresAt // 0' "$creds" 2>/dev/null)
    [[ -n "$token" ]] && (( ${exp:-0} > $(date +%s) * 1000 )) || return 2

    local ver tmp
    ver=$(claude --version 2>/dev/null | awk '{print $1}')
    mkdir -p "$CACHE"
    tmp=$(mktemp "$CACHE/.$name.XXXXXX")
    if curl -fsS -m 5 "$USAGE_URL" \
        -H "Authorization: Bearer $token" \
        -H "anthropic-beta: oauth-2025-04-20" \
        -H "User-Agent: claude-code/${ver:-2}" > "$tmp" 2>/dev/null \
        && jq -e '.five_hour or .seven_day' "$tmp" >/dev/null 2>&1; then
        mv "$tmp" "$cache"
        cat "$cache"
        return 0
    fi
    rm -f "$tmp"
    return 1
}

# scores -> "rank US score US name US dir US note" per account that can be scored. Lower rank is
# better (see usage_json); score is the fuller of the two windows, which `move` compares to 100.
scores() {
    usage_json nospend | jq -r '
        select(.state != "unread") |
        def p: if . == null then "-" else "\(floor)%" end;
        [.rank, ([.five_hour // 0, .week_used // 0] | max), .name, .dir,
         # An idle account token expires; launching it is what refreshes it.
         (if .state == "expired" then "token expired, refreshes on launch"
          else "5h \(.five_hour | p), 7d \(.week_used | p)" end)]
        | map(tostring) | join("\u001f")'
}

cmd_link() {
    local name dir e src dst bk
    while IFS=$'\037' read -r name dir; do
        [[ -n "$dir" && -d "$dir" ]] || continue
        for e in "${SHARED[@]}"; do
            src="$MAIN_DIR/$e" dst="$dir/$e"
            [[ -e "$src" ]] || continue
            [[ -L "$dst" && "$(readlink "$dst")" == "$src" ]] && continue
            if [[ -d "$dst" && ! -L "$dst" && " ${MERGE[*]} " == *" $e "* ]]; then
                find "$dst" -mindepth 1 -maxdepth 1 -exec mv -n -t "$src" {} +
                rmdir "$dst" 2>/dev/null   # anything left (a name clash) is parked below
            fi
            if [[ -e "$dst" || -L "$dst" ]]; then
                # Never delete what an account already had: park it for a manual merge.
                bk="$dir/.pre-share-$(date +%F)"
                mkdir -p "$bk"
                [[ -e "$bk/$e" ]] && bk="$bk/$$" && mkdir -p "$bk"
                mv "$dst" "$bk/$e"
                echo "claude-acct: $name: moved existing $e to $bk/" >&2
            fi
            ln -s "$src" "$dst"
        done
    done < <(accounts)
}

# best -> "score US name US dir US note" of the account whose week is cheapest to spend from,
# nothing without data
best() {
    # Stable sort keeps file order on a tie, so the first account (main) wins it.
    scores | sort -s -t$'\037' -g -k1,1 | head -n1 | cut -d$'\037' -f2-
}

cmd_pick() {
    cmd_link
    local b name dir note
    if [[ -n "${1:-}" ]]; then
        while IFS=$'\037' read -r name dir; do
            [[ "$name" == "$1" ]] && { printf '%s\n' "$dir"; return 0; }
        done < <(accounts)
        echo "claude-acct: no account '$1' in $CONF (have: $(accounts | cut -d$'\037' -f1 | paste -sd' '))" >&2
        return 1
    fi
    b=$(best)
    if [[ -z "$b" ]]; then
        echo "claude-acct: no usage data, using the default account" >&2
        return 0
    fi
    IFS=$'\037' read -r _ name dir note <<< "$b"
    echo "claude-acct: $name ($note)" >&2
    # Told, never refused: a human start goes ahead whatever the pace, and never moves to the
    # paid Lazer reserve on its own; the hint names it, `cl --lazer` is the human's choice.
    local rows
    rows=$(usage_json nospend | jq -s .)
    if [[ "$(jq -r --arg n "$name" '.[] | select(.name == $n) | .over_pace' <<< "$rows")" == true ]]; then
        echo "claude-acct: $name is over its weekly pace" >&2
    fi
    if jq -e 'length > 0 and all(.[]; (.week_used // 0) >= 100 or (.five_hour // 0) >= 100)' <<< "$rows" >/dev/null; then
        echo "claude-acct: every account is spent; cl --lazer runs Sonnet on the Lazer reserve" >&2
    fi
    printf '%s\n' "$dir"
}

# --- usage -----------------------------------------------------------------------------
# The weekly percent is what stops work, so pace is read against it: under the line the account
# can keep this use up until it resets. Dollars are the OTel list-price estimate, for scale only.
WEEK=604800
PACE_SLACK_PCT="${CLAUDE_ACCT_PACE_SLACK_PCT:-5}"   # how far past the pace line an automatic start may go
RESERVE_PCT="${CLAUDE_ACCT_RESERVE_PCT:-15}"        # the last of each account, kept for the human
# The endpoint is private: the hub's own env file, the same one agent-web's Infra tab loads.
PROM_ENV="${CLAUDE_ACCT_PROM_ENV:-$HOME/.config/command-center/env}"

# email_of <dir> -> the address that account is logged in as, empty if unknown
email_of() {
    local f="$HOME/.claude.json"
    [[ -n "$1" ]] && f="$1/.claude.json"
    jq -r '.oauthAccount.emailAddress // empty' "$f" 2>/dev/null
}

# live_of -> one line per running claude, the account dir it runs under
live_of() {
    local c
    for c in "$PROC"/[0-9]*/comm; do
        [[ "$(cat "$c" 2>/dev/null)" == claude ]] || continue
        c="${c%/comm}"
        config_dir_of "${c##*/}"
        echo
    done
}

# prom_q <promql> -> the instant-query answer on stdout, exit 1 when Prometheus cannot be read
prom_q() {
    local url="${CC_PROM_URL:-}"
    # shellcheck source=/dev/null
    [[ -n "$url" || ! -r "$PROM_ENV" ]] || url=$(. "$PROM_ENV" 2>/dev/null; printf '%s' "${CC_PROM_URL:-}")
    [[ -n "$url" ]] || return 1
    curl -sf -m 5 --data-urlencode "query=$1" "$url/api/v1/query" 2>/dev/null
}

# spend_24h -> {"email": dollars}, or null when Prometheus cannot be read: dollars are for scale,
# never load-bearing, so the percents still print
spend_24h() {
    local out
    out=$(prom_q 'sum by (user_email) (increase(claude_code_cost_usage_USD_total[24h]))' |
        jq -c '[.data.result[] | {key: (.metric.user_email // ""), value: (.value[1] | tonumber)}] | from_entries' 2>/dev/null)
    echo "${out:-null}"
}

# usage_json [nospend] -> one JSON object per account. state: ok, expired (idle, refreshes on launch)
# or unread. nospend skips Prometheus, so a `cl` off the LAN does not wait out its timeout.
usage_json() {
    local name dir json rc state now resets start gone used run_out over live spend lives
    now="${CLAUDE_ACCT_NOW:-$(date +%s)}"
    if [[ "${1:-}" == nospend ]]; then spend=null; else spend=$(spend_24h); fi
    lives=$(live_of)
    while IFS=$'\037' read -r name dir; do
        json=$(fetch "$name" "$dir"); rc=$?
        case $rc in
            0) state=ok ;;
            2) state=expired; json='{}' ;;
            *) state=unread; json='{}' ;;
        esac
        used=$(jq -r '.seven_day.utilization // empty' <<< "$json")
        resets=$(jq -r '.seven_day.resets_at // empty' <<< "$json")
        resets=$([[ -n "$resets" ]] && date -d "$resets" +%s 2>/dev/null)
        gone="" over="" run_out=""
        if [[ -n "$resets" && -n "$used" ]]; then
            start=$((resets - WEEK))
            gone=$(awk -v n="$now" -v s="$start" -v w="$WEEK" 'BEGIN { g = (n - s) * 100 / w; print (g < 0 ? 0 : g > 100 ? 100 : g) }')
            over=$(awk -v u="$used" -v g="$gone" 'BEGIN { print (u > g ? "true" : "false") }')
            # Straight line from the window start; nothing when it lasts to the reset.
            run_out=$(awk -v u="$used" -v n="$now" -v s="$start" -v r="$resets" 'BEGIN {
                if (u <= 0) exit; t = s + (n - s) * 100 / u; if (t < r) printf "%d", t }')
        fi
        live=$(grep -cxF -- "$dir" <<< "$lives")
        jq -cn --arg name "$name" --arg dir "$dir" --arg email "$(email_of "$dir")" --arg state "$state" \
            --argjson usage "$json" --arg used "$used" --arg gone "$gone" --arg over "$over" \
            --arg resets "$resets" --arg run_out "$run_out" --argjson live "${live:-0}" --argjson spend "$spend" \
            --argjson now "$now" --argjson reserve "$RESERVE_PCT" --argjson week "$WEEK" '
            def num: if . == "" then null else tonumber end;
            # Hours to the weekly reset per % left, so the account about to reset spends first:
            # what is left there is lost anyway. Lower is better. A 5h window near full goes last.
            def rank:
                (.week_used // 0) as $u
                | (if .state == "expired" then 0
                   elif $u >= 100 then 1e9
                   else ((if .resets == null then $week / 3600 else ([(.resets - $now) / 3600, 0.1] | max) end)
                         / (100 - $u)) end)
                  + (if (.five_hour // 0) >= 100 - $reserve then 1e6 else 0 end);
            {name: $name, dir: $dir, email: $email, state: $state,
             five_hour: ($usage.five_hour.utilization // null),
             five_hour_resets: ($usage.five_hour.resets_at // null | if . == null then null else (sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601? // null) end),
             week_used: ($used | num), week_gone: ($gone | num),
             over_pace: (if $over == "" then null else $over == "true" end),
             resets: ($resets | num), run_out: ($run_out | num), live: $live,
             usd_24h: (if $email == "" or $spend == null then null else ($spend[$email] // 0) end)}
            | .rank = rank'
    done < <(accounts)
}

# day_time <epoch> -> "Thu 19:00", or - when there is none
day_time() { if [[ -n "$1" && "$1" != null ]]; then date -d "@$1" '+%a %H:%M'; else printf -- -; fi; }

cmd_status() {
    if [[ "${1:-}" == --json ]]; then
        usage_json | jq -s .
        return
    fi
    local line state
    printf '%-8s %-4s %-5s %-5s %-6s %-10s %-10s %-5s %-7s %s\n' \
        ACCOUNT 5H WEEK GONE PACE RUNS-OUT RESETS LIVE '24H-$' EMAIL
    while IFS= read -r line; do
        state=$(jq -r .state <<< "$line")
        if [[ "$state" != ok ]]; then
            [[ "$state" == expired ]] && state="token expired" || state="fetch failed"
            printf '%-8s %s (%s live)\n' "$(jq -r .name <<< "$line")" "$state" "$(jq -r .live <<< "$line")"
            continue
        fi
        printf '%-8s %-4s %-5s %-5s %-6s %-10s %-10s %-5s %-7s %s\n' \
            "$(jq -r .name <<< "$line")" \
            "$(jq -r 'if .five_hour == null then "-" else "\(.five_hour | floor)%" end' <<< "$line")" \
            "$(jq -r 'if .week_used == null then "-" else "\(.week_used | floor)%" end' <<< "$line")" \
            "$(jq -r 'if .week_gone == null then "-" else "\(.week_gone | floor)%" end' <<< "$line")" \
            "$(jq -r 'if .over_pace == null then "-" elif .over_pace then "over" else "under" end' <<< "$line")" \
            "$(day_time "$(jq -r .run_out <<< "$line")")" \
            "$(day_time "$(jq -r .resets <<< "$line")")" \
            "$(jq -r .live <<< "$line")" \
            "$(jq -r 'if .usd_24h == null then "-" else "$\(.usd_24h | floor)" end' <<< "$line")" \
            "$(jq -r .email <<< "$line")"
    done < <(usage_json)
}

# textfile <dir>: written to a temp file and renamed, so a scrape never reads half.
cmd_textfile() {
    local dir="${1:?usage: claude-acct textfile <dir>}" tmp
    tmp=$(mktemp "$dir/.claude_acct.prom.XXXXXX") || return 1
    if usage_json | jq -rs '
        def rows($metric; f):
            .[] | f as $v | select($v != null) | "\($metric){account=\"\(.name)\"} \($v)";
        (rows("claude_account_read_ok"; if .state == "unread" then 0 else 1 end)),
        (rows("claude_account_week_used_percent"; .week_used)),
        (rows("claude_account_week_gone_percent"; .week_gone)),
        (rows("claude_account_over_pace"; if .over_pace == null then null elif .over_pace then 1 else 0 end)),
        (rows("claude_account_five_hour_percent"; .five_hour)),
        (rows("claude_account_five_hour_resets_timestamp_seconds"; .five_hour_resets)),
        (rows("claude_account_resets_timestamp_seconds"; .resets)),
        (rows("claude_account_run_out_timestamp_seconds"; .run_out)),
        (rows("claude_account_live_sessions"; .live)),
        (rows("claude_account_cost_24h_usd"; .usd_24h))' > "$tmp" &&
        chmod 0644 "$tmp" && mv -f "$tmp" "$dir/claude_acct.prom"; then
        return 0
    fi
    rm -f "$tmp"
    return 1
}

# room: where an automatic start may go. Only automatic starts ask this: `cl`, a running session
# and a hand start are never refused. An expired token means the account has been idle for hours,
# and launching it is what refreshes it, so it has room, as in pick.
cmd_room() {
    local rows row
    rows=$(usage_json nospend | jq -s .)
    row=$(jq -c --argjson slack "$PACE_SLACK_PCT" --argjson reserve "$RESERVE_PCT" '
        [.[] | select(.state != "unread")
             | select((.week_used == null) or
                      (.week_used <= .week_gone + $slack and .week_used < 100 - $reserve))
             | select((.five_hour == null) or (.five_hour < 100 - $reserve))]
        | sort_by(.rank) | first // empty' <<< "$rows")
    if [[ -n "$row" ]]; then
        echo "claude-acct: room on $(jq -r '"\(.name) (\(.week_used // "?")% of its week, \(.week_gone // "?" | if type == "number" then floor else . end)% gone)"' <<< "$row")" >&2
        jq -r .dir <<< "$row"
        return 0
    fi
    if [[ "$(jq 'any(.state == "unread")' <<< "$rows")" == true ]]; then
        echo "claude-acct: no account has room and one cannot be read" >&2
        return 2
    fi
    echo "claude-acct: no account has room under its weekly pace" >&2
    return 1
}

# check usage: can every account be read? A failed read sends every start to the default account
# without a word, which is how the 2026-10-30 API change went two days unseen.
# check burn: is the last 2h of use faster than the rest of the week can carry? Both rates are
# percentage points of an account's week, summed over accounts: used per hour over the last 2h
# (from Prometheus), against the points left divided by the hours to the later reset. The
# week-to-date average this replaced read 122% after a day at 3%/h; a 2h window sees a burst
# within the hour. A reset inside the window hides that account's use (clamped at 0), which only
# makes the alarm late. The line names the live sessions and the three costliest, so the human
# knows what to cut.
cmd_check_burn() {
    local rows now left hours sustainable rate live top
    live=$(live_of | wc -l)
    rows=$(usage_json nospend | jq -s .)
    now="${CLAUDE_ACCT_NOW:-$(date +%s)}"
    read -r left hours < <(jq -r --argjson now "$now" '
        [.[] | select(.state == "ok" and .week_used != null and .resets != null)] as $a
        | if ($a | length) == 0 then "- -"
          else "\([$a[] | 100 - .week_used] | add) \(([($a | map(.resets) | max) - $now, 360] | max) / 3600)" end' <<< "$rows")
    if [[ "$left" == - ]]; then echo "cannot read any account usage"; return 2; fi
    if ! rate=$(prom_q 'sum(clamp_min(claude_account_week_used_percent - claude_account_week_used_percent offset 2h, 0))' |
            jq -er '.data.result[0].value[1] | tonumber'); then
        echo "cannot read the 2h burn rate: Prometheus is unreachable or has no claude_account_week_used_percent"
        return 2
    fi
    sustainable=$(awk -v l="$left" -v h="$hours" 'BEGIN { printf "%.1f", l / h }')
    rate=$(awk -v r="$rate" 'BEGIN { printf "%.1f", r / 2 }')
    top=$(prom_q 'topk(3, sum by (session_id) (increase(claude_code_cost_usage_USD_total[2h])))' |
        jq -r '[.data.result | sort_by(-(.value[1] | tonumber))[] | "\(.metric.session_id[0:8]) $\(.value[1] | tonumber | floor)"] | join(", ")' 2>/dev/null)
    echo "burning ${rate}%/h over 2h, the week can carry ${sustainable}%/h (${left}% left, resets in $(awk -v h="$hours" 'BEGIN { printf "%.0f", h }')h); ${live} live sessions${top:+; top by 2h spend: $top}"
    awk -v r="$rate" -v s="$sustainable" 'BEGIN { exit !(r <= s) }'
}

cmd_check() {
    local rows
    case "${1:-}" in
        usage)
            rows=$(usage_json nospend | jq -s .)
            jq -r 'map(select(.state == "unread") | .name) as $bad |
                if ($bad | length) > 0 then "cannot read usage of \($bad | join(", "))"
                else "usage read on \(length) accounts" end' <<< "$rows"
            [[ "$(jq 'any(.state == "unread")' <<< "$rows")" == false ]]
            ;;
        burn) cmd_check_burn ;;
        *) echo "usage: claude-acct check usage|burn" >&2; return 2 ;;
    esac
}

# --- move ------------------------------------------------------------------------------
# A session stopped on one account's limit carries on from the other: the accounts share
# projects/ (the transcripts) and sessions/ (the live registry), so `claude --resume <id>`
# continues the same conversation from either one.

PROC="${CLAUDE_ACCT_PROC:-/proc}"
REGISTRY="$MAIN_DIR/sessions"
# A TUI dialog and a new registry entry have no event to await, so move looks at the pane and
# the registry on this one cadence, for at most MOVE_TIMEOUT seconds each.
MOVE_POLL="${CLAUDE_ACCT_POLL:-0.5}"
MOVE_TIMEOUT="${CLAUDE_ACCT_MOVE_TIMEOUT:-60}"
# Flags a resumed claude keeps from the one it replaces; the rest (a brief, --resume) are spent.
CARRY_VALUE=(--model --permission-mode)
CARRY_BARE=(--dangerously-skip-permissions --allow-dangerously-skip-permissions)

# norm_dir <dir> -> the account dir as accounts() spells it: empty for the main account
norm_dir() {
    local d="${1%/}"
    [[ "$d" == "$MAIN_DIR" ]] && d=""
    printf '%s' "$d"
}

# config_dir_of <pid> -> the CLAUDE_CONFIG_DIR that process runs under, empty = main
config_dir_of() {
    norm_dir "$(tr '\0' '\n' < "$PROC/$1/environ" 2>/dev/null | sed -n 's/^CLAUDE_CONFIG_DIR=//p' | head -n1)"
}

# ppid_of <pid> -- the fourth field of stat, read after the comm, which may hold spaces
ppid_of() {
    local st
    st=$(cat "$PROC/$1/stat" 2>/dev/null) || return 1
    st="${st##*) }"
    printf '%s' "$st" | cut -d' ' -f2
}

# descends <pid> <ancestor> -- the process is the ancestor or runs somewhere under it
descends() {
    local p="$1" n
    for ((n = 0; n < 16; n++)); do
        [[ "$p" == "$2" ]] && return 0
        p=$(ppid_of "$p") || return 1
        [[ -n "$p" && "$p" != 0 && "$p" != 1 ]] || return 1
    done
    return 1
}

# name_of <dir> -> the account's name in the accounts file, or the dir itself
name_of() {
    local name dir
    while IFS=$'\037' read -r name dir; do
        [[ "$dir" == "$1" ]] && { printf '%s' "$name"; return; }
    done < <(accounts)
    printf '%s' "${1:-default}"
}

# carry_flags <pid> -> the CARRY_* flags from its command line, shell-quoted
carry_flags() {
    local -a argv out=()
    local i a f
    mapfile -d '' -t argv < "$PROC/$1/cmdline" 2>/dev/null || return 0
    for ((i = 1; i < ${#argv[@]}; i++)); do
        a="${argv[i]}"
        for f in "${CARRY_BARE[@]}"; do [[ "$a" == "$f" ]] && out+=("$a"); done
        for f in "${CARRY_VALUE[@]}"; do
            if [[ "$a" == "$f" && -n "${argv[i+1]:-}" ]]; then out+=("$a" "${argv[i+1]}"); ((i++))
            elif [[ "$a" == "$f="* ]]; then out+=("$f" "${a#*=}"); fi
        done
    done
    ((${#out[@]})) && printf '%q ' "${out[@]}"
    return 0
}

# hold_refusal <verb> <status> <stop shells 0|1> -> why this session's claude must not exit
#   now, or nothing (exit 1) when it may
# A session with background shells exits only with --stop-shells. The /exit dialog's other
# way out, "Move to background", forks the conversation into a `claude daemon` session that
# stays on the old account: a second agent in the same worktree once that account resets,
# and on 2026-10-29 it did not keep agent-35's shell alive either.
hold_refusal() {
    case "$2" in
        busy)    echo "busy mid-turn; $1 it once the turn ends"; return 0 ;;
        waiting) echo "waiting in a permission or question dialog; answer it first"; return 0 ;;
        shell)   [[ "${3:-0}" == 1 ]] || { echo "background shells are running; $1 it once they finish, or pass --stop-shells to stop them"; return 0; } ;;
        idle) ;;
        *)       echo "unknown session status '${2:-none}'"; return 0 ;;
    esac
    return 1
}

# refusal <status> <from dir> <to dir> <score> <name> <note> <stop shells 0|1> [chosen]
#   -> why this session must not move, or nothing (exit 1) when it may: hold_refusal, then
#   whether the account it would move to has room for it. That account is the best one, or
#   with `chosen` set, the one --to named.
refusal() {
    hold_refusal move "$1" "${7:-0}" && return 0
    if [[ -n "${8:-}" ]]; then
        if [[ -z "$4" ]]; then echo "no usage data for $5, so it is not known to have room"; return 0; fi
        if awk -v s="$4" 'BEGIN { exit !(s >= 100) }'; then echo "$5 has no room ($6)"; return 0; fi
        if [[ "$2" == "$3" ]]; then echo "already on $5 ($6)"; return 0; fi
        return 1
    fi
    if [[ -z "$4" ]]; then echo "no usage data, so no account is known to have room"; return 0; fi
    if awk -v s="$4" 'BEGIN { exit !(s >= 100) }'; then
        echo "no account has room (the best is $5: $6)"; return 0
    fi
    if [[ "$2" == "$3" ]]; then echo "already on $5, the account with the most room ($6)"; return 0; fi
    return 1
}

# shell_kind <command> -> local, remote or other. local is a gate, suite or Unity run on this
# machine: stopping it throws the run away. remote is a wait on GitHub (`gh run watch`,
# `gh pr checks --watch`, an `until ... gh ...; do sleep` loop): the run goes on without it,
# and a resumed session re-checks it in one call. A command that is both is local.
shell_kind() {
    local re_local='(^|[^[:alnum:]_.-])(ci-gate|suite|run)\.sh([^[:alnum:]_.-]|$)|(^|[/[:space:]])Unity([[:space:]]|$)|-batchmode'
    local re_loop='(^|[;&|({[:space:]])(until|while)[[:space:]].*gh[[:space:]].*;[[:space:]]*do[[:space:]].*sleep'
    if [[ "$1" =~ $re_local ]]; then echo local
    elif [[ "$1" =~ gh[[:space:]]+run[[:space:]]+watch || "$1" =~ $re_loop ||
            ( "$1" =~ gh[[:space:]]+pr[[:space:]]+checks && "$1" == *--watch* ) ]]; then echo remote
    else echo other; fi
}

# shells_refusal <bg_shells lines> -> why park must not stop these shells, or nothing (exit 1)
# when every one is a remote wait. A local run is named first: it is the costly one to lose.
shells_refusal() {
    local kind pid cmd
    for kind in local other; do
        while read -r pid cmd; do
            [[ -n "$pid" && "$(shell_kind "$cmd")" == "$kind" ]] || continue
            if [[ "$kind" == local ]]; then
                echo "a local gate or suite is running ($pid: ${cmd:0:80}); stopping it throws the run away, so park it once the run ends"
            else
                echo "a background shell is not a remote wait ($pid: ${cmd:0:80}); park it once it ends"
            fi
            return 0
        done <<< "$1"
    done
    return 1
}

# dialog_choice <screen> -> the number of /exit's "Exit and stop tasks" option
dialog_choice() {
    grep -oE '([0-9])\. Exit and stop tasks' <<< "$1" | head -n1 | cut -c1
}

# bg_shells <pid> -> "pid  command" for each background shell that claude runs: a child
# shell sourcing one of its shell snapshots, the way the Bash tool starts a command. The whole
# command, since shell_kind reads its tail; a listing cuts it.
bg_shells() {
    local f st c
    for f in "$PROC"/[0-9]*/stat; do
        { read -r st < "$f"; } 2>/dev/null || continue   # a process may end mid-scan
        st="${st##*) }"; st="${st#* }"
        [[ "${st%% *}" == "$1" ]] || continue
        c=$(tr '\0' ' ' < "${f%/stat}/cmdline" 2>/dev/null)
        [[ "$c" == *shell-snapshots* ]] || continue
        [[ "$c" == *"eval '"* ]] && c="${c#*eval \'}"
        f="${f%/stat}"
        printf '%s  %s\n' "${f##*/}" "$c"
    done
}

# tmux_servers -> the name of every tmux socket in this user's socket dir
tmux_servers() {
    local d="${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)" s
    for s in "$d"/*; do [[ -S "$s" ]] && printf '%s\n' "${s##*/}"; done
    return 0
}

# find_claude <server> <session> -> "pid US pane US pane_pid US registry file" for each live
# claude in the session's panes: one whose registered pid is the pane's process or under it.
find_claude() {
    local pane ppid f pid
    while read -r pane ppid; do
        for f in "$REGISTRY"/*.json; do
            [[ -f "$f" ]] || continue
            pid=$(jq -r '.pid // empty' "$f" 2>/dev/null)
            [[ -n "$pid" && -d "$PROC/$pid" ]] || continue
            descends "$pid" "$ppid" || continue
            printf '%s\037%s\037%s\037%s\n' "$pid" "$pane" "$ppid" "$f"
        done
    done < <(tmux -L "$1" list-panes -s -t "=$2:" -F '#{pane_id} #{pane_pid}' 2>/dev/null)
}

# await <what> <command...> -- run the command every MOVE_POLL seconds until it succeeds
await() {
    local what="$1" end=$(( $(date +%s) + MOVE_TIMEOUT ))
    shift
    until "$@" > /dev/null; do
        (( $(date +%s) >= end )) && { echo "claude-acct: timed out after ${MOVE_TIMEOUT}s waiting for $what" >&2; return 1; }
        sleep "$MOVE_POLL"
    done
}

# leave_mode <server> <pane> -- take the pane out of any tmux mode before keys are typed into
# it; fails if it is still in one. Copy mode swallows typed keys, and the session picker
# (choose-tree) acts on them: its x then y kill a session. `copy-mode -q` cancels every mode,
# and does nothing to a pane in none.
leave_mode() {
    tmux -L "$1" copy-mode -q -t "$2" 2>/dev/null
    [[ "$(tmux -L "$1" display-message -p -t "$2" '#{pane_in_mode}' 2>/dev/null)" != 1 ]]
}

# exited <server> <pane> <pid> <stop shells 0|1> -- the claude is gone; with --stop-shells
# it answers the background-shell dialog on the way with "Exit and stop tasks".
exited() {
    [[ -d "$PROC/$3" ]] || return 0
    [[ "$4" == 1 ]] || return 1
    local n
    n=$(dialog_choice "$(tmux -L "$1" capture-pane -p -t "$2" 2>/dev/null)")
    [[ -n "$n" ]] && tmux -L "$1" send-keys -t "$2" "$n"
    return 1
}

# resumed <session id> <old pid> <to dir> -- a new claude registered that session id on the
# target account; prints "pid status" for it
# resumed_or_trusted <server> <pane> <resumed args...> -- resumed, answering Claude's folder
# trust prompt once on the way: an account that never opened the ledger's cwd asks for it, and
# its default is "No, exit". The same conversation already ran in that folder on its old
# account, so the trust carries over; Claude keeps trust per account in .claude.json, which
# claude-acct never writes. TRUSTED is set empty by unpark_ledger before its wait.
resumed_or_trusted() {
    local server="$1" pane="$2"
    shift 2
    resumed "$@" && return 0
    if [[ -z "$TRUSTED" ]] && tmux -L "$server" capture-pane -p -t "$pane" 2>/dev/null | grep -qF 'Yes, I trust this folder'; then
        TRUSTED=1
        leave_mode "$server" "$pane" || return 1
        tmux -L "$server" send-keys -t "$pane" Down
        tmux -L "$server" send-keys -t "$pane" Enter
    fi
    return 1
}
resumed() {
    local f pid
    for f in "$REGISTRY"/*.json; do
        [[ -f "$f" ]] || continue
        [[ "$(jq -r '.sessionId // empty' "$f" 2>/dev/null)" == "$1" ]] || continue
        pid=$(jq -r '.pid // empty' "$f")
        [[ -n "$pid" && "$pid" != "$2" && -d "$PROC/$pid" ]] || continue
        [[ "$(config_dir_of "$pid")" == "$3" ]] || continue
        printf '%s %s\n' "$pid" "$(jq -r '.status // "-"' "$f")"
        return 0
    done
    return 1
}

# --- park and unpark -------------------------------------------------------------------
# A parked session costs nothing: its claude has exited, so no background task finishing and
# no peer's message can wake it to re-read its context (on 2026-11-02, 48% of the fleet's
# tokens were such wakes on sessions waiting on CI). park exits it and writes a ledger with
# what unpark needs; unpark resumes it in the same pane on the account best() names then.
# move is park and unpark back to back, so there is one exit path and one resume path.
PARKED="${CLAUDE_ACCT_PARKED_DIR:-$HOME/.agent/parked}"

# ledger_get <file> <key> -> that key's value in a park ledger (one key=value per line)
ledger_get() { sed -n "s/^$2=//p" "$1" 2>/dev/null | head -n1; }

# refuse <why...> -- one line naming the caller's $verb and $session, exit 1
refuse() { echo "claude-acct: $verb $session: $*" >&2; return 1; }

# resume_prompt <move|park> <from name> <to name> <status> -> what the resumed session is told
resume_prompt() {
    local p
    if [[ "$1" == move ]]; then
        p="This session was moved from the $2 Claude account to $3, because $2 is out of usage. Nothing else changed: same conversation, same worktree. Pick up where you left off."
        [[ "$4" == shell ]] && p+=" The move stopped your background shells: restart any you still need."
    else
        p="This session was parked to save Claude usage: its claude exited while it waited, and it is now resumed on the $3 account. Same conversation, same worktree. Whatever you were waiting on (CI, a PR, a review, a hold) may have moved while you were parked, so re-check it before you carry on."
        [[ "$4" == shell ]] && p+=" Parking stopped your background waits: check what they watched directly instead of restarting them."
    fi
    printf '%s' "$p"
}

# resume_cmd <direct 0|1> <cwd> <to dir> <claude ... --resume <id>> <prompt> -> the command
# that resumes the session on that account: run as the pane's process when direct, typed into
# the pane's shell (after a cd) when not
resume_cmd() {
    local c
    c="$4 $(printf %q "$5")"
    if [[ -n "$3" ]]; then c="CLAUDE_CONFIG_DIR=$(printf %q "$3") $c"
    else c="env -u CLAUDE_CONFIG_DIR $c"; fi
    [[ "$1" == 1 ]] || c="cd $(printf %q "$2") && $c"
    printf '%s' "$c"
}

# park_flow <park|move> <tmux-session> [--server S] [--to <account>] [--stop-shells] [--dry-run]
park_flow() {
    local verb="$1" session="" server="" dry=0 stop=0 to_name="" to_dir=""
    shift
    while (($#)); do
        case "$1" in
            --server) [[ -n "${2:-}" ]] || { echo "claude-acct: $verb: --server needs a value" >&2; return 2; }
                      server="$2"; shift 2 ;;
            --to) [[ "$verb" == move ]] || { echo "claude-acct: $verb: --to is for move" >&2; return 2; }
                  [[ -n "${2:-}" ]] || { echo "claude-acct: $verb: --to needs an account name" >&2; return 2; }
                  to_name="$2"; shift 2 ;;
            --dry-run) dry=1; shift ;;
            --stop-shells) stop=1; shift ;;
            -*) echo "claude-acct: $verb: unknown flag '$1'" >&2; return 2 ;;
            *) [[ -z "$session" ]] || { echo "claude-acct: $verb: one session at a time" >&2; return 2; }
               session="$1"; shift ;;
        esac
    done
    [[ -n "$session" ]] || { echo "claude-acct: $verb: name the tmux session to $verb" >&2; return 2; }
    [[ "$session" != */* ]] || { echo "claude-acct: $verb: '$session' is not a tmux session name" >&2; return 2; }
    if [[ -n "$to_name" ]]; then
        local n d known=0
        while IFS=$'\037' read -r n d; do
            [[ "$n" == "$to_name" ]] && { known=1; to_dir="$d"; }
        done < <(accounts)
        ((known)) || { echo "claude-acct: $verb: no account '$to_name' in $CONF (have: $(accounts | cut -d$'\037' -f1 | paste -sd' '))" >&2; return 2; }
    fi

    if [[ -z "$server" ]]; then
        local s found=()
        while read -r s; do
            tmux -L "$s" has-session -t "=$session" 2>/dev/null && found+=("$s")
        done < <(tmux_servers)
        case ${#found[@]} in
            0) refuse "no tmux server has that session"; return ;;
            1) server="${found[0]}" ;;
            *) refuse "on servers ${found[*]}; pass --server"; return ;;
        esac
    fi
    tmux -L "$server" has-session -t "=$session" 2>/dev/null || { refuse "no such session on server $server"; return; }

    local hits pid pane pane_pid reg
    hits=$(find_claude "$server" "$session")
    if [[ -z "$hits" ]]; then
        [[ -f "$PARKED/$session" ]] && { refuse "no live claude in its panes: it is parked (claude-acct unpark $session)"; return; }
        refuse "no live claude in its panes"; return
    fi
    (( $(wc -l <<< "$hits") == 1 )) || { refuse "more than one claude in its panes"; return; }
    IFS=$'\037' read -r pid pane pane_pid reg <<< "$hits"

    local status sid cwd from b score name to note why shells=""
    status=$(jq -r '.status // empty' "$reg"); sid=$(jq -r '.sessionId // empty' "$reg"); cwd=$(jq -r '.cwd // empty' "$reg")
    [[ -n "$sid" && -d "$cwd" ]] || { refuse "its registry entry $reg has no session id or cwd"; return; }
    from=$(config_dir_of "$pid")
    [[ "$status" == shell ]] && shells=$(bg_shells "$pid")
    if [[ "$verb" == move && -n "$to_name" ]]; then
        # The named account's own score line, the same numbers best() ranks.
        b=$(scores | awk -F'\037' -v n="$to_name" '$3 == n' | head -n1 | cut -d$'\037' -f2-)
        IFS=$'\037' read -r score name to note <<< "$b"
        name="$to_name" to="$to_dir"
        why=$(refusal "$status" "$from" "$to" "$score" "$name" "$note" "$stop" chosen)
    elif [[ "$verb" == move ]]; then
        b=$(best)
        IFS=$'\037' read -r score name to note <<< "$b"
        why=$(refusal "$status" "$from" "$to" "$score" "$name" "$note" "$stop")
    else
        why=$(hold_refusal park "$status" "$stop") || why=$(shells_refusal "$shells")
    fi
    if [[ -n "$why" ]]; then
        refuse "$why"
        [[ -n "$shells" ]] && cut -c1-100 <<< "$shells" | sed 's/^/  shell /' >&2
        return 1
    fi

    local direct=0 base win
    [[ "$pid" == "$pane_pid" ]] && direct=1
    base="claude $(carry_flags "$pid")--resume $(printf %q "$sid")"
    if [[ "$verb" == move ]]; then
        echo "claude-acct: move $session ($server $pane, claude $pid, $status) from $(name_of "$from") to $name ($note)"
    else
        echo "claude-acct: park $session ($server $pane, claude $pid, $status) on $(name_of "$from")"
    fi
    if ((direct)); then
        echo "  claude is the pane's own process: keep the pane on exit, respawn it in $cwd"
    else
        echo "  claude runs under the pane's shell: exit it and type the resume there"
    fi
    if [[ "$status" == shell ]]; then
        echo "  --stop-shells: answer /exit's dialog with 'Exit and stop tasks', stopping:"
        cut -c1-100 <<< "$shells" | sed 's/^/    /'
    fi
    if [[ "$verb" == move ]]; then
        echo "  then: $(resume_cmd "$direct" "$cwd" "$to" "$base" "$(resume_prompt move "$(name_of "$from")" "$name" "$status")")"
    else
        echo "  then: write $PARKED/$session; claude-acct unpark $session resumes it with $base, on the account with room then"
    fi
    ((dry)) && return 0
    leave_mode "$server" "$pane" || { refuse "pane $pane is in a tmux mode that did not close; typed nothing"; return; }

    # Written beside the ledger and renamed into place once the claude is gone, so a reader
    # never sees half of one, and a claude that would not exit leaves none.
    local tmp
    if ! mkdir -p "$PARKED" || ! tmp=$(mktemp "$PARKED/.$session.XXXXXX"); then refuse "cannot write to $PARKED"; return; fi
    win=$(tmux -L "$server" display-message -p -t "$pane" '#{window_index}' 2>/dev/null)
    printf '%s\n' "session=$session" "server=$server" "target=$server/$session${win:+:$win}" "pane=$pane" \
        "direct=$direct" "pid=$pid" "session_id=$sid" "cwd=$cwd" "from=$from" "status=$status" \
        "why=$verb" "parked=$(date +%s)" "resume=$base" > "$tmp"

    # A fleet-dispatch pane closes with its claude, and with it the session, its @dispatch
    # label and the name its ledger is filed under; held open, it is respawned in place.
    ((direct)) && tmux -L "$server" set-option -p -t "$pane" remain-on-exit on
    tmux -L "$server" send-keys -t "$pane" Escape
    tmux -L "$server" send-keys -t "$pane" -l /exit
    tmux -L "$server" send-keys -t "$pane" Enter
    if ! await "claude $pid to exit" exited "$server" "$pane" "$pid" "$stop"; then
        rm -f "$tmp"
        tmux -L "$server" send-keys -t "$pane" Escape   # closes a dialog left open
        ((direct)) && tmux -L "$server" set-option -p -u -t "$pane" remain-on-exit
        refuse "claude $pid did not exit; look at the pane"; return
    fi
    mv -f "$tmp" "$PARKED/$session"
    if [[ "$verb" == park ]]; then
        echo "claude-acct: parked $session: $PARKED/$session; claude-acct unpark $session resumes it"
        return 0
    fi
    unpark_ledger move "$PARKED/$session" "$to" "$name" "$note"
}

# unpark_ledger <verb> <ledger> [<to dir> <to name> <note>] -- resume the parked session in its
# pane, on that account or else the one best() names now, await it, then delete the ledger.
# A failure keeps the ledger, so `claude-acct unpark` can try again.
unpark_ledger() {
    local verb="$1" file="$2" session server pane direct pid sid cwd from status why base to name note b cmd got TRUSTED
    session="${file##*/}"
    [[ -f "$file" ]] || { refuse "not parked: no $file"; return; }
    server=$(ledger_get "$file" server); pane=$(ledger_get "$file" pane); direct=$(ledger_get "$file" direct)
    pid=$(ledger_get "$file" pid); sid=$(ledger_get "$file" session_id); cwd=$(ledger_get "$file" cwd)
    from=$(ledger_get "$file" from); status=$(ledger_get "$file" status); why=$(ledger_get "$file" why)
    base=$(ledger_get "$file" resume)
    [[ -n "$server" && -n "$pane" && -n "$sid" && -n "$cwd" && -n "$base" ]] || { refuse "$file is missing a field"; return; }
    if (($# > 2)); then
        to="$3" name="$4" note="$5"
    elif b=$(best) && [[ -n "$b" ]]; then
        IFS=$'\037' read -r _ name to note <<< "$b"
    else
        to="" name=$(name_of "") note="no usage data"
    fi
    tmux -L "$server" has-session -t "=$session" 2>/dev/null ||
        { refuse "its tmux session is gone from server $server; resume it by hand in $cwd with $base"; return; }
    [[ -z "$(find_claude "$server" "$session")" ]] ||
        { refuse "a claude is already live in its panes; delete $file if it is this session"; return; }
    cmd=$(resume_cmd "$direct" "$cwd" "$to" "$base" "$(resume_prompt "${why:-park}" "$(name_of "$from")" "$name" "$status")")

    cmd_link
    if [[ "$direct" == 1 ]]; then
        tmux -L "$server" respawn-pane -t "$pane" -c "$cwd" "$cmd" || { refuse "respawn-pane failed; the pane is held open, dead"; return; }
        tmux -L "$server" set-option -p -u -t "$pane" remain-on-exit
    else
        leave_mode "$server" "$pane" ||
            { refuse "pane $pane is in a tmux mode that did not close; typed nothing ($file is kept)"; return; }
        tmux -L "$server" send-keys -t "$pane" -l "$cmd"
        tmux -L "$server" send-keys -t "$pane" Enter
    fi
    TRUSTED=""
    await "session $sid to register on $name" resumed_or_trusted "$server" "$pane" "$sid" "$pid" "$to" ||
        { refuse "resume did not register; look at the pane ($file is kept for claude-acct unpark)"; return; }
    rm -f "$file"
    got=$(resumed "$sid" "$pid" "$to")
    if [[ "$verb" == move ]]; then echo "claude-acct: moved $session to $name: claude ${got% *}, ${got#* }"
    else echo "claude-acct: unparked $session on $name ($note): claude ${got% *}, ${got#* }"; fi
}

cmd_park() { park_flow park "$@"; }
cmd_move() { park_flow move "$@"; }

# unpark <tmux-session>|--all
cmd_unpark() {
    local verb=unpark session="" f rc=0 n=0
    case "${1:-}" in
        "") echo "claude-acct: unpark: name the tmux session, or --all" >&2; return 2 ;;
        --all)
            (($# == 1)) || { echo "claude-acct: unpark: --all takes no session" >&2; return 2; }
            for f in "$PARKED"/*; do
                [[ -f "$f" ]] || continue
                ((n++))
                unpark_ledger unpark "$f" || rc=1
            done
            ((n)) || echo "claude-acct: unpark: nothing is parked"
            return "$rc" ;;
        -*) echo "claude-acct: unpark: unknown flag '$1'" >&2; return 2 ;;
    esac
    (($# == 1)) || { echo "claude-acct: unpark: one session at a time" >&2; return 2; }
    [[ "$1" != */* ]] || { echo "claude-acct: unpark: '$1' is not a tmux session name" >&2; return 2; }
    unpark_ledger unpark "$PARKED/$1"
}

# Sourceable for tests; the dispatch runs only when executed.
[[ "${BASH_SOURCE[0]}" != "$0" ]] && return 0

case "${1:-}" in
    pick)   shift; cmd_pick "$@" ;;
    status) shift; cmd_status "$@" ;;
    textfile) shift; cmd_textfile "$@" ;;
    room)   cmd_room ;;
    check)  shift; cmd_check "$@" ;;
    link)   cmd_link ;;
    move)   shift; cmd_move "$@" ;;
    park)   shift; cmd_park "$@" ;;
    unpark) shift; cmd_unpark "$@" ;;
    -h|--help|"") usage ;;
    *) echo "claude-acct: unknown verb '$1'" >&2; usage >&2; exit 1 ;;
esac
