#!/usr/bin/env bash
# agent-land - land a gated PR and record it in one call, so a green gate costs no model call.
#
#   agent-land <pr> [--repo <owner>/<repo>] [--item <slug>] [--supersedes <n>] [--plan <file> --phase "<text>"] [--partial] [--merge-commit] [--admin] [--ran-checks] [--dry-run]
#
# Which repo <pr> is in: --repo, else the repo of the item's own pr:<owner>/<repo>#<pr>, else gh's
# default for this checkout. Either way the PR must be in this checkout's origin repo (git, the merge
# proof and autopull all read it), and a MERGED PR, which skips the head step, must be the item's:
# its body has "Item: <slug>", its head commit is in this checkout's HEAD, or the item records it.
# Why: a bare number run from a worktree of the public repo recorded an unrelated public #595 for a
# private-repo PR (2026-11-07). --supersedes <n> ties a merged <pr> another session made to the item
# instead: #<n>, in the same repo, is the item's own PR, closed unmerged because <pr> replaced it
# (supersedes_mine); the item drops #<n> from its pr: and records <pr>.
#
# Steps, stopping at the first failure: head (HEAD must be the PR's head commit, before the body is
# touched; else the merge would be refused as "Head branch was modified": run from the PR's own
# checkout; a HEAD that is origin's tip of the PR branch is a fresh push, waited on until the PR reads it), fetch (a head behind origin/<base> is merged up to it, each clean submodule checkout on its old pin moved to the merged one (submodule_follow), and pushed, before the checks and again after them if the base moved on during them; a head pushed after them waits on its own checks before it merges, and on a base without strict checks a second move lands that green head behind it, catch_up), item-line
# (before the checks, the PR body gets the line "Item: <slug>" unless it has it, so a reader holding
# only the PR finds its work item; a stale "Item:" line is rewritten, except on a merged PR where another queue item's line stays), review (a tier-3 item's body has a
# "Review:" line, review_gate), loose (a plan phase's item filed no open agent row its plan does not take, loose_gate), shape (no function over 150 lines gets longer unless the body has a "Split: <row id>" line, shape_gate), checks (the PR's checks pass: CI, a required check; a cancelled check is no pass, waited on while a run on the head goes on, and on GitHub so is a failed one while a run of its workflow and event started after it goes on, and a cancelled matrix job of an older run of its workflow is no verdict (pr-ci.sh); a tier-3 item, or one landed with --ran-checks, needs checks that ran), validate (critical work by judge.sh judge_work_level merges only on a second agent's pass verdict on this head, validate_gate), merge (--squash, or with --merge-commit a merge commit,
# for a landing train whose member PRs read MERGED only while their heads stay reachable; --admin adds gh's --admin, which skips a required approving review on a repo whose owner allows it, never the checks step above; --match-head-commit HEAD, then gh pr view must say MERGED), proof (the PR's merge commit is
# on origin/<base>, by agent-merge-proof.sh), live (dotfiles-autopull --now --bg fast-forwards, in the background, the stowed
# checkout when this repo is ~/.dotfiles or ~/.dotfiles-private, links what it added, rebuilds the
# Rust tools (notes through notes-bootstrap), restarts agent-web on a new binary and a persistent agentctl runner on a new script; it logs its result to autopull.log, and the landing prints a line, never a failure), item (the queue item gets pr:<owner>/<repo>#<pr>,
# merged:<sha>, this Claude session in its sessions (unless --partial lands on an item another session owns) and "<session>=<pr>" in its landed_by, the project credited by the PR's changed
# files (agent-queue attribute), and moves to done, status ok unless --partial keeps it open (a red watch item resolves its watch with this PR first and refuses to close ok while its probe still trips, watch_gate); a done ok item with no PR in this
# PR's repo adds it to its pr: and merged: lists instead, one PR per repo; an open item's earlier PR with
# no merge recorded takes its merge commit from gh, and one not merged refuses before the merge, settle_prior;
# a --partial landing passes one still open and leaves merged: empty for the final landing), board (the
# item's row, whatever its origin: the story `agent-queue add` filed, the board row it was
# promoted from, or the row its PR body's Task: line names when the item had none, done with proof "pr:<owner>/<repo>#<pr> commit:<sha>" on the final landing), plan (--plan: the one "- [ ] <phase>"
# line becomes "- [x] <phase> (#<pr>)"; when that leaves no open phase, each row on the plan's `rows:` line
# closes with the same proof). A row another open queue item names stays open for that item's landing (row_worker). After the merge, one "body:" line scores the PR body
# against comms-standard (comms-lint --channel pr-body); it never fails the landing. Before that, a *.md or *.txt
# file at the top of ~/.cache whose text is the merged body (the --body-file a session wrote) is deleted. Each "After deploy: <step>"
# line of the body, a step that can run only once the change is live, is added as its own item (deploy_steps). One line per step.
# The item is --item, else $AGENT_QUEUE_ITEM (set in a session fleet-dispatch started), else the
# one this session added or claimed (`agent-queue mine`). No item, no landing: every merged PR
# is a unit of work on the work ledger, so add one first (`agent-queue add --running`). An item
# taken from the session, not named by --item, takes only a PR in its project's repo, and only one it
# records or whose body names it on an "Item: <slug>" line (own_item).
# Exit 0 landed, 1 a step failed, 2 usage, 3 a catch-up merge of origin/<base> that conflicts
# (before or after the checks): resolve it and re-run, 4 an item stacked on an item that has not closed ok (stack_gate), 5 critical work waiting on its validate item (validate_gate): that session lands it on a pass, so the author winds down. A head pushed after the checks waits on its own
# checks before it merges; the local gate script runs again on a merge of <base> only when the repo's CI
# doc says it needs one.
# An already MERGED PR skips checks, fetch and merge, so a re-run finishes a failed record step.
# --partial records a merged PR with partial: yes and leaves the item and row open, for a final
# agent-land without --partial, which clears the marker and closes the item. A partial landing on
# an item another session owns records the PR without claiming the item, so self-close is not
# held up by the other session's open item. An item carries at most
# one PR per repo unless --partial lifts that limit, so a brief asking for two PRs in one repo is one
# item (land the first with --partial, the last without). If the session ends first, reap requeues the
# item and the next run makes that final landing.
# A full landing is refused, before anything is touched, while another open PR on GitHub names the item
# on its first "Item:" line, recorded on the item or not: that PR's landing closes it (split_gate).
# A PR on Forgejo (a checkout that commits the mirror marker, forge_canonical, or whose origin is on a
# host SO_FORGEJO_HOSTS lists: home-config, bnb-game-servers) runs the same steps through that host's
# API instead of gh (pr_view, pr_edit_body, fj_wait_checks, pr_merge pinned by head_commit_id,
# pr_files) and its git steps through that remote, so this is its one writer too. Why: 12 Forgejo
# merges on 2026-11-07..09 went through a raw API call and were recorded on no item (ar-1213).
# --dry-run prints the commands and runs none. No reap: `wt done` from inside the worktree
# ends the caller's own tmux session, so wind-down releases the worktree.

set -euo pipefail

usage() {
  sed -n '2,/^$/{s/^# \{0,1\}//;p}' "$0" >&2
  exit 2
}
# shellcheck source=../lib/chain-event.sh
. "${CHAIN_EVENT_LIB:-$(dirname "$(readlink -f "$0")")/../lib/chain-event.sh}"
# shellcheck source=../lib/submodule-follow.sh
. "$(dirname "$(readlink -f "$0")")/../lib/submodule-follow.sh"
# shellcheck source=../lib/plan-phases.sh
. "$(dirname "$(readlink -f "$0")")/../lib/plan-phases.sh"
# shellcheck source=../lib/judge.sh
. "$(dirname "$(readlink -f "$0")")/../lib/judge.sh"
die() {
  printf 'agent-land: %s\n' "$1" >&2
  exit 2
}
# land_failed STEP CAUSE: a landing that stopped goes on the record, where the pipeline line's done
# node reads it. A dry run lands nothing, and a wrong checkout or an unfinished PR body never began
# to land, like a refusal (die). Once merged only the bookkeeping failed, and the cause says so.
land_failed() {
  [ "${dry:-0}" = 1 ] && return 0
  case "$1" in repo | match | head | review) return 0 ;; esac
  chain_event land land-failed "${project:-}" "${pr_ref:-#${pr:-}}" --item "${item:-}" --pr "${pr_ref:-}" --why "${merged:+merged, but }$1: $2"
}
# Once its PR is merged (pr_landed, set past the refusals), a failure left only the record, and a
# re-run on the merged PR finishes it: the line says so, or the item stays in running/ with its PR merged.
pr_landed=''
fail() {
  local next=''
  [ -z "${pr_landed:-}" ] ||
    next="; #$pr is merged and only its record is left: re-run agent-land $pr${repo:+ --repo $repo}${item:+ --item $item} to finish it"
  printf 'agent-land: %s failed: %s%s\n' "$1" "$2" "$next" >&2
  land_failed "$1" "$2$next"
  exit 1
}
lastline() { printf '%s' "$1" | tail -n 1; }

# aq_retry <agent-queue args...>: agent-queue, taken again when its lock wait ran out. That exit
# (75, agent-queue's LOCK_BUSY) wrote nothing, so a retry is safe, and each attempt already waits
# out agent-queue's own lock window, so there is no pause here. Without it one busy window left a
# merged PR with no item record (#1074 needed 4 runs, 2026-11-14).
# Only the last attempt's stderr is passed on: a caller that reads `2>&1` as one answer (show --json)
# must not find a failed attempt's lock line in it.
QUEUE_BUSY=75
QUEUE_TRIES="${AGENT_LAND_QUEUE_TRIES:-3}"
aq_retry() {
  local n=1 rc err
  while :; do
    rc=0
    { err=$(agent-queue "$@" 2>&1 1>&3 3>&-) || rc=$?; } 3>&1
    [ "$rc" -eq "$QUEUE_BUSY" ] && [ "$n" -lt "$QUEUE_TRIES" ] || break
    n=$((n + 1))
  done
  [ -z "$err" ] || printf '%s\n' "$err" >&2
  return "$rc"
}

# Until a CI job starts, a PR reports no checks, and GitHub has no event for the first one: that
# one state is polled CHECKS_POLL seconds apart. While an Actions run for HEAD is still queued it
# waits on, CHECKS_QUEUED_POLL apart: a queue on a busy runner pool lasts tens of minutes, and at
# 10s each landing spent 360 REST calls an hour of the one budget every account shares (ar-1345).
# With none, it gives up after CHECKS_TRIES polls and lands on the local gate (a repo with no PR
# checks), unless no_checks would refuse it (tier 3, --ran-checks, a required check): that waits
# for a first run (CHECKS_FIRST_RUN_TRIES), then stops at checks. `gh pr checks --watch` waits out
# the rest, one read per CHECKS_WATCH_INTERVAL.
CHECKS_POLL="${AGENT_LAND_CHECKS_POLL:-10}"
CHECKS_QUEUED_POLL="${AGENT_LAND_CHECKS_QUEUED_POLL:-60}"
CHECKS_WATCH_INTERVAL=30 # gh's default is 10s; a check takes minutes
CHECKS_WATCH_TIMEOUT="${AGENT_LAND_CHECKS_WATCH_TIMEOUT:-600}" # bound one gh pr checks --watch (a check left IN_PROGRESS with conclusion SUCCESS never exits)
CHECKS_WAIT_TIMEOUT="${AGENT_LAND_CHECKS_WAIT_TIMEOUT:-3600}"  # the cap on one whole checks wait, either forge (the slowest PR run seen: 42m, playground 2026-11-22)
CHECKS_TRIES="${AGENT_LAND_CHECKS_TRIES:-12}"
# GitHub opens a PR's pull_request run only once it has built the merge ref: seconds on most PRs,
# minutes on some (80 dotfiles PRs to 2026-11-21: p90 5s, then 111s, 192s, 949s). #1710's came 213s
# after gh pr create, so a tier-3 land refused "none reported" before the run existed. A land that
# no_checks would refuse has nothing to lose by waiting, so it reads CHECKS_FIRST_RUN_TRIES more
# times, CHECKS_QUEUED_POLL apart, before refusing; one that would land on the local gate does not.
CHECKS_FIRST_RUN_TRIES="${AGENT_LAND_CHECKS_FIRST_RUN_TRIES:-20}"
# A read that loses its connection to the API (a reset, a timeout, a 5xx) has seen no check fail:
# it reads again, up to CHECKS_NET_TRIES times in one wait. It hit binks #1531 three times on
# 2026-11-13. Only the last line is classified, and on GitHub only when no check reads as failed,
# since a check's name may hold any of these words. A rate limit is not here: retrying it spends
# the budget it ran out of. A status read the proxy in front of Forgejo still refuses after
# so_forgejo_get's own tries (a plain-text 403; home-config #950 failed twice on 2026-11-14) has seen
# no check fail either.
CHECKS_NET_TRIES="${AGENT_LAND_CHECKS_NET_TRIES:-5}"
net_error() {
  case "$(lastline "$1")" in
  *'connection reset by peer'* | *'Connection reset by peer'* | *'connection refused'* | *'Connection refused'* | \
    *'i/o timeout'* | *'TLS handshake timeout'* | *'context deadline exceeded'* | *'unexpected EOF'* | \
    *'HTTP 500'* | *'HTTP 502'* | *'HTTP 503'* | *'HTTP 504'* | *'the proxy in front of Forgejo refused'*) return 0 ;;
  esac
  return 1
}
# net_retry <output>: count one lost connection, or stop at checks once CHECKS_NET_TRIES are spent.
net=0
net_retry() {
  ((++net <= CHECKS_NET_TRIES)) || fail checks "lost the connection to the API $net times: $(lastline "$1")"
  echo "checks: lost the connection to the API ($net of $CHECKS_NET_TRIES retries), reading again"
  sleep "$CHECKS_POLL"
}
# newer_runs <checks json>: how many runs on HEAD of a check's workflow have not completed, the newer
# run it gave way to; on a failed read, the read's output and status 1. A cancelled check's
# replacement can start before the cancel lands, so any open run of its workflow counts. A failed
# check counts only a run of its own event created or (re-)started after it completed, or with a higher
# run id than the run its link names, never the open run it failed in; a queued run's startedAt can be
# empty or zero, so createdAt counts too. The id: a body edit's re-run can open before the run it
# cancels fails its aggregate check, so it predates that red (train #3108, 2026-11-21 22:25 local, 06:25Z, ar-2940).
newer_runs() {
  local runs
  runs=$(gh run list "${R[@]}" --commit "$(git rev-parse HEAD)" --json databaseId,status,conclusion,workflowName,event,createdAt,startedAt 2>&1) || { printf '%s' "$runs"; return 1; }
  jq -r --argjson c "$1" 'def run_id: ((.link // "") | capture("/actions/runs/(?<id>[0-9]+)") | .id | tonumber) // 0;
    [.[] | select(.status != "completed" and (.conclusion // "") == "") | . as $r
    | select($c | any(.workflow == $r.workflowName and (.bucket != "fail" or
        (((.event // "") == "" or .event == $r.event) and (([$r.createdAt, $r.startedAt] | map(. // "") | max) > (.completedAt // "~")
          or (run_id > 0 and ($r.databaseId // 0) > run_id))))))] | length' <<<"$runs"
}
# gh_read <var> <gh args...>: gh's stdout in <var> and its stderr in gh_err, so a warning gh prints
# beside an answer is never part of it; returns gh's status.
gh_err=''
gh_read() {
  local var=$1 errf rc=0 got
  shift
  errf=$(mktemp) || fail checks "mktemp: no scratch for a gh read"
  got=$(gh "$@" 2>"$errf") || rc=$?
  gh_err=$(<"$errf")
  rm -f "$errf"
  printf -v "$var" '%s' "$got"
  return "$rc"
}
# checks_by_conclusion: after `gh pr checks --watch` times out (rc 124), e.g. on a check run left
# IN_PROGRESS with a conclusion set (unity-core-playground#3115), judge the PR's statusCheckRollup by
# each check's conclusion through pr-ci.sh's ci. Returns 0 when green (sets had_checks=yes), 1 to
# watch again (still pending, or a red that a newer run on HEAD supersedes, as newer_runs reads it),
# 2 when none is reported (sets out). Any other red, or a verdict it cannot read, stops at checks.
checks_by_conclusion() {
  local rollup red queued
  until gh_read rollup pr view "$pr" "${R[@]}" --json statusCheckRollup; do
    net_error "$gh_err" || fail checks "reading the checks after the watch timed out: $(lastline "$gh_err")"
    net_retry "$gh_err"
  done
  case "$(jq -r "$CI_JQ"' ci' <<<"$rollup")" in
  PASS)
    echo "checks: green"
    had_checks=yes
    return 0
    ;;
  PENDING)
    echo "checks: the watch timed out with checks still pending; continuing"
    return 1
    ;;
  NONE)
    out='no checks reported'
    return 2
    ;;
  FAIL)
    red=$(jq -c "$CI_JQ"' [checks | .[] | select((.conclusion // .state // "") | test(red_re))
      | {name: (.name // .context // "check"), workflow: (.workflowName // ""), completedAt, link: .detailsUrl,
         bucket: (if (.conclusion // .state // "") | test("CANCEL") then "cancel" else "fail" end)}]' <<<"$rollup")
    queued=$(newer_runs "$red") || {
      net_error "$queued" || fail checks "$(jq -r 'map(.name) | join(", ")' <<<"$red") (reading the runs on the head: $(lastline "$queued"))"
      net_retry "$queued"
      return 1
    }
    if [[ $queued =~ ^[1-9][0-9]*$ ]]; then
      echo "checks: red: $(jq -r 'map(.name) | join(", ")' <<<"$red"); waiting on the newer run of its workflow on the head"
      sleep "$CHECKS_QUEUED_POLL"
      return 1
    fi
    fail checks "$(jq -r 'map(.name) | join(", ")' <<<"$red")"
    ;;
  *) fail checks "reading the checks after the watch timed out: the rollup gave no verdict" ;;
  esac
}
had_checks=''
wait_checks() {
  [ -z "$fj" ] || { fj_wait_checks; return; }
  local try out rc left failed cancelled names queued rollup read_err stale skipping deadline=$((SECONDS + CHECKS_WAIT_TIMEOUT))
  for ((try = 1; ; try++)); do
    left=$((deadline - SECONDS))
    [ "$left" -gt 0 ] || fail checks "timed out waiting for checks after ${CHECKS_WAIT_TIMEOUT}s"
    rc=0
    out=$(timeout "$((left < CHECKS_WATCH_TIMEOUT ? left : CHECKS_WATCH_TIMEOUT))" gh pr checks "$pr" "${R[@]}" --watch --fail-fast -i "$CHECKS_WATCH_INTERVAL" 2>&1) || rc=$?
    if [ "$rc" -eq 0 ]; then
      # gh counts a cancelled check as neither failed nor pending, so a watch whose only Checks is
      # a cancelled run exits 0 while the newer run on the head has no check yet, and GitHub then
      # refuses the merge (unity-core-playground#2166). An open run of its workflow on HEAD is that
      # newer run: wait on it at the queued cadence. With none, GitHub may not have registered the
      # replacement yet, so it is read CHECKS_TRIES times before the cancelled check is the verdict.
      cancelled=$(gh pr checks "$pr" "${R[@]}" --json name,bucket,workflow -q 'map(select(.bucket == "cancel"))' 2>&1) || {
        net_error "$cancelled" || fail checks "reading the cancelled checks: $(lastline "$cancelled")"
        net_retry "$cancelled"
        continue
      }
      if [ "$cancelled" = '[]' ]; then
        echo "checks: green"
        had_checks=yes
        return 0
      fi
      names=$(jq -r 'map(.name) | join(", ")' <<<"$cancelled")
      queued=$(newer_runs "$cancelled") || {
        net_error "$queued" || fail checks "reading the runs on the head: $(lastline "$queued")"
        net_retry "$queued"
        continue
      }
      if [ "$queued" -ne 0 ]; then
        echo "checks: cancelled: $names; waiting on the newer run of its workflow on the head"
        try=0
        sleep "$CHECKS_QUEUED_POLL"
        continue
      fi
      # A cancelled matrix job of an older run of its workflow on the head, which never expanded and kept
      # its template name, stays listed after the newer run went green; pr-ci.sh's reading of the rollup
      # drops it (dotfiles#2437, ar-3095). Green only when the rollup lists every cancelled name; a lost
      # connection reads again, and any other failed read leaves the cancelled check as the verdict.
      if gh_read rollup pr view "$pr" "${R[@]}" --json statusCheckRollup; then
        if [ "$(jq -r --argjson c "$cancelled" "$CI_JQ"' if ([.statusCheckRollup[]?.name] as $n | $c | all(.name as $k | $n | index([$k])))
            then ci else "MISSING" end' <<<"$rollup" 2>/dev/null)" = PASS ]; then
          echo "checks: green (cancelled: $names, a matrix job of an older run of its workflow on the head)"
          had_checks=yes
          return 0
        fi
      elif net_error "$gh_err"; then
        net_retry "$gh_err"
        continue
      fi
      [ "$try" -lt "$CHECKS_TRIES" ] || fail checks "cancelled: $names, and no run of its workflow is left on the head to replace it: gh run rerun it, then re-run"
      sleep "$CHECKS_POLL"
      continue
    fi
    if [ "$rc" -eq 124 ]; then
      rc=0
      checks_by_conclusion && return 0 || rc=$?
      if [ "$rc" -eq 1 ]; then
        try=0
        continue
      fi
    fi
    case "$out" in
    *'no checks reported'*) ;;
    *)
      # A watch that died on a 403, or a names read that failed, names no red check: it stops as a
      # read error, not a red check, so nobody goes to fix CI that is green. A names read that
      # exits non-zero but printed names still has its answer.
      read_err=''
      gh_read failed pr checks "$pr" "${R[@]}" --json name,bucket -q '[.[] | select(.bucket == "fail" or .bucket == "cancel") | .name] | join(", ")' || [ -n "$failed" ] || read_err=$gh_err
      if [ -z "$failed" ]; then
        if ! net_error "$out" && ! net_error "$read_err"; then
          [ -z "$read_err" ] || fail checks "reading the failed checks: $(lastline "$read_err")"
          # Only skipping checks is no verdict: the run that reports the real check may not have a
          # check yet (playground #2682, 2026-11-15). Read as none reported, so the queued-runs count
          # below waits on it. A read that exits non-zero but printed its answer still has it.
          gh_read skipping pr checks "$pr" "${R[@]}" --json bucket -q 'length > 0 and all(.bucket == "skipping")' || [ -n "$skipping" ] || {
            net_error "$gh_err" || fail checks "reading the checks: $(lastline "$gh_err")"
            net_retry "$gh_err"
            try=0
            continue
          }
          [ "$skipping" = true ] || fail checks "the watch ended with no failed check to name: $(lastline "$out")"
          echo "checks: only skipping reported; waiting"
        else
          net_retry "${read_err:-$out}"
          try=0
          continue
        fi
      else
        # A failed check whose workflow has a run on HEAD started after it, or with a higher run id (newer_runs), is superseded: the edit
        # that adds the gate line re-runs Checks, and a watch read seconds later still sees the old
        # red (unity-core-playground#2492 lost the landing slot that way, 2026-11-21). Wait on the
        # newer run; a failed or unreadable look leaves the red as the verdict.
        # gh exits non-zero while a check fails, so a read that printed JSON still has its answer.
        gh_read stale pr checks "$pr" "${R[@]}" --json name,bucket,workflow,event,completedAt,link -q 'map(select(.bucket == "fail"))' || true
        if [ -n "$stale" ] && [ "$stale" != '[]' ]; then
          queued=$(newer_runs "$stale") || {
            net_error "$queued" || fail checks "$failed (reading the runs on the head: $(lastline "$queued"))"
            net_retry "$queued"
            continue
          }
          if [[ $queued =~ ^[1-9][0-9]*$ ]]; then
            echo "checks: failed: $(jq -r 'map(.name) | join(", ")' <<<"$stale"); waiting on the newer run of its workflow on the head"
            try=0
            sleep "$CHECKS_QUEUED_POLL"
            continue
          fi
        fi
        fail checks "$failed"
      fi
      ;;
    esac
    # A failed read is not "0 queued": it would reach no_checks and land on the local gate with a run
    # still queued. A count that is not a number is a failed read too.
    gh_read queued run list "${R[@]}" --commit "$(git rev-parse HEAD)" --json status,conclusion -q '[.[] | select(.status != "completed" and (.conclusion // "") == "")] | length' && [[ $queued =~ ^[0-9]+$ ]] || {
      [ -n "$gh_err" ] || gh_err="not a count: $queued"
      net_error "$gh_err" || fail checks "reading the runs on the head: $(lastline "$gh_err")"
      net_retry "$gh_err"
      try=0
      continue
    }
    if [ "${queued:-0}" -ne 0 ]; then
      try=0
      sleep "$CHECKS_QUEUED_POLL"
      continue
    fi
    [ "$try" -lt "$CHECKS_TRIES" ] || { first_run_wait "$try" || { no_checks; return 0; }; continue; }
    sleep "$CHECKS_POLL"
  done
}
# no_checks: none reported after CHECKS_TRIES polls and any first-run wait, on either forge. Lands
# on the local gate unless no_checks_refusal names why not.
no_checks() {
  ! no_checks_refusal || fail checks "$refusal"
  echo "checks: none reported"
}
# no_checks_refusal: sets refusal to why a head with no checks reported cannot land, or returns 1
# when it lands on the local gate. Called outside a subshell, so checks_policy reads the base once.
refusal=''
# gate: al-no-checks
no_checks_refusal() {
  if [ "$tier" = 3 ]; then
    refusal="none reported, and a tier-3 item lands only on checks that ran green"
  elif [ -n "$ran_checks" ]; then
    refusal="none reported, and --ran-checks lands only on checks that ran green"
  elif [ -n "$had_checks" ]; then
    # A head pushed by catch_up gets the runs the gate's head had; none yet means they have not
    # started, and landing it would merge a tree no check has seen (dotfiles #1504).
    refusal="none reported on the pushed head $(git rev-parse --short HEAD), though the gate's head ran green: re-run once its checks start"
  elif required_checks; then
    # A Checks run that ends with no job reports no check and has nothing left to wait on (#2141,
    # 2026-11-09), and GitHub refuses the merge while a required check is missing on the head.
    local runs="gh run list --commit $(git rev-parse HEAD) shows whether a run exists (none yet: re-run once it does; one that ended with no job never started: gh run rerun it)"
    [ -z "$fj" ] || runs="the repo's Actions page shows whether a run exists for $(git rev-parse --short HEAD)"
    refusal="none reported on the head, and $remote/$base requires checks, so $forge would refuse the merge: $runs, then re-run"
  else
    return 1
  fi
}
# first_run_wait <try>: past CHECKS_TRIES with none reported, a land no_checks would refuse sleeps
# CHECKS_QUEUED_POLL for the head's first run, up to CHECKS_FIRST_RUN_TRIES times per stretch with
# no run (a run seen resets try). Only a head with Actions workflow files waits: in a repo with none,
# no run is coming. Status 1 when it would land anyway or the wait is spent; the caller then goes to
# no_checks.
first_run_wait() {
  local extra=$(($1 - CHECKS_TRIES))
  [ "$extra" -lt "$CHECKS_FIRST_RUN_TRIES" ] && no_checks_refusal || return 1
  git ls-tree -d --name-only HEAD .github/workflows .forgejo/workflows .gitea/workflows 2>/dev/null | grep -q . || return 1
  [ "$extra" -ne 0 ] || echo "checks: none reported yet, which this land would refuse; waiting up to $CHECKS_FIRST_RUN_TRIES x ${CHECKS_QUEUED_POLL}s for the head's first run"
  sleep "$CHECKS_QUEUED_POLL"
}
# fj_wait_checks: Forgejo has no watch, and no event a script can await, so the head's combined
# commit status is read once per CHECKS_WATCH_INTERVAL while a status is pending, and CHECKS_POLL
# apart while none is reported yet, through so_forgejo_checks and pr-ci.sh's ci (warning passes).
fj_wait_checks() {
  local try st head deadline=$((SECONDS + CHECKS_WAIT_TIMEOUT))
  head=$(git rev-parse HEAD)
  for ((try = 1; ; try++)); do
    [ "$SECONDS" -lt "$deadline" ] || fail checks "timed out waiting for checks after ${CHECKS_WAIT_TIMEOUT}s"
    st=$(so_forgejo_checks "$fj" "$head" 2>&1) || {
      net_error "$st" || fail checks "Forgejo status read: $(lastline "$st")"
      net_retry "$st"
      try=0
      continue
    }
    net=0 # a read that answered ends the run of lost ones: a long wait meets several separate bursts
    case "$(jq -r "$CI_JQ"' {statusCheckRollup: .} | ci' <<<"$st")" in
    PASS)
      echo "checks: green"
      had_checks=yes
      return 0
      ;;
    FAIL) fail checks "$(jq -r 'map(select(.state == "FAILURE" or .state == "ERROR") | .context) | join(", ")' <<<"$st")" ;;
    PENDING)
      try=0
      sleep "$CHECKS_WATCH_INTERVAL"
      ;;
    *)
      [ "$try" -lt "$CHECKS_TRIES" ] || { first_run_wait "$try" || { no_checks; return 0; }; continue; }
      sleep "$CHECKS_POLL"
      ;;
    esac
  done
}

# own_head: the merge pins HEAD (--match-head-commit), so a cwd that is not on the PR's head would
# reach the merge and be refused as "Head branch was modified", which reads as a race. Say where the
# PR's branch is checked out instead. A fork's branch name proves nothing about a local checkout.
# gate: al-own-head
own_head() {
  local here wt top
  here=$(git rev-parse HEAD 2>&1) || fail head "git rev-parse: $(lastline "$here")"
  [ "$here" != "$head_oid" ] || return 0
  if [ "$cross" = true ]; then
    fail head "HEAD ${here:0:8} is not the PR's head ${head_oid:0:8}, and that head is on a fork: gh pr checkout $pr in a checkout of this repo, then re-run"
  fi
  # A fresh push: the PR reads its new head a moment after the push lands, so headRefOid can still
  # be the old one (#590, #1401 failed here and a plain re-run passed). When origin's branch tip is
  # HEAD, the push landed: poll until the PR reads it, since the checks and the merge read the PR's
  # head, not origin's. No event says when; the bound is the checks one.
  # A failed ls-remote leaves tip empty and the diagnostics below run, as before this wait existed.
  local tip seen out try
  tip=$(git ls-remote "$remote" "refs/heads/$head_ref" 2>/dev/null | awk -v r="refs/heads/$head_ref" '$2 == r { print $1 }') || tip=''
  if [ -n "$tip" ] && [ "$tip" = "$here" ]; then
    for ((try = 1; ; try++)); do
      if out=$(pr_view headRefOid .headRefOid 2>&1); then
        if [ "$out" = "$here" ]; then
          head_oid=$here
          echo "head: the PR read the pushed head ${here:0:8} after $try polls"
          return 0
        fi
        seen=${out:0:8}
      else
        seen="nothing ($api: $(lastline "$out"))"
      fi
      [ "$try" -lt "$CHECKS_TRIES" ] || break
      sleep "$CHECKS_POLL"
    done
    fail head "HEAD ${here:0:8} is $remote's $head_ref, but the PR still reads $seen after $try polls: re-run once $forge catches up"
  fi
  wt=$(git worktree list --porcelain 2>/dev/null | awk -v b="branch refs/heads/$head_ref" '/^worktree /{p = substr($0, 10)} $0 == b { print p; exit }')
  top=$(git rev-parse --show-toplevel 2>/dev/null || true)
  if [ -n "$wt" ] && [ "$wt" = "$top" ]; then
    fail head "HEAD ${here:0:8} is not the PR's head ${head_oid:0:8} though this checkout has $head_ref: push your commits, or pull the branch, then re-run"
  elif [ -n "$wt" ]; then
    fail head "HEAD ${here:0:8} is not the PR's head ${head_oid:0:8}: run from the PR's checkout: $wt"
  fi
  fail head "HEAD ${here:0:8} is not the PR's head ${head_oid:0:8}, and no checkout of $head_ref is listed: git switch $head_ref (pushed and current) in a checkout of this repo, then re-run"
}

# checks_policy reads, once, what <base> asks of a head's checks. strict: it refuses a head whose
# required checks have not run on it (a ruleset's required_status_checks rule with
# strict_required_status_checks_policy, or branch protection's required_status_checks.strict); any
# answer but a 404 from the protection call counts as strict, the side that waits instead of being
# refused. required: it names at least one check a head must pass, so a head with none reported
# cannot merge; only an answer that says so counts (an unreadable one is no), since a wrong yes would
# block every landing there.
strict='' required=''
checks_policy() {
  [ -z "$strict" ] || return 0
  local repo="${pr_ref%#*}" out
  strict=yes required=no
  [ "$repo" != "$pr_ref" ] || return 0
  # Forgejo: the protection rule named <base>. enable_status_check refuses a head without passing
  # statuses (required), block_on_outdated_branch a head that is behind (strict); none: neither.
  if [ -n "$fj" ]; then
    out=$(so_forgejo_get "$fj" branch_protections 2>/dev/null) || return 0
    ! jq -e --arg b "$base" 'any(.[]; .rule_name == $b and .enable_status_check)' <<<"$out" >/dev/null 2>&1 || required=yes
    jq -e --arg b "$base" 'any(.[]; .rule_name == $b and .block_on_outdated_branch)' <<<"$out" >/dev/null 2>&1 || strict=no
    return 0
  fi
  out=$(gh api "repos/$repo/rules/branches/$base" 2>/dev/null) || return 0
  ! jq -e 'any(.[]; .type == "required_status_checks" and (.parameters.required_status_checks // [] | length) > 0)' <<<"$out" >/dev/null 2>&1 || required=yes
  jq -e 'all(.[]; .type != "required_status_checks" or .parameters.strict_required_status_checks_policy != true)' <<<"$out" >/dev/null 2>&1 || return 0
  if out=$(gh api "repos/$repo/branches/$base/protection" 2>&1); then
    ! jq -e '(.required_status_checks.contexts // []) + (.required_status_checks.checks // []) | length > 0' <<<"$out" >/dev/null 2>&1 || required=yes
    jq -e '.required_status_checks.strict == true' <<<"$out" >/dev/null 2>&1 || strict=no
  else
    case "$out" in *'(HTTP 404)'*) strict=no ;; esac
  fi
}
strict_checks() { checks_policy && [ "$strict" = yes ]; }
required_checks() { checks_policy && [ "$required" = yes ]; }

# catch_up: a base the head is behind is merged in and pushed, before the gate and again after it if
# the base moved on during the checks. A merge of <base> does not keep the checks green: a pushed head
# is a new tree, and merging one before its checks ran shipped a broken one (dotfiles #1504; #1731
# merged a merge-up head whose checks ran only after the merge). So it returns 0 when the head is
# current, and 1 after a push: the caller waits on the PR checks for that head, then calls it again.
# After the gate (catch_up after <waits so far>), a base with no strict required checks (strict_checks)
# is merged up and re-checked CATCHUP_WAITS times; if it moved on again during those waits, the green
# head lands behind it, which such a base allows, unless merging the base would conflict (then the
# merge below runs and exits 3, since GitHub would refuse that head anyway): a base that merges faster than its checks run would otherwise loop it forever
# (dotfiles #1059 went green 9 times in an hour), and exiting 3 sent the caller round its own gate,
# which a busy base outruns every time (#916). A strict base has no bound, since it refuses a head
# that is behind (2026-11-05: unity-core-playground #1837 was refused twice). A conflict is aborted
# and exits 3.
CATCHUP_WAITS=1
catch_up() {
  local out behind
  out=$(git fetch -q "$remote" 2>&1) || fail fetch "$(lastline "$out")"
  behind=$(git rev-list --count "HEAD..$remote/$base" 2>&1) || fail fetch "$(lastline "$behind")"
  if [ "$behind" -eq 0 ]; then
    [ "${1:-}" = before ] || echo "fetch: current with $remote/$base"
    return 0
  fi
  if [ "${1:-}" = after ] && [ "${2:-0}" -ge "$CATCHUP_WAITS" ] && ! strict_checks &&
    git merge-tree --write-tree --quiet HEAD "$remote/$base" >/dev/null 2>&1; then
    echo "fetch: $remote/$base moved on by $behind during the checks on the merged-up head; landing that green head behind it (no strict checks on $base)"
    return 0
  fi
  # Before the merge, so a refusal leaves the checkout as it was. A fork head is not origin's branch.
  [ "$cross" != true ] || fail push "the PR head is on a fork: git push HEAD to that fork's $head_ref, then re-run"
  local pre
  pre=$(git rev-parse HEAD)
  if ! out=$(git merge -q --no-edit "$remote/$base" 2>&1); then
    git merge --abort >/dev/null 2>&1 || true
    printf 'agent-land: behind %s/%s by %s and merging it conflicts: resolve the merge and re-run\n' "$remote" "$base" "$behind" >&2
    land_failed conflict "behind $remote/$base by $behind and merging it conflicts"
    exit 3
  fi
  # The merge moved the gitlinks, not the submodule checkouts: a clean one on its old pin follows,
  # so the next local build compiles the merged code (ucp-671 #2506). Before the push, so a failed
  # push still leaves the checkouts matching the merged HEAD; its lines print after the fetch line.
  local subs
  subs=$(submodule_follow "$pre")
  # Push HEAD to the PR's own head branch: a bare `git push` under push.default=simple refuses when
  # the local branch name differs from its upstream (agent-11 -> feat/x, PR #1252), and the upstream
  # itself can be the base (a worktree cut from origin/main tracks it).
  out=$(git push -q "$remote" "HEAD:refs/heads/$head_ref" 2>&1) || fail push "$(lastline "$out")"
  echo "fetch: merged $remote/$base ($behind behind) into the head and pushed it"
  [ -z "$subs" ] || printf '%s\n' "$subs"
  # GitHub works out whether a pushed head merges after the push and refuses the merge until then
  # ("not mergeable"). No event says when, so the PR is polled at the checks cadence until it
  # reads this head with a known answer; the merge step reports what it ends up refusing.
  local head try
  head=$(git rev-parse HEAD)
  for ((try = 1; try <= CHECKS_TRIES; try++)); do
    case "$(pr_view headRefOid,mergeable '.headRefOid + " " + .mergeable' 2>/dev/null)" in
    "$head UNKNOWN" | "") ;;
    "$head "*) break ;;
    esac
    sleep "$CHECKS_POLL"
  done
  [ "${1:-}" = before ] || echo "checks: waiting on them for the pushed head"
  return 1
}

stub='' canon='' pr='' sup='' sup_ref='' repo='' repo_from='' merged='' plan='' phase='' item="${AGENT_QUEUE_ITEM:-}" dry=0 partial=0 method=--squash admin=() ran_checks=''
implied=${item:+'$AGENT_QUEUE_ITEM'}
while [ $# -gt 0 ]; do
  case "$1" in
  --project | --title) die "$1 is gone: the queue item is the record; agent-queue add --running --project <p> \"<task>\", then --item <slug>" ;;
  --plan) plan="${2:?--plan needs a value}" && shift ;;
  --phase) phase="${2:?--phase needs a value}" && shift ;;
  --item) item="${2:?--item needs a value}" implied='' && shift ;;
  --repo) repo="${2:?--repo needs a value}" repo_from=--repo && shift ;;
  --supersedes) sup="${2:?--supersedes needs a value}" && shift ;;
  --partial) partial=1 ;;
  --merge-commit) method=--merge ;;
  --admin) admin=(--admin) ;;
  --ran-checks) ran_checks=1 ;;
  --dry-run) dry=1 ;;
  -h | --help) usage ;;
  -*) die "unknown flag: $1" ;;
  *) [ -z "$pr" ] || die "one PR only"; pr="$1" ;;
  esac
  shift
done
[[ "$pr" =~ ^[0-9]+$ ]] || die "a PR number is required (try --help)"
[ -z "$sup" ] || { [[ "$sup" =~ ^[0-9]+$ ]] && [ "$sup" != "$pr" ]; } || die "--supersedes takes the number of the closed PR #$pr replaced, in its repo, not $sup"
[ -z "$repo" ] || [[ "$repo" =~ ^[^/[:space:]]+/[^/#[:space:]]+$ ]] || die "--repo takes <owner>/<repo>, not $repo"
[ "$partial" -eq 0 ] || [ -z "$plan$phase" ] || die "--partial cannot finish a plan phase; pass --plan and --phase on the final landing"
row=''
if [ -z "$item" ]; then
  mine=0
  item=$(aq_retry mine 2>/dev/null) || mine=$?
  [ "$mine" -ne "$QUEUE_BUSY" ] || die "the queue is locked by another writer: re-run (agent-queue mine)"
  [ "$mine" -ne 2 ] || die "more than one queue item records this session: pass --item <slug> (agent-queue mine)"
  implied='agent-queue mine'
fi
[ -n "$item" ] || die "no queue item for this session: agent-queue add --running --project <p> \"<type(area): title>\" (or claim one), then re-run"
# Checked before the merge, like the plan phase: a wrong slug cannot leave a merged PR unrecorded.
show_rc=0
it=$(aq_retry show "$item" --json 2>/dev/null) || show_rc=$?
[ "$show_rc" -ne "$QUEUE_BUSY" ] || die "the queue is locked by another writer: nothing merged, re-run"
[ "$show_rc" -eq 0 ] || die "no queue item $item (agent-queue show)"
# A done ok item takes more PRs: its `pr:` holds one <owner>/<repo>#<N> per repo, space separated,
# and `merged:` their merge commits in the same order, so a task split across repos lands each on
# its one item. Which repo this PR is in needs gh, so once_done checks it after the PR is read.
case "$(jq -r 'if .state == "done" and .status == "ok" and (.pr // "") != "" then "done-ok" else .state end' <<<"$it")" in
running | waiting | review | queued | done-ok) ;;
*) die "queue item $item is $(jq -r '.state + " " + (.status // "")' <<<"$it"), not open" ;;
esac
# With no --repo, the item's own pr:<owner>/<repo>#<pr> names the repo: the bare number alone would
# be read against this checkout's repo, whatever repo the item's PR is in.
if [ -z "$repo" ]; then
  mapfile -t hits < <(jq -r --arg n "$pr" '(.pr // "") | split(" ")[] | select(test("^[^/]+/[^/#]+#" + $n + "$")) | sub("#[0-9]+$"; "")' <<<"$it" | sort -fu)
  case ${#hits[@]} in
  0) ;;
  1) repo=${hits[0]} repo_from="the item's pr:" ;;
  *) die "queue item $item records #$pr in ${hits[*]}: pass --repo <owner>/<repo>" ;;
  esac
fi
R=()
[ -z "$repo" ] || R=(-R "$repo")
# Every real step reads this checkout (head, forge remote, merge proof); --repo only redirects gh.
# Outside a checkout a merged PR got through repo, merge and body, then failed proof (ar-2371).
# A dry run reads no PR and stays the way to preview from anywhere.
if [ "$dry" -eq 0 ]; then
  git_err=$(git rev-parse --show-toplevel 2>&1 >/dev/null) ||
    die "$PWD is not a usable git checkout ($(lastline "$git_err")): agent-land reads the checkout for the head, the forge remote and the merge proof, and --repo only picks the repo gh reads. Run it from a checkout of ${repo:-the PR repo}"
fi

# The forge the PR is on: gh's, or Forgejo's API through so_forgejo_* (session-outcomes.sh, which
# also brings origin-repo.sh). fj is its host/owner/repo and remote the git remote that carries it;
# on GitHub fj is empty and remote is origin. A Forgejo-canonical checkout with no remote on a
# listed host stops here: gh would land on its GitHub mirror, which the next mirror push erases.
# shellcheck source=../lib/session-outcomes.sh
. "$(dirname "$(readlink -f "$0")")/../lib/session-outcomes.sh"
# shellcheck source=../lib/pr-ci.sh
. "$(dirname "$(readlink -f "$0")")/../lib/pr-ci.sh"
# gh: gh with its stderr held back unless it fails. The steps capture 2>&1 so a failure's last line
# names the error, and gh 2.105 writes an "event listen" hint to stderr on a SUCCESSFUL pr view and
# api call, which read into the PR fields and the attributed file list (2026-11-19).
gh() {
  local err rc=0
  err=$(mktemp) || return
  command gh "$@" 2>"$err" || { rc=$?; cat "$err" >&2; }
  rm -f "$err"
  return "$rc"
}
fj='' remote=origin api=gh forge=GitHub
fj_detect() {
  local r rc=0
  r=$(so_forge_remote .) || rc=$?
  case $rc in
    0) ;;
    1) return 0 ;;
    2) die "$(git rev-parse --show-toplevel 2>/dev/null) is Forgejo-canonical, but none of its remotes is on a host SO_FORGEJO_HOSTS lists ($(so_forgejo_hosts)): add the Forgejo remote, or list its host in nightly-measure.conf" ;;
    *) die "picking the forge failed (so_forge_remote rc $rc)" ;;
  esac
  remote=${r%% *} fj=${r#* } api=Forgejo forge=Forgejo
}
fj_detect
fj_repo=${fj#*/}
[ -z "$fj" ] || [ -z "$repo" ] || [ "${repo,,}" = "${fj_repo,,}" ] ||
  die "#$pr is in $repo ($repo_from), but this checkout's Forgejo repo is $fj_repo: run from a checkout of $repo"
# The token is read once, in this shell, so every $(...) below inherits it. A dry run calls nothing.
[ -z "$fj" ] || [ "$dry" -eq 1 ] || so_forgejo_auth "$fj" || die "$SO_FORGEJO_ERR"
# fj_send METHOD PATH JSON: one authed write to the PR's Forgejo repo. A refusal ends stderr with
# Forgejo's reason (a protected branch, a 409 stale head), or so_forgejo_get's line naming the proxy
# that refused it before Forgejo saw it, which fail prints as its last line.
fj_send() {
  local out
  out=$(so_forgejo_get "$fj" "$2" -X "$1" -H 'Content-Type: application/json' --data-binary "$3") && return 0
  out=$(jq -r '.message // empty' <<<"$out" 2>/dev/null || printf '%s' "$out")
  [ -z "$out" ] || printf 'Forgejo: %s\n' "$out" >&2
  return 1
}
# pr_view FIELDS JQ: `gh pr view --json FIELDS -q JQ`; on Forgejo the API's PR in gh's field names,
# so one query reads both. Forgejo's mergeable reads false while it is still checking a pushed head,
# so false is UNKNOWN: catch_up polls it out, and the merge step names a real conflict.
pr_view() {
  [ -n "$fj" ] || { gh pr view "$pr" "${R[@]}" --json "$1" -q "$2"; return; }
  local raw
  raw=$(so_forgejo_get "$fj" "pulls/$pr") || return 1
  jq -r '{state: (if .merged then "MERGED" elif .state == "open" then "OPEN" else "CLOSED" end),
          baseRefName: .base.ref, url: .html_url, headRefOid: .head.sha, headRefName: .head.ref,
          isCrossRepository: (.head.repo.full_name != .base.repo.full_name), body: (.body // ""),
          mergeable: (if .mergeable then "MERGEABLE" else "UNKNOWN" end),
          createdAt: .created_at, mergedAt: .merged_at,
          mergeCommit: {oid: (.merge_commit_sha // "")}} | '"$2" <<<"$raw"
}
# pr_edit_body: stdin becomes the PR body.
pr_edit_body() {
  [ -n "$fj" ] || { gh pr edit "$pr" "${R[@]}" --body-file -; return; }
  fj_send PATCH "pulls/$pr" "$(jq -Rsc '{body: .}')"
}
# pr_merge HEAD: merge pinned to HEAD, the full sha (Forgejo answers 409 to a short one).
pr_merge() {
  [ -n "$fj" ] || { gh pr merge "$pr" "${R[@]}" "$method" ${admin[@]+"${admin[@]}"} --match-head-commit "$1"; return; }
  fj_send POST "pulls/$pr/merge" "$(jq -nc --arg do "${method#--}" --arg h "$1" '{Do: $do, head_commit_id: $h}')"
}
# pr_files: the PR's changed paths, one a line, a rename's old path too (moving a file out of a
# Judge authority name is critical, validate_gate).
pr_files() {
  [ -n "$fj" ] || { gh_pr_files; return; }
  local page=1 got
  while got=$(so_forgejo_get "$fj" "pulls/$pr/files?limit=$SO_FORGEJO_PAGE&page=$page"); do
    jq -r '.[] | .filename, (.previous_filename // empty)' <<<"$got"
    [ "$(jq length <<<"$got")" -ge "$SO_FORGEJO_PAGE" ] || return 0
    page=$((page + 1))
  done
  return 1
}
# gh_pr_files: pr_files on GitHub. GitHub answers 422 "diff is taking too long to generate"
# (code not_available) for every page of a diff too big to render, so that one answer reads the
# same list from git: the base...head diff GitHub shows, a rename's old path too. Why: a train
# carrying two rebuilt 1M-line scenes never landed (unity-core-playground #3231, 2026-11-24).
gh_pr_files() {
  local out oids base head
  # stdout only: gh's stderr carries a hint even on success, and on a failure the API's error body is on stdout.
  out=$(gh api "repos/${pr_ref%#*}/pulls/$pr/files" --paginate --jq '.[] | .filename, (.previous_filename // empty)') && { [ -z "$out" ] || printf '%s\n' "$out"; return 0; }
  case $out in *not_available*) ;; *) printf '%s\n' "$out"; return 1 ;; esac
  oids=$(gh pr view "$pr" "${R[@]}" --json baseRefOid,headRefOid -q '.baseRefOid + " " + .headRefOid') || return 1
  read -r base head <<<"$oids"
  git fetch -q "$remote" "$base" "$head" || return 1
  git diff --name-status -M "$base...$head" | awk -F'\t' '{ print $NF } $1 ~ /^R/ { print $2 }'
}
# once_done -> how a done item takes this PR: "rerun" when it owns row closure (the first PR
# on older items without closing_pr, a re-run after a failed board step), "again" when it is a later one, "more" when the item carries none in this
# repo yet. A second PR in one repo is refused: that is a second task, so it gets its own item.
once_done() {
  local refs ref i closing_pr
  read -ra refs <<<"$(jq -r '.pr // ""' <<<"$it")"
  # A bare ref (a PR whose URL did not parse, or an old item) matches on its number alone.
  for i in "${!refs[@]}"; do
    [ "${refs[i]}" = "$pr_ref" ] || { [[ "${refs[i]}" != */*#* || "$pr_ref" != */*#* ]] && [ "${refs[i]##*#}" = "$pr" ]; } ||
      continue
    closing_pr=$(jq -r '.closing_pr // ""' <<<"$it")
    if [ "$closing_pr" = "$pr_ref" ] || { [ -z "$closing_pr" ] && [ "$i" -eq 0 ]; }; then
      echo rerun
    else
      echo again
    fi
    return 0
  done
  [[ "$pr_ref" == */*#* ]] || die "queue item $item is done, and #$pr names no repo to add it under"
  # An open item can still say it carries more PRs; a done one cannot.
  local out="" state=done
  if [ "$(jq -r .state <<<"$it")" != done ]; then
    state=open out="; if both are this item's work, agent-queue set $item partial=yes and re-run"
  fi
  for ref in "${refs[@]}"; do
    [[ "$ref" == */*#* ]] || die "queue item $item is $state and already carries a bare pr:$ref, which names no repo to tell #$pr apart from"
    [[ "$ref" != "${pr_ref%#*}#"* ]] ||
      die "queue item $item is $state and already carries $ref, and an item carries one PR per repo: give #$pr its own item (agent-queue add --running), then --item <that slug>$out"
  done
  echo more
}

# item_pr_gate: enforce the one-PR-per-repo rule on done items and on open items without --partial.
# gate: al-item-pr-gate
item_pr_gate() {
  if [ "$(jq -r .state <<<"$it")" = done ]; then
    once_done || return $?
  elif [ -n "$it_pr" ] && [ "$partial" -eq 0 ] && [ "$(jq -r '.partial // ""' <<<"$it")" != yes ]; then
    # An open item takes the same one-PR-per-repo rule, unless a --partial landing (this one, or an
    # earlier one that left partial: yes) says it carries more PRs: a brief that asks for two PRs in one
    # repo lands both on its one item. Why: release-windows-only had to file ucp-1987 for #2397 (2026-11-12).
    once_done >/dev/null || return $?
  fi
}

# The notes argv that closes the item's row (`row`, "<project>:<key>", agent-queue's one
# definition), one word a line, as fleet-dispatch reads it; empty for an item with no row.
set_row() {
  row=$(jq -r 'select((.row // "") != "") | (.row | split(":")) as $r
    | (if (.profile // "") != "" then ["--profile", .profile] else [] end) + ["ptask", $r[0]]
      + (if (.lane // "agent") == "agent" then ["--agent"] else [] end)
      + ["done", ($r[1:] | join(":")), "--proof"] | .[]' <<<"$it")
}
set_row
# body_norm: stdin's text without CRs, "Item:" lines (item-line adds or rewrites one) or trailing blanks.
body_norm() { tr -d '\r' | sed -e '/^Item: /d' -e 's/[[:space:]]*$//'; }
# drop_body_scratch BODY: delete each *.md or *.txt file at the top of ~/.cache whose text is the
# merged BODY (body_norm on both). The PR keeps that text, so nothing is lost; a file that differs
# (a later edit, another PR's body) stays, and so does every file when the body is under
# SCRATCH_BODY_MIN chars, since a short generic one ("Fix typo.") may be another session's unsent
# draft. It runs on a re-run of a merged PR too. Why: sessions write the body there for gh pr create,
# and 64 sat in the ~/.cache root on 2026-11-21, the shortest 680 bytes (ar-3663).
SCRATCH_BODY_MIN=200
drop_body_scratch() {
  local want f
  want=$(printf '%s\n' "$1" | body_norm)
  [ "${#want}" -ge "$SCRATCH_BODY_MIN" ] || return 0
  while IFS= read -r -d '' f; do
    if [ "$(body_norm <"$f")" = "$want" ] && rm -f -- "$f"; then echo "scratch: deleted $f, a copy of the merged body"; fi
  done < <(find "$HOME/.cache" -maxdepth 1 -type f \( -name '*.md' -o -name '*.txt' \) -size -64k -print0 2>/dev/null)
}
# score_body: the merged body's score against comms-standard (channel pr-body), after drop_body_scratch.
# A score, never a gate: the PR is already merged, and the line tells its author what to fix in the next one.
score_body() {
  local body out rc=0
  body=$(pr_view body .body 2>&1) || { echo "body: not scored ($api pr view: $(lastline "$body"))"; return 0; }
  drop_body_scratch "$body"
  command -v comms-lint >/dev/null 2>&1 || { echo "body: not scored (no comms-lint on PATH)"; return 0; }
  out=$(printf '%s\n' "$body" | comms-lint --channel pr-body - 2>&1) || rc=$?
  case "$rc" in
  0) echo "body: passes comms-lint --channel pr-body" ;;
  1) echo "body: $(lastline "$out") First: $(printf '%s\n' "$out" | sed -n '1s/^ *//p')" ;;
  *) echo "body: not scored ($(lastline "$out"))" ;;
  esac
}

# own_repo: git, the merge proof and autopull all read this checkout, so a PR in another repo is
# refused here, before anything is touched: from the wrong checkout its merge proof would test the
# wrong graph, or pass on an unrelated PR that shares the number.
own_repo() {
  local here want=${pr_ref%#*}
  if [ -n "$fj" ]; then here=$fj_repo; else here=$(origin_repo .) || here=""; fi
  [ -n "$here" ] || { echo "repo: not checked, this checkout has no origin"; return 0; }
  [[ "$pr_ref" == */*#* && "${here,,}" != "${want,,}" ]] || return 0
  fail repo "#$pr is $pr_ref (${repo_from:-the repo gh picks here}), but this checkout's $remote is $here: run from a checkout of ${pr_ref%#*}${repo_from:+, or pass --repo $here for $here#$pr}"
}

# shellcheck source=../../.config/shared-hooks/project-name.sh
. "${PROJECT_NAME_LIB:-$(dirname "$(readlink -f "$0")")/../../.config/shared-hooks/project-name.sh}"
PROJECT_MAP_FILE="${AGENT_QUEUE_PROJECT_MAP:-$(project_map_file)}"

# own_item: an item this run did not name is only the session's guess ($AGENT_QUEUE_ITEM, or agent-queue
# mine), so before anything is touched it takes only a PR that is its work. First the repo: a session
# lands side PRs in other repos, and one outside the item project's repo (its tracker `repo`, else the
# project) would close the item and its row with a PR that is not their work (2026-11-07:
# dotfiles-private#652, a store-console skill fix, closed shape-city-steam-console and row ucp-1207).
# Then the PR itself: a session lands side fixes in its item's repo too, and parallel subagents of one
# coordinator share its Claude session id, so `agent-queue mine` can return a sibling's item. Such an
# item takes only a PR it records (pr:, open_pr:) or whose body names it on an "Item: <slug>" line; any
# other PR is refused, a body naming another queue item with that item in the message, so stamp_item
# only adds the line for an item --item named or one that records the PR. Not the branch: `branch:` is
# the last push the Stop hook saw, and a run that re-cuts its branch lands from the new one in the same
# turn. Why: home-config #1195 got a sibling subagent's "Item:" line on 2026-11-18 (ar-3047), and
# unity-core-playground#2985, an iOS side fix with no "Item:" line, closed its session's overnight
# release watch on 2026-11-20 (ar-3970). --item claims either.
# gate: al-own-item
own_item() {
  [ -n "$implied" ] || return 0
  local ref refs named rc=1 project want got name=${pr_ref%#*}
  if [[ "$pr_ref" == */*#* ]] && [ -f "$PROJECT_MAP_FILE" ]; then
    name=${name#*/}
    project=$(jq -r '.project // ""' <<<"$it")
    if [ -n "$project" ]; then
      want=$(project_repo_name "$project")
      got=$(project_of_repos_json "$name" | jq -r --arg n "$name" '.[$n] // ""')
      # gate: al-own-item
      [ "${got,,}" = "${want,,}" ] ||
        die "#$pr is in ${pr_ref%#*} ($got), and $item, taken from $implied, is a $project item in $want: a PR outside the item's repo names its item. Pass --item $item if this PR is that item's work (with --partial while its own PR is still to land), or give it its own item (agent-queue add --running --project $got \"<type(area): title>\") and pass --item <that slug>"
    fi
  fi
  [ -z "$sup_ref" ] || return 0
  read -ra refs <<<"$it_pr"
  for ref in "${refs[@]}" $(jq -r '.open_pr // ""' <<<"$it"); do
    [ "$ref" = "$pr_ref" ] || { [[ "$ref" != */*#* || "$pr_ref" != */*#* ]] && [ "${ref##*#}" = "$pr" ]; } || continue
    return 0
  done
  body=$(pr_view body .body 2>&1) || fail item-line "$api pr view: $(lastline "$body")"
  named=$(tr -d '\r' <<<"$body" | sed -n '/^Item: */{s/^Item: *\([^[:space:]]*\).*/\1/p;q;}')
  [ "$named" != "$item" ] || return 0
  # A placeholder ("Item: <slug>", "Item: n/a") names no item, as no line does.
  if [ -n "$named" ]; then
    rc=0
    aq_retry show "$named" >/dev/null 2>&1 || rc=$?
    [ "$rc" -ne "$QUEUE_BUSY" ] || die "the queue is locked by another writer: nothing touched, re-run"
  fi
  [ "$rc" -eq 0 ] &&
    die "#$pr ($pr_ref) is not $item's work, taken from $implied: its body names its item, $named. Pass --item $named for the item #$pr is the work of, or --item $item if it is this item's"
  die "#$pr ($pr_ref) may be a side fix, not $item's work, taken from $implied: its body has no \"Item: $item\" line and $item does not record it. If it is $item's work, add that line to the body or pass --item $item; else give it its own item (agent-queue add --running --project <p> \"<type(area): title>\") and pass --item <that slug>"
}

# own_merged: a MERGED PR skips own_head, which is what ties an open PR to this checkout. So it must
# be the item's some other way: the item records it (a re-run, or a --pr-only item; a bare ref by its
# number, as once_done reads it), its body has "Item: <slug>" (one-shot writes it, and this script
# stamps it before any merge), or its head commit is in this checkout's HEAD. Not the branch name:
# recycled worktrees reuse agent-N names across tasks.
own_merged() {
  local ref refs
  read -ra refs <<<"$it_pr"
  for ref in "${refs[@]}"; do
    [ "$ref" != "$pr_ref" ] && { [[ "$ref" == */*#* ]] || [ "$ref" != "$pr" ]; } || return 0
  done
  body=$(pr_view body .body 2>&1) || fail item-line "$api pr view: $(lastline "$body")"
  ! tr -d '\r' <<<"$body" | grep -qxF "Item: $item" || return 0
  ! git merge-base --is-ancestor "$head_oid" HEAD 2>/dev/null || return 0
  [ -z "$sup_ref" ] || return 0
  fail match "#$pr ($pr_ref, from $head_ref) is merged, and nothing ties it to $item: its body has no \"Item: $item\" line, its head ${head_oid:0:8} is not in this checkout's HEAD, and the item records ${it_pr:-no PR}. A PR in another repo: run from a checkout of it, with --repo <owner>/<repo>. If #$pr replaced $item's own PR and you closed that one: --supersedes <its number>"
}

# supersedes_mine: --supersedes <n> says merged #pr replaced the item's own PR #n, closed unmerged, so #pr
# lands the item though its body names its own session's item and its head is not in this checkout. #n
# must be in #pr's repo (a bare number, read there), CLOSED, opened before #pr merged (an older merged PR
# replaced nothing), and the item's by own_merged's ties (its body's "Item: <slug>", its head in this
# checkout's HEAD, or the item's pr: or open_pr:). Sets sup_ref, and takes a recorded #n off the item read
# here (drop_sup), since settle_prior refuses a closed one and once_done a second in the same repo; the
# queue keeps it until the record step writes the lists, so a refusal before then leaves the item as it was.
# Why: 2026-11-11 unity-core-playground agent-17 closed #2271 for agent-5's merged #2276, and nothing tied
# #2276 to its item, so the item stayed open and the session read closed without merging (bk-3).
supersedes_mine() {
  local out st sh opened merged_at ref refs
  [ "$state" = MERGED ] || die "--supersedes takes a merged PR, and #$pr is $state: let the session that made it land it, then re-run"
  ref="${pr_ref%#*}#$sup"; [[ "$pr_ref" == */*#* ]] || ref=$sup
  out=$(pr=$sup; pr_view state,headRefOid,body,createdAt '{state, headRefOid, body, createdAt} | tojson' 2>&1) ||
    die "--supersedes $sup: $api pr view $sup in ${pr_ref%#*}: $(lastline "$out")"
  read -r st sh opened < <(jq -r '"\(.state) \(.headRefOid) \(.createdAt)"' <<<"$out")
  case "$st" in
  CLOSED) ;;
  MERGED) die "--supersedes $sup: #$sup merged, so nothing replaced it: land it with agent-land $sup" ;;
  *) die "--supersedes $sup: #$sup in ${pr_ref%#*} is ${st:-unreadable}, not closed: close it first (gh pr close $sup --comment \"superseded by #$pr\"), then re-run" ;;
  esac
  merged_at=$(pr_view mergedAt .mergedAt 2>&1) || die "--supersedes $sup: $api pr view $pr: $(lastline "$merged_at")"
  opened=$(date -d "$opened" +%s 2>/dev/null) && merged_at=$(date -d "$merged_at" +%s 2>/dev/null) ||
    die "--supersedes $sup: cannot read when #$sup opened or #$pr merged"
  [ "$merged_at" -ge "$opened" ] || die "--supersedes $sup: #$pr merged before #$sup was opened, so it did not replace it"
  read -ra refs <<<"$it_pr"
  # Here-strings, not pipes into grep -q: under pipefail a writer cut off by grep's early exit reads as no match.
  if ! grep -qxF "Item: $item" <<<"$(jq -r '.body // ""' <<<"$out" | tr -d '\r')" &&
    ! git merge-base --is-ancestor "$sh" HEAD 2>/dev/null &&
    ! grep -qxF -e "$ref" -e "$sup" <<<"$(printf '%s\n' "${refs[@]}" $(jq -r '.open_pr // ""' <<<"$it"))"; then
    die "--supersedes $sup: nothing ties #$sup to $item: its body has no \"Item: $item\" line, its head ${sh:0:8} is not in this checkout's HEAD, and the item does not record it"
  fi
  sup_ref=$ref
  echo "supersedes: #$sup closed, replaced by #$pr"
  it=$(drop_sup <<<"$it")
  it_pr=$(jq -r '.pr // ""' <<<"$it")
}

# drop_sup: stdin's item JSON without the superseded PR in pr:, and its merge commit out of merged: at the same
# place. Lists out of step (a merged: neither empty nor as long as pr:) are left as they are, for settle_prior
# to refuse.
drop_sup() {
  jq -c --arg a "$sup_ref" --arg b "$sup" '
    (.pr // "" | split(" ") | map(select(. != ""))) as $p | (.merged // "" | split(" ") | map(select(. != ""))) as $m
    | if ($p | any(. == $a or . == $b) | not) or (($m | length) != 0 and ($m | length) != ($p | length)) then .
      else [range($p | length) | select($p[.] != $a and $p[.] != $b)] as $k
        | .pr = ([$k[] | $p[.]] | join(" ")) | .merged = ([$k[] | $m[.] // empty] | join(" ")) end'
}

# landed_by: sets lb to the set argument that adds "<this session>=<pr_ref>" to the item's landed_by:
# pairs, read from $it, or to nothing with no session id or no repo in pr_ref. The nightly outcomes pass credits each session
# with the PRs it landed from these pairs (queue_index); sessions: alone cannot say which one did (ar-2779).
landed_by() {
  local sid="${CLAUDE_CODE_SESSION_ID:-}" cur
  lb=()
  # A pr_ref that fell back to the bare argument names no repo, which agent-queue set refuses after the merge.
  [ -n "$sid" ] && [[ "$pr_ref" =~ ^[^/]+/[^/#]+#[0-9]+$ ]] || return 0
  cur=$(jq -r '.landed_by // ""' <<<"$it")
  [[ " $cur " == *" $sid=$pr_ref "* ]] || cur="${cur:+$cur }$sid=$pr_ref"
  lb=("landed_by=$cur")
}

# other_session: exit 0 when another session owns this queue item (its session: names another
# tmux session, or it has none and sessions: lists only other Claude sessions), so a --partial landing does not
# claim it and tie this session to it while it is still running (tilecast 2026-11-18, ar-3368).
other_session() {
  local sid="${CLAUDE_CODE_SESSION_ID:-}" cur tsess n
  [ -n "$sid" ] || return 1
  [ -z "${AGENT_QUEUE_ITEM:-}" ] || [ "$item" != "$AGENT_QUEUE_ITEM" ] || return 1
  [ -z "$implied" ] || return 1
  cur=$(jq -r '.sessions // ""' <<<"$it")
  [[ " $cur " != *" $sid "* ]] || return 1
  # session: is <server>:<session>, the form agent-queue's own_session records. Its own tmux
  # session is this one (a resumed session has a new id), and one this landing cannot name
  # (no tmux) is not known to be another's, so it claims as before.
  tsess=$(jq -r '.session // ""' <<<"$it")
  [ -n "$tsess" ] || { [ -n "$cur" ]; return; }
  [ -n "${TMUX:-}" ] && n=$(tmux display-message -p '#{session_name}' 2>/dev/null) && [ -n "$n" ] || return 1
  [ "$tsess" != "$(basename "${TMUX%%,*}"):$n" ]
}

# stamp_item: the PR body names its work item on one "Item: <slug>" line. A body that already has it
# is left alone; any other "Item:" line is replaced, else the line is appended. Before the checks,
# so a CI job that reads the body runs on the stamped one. On a MERGED PR an "Item:" line naming another
# queue item is that item's link (landing a duplicate item on the PR that did its work must not cut it),
# so it stays; a placeholder or an unknown slug is rewritten as on an open PR (ar-4252).
stamp_item() {
  local new out named
  [ -n "$body" ] || body=$(pr_view body .body 2>&1) || fail item-line "$api pr view: $(lastline "$body")"
  if tr -d '\r' <<<"$body" | grep -qxF "Item: $item"; then
    echo "item-line: present"
    return 0
  fi
  if [ "$state" = MERGED ]; then
    named=$(tr -d '\r' <<<"$body" | sed -n '/^Item: */{s/^Item: *\([^[:space:]]*\).*/\1/p;q;}')
    if [ -n "$named" ] && aq_retry show "$named" >/dev/null 2>&1; then
      echo "item-line: merged body names another item ($named), left as is"
      return 0
    fi
  fi
  if grep -q '^Item: ' <<<"$body"; then
    new=$(I="Item: $item" awk '/^Item: / { $0 = ENVIRON["I"] } { print }' <<<"$body")
  else
    new=$(printf '%s\n\nItem: %s' "$body" "$item")
  fi
  out=$(printf '%s\n' "$new" | pr_edit_body 2>&1) || fail item-line "$api pr edit: $(lastline "$out")"
  body=$new
  echo "item-line: added \"Item: $item\" to the body"
}

# link_task_row: an item with no row links the row its PR body's "Task: <id>" line names, when that id
# is one open row on the boards (as close_rows reads them), so the row closes on landing (ar-4231).
# A Task: id that is no open row (closed, mistyped, a text key) links nothing and says so. An item
# already done (done_as more or again) links nothing: its board step leaves the row to its closing PR.
link_task_row() {
  local task_id feed hit prof proj lane out
  [ -z "$row" ] && [ -z "$done_as" ] || return 0
  task_id=$(tr -d '\r' <<<"$body" | sed -n '/^[[:space:]]*Task:/{s/^[[:space:]]*Task:[[:space:]]*\([^[:space:]]*\).*/\1/p;q;}')
  [ -n "$task_id" ] || return 0
  feed=$(notes board --json 2>/dev/null) || { echo "item-row: notes board --json failed, so Task: $task_id is not linked"; return 0; }
  hit=$(jq -r --arg id "$task_id" '[.rows[]? | select(.id == $id)] | if length == 1 then .[0] | [.profile, .project, .lane] | @tsv else empty end' <<<"$feed" 2>/dev/null) || hit=''
  [ -n "$hit" ] || { echo "item-row: Task: $task_id is not one open row on any board, left unlinked"; return 0; }
  IFS=$'\t' read -r prof proj lane <<<"$hit"
  out=$(aq_retry set "$item" "row=$proj:$task_id" "lane=$lane" "profile=$prof" 2>&1) || fail item "linking row $proj:$task_id: $(lastline "$out")"
  it=$(aq_retry show "$item" --json 2>&1) || fail item "agent-queue show: $(lastline "$it")"
  set_row
  echo "item-row: linked $proj:$task_id from the body's Task: line"
}

# review_gate: a tier-3 item (`fleet-dispatch item-tier`, the one beside this script: harness or tooling, promoted from a row or
# queued by hand) merges only behind the red-fix gate, fix-red step 5: a "Review: /code-review <level>,
# <what it found and what you did>" line in the body (n/a or empty is refused), and checks that ran
# (wait_checks refuses "none reported" for it). The line is a claim, not proof: CI and the post-merge
# hold check are the backstops.
# Checked on the item, not where it was queued, so `agent-queue add` cannot skip it. An unreadable
# tier counts as 3, the side that waits.
tier='' body=''
# gate: al-review-gate
review_gate() {
  tier=$("$(dirname "$(readlink -f "$0")")/fleet-dispatch" item-tier "$item" 2>/dev/null) || tier=3
  [ "$tier" = 3 ] || return 0
  local line
  line=$(grep -m1 '^Review: ' <<<"$body" || true)
  [[ "$line" =~ ^Review:\ /code-review\ (low|medium|high|xhigh|max),\ *([^[:space:]].*)$ ]] &&
    ! [[ "${BASH_REMATCH[2],,}" =~ ^(n/?a|none|-|tbd|todo)[[:space:].]*$ ]] ||
    fail review "tier-3 item $item: no \"Review: /code-review <level>, <what it found and what you did>\" line in the PR body${line:+ (found: $line)}. Run /code-review high, fix or answer each finding, then add that line (~/.claude/skills/fix-red/SKILL.md step 5)"
  echo "review: present (tier 3)"
}

# loose_gate: a phase of a plan (an item with plan:, agent-queue add --plan) lands only once each open agent row
# its item filed has a home in that plan: a found blocker is a `takes <row id>` phase line (planning.md,
# Found work:), so the chain does the work and closes the row, never a row left loose while the plan reads done.
# The rows are plan_loose_rows's: the ingest record says who filed a row, as the board keeps no #from/ tag.
# A --partial landing is not checked (the final one is), nor is an item of no plan, nor a PR already merged
# (only recorded, as review_gate; P3's reconcile_plans finds a row left loose that way). A record or board it
# cannot read refuses, so a broken read never passes a loose row.
# gate: al-loose-gate
loose_gate() {
  [ "$partial" -eq 0 ] || return 0
  local p own loose
  p=$(jq -r '.plan // ""' <<<"$it")
  [ -n "$p" ] && [ -f "$p" ] || return 0
  own=$(jq -r '.row // ""' <<<"$it")
  loose=$(plan_loose_rows "$p" "$item" "${own#*:}") ||
    fail loose "could not read the rows $item filed (notes log, notes board); re-run once notes reads"
  [ -n "$loose" ] || return 0
  fail loose "$item filed open row(s) $(paste -sd' ' <<<"$loose") that no phase of $p takes. Two ways out: take each into the plan, a phase line \"- [ ] P<N> <what> takes <row id> (after N; needs ...)\" then agent-queue add --plan $p (or \"takes <row id>\" on this phase's own line when this PR does that work); or ask the human to drop it (agent-ask post). Then re-run agent-land; nothing was merged"
}

# stack_gate: an item whose after: names an item that has not closed ok was started on that item's open
# PR (fleet-dispatch cmd_start, a stacked phase) and does not merge before it: this PR carries the
# dependency's commits, so merging first would land them unreviewed. Exit 4 with the blocker named; a
# re-run once it closed ok catches up on <base> (catch_up) and lands; the dependency was squash-merged, so
# where the phase touched lines its commits touched that catch-up conflicts (exit 3): resolve it as any
# exit 3. A dependency that closed any other
# way never releases: the same refusal says so. Its own `open_pr:` is set first, so a phase stacked on
# this item can start while these checks run.
# gate: al-stack-gate
stack_gate() {
  local s dep st
  [ -n "$done_as" ] || aq_retry set "$item" "open_pr=$pr_ref" >/dev/null 2>&1 ||
    echo "item: could not record open_pr:$pr_ref on $item" >&2
  for s in $(jq -r '.after // ""' <<<"$it"); do
    dep=$(aq_retry show "$s" --json 2>/dev/null) || dep=''
    [ -n "$dep" ] || { echo "agent-land: could not read $s, which $item is after, so that dependency is not checked" >&2; continue; }
    st=$(jq -r '"\(.state // "") \(.status // "")"' <<<"${dep:-null}")
    [ "$st" != "done ok" ] || continue
    printf 'agent-land: #%s is stacked on %s (%s), so it does not merge before it: re-run once agent-queue show %s reads done ok\n' "$pr" "$s" "${st# }" "$s" >&2
    exit 4
  done
}

# validate_gate: critical work (judge_work_level, the ask judge's levels in judge.sh and the
# policy's floor lists) merges only on a second agent's pass verdict. Checked once the checks are
# green and the head caught up, on the head that would merge. The author item's `validate:` names
# its validate item, validate-<item>-<head>, which `fleet-dispatch validate` files for the head;
# that session reviews the PR, records `verdict` (pass or fail) and `verdict_head` on its own item,
# and runs this landing again. A pass on this head, or on one this head only merged <base> into,
# from an item none of the author's sessions worked, merges. A fail leaves the PR open and sends the
# author item back to the queue with the findings (its note). Anything else, a verdict missing,
# pending or on an older head included, files or names the validate item and exits 5: nothing
# merges. Unreadable files or policy refuse the same way. Why: the human, 2026-11-11, "maybe
# another agent to validate critical work" (ar-1689).
VALIDATE_WAIT=5
validate_gate() {
  local files lv ev vslug vit v vh vses ases s out
  files=$(pr_files 2>&1) || fail validate "could not read #$pr's changed files ($(lastline "$files")), so whether its work is critical is unknown; re-run"
  PR_FILES=$files
  out=$(judge_work_level "$(judge_conf PROMPT "$(dirname "$(readlink -f "$0")")/../../.config/agent-ask/policy.md")" \
    "${AGENT_ASK_ROOT:-$HOME/.agent/asks}" "$it" <<<"$files") ||
    fail validate "could not read the ask policy (ask-judge.conf PROMPT), so whether #$pr is critical is unknown"
  IFS=$'\t' read -r lv ev <<<"$out"
  [ "$lv" = critical ] || { echo "validate: $lv work, no second agent needed"; return 0; }
  # This session is the author's unless it is the validate item's: on the item now, so a later
  # verdict from it reads as the author's (a hand start may not have claimed it yet).
  if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && [[ "${AGENT_QUEUE_ITEM:-}" != "validate-$item-"* ]] && ! { [ "$partial" -eq 1 ] && other_session; }; then
    aq_retry claim "$item" >/dev/null 2>&1 || echo "validate: could not record this session on $item" >&2
    it=$(aq_retry show "$item" --json 2>/dev/null) || fail validate "could not re-read $item"
  fi
  vslug=$(jq -r '.validate // ""' <<<"$it")
  vit=''; [ -z "$vslug" ] || vit=$(aq_retry show "$vslug" --json 2>/dev/null) || vit=''
  IFS=$'\t' read -r v vh vses < <(jq -r '[.verdict // "", .verdict_head // "", .sessions // ""] | @tsv' <<<"${vit:-null}")
  if [ -n "$v" ] && covers "$vh"; then
    [ -n "$vses" ] || fail validate "$vslug records a $v verdict, but no session worked it: a verdict comes from a second agent's session"
    ases=" $(jq -r '.sessions // ""' <<<"$it") "
    for s in $vses; do
      [[ "$ases" != *" $s "* ]] || fail validate "$vslug was worked by session $s, which also worked $item: the verdict must come from another agent"
    done
    if [ "$v" = pass ]; then
      echo "validate: pass from $vslug on ${vh:0:8} (critical: $ev)"
      return 0
    fi
    out=$(aq_retry set "$item" "note=validation failed on #$pr at ${vh:0:8} ($vslug): $(jq -r '.note // "no findings recorded"' <<<"$vit")" 2>&1) &&
      out=$(aq_retry move "$item" queued 2>&1) || fail validate "$vslug failed #$pr, and $item could not go back to the queue: $(lastline "$out")"
    printf 'agent-land: validate failed: %s failed #%s on %s; #%s stays open and %s is back in the queue with its findings\n' "$vslug" "$pr" "${vh:0:8}" "$pr" "$item" >&2
    land_failed validate "$vslug failed it"
    exit 1
  fi
  if [ -n "$vit" ] && [ -z "$v" ] && [[ "$(jq -r .state <<<"$vit")" =~ ^(queued|running|waiting|review)$ ]]; then
    if covers "${vslug##*-}"; then
      printf 'agent-land: #%s is critical (%s), so it waits on %s, a second agent reviewing it; that session lands it on a pass\n' "$pr" "$ev" "$vslug" >&2
      exit "$VALIDATE_WAIT"
    fi
    aq_retry cancel "$vslug" --why "#$pr moved on to ${head:0:8}, which a new validate item reviews" >/dev/null 2>&1 ||
      echo "validate: could not cancel $vslug, which reviews an older head of #$pr" >&2
  fi
  vslug="validate-$item-${head:0:8}"
  out=$("$(dirname "$(readlink -f "$0")")/fleet-dispatch" validate "$item" --pr "$pr_ref" --head "$head" --why "$ev" 2>&1) &&
    out=$(aq_retry set "$item" "validate=$vslug" 2>&1) || fail validate "#$pr is critical ($ev), and its validate item could not be filed: $(lastline "$out")"
  printf 'agent-land: #%s is critical (%s), so it merges only on a second agent'"'"'s pass: queued %s, whose session reviews it and lands it on a pass\n' "$pr" "$ev" "$vslug" >&2
  exit "$VALIDATE_WAIT"
}
# covers <sha>: the head that would merge is <sha>, or adds to it nothing but merges of <base>
# (catch_up's clean merges), so a verdict on <sha> still reads its diff.
covers() {
  [ -n "$1" ] || return 1
  [[ "$head" == "$1"* ]] && return 0
  git merge-base --is-ancestor "$1" HEAD 2>/dev/null &&
    [ "$(git rev-list --count --no-merges HEAD "^$1" "^$remote/$base" 2>/dev/null)" = 0 ]
}

# shape_gate: a function over shape-grow's limit does not get longer. The fix is in the PR: extract
# the new logic as a pure function and call it. When that cannot be done here, the body names the
# board row that will split the function, "Split: <row id>", open on a lab sheet and naming each
# grown function, so a made-up or closed id is no escape. Measured from the merge-base, so what
# <base> changed since never reads as this PR's growth. Why: 2026-11-18 ci-runner-governor's
# decide() grew 34 -> 269 lines over 35 sessions, a few lines a PR, and no review read the whole.
# gate: al-shape-gate
shape_gate() {
  local out rc=0 mb list id row miss
  mb=$(git merge-base HEAD "$remote/$base" 2>&1) || fail shape "git merge-base HEAD $remote/$base: $(lastline "$mb")"
  out=$("${SHAPE_GROW:-$(dirname "$(readlink -f "$0")")/shape-grow}" "$mb" HEAD 2>&1) || rc=$?
  case $rc in
    0) echo "shape: clean"; return 0 ;;
    1) list=$(paste -sd';' <<<"$out" | sed 's/;/; /g') ;;
    *) fail shape "shape-grow $mb HEAD: $(lastline "$out")" ;;
  esac
  id=$(grep -m1 -oE '^Split: *[a-z]+-[0-9]+' <<<"$body" | sed -E 's/^Split: *//' || true)
  [ -n "$id" ] || fail shape "long functions got longer: $list. Extract the new logic as a pure function (inputs in, result out) and call it; a helper that mutates shared state only moves the length. Or add a \"Split: <row id>\" line naming an open board row that names each function"
  row=$(lab_row "$id" | grep -m1 '^[[:space:]]*- \[ \]' || true)
  [ -n "$row" ] || fail shape "Split: $id is not an open row on any sheet under ~/.notes/lab ($list)"
  # A line is "<path>:<line> <name> <was>-><now>", so the name is the next-to-last field even when the path has a space.
  miss=$(awk '{n = $(NF - 1); sub(/#[0-9]+$/, "", n); sub(/.*\./, "", n); print n}' <<<"$out" | sort -u |
    while read -r f; do grep -qwF -- "$f" <<<"$row" || echo "$f"; done)
  [ -z "$miss" ] || fail shape "Split: $id does not name $(paste -sd' ' <<<"$miss"): the row that owes the split names each function it splits ($list)"
  echo "shape: grows, split owed by $id: $list"
}

# item_watch <item json> -> the watch name when the item is a `red` item for a Sentinel watch
# (`check(watch): <name> ...`), empty otherwise.
item_watch() {
  jq -r 'select(((" " + (.tags // "") + " ") | contains(" red ")))
    | (.title // ((.task // "") | split("\n")[0]))
    | try capture("^check\\(watch\\): (?<w>[A-Za-z0-9._-]+)").w // empty' <<<"$1" 2>/dev/null
}

# watch_gate <item json>: a red item for a Sentinel watch cannot close ok while its watch's probe
# still trips. The PR merged (and autopull ran for dotfiles), so it resolves the watch with this PR,
# which records the merge as the fix watermark (a windowed probe counts only events after it, fix-red
# step 5) and rechecks; a bare #N with no repo rechecks only. Still red means the fix did not clear
# it, or waits on a deploy: re-running agent-land once it clears closes the item and its board row.
# gate: al-watch-gate
watch_gate() {
  local w rc=0 out verb
  w=$(item_watch "$1")
  [ -n "$w" ] || return 0
  command -v watch-companion-loop >/dev/null 2>&1 || { echo "watch: $w not checked (no watch-companion-loop on PATH)"; return 0; }
  verb=(recheck "$w")
  [[ "$pr_ref" != */* ]] || verb=(resolve "$w" --pr "$pr_ref")
  out=$(watch-companion-loop "${verb[@]}" 2>&1) || rc=$?
  # exit 2 is also a usage error (a loop with no resolve): only "no watch named" skips the check
  case "$rc" in
    0) echo "watch: $w OK" ;;
    2) [[ "$out" == *"no watch named $w"* ]] || fail item "watch-companion-loop ${verb[0]} $w: $(lastline "$out")"
       echo "watch: $w not known here (exit 2), skipping probe check" ;;
    75) fail item "watch-companion-loop ${verb[0]} $w could not take the lock (exit 75); re-run" ;;
    *) fail item "watch $w did not read OK on ${verb[0]} (exit $rc)${out:+: $(lastline "$out")}" ;;
  esac
}

# unlisted_repo <store key>: the merged PR's repo is in no `schedules-sync repos` list (sync-prs exit
# 3). Says so with the fix, and files it on the outbox (notes exits 3 while a like row is open, so a
# second landing there files nothing new; 5, a hand session's shortlist to read, files nothing and
# prints the add to run by hand). Never fails the landing: the merge stands.
unlisted_repo() {
  local board=${AGENT_LAND_LEDGER_BOARD:-agent-runtime} out rc=0
  echo "prs: $1 is in no schedules-sync repos list, so the run ledger never reads it and fleet-bench's cleanup hold reads it as unread: add it to the exporter's FEED_REPOS or FORGEJO_REPOS (home-config apps/github-runner-exporter/deployment.yaml) if it runs CI, else to a prsOnly tracker in project-map.json" >&2
  local row="fix(ledger): $1 is in no schedules-sync repos list, so nothing guards its main after a cleanup merge: add it to the exporter's repo list (home-config apps/github-runner-exporter/deployment.yaml) if it runs CI, else a prsOnly tracker in project-map.json #high #size/s"
  out=$(notes ptask "$board" --agent add --why runtime-fault "$row" 2>&1 </dev/null) || rc=$?
  case "$rc" in
    0 | 4) echo "prs: filed on the $board outbox" >&2 ;;
    3) echo "prs: a like row is already open on $board" >&2 ;;
    5) echo "prs: not filed, notes wants its shortlist read first: notes ptask $board --agent add --why runtime-fault --checked <ids> '$row'" >&2 ;;
    *) echo "prs: could not file it on $board ($(lastline "$out"))" >&2 ;;
  esac
}

# deploy_steps: each "After deploy: <step>" line of the merged PR's body is a step the PR leaves for
# once its change is live (a migration of the live store, a restart, a re-seed). Each is added as its
# own item on the landed item's project, so the step has an owner: #3249 left `notes projects --migrate
# unity-core-playground` in a sentence, nobody ran it, and from 09:06 to 13:30 on 2026-11-23 no board
# view or dispatch pass read a unity sprint (ar-4887). A line in a code fence or a quote, and a
# placeholder (`<command>`, none, n/a), is no step. The slug names the PR, a hash of the step and the
# repo, so a re-run of this landing adds none twice, even after the body was edited. The add is
# from the landed item but not run as it (AGENT_QUEUE_ITEM empty), so that item's own after: never
# gates it. High, since main's change is only half applied until it runs. Never fails the landing:
# the merge stands, and a step not added is said with the add to run by hand.
deploy_steps() {
  local text step slug project out rc steps=() repo=${pr_ref%#*}
  text=$(pr_view body .body 2>&1) || { echo "deploy: no After deploy: step read ($api pr view: $(lastline "$text")); re-run agent-land $pr to add them" >&2; return 0; }
  mapfile -t steps < <(tr -d '\r' <<<"$text" | awk '
    /^[[:space:]]*(```|~~~)/ { fence = !fence; next }
    fence || !sub(/^After deploy:[[:space:]]*/, "") { next }
    { sub(/[[:space:]]+$/, "") }
    $0 != "" && $0 !~ /^</ && tolower($0) !~ /^(none|n\/a|nothing|-)\.?$/')
  [ "${#steps[@]}" -gt 0 ] || return 0
  project=$(jq -r '.project // empty' <<<"$it")
  for step in "${steps[@]}"; do
    rc=0
    # the repo last: agent-queue cuts a slug at 40 characters
    slug="after-deploy-$pr-$(printf '%s' "$step" | sha1sum | cut -c1-7)-${repo##*/}"
    out=$(AGENT_QUEUE_ITEM='' aq_retry add --project "$project" --priority high --from "item:$item" --slug "$slug" \
      "chore(deploy): $step (left by $pr_ref)"$'\n\n'"$pr_ref (merge ${merged:0:12}) left this step for once its change is live: $step"$'\n'"Check the change is live first (a dotfiles merge: the main checkout is at or past the merge; a service: its rollout finished), then run it and prove what it changed." 2>&1) || rc=$?
    case "$rc" in
      0) echo "deploy: added $slug: $step" ;;
      5) echo "deploy: $slug filed on the $project board, the queue takes it from there: $step" ;;
      4) echo "deploy: $slug already ran: $step" ;;
      *) if [[ "$out" == *"already in the queue"* ]]; then echo "deploy: $slug already queued: $step"
         else echo "deploy: not added ($(lastline "$out")): agent-queue add --project $project --priority high --from item:$item --slug $slug 'chore(deploy): $step (left by $pr_ref)'" >&2; fi ;;
    esac
  done
}

# credit -> ", <what agent-queue attribute recorded>" for the item line: the PR's changed files
# credit the item to the registry project whose `path` owns most of them (a game inside the
# playground). It never fails the landing: the PR is merged, and the item keeps the project it
# was added under, so the line says why it was not credited.
credit() {
  local files out
  [[ "$pr_ref" == */*#* ]] || { echo ", not credited (no repo on #$pr)"; return 0; }
  # validate_gate read them already on a merge this run made (PR_FILES), the same files squashed.
  files=${PR_FILES-$(pr_files 2>&1)} || { echo ", not credited ($api api: $(lastline "$files"))"; return 0; }
  out=$(printf '%s\n' "$files" | agent-queue attribute "$item" 2>&1) || { echo ", not credited ($(lastline "$out"))"; return 0; }
  [ -z "$out" ] || echo ", $out"
}

# board_cmd -> the notes argv that closes the item's row, one word a line; none for an item with no row.
# Its proof is the PR, by repo when the URL names one (pr:<owner>/<repo>#N, so the graph joins it
# with no project lookup), and, once proven, the merge commit: something checkable, not a claim.
board_cmd() { [ -z "$row" ] || printf '%s\n' "$row" "pr:${pr_ref:-$pr}${merged:+ commit:${merged:0:12}}"; }
# row_at <id> <feed> -> "<profile>US<project>US<lane>" (US the \x1f unit separator, so an empty field keeps
# its place) of the one open or started row with this id on any board of a `notes board --json` feed;
# nothing when no row or two carry it, or the feed is not JSON.
row_at() {
  jq -r --arg id "$1" '[.rows[]? | select(.id == $id and (.state == "open" or .state == "doing"))]
    | if length == 1 then .[0] | [.profile // "", .project // "", .lane // ""] | join("\u001f") else empty end' <<<"$2" 2>/dev/null
}
# locate_row: the item's recorded row (`row`, "<board>:<key>") pointed at where it sits now. A row moved
# to another board or to the other lane (`notes ptask move`) keeps its id, so the one open agent or human
# lane row carrying an id-shaped key wins, and row_board, row_lane, row_prof and row_moved (the
# recorded place) say where; the recorded board answers when none does (a text key, a row already
# closed, a feed that does not read). Ids are minted per board prefix, so a second open row with the
# id is the moved one. Why:
# ucp-1594 moved to the shape-city board after dispatch promoted it from unity-core-playground's, so
# #2836's landing exited 1 "no open task matches" (2026-11-17, ar-2751).
row_board='' row_lane='' row_prof='' row_key='' row_moved=''
locate_row() {
  local rec hit p b l w
  rec=$(jq -r '[.row // "", .profile // "", .lane // "agent"] | join("\u001f")' <<<"$it")
  IFS=$'\x1f' read -r row_key row_prof row_lane <<<"$rec"
  [ -n "$row_key" ] || return 0
  row_board=${row_key%%:*} row_key=${row_key#*:}
  [[ "$row_key" =~ ^[A-Za-z][A-Za-z0-9_-]*-[0-9]+$ ]] || return 0
  hit=$(row_at "$row_key" "$(notes board --json 2>/dev/null)") && [ -n "$hit" ] || return 0
  IFS=$'\x1f' read -r p b l <<<"$hit"
  [ -n "$b" ] && { [ "$l" = agent ] || [ "$l" = human ]; } || return 0
  [ "$b" = "$row_board" ] && [ "$l" = "$row_lane" ] && { [ -z "$row_prof" ] || [ "$p" = "$row_prof" ]; } && return 0
  row_moved="$row_board, $row_lane lane${row_prof:+, profile $row_prof}"
  row_prof=$p row_board=$b row_lane=$l
  w=(); [ -z "$p" ] || w=(--profile "$p")
  w+=(ptask "$b"); [ "$l" != agent ] || w+=(--agent)
  row=$(printf '%s\n' "${w[@]}" done "$row_key" --proof)
}
# read_open: queue_items <- every open queue item, one JSON object a line (agent-queue list --json, whose
# `row` is agent-queue's one definition), read once per landing; rc 1 when the queue cannot be read.
queue_items='' queue_read=''
read_open() { [ -n "$queue_read" ] || { queue_items=$(aq_retry list --json 2>/dev/null) && queue_read=1; }; }
# row_worker <board>:<id> -> the slug of another open item (read_open) that names that row, else nothing.
# A row two items name closes with the last of them to land, never under the other: agent-queue's
# link_row and repoint_row keep the same rule (ar-1793).
row_worker() {
  jq -rs --arg r "${1,,}" --arg s "$item" 'first(.[] | select((.row // "" | ascii_downcase) == $r and .slug != $s) | .slug) // empty' <<<"$queue_items"
}
# row_closed <project> <id>: rc 0 when the boards' done feed lists that row on that project as done,
# not dropped, so a done that matched no open row met one already ticked (by hand, or by another
# landing), not a missing or dropped row (ar-4189). notes-cli's ptask done prints the "no open task
# matches" line both read. 3650 days reaches every close the feed keeps, the version notes included.
row_closed() {
  notes board --json --done-days 3650 2>/dev/null | jq -e --arg p "$1" --arg id "$2" \
    'any(.done[]?; .project == $p and .id == $id and ((.marker // "") | test("(^| )(dropped|dup):") | not))' >/dev/null 2>&1
}
# close_rows <id>...: each row still open on a board closes with this PR as proof, as the item's own row
# does, unless another open item works it. The PR is merged by now, so a row it cannot close is a line
# with the command, never a failed landing.
close_rows() {
  local ids feed id hit prof proj lane out flag other
  ids=$(printf '%s\n' "$@")
  feed=$(notes board --json 2>/dev/null) || { echo "rows: notes board --json failed; close by hand: $(paste -sd' ' <<<"$ids")"; return 0; }
  read_open || { echo "rows: agent-queue list failed, so no row is known free of another open item; close by hand: $(paste -sd' ' <<<"$ids")"; return 0; }
  while IFS= read -r id; do
    hit=$(jq -r --arg id "$id" '[.rows[]? | select(.id == $id)] | if length == 1 then .[0] | [.profile, .project, .lane] | @tsv else empty end' <<<"$feed" 2>/dev/null) ||
      { echo "rows: notes board --json was not JSON; close by hand: $(paste -sd' ' <<<"$ids")"; return 0; }
    if [ -z "$hit" ]; then echo "rows: $id is not one open row on any board, left as is"; continue; fi
    IFS=$'\t' read -r prof proj lane <<<"$hit"
    flag=(); [ "$lane" = agent ] && flag=(--agent)
    other=$(row_worker "$proj:$id")
    if [ -n "$other" ]; then
      echo "rows: $id left open, $other still works it (if it is dropped: notes --profile $prof ptask $proj ${flag[*]:+${flag[*]} }done $id --proof pr:${pr_ref:-$pr})"
      continue
    fi
    if out=$(notes --profile "$prof" ptask "$proj" "${flag[@]}" done "$id" --proof "pr:${pr_ref:-$pr}${merged:+ commit:${merged:0:12}}" 2>&1); then
      echo "rows: closed $id on $proj"
    else
      echo "rows: $id not closed ($(lastline "$out")): notes --profile $prof ptask $proj ${flag[*]:+${flag[*]} }done $id --proof pr:${pr_ref:-$pr}"
    fi
  done <<<"$ids"
}
# close_plan_rows: once --plan has no open phase left, each row on its `rows:` line (plan_rows) closes.
close_plan_rows() {
  local ids
  [ "$partial" -eq 0 ] || return 0
  ids=$(plan_rows "$plan")
  [ -n "$ids" ] || return 0
  [ "$(plan_left "$plan")" = 0 ] || return 0
  if plan_superseded "$plan"; then echo "rows: left open, the plan is superseded: $(paste -sd' ' <<<"$ids")"; return 0; fi
  if plan_phase_list "$plan" | jq -e 'any(.[]; .state == "deferred")' >/dev/null; then echo "rows: left open, the plan deferred a phase: $(paste -sd' ' <<<"$ids")"; return 0; fi
  # shellcheck disable=SC2086  # one id a word
  close_rows $ids
}
# phase_line <plan> <phase>: the whole unchecked line a --phase names (the tick matches it by prefix).
phase_line() { P="- [ ] $2" awk 'index($0, ENVIRON["P"]) == 1 { print; exit }' "$1"; }

if [ -n "$plan$phase" ]; then
  [ -n "$plan" ] && [ -n "$phase" ] || die "--plan and --phase go together"
  [ -f "$plan" ] || die "no plan file: $plan"
  # A pointer stub ("Phase N of <plan>.md") owns no phases: the tick, the last-phase test and the
  # plan's rows all belong to the canonical plan it names; the stub's own line is ticked beside it.
  IFS=$'\t' read -r canon _ < <(plan_pointer "$plan") || true
  [ -z "${canon:-}" ] || { stub="$plan"; plan="$canon"; echo "plan: $stub is a pointer stub; its phases are in $plan"; }
  # Checked before the merge, so a bad phase name cannot leave a merged PR half recorded.
  n=$(P="- [ ] $phase" awk 'index($0, ENVIRON["P"]) == 1 { n++ } END { print n + 0 }' "$plan")
  [ "$n" -eq 1 ] || die "plan: $n unchecked lines start with \"- [ ] $phase\", need exactly 1"
fi

if [ "$partial" -eq 1 ] && [ "$(jq -r .state <<<"$it")" = done ]; then
  die "--partial needs an open item; $item is already done"
fi

if [ "$dry" -eq 1 ]; then
  # The real run's one-PR-per-repo gate, on the repo --repo, the Forgejo remote or origin names,
  # since a dry run reads no PR URL; with none of them it cannot tell the PR's repo and skips it.
  # An item with no PR yet has nothing to gate, so its dry run reads no remote. A subshell, so
  # pr_ref stays empty for the steps below, as the real run's is before pr_view.
  it_pr=$(jq -r '.pr // ""' <<<"$it")
  if [ -n "$it_pr" ] || [ "$(jq -r .state <<<"$it")" = done ]; then
    dry_repo=${repo:-${fj:+$fj_repo}}
    [ -n "$dry_repo" ] || dry_repo=$(origin_repo .) || dry_repo=''
    [ -z "$dry_repo" ] || (pr_ref="$dry_repo#$pr"; item_pr_gate >/dev/null) || exit $?
  fi
  [ -z "$fj" ] || echo "forge: Forgejo $fj on remote $remote: each gh pr call below is that API (pulls/$pr, PATCH for the body, commits/<head>/status for the checks, POST pulls/$pr/merge {Do, head_commit_id}, pulls/$pr/files), and each git step reads $remote, not origin"
  echo "item-line: gh pr view $pr${repo:+ -R $repo} --json body, then gh pr edit $pr --body-file -  (unless it has \"Item: $item\")"
  echo "head: git rev-parse HEAD must equal the PR's headRefOid (when it is git ls-remote origin's tip of the PR branch, poll gh pr view $pr --json headRefOid until it does), else exit 1 naming the PR's checkout (git worktree list); the PR's repo must be origin's; a MERGED PR must name the item, have its head in HEAD, or be on the item${sup:+, or replace closed #$sup (--supersedes: #$sup is the item's and opened before #$pr merged; the record drops it from the item's pr:)}; an item not named by --item takes only a PR in its project's repo that it records or whose body has \"Item: $item\""
  echo "review: fleet-dispatch item-tier $item  (tier 3: the body needs a \"Review: \" line and the checks must run)"
  [ "$partial" -eq 1 ] || [ -z "$(jq -r '.plan // ""' <<<"$it")" ] ||
    echo "loose: plan_loose_rows $(jq -r .plan <<<"$it") $item  (notes log, then notes board --json --id: an open agent row $item filed that no phase line takes stops the landing)"
  echo "shape: shape-grow \$(git merge-base HEAD origin/<base>) HEAD  (no function over 150 lines gets longer, unless the body has a \"Split: <row id>\" line naming an open row that names each function)"
  echo "checks: gh pr checks $pr${repo:+ -R $repo} --watch --fail-fast -i $CHECKS_WATCH_INTERVAL  (must pass, or report none on a tier 1 or 2 item; a land that would refuse none, on a head with workflow files, first waits up to $CHECKS_FIRST_RUN_TRIES x ${CHECKS_QUEUED_POLL}s for its first run, AGENT_LAND_CHECKS_FIRST_RUN_TRIES)"
  echo "fetch: git fetch origin && git rev-list --count HEAD..origin/<base of #$pr>  (0 before the checks; after them git merge origin/<base> && git push, then the checks again on that head)"
  echo "validate: gh api repos/<owner>/<repo>/pulls/$pr/files | judge_work_level  (critical: merges only on a pass verdict from the item's validate item on this head, else fleet-dispatch validate $item and exit $VALIDATE_WAIT)"
  echo "merge: gh pr merge $pr${repo:+ -R $repo} $method${admin[*]:+ ${admin[*]}} --match-head-commit \$(git rev-parse HEAD) && gh pr view $pr${repo:+ -R $repo} --json state  (must be MERGED)"
  echo "body: gh pr view $pr${repo:+ -R $repo} --json body | comms-lint --channel pr-body -  (a score, never a gate; first a ~/.cache/*.md or *.txt whose text is the body is deleted)"
  echo "proof: gh pr view $pr${repo:+ -R $repo} --json mergeCommit, then merge_proof: an ancestor of origin/<base>"
  echo "live: dotfiles-autopull --now . --bg  (in the background, its result logged to ~/.cache/dotfiles-autopull/autopull.log: fast-forwards ~/.dotfiles or ~/.dotfiles-private when this is that repo, rebuilds the Rust tools (notes through notes-bootstrap), restarts agent-web on a new binary and a persistent agentctl runner on a new script; never fails the landing)"
  echo "prs: schedules-sync sync-prs <owner>/<repo>  (the PR store reads the merge now, not at its next poll; exit 3, a repo in no list, is said and filed on the agent-runtime outbox; never fails the landing)"
  if [ "$partial" -eq 1 ]; then
    echo "item: agent-queue set $item partial=yes once #$pr is merged; record pr=$pr merged=<sha> beside earlier PRs, leave the item open"
    echo "board: left open until the final landing"
  else
    [ -n "$fj" ] || echo "split: gh search prs --owner <owner> --state open --match body -- \"Item: $item\"  (before anything is touched: another open PR whose first Item: line names $item refuses this full landing; land #$pr --partial)"
    dry_watch=$(item_watch "$it")
    [ -z "$dry_watch" ] || echo "watch: watch-companion-loop resolve $dry_watch --pr <owner>/<repo>#$pr  (a red item closes ok only once its probe passes)"
    echo "item: agent-queue set $item pr=$pr merged=<sha> partial= beside earlier PRs && gh api repos/<owner>/<repo>/pulls/$pr/files | agent-queue attribute $item && agent-queue move $item done --status ok"
  fi
  mapfile -t b < <(board_cmd)
  [ "$partial" -eq 1 ] || [ "${#b[@]}" -eq 0 ] || echo "board: notes ${b[*]}"
  [ -z "$plan" ] || echo "plan: tick \"- [ ] $phase\" -> \"- [x] ... (#$pr)\" in $plan"
  [ -z "$plan" ] || [ -z "$(phase_takes "$(phase_line "$plan" "$phase")")" ] ||
    echo "rows: close $(phase_takes "$(phase_line "$plan" "$phase")" | tr '\n' ' ')with pr:$pr, the rows the phase takes"
  if [ -n "$plan" ] && [ "$partial" -eq 0 ] && [ -n "$(plan_rows "$plan")" ] &&
    [ "$(plan_left "$plan")" = 1 ]; then
    echo "rows: close $(plan_rows "$plan" | tr '\n' ' ')with pr:$pr, the plan's last phase"
  fi
  exit 0
fi

info=$(pr_view state,baseRefName,url,headRefOid,isCrossRepository,headRefName '.state + " " + .baseRefName + " " + .url + " " + .headRefOid + " " + (.isCrossRepository | tostring) + " " + .headRefName' 2>&1) ||
  fail fetch "$api pr view $pr: $(lastline "$info")"
read -r state base url head_oid cross head_ref <<<"$info"
# The item's PR names its repo: a bare number is ambiguous across the repos one project spans.
pr_ref=$(sed -E 's#^https?://[^/]+/([^/]+/[^/]+)/pulls?/([0-9]+).*#\1\#\2#' <<<"$url")
[[ "$pr_ref" =~ ^[^/]+/[^/#]+#[0-9]+$ ]] || pr_ref="$pr"
done_as=''
it_pr=$(jq -r '.pr // ""' <<<"$it")
own_repo
[ -z "$sup" ] || supersedes_mine
own_item
done_as=$(item_pr_gate) || exit $?
# settle_prior: pr: and merged: are lists in step, so each earlier PR an open item records needs its
# merge commit before this one joins them. One recorded with none (its pr= set while it was open, or
# merged outside agent-land) takes it from gh into prior_oid; one not merged refuses here, before
# the merge, never after it. Why: private #762 merged and was left off its item, whose public #1794
# had no merge recorded (2026-11-11). A --partial landing takes one still OPEN: pr: lists
# both before either merges (move review, --pr-only), and refusing each landing for the other's merge
# deadlocked them (ar-1267, seen on ar-314 2026-11-09).
declare -A prior_oid=()
settle_prior() {
  local refs oids i out
  read -ra refs <<<"$it_pr"
  read -ra oids <<<"$(jq -r '.merged // ""' <<<"$it")"
  # Space-split lists lose an empty slot, so a shorter merged: cannot say which PR lacks its merge.
  [ "${#oids[@]}" -eq 0 ] || [ "${#oids[@]}" -ge "${#refs[@]}" ] ||
    die "queue item $item records pr:${refs[*]} with merged:${oids[*]}, out of step: set both lists (agent-queue set $item pr=... merged=...), then re-run"
  for i in "${!refs[@]}"; do
    [ "${refs[i]}" != "$pr_ref" ] && [ "${refs[i]}" != "$pr" ] && [ -z "${oids[i]:-}" ] || continue
    [[ "${refs[i]}" == */*#* ]] || die "queue item $item records pr:${refs[i]} with no merge, and a bare number names no repo to look it up in"
    out=$(gh pr view "${refs[i]##*#}" -R "${refs[i]%#*}" --json state,mergeCommit -q '.mergeCommit.oid // .state' 2>&1) ||
      die "gh pr view ${refs[i]}: $(lastline "$out")"
    case "$out" in
    MERGED) die "queue item $item records ${refs[i]}, which gh reads MERGED with no merge commit: record it (agent-queue set $item merged=<sha>), then re-run" ;;
    CLOSED) die "queue item $item records ${refs[i]}, closed unmerged: drop it from the item's pr: (agent-queue set $item pr=...), then re-run" ;;
    esac
    [ "$partial" -eq 0 ] || [ "$out" != OPEN ] || continue
    [[ "$out" =~ ^[0-9a-f]{40}$ ]] ||
      die "queue item $item records ${refs[i]}, which is $out: land it first (agent-land ${refs[i]##*#} --repo ${refs[i]%#*} --item $item --partial), then #$pr"
    prior_oid[${refs[i]}]=$out
  done
}
[ -n "$done_as" ] || settle_prior
# split_gate: settle_prior sees only the PRs an item records, and a full landing closes the item, which frees
# every item held after: it. So before it, an open PR in any repo of this PR's owner whose body names the item
# (its first "Item:" line, as own_item reads it) refuses the landing as a recorded one does: the item is split,
# so this PR lands --partial and that one closes it. A re-run that records a merged PR is refused too, since
# recording it in full closes the item the same way. Why: ar-2653 closed on public #2278 while private #949,
# naming it, was open and unrecorded, freeing an after: hold early (2026-11-17, ar-2665). GitHub search only:
# Forgejo has none across repos, and a PR opened under a minute ago may not be indexed yet.
split_gate() {
  [ "$partial" -eq 0 ] && [ -z "$fj" ] && [[ "$pr_ref" == */*#* ]] || return 0
  local hits open ref
  # gate: al-split-gate
  hits=$(gh search prs --owner "${pr_ref%%/*}" --state open --match body --limit 100 --json number,repository,body -- "Item: $item" 2>&1) ||
    die "split: gh search prs for open PRs naming $item failed, nothing touched: $(lastline "$hits"); re-run"
  open=$(jq -r --arg s "$item" --arg me "${pr_ref,,}" '.[]
    | select(([(.body // "") | gsub("\r"; "") | split("\n")[] | select(startswith("Item:"))][0] // "" | capture("^Item: *(?<s>[^[:space:]]*)").s) == $s)
    | .repository.nameWithOwner + "#" + (.number | tostring) | select(ascii_downcase != $me)' <<<"$hits" 2>&1) ||
    die "split: reading gh search prs for $item: $(lastline "$open")"
  [ -n "$open" ] || return 0
  ref=${open%%$'\n'*}
  # gate: al-split-gate
  die "$(tr '\n' ' ' <<<"$open")is open and names $item, which a full landing would close: land #$pr --partial (agent-land $pr${repo:+ --repo $repo} --item $item --partial), then $ref with the full flags (agent-land ${ref##*#} --repo ${ref%#*} --item $item); if $ref is not $item's work, drop its \"Item: $item\" line"
}
[ -n "$done_as" ] || split_gate
# mark_partial: the --partial marker follows the merge, never the attempt. Set before it, a merge that
# failed left partial: yes on an item with nothing merged, and reap requeued it as "merged as a partial"
# (ar-2904). Called once the PR is known merged (already MERGED, or gh/the API accepted the merge), ahead
# of the state read, the proof and the record steps, so one that fails after the merge still leaves it.
mark_partial() {
  [ "$partial" -eq 1 ] || return 0
  local out
  out=$(aq_retry set "$item" partial=yes 2>&1) || fail item "$(lastline "$out")"
}

# Before stamp_item, so a refused run leaves the PR untouched.
if [ "$state" = MERGED ]; then own_merged; else own_head; fi
# Past own_merged, a merged PR is this item's: what fails from here leaves only its record (fail).
[ "$state" != MERGED ] || pr_landed=1
stamp_item
link_task_row

if [ "$state" = MERGED ]; then
  mark_partial
  echo "merge: #$pr already MERGED, recording it"
else
  # Before the checks too: a PR that conflicts with its base gets no pull_request run at all
  # (GitHub cannot build its merge ref), so its last, stale Checks red would read as a failure.
  stack_gate
  review_gate
  loose_gate
  # A head behind <base> is caught up first, the same merge as after the gate: a session that
  # stopped on exit 3 here left its green PR open while main moved (six waiting on 2026-11-07).
  catch_up before || true
  shape_gate
  wait_checks
  waits=0
  while ! catch_up after "$waits"; do
    wait_checks
    waits=$((waits + 1))
  done

  head=$(git rev-parse HEAD)
  validate_gate
  out=$(pr_merge "$head" 2>&1) || fail merge "$(lastline "$out")"
  mark_partial
  state=$(pr_view state .state 2>&1) || fail merge "$api pr view: $(lastline "$state")"
  [ "$state" = MERGED ] || fail merge "#$pr reads $state, not MERGED"
  pr_landed=1
  echo "merge: #$pr MERGED at ${head:0:8}"
fi

score_body

# The record steps carry the merge commit, proven on origin/<base> from the git graph: a PR object
# reading MERGED is not proof its content is on the branch (ticket contract, "done is a gate").
merged=$(pr_view mergeCommit .mergeCommit.oid 2>&1) || fail proof "$api pr view: $(lastline "$merged")"
# shellcheck source=../lib/agent-merge-proof.sh
. "$(dirname "$(readlink -f "$0")")/../lib/agent-merge-proof.sh"
out=$(MERGE_PROOF_REMOTE=$remote merge_proof . "$pr" "$base" "$merged" 2>&1) || fail proof "$(lastline "$out")"
echo "proof: $out"
# Stow serves the main checkouts, so a merged dotfiles PR is live only once its checkout moves:
# fast-forward it now, in the background: its builds can take the pass lock for minutes, and the
# landing waits on none of it (ar-4471). Prints nothing for any other repo, and never fails the landing.
live=$("${DOTFILES_AUTOPULL:-$(dirname "$(readlink -f "$0")")/dotfiles-autopull}" --now . --bg 2>/dev/null) || true
[ -z "$live" ] || printf '%s\n' "$live" | sed 's/^/live: /'
# The PR store reads this merge now, not at its next poll, so its readers see it at once. A repo the
# store does not list (exit 3) is in no `schedules-sync repos` list, so the run ledger never reads
# it and fleet-bench's cleanup hold cannot read its main (the KPIs read it as unread): said here and
# filed on the outbox once, since it is a map entry to add, not this landing's fault. muxpoon sat
# that way for a week, as home-config and fleet-platform had before it (ar-5402). Any other failure
# is said, and the next poll reads the merge.
if [[ "$pr_ref" == */*#* ]]; then
  store=${pr_ref%#*} host=$(url_host "$url")
  # html_url carries the public host; the store keys a Forgejo repo by the project map's
  # forges.forgejo host, so map the alias or sync-prs exits 3, unseen (ar-4530).
  [ "$host" = github.com ] ||
    store=$(so_store_key "${SO_PROJECT_MAP:-$HOME/.config/shared-hooks/project-map.json}" "$host/$store")
  rc=0; out=$("${SCHEDULES_SYNC:-schedules-sync}" sync-prs "$store" 2>&1) || rc=$?
  case "$rc" in
    0) ;;
    3) unlisted_repo "$store" ;;
    *) echo "prs: $store not refreshed ($(lastline "$out")); its next poll reads the merge" >&2 ;;
  esac
fi
chain_event land merged "$(jq -r .project <<<"$it")" "$(jq -r '.title // ((.task // "") | split("\n")[0])' <<<"$it")" \
  --item "$item" --id "$(jq -r '(.row // "") | sub("^[^:]*:"; "")' <<<"$it")" --pr "$pr_ref" --sha "$merged"
deploy_steps

case "$done_as" in
'')
  # The validate session that landed it (validate_gate) is in landed_by, never in the author's sessions.
  if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && [[ "${AGENT_QUEUE_ITEM:-}" != "validate-$item-"* ]] && ! { [ "$partial" -eq 1 ] && other_session; }; then
    aq_retry claim "$item" >/dev/null 2>&1 || echo "item: could not record this session on $item (agent-queue claim)" >&2
  fi
  # Re-read so earlier partial landings survive, including a re-run of this PR.
  # closing_pr owns a failed board step even when it is the second PR in the list.
  it=$(aq_retry show "$item" --json 2>&1) || fail item "agent-queue show: $(lastline "$it")"
  [ -z "$sup_ref" ] || it=$(drop_sup <<<"$it")
  read -ra refs <<<"$(jq -r '.pr // ""' <<<"$it")"
  read -ra oids <<<"$(jq -r '.merged // ""' <<<"$it")"
  found=0
  for i in "${!refs[@]}"; do
    if [ "${refs[i]}" = "$pr_ref" ] || [ "${refs[i]}" = "$pr" ]; then
      refs[i]=$pr_ref oids[i]=$merged found=1
    else
      [ -n "${oids[i]:-}" ] || oids[i]=${prior_oid[${refs[i]}]:-}
      [ -n "${oids[i]}" ] || [ "$partial" -eq 1 ] || fail item "no merge recorded for ${refs[i]}; land it before finishing $item"
    fi
  done
  if [ "$found" -eq 0 ]; then refs+=("$pr_ref"); oids+=("$merged"); fi
  # A ref still open (settle_prior lets a --partial landing pass one) has no merge to list,
  # and the lists stay in step, so merged: waits empty: the final landing takes each from gh.
  open=()
  for i in "${!refs[@]}"; do [ -n "${oids[i]:-}" ] || open+=("${refs[i]}"); done
  [ "${#open[@]}" -eq 0 ] || { oids=(); open_ref="; merged: waits for ${open[*]}, still open"; }
  marker=''
  [ "$partial" -eq 0 ] || marker=yes
  closing=()
  [ "$partial" -eq 1 ] || closing=("closing_pr=$pr_ref")
  # A full landing ends the item's open PR; a partial one leaves the item's other PRs open (stack_pr reads it).
  clear_open=open_pr=; [ -z "$marker" ] || clear_open=
  landed_by
  out=$(aq_retry set "$item" "pr=${refs[*]}" "merged=${oids[*]}" "partial=$marker" $clear_open "${closing[@]}" "${lb[@]}" 2>&1) || fail item "$(lastline "$out")"
  credited="$(credit)${open_ref:-}"
  if [ "$partial" -eq 0 ]; then
    watch_gate "$it"
    out=$(aq_retry move "$item" "done" --status ok 2>&1) || fail item "$(lastline "$out")"
  fi
  ;;
more)
  # Its first PR credited the item and closed its row; this one joins the lists, in step. Read
  # again here, not at the start, so a PR another run added during the checks is kept.
  if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && ! out=$(aq_retry claim "$item" 2>&1); then
    echo "item: could not record this session on $item: $(lastline "$out")" >&2
  fi
  it=$(aq_retry show "$item" --json 2>&1) || fail item "agent-queue show: $(lastline "$it")"
  landed_by
  out=$(aq_retry set "$item" "pr=$(jq -r .pr <<<"$it") $pr_ref" "merged=$(jq -r '.merged // ""' <<<"$it") $merged" "${lb[@]}" 2>&1) ||
    fail item "$(lastline "$out")"
  credited=", beside $(jq -r .pr <<<"$it")"
  ;;
esac
if [ "$partial" -eq 1 ]; then
  echo "item: $item partial with pr:$pr_ref${credited:-}, left open for the final landing"
else
  echo "item: $item done with pr:$pr_ref${credited:-}"
fi

mapfile -t b < <(board_cmd)
if [ "$partial" -eq 1 ]; then
  echo "board: left open until the final landing"
elif [ "$done_as" = more ] || [ "$done_as" = again ]; then
  [ "${#b[@]}" -eq 0 ] || echo "board: left to its closing PR, $(jq -r '.closing_pr // (.pr | split(" ")[0])' <<<"$it") (agent-land on that one closes the row if its board step failed)"
elif [ "${#b[@]}" -gt 0 ]; then
  # The PR is merged and the item done, so a row this cannot check is a line with the command, as in
  # close_rows, and the plan steps below still run.
  if ! read_open; then
    echo "board: agent-queue list failed, so \"${b[-3]}\" is not known free of another open item; close by hand: notes ${b[*]}"
  elif other=$(row_worker "$(jq -r .row <<<"$it")") && [ -n "$other" ]; then
    echo "board: left \"${b[-3]}\" open, $other still works it (its landing closes it; if it is dropped: notes ${b[*]})"
  else
    locate_row
    [ -z "$row_moved" ] || mapfile -t b < <(board_cmd)
    if out=$(notes "${b[@]}" 2>&1); then
      echo "board: closed \"${b[-3]}\" with ${b[-1]}${row_moved:+, on $row_board, $row_lane lane (recorded on $row_moved)}"
      # The item follows its row, so each later reader of its row finds it. The row is closed by now, so a
      # record that fails is a line with the command, never a failed landing.
      if [ -n "$row_moved" ]; then
        if out=$(aq_retry set "$item" "row=$row_board:$row_key" "lane=$row_lane" "profile=$row_prof" 2>&1); then
          echo "item: $item row: $row_board:$row_key"
        else
          echo "item: $item row not re-pointed ($(lastline "$out")): agent-queue set $item row=$row_board:$row_key lane=$row_lane profile=$row_prof"
        fi
      fi
    elif [[ "$out" == *"no open task matches "* ]] && row_closed "$row_board" "${b[-3]}"; then
      echo "board: \"${b[-3]}\" was already closed, left as is"
    else
      fail board "$(lastline "$out")"
    fi
  fi
fi

if [ -n "$plan" ]; then
  taken=$(phase_takes "$(phase_line "$plan" "$phase")")
  tmp=$(mktemp)
  tick() {
    P="- [ ] $phase" PR="$pr" awk '
      index($0, ENVIRON["P"]) == 1 { sub(/^- \[ \]/, "- [x]"); $0 = $0 " (#" ENVIRON["PR"] ")" }
      { print }' "$1" >"$tmp" && cat "$tmp" >"$1"
  }
  tick "$plan" || fail plan "awk could not rewrite $plan"
  # The stub's own line is a courtesy beside the canonical tick: the PR is merged, so it never fails the landing.
  [ -z "$stub" ] || tick "$stub" || echo "plan: could not tick the stub $stub"
  rm -f "$tmp"
  echo "plan: ticked \"$phase\""
  close_plan_rows
  # shellcheck disable=SC2086  # one id a word
  [ -z "$taken" ] || close_rows $taken
fi

echo "landed #$pr"
