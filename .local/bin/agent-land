#!/usr/bin/env bash
# agent-land - land a gated PR and record it in one call, so a green gate costs no model call.
#
#   agent-land <pr> [--repo <owner>/<repo>] [--item <slug>] [--plan <file> --phase "<text>"] [--partial] [--merge-commit] [--admin] [--dry-run]
#
# Which repo <pr> is in: --repo, else the repo of the item's own pr:<owner>/<repo>#<pr>, else gh's
# default for this checkout. Either way the PR must be in this checkout's origin repo (git, the merge
# proof and autopull all read it), and a MERGED PR, which skips the head step, must be the item's:
# its body has "Item: <slug>", its head commit is in this checkout's HEAD, or the item records it.
# Why: a bare number run from a worktree of the public repo recorded an unrelated public #595 for a
# private-repo PR (2026-11-07).
#
# Steps, stopping at the first failure: head (HEAD must be the PR's head commit, before the body is
# touched; else the merge would be refused as "Head branch was modified": run from the PR's own
# checkout; a HEAD that is origin's tip of the PR branch is a fresh push, waited on until the PR reads it), fetch (a head behind origin/<base> is merged up to it and pushed, before the checks and again after them if the base moved on during them; a head pushed after them waits on its own checks before it merges, and on a base without strict checks a second move lands that green head behind it, catch_up), item-line
# (before the checks, the PR body gets the line "Item: <slug>" unless it has it, so a reader holding
# only the PR finds its work item; a stale "Item:" line is rewritten), review (a tier-3 item's body has a
# "Review:" line, review_gate), checks (the PR's checks pass: CI, a required check; a tier-3 item needs checks that ran), merge (--squash, or with --merge-commit a merge commit,
# for a landing train whose member PRs read MERGED only while their heads stay reachable; --admin adds gh's --admin, which skips a required approving review on a repo whose owner allows it, never the checks step above; --match-head-commit HEAD, then gh pr view must say MERGED), proof (the PR's merge commit is
# on origin/<base>, by agent-merge-proof.sh), live (dotfiles-autopull --now fast-forwards the stowed
# checkout when this repo is ~/.dotfiles or ~/.dotfiles-private, links what it added, rebuilds the
# Rust tools, restarts agent-web on a new binary and a persistent agentctl runner on a new script; a line, never a failure), item (the queue item gets pr:<owner>/<repo>#<pr>,
# merged:<sha>, this Claude session in its sessions, the project credited by the PR's changed
# files (agent-queue attribute), and moves to done, status ok unless --partial keeps it open; a done ok item with no PR in this
# PR's repo adds it to its pr: and merged: lists instead, one PR per repo; an open item's earlier PR with
# no merge recorded takes its merge commit from gh, and one not merged refuses before the merge, settle_prior), board (the
# item's row, whatever its origin: the story `agent-queue add` filed or the board row it was
# promoted from, done with proof "pr:<owner>/<repo>#<pr> commit:<sha>" on the final landing), plan (--plan: the one "- [ ] <phase>"
# line becomes "- [x] <phase> (#<pr>)"; when that leaves no open phase, each row on the plan's `rows:` line
# closes with the same proof). After the merge, one "body:" line scores the PR body
# against comms-standard (comms-lint --channel pr-body); it never fails the landing. One line per step.
# The item is --item, else $AGENT_QUEUE_ITEM (set in a session fleet-dispatch started), else the
# one this session added or claimed (`agent-queue mine`). No item, no landing: every merged PR
# is a unit of work on the work ledger, so add one first (`agent-queue add --running`). An item
# taken from the session, not named by --item, takes only a PR in its project's repo (own_project).
# Exit 0 landed, 1 a step failed, 2 usage, 3 a catch-up merge of origin/<base> that conflicts
# (before or after the checks): resolve it and re-run. A head pushed after the checks waits on its own
# checks before it merges; the local gate script runs again on a merge of <base> only when the repo's CI
# doc says it needs one.
# An already MERGED PR skips checks, fetch and merge, so a re-run finishes a failed record step.
# --partial records a merged PR with partial: yes and leaves the item and row open, for a final
# agent-land without --partial, which clears the marker and closes the item. If the session ends first,
# reap requeues the item and the next run makes that final landing.
# A PR on Forgejo (a checkout that commits the mirror marker, forge_canonical, or whose origin is on a
# host SO_FORGEJO_HOSTS lists: home-config, bnb-game-servers) runs the same steps through that host's
# API instead of gh (pr_view, pr_edit_body, fj_wait_checks, pr_merge pinned by head_commit_id,
# pr_files) and its git steps through that remote, so this is its one writer too. Why: 12 Forgejo
# merges on 2026-11-07..09 went through a raw API call and were recorded on no item (ar-1213).
# --dry-run prints the commands and runs none. No reap: `wt done` from inside the worktree
# ends the caller's own tmux session, so wind-down releases the worktree.

set -euo pipefail

usage() {
  sed -n '2,/^$/{s/^# \{0,1\}//;p}' "$0" >&2
  exit 2
}
# shellcheck source=../lib/chain-event.sh
. "${CHAIN_EVENT_LIB:-$(dirname "$(readlink -f "$0")")/../lib/chain-event.sh}"
# shellcheck source=../lib/plan-phases.sh
. "$(dirname "$(readlink -f "$0")")/../lib/plan-phases.sh"
die() {
  printf 'agent-land: %s\n' "$1" >&2
  exit 2
}
# land_failed STEP CAUSE: a landing that stopped goes on the record, where the pipeline line's done
# node reads it. A dry run lands nothing, and a wrong checkout or an unfinished PR body never began
# to land, like a refusal (die). Once merged only the bookkeeping failed, and the cause says so.
land_failed() {
  [ "${dry:-0}" = 1 ] && return 0
  case "$1" in repo | match | head | review) return 0 ;; esac
  chain_event land land-failed "${project:-}" "${pr_ref:-#${pr:-}}" --item "${item:-}" --pr "${pr_ref:-}" --why "${merged:+merged, but }$1: $2"
}
fail() {
  printf 'agent-land: %s failed: %s\n' "$1" "$2" >&2
  land_failed "$1" "$2"
  exit 1
}
lastline() { printf '%s' "$1" | tail -n 1; }

# Until a CI job starts, a PR reports no checks, and GitHub has no event for the first one: that
# one state is polled CHECKS_POLL seconds apart. While an Actions run for HEAD is still queued it
# waits on, CHECKS_QUEUED_POLL apart: a queue on a busy runner pool lasts tens of minutes, and at
# 10s each landing spent 360 REST calls an hour of the one budget every account shares (ar-1345).
# With none, it gives up after CHECKS_TRIES polls and lands on the local gate (a repo with no PR
# checks), unless the base requires a check, which GitHub would refuse the merge for: that stops
# at checks. `gh pr checks --watch` waits out the rest, one read per CHECKS_WATCH_INTERVAL.
CHECKS_POLL="${AGENT_LAND_CHECKS_POLL:-10}"
CHECKS_QUEUED_POLL="${AGENT_LAND_CHECKS_QUEUED_POLL:-60}"
CHECKS_WATCH_INTERVAL=30 # gh's default is 10s; a check takes minutes
CHECKS_TRIES="${AGENT_LAND_CHECKS_TRIES:-12}"
# A watch that loses its connection to the API (a reset, a timeout, a 5xx) has seen no check fail:
# it starts again, up to CHECKS_NET_TRIES times. It hit binks #1531 three times on 2026-11-13.
CHECKS_NET_TRIES=5
had_checks=''
wait_checks() {
  [ -z "$fj" ] || { fj_wait_checks; return; }
  local try out failed queued net=0
  for ((try = 1; ; try++)); do
    out=$(gh pr checks "$pr" "${R[@]}" --watch --fail-fast -i "$CHECKS_WATCH_INTERVAL" 2>&1) && {
      echo "checks: green"
      had_checks=yes
      return 0
    }
    case "$out" in
    *'no checks reported'*) ;;
    *'connection reset by peer'* | *'i/o timeout'* | *'TLS handshake timeout'* | *'unexpected EOF'* | *'HTTP 502'* | *'HTTP 503'* | *'HTTP 504'*)
      ((++net <= CHECKS_NET_TRIES)) || fail checks "lost the connection to the API $CHECKS_NET_TRIES times: $(lastline "$out")"
      echo "checks: lost the connection to the API ($net of $CHECKS_NET_TRIES), watching again"
      try=0
      sleep "$CHECKS_POLL"
      continue
      ;;
    *)
      failed=$(gh pr checks "$pr" "${R[@]}" --json name,bucket -q '[.[] | select(.bucket == "fail" or .bucket == "cancel") | .name] | join(", ")' 2>/dev/null || true)
      fail checks "${failed:-$(lastline "$out")}"
      ;;
    esac
    queued=$(gh run list "${R[@]}" --commit "$(git rev-parse HEAD)" --json status -q '[.[] | select(.status != "completed")] | length' 2>/dev/null || echo 0)
    if [ "${queued:-0}" -ne 0 ]; then
      try=0
      sleep "$CHECKS_QUEUED_POLL"
      continue
    fi
    [ "$try" -lt "$CHECKS_TRIES" ] || { no_checks; return 0; }
    sleep "$CHECKS_POLL"
  done
}
# no_checks: none reported after CHECKS_TRIES polls, on either forge. Lands on the local gate
# unless one of these refuses.
no_checks() {
  [ "$tier" != 3 ] || fail checks "none reported, and a tier-3 item lands only on checks that ran green"
  # A head pushed by catch_up gets the runs the gate's head had; none yet means they have not
  # started, and landing it would merge a tree no check has seen (dotfiles #1504).
  [ -z "$had_checks" ] || fail checks "none reported on the pushed head $(git rev-parse --short HEAD), though the gate's head ran green: re-run once its checks start"
  # A Checks run that ends with no job reports no check and has nothing left to wait on (#2141,
  # 2026-11-09), and GitHub refuses the merge while a required check is missing on the head.
  local runs="gh run list --commit $(git rev-parse HEAD) shows whether a run exists (none yet: re-run once it does; one that ended with no job never started: gh run rerun it)"
  [ -z "$fj" ] || runs="the repo's Actions page shows whether a run exists for $(git rev-parse --short HEAD)"
  ! required_checks || fail checks "none reported on the head, and $remote/$base requires checks, so $forge would refuse the merge: $runs, then re-run"
  echo "checks: none reported"
}
# fj_wait_checks: Forgejo has no watch, and no event a script can await, so the head's combined
# commit status is read once per CHECKS_WATCH_INTERVAL while a status is pending, and CHECKS_POLL
# apart while none is reported yet, through so_forgejo_checks and pr-ci.sh's ci (warning passes).
fj_wait_checks() {
  local try st head
  head=$(git rev-parse HEAD)
  for ((try = 1; ; try++)); do
    st=$(so_forgejo_checks "$fj" "$head" 2>&1) || fail checks "Forgejo status read: $(lastline "$st")"
    case "$(jq -r "$CI_JQ"' {statusCheckRollup: .} | ci' <<<"$st")" in
    PASS)
      echo "checks: green"
      had_checks=yes
      return 0
      ;;
    FAIL) fail checks "$(jq -r 'map(select(.state == "FAILURE" or .state == "ERROR") | .context) | join(", ")' <<<"$st")" ;;
    PENDING)
      try=0
      sleep "$CHECKS_WATCH_INTERVAL"
      ;;
    *)
      [ "$try" -lt "$CHECKS_TRIES" ] || { no_checks; return 0; }
      sleep "$CHECKS_POLL"
      ;;
    esac
  done
}

# own_head: the merge pins HEAD (--match-head-commit), so a cwd that is not on the PR's head would
# reach the merge and be refused as "Head branch was modified", which reads as a race. Say where the
# PR's branch is checked out instead. A fork's branch name proves nothing about a local checkout.
own_head() {
  local here wt top
  here=$(git rev-parse HEAD 2>&1) || fail head "git rev-parse: $(lastline "$here")"
  [ "$here" != "$head_oid" ] || return 0
  if [ "$cross" = true ]; then
    fail head "HEAD ${here:0:8} is not the PR's head ${head_oid:0:8}, and that head is on a fork: gh pr checkout $pr in a checkout of this repo, then re-run"
  fi
  # A fresh push: the PR reads its new head a moment after the push lands, so headRefOid can still
  # be the old one (#590, #1401 failed here and a plain re-run passed). When origin's branch tip is
  # HEAD, the push landed: poll until the PR reads it, since the checks and the merge read the PR's
  # head, not origin's. No event says when; the bound is the checks one.
  # A failed ls-remote leaves tip empty and the diagnostics below run, as before this wait existed.
  local tip seen out try
  tip=$(git ls-remote "$remote" "refs/heads/$head_ref" 2>/dev/null | awk -v r="refs/heads/$head_ref" '$2 == r { print $1 }') || tip=''
  if [ -n "$tip" ] && [ "$tip" = "$here" ]; then
    for ((try = 1; ; try++)); do
      if out=$(pr_view headRefOid .headRefOid 2>&1); then
        if [ "$out" = "$here" ]; then
          head_oid=$here
          echo "head: the PR read the pushed head ${here:0:8} after $try polls"
          return 0
        fi
        seen=${out:0:8}
      else
        seen="nothing ($api: $(lastline "$out"))"
      fi
      [ "$try" -lt "$CHECKS_TRIES" ] || break
      sleep "$CHECKS_POLL"
    done
    fail head "HEAD ${here:0:8} is $remote's $head_ref, but the PR still reads $seen after $try polls: re-run once $forge catches up"
  fi
  wt=$(git worktree list --porcelain 2>/dev/null | awk -v b="branch refs/heads/$head_ref" '/^worktree /{p = substr($0, 10)} $0 == b { print p; exit }')
  top=$(git rev-parse --show-toplevel 2>/dev/null || true)
  if [ -n "$wt" ] && [ "$wt" = "$top" ]; then
    fail head "HEAD ${here:0:8} is not the PR's head ${head_oid:0:8} though this checkout has $head_ref: push your commits, or pull the branch, then re-run"
  elif [ -n "$wt" ]; then
    fail head "HEAD ${here:0:8} is not the PR's head ${head_oid:0:8}: run from the PR's checkout: $wt"
  fi
  fail head "HEAD ${here:0:8} is not the PR's head ${head_oid:0:8}, and no checkout of $head_ref is listed: git switch $head_ref (pushed and current) in a checkout of this repo, then re-run"
}

# checks_policy reads, once, what <base> asks of a head's checks. strict: it refuses a head whose
# required checks have not run on it (a ruleset's required_status_checks rule with
# strict_required_status_checks_policy, or branch protection's required_status_checks.strict); any
# answer but a 404 from the protection call counts as strict, the side that waits instead of being
# refused. required: it names at least one check a head must pass, so a head with none reported
# cannot merge; only an answer that says so counts (an unreadable one is no), since a wrong yes would
# block every landing there.
strict='' required=''
checks_policy() {
  [ -z "$strict" ] || return 0
  local repo="${pr_ref%#*}" out
  strict=yes required=no
  [ "$repo" != "$pr_ref" ] || return 0
  # Forgejo: the protection rule named <base>. enable_status_check refuses a head without passing
  # statuses (required), block_on_outdated_branch a head that is behind (strict); none: neither.
  if [ -n "$fj" ]; then
    out=$(so_forgejo_get "$fj" branch_protections 2>/dev/null) || return 0
    ! jq -e --arg b "$base" 'any(.[]; .rule_name == $b and .enable_status_check)' <<<"$out" >/dev/null 2>&1 || required=yes
    jq -e --arg b "$base" 'any(.[]; .rule_name == $b and .block_on_outdated_branch)' <<<"$out" >/dev/null 2>&1 || strict=no
    return 0
  fi
  out=$(gh api "repos/$repo/rules/branches/$base" 2>/dev/null) || return 0
  ! jq -e 'any(.[]; .type == "required_status_checks" and (.parameters.required_status_checks // [] | length) > 0)' <<<"$out" >/dev/null 2>&1 || required=yes
  jq -e 'all(.[]; .type != "required_status_checks" or .parameters.strict_required_status_checks_policy != true)' <<<"$out" >/dev/null 2>&1 || return 0
  if out=$(gh api "repos/$repo/branches/$base/protection" 2>&1); then
    ! jq -e '(.required_status_checks.contexts // []) + (.required_status_checks.checks // []) | length > 0' <<<"$out" >/dev/null 2>&1 || required=yes
    jq -e '.required_status_checks.strict == true' <<<"$out" >/dev/null 2>&1 || strict=no
  else
    case "$out" in *'(HTTP 404)'*) strict=no ;; esac
  fi
}
strict_checks() { checks_policy && [ "$strict" = yes ]; }
required_checks() { checks_policy && [ "$required" = yes ]; }

# catch_up: a base the head is behind is merged in and pushed, before the gate and again after it if
# the base moved on during the checks. A merge of <base> does not keep the checks green: a pushed head
# is a new tree, and merging one before its checks ran shipped a broken one (dotfiles #1504; #1731
# merged a merge-up head whose checks ran only after the merge). So it returns 0 when the head is
# current, and 1 after a push: the caller waits on the PR checks for that head, then calls it again.
# After the gate (catch_up after <waits so far>), a base with no strict required checks (strict_checks)
# is merged up and re-checked CATCHUP_WAITS times; if it moved on again during those waits, the green
# head lands behind it, which such a base allows, unless merging the base would conflict (then the
# merge below runs and exits 3, since GitHub would refuse that head anyway): a base that merges faster than its checks run would otherwise loop it forever
# (dotfiles #1059 went green 9 times in an hour), and exiting 3 sent the caller round its own gate,
# which a busy base outruns every time (#916). A strict base has no bound, since it refuses a head
# that is behind (2026-11-05: unity-core-playground #1837 was refused twice). A conflict is aborted
# and exits 3.
CATCHUP_WAITS=1
catch_up() {
  local out behind
  out=$(git fetch -q "$remote" 2>&1) || fail fetch "$(lastline "$out")"
  behind=$(git rev-list --count "HEAD..$remote/$base" 2>&1) || fail fetch "$(lastline "$behind")"
  if [ "$behind" -eq 0 ]; then
    [ "${1:-}" = before ] || echo "fetch: current with $remote/$base"
    return 0
  fi
  if [ "${1:-}" = after ] && [ "${2:-0}" -ge "$CATCHUP_WAITS" ] && ! strict_checks &&
    git merge-tree --write-tree --quiet HEAD "$remote/$base" >/dev/null 2>&1; then
    echo "fetch: $remote/$base moved on by $behind during the checks on the merged-up head; landing that green head behind it (no strict checks on $base)"
    return 0
  fi
  # Before the merge, so a refusal leaves the checkout as it was. A fork head is not origin's branch.
  [ "$cross" != true ] || fail push "the PR head is on a fork: git push HEAD to that fork's $head_ref, then re-run"
  if ! out=$(git merge -q --no-edit "$remote/$base" 2>&1); then
    git merge --abort >/dev/null 2>&1 || true
    printf 'agent-land: behind %s/%s by %s and merging it conflicts: resolve the merge and re-run\n' "$remote" "$base" "$behind" >&2
    land_failed conflict "behind $remote/$base by $behind and merging it conflicts"
    exit 3
  fi
  # Push HEAD to the PR's own head branch: a bare `git push` under push.default=simple refuses when
  # the local branch name differs from its upstream (agent-11 -> feat/x, PR #1252), and the upstream
  # itself can be the base (a worktree cut from origin/main tracks it).
  out=$(git push -q "$remote" "HEAD:refs/heads/$head_ref" 2>&1) || fail push "$(lastline "$out")"
  echo "fetch: merged $remote/$base ($behind behind) into the head and pushed it"
  # GitHub works out whether a pushed head merges after the push and refuses the merge until then
  # ("not mergeable"). No event says when, so the PR is polled at the checks cadence until it
  # reads this head with a known answer; the merge step reports what it ends up refusing.
  local head try
  head=$(git rev-parse HEAD)
  for ((try = 1; try <= CHECKS_TRIES; try++)); do
    case "$(pr_view headRefOid,mergeable '.headRefOid + " " + .mergeable' 2>/dev/null)" in
    "$head UNKNOWN" | "") ;;
    "$head "*) break ;;
    esac
    sleep "$CHECKS_POLL"
  done
  [ "${1:-}" = before ] || echo "checks: waiting on them for the pushed head"
  return 1
}

pr='' repo='' repo_from='' merged='' plan='' phase='' item="${AGENT_QUEUE_ITEM:-}" dry=0 partial=0 method=--squash admin=()
implied=${item:+'$AGENT_QUEUE_ITEM'}
while [ $# -gt 0 ]; do
  case "$1" in
  --project | --title) die "$1 is gone: the queue item is the record; agent-queue add --running --project <p> \"<task>\", then --item <slug>" ;;
  --plan) plan="${2:?--plan needs a value}" && shift ;;
  --phase) phase="${2:?--phase needs a value}" && shift ;;
  --item) item="${2:?--item needs a value}" implied='' && shift ;;
  --repo) repo="${2:?--repo needs a value}" repo_from=--repo && shift ;;
  --partial) partial=1 ;;
  --merge-commit) method=--merge ;;
  --admin) admin=(--admin) ;;
  --dry-run) dry=1 ;;
  -h | --help) usage ;;
  -*) die "unknown flag: $1" ;;
  *) [ -z "$pr" ] || die "one PR only"; pr="$1" ;;
  esac
  shift
done
[[ "$pr" =~ ^[0-9]+$ ]] || die "a PR number is required (try --help)"
[ -z "$repo" ] || [[ "$repo" =~ ^[^/[:space:]]+/[^/#[:space:]]+$ ]] || die "--repo takes <owner>/<repo>, not $repo"
[ "$partial" -eq 0 ] || [ -z "$plan$phase" ] || die "--partial cannot finish a plan phase; pass --plan and --phase on the final landing"
row=''
if [ -z "$item" ]; then
  mine=0
  item=$(agent-queue mine 2>/dev/null) || mine=$?
  [ "$mine" -ne 2 ] || die "more than one queue item records this session: pass --item <slug> (agent-queue mine)"
  implied='agent-queue mine'
fi
[ -n "$item" ] || die "no queue item for this session: agent-queue add --running --project <p> \"<type(area): title>\" (or claim one), then re-run"
# Checked before the merge, like the plan phase: a wrong slug cannot leave a merged PR unrecorded.
it=$(agent-queue show "$item" --json 2>/dev/null) || die "no queue item $item (agent-queue show)"
# A done ok item takes more PRs: its `pr:` holds one <owner>/<repo>#<N> per repo, space separated,
# and `merged:` their merge commits in the same order, so a task split across repos lands each on
# its one item. Which repo this PR is in needs gh, so once_done checks it after the PR is read.
case "$(jq -r 'if .state == "done" and .status == "ok" and (.pr // "") != "" then "done-ok" else .state end' <<<"$it")" in
running | waiting | review | queued | done-ok) ;;
*) die "queue item $item is $(jq -r '.state + " " + (.status // "")' <<<"$it"), not open" ;;
esac
# With no --repo, the item's own pr:<owner>/<repo>#<pr> names the repo: the bare number alone would
# be read against this checkout's repo, whatever repo the item's PR is in.
if [ -z "$repo" ]; then
  mapfile -t hits < <(jq -r --arg n "$pr" '(.pr // "") | split(" ")[] | select(test("^[^/]+/[^/#]+#" + $n + "$")) | sub("#[0-9]+$"; "")' <<<"$it" | sort -fu)
  case ${#hits[@]} in
  0) ;;
  1) repo=${hits[0]} repo_from="the item's pr:" ;;
  *) die "queue item $item records #$pr in ${hits[*]}: pass --repo <owner>/<repo>" ;;
  esac
fi
R=()
[ -z "$repo" ] || R=(-R "$repo")

# The forge the PR is on: gh's, or Forgejo's API through so_forgejo_* (session-outcomes.sh, which
# also brings origin-repo.sh). fj is its host/owner/repo and remote the git remote that carries it;
# on GitHub fj is empty and remote is origin. A Forgejo-canonical checkout with no remote on a
# listed host stops here: gh would land on its GitHub mirror, which the next mirror push erases.
# shellcheck source=../lib/session-outcomes.sh
. "$(dirname "$(readlink -f "$0")")/../lib/session-outcomes.sh"
# shellcheck source=../lib/pr-ci.sh
. "$(dirname "$(readlink -f "$0")")/../lib/pr-ci.sh"
fj='' remote=origin api=gh forge=GitHub
fj_detect() {
  local r rc=0
  r=$(so_forge_remote .) || rc=$?
  case $rc in
    0) ;;
    1) return 0 ;;
    2) die "$(git rev-parse --show-toplevel 2>/dev/null) is Forgejo-canonical, but none of its remotes is on a host SO_FORGEJO_HOSTS lists ($(so_forgejo_hosts)): add the Forgejo remote, or list its host in session-outcomes.conf" ;;
    *) die "picking the forge failed (so_forge_remote rc $rc)" ;;
  esac
  remote=${r%% *} fj=${r#* } api=Forgejo forge=Forgejo
}
fj_detect
fj_repo=${fj#*/}
[ -z "$fj" ] || [ -z "$repo" ] || [ "${repo,,}" = "${fj_repo,,}" ] ||
  die "#$pr is in $repo ($repo_from), but this checkout's Forgejo repo is $fj_repo: run from a checkout of $repo"
# The token is read once, in this shell, so every $(...) below inherits it. A dry run calls nothing.
[ -z "$fj" ] || [ "$dry" -eq 1 ] || so_forgejo_auth "$fj" || die "$SO_FORGEJO_ERR"
# fj_send METHOD PATH JSON: one authed write to the PR's Forgejo repo. A refusal ends stderr with
# Forgejo's reason (a protected branch, a 409 stale head), which fail prints as its last line.
fj_send() {
  local out
  out=$(so_forgejo_get "$fj" "$2" -X "$1" -H 'Content-Type: application/json' --data-binary "$3") && return 0
  printf 'Forgejo: %s\n' "$(jq -r '.message // empty' <<<"$out" 2>/dev/null || printf '%s' "$out")" >&2
  return 1
}
# pr_view FIELDS JQ: `gh pr view --json FIELDS -q JQ`; on Forgejo the API's PR in gh's field names,
# so one query reads both. Forgejo's mergeable reads false while it is still checking a pushed head,
# so false is UNKNOWN: catch_up polls it out, and the merge step names a real conflict.
pr_view() {
  [ -n "$fj" ] || { gh pr view "$pr" "${R[@]}" --json "$1" -q "$2"; return; }
  local raw
  raw=$(so_forgejo_get "$fj" "pulls/$pr") || return 1
  jq -r '{state: (if .merged then "MERGED" elif .state == "open" then "OPEN" else "CLOSED" end),
          baseRefName: .base.ref, url: .html_url, headRefOid: .head.sha, headRefName: .head.ref,
          isCrossRepository: (.head.repo.full_name != .base.repo.full_name), body: (.body // ""),
          mergeable: (if .mergeable then "MERGEABLE" else "UNKNOWN" end),
          mergeCommit: {oid: (.merge_commit_sha // "")}} | '"$2" <<<"$raw"
}
# pr_edit_body: stdin becomes the PR body.
pr_edit_body() {
  [ -n "$fj" ] || { gh pr edit "$pr" "${R[@]}" --body-file -; return; }
  fj_send PATCH "pulls/$pr" "$(jq -Rsc '{body: .}')"
}
# pr_merge HEAD: merge pinned to HEAD, the full sha (Forgejo answers 409 to a short one).
pr_merge() {
  [ -n "$fj" ] || { gh pr merge "$pr" "${R[@]}" "$method" ${admin[@]+"${admin[@]}"} --match-head-commit "$1"; return; }
  fj_send POST "pulls/$pr/merge" "$(jq -nc --arg do "${method#--}" --arg h "$1" '{Do: $do, head_commit_id: $h}')"
}
# pr_files: the PR's changed paths, one a line.
pr_files() {
  [ -n "$fj" ] || { gh api "repos/${pr_ref%#*}/pulls/$pr/files" --paginate --jq '.[].filename'; return; }
  local page=1 got
  while got=$(so_forgejo_get "$fj" "pulls/$pr/files?limit=$SO_FORGEJO_PAGE&page=$page"); do
    jq -r '.[].filename' <<<"$got"
    [ "$(jq length <<<"$got")" -ge "$SO_FORGEJO_PAGE" ] || return 0
    page=$((page + 1))
  done
  return 1
}
# once_done -> how a done item takes this PR: "rerun" when it owns row closure (the first PR
# on older items without closing_pr, a re-run after a failed board step), "again" when it is a later one, "more" when the item carries none in this
# repo yet. A second PR in one repo is refused: that is a second task, so it gets its own item.
once_done() {
  local refs ref i closing_pr
  read -ra refs <<<"$(jq -r '.pr // ""' <<<"$it")"
  # A bare ref (a PR whose URL did not parse, or an old item) matches on its number alone.
  for i in "${!refs[@]}"; do
    [ "${refs[i]}" = "$pr_ref" ] || { [[ "${refs[i]}" != */*#* || "$pr_ref" != */*#* ]] && [ "${refs[i]##*#}" = "$pr" ]; } ||
      continue
    closing_pr=$(jq -r '.closing_pr // ""' <<<"$it")
    if [ "$closing_pr" = "$pr_ref" ] || { [ -z "$closing_pr" ] && [ "$i" -eq 0 ]; }; then
      echo rerun
    else
      echo again
    fi
    return 0
  done
  [[ "$pr_ref" == */*#* ]] || die "queue item $item is done, and #$pr names no repo to add it under"
  for ref in "${refs[@]}"; do
    [[ "$ref" == */*#* ]] || die "queue item $item is done with a bare pr:$ref, which names no repo to tell #$pr apart from"
    [[ "$ref" != "${pr_ref%#*}#"* ]] ||
      die "queue item $item is done with $ref, and an item carries one PR per repo: give #$pr its own item (agent-queue add --running), then --item <that slug>"
  done
  echo more
}
# The notes argv that closes the item's row (`row`, "<project>:<key>", agent-queue's one
# definition), one word a line, as fleet-dispatch reads it; empty for an item with no row.
row=$(jq -r 'select((.row // "") != "") | (.row | split(":")) as $r
  | (if (.profile // "") != "" then ["--profile", .profile] else [] end) + ["ptask", $r[0]]
    + (if (.lane // "agent") == "agent" then ["--agent"] else [] end)
    + ["done", ($r[1:] | join(":")), "--proof"] | .[]' <<<"$it")
# score_body: the merged body's score against comms-standard (channel pr-body). A score, never a
# gate: the PR is already merged, and the line tells its author what to fix in the next one.
score_body() {
  local body out rc=0
  command -v comms-lint >/dev/null 2>&1 || { echo "body: not scored (no comms-lint on PATH)"; return 0; }
  body=$(pr_view body .body 2>&1) || { echo "body: not scored ($api pr view: $(lastline "$body"))"; return 0; }
  out=$(printf '%s\n' "$body" | comms-lint --channel pr-body - 2>&1) || rc=$?
  case "$rc" in
  0) echo "body: passes comms-lint --channel pr-body" ;;
  1) echo "body: $(lastline "$out") First: $(printf '%s\n' "$out" | sed -n '1s/^ *//p')" ;;
  *) echo "body: not scored ($(lastline "$out"))" ;;
  esac
}

# own_repo: git, the merge proof and autopull all read this checkout, so a PR in another repo is
# refused here, before anything is touched: from the wrong checkout its merge proof would test the
# wrong graph, or pass on an unrelated PR that shares the number.
own_repo() {
  local here want=${pr_ref%#*}
  if [ -n "$fj" ]; then here=$fj_repo; else here=$(origin_repo .) || here=""; fi
  [ -n "$here" ] || { echo "repo: not checked, this checkout has no origin"; return 0; }
  [[ "$pr_ref" == */*#* && "${here,,}" != "${want,,}" ]] || return 0
  fail repo "#$pr is $pr_ref (${repo_from:-the repo gh picks here}), but this checkout's $remote is $here: run from a checkout of ${pr_ref%#*}${repo_from:+, or pass --repo $here for $here#$pr}"
}

# shellcheck source=../../.config/shared-hooks/project-name.sh
. "${PROJECT_NAME_LIB:-$(dirname "$(readlink -f "$0")")/../../.config/shared-hooks/project-name.sh}"
PROJECT_MAP_FILE="${AGENT_QUEUE_PROJECT_MAP:-$(project_map_file)}"

# own_project: an item this run did not name is the session's own ($AGENT_QUEUE_ITEM, or agent-queue
# mine), and a session also lands side PRs in other repos. A PR outside the item project's repo
# (its tracker `repo`, else the project) is refused before anything is touched: it would close the
# item and its row with a PR that is not their work (2026-11-07: dotfiles-private#652, a
# store-console skill fix, closed shape-city-steam-console and row ucp-1207). --item claims it.
own_project() {
  [ -n "$implied" ] && [[ "$pr_ref" == */*#* ]] && [ -f "$PROJECT_MAP_FILE" ] || return 0
  local project want got name=${pr_ref%#*}
  name=${name#*/}
  project=$(jq -r '.project // ""' <<<"$it")
  [ -n "$project" ] || return 0
  want=$(project_repo_name "$project")
  got=$(project_of_repos_json "$name" | jq -r --arg n "$name" '.[$n] // ""')
  [ "${got,,}" != "${want,,}" ] || return 0
  die "#$pr is in ${pr_ref%#*} ($got), and $item, taken from $implied, is a $project item in $want: a PR outside the item's repo names its item. Pass --item $item if this PR is that item's work (with --partial while its own PR is still to land), or give it its own item (agent-queue add --running --project $got \"<type(area): title>\") and pass --item <that slug>"
}

# own_merged: a MERGED PR skips own_head, which is what ties an open PR to this checkout. So it must
# be the item's some other way: the item records it (a re-run, or a --pr-only item; a bare ref by its
# number, as once_done reads it), its body has "Item: <slug>" (one-shot writes it, and this script
# stamps it before any merge), or its head commit is in this checkout's HEAD. Not the branch name:
# recycled worktrees reuse agent-N names across tasks.
own_merged() {
  local ref refs
  read -ra refs <<<"$it_pr"
  for ref in "${refs[@]}"; do
    [ "$ref" != "$pr_ref" ] && { [[ "$ref" == */*#* ]] || [ "$ref" != "$pr" ]; } || return 0
  done
  body=$(pr_view body .body 2>&1) || fail item-line "$api pr view: $(lastline "$body")"
  ! tr -d '\r' <<<"$body" | grep -qxF "Item: $item" || return 0
  ! git merge-base --is-ancestor "$head_oid" HEAD 2>/dev/null || return 0
  fail match "#$pr ($pr_ref, from $head_ref) is merged, and nothing ties it to $item: its body has no \"Item: $item\" line, its head ${head_oid:0:8} is not in this checkout's HEAD, and the item records ${it_pr:-no PR}. A PR in another repo: run from a checkout of it, with --repo <owner>/<repo>"
}

# stamp_item: the PR body names its work item on one "Item: <slug>" line. A body that already has it
# is left alone; any other "Item:" line is replaced, else the line is appended. Before the checks,
# so a CI job that reads the body runs on the stamped one.
stamp_item() {
  local new out
  [ -n "$body" ] || body=$(pr_view body .body 2>&1) || fail item-line "$api pr view: $(lastline "$body")"
  if tr -d '\r' <<<"$body" | grep -qxF "Item: $item"; then
    echo "item-line: present"
    return 0
  fi
  if grep -q '^Item: ' <<<"$body"; then
    new=$(I="Item: $item" awk '/^Item: / { $0 = ENVIRON["I"] } { print }' <<<"$body")
  else
    new=$(printf '%s\n\nItem: %s' "$body" "$item")
  fi
  out=$(printf '%s\n' "$new" | pr_edit_body 2>&1) || fail item-line "$api pr edit: $(lastline "$out")"
  body=$new
  echo "item-line: added \"Item: $item\" to the body"
}

# review_gate: a tier-3 item (`fleet-dispatch item-tier`, the one beside this script: harness or tooling, promoted from a row or
# queued by hand) merges only behind the red-fix gate, fix-red step 5: a "Review: /code-review <level>,
# <what it found and what you did>" line in the body (n/a or empty is refused), and checks that ran
# (wait_checks refuses "none reported" for it). The line is a claim, not proof: CI and the post-merge
# hold check are the backstops.
# Checked on the item, not where it was queued, so `agent-queue add` cannot skip it. An unreadable
# tier counts as 3, the side that waits.
tier='' body=''
review_gate() {
  tier=$("$(dirname "$(readlink -f "$0")")/fleet-dispatch" item-tier "$item" 2>/dev/null) || tier=3
  [ "$tier" = 3 ] || return 0
  local line
  line=$(grep -m1 '^Review: ' <<<"$body" || true)
  [[ "$line" =~ ^Review:\ /code-review\ (low|medium|high|xhigh|max),\ *([^[:space:]].*)$ ]] &&
    ! [[ "${BASH_REMATCH[2],,}" =~ ^(n/?a|none|-|tbd|todo)[[:space:].]*$ ]] ||
    fail review "tier-3 item $item: no \"Review: /code-review <level>, <what it found and what you did>\" line in the PR body${line:+ (found: $line)}. Run /code-review high, fix or answer each finding, then add that line (~/.claude/skills/fix-red/SKILL.md step 5)"
  echo "review: present (tier 3)"
}

# credit -> ", <what agent-queue attribute recorded>" for the item line: the PR's changed files
# credit the item to the registry project whose `path` owns most of them (a game inside the
# playground). It never fails the landing: the PR is merged, and the item keeps the project it
# was added under, so the line says why it was not credited.
credit() {
  local files out
  [[ "$pr_ref" == */*#* ]] || { echo ", not credited (no repo on #$pr)"; return 0; }
  files=$(pr_files 2>&1) || { echo ", not credited ($api api: $(lastline "$files"))"; return 0; }
  out=$(printf '%s\n' "$files" | agent-queue attribute "$item" 2>&1) || { echo ", not credited ($(lastline "$out"))"; return 0; }
  [ -z "$out" ] || echo ", $out"
}

# board_cmd -> the notes argv that closes the item's row, one word a line; none for an item with no row.
# Its proof is the PR, by repo when the URL names one (pr:<owner>/<repo>#N, so the graph joins it
# with no project lookup), and, once proven, the merge commit: something checkable, not a claim.
board_cmd() { [ -z "$row" ] || printf '%s\n' "$row" "pr:${pr_ref:-$pr}${merged:+ commit:${merged:0:12}}"; }
# close_plan_rows: once --plan has no open phase left, each row on its `rows:` line (plan_rows) that
# is still open on a board closes with this PR as proof, as the item's own row does. The PR is
# merged by now, so a row it cannot close is a line with the command, never a failed landing.
close_plan_rows() {
  local ids feed id hit prof proj lane out flag
  [ "$partial" -eq 0 ] || return 0
  ids=$(plan_rows "$plan")
  [ -n "$ids" ] || return 0
  plan_phases "$plan" | awk -F'\t' '$1 != "-" && $1 == $2 { ok = 1 } END { exit !ok }' || return 0
  if grep -q '^- \[-\]' "$plan"; then echo "rows: left open, the plan deferred a phase: $(paste -sd' ' <<<"$ids")"; return 0; fi
  feed=$(notes board --json 2>/dev/null) || { echo "rows: notes board --json failed; close by hand: $(paste -sd' ' <<<"$ids")"; return 0; }
  while IFS= read -r id; do
    hit=$(jq -r --arg id "$id" '[.rows[]? | select(.id == $id)] | if length == 1 then .[0] | [.profile, .project, .lane] | @tsv else empty end' <<<"$feed" 2>/dev/null) ||
      { echo "rows: notes board --json was not JSON; close by hand: $(paste -sd' ' <<<"$ids")"; return 0; }
    if [ -z "$hit" ]; then echo "rows: $id is not one open row on any board, left as is"; continue; fi
    IFS=$'\t' read -r prof proj lane <<<"$hit"
    flag=(); [ "$lane" = agent ] && flag=(--agent)
    if out=$(notes --profile "$prof" ptask "$proj" "${flag[@]}" done "$id" --proof "pr:${pr_ref:-$pr}${merged:+ commit:${merged:0:12}}" 2>&1); then
      echo "rows: closed $id on $proj"
    else
      echo "rows: $id not closed ($(lastline "$out")): notes --profile $prof ptask $proj ${flag[*]:+${flag[*]} }done $id --proof pr:${pr_ref:-$pr}"
    fi
  done <<<"$ids"
}

if [ -n "$plan$phase" ]; then
  [ -n "$plan" ] && [ -n "$phase" ] || die "--plan and --phase go together"
  [ -f "$plan" ] || die "no plan file: $plan"
  # Checked before the merge, so a bad phase name cannot leave a merged PR half recorded.
  n=$(P="- [ ] $phase" awk 'index($0, ENVIRON["P"]) == 1 { n++ } END { print n + 0 }' "$plan")
  [ "$n" -eq 1 ] || die "plan: $n unchecked lines start with \"- [ ] $phase\", need exactly 1"
fi

if [ "$partial" -eq 1 ] && [ "$(jq -r .state <<<"$it")" = done ]; then
  die "--partial needs an open item; $item is already done"
fi

if [ "$dry" -eq 1 ]; then
  [ -z "$fj" ] || echo "forge: Forgejo $fj on remote $remote: each gh pr call below is that API (pulls/$pr, PATCH for the body, commits/<head>/status for the checks, POST pulls/$pr/merge {Do, head_commit_id}, pulls/$pr/files), and each git step reads $remote, not origin"
  echo "item-line: gh pr view $pr${repo:+ -R $repo} --json body, then gh pr edit $pr --body-file -  (unless it has \"Item: $item\")"
  echo "head: git rev-parse HEAD must equal the PR's headRefOid (when it is git ls-remote origin's tip of the PR branch, poll gh pr view $pr --json headRefOid until it does), else exit 1 naming the PR's checkout (git worktree list); the PR's repo must be origin's; a MERGED PR must name the item, have its head in HEAD, or be on the item; an item not named by --item takes only a PR in its project's repo"
  echo "review: fleet-dispatch item-tier $item  (tier 3: the body needs a \"Review: \" line and the checks must run)"
  echo "checks: gh pr checks $pr${repo:+ -R $repo} --watch --fail-fast -i $CHECKS_WATCH_INTERVAL  (must pass, or report none on a tier 1 or 2 item)"
  echo "fetch: git fetch origin && git rev-list --count HEAD..origin/<base of #$pr>  (0 before the checks; after them git merge origin/<base> && git push, then the checks again on that head)"
  echo "merge: gh pr merge $pr${repo:+ -R $repo} $method${admin[*]:+ ${admin[*]}} --match-head-commit \$(git rev-parse HEAD) && gh pr view $pr${repo:+ -R $repo} --json state  (must be MERGED)"
  echo "body: gh pr view $pr${repo:+ -R $repo} --json body | comms-lint --channel pr-body -  (a score, never a gate)"
  echo "proof: gh pr view $pr${repo:+ -R $repo} --json mergeCommit, then merge_proof: an ancestor of origin/<base>"
  echo "live: dotfiles-autopull --now .  (fast-forwards ~/.dotfiles or ~/.dotfiles-private when this is that repo, rebuilds the Rust tools, restarts agent-web on a new binary and a persistent agentctl runner on a new script; never fails the landing)"
  echo "prs: schedules-sync sync-prs <owner>/<repo>  (the PR store reads the merge now, not at its next poll; never fails the landing)"
  if [ "$partial" -eq 1 ]; then
    echo "item: agent-queue set $item partial=yes before merging; record pr=$pr merged=<sha> beside earlier PRs, leave the item open"
    echo "board: left open until the final landing"
  else
    echo "item: agent-queue set $item pr=$pr merged=<sha> partial= beside earlier PRs && gh api repos/<owner>/<repo>/pulls/$pr/files | agent-queue attribute $item && agent-queue move $item done --status ok"
  fi
  mapfile -t b < <(board_cmd)
  [ "$partial" -eq 1 ] || [ "${#b[@]}" -eq 0 ] || echo "board: notes ${b[*]}"
  [ -z "$plan" ] || echo "plan: tick \"- [ ] $phase\" -> \"- [x] ... (#$pr)\" in $plan"
  if [ -n "$plan" ] && [ "$partial" -eq 0 ] && [ -n "$(plan_rows "$plan")" ] &&
    plan_phases "$plan" | awk -F'\t' '$1 != "-" && $1 + 1 == $2 { ok = 1 } END { exit !ok }'; then
    echo "rows: close $(plan_rows "$plan" | tr '\n' ' ')with pr:$pr, the plan's last phase"
  fi
  exit 0
fi

info=$(pr_view state,baseRefName,url,headRefOid,isCrossRepository,headRefName '.state + " " + .baseRefName + " " + .url + " " + .headRefOid + " " + (.isCrossRepository | tostring) + " " + .headRefName' 2>&1) ||
  fail fetch "$api pr view $pr: $(lastline "$info")"
read -r state base url head_oid cross head_ref <<<"$info"
# The item's PR names its repo: a bare number is ambiguous across the repos one project spans.
pr_ref=$(sed -E 's#^https?://[^/]+/([^/]+/[^/]+)/pulls?/([0-9]+).*#\1\#\2#' <<<"$url")
[[ "$pr_ref" =~ ^[^/]+/[^/#]+#[0-9]+$ ]] || pr_ref="$pr"
done_as=''
it_pr=$(jq -r '.pr // ""' <<<"$it")
own_repo
own_project
if [ "$(jq -r .state <<<"$it")" = done ]; then
  done_as=$(once_done) || exit $?
elif [ -n "$it_pr" ]; then
  # Apply the same one-PR-per-repo rule while the item is still open.
  once_done >/dev/null || exit $?
fi
# settle_prior: pr: and merged: are lists in step, so each earlier PR an open item records needs its
# merge commit before this one joins them. One recorded with none (its pr= set while it was open, or
# merged outside agent-land) takes it from gh into prior_oid; one not merged refuses here, before
# the merge, never after it. Why: private #762 merged and was left off its item, whose public #1794
# had no merge recorded (2026-11-11).
declare -A prior_oid=()
settle_prior() {
  local refs oids i out
  read -ra refs <<<"$it_pr"
  read -ra oids <<<"$(jq -r '.merged // ""' <<<"$it")"
  # Space-split lists lose an empty slot, so a shorter merged: cannot say which PR lacks its merge.
  [ "${#oids[@]}" -eq 0 ] || [ "${#oids[@]}" -ge "${#refs[@]}" ] ||
    die "queue item $item records pr:${refs[*]} with merged:${oids[*]}, out of step: set both lists (agent-queue set $item pr=... merged=...), then re-run"
  for i in "${!refs[@]}"; do
    [ "${refs[i]}" != "$pr_ref" ] && [ "${refs[i]}" != "$pr" ] && [ -z "${oids[i]:-}" ] || continue
    [[ "${refs[i]}" == */*#* ]] || die "queue item $item records pr:${refs[i]} with no merge, and a bare number names no repo to look it up in"
    out=$(gh pr view "${refs[i]##*#}" -R "${refs[i]%#*}" --json state,mergeCommit -q '.mergeCommit.oid // .state' 2>&1) ||
      die "gh pr view ${refs[i]}: $(lastline "$out")"
    case "$out" in
    MERGED) die "queue item $item records ${refs[i]}, which gh reads MERGED with no merge commit: record it (agent-queue set $item merged=<sha>), then re-run" ;;
    CLOSED) die "queue item $item records ${refs[i]}, closed unmerged: drop it from the item's pr: (agent-queue set $item pr=...), then re-run" ;;
    esac
    [[ "$out" =~ ^[0-9a-f]{40}$ ]] ||
      die "queue item $item records ${refs[i]}, which is $out: land it first (agent-land ${refs[i]##*#} --repo ${refs[i]%#*} --item $item --partial), then #$pr"
    prior_oid[${refs[i]}]=$out
  done
}
[ -n "$done_as" ] || settle_prior
# Before stamp_item, so a refused run leaves the PR untouched.
if [ "$state" = MERGED ]; then own_merged; else own_head; fi
stamp_item
# Persist intent even on an already-merged re-run, before any later record step can fail.
if [ "$partial" -eq 1 ]; then
  out=$(agent-queue set "$item" partial=yes 2>&1) || fail item "$(lastline "$out")"
fi

if [ "$state" = MERGED ]; then
  echo "merge: #$pr already MERGED, recording it"
else
  # Before the checks too: a PR that conflicts with its base gets no pull_request run at all
  # (GitHub cannot build its merge ref), so its last, stale Checks red would read as a failure.
  review_gate
  # A head behind <base> is caught up first, the same merge as after the gate: a session that
  # stopped on exit 3 here left its green PR open while main moved (six waiting on 2026-11-07).
  catch_up before || true
  wait_checks
  waits=0
  while ! catch_up after "$waits"; do
    wait_checks
    waits=$((waits + 1))
  done

  head=$(git rev-parse HEAD)
  out=$(pr_merge "$head" 2>&1) || fail merge "$(lastline "$out")"
  state=$(pr_view state .state 2>&1) || fail merge "$api pr view: $(lastline "$state")"
  [ "$state" = MERGED ] || fail merge "#$pr reads $state, not MERGED"
  echo "merge: #$pr MERGED at ${head:0:8}"
fi

score_body

# The record steps carry the merge commit, proven on origin/<base> from the git graph: a PR object
# reading MERGED is not proof its content is on the branch (ticket contract, "done is a gate").
merged=$(pr_view mergeCommit .mergeCommit.oid 2>&1) || fail proof "$api pr view: $(lastline "$merged")"
# shellcheck source=../lib/agent-merge-proof.sh
. "$(dirname "$(readlink -f "$0")")/../lib/agent-merge-proof.sh"
out=$(MERGE_PROOF_REMOTE=$remote merge_proof . "$pr" "$base" "$merged" 2>&1) || fail proof "$(lastline "$out")"
echo "proof: $out"
# Stow serves the main checkouts, so a merged dotfiles PR is live only once its checkout moves:
# fast-forward it now. Prints nothing for any other repo, and never fails the landing.
live=$("${DOTFILES_AUTOPULL:-$(dirname "$(readlink -f "$0")")/dotfiles-autopull}" --now . 2>/dev/null) || true
[ -z "$live" ] || printf '%s\n' "$live" | sed 's/^/live: /'
# The PR store reads this merge now, not at its next poll, so its readers see it at once. A repo the
# store does not list (exit 3) is not one it serves; any other failure is said, and the next poll
# reads the merge.
if [[ "$pr_ref" == */*#* ]]; then
  store=${pr_ref%#*} host=$(url_host "$url")
  [ "$host" = github.com ] || store="$host/$store"
  rc=0; out=$("${SCHEDULES_SYNC:-schedules-sync}" sync-prs "$store" 2>&1) || rc=$?
  [ "$rc" = 0 ] || [ "$rc" = 3 ] || echo "prs: $store not refreshed ($(lastline "$out")); its next poll reads the merge" >&2
fi
chain_event land merged "$(jq -r .project <<<"$it")" "$(jq -r '.title // ((.task // "") | split("\n")[0])' <<<"$it")" \
  --item "$item" --id "$(jq -r '(.row // "") | sub("^[^:]*:"; "")' <<<"$it")" --pr "$pr_ref" --sha "$merged"

case "$done_as" in
'')
  [ -z "${CLAUDE_CODE_SESSION_ID:-}" ] || agent-queue claim "$item" >/dev/null 2>&1 || echo "item: could not record this session on $item (agent-queue claim)" >&2
  # Re-read so earlier partial landings survive, including a re-run of this PR.
  # closing_pr owns a failed board step even when it is the second PR in the list.
  it=$(agent-queue show "$item" --json 2>&1) || fail item "agent-queue show: $(lastline "$it")"
  read -ra refs <<<"$(jq -r '.pr // ""' <<<"$it")"
  read -ra oids <<<"$(jq -r '.merged // ""' <<<"$it")"
  found=0
  for i in "${!refs[@]}"; do
    if [ "${refs[i]}" = "$pr_ref" ] || [ "${refs[i]}" = "$pr" ]; then
      refs[i]=$pr_ref oids[i]=$merged found=1
    else
      [ -n "${oids[i]:-}" ] || oids[i]=${prior_oid[${refs[i]}]:-}
      [ -n "${oids[i]}" ] || fail item "no merge recorded for ${refs[i]}; land it before finishing $item"
    fi
  done
  if [ "$found" -eq 0 ]; then refs+=("$pr_ref"); oids+=("$merged"); fi
  marker=''
  [ "$partial" -eq 0 ] || marker=yes
  closing=()
  [ "$partial" -eq 1 ] || closing=("closing_pr=$pr_ref")
  out=$(agent-queue set "$item" "pr=${refs[*]}" "merged=${oids[*]}" "partial=$marker" "${closing[@]}" 2>&1) || fail item "$(lastline "$out")"
  credited=$(credit)
  if [ "$partial" -eq 0 ]; then
    out=$(agent-queue move "$item" "done" --status ok 2>&1) || fail item "$(lastline "$out")"
  fi
  ;;
more)
  # Its first PR credited the item and closed its row; this one joins the lists, in step. Read
  # again here, not at the start, so a PR another run added during the checks is kept.
  if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && ! out=$(agent-queue claim "$item" 2>&1); then
    echo "item: could not record this session on $item: $(lastline "$out")" >&2
  fi
  it=$(agent-queue show "$item" --json 2>&1) || fail item "agent-queue show: $(lastline "$it")"
  out=$(agent-queue set "$item" "pr=$(jq -r .pr <<<"$it") $pr_ref" "merged=$(jq -r '.merged // ""' <<<"$it") $merged" 2>&1) ||
    fail item "$(lastline "$out")"
  credited=", beside $(jq -r .pr <<<"$it")"
  ;;
esac
if [ "$partial" -eq 1 ]; then
  echo "item: $item partial with pr:$pr_ref${credited:-}, left open for the final landing"
else
  echo "item: $item done with pr:$pr_ref${credited:-}"
fi

mapfile -t b < <(board_cmd)
if [ "$partial" -eq 1 ]; then
  echo "board: left open until the final landing"
elif [ "$done_as" = more ] || [ "$done_as" = again ]; then
  [ "${#b[@]}" -eq 0 ] || echo "board: left to its closing PR, $(jq -r '.closing_pr // (.pr | split(" ")[0])' <<<"$it") (agent-land on that one closes the row if its board step failed)"
elif [ "${#b[@]}" -gt 0 ]; then
  out=$(notes "${b[@]}" 2>&1) || fail board "$(lastline "$out")"
  echo "board: closed \"${b[-3]}\" with ${b[-1]}"
fi

if [ -n "$plan" ]; then
  tmp=$(mktemp)
  P="- [ ] $phase" PR="$pr" awk '
    index($0, ENVIRON["P"]) == 1 { sub(/^- \[ \]/, "- [x]"); $0 = $0 " (#" ENVIRON["PR"] ")" }
    { print }' "$plan" >"$tmp" || fail plan "awk could not rewrite $plan"
  cat "$tmp" >"$plan" && rm -f "$tmp"
  echo "plan: ticked \"$phase\""
  close_plan_rows
fi

echo "landed #$pr"
