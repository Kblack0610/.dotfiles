#!/usr/bin/env bash
# agent-land - land a gated PR and record it in one call, so a green gate costs no model call.
#
#   agent-land <pr> [--item <slug>] [--plan <file> --phase "<text>"] [--dry-run]
#
# Steps, stopping at the first failure: fetch (HEAD must contain origin/<base> before the
# checks; after them, a base that moved on is merged in, pushed and landed on the same gate), checks (the PR's checks pass: CI, a required check), merge (--squash
# --match-head-commit HEAD, then gh pr view must say MERGED), proof (the PR's merge commit is
# on origin/<base>, by agent-merge-proof.sh), item (the queue item gets pr:<owner>/<repo>#<pr>,
# merged:<sha>, this Claude session in its sessions, the project credited by the PR's changed
# files (agent-queue attribute), and moves to done, status ok), board (the
# item's row, whatever its origin: the story `agent-queue add` filed or the board row it was
# promoted from, done with proof "pr:<pr> commit:<sha>"), plan (--plan: the one "- [ ] <phase>"
# line becomes "- [x] <phase> (#<pr>)"). After the merge, one "body:" line scores the PR body
# against comms-standard (comms-lint --channel pr-body); it never fails the landing. One line per step.
# The item is --item, else $AGENT_QUEUE_ITEM (set in a session fleet-dispatch started), else the
# one this session added or claimed (`agent-queue mine`). No item, no landing: every merged PR
# is a unit of work on the work ledger, so add one first (`agent-queue add --running`).
# Exit 0 landed, 1 a step failed, 2 usage, 3 behind origin/<base> before the checks, or a catch-up
# merge that conflicts: merge it and re-run. A merge of <base> keeps a green gate green; gate again
# only when the repo's CI doc says that merge needs one.
# An already MERGED PR skips checks, fetch and merge, so a re-run finishes a failed record step.
# --dry-run prints the commands and runs none. No reap: `wt done` from inside the worktree
# ends the caller's own tmux session, so wind-down releases the worktree.

set -euo pipefail

usage() {
  sed -n '2,/^$/{s/^# \{0,1\}//;p}' "$0" >&2
  exit 2
}
die() {
  printf 'agent-land: %s\n' "$1" >&2
  exit 2
}
fail() {
  printf 'agent-land: %s failed: %s\n' "$1" "$2" >&2
  exit 1
}
lastline() { printf '%s' "$1" | tail -n 1; }

# Until a CI job starts, a PR reports no checks, and GitHub has no event for the first one: that
# one state is polled CHECKS_POLL seconds apart. While an Actions run for HEAD is still queued it
# waits on; with none, it gives up after CHECKS_TRIES polls and lands on the local gate (a repo
# with no PR checks). `gh pr checks --watch` waits out the rest.
CHECKS_POLL="${AGENT_LAND_CHECKS_POLL:-10}"
CHECKS_TRIES="${AGENT_LAND_CHECKS_TRIES:-12}"
wait_checks() {
  local try out failed queued
  for ((try = 1; ; try++)); do
    out=$(gh pr checks "$pr" --watch --fail-fast 2>&1) && {
      echo "checks: green"
      return 0
    }
    case "$out" in
    *'no checks reported'*) ;;
    *)
      failed=$(gh pr checks "$pr" --json name,bucket -q '[.[] | select(.bucket == "fail" or .bucket == "cancel") | .name] | join(", ")' 2>/dev/null || true)
      fail checks "${failed:-$(lastline "$out")}"
      ;;
    esac
    queued=$(gh run list --commit "$(git rev-parse HEAD)" --json status -q '[.[] | select(.status != "completed")] | length' 2>/dev/null || echo 0)
    [ "${queued:-0}" -eq 0 ] || try=0
    [ "$try" -lt "$CHECKS_TRIES" ] || {
      echo "checks: none reported"
      return 0
    }
    sleep "$CHECKS_POLL"
  done
}

current_with_base() {
  local out behind
  out=$(git fetch -q origin 2>&1) || fail fetch "$(lastline "$out")"
  behind=$(git rev-list --count "HEAD..origin/$base" 2>&1) || fail fetch "$(lastline "$behind")"
  if [ "$behind" -ne 0 ]; then
    printf 'agent-land: behind origin/%s by %s, merge it and re-run (a green gate stays green across a merge of %s unless the repo CI doc says otherwise)\n' "$base" "$behind" "$base" >&2
    exit 3
  fi
}

# catch_up: after a green gate, a base that moved on during the checks is merged in and pushed, and
# that head keeps the same gate, since a merge of <base> keeps it green. It returns 0 when already
# current and 1 after a push: the caller then waits on the PR checks again, because a base with
# strict required checks refuses a head whose checks have not run (2026-11-05: #1837 was refused
# twice). Exiting 3 there instead sent the caller round its own gate again, which a busy base
# outruns every time (#916). A conflict is aborted and exits 3.
catch_up() {
  local out behind
  out=$(git fetch -q origin 2>&1) || fail fetch "$(lastline "$out")"
  behind=$(git rev-list --count "HEAD..origin/$base" 2>&1) || fail fetch "$(lastline "$behind")"
  if [ "$behind" -eq 0 ]; then
    echo "fetch: current with origin/$base"
    return 0
  fi
  if ! out=$(git merge -q --no-edit "origin/$base" 2>&1); then
    git merge --abort >/dev/null 2>&1 || true
    printf 'agent-land: behind origin/%s by %s and merging it conflicts: resolve the merge and re-run\n' "$base" "$behind" >&2
    exit 3
  fi
  out=$(git push -q 2>&1) || fail push "$(lastline "$out")"
  echo "fetch: merged origin/$base ($behind behind) into the green head and pushed it"
  # GitHub works out whether a pushed head merges after the push and refuses the merge until then
  # ("not mergeable"). No event says when, so the PR is polled at the checks cadence until it
  # reads this head with a known answer; the merge step reports what it ends up refusing.
  local head try
  head=$(git rev-parse HEAD)
  for ((try = 1; try <= CHECKS_TRIES; try++)); do
    case "$(gh pr view "$pr" --json headRefOid,mergeable -q '.headRefOid + " " + .mergeable' 2>/dev/null)" in
    "$head UNKNOWN" | "") ;;
    "$head "*) return 1 ;;
    esac
    sleep "$CHECKS_POLL"
  done
  return 1
}

pr='' merged='' plan='' phase='' item="${AGENT_QUEUE_ITEM:-}" dry=0
while [ $# -gt 0 ]; do
  case "$1" in
  --project | --title) die "$1 is gone: the queue item is the record; agent-queue add --running --project <p> \"<task>\", then --item <slug>" ;;
  --plan) plan="${2:?--plan needs a value}" && shift ;;
  --phase) phase="${2:?--phase needs a value}" && shift ;;
  --item) item="${2:?--item needs a value}" && shift ;;
  --dry-run) dry=1 ;;
  -h | --help) usage ;;
  -*) die "unknown flag: $1" ;;
  *) [ -z "$pr" ] || die "one PR only"; pr="$1" ;;
  esac
  shift
done
[[ "$pr" =~ ^[0-9]+$ ]] || die "a PR number is required (try --help)"
row=''
if [ -z "$item" ]; then
  mine=0
  item=$(agent-queue mine 2>/dev/null) || mine=$?
  [ "$mine" -ne 2 ] || die "more than one queue item records this session: pass --item <slug> (agent-queue mine)"
fi
[ -n "$item" ] || die "no queue item for this session: agent-queue add --running --project <p> \"<type(area): title>\" (or claim one), then re-run"
# Checked before the merge, like the plan phase: a wrong slug cannot leave a merged PR unrecorded.
it=$(agent-queue show "$item" --json 2>/dev/null) || die "no queue item $item (agent-queue show)"
# A done item that already carries this PR is a re-run after a failed board step.
case "$(jq -r --arg pr "$pr" 'if .state == "done" and ((.pr // "") | sub(".*#"; "")) == $pr then "rerun" else .state end' <<<"$it")" in
running | waiting | queued | rerun) ;;
*) die "queue item $item is $(jq -r '.state + " " + (.status // "")' <<<"$it"), not open" ;;
esac
# The notes argv that closes the item's row (`row`, "<project>:<key>", agent-queue's one
# definition), one word a line, as fleet-dispatch reads it; empty for an item with no row.
row=$(jq -r 'select((.row // "") != "") | (.row | split(":")) as $r
  | (if (.profile // "") != "" then ["--profile", .profile] else [] end) + ["ptask", $r[0]]
    + (if (.lane // "agent") == "agent" then ["--agent"] else [] end)
    + ["done", ($r[1:] | join(":")), "--proof"] | .[]' <<<"$it")
# score_body: the merged body's score against comms-standard (channel pr-body). A score, never a
# gate: the PR is already merged, and the line tells its author what to fix in the next one.
score_body() {
  local body out rc=0
  command -v comms-lint >/dev/null 2>&1 || { echo "body: not scored (no comms-lint on PATH)"; return 0; }
  body=$(gh pr view "$pr" --json body -q .body 2>&1) || { echo "body: not scored (gh pr view: $(lastline "$body"))"; return 0; }
  out=$(printf '%s\n' "$body" | comms-lint --channel pr-body - 2>&1) || rc=$?
  case "$rc" in
  0) echo "body: passes comms-lint --channel pr-body" ;;
  1) echo "body: $(lastline "$out") First: $(printf '%s\n' "$out" | sed -n '1s/^ *//p')" ;;
  *) echo "body: not scored ($(lastline "$out"))" ;;
  esac
}

# credit -> ", <what agent-queue attribute recorded>" for the item line: the PR's changed files
# credit the item to the registry project whose `path` owns most of them (a game inside the
# playground). It never fails the landing: the PR is merged, and the item keeps the project it
# was added under, so the line says why it was not credited.
credit() {
  local files out
  [[ "$pr_ref" == */*#* ]] || { echo ", not credited (no repo on #$pr)"; return 0; }
  files=$(gh api "repos/${pr_ref%#*}/pulls/$pr/files" --paginate --jq '.[].filename' 2>&1) ||
    { echo ", not credited (gh api: $(lastline "$files"))"; return 0; }
  out=$(printf '%s\n' "$files" | agent-queue attribute "$item" 2>&1) || { echo ", not credited ($(lastline "$out"))"; return 0; }
  [ -z "$out" ] || echo ", $out"
}

# board_cmd -> the notes argv that closes the item's row, one word a line; none for an item with no row.
# Its proof is the PR and, once proven, the merge commit: something checkable, not a claim.
board_cmd() { [ -z "$row" ] || printf '%s\n' "$row" "pr:$pr${merged:+ commit:${merged:0:12}}"; }
if [ -n "$plan$phase" ]; then
  [ -n "$plan" ] && [ -n "$phase" ] || die "--plan and --phase go together"
  [ -f "$plan" ] || die "no plan file: $plan"
  # Checked before the merge, so a bad phase name cannot leave a merged PR half recorded.
  n=$(P="- [ ] $phase" awk 'index($0, ENVIRON["P"]) == 1 { n++ } END { print n + 0 }' "$plan")
  [ "$n" -eq 1 ] || die "plan: $n unchecked lines start with \"- [ ] $phase\", need exactly 1"
fi

if [ "$dry" -eq 1 ]; then
  echo "checks: gh pr checks $pr --watch --fail-fast  (must pass, or report none)"
  echo "fetch: git fetch origin && git rev-list --count HEAD..origin/<base of #$pr>  (0 before the checks; after them git merge origin/<base> && git push)"
  echo "merge: gh pr merge $pr --squash --match-head-commit \$(git rev-parse HEAD) && gh pr view $pr --json state  (must be MERGED)"
  echo "body: gh pr view $pr --json body | comms-lint --channel pr-body -  (a score, never a gate)"
  echo "proof: gh pr view $pr --json mergeCommit, then merge_proof: an ancestor of origin/<base>"
  echo "item: agent-queue set $item pr=$pr merged=<sha> && gh api repos/<owner>/<repo>/pulls/$pr/files | agent-queue attribute $item && agent-queue move $item done --status ok"
  mapfile -t b < <(board_cmd)
  [ "${#b[@]}" -eq 0 ] || echo "board: notes ${b[*]}"
  [ -z "$plan" ] || echo "plan: tick \"- [ ] $phase\" -> \"- [x] ... (#$pr)\" in $plan"
  exit 0
fi

info=$(gh pr view "$pr" --json state,baseRefName,url -q '.state + " " + .baseRefName + " " + .url' 2>&1) ||
  fail fetch "gh pr view $pr: $(lastline "$info")"
read -r state base url <<<"$info"
# The item's PR names its repo: a bare number is ambiguous across the repos one project spans.
pr_ref=$(sed -E 's#^https?://[^/]+/([^/]+/[^/]+)/pulls?/([0-9]+).*#\1\#\2#' <<<"$url")
[[ "$pr_ref" =~ ^[^/]+/[^/#]+#[0-9]+$ ]] || pr_ref="$pr"

if [ "$state" = MERGED ]; then
  echo "merge: #$pr already MERGED, recording it"
else
  # Before the checks too: a PR that conflicts with its base gets no pull_request run at all
  # (GitHub cannot build its merge ref), so its last, stale Checks red would read as a failure.
  current_with_base
  wait_checks
  while ! catch_up; do wait_checks; done

  head=$(git rev-parse HEAD)
  out=$(gh pr merge "$pr" --squash --match-head-commit "$head" 2>&1) || fail merge "$(lastline "$out")"
  state=$(gh pr view "$pr" --json state -q .state 2>&1) || fail merge "gh pr view: $(lastline "$state")"
  [ "$state" = MERGED ] || fail merge "#$pr reads $state, not MERGED"
  echo "merge: #$pr MERGED at ${head:0:8}"
fi

score_body

# The record steps carry the merge commit, proven on origin/<base> from the git graph: a PR object
# reading MERGED is not proof its content is on the branch (ticket contract, "done is a gate").
merged=$(gh pr view "$pr" --json mergeCommit -q .mergeCommit.oid 2>&1) || fail proof "gh pr view: $(lastline "$merged")"
# shellcheck source=../lib/agent-merge-proof.sh
. "$(dirname "$(readlink -f "$0")")/../lib/agent-merge-proof.sh"
out=$(merge_proof . "$pr" "$base" "$merged" 2>&1) || fail proof "$(lastline "$out")"
echo "proof: $out"

if [ "$(jq -r .state <<<"$it")" != "done" ]; then
  [ -z "${CLAUDE_CODE_SESSION_ID:-}" ] || agent-queue claim "$item" >/dev/null 2>&1 || echo "item: could not record this session on $item (agent-queue claim)" >&2
  out=$(agent-queue set "$item" "pr=$pr_ref" "merged=$merged" 2>&1) || fail item "$(lastline "$out")"
  credited=$(credit)
  out=$(agent-queue move "$item" "done" --status ok 2>&1) || fail item "$(lastline "$out")"
fi
echo "item: $item done with pr:$pr_ref${credited:-}"

mapfile -t b < <(board_cmd)
if [ "${#b[@]}" -gt 0 ]; then
  out=$(notes "${b[@]}" 2>&1) || fail board "$(lastline "$out")"
  echo "board: closed \"${b[-3]}\" with ${b[-1]}"
fi

if [ -n "$plan" ]; then
  tmp=$(mktemp)
  P="- [ ] $phase" PR="$pr" awk '
    index($0, ENVIRON["P"]) == 1 { sub(/^- \[ \]/, "- [x]"); $0 = $0 " (#" ENVIRON["PR"] ")" }
    { print }' "$plan" >"$tmp" || fail plan "awk could not rewrite $plan"
  cat "$tmp" >"$plan" && rm -f "$tmp"
  echo "plan: ticked \"$phase\""
fi

echo "landed #$pr"
