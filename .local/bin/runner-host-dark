#!/usr/bin/env bash
# runner-host-dark - name each self-hosted CI runner host whose every registered GitHub runner has
# been offline for a whole window. The probe of the Sentinel watch runner-host-dark.
#
#   runner-host-dark [--for 10m] [--at <epoch|date>]
#
# Exit 0: no host dark. Exit 1: a `dark:` line per dark host plus one `reason:` line naming them
# (watch-companion-loop puts it in the page), or one `unreadable:` line when Prometheus or the
# runner exporter gave no reading (Sentinel holds the state, no page).
#
# Hosts: every host label of the runner exporter's github_runner_state (one series per registered
# runner, its status in the state label) but the ARC scale sets' (EPHEMERAL_HOSTS): their runners
# are pods kube-scheduler places for one job each, so no machine stands behind the label. Today
# that leaves the mac-mini, whose macOS runners cannot run in the cluster.
#
# Dark: at least one registered runner now, and no runner online (state idle or running) at any
# exporter reading across the window. A reading the exporter did not give counts as nothing, never
# as offline, and the window must hold readings from its first minute. --at replays a past moment.

set -uo pipefail

# shellcheck source=../lib/prom.sh
. "$(dirname "$(readlink -f "$0")")/../lib/prom.sh"
PROM_TIMEOUT=20
# The exporter is scraped about once a minute, so one reading per minute is every reading.
STEP=60
# The host labels of ARC scale-set runner pods (`unknown` is a pod that has not reported its node).
EPHEMERAL_HOSTS='unknown|arc|arc-.+'
RUNNERS="github_runner_state{forge=\"github\",state!=\"missing\",host!~\"$EPHEMERAL_HOSTS\"}"
ONLINE="github_runner_state{forge=\"github\",state=~\"idle|running\",host!~\"$EPHEMERAL_HOSTS\"}"

usage() { sed -n '5p' "$0" | sed 's/^# *//' >&2; exit 2; }

win=10m at=
while [ $# -gt 0 ]; do
  case "$1" in
    --for|--at) [ $# -ge 2 ] || usage
      if [ "$1" = --for ]; then win=$2; else at=$2; fi; shift 2 ;;
    -h|--help) usage ;;
    *) echo "runner-host-dark: unknown argument $1" >&2; usage ;;
  esac
done
[[ "$win" =~ ^([0-9]+)([smh])$ ]] || { echo "runner-host-dark: --for wants a duration like 10m, got '$win'" >&2; exit 2; }
case "${BASH_REMATCH[2]}" in s) secs=${BASH_REMATCH[1]} ;; m) secs=$((BASH_REMATCH[1] * 60)) ;; h) secs=$((BASH_REMATCH[1] * 3600)) ;; esac
(( secs >= STEP )) || { echo "runner-host-dark: --for must be at least ${STEP}s" >&2; exit 2; }
if [ -z "$at" ]; then end=$(date +%s)
elif [[ "$at" =~ ^[0-9]+$ ]]; then end=$at
else end=$(date -d "$at" +%s 2>/dev/null) || { echo "runner-host-dark: --at '$at' is not a date" >&2; exit 2; }
fi
start=$((end - secs))

# Per host and reading, the runners online, 0 for a host whose runners all read offline.
online=$(prom_range "count by (host) ($W ($ONLINE)) or (count by (host) ($W ($RUNNERS)) * 0)" "$start" "$end" "$STEP") \
  || { echo "unreadable: Prometheus did not answer the runner exporter's runner states"; exit 1; }
reg=$(prom_q "count by (host) ($W ($RUNNERS))" "$end") \
  || { echo "unreadable: Prometheus did not answer the registered runners"; exit 1; }

out=$(jq -rn --argjson r "$online" --argjson reg "$reg" \
  --argjson start "$start" --argjson end "$end" --argjson step "$STEP" --arg win "$win" '
  def by_host($j): [$j.data.result[] | {key: .metric.host, value: (.value[1] | tonumber)}] | from_entries;
  [$r.data.result[].values[][0]] as $ts
  | if ($ts | length) == 0 or ($ts | max) < $end - $step then "unreadable: the runner exporter gave no runner state (github_runner_state) now"
    else
      by_host($reg) as $regd | ($ts | min) as $first | ($ts | max) as $last
      # Each host'"'"'s last reading with a runner online, null when none in the window.
      | ($r.data.result | map({key: .metric.host, value: ([.values[] | select((.[1] | tonumber) > 0)] | last)}) | from_entries) as $up
      | [$regd | keys[] as $h | $regd[$h] as $n | $up[$h] as $u
         | if $u != null and $u[0] >= $last then "ok: \($h) \($u[1]) of \($n) online"
           elif $u != null then "ok: \($h) all \($n) offline, for under \($win)"
           elif $first > $start + $step then "ok: \($h) all \($n) offline, but the exporter readings start inside the window"
           else {host: $h, n: $n} end] as $rows
      | if ($rows | length) == 0 then "ok: no self-hosted runner host is registered"
        else ($rows[] | if type == "object" then "dark: \(.host) all \(.n) runners offline for \($win) or more" else . end),
          ([$rows[] | objects | "\(.host) (\(.n) runners)"] | select(length > 0) | "reason: \(join(", ")) offline for \($win) or more")
        end
    end') && [ -n "$out" ] || { echo "unreadable: runner-host-dark could not judge the readings Prometheus gave"; exit 1; }

printf '%s\n' "$out"
grep -qE '^(unreadable|reason): ' <<<"$out" && exit 1
exit 0
