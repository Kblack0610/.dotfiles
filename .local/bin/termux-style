#!/data/data/com.termux/files/usr/bin/bash
# termux-style - attach the repo's Termux terminal profile to this phone.
#
# Links .termux/{termux,colors}.properties into ~/.termux and reloads Termux, so
# a `git pull` is all it takes to move the phone onto a new theme. colors is
# generated by theme-switch from the active palette; termux.properties is
# hand-written and hostile to wasted rows.
#
# Stow never deploys these (.stow-local-ignore holds ~/.termux back) because the
# path only means anything on Android. This script is the deploy step.
#
#   ~/.dotfiles/.local/bin/termux-style
#
set -uo pipefail

DOTFILES="${DOTFILES_ROOT:-$HOME/.dotfiles}"
DST_DIR="${TERMUX_CONFIG_DIR:-$HOME/.termux}"
SRC_DIR="$DOTFILES/.termux"
STAMP="$(date +%Y%m%d%H%M%S)"

say()  { printf '\033[1;36m==>\033[0m %s\n' "$1"; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$1" >&2; }
die()  { printf '\033[1;31mERROR:\033[0m %s\n' "$1" >&2; exit 1; }

command -v pkg >/dev/null 2>&1 || die "not Termux (no pkg). This only means anything inside the Termux app."
[ -d "$SRC_DIR" ] || die "no $SRC_DIR - clone the public dotfiles first."

mkdir -p "$DST_DIR"

for name in termux.properties colors.properties; do
    src="$SRC_DIR/$name"
    dst="$DST_DIR/$name"
    [ -f "$src" ] || { warn "$name: not in the repo, skipping"; continue; }

    # If $DST_DIR is itself a link into the repo, dst and src are already one
    # file and linking would point it at itself - a self-loop that survives as a
    # tracked 120000 mode change and breaks whatever execs it. Resolve both ends
    # first; identity is the only safe test.
    if [ "$(readlink -f "$dst" 2>/dev/null)" = "$(readlink -f "$src")" ]; then
        say "$name: already resolves to the repo copy"
        continue
    fi

    # Preserve a hand-rolled config once, then never again - a re-run must not
    # bury the real backup under a chain of backups-of-symlinks.
    if [ -e "$dst" ] && [ ! -L "$dst" ]; then
        mv "$dst" "$dst.bak.$STAMP"
        say "$name: kept your previous file as $name.bak.$STAMP"
    fi

    ln -sfn "$src" "$dst"
    say "$name: linked"
done

if command -v termux-reload-settings >/dev/null 2>&1; then
    termux-reload-settings
    say "reloaded Termux settings"
else
    warn "termux-reload-settings missing (pkg install termux-tools) - restart Termux to apply"
fi

cat <<'EOF'

Volume-Up + Q  hide/show the extra-keys row (use it when a keyboard is attached)
Volume-Up + K  hide/show the soft keyboard
Ctrl+Alt +/-   font size, or pinch-zoom
EOF
