#!/usr/bin/env bash
# agentctl — manage named long-running Claude agents via systemd --user
#
# Each agent is a config file at ~/.config/agentctl/agents/<name>.conf.
# Agents become systemctl --user units (agentctl@<name>.service for the
# process; agentctl-<name>.timer for oneshot scheduling).

set -euo pipefail

CONFIG_DIR="${HOME}/.config/agentctl/agents"
SYSTEMD_USER_DIR="${HOME}/.config/systemd/user"
# ONE state dir, reachable under EITHER name.
#
# This was two names for one thing, split across the write and read sides: this
# file honoured AGENTCTL_STATE (which agentctl@.service exports into every unit),
# while every reader - agent-proof.sh, fleet.sh, the bats sandbox - honoured
# AGENTCTL_STATE_DIR. They agreed only because both defaulted to the same path,
# so nothing ever looked wrong until something set one of them. Then the writer
# and the reader addressed different directories and both reported success.
#
# AGENTCTL_STATE_DIR wins when both are set: it is the name the readers and the
# test harness use, so whoever is trying to redirect state gets what they asked
# for rather than silently losing to the unit's absolute path.
STATE_DIR="${AGENTCTL_STATE_DIR:-${AGENTCTL_STATE:-${HOME}/.local/state/agentctl}}"

mkdir -p "$STATE_DIR"

die() { printf 'agentctl: %s\n' "$*" >&2; exit 1; }

list_agent_names() {
    [ -d "$CONFIG_DIR" ] || return 0
    for f in "$CONFIG_DIR"/*.conf; do
        [ -f "$f" ] || continue
        basename "$f" .conf
    done
}

# Source a config in a subshell, validate, emit normalized KEY=VALUE lines.
load_agent() {
    local name="$1"
    local conf="$CONFIG_DIR/${name}.conf"
    [ -f "$conf" ] || { printf 'no such agent: %s\n' "$name" >&2; return 1; }
    (
        set -e
        # shellcheck disable=SC1090
        source "$conf"
        : "${NAME:?missing NAME}"
        : "${KIND:?missing KIND}"
        : "${COMMAND:?missing COMMAND}"
        case "$KIND" in
            oneshot|persistent) ;;
            *) printf 'invalid KIND=%s\n' "$KIND" >&2; exit 1 ;;
        esac
        [ "$NAME" = "$name" ] || { printf 'NAME=%s does not match filename %s\n' "$NAME" "$name" >&2; exit 1; }
        : "${DESCRIPTION:=}"
        : "${SCHEDULE:=}"
        : "${AUTOSTART:=no}"
        : "${INBOX:=$STATE_DIR/$NAME}"
        printf 'NAME=%s\n' "$NAME"
        printf 'KIND=%s\n' "$KIND"
        printf 'COMMAND=%s\n' "$COMMAND"
        printf 'DESCRIPTION=%s\n' "$DESCRIPTION"
        printf 'SCHEDULE=%s\n' "$SCHEDULE"
        printf 'AUTOSTART=%s\n' "$AUTOSTART"
        printf 'INBOX=%s\n' "$INBOX"
    )
}

agent_field() {
    local name="$1" field="$2"
    load_agent "$name" 2>/dev/null \
        | awk -F= -v k="$field" 'BEGIN{IGNORECASE=0} {if (substr($0,1,length(k)+1) == k"=") {print substr($0, length(k)+2); exit}}'
}

systemd_show() {
    local unit="$1" prop="$2"
    systemctl --user show "$unit" --property="$prop" --value 2>/dev/null
}

unit_state() { systemd_show "agentctl@${1}.service" ActiveState; }
unit_substate() { systemd_show "agentctl@${1}.service" SubState; }
unit_result() { systemd_show "agentctl@${1}.service" Result; }
unit_restarts() { systemd_show "agentctl@${1}.service" NRestarts; }
unit_exitstatus() { systemd_show "agentctl@${1}.service" ExecMainStatus; }

unit_pid() {
    local pid
    pid=$(systemd_show "agentctl@${1}.service" MainPID)
    [ "$pid" = "0" ] && echo "" || echo "$pid"
}

unit_uptime() {
    local started
    started=$(systemd_show "agentctl@${1}.service" ExecMainStartTimestamp)
    if [ -z "$started" ] || [ "$started" = "n/a" ]; then
        echo ""; return 0
    fi
    local started_epoch now_epoch diff
    if ! started_epoch=$(date -d "$started" +%s 2>/dev/null); then
        echo ""; return 0
    fi
    now_epoch=$(date +%s)
    diff=$((now_epoch - started_epoch))
    if [ "$diff" -lt 0 ]; then
        echo ""; return 0
    fi
    fmt_dur "$diff"
}

unit_next_run() {
    local timer="agentctl-${1}.timer"
    # systemd output: "Fri 2026-05-01 03:00:00 PDT      11h -  ..."
    # Show "Fri 03:00:00" as a compact next-run marker.
    systemctl --user list-timers --all 2>/dev/null \
        | awk -v t="$timer" '$0 ~ t {print $1" "$3; exit}'
}

fmt_dur() {
    local s=$1
    if   [ "$s" -lt 60 ];    then printf '%ds\n' "$s"
    elif [ "$s" -lt 3600 ];  then printf '%dm%ds\n' $((s/60)) $((s%60))
    elif [ "$s" -lt 86400 ]; then printf '%dh%dm\n' $((s/3600)) $(((s%3600)/60))
    else                          printf '%dd%dh\n' $((s/86400)) $(((s%86400)/3600))
    fi
}

# ----------------------------------------------------------------------
# Runner status contract
# ----------------------------------------------------------------------
# systemd tells a reader whether a unit is running. It cannot tell it what the runner is
# WORKING ON — which project, which item, whether it is blocked on a human. Before this,
# every runner answered that differently (sentinel wrote watch-companion/*.state,
# delivery-loop had its own `status` text, most reported nothing), so the cockpit could
# only show active/inactive plus a tail of a freeform log. This is the one shape they all
# publish instead:
#
#   $STATE_DIR/<name>/status     key=value, one per line, atomically replaced
#     state=working|idle|ok|blocked|error
#     project=<canonical project name; empty for a global runner like sentinel>
#     item=<one line: what it is doing now, or last did>
#     detail=<optional extra>
#     updated=<epoch of the last report>
#
# It sits beside that runner's activity.log in the same INBOX dir. Readers (fleet.sh)
# parse the FILE, not this command — the file is the contract, `report` is just the
# blessed writer, so a reader keeps working if this script is rewritten.
#
# Writes MERGE: `report item=...` must never wipe `project`. Unknown keys are rejected
# rather than stored, so a typo fails loudly instead of vanishing into a file nobody reads.

STATUS_KEYS=' state project item detail updated '
STATUS_STATES=' working idle ok blocked error '

status_file() { printf '%s/%s/status' "$STATE_DIR" "$1"; }

# status_get <name> <key> -> value, or empty. First match wins.
status_get() {
    local f; f="$(status_file "$1")"
    [ -f "$f" ] || return 0
    awk -F= -v k="$2" '$1 == k { sub(/^[^=]*=/, ""); print; exit }' "$f"
}

# status_write <name> <k=v>... — merge into the existing file and replace it atomically.
# Atomic because a reader polling this file must never catch it half-written; the tmp
# file is created in the same directory so the mv is a rename, not a copy.
status_write() {
    local name="$1"; shift
    status_write_dir "$STATE_DIR/$name" "$@"
}

# The same writer, addressed by DIRECTORY rather than by roster name.
#
# A run lives wherever runs_dir() says (which honours $AGENTCTL_RUNS_DIR), and
# that is not always $STATE_DIR/runs -- so deriving the status path from a name
# would put the file somewhere the reader is not looking. That is precisely the
# two-names-one-location bug fixed in .dotfiles#231, and it showed up here within
# an hour of the run subtree existing. Take the directory as the argument and it
# cannot happen: the caller that owns the directory names the file.
status_write_dir() {
    local dir="$1"; shift
    local f="$dir/status" tmp kv k v
    mkdir -p "$dir" || die "cannot create $dir"

    declare -A merged=()
    if [ -f "$f" ]; then
        while IFS= read -r kv; do
            [ -n "$kv" ] || continue
            k="${kv%%=*}"; v="${kv#*=}"
            [[ "$STATUS_KEYS" == *" $k "* ]] && merged["$k"]="$v"
        done < "$f"
    fi

    for kv in "$@"; do
        [[ "$kv" == *=* ]] || die "report: expected key=value, got '$kv'"
        k="${kv%%=*}"; v="${kv#*=}"
        [[ "$STATUS_KEYS" == *" $k "* ]] || die "report: unknown key '$k' (allowed:${STATUS_KEYS% })"
        # One physical line per key, or the next read splits one value into two records.
        v="${v//$'\n'/ }"; v="${v//$'\r'/}"
        if [ "$k" = state ] && [ -n "$v" ] && [[ "$STATUS_STATES" != *" $v "* ]]; then
            die "report: unknown state '$v' (allowed:${STATUS_STATES% })"
        fi
        merged["$k"]="$v"
    done
    merged[updated]="$(date +%s)"

    tmp="$dir/.status.$$"
    : > "$tmp" || die "cannot write $tmp"
    for k in state project item detail updated; do
        printf '%s=%s\n' "$k" "${merged[$k]-}" >> "$tmp"
    done
    mv -f "$tmp" "$f"
}

# The proof contract's engine half. The file itself is written by
# ~/.local/lib/agent-proof.sh's proof_report(); these two only handle the states a
# runner cannot report for itself: "started, has not said anything yet" and "exited
# without ever saying anything".
_outcome_file() { printf '%s/%s/last-outcome' "$STATE_DIR" "$1"; }

_outcome_seed() {
    local f; f="$(_outcome_file "$1")"
    mkdir -p "$(dirname "$f")" 2>/dev/null || return 0
    printf 'PENDING' > "$f" 2>/dev/null || true
}

_outcome_promote() {
    local f; f="$(_outcome_file "$1")"
    [ -r "$f" ] || return 0
    [ "$(cat "$f" 2>/dev/null)" = PENDING ] || return 0
    printf 'STALLED' > "$f" 2>/dev/null || true
}

cmd_report() {
    local name="${AGENTCTL_NAME:-}" lifecycle=""
    local -a kvs=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --name)      shift; name="${1:-}" ;;
            --lifecycle) shift; lifecycle="${1:-}" ;;
            --) shift; while [ $# -gt 0 ]; do kvs+=("$1"); shift; done; break ;;
            -*) die "report: unknown flag: $1" ;;
            *)  kvs+=("$1") ;;
        esac
        shift
    done
    [ -n "$name" ] || die "report: no agent name (pass --name, or run under systemd where AGENTCTL_NAME is set)"

    # The engine-side envelope, wired into agentctl@.service so EVERY runner gets a
    # baseline started/finished/failed for free — a runner only calls `report` by hand to
    # add the semantics systemd cannot know (project, item).
    case "$lifecycle" in
        start)
            # `project` is deliberately kept: a runner that reports one keeps it across
            # fires, and a fresh run overwrites it anyway. item/detail are last run's.
            kvs+=(state=working item= detail=)
            # Seed the proof contract. The absence of a last-outcome must mean "this
            # runner was never wired", NOT "it ran and said nothing" - those need
            # different fixes and looked identical before. A run that STARTS declares
            # PENDING and is expected to overwrite it.
            _outcome_seed "$name" ;;
        stop)
            # systemd sets these for ExecStopPost only. Anything but `success` is a fault
            # worth a glyph, which is the distinction `inactive` alone can never make.
            if [ -n "${SERVICE_RESULT:-}" ] && [ "${SERVICE_RESULT}" != success ]; then
                kvs+=(state=error "detail=result=${SERVICE_RESULT} exit=${EXIT_STATUS:-?}")
            else
                kvs+=(state=idle detail=)
            fi
            # A runner that exited without ever declaring an outcome is STALLED. Doing
            # this engine-side means every runner inherits the guard instead of adopting
            # it one at a time - which is exactly how nightly-sync missed the guard dream
            # already had, and went six nights writing nothing.
            _outcome_promote "$name" ;;
        "") ;;
        *) die "report: unknown lifecycle '$lifecycle' (start|stop)" ;;
    esac

    [ "${#kvs[@]}" -gt 0 ] || die "report: nothing to report (pass key=value or --lifecycle)"
    status_write "$name" "${kvs[@]}"
}

# ----------------------------------------------------------------------
# Subcommands
# ----------------------------------------------------------------------

cmd_list() {
    printf '%-12s %-10s %-10s %-7s %-10s %s\n' NAME KIND STATE PID UPTIME NEXT
    local found=0
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        found=1
        local kind state pid uptime nextrun
        kind=$(agent_field "$name" KIND)
        [ -z "$kind" ] && kind="?"
        state=$(unit_state "$name"); [ -z "$state" ] && state="-"
        pid=$(unit_pid "$name");     [ -z "$pid" ]   && pid="-"
        uptime=$(unit_uptime "$name"); [ -z "$uptime" ] && uptime="-"
        nextrun=$(unit_next_run "$name"); [ -z "$nextrun" ] && nextrun="-"
        printf '%-12s %-10s %-10s %-7s %-10s %s\n' "$name" "$kind" "$state" "$pid" "$uptime" "$nextrun"
    done < <(list_agent_names)
    if [ "$found" -eq 0 ]; then
        printf '(no agents configured at %s)\n' "$CONFIG_DIR"
    fi
    return 0
}

cmd_status() {
    local name="${1:-}"
    [ -n "$name" ] || die "usage: agentctl status <name>"
    [ -f "$CONFIG_DIR/${name}.conf" ] || die "no such agent: $name"

    local desc kind inbox state substate pid uptime restarts result lastexit nextrun
    desc=$(agent_field "$name" DESCRIPTION)
    kind=$(agent_field "$name" KIND)
    inbox=$(agent_field "$name" INBOX)
    state=$(unit_state "$name")
    substate=$(unit_substate "$name")
    pid=$(unit_pid "$name")
    uptime=$(unit_uptime "$name")
    restarts=$(unit_restarts "$name")
    result=$(unit_result "$name")
    lastexit=$(unit_exitstatus "$name")
    nextrun=$(unit_next_run "$name")

    printf '%s [%s]\n' "$name" "$kind"
    [ -n "$desc" ] && printf '  description: %s\n' "$desc"
    printf '  state:    %s' "${state:-unknown}"
    [ -n "$substate" ] && [ "$substate" != "$state" ] && printf ' (%s)' "$substate"
    printf '\n'
    [ -n "$pid" ]      && printf '  pid:      %s\n' "$pid"
    [ -n "$uptime" ]   && printf '  uptime:   %s\n' "$uptime"
    [ -n "$restarts" ] && [ "$restarts" != "0" ] && printf '  restarts: %s\n' "$restarts"
    [ -n "$result" ]   && [ "$result" != "success" ] && printf '  result:   %s\n' "$result"
    if [[ -n "$lastexit" && "$state" != "active" && ( "$result" != "success" || -n "$pid" ) ]]; then
        printf '  last_exit: %s\n' "$lastexit"
    fi
    [ -n "$nextrun" ]  && printf '  next_run: %s\n' "$nextrun"
    printf '  inbox:    %s\n' "$inbox"

    # What the runner itself said it was doing. systemd's view above is the envelope;
    # this is the payload, and it is the half that answers "on what".
    local r_state r_project r_item r_detail r_updated
    r_state="$(status_get "$name" state)"
    if [ -n "$r_state" ]; then
        r_project="$(status_get "$name" project)"
        r_item="$(status_get "$name" item)"
        r_detail="$(status_get "$name" detail)"
        r_updated="$(status_get "$name" updated)"
        printf '  reported: %s' "$r_state"
        [ -n "$r_updated" ] && printf ' (%s ago)' "$(fmt_dur $(( $(date +%s) - r_updated )))"
        printf '\n'
        [ -n "$r_project" ] && printf '  project:  %s\n' "$r_project"
        [ -n "$r_item" ]    && printf '  item:     %s\n' "$r_item"
        [ -n "$r_detail" ]  && printf '  detail:   %s\n' "$r_detail"
    fi

    local stdout="$STATE_DIR/${name}.stdout.log"
    local stderr="$STATE_DIR/${name}.stderr.log"
    local activity="$inbox/activity.log"
    if [ -s "$stdout" ]; then
        printf '\n--- stdout (tail 10) ---\n'
        tail -n 10 "$stdout"
    fi
    if [ -s "$stderr" ]; then
        printf '\n--- stderr (tail 10) ---\n'
        tail -n 10 "$stderr"
    fi
    if [ -s "$activity" ]; then
        printf '\n--- inbox activity (tail 10) ---\n'
        tail -n 10 "$activity"
    fi
}

cmd_start() {
    local name="${1:-}"
    [ -n "$name" ] || die "usage: agentctl start <name>"
    [ -f "$CONFIG_DIR/${name}.conf" ] || die "no such agent: $name"
    systemctl --user start "agentctl@${name}.service"
}

cmd_stop() {
    local name="${1:-}"
    [ -n "$name" ] || die "usage: agentctl stop <name>"
    systemctl --user stop "agentctl@${name}.service"
}

cmd_restart() {
    local name="${1:-}"
    [ -n "$name" ] || die "usage: agentctl restart <name>"
    [ -f "$CONFIG_DIR/${name}.conf" ] || die "no such agent: $name"
    systemctl --user restart "agentctl@${name}.service"
}

cmd_enable() {
    local name="${1:-}"
    [ -n "$name" ] || die "usage: agentctl enable <name>"
    [ -f "$CONFIG_DIR/${name}.conf" ] || die "no such agent: $name"
    local kind
    kind=$(agent_field "$name" KIND)
    if [ "$kind" = "oneshot" ]; then
        [ -f "$SYSTEMD_USER_DIR/agentctl-${name}.timer" ] \
            || die "no timer for $name; run 'agentctl reload' first"
        systemctl --user enable --now "agentctl-${name}.timer"
    else
        systemctl --user enable --now "agentctl@${name}.service"
    fi
}

cmd_disable() {
    local name="${1:-}"
    [ -n "$name" ] || die "usage: agentctl disable <name>"
    local kind
    kind=$(agent_field "$name" KIND 2>/dev/null || echo "")
    if [ "$kind" = "oneshot" ]; then
        systemctl --user disable --now "agentctl-${name}.timer" 2>/dev/null || true
    else
        systemctl --user disable --now "agentctl@${name}.service" 2>/dev/null || true
    fi
}

cmd_logs() {
    local follow=""
    local name=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -f|--follow) follow=1; shift ;;
            -*) die "unknown option: $1" ;;
            *)  name="$1"; shift ;;
        esac
    done
    [ -n "$name" ] || die "usage: agentctl logs <name> [-f]"
    [ -f "$CONFIG_DIR/${name}.conf" ] || die "no such agent: $name"

    local inbox stdout stderr activity
    inbox=$(agent_field "$name" INBOX)
    stdout="$STATE_DIR/${name}.stdout.log"
    stderr="$STATE_DIR/${name}.stderr.log"
    activity="$inbox/activity.log"

    mkdir -p "$STATE_DIR" "$inbox"
    [ -e "$stdout" ]   || touch "$stdout"
    [ -e "$stderr" ]   || touch "$stderr"
    [ -e "$activity" ] || touch "$activity"

    if [ -n "$follow" ]; then
        exec tail -F "$stdout" "$stderr" "$activity"
    else
        tail -n 50 "$stdout" "$stderr" "$activity"
    fi
}

write_timer_file() {
    local name="$1" schedule="$2"
    local timer="$SYSTEMD_USER_DIR/agentctl-${name}.timer"
    cat > "$timer" <<EOF
[Unit]
Description=agentctl schedule: $name
# Generated by 'agentctl reload' — do not edit manually.

[Timer]
OnCalendar=$schedule
Persistent=true
Unit=agentctl@${name}.service

[Install]
WantedBy=timers.target
EOF
}

cmd_reload() {
    mkdir -p "$SYSTEMD_USER_DIR" "$STATE_DIR"

    local existing_timers=()
    for t in "$SYSTEMD_USER_DIR"/agentctl-*.timer; do
        [ -f "$t" ] || continue
        existing_timers+=("$(basename "$t" .timer | sed 's/^agentctl-//')")
    done

    local configured_oneshots=()
    local configured_persistent_autostart=()
    local count=0 errors=0
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        if ! load_agent "$name" >/dev/null 2>&1; then
            local err
            err=$(load_agent "$name" 2>&1 1>/dev/null || true)
            printf 'agentctl: skipping invalid config %s: %s\n' "$name" "$err" >&2
            errors=$((errors + 1))
            continue
        fi
        count=$((count + 1))
        local kind sched autostart
        kind=$(agent_field "$name" KIND)
        sched=$(agent_field "$name" SCHEDULE)
        autostart=$(agent_field "$name" AUTOSTART)

        if [ "$kind" = "oneshot" ] && [ -n "$sched" ]; then
            write_timer_file "$name" "$sched"
            configured_oneshots+=("$name")
        elif [ "$kind" = "persistent" ] && [ "$autostart" = "yes" ]; then
            configured_persistent_autostart+=("$name")
        fi
    done < <(list_agent_names)

    # Remove orphaned timers
    if [ "${#existing_timers[@]}" -gt 0 ]; then
        for t in "${existing_timers[@]}"; do
            local found=0
            if [ "${#configured_oneshots[@]}" -gt 0 ]; then
                for o in "${configured_oneshots[@]}"; do
                    [ "$o" = "$t" ] && { found=1; break; }
                done
            fi
            if [ "$found" -eq 0 ]; then
                systemctl --user disable --now "agentctl-${t}.timer" 2>/dev/null || true
                rm -f "$SYSTEMD_USER_DIR/agentctl-${t}.timer"
                printf 'agentctl: removed orphan timer: %s\n' "$t" >&2
            fi
        done
    fi

    systemctl --user daemon-reload

    if [ "${#configured_oneshots[@]}" -gt 0 ]; then
        for o in "${configured_oneshots[@]}"; do
            systemctl --user enable "agentctl-${o}.timer" >/dev/null 2>&1 || true
            systemctl --user start  "agentctl-${o}.timer" >/dev/null 2>&1 || true
        done
    fi
    if [ "${#configured_persistent_autostart[@]}" -gt 0 ]; then
        for p in "${configured_persistent_autostart[@]}"; do
            systemctl --user enable "agentctl@${p}.service" >/dev/null 2>&1 || true
            local state
            state=$(unit_state "$p")
            if [ "$state" != "active" ]; then
                systemctl --user start "agentctl@${p}.service" >/dev/null 2>&1 || true
            fi
        done
    fi

    printf 'agentctl: loaded %d agent(s)' "$count"
    [ "$errors" -gt 0 ] && printf ', %d error(s)' "$errors"
    printf '\n'
}

cmd_watch() {
    command -v watch >/dev/null || die "watch(1) not found (install procps-ng)"
    exec watch -n 2 -c -t -- agentctl list
}

# ----------------------------------------------------------------------
# run / runs — the ad-hoc front door
# ----------------------------------------------------------------------
# agentctl supervised RUNNERS and nothing else, so every ad-hoc invocation
# became a bare `claude -p` at a call site with its own flags and no trace.
# A RUN is the missing unit: one invocation, through the role contract,
# recorded where a supervised runner is already visible.
#
# TWO LAYERS, OPPOSITE FAILURE POLICIES, and the whole design falls out of
# keeping them apart:
#
#   agentctl-run   capability   fail CLOSED (78, never degrade)
#   agentctl run   observability fail OPEN  (never break the run)
#
# So this forks agentctl-run as a CHILD rather than absorbing it. agentctl-run
# keeps its exec and stays on PATH: wave-start wraps it with its own lock, trap
# and proof and reads `|| rc=$?`, and interposing a supervisor would change what
# that $? means. A telemetry bug here must not be able to take down the fleet,
# which is the same reason the unit prefixes its lifecycle hooks with `-`.

RUNS_LIB="${AGENTCTL_RUNS_LIB:-$HOME/.local/lib/agentctl-runs.sh}"
[ -r "$RUNS_LIB" ] || RUNS_LIB="$(dirname "$(readlink -f "$0")")/../lib/agentctl-runs.sh"

# Resolve the child deterministically before falling back to PATH: a sibling of
# the resolved $0 is what this repo ships, and PATH-first is how a test passes
# against the wrong binary.
_run_child() {
    if [ -n "${AGENTCTL_RUN:-}" ]; then printf '%s' "$AGENTCTL_RUN"; return 0; fi
    local sib; sib="$(dirname "$(readlink -f "$0")")/agentctl-run"
    if [ -x "$sib" ]; then printf '%s' "$sib"; return 0; fi
    command -v agentctl-run 2>/dev/null || true
}

cmd_run() {
    local role="" harness="" route="" label="" project="" mode="" quiet=0
    local explain=0 dry=0
    local -a watch=() argv=()

    # Option parsing STOPS at the first token we do not own. `agentctl run` exists
    # to carry ANY prompt, and agentctl-run's habit of picking --role out of the
    # middle of a line means a prompt containing that text gets eaten.
    while [ $# -gt 0 ]; do
        case "$1" in
            --role)     shift; role="${1:?--role needs a value}" ;;
            --harness)  shift; harness="${1:?--harness needs a value}" ;;
            --route)    shift; route="${1:?--route needs a value}" ;;
            --label)    shift; label="${1:?--label needs a value}" ;;
            --project)  shift; project="${1:?--project needs a value}" ;;
            --watch)    shift; watch+=("${1:?--watch needs a path}") ;;
            --interactive) mode=interactive ;;
            --headless)    mode=headless ;;
            --explain)  explain=1 ;;
            --dry-run)  dry=1 ;;
            --quiet)    quiet=1 ;;
            --)         shift; argv=("$@"); break ;;
            *)          argv=("$@"); break ;;
        esac
        shift
    done

    local child; child="$(_run_child)"
    [ -n "$child" ] && [ -x "$child" ] || {
        printf 'agentctl: run: agentctl-run not found (is the repo stowed?)\n' >&2
        exit 70   # distinct from 78: "not installed" and "refused" are different alarms
    }

    local -a pass=()
    [ -n "$role" ]    && pass+=(--role "$role")
    [ -n "$harness" ] && pass+=(--harness "$harness")
    [ -n "$route" ]   && pass+=(--route "$route")

    # --explain runs nothing and costs nothing: hand it straight through, record
    # no run. An audit is not an invocation.
    if [ "$explain" -eq 1 ]; then
        exec "$child" "${pass[@]+"${pass[@]}"}" --explain "${argv[@]+"${argv[@]}"}"
    fi

    # Interactive vs headless. agentctl-run exports CLAUDE_HEADLESS=1 and the
    # claude harness justifies BOTH --dangerously-skip-permissions and its
    # "nobody is watching" system prompt solely by "every caller is a timer".
    # At a terminal both premises are false. Ambiguity resolves toward KEEPING
    # the permission gate, because headless is the more permissive mode and a
    # wrong headless guess is loud (a hang) rather than silent.
    if [ -z "$mode" ]; then
        if [ -t 0 ] && [ -t 1 ] && [ -z "${AGENTCTL_NAME:-}" ]; then mode=interactive
        else mode=headless; fi
    fi

    # A headless run with no prompt is a REPL with tools and no human: refuse.
    if [ "$mode" = headless ]; then
        local has_prompt=0 a
        for a in "${argv[@]+"${argv[@]}"}"; do
            case "$a" in -p|--print|-p=*|--print=*) has_prompt=1 ;; esac
        done
        [ "$has_prompt" -eq 1 ] || {
            printf 'agentctl: run: headless with no prompt would start an unattended REPL with tools.\n' >&2
            printf '  pass -p "<prompt>", or --interactive if you meant to drive it yourself.\n' >&2
            exit 64
        }
    fi

    [ "$dry" -eq 1 ] && { printf 'agentctl: run: would exec %s %s\n' "$child" "${pass[*]-}" >&2; return 0; }

    # PREFLIGHT, before any state is allocated. `--explain` resolves the role and
    # harness and applies every fail-closed rule without running a model or
    # touching the network, so an unknown role or an unenforcing harness is
    # refused here for free.
    #
    # A refusal is NOT a run: it gets no directory, because a directory it never
    # used would eat the prune budget and read like an attempt. But the fact that
    # something was refused is exactly what you want to find later, so it still
    # gets one ledger line.
    local pre_rc=0 pre_msg
    pre_msg="$("$child" "${pass[@]+"${pass[@]}"}" --explain 2>&1)" || pre_rc=$?
    if [ "$pre_rc" -ne 0 ]; then
        printf '%s\n' "$pre_msg" >&2
        # shellcheck source=/dev/null
        if [ -r "$RUNS_LIB" ] && . "$RUNS_LIB" 2>/dev/null; then
            runs_ledger_append "$(date -Is)" refused "-" "${label:-}" "${role:-}" \
                "${harness:-claude}" "" "REFUSED" "$pre_rc" "0" "${argv[*]-}" 2>/dev/null || true
        fi
        exit "$pre_rc"
    fi

    # ---- telemetry: from here to the end, every failure is non-fatal ----
    # shellcheck source=/dev/null
    local have_lib=0
    [ -r "$RUNS_LIB" ] && { . "$RUNS_LIB" && have_lib=1; }

    local dir="" id=""
    if [ "$have_lib" -eq 1 ]; then
        dir="$(runs_new 2>/dev/null || true)"
    fi
    if [ -z "$dir" ]; then
        [ "$quiet" -eq 1 ] || printf 'agentctl: run: telemetry unavailable, running anyway\n' >&2
        exec "$child" "${pass[@]+"${pass[@]}"}" "${argv[@]+"${argv[@]}"}"
    fi
    id="$(runs_id_of "$dir")"
    chmod 700 "$dir" 2>/dev/null || true

    [ -n "$project" ] || project="$(_resolve_project "$PWD")"

    runs_meta_write "$dir" \
        "id=$id" "label=${label:-$id}" "role=${role:-}" "harness=${harness:-claude}" \
        "route=${route:-}" "project=${project:-}" "cwd=$PWD" "mode=$mode" \
        "unit=${AGENTCTL_NAME:-}" "supervised=$([ -n "${AGENTCTL_NAME:-}" ] && echo yes || echo no)" \
        "started=$(date +%s)" "git_mark=$(runs_git_mark "$PWD" 2>/dev/null || true)"

    { printf '%q\n' "${argv[@]+"${argv[@]}"}"; } > "$dir/prompt" 2>/dev/null || true
    chmod 600 "$dir/prompt" 2>/dev/null || true

    status_write_dir "$dir" state=working "project=${project:-}" \
        "item=${label:-$id}" "detail=role=${role:-none} harness=${harness:-claude} mode=$mode" 2>/dev/null || true
    printf 'PENDING' > "$dir/last-outcome" 2>/dev/null || true

    local excerpt="${argv[*]-}"; excerpt="${excerpt:0:200}"
    runs_ledger_append "$(date -Is)" start "$id" "${label:-$id}" "${role:-}" \
        "${harness:-claude}" "${project:-}" "" "" "" "$excerpt"
    runs_prune >/dev/null 2>&1 || true
    runs_ledger_trim >/dev/null 2>&1 || true

    [ "$quiet" -eq 1 ] || printf 'agentctl: run %s  role=%s harness=%s mode=%s\n' \
        "$id" "${role:-none}" "${harness:-claude}" "$mode" >&2

    local out="$dir/output.log" rc=0 child_pid tail_pid="" started
    started="$(date +%s)"

    if [ "$mode" = interactive ]; then
        # No capture: the child inherits the real tty. The stall regex is then
        # unavailable, and that is correct -- with a human present, plan mode is
        # not a failure.
        AGENTCTL_INTERACTIVE=1 "$child" "${pass[@]+"${pass[@]}"}" "${argv[@]+"${argv[@]}"}" &
        child_pid=$!
        runs_meta_write "$dir" "pid=$child_pid"
        set +e; wait "$child_pid"; rc=$?; set -e
    else
        : > "$out" 2>/dev/null || true
        "$child" "${pass[@]+"${pass[@]}"}" "${argv[@]+"${argv[@]}"}" >>"$out" 2>&1 &
        child_pid=$!
        runs_meta_write "$dir" "pid=$child_pid"
        # tail --pid, not `| tee`: a pipeline loses $! so signals cannot be
        # forwarded, and process substitution is unreapable so the log may be
        # unflushed when the verdict is scored.
        tail --pid="$child_pid" -n +1 -f "$out" 2>/dev/null &
        tail_pid=$!
        set +e; wait "$child_pid"; rc=$?; set -e
        [ -n "$tail_pid" ] && wait "$tail_pid" 2>/dev/null || true
    fi

    local verdict; verdict="$(runs_verdict "$dir" "$rc" "${watch[@]+"${watch[@]}"}" 2>/dev/null || echo UNKNOWN)"
    local st=ok; [ "$rc" -ne 0 ] && st=error

    printf '%s' "$verdict" > "$dir/last-outcome" 2>/dev/null || true
    status_write_dir "$dir" "state=$st" "detail=exit=$rc outcome=$verdict" 2>/dev/null || true
    printf '[%s] outcome=%s exit=%s\n' "$(date -Is)" "$verdict" "$rc" >> "$dir/activity.log" 2>/dev/null || true
    runs_ledger_append "$(date -Is)" end "$id" "${label:-$id}" "${role:-}" \
        "${harness:-claude}" "${project:-}" "$verdict" "$rc" "$(( $(date +%s) - started ))" ""

    # Supervised: the run is a DETAIL RECORD on a roster row, not a row of its
    # own. Mirroring item/project up costs the runner nothing, and writing a real
    # verdict means _outcome_promote finds a non-PENDING value and leaves it --
    # so every adopter inherits the anti-stall guard nightly-sync went six nights
    # without.
    if [ -n "${AGENTCTL_NAME:-}" ]; then
        status_write "$AGENTCTL_NAME" "project=${project:-}" "item=${label:-$id}" 2>/dev/null || true
        printf '%s' "$verdict" > "$STATE_DIR/$AGENTCTL_NAME/last-outcome" 2>/dev/null || true
    fi

    exit "$rc"   # the child's code, verbatim: the primary contract
}

# Best-effort project name. The canonical resolver lives in shared-hooks; this
# only needs a label, so a miss is empty rather than fatal.
_resolve_project() {
    local d="$1" root
    root="$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)" || return 0
    basename "$root" | sed 's/^\.//'
}

cmd_runs() {
    # shellcheck source=/dev/null
    [ -r "$RUNS_LIB" ] && . "$RUNS_LIB" || die "runs: $RUNS_LIB not found"
    local sub="${1:-list}"; [ $# -gt 0 ] && shift
    local d; d="$(runs_dir)"
    case "$sub" in
        list|-n)
            [ "$sub" = -n ] && set -- "$@"
            local n="${1:-15}"
            [ -d "$d" ] || { echo "no runs yet"; return 0; }
            printf '%-22s %-9s %-10s %-8s %s\n' ID STATE OUTCOME ROLE LABEL
            local p
            while IFS= read -r p; do
                [ -n "$p" ] || continue
                printf '%-22s %-9s %-10s %-8s %s\n' \
                    "$(basename "$p")" "$(runs_state "$p")" "$(runs_outcome "$p")" \
                    "$(runs_meta_get "$p" role)" "$(runs_meta_get "$p" label)"
            done < <(find "$d" -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null | sort -r | head -n "$n")
            ;;
        show)
            local id="${1:?runs show <id>}" p="$d/${1}"
            [ -d "$p" ] || die "runs: no such run '$id'"
            cat "$p/meta" 2>/dev/null
            printf -- '--- status ---\n'; cat "$p/status" 2>/dev/null
            printf -- '--- outcome ---\n%s\n' "$(runs_outcome "$p")"
            ;;
        log)
            local id="${1:?runs log <id>}" p="$d/${1}"; shift || true
            [ -d "$p" ] || die "runs: no such run '$id'"
            if [ "${1:-}" = -f ]; then tail -f "$p/output.log"; else cat "$p/output.log" 2>/dev/null; fi
            ;;
        prune) runs_prune "${1:-}" ; echo "pruned to ${1:-$RUNS_KEEP}" ;;
        *) die "runs: unknown subcommand '$sub' (list|show|log|prune)" ;;
    esac
}

cmd_help() {
    cat <<'EOF'
agentctl — manage named long-running Claude agents via systemd

Usage:
  agentctl run [opts] -- <args>  Run ANY prompt through the role contract, recorded
  agentctl runs [-n N]           List recent runs (show <id> | log <id> | prune)
  agentctl list                  List all configured agents and their state
  agentctl status <name>         Detailed status for one agent
  agentctl report [k=v ...]      Publish this runner's status (runner-side; see below)
  agentctl start <name>          Start agent (oneshot: run now; persistent: spawn)
  agentctl stop <name>           Stop a running agent
  agentctl restart <name>        Restart agent
  agentctl enable <name>         Enable agent (autostart on boot, or arm timer)
  agentctl disable <name>        Disable agent
  agentctl logs <name> [-f]      Tail merged stdout+stderr+inbox (use -f to follow)
  agentctl reload                Rescan agents/, regenerate timers, daemon-reload
  agentctl watch                 Refreshing dashboard (Ctrl-C to exit)

Configs live at ~/.config/agentctl/agents/<name>.conf.
See ~/.config/agentctl/README.md for the schema.

Running something ad-hoc (the front door — prefer this over a bare `claude -p`):
  agentctl run --role plan -p 'what changed in this repo today?'
  agentctl run --role curate --label digest --watch out.md -p "$(cat prompt)"
  agentctl run --harness opencode --role propose --explain

  --role/--harness/--route pass through to agentctl-run, which resolves the
  capability contract and REFUSES rather than degrading. Option parsing stops at
  the first token agentctl does not own, so everything from `-p` onward reaches
  the harness verbatim.

  Two layers, opposite policies: agentctl-run is the capability layer and fails
  CLOSED (exit 78, never degrade); `agentctl run` is the observability layer and
  fails OPEN (a telemetry problem must never break your run). A caller that
  already owns its telemetry — wave-start, skill-refine, watch-companion-loop —
  calls agentctl-run directly; a human, a script, or a conf's COMMAND calls this.

  Exit codes: the harness's own, verbatim. 78 refused. 64 usage. 70 not installed.

The status contract (what a headless runner publishes, and readers consume):
  agentctl report state=working project=bnb-platform item='/kb:sprint resume'
  keys: state(working|idle|ok|blocked|error) project item detail
  Writes MERGE into ~/.local/state/agentctl/<name>/status; the name comes from
  --name or $AGENTCTL_NAME (exported into every unit). start/finish/failure are
  already reported for you by agentctl@.service — a runner only adds the
  semantics systemd cannot know.
EOF
}

# ----------------------------------------------------------------------
# Dispatch
# ----------------------------------------------------------------------

case "${1:-}" in
    list)              cmd_list ;;
    status)            shift; cmd_status "$@" ;;
    report)            shift; cmd_report "$@" ;;
    run)               shift; cmd_run "$@" ;;
    runs)              shift; cmd_runs "$@" ;;
    start)             shift; cmd_start "$@" ;;
    stop)              shift; cmd_stop "$@" ;;
    restart)           shift; cmd_restart "$@" ;;
    enable)            shift; cmd_enable "$@" ;;
    disable)           shift; cmd_disable "$@" ;;
    logs)              shift; cmd_logs "$@" ;;
    reload)            cmd_reload ;;
    watch)             cmd_watch ;;
    help|--help|-h|"") cmd_help ;;
    *)                 die "unknown subcommand: $1 (see 'agentctl help')" ;;
esac
