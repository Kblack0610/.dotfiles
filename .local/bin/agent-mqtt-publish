#!/usr/bin/env bash
# agent-mqtt-publish - mirror the agent fleet's status into Home Assistant over MQTT.
#
#   agent-mqtt-publish            publish what changed since the last run
#   agent-mqtt-publish --full     republish everything (the timer; refreshes expire_after)
#   agent-mqtt-publish --dry-run  print `topic<TAB>payload` lines, touch nothing
#
# Two topics are not HA entities: agents/<host>/summary/bar, the lease holder's `hub bar --json` for the chip
# hovers, and agents/<host>/summary/feed, whether this host holds the fleet lease (feed_lines).
# Entities use HA MQTT discovery: runners, watches, open asks, the dispatch queue, the pager, live sessions, the fleet overview and the fleet cards (hub's widget document) appear as
# sensors with no HA-side config, and one that disappears is deleted, not left as a ghost.
# mqtt2prom keeps only numeric and boolean keys, so each text fact Prometheus needs has a
# number beside it: runner updated_epoch, duration_s (the main process of the last run, null
# while one runs) and outcome_code (0 ok: WORKED, NOOP; 1 warn: BLOCKED, PENDING; 2 fail:
# FAILED, STALLED; null when none is recorded), and watch since_epoch.
# Triggers: agentctl after every status write, sentinel on a watch state change, and
# agent-mqtt-publish.timer (--full, every 5 minutes).
# Broker comes from ~/.config/agent-mqtt.env (private overlay); with none set this is a no-op.
set -uo pipefail

CONF="${AGENT_MQTT_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/agent-mqtt.env}"
# shellcheck disable=SC1090
[ -f "$CONF" ] && . "$CONF"

# Same env names as fleet.sh, the other reader of these roots.
CONFIG_DIR="${AGENTCTL_CONF_DIR:-$HOME/.config/agentctl/agents}"
STATE_DIR="${AGENTCTL_STATE_DIR:-${AGENTCTL_STATE:-$HOME/.local/state/agentctl}}"
WATCHES="${WATCH_DIR:-${SENTINEL_WATCHES:-$HOME/.agent/watches}}"
WSTATE="${WATCH_STATE_DIR:-${SENTINEL_STATE:-$HOME/.local/state/watch-companion}}"
CACHE="${AGENT_MQTT_CACHE:-$HOME/.local/state/agent-mqtt}"
BAR_TIMEOUT="${AGENT_MQTT_BAR_TIMEOUT:-20}" # seconds `hub bar --json` may run: it makes agent-queue calls, so a locked store must not hold the publish lock
READER_TTL=45 # seconds: under fleet-state.timer's minute, so the slow readers render at least once a tick
# Same staleness rule fleet.sh uses (one lib, so the two never disagree).
_WATCH_LIB="${SENTINEL_WATCH_LIB:-$HOME/.local/lib/sentinel-watch.sh}"
[ -r "$_WATCH_LIB" ] || _WATCH_LIB="$(dirname "$(realpath "$0")")/../lib/sentinel-watch.sh"
# shellcheck source=/dev/null
. "$_WATCH_LIB"
MQTT_HOST="${AGENT_MQTT_HOST:-}"
MQTT_PORT="${AGENT_MQTT_PORT:-1883}"
# Per-message guard on the broker call, so a dead broker fails fast. It does not bound the
# whole run (the snapshot scan and lock wait are outside it); agentctl's status hook does
# that with its own timeout, since it runs inside a runner's lifecycle.
PUB_TIMEOUT="${AGENT_MQTT_TIMEOUT:-3}"
# A broker miss (a restart, a dropped connection) is retried on the same message before the
# run gives up: RETRIES more attempts, BACKOFF whole seconds before the first, doubling. A
# retained publish is idempotent, so a repeat cannot act twice. Any failed call is retried: a
# refused connection and a timeout look alike. A dead broker still fails, after
# (RETRIES+1) x PUB_TIMEOUT plus the backoffs (about 12s at the defaults); the 5-min timer
# catches up on what was not sent. agentctl's status hook sets RETRIES=0: its 5s budget is
# shorter than that window.
PUB_RETRIES="${AGENT_MQTT_RETRIES:-2}"
PUB_BACKOFF="${AGENT_MQTT_BACKOFF:-1}"
[[ "$PUB_RETRIES" =~ ^[0-9]+$ ]] || PUB_RETRIES=2
[[ "$PUB_BACKOFF" =~ ^[0-9]+$ ]] || PUB_BACKOFF=1
# 3x the timer cadence (agent-mqtt-publish.timer, 5 min): a workstation that is off or
# asleep turns its sensors `unavailable` instead of leaving them stale-but-green.
EXPIRE_AFTER=900

mode=diff quiet=0
for a in "$@"; do
    case "$a" in
        --full) mode=full ;;
        --dry-run) mode=dry ;;
        --quiet) quiet=1 ;;
        -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) printf 'agent-mqtt-publish: unknown arg %s\n' "$a" >&2; exit 2 ;;
    esac
done

# Tilecast push: a poke to agent-web, which pushes "fetch now" to the phone widget when what it
# draws changed, at most once every 30s (agent-web src/push.rs). It goes before the broker check,
# since it needs no broker, and in the background with a short timeout, so a stopped agent-web
# never slows a hook. No widget key, no poke. The key goes on stdin, out of argv.
poke_widget_push() {
    local key
    key="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/agent-web/widget.token" 2>/dev/null)" || return 0
    # A key with anything but token characters would break the quoted config line below.
    case "$key" in "" | *[!A-Za-z0-9_-]*) return 0 ;; esac
    command -v curl >/dev/null 2>&1 || return 0
    printf 'header = "Authorization: Bearer %s"\n' "$key" |
        curl -sS -o /dev/null -m 2 -X POST -K - "${AGENT_WEB_URL:-http://127.0.0.1:8790}/widget/push-send" \
            >/dev/null 2>&1 &
}
[ "$mode" = dry ] || poke_widget_push

[ "$mode" = dry ] || [ -n "$MQTT_HOST" ] || exit 0

say() { [ "$quiet" = 1 ] || printf 'agent-mqtt-publish: %s\n' "$*" >&2; }

# Topic-safe id: lowercase, [a-z0-9_] only.
slug() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_\n' '_'; }

HOST_NAME="${AGENT_MQTT_HOST_ID:-$(uname -n | cut -d. -f1)}"
HOST_ID="$(slug "$HOST_NAME")"

# epoch -> ISO 8601, or empty for anything that is not a positive integer.
iso() { [[ "${1:-}" =~ ^[1-9][0-9]*$ ]] && date -d "@$1" -Iseconds 2>/dev/null; }

# systemd's human timestamp ("Thu 2026-09-17 20:30:00 PDT") -> ISO 8601, or empty.
iso_ts() { [ -n "${1:-}" ] && [ "$1" != n/a ] && date -d "$1" -Iseconds 2>/dev/null; }

# epoch -> itself as a JSON number, or null for anything that is not a positive integer.
num() { if [[ "${1:-}" =~ ^[1-9][0-9]*$ ]]; then printf '%s' "$1"; else printf null; fi; }

kv() { awk -F= -v k="$2" '$1 == k { sub(/^[^=]*=/, ""); print; exit }' "$1" 2>/dev/null; }

unit_prop() { systemctl --user show "$1" -p "$2" --value 2>/dev/null; }

# last_run_secs <unit> -> seconds its last run took, from systemd's monotonic start and exit
# stamps; null while it runs (exit is from an earlier run) or when it never ran.
last_run_secs() {
    local start end
    start="$(unit_prop "$1" ExecMainStartTimestampMonotonic)"
    end="$(unit_prop "$1" ExecMainExitTimestampMonotonic)"
    if [[ "$start" =~ ^[1-9][0-9]*$ && "$end" =~ ^[0-9]+$ ]] && [ "$end" -ge "$start" ]; then
        printf '%s' $(((end - start) / 1000000))
    else
        printf null
    fi
}

# emit <kind> <name> <icon> <state-json> [extra-discovery-json]
# Prints the discovery message then the state message, as `topic<TAB>payload`.
emit() {
    local kind="$1" name="$2" icon="$3" state="$4" extra="${5:-{\}}"
    local id eid uid base label="$name"
    id="$(slug "$name")"
    case "$kind" in
        runner)  eid="agent_$id" ;;
        watch)   eid="agent_watch_$id" ;;
        sessions) eid="agent_sessions_$id" ;;
        *)       eid="agent_$id"
                 case "$id" in asks_open) label="Open asks" ;; sessions) label="Live sessions" ;;
                     dispatch) label="Dispatch queue" ;; shepherd) label="Shepherd due lines" ;; pager) label="Pages undelivered (24h)" ;;
                     overview) label="Fleet overview" ;; cards) label="Fleet cards" ;; esac ;;
    esac
    uid="agent_${HOST_ID}_${kind}_${id}"
    base="agents/$HOST_ID/$kind/$id"
    jq -cn --arg name "$label" --arg uid "$uid" --arg eid "sensor.$eid" --arg t "$base" \
        --arg icon "$icon" --arg host "$HOST_ID" --arg hostname "$HOST_NAME" --argjson exp "$EXPIRE_AFTER" \
        --argjson extra "$extra" '{
            name: $name, unique_id: $uid, default_entity_id: $eid,
            state_topic: $t, value_template: "{{ value_json.state }}",
            json_attributes_topic: $t, expire_after: $exp, icon: $icon,
            device: {identifiers: ["agent_fleet_\($host)"], name: "Agent fleet (\($hostname))",
                     manufacturer: "agentctl", model: "agent-mqtt-publish"}
        } + $extra' | sed "s|^|homeassistant/sensor/$uid/config\t|"
    printf '%s\t%s\n' "$base" "$state"
}

# hand_fired <conf> -> 0 when nothing starts the runner on a clock: no SCHEDULE and no
# AUTOSTART=yes, the SCHEDULE/AUTOSTART test of fleet-bench's scheduled_runner. Its last
# verdict is one old run's, so it is not a fault the Overview row can clear.
hand_fired() {
    ! grep -qE '^(SCHEDULE=["'"'"']?[^"'"'"' ]|AUTOSTART=["'"'"']?yes)' "$1"
}

# slow_reader <fd var> <kind/id> <cmd...> -> sets <fd var> to an fd that yields the command's output,
# started now and printed only on success; or, outside a dry run, the last payload sent on that topic
# when it is younger than READER_TTL.
slow_reader() {
    local var="$1" sent fd; sent="$(tfile "agents/$HOST_ID/$2")"; shift 2
    if [ "$mode" != dry ] && [ -f "$sent" ] && (($(date +%s) - $(date -r "$sent" +%s) < READER_TTL)); then
        exec {fd}< "$sent"
    else
        exec {fd}< <(out="$("$@" 2>/dev/null)" && printf '%s' "$out")
    fi
    printf -v "$var" '%s' "$fd"
}

# dispatch_here -> rc 0 when this machine sends summary/dispatch. It describes the fleet's one queue,
# so only the lease holder sends it: a peer whose store clone stopped syncing (cachyos-rog, frozen
# since 2026-11-15) sent 622 queued, and the chip's max over hosts showed it (ar-4306). fans_out in
# fleet-dispatch reads the lease the same way.
dispatch_here() { command -v fleet-dispatch >/dev/null 2>&1 && fleet-lease held >/dev/null 2>&1; }

# bar_here -> rc 0 when this machine reads the lease holder's views, summary/bar and summary/cards: `hub bar --json`
# reads its queue, fleet state and dispatch snapshot (ar-4362), and the cards chip takes only its figures.
bar_here() { command -v hub >/dev/null 2>&1 && fleet-lease held >/dev/null 2>&1; }

# overview_lines <fd> -> the HA sensor lines for `hub phone --json` read from <fd>, the phone widget's
# rows. They ride as attributes because an HA state over 255 chars is rejected; the state is the worst
# row. A run within READER_TTL of the last send repeats it (slow_reader), and PROM_TIMEOUT keeps a dead
# Prometheus out of a hooked run. Closes <fd>; prints nothing when the document has no rows.
overview_lines() {
    local fd="$1" overview
    overview="$(cat <&"$fd")"; exec {fd}<&-
    jq -e '.rows | arrays' <<< "$overview" >/dev/null 2>&1 &&
        emit summary overview mdi:view-dashboard "$overview"
}

# bar_lines <fd> -> the summary/bar line for `hub bar --json` read from <fd>, what the waybar and
# noctalia chip hovers lay out (sessions worst first, the ready items, the top cleared candidates).
# Retained on its own topic with no HA discovery: the chips read it with mosquitto_sub, and a hub that
# fails or prints no sessions list sends nothing, so the chips see no topic rather than an old one.
# Closes <fd>.
bar_lines() {
    local fd="$1" bar
    bar="$(cat <&"$fd")"; exec {fd}<&-
    jq -e '.sessions | arrays' <<< "$bar" >/dev/null 2>&1 &&
        printf '%s\t%s\n' "agents/$HOST_ID/summary/bar" "$(jq -c . <<< "$bar")"
}

# cards_lines <fd> -> the summary/cards lines for `hub cards --json --figures` read from <fd>: Home's
# cards as the widget document /widget.json serves plus `figures`, their whole numbers by name, so every
# figure on a snapshot surface is hub-core's own and carries `updated_at`. The document rides as
# attributes (its `state` is the worst card's level). mqtt2prom drops the text and keeps `figures` as
# mqtt_figures_<tab>_<label>, which the waybar agents and health chips read; the queue chip reads the
# document itself. No sections, no lines.
cards_lines() {
    local fd="$1" cards
    cards="$(cat <&"$fd")"; exec {fd}<&-
    jq -e '.sections | arrays' <<< "$cards" >/dev/null 2>&1 &&
        emit summary cards mdi:view-grid "$cards"
}

# feed_lines -> the summary/feed line: {"lease_holder": true|false}, from `fleet-lease held`. mqtt2prom
# exports it as mqtt_lease_holder, so home-config's AgentFeedFrozen counts only the holder's feed and a
# no-lease peer's event publish cannot hide a dead holder (ar-3920, the gap home-config #1314 named).
# Every host sends it, a peer false rather than nothing: an exporter keeps a gauge whose topic stops, so a
# former holder's retained true must be overwritten. The payload is stable, so a diff run sends it only on
# a lease change and the holder's 5-min --full run is the heartbeat the rule reads.
feed_lines() {
    local held=false
    fleet-lease held >/dev/null 2>&1 && held=true
    printf '%s\t{"lease_holder":%s}\n' "agents/$HOST_ID/summary/feed" "$held"
}

snapshot() {
    local f name st dfd='' ofd='' cfd='' bfd=''

    # The slow readers (fleet-dispatch stats, hub phone, hub bar, hub cards: 2s to 21s at load) start here
    # and run while the runner and watch loops do, so a run costs the slowest, not the sum (ar-1753). A run
    # within READER_TTL of a reader's last send repeats that send: hooks fire many times a minute, and
    # each re-running the readers under the lock starved the --full timer run past its 60s (ar-2310).
    dispatch_here && slow_reader dfd summary/dispatch fleet-dispatch stats
    command -v hub >/dev/null 2>&1 && slow_reader ofd summary/overview env PROM_TIMEOUT=3 hub phone --json
    bar_here && slow_reader bfd summary/bar timeout "$BAR_TIMEOUT" hub bar --json
    bar_here && slow_reader cfd summary/cards timeout 25 env PROM_TIMEOUT=3 hub cards --json --figures

    # Runners: the roster is the conf dir, so a retired runner drops out of HA with its conf.
    for f in "$CONFIG_DIR"/*.conf; do
        [ -f "$f" ] || continue
        name="$(basename "$f" .conf)"
        st="$STATE_DIR/$name/status"
        local state updated hand=false; state="$(kv "$st" state)"; updated="$(kv "$st" updated)"
        hand_fired "$f" && hand=true
        emit runner "$name" mdi:robot "$(jq -cn \
            --arg state "${state:-unknown}" \
            --arg project "$(kv "$st" project)" \
            --arg item "$(kv "$st" item)" \
            --arg detail "$(kv "$st" detail)" \
            --arg updated "$(iso "$updated")" --argjson updated_epoch "$(num "$updated")" \
            --argjson duration "$(last_run_secs "agentctl@$name.service")" \
            --arg outcome "$(cat "$STATE_DIR/$name/last-outcome" 2>/dev/null)" \
            --argjson hand "$hand" \
            --arg active "$(unit_prop "agentctl@$name.service" ActiveState)" \
            --arg next "$(iso_ts "$(unit_prop "agentctl-$name.timer" NextElapseUSecRealtime)")" \
            '{state: $state, project: $project, item: $item, detail: $detail,
              updated: (if $updated == "" then null else $updated end),
              last_outcome: $outcome, unit: $active,
              next_run: (if $next == "" then null else $next end),
              # Booleans, because mqtt2prom drops text: these are what Prometheus sees.
              # A hand-fired runner (no clock) keeps one old verdict: only its state can fail it.
              failed: ($state == "error" or (($hand | not) and ($outcome == "STALLED" or $outcome == "FAILED"))),
              # Waiting on a human is not a failure, but it is the one state worth a glance.
              blocked: ($state == "blocked" or $outcome == "BLOCKED"),
              running: ($active == "active" or $active == "activating"),
              updated_epoch: $updated_epoch, duration_s: $duration,
              outcome_code: ({WORKED: 0, NOOP: 0, BLOCKED: 1, PENDING: 1, FAILED: 2, STALLED: 2}[$outcome])}')"
    done

    # Watches: the registry is the manifest dir; a paused manifest stays visible as paused.
    local qnow; qnow="$(date +%s)"   # once a pass: each watch's quarantine is in force while UNTIL is ahead
    for f in "$WATCHES"/*.yaml "$WATCHES"/*.yaml.paused; do
        [ -f "$f" ] || continue
        name="$(basename "$f")"; name="${name%.paused}"; name="${name%.yaml}"
        local ws paused=false lr stale=false since quarantined=false
        ws="$(cat "$WSTATE/$name.state" 2>/dev/null)"
        watch_quarantined "$WSTATE" "$name" "$qnow" && quarantined=true
        since="$(cat "$WSTATE/$name.since" 2>/dev/null)"
        lr="$(cat "$WSTATE/$name.lastrun" 2>/dev/null)"
        case "$f" in *.paused) paused=true; ws=PAUSED ;; esac
        # A paused watch is not polled on purpose, so it is never stale.
        [ "$paused" = false ] && watch_is_stale "$f" "$lr" && stale=true
        emit watch "$name" mdi:eye "$(jq -cn \
            --arg state "${ws:-NEW}" --argjson paused "$paused" --argjson stale "$stale" \
            --arg severity "$(watch_severity "$f")" \
            --arg since "$(iso "$since")" --argjson since_epoch "$(num "$since")" \
            --arg lastrun "$(iso "$lr")" --argjson quarantined "$quarantined" \
            '{state: $state, paused: $paused,
              since: (if $since == "" then null else $since end),
              last_run: (if $lastrun == "" then null else $lastrun end),
              tripped: ($state == "TRIP" or $state == "ERROR"), stale: $stale, since_epoch: $since_epoch,
              # The manifest severity, ranked because mqtt2prom drops text: the command-center
              # catch-all reads mqtt_severity_rank to warn on a tripped low watch instead of going red.
              severity: $severity, severity_rank: {low: 1, normal: 2, high: 3, urgent: 4}[$severity],
              # A red its owner took on with an expiry: the rollup counts it a warning, not down.
              quarantined: ($quarantined and ($state == "TRIP" or $state == "ERROR"))}')"
    done

    # Open asks: questions an agent is blocked on until the human answers.
    if command -v agent-ask >/dev/null 2>&1; then
        # Its own list: `agent-ask count --all` is Home's Question figure now, a hub read this
        # publisher must not wait on. The sensor retires with ar-4397.
        emit summary asks_open mdi:account-question "$(agent-ask list --all --pending 2>/dev/null |
            jq -cR -s '
              [split("\n")[] | select(length > 0) | split("\t")
                | {id: .[0], project: .[1], kind: .[4], question: (.[5] // "" | .[0:160])}] as $a
              | {state: ($a | length), asks: $a}')" \
            '{"state_class":"measurement"}'
    fi

    # Dispatch: runnable queue work, starts and reaps in the last hour, flapping items, as
    # fleet-dispatch itself counts them (`fleet-dispatch stats`); nothing is derived here. A queue
    # it cannot read publishes nothing, so the sensor goes unavailable at expire_after.
    if [ -n "$dfd" ]; then
        local dstats
        dstats="$(cat <&"$dfd")"; exec {dfd}<&-
        jq -e '.runnable | numbers' <<< "$dstats" >/dev/null 2>&1 &&
            emit summary dispatch mdi:tray-full "$dstats" '{"state_class":"measurement"}'
    fi

    # Shepherd: open, unhandled and skipped due lines, 24h nudges, escalations and passes, the pass
    # running now (id, age, attach line), the last verdict and whether it is stuck, as `fleet-shepherd
    # stats` reads them from its ledgers. HA gets every field as an attribute; the state is the open due lines.
    if command -v fleet-shepherd >/dev/null 2>&1; then
        local sstats
        sstats="$(fleet-shepherd stats 2>/dev/null)" && jq -e '.due | numbers' <<< "$sstats" >/dev/null 2>&1 &&
            emit summary shepherd mdi:sheep "$sstats" '{"state_class":"measurement"}'
    fi

    # Pager: what agent-notify raised and which channel took it in the last 24h, as
    # `agent-notify stats` counts it; the HA state is undelivered_24h, pages that reached nobody.
    # No agent-notify, or output with no count, publishes nothing rather than a zero.
    if command -v agent-notify >/dev/null 2>&1; then
        local pstats
        pstats="$(agent-notify stats 2>/dev/null)" && jq -e '.undelivered_24h | numbers' <<< "$pstats" >/dev/null 2>&1 &&
            emit summary pager mdi:bell-alert "$(jq -c '{state: .undelivered_24h} + .' <<< "$pstats")" '{"state_class":"measurement"}'
    fi

    [ -n "$ofd" ] && overview_lines "$ofd"
    [ -n "$bfd" ] && bar_lines "$bfd"
    [ -n "$cfd" ] && cards_lines "$cfd"

    # Interactive sessions: live Claude panes from `agent-panel list`. Glyphs are agent-panel's
    # own: `~` working, `!` needs you, anything else idle. One summary sensor, plus one sensor
    # per project.
    # The delivery bucket (NEEDS, LANDED, STALLED, ...) is read from the fleet state document,
    # never worked out here: agent-panel is the live tier, the document the slower one, and
    # a session the document has not seen yet has bucket null.
    if command -v agent-panel >/dev/null 2>&1; then
        local sessions proj fleet buckets
        fleet="${FLEET_STATE_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/fleet/state.json}"
        # main_red: repos whose default branch is red, the document's main[] (a widget line).
        # zero: every bucket at 0, so `buckets` names each one and an emptied bucket reads 0,
        # not its last count (an exporter keeps a gauge whose key stops arriving).
        # shepherd: the fleet-shepherd pass's pane (label shepherd), which is not an agent session.
        buckets="$(jq -c '{at: .generated_at, by: (.sessions | map({key: .target, value: .bucket}) | from_entries),
                           shepherd: [.sessions[] | select((.labels // []) | index("shepherd")) | .target],
                           main_red: [.main[]?.repo], zero: (.counts // {} | map_values(0))}' \
            "$fleet" 2>/dev/null)" || buckets='{"at":null,"by":{},"shepherd":[],"main_red":[]}'
        sessions="$(agent-panel list 2>/dev/null | jq -cR -s --argjson f "$buckets" '
            [split("\n")[] | select(length > 0) | split("\t")
             | select(.[0] as $t | ($f.shepherd // []) | index($t) | not)
             | {target: .[0], glyph: .[1], project: .[2], title: .[3],
                status: (if .[1] == "~" then "working" elif .[1] == "!" then "attention" else "idle" end),
                bucket: ($f.by[.[0]] // null)}]')"
        emit summary sessions mdi:console "$(jq -c --argjson f "$buckets" '
            {state: length, working: map(select(.status == "working")) | length,
             attention: map(select(.status == "attention")) | length,
             buckets: ({unknown: 0} + $f.zero + (map(.bucket // "unknown") | group_by(.) | map({(.[0]): length}) | add // {})),
             fleet_state_at: $f.at, main_red: $f.main_red, sessions: .}' <<< "$sessions")" \
            '{"state_class":"measurement"}'
        # State is the group's most urgent status, so a widget or automation can key on it.
        while IFS= read -r proj; do
            emit sessions "$proj" mdi:console-line "$(jq -c --arg p "$proj" '
                map(select(.project == $p)) as $g
                | {state: (if any($g[]; .status == "attention") then "attention"
                           elif any($g[]; .status == "working") then "working" else "idle" end),
                   project: $p, glyphs: ($g | map(.glyph) | join("")), count: ($g | length),
                   working: ($g | map(select(.status == "working")) | length),
                   attention: ($g | map(select(.status == "attention")) | length),
                   needs: ($g | map(select(.bucket == "NEEDS")) | length),
                   sessions: ($g | map({target, status, bucket, title}))}' <<< "$sessions")"
        done < <(jq -r 'map(.project) | unique[]' <<< "$sessions")
    fi
}

# Cache: one file per topic holding the last payload the broker accepted. It decides what
# a diff run sends, and it is the record of what exists in HA, so an entity whose topic is
# no longer in the snapshot can be deleted. Filenames are the topic with / -> %.
tfile() { printf '%s/sent/%s' "$CACHE" "${1//\//%}"; }

publish() {
    local i
    for ((i = 0; i <= PUB_RETRIES; i++)); do
        # Backoff, not a wait on a signal: the broker has no event to await.
        [ "$i" -gt 0 ] && sleep $((PUB_BACKOFF << (i - 1)))
        timeout "$PUB_TIMEOUT" mosquitto_pub -h "$MQTT_HOST" -p "$MQTT_PORT" -q 1 -r \
            -t "$1" -m "$2" 2>/dev/null && return 0
    done
    return 1
}

main() {
    local snap topic payload f

    if [ "$mode" = dry ]; then
        snapshot; feed_lines
        return 0
    fi

    command -v mosquitto_pub >/dev/null 2>&1 || { say "mosquitto_pub not installed"; return 1; }
    mkdir -p "$CACHE/sent"

    # One run at a time, so two hooks firing together cannot interleave cache writes. Each
    # waiter re-reads the state after it gets the lock, so the last writer always wins. A
    # waiter behind a slow --full run gives up after 20s and exits 0: the 5-minute --full run
    # republishes everything, and the next fleet-state pass any change.
    exec 9>"$CACHE/lock"
    flock -w 20 9 || { say "lock busy"; return 0; }
    snap="$(snapshot; feed_lines)"

    local -A want=()
    local sent=0 reloaded=0
    while IFS=$'\t' read -r topic payload; do
        [ -n "$topic" ] || continue
        want["$topic"]=1
        f="$(tfile "$topic")"
        # emit() prints each entity's config line right before its state line. A config
        # (re)send makes HA reload the entity, and with expire_after set it ignores the
        # retained state, so the state is always resent after a config.
        if [ "$mode" = diff ] && [ "$reloaded" = 0 ] && [ -f "$f" ] && [ "$(cat "$f")" = "$payload" ]; then
            continue
        fi
        case "$topic" in */config) reloaded=1 ;; *) reloaded=0 ;; esac
        # Stop at the first failed publish (after its retries): a dead broker would otherwise cost
        # that whole window per topic.
        publish "$topic" "$payload" || { say "publish failed ($MQTT_HOST:$MQTT_PORT)"; return 1; }
        printf '%s' "$payload" > "$f"
        sent=$((sent + 1))
    done <<< "$snap"

    # Deletions: an empty retained payload removes both the HA entity (config topic) and
    # the broker's retained state.
    for f in "$CACHE/sent/"*; do
        [ -f "$f" ] || continue
        topic="$(basename "$f")"; topic="${topic//%//}"
        [ -n "${want[$topic]:-}" ] && continue
        publish "$topic" "" || { say "publish failed ($MQTT_HOST:$MQTT_PORT)"; return 1; }
        rm -f "$f"
        sent=$((sent + 1))
    done

    say "$mode: $sent message(s) sent"
}

main
