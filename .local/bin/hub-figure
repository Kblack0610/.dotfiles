#!/usr/bin/env bash
# hub-figure - one number from a hub-core card, for a script that must not count it again.
#
# Usage: hub-figure [--fresh] [NAME]
#
# NAME is a figure of a card, as `hub cards --json --figures` names it. needs_* is Home's Needs you
# card, read from `hub needs --json`: needs_headline (the default, every row Home lists as waiting
# on the human), needs_only_you (less the asks the judge left to a machine), needs_question,
# needs_blocked, needs_to_do, needs_your_turn. A kind with no rows reads 0 (the card leaves a zero
# kind out). Any other name is read from `hub cards --json --figures`: sessions_headline (live
# sessions, every host, less the fleet's own), sessions_working, sessions_need_you, sessions_stalled,
# sessions_ready_to_close; done_shipped and done_checks (queue items closed today with and without a
# merge; done_headline is the day-log record's PRs merged); costs_headline (the fleet cost over 24h,
# agent-usage fleet-cost, whole dollars), costs_measured and costs_estimated, its two parts. A card
# figure absent from the answer is a card whose reader failed.
# Prints "?" and exits 1 when the count cannot be read, and for a Needs you 0 counted while a read
# failed (`errors` in `hub needs --json`): never a made-up 0 (dashboards.md rule 6).
#
# `hub needs --json` reads the whole fleet (about 4s, 11s under load) and `hub cards` about 10s, so
# a caller that ticks, the tmux status bar every few seconds, would start a hub per tick. This keeps
# the last answer of each in $HUB_FIGURE_CACHE (the cards answer beside it, `$HUB_FIGURE_CACHE.cards`): an answer
# younger than $HUB_FIGURE_TTL seconds is served as is, an older one is served while ONE background
# hub (flock) replaces it, and one older than $HUB_FIGURE_MAX_AGE is not served at all: the reader
# waits for a fresh count, and prints "?" when that fails. --fresh always waits for a fresh count (a
# page, a report). With nothing to serve, one caller reads hub and the rest wait for it; a failed
# read holds every other read off for $HUB_FIGURE_BACKOFF seconds, so a hub that is down is asked
# once, not once per tick.
#
# Env: HUB_FIGURE_HUB (the hub binary), HUB_FIGURE_CACHE, HUB_FIGURE_TTL (default 60),
# HUB_FIGURE_MAX_AGE (default 900, the stale limit of waybar's needs chip), HUB_FIGURE_BACKOFF
# (default 30), HUB_FIGURE_LOCK_WAIT (default 30).

set -u

HUB="${HUB_FIGURE_HUB:-hub}"
CACHE="${HUB_FIGURE_CACHE:-${XDG_RUNTIME_DIR:-/tmp}/hub-figure.$(id -u).json}"
TTL="${HUB_FIGURE_TTL:-60}"
MAX_AGE="${HUB_FIGURE_MAX_AGE:-900}"
BACKOFF="${HUB_FIGURE_BACKOFF:-30}"   # seconds after a failed hub read before another is started
LOCK_WAIT="${HUB_FIGURE_LOCK_WAIT:-30}"   # the longest a caller waits on another caller's hub read

fresh=0
[ "${1:-}" = "--fresh" ] && { fresh=1; shift; }
case "${1:-}" in -h | --help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; esac
name="${1:-needs_headline}"

# The source of a figure is its card: the Needs you card has its own export (rows and errors beside
# the figures), every other card comes out of the cards export.
case "$name" in
  needs_*) kind=needs ;;
  *) kind=cards; CACHE="$CACHE.cards" ;;
esac
FAIL="$CACHE.fail"

age_of() { local m; m="$(stat -c %Y "$CACHE" 2>/dev/null)" || return 1; echo $(($(date +%s) - m)); }
failed_lately() { local m; m="$(stat -c %Y "$FAIL" 2>/dev/null)" || return 1; [ $(($(date +%s) - m)) -lt "$BACKOFF" ]; }

# fetch: one `hub needs --json` or `hub cards --json --figures` into the cache, atomically; false
# when hub failed or gave no figures, and the old answer stays.
fetch() {
  local tmp out
  tmp="$(mktemp "$CACHE.XXXXXX")" || return 1
  if [ "$kind" = needs ]; then out="$("$HUB" needs --json 2>/dev/null)"; else out="$("$HUB" cards --json --figures 2>/dev/null)"; fi
  if jq -e '.figures | objects' >/dev/null 2>&1 <<<"$out"; then
    printf '%s' "$out" | jq -c '{figures, errors}' >"$tmp" && mv "$tmp" "$CACHE" && { rm -f "$FAIL"; return 0; }
  fi
  rm -f "$tmp"; touch "$FAIL"
  return 1
}

serve() {
  if [ "$kind" = cards ]; then
    jq -r --arg n "$name" '(.figures // {})[$n] | if type == "number" then . else "?" end' "$CACHE" 2>/dev/null
    return
  fi
  jq -r --arg n "$name" '
    (.figures // {}) as $f | (.errors // []) as $e
    | if ($f.needs_headline | type) != "number" then "?"
      else ($f[$n] // 0) as $v | if $v == 0 and ($e | length) > 0 then "?" else $v end end' "$CACHE" 2>/dev/null
}

age="$(age_of)" || age=""
if [ "$fresh" = 1 ]; then
  fetch || { echo '?'; exit 1; }
elif [ -z "$age" ] || [ "$age" -gt "$MAX_AGE" ]; then
  # Nothing to serve. One hub at a time: a caller that loses the lock waits for the winner and
  # serves what it fetched, and after a failure none starts another hub for FAIL_BACKOFF seconds.
  failed_lately && { echo '?'; exit 1; }
  ( flock -w "$LOCK_WAIT" 9 || exit 1
    a="$(age_of)" && [ "$a" -le "$TTL" ] && exit 0
    fetch ) 9>"$CACHE.lock" || { echo '?'; exit 1; }
elif [ "$age" -gt "$TTL" ] && ! failed_lately; then
  # One refresher at a time: a tick that loses the lock serves the cache and moves on.
  ( flock -n 9 || exit 0; fetch ) 9>"$CACHE.lock" >/dev/null 2>&1 &
fi

out="$(serve)"
[ -n "$out" ] || out='?'
echo "$out"
[ "$out" != '?' ]
