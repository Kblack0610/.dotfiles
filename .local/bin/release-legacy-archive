#!/usr/bin/env bash
# release-legacy-archive - the ledger of a project's legacy releases, and their run logs on the NAS.
#
#   release-legacy-archive [--dry-run] [--no-logs] <project>
#
# Covers <project> and the projects whose registry `repo` is it. Writes, whole, the lab project's
# versions/legacy.md (legacy tags, release runs, Deployments) and copies each legacy run's log zip
# to $RELEASE_ARCHIVE_DIR/<project>/<run-id>.zip once. Legacy is release-state's provenance, read
# through `release-state provenance`, never recomputed. Deletes nothing. --dry-run prints the
# ledger and writes nothing; --no-logs copies no zip. Exit 1 when a log failed for a reason other
# than expiry, so a rerun picks it up. Rules: docs/operations/release-state.md, Legacy archive.
set -uo pipefail

HERE="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
PROJECT_NAME_LIB="${PROJECT_NAME_LIB:-$HERE/../../.config/shared-hooks/project-name.sh}"
# shellcheck source=../../.config/shared-hooks/project-name.sh
. "$PROJECT_NAME_LIB"
# shellcheck source=../lib/origin-repo.sh
. "$HERE/../lib/origin-repo.sh"
RELEASE_STATE="${RELEASE_STATE:-$HERE/release-state}"

ARCHIVE_DIR="${RELEASE_ARCHIVE_DIR:-/mnt/nas/private/releases/legacy}"
# Timeout guards, in seconds: one API page or status, and one log zip download.
API_TIMEOUT=30
LOG_TIMEOUT=300
GH_PAGE=100

die() { echo "release-legacy-archive: $*" >&2; exit 2; }
usage() { sed -n '4,4p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-2}"; }

dry=0 logs=1 proj=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry=1 ;;
    --no-logs) logs=0 ;;
    -h|--help) usage 0 ;;
    -*) usage ;;
    *) [ -z "$proj" ] || usage; proj="$1" ;;
  esac
  shift
done
[ -n "$proj" ] || usage
command -v jq >/dev/null 2>&1 || die "jq is not installed"
MAP="$(project_map_file)"
[ -f "$MAP" ] || die "no project map"

repo_key="$(project_repo_name "$proj")"
repo="$(project_repo_path "$proj")"
[ -n "$repo" ] && [ -d "$repo/.git" ] || die "$proj has no checkout"
slug="$(origin_repo "$repo" github.com)" || slug=""
[ -n "$slug" ] || die "$proj's checkout has no GitHub origin, so no runs or Deployments to read"
lab="$(project_field "$proj" lab)"
[ -n "$lab" ] || die "$proj has no lab, so no versions/ to write the ledger in"
root="$(notes --profile "$lab" path projects 2>/dev/null)" || root=""
[ -n "$root" ] && [ -d "$root/$proj" ] || die "no lab project dir for $proj under ${root:-the $lab profile}"
LEDGER="$root/$proj/versions/legacy.md"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# The projects covered: <project> and the ones that name it as their repo.
mapfile -t projects < <(project_lab_names "$proj")
[ "${#projects[@]}" -gt 0 ] || projects=("$proj")

# Every tag each project owns, with its provenance, tagged with the project.
for p in "${projects[@]}"; do
  "$RELEASE_STATE" provenance "$p" 2>/dev/null | jq -c --arg p "$p" '. + {project: $p}' >>"$tmp/tags" \
    || die "release-state provenance $p failed"
done
touch "$tmp/tags"
jq -s 'map({(.tag): .}) | add // {}' "$tmp/tags" >"$tmp/tagmap"

# Where the repo's line starts: the oldest flow tag of the repo's own project. A run with no tag
# before it is legacy; with no flow tag yet, every run is.
start="$(jq -s --arg k "$repo_key" '[.[] | select(.project == $k and .provenance == "flow") | .at] | min // empty' "$tmp/tags")"

# The release workflows (see the header), each a file name the Actions API takes as an id.
mapfile -t workflows < <(jq -r --arg k "$repo_key" '
  .trackers as $t
  | [$t | to_entries[] | select(.value | type == "object") | select(.key == $k or .value.repo == $k)
     | .value.targets[]? | select(.pinned.deployed == true) | .id] as $stores
  | ($t[$k] // {}) as $r
  | ([$r.buildWorkflows[]?]
     + [$r.deployWorkflows // {} | to_entries[] | select(.value | type == "array")
        | select(any(.value[]; . as $id | $stores | index($id))) | .key])
  | unique[] | split("/") | last' "$MAP")

gh_pages() { timeout "$API_TIMEOUT" gh api --paginate "$1" --jq "$2" </dev/null; }

: >"$tmp/runs"
for wf in "${workflows[@]}"; do
  gh_pages "repos/$slug/actions/workflows/$wf/runs?per_page=$GH_PAGE" \
    '.workflow_runs[] | {id, workflow: "'"$wf"'", branch: .head_branch, event, status, conclusion, created_at, url: .html_url}' \
    >>"$tmp/runs" 2>/dev/null || die "could not list the runs of $wf in $slug"
done

# A run's tag is its head branch when that is a tag one of the projects owns; a tag owned by none
# of them is another product's, and the run is left out.
while IFS= read -r r; do
  b="$(jq -r '.branch // ""' <<<"$r")"
  if t="$(jq -c --arg b "$b" '.[$b] // empty' "$tmp/tagmap")" && [ -n "$t" ]; then
    jq -c --argjson t "$t" '. + {tag: $t.tag, project: $t.project, provenance: $t.provenance}' <<<"$r"
  elif [ -n "$b" ] && git -C "$repo" rev-parse -q --verify "refs/tags/$b" >/dev/null; then
    continue
  else
    jq -c --arg s "$start" '. + {tag: null, project: null,
      provenance: (if $s == "" or (.created_at | fromdate) < ($s | tonumber) then "legacy" else "after the line start" end)}' <<<"$r"
  fi
done <"$tmp/runs" | jq -s 'map(select(.provenance == "legacy")) | sort_by(.created_at) | reverse' >"$tmp/legacy-runs"

# Deployments: each one's version (its description, else its ref) held to the provenance of the
# project whose target it records; a job environment no target names (`steam`, `cut`) goes to the
# project owning the version's tag, else the repo's own project.
gh_pages "repos/$slug/deployments?per_page=$GH_PAGE" \
  '.[] | {id, environment, ref, description, creator: .creator.login, created_at,
          build: ((.payload // "") | if type == "string" then (fromjson? // {}) else . end | objects | .build // null | if . == null then null else tostring end)}' \
  >"$tmp/deploys.raw" 2>/dev/null || die "could not list the Deployments of $slug"
jq -c --arg k "$repo_key" --slurpfile tm "$tmp/tagmap" --argjson own "$(jq -c '
  [.trackers | to_entries[] | select(.value | type == "object") | .key as $p | .value.targets[]? | {(.id): $p}] | add // {}' "$MAP")" '
  (if (.description // "") != "" then .description else .ref end) as $v
  | . + {version: $v, project: ($own[.environment] // $tm[0][$v].project // $k)}' "$tmp/deploys.raw" >"$tmp/deploys"
: >"$tmp/dprov"
for p in $(jq -r .project "$tmp/deploys" | sort -u); do
  mapfile -t vs < <(jq -r --arg p "$p" 'select(.project == $p) | .version' "$tmp/deploys" | sort -u)
  "$RELEASE_STATE" provenance "$p" "${vs[@]}" 2>/dev/null | jq -c --arg p "$p" '. + {project: $p}' >>"$tmp/dprov" \
    || die "release-state provenance $p failed"
done
jq -s --slurpfile pv "$tmp/dprov" '
  ($pv | map({("\(.project)\t\(.value)"): .provenance}) | add // {}) as $pm
  | map(. + {provenance: ($pm["\(.project)\t\(.version)"] // "legacy")})
  | map(select(.provenance == "legacy")) | sort_by(.created_at) | reverse' "$tmp/deploys" >"$tmp/legacy-deploys"

# Each legacy Deployment's newest status, one call each.
while IFS= read -r d; do
  id="$(jq -r .id <<<"$d")"
  st="$(timeout "$API_TIMEOUT" gh api "repos/$slug/deployments/$id/statuses?per_page=1" --jq '.[0].state // "none"' </dev/null 2>/dev/null)" || st="not read"
  jq -c --arg s "$st" '. + {state: $s}' <<<"$d"
done < <(jq -c '.[]' "$tmp/legacy-deploys") | jq -s . >"$tmp/legacy-deploys.s"
mv "$tmp/legacy-deploys.s" "$tmp/legacy-deploys"

# Copy each legacy run's log zip once. A 404 or 410 is a log GitHub no longer keeps.
dest="$ARCHIVE_DIR/$proj"
copied=0 kept=0 expired=0 failed=0
: >"$tmp/logs"
if [ "$logs" = 1 ] && [ "$dry" = 0 ]; then
  mkdir -p "$dest" 2>/dev/null && [ -w "$dest" ] || die "cannot write $dest"
fi
while IFS=$'\t' read -r id status; do
  f="$dest/$id.zip" word=""
  if [ "$status" != completed ]; then word="not finished"
  elif [ -s "$f" ]; then word="archived"; kept=$((kept + 1))
  elif [ "$logs" = 0 ] || [ "$dry" = 1 ]; then word="not copied"
  elif timeout "$LOG_TIMEOUT" gh api "repos/$slug/actions/runs/$id/logs" </dev/null >"$f.part" 2>"$tmp/err" \
      && [ "$(head -c2 "$f.part")" = PK ]; then
    mv "$f.part" "$f"; word="archived"; copied=$((copied + 1))
  elif grep -qE 'HTTP (404|410)' "$tmp/err"; then
    rm -f "$f.part"; word="expired"; expired=$((expired + 1))
  else
    rm -f "$f.part"; word="copy failed"; failed=$((failed + 1))
    echo "release-legacy-archive: run $id: log not copied: $(head -c 200 "$tmp/err")" >&2
  fi
  printf '%s\t%s\n' "$id" "$word" >>"$tmp/logs"
done < <(jq -r '.[] | "\(.id)\t\(.status)"' "$tmp/legacy-runs")

# The ledger.
lines="$(for p in "${projects[@]}"; do
  f="$(project_field "$p" releaseFrom)"
  if [ -n "$f" ]; then echo "$p starts its line at $f"; else echo "$p has no line yet"; fi
done | paste -sd ';' | sed 's/;/; /g')"
ntags="$(jq -s 'map(select(.provenance == "legacy")) | length' "$tmp/tags")"
nall="$(jq -s length "$tmp/tags")"
nruns="$(jq length "$tmp/legacy-runs")"
ndep="$(jq length "$tmp/legacy-deploys")"
nlogs="$(awk -F'\t' '$2 == "archived"' "$tmp/logs" | wc -l)"
{
  echo "# Legacy releases: $proj"
  echo
  echo "<!-- written by release-legacy-archive $proj; rerun it, never edit this file by hand -->"
  echo "Releases that did not go through the release flow, kept as history (dotfiles docs/operations/release-state.md, Provenance): $lines. Run logs: \`$dest/<run>.zip\`."
  echo
  echo "Written $(date +%F): $ntags legacy tags of $nall, $nruns release runs ($nlogs logs archived), $ndep Deployments."
  echo
  echo "## Tags"
  echo
  echo "| Tag | Project | Tagger | Date | Commit |"
  echo "|---|---|---|---|---|"
  jq -rs 'map(select(.provenance == "legacy")) | sort_by(.at) | reverse[]
    | "| \(.tag) | \(.project) | \(.tagger // "lightweight") | \(.at // 0 | strftime("%Y-%m-%d")) | \(.sha // "" | .[0:10]) |"' "$tmp/tags"
  echo
  echo "## Release runs"
  echo
  echo "| Run | Workflow | Tag | Event | Result | Date | Log |"
  echo "|---|---|---|---|---|---|---|"
  jq -r --rawfile lg "$tmp/logs" '($lg | split("\n") | map(select(. != "") | split("\t") | {(.[0]): .[1]}) | add // {}) as $l
    | .[] | "| [\(.id)](\(.url)) | \(.workflow) | \(.tag // "none (\(.branch // "-"))") | \(.event) | \(.conclusion // .status) | \(.created_at[0:10]) | \($l[.id | tostring] // "-") |"' "$tmp/legacy-runs"
  echo
  echo "## Deployments"
  echo
  echo "| Environment | Version | Creator | Date | State | Build |"
  echo "|---|---|---|---|---|---|"
  jq -r '.[] | "| \(.environment) | \(.version) | \(.creator // "-") | \(.created_at[0:10]) | \(.state | ascii_downcase) | \(.build // "-") |"' "$tmp/legacy-deploys"
} >"$tmp/ledger"

if [ "$dry" = 1 ]; then
  cat "$tmp/ledger"
else
  mkdir -p "$(dirname "$LEDGER")" && cp "$tmp/ledger" "$LEDGER" || die "cannot write $LEDGER"
  echo "wrote $LEDGER"
fi
echo "release-legacy-archive $proj: tags $ntags legacy of $nall, runs $nruns, logs copied $copied, already archived $kept, expired $expired, failed $failed, deployments $ndep"
[ "$failed" = 0 ]
