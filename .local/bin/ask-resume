#!/usr/bin/env bash
# ask-resume — run the `resume` command of an answered ask. The producer half of the
# human<->agent loop, and the piece that was missing.
#
#   ask-resume <id>          resume one ask (what `agent-ask answer` calls)
#   ask-resume --all         drain every resumable ask, any project
#   ask-resume --dry-run     print what would run, run nothing
#
# Without this, an answer is only a field on disk: an agent posts a gate, you answer
# `approve`, and nothing turns that answer back into an action.
#
# `agent-ask answer` calls it with an id, so answering IS starting from any surface.
# `--all` is the manual backstop for an answer recorded with AGENT_ASK_NO_RESUME or
# whose resume could not start.
#
# Marking happens BEFORE running (`agent-ask mark-resumed`), so a resume that dies part
# way is not retried forever. These commands create tickets and cut branches; re-running
# one is not free. A failed resume is visible in its log under
# ~/.local/state/agentctl/ask-resume/.

set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

DRY=0
TARGET=""
while [ $# -gt 0 ]; do
  case "$1" in
    --all)     TARGET="--all" ;;
    --dry-run) DRY=1 ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)        echo "ask-resume: unknown flag '$1'" >&2; exit 2 ;;
    *)         TARGET="$1" ;;
  esac
  shift
done
[ -n "$TARGET" ] || TARGET="--all"

command -v agent-ask >/dev/null 2>&1 || { echo "ask-resume: agent-ask not on PATH" >&2; exit 1; }

# Run one resume command, headless through agentctl-run (build role). agentctl-run
# scrubs the inherited transport env and applies the route, so a resume never runs on
# whatever gateway its caller happened to export.
run_resume() { # $1=id $2=project $3=command
  local id="$1" project="$2" cmd="$3"
  if [ "$DRY" = 1 ]; then echo "would run: agentctl-run --role build -p '$cmd'   (ask $id)"; return 0; fi
  command -v agentctl-run >/dev/null 2>&1 || { echo "ask-resume: agentctl-run not on PATH" >&2; return 1; }
  agent-ask mark-resumed "$id" >/dev/null 2>&1
  echo "ask-resume: $id ($project) -> $cmd" >&2
  local log="${AGENTCTL_STATE_DIR:-$HOME/.local/state/agentctl}/ask-resume"
  mkdir -p "$log"
  setsid -f agentctl-run --role build -p "$cmd" \
    --max-turns "${ASK_RESUME_MAX_TURNS:-60}" \
    >>"$log/${project}.log" 2>&1 </dev/null
}

# --- one id -----------------------------------------------------------------
if [ "$TARGET" != "--all" ]; then
  line="$(agent-ask resumable --all 2>/dev/null | awk -F'\t' -v i="$TARGET" '$1==i')"
  if [ -z "$line" ]; then
    # Not an error: an ask with no `resume`, or one already consumed, is the common case.
    # `agent-ask answer` calls this on EVERY answer and must stay silent for ordinary questions.
    exit 0
  fi
  IFS=$'\t' read -r id project cmd _answer <<<"$line"
  run_resume "$id" "$project" "$cmd"
  exit $?
fi

# --- drain everything -------------------------------------------------------
n=0
while IFS=$'\t' read -r id project cmd _answer; do
  [ -n "$id" ] || continue
  run_resume "$id" "$project" "$cmd" || true
  n=$((n + 1))
done < <(agent-ask resumable --all 2>/dev/null)
[ "$n" -gt 0 ] && echo "ask-resume: resumed $n" >&2
exit 0
