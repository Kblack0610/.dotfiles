#!/usr/bin/env bash
# ask-resume — run the `resume` command of an answered ask. The producer half of the
# human<->agent loop, and the piece that was missing.
#
#   ask-resume <id>          resume one ask (what `agent-ask answer` calls)
#   ask-resume --all         drain every resumable ask, any project
#   ask-resume --dry-run     print what would run, run nothing
#
# Without this, an answer is only a field on disk: an agent posts a gate, you answer
# `approve`, and nothing turns that answer back into an action.
#
# A `resume` is a prompt for the ask-resume agent, or `run: <command>`: a script that posts an
# ask and consumes its own answer, which runs as `<command> <id>` with no model call (the inbox
# sweep's "which project is this line about?" asks).
#
# `agent-ask answer` calls it with an id, so answering IS starting from any surface.
# `--all` is the manual backstop for an answer recorded with AGENT_ASK_NO_RESUME or
# whose resume could not start.
#
# Marking happens BEFORE running (`agent-ask mark-resumed`), so a resume that dies part
# way is not retried forever. These commands create tickets and cut branches; re-running
# one is not free. A failed resume is visible in its log under
# ~/.local/state/agentctl/ask-resume/.

set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

DRY=0
TARGET=""
while [ $# -gt 0 ]; do
  case "$1" in
    --all)     TARGET="--all" ;;
    --dry-run) DRY=1 ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)        echo "ask-resume: unknown flag '$1'" >&2; exit 2 ;;
    *)         TARGET="$1" ;;
  esac
  shift
done
[ -n "$TARGET" ] || TARGET="--all"

command -v agent-ask >/dev/null 2>&1 || { echo "ask-resume: agent-ask not on PATH" >&2; exit 1; }

# Run one resume command, headless as the ask-resume agent (its conf: build role, its own
# budget, never the answering runner's). agentctl-run
# scrubs the inherited transport env and applies the route, so a resume never runs on
# whatever gateway its caller happened to export.
# A model resume is work, so it runs as a queue item, `from: ask:<id>` and origin `ask`, which
# its session works under ($AGENT_QUEUE_ITEM: its agent-land closes it, and its own adds go to the
# board as an unattended session's do). The item is filed before the ask is marked, so an add
# agent-queue refuses leaves the ask resumable for `--all`; when the run ends with the item still
# running, its exit closes it. A `run:` command is the asking script's own step, not a session.
run_resume() { # $1=id $2=project $3=command
  local id="$1" project="$2" cmd="$3" slug="ask-resume-$1" sid=''
  if [ "$DRY" = 1 ]; then
    if [[ "$cmd" == run:* ]]; then echo "would run: ${cmd#run:} $id   (ask $id)"; else echo "would run: agentctl-run --agent ask-resume -p '$cmd'   (ask $id, item $slug)"; fi
    return 0
  fi
  if [[ "$cmd" != run:* ]]; then
    command -v agentctl-run >/dev/null 2>&1 || { echo "ask-resume: agentctl-run not on PATH" >&2; return 1; }
    # The caller's session, item and pane are not this run's, so none of them is recorded on it
    # (agent-queue reads an empty one as unset).
    slug="$(CLAUDE_CODE_SESSION_ID='' AGENT_QUEUE_ITEM='' TMUX='' agent-queue add --running --repeat \
      --project "$project" --from "ask:$id" --slug "$slug" --title "chore(asks): resume answered ask $id" "$cmd" |
      sed -n 's/^running \([^ ]*\) -> .*/\1/p')"
    [ -n "$slug" ] || { echo "ask-resume: $id not resumed: agent-queue did not file its item (above); ask-resume --all retries it" >&2; return 1; }
    agent-queue set "$slug" origin=ask >/dev/null || echo "ask-resume: $slug has no origin: agent-queue set $slug origin=ask" >&2
    # The run's Claude session id is chosen here and claimed, as fleet-dispatch start claims its own, so
    # reap and fleet-bench see a witnessed item, not an ownerless one.
    sid="$(uuidgen | tr "[:upper:]" "[:lower:]")"
    agent-queue claim "$slug" --sid "$sid" >/dev/null || echo "ask-resume: $slug has no session: agent-queue claim $slug --sid $sid" >&2
  fi
  agent-ask mark-resumed "$id" >/dev/null 2>&1
  echo "ask-resume: $id ($project) -> $cmd" >&2
  local log="${AGENTCTL_STATE_DIR:-$HOME/.local/state/agentctl}/ask-resume"
  mkdir -p "$log"
  # A unit kills whatever its oneshot cgroup leaves behind (assume-due answers from fleet-state), so
  # under one the run gets its own scope. systemd sets INVOCATION_ID for a unit's processes.
  local detach=(setsid -f)
  [ -z "${INVOCATION_ID:-}" ] || detach=(systemd-run --user --scope --quiet setsid -f)
  if [[ "$cmd" == run:* ]]; then
    # shellcheck disable=SC2016 # $0 and $1 are the inner shell's: the label and the ask id
    "${detach[@]}" bash -c "${cmd#run:}"' "$1"' ask-resume "$id" >>"$log/${project}.log" 2>&1 </dev/null
    return 0
  fi
  # A run that opened a PR and did not land it leaves the item in review, where reap settles it by
  # that PR; done refuses an item whose PR has not merged. An ok close refused (a red watch item whose
  # watch still trips, ar-5414) parks it in review too, where reap notes it. ar-4681: a close once reached agent-queue
  # with an empty state and the item stayed open; the cause was not reproduced. close() passes the state
  # as literal arguments from each call site and logs the very arguments it passed, so a repeat shows
  # what agent-queue was given.
  # shellcheck disable=SC2016 # the inner shell's $1..$4: the prompt, max turns, the item and its session id
  "${detach[@]}" env AGENT_QUEUE_ITEM="$slug" bash -c '
    agentctl-run --agent ask-resume -p "$1" --max-turns "$2" ${4:+--session-id "$4"}; rc=$?
    item="$3"
    close() { agent-queue move "$item" "$@" >/dev/null && return 0; echo "ask-resume: $item is left open: agent-queue move $item $*" >&2; return 1; }
    it="$(agent-queue show "$item" --json 2>/dev/null)"
    [ "$(jq -r .state <<<"$it")" = running ] || exit "$rc"
    if [ -n "$(jq -r ".pr // empty" <<<"$it")" ]; then close review
    elif [ "$rc" = 0 ]; then close done --status ok || close review
    else close done --status failed; fi
    exit "$rc"' ask-resume "$cmd" "${ASK_RESUME_MAX_TURNS:-60}" "$slug" "$sid" \
    >>"$log/${project}.log" 2>&1 </dev/null
}

# --- one id -----------------------------------------------------------------
if [ "$TARGET" != "--all" ]; then
  line="$(agent-ask resumable --all 2>/dev/null | awk -F'\t' -v i="$TARGET" '$1==i')"
  if [ -z "$line" ]; then
    # Not an error: an ask with no `resume`, or one already consumed, is the common case.
    # `agent-ask answer` calls this on EVERY answer and must stay silent for ordinary questions.
    exit 0
  fi
  IFS=$'\t' read -r id project cmd _answer <<<"$line"
  run_resume "$id" "$project" "$cmd"
  exit $?
fi

# --- drain everything -------------------------------------------------------
n=0
while IFS=$'\t' read -r id project cmd _answer; do
  [ -n "$id" ] || continue
  run_resume "$id" "$project" "$cmd" || true
  n=$((n + 1))
done < <(agent-ask resumable --all 2>/dev/null)
[ "$n" -gt 0 ] && echo "ask-resume: resumed $n" >&2
exit 0
