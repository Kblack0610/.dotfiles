#!/usr/bin/env bash
# fleet-lease - the one machine that runs the fleet's singleton lanes, chosen by a lease in the agent store.
#
#   fleet-lease <lane>           exit 0 when this machine may run <lane> now: the units' ExecCondition
#   fleet-lease renew            renew the lease when held, take it when free, and start or stop the
#                                persistent singleton units to match (fleet-lease.timer, every machine);
#                                a machine another holds it from removes the singletons' textfiles
#   fleet-lease held             what this machine last read, no network: exit 0 it holds the lease,
#                                1 another machine does (or this one never may), 2 no holder known
#   fleet-lease status [--json]  who holds it, until when, on which remote
#
# Any peer of the store may hold the lease; every singleton lane shares it. A lane's conf says
# SCOPE=singleton or every-node; no conf, or no SCOPE, is a singleton. The lease is the branch
# lease/fleet on the store's remotes, taken by a push without force, so exactly one of two takers
# lands. <lane> exits 0 run, 1 another machine holds it, 2 cannot tell; systemd skips on 1 and 2.
# Design and runbook: ~/.config/agentctl/QUEUE.md, "The fleet lease".
set -uo pipefail

STORE="${AGENT_STORE_DIR:-$HOME/.agent}"
# shellcheck source=../lib/store-remote.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/store-remote.sh"
# shellcheck source=../lib/prom-textfile.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/prom-textfile.sh"
CONF_DIR="${AGENTCTL_CONF_DIR:-$HOME/.config/agentctl/agents}"
ME="${FLEET_HOST:-$(uname -n | cut -d. -f1)}"
NAME=fleet
REF="refs/heads/lease/$NAME"
# A lapsed holder's lanes move within TTL_S. Renewal writes only once half of it is gone, so the
# branch grows by under 600 small commits a day.
TTL_S="${FLEET_LEASE_TTL_S:-300}"
# A holder this far from expiry passes the gate with no network call.
MARGIN_S=60
LOCK_WAIT_S=30
# The persistent singleton units the renewer starts on the holder and stops elsewhere, besides each
# KIND=persistent singleton agentctl lane (agentctl@<name>.service). Only an enabled one is started.
UNITS="${FLEET_LEASE_UNITS:-agent-web.service}"
# The textfiles the singleton lanes publish (prom-textfile.sh): fleet-bench, fleet-state,
# claude-acct, mkt-metrics and product-metrics. A machine another holds the lease from removes
# them: its lanes no longer run, and a copy left behind is a second, frozen reading of each fleet
# gauge (razer's fleet_bench.prom from the 2026-11-19 handover, ar-4358). A new singleton writer
# adds its file here.
TEXTFILES="${FLEET_LEASE_TEXTFILES:-fleet_bench.prom fleet_projects.prom fleet_sessions.prom claude_acct.prom mkt_metrics.prom store_reviews.prom store_sales.prom sentry_issues.prom playtest_feedback.prom}"
SYNC_DIR="$STORE/.sync"
PEER="$SYNC_DIR/peer"
# A peer that must never hold the lease: one without what the holder runs (agent-web, hub, notes).
# home-config's fleet-worker role writes it from fleet_lease.
NOLEASE="$SYNC_DIR/no-lease"
# Its own bare repo, so a lease fetch never touches the store's refs or races store-sync's fetch.
LDIR="$SYNC_DIR/lease.git"
# "<holder> <expires> <remote>" of the last lease this machine wrote or read.
LOCAL="$SYNC_DIR/lease-$NAME"

die() { echo "fleet-lease: $*" >&2; exit 2; }
now() { printf '%s' "${FLEET_LEASE_NOW:-$(date +%s)}"; }
L() { git -C "$LDIR" -c core.hooksPath=/dev/null -c user.name=fleet-lease -c "user.email=fleet-lease@$ME" "$@"; }
hm() { date -d "@$1" +%H:%M 2>/dev/null || echo "$1"; }

# scope <lane> -> singleton or every-node.
scope() {
  local s
  s=$(sed -n 's/^SCOPE=["'\'']\{0,1\}\([a-z-]*\).*/\1/p' "$CONF_DIR/$1.conf" 2>/dev/null | tail -n 1)
  [ "$s" = every-node ] && echo every-node || echo singleton
}

# url_of <remote> -> its URL: store.env's, else the store clone's own.
url_of() {
  local u
  [ "$1" = origin ] && u=$STORE_PRIMARY_URL || u=$STORE_BACKUP_URL
  [ -n "$u" ] || u=$(git -C "$STORE" remote get-url "$1" 2>/dev/null) || return 1
  [ -n "$u" ] && printf '%s' "$u"
}

# fetch <remote>: its lease tip into refs/lease/<remote>/fleet, removed when it has none. A tip this
# machine already has (its own last write) costs one ls-remote; any other comes in shallow.
fetch() {
  local u tip
  u=$(url_of "$1") || return 1
  [ -d "$LDIR" ] || git init -q --bare "$LDIR" >/dev/null || return 1
  tip=$(net "$1" ls-remote "$u" "$REF" 2>/dev/null) || return 1
  tip=${tip%%[[:space:]]*}
  if [ -z "$tip" ]; then
    L update-ref -d "refs/lease/$1/$NAME" 2>/dev/null
  elif L cat-file -e "$tip^{commit}" 2>/dev/null; then
    L update-ref "refs/lease/$1/$NAME" "$tip"
  else
    net "$1" -C "$LDIR" fetch -q --depth=1 --no-write-fetch-head "$u" "+$REF:refs/lease/$1/$NAME" 2>/dev/null
  fi
}

# read_lease <remote> -> "<tip> <holder> <expires>" as last fetched; "- - 0" when it has none.
read_lease() {
  local tip body h e
  tip=$(L rev-parse -q --verify "refs/lease/$1/$NAME" 2>/dev/null) || { echo "- - 0"; return; }
  body=$(L show "$tip:lease" 2>/dev/null)
  h=$(sed -n 's/^holder=//p' <<<"$body"); e=$(sed -n 's/^expires=//p' <<<"$body")
  [[ "$e" =~ ^[0-9]+$ ]] || e=0
  echo "$tip ${h:--} $e"
}

# push <remote> <parent tip or -> <expires>: a lease commit on that tip, pushed without force. Rc 0
# only when the remote took it.
push() {
  local blob tree commit p=()
  [ "$2" = - ] || p=(-p "$2")
  blob=$(printf 'holder=%s\nexpires=%s\n' "$ME" "$3" | L hash-object -w --stdin) &&
    tree=$(printf '100644 blob %s\tlease\n' "$blob" | L mktree) &&
    commit=$(L commit-tree "$tree" "${p[@]}" -m "$ME holds $NAME until $(hm "$3")") || return 1
  net "$1" -C "$LDIR" push -q "$(url_of "$1")" "$commit:$REF" 2>/dev/null
}

# take_on <remote> <expires> [over] -> rc 0 this machine holds it there until <expires>, 1 another
# holds it (HOLDER, HELD_TO), 3 the remote did not answer, 4 it refused both writes. With `over` it
# writes whatever is there.
take_on() {
  local r="$1" exp="$2" tip h e
  for _ in 1 2; do
    fetch "$r" || return 3
    read -r tip h e < <(read_lease "$r")
    if [ "${3:-}" != over ] && [ "$tip" != - ] && [ "$h" != "$ME" ] && [ "$e" -gt "$(now)" ]; then
      HOLDER=$h HELD_TO=$e
      return 1
    fi
    push "$r" "$tip" "$exp" && return 0
    # Rejected: another machine moved the branch since the fetch; the next fetch reads who.
  done
  # It answered but never took a write: no other remote may decide for it.
  return 4
}

save() { mkdir -p "$SYNC_DIR" && printf '%s %s %s\n' "$1" "$2" "$3" > "$LOCAL.tmp" && mv -f "$LOCAL.tmp" "$LOCAL"; }

# held [<secs>] -> rc 0 when the last lease this machine wrote or read says it holds it <secs> past now.
held() {
  local h e r
  read -r h e r 2>/dev/null < "$LOCAL" || return 1
  [ "$h" = "$ME" ] && [[ "$e" =~ ^[0-9]+$ ]] && [ "$e" -gt $(( $(now) + ${1:-0} )) ]
}

# take -> rc 0 this machine holds the lease (on SOURCE), 1 another does (HOLDER, HELD_TO), 2 no
# remote answered. origin decides while it answers, and its holder's lease goes over backup's.
take() {
  local exp rc
  exp=$(( $(now) + TTL_S ))
  load_conf
  HOLDER='' HELD_TO=0 SOURCE=''
  if url_of origin >/dev/null; then
    take_on origin "$exp"; rc=$?
    case "$rc" in
      0) SOURCE=origin
         ! url_of backup >/dev/null || take_on backup "$exp" over || :
         save "$ME" "$exp" origin; return 0 ;;
      1) save "$HOLDER" "$HELD_TO" origin; return 1 ;;
      4) return 2 ;;
    esac
  fi
  url_of backup >/dev/null || return 2
  take_on backup "$exp"; rc=$?
  case "$rc" in
    0) SOURCE=backup; save "$ME" "$exp" backup; return 0 ;;
    1) save "$HOLDER" "$HELD_TO" backup; return 1 ;;
  esac
  return 2
}

# lock: this machine's lease lock, held to exit, so the timer and a gate never race each other.
lock() { mkdir -p "$SYNC_DIR" && exec 8>"$SYNC_DIR/lease.lock" && flock -w "$LOCK_WAIT_S" 8; }

cmd_gate() {
  local lane="$1" rc
  [[ "$lane" =~ ^[A-Za-z0-9@._-]+$ ]] || die "usage: fleet-lease <lane> | renew | held | status [--json]"
  [ "$(scope "$lane")" = singleton ] || exit 0
  [ ! -f "$NOLEASE" ] || { echo "fleet-lease: $ME never holds the fleet lease ($NOLEASE), so it skips $lane" >&2; exit 1; }
  held "$MARGIN_S" && exit 0
  [ -f "$PEER" ] || { echo "fleet-lease: $STORE is not a peer clone (store-sync join), so $ME cannot hold the fleet lease and skips $lane" >&2; exit 2; }
  lock || { echo "fleet-lease: the lease lock is busy past ${LOCK_WAIT_S}s, so $ME skips $lane this time" >&2; exit 2; }
  # Another gate or the timer may have taken it while this one waited.
  held "$MARGIN_S" && exit 0
  take; rc=$?
  case "$rc" in
    0) echo "fleet-lease: $ME took the fleet lease on $SOURCE until $(hm "$(( $(now) + TTL_S ))") for $lane" >&2; exit 0 ;;
    1) echo "fleet-lease: $lane is a singleton and $HOLDER holds the fleet lease until $(hm "$HELD_TO"), so $ME skips it" >&2; exit 1 ;;
    *) echo "fleet-lease: no remote of the store answered, so $ME cannot tell who holds the fleet lease and skips $lane" >&2; exit 2 ;;
  esac
}

# units -> the persistent singleton units: UNITS, and each KIND=persistent agentctl lane not every-node.
units() {
  local c n
  # shellcheck disable=SC2086 # a word list
  printf '%s\n' $UNITS
  for c in "$CONF_DIR"/*.conf; do
    [ -f "$c" ] && grep -qE "^KIND=[\"']?persistent" "$c" || continue
    n=${c##*/}; n=${n%.conf}
    [ "$(scope "$n")" = singleton ] && echo "agentctl@$n.service"
  done
}

# follow <0|1>: start the enabled persistent singleton units on the holder (1), stop them elsewhere.
follow() {
  local u
  while IFS= read -r u; do
    [ -n "$u" ] || continue
    if [ "$1" = 1 ]; then
      systemctl --user is-enabled -q "$u" 2>/dev/null && ! systemctl --user is-active -q "$u" 2>/dev/null &&
        systemctl --user start --no-block "$u" && echo "fleet-lease: started $u"
    elif systemctl --user is-active -q "$u" 2>/dev/null; then
      systemctl --user stop --no-block "$u" && echo "fleet-lease: stopped $u: $ME does not hold the fleet lease"
    fi
  done < <(units)
  return 0
}

# unpublish: remove this machine's copy of each singleton textfile. Only a machine that knows
# another holds the lease, or that never may, calls it: one that cannot tell keeps its copy, as
# its lanes' gate does.
unpublish() {
  local d f
  d=$(prom_textfile_target) || return 0
  # shellcheck disable=SC2086 # a word list
  for f in $TEXTFILES; do
    [ -e "$d/$f" ] && rm -f "$d/$f" && echo "fleet-lease: removed $f: $ME does not hold the fleet lease"
  done
  return 0
}

cmd_renew() {
  local rc h=0
  # Not a peer, or never a holder: this machine runs none of the holder's units.
  [ -f "$PEER" ] && [ ! -f "$NOLEASE" ] || { follow 0; unpublish; exit 0; }
  lock || exit 0
  if held $(( TTL_S / 2 )); then h=1
  else
    take; rc=$?
    case "$rc" in
      0) h=1 ;;
      1) h=0; unpublish ;;
      # No remote answered: keep what the last write says until it lapses.
      *) held && h=1 ;;
    esac
  fi
  follow "$h"
}

# cmd_held: the lease as this machine last wrote or read it (renew, every minute; a gate), with no
# network or lock, for callers that must answer fast: agentctl liveness, a hand fleet-dispatch verb.
cmd_held() {
  local h e r
  held && exit 0
  [ ! -f "$NOLEASE" ] || { echo "fleet-lease: $ME never holds the fleet lease ($NOLEASE)"; exit 1; }
  [ -f "$PEER" ] || { echo "fleet-lease: $STORE is not a peer clone (store-sync join), so $ME cannot hold the fleet lease"; exit 2; }
  if read -r h e r 2>/dev/null < "$LOCAL" && [[ "$e" =~ ^[0-9]+$ ]] && [ "$e" -gt "$(now)" ]; then
    echo "fleet-lease: $h holds the fleet lease until $(hm "$e") (on $r)"; exit 1
  fi
  echo "fleet-lease: no machine is known to hold the fleet lease${e:+ (the last one read lapsed at $(hm "$e"))}: fleet-lease status"
  exit 2
}

cmd_status() {
  local r tip h e out=() json=() t
  t=$(now)
  load_conf
  lock || :
  for r in origin backup; do
    url_of "$r" >/dev/null || continue
    if ! fetch "$r"; then
      out+=("$r: did not answer"); json+=("$(jq -nc --arg r "$r" '{remote: $r, reached: false}')")
      continue
    fi
    read -r tip h e < <(read_lease "$r")
    if [ "$tip" = - ]; then out+=("$r: no lease yet")
    elif [ "$e" -le "$t" ]; then out+=("$r: free, $h's lease lapsed at $(hm "$e")")
    else out+=("$r: $h holds it until $(hm "$e")$([ "$h" != "$ME" ] || echo ' (this machine)')"); fi
    json+=("$(jq -nc --arg r "$r" --arg h "$h" --argjson e "$e" --argjson t "$t" \
      '{remote: $r, reached: true, holder: (if $h == "-" then null else $h end), expires: $e, live: ($e > $t)}')")
  done
  if [ "${1:-}" = --json ]; then
    printf '%s\n' "${json[@]}" | jq -sc --arg me "$ME" --argjson held "$(held && echo true || echo false)" --argjson cand "$([ -f "$NOLEASE" ] && echo false || echo true)" '{me: $me, held: $held, candidate: $cand, remotes: .}'
  else
    if held; then echo "this machine ($ME) holds the fleet lease"
    elif [ -f "$NOLEASE" ]; then echo "this machine ($ME) never holds the fleet lease ($NOLEASE)"
    else echo "this machine ($ME) does not hold the fleet lease"; fi
    printf '%s\n' "${out[@]}"
  fi
}

case "${1:-}" in
  renew) cmd_renew ;;
  held) cmd_held ;;
  status) shift; cmd_status "$@" ;;
  -h | --help) awk 'NR==1 && /^#!/ {next} /^#/ {sub(/^# ?/,""); print; next} {exit}' "$0" ;;
  "") die "usage: fleet-lease <lane> | renew | held | status [--json]" ;;
  *) cmd_gate "$1" ;;
esac
