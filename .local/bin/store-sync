#!/usr/bin/env bash
# store-sync - keep this machine's clone of a store and the shared remote one in step.
#
#   store-sync [--store agent|notes] [--now] [--bg]  commit, merge the remote, push origin, then backup
#   store-sync join [--keep-dirty]                   make this agent-store clone a peer (once per machine)
#   store-sync merge-derived <base> <ours> <theirs> <path>   git's `derived` merge driver (below)
#   store-sync merge-item <base> <ours> <theirs> <path>      git's `item` merge driver for queue items (below)
#
# Two stores ride this one engine. agent (the default) is ~/.agent: agent-queue and agent-ask run
# `--now --bg` after each write, which commits the coordination paths (NOW_PATHS), plus any dirty
# file the merge also changes, and pushes at once; store-sync.timer runs the bulk pass. notes is
# ~/.notes: `notes-sync` runs it for notes-watch (each saved note), notes-mqtt and notes-ntfy (a
# push from elsewhere) and git-sync-notes.timer. origin is Forgejo and backup is GitHub; backup
# takes the write when origin is unreachable or refuses it. Remote commits come in by merge, never
# rebase, and a conflict stops with every local commit kept and pages once. COMPLETE in sync.log
# means origin holds HEAD, which store-sync-age reads. An unjoined agent clone never pushes.
# Design, rollout and troubleshooting: ~/.config/agentctl/QUEUE.md, "The store: every machine a
# peer"; the notes side: ~/.local/src/git/NOTES_SYNC_SETUP.md.
set -uo pipefail

# mapfile and declare -A need bash 4. macOS ships 3.2 at /bin/bash, first on launchd's PATH even
# under `bash -l`, so take brew's when it is there.
if [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
  for b in /opt/homebrew/bin/bash /usr/local/bin/bash; do [ -x "$b" ] && exec "$b" "$0" "$@"; done
  echo "store-sync: needs bash 4 or later (brew install bash)" >&2; exit 2
fi

die() { echo "store-sync: $*" >&2; exit 2; }

# A status read never takes the optional index.lock: the --bg check runs in its caller's process,
# and a caller killed with SIGKILL (a Bash tool timeout, a closed pane) would leave the lock behind.
export GIT_OPTIONAL_LOCKS=0

STORE_NAME=agent
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --store) [ $# -ge 2 ] || die "--store needs agent or notes"; STORE_NAME="$2"; shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- "${args[@]+"${args[@]}"}"

# What differs between the two stores is only here.
case "$STORE_NAME" in
  agent)
    STORE="${AGENT_STORE_DIR:-$HOME/.agent}"
    CONF="${STORE_SYNC_CONF:-$HOME/.config/agentctl/store.env}"
    SSH_KEY="${STORE_SYNC_SSH_KEY:-$HOME/.ssh/id_agent_sync}"
    SYNC_DIR="$STORE/.sync"
    # What a write hook (--now) commits: the coordination state, never the bulk logs.
    NOW_PATHS=(queue asks presence)
    # A clone pushes only once `store-sync join` made it a peer of the shared store.
    NEEDS_JOIN=1 ;;
  notes)
    STORE="${NOTES_DIR:-$HOME/.notes}"
    # No conf: the remotes are the clone's own, set by notes-sync-bootstrap.sh.
    CONF=""
    SSH_KEY="${STORE_SYNC_SSH_KEY:-$HOME/.ssh/id_notes_sync}"
    # Outside the vault, so none of it is committed; `notes doctor` reads sync.log here.
    SYNC_DIR="$HOME/.local/state/notes-sync"
    NOW_PATHS=(.)
    # Every notes clone already syncs with its remotes as the truth.
    NEEDS_JOIN=0 ;;
  *) die "unknown store '$STORE_NAME' (agent or notes)" ;;
esac
BRANCH=master
# ssh_cmd, net, load_conf: how a remote is reached, shared with fleet-lease. It keeps the CONF
# and SSH_KEY set above; its own defaults are the agent store's.
# shellcheck source=../lib/store-remote.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/store-remote.sh"
# shellcheck source=../lib/dispatch-wake.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/dispatch-wake.sh"
TRIES=3
# A sync waits this long for another one on this machine to finish; past it the write stays
# committed or on disk, and the next sync pushes it.
LOCK_WAIT_S=300
# How long backup may go without taking HEAD while origin answers, before the page: an hour of a
# dead backup rather than one bad Wi-Fi moment. Time, not a run count: write hooks run many syncs.
BACKUP_ALERT_AFTER_S=3600
# A git killed mid-write leaves .git/index.lock, and every commit after it fails. One older than
# this that no process holds open is that leftover: a live git holds its lock for seconds.
STALE_LOCK_MIN=10
# A sync that could not commit exits this, outside the unit's SuccessExitStatus=1, so the unit
# fails: on 2026-11-18 a stale index.lock failed every ~/.agent commit for two hours as clean runs.
EXIT_NO_COMMIT=3
# git add walks a live tree; a file that moves mid-walk fails one pass (commit_paths).
ADD_TRIES=3
HOST_TAG="$(uname -n | cut -d. -f1)"
LOG="$SYNC_DIR/sync.log"
PEER="$SYNC_DIR/peer"
# "<HEAD> <remote ref>" of the last merge that conflicted: retrying that pair cannot succeed.
CONFLICT="$SYNC_DIR/conflict"
BACKUP_FAILS="$SYNC_DIR/backup-failures"
# The short HEAD whose missing trees a refetch that reached a remote could not restore (heal_head).
REFETCHED="$SYNC_DIR/refetched"

log() {
  mkdir -p "$SYNC_DIR"
  printf '[%s] [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$HOST_TAG" "$1" >> "$LOG"
  rotate_log
  [ "${QUIET:-0}" = 1 ] || printf '%s\n' "$1"
}

rotate_log() {
  local size
  size=$(stat -c%s "$LOG" 2>/dev/null || stat -f%z "$LOG" 2>/dev/null || echo 0)
  [ "$size" -gt 1048576 ] || return 0
  # The newest COMPLETE line survives the cut, since store-sync-age reads it: on 2026-11-18 a flood
  # of commit errors rotated it out, and the stale store read as unreadable instead of stale.
  local last
  last=$(grep -E '^\[[^]]*\] \[[^]]*\] COMPLETE:' "$LOG" | tail -n 1)
  { [ -z "$last" ] || tail -n 1000 "$LOG" | grep -qxF -- "$last" || printf '%s\n' "$last"
    tail -n 1000 "$LOG"; } > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
}

# notify <priority> <message>: page the human on a change of state, never on every run. A sync
# never fails on it; under systemd the login PATH is absent, hence the fallback.
notify() {
  local n
  n=$(command -v agent-notify 2>/dev/null) || n="$HOME/.local/bin/agent-notify"
  [ -x "$n" ] || return 0
  "$n" -t "store-sync $STORE_NAME" -p "$1" "$2" >/dev/null 2>&1 || true
}

# track_backup <ok 0|1>: BACKUP_FAILS holds "<epoch of the first failed sync> [paged]" while
# origin answers and backup does not take HEAD; page once past BACKUP_ALERT_AFTER_S and once on
# recovery. A silently stale backup once went a month unseen (notes, from 2026-06-17).
track_backup() {
  local first="" paged="" now
  read -r first paged 2>/dev/null < "$BACKUP_FAILS"
  if [ "$1" = 0 ]; then
    [ -z "$paged" ] || notify normal "The $STORE_NAME store's backup took HEAD again on $HOST_TAG."
    rm -f "$BACKUP_FAILS"
    return 0
  fi
  now=$(date +%s)
  case "$first" in '' | *[!0-9]*) echo "$now" > "$BACKUP_FAILS"; return 0 ;; esac
  [ -z "$paged" ] && [ $((now - first)) -ge "$BACKUP_ALERT_AFTER_S" ] || return 0
  notify high "The $STORE_NAME store's backup has not taken a write on $HOST_TAG for $(( (now - first) / 60 )) minutes, so the off-site copy is going stale. See $LOG"
  echo "$first paged" > "$BACKUP_FAILS"
}

usage() { awk 'NR==1 && /^#!/ {next} /^#/ {sub(/^# ?/,""); print; next} {exit}' "$0"; }

g() { git -C "$STORE" "$@"; }

# Point origin and backup at the conf's URLs; a URL the conf leaves empty keeps the clone's own.
apply_remotes() {
  local name url
  for name in origin backup; do
    [ "$name" = origin ] && url="$STORE_PRIMARY_URL" || url="$STORE_BACKUP_URL"
    [ -n "$url" ] || continue
    if g remote get-url "$name" >/dev/null 2>&1; then
      [ "$(g remote get-url "$name")" = "$url" ] || g remote set-url "$name" "$url"
    else
      g remote add "$name" "$url"
    fi
  done
}

# ~/.agent's .gitattributes marks regenerated files (daylog/*.json, prs/sync.json, anchors/*.md)
# `merge=derived`: two peers rewrote them ~43 times a day and every merge conflicted (ar-3364). A
# merge driver lives in each clone's config, so every sync defines it; a clone without it merges them
# as text. A new driver config also drops the recorded conflict pair, so the stuck pair is retried.
apply_merge_drivers() {
  local me want attrs a
  me=$(printf '%q' "$(realpath "$0")")
  # Queue items merge=item (ar-4091, ar-3439): two hosts writing one item's header, or closing it. The
  # attributes go in this clone's info/attributes, not the tracked .gitattributes: each peer sets them
  # itself, so no peer waits on another's commit, and a clone gets them with the driver. The `close`
  # driver it replaced is dropped. Both conflict pairs are retried on a change.
  attrs=$(g rev-parse --path-format=absolute --git-path info/attributes) && mkdir -p "$(dirname "$attrs")"
  a='queue/done/*/*.md merge=close'
  if grep -qxF "$a" "$attrs" 2>/dev/null; then
    grep -vxF "$a" "$attrs" > "$attrs.new"; mv -f "$attrs.new" "$attrs"
    g config --unset merge.close.driver
  fi
  for a in 'queue/*/*.md merge=item' 'queue/done/*/*.md merge=item'; do
    grep -qxF "$a" "$attrs" 2>/dev/null || { printf '%s\n' "$a" >> "$attrs" && rm -f "$CONFLICT" "$CONFLICT"-*; }
  done
  [ "$(g config --get merge.item.driver)" = "$me merge-item %O %A %B %P" ] ||
    { g config merge.item.driver "$me merge-item %O %A %B %P" && rm -f "$CONFLICT" "$CONFLICT"-*; }
  want="$me merge-derived %O %A %B %P"
  [ "$(g config --get merge.derived.driver)" = "$want" ] && return 0
  g config merge.derived.driver "$want" && rm -f "$CONFLICT" "$CONFLICT"-*
}

# cmd_merge_item <base> <ours> <theirs> <path>: the driver for a queue item, leaving the result in
# <ours>. A clean text merge stands. Otherwise, for two closes of one item, the close that is
# `status: ok` or `cancelled` wins whole over a `status: failed`, which is a reaper that read a stale
# copy of the item (razer-laptop, 2026-11-20: 5 items closed ok there, failed here minutes later; ar-268
# cancelled there, failed here while this store was stuck; ar-4091). Otherwise the header (each
# `key: value` line before the first `---`, as agent-queue's header_set writes it) merges key by key
# and the rest as text, so two hosts that set different keys both keep theirs: the fleet home recorded
# pr: and merged: on a running item while razer-laptop's session set open_pr: and branch: on the next
# lines, and the text merge stuck that store 35 minutes (2026-11-21, ar-3439). A key both sides set
# differently takes the value of the side whose `requeued:` this merge changed, when only one did: a
# requeue ends the run the other side's header edit was about (the fleet home set `routed:` on a
# running ar-3010 while razer-laptop's requeue cleared it, 2026-11-23, ar-3439). With no requeue, a
# side whose `status:` this merge changed closed the item and wins the same way (ar-4219, ar-3439).
# Otherwise it still conflicts. That conflict, a repeated key, a line that is not `key: value`, or a side with no `---`
# (an empty base, both sides adding the item, is fine) keeps this side whole and the other as a lost
# file (keep_ours). `requeued:` is written only by agent-queue's move back to queued after a run.
cmd_merge_item() {
  [ $# -eq 4 ] || die "merge-item needs <base> <ours> <theirs> <path>"
  local tmp f
  tmp=$(mktemp -d) || return 1
  if git merge-file -q -p "$2" "$1" "$3" > "$tmp/out"; then
    cat "$tmp/out" > "$2"; rm -rf "$tmp"; return 0
  fi
  status_of() { sed -n '/^---$/q;s/^status: //p' "$1"; }
  settled() { case "$(status_of "$1")" in ok | cancelled) return 0 ;; esac; return 1; }
  settled "$2" && [ "$(status_of "$3")" = failed ] && { rm -rf "$tmp"; return 0; }
  settled "$3" && [ "$(status_of "$2")" = failed ] && { cat "$3" > "$2"; rm -rf "$tmp"; return 0; }
  grep -qx -- '---' "$2" && grep -qx -- '---' "$3" && { [ ! -s "$1" ] || grep -qx -- '---' "$1"; } ||
    { rm -rf "$tmp"; keep_ours "$3" "$4"; return; }
  for f in 1 2 3; do sed -n '/^---$/,$p' "${!f}" > "$tmp/rest$f"; done
  # An empty base has no lines, so each file is told by its name.
  if awk 'FILENAME == ARGV[1] {s = 1} FILENAME == ARGV[2] {s = 2} FILENAME == ARGV[3] {s = 3}
          end[s] { next }
          $0 == "---" { end[s] = 1; next }
          { i = index($0, ":"); k = substr($0, 1, i - 1)
            if (i < 2 || k ~ /[[:space:]]/ || (s, k) in v) { bad = 1; exit }
            v[s, k] = $0
            if (s > 1 && !(k in seen)) { seen[k] = 1; order[++n] = k } }
          END { if (bad) exit 1
                rb = (1, "requeued") in v ? v[1, "requeued"] : SUBSEP
                ro = (2, "requeued") in v && v[2, "requeued"] != rb
                rt = (3, "requeued") in v && v[3, "requeued"] != rb
                if (!ro && !rt) {
                  sb = (1, "status") in v ? v[1, "status"] : SUBSEP
                  ro = (2, "status") in v && v[2, "status"] != sb
                  rt = (3, "status") in v && v[3, "status"] != sb }
                for (j = 1; j <= n; j++) {
                  k = order[j]; b = (1, k) in v ? v[1, k] : SUBSEP
                  o = (2, k) in v ? v[2, k] : SUBSEP; t = (3, k) in v ? v[3, k] : SUBSEP
                  if (o == t || t == b) r = o; else if (o == b) r = t
                  else if (ro && !rt) r = o; else if (rt && !ro) r = t; else exit 1
                  if (r != SUBSEP) print r } }' "$1" "$2" "$3" > "$tmp/out" &&
     git merge-file -q -p "$tmp/rest2" "$tmp/rest1" "$tmp/rest3" >> "$tmp/out"; then
    cat "$tmp/out" > "$2"; rm -rf "$tmp"; return 0
  fi
  rm -rf "$tmp"
  keep_ours "$3" "$4"
}

# keep_ours <theirs> <path>: the last resort of merge-item. The local copy stands whole and the remote
# one is kept as $SYNC_DIR/lost/<path, / as __>.lost-<its blob hash>, named by content, so a merge
# retried, or the in-memory merge-tree run before the real merge, finds it and logs nothing more;
# store-sync-age reads any file there as red until someone settles it
# (re-applies what the remote side should have kept, with agent-queue set) and deletes it. Exit 1,
# the conflict as before, only when the file cannot be written. Logged, never printed: a driver's
# stdout is git's. Why: one item set two ways on two hosts stopped every sync of the store until a
# human resolved it, with no record of which side lost (ar-3439 measured 35 minutes on 2026-11-21; ar-4471).
keep_ours() {
  local h lost
  h=$(git hash-object -- "$1" 2>/dev/null) || return 1
  lost="$SYNC_DIR/lost/${2//\//__}.lost-${h:0:12}"
  [ -e "$lost" ] && return 0
  mkdir -p "${lost%/*}" && cp -- "$1" "$lost" || return 1
  QUIET=1 log "merge-item: $2 differs on both sides past what merges; kept this side's copy, the other is in ${lost/#"$HOME"/\~}"
}

# cmd_merge_derived <base> <ours> <theirs> <path>: the driver, leaving the result in <ours>. A JSON
# snapshot keeps the local copy whole, never a mix of two passes (an etag from one and the body from
# the other). Any other file keeps the local copy of each AUTO:START..AUTO:END block and merges the
# lines around them as text, so a hand edit beside an anchor's auto block survives and two clashing
# hand edits still conflict (exit 1). The next regen rewrites whatever the local side held.
cmd_merge_derived() {
  [ $# -eq 4 ] || die "merge-derived needs <base> <ours> <theirs> <path>"
  case "$4" in *.json) return 0 ;; esac
  local tmp n
  tmp=$(mktemp -d) || return 1
  # Each block collapses to one fixed line, so blocks that differ merge as unchanged text.
  local f
  for f in base:"$1" ours:"$2" theirs:"$3"; do
    awk '/^<!-- AUTO:START/ {print "<!-- AUTO:BLOCK -->"; skip=1; next}
         skip && /^<!-- AUTO:END/ {skip=0; next} !skip' "${f#*:}" > "$tmp/${f%%:*}"
  done
  if ! git merge-file -q -p "$tmp/ours" "$tmp/base" "$tmp/theirs" > "$tmp/merged"; then
    rm -rf "$tmp"; return 1
  fi
  n=$(grep -c '^<!-- AUTO:START' "$2")
  [ "$(grep -c '^<!-- AUTO:BLOCK -->$' "$tmp/merged")" = "$n" ] || { rm -rf "$tmp"; return 1; }
  # Put the local blocks back, in order.
  awk 'NR == FNR { if (/^<!-- AUTO:START/) {i++; inb=1} if (inb) blk[i] = blk[i] $0 "\n"
                   if (inb && /^<!-- AUTO:END/) inb=0; next }
       /^<!-- AUTO:BLOCK -->$/ {printf "%s", blk[++j]; next} {print}' "$2" "$tmp/merged" > "$tmp/out" \
    && cat "$tmp/out" > "$2"
  local rc=$?
  rm -rf "$tmp"
  return "$rc"
}

remotes() { local r; for r in origin backup; do g remote get-url "$r" >/dev/null 2>&1 && echo "$r"; done; }

# settle_closes <ref> <merge-tree output> <message>: a merge of HEAD and <ref> whose every conflict is
# a queue item one side closed (queue/done/) and the other moved to another open state, as a rename/
# rename no merge driver sees: a worker's session closed its item before the dispatcher's running move
# reached it (razer-laptop, 2026-11-21, canary-flee-3be2; ar-268 and ar-1801 on 11-20, ar-3439). The
# close wins whole, the rule merge-item applies to two closes. Prints the merge commit; rc 1, and
# nothing written but objects, when any conflict is another kind.
settle_closes() {
  local ref="$1" tree p side base at idx t rc=0 paths=() keep=()
  declare -A done_at=()
  tree=$(head -n 1 <<<"$2")
  mapfile -t paths < <(tail -n +2 <<<"$2" | sed '/^$/d')
  [ "${#paths[@]}" -gt 0 ] || return 1
  for p in "${paths[@]}"; do
    [[ "$p" =~ ^queue/(queued|running|waiting|review|done/[^/]+)/[^/]+\.md$ ]] || return 1
    [[ "$p" = queue/done/* ]] || continue
    for side in HEAD "$ref"; do
      g cat-file -e "$side:$p" 2>/dev/null || continue
      # Two closes of one item are merge-item's call, made already: one it refused stays a conflict.
      [ -z "${done_at[${p##*/}]:-}" ] || return 1
      done_at[${p##*/}]="$side $p"
    done
  done
  for p in "${paths[@]}"; do [ -n "${done_at[${p##*/}]:-}" ] || return 1; done
  # A name only: read-tree writes the index, and an empty file is not one.
  idx=$(mktemp) && rm -f "$idx" || return 1
  # Every copy of the item goes, then the closed one comes back from the side that closed it.
  GIT_INDEX_FILE=$idx g read-tree "$tree" &&
    GIT_INDEX_FILE=$idx g update-index --force-remove -- "${paths[@]}" || rc=1
  for base in "${!done_at[@]}"; do
    [ "$rc" = 0 ] || break
    at=${done_at[$base]}; side=${at%% *}; p=${at#* }
    keep+=("$base")
    g ls-tree "$side" -- "$p" | GIT_INDEX_FILE=$idx g update-index --index-info || rc=1
  done
  [ "$rc" = 0 ] && t=$(GIT_INDEX_FILE=$idx g write-tree) || rc=1
  rm -f "$idx"
  [ "$rc" = 0 ] || return 1
  g commit-tree "$t" -p HEAD -p "$ref" -m "$3, the close kept for ${keep[*]}"
}

# open_twins <tree> -> the paths in <tree> of an item open (queued, running, waiting, review) that
# queue/done/ also holds, one a line. A close on one side and a move on the other that git does not pair
# as renames (a short item, or one under 50% alike) merge clean as two deletes and two adds, leaving both
# copies: the open one is a ghost agent-queue lists with no page (ar-3439 /code-review high, ar-4262).
open_twins() {
  g ls-tree -r --name-only "$1" -- queue | awk '
    /^queue\/done\/[^\/]+\/[^\/]+\.md$/ { n = $0; sub(/.*\//, "", n); closed[n] = 1; next }
    /^queue\/(queued|running|waiting|review)\/[^\/]+\.md$/ { n = $0; sub(/.*\//, "", n); open[$0] = n }
    END { for (p in open) if (open[p] in closed) print p }'
}

# drop_twins <ref> <tree> <twins> <message>: the merge commit of HEAD and <ref> with <tree> less the
# <twins> paths (open_twins): the close wins, as settle_closes keeps it on a conflict. Prints the commit.
drop_twins() {
  local idx t rc=0 paths=()
  mapfile -t paths <<<"$3"
  idx=$(mktemp) && rm -f "$idx" || return 1
  GIT_INDEX_FILE=$idx g read-tree "$2" &&
    GIT_INDEX_FILE=$idx g update-index --force-remove -- "${paths[@]}" &&
    t=$(GIT_INDEX_FILE=$idx g write-tree) || rc=1
  rm -f "$idx"
  [ "$rc" = 0 ] || return 1
  g commit-tree "$t" -p HEAD -p "$1" -m "$4, the close kept for ${paths[*]##*/}"
}

# commit_paths <message> <path>...: stage and commit those paths (those that exist), nothing else.
commit_paths() {
  local msg="$1" p have=()
  shift
  for p in "$@"; do [ -e "$STORE/$p" ] || g ls-files --error-unmatch -- "$p" >/dev/null 2>&1 && have+=("$p"); done
  [ "${#have[@]}" -gt 0 ] || return 0
  # Queue items and spin-down markers move while the walk runs, and git add aborts on one that
  # vanished between its readdir and its stat ("unable to stat ...: No such file"): the next walk
  # no longer sees it. Retry the add; a failure that repeats is real (a lock, a full disk).
  local try=0
  until g add -A -- "${have[@]}"; do
    try=$((try + 1))
    [ "$try" -lt "$ADD_TRIES" ] || return 1
  done
  g diff --cached --quiet && return 0
  g -c core.hooksPath=/dev/null commit -q -m "$msg" >/dev/null
}

# clear_stale_lock: remove the index.lock or ref lock a killed git left; a crash mid-commit leaves
# HEAD.lock or the branch's, mid-fetch a remote branch's, and every commit or fetch after it fails
# on "cannot lock ref" (~/.notes, 2026-11-20, ar-2940). Run under the sync lock, so no other
# store-sync is in git here; a lock younger than STALE_LOCK_MIN or held open stays, and so does
# every lock on a machine with no fuser to ask. git closes a ref lock before renaming it, so for
# those the age is the guard.
clear_stale_lock() {
  local lk at r locks=("$STORE/.git/index.lock" "$STORE/.git/HEAD.lock" "$STORE/.git/refs/heads/$BRANCH.lock")
  for r in $(remotes); do locks+=("$STORE/.git/refs/remotes/$r/$BRANCH.lock"); done
  for lk in "${locks[@]}"; do
    [ -e "$lk" ] && [ -n "$(find "$lk" -maxdepth 0 -mmin +"$STALE_LOCK_MIN" 2>/dev/null)" ] || continue
    command -v fuser >/dev/null 2>&1 \
      || { log "WARN: $lk is over ${STALE_LOCK_MIN}m old, and with no fuser to check for a holder it stays"; continue; }
    [ -z "$(fuser "$lk" 2>/dev/null)" ] || continue
    at=$(date -r "$lk" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo 'an unknown time')
    rm -f "$lk" && log "WARN: removed $lk, left at $at by a git that no longer holds it"
  done
  return 0
}

ref_of() { g rev-parse -q --verify "refs/remotes/$1/$BRANCH" 2>/dev/null; }

# heal_head: an unclean shutdown can lose the newest loose objects while HEAD, already on disk, still
# names them, and every commit after it fails on "bad tree object HEAD" (the fleet home, 2026-11-20:
# six hours stuck after a crash, ar-3439). A remote that took HEAD before the crash holds them, so a
# full refetch puts them back; with none, the sync stops and says so. A refetch that reached a remote
# and still left HEAD broken is not repeated for that HEAD (REFETCHED), since every write starts a sync.
heal_head() {
  g rev-parse -q --verify HEAD >/dev/null || return 0
  g ls-tree -r HEAD >/dev/null 2>&1 && { rm -f "$REFETCHED"; return 0; }
  local r head reached=0 err=""
  head=$(g rev-parse --short HEAD)
  if [ "$(cat "$REFETCHED" 2>/dev/null)" != "$head" ]; then
    for r in $(remotes); do
      if ! err=$(net "$r" -C "$STORE" fetch -q --refetch "$r" "+refs/heads/$BRANCH:refs/remotes/$r/$BRANCH" 2>&1); then
        err=$(printf '%s' "$err" | tail -n 1 | cut -c1-200)
        continue
      fi
      reached=1
      g ls-tree -r HEAD >/dev/null 2>&1 || continue
      log "WARN: HEAD $head named trees missing here (an unclean shutdown?); refetched them from $r"
      return 0
    done
    [ "$reached" = 0 ] && { log "ERROR: HEAD $head names trees missing here, and no remote answered to refetch them (${err:-no remote}); the next sync tries again"; exit "$EXIT_NO_COMMIT"; }
    printf '%s\n' "$head" > "$REFETCHED"
  fi
  log "ERROR: HEAD $head names trees missing here and no remote has them; repair $STORE by hand (QUEUE.md, Troubleshooting)"
  exit "$EXIT_NO_COMMIT"
}


# This machine's own state in the store's tree: written here, read here, never shared. A shared copy
# is rewritten by every wake, so two peers' commits of it conflict and stop the sync (the panes file,
# ar-3327). They go in this clone's info/exclude, as the merge attributes go in info/attributes.
LOCAL_ONLY=(dispatch/.wake dispatch/.kick dispatch/.past-starts dispatch/.beside dispatch/after-pending)
apply_local_excludes() {
  local ex a
  [ "$STORE_NAME" = agent ] || return 0
  ex=$(g rev-parse --path-format=absolute --git-path info/exclude) && mkdir -p "$(dirname "$ex")" || return 0
  for a in "${LOCAL_ONLY[@]}"; do
    grep -qxF "$a" "$ex" 2>/dev/null || printf '%s\n' "$a" >> "$ex"
  done
}

# wake_on_pull -- a sync that pulled an item queued or closed wakes a fleet-dispatch kick (dispatch_wake) on
# the lease holder, which is where a kick runs: an add or close made in a worker's store clone reaches the
# holder only through this pull, and the holder's own writers touch .wake themselves (plan
# dispatch-event-wake, step 5). SYNC_BASE is HEAD with this machine's own writes committed, so only
# what came in differs from it. A close arrives as a move into queue/done and a release of a held item as
# an edit of a queued file, so renames are off and an edit counts with an add. No pipe into grep -q: its
# early exit would SIGPIPE a long diff, and pipefail would read the match as none.
wake_on_pull() {
  [ "$STORE_NAME" = agent ] && [ -n "${SYNC_BASE:-}" ] || return 0
  [ -n "$(g diff --no-renames --diff-filter=AM --name-only "$SYNC_BASE" HEAD -- queue/queued queue/done 2>/dev/null)" ] || return 0
  fleet-lease held >/dev/null 2>&1 || return 0
  dispatch_wake "store-sync pulled a change in queue/"
}

# sync_one <remote>: fetch it, merge it into HEAD, push HEAD to it.
# 0 the remote holds HEAD, 1 unreachable (FETCH_ERR says why), 2 a merge conflict, 3 the push
# failed (rejected because another machine pushed first, or a transient error).
sync_one() {
  local r="$1" ref files=() err
  PUSH_ERR=""
  # One conflict file per remote: a clean origin merge must not clear a backup conflict.
  local cf="$CONFLICT"; [ "$r" = origin ] || cf="$CONFLICT-$r"
  # master alone: the lease branch (fleet-lease) is not the store, and its history stays off clones.
  if ! FETCH_ERR=$(net "$r" -C "$STORE" fetch -q "$r" "+refs/heads/$BRANCH:refs/remotes/$r/$BRANCH" 2>&1); then
    FETCH_ERR=$(printf '%s' "$FETCH_ERR" | tail -n 1 | cut -c1-200)
    return 1
  fi
  ref=$(ref_of "$r")
  if [ -n "$ref" ] && ! g merge-base --is-ancestor "$ref" HEAD; then
    # Every file the remote changed since the merge base that is dirty here goes into a commit
    # first, so the merge sees both sides instead of refusing to touch the working tree.
    mapfile -t files < <(comm -12 \
      <(g diff -z --no-renames --name-only "HEAD...$ref" | tr '\0' '\n' | sort -u) \
      <(g status -z --porcelain=v1 -uall --no-renames | tr '\0' '\n' | cut -c4- | sort -u))
    if [ "${#files[@]}" -gt 0 ]; then
      commit_paths "$HOST_TAG store-sync: local edits before merging $r $(date '+%Y-%m-%d_%H:%M:%S')" "${files[@]}" || return 3
    fi
    if g merge-base --is-ancestor HEAD "$ref"; then
      g merge -q --ff-only "$ref" >/dev/null 2>&1 || return 3
    elif [ "$(cat "$cf" 2>/dev/null)" = "$(g rev-parse HEAD) $ref" ]; then
      CONFLICT_FILES=""
      return 2
    else
      # The merge is tried in memory first (merge-tree runs the same merge drivers), so a conflict
      # never touches the working tree. A conflicted `git merge` had to be aborted, and a queue
      # write landing on a file it brought in made the abort fail and left MERGE_HEAD behind, which
      # every later sync read as a person's merge (razer-laptop, 2026-11-20, ar-3439).
      local tree trc merged msg twins=''
      msg="$HOST_TAG store-sync: merge $r $(date '+%Y-%m-%d_%H:%M:%S')"
      tree=$(g merge-tree --write-tree --name-only --no-messages HEAD "$ref" 2>/dev/null); trc=$?
      [ "$trc" != 0 ] || twins=$(open_twins "$(head -n 1 <<<"$tree")")
      if { [ "$trc" = 1 ] && merged=$(settle_closes "$ref" "$tree" "$msg"); } ||
        { [ -n "$twins" ] && merged=$(drop_twins "$ref" "$(head -n 1 <<<"$tree")" "$twins" "$msg"); }; then
        # HEAD is its first parent, so a fast-forward takes it; a write here on a path it changes
        # refuses it, and the next round commits that write and settles again.
        if ! err=$(g -c core.hooksPath=/dev/null merge -q --ff-only "$merged" 2>&1); then
          PUSH_ERR="merging $r: $(printf '%s' "$err" | grep -m1 -E '^(error|fatal)' | cut -c1-200)"
          return 3
        fi
      # Any other non-zero exit (unrelated histories, say) cannot merge either: stuck the same way.
      elif [ "$trc" != 0 ]; then
        CONFLICT_FILES=$(printf '%s\n' "$tree" | awk 'NR>1 && NF && NR<=6' | tr '\n' ' ')
        [ "$trc" = 1 ] || CONFLICT_FILES="(git merge-tree exit $trc) "
        # Page on entering the stuck state only: a notes conflict once sat unseen for two days.
        [ -f "$cf" ] || notify high "The $STORE_NAME store on $HOST_TAG hit a merge conflict with $r in ${CONFLICT_FILES:-some files} and stopped syncing with $r; local commits are kept. Resolve it in $STORE; see $LOG"
        printf '%s %s\n' "$(g rev-parse HEAD)" "$ref" > "$cf"
        return 2
      # Clean in memory, so this merge fails when the working tree refuses it (a write here on a
      # path it changes); the next round commits that write and tries again.
      elif ! err=$(g -c core.hooksPath=/dev/null merge -q --no-edit -m "$msg" "$ref" 2>&1); then
        PUSH_ERR="merging $r: $(printf '%s' "$err" | grep -m1 -E '^(error|fatal)' | cut -c1-200)"
        if g rev-parse -q --verify MERGE_HEAD >/dev/null && ! g merge --abort >/dev/null 2>&1; then
          log "ERROR: store-sync's own merge of $r could not be aborted (a write landed on a file it brought in); in $STORE: git merge --abort, or finish the merge, then store-sync"
          exit 1
        fi
        return 3
      fi
    fi
  fi
  rm -f "$cf"
  [ "$(ref_of "$r")" = "$(g rev-parse HEAD)" ] && return 0
  if PUSH_ERR=$(net "$r" -C "$STORE" push -q "$r" "HEAD:refs/heads/$BRANCH" 2>&1); then
    g update-ref "refs/remotes/$r/$BRANCH" HEAD
    return 0
  fi
  PUSH_ERR=$(printf '%s' "$PUSH_ERR" | tail -n 1 | cut -c1-200)
  return 3
}

has_remote() { g remote get-url "$1" >/dev/null 2>&1; }
at_head() { [ "$(ref_of "$1")" = "$(g rev-parse HEAD)" ]; }

cmd_sync() {
  local mode=all paths=(.) bg=0 a fwd=()
  for a in "$@"; do
    case "$a" in
      --now) mode=now; paths=("${NOW_PATHS[@]}"); fwd+=("$a") ;;
      --bg) bg=1 QUIET=1 ;;
      *) die "unknown flag $a (try --help)" ;;
    esac
  done
  # A write hook on a machine that is not a peer yet does nothing; the timer logs why.
  if [ ! -d "$STORE/.git" ] || { [ "$NEEDS_JOIN" = 1 ] && [ ! -f "$PEER" ]; }; then
    [ "$bg" = 1 ] && exit 0
    if [ ! -d "$STORE/.git" ]; then
      [ "$NEEDS_JOIN" = 0 ] && { log "ERROR: $STORE is not a git clone (notes-bootstrap sets it up)"; exit 1; }
      die "$STORE is not a git clone (store-sync join)"
    fi
    log "ERROR: $STORE is not a peer clone yet; run store-sync join (nothing pushed)"
    exit 1
  fi
  if [ "$bg" = 1 ]; then
    # A write that left nothing dirty here costs no fork; commits a past sync could not push go
    # out with the next write or the timer.
    [ -n "$(g status --porcelain -- "${paths[@]}" 2>/dev/null)" ] || exit 0
    # The fork outlives its caller and waits up to LOCK_WAIT_S on the sync lock, so it drops every
    # descriptor it inherited: agent-queue's queue lock on fd 8 held each queue write behind a long sync
    # (2026-11-18). Inside a service's cgroup it gets its own scope: there a fork started after the
    # stop sweep (an agent-queue the sweep TERMed runs its EXIT hook) sat in flock -w unsignalled until
    # the stop timeout SIGKILLed it and failed the unit (ar-4685). The cgroup decides, not INVOCATION_ID,
    # which every session a unit's tmux spawned still carries.
    [ "${STORE_SYNC_FG:-0}" = 1 ] || {
      local cg="" cgf="${STORE_SYNC_CGROUP:-/proc/self/cgroup}"
      [ -r "$cgf" ] && while IFS= read -r cg; do [[ "$cg" == 0::* ]] && break; cg=""; done < "$cgf"
      ( for a in /dev/fd/*; do a="${a##*/}"; [ "$a" -gt 2 ] && eval "exec $a>&-"; done
        if [[ "$cg" == *.service ]]; then
          systemd-run --user --scope --quiet setsid -f "$0" --store "$STORE_NAME" "${fwd[@]}" && exit 0
          log "WARN: systemd-run gave the background sync no scope; it runs in ${cg#0::}, whose stop may kill it"
        fi
        exec setsid -f "$0" --store "$STORE_NAME" "${fwd[@]}" ) </dev/null >/dev/null 2>/dev/null
      exit 0
    }
  fi

  # Every push is HEAD:$BRANCH, so a clone left on another branch would push it over $BRANCH.
  [ "$(g symbolic-ref -q --short HEAD)" = "$BRANCH" ] \
    || { log "ERROR: $STORE is on $(g symbolic-ref -q --short HEAD || echo a detached HEAD), not $BRANCH; nothing synced"; exit 1; }
  mkdir -p "$SYNC_DIR"
  exec 9>"$SYNC_DIR/lock"
  flock -w "$LOCK_WAIT_S" 9 || { log "SKIP: another sync held the lock past ${LOCK_WAIT_S}s; the next sync pushes this write"; exit 0; }
  # A merge resolved by hand (QUEUE.md, Troubleshooting), or any other git step left with unmerged
  # files, is a person's work in progress: a sync that staged its paths would record the conflicted
  # files as resolved, markers and all. Our own merges finish or abort under this lock.
  if g rev-parse -q --verify MERGE_HEAD >/dev/null || [ -n "$(g ls-files -u 2>/dev/null)" ]; then
    log "ERROR: a merge is in progress in $STORE; commit it or git merge --abort, then store-sync (nothing synced)"
    exit 1
  fi
  # Writes in a burst each start a sync; the first one through the lock carries them all.
  [ "$mode" = now ] && [ -z "$(g status --porcelain -- "${paths[@]}" 2>/dev/null)" ] && at_head origin && exit 0
  load_conf
  apply_remotes
  apply_merge_drivers
  apply_local_excludes
  # An interrupted fetch leaves .git/objects/pack/tmp_pack_*, which only gc removes: on 2026-09-14
  # a flapping notes remote left 4 GB of them in 21 minutes. The age floor spares a live transfer.
  find "$STORE/.git/objects/pack" -maxdepth 1 -name 'tmp_pack_*' -mmin +60 -delete 2>/dev/null
  clear_stale_lock
  heal_head
  commit_paths "$HOST_TAG store-sync $mode $(date '+%Y-%m-%d_%H:%M:%S')" "${paths[@]}" \
    || { log "ERROR: could not commit ${paths[*]}"; exit "$EXIT_NO_COMMIT"; }
  SYNC_BASE=$(g rev-parse HEAD 2>/dev/null)
  trap wake_on_pull EXIT

  local round=0 again r rc rs=() conflict=""
  declare -A down=() why=()
  mapfile -t rs < <(remotes)
  [ "${#rs[@]}" -gt 0 ] || { log "ERROR: $STORE has no origin or backup remote (${CONF:-notes-sync-bootstrap.sh sets them})"; exit 1; }
  while [ "$round" -lt "$TRIES" ]; do
    round=$((round + 1)) again=0
    for r in "${rs[@]}"; do
      [ -z "${down[$r]:-}" ] || continue
      # Backup takes a write after origin has it, while origin is unreachable, or in the last
      # round once origin has refused it; so it never runs ahead of an origin that takes writes.
      if [ "$r" = backup ] && has_remote origin && [ -z "${down[origin]:-}" ] && ! at_head origin && [ "$round" -lt "$TRIES" ]; then
        again=1; continue
      fi
      sync_one "$r"; rc=$?
      case "$rc" in
        1) down[$r]=1 why[$r]="$FETCH_ERR" ;;
        2) conflict="merging $r conflicts in ${CONFLICT_FILES:-the same files as last time}"
           [ "$r" = origin ] && { log "ERROR: $conflict; resolve by hand in $STORE (local commits kept, nothing pushed)"; exit 1; }
           down[$r]=1 why[$r]="merge conflict" ;;
        3) again=1 why[$r]="${PUSH_ERR:-could not merge}" ;;
      esac
    done
    # A merge from backup moves HEAD past what origin got this round.
    for r in "${rs[@]}"; do [ -n "${down[$r]:-}" ] || at_head "$r" || again=1; done
    [ "$again" = 1 ] || break
  done

  local head bk="backup none"
  head=$(g rev-parse --short HEAD)
  if has_remote backup; then
    if at_head backup; then
      bk="backup at $head"; track_backup 0
    else
      bk="backup failed: ${why[backup]:-behind}"
      # With origin down too this machine is offline, which says nothing about backup.
      [ -n "${down[origin]:-}" ] || track_backup 1
    fi
  fi
  if has_remote origin && at_head origin; then
    log "COMPLETE: origin at $head, $bk"
  elif [ -n "${down[origin]:-}" ] && [ "$bk" = "backup at $head" ]; then
    log "BACKUP: origin unreachable (${why[origin]}); the write is on backup at $head"
  elif [ -n "${down[origin]:-}" ] && [ -z "$conflict" ] && { ! has_remote backup || [ -n "${down[backup]:-}" ]; }; then
    log "SKIP: no remote reachable (${why[origin]}); $(g rev-list --count "refs/remotes/origin/$BRANCH..HEAD" 2>/dev/null || echo some) commit(s) kept for the next sync"
  else
    log "ERROR: origin did not take $head after $TRIES rounds: ${why[origin]:-unknown}; $bk"
    exit 1
  fi
  [ -z "$conflict" ] || { log "ERROR: $conflict; resolve by hand in $STORE (local commits kept)"; exit 1; }
}

cmd_join() {
  local keep=0 a stamp url ahead=1 moved=""
  for a in "$@"; do
    case "$a" in --keep-dirty) keep=1 ;; *) die "unknown flag $a (try --help)" ;; esac
  done
  [ "$NEEDS_JOIN" = 1 ] || die "the $STORE_NAME store has no join: its clone already syncs as a peer"
  load_conf
  url="${STORE_PRIMARY_URL:-$(g remote get-url origin 2>/dev/null)}"
  [ -n "$url" ] || die "no origin: set STORE_PRIMARY_URL in $CONF"
  stamp=$(date +%Y%m%d%H%M%S)
  if [ -d "$STORE/.git" ]; then
    apply_remotes
    net origin -C "$STORE" fetch -q origin "+refs/heads/$BRANCH:refs/remotes/origin/$BRANCH" 2>/dev/null || die "origin ($url) is unreachable; join needs it"
    g merge-base --is-ancestor HEAD "refs/remotes/origin/$BRANCH" 2>/dev/null && ahead=0
    if [ "$ahead" = 0 ] && { [ "$keep" = 1 ] || [ -z "$(g status --porcelain)" ]; }; then
      g merge -q --ff-only "refs/remotes/origin/$BRANCH" >/dev/null 2>&1 \
        || die "a dirty file here is also changed on origin; commit or move it, then join again"
      mkdir -p "$SYNC_DIR"; printf 'joined %s in place\n' "$(date -Is)" > "$PEER"
      log "JOIN: $STORE is a peer clone in place at $(g rev-parse --short HEAD)"
      return 0
    fi
  fi
  # Not a clone, ahead of origin, or dirty: the remote's copy replaces it, and the old one is kept.
  local new="$STORE.peer-new-$stamp"
  net origin clone -q --single-branch -b "$BRANCH" "$url" "$new" 2>&1 | tail -n 1 >&2
  # A fresh clone has no commits of its own, so backup's copy is as safe a start as origin's.
  if [ ! -d "$new/.git" ] && [ -n "$STORE_BACKUP_URL" ]; then
    rm -rf "$new"
    net backup clone -q --single-branch -b "$BRANCH" "$STORE_BACKUP_URL" "$new" 2>&1 | tail -n 1 >&2
    [ ! -d "$new/.git" ] || echo "store-sync: origin unreachable; cloned backup, and writes go there until origin answers" >&2
  fi
  [ -d "$new/.git" ] || die "clone of $url failed"
  if [ -e "$STORE" ]; then
    moved="$STORE.pre-peer-$stamp"
    mv "$STORE" "$moved" || die "could not move $STORE aside"
  fi
  mv "$new" "$STORE" || die "could not move the clone into $STORE"
  apply_remotes
  mkdir -p "$SYNC_DIR"; printf 'joined %s by a fresh clone\n' "$(date -Is)" > "$PEER"
  log "JOIN: $STORE is a fresh peer clone at $(g rev-parse --short HEAD)${moved:+; the old store is kept at $moved}"
}

case "${1:-}" in
  join) shift; cmd_join "$@" ;;
  merge-derived) shift; cmd_merge_derived "$@" ;;
  merge-item) shift; cmd_merge_item "$@" ;;
  -h | --help) usage ;;
  *) cmd_sync "$@" ;;
esac
