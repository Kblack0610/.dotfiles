#!/usr/bin/env bash
# agent-queue - the one intake for agent work, and the only writer of its store.
#
#   add [--project p] [--mode oneshot|plan] [--priority urgent|high|low] [--tags "t1 t2"]
#       [--weight heavy|light] [--after slug] [--from human|shepherd|board:<project>:<key>] [--agent claude] [--slug s]
#       [--running [--session s]] [task...]    the task from args, or stdin when there are none
#   add --plan <plan.md> [--dry-run] [--project p] [--priority p] [--tags t] [--weight w] [--after slug] [--slug prefix]
#       one oneshot item per unchecked `## Phases` line, each after the one before
#   list [--json] [--state queued|running|waiting|done|active|all] [--date YYYY-MM-DD]
#   next [--json] | show <slug> [--json] | cancel <slug> | bump <slug> <priority>
#   mine [--session s]    the slug of the running or waiting item this tmux session records
#   set <slug> <key=value>... | move <slug> <state> [--status ok|failed|cancelled]
#   stats [--json] [--since YYYY-MM-DD]
# A plan item starts its session at once (fleet-dispatch start --item), and so does the next item
# `after:` one that closes ok; AGENT_QUEUE_START=0 only queues.
# Weight: heavy holds two of fleet-dispatch's run units, light one; see item_weight.
# Holds: `after <slug>`, and the tags night, at:HH:MM and pr:<owner>/<repo>#<N> (until that PR merges).
#
# One file per item under $AGENT_QUEUE_DIR/<state>/. Design: ~/.config/agentctl/QUEUE.md.
set -uo pipefail

AQ_DIR="${AGENT_QUEUE_DIR:-$HOME/.agent/queue}"
AQ_MAP="${AGENT_QUEUE_PROJECT_MAP:-$HOME/.config/shared-hooks/project-map.json}"
# The registry's resolver: this tree's project-name.sh (PROJECT_NAME_LIB when the script runs
# from a copy, as in the tests), reading the same map.
PROJECT_MAP_FILE="$AQ_MAP"
# shellcheck source=../../.config/shared-hooks/project-name.sh
. "${PROJECT_NAME_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../../.config/shared-hooks/project-name.sh}"
# The night window a `night` item may start in, local time; it may wrap midnight.
AQ_NIGHT="${AGENT_QUEUE_NIGHT:-01:00-06:00}"
AQ_TMUX_SERVER="${AGENT_QUEUE_TMUX_SERVER:-lab}"
# A `pr:<owner>/<repo>#<N>` item waits for that PR to merge; its state is cached here.
AQ_PR_CACHE="${AGENT_QUEUE_PR_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/agent-queue/pr}"
AQ_PR_TTL="${AGENT_QUEUE_PR_TTL:-120}"
ACTIVE="queued running waiting"

die() { echo "agent-queue: $*" >&2; exit 1; }
now_utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }
# The caller's own session as an item records it: <tmux server>:<session>, the shape reap reads.
own_session() {
  [ -n "${TMUX:-}" ] || return 1
  local name
  name="$(tmux display-message -p '#{session_name}' 2>/dev/null)"
  [ -n "$name" ] || return 1
  printf '%s:%s\n' "$(basename "${TMUX%%,*}")" "$name"
}

# --- the file format ---
# `key: value` lines, a `---` line, then the task as typed.
fm_get() { # file key
  awk -v k="$2" '$0 == "---" { exit }
    index($0, k ":") == 1 { v = substr($0, length(k) + 2); sub(/^ +/, "", v); print v; exit }' "$1" 2>/dev/null
}
fm_body() { awk 'f { print } $0 == "---" { f = 1 }' "$1" 2>/dev/null; }

slugify() {
  printf '%s' "$1" | head -1 | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | tr -s '-' \
    | sed 's/^-//; s/-$//' | cut -c1-40 | sed 's/-$//'
}

# urgent|high|low, as on the sheets. A bare add is high: nobody decided, so it is not demoted.
prio_rank() { case "$1" in urgent) echo 0 ;; high) echo 1 ;; low) echo 2 ;; *) return 1 ;; esac; }

# Mutations take one lock, so the web page, the shepherd and the dispatcher never interleave.
# The wait is a timeout guard, not a delay: a writer holds it for milliseconds.
lock() {
  mkdir -p "$AQ_DIR" || die "cannot create $AQ_DIR"
  exec 8> "$AQ_DIR/.lock"
  flock -w 10 8 || die "the queue is locked by another writer"
}
# Reads share the lock, so a list never sees an item a writer is moving between states.
lock_read() {
  [ -d "$AQ_DIR" ] || return 0
  exec 8> "$AQ_DIR/.lock"
  flock -s -w 10 8 || die "the queue is locked by another writer"
}

items_in() { # state-dir -> item files, oldest first
  local f
  for f in "$1"/*.md; do [ -e "$f" ] && printf '%s\n' "$f"; done | sort
}

# slug_files <slug> <glob-dir>... -> the item files whose `slug:` header is exactly this slug.
# The file name only narrows the search: `*-first.md` also matches `x-first`, and a second
# finish on the same day carries a `-2` suffix.
slug_files() {
  local slug="$1" d f
  shift
  for d in "$@"; do
    for f in "$d"/*"$slug"*.md; do
      [ -e "$f" ] && [ "$(fm_get "$f" slug)" = "$slug" ] && printf '%s
' "$f"
    done
  done
}

# latest_done <slug> -> the most recently finished item with this slug; the file's mtime breaks a
# tie inside one second, since `finished` is whole seconds for jq's date parser.
latest_done() {
  local f
  slug_files "$1" "$AQ_DIR"/done/* | while IFS= read -r f; do
    printf '%s\t%s\t%s\n' "$(fm_get "$f" finished)" "$(stat -c %.9Y "$f")" "$f"
  done | sort | tail -1 | cut -f3-
}

# find_item <slug> [any] -> the active item with that slug; `any` falls back to the latest
# finished one, so `show` and `set` reach a done item.
find_item() {
  local s f
  for s in $ACTIVE; do
    f="$(slug_files "$1" "$AQ_DIR/$s" | head -1)"
    [ -n "$f" ] && { printf '%s\n' "$f"; return 0; }
  done
  [ "${2:-}" = any ] || return 1
  f="$(latest_done "$1")"
  [ -n "$f" ] && printf '%s\n' "$f"
}

state_of() { # file -> its state, from its directory
  case "$1" in "$AQ_DIR"/done/*) echo "done" ;; *) basename "$(dirname "$1")" ;; esac
}

# The status of the most recent finished item with this slug, empty if none.
done_status() {
  local f
  f="$(latest_done "$1")"
  [ -n "$f" ] && fm_get "$f" status
}

# hhmm_in <HH:MM> <from-to> -> true when the time is inside the window, which may wrap midnight.
hhmm_in() {
  local t="${1/:/}" a="${2%-*}" b="${2#*-}"
  a="${a/:/}"; b="${b/:/}"
  if [ "$a" -le "$b" ]; then [ "$t" -ge "$a" ] && [ "$t" -lt "$b" ]
  else [ "$t" -ge "$a" ] || [ "$t" -lt "$b" ]; fi
}

# hold_reason <file> -> why a queued item cannot start yet, or nothing when it can.
hold_reason() {
  local f="$1" after tag now
  after="$(fm_get "$f" after)"
  if [ -n "$after" ] && [ "$(done_status "$after")" != ok ]; then echo "after $after"; return; fi
  now="${AGENT_QUEUE_NOW:-$(date +%H:%M)}"
  for tag in $(fm_get "$f" tags); do
    case "$tag" in
      night) hhmm_in "$now" "$AQ_NIGHT" || { echo "night ($AQ_NIGHT)"; return; } ;;
      at:[0-9][0-9]:[0-9][0-9]) [ "${now/:/}" -ge "$(printf '%s' "${tag#at:}" | tr -d :)" ] || { echo "$tag"; return; } ;;
      pr:?*/?*#[0-9]*) [ "$(pr_state "${tag#pr:}")" = MERGED ] || { echo "$tag not merged"; return; } ;;
    esac
  done
}

# pr_state <owner/repo#N> -> the PR's state from gh (MERGED, OPEN, CLOSED), or nothing when gh
# cannot say, which holds the item. MERGED never changes, so it is cached for good; any other
# state for AQ_PR_TTL seconds, so a list or a dispatch pass costs one gh call per PR.
pr_state() {
  local ref="$1" f state
  f="$AQ_PR_CACHE/$(printf '%s' "$ref" | tr '/#' '__')"
  if [ -f "$f" ]; then
    state="$(cat "$f")"
    if [ "$state" = MERGED ] || [ $(( $(date +%s) - $(stat -c %Y "$f") )) -lt "$AQ_PR_TTL" ]; then
      echo "$state"; return
    fi
  fi
  state="$(gh pr view "${ref##*#}" -R "${ref%#*}" --json state -q .state 2>/dev/null)" || return 0
  mkdir -p "$AQ_PR_CACHE" && printf '%s\n' "$state" > "$f"
  echo "$state"
}

# item_json <file> -> one JSON object: every header key, plus state, file, task, and hold. An item
# with no weight line gets item_weight's answer, so every reader sees a weight.
item_json() {
  local f="$1" state hold="" weight
  state="$(state_of "$f")"
  [ "$state" = queued ] && hold="$(hold_reason "$f")"
  weight="$(fm_get "$f" weight)"
  [ -n "$weight" ] || weight="$(item_weight "$(fm_get "$f" project)" "$(fm_get "$f" mode)" "$(fm_get "$f" phases)")"
  awk '$0 == "---" { exit } { i = index($0, ":"); if (i > 1) { v = substr($0, i + 1); sub(/^ +/, "", v); print substr($0, 1, i - 1) "\t" v } }' "$f" \
    | jq -Rnc --arg state "$state" --arg file "$f" --arg task "$(fm_body "$f")" --arg hold "$hold" \
      --arg weight "$weight" '([inputs | split("\t") | {(.[0]): (.[1:] | join("\t"))}] | add // {})
       + {weight: $weight, state: $state, file: $file, task: $task} + (if $hold == "" then {} else {hold: $hold} end)'
}

# Queue order: priority, then queued time. `after` and tags do not reorder, they hold.
ORDER='sort_by((({"urgent":0,"high":1,"low":2}[.priority] // 1)), .queued)'

# collect <states...> [--date D] -> a JSON array of items.
collect() {
  local states=() date="" s f
  while [ $# -gt 0 ]; do
    case "$1" in --date) date="$2"; shift 2 ;; *) states+=("$1"); shift ;; esac
  done
  for s in "${states[@]}"; do
    if [ "$s" = "done" ]; then
      for f in "$AQ_DIR/done/${date:-$(date +%F)}"/*.md; do [ -e "$f" ] && item_json "$f"; done
    else
      while IFS= read -r f; do item_json "$f"; done < <(items_in "$AQ_DIR/$s")
    fi
  done | jq -sc "$ORDER"
}

# header_set <file> <key> <value> -> rewrite the header field in place, atomically.
header_set() {
  local f="$1" k="$2" v="$3" tmp
  case "$v" in *$'\n'*) die "a value cannot span lines: $k" ;; esac
  tmp="$(mktemp "$(dirname "$f")/.set.XXXXXX")" || die "cannot write in $(dirname "$f")"
  awk -v k="$k" -v v="$v" '
    !done && $0 == "---" { if (!seen) print k ": " v; done = 1; print; next }
    !done && index($0, k ":") == 1 { print k ": " v; seen = 1; next }
    { print }' "$f" > "$tmp" && mv -- "$tmp" "$f"
}

# move_to <file> <state> -> the new path. done/ is dated by today, and a name that is already
# there (the same slug finished twice in a day) gets a numeric suffix.
move_to() {
  local f="$1" to="$2" dir name dest n=2
  if [ "$to" = "done" ]; then dir="$AQ_DIR/done/$(date +%F)"; else dir="$AQ_DIR/$to"; fi
  mkdir -p "$dir"
  name="$(basename "$f" .md)"; dest="$dir/$name.md"
  while [ -e "$dest" ]; do dest="$dir/$name-$n.md"; n=$((n + 1)); done
  mv -- "$f" "$dest" && printf '%s\n' "$dest"
}

# project_resolve <name> -> the project an item is filed under, or nothing when dispatch could not
# start it: an alias becomes its project, and the project must reach a checkout through the
# registry (project-name.sh's project_repo_path). A game inside a repo is runnable; a notes-only
# project is not. With no map there is nothing to ask.
project_resolve() {
  [ -f "$AQ_MAP" ] || { printf '%s\n' "$1"; return 0; }
  local name
  name="$(jq -r --arg p "$1" '.aliases[$p] // $p' "$AQ_MAP" 2>/dev/null)"
  [ -n "$name" ] && [ -n "$(project_repo_path "$name")" ] && printf '%s\n' "$name"
}

project_of_cwd() {
  local top
  top="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 0
  top="$(dirname "$top")"
  [ -f "$AQ_MAP" ] && jq -r --arg r "$top" '.paths[$r] // empty' "$AQ_MAP" 2>/dev/null
}

# --- verbs ---
cmd_add() {
  local project="" mode=oneshot priority=high tags="" after="" from=human agent=claude slug=""
  local running="" session="" task=() tag planf="" dry="" weight=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project="${2:?}"; shift 2 ;;
      --mode) mode="${2:?}"; shift 2 ;;
      --priority) priority="${2:?}"; shift 2 ;;
      --weight) weight="${2:?}"; shift 2 ;;
      --tags) tags="$(printf '%s' "${2:?}" | tr ',' ' ' | tr -s ' ' | sed 's/^ //; s/ $//')"; shift 2 ;;
      --after) after="${2:?}"; shift 2 ;;
      --from) from="${2:?}"; shift 2 ;;
      --agent) agent="${2:?}"; shift 2 ;;
      --slug) slug="${2:?}"; shift 2 ;;
      --running) running=1; shift ;;
      --session) session="${2:?}"; shift 2 ;;
      --plan) planf="${2:?}"; shift 2 ;;
      --dry-run) dry=1; shift ;;
      --) shift; task+=("$@"); break ;;
      -*) die "unknown option: $1" ;;
      *) task+=("$1"); shift ;;
    esac
  done
  if [ -n "$planf" ]; then
    [ "${#task[@]}" -eq 0 ] || die "--plan writes its own tasks; pass no task with it"
    [ "$mode" = oneshot ] && [ -z "$running" ] || die "--plan items are queued oneshot items: no --mode plan or --running"
    add_plan; return
  fi
  [ -z "$dry" ] || die "--dry-run goes with --plan"
  local text
  if [ "${#task[@]}" -gt 0 ]; then text="${task[*]}"; elif [ ! -t 0 ]; then text="$(cat)"; fi
  [ -n "$(printf '%s' "${text:-}" | tr -d '[:space:]')" ] || die "no task: pass it as arguments or on stdin"
  case "$mode" in oneshot | plan) ;; *) die "--mode is oneshot or plan, not $mode" ;; esac
  prio_rank "$priority" >/dev/null || die "--priority is urgent, high or low, not $priority"
  case "$weight" in '' | heavy | light) ;; *) die "--weight is heavy or light, not $weight" ;; esac
  case "$from" in human | shepherd | board:?*:?*) ;; *) die "--from is human, shepherd or board:<project>:<key>, not $from" ;; esac
  case "$agent" in *[!a-z0-9-]* | '') die "--agent is one word, not $agent" ;; esac
  for tag in $tags; do
    case "$tag" in
      at:*) [[ "$tag" =~ ^at:([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || die "a time tag is at:HH:MM, not $tag" ;;
      pr:*) [[ "$tag" =~ ^pr:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+$ ]] || die "a PR tag is pr:<owner>/<repo>#<N>, not $tag" ;;
    esac
  done
  # A hand-started session records itself.
  if [ -n "$running" ] && [ -z "$session" ]; then session="$(own_session)" || session=""; fi
  [ -n "$project" ] || project="$(project_of_cwd)"
  [ -n "$project" ] || die "no --project, and this directory is not a repo project-map knows"
  local resolved
  resolved="$(project_resolve "$project")" || die "unknown project: $project (no checkout for it in $AQ_MAP)"
  project="$resolved"
  [ -n "$weight" ] || weight="$(item_weight "$project" "$mode" "${AQ_ITEM_PHASES:-}")"
  slug="$(slugify "${slug:-$text}")"
  [ -n "$slug" ] || die "could not derive a slug; pass --slug"
  lock
  [ -z "$(find_item "$slug")" ] || die "already in the queue: $slug"
  if [ -n "$after" ] && [ -z "$(find_item "$after")" ] && [ -z "$(done_status "$after")" ]; then
    die "--after $after: no item has that slug"
  fi
  local state=queued now; now="$(now_utc)"
  [ -n "$running" ] && state=running
  mkdir -p "$AQ_DIR/$state"
  local f tmp
  f="$AQ_DIR/$state/$(date +%Y%m%d-%H%M%S)-$slug.md"
  tmp="$(mktemp "$AQ_DIR/$state/.add.XXXXXX")" || die "cannot write in $AQ_DIR/$state"
  {
    printf 'slug: %s\nproject: %s\nmode: %s\npriority: %s\nweight: %s\n' "$slug" "$project" "$mode" "$priority" "$weight"
    [ -n "$tags" ] && printf 'tags: %s\n' "$tags"
    [ -n "$after" ] && printf 'after: %s\n' "$after"
    [ -n "${AQ_ITEM_PLAN:-}" ] && printf 'plan: %s\nphases: %s\n' "$AQ_ITEM_PLAN" "$AQ_ITEM_PHASES"
    printf 'from: %s\nagent: %s\nqueued: %s\n' "$from" "$agent" "$now"
    [ -n "$running" ] && printf 'started: %s\n' "$now"
    [ -n "$session" ] && printf 'session: %s\n' "$session"
    printf -- '---\n%s\n' "$text"
  } > "$tmp" && mv -- "$tmp" "$f" || die "could not write $f"
  echo "$state $slug -> $f"
  [ "$mode" = plan ] && [ -z "$running" ] && [ "${AGENT_QUEUE_START:-1}" = 1 ] || return 0
  # The starter writes this item back through this script: free the lock, and keep the fd out of tmux.
  exec 8>&-
  fleet-dispatch start --item "$slug" ||
    echo "agent-queue: $slug could not start now, so it stays queued for the next dispatch pass" >&2
}

# item_weight <project> <mode> <phases> -> heavy or light, for an item added without --weight.
# Heavy: the checkout is a Unity project (a session there runs an editor and pool gates), a plan
# session (it holds the whole plan), or an item that carries two or more phases. Else light.
item_weight() {
  local dir
  dir="$(project_repo_path "$1" 2>/dev/null)" || dir=""
  if [ -n "$dir" ] && [ -f "$dir/ProjectSettings/ProjectVersion.txt" ]; then echo heavy; return; fi
  [ "$2" = plan ] && { echo heavy; return; }
  [ "$(wc -w <<<"$3")" -ge 2 ] && { echo heavy; return; }
  echo light
}

# add_plan: cmd_add --plan, reading its locals. One item per unchecked phase, in checklist
# order, each `after:` the one before (the first after --after), carrying `plan:` and
# `phases:` (its checklist numbers). A phase line with `(with N)` joins phase N's item when
# phase N is open too, for phases that share a branch; the item runs where its first phase is.
# Every slug is checked before any item is written.
add_plan() {
  # The one reader of a plan's `## Phases` checklist, shared with fleet-sessions; only this verb needs it.
  # shellcheck source=../lib/plan-phases.sh
  . "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/plan-phases.sh" || die "cannot read plan-phases.sh"
  [ -f "$planf" ] || die "--plan $planf: no such file"
  planf="$(realpath "$planf")"
  [ -n "$project" ] || project="$(project_of_cwd)"
  [ -n "$project" ] || die "no --project, and this directory is not a repo project-map knows"
  project="$(project_resolve "$project")" || die "unknown project: $project (no checkout for it in $AQ_MAP)"
  # A plan is queued once: by its owner, or by hand. The calling session's own item does not count.
  local taken
  taken="$(collect $ACTIVE | jq -r --arg p "$planf" --arg own "${AGENT_QUEUE_ITEM:-}" \
    "$PLAN_ITEMS_JQ"' .[] | select(.slug != $own and names_plan($p)) | .slug' | paste -sd' ')"
  [ -z "$taken" ] || die "the phases of $planf are already queued: $taken (nothing was added)"
  local groups
  groups="$(plan_phase_list "$planf" | jq -c '
    to_entries | map({n: (.key + 1), state: .value.state, name: .value.name,
      with: ((.value.name | capture("\\(with (?<w>[0-9]+)\\)") | .w | tonumber) // null)}) as $all
    | reduce ($all[] | select(.state == "open")) as $p ({of: {}, items: []};
        ($all[($p.with // 0) - 1]) as $w
        | if $p.with != null and $p.with < $p.n and $p.with > 0 and $w.state == "open" then
            .of[$p.n | tostring] = .of[$p.with | tostring]
            | .items[.of[$p.n | tostring]] += [$p]
          else .of[$p.n | tostring] = (.items | length) | .items += [[$p]] end)
    | .items | map({phases: map(.n), titles: map(.name | sub(" ?\\(with [0-9]+\\)"; "")
        | sub("^[0-9]+[.)] "; "") | sub("[.:] .*$"; "") | sub("[.:]$"; "") | .[0:80])})')" ||
    die "--plan $planf: could not read its Phases checklist"
  [ "$(jq length <<<"$groups")" -gt 0 ] || die "--plan $planf: no unchecked phase in its ## Phases checklist"
  local prefix
  prefix="$(slugify "${slug:-$(basename "$planf" .md)}" | cut -c1-32 | sed 's/-$//')"
  [ -n "$prefix" ] || die "could not derive a slug prefix; pass --slug"
  local rows
  rows="$(jq -r --arg pre "$prefix" --arg plan "$planf" '.[]
    | (.phases | length > 1) as $many
    | [($pre + "-p\(.phases[0])"), (.phases | join(" ")),
       ("\(if $many then "Phases \(.phases | join(" and "))" else "Phase \(.phases[0])" end) of the plan \($plan): \(.titles | join("; ")). "
        + "Read the plan whole, then do ONLY \(if $many then "these phases, on one branch" else "this phase" end), to merged. "
        + "When it lands, tick its box\(if $many then "es" else "" end) in the plan'"'"'s Phases checklist with the PR number and add a Results line. "
        + "If the phase is already landed, or something it waits on (a named PR, an earlier phase, a deploy) is not in place, stop and say what is missing instead of working around it.")]
    | @tsv' <<<"$groups")"
  local s ph text prev="$after"
  while IFS=$'\t' read -r s ph text; do
    [ -z "$(find_item "$s")" ] || die "already in the queue: $s (nothing was added)"
  done <<<"$rows"
  if [ -n "$after" ] && [ -z "$(find_item "$after")" ] && [ -z "$(done_status "$after")" ]; then
    die "--after $after: no item has that slug"
  fi
  local n=0 total
  total="$(wc -l <<<"$rows")"
  while IFS=$'\t' read -r s ph text; do
    if [ -n "$dry" ]; then
      printf 'would queue %s\tphases %s\tafter %s\n  %s\n' "$s" "$ph" "${prev:--}" "$text"
    else
      AQ_ITEM_PLAN="$planf" AQ_ITEM_PHASES="$ph" \
        cmd_add_one ${project:+--project "$project"} --priority "$priority" ${tags:+--tags "$tags"} ${weight:+--weight "$weight"} \
          --from "$from" --agent "$agent" --slug "$s" ${prev:+--after "$prev"} -- "$text" ||
        die "added $n of $total items from $planf; $s and the rest are not queued"
    fi
    n=$((n + 1)); prev="$s"
  done <<<"$rows"
}
# One item through cmd_add, in a subshell so its die stops only that item.
cmd_add_one() { (cmd_add "$@"); }

cmd_list() {
  local json="" state=active date=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --state) state="${2:?}"; shift 2 ;;
      --date) date="${2:?}"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  local states
  case "$state" in
    active) states="waiting running queued" ;;
    all) states="waiting running queued done" ;;
    queued | running | waiting | done) states="$state" ;;
    *) die "--state is queued, running, waiting, done, active or all" ;;
  esac
  lock_read
  # shellcheck disable=SC2086
  local items; items="$(collect $states ${date:+--date "$date"})"
  if [ -n "$json" ]; then
    jq -c '.[]' <<<"$items"
    return 0
  fi
  [ "$(jq length <<<"$items")" -gt 0 ] || { echo "queue: nothing ${state/active/queued, running or waiting}"; return 0; }
  # Grouped by state in this order, queue order inside each group.
  jq -r '(["waiting","running","queued","done"]) as $o
    | sort_by(.state as $s | $o | index($s)) | .[]
    | [.state, .priority, .slug, .project, .mode,
       (.hold // .status // .session // ""), (.tags // ""), .from] | map(if . == "" then "-" else . end) | @tsv' <<<"$items"
}

cmd_next() {
  local items
  lock_read
  items="$(collect queued | jq -c '[.[] | select(.hold == null)] | first // empty')"
  [ -n "$items" ] || return 1
  if [ "${1:-}" = --json ]; then printf '%s\n' "$items"; else jq -r .file <<<"$items"; fi
}

cmd_show() {
  local slug="${1:?usage: agent-queue show <slug>}" f
  lock_read
  f="$(find_item "$slug" any)"; [ -n "$f" ] || die "no item: $slug"
  if [ "${2:-}" = --json ]; then item_json "$f"; return 0; fi
  printf 'state: %s\nfile: %s\n' "$(state_of "$f")" "$f"
  cat -- "$f"
}

# A hand-started session's item, so agent-land can close it with no slug: exit 1 when
# none records this session, 2 when more than one does (pass the slug).
cmd_mine() {
  local session='' slugs
  case "${1:-}" in --session) session="${2:?--session needs a value}" ;; '') ;; *) die "usage: agent-queue mine [--session s]" ;; esac
  [ -n "$session" ] || session="$(own_session)" || die "not in tmux: pass --session <server>:<session>"
  lock_read
  slugs="$(collect running waiting | jq -r --arg s "$session" '.[] | select(.session == $s) | .slug')"
  [ -n "$slugs" ] || return 1
  if [ "$(wc -l <<<"$slugs")" -gt 1 ]; then
    echo "agent-queue: more than one item records $session: $(tr '\n' ' ' <<<"$slugs")" >&2
    return 2
  fi
  printf '%s\n' "$slugs"
}

cmd_cancel() {
  local slug="${1:?usage: agent-queue cancel <slug>}" f session server dest
  lock
  f="$(find_item "$slug")"; [ -n "$f" ] || die "nothing active with slug $slug"
  # `session:` is <server>:<tmux session>, as fleet-dispatch writes it; a bare name is on AQ_TMUX_SERVER.
  session="$(fm_get "$f" session)"; server="$AQ_TMUX_SERVER"
  case "$session" in *:*) server="${session%%:*}"; session="${session#*:}" ;; esac
  if [ -n "$session" ] && [ "$(state_of "$f")" != queued ]; then
    if tmux -L "$server" kill-session -t "=$session" 2>/dev/null; then
      echo "killed session $session"
    else
      echo "agent-queue: session $session was not running on $server" >&2
    fi
  fi
  header_set "$f" status cancelled
  header_set "$f" finished "$(now_utc)"
  dest="$(move_to "$f" "done")" || die "could not move $f"
  echo "cancelled $slug -> $dest"
}

cmd_bump() {
  local slug="${1:?usage: agent-queue bump <slug> <priority>}" prio="${2:?usage: agent-queue bump <slug> <priority>}" f
  prio_rank "$prio" >/dev/null || die "priority is urgent, high or low, not $prio"
  lock
  f="$(find_item "$slug")"; [ -n "$f" ] || die "nothing active with slug $slug"
  header_set "$f" priority "$prio"
  echo "$slug -> $prio"
}

# The fields only the dispatcher and the session record. Identity fields (slug, queued) are not
# settable: they are what the item is. `from` is, so a project rename can move a board origin.
SETTABLE=" project mode priority tags after agent started waiting finished session account model plan pr note status area origin lane profile from "

cmd_set() {
  local slug="${1:?usage: agent-queue set <slug> <key=value>...}" f kv k
  shift
  [ $# -gt 0 ] || die "usage: agent-queue set <slug> <key=value>..."
  for kv in "$@"; do
    k="${kv%%=*}"
    [ "$k" != "$kv" ] || die "not key=value: $kv"
    case "$SETTABLE" in *" $k "*) ;; *) die "not a settable field: $k" ;; esac
    if [ "$k" = project ] && [ "$(project_resolve "${kv#*=}")" != "${kv#*=}" ]; then
      die "unknown project: ${kv#*=} (not a canonical project in $AQ_MAP)"
    fi
  done
  lock
  f="$(find_item "$slug" any)"; [ -n "$f" ] || die "no item: $slug"
  for kv in "$@"; do header_set "$f" "${kv%%=*}" "${kv#*=}"; done
  echo "$slug: $*"
}

cmd_move() {
  local slug="${1:?usage: agent-queue move <slug> <state> [--status s]}" to="${2:?usage: agent-queue move <slug> <state>}"
  local status="" f from dest
  [ "${3:-}" = --status ] && status="${4:?}"
  case "$to" in queued | running | waiting | done) ;; *) die "state is queued, running, waiting or done, not $to" ;; esac
  if [ "$to" = "done" ]; then
    case "$status" in ok | failed | cancelled) ;; *) die "move to done needs --status ok, failed or cancelled" ;; esac
  fi
  lock
  f="$(find_item "$slug")"; [ -n "$f" ] || die "nothing active with slug $slug"
  from="$(state_of "$f")"
  [ "$from" != "$to" ] || { echo "$slug already $to"; return 0; }
  case "$to" in
    running) [ -n "$(fm_get "$f" started)" ] || header_set "$f" started "$(now_utc)" ;;
    waiting) header_set "$f" waiting "$(now_utc)" ;;
    done) header_set "$f" status "$status"; header_set "$f" finished "$(now_utc)" ;;
  esac
  dest="$(move_to "$f" "$to")" || die "could not move $f"
  echo "$slug: $from -> $to"
  [ "$to" = done ] && [ "$status" = ok ] && [ "${AGENT_QUEUE_START:-1}" = 1 ] || return 0
  start_next "$slug"
}

# start_next <slug> -- the items `after:` this one start the moment it closes ok. Each takes the
# slot the closing session frees, so it waits for no dispatch pass and none of its load gates: a
# plan's next phase never sits behind fresh work. A dispatch hold (agent-hold) still holds it.
start_next() {
  local f s next=()
  while IFS= read -r f; do
    [ -n "$f" ] && [ "$(fm_get "$f" after)" = "$1" ] && [ -z "$(hold_reason "$f")" ] && next+=("$(fm_get "$f" slug)")
  done < <(items_in "$AQ_DIR/queued")
  [ ${#next[@]} -gt 0 ] || return 0
  # The starter writes these items back through this script: free the lock, and keep the fd out of tmux.
  exec 8>&-
  if ! agent-hold check dispatch >/dev/null 2>&1; then
    echo "agent-queue: dispatch is held, so ${next[*]} stays queued for the next dispatch pass" >&2
    return 0
  fi
  for s in "${next[@]}"; do
    fleet-dispatch start --item "$s" ||
      echo "agent-queue: $s could not start now, so it stays queued for the next dispatch pass" >&2
  done
  return 0
}

cmd_stats() {
  local json="" since d f s
  since="$(date -d '7 days ago' +%F)"
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --since) since="${2:?}"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  local stats
  lock_read
  stats="$({
    for s in $ACTIVE; do while IFS= read -r f; do item_json "$f"; done < <(items_in "$AQ_DIR/$s"); done
    for d in "$AQ_DIR"/done/*/; do
      [ -d "$d" ] || continue
      [[ "$(basename "$d")" < "$since" ]] && continue
      for f in "$d"*.md; do [ -e "$f" ] && item_json "$f"; done
    done
  } | jq -sc --arg since "$since" '
    def mins($a; $b): if $a and $b then ((($b | fromdateiso8601) - ($a | fromdateiso8601)) / 60 | floor) else empty end;
    def median: sort | if length == 0 then null else .[length / 2 | floor] end;
    def p90: sort | if length == 0 then null else .[(length * 0.9 | ceil) - 1] end;
    def age: ((now - (. | fromdateiso8601)) / 60 | floor);
    # A `--running` or plan item starts the minute it is added; counting its 0 hid every real wait.
    def waits: [.[] | mins(.queued; .started)];
    def waited: waits | map(select(. > 0));
    # A hold_reason line by its first word: "after x", "night (..)", "at:HH:MM", "pr:o/r#N not merged".
    def hold_kind: split(" ")[0] | split(":")[0];
    def source: (.from // "human") | split(":")[0];
    def count_by(f): group_by(f) | map({key: (.[0] | f), value: length}) | from_entries;
    def has_pr: (.pr // "") != "";
    def to_pr: [.[] | select(has_pr) | mins(.queued; .finished)] | median;
    def outcomes: {done: length, ok: map(select(.status == "ok")) | length,
      failed: map(select(.status == "failed")) | length, cancelled: map(select(.status == "cancelled")) | length,
      prs: map(select(has_pr)) | length, wait_minutes_median: (waited | median),
      to_pr_minutes_median: to_pr};
    def group(f): group_by(f) | map({key: (.[0] | f), value: outcomes}) | from_entries;
    (map(select(.state == "done"))) as $done
    | (map(select(.state == "queued"))) as $queued
    | ($queued | map(select(.hold == null) | {slug, project, minutes: (.queued | age)}) | sort_by(-.minutes)) as $runnable
    | {since: $since,
       active: (map(select(.state != "done")) | count_by(.state)),
       done: ($done | count_by(.status // "unknown")),
       wait_minutes_median: (waited | median),
       wait_minutes_p90: (waited | p90),
       started_at_once: (waits | map(select(. == 0)) | length),
       sitting: {queued: ($queued | length), runnable: ($runnable | length),
         held: ($queued | map(select(.hold)) | length),
         held_by: ($queued | map(select(.hold)) | count_by(.hold | hold_kind)),
         runnable_age_minutes_median: ($runnable | map(.minutes) | median),
         oldest_runnable: $runnable[:3]},
       added_per_day: (map(select((.queued // "")[:10] >= $since)) | count_by(.queued[:10])),
       # Flow over the last hours, for a drain trend: done by finished, added by queued.
       recent: (. as $all | [1, 6, 24] | map(. as $h | (now - $h * 3600) as $t
         | {("done_\($h)h"): ($done | map(select((.finished // "") != "" and (.finished | fromdateiso8601) >= $t)) | length),
            ("added_\($h)h"): ($all | map(select((.queued // "") != "" and (.queued | fromdateiso8601) >= $t)) | length)}) | add),
       run_minutes_median: ([$done[] | mins(.started; .finished)] | median),
       to_pr_minutes_median: ($done | to_pr),
       per_day: ($done | count_by((.finished // "")[:10])),
       by_project: ($done | group(.project)),
       by_source: ($done | group(source)),
       done_by_tag: ([$done[] | (.tags // "" | split(" ") | map(select(. != ""))[]) as $t | {t: $t}] | count_by(.t))}')"
  if [ -n "$json" ]; then printf '%s\n' "$stats"; return 0; fi
  jq -r 'def dur: if . == null then "-" elif . >= 120 then "\(. / 60 | floor)h" else "\(.)m" end;
    def pairs: to_entries | map("\(.key) \(.value)") | join(", ");
    "since \(.since)",
    "active:  \(.active | pairs | if . == "" then "none" else . end)",
    "done:    \(.done | pairs | if . == "" then "none" else . end)",
    "wait:    median \(.wait_minutes_median // "-") min, p90 \(.wait_minutes_p90 // "-") min from queued to started, \(.started_at_once) started at once and not counted",
    (.sitting | "sitting: \(.runnable) can start, oldest \(.oldest_runnable[0].minutes | dur)"
      + (if .runnable > 0 then " (\(.oldest_runnable[0].slug)), median \(.runnable_age_minutes_median | dur)" else "" end)
      + "; \(.held) held" + (if .held > 0 then " (\(.held_by | pairs))" else "" end)),
    "added:   \(.added_per_day | pairs)",
    "run:     median \(.run_minutes_median // "-") min from started to finished",
    "to PR:   median \(.to_pr_minutes_median // "-") min from queued to finished with a PR",
    "per day: \(.per_day | to_entries | map("\(.key) \(.value)") | join(", "))",
    "project: \(.by_project | to_entries | map("\(.key) \(.value.done) (\(.value.prs) PR)") | join(", "))",
    "source:  \(.by_source | to_entries | map("\(.key) \(.value.done) (\(.value.prs) PR)") | join(", "))"' <<<"$stats"
}

[[ "${BASH_SOURCE[0]}" != "$0" ]] && return 0

command -v jq >/dev/null || die "jq not on PATH"
case "${1:-}" in
  add | list | next | show | mine | cancel | bump | set | move | stats) v="$1"; shift; "cmd_$v" "$@" ;;
  -h | --help | '') sed -n '2,/^set -uo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
  *) die "unknown verb: $1 (try --help)" ;;
esac
