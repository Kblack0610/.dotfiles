#!/usr/bin/env bash
# agent-queue - the one intake for agent work, and the only writer of its store.
#
#   add [--project p] [--mode oneshot|plan] [--priority urgent|high|low] [--tags "t1 t2"]
#       [--weight heavy|light] [--after slug] [--from human|shepherd|canary|research:<facet>|auto:<filer>|board:<project>:<key>] [--agent claude] [--slug s] [--title t]
#       [--row <code>-<N>] [--epic <code>-<N>] [--want <channel>] [--running [--session s]] [--repeat] [task...]    the task from args, or stdin when there are none
#       --want names the channel a human's want came in by (`notes ptask add --want`): its story row gets #requested from
#       the notes writer. Without it the row carries no stamp, as a session's own add does not.
#       --row names the open agent board row this item works on: see link_row. With no --row,
#       --epic or --want, a title whose subject is one open row id works that row too (named_row).
#       Any other item not from the board files its own story row: see file_story. A slug that already
#       finished ok is refused unless --repeat says this is new work under it: see finished_ok.
#       An automated add waits while the queue is a day of drain deep: see admit (exit AQ_EX_HELD).
#   add --plan <plan.md> [--dry-run] [--project p] [--priority p] [--tags t] [--weight w] [--after slug] [--slug prefix] [--repeat]
#       one oneshot item per unchecked `## Phases` line, each after the one before
#   list [--json] [--state queued|running|waiting|review|done|active|all] [--date YYYY-MM-DD | --since YYYY-MM-DD]
#   next [--json] | show <slug> [--json] | cancel <slug> | bump <slug> <priority>
#   claim <slug> [--sid id]    record a Claude session as working this item (default $CLAUDE_CODE_SESSION_ID)
#   mine [--session s | --sid id]  the slug of the running, waiting or review item this session records
#   set <slug> <key=value>... | move <slug> <state> [--status ok|failed|cancelled] [--end <reason>] [--if <state>]
#       --end records why a run ended (end_reason:): refused, limit, provider, cut, timeout or stopped.
#       The first four are not the model's doing, so the run's model-lane outcome is not filed.
#   retask <slug> [task...]    replace a queued item's task (the brief its session gets), from args or stdin
#   attribute <slug> < changed-paths    credit the item to the registry project whose path owns most of its PR
#   credit-of <project> < changed-paths  print what attribute would record ("<winner>\t<touches>"), writing nothing
#   requeue <slug> --hold <resource>   a started item back in the queue, held on that agent-hold
#   reopen <slug> [--to running|waiting] [--why text] [--unland <owner>/<repo>#<N>]   a falsely-done item back to running (or waiting),
#       its row started again. A failed close reopens as it is; an ok close only with --unland naming the PR it
#       closed on that was not its work, which comes off pr:, merged: and closing_pr:, and its row reopens through
#       `notes ptask reopen`. Items `after:` it that the ok close released stay started.
#   stats [--json] [--flow] [--since YYYY-MM-DD]
#   admission [--json]    the backlog an automated add is admitted under, its limit, and the adds held in 7 days
# A plan item starts its session at once (fleet-dispatch start --item), and so does the next item
# `after:` one that closes ok; AGENT_QUEUE_START=0 only queues.
# Weight: heavy holds two of fleet-dispatch's run units, light one; see weight_of.
# A partial: yes item stays open until agent-land without --partial finishes it; reap also waits.
# Holds: `after <slug>`, and the tags night, at:HH:MM (that time of day), at:YYYY-MM-DDTHH:MM (that moment)
# pr:<owner>/<repo>#<N> (until that PR merges; closed unmerged, it says it never releases) and nightly:<repo> (until the scheduled runs of that repo on its at: date, else today,
# have finished; see nightly_pending) and ask:<id>[=<option>[+<option>]] (until the human answers that agent-ask,
# with one of those options when named; see ask_pending) and hold:<resource> (while agent-hold holds it; see
# hold_pending). A start on a later day is the dated form, never a held session.
#
# One file per item under $AGENT_QUEUE_DIR/<state>/. Design: ~/.config/agentctl/QUEUE.md.
set -uo pipefail

AQ_DIR="${AGENT_QUEUE_DIR:-$HOME/.agent/queue}"
# The registry's resolver: this tree's project-name.sh (PROJECT_NAME_LIB when the script runs
# from a copy, as in the tests); AGENT_QUEUE_PROJECT_MAP points it at another map.
# shellcheck source=../../.config/shared-hooks/project-name.sh
. "${PROJECT_NAME_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../../.config/shared-hooks/project-name.sh}"
AQ_MAP="${AGENT_QUEUE_PROJECT_MAP:-$(project_map_file)}"
PROJECT_MAP_FILE="$AQ_MAP"
# shellcheck source=../lib/chain-event.sh
. "${CHAIN_EVENT_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/chain-event.sh}"
# The one reader of a plan's `## Phases` checklist and `epic:` line, shared with fleet-sessions.
# shellcheck source=../lib/plan-phases.sh
. "${PLAN_PHASES_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/plan-phases.sh}"
# shellcheck source=../lib/machine-mode.sh
. "${MACHINE_MODE_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/machine-mode.sh}"
# The night window a `night` item may start in, local time, which may wrap midnight: the `night`
# part of the system's clock hours (.config/machine-mode/hours), read when a night hold is checked.
AQ_NIGHT="${AGENT_QUEUE_NIGHT:-}"
# A `pr:<owner>/<repo>#<N>` item waits for that PR to merge; its state is cached here.
AQ_PR_CACHE="${AGENT_QUEUE_PR_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/agent-queue/pr}"
AQ_PR_TTL="${AGENT_QUEUE_PR_TTL:-120}"
# A `nightly:<repo>` item waits on the scheduled-run facts schedules-sync writes, through its `pending` verb.
AQ_SCHEDULES="$(dirname "$(realpath "${BASH_SOURCE[0]}")")/schedules-sync"
# An `ask:<id>[=<option>]` item waits on that agent-ask's answer, read from its file here.
AQ_ASKS="${AGENT_ASK_DIR:-$HOME/.agent/asks}"
# A `hold:<resource>` item waits while this tree's agent-hold says that resource is held.
AQ_HOLD="$(dirname "$(realpath "${BASH_SOURCE[0]}")")/agent-hold"
# waiting: its session needs the human (a plan, a dialog, an ask). review: its session ended or
# stopped at an open PR, which reap closes on the merge. They are two states so "needs you" counts
# only the first.
ACTIVE="queued running waiting review"

die() { echo "agent-queue: $*" >&2; exit 1; }
now_utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }
# The caller's own session as an item records it: <tmux server>:<session>, the shape reap reads.
own_session() {
  [ -n "${TMUX:-}" ] || return 1
  local name
  name="$(tmux display-message -p '#{session_name}' 2>/dev/null)"
  [ -n "$name" ] || return 1
  printf '%s:%s\n' "$(basename "${TMUX%%,*}")" "$name"
}
# The Claude session id of the caller, which every reader of a session (outcomes, fleet-bench,
# day-log, Langfuse) keys on. Claude Code exports it to every command it runs.
claude_sid() { [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && printf '%s\n' "$CLAUDE_CODE_SESSION_ID"; }
# The caller's session when it is on the agent world, else nothing. An item's session is what
# cancel and the reap kill, so a hub window never lends its session to one.
agent_session() {
  local own
  own="$(own_session)" || return 1
  [ "${own%%:*}" = "$(tmux-world agents)" ] || return 1
  printf '%s\n' "$own"
}
# qualified <session> -- `session:` is always <server>:<session>; a bare name is on the agent world.
qualified() {
  local world
  case "$1" in '' | *:*) printf '%s\n' "$1"; return ;; esac
  world="$(tmux-world agents)"
  [ -n "$world" ] || die "no world declares @agents: give the session as <server>:$1"
  printf '%s:%s\n' "$world" "$1"
}
# The caller's own window id (@N), which cancel closes: a hand-started item runs in a window of
# a session it did not make, so the session is never its to close.
own_window() {
  [ -n "${TMUX:-}" ] || return 1
  tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#{window_id}' 2>/dev/null
}
# The one closer, beside this script (TMUX_CLOSE when the script runs from a copy, as in tests).
TMUX_CLOSE="${TMUX_CLOSE:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/tmux-close}"

# --- the file format ---
# `key: value` lines, a `---` line, then the task as typed.
fm_get() { # file key
  awk -v k="$2" '$0 == "---" { exit }
    index($0, k ":") == 1 { v = substr($0, length(k) + 2); sub(/^ +/, "", v); print v; exit }' "$1" 2>/dev/null
}
fm_body() { awk 'f { print } $0 == "---" { f = 1 }' "$1" 2>/dev/null; }

# item_event <action> <file> [record flags...] -> the item's write on the chain log (stage queue),
# naming the item, its project, its row's key (as ITEM_JQ reads `row`), its PR and merge commit.
item_event() {
  local action=$1 f=$2 row title
  shift 2
  row="$(fm_get "$f" row)" title="$(fm_get "$f" title)"
  [ -n "$row" ] || case "$(fm_get "$f" from)" in board:*) row="$(fm_get "$f" from)" row="${row#board:}" ;; esac
  chain_event queue "$action" "$(fm_get "$f" project)" "${title:-$(fm_body "$f" | head -1)}" \
    --item "$(fm_get "$f" slug)" --id "${row:+${row#*:}}" --pr "$(fm_get "$f" pr)" \
    --sha "$(fm_get "$f" merged)" "$@"
}

slugify() {
  printf '%s' "$1" | head -1 | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | tr -s '-' \
    | sed 's/^-//; s/-$//' | cut -c1-40 | sed 's/-$//'
}

# urgent|high|low, as on the sheets. A bare add is high: nobody decided, so it is not demoted.
prio_rank() { case "$1" in urgent) echo 0 ;; high) echo 1 ;; low) echo 2 ;; *) return 1 ;; esac; }

# Mutations take one lock, so the web page, the shepherd and the dispatcher never interleave.
# The wait is a timeout guard, not a delay: a writer holds it for milliseconds.
lock() {
  mkdir -p "$AQ_DIR" || die "cannot create $AQ_DIR"
  exec 8> "$AQ_DIR/.lock"
  flock -w 10 8 || die "the queue is locked by another writer"
}
# Reads share the lock, so a list never sees an item a writer is moving between states.
lock_read() {
  [ -d "$AQ_DIR" ] || return 0
  exec 8> "$AQ_DIR/.lock"
  flock -s -w 10 8 || die "the queue is locked by another writer"
}

items_in() { # state-dir -> item files, oldest first
  local f
  for f in "$1"/*.md; do [ -e "$f" ] && printf '%s\n' "$f"; done | sort
}

# slug_files <slug> <glob-dir>... -> the item files whose `slug:` header is exactly this slug.
# The file name only narrows the search: `*-first.md` also matches `x-first`, and a second
# finish on the same day carries a `-2` suffix.
slug_files() {
  local slug="$1" d f
  shift
  for d in "$@"; do
    for f in "$d"/*"$slug"*.md; do
      [ -e "$f" ] && [ "$(fm_get "$f" slug)" = "$slug" ] && printf '%s
' "$f"
    done
  done
}

# latest_done <slug> -> the most recently finished item with this slug; the file's mtime breaks a
# tie inside one second, since `finished` is whole seconds for jq's date parser.
latest_done() {
  local f
  slug_files "$1" "$AQ_DIR"/done/* | while IFS= read -r f; do
    printf '%s\t%s\t%s\n' "$(fm_get "$f" finished)" "$(stat -c %.9Y "$f")" "$f"
  done | sort | tail -1 | cut -f3-
}

# find_item <slug> [any] -> the active item with that slug; `any` falls back to the latest
# finished one, so `show` and `set` reach a done item.
find_item() {
  local s f
  for s in $ACTIVE; do
    f="$(slug_files "$1" "$AQ_DIR/$s" | head -1)"
    [ -n "$f" ] && { printf '%s\n' "$f"; return 0; }
  done
  [ "${2:-}" = any ] || return 1
  f="$(latest_done "$1")"
  [ -n "$f" ] && printf '%s\n' "$f"
}

state_of() { # file -> its state, from its directory
  local d
  case "$1" in "$AQ_DIR"/done/*) echo "done" ;; *) d="${1%/*}"; echo "${d##*/}" ;; esac
}

# The status of the most recent finished item with this slug, empty if none.
done_status() {
  local f
  f="$(latest_done "$1")"
  [ -n "$f" ] && fm_get "$f" status
}

# finished_ok <slug> [<task>] -> why an add under this slug is refused: its latest done item closed ok,
# so a second item would do landed work again. A failed or cancelled one is a retry and passes. A
# recurring item (a nightly pass, a shared red that came back) is new work and says so with --repeat.
# A slug cut from the task's words (pass the task) is refused only when the words are that item's
# too: two tasks can share a 40-character slug and be different work. Refused adds exit
# AQ_EX_FINISHED. On 2026-11-06 a plan's re-queue ran an ok phase again (id-like-to-setup-abundant-seahor-p8).
AQ_EX_FINISHED=4
finished_ok() {
  local f
  f="$(latest_done "$1")"
  [ -n "$f" ] && [ "$(fm_get "$f" status)" = ok ] || return 0
  [ -z "${2-}" ] || [ "$(fm_body "$f" | head -1)" = "$(head -1 <<<"$2")" ] || return 0
  printf '%s already finished ok (%s%s): pass --repeat to queue it again as new work\n' \
    "$1" "$(fm_get "$f" finished)" "$(fm_get "$f" pr | sed 's/^./, PR &/')"
}

# finished_row_ok <from> -> why an add from a board row is refused: an item under another slug already
# finished ok on that row, as finished_ok reads the slug's. finished_ok keys on the slug, and a hand start slugs
# `<project>-<key>` where promote slugs the row `<key>`, so a done row's refill slipped past it
# (2026-11-07: trader tr-58 queued again after #635 merged). Refused adds exit AQ_EX_FINISHED.
finished_row_ok() {
  local key="${1#board:}" f
  [ "$key" != "$1" ] || return 0
  grep -lxF -e "from: board:$key" -e "row: $key" "$AQ_DIR"/done/*/*.md 2>/dev/null | while IFS= read -r f; do
    [ "$(fm_get "$f" status)" = ok ] || continue
    printf '%s already finished ok on its own item %s (%s%s): pass --repeat to queue it again as new work\n' \
      "$key" "$(fm_get "$f" slug)" "$(fm_get "$f" finished)" "$(fm_get "$f" pr | sed 's/^./, PR &/')"
    break
  done
}

# Admission (ar-697): an automated filer adds to the queue only while the items that can start now
# number under a day of measured drain; the board is uncapped and takes the overflow, and dispatch
# promotes from it as the queue drains. Automated: a `--from research:<facet>` or `auto:<filer>`,
# and a session working a queue item ($AGENT_QUEUE_ITEM) that adds one without --from, recorded as
# `from: item:<its slug>` when admission gates it (an exempt or deferred add keeps `human`). Never held: --running (the caller's own work), a --plan not from a
# machine filer (an approved plan), urgent, `red` and `#requested` items, and a session's add that
# arrives held (--after, at:, pr:, ask:, hold:, nightly:): its own work later, not runnable inflow.
# A held add writes no item, logs one line to AQ_ADMISSION_LOG and exits AQ_EX_HELD. Drain is the
# items started out of the queue (started after they were queued) over AQ_DRAIN_DAYS, a day.
# Provisional, confidence low: AGENT_QUEUE_ADMIT_DAYS 1 and the floor AGENT_QUEUE_ADMIT_MIN 10 were
# set on 2026-11-07 at a drain of 61/day with 56 runnable; revisit when 7d inflow (fleet-bench flow)
# stays under drain or requested_unstarted_h rises. AGENT_QUEUE_ADMIT_DAYS=0 turns it off.
AQ_EX_HELD=5
AQ_ADMIT_DAYS="${AGENT_QUEUE_ADMIT_DAYS:-1}"
AQ_ADMIT_MIN="${AGENT_QUEUE_ADMIT_MIN:-10}"
AQ_DRAIN_DAYS=7
AQ_ADMISSION_LOG="$AQ_DIR/admission.jsonl"

# started_from_queue <since UTC> -> how many items started at or after then out of the queue. A
# file not written in the window cannot have started in it, so find skips the older done/ days.
started_from_queue() {
  local x d=()
  for x in running waiting review done; do [ -d "$AQ_DIR/$x" ] && d+=("$AQ_DIR/$x"); done
  [ "${#d[@]}" -gt 0 ] || { echo 0; return 0; }
  find "${d[@]}" -maxdepth 2 -name '*.md' -mtime -$((AQ_DRAIN_DAYS + 1)) -exec awk -v s="$1" '
    FNR == 1 { q = ""; t = "" }
    $0 == "---" { if (t != "" && t >= s && t != q) n++; nextfile }
    index($0, "queued:") == 1 { q = $2 }
    index($0, "started:") == 1 { t = $2 }
    END { print n + 0 }' {} + | awk '{ n += $1 } END { print n + 0 }'
}

# admission_now -> "<runnable> <limit> <drain per day>": the queued items that can start now, and
# the limit an automated add is admitted under, a day of drain and never under the floor.
admission_now() {
  local since runnable n
  since="$(admission_since)"
  runnable="$(collect queued | jq '[.[] | select(.hold == null)] | length')" || return 1
  n="$(started_from_queue "$since")"
  awk -v r="$runnable" -v n="$n" -v w="$AQ_DRAIN_DAYS" -v d="$AQ_ADMIT_DAYS" -v m="$AQ_ADMIT_MIN" 'BEGIN {
    per = n / w; l = per * d; if (l > int(l)) l = int(l) + 1; if (l < m) l = m
    printf "%d %d %s\n", r, l, int(per * 10 + 0.5) / 10 }'
}

# admission_exempt <priority> <tags> -> true when admission never holds the add: admission is off,
# or the item is urgent, `red` or `#requested`.
admission_exempt() {
  [ "$AQ_ADMIT_DAYS" = 0 ] || [ "$1" = urgent ] || [[ " $2 " == *" red "* || " $2 " == *" #requested "* ]]
}

# admission_since -> the UTC start of the drain window.
admission_since() { date -u -d "$AQ_DRAIN_DAYS days ago" +%Y-%m-%dT%H:%M:%SZ; }

# admit <from> <priority> <tags> <project> <slug> <title> -> 0 when the add may go in; else says
# why on stderr, logs the hold and returns 1. An unreadable queue admits with a warning: the check
# never blocks work on its own fault. The log keeps the drain window only, since a filer retries.
admit() {
  local from=$1 priority=$2 tags=$3 project=$4 slug=$5 title=$6 now r l d
  ! admission_exempt "$priority" "$tags" || return 0
  now="$(admission_now)" && read -r r l d <<<"$now" && [[ "$r" =~ ^[0-9]+$ && "$l" =~ ^[0-9]+$ ]] ||
    { echo "agent-queue: admission could not read the queue, so this automated add goes in unchecked" >&2; return 0; }
  [ "$r" -ge "$l" ] || return 0
  mkdir -p "$AQ_DIR"
  { [ -s "$AQ_ADMISSION_LOG" ] && jq -c --arg s "$(admission_since)" 'select(.at >= $s)' "$AQ_ADMISSION_LOG" 2>/dev/null
    jq -nc --arg at "$(now_utc)" --arg from "$from" --arg project "$project" --arg slug "$slug" --arg title "$title" \
      --argjson runnable "$r" --argjson limit "$l" --argjson drain "$d" \
      '{at: $at, from: $from, project: $project, slug: $slug, title: $title, runnable: $runnable, limit: $limit, drain_per_day: $drain}'
  } > "$AQ_ADMISSION_LOG.tmp" && mv -f "$AQ_ADMISSION_LOG.tmp" "$AQ_ADMISSION_LOG"
  echo "agent-queue: held by admission, nothing was added: $r items can start now against a limit of $l ($AQ_ADMIT_DAYS day of drain at $d/day), and an automated add ($from) waits under it. File it on the board, which dispatch promotes from as the queue drains: notes ptask $project --agent add \"<type(area): title> #size/s\"; a task the human asked for in this session passes --from human" >&2
  return 1
}

# admission [--json] -> admission_now and the items held in the last AQ_DRAIN_DAYS, each counted
# once however often its filer retried.
cmd_admission() {
  local json='' now r l d since held=0
  case "${1:-}" in --json) json=1 ;; '') ;; *) die "unknown option: $1" ;; esac
  now="$(admission_now)" || die "the queue could not be read"
  read -r r l d <<<"$now"
  since="$(admission_since)"
  [ -s "$AQ_ADMISSION_LOG" ] && held="$(jq -s --arg s "$since" '[.[] | select(.at >= $s) | [.project, .slug]] | unique | length' "$AQ_ADMISSION_LOG" 2>/dev/null)"
  if [ -n "$json" ]; then
    jq -nc --argjson r "$r" --argjson l "$l" --argjson d "$d" --argjson h "${held:-0}" --argjson on "$([ "$AQ_ADMIT_DAYS" != 0 ] && echo true || echo false)" \
      '{on: $on, runnable: $r, limit: $l, drain_per_day: $d, held_7d: $h, admits: (($on | not) or $r < $l)}'
  else
    printf 'admission: %s, %s can start now against a limit of %s (%s day of drain at %s/day); %s automated adds held in %s days\n' \
      "$([ "$AQ_ADMIT_DAYS" != 0 ] && { [ "$r" -lt "$l" ] && echo admitting || echo holding; } || echo off)" "$r" "$l" "$AQ_ADMIT_DAYS" "$d" "${held:-0}" "$AQ_DRAIN_DAYS"
  fi
}

# prios_read -> `name<TAB>prio` for every project whose front page declares a `#prio/<word>` (`notes
# projects --prios`, the one reader of the tag the human sets with `notes projects --prio` or the hub's
# P key). Nothing when notes cannot answer: no prio is the safe default, it ranks and holds nothing.
prios_read() { notes projects --prios 2>/dev/null || true; }

# focus_hold <project> <priority> <tags> -> sets HOLD to `focus: only <projects>` while any project is
# `#prio/only` and this item's project is not one of them. Exempt, so the fleet still mends itself
# and still does what the human asked: a `red` item, an urgent one and a `requested` one (the human,
# 2026-11-07). A listing asks notes and parses its answer once (memo), never once an item.
focus_only() { prios_read | awk -F '\t' '$2 == "only" { printf "%s%s", (n++ ? " " : ""), $1 }'; }
focus_hold() {
  local only MEMO_V
  memo focus focus_only
  only=$MEMO_V
  [ -n "$only" ] || return 0
  [[ " $only " != *" $1 "* ]] || return 0
  [ "$2" != urgent ] || return 0
  [[ " $3 " != *" red "* && " $3 " != *" requested "* && " $3 " != *" #requested "* ]] || return 0
  HOLD="focus: only $only"
}

# hold_reason <file> -> why a queued item cannot start yet, or nothing when it can.
hold_reason() {
  local HOLD=""
  hold_for "$(fm_get "$1" after)" "$(fm_get "$1" tags)" "$(fm_get "$1" project)" "$(fm_get "$1" priority)"
  [ -z "$HOLD" ] || printf '%s\n' "$HOLD"
}

# memo <key> <cmd...> -> sets MEMO_V to the command's output, cached in LIST_MEMO when the caller
# (items_json) set LIST_MEMO_ON: a cache that lives for one listing, so a listing asks each hold
# and each project's weight once. Without one it just runs the command, so a check after a
# move never reads a stale answer. Sets a variable, not stdout, so the cache survives the call.
memo() {
  local k="$1"; shift
  if [ -z "${LIST_MEMO_ON-}" ]; then MEMO_V="$("$@")"; return; fi
  [ -n "${LIST_MEMO[$k]+x}" ] || LIST_MEMO[$k]="$("$@")"
  MEMO_V="${LIST_MEMO[$k]}"
}

# after_status <slug> -> sets AST to what an `after:` waits on: empty while the slug has a live item
# (queued, running or waiting), else its latest done status. A re-queued slug is work again, whatever
# done/ holds. A listing answers from its index (index_load, which picks the latest done item as
# latest_done does); a lone check asks the store.
after_status() {
  AST=""
  if [ -n "${LIST_MEMO_ON-}" ]; then
    [ -n "${QI_LIVE[$1]+x}" ] || AST="${QI_ST[$1]-}"
  elif [ -z "$(find_item "$1")" ]; then
    AST="$(done_status "$1")"
  fi
}

# hold_for <after> <tags> [<project> <priority>] -> sets HOLD to hold_reason's answer for these
# header values.
hold_for() {
  local after="$1" tags="$2" tag now stamp nday MEMO_V AST
  HOLD=""
  if [ -n "$after" ]; then
    after_status "$after"
    case "$AST" in
      ok) ;;
      "") HOLD="after $after"; return ;;
      # Any other close releases only if that slug is queued again and closes ok: say so, so the
      # list and the hub show a dead hold apart from a live one.
      *) HOLD="after $after closed $AST, dead: cancel it or set after=<slug>"; return ;;
    esac
  fi
  focus_hold "${3-}" "${4-}" "$tags"
  [ -z "$HOLD" ] || return 0
  [ -n "$tags" ] || return 0
  # AGENT_QUEUE_NOW is HH:MM (today) or YYYY-MM-DDTHH:MM, local time. printf's clock, not date: a
  # listing asks this for every tagged queued item.
  stamp="${AGENT_QUEUE_NOW-}"
  [ -n "$stamp" ] || printf -v stamp '%(%Y-%m-%dT%H:%M)T' -1
  [[ "$stamp" == *T* ]] || { printf -v now '%(%Y-%m-%d)T' -1; stamp="${now}T$stamp"; }
  now="${stamp#*T}"
  # A nightly: hold judges the night of the item's at: date (nightly_pending), else today's.
  nday=""
  for tag in $tags; do [[ "$tag" =~ ^at:([0-9]{4}-[0-9]{2}-[0-9]{2})T ]] && nday="${BASH_REMATCH[1]}"; done
  for tag in $tags; do
    case "$tag" in
      night)
        [ -n "$AQ_NIGHT" ] || AQ_NIGHT="$(clock_window night)"
        [ -n "$AQ_NIGHT" ] || { HOLD="night (the hours file has no night part)"; return; }
        hhmm_in "$now" "$AQ_NIGHT" || { HOLD="night ($AQ_NIGHT)"; return; } ;;
      at:[0-9][0-9]:[0-9][0-9]) [ "${now/:/}" -ge "${tag//[!0-9]/}" ] || { HOLD="$tag"; return; } ;;
      at:[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]) [[ ! "$stamp" < "${tag#at:}" ]] || { HOLD="$tag"; return; } ;;
      pr:?*/?*#[0-9]*)
        memo "$tag" pr_state "${tag#pr:}"
        case "$MEMO_V" in
          MERGED) ;;
          # Closed unmerged, it can never release: say so, so the list and the hub show a dead hold.
          CLOSED) HOLD="$tag closed unmerged, never releases: cancel the item or set its tags without it"; return ;;
          *) HOLD="$tag not merged"; return ;;
        esac ;;
      nightly:?*)
        memo "nightly:${tag#nightly:}@$nday" nightly_pending "${tag#nightly:}" "$stamp" "$nday"
        [ -z "$MEMO_V" ] || { HOLD="$tag ($MEMO_V)"; return; } ;;
      ask:?*)
        memo "$tag" ask_pending "${tag#ask:}"
        [ -z "$MEMO_V" ] || { HOLD="$tag ($MEMO_V)"; return; } ;;
      hold:?*)
        memo "$tag" hold_pending "${tag#hold:}"
        [ -z "$MEMO_V" ] || { HOLD="$tag ($MEMO_V)"; return; } ;;
    esac
  done
}

# hold_resource <name> -- an agent-hold resource name: one path segment of letters, digits, . _ -.
hold_resource() { [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] && [ "$1" != . ] && [ "$1" != .. ]; }

# hold_pending <resource> -> who holds that agent-hold resource and why, or nothing once it is free.
# Asked as no session (no tmux, cwd /): the session the item will start does not exist yet, so the
# asker's own claim or grant is not one it would have. A resource a session needs (the mac-mini
# desktop, claimed by another) is waited on here instead of by a session polling or guessing an
# at: time: on 2026-11-06 a store-forms item needed mac-desktop while a session with no queue item
# held it, so there was nothing to put it after:. A failing agent-hold holds.
hold_pending() {
  local out rc dir
  dir="$(realpath -m "${AGENT_HOLD_DIR:-$HOME/.agent/holds}")"
  out="$(cd / && TMUX='' AGENT_HOLD_DIR="$dir" "$AQ_HOLD" check "$1" 2>/dev/null)"; rc=$?
  [ "$rc" -ne 0 ] || return 0
  [ "$rc" -eq 1 ] && [ -n "$out" ] || { echo "agent-hold check failed, exit $rc"; return; }
  printf '%s\n' "${out#held: "$1" }"
}

# ask_pending <id>[=<option>[+<option>]] -> why that agent-ask still holds an item, or nothing once
# the human answered it (with one of those options as the answer's first word, when named). A phase gated on the
# human's decision (live money, a vendor) is queued behind its ask instead of held by an open
# session: on 2026-11-06 trader-real-money-plan sat 6h+ refusing to queue phases that would have
# started on their own. Pending, cancelled, another answer or no such ask all hold.
ask_pending() {
  local id="${1%%=*}" want="" f st by ans
  [[ "$1" == *=* ]] && want="${1#*=}"
  [[ "$id" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "not an ask id"; return; }
  f="$(compgen -G "$AQ_ASKS/*/$id.md" | head -1)"
  [ -n "$f" ] || { echo "no such ask"; return; }
  st="$(sed -n 's/^status: //p' "$f" | head -1)"
  [ "$st" = answered ] || { echo "${st:-unreadable}"; return; }
  # A judge or shepherd answer is not the human's decision; legacy answers carry an empty by.
  by="$(sed -n 's/^answered_by: *//p' "$f" | head -1)"
  [ -z "$by" ] || [ "$by" = human ] || { echo "answered by $by, not the human"; return; }
  [ -n "$want" ] || return 0
  ans="$(sed -n 's/^answer: //p' "$f" | head -1)"; ans="${ans%% *}"; ans="${ans%[.,;:!]}"
  case "+${want,,}+" in *"+${ans,,}+"*) ;; *) echo "answered ${ans:-nothing}, not $want" ;; esac
}

# ask_options <id> -> the ask's answer vocabulary, one option per line; nothing when it has none.
ask_options() {
  local f; f="$(compgen -G "$AQ_ASKS/*/${1%%=*}.md" | head -1)"
  [ -n "$f" ] || return 0
  sed -n 's/^options: *//p' "$f" | head -1 | tr '|' '\n'
}

# nightly_pending <repo> <local stamp> [<day>] -> what that day's scheduled runs of that repo still wait
# for (day: the item's at: date, else the stamp's), or nothing when every one has finished or passed its
# slot plus timeout (a missing run is the triage's red). A missing or stale state file, or schedules-sync
# failing, holds. The day is the at: date so a finished night stays released after midnight.
nightly_pending() {
  local out
  out="$(SCHEDULES_NOW="$(date -d "${2/T/ }" +%s)" "$AQ_SCHEDULES" pending "$1" ${3:+--day "$3"} 2>/dev/null)" && return 0
  printf '%s\n' "${out:-schedules state unreadable}"
}

# pr_state <owner/repo#N> -> the PR's state from gh (MERGED, OPEN, CLOSED), or nothing when gh
# cannot say, which holds the item. MERGED never changes, so it is cached for good; any other
# state for AQ_PR_TTL seconds, so a list or a dispatch pass costs one gh call per PR.
pr_state() {
  local ref="$1" f state
  f="$AQ_PR_CACHE/$(printf '%s' "$ref" | tr '/#' '__')"
  if [ -f "$f" ]; then
    state="$(cat "$f")"
    if [ "$state" = MERGED ] || [ $(( $(date +%s) - $(stat -c %Y "$f") )) -lt "$AQ_PR_TTL" ]; then
      echo "$state"; return
    fi
  fi
  state="$(gh pr view "${ref##*#}" -R "${ref%#*}" --json state -q .state 2>/dev/null)" || return 0
  mkdir -p "$AQ_PR_CACHE" && printf '%s\n' "$state" > "$f"
  echo "$state"
}

# HDR_AWK: the awk function both header readers (header_rows, item_recs) split a line by, as fm_get
# reads a key: hdr(line) is true for a `key: value` line and sets HK to the key, up to the first
# colon (never empty), and HV to the value with its leading spaces dropped.
HDR_AWK='function hdr(line,  i) { i = index(line, ":"); if (i < 2) return 0
  HK = substr(line, 1, i - 1); HV = substr(line, i + 1); sub(/^ +/, "", HV); return 1 }'

# header_rows < "<mtime>\t<file>" lines -> one line per file, fields split by \x1f: the file, its
# mtime, then the first slug, finished, status, after, tags, project, mode, phases, weight and
# priority of its header (HDR_AWK).
header_rows() {
  awk -F '\t' "$HDR_AWK"'{
    f = $2; delete h
    while ((getline line < f) > 0 && line != "---") if (hdr(line) && !(HK in h)) h[HK] = HV
    close(f)
    printf "%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n", f, $1, h["slug"], h["finished"],
      h["status"], h["after"], h["tags"], h["project"], h["mode"], h["phases"], h["weight"], h["priority"] }'
}

# queue_index active | done [slug...] -> header_rows for every item file in the active states, or
# in done/, there only the files named for these slugs when some are given (as slug_files narrows):
# one find, one awk.
queue_index() {
  local d=() s n=()
  if [ "$1" = done ]; then
    shift
    for s in "$@"; do [ ${#n[@]} -eq 0 ] || n+=(-o); n+=(-name "*$s*.md"); done
    [ ${#n[@]} -gt 0 ] || n=(-name '*.md')
    [ ! -d "$AQ_DIR/done" ] ||
      find "$AQ_DIR/done" -mindepth 2 -maxdepth 2 \( "${n[@]}" \) ! -name '.*' ! -path "$AQ_DIR/done/.*" -printf '%T@\t%p\n'
  else
    for s in $ACTIVE; do [ -d "$AQ_DIR/$s" ] && d+=("$AQ_DIR/$s"); done
    [ "${#d[@]}" -eq 0 ] || find "${d[@]}" -maxdepth 1 -name '*.md' ! -name '.*' -printf '%T@\t%p\n'
  fi | header_rows
}

# index_load -> fills the caller's index (items_json declares it) from queue_index: QI_LIVE, the
# slugs with a live item; QI_ST and QI_FIN, each slug's latest done status and finish, the item
# latest_done picks (finished, then mtime, then path); and by file QI_AFTER, QI_TAGS, QI_FOCUS (project
# and priority, what a focus hold reads) and, for an item with no weight line, QI_WMETA (project, mode
# and phases). done/ holds most of the queue, so
# a listing of active items reads there only the files of the slugs its items wait on.
index_load() { # <listed file>...
  local f
  local -A want=()
  index_rows "$(queue_index active)"
  for f in "$@"; do
    case "$f" in "$AQ_DIR"/done/*) index_rows "$(queue_index done)"; return ;; esac
    [ -z "${QI_AFTER[$f]-}" ] || want[${QI_AFTER[$f]}]=1
  done
  [ ${#want[@]} -eq 0 ] || index_rows "$(queue_index done "${!want[@]}")"
}
index_rows() { # <queue_index output>
  local f m slug fin st after tags project mode phases w pr key
  local -A latest=()
  while IFS=$'\x1f' read -r f m slug fin st after tags project mode phases w pr; do
    [ -n "$f" ] || continue
    if [ -n "$slug" ]; then
      case "$f" in
        "$AQ_DIR"/done/*)
          key="$fin"$'\t'"$m"$'\t'"$f"
          [[ "$key" < "${latest[$slug]-}" ]] || { latest[$slug]="$key"; QI_ST[$slug]="$st"; QI_FIN[$slug]="$fin"; } ;;
        *) QI_LIVE[$slug]=1 ;;
      esac
    fi
    [ -z "$after" ] || QI_AFTER[$f]="$after"
    [ -z "$tags" ] || QI_TAGS[$f]="$tags"
    QI_FOCUS[$f]="$project"$'\x1f'"$pr"
    [ -n "$w" ] || QI_WMETA[$f]="$project"$'\x1f'"$mode"$'\x1f'"$phases"
  done <<<"$1"
}

# item_recs <file>... -> one record per item file for ITEM_JQ, all read by one awk: state, file,
# task and the first weight in its header, then its header keys and values; fields end in \x1f and
# the record in \x1e. Header keys by HDR_AWK; the object keeps the last of a repeated key and the
# rules (after, tags, weight) read the first.
item_recs() {
  printf '%s\n' "$@" | AQ_DONE="$AQ_DIR/done/" awk "$HDR_AWK"'{
    f = $0; task = ""; body = 0; w = ""; sw = 0; kv = ""
    while ((getline line < f) > 0) {
      if (body) { task = task line "\n"; continue }
      if (line == "---") { body = 1; continue }
      if (hdr(line)) { kv = kv HK "\037" HV "\037"; if (HK == "weight" && !sw++) w = HV }
    }
    close(f)
    sub(/\n+$/, "", task)
    if (index(f, ENVIRON["AQ_DONE"]) == 1) st = "done"; else { st = f; sub(/\/[^\/]*$/, "", st); sub(/.*\//, "", st) }
    printf "%s\037%s\037%s\037%s\037%s\036", st, f, task, w, kv }'
}

# The side table (items_json, by file: hold, derived weight, the finish of its `after:` item), a \x1d,
# then item_recs records -> a JSON array of items: every header key, plus state, file, task, ready
# and, for a held queued item, hold. `ready` is when the item could first start: queued, or the finish of
# its `after:` item when that came later, so a deliberate hold is not read as waiting; none while an
# `after:` still holds it. The one rule for an item's wait: `stats` medians it, the hub shows it.
# An item with no weight line gets weight_of's answer, so every reader sees a weight.
# `row` is the "<board>:<key>" of the sheet row the item closes on merge, the board being the item's
# project or the one its `board` key names (project_board): its `row:` (file_story, link_row), else
# the board row it was promoted from (`from: board:`). The one definition agent-land and
# fleet-dispatch read, whatever the item's origin.
ITEM_JQ='split("\u001d") as [$side, $recs]
  | ($side | split("\u001e")[:-1] | map(split("\u001f") | {key: .[0], value: {hold: .[1], weight: .[2], afin: .[3]}})
     | from_entries) as $by
  | $recs | split("\u001e")[:-1] | map(split("\u001f")[:-1] as $f | ($by[$f[1]] // {}) as $x
  | ([range(4; $f | length; 2) as $i | {($f[$i]): $f[$i + 1]}] | add // {})
    + {weight: (if $f[3] != "" then $f[3] else $x.weight end), state: $f[0], file: $f[1], task: $f[2]}
    + (if ($x.hold // "") == "" then {} else {hold: $x.hold} end)
  | (if (.hold // "") | startswith("after ") then null else [.queued, ($x.afin // "" | select(. != ""))] | max end) as $ready
  | (if $ready then .ready = $ready else . end)
  | if (.row // "") == "" and (.from // "" | startswith("board:")) then .row = (.from | ltrimstr("board:")) else . end)'

# item_side <file> <after> <tags> <weight> <project> <mode> <phases> <after's finish> <item's project>
# <priority> -> the file's
# entry in ITEM_JQ's side table, from its header values: the hold of a queued item, a weight for an
# item with no weight line, and the finish of its `after:` item; nothing when all three are empty.
item_side() {
  local d HOLD="" WEIGHT=""
  case "$1" in
    "$AQ_DIR"/done/*) ;;
    *) d="${1%/*}"; [ "${d##*/}" != queued ] || hold_for "$2" "$3" "${9-}" "${10-}" ;;
  esac
  [ -n "$4" ] || weight_of "$5" "$6" "$7"
  [ -z "$HOLD$WEIGHT$8" ] || printf '%s\x1f%s\x1f%s\x1f%s\x1e' "$1" "$HOLD" "$WEIGHT" "$8"
}

# items_json <jq filter> <file>... -> these items as one JSON array (ITEM_JQ) through the filter.
# A listing reads every header in the queue once (index_load) and the listed files once
# (item_recs), and asks each hold once (memo), never a fork per file or per `after:` slug.
items_json() {
  local filter="$1" f a w p mo ph
  shift
  [ $# -gt 0 ] || { jq -nc "[] | $filter"; return; }
  local -A LIST_MEMO=() QI_LIVE=() QI_ST=() QI_FIN=() QI_AFTER=() QI_TAGS=() QI_WMETA=() QI_FOCUS=()
  local LIST_MEMO_ON=1 fp fpr
  index_load "$@"
  {
    for f in "$@"; do
      a="${QI_AFTER[$f]-}" w=1 p="" mo="" ph="" fp="" fpr=""
      [ -z "${QI_WMETA[$f]+x}" ] || { w=""; IFS=$'\x1f' read -r p mo ph <<<"${QI_WMETA[$f]}"; }
      [ -z "${QI_FOCUS[$f]+x}" ] || IFS=$'\x1f' read -r fp fpr <<<"${QI_FOCUS[$f]}"
      item_side "$f" "$a" "${QI_TAGS[$f]-}" "$w" "$p" "$mo" "$ph" "${a:+${QI_FIN[$a]-}}" "$fp" "$fpr"
    done
    printf '\x1d'
    item_recs "$@"
  } | jq -Rsc "$ITEM_JQ | $filter"
}

# item_json <file> -> that item as one JSON object. One item asks the store for its own `after:`
# instead of reading the whole queue's index.
item_json() {
  local f m slug fin st a tags project mode phases w pr d afin=""
  IFS=$'\x1f' read -r f m slug fin st a tags project mode phases w pr < <(printf '0\t%s\n' "$1" | header_rows)
  [ -z "$a" ] || { d="$(latest_done "$a")"; [ -z "$d" ] || afin="$(fm_get "$d" finished)"; }
  { item_side "$1" "$a" "$tags" "$w" "$project" "$mode" "$phases" "$afin" "$project" "$pr"; printf '\x1d'; item_recs "$1"; } |
    jq -Rsc "$ITEM_JQ | .[]"
}

# Queue order: a `red` item first (something is broken), then priority, then the project's `#prio`
# (order_filter), then a `cleanup` item within that, then queued time. The one queue order: every reader (next, list, fleet-dispatch
# next_items) takes it as is. `after` and other tags hold, not reorder.
# A red outranks urgent on purpose: the human's rule is that anything broken goes first. The rank
# sits under priority, so an urgent fix still jumps it, and over cleanup, so a ranked project's work
# is not queued behind the fleet's own housekeeping (the human: games go first).
ORDER='def untagged($t): ((.tags // "") | if type == "array" then join(" ") else tostring end
    | [splits("\\s+")] | index([$t])) == null;
  sort_by(untagged("red"), ({"urgent":0,"high":1,"low":2}[.priority] // 1),
    ($rank[.project // ""] // 2), untagged("cleanup"), .queued)'
# order_filter -> ORDER with each project's rank bound to $rank, from the `#prio` the human set on
# its front page (prios_read): only and focus 0, high 1, normal 2, low 3. No prio, or a notes that
# cannot answer, ranks every project the same.
order_filter() {
  local rank
  rank="$(prios_read | jq -Rsc 'split("\n") | map(select(. != "") | split("\t")
    | {(.[0]): ({"only": 0, "focus": 0, "high": 1, "low": 3}[.[1]] // 2)}) | add // {}' 2>/dev/null)" || rank='{}'
  printf '%s as $rank | %s' "$rank" "$ORDER"
}

# list_files <states...> [--date D] [--since D] -> appends the caller's FILES with the item files in
# those states, each state oldest first; done is one day (--date, today by default) or every day
# from --since on, which wins.
list_files() {
  local states=() date="" since="" s d n f
  while [ $# -gt 0 ]; do
    case "$1" in --date) date="$2"; shift 2 ;; --since) since="$2"; shift 2 ;; *) states+=("$1"); shift ;; esac
  done
  for s in "${states[@]}"; do
    if [ "$s" = "done" ] && [ -n "$since" ]; then
      for d in "$AQ_DIR"/done/*/; do
        n="${d%/}"; n="${n##*/}"
        [ -d "$d" ] && [[ ! "$n" < "$since" ]] || continue
        for f in "$d"*.md; do [ -e "$f" ] && FILES+=("$f"); done
      done
    elif [ "$s" = "done" ]; then
      for f in "$AQ_DIR/done/${date:-$(date +%F)}"/*.md; do [ -e "$f" ] && FILES+=("$f"); done
    else
      while IFS= read -r f; do FILES+=("$f"); done < <(items_in "$AQ_DIR/$s")
    fi
  done
}

# collect <states...> [--date D] [--since D] -> a JSON array of items, in queue order.
collect() {
  local FILES=()
  list_files "$@"
  items_json "$(order_filter)" "${FILES[@]}"
}

# header_set <file> <key> <value> -> rewrite the header field in place, atomically.
header_set() {
  local f="$1" k="$2" v="$3" tmp
  case "$v" in *$'\n'*) die "a value cannot span lines: $k" ;; esac
  tmp="$(mktemp "$(dirname "$f")/.set.XXXXXX")" || die "cannot write in $(dirname "$f")"
  awk -v k="$k" -v v="$v" '
    !done && $0 == "---" { if (!seen) print k ": " v; done = 1; print; next }
    !done && index($0, k ":") == 1 { print k ": " v; seen = 1; next }
    { print }' "$f" > "$tmp" && mv -- "$tmp" "$f"
}

# header_del <file> <key>... -> drop those header fields in place, atomically.
header_del() {
  local f="$1" tmp; shift
  tmp="$(mktemp "$(dirname "$f")/.del.XXXXXX")" || die "cannot write in $(dirname "$f")"
  awk -v ks="$*" '
    BEGIN { n = split(ks, k, " ") }
    !done && $0 == "---" { done = 1 }
    !done { for (i = 1; i <= n; i++) if (index($0, k[i] ":") == 1) next }
    { print }' "$f" > "$tmp" && mv -- "$tmp" "$f"
}

# move_to <file> <state> -> the new path. done/ is dated by today, and a name that is already
# there (the same slug finished twice in a day) gets a numeric suffix.
move_to() {
  local f="$1" to="$2" dir name dest n=2
  if [ "$to" = "done" ]; then dir="$AQ_DIR/done/$(date +%F)"; else dir="$AQ_DIR/$to"; fi
  mkdir -p "$dir"
  name="$(basename "$f" .md)"; dest="$dir/$name.md"
  while [ -e "$dest" ]; do dest="$dir/$name-$n.md"; n=$((n + 1)); done
  mv -- "$f" "$dest" && printf '%s\n' "$dest"
}

# project_resolve <name> -> the project an item is filed under, or nothing when dispatch could not
# start it: an alias becomes its project, a repo key with an `owner` in the registry becomes that
# lab project (dotfiles has no sheet; its work counts on agent-runtime's), and the project must
# reach a checkout through the registry (project-name.sh's project_repo_path). A game inside a
# repo is runnable; a notes-only project is not. With no map there is nothing to ask.
project_resolve() {
  [ -f "$AQ_MAP" ] || { printf '%s\n' "$1"; return 0; }
  local name
  name="$(jq -r --arg p "$1" '(.aliases[$p] // $p) as $n | (.trackers[$n] | objects | .owner) // $n' "$AQ_MAP" 2>/dev/null)"
  [ -n "$name" ] && [ -n "$(project_repo_path "$name")" ] && printf '%s\n' "$name"
}

# The one resolver of which lab project an item's work counts on, inside a repo that holds several
# (the playground's games, dotfiles' agent-runtime and notes-cockpit): project_credit at add,
# cmd_attribute at land. Both only move an item between projects that share one checkout.

# project_credit <project> <from> <epic> -> the project the item's own evidence names: the sheet its
# row is on (`from: board:<p>:<key>`), else the sheet whose row code the epic id `<code>-<N>`
# carries; when that project shares <project>'s checkout. Else <project>.
project_credit() {
  local p="" dir
  case "$2" in board:*) p="${2#board:}"; p="${p%%:*}" ;; esac
  if [ -z "$p" ] && [ -n "$3" ] && [ -f "$AQ_MAP" ]; then
    p="$(jq -r --arg c "${3%-*}" \
      'first(.trackers // {} | to_entries[] | select((.value | objects | .code) == $c) | .key) // empty' "$AQ_MAP")"
  fi
  if [ -n "$p" ] && [ "$p" != "$1" ] && p="$(project_resolve "$p")" &&
    dir="$(project_repo_path "$1")" && [ -n "$dir" ] && [ "$(project_repo_path "$p")" = "$dir" ]; then
    printf '%s\n' "$p"
  else
    printf '%s\n' "$1"
  fi
}

project_of_cwd() {
  local top
  top="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 0
  top="$(dirname "$top")"
  [ -f "$AQ_MAP" ] && jq -r --arg r "$top" '.paths[$r] // empty' "$AQ_MAP" 2>/dev/null
}

# project_board <project> -> "<board><TAB><profile><TAB><row code>" of the lab sheet the project's rows
# go on: the project named by its `board` key (a repo with no sheet of its own: dotfiles-private ->
# agent-runtime), else its own. Profile and code are empty when that board has no sheet.
project_board() {
  jq -r --arg p "$1" '((.trackers[$p] | objects | .board) // $p) as $b
    | (.trackers[$b] | objects) // {} | [$b, .lab // "", .code // ""] | @tsv' "$AQ_MAP" 2>/dev/null
}

# file_story <project> <title> <priority> <weight> <epic> <want> -> "<board><TAB><profile><TAB><id>" of the story row
# the item closes on merge, or nothing. An item not promoted from the board is still a story on its
# project's agent board, so a task shows under its feature the moment it is added: one `[/]` row
# through `notes ptask` (the rows' one writer), `#of/<epic>` when the item names an epic of this
# project (--epic, or its plan's `epic:` line), else the standing epic of its area's system, which
# `notes ptask` links, `#size/s` for a light item and `#size/m` for a heavy one, at the item's
# priority, on the board project_board names. Started, so dispatch never promotes it a second time. An open
# row with the same text is linked instead of written twice. A project with no lab sheet or no row
# code files nothing, and a failed write never stops the add: the item is the record, the row its credit.
# <want> is the channel of a human's want, or empty: the notes writer then stamps #requested.
file_story() {
  local project text="$2" prio="$3" size=s of="" lab code row out rc=0 id detail=() want=()
  [ -z "${6:-}" ] || want=(--want "$6")
  [ "$4" = heavy ] && size=m
  [ -f "$AQ_MAP" ] || return 0
  IFS=$'\t' read -r project lab code < <(project_board "$1")
  [ -n "$lab" ] && [ -n "$code" ] || return 0
  command -v notes >/dev/null || { echo "agent-queue: no story row filed: no notes on PATH" >&2; return 0; }
  [ "${5%-*}" = "$code" ] && of=" #of/$5"
  # The row's words: no markers or #tags of the task's own. The board refuses untyped text, so the
  # row is `notes`'s typed form of them, cut to the board's 80; past that the whole line is its detail.
  text="$(sed -E 's/<!--[^>]*-->//g; s/(^| )#[A-Za-z][A-Za-z0-9_/:.-]*//g; s/ +/ /g; s/^ //; s/ $//' <<<"$text")"
  [ -n "$text" ] || return 0
  row="$(notes --profile "$lab" ptask "$project" --agent propose -- "$text" 2>&1)" ||
    { echo "agent-queue: no story row filed on $project: ${row##*$'\n'}" >&2; return 0; }
  [ "${#text}" -le 80 ] || detail=(--detail "$text")
  out="$(notes --profile "$lab" ptask "$project" --agent add "${detail[@]}" "${want[@]}" -- "$row #size/$size #$prio$of" 2>&1)" || rc=$?
  id="$(sed -nE 's/.*<!--.*\bid:([a-z0-9]+-[0-9]+).*/\1/p' <<<"$out" | head -1)"
  case "$rc" in
    0) [ -n "$id" ] || { echo "agent-queue: story row on $project has no id, not linked: ${out##*$'\n'}" >&2; return 0; }
       notes --profile "$lab" ptask "$project" --agent start "$id" >/dev/null 2>&1 ||
         echo "agent-queue: story row $id on $project could not be started" >&2 ;;
    3) [ -n "$id" ] || { echo "agent-queue: no story row filed: ${out##*$'\n'}" >&2; return 0; }
       # The twin is open: start it unless a live item already did.
       if grep -q ': - \[ \] ' <<<"$out"; then notes --profile "$lab" ptask "$project" --agent start "$id" >/dev/null 2>&1; fi ;;
    *) echo "agent-queue: no story row filed on $project: ${out##*$'\n'}" >&2; return 0 ;;
  esac
  printf '%s\t%s\t%s\n' "$project" "$lab" "$id"
}

# link_row <id> <project> -> "<board><TAB><profile><TAB><id>" of an open row on the project's agent board, started
# now, for an item that works a row already filed. Refused when the project has no board, the row is
# not open there, or a live item already names it (two items cannot both close one row). `from:` stays
# the item's origin: a board origin also means dispatch's presence gate and the judge's picks.
link_row() {
  local id="$1" project lab code taken out
  IFS=$'\t' read -r project lab code < <(project_board "$2")
  [ -n "$lab" ] && [ -n "$code" ] || die "--row $id: $2 has no agent board (no lab or code in $AQ_MAP, nor a board key naming one)"
  taken="$(collect $ACTIVE | jq -r --arg r "$project:$id" 'first(.[] | select(.row == $r) | .slug) // empty')"
  [ -z "$taken" ] || die "--row $id: $taken already works that row; to take it over: agent-queue claim $taken"
  command -v notes >/dev/null || die "--row $id: no notes on PATH"
  out="$(notes --profile "$lab" ptask "$project" --agent start "$id" 2>&1)" ||
    die "--row $id: not an open row on the $project agent board: ${out##*$'\n'}"
  printf '%s\t%s\t%s\n' "$project" "$lab" "$id"
}

# named_row <title> -> the one row id (`ucp-134`) the title names as its subject, else nothing and
# rc 1: none, or two that differ. A subject is the first word (`ucp-134: ...`) or an id in brackets
# (`... (ucp-134)`, `[ucp-134]`); an id in the sentence (`after ar-40 lands`) only mentions a row.
# An item added for a row already filed then works that row (link_row, when it is open and no live
# item has it) instead of filing a second one beside it, so the row the human reads closes when
# the work lands (ucp-134 stayed open after its epic shipped, 2026-11-04).
named_row() {
  local ids
  ids="$({ grep -oiE '^[[:space:]]*[a-z]{2,4}-[0-9]+([:[:space:]]|$)' <<<"$1"; grep -oiE '[([][a-z]{2,4}-[0-9]+[])]' <<<"$1"; } |
    tr -cd 'A-Za-z0-9\n-' | tr 'A-Z' 'a-z' | sort -u)"
  [ -n "$ids" ] && [ "$(grep -c . <<<"$ids")" = 1 ] && printf '%s\n' "$ids"
}

# prior_story <slug> <project> -> "<board><TAB><profile><TAB><id>" of the row this slug's last item recorded,
# when that row is still open on this project's board (started now if it was not), else nothing. A re-queue
# keeps its row by its id, not by its words: on 2026-11-06 two re-queued trader phases got second rows
# (tr-76, tr-77) because the first ones were written before rows were typed, so no text matched.
prior_story() {
  local f row prof board
  f="$(latest_done "$1")"; [ -n "$f" ] || return 0
  row="$(fm_get "$f" row)"; prof="$(fm_get "$f" profile)"
  board="$(project_board "$2" | cut -f1)"
  [ "${row%%:*}" = "$board" ] && [ -n "$prof" ] && command -v notes >/dev/null || return 0
  notes --profile "$prof" ptask "$board" --agent start "${row#*:}" >/dev/null 2>&1 || return 0
  printf '%s\t%s\t%s\n' "$board" "$prof" "${row#*:}"
}

# --- verbs ---
cmd_add() {
  local project="" mode=oneshot priority=high tags="" after="" from=human agent=claude slug=""
  local running="" session="" task=() tag planf="" dry="" weight="" title="" epic="" repeat="" from_given="" want="" row=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project="${2:?}"; shift 2 ;;
      --mode) mode="${2:?}"; shift 2 ;;
      --priority) priority="${2:?}"; shift 2 ;;
      --weight) weight="${2:?}"; shift 2 ;;
      --tags) tags="$(printf '%s' "${2:?}" | tr ',' ' ' | tr -s ' ' | sed 's/^ //; s/ $//')"; shift 2 ;;
      --after) after="${2:?}"; shift 2 ;;
      --from) from="${2:?}"; from_given=1; shift 2 ;;
      --agent) agent="${2:?}"; shift 2 ;;
      --slug) slug="${2:?}"; shift 2 ;;
      --title) title="$(printf '%s' "${2:?}" | tr -s '\n\t' '  ' | sed 's/^ *//; s/ *$//')"; shift 2 ;;
      --epic) epic="${2:?}"; shift 2 ;;
      --want) want="${2:?}"; shift 2 ;;
      --row) row="${2:?}"; shift 2 ;;
      --running) running=1; shift ;;
      --session) session="${2:?}"; shift 2 ;;
      --plan) planf="${2:?}"; shift 2 ;;
      --dry-run) dry=1; shift ;;
      --repeat) repeat=1; shift ;;
      --) shift; task+=("$@"); break ;;
      -*) die "unknown option: $1" ;;
      *) task+=("$1"); shift ;;
    esac
  done
  if [ -n "$planf" ]; then
    [ "${#task[@]}" -eq 0 ] || die "--plan writes its own tasks; pass no task with it"
    [ -z "$want" ] || die "--want names a human's channel; --plan items are agent-made and carry none"
    [ -z "$row" ] || die "--row links one item; a plan's phases each file a story under its epic: line"
    [ "$mode" = oneshot ] && [ -z "$running" ] || die "--plan items are queued oneshot items: no --mode plan or --running"
    case "$from" in
      research:?* | auto:?*) [ -n "$dry" ] || admit "$from" "$priority" "$tags" "${project:-$(project_of_cwd)}" "$(basename "$planf" .md)" \
        "plan $(basename "$planf")" || exit "$AQ_EX_HELD" ;;
    esac
    AQ_ADMITTED=1 add_plan; return
  fi
  [ -z "$dry" ] || die "--dry-run goes with --plan"
  local text
  if [ "${#task[@]}" -gt 0 ]; then text="${task[*]}"; elif [ ! -t 0 ]; then text="$(cat)"; fi
  [ -n "$(printf '%s' "${text:-}" | tr -d '[:space:]')" ] || die "no task: pass it as arguments or on stdin"
  case "$mode" in oneshot | plan) ;; *) die "--mode is oneshot or plan, not $mode" ;; esac
  prio_rank "$priority" >/dev/null || die "--priority is urgent, high or low, not $priority"
  case "$weight" in '' | heavy | light) ;; *) die "--weight is heavy or light, not $weight" ;; esac
  case "$from" in human | shepherd | canary | research:?* | auto:?* | board:?*:?*) ;; *) die "--from is human, shepherd, canary, research:<facet>, auto:<filer> or board:<project>:<key>, not $from" ;; esac
  case "$agent" in *[!a-z0-9-]* | '') die "--agent is one word, not $agent" ;; esac
  local row_id='^[a-z0-9]+-[0-9]+$'
  [ -z "$epic" ] || [[ "$epic" =~ $row_id ]] || die "--epic is a row id, <code>-<N>, not $epic"
  if [ -n "$row" ]; then
    [[ "$row" =~ $row_id ]] || die "--row is a row id, <code>-<N>, not $row"
    [ -z "$epic$want" ] || die "--epic and --want shape a new story; --row links a row already filed"
    case "$from" in board:* | canary) die "--row is for an item not promoted from the board and not a canary, not --from $from" ;; esac
  fi
  check_tags "$tags"
  # A hand-started session records itself and its window, on the agent world only.
  local window=''
  if [ -n "$running" ] && [ -z "$session" ]; then
    session="$(agent_session)" || session=""
    [ -z "$session" ] || window="$(own_window)" || window=""
  fi
  session="$(qualified "$session")" || exit 1
  [ -n "$project" ] || project="$(project_of_cwd)"
  [ -n "$project" ] || die "no --project, and this directory is not a repo project-map knows"
  local resolved
  resolved="$(project_resolve "$project")" || die "unknown project: $project (no checkout for it in $AQ_MAP)"
  [ -n "$epic" ] || epic="$(plan_epic "${AQ_ITEM_PLAN:-}")"
  project="$(project_credit "$resolved" "$from" "${row:-$epic}")"
  # A title naming one row (named_row) is linked at the story step, after admission, on the
  # board of the project that row's code credits; a link that fails keeps this project.
  local named='' named_project=''
  if [ -z "$row$epic$want" ] && named="$(named_row "${title:-$(head -1 <<<"$text")}")"; then
    named_project="$(project_credit "$resolved" "$from" "$named")"
  fi
  [ -n "$weight" ] || { weight_of "$project" "$mode" "${AQ_ITEM_PHASES:-}"; weight="$WEIGHT"; }
  local slug_from_text=''
  [ -n "$slug" ] || slug_from_text=1
  slug="$(slugify "${slug:-$text}")"
  [ -n "$slug" ] || die "could not derive a slug; pass --slug"
  # Admission: a machine filer, or a queue item's session adding new runnable work that admission
  # would gate, which is recorded as from the item. See admit.
  local auto='' deferred=''
  case "$from" in research:?* | auto:?*) auto=1 ;; esac
  if [ -z "$from_given" ] && [ -n "${AGENT_QUEUE_ITEM:-}" ] && [ -z "$running" ] && ! admission_exempt "$priority" "$tags"; then
    for tag in $tags; do case "$tag" in at:* | pr:* | ask:* | hold:* | nightly:*) deferred=1 ;; esac; done
    [ -n "$after" ] || [ -n "$deferred" ] || { from="item:$AGENT_QUEUE_ITEM"; auto=1; }
  fi
  lock
  [ -z "$(find_item "$slug")" ] || die "already in the queue: $slug"
  local why
  # Checked before slug is reused below: an explicit --slug is the same work by name.
  [ -n "$repeat" ] || why="$(finished_ok "$slug" "${slug_from_text:+$text}")"
  [ -n "$repeat" ] || [ -n "${why:-}" ] || why="$(finished_row_ok "$from")"
  [ -z "${why:-}" ] || { echo "agent-queue: $why" >&2; exit "$AQ_EX_FINISHED"; }
  # Under the lock, so two filers at once cannot both pass on the same count.
  if [ -n "$auto" ] && [ -z "$running" ] && [ -z "${AQ_ADMITTED:-}" ]; then
    admit "$from" "$priority" "$tags" "$project" "$slug" "${title:-$(head -1 <<<"$text")}" || exit "$AQ_EX_HELD"
  fi
  if [ -n "$after" ] && [ -z "$(find_item "$after")" ] && [ -z "$(done_status "$after")" ]; then
    die "--after $after: no item has that slug"
  fi
  local state=queued now; now="$(now_utc)"
  [ -n "$running" ] && state=running
  # `type(area): title` on the task's first line or its --title, parsed by the grammar's one home.
  local ctype='' carea='' sid='' parsed ok=''
  if parsed="$(head -1 <<<"${title:-$text}" | notes row parse 2>/dev/null)" && [ -n "$parsed" ]; then
    IFS=$'\t' read -r ctype carea _ ok <<<"$parsed"
  else
    echo "agent-queue: notes row parse failed, so $slug is untyped (an old notes? notes-bootstrap --build-only)" >&2
  fi
  [ "$ok" = 1 ] || ctype='' carea=''
  # Only a session taking the item works it. One queueing it for later did not, and outcomes
  # would charge that session's cost and revert count to this item.
  [ -z "$running" ] || sid="$(claude_sid)" || sid=
  local story='' sboard='' sprof='' srow=''
  # A canary item is an eval of the fleet, not work on the project: fleet-bench canary is its record.
  case "$from" in
    board:* | canary) ;;
    *) if [ -n "$row" ]; then
         story="$(link_row "$row" "$project")" || exit 1
       else
         story="$(prior_story "$slug" "$project")"
         if [ -z "$story" ] && [ -n "$named" ] && story="$(link_row "$named" "$named_project" 2>/dev/null)"; then
           project="$named_project"
           echo "agent-queue: $slug works row $named, which its title names; it closes that row when it lands" >&2
         fi
         [ -n "$story" ] || story="$(file_story "$project" "${title:-$(head -1 <<<"$text")}" "$priority" "$weight" "$epic" "$want")"
       fi ;;
  esac
  [ -z "$story" ] || IFS=$'\t' read -r sboard sprof srow <<<"$story"
  mkdir -p "$AQ_DIR/$state"
  local f tmp
  f="$AQ_DIR/$state/$(date +%Y%m%d-%H%M%S)-$slug.md"
  tmp="$(mktemp "$AQ_DIR/$state/.add.XXXXXX")" || die "cannot write in $AQ_DIR/$state"
  {
    printf 'slug: %s\nproject: %s\nmode: %s\npriority: %s\nweight: %s\n' "$slug" "$project" "$mode" "$priority" "$weight"
    [ -n "$title" ] && printf 'title: %s\n' "$title"
    [ -n "$ctype" ] && printf 'type: %s\narea: %s\n' "$ctype" "$carea"
    [ -n "$tags" ] && printf 'tags: %s\n' "$tags"
    [ -n "$after" ] && printf 'after: %s\n' "$after"
    [ -n "${AQ_ITEM_PLAN:-}" ] && printf 'plan: %s\nphases: %s\n' "$AQ_ITEM_PLAN" "$AQ_ITEM_PHASES"
    printf 'from: %s\nagent: %s\nqueued: %s\n' "$from" "$agent" "$now"
    [ -n "$running" ] && printf 'started: %s\n' "$now"
    [ -n "$session" ] && printf 'session: %s\n' "$session"
    [ -n "$window" ] && printf 'window: %s\n' "$window"
    [ -n "$sid" ] && printf 'sessions: %s\n' "$sid"
    [ -n "$story" ] && printf 'row: %s:%s\nlane: agent\nprofile: %s\n' "$sboard" "$srow" "$sprof"
    printf -- '---\n%s\n' "$text"
  } > "$tmp" && mv -- "$tmp" "$f" || die "could not write $f"
  item_event item-added "$f" --to "$state"
  echo "$state $slug -> $f"
  [ -z "$story" ] || echo "story $srow on the $sboard agent board${epic:+, under $epic}"
  [ -z "$running" ] || mark_row "$f" run
  [ "$mode" = plan ] && [ -z "$running" ] && [ "${AGENT_QUEUE_START:-1}" = 1 ] || return 0
  # The starter writes this item back through this script: free the lock, and keep the fd out of tmux.
  exec 8>&-
  fleet-dispatch start --item "$slug" ||
    echo "agent-queue: $slug could not start now, so it stays queued for the next dispatch pass" >&2
}

# weight_of <project> <mode> <phases> -> sets WEIGHT, heavy or light, for an item added without
# --weight. Heavy: a plan session (it holds the whole plan), an item that carries two or more
# phases, or a checkout that is a Unity project (a session there runs an editor and pool gates),
# which a listing asks once per project. Else light.
weight_of() {
  local words MEMO_V
  read -ra words <<<"$3"
  if [ "$2" = plan ] || [ "${#words[@]}" -ge 2 ]; then WEIGHT=heavy; return; fi
  memo "unity:$1" unity_weight "$1"
  WEIGHT="$MEMO_V"
}
unity_weight() {
  local dir
  dir="$(project_repo_path "$1" 2>/dev/null)" || dir=""
  if [ -n "$dir" ] && [ -f "$dir/ProjectSettings/ProjectVersion.txt" ]; then echo heavy; else echo light; fi
}

# add_plan: cmd_add --plan, reading its locals. One item per unchecked phase, in checklist
# order, each `after:` the one before (the first after --after), carrying `plan:` and
# `phases:` (its checklist numbers). A phase line with `(with N)` joins phase N's item when
# phase N is open too, for phases that share a branch; the item runs where its first phase is.
# Every slug is checked before any item is written.
add_plan() {
  [ -f "$planf" ] || die "--plan $planf: no such file"
  planf="$(realpath "$planf")"
  [ -n "$project" ] || project="$(project_of_cwd)"
  [ -n "$project" ] || die "no --project, and this directory is not a repo project-map knows"
  project="$(project_resolve "$project")" || die "unknown project: $project (no checkout for it in $AQ_MAP)"
  # A plan is queued once: by its owner, or by hand. The calling session's own item does not count.
  local taken
  taken="$(collect $ACTIVE | jq -r --arg p "$planf" --arg own "${AGENT_QUEUE_ITEM:-}" \
    "$PLAN_ITEMS_JQ"' .[] | select(.slug != $own and names_plan($p)) | .slug' | paste -sd' ')"
  [ -z "$taken" ] || die "the phases of $planf are already queued: $taken (nothing was added)"
  local groups
  groups="$(plan_phase_list "$planf" | jq -c '
    to_entries | map({n: (.key + 1), state: .value.state, name: .value.name,
      with: ((.value.name | capture("\\(with (?<w>[0-9]+)\\)") | .w | tonumber) // null)}) as $all
    | reduce ($all[] | select(.state == "open")) as $p ({of: {}, items: []};
        ($all[($p.with // 0) - 1]) as $w
        | if $p.with != null and $p.with < $p.n and $p.with > 0 and $w.state == "open" then
            .of[$p.n | tostring] = .of[$p.with | tostring]
            | .items[.of[$p.n | tostring]] += [$p]
          else .of[$p.n | tostring] = (.items | length) | .items += [[$p]] end)
    | .items | map({phases: map(.n), names: map(.name | sub(" ?\\(with [0-9]+\\)"; "") | sub("^[0-9]+[.)] "; ""))}
      | .titles = (.names | map(sub("[.:] .*$"; "") | sub("[.:]$"; "") | .[0:80]))
      | .full = (.names | map(sub("[.]$"; "")) | join("; ") | .[0:100]))')" ||
    die "--plan $planf: could not read its Phases checklist"
  [ "$(jq length <<<"$groups")" -gt 0 ] || die "--plan $planf: no unchecked phase in its ## Phases checklist"
  local prefix
  prefix="$(slugify "${slug:-$(basename "$planf" .md)}" | cut -c1-32 | sed 's/-$//')"
  [ -n "$prefix" ] || die "could not derive a slug prefix; pass --slug"
  local rows
  rows="$(jq -r --arg pre "$prefix" --arg plan "$planf" --arg pname "$(basename "$planf" .md)" '.[]
    | (.phases | length > 1) as $many
    | [($pre + "-p\(.phases[0])"), (.phases | join(" ")),
       ("\(if $many then "Phases \(.phases | join(" and "))" else "Phase \(.phases[0])" end) of the plan \($plan): \(.titles | join("; ")). "
        + "Read the plan whole, then do ONLY \(if $many then "these phases, on one branch" else "this phase" end), to merged. "
        + "When it lands, tick its box\(if $many then "es" else "" end) in the plan'"'"'s Phases checklist with the PR number and add a Results line. "
        + "If the phase is already landed, or something it waits on (a named PR, an earlier phase, a deploy) is not in place, stop and say what is missing instead of working around it."),
       "\($pname) P\(.phases | map(tostring) | join("+")): \(.full)"]
    | @tsv' <<<"$groups")"
  local s ph text prev="$after"
  while IFS=$'\t' read -r s ph text _; do
    [ -z "$(find_item "$s")" ] || die "already in the queue: $s (nothing was added)"
  done <<<"$rows"
  if [ -n "$after" ] && [ -z "$(find_item "$after")" ] && [ -z "$(done_status "$after")" ]; then
    die "--after $after: no item has that slug"
  fi
  # A phase whose item already finished ok landed with its box left unticked: it is skipped, never run
  # twice, and the next phase still goes after it (an ok after: releases at once).
  local n=0 total why skipped=0
  total="$(wc -l <<<"$rows")"
  while IFS=$'\t' read -r s ph text ttl; do
    why=''
    [ -n "$repeat" ] || why="$(finished_ok "$s")"
    if [ -n "$why" ]; then
      echo "agent-queue: skipped $why; tick its box in $planf" >&2
      skipped=$((skipped + 1)); prev="$s"; continue
    fi
    if [ -n "$dry" ]; then
      printf 'would queue %s\tphases %s\tafter %s\n  %s\n' "$s" "$ph" "${prev:--}" "$text"
    else
      AQ_ITEM_PLAN="$planf" AQ_ITEM_PHASES="$ph" \
        cmd_add_one ${project:+--project "$project"} --priority "$priority" ${tags:+--tags "$tags"} ${weight:+--weight "$weight"} \
          --from "$from" --agent "$agent" --slug "$s" --title "$ttl" ${prev:+--after "$prev"} ${repeat:+--repeat} -- "$text" ||
        die "added $n of $total items from $planf; $s and the rest are not queued"
    fi
    n=$((n + 1)); prev="$s"
  done <<<"$rows"
  [ "$skipped" -lt "$total" ] || exit "$AQ_EX_FINISHED"
}
# One item through cmd_add, in a subshell so its die stops only that item.
cmd_add_one() { (cmd_add "$@"); }

cmd_list() {
  local json="" state=active date="" since=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --state) state="${2:?}"; shift 2 ;;
      --date) date="${2:?}"; shift 2 ;;
      --since) since="${2:?}"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  local states
  case "$state" in
    active) states="waiting review running queued" ;;
    all) states="waiting review running queued done" ;;
    queued | running | waiting | review | done) states="$state" ;;
    *) die "--state is queued, running, waiting, review, done, active or all" ;;
  esac
  lock_read
  # shellcheck disable=SC2086
  local items; items="$(collect $states ${date:+--date "$date"} ${since:+--since "$since"})"
  if [ -n "$json" ]; then
    jq -c '.[]' <<<"$items"
    return 0
  fi
  [ "$(jq length <<<"$items")" -gt 0 ] || { echo "queue: nothing ${state/active/queued, running, waiting or review}"; return 0; }
  # Grouped by state in this order, queue order inside each group.
  jq -r '(["waiting","review","running","queued","done"]) as $o
    | sort_by(.state as $s | $o | index($s)) | .[]
    | [.state, .priority, .slug, .project, .mode,
       (.hold // .status // .session // ""), (.tags // ""), .from] | map(if . == "" then "-" else . end) | @tsv' <<<"$items"
}

cmd_next() {
  local items
  lock_read
  items="$(collect queued | jq -c '[.[] | select(.hold == null)] | first // empty')"
  [ -n "$items" ] || return 1
  if [ "${1:-}" = --json ]; then printf '%s\n' "$items"; else jq -r .file <<<"$items"; fi
}

cmd_show() {
  local slug="${1:?usage: agent-queue show <slug>}" f
  lock_read
  f="$(find_item "$slug" any)"; [ -n "$f" ] || die "no item: $slug"
  if [ "${2:-}" = --json ]; then item_json "$f"; return 0; fi
  printf 'state: %s\nfile: %s\n' "$(state_of "$f")" "$f"
  cat -- "$f"
}

# The item this session is working, so agent-land can close it with no slug: exit 1 when none,
# 2 when more than one (pass the slug). The Claude session id decides first: an item lists every
# session that worked it (`sessions:`), whatever window it ran in. Without one, the tmux session,
# and only a running item: a hub session hosts many conversations, and a waiting item of an
# earlier one is not this one's (2026-11-05 a land closed c1103's waiting item that way).
# --sid asks of that Claude session alone, with no tmux fallback (the focus gate, from a hook).
cmd_mine() {
  local session='' sid only=0 slugs
  case "${1:-}" in
    --session) session="${2:?--session needs a value}" ;;
    --sid) sid="${2:?--sid needs a value}" only=1 ;;
    '') ;;
    *) die "usage: agent-queue mine [--session s | --sid id]" ;;
  esac
  [ "$only" -eq 1 ] || sid="$(claude_sid)" || sid=""
  lock_read
  if [ -z "$session" ] && [ -n "$sid" ]; then
    slugs="$(collect running waiting review | jq -r --arg s "$sid" '.[] | select((.sessions // "") | split(" ") | index($s)) | .slug')"
  fi
  [ "$only" -eq 0 ] || [ -n "${slugs:-}" ] || return 1
  if [ -z "${slugs:-}" ]; then
    [ -n "$session" ] || session="$(own_session)" || { [ -n "$sid" ] && return 1; die "not in tmux: pass --session <server>:<session>"; }
    slugs="$(collect running | jq -r --arg s "$session" '.[] | select(.session == $s) | .slug')"
  fi
  [ -n "$slugs" ] || return 1
  if [ "$(wc -l <<<"$slugs")" -gt 1 ]; then
    echo "agent-queue: more than one item is this session's: $(tr '\n' ' ' <<<"$slugs")" >&2
    return 2
  fi
  printf '%s\n' "$slugs"
}

# claim <slug> [--sid id] -- add a Claude session to the sessions that worked this item, done or not. Run by
# fleet-dispatch start for the id it launches with, and by agent-land; adding one already there is a no-op.
cmd_claim() {
  local slug="${1:?usage: agent-queue claim <slug> [--sid id]}" sid f cur
  shift
  case "${1:-}" in --sid) sid="${2:?--sid needs a value}" ;; '') sid="$(claude_sid)" || die "no Claude session: pass --sid" ;; *) die "usage: agent-queue claim <slug> [--sid id]" ;; esac
  case "$sid" in *[!A-Za-z0-9_-]*) die "not a session id: $sid" ;; esac
  lock
  # `any`: a task split across repos lands its second PR on a done item, from another session.
  f="$(find_item "$slug" any)"; [ -n "$f" ] || die "no item: $slug"
  cur="$(fm_get "$f" sessions)"
  case " $cur " in *" $sid "*) echo "$slug: $sid already claimed"; return 0 ;; esac
  header_set "$f" sessions "${cur:+$cur }$sid"
  item_event item-claimed "$f" --why "$sid"
  echo "$slug: claimed by $sid"
}

# close_on <host> <tmux-close args...> -- tmux-close here, or on that fleet worker over ssh.
close_on() {
  local host="$1"; shift
  [ -n "$host" ] || { "$TMUX_CLOSE" "$@"; return; }
  # shellcheck source=../lib/fleet-hosts.sh
  declare -F fleet_host_run >/dev/null || . "${FLEET_HOSTS_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/fleet-hosts.sh}"
  fleet_host_run "$host" tmux-close "$@"
}

cmd_cancel() {
  local slug="${1:?usage: agent-queue cancel <slug>}" f session server window host dest
  lock
  f="$(find_item "$slug")"; [ -n "$f" ] || die "nothing active with slug $slug"
  # `session:` is <server>:<tmux session>; a value with no server names nothing to kill.
  session="$(fm_get "$f" session)"; server="${session%%:*}"; window="$(fm_get "$f" window)"
  case "$session" in *:*) session="${session#*:}" ;; *) session='' ;; esac
  # A session on a fleet worker is closed there: here the same name is some other session.
  host="$(fm_get "$f" host)"
  # Close what the item owns: its window when it recorded one (a hand start), its session only
  # when fleet-dispatch made it (`origin:`), else nothing. tmux-close spares world sessions.
  if [ -n "$session" ] && [ "$(state_of "$f")" != queued ]; then
    if [ -n "$window" ]; then
      close_on "$host" -L "$server" window "$window" 2>/dev/null && echo "closed window $window of $session" ||
        echo "agent-queue: window $window was not open on $server" >&2
    elif [ -n "$(fm_get "$f" origin)" ]; then
      close_on "$host" -L "$server" session "$session" && echo "killed session $session" ||
        echo "agent-queue: session $session was not closed on $server" >&2
    else
      echo "agent-queue: left $server:$session open: a hand-started item that recorded no window owns no session" >&2
    fi
  fi
  header_set "$f" status cancelled
  header_set "$f" finished "$(now_utc)"
  header_del "$f" end_reason
  dest="$(move_to "$f" "done")" || die "could not move $f"
  item_event item-cancelled "$dest" --to done
  echo "cancelled $slug -> $dest"
}

cmd_bump() {
  local slug="${1:?usage: agent-queue bump <slug> <priority>}" prio="${2:?usage: agent-queue bump <slug> <priority>}" f
  prio_rank "$prio" >/dev/null || die "priority is urgent, high or low, not $prio"
  lock
  f="$(find_item "$slug")"; [ -n "$f" ] || die "nothing active with slug $slug"
  header_set "$f" priority "$prio"
  item_event item-set "$f" --why "priority=$prio"
  echo "$slug -> $prio"
}

# The fields only the dispatcher and the session record. Identity fields (slug, queued) are not
# settable: they are what the item is. `from` is, so a project rename can move a board origin.
SETTABLE=" project mode priority tags type after agent started waiting review finished session window account model size lane_run end_reason plan pr merged partial closing_pr fix_tries fix_human cost_usd gateway_cost_usd work_min report ask note status area origin lane profile from touches row host routed "

cmd_set() {
  local slug="${1:?usage: agent-queue set <slug> <key=value>...}" f kv k
  shift
  [ $# -gt 0 ] || die "usage: agent-queue set <slug> <key=value>..."
  for kv in "$@"; do
    k="${kv%%=*}"
    [ "$k" != "$kv" ] || die "not key=value: $kv"
    case "$SETTABLE" in *" $k "*) ;; *) die "not a settable field: $k" ;; esac
    [ "$k" != tags ] || check_tags "${kv#*=}"
    [ "$k" != end_reason ] || [ -z "${kv#*=}" ] || check_end "${kv#*=}"
    if [ "$k" = project ] && [ "$(project_resolve "${kv#*=}")" != "${kv#*=}" ]; then
      die "unknown project: ${kv#*=} (not a canonical project in $AQ_MAP)"
    fi
  done
  lock
  f="$(find_item "$slug" any)"; [ -n "$f" ] || die "no item: $slug"
  # merged: is the merge of the PR in pr:, so a new pr: drops an old merged: unless this set names
  # one too (agent-land sets both), or done ok would pass on the last PR's merge (cmd_move).
  case " $* " in
    *" merged="*) ;;
    *" pr="*) for kv in "$@"; do
        [ "${kv%%=*}" = pr ] && [ "${kv#*=}" != "$(fm_get "$f" pr)" ] && header_del "$f" merged
      done ;;
  esac
  for kv in "$@"; do
    case "$kv" in session=*) kv="session=$(qualified "${kv#*=}")" || exit 1 ;; esac
    header_set "$f" "${kv%%=*}" "${kv#*=}"
  done
  item_event item-set "$f" --why "$*"
  echo "$slug: $*"
}

# retask <slug> [task...] -- replace a queued item's task, from args or stdin like add: the correction
# for a task that holds a wrong fact, since the task is what its session is briefed with. A started
# item is refused: its session already has the brief, so tell the session instead. The header stays
# as filed (its row, title and holds); `set type= area=` when the correction changes the item's kind.
cmd_retask() {
  local slug="${1:?usage: agent-queue retask <slug> [task...]}" f text tmp was
  shift
  if [ $# -gt 0 ]; then text="$*"; elif [ ! -t 0 ]; then text="$(cat)"; fi
  [ -n "$(printf '%s' "${text:-}" | tr -d '[:space:]')" ] || die "no task: pass it as arguments or on stdin"
  lock
  f="$(find_item "$slug")"; [ -n "$f" ] || die "nothing active with slug $slug"
  [ "$(state_of "$f")" = queued ] || die "$slug is $(state_of "$f"): its session already has the brief; tell the session"
  was="$(fm_body "$f" | head -1)"
  tmp="$(mktemp "$(dirname "$f")/.retask.XXXXXX")" || die "cannot write in $(dirname "$f")"
  { awk '{ print } $0 == "---" { exit }' "$f"; printf '%s\n' "$text"; } > "$tmp" && mv -- "$tmp" "$f"
  item_event item-set "$f" --why "task rewritten, was: $was"
  echo "$slug: task rewritten"
}

# attribute <slug> -- credit an item by the files its PR changed, repo-relative paths on stdin.
# The candidates are the registry projects with a `path` in the item's repo (its project's `repo`,
# else the project itself). The one owning the most changed files gets the item, and every one
# owning any is recorded in `touches:`. No file under a path, or a tie for the most, leaves
# `project:` as it is. agent-land runs it on a merge. Prints what it recorded, or nothing.
cmd_attribute() {
  [ $# -eq 1 ] || die "usage: agent-queue attribute <slug> < changed-paths"
  local f project res win touches
  [ -f "$AQ_MAP" ] || return 0
  lock
  f="$(find_item "$1" any)"; [ -n "$f" ] || die "no item: $1"
  project="$(fm_get "$f" project)"
  res="$(credit_of "$project")" || die "could not read $AQ_MAP"
  [ -n "$res" ] || return 0
  win="${res%%$'\t'*}" touches="${res#*$'\t'}"
  header_set "$f" touches "$touches"
  if [ -n "$win" ] && [ "$win" != "$project" ]; then
    header_set "$f" project "$win"
    echo "credited to $win (touches $touches)"
  else
    echo "touches $touches"
  fi
}

# credit_of <project> < changed-paths -> "<winner>\t<touches>", or nothing when no path matches: the
# attribution rule itself, shared by `attribute` (which records it), `credit-of` (which only prints
# it, for credit-backfill) and session-outcomes. A path is an app's when it is under the app's tracker
# `path`, else when one of its directories is named after the app (infra/flux/apps/prod/<app>/,
# store/<app>/). The winner owns the most paths, and is empty on a tie.
credit_of() {
  jq -nRr --slurpfile m "$AQ_MAP" --arg p "$1" '
    ($m[0].trackers // {}) as $t
    | (($t[$p] | objects | .repo) // $p) as $repo
    | [$t | to_entries[] | select((.value | objects | .repo) == $repo and (.value.path // "") != "")
       | {key, dir: (.value.path | rtrimstr("/") + "/")}] as $cands
    | [inputs | select(. != "") | . as $f
       | [$cands[] | .dir as $d | select($f | startswith($d)) | .key] as $in
       | if $in != [] then $in[] else ($f | split("/") | .[0:-1]) as $ds | $cands[] | select(.key as $k | $ds | index($k)) | .key end]
    | group_by(.) | map({key: .[0], n: length})
    | sort_by(-.n, .key)
    | select(length > 0)
    | (if length > 1 and .[0].n == .[1].n then "" else .[0].key end) + "\t" + (map(.key) | sort | join(" "))'
}

cmd_credit_of() {
  [ $# -eq 1 ] || die "usage: agent-queue credit-of <project> < changed-paths"
  [ -f "$AQ_MAP" ] || return 0
  credit_of "$1" || die "could not read $AQ_MAP"
}

# END_REASONS: why a run ended (end_reason:), set only by fleet-dispatch's settle_item from the rollout
# (codex-rollout.jq). The first four say nothing about the model, so lane_outcome files no outcome for
# them; `timeout` and `stopped` rate as before.
END_REASONS="refused limit provider cut timeout stopped"
UNRATED_ENDS=" refused limit provider cut "
check_end() { case " $END_REASONS " in *" $1 "*) ;; *) die "end_reason is one of: $END_REASONS, not $1" ;; esac; }

# move <slug> <state> [--status s] [--end reason] [--if <state>] -- --end records why the run ended
# (end_reason:); --if is the compare in a compare-and-set: the
# move happens only while the item is still in the state the caller read, so a pass that read it a
# moment ago never undoes a move made since (a requeue, the session's own close).
cmd_move() {
  local slug="${1:?usage: agent-queue move <slug> <state> [--status s] [--end reason] [--if state]}" to="${2:?usage: agent-queue move <slug> <state>}"
  local status="" end="" expect="" f from dest deps run tags
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --status) status="${2:?--status needs a value}"; shift 2 ;;
      --end) end="${2:?--end needs a reason}"; check_end "$end"; shift 2 ;;
      --if) expect="${2:?--if needs a state}"; shift 2 ;;
      *) die "usage: agent-queue move <slug> <state> [--status s] [--end reason] [--if state]" ;;
    esac
  done
  case "$to" in queued | running | waiting | review | done) ;; *) die "state is queued, running, waiting, review or done, not $to" ;; esac
  if [ "$to" = "done" ]; then
    case "$status" in ok | failed | cancelled) ;; *) die "move to done needs --status ok, failed or cancelled" ;; esac
  fi
  [ -n "${AQ_LOCKED-}" ] || lock
  f="$(find_item "$slug")"; [ -n "$f" ] || die "nothing active with slug $slug"
  from="$(state_of "$f")"
  [ -z "$expect" ] || [ "$from" = "$expect" ] || { echo "agent-queue: $slug is $from, not $expect: left as it is" >&2; return 3; }
  [ "$from" != "$to" ] || { echo "$slug already $to"; return 0; }
  if [ "$to" = done ] && [ "$status" = ok ] && [ "$(fm_get "$f" partial)" = yes ]; then
    die "$slug has a partial landing; finish with agent-land <N> without --partial before closing it ok"
  fi
  # Done ok with a PR means merged: an ok close with the PR still open strands it, since nothing
  # reads that item again and its after: items start on work that never landed (#1145, #1146).
  if [ "$to" = done ] && [ "$status" = ok ] && [ -n "$(fm_get "$f" pr)" ] && [ -z "$(fm_get "$f" merged)" ]; then
    die "$slug has pr:$(fm_get "$f" pr) and no merged:, so done ok would close it with the PR open: land it with agent-land <N>, which records the merge, or move it to review until the PR merges (fleet-dispatch reap closes it then)"
  fi
  # The items after: this one, named before it closes, since an ok close starts them (start_next).
  if [ "$to" = done ] && [ "$status" = ok ]; then
    deps="$(dependents "$slug")"
    [ -z "$deps" ] || echo "$slug releases: $(paste -sd' ' <<<"$deps")"
  fi
  run="$(fm_get "$f" lane_run)"
  case "$to" in
    # Back in the queue, the item runs nowhere: the next start launches a fresh session and
    # records it, and until then a stale `session:` points shepherd and fleet-sessions at a window
    # that no longer works it. `sessions:` stays: it is the history of who worked the item.
    # lane_run goes too: the next start logs a run of its own, and host: too, since the next start
    # may run it here.
    queued) header_del "$f" session window started waiting review origin lane_run host ;;
    running) [ -n "$(fm_get "$f" started)" ] || header_set "$f" started "$(now_utc)"
      # A new run has not ended yet: the last run's reason goes.
      header_del "$f" end_reason
      # A hold: tag gates one start: once running, the item's own session may claim that resource,
      # and a tag left on would hold the item behind its own claim if it is ever requeued.
      tags="$(fm_get "$f" tags)"
      case " $tags " in *" hold:"*)
        tags="$(tr ' ' '\n' <<<"$tags" | grep -v '^hold:' | paste -sd' ')"
        if [ -n "$tags" ]; then header_set "$f" tags "$tags"; else header_del "$f" tags; fi ;;
      esac ;;
    waiting) header_set "$f" waiting "$(now_utc)" ;;
    review) header_set "$f" review "$(now_utc)" ;;
    # A run that landed or was cancelled has no end to report: a reason left from a wait on its PR goes.
    done) header_set "$f" status "$status"; header_set "$f" finished "$(now_utc)"
      case "$status" in ok | cancelled) header_del "$f" end_reason; end="" ;; esac ;;
  esac
  [ -z "$end" ] || header_set "$f" end_reason "$end"
  dest="$(move_to "$f" "$to")" || die "could not move $f"
  item_event item-moved "$dest" --to "$to" --why "$from -> $to${status:+ ($status)}"
  echo "$slug: $from -> $to"
  lane_outcome "$run" "$from" "$to" "$status" "$end"
  # The row's section follows the item: Now while it runs or waits on someone, Next up once back in
  # the queue. waiting and review keep the mark: the item started.
  case "$to" in running) mark_row "$dest" run ;; queued) mark_row "$dest" start ;; esac
  [ "$to" = done ] && [ "$status" = ok ] || return 0
  local rc=0
  [ "${AGENT_QUEUE_START:-1}" != 1 ] || start_next "$slug" || rc=$?
  close_row_on_item "$slug" "$dest"
  return "$rc"
}

# mark_row <file> <run|start> -- the item's board row records its queue state, through notes, the rows'
# one writer: `run` adds run:MMDD (the sweep puts the row in Now), `start` takes it off again (Next up).
# The item is the state and the row its view, so a row the write cannot reach warns and the move stands.
mark_row() {
  local row prof flag=()
  row="$(fm_get "$1" row)" prof="$(fm_get "$1" profile)"
  [ -n "$row" ] && command -v notes >/dev/null || return 0
  case "$(fm_get "$1" lane)" in '' | agent) flag=(--agent) ;; esac
  notes ${prof:+--profile "$prof"} ptask "${row%%:*}" "${flag[@]}" "$2" "${row#*:}" >/dev/null 2>&1 ||
    echo "agent-queue: board row ${row#*:} on ${row%%:*} not marked $2: notes ${prof:+--profile $prof }ptask ${row%%:*} ${flag[*]} $2 ${row#*:}" >&2
}

# close_row_on_item <slug> <file> -- an item closed ok with no PR closes its row, the item as proof:
# its session's close is the claim, as the merge is for an item with a PR (agent-land, or
# fleet-dispatch close_row when its session died first). Its sessions read the move as closing the
# row, and a row left started reads as an orphan. A row already closed (a doc kind closes its own
# with doc: proof) is left as it is; a close that fails warns unless the board shows the row closed.
# After start_next, which scans the queue under the lock: this frees it before calling notes.
close_row_on_item() {
  local slug=$1 row prof lane pr flag=() out key board
  IFS=$'\x1f' read -r row prof lane pr < <(item_json "$2" |
    jq -r '[.row // "", .profile // "", .lane // "", .pr // ""] | join("\u001f")')
  [ -n "$row" ] && [ -z "$pr" ] || return 0
  case "$lane" in '' | agent) flag=(--agent) ;; esac
  [ -n "${AQ_LOCKED-}" ] || exec 8>&-
  key="${row#*:}"
  if out="$(notes ${prof:+--profile "$prof"} ptask "${row%%:*}" "${flag[@]}" done "$key" --proof "item:$slug" 2>&1)"; then
    echo "$slug: board row $key closed"
    return 0
  fi
  # Quiet only when the board reads and its open rows no longer hold this one (by id: lv-9 is not lv-90).
  [[ "$key" =~ ^[a-z]{2,4}-[0-9]+$ ]] && key="id:$key"
  if board="$(notes ${prof:+--profile "$prof"} ptask "${row%%:*}" "${flag[@]}" list 2>/dev/null)" && ! grep -qwF -- "$key" <<<"$board"; then
    return 0
  fi
  echo "agent-queue: $slug is done, but its board row ${row#*:} on ${row%%:*} may still be open (${out##*$'\n'}): notes ${prof:+--profile $prof }ptask ${row%%:*} ${flag[*]} done ${row#*:} --proof item:$slug" >&2
}

# check_tags <tags> -- die on a hold tag the queue could not read, so a gate is never silently
# open or shut: add and `set tags=` both check.
check_tags() {
  local tag why opts rest opt
  for tag in $1; do
    case "$tag" in
      at:*) [[ "$tag" =~ ^at:([0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T)?([01][0-9]|2[0-3]):[0-5][0-9]$ ]] ||
        die "a time tag is at:HH:MM or at:YYYY-MM-DDTHH:MM, not $tag" ;;
      pr:*) [[ "$tag" =~ ^pr:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+$ ]] || die "a PR tag is pr:<owner>/<repo>#<N>, not $tag" ;;
      nightly:*) [[ "$tag" =~ ^nightly:[A-Za-z0-9_.-]+$ ]] || die "a nightly tag is nightly:<repo>, the repo's name, not $tag" ;;
      ask:*) [[ "$tag" =~ ^ask:[A-Za-z0-9_-]+(=[^[:space:]]+)?$ ]] || die "an ask tag is ask:<id>[=<option>[+<option>]], not $tag"
        # An ask already cancelled, or answered by the judge or another option, can never release
        # the item: on 2026-11-07 can-we-get-cloud-vast-clarke-p3-live was queued behind an ask the
        # judge had answered at post, and upwork-p2..p5 behind one cancelled later.
        why="$(ask_pending "${tag#ask:}")"
        case "$why" in
          "" | pending) ;;
          "no such ask") die "$tag: no agent-ask has that id; post the ask first" ;;
          *) die "$tag: that ask can never release it ($why); post a new one with agent-ask post --kind gate, which the judge never answers" ;;
        esac
        # With no option named, every answer releases the item, a "stop" among them.
        # A name the ask does not offer can never match an answer, so the item would wait for good.
        # An answer matches on its first word (ask_pending), and a slug may itself contain a +.
        opts="$(ask_options "${tag#ask:}")"
        [ -n "$opts" ] || continue
        if [[ "$tag" != *=* ]]; then
          die "$tag: that ask offers ${opts//$'\n'/,}; name the answers that release the item: $tag=<option>[+<option>]"
        fi
        rest="+${tag#*=}+"; rest="${rest,,}"
        while IFS= read -r opt; do
          opt="${opt%% *}"; opt="${opt%[.,;:!]}"
          rest="${rest//"+${opt,,}+"/+}"
        done <<<"$opts"
        [ "$rest" = + ] || die "$tag: that ask offers ${opts//$'\n'/,}, and those are what an answer can match" ;;
      hold:*) hold_resource "${tag#hold:}" || die "a hold tag is hold:<resource>, an agent-hold name (letters, digits, . _ -), not $tag" ;;
    esac
  done
}

# requeue <slug> --hold <resource> -- put an item back in the queue behind an agent-hold resource,
# for a session that finds a resource it needs held by another (`agent-hold claim` said busy): it
# requeues and winds down, and the item starts again once the resource is free. Not a redo: the
# model did nothing wrong, so its lane run is dropped, not reported to model-lane, as a cancel is.
cmd_requeue() {
  local slug="${1:?usage: agent-queue requeue <slug> --hold <resource>}" res="" f tags
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --hold) res="${2:?--hold needs a resource}"; shift 2 ;;
      *) die "usage: agent-queue requeue <slug> --hold <resource>" ;;
    esac
  done
  [ -n "$res" ] || die "usage: agent-queue requeue <slug> --hold <resource>"
  hold_resource "$res" || die "not an agent-hold resource: $res (letters, digits, . _ -)"
  # A free resource would restart the item at once: the caller claims it instead.
  [ -n "$(hold_pending "$res")" ] || die "$res is not held: claim it (agent-hold claim $res) instead of requeueing"
  lock
  f="$(find_item "$slug")"; [ -n "$f" ] || die "nothing active with slug $slug"
  tags="$(fm_get "$f" tags)"
  case " $tags " in
    *" hold:$res "*) ;;
    *) header_set "$f" tags "${tags:+$tags }hold:$res"; item_event item-set "$f" --why "tags=${tags:+$tags }hold:$res" ;;
  esac
  header_del "$f" lane_run
  # The move runs under this lock, so no writer closes or moves the item between the edit and it.
  local AQ_LOCKED=1
  cmd_move "$slug" queued
}

# reopen <slug> [--to running|waiting] [--why <text>] -- put back an item a false close finished,
# such as a reap that read a live session as gone (ar-900, 2026-11-07: the shepherd had to move the
# file under the lock by hand). The latest done item with the slug goes to running (or waiting) with
# its session: and sessions: as they were, so the next reap reads it live again; status: and
# finished: go, note: says why and keeps the close's own note. Its board row, which the close
# un-started, is started again, after the queue lock is let go. Only a failed close is reopened: an ok
# one may have started the items after: it (start_next) and a cancel closed its session, so either is
# new work under the slug. A reap that parked a live item in waiting/ needs none: the next reap that
# lists its Claude moves it back to running.
cmd_reopen() {
  local usage="usage: agent-queue reopen <slug> [--to running|waiting] [--why text] [--unland <owner>/<repo>#<N>]"
  local slug="${1:?$usage}" to=running why="" unland="" f dest status note row prof flag=() refs=() oids=() kr=() ko=() i cp
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) to="${2:?--to needs a state}"; shift 2 ;;
      --why) why="${2:?--why needs a reason}"; shift 2 ;;
      --unland) unland="${2:?--unland needs <owner>/<repo>#<N>}"; shift 2 ;;
      *) die "$usage" ;;
    esac
  done
  case "$to" in running | waiting) ;; *) die "reopen goes to running or waiting, not $to" ;; esac
  case "$why" in *$'\n'*) die "--why is one line" ;; esac
  [ -z "$unland" ] || [[ "$unland" =~ ^[^/[:space:]]+/[^/#[:space:]]+#[0-9]+$ ]] || die "--unland takes <owner>/<repo>#<N>, not $unland"
  lock
  [ -z "$(find_item "$slug")" ] || die "$slug is still active: nothing to reopen"
  f="$(latest_done "$slug")"; [ -n "$f" ] || die "no finished item: $slug"
  status="$(fm_get "$f" status)" note="$(fm_get "$f" note)"
  if [ -n "$unland" ]; then
    # A false ok close (agent-land took a side PR from another repo, 2026-11-07): that PR comes
    # off the item, its merge commit with it, so the item's own PR lands on it as its first.
    [ "$status" = ok ] || die "--unland undoes an ok close, and $slug closed ${status:-with no status}"
    read -ra refs <<<"$(fm_get "$f" pr)"
    read -ra oids <<<"$(fm_get "$f" merged)"
    # The lists are kept in step (set clears merged: with pr:); one out of step names no commit by index.
    [ "${#oids[@]}" -eq 0 ] || [ "${#oids[@]}" -eq "${#refs[@]}" ] ||
      die "$slug records ${#refs[@]} pr: and ${#oids[@]} merged: entries, not in step: agent-queue set $slug pr=<refs> merged=<shas> first"
    for i in "${!refs[@]}"; do
      # A bare ref is the PR by its number, as once_done reads it.
      [ "${refs[i],,}" = "${unland,,}" ] || [ "${refs[i]}" = "${unland##*#}" ] || kr+=("${refs[i]}") ko+=("${oids[i]:-}")
    done
    [ "${#kr[@]}" -lt "${#refs[@]}" ] || die "$slug records pr:${refs[*]:-nothing}, not $unland"
    header_set "$f" pr "${kr[*]}"
    header_set "$f" merged "${ko[*]}"
    cp="$(fm_get "$f" closing_pr)"
    [ "${cp,,}" != "${unland,,}" ] || header_del "$f" closing_pr
  else
    [ "$status" = failed ] || die "$slug closed $status, not failed: that is new work under the slug (agent-queue add${status:+ --repeat})${status:+, or --unland <owner>/<repo>#<N> when it closed on a PR that was not its work}"
  fi
  header_del "$f" status finished
  [ "$to" = running ] || header_set "$f" waiting "$(now_utc)"
  header_set "$f" note "reopened from done ($status${unland:+, unlanded $unland}${note:+: $note})${why:+: $why}"
  dest="$(move_to "$f" "$to")" || die "could not move $f"
  item_event item-moved "$dest" --to "$to" --why "done ($status) -> $to: reopened${why:+: $why}"
  echo "$slug: done -> $to (reopened, was $status)"
  # The row, through notes, the rows' one writer (it leaves a row already started as it is), read as
  # fleet-dispatch's settle_row un-started it: no profile is notes' default, no lane is the agent lane.
  row="$(fm_get "$dest" row)" prof="$(fm_get "$dest" profile)"
  [ -n "$row" ] || return 0
  case "$(fm_get "$dest" lane)" in '' | agent) flag=(--agent) ;; esac
  exec 8>&-
  # An ok close closed the row too: it opens again, its proof off, before it is started. A row
  # that is not closed (the close never reached it) has nothing to reopen, so start still runs.
  if [ -n "$unland" ]; then
    notes ${prof:+--profile "$prof"} ptask "${row%%:*}" "${flag[@]}" reopen "${row#*:}" --why "closed on $unland, not its work${why:+: $why}" >/dev/null 2>&1 ||
      echo "agent-queue: $slug: board row ${row#*:} on ${row%%:*} was not reopened; if it is closed: notes ${prof:+--profile $prof }ptask ${row%%:*} ${flag[*]} reopen ${row#*:} --why <why>" >&2
  fi
  notes ${prof:+--profile "$prof"} ptask "${row%%:*}" "${flag[@]}" start "${row#*:}" >/dev/null 2>&1 ||
    die "$slug is $to, but its board row ${row#*:} on ${row%%:*} could not be started again: notes ${prof:+--profile $prof }ptask ${row%%:*} ${flag[*]} start ${row#*:}"
  mark_row "$dest" run
  echo "$slug: board row ${row#*:} started again"
}

# lane_outcome <lane_run> <from> <to> <status> [end] -- the model-lane run a dispatch start logged gets
# what became of it: done ok is ok, done failed is failed, and a started item put back in the queue
# is redo. Every close goes through move (agent-land, the reap, a hand close), so this is the one
# place outcomes are reported. A run whose end says nothing about the model (UNRATED_ENDS) files no
# outcome, on a close or a requeue. A cancel says nothing about the model; a model-lane error never
# fails the move.
lane_outcome() {
  local o=''
  [ -n "$1" ] || return 0
  case "$UNRATED_ENDS" in *" ${5:-none} "*) return 0 ;; esac
  case "$3:$4" in
    done:ok) o=ok ;;
    done:failed) o=failed ;;
    queued:) case "$2" in running | waiting | review) o=redo ;; esac ;;
  esac
  [ -z "$o" ] || model-lane outcome "$1" "$o" >/dev/null 2>&1 || echo "agent-queue: model-lane outcome $1 $o failed" >&2
}

# dependents <slug> -> the slugs of the queued items `after:` it, oldest first.
dependents() {
  local f
  while IFS= read -r f; do
    [ -n "$f" ] && [ "$(fm_get "$f" after)" = "$1" ] && fm_get "$f" slug
  done < <(items_in "$AQ_DIR/queued")
}

# phases_ticked <item file> -- every phase the item carries is already ticked (or deferred) in its
# plan: another session landed it, so starting it would do it twice (lesson 2026-11-05: closing p4
# started p5, which had landed). No plan, no phases, or a plan it cannot read is not ticked.
phases_ticked() {
  local plan phases
  plan="$(fm_get "$1" plan)" phases="$(fm_get "$1" phases)"
  [ -n "$plan" ] && [ -n "$phases" ] && [ -f "$plan" ] || return 1
  plan_phase_list "$plan" | jq -e --arg ph "$phases" '
    . as $all | ($ph | split(" ") | map(tonumber? // empty)) as $n
    | ($n | length) > 0 and all($n[]; ($all[. - 1].state // "open") != "open")' >/dev/null
}

# start_next <slug> -- the items `after:` this one start the moment it closes ok. Each takes the
# slot the closing session frees, so it waits for no dispatch pass and none of its load gates: a
# plan's next phase never sits behind fresh work. A dispatch hold (agent-hold) still holds it. One
# whose plan phases are already ticked closes ok instead, which releases the item after it in turn.
start_next() {
  local f s next=() landed=() self
  self="$(realpath "${BASH_SOURCE[0]}")"
  while IFS= read -r f; do
    [ -n "$f" ] && [ "$(fm_get "$f" after)" = "$1" ] || continue
    if phases_ticked "$f"; then landed+=("$(fm_get "$f" slug)")
    elif [ -z "$(hold_reason "$f")" ]; then next+=("$(fm_get "$f" slug)")
    fi
  done < <(items_in "$AQ_DIR/queued")
  [ $((${#next[@]} + ${#landed[@]})) -gt 0 ] || return 0
  # The starter writes these items back through this script: free the lock, and keep the fd out of tmux.
  exec 8>&-
  for s in "${landed[@]}"; do
    "$self" set "$s" "note=its plan phases were ticked before $1 closed" >/dev/null
    echo "$s: its plan phases are already ticked, so it closes instead of starting"
    "$self" move "$s" done --status ok
  done
  [ ${#next[@]} -gt 0 ] || return 0
  if ! agent-hold check dispatch >/dev/null 2>&1; then
    echo "agent-queue: dispatch is held, so ${next[*]} stays queued for the next dispatch pass" >&2
    return 0
  fi
  for s in "${next[@]}"; do
    fleet-dispatch start --item "$s" ||
      echo "agent-queue: $s could not start now, so it stays queued for the next dispatch pass" >&2
  done
  return 0
}

cmd_stats() {
  local json="" flow=false since
  since="$(date -d '7 days ago' +%F)"
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --flow) flow=true; shift ;;  # only day-log reads it, and the hub polls stats
      --since) since="${2:?}"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  local stats FILES=()
  lock_read
  # shellcheck disable=SC2086
  list_files $ACTIVE done --since "$since"
  stats="$(items_json . "${FILES[@]}" | jq -c --arg since "$since" --argjson flow "$flow" '
    def mins($a; $b): if $a and $b then ((($b | fromdateiso8601) - ($a | fromdateiso8601)) / 60 | floor) else empty end;
    def median: sort | if length == 0 then null else .[length / 2 | floor] end;
    def p90: sort | if length == 0 then null else .[(length * 0.9 | ceil) - 1] end;
    def age: ((now - (. | fromdateiso8601)) / 60 | floor);
    # Wait runs from ready (ITEM_JQ), so a deliberate hold is not read as dispatch latency. A
    # `--running` or plan item starts the minute it is added; counting its 0 hid every real wait.
    def waits: [.[] | mins(.ready; .started)];
    def waited: waits | map(select(. > 0));
    # A hold_reason line by its first word: "after x", "night (..)", "at:HH:MM", "pr:o/r#N not merged",
    # "nightly:repo (..)".
    def hold_kind: split(" ")[0] | split(":")[0];
    def source: (.from // "human") | split(":")[0];
    def count_by(f): group_by(f) | map({key: (.[0] | f), value: length}) | from_entries;
    def has_pr: (.pr // "") != "";
    def to_pr: [.[] | select(has_pr) | mins(.queued; .finished)] | median;
    def outcomes: {done: length, ok: map(select(.status == "ok")) | length,
      failed: map(select(.status == "failed")) | length, cancelled: map(select(.status == "cancelled")) | length,
      prs: map(select(has_pr)) | length, wait_minutes_median: (waited | median),
      to_pr_minutes_median: to_pr};
    def group(f): group_by(f) | map({key: (.[0] | f), value: outcomes}) | from_entries;
    def spread: {n: length, p50: median, p90: p90};
    def stage($name; f): [.[] | select((f // "") != "") | {day: (f | fromdateiso8601 | strflocaltime("%F")), stage: $name, item: .}];
    def at($name): map(select(.stage == $name) | .item);
    (map(select(.state == "done"))) as $done
    | (map(select(.state == "queued"))) as $queued
    | ($queued | map(select(.hold == null) | {slug, project, minutes: (.queued | age)}) | sort_by(-.minutes)) as $runnable
    | {since: $since,
       active: (map(select(.state != "done")) | count_by(.state)),
       done: ($done | count_by(.status // "unknown")),
       wait_minutes_median: (waited | median),
       wait_minutes_p90: (waited | p90),
       started_at_once: (waits | map(select(. == 0)) | length),
       sitting: {queued: ($queued | length), runnable: ($runnable | length),
         held: ($queued | map(select(.hold)) | length),
         held_by: ($queued | map(select(.hold)) | count_by(.hold | hold_kind)),
         runnable_age_minutes_median: ($runnable | map(.minutes) | median),
         oldest_runnable: $runnable[:3]},
       added_per_day: (map(select((.queued // "")[:10] >= $since)) | count_by(.queued[:10])),
       # Flow over the last hours, for throughput and a drain trend: added by queued, started by
       # started, done by finished (failed is the part of done that failed).
       recent: (. as $all | [1, 6, 24] | map(. as $h | (now - $h * 3600) as $t
         | def since(f): map(select((f // "") != "" and (f | fromdateiso8601) >= $t));
           ($done | since(.finished)) as $fin
         | {("done_\($h)h"): ($fin | length), ("failed_\($h)h"): ($fin | map(select(.status == "failed")) | length),
            ("started_\($h)h"): ($all | since(.started) | length),
            ("added_\($h)h"): ($all | since(.queued) | length)}) | add
         # Finished ok since local midnight, the day day-log keeps.
         | . + {done_today: ($done | map(select(.status == "ok" and (.finished // "") != ""
             and (.finished | fromdateiso8601 | strflocaltime("%F")) == (now | strflocaltime("%F")))) | length)}),
       run_minutes_median: ([$done[] | mins(.started; .finished)] | median),
       to_pr_minutes_median: ($done | to_pr),
       per_day: ($done | count_by((.finished // "")[:10])),
       # Per local day, the day day-log keeps: each item counts on the day it reached that stage.
       # .waiting is the last move to waiting, so an item that waited twice counts on the later day.
       flow: (if $flow | not then null else (stage("queued"; .queued) + stage("started"; .started) + stage("waiting"; .waiting)
           + stage("review"; .review) + ($done | stage("done"; .finished)))
         | map(select(.day >= $since)) | group_by(.day)
         | map(at("done") as $fin | at("started") as $went | {key: .[0].day, value: {
             queued: (at("queued") | length), started: ($went | length), waiting: (at("waiting") | length),
             review: (at("review") | length), done: ($fin | length), ok: ($fin | map(select(.status == "ok")) | length),
             failed: ($fin | map(select(.status == "failed")) | length),
             cancelled: ($fin | map(select(.status == "cancelled")) | length),
             lead_minutes: ([$fin[] | mins(.queued; .finished)] | spread),
             wait_minutes: ($went | waited | spread),
             run_minutes: ([$fin[] | mins(.started; .finished)] | spread)}})
         | from_entries end),
       by_project: ($done | group(.project)),
       by_source: ($done | group(source)),
       by_end: ($done | map(select((.end_reason // "") != "")) | count_by(.end_reason)),
       done_by_tag: ([$done[] | (.tags // "" | split(" ") | map(select(. != ""))[]) as $t | {t: $t}] | count_by(.t))}')"
  if [ -n "$json" ]; then printf '%s\n' "$stats"; return 0; fi
  jq -r 'def dur: if . == null then "-" elif . >= 120 then "\(. / 60 | floor)h" else "\(.)m" end;
    def pairs: to_entries | map("\(.key) \(.value)") | join(", ");
    "since \(.since)",
    "active:  \(.active | pairs | if . == "" then "none" else . end)",
    "done:    \(.done | pairs | if . == "" then "none" else . end)",
    "wait:    median \(.wait_minutes_median // "-") min, p90 \(.wait_minutes_p90 // "-") min from ready to started, \(.started_at_once) started at once and not counted",
    (.sitting | "sitting: \(.runnable) can start, oldest \(.oldest_runnable[0].minutes | dur)"
      + (if .runnable > 0 then " (\(.oldest_runnable[0].slug)), median \(.runnable_age_minutes_median | dur)" else "" end)
      + "; \(.held) held" + (if .held > 0 then " (\(.held_by | pairs))" else "" end)),
    "added:   \(.added_per_day | pairs)",
    "run:     median \(.run_minutes_median // "-") min from started to finished",
    "to PR:   median \(.to_pr_minutes_median // "-") min from queued to finished with a PR",
    "per day: \(.per_day | to_entries | map("\(.key) \(.value)") | join(", "))",
    "project: \(.by_project | to_entries | map("\(.key) \(.value.done) (\(.value.prs) PR)") | join(", "))",
    "source:  \(.by_source | to_entries | map("\(.key) \(.value.done) (\(.value.prs) PR)") | join(", "))",
    (if .by_end == {} then empty else "ends:    \(.by_end | pairs)" end)' <<<"$stats"
}

[[ "${BASH_SOURCE[0]}" != "$0" ]] && return 0

# A session on a fleet worker writes the store on the workstation (AGENT_STATE_HOST, fleet-hosts.sh).
if [ -n "${AGENT_STATE_HOST:-}" ]; then
  # shellcheck source=../lib/fleet-hosts.sh
  . "${FLEET_HOSTS_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/fleet-hosts.sh}"
  state_forward agent-queue "add retask attribute credit-of" "$@"
fi
command -v jq >/dev/null || die "jq not on PATH"
case "${1:-}" in
  add | list | next | show | mine | claim | cancel | bump | set | retask | attribute | move | requeue | reopen | stats | admission) v="$1"; shift; "cmd_$v" "$@" ;;
  credit-of) shift; cmd_credit_of "$@" ;;
  -h | --help | '') sed -n '2,/^set -uo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
  *) die "unknown verb: $1 (try --help)" ;;
esac
