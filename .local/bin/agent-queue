#!/usr/bin/env bash
# agent-queue - the one intake for agent work, and the only writer of its store.
#
#   add [--project p] [--mode oneshot|plan] [--priority urgent|high|normal|low] [--tags "t1 t2"]
#       [--weight heavy|light] [--after slug|row-id[,...]] [--from human|session|shepherd|canary|trainee|research:<facet>|auto:<filer>|item:<slug>|ask:<id>|board:<project>:<key>] [--agent claude] [--slug s] [--title t]
#       [--row <code>-<N>] [--epic <code>-<N>] [--want <channel>] [--running [--session s]] [--repeat] [task...]    the task from args, or stdin when there are none
#       --running with no --from or --want is from item:<$AGENT_QUEUE_ITEM> in a queue item's session, from session in any
#       other Claude session, and from human only at a terminal; a hand session records the human's own want with --want human.
#       A headless Claude run (`claude -p`, CLAUDE_CODE_ENTRYPOINT sdk-*) is never the human: its add goes to the board and
#       never starts at add, and its --want is refused (headless).
#       --want names the channel a human's want came in by (`notes ptask add --want`): its story row gets #requested from
#       the notes writer. Without it the row carries no stamp, as a session's own add does not.
#       --tags interrupt puts #interrupt on its story row (or an open twin), so a locked sprint takes it (notes' interrupt
#       lane, window.rs): for a bounded machine filer whose row must start under any sprint (research-pick, one a night).
#       --priority defaults to high only for an add by hand: one from a session ($CLAUDE_CODE_SESSION_ID or
#       $AGENT_QUEUE_ITEM set) names it, except --running, --want, --dry-run and --check. A session's
#       --plan queues at high at most: urgent stays for the human's own add, a red, and dispatch's promote.
#       The human's own add that links a row (--row, the title's row) with an explicit --priority retags that row.
#       --after holds the item until every slug it names closed ok: a comma or space list, and it repeats.
#       A queue item's session adding a task that says land, from an item with a PR recorded, with no --after is gated on that item's own live `after:` blockers (landing_after).
#       A plan phase or validate item (stack_dependent) after a slug whose item is live with an open PR (open_pr:, set by agent-land before its checks, or a --pr-only run's pr:) does not hold: it is stacked on it
#       (hold_for HOLD_STACK, `stacked_on` in list --json; gate after/<row-id> clears with stack: <slug>), fleet-dispatch starts it in a worktree cut from that PR's
#       head, and agent-land refuses it (exit 4) until that slug closed ok. A dependency closed unmerged stays a dead hold. Any other --after holds until that slug closed ok, open PR or not.
#       --row names the open agent board row this item works on: see link_row. With no --row,
#       --epic or --want, a title whose subject is one open row id works that row too (named_row).
#       Any other item not from the board files its own story row: see file_story. A slug that already
#       finished ok is refused unless --repeat says this is new work under it: see finished_ok.
#       An add over the cap (AGENT_QUEUE_CAP runnable items) is not queued: its board row is left un-started, brief and all (exit AQ_EX_HELD); see admit.
#   add --plan <plan.md> [--dry-run | --check] [--project p] [--priority p] [--tags t] [--weight w] [--after slug[,slug...]] [--slug prefix] [--repeat]
#       one oneshot item per unchecked `## Phases` line, each after the one before, unless its line says
#       `(independent)` (after --after alone) or `(after N; needs <result>)` (after phase N's item; `(after N, M; needs ...)` after several), where `needs` names the output the phase consumes: a missing `needs`, a shared-file reason (`edits`, `same file`, `conflicts`) or a marker that does not parse is refused; `(with N)` joins phase N's item; `(at YYYY-MM-DD HH:MM)` holds that phase alone until then (its at: tag) at no more than high priority; an `(independent)` marker may carry a note, `(independent; why)`; `--check` only reads and validates the markers. A phase that says `takes <row-id>` (or `takes board row <row-id>`) is filed at the higher of the plan's priority and that row's, and agent-land closes the row when the phase merges; its newly filed story row carries `#takes/<id>` (docs/agent-queue.md). A line opening `P<N>` is phase N, else its place counts; a `1b.` line is a sub-phase: it takes no place and is not queued
#   list [--json [--points]] [--state queued|running|waiting|review|done|active|all] [--date YYYY-MM-DD | --since YYYY-MM-DD|Nd|N]
#       list joins each item's board row (`notes board --json`, one read of the whole board): the text list ends in a
#       `<band>/<points>` column (`m/5`, the band alone when the row is unscored, `-` with none); --json joins
#       only with --points, which adds `points` and the row's current `size`. Ordering items that work a row reads the
#       board once more for those rows' priority (row_prios, ar-3011); done items and rowless ones pay no board read
#   next [--json] | show <slug> [--json [--points]] (the board join list --points does) | cancel <slug> [--why <text>] [--ask <id>] | bump <slug> <priority>
#       cancel records cancelled_by: (the session id, else the item slug the caller works) and cancel_why:;
#       --why is required from a session or script ($CLAUDE_CODE_SESSION_ID or $AGENT_QUEUE_ITEM set)
#       work the human asked for (from: human, or a #requested row) cancels, returns with --drop, or returns with no
#       board row, from a session or script only with --ask <id>, an answered ask naming the item; the ask joins cancel_why:
#       cancel of an item whose after: closed dead also records cancel_cause: (that item's own cause, else who closed it and why)
#       cancel of a slug with no file but still active in the chain record closes it in the record
#       bump to urgent never lifts an after: hold; it names the hold and the `set <slug> after=` that does
#       bump (and set priority=) of an item with a board row retags the row, which the order reads (ar-3011)
#   return <slug> --why <text> [--ask <id>] [--drop]    send an item back to its board: closed cancelled with end_reason: returned, its row un-started
#       (--drop: dropped), and every queued item after: it (transitively) goes back with it, cancel_cause: "returned with <slug>", never left dead;
#       the chain record's item-cancelled event says "returned: <why>"; exit 1 when a row stayed started.
#       Before a row is un-started, the holds its item still waits on are written onto it as gate tags (return_gates);
#       an after: slug with no board row refuses the return
#   gate [--json] (--all | <tag>...)   each board gate tag clear, pending (why) or dead; exit 3 unless all clear.
#       Board forms: after/<row-id> at/[<YYYY-MM-DD>/]<HHMM> rbw/<folder>/<name> ask/<id>[/<option>...] pr/<owner>/<repo>/<N>
#       hold/<resource> nightly/<repo>[/<YYYY-MM-DD>]; any other tag is "none". --all: every gate tag on the board's open rows
#       (fleet-dispatch, once a pass), and a clear line naming the row (`row` in --json) for each row a held hold/ grants
#       by its row, epic or plan id (agent-hold grant), which the item it is promoted to passes the same way (grant_names)
#   claim <slug> [--sid id]    record a Claude session as working this item (default $CLAUDE_CODE_SESSION_ID; that own claim starts a queued item)
#   mine [--session s | --sid id] [--newest]  the slug of the running, waiting or review item this session records;
#       exit 2 when more than one does, unless --newest: a running one before the rest, then the one whose file changed last
#   set <slug> <key=value>... | move <slug> <state> [--status ok|failed|cancelled] [--end <reason>] [--cause <cause>] [--why <text>] [--ask <id>] [--if <state>]
#       set title= retitles an item, a done one too, on one line as add --title writes it
#       --why and --ask are cancel's: with --status cancelled they record and guard as cancel does, and are refused on any other close
#       move <slug> running of a queued item is refused while its hold is pending (after:, a tag gate), as add --running --after is
#       --end records why a run ended (end_reason:), one of END_REASONS (lib/end-reasons.sh). An
#       UNRATED_ENDS one is not the model's doing, so the run's model-lane outcome is filed unrated, that end its cause.
#       --cause (a requeue) tells the run's outcome why it went back, one of MOVE_CAUSES (lib/end-reasons.sh); an
#       UNRATED_CAUSES one (a green PR handed to a lander, a lost host) files it unrated. Every outcome carries a cause.
#   backfill-briefs [--dry-run | --check]    each open agent row with no brief gets the brief of the item that worked it, and an open
#       item with no row (not canary or trainee) gets a story row with its brief: the row is the one record of a brief
#   retask <slug> [task...]    replace a queued item's task (the brief its session gets) and its board row's brief, from args or stdin
#   attribute <slug> < changed-paths    credit the item to the registry project whose path owns most of its PR
#   credit-of <project> < changed-paths  print what attribute would record ("<winner>\t<touches>"), writing nothing
#   requeue <slug> --hold <resource> [--class c] | --ask <id>   a started item back to its board row, gated on that agent-hold
#       or ask (#hold/<res>, #ask/<id>): the item closes returned, and dispatch promotes the row once the gate clears;
#       an item with no row (hand-queued) gets a story row filed first (story_row_for), refused only when none can be
#   handoff <slug> --note <file> [--dir <checkout>]   a running item to a fresh session with its work pushed: salvage: (or its pr:),
#       handoff: <note>, back to queued with end_reason: handoff (unrated), AGENT_HANDOFF_MAX (2) per item; see cmd_handoff
#   start <slug>   start a queued item's session now, through add's start guards (a low one, a desk wait or the dispatch hold keep it queued)
#   ask-holds [<id>]   `<slug or row id><TAB><ask id><TAB><releasing options>` per active item, and per open board row gated
#       #ask/<id>, held on an ask (that ask only, given one)
#   reopen <slug> [--to running|waiting] [--why text] [--unland <owner>/<repo>#<N>]   a falsely-done item back to running (or waiting),
#       its row started again. A failed close reopens as it is; an ok close only with --unland naming the PR it
#       closed on that was not its work, which comes off pr:, merged: and closing_pr:, and its row reopens through
#       `notes ptask reopen`. Items `after:` it that the ok close released stay started.
#   stats [--json] [--flow] [--since YYYY-MM-DD|Nd|N]    Nd and N: that many days ago, a local day
#   admission [--json]    the runnable items, the cap an add is admitted under, and the adds held in 7 days
#   mix [--json]          each class of service: share, runnable, started in its window, and the starved ones
#   lock-miss [--hours H] [--max N]   the queue lock timeouts in the last H hours (1) against N (3); exit 1 over it
# Starts at add (fleet-dispatch start --item, see start_at_add): an urgent or high plan item, and, from
# the human at hand (human_at_hand), an urgent oneshot and each queued phase of an urgent or high --plan.
# The queue holds no gated work: an add that waits on a hold or an after: item not done is filed as its
# board row carrying the gate, and exits AQ_EX_HELD (cmd_add). An item that closes ok pulls the rows
# gated #after/<its row> at once (pull_after, fleet-dispatch pull-after). A low one, or a machine
# filer's, waits for a dispatch pass, which starts the queue in priority order. AGENT_QUEUE_START=0 only queues, a pull included.
# Weight: heavy holds two of fleet-dispatch's run units, light one; see weight_of.
# A partial: yes item stays open until agent-land without --partial finishes it; if its session ends first, reap requeues it once for that.
# Holds: `after <slug>...` (until every slug named closed ok), and the tags at:HH:MM (that time of day), at:YYYY-MM-DDTHH:MM (that moment)
# pr:<owner>/<repo>#<N> (until that PR merges; closed unmerged, it says it never releases) and nightly:<repo> (until the scheduled runs of that repo on its at: date, else today,
# have finished; see nightly_pending) and ask:<id>[=<option>[+<option>]] (until that agent-ask is answered, by the human, the judge or an agent,
# with one of those options when named, or in free text; see ask_pending) and hold:<resource> (while agent-hold holds it; see
# hold_pending) and rbw:<folder>/<name> (until rbw lists that entry; see rbw_pending). A start on a later day is the dated form, never a held session.
# A queued item whose body's last Blocked heading has no Unblocked one after it holds too (ITEM_JQ).
#
# One file per item under $AGENT_QUEUE_DIR/<state>/. Design: ~/.config/agentctl/QUEUE.md.
set -uo pipefail

AQ_DIR="${AGENT_QUEUE_DIR:-$HOME/.agent/queue}"
# This script's own directory, resolved once: every call paid two forks per lib and sibling it
# found from here, about 12 of its 80 ms startup, and fleet-dispatch's tests call it ~70 times
# each (ar-3036).
AQ_BIN="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
# The registry's resolver: this tree's project-name.sh (PROJECT_NAME_LIB when the script runs
# from a copy, as in the tests); AGENT_QUEUE_PROJECT_MAP points it at another map.
# shellcheck source=../../.config/shared-hooks/project-name.sh
. "${PROJECT_NAME_LIB:-$AQ_BIN/../../.config/shared-hooks/project-name.sh}"
AQ_MAP="${AGENT_QUEUE_PROJECT_MAP:-$(project_map_file)}"
PROJECT_MAP_FILE="$AQ_MAP"
# shellcheck source=../lib/chain-event.sh
. "${CHAIN_EVENT_LIB:-$AQ_BIN/../lib/chain-event.sh}"
# The one reader of a plan's `## Phases` checklist and `epic:` line, shared with fleet-sessions.
# shellcheck source=../lib/plan-phases.sh
. "${PLAN_PHASES_LIB:-$AQ_BIN/../lib/plan-phases.sh}"
# shellcheck source=../lib/machine-mode.sh
. "${MACHINE_MODE_LIB:-$AQ_BIN/../lib/machine-mode.sh}"
# shellcheck source=../lib/end-reasons.sh
. "$AQ_BIN/../lib/end-reasons.sh"
# shellcheck source=../lib/dispatch-wake.sh
. "$AQ_BIN/../lib/dispatch-wake.sh"
# so_pr_view: the one forge rule pr_state reads a pr: hold's PR by.
# shellcheck source=../lib/session-outcomes.sh
. "$AQ_BIN/../lib/session-outcomes.sh"
# A `pr:<owner>/<repo>#<N>` item waits for that PR to merge; its state is cached here.
AQ_PR_CACHE="${AGENT_QUEUE_PR_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/agent-queue/pr}"
AQ_PR_TTL="${AGENT_QUEUE_PR_TTL:-120}"
# A `nightly:<repo>` item waits on the scheduled-run facts schedules-sync writes, through its `pending` verb.
AQ_SCHEDULES="$AQ_BIN/schedules-sync"
# An `ask:<id>[=<option>]` item waits on that agent-ask's answer, read from its file here.
AQ_ASKS="${AGENT_ASK_ROOT:-$HOME/.agent/asks}"
# A `hold:<resource>` item waits while this tree's agent-hold says that resource is held.
AQ_HOLD="$AQ_BIN/agent-hold"
# Of the items waiting on one resource, the best `desk:<class>` (agent-hold classes) starts once it
# is free, the rest stay held behind it (desk_wait); a desk:auth item waits while this says away.
AQ_PRESENCE="${AGENT_QUEUE_PRESENCE:-fleet-presence}"
# Minutes a just-started desk waiter keeps the free resource from the next one while its session
# boots and claims it. The claim is the event; this bounds a session that never claims, so it
# cannot hold the line for good.
AQ_DESK_START_MIN=10
# An `rbw:<folder>/<name>` item waits until this rbw lists that Bitwarden entry.
AQ_RBW="${AGENT_QUEUE_RBW:-rbw}"
AQ_RBW_TIMEOUT_S=5
AQ_ASK="$AQ_BIN/agent-ask"
# waiting: its session needs the human (a plan, a dialog, an ask). review: its session ended or
# stopped at an open PR, which reap closes on the merge. They are two states so "needs you" counts
# only the first.
ACTIVE="queued running waiting review"

die() { echo "agent-queue: $*" >&2; exit 1; }
now_utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }
# The caller's own session as an item records it: <tmux server>:<session>, the shape reap reads.
own_session() {
  [ -n "${TMUX:-}" ] || return 1
  local name
  name="$(tmux display-message -p '#{session_name}' 2>/dev/null)"
  [ -n "$name" ] || return 1
  printf '%s:%s\n' "$(basename "${TMUX%%,*}")" "$name"
}
# The Claude session id of the caller, which every reader of a session (outcomes, fleet-bench,
# day-log, Langfuse) keys on. Claude Code exports it to every command it runs.
claude_sid() { [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && printf '%s\n' "$CLAUDE_CODE_SESSION_ID"; }
# The caller's Claude account as fleet-dispatch start records it (the config dir's basename, `main`
# when unset). fleet-bench sources puts a landed item on a source by its `account:`, and a hand
# session's outcome row, the other way to one, lands only when the session ends.
claude_account() { basename "${CLAUDE_CONFIG_DIR:-main}"; }
# The caller's worktree session (`<repo>-agent-N`) on any world, else nothing, so a hand start on
# hub or work records itself as it does on lab. An item's session is what cancel and the reap act
# on, so a checkout session (hub:dotfiles, hub:tools: one session, many conversations) never
# lends itself to one, declared or not.
agent_session() {
  local own
  own="$(own_session)" || return 1
  case "${own#*:}" in *-agent-[0-9]*) ;; *) return 1 ;; esac
  printf '%s\n' "$own"
}
# qualified <session> -- `session:` is always <server>:<session>; a bare name is on the agent world.
qualified() {
  local world
  case "$1" in '' | *:*) printf '%s\n' "$1"; return ;; esac
  world="$(tmux-world agents)"
  [ -n "$world" ] || die "no world declares @agents: give the session as <server>:$1"
  printf '%s:%s\n' "$world" "$1"
}
# The caller's own window id (@N), which cancel closes: a hand-started item runs in a window of
# a session it did not make, so the session is never its to close.
own_window() {
  [ -n "${TMUX:-}" ] || return 1
  tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#{window_id}' 2>/dev/null
}
# hand_start -- "<session>\t<window>" a session that starts an item itself (add --running, its own
# claim) records on it; nothing outside a worktree session.
hand_start() {
  local session window
  session="$(agent_session)" || return 0
  window="$(own_window)" || window=''
  printf '%s\t%s\n' "$session" "$window"
}
# The one closer, beside this script (TMUX_CLOSE when the script runs from a copy, as in tests).
TMUX_CLOSE="${TMUX_CLOSE:-$AQ_BIN/tmux-close}"

# --- the file format ---
# `key: value` lines, a `---` line, then the task as typed.
fm_get() { # file key
  awk -v k="$2" '$0 == "---" { exit }
    index($0, k ":") == 1 { v = substr($0, length(k) + 2); sub(/^ +/, "", v); print v; exit }' 2>/dev/null <"$1"
}
# The file is read by redirect, never as an awk operand: awk reads stdin for an empty operand, and a
# caller whose item lookup came back empty hung on the tool shell's open stdin (ar-3455).
fm_body() { awk 'f { print } $0 == "---" { f = 1 }' 2>/dev/null <"$1"; }
# one_line <text> -> the text on one line, each run of newlines, tabs or spaces as one space,
# trimmed: a title as add --title and set title= write it.
one_line() { printf '%s' "$1" | tr -s '\n\t' '  ' | sed 's/^ *//; s/ *$//'; }

# item_row <file> -> the "<board>:<key>" of the row the item works, as ITEM_JQ reads `row`: its
# `row:`, else the board row it was promoted from (`from: board:`), else nothing. Every reader of an
# item file's row goes through it, so a `--from board:` item added by hand marks and closes its row
# like a `row:` one.
item_row() {
  local row
  row="$(fm_get "$1" row)"
  [ -n "$row" ] || case "$(fm_get "$1" from)" in board:*) row="$(fm_get "$1" from)" row="${row#board:}" ;; esac
  printf '%s' "$row"
}

# item_event <action> <file> [record flags...] -> the item's write on the chain log (stage queue),
# naming the item, its project, its row's key (item_row), its PR and merge commit.
item_event() {
  local action=$1 f=$2 row title to="" i
  shift 2
  # One wake for the fleet-dispatch kick (dispatch_wake) on the two transitions an event should act on:
  # an item queued (an add) and an item closed (its slot is free). An item started, set or claimed
  # is no event, so a kick's own starts never wake the next kick.
  local -a rec=("$@")
  for ((i = 0; i + 1 < ${#rec[@]}; i++)); do [ "${rec[i]}" = --to ] && to=${rec[i + 1]}; done
  case "$action:$to" in item-added:queued | *:done) dispatch_wake "$action $(fm_get "$f" slug)" ;; esac
  row="$(item_row "$f")" title="$(fm_get "$f" title)"
  chain_event queue "$action" "$(fm_get "$f" project)" "${title:-$(fm_body "$f" | awk 'NR==1')}" \
    --item "$(fm_get "$f" slug)" --id "${row:+${row#*:}}" --pr "$(fm_get "$f" pr)" \
    --sha "$(fm_get "$f" merged)" "$@"
}

slugify() {
  printf '%s' "${1%%$'\n'*}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | tr -s '-' \
    | sed 's/^-//; s/-$//' | cut -c1-40 | sed 's/-$//'
}

# urgent|high|normal|low, as on the sheets (priority.md). A bare add by hand is high: the human's own, so it is not demoted.
prio_rank() { case "$1" in urgent) echo 0 ;; high) echo 1 ;; normal) echo 2 ;; low) echo 3 ;; *) return 1 ;; esac; }

# Mutations take one lock, so the web page, the shepherd and the dispatcher never interleave.
# The wait is a timeout guard, not a delay: a writer holds it for milliseconds.
# AQ_HELD names the lock this process holds (excl or shared), so a read under it takes no second one.
lock() {
  mkdir -p "$AQ_DIR" || die "cannot create $AQ_DIR"
  take_lock
  AQ_HELD=excl
}
# Reads share the lock, so a list never sees an item a writer is moving between states.
lock_read() {
  [ -d "$AQ_DIR" ] || return 0
  take_lock -s
  AQ_HELD=shared
}
# unlock -- let the lock go. A shared one is let go once the item files are read (items_json,
# item_json): what a listing derives from them (holds, order, sizes) asks gh, rbw, asks and notes for
# seconds, and a writer gives up after LOCK_WAIT (ar-2427).
unlock() {
  exec 8>&-
  AQ_HELD=""
}
unlock_read() { [ "${AQ_HELD-}" != shared ] || unlock; }
# take_lock [-s]: every taker passes through .gate and closes it once in, all within one
# LOCK_WAIT (10s by default) deadline. A waiting writer holds the gate, so a new read queues behind it and the writer waits
# only for the reads already in. Why: flock lets a shared taker in while an exclusive one waits, so
# overlapping lists (agent-web, hub, panel, dispatch, about 16 at once under load) held .lock
# shared without a gap and every write timed out (2026-11-12). As with any writer-first lock, a
# holder must not wait on a child that takes the lock again. A reader holds .lock only while it lists
# and reads the files (snap_json), since a writer's wait is the sum of the reads already in.
# A timeout exits LOCK_BUSY, not 1: nothing was written, so a caller that must record (agent-land)
# can tell it from a refusal and take the lock again. Each timeout appends one lock_miss line.
LOCK_BUSY=75
LOCK_WAIT="${AGENT_QUEUE_LOCK_WAIT:-10}"
AQ_LOCK_MISS_LOG="$AQ_DIR/lock-miss.jsonl"
take_lock() {
  [[ "$LOCK_WAIT" =~ ^[1-9][0-9]*$ ]] || die "AGENT_QUEUE_LOCK_WAIT is whole seconds, not '$LOCK_WAIT'"
  local gate end=$((SECONDS + LOCK_WAIT))
  exec {gate}> "$AQ_DIR/.gate" 8> "$AQ_DIR/.lock" || die "cannot open the queue lock in $AQ_DIR"
  flock -w "$LOCK_WAIT" "$gate" && flock "$@" -w "$((end - SECONDS > 1 ? end - SECONDS : 1))" 8 || {
    exec {gate}>&- 8>&-
    lock_miss "${1:-}"
    echo "agent-queue: the queue is locked by another writer (who held it: $AQ_LOCK_MISS_LOG)" >&2
    exit "$LOCK_BUSY"
  }
  exec {gate}>&-
}
# lock_miss [-s]: one JSON line naming this taker, its caller, the kernel's locks on .gate and
# .lock (holds or waits, READ or WRITE) and every process with either open: the holder, the
# waiters, and any child a holder started, since fd 8 is inherited. Called with both fds closed,
# so the line never lists the taker itself. Best effort: it never changes the exit. Why: 108
# dispatch starts and two runners timed out on the lock with nothing naming the holder (ar-3025).
# The log moves to .1 past 1 MB, so a timeout storm cannot grow it without bound.
lock_miss() {
  local f s line path pids p
  [ ! -f "$AQ_LOCK_MISS_LOG" ] || [ "$(stat -c %s "$AQ_LOCK_MISS_LOG")" -lt 1048576 ] ||
    mv -f "$AQ_LOCK_MISS_LOG" "$AQ_LOCK_MISS_LOG.1"
  {
    for f in .gate .lock; do
      s=$(stat -c %i "$AQ_DIR/$f") || continue
      # /proc/locks names a file <maj:min:inode>, matched on the inode alone: on btrfs it gives the
      # superblock's device (00:24) where stat gives the subvolume's (00:3b), so a full match found
      # no lock at all and every line read "locks":[] (ar-5560). The pid is the holder's or waiter's.
      awk -v f="$f" -v ino="$s" '{ o = ($2 == "->"); n = split($(6 + o), id, ":") } n == 3 && id[3] == ino {
        printf "lock\t%s %s %s %s\n", f, (o ? "waits" : "holds"), $(4 + o), $(5 + o) }' /proc/locks
    done
    # One fuser scan for both files: it prints "<path>: <pid>..." per file in use, the path on
    # stderr and the pids on stdout, so the merged stream pairs them. Split at the last colon: the
    # path may hold spaces, a pid never holds a colon.
    fuser "$AQ_DIR/.gate" "$AQ_DIR/.lock" 2>&1 | while IFS= read -r line; do
      path=${line%:*} pids=${line##*:} && f=${path##*/}
      for p in $pids; do
        p=${p%%[!0-9]*}
        [ -n "$p" ] || continue
        printf 'proc\t%s\t%s\t%s\n' "$f" "$p" "$(tr '\0' ' ' < "/proc/$p/cmdline" | cut -c1-300)"
      done
    done
  } 2>/dev/null | jq -Rnc --arg ts "$(date -u -Is)" --arg mode "$([ "$1" = -s ] && echo shared || echo exclusive)" \
    --argjson wait "$LOCK_WAIT" --arg cmd "$(tr '\0' ' ' < /proc/$$/cmdline | cut -c1-300)" \
    --arg caller "$(tr '\0' ' ' < /proc/$PPID/cmdline | cut -c1-300)" \
    '[inputs | split("\t")] | {ts: $ts, mode: $mode, wait: $wait, cmd: $cmd, caller: $caller,
      locks: map(select(.[0] == "lock") | .[1]),
      procs: map(select(.[0] == "proc") | {file: .[1], pid: (.[2] | tonumber), cmd: .[3]})}' \
    >> "$AQ_LOCK_MISS_LOG" 2>/dev/null || true
}

# lock-miss [--hours H] [--max N] -> one line: the lock timeouts lock_miss logged in the last H hours
# (AQ_LOCK_MISS_HOURS, 1) against the bound N (AQ_LOCK_MISS_MAX, 3), with the latest one's command
# and caller, and the pid and command holding .lock when the kernel named one (ar-5560); exit 1 when
# over the bound, 2 when the log cannot be read. The rotated .1 counts too.
# The watch queue-lock-miss runs it: a miss is a line in a file, no event, so the watch samples the rate.
# lock_miss writes ts in UTC (`date -u -Is`) and the log syncs with the store, so lines from every host
# and either side of a DST change compare as strings against a UTC cutoff; lines before 2026-11-21
# carry -08:00 and are all from 2026-11-18. Bound: no hour had a miss but 2026-11-18T11, which had 364.
cmd_lock_miss() {
  local hours="${AQ_LOCK_MISS_HOURS:-1}" max="${AQ_LOCK_MISS_MAX:-3}" cut out n
  while [ $# -gt 0 ]; do
    case "$1" in
      --hours) hours="${2:?--hours needs a number}"; shift 2 ;;
      --max) max="${2:?--max needs a number}"; shift 2 ;;
      *) die "usage: agent-queue lock-miss [--hours H] [--max N]" ;;
    esac
  done
  [[ "$hours" =~ ^[0-9]+$ && "$max" =~ ^[0-9]+$ ]] || die "lock-miss: --hours and --max are whole numbers"
  cut=$(date -u -Is -d "-$hours hours")
  # A missing log (or no .1 yet) is no misses: only a jq failure is unreadable.
  out=$({ cat "$AQ_LOCK_MISS_LOG.1" "$AQ_LOCK_MISS_LOG" 2>/dev/null || :; } | jq -nrR --arg cut "$cut" '
    [inputs | fromjson? | objects | select((.ts // "") >= $cut)] | (last // {}) as $l
    | ([$l.locks[]? | select(startswith(".lock holds")) | split(" ") | {w: .[2], p: (.[3] | tonumber?)}
      | select(.p)] | map(select(.w == "WRITE")) + map(select(.w != "WRITE")) | map(.p)) as $h
    | (first($h[] as $p | $l.procs[]? | select(.pid == $p) | "\(.pid) \(.cmd)") // null) as $who
    | "\(length)\t\($l.ts): \($l.cmd) from \($l.caller)\(if $who then ", held by \($who)" else "" end)"') ||
    { echo "unreadable: $AQ_LOCK_MISS_LOG"; return 2; }
  n="${out%%$'\t'*}"
  printf '%s queue lock misses in the last %sh (bound %s)' "$n" "$hours" "$max"
  [ "$n" -eq 0 ] || printf '; the latest at %s (%s)' "${out#*$'\t'}" "$AQ_LOCK_MISS_LOG"
  echo
  [ "$n" -le "$max" ]
}

items_in() { # state-dir -> item files, oldest first
  local f
  for f in "$1"/*.md; do [ -e "$f" ] && printf '%s\n' "$f"; done | sort
}

# slug_files <slug> <glob-dir>... -> the item files whose `slug:` header is exactly this slug.
# The file name only narrows the search: `*-first.md` also matches `x-first`, and a second
# finish on the same day carries a `-2` suffix.
slug_files() {
  local slug="$1" d f
  shift
  for d in "$@"; do
    for f in "$d"/*"$slug"*.md; do
      [ -e "$f" ] && [ "$(fm_get "$f" slug)" = "$slug" ] && printf '%s
' "$f"
    done
  done
}

# latest_done <slug> -> the most recently finished item with this slug; the file's mtime breaks a
# tie inside one second, since `finished` is whole seconds for jq's date parser.
latest_done() {
  local f
  slug_files "$1" "$AQ_DIR"/done/* | while IFS= read -r f; do
    printf '%s\t%s\t%s\n' "$(fm_get "$f" finished)" "$(stat -c %.9Y "$f")" "$f"
  done | sort | tail -1 | cut -f3-
}

# find_item <slug> [any] -> the active item with that slug; `any` falls back to the latest
# finished one, so `show` and `set` reach a done item.
find_item() {
  local s f
  for s in $ACTIVE; do
    f="$(slug_files "$1" "$AQ_DIR/$s" | awk 'NR==1')"
    [ -n "$f" ] && { printf '%s\n' "$f"; return 0; }
  done
  [ "${2:-}" = any ] || return 1
  f="$(latest_done "$1")"
  [ -n "$f" ] && printf '%s\n' "$f"
}

state_of() { # file -> its state, from its directory
  local d
  case "$1" in "$AQ_DIR"/done/*) echo "done" ;; *) d="${1%/*}"; echo "${d##*/}" ;; esac
}

# The status of the most recent finished item with this slug, empty if none.
done_status() {
  local f
  f="$(latest_done "$1")"
  [ -n "$f" ] && fm_get "$f" status
}

# start_gate <slug> <after> <tags> <verb> <fix> [<item file>] -- a start by hand (add --running, move
# running of a queued item) waits on what holds the item, as the queue does: a live or dead after: or a
# tag gate that is not clear refuses it, naming <fix> (ar-3260). <item file>: the queued item, for
# stack_dependent; none for an add.
# gate: aq-hold-for
start_gate() {
  local HOLD HOLD_DEAD
  hold_for "$2" "$3" "" "${6-}"
  [ -z "$HOLD_DEAD" ] || die "$1 cannot $4: $HOLD"
  [ -z "$HOLD" ] || die "$1 waits on $HOLD, so it cannot $4: $5"
}

# finished_ok <slug> [<task>] [<from>] -> why an add is refused: the slug's latest done item closed ok,
# or, from a board row, an item under any slug closed ok on that row. A second item would do landed
# work again. A failed or cancelled one is a retry and passes. A recurring item (a nightly pass, a
# shared red that came back) is new work and says so with --repeat. A slug cut from the task's words
# (pass the task) is refused only when the words are that item's too: two tasks can share a
# 40-character slug and be different work. The row is read too because a hand start slugs
# `<project>-<key>` where promote slugs the row `<key>` (2026-11-07: trader tr-58 queued again after
# #635 merged). Refused adds exit AQ_EX_FINISHED. On 2026-11-06 a plan's re-queue ran an ok phase
# again (id-like-to-setup-abundant-seahor-p8).
AQ_EX_FINISHED=4
# gate: aq-finished-ok
finished_ok() {
  local f from="${3-}" key
  key="${from#board:}"
  f="$(latest_done "$1")"
  if [ -n "$f" ] && [ "$(fm_get "$f" status)" = ok ] && { [ -z "${2-}" ] || [ "$(fm_body "$f" | awk 'NR==1')" = "$(head -1 <<<"$2")" ]; }; then
    printf '%s already finished ok (%s%s): pass --repeat to queue it again as new work\n' \
      "$1" "$(fm_get "$f" finished)" "$(fm_get "$f" pr | sed 's/^./, PR &/')"
    return 0
  fi
  [ "$key" != "$from" ] || return 0
  grep -lxF -e "from: board:$key" -e "row: $key" "$AQ_DIR"/done/*/*.md 2>/dev/null | while IFS= read -r f; do
    [ "$(fm_get "$f" status)" = ok ] || continue
    printf '%s already finished ok on its own item %s (%s%s): pass --repeat to queue it again as new work\n' \
      "$key" "$(fm_get "$f" slug)" "$(fm_get "$f" finished)" "$(fm_get "$f" pr | sed 's/^./, PR &/')"
    break
  done
}

# Admission: the queue holds at most AQ_CAP items, every queued one counted, since each can start (a gated
# add queues nothing: its board row takes the gate, cmd_add). The board is the ranked backlog, the queue the
# ready buffer dispatch pulls from, so an add over the cap leaves its board row un-started with its
# rank and its whole brief, and dispatch promotes it as the queue drains. A hold writes no item, logs
# one line to AQ_ADMISSION_LOG and exits AQ_EX_HELD (docs: QUEUE.md "Admission").
# Only the board's pull and the human add at all (pull_ok, below); of those, never held: --running, a
# hand start (AGENT_QUEUE_PULL=hand), a gated add (it queues nothing), dispatch's trainee, canary
# and auto:epics verify adds (its board fill stops at the cap, queue_headroom), agent-land's
# auto:validate add (one per critical PR head, which no merge passes without), a --plan (an approved
# plan) and the pull of a phase it filed on its board row (plan_phase_task), cap 0. Urgent and `red`
# respect the cap too (the human, 2026-11-18): at it, make_room first returns the last-ranked item
# that has a row to its board, so they go in without the queue growing; so does pull-after's pull of a
# row an ok close cleared (AGENT_QUEUE_PULL=after).
# Provisional, confidence low (rules.jsonl): 30 keeps the queued age p90 under its bound
# (step_age_p90_queued_max, 420m since ar-4471) at the rate the oldest items drain, about 4.3 an hour on
# 2026-11-24 (45 queued, p90 9.5h at the old 50), not the 7.6 an hour mean that sized 50 (ar-4554).
# Re-measure from the queued row of `fleet-bench pipeline`: the tail rate is 0.9 x wip / age p90.
# Revisit when queued age p90 stays over it at the cap.
AQ_EX_HELD=5
AQ_CAP="${AGENT_QUEUE_CAP:-30}"
AQ_HELD_DAYS=7
AQ_ADMISSION_LOG="$AQ_DIR/admission.jsonl"

# admission_now -> "<runnable> <cap>": the queued items, and the cap. The queue holds only work that
# can start (a gate waits on its board row, cmd_add), so every queued item counts.
admission_now() {
  local runnable
  runnable="$(snap_json . queued | jq 'length')" || return 1
  printf '%s %s\n' "$runnable" "$AQ_CAP"
}

# make_room <priority> <tags> <slug> -> at the cap, an urgent or `red` add, or the pull of a row whose
# #after/ an ok close just cleared (AGENT_QUEUE_PULL=after, fleet-dispatch pull-after: held, that row
# waited for a pass, and a pass then never took the backlog tier, retired by ar-4626; 2026-11-20, chain-after-stuck), returns
# the last-ranked runnable item to its board row (cmd_return: lossless, the row is un-started and dispatch promotes it
# again), so the add goes in under the cap. Never chosen: urgent or red work, the human's (human_work),
# an item with no row to return to, a chain's head, a plan's phase (plan_phase_item), whatever the add's
# priority: its phases go in past the cap (a --plan, a phase pull), and a returned one waits on its row behind
# dispatch's fill, which stops at the cap, so its chain stops there; a held urgent add's row ranks first and
# goes in at the next free place (ar-5357). No such item: nothing moves, and admit holds the add
# like any other. Runs before the add takes the lock, since the return takes it: an add the lock would
# refuse (already queued, finished ok, its cause: owned) moves nothing, and a victim that starts
# meanwhile is not returned. A pull-after's pull returns only an item it does not outrank, and never one
# that the same pull-after already queued (AQ_ROOM_KEEP, its slugs), so rows behind one close do not
# push each other out.
make_room() {
  local now r l victim="" cands c f pr=0
  [ "$AQ_CAP" != 0 ] && { [ "$1" = urgent ] || [[ " $2 " == *" red "* ]] || [ "${AGENT_QUEUE_PULL:-}" = after ]; } || return 0
  [ "$1" = urgent ] || [[ " $2 " == *" red "* ]] || pr="$(prio_rank "$1" || echo 1)"
  [ -z "$(find_item "$3")" ] || return 0
  ( cause_owner "$2" ) >/dev/null 2>&1 || return 0
  [ -n "${repeat:-}" ] || [ -z "$(finished_ok "$3" "${slug_from_text:+$text}" "${from:-}")" ] || return 0
  now="$(admission_now)" && read -r r l <<<"$now" && [[ "$r" =~ ^[0-9]+$ ]] && [ "$r" -ge "$l" ] || return 0
  cands="$(collect queued | jq -r --argjson pr "$pr" --arg keep " ${AQ_ROOM_KEEP:-} " '
    ([.[] | (.after // "") | splits("[ ,]+") | select(. != "")]) as $heads
    | [.[] | select(.priority != "urgent" and (.row // "") != "")
        | select((" " + (.tags // "") + " ") | test(" (red|requested|#requested) ") | not)
        | select(.from != "human")
        | select(({"urgent":0,"high":1,"normal":2,"low":3}[.priority] // 1) >= $pr)
        | select(.slug as $s | $keep | contains(" \($s) ") | not)
        | select(.slug as $s | $heads | index($s) | not)] | reverse[] | "\(.slug)\t\(.file)"')" || return 0
  while IFS=$'\t' read -r c f; do
    [ -n "$c" ] && ! plan_phase_item "$f" || continue
    victim="$c"; break
  done <<<"$cands"
  [ -n "$victim" ] || return 0
  # Returned once it is no longer active, its row un-started or not (cmd_return says which).
  ( AQ_RETURN_QUEUED=1 cmd_return "$victim" --why "made room for $1 $3: the queue is at its cap of $l" ) >&2
  [ -z "$(find_item "$victim")" ] || return 0
  lock; admission_log "${from:-}" "${project:-}" "$victim" "returned for $3" "$r" "$l" returned; unlock
  echo "agent-queue: returned $victim to its board row to make room for $1 $3 under the cap of $l" >&2
}

# plan_phase_task <text> -- the task is a phase of an approved plan: the line add_plan writes into each
# phase's brief ("Phase N of the plan <path>", "Phases N and M ..."), naming a plan file that exists,
# which a phase it filed on its board row behind #after/ still carries when fleet-dispatch pull-after
# pulls that row. The cap passes a --plan's phases, so it passes this pull too: held, a phase on the
# backlog tier (retired, ar-4626) was never pulled again, since a pass skipped that tier and a pass's fill stops at the cap
# (2026-11-18: six plan phases sat behind closed rows, chain-after-stuck). add_plan writes the path
# through realpath, so it is absolute; the test files its brief through add_plan itself.
PHASE_BRIEF_RE='(^|[[:space:]])Phases? [0-9]+( and [0-9]+)* of the plan (/[^:]+\.md):'
plan_phase_task() { [[ "$1" =~ $PHASE_BRIEF_RE ]] && [ -f "${BASH_REMATCH[3]}" ]; }
# plan_phase_item <item file> -- the item is a plan's phase: its plan: line (add_plan), else its brief
# (plan_phase_task: a phase promoted from its row).
plan_phase_item() { [ -n "$(fm_get "$1" plan)" ] || plan_phase_task "$(fm_body "$1")"; }

# grant_names <id> <text> [<plan>] -> the names an agent-hold grant can give this work, space-separated:
# its row id (or slug), each epic its text names (#of/<id>), and the slug of its plan: <plan> (an item's
# plan: line), else the plan its brief names (a phase brief, PHASE_BRIEF_RE, or a plan row's,
# plan_row_plan). A hold:/#hold/ gate clears for a granted name while the hold stays (agent-hold check
# --for), so a human's narrowing lets the rows of a plan they approved run (ar-5235).
grant_names() {
  local out="$1" p="${3-}" e
  for e in $(grep -oE '(^|[[:space:]])#of/[A-Za-z0-9_.-]+' <<<"$2" | sed 's/.*#of\///'); do
    [[ " $out " == *" $e "* ]] || out+=" $e"
  done
  if [ -z "$p" ]; then
    if [[ "$2" =~ $PHASE_BRIEF_RE ]]; then p="${BASH_REMATCH[3]}"; else p="$(plan_row_plan "$2")"; fi
  fi
  [ -z "$p" ] || out+=" $(basename "$p" .md)"
  printf '%s' "$out"
}

# item_grant_names <item file> -> grant_names of a queue item: its row's id (else its slug), its title
# and brief, its plan: line.
item_grant_names() {
  local f="$1" row
  row="$(item_row "$f")"
  grant_names "${row:+${row#*:}}$( [ -n "$row" ] || fm_get "$f" slug)" "$(fm_get "$f" title)"$'\n'"$(fm_body "$f")" "$(fm_get "$f" plan)"
}

# admission_since -> the UTC start of the window the log and the held count keep.
admission_since() { date -u -d "$AQ_HELD_DAYS days ago" +%Y-%m-%dT%H:%M:%SZ; }

# admit <from> <priority> <tags> <project> <slug> <title> -> 0 when the add may go in; else says
# why on stderr, logs the hold and returns 1. An unreadable queue admits with a warning: the check
# never blocks work on its own fault. The log keeps the window only, since a filer retries.
admit() {
  local from=$1 priority=$2 tags=$3 project=$4 slug=$5 title=$6 now r l
  [ "$AQ_CAP" != 0 ] || return 0
  now="$(admission_now)" && read -r r l <<<"$now" && [[ "$r" =~ ^[0-9]+$ && "$l" =~ ^[0-9]+$ ]] ||
    { echo "agent-queue: admission could not read the queue, so this add goes in unchecked" >&2; return 0; }
  [ "$r" -ge "$l" ] || return 0
  admission_log "$from" "$project" "$slug" "$title" "$r" "$l" cap
  echo "agent-queue: held by admission, nothing was queued: $r items can start now against a cap of $l ($from)" >&2
  return 1
}

# admission_log <from> <project> <slug> <title> <runnable> <limit> <why> -> one line in AQ_ADMISSION_LOG,
# which keeps the window only. Called under the lock: the log is rewritten through a tmp file.
admission_log() {
  mkdir -p "$AQ_DIR"
  { [ -s "$AQ_ADMISSION_LOG" ] && jq -c --arg s "$(admission_since)" 'select(.at >= $s)' "$AQ_ADMISSION_LOG" 2>/dev/null
    jq -nc --arg at "$(now_utc)" --arg from "$1" --arg project "$2" --arg slug "$3" --arg title "$4" \
      --argjson runnable "${5:-null}" --argjson limit "${6:-null}" --arg why "$7" \
      '{at: $at, from: $from, project: $project, slug: $slug, title: $title, runnable: $runnable, limit: $limit, why: $why}'
  } > "$AQ_ADMISSION_LOG.tmp" && mv -f "$AQ_ADMISSION_LOG.tmp" "$AQ_ADMISSION_LOG"
}

# Only the board fills the queue (the human, 2026-11-18, after three filers' 225 `night` items took the
# runnable count from 205 to 362 when the night window opened): dispatch's pull (AGENT_QUEUE_PULL=dispatch,
# set by fleet-dispatch on its promote, trainee and epic-verify adds), a session's own --running record,
# and the human, at a terminal or in a session they started (hand_caller). Any other add, a
# dispatch-run agent's or a filer's, is filed on the board instead and exits AQ_EX_HELD.
# Provisional (rules.jsonl, anchor "Only the board fills the queue"): hand sessions add straight in;
# the human, 2026-11-19, made their want start at add there (start_at_add).
# hand_caller <from> <from_given> -> true for the human: no --from but `human`, not a headless Claude run,
# and no queue item, or one whose session the human opened (origin hand or resume). A finished or
# unknown item is an agent's.
hand_caller() {
  [ -z "$2" ] || [ "$1" = human ] || return 1
  ! headless || return 1
  [ -n "${AGENT_QUEUE_ITEM:-}" ] || return 0
  local f; f="$(find_item "$AGENT_QUEUE_ITEM")"
  [ -n "$f" ] || return 1
  case "$(fm_get "$f" origin)" in hand | resume) return 0 ;; esac
  return 1
}
# headless -- the caller runs under a headless Claude run: Claude sets CLAUDE_CODE_ENTRYPOINT to sdk-cli for
# `claude -p` (every agentctl runner and private launch) and sdk-* for an SDK host, and to cli in a session
# with a pane. No human sits at one, so what it adds is an agent's, with or without a queue item (ar-3887).
headless() { [[ "${CLAUDE_CODE_ENTRYPOINT:-}" == sdk-* ]]; }
# running_from -> the `from` of a --running record that names no --from or --want: a session's record of its own
# work is the session's, item:<slug> in a queue item's session, and `from: human` stays for what the human typed
# (a terminal add, --want, the hub's Add) (ar-4154).
running_from() {
  if [ -n "${AGENT_QUEUE_ITEM:-}" ]; then echo "item:$AGENT_QUEUE_ITEM"
  elif [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then echo session
  else echo human; fi
}
# pull_ok <running> <from> <from_given> -> true when this add may go into the queue at all.
# gate: aq-pull-ok
pull_ok() { [ -n "$1" ] || [ -n "${AGENT_QUEUE_PULL:-}" ] || hand_caller "$2" "$3"; }
# board_only_say -> the one line every add the board takes instead prints first.
board_only_say() {
  echo "agent-queue: only the board fills the queue: an agent or a script files a board row and dispatch pulls it (QUEUE.md \"Admission\")" >&2
}

# admission [--json] -> admission_now, the items the cap held and the adds sent to the board (the
# board-only rule) in the last AQ_HELD_DAYS, each counted once however often its filer retried, and
# the items an urgent or red add returned to the board (make_room), so urgent inflation shows.
# --json adds `day`, the last 24h: `held` as held_7d counts it, and `why`, those same items per
# reason (a line from before the log kept its reason is a cap hold); the pipeline's admission step.
cmd_admission() {
  local json='' now r l since held=0 boarded=0 returned=0 day=''
  case "${1:-}" in --json) json=1 ;; '') ;; *) die "unknown option: $1" ;; esac
  now="$(admission_now)" || die "the queue could not be read"
  read -r r l <<<"$now"
  since="$(admission_since)"
  if [ -s "$AQ_ADMISSION_LOG" ]; then
    read -r held boarded returned day < <(jq -rs --arg s "$since" --arg d "$(date -u -d '1 day ago' +%Y-%m-%dT%H:%M:%SZ)" '
      def items: map([.project, .slug]) | unique | length;
      def held: map(select(.why | IN("board-only", "gated", "returned") | not));
      [.[] | select(.at >= $s)] as $w | [$w[] | select(.at >= $d)] as $x
      | ($w | held | items)
      , ([$w[] | select(.why | IN("board-only", "gated")) | [.project, .slug, .title]] | unique | length)
      , ([$w[] | select(.why == "returned")] | length)
      , ({held: ($x | held | items), why: ($x | held | group_by(.why // "cap") | map({key: (.[0].why // "cap"), value: items}) | from_entries)} | tojson)' \
      "$AQ_ADMISSION_LOG" 2>/dev/null | paste -sd' ')
  fi
  if [ -n "$json" ]; then
    jq -nc --argjson r "$r" --argjson l "$l" --argjson h "${held:-0}" --argjson b "${boarded:-0}" --argjson x "${returned:-0}" --argjson on "$([ "$AQ_CAP" != 0 ] && echo true || echo false)" \
      --argjson day "${day:-null}" \
      '{on: $on, runnable: $r, limit: $l, held_7d: $h, boarded_7d: $b, returned_7d: $x, day: ($day // {held: 0, why: {}}), admits: (($on | not) or $r < $l)}'
  else
    printf 'admission: %s, %s can start now against a cap of %s; %s adds held, %s sent to the board and %s returned for urgent work in %s days\n' \
      "$([ "$AQ_CAP" != 0 ] && { [ "$r" -lt "$l" ] && echo admitting || echo holding; } || echo off)" "$r" "$l" "${held:-0}" "${boarded:-0}" "${returned:-0}" "$AQ_HELD_DAYS"
  fi
}

# requested_tag <tags> -> whether the item came from a row the human asked for (#requested; dispatch
# copies it onto the item as `requested`).
requested_tag() { [[ " $1 " == *" requested "* || " $1 " == *" #requested "* ]]; }
# interrupt_tag <tags> -> whether the item's story row goes through a locked sprint's interrupt lane.
interrupt_tag() { [[ " $1 " == *" interrupt "* || " $1 " == *" #interrupt "* ]]; }
# human_work <from> <tags> -> whether the human asked for this work: added --from human, or a #requested row.
human_work() { [ "$1" = human ] || requested_tag "$2"; }

# hold_reason <file> -> why a queued item cannot start yet, or nothing when it can.
hold_reason() {
  local HOLD=""
  hold_for "$(fm_get "$1" after)" "$(fm_get "$1" tags)" "$1"
  [ -z "$HOLD" ] || printf '%s\n' "$HOLD"
}

# memo <key> <cmd...> -> sets MEMO_V to the command's output, cached in LIST_MEMO when the caller
# (items_json) set LIST_MEMO_ON: a cache that lives for one listing, so a listing asks each hold
# and each project's weight once. Without one it just runs the command, so a check after a
# move never reads a stale answer. Sets a variable, not stdout, so the cache survives the call.
# 8>&-: a check runs gh, rbw, agent-ask or agent-hold under the queue lock, and a daemon one of them
# starts (rbw-agent) would inherit the lock's fd and hold the lock for its whole life, so every
# writer timed out (2026-11-16, the first rbw call after a boot).
memo() {
  local k="$1"; shift
  if [ -z "${LIST_MEMO_ON-}" ]; then MEMO_V="$("$@" 8>&-)"; return; fi
  [ -n "${LIST_MEMO[$k]+x}" ] || LIST_MEMO[$k]="$("$@" 8>&-)"
  MEMO_V="${LIST_MEMO[$k]}"
}

# after_status <slug> -> sets AST to what an `after:` waits on: empty while the slug has a live item
# (queued, running or waiting), else its latest done status. A re-queued slug is work again, whatever
# done/ holds. A listing answers from its index (index_load, which picks the latest done item as
# latest_done does); a lone check asks the store.
after_status() {
  AST=""
  if [ -n "${LIST_MEMO_ON-}" ]; then
    [ -n "${QI_LIVE[$1]+x}" ] || AST="${QI_ST[$1]-}"
  elif [ -z "$(find_item "$1")" ]; then
    AST="$(done_status "$1")"
  fi
}

# stack_pr <slug> -> sets STK to the open PR (owner/repo#N) of the live item <slug>, empty when it has
# none: a PR it recorded while open (`open_pr:`, which agent-land sets before the checks, or the `pr:`
# of a --pr-only run) that its forge still reads OPEN. An `after:` on such an item is stacked, not
# held: the dependent starts on that PR's head (fleet-dispatch cmd_start), and agent-land merges it
# only once <slug> closed ok.
stack_pr() {
  local f ref MEMO_V
  STK=""
  f="$(find_item "$1")" || return 0
  case "$(state_of "$f")" in running | waiting | review) ;; *) return 0 ;; esac
  for ref in $(fm_get "$f" open_pr) $(fm_get "$f" pr); do
    [[ "$ref" == */*#* ]] || continue
    memo "pr:$ref" pr_state "$ref"
    [ "$MEMO_V" != OPEN ] || { STK="$ref"; return 0; }
  done
}

# stack_dependent [<item file>] -- the item waiting may stack on its after: item's open PR (hold_for,
# cmd_gate): a plan phase, which builds on its dependency's code (ar-3852), or a `validate` item, which
# reviews its author's open PR before it lands (fleet-dispatch validate, ar-1689). An item file: its
# `plan:` line, its `validate` tag, else its brief (plan_phase_task: a phase promoted from its row). No
# file: the add under way (AQ_ADD_STACKS, which cmd_add sets). Any other after: means "once it lands"
# and holds until that item closed ok. Why: 2026-11-21 a hand `add --after ucp-2567`, running with open
# PR #3076, started its dependent at once on #3076's head, three hours before #3076 merged (ar-4537).
stack_dependent() {
  if [ -n "${1-}" ]; then
    plan_phase_item "$1" || [[ " $(fm_get "$1" tags) " == *" validate "* ]]
  else [ -n "${AQ_ADD_STACKS-}" ]; fi
}

# add_stacks <text> <tags> -- prints 1 when the add under way may stack on its after: item's open PR
# (stack_dependent's no-file case): a --plan phase (AQ_ITEM_PLAN), a validate item, or a phase brief.
add_stacks() {
  if [ -n "${AQ_ITEM_PLAN:-}" ] || [[ " $2 " == *" validate "* ]] || plan_phase_task "$1"; then echo 1; fi
}

# hold_for <after> <tags> [<file>] [<item file>] -> sets HOLD to hold_reason's answer for these
# header values, HOLD_DEAD to 1 when that hold can never release (cmd_gate reads it), and
# HOLD_STACK to "<slug>=<PR>" for each after: slug that is live with an open PR, when the item waiting
# is a plan phase or validate item (stacked: no hold, stack_dependent). <file> is that item, which also names the human's
# work in a dead hold; <item file> names it for the stack check alone.
# gate: aq-hold-for
hold_for() {
  local after="$1" tags="$2" dep="${4:-${3-}}" tag now stamp nday MEMO_V AST s live="" gnames
  local -a afters
  HOLD="" HOLD_DEAD="" HOLD_STACK=""
  # Every slug in after: must have closed ok. The hold names the slugs still live; a dead one wins,
  # since it never releases.
  read -ra afters <<<"$after"
  for s in "${afters[@]}"; do
    after_status "$s"
    case "$AST" in
      ok) ;;
      "") stack_pr "$s"
        [ -z "$STK" ] || stack_dependent "$dep" || STK=""
        if [ -n "$STK" ]; then HOLD_STACK="$HOLD_STACK${HOLD_STACK:+ }$s=$STK"; else live="$live${live:+ }$s"; fi ;;
      # Any other close releases only if that slug is queued again and closes ok: say so, so the
      # list and the hub show a dead hold apart from a live one.
      *) HOLD_DEAD=1 HOLD="after $s closed $AST, dead: it never releases (queue $s again, or set after= without it); who closed it and why: agent-queue show $s"
        # The human's own work is theirs to drop: say so before a cleanup loop tries (cancel_guard).
        [ -z "${3-}" ] || ! human_work "$(fm_get "$3" from)" "$tags" || HOLD+="; a cancel by hand takes --why and --ask <an answered ask naming it>"
        return ;;
    esac
  done
  # One worktree has one base: two or more open PRs to stack on is a wait, not a start.
  case "$HOLD_STACK" in
    *" "*) for s in $HOLD_STACK; do live="$live${live:+ }${s%%=*}"; done; HOLD_STACK="" ;;
  esac
  [ -z "$live" ] || { HOLD="after $live"; return; }
  [ -n "$tags" ] || return 0
  # AGENT_QUEUE_NOW is HH:MM (today) or YYYY-MM-DDTHH:MM, local time. printf's clock, not date: a
  # listing asks this for every tagged queued item.
  stamp="${AGENT_QUEUE_NOW-}"
  [ -n "$stamp" ] || printf -v stamp '%(%Y-%m-%dT%H:%M)T' -1
  [[ "$stamp" == *T* ]] || { printf -v now '%(%Y-%m-%d)T' -1; stamp="${now}T$stamp"; }
  now="${stamp#*T}"
  # A nightly: hold judges the night of the item's at: date (nightly_pending), else today's.
  nday=""
  for tag in $tags; do [[ "$tag" =~ ^at:([0-9]{4}-[0-9]{2}-[0-9]{2})T ]] && nday="${BASH_REMATCH[1]}"; done
  for tag in $tags; do
    case "$tag" in
      at:[0-9][0-9]:[0-9][0-9]) [ "${now/:/}" -ge "${tag//[!0-9]/}" ] || { HOLD="$tag"; return; } ;;
      at:[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]) [[ ! "$stamp" < "${tag#at:}" ]] || { HOLD="$tag"; return; } ;;
      pr:?*/?*#[0-9]*)
        memo "$tag" pr_state "${tag#pr:}"
        case "$MEMO_V" in
          MERGED) ;;
          # Closed unmerged, it can never release: say so, so the list and the hub show a dead hold.
          CLOSED) HOLD_DEAD=1 HOLD="$tag closed unmerged, never releases: cancel the item or set its tags without it"; return ;;
          *) HOLD="$tag not merged"; return ;;
        esac ;;
      nightly:?*)
        memo "nightly:${tag#nightly:}@$nday" nightly_pending "${tag#nightly:}" "$stamp" "$nday"
        [ -z "$MEMO_V" ] || { HOLD="$tag ($MEMO_V)"; return; } ;;
      ask:?*)
        memo "$tag" ask_pending "${tag#ask:}"
        [ -z "$MEMO_V" ] || { HOLD="$tag ($MEMO_V)"; return; } ;;
      hold:?*)
        memo "$tag" hold_pending "${tag#hold:}"
        # Held, an item still passes on a grant to its row, epic or plan (item_grant_names): the
        # hold stands for the rest, so no desk turn is taken either.
        if [ -n "$MEMO_V" ] && [ -n "${3:-${4-}}" ]; then
          gnames="$(item_grant_names "${3:-${4-}}")"
          memo "$tag@$gnames" hold_pending "${tag#hold:}" "$gnames"
          [ -n "$MEMO_V" ] || continue
        fi
        [ -z "$MEMO_V" ] || { HOLD="$tag ($MEMO_V)"; return; }
        [ -n "${DESK_SCAN-}" ] || desk_wait "${tag#hold:}" "$tags" "${3-}"
        [ -z "$HOLD" ] || return 0 ;;
      rbw:*)
        # A tag edited past check_tags into the wrong shape holds rather than starting before its key.
        [[ "$tag" =~ ^rbw:[^/[:space:]]*/[^[:space:]]+$ ]] || { HOLD_DEAD=1 HOLD="$tag (not rbw:<folder>/<name>, never releases)"; return; }
        # One rbw list a listing or gate call, however many rbw: tags it reads.
        memo rbw rbw_listing
        MEMO_V="$(rbw_pending "${tag#rbw:}" "$MEMO_V")"
        [ -z "$MEMO_V" ] || { HOLD="$tag ($MEMO_V)"; return; } ;;
    esac
  done
}

# A board row waits on its gate tags before it has an item (fleet-dispatch promotes it once `gate` says
# all clear), and a returned item's holds go back onto its row as gate tags (return_gates). A hashtag
# has no colon (notes md.rs tag_span), so each board form is a queue hold with / for its punctuation:
# gate_queue_tag and gate_board_tag translate, and hold_for stays the one evaluator.

# ROW_TAGS_JQ: a board row's tags as written (notes board --json .tags_cased). .tags is lower-cased
# for grouping, but a gate's value is data: an ask id (kxL6vp) or an rbw name keeps its case, and read
# lower-cased every #ask/ gate named no ask (2026-11-18). A notes build from before tags_cased gives .tags.
ROW_TAGS_JQ='def row_tags: .tags_cased // .tags // [];'

# gate_queue_tag <board tag> -> sets GQ to the queue tags that gate means (space-separated); returns 1
# when it is no gate. after/ has none: cmd_gate reads the board for it. An ask/<id> naming no option,
# on an ask that offers some, names them all (check_tags wants them named): any answer releases it.
gate_queue_tag() {
  local t="${1#\#}" rest opt
  local -a opts=()
  GQ=""
  case "$t" in
    at/[0-9][0-9][0-9][0-9]) GQ="at:${t:3:2}:${t:5:2}" ;;
    at/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/[0-9][0-9][0-9][0-9]) GQ="at:${t:3:10}T${t:14:2}:${t:16:2}" ;;
    rbw/?*/?* | rbw//?*) GQ="rbw:${t#rbw/}" ;;
    ask/?*/?*) rest="${t#ask/}"; opt="${rest#*/}"; GQ="ask:${rest%%/*}=${opt//\//+}" ;;
    ask/?*)
      GQ="ask:${t#ask/}"
      while IFS= read -r opt; do
        [ -n "$opt" ] || continue
        opt="${opt%% *}"; opts+=("${opt%[.,;:!]}")
      done < <(ask_options "${t#ask/}")
      [ "${#opts[@]}" -eq 0 ] || GQ+="=$(IFS=+; printf '%s' "${opts[*]}")" ;;
    pr/?*/?*/[0-9]*) rest="${t#pr/}"; GQ="pr:${rest%/*}#${rest##*/}" ;;
    hold/?*) GQ="hold:${t#hold/}" ;;
    nightly/?*/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) rest="${t#nightly/}"; GQ="at:${rest#*/}T00:00 nightly:${rest%%/*}" ;;
    nightly/?*) GQ="nightly:${t#nightly/}" ;;
    *) return 1 ;;
  esac
}

# gate_board_tag <queue tag> [<day>] -> sets GB to that hold's board gate tag (no #), a nightly: one
# dated <day> (the item's at: date) when given; returns 1 when it has none: no hold tag, or a value a
# hashtag cannot carry (letters, digits and _ . / -, not ending in / - or .).
gate_board_tag() {
  local t="$1" v
  GB=""
  case "$t" in
    at:[0-9][0-9]:[0-9][0-9]) GB="at/${t:3:2}${t:6:2}" ;;
    at:[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]) GB="at/${t:3:10}/${t:14:2}${t:17:2}" ;;
    rbw:?*) GB="rbw/${t#rbw:}" ;;
    ask:?*=?*) v="${t#ask:}"; GB="ask/${v%%=*}/${v#*=}"; GB="${GB//+//}" ;;
    ask:?*) GB="ask/${t#ask:}" ;;
    pr:?*#?*) v="${t#pr:}"; GB="pr/${v%#*}/${v##*#}" ;;
    hold:?*) GB="hold/${t#hold:}" ;;
    nightly:?*) GB="nightly/${t#nightly:}${2:+/$2}" ;;
    *) return 1 ;;
  esac
  [[ "$GB" =~ ^[A-Za-z0-9_./-]+$ && "$GB" != *[/.-] ]] || { GB=""; return 1; }
}

# stack_row <row id> -> sets STK to the open PR of the live item working that row (stack_pr) and
# STK_SLUG to its slug; both empty when no live item of that row has one. The caller (cmd_gate)
# declares ROW_LIVE and ROW_LIVE_READ; the live items' rows are read once into it (row_live_load).
stack_row() {
  local s
  STK="" STK_SLUG=""
  row_live_load
  for s in ${ROW_LIVE[$1]-}; do
    STK_SLUG="$s"
    stack_pr "$STK_SLUG"
    [ -z "$STK" ] || return 0
  done
  STK_SLUG=""
}

# row_live_load -- ROW_LIVE[<row id>]: the slugs of the running, waiting and review items working that row
# (item_row's row, read as fm_get reads a header), in that order, from one awk over every live item.
# A gate --all asked item_row of every live item for each open #after/ row: 32 of its 34 s (ar-4911).
row_live_load() {
  [ -z "${ROW_LIVE_READ-}" ] || return 0
  ROW_LIVE_READ=1
  local d f s r
  local -a files=()
  for d in running waiting review; do for f in "$AQ_DIR/$d"/*; do [ -f "$f" ] && files+=("$f"); done; done
  [ "${#files[@]}" -gt 0 ] || return 0
  while IFS=$'\x1f' read -r s r; do
    [ -n "$s" ] && [ -n "${r##*:}" ] || continue
    ROW_LIVE[${r##*:}]+="${ROW_LIVE[${r##*:}]:+ }$s"
  done < <(awk 'function out() { if (on) { r = row; if (r == "" && from ~ /^board:/) r = substr(from, 7); if (r ~ /:/) printf "%s\037%s\n", slug, r } }
    function val(k) { v = substr($0, length(k) + 2); sub(/^ +/, "", v); return v }
    FNR == 1 { out(); on = 1; hd = 1; slug = row = from = ""; gs = gr = gf = 0 }
    !hd { next }
    $0 == "---" { hd = 0; next }
    !gs && index($0, "slug:") == 1 { slug = val("slug"); gs = 1 }
    !gr && index($0, "row:") == 1 { row = val("row"); gr = 1 }
    !gf && index($0, "from:") == 1 { from = val("from"); gf = 1 }
    END { out() }' "${files[@]}" 2>/dev/null)
}

# after_fix <id> -> "; <the gate it should be>" for an #after/ id no board row has, when the id says
# what was meant: a date or a time is an #at/ gate, and a queue item's slug is #after/ its row. Nothing
# otherwise. Why: 2026-11-21, ucp-2891 waited #after/2026-11-23 and ucp-2786 #after/<a slug>, and
# starved named both dead with only the generic fix (ar-4471).
after_fix() {
  local f row
  if [[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then printf '; a date is an at gate: #at/%s/HHMM' "$1"; return; fi
  if [[ "$1" =~ ^[0-9]{4}$ ]]; then printf '; a time is an at gate: #at/%s' "$1"; return; fi
  f="$(find_item "$1" any)" && [ -n "$f" ] || return 0
  row="$(item_row "$f")"
  [ -n "$row" ] && printf '; %s is a queue item, its row is #after/%s' "$1" "${row#*:}"
  return 0
}

# rows_state <id>... -- RS[<id>] for each row `notes board --json --id` finds: open (open or doing),
# done, dropped, or dup:<row> when it was folded into another row, whose state it reads too, up to
# AQ_GATE_DUP_HOPS reads. An id listed twice (a sheet and a version note) reads open, then done, then
# dup, then dropped. An id it does not find gets no entry. Fails when the board cannot be read.
AQ_GATE_DUP_HOPS=4
rows_state() {
  local -a more=("$@")
  local i hop
  for ((hop = 0; hop < AQ_GATE_DUP_HOPS && ${#more[@]} > 0; hop++)); do
    rows_state_read "${more[@]}" || return 1
    more=()
    for i in "${RS[@]}"; do [[ "$i" != dup:?* ]] || [ -n "${RS[${i#dup:}]-}" ] || more+=("${i#dup:}"); done
  done
}
# A marker reads dropped by the token notes writes (md::is_dropped): `dropped:`.
rows_state_read() {
  local -a args=()
  local i st feed lines
  for i in "$@"; do args+=(--id "$i"); done
  feed="$(notes board --json "${args[@]}" 2>/dev/null)" && [ -n "$feed" ] || return 1
  lines="$(jq -r '[.rows[]? | select(.id != null)] | group_by(.id)[]
    | map(if .state == "open" or .state == "doing" then "open"
          elif ((.marker // "") | test("(^| )dropped:")) then "dropped"
          elif .dup != null then "dup:\(.dup)" else "done" end) as $s
    | "\(.[0].id)\t\(if any($s[]; . == "open") then "open" elif any($s[]; . == "done") then "done"
        else (($s | map(select(startswith("dup:"))))[0] // "dropped") end)"' <<<"$feed")" || return 1
  while IFS=$'\t' read -r i st; do [ -z "$i" ] || RS[$i]=$st; done <<<"$lines"
}

# gate [--json] (--all | <tag>...) -- each board gate tag clear, pending (why, in hold_for's words) or
# dead (it can never clear: take it off the row, or settle what it names), and any other tag none.
# after/<row-id> is clear once that row closed done, dead once it was dropped or when no row has that
# id, pending while it is open or the board cannot be read; a dup-closed row reads as the row it was
# folded into. One `notes board --json --id` read (rows_state) and one rbw list serve every tag; --all
# also reads the open board for its tags. --all answers every gate tag on the board's open rows, and
# only those: fleet-dispatch's one call a pass (a board it cannot read fails it). --json: one {tag,
# state, why, queue} line per tag, queue the hold tags it means (gate_queue_tag), which fleet-dispatch
# promote puts on the row's item. With --all, a held hold/ tag also gets a clear line with `row` for each
# open row carrying it that the hold grants (gate_grants). Exit 0 when every gate is clear, else 3.
cmd_gate() {
  local usage="usage: agent-queue gate [--json] (--all | <tag>...)"
  local json="" all="" board="" unread="" t q st why id r via hop rc=0 GQ HOLD HOLD_DEAD stack STK STK_SLUG
  local -a tags=() ids=() held=()
  local -A RS=() NOPHASE=() ROW_LIVE=()
  local ROW_LIVE_READ=''
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --all) all=1; shift ;;
      -?*) die "$usage" ;;
      *) tags+=("$1"); shift ;;
    esac
  done
  [ -n "$all" ] || [ "${#tags[@]}" -gt 0 ] || die "$usage"
  if [ -n "$all" ]; then
    board="$(notes board --json 2>/dev/null)" && [ -n "$board" ] || die "gate --all: notes board --json failed"
    mapfile -t -O "${#tags[@]}" tags < <(jq -r "$ROW_TAGS_JQ"'[.rows[]? | select(.state == "open" or .state == "doing") | row_tags[]] | unique | .[]' <<<"$board")
    # Each after/ tag an open row carries whose brief is no plan phase's: that tag never clears as stacked.
    local brief
    while IFS=$'\x1f' read -r t brief; do
      [ -n "$t" ] && ! plan_phase_task "$brief" && NOPHASE[$t]=1
    done < <(jq -r "$ROW_TAGS_JQ"'.rows[]? | select(.state == "open" or .state == "doing")
      | ([.text // "", (.details // [])[]] | join(" ") | gsub("[\n\u001f]"; " ")) as $b
      | row_tags[] | select(startswith("after/")) | "\(.)\u001f\($b)"' <<<"$board")
  fi
  local -A LIST_MEMO=()
  local LIST_MEMO_ON=1
  # Every after/ id in one `notes board --json --id` read: it finds a row wherever it sits (open in any
  # version, closed, dropped or dup-closed, either lane, rolled into a version note), which the open
  # board and its done feed do not (2026-11-23: a human row aimed at a later version and two dropped
  # agent rows all read "no board row has that id", and queue-starved tripped on them).
  for t in "${tags[@]}"; do t="${t#\#}"; if [[ "$t" == after/?* ]]; then ids+=("${t#after/}"); fi; done
  [ "${#ids[@]}" -eq 0 ] || rows_state "${ids[@]}" || unread=1
  for t in "${tags[@]}"; do
    t="${t#\#}" q="" why="" stack=""
    if [[ "$t" == after/?* ]]; then
      id="${t#after/}" r="${RS[$id]-}" via=""
      # A dup-closed row is the row it was folded into, through every hop rows_state read.
      for ((hop = 0; hop < AQ_GATE_DUP_HOPS; hop++)); do
        [[ "$r" == dup:?* ]] || break
        via+=" (folded into ${r#dup:})" id="${r#dup:}" r="${RS[${r#dup:}]-}"
      done
      case "$r" in
        dup:*) st=dead why="after ${t#after/}$via: folded more than $AQ_GATE_DUP_HOPS times; gate on the row that owns the work" ;;
        done) st=clear ;;
        dropped) st=dead why="after ${t#after/}$via: that row was dropped, so it never closes done; take the tag off the row" ;;
        open) st=pending why="after ${t#after/}$via (open)"
          # The row's item is live with an open PR: stacked, which clears the gate for a plan phase (it
          # builds on that PR; agent-land merges it once the item closed ok). `stack` names the item for
          # promote. With --all, only when every open row carrying the tag is a phase; one tag asked
          # alone, when the add asking stacks (stack_dependent). Any other row waits for the close (ar-4537).
          stack_row "$id"
          if [ -n "$STK" ]; then
            if { [ -n "$all" ] && [ -z "${NOPHASE[$t]-}" ]; } || { [ -z "$all" ] && stack_dependent; }; then
              st=clear why="stacked on $STK" stack="$STK_SLUG"
            else why="after ${t#after/}$via (open; its item's open PR $STK is a base only for a plan phase)"; fi
          fi ;;
        *) if [ -z "$unread" ]; then st=dead why="after ${t#after/}$via: no board row has that id$(after_fix "$id")"
           else st=pending why="after ${t#after/} (notes board --json failed)"; fi ;;
      esac
    elif gate_queue_tag "$t"; then
      q="$GQ"
      # A tag check_tags refuses (a bad time, an ask that can never release) is dead; the rest hold_for answers.
      if why="$( (check_tags "$q") 2>&1 >/dev/null)"; then
        hold_for "" "$q"
        why="${HOLD/:/ }"
        if [ -z "$HOLD" ]; then st=clear
        elif [ -n "$HOLD_DEAD" ]; then st=dead
        else st=pending
        fi
      else
        why="${why#agent-queue: }" st=dead
      fi
    else
      [ -z "$all" ] || continue
      st=none
    fi
    case "$st" in pending | dead) rc=3 ;; esac
    [[ "$t" != hold/?* || "$st" != pending ]] || held+=("$t")
    gate_line "$t" "$st" "$why" "$q" "$stack" ""
  done
  [ -z "$all" ] || [ "${#held[@]}" -eq 0 ] || gate_grants "$board" "${held[@]}"
  return "$rc"
}

# gate_line <tag> <state> <why> <queue> <stack> <row> -- one line of cmd_gate's answer (its locals: json).
gate_line() {
  if [ -n "$json" ]; then
    jq -cn --arg tag "$1" --arg state "$2" --arg why "$3" --arg queue "$4" --arg stack "$5" --arg row "$6" \
      '{tag: $tag, state: $state, why: $why, queue: $queue, stack: $stack} + (if $row == "" then {} else {row: $row} end)'
  else
    printf '%-8s %s%s%s\n' "$2" "$1" "${6:+ (row $6)}" "${3:+: $3}"
  fi
}

# gate_grants <board json> <hold tag>... -- for each held #hold/<res> tag, a clear line naming the row
# for every open row carrying it that the hold grants by its row, epic or plan (grant_names): one
# agent-hold check --for a tag with every such row's names, its answer mapped back to the rows. The
# tag's own line stays pending, so every other row carrying it still waits; fleet-dispatch reads the
# row's line first (gate_wait). Why: a narrowing the human made was reason text no gate read, and the
# rows of a plan they approved sat behind #hold/critical (2026-11-24, ar-5235).
gate_grants() {
  local board="$1" t id rt text names all hit q n GQ
  shift
  # The names are split into one --for word each, never globbed (a plan path is free text).
  local -; set -f
  local -A NAMES=()
  for t in "$@"; do
    NAMES=() all=""
    while IFS=$'\x1f' read -r id rt text; do
      [ -n "$id" ] || continue
      names="$(grant_names "$id" "$text $rt")"
      NAMES[$id]="$names" all+=" $names"
    done < <(jq -r --arg t "$t" "$ROW_TAGS_JQ"'.rows[]? | select((.state == "open" or .state == "doing") and .id != null)
      | select(row_tags | index($t)) | [row_tags[] | select(startswith("of/")) | "#" + .] as $of
      | "\(.id)\u001f\($of | join(" "))\u001f\([.text // "", (.details // [])[]] | join(" ") | gsub("[\n\u001f]"; " "))"' <<<"$board")
    [ -n "$all" ] || continue
    # shellcheck disable=SC2086 # a word list: one --for name each
    hit="$("$AQ_HOLD" check "${t#hold/}" --no-caller --for $all 2>&1 >/dev/null | sed -n 's/^granted: [^ ]* for //p')"
    [ -n "$hit" ] || continue
    hit=" $hit "
    gate_queue_tag "$t"; q="$GQ"
    for id in "${!NAMES[@]}"; do
      for n in ${NAMES[$id]}; do
        [[ "$hit" == *" $n "* ]] || continue
        gate_line "$t" clear "granted $n by the ${t#hold/} hold" "$q" "" "$id"
        break
      done
    done
  done
}

# desk_class <tags> -> the item's desk:<class>, other when it names none.
desk_class() {
  local t
  for t in $1; do case "$t" in desk:?*) printf '%s' "${t#desk:}"; return ;; esac; done
  printf other
}

# human_away -- the human is away (fleet-presence); unread or a missing presence reads as here.
# Asked once per listing, so every item in it reads the same answer.
presence_word() { local p; p="$("$AQ_PRESENCE" 2>/dev/null)"; printf '%s' "${p%% *}"; }
human_away() { memo presence presence_word; [ "$MEMO_V" = away ]; }

# desk_starting <resource> -> the slug of an item started on that resource less than
# AQ_DESK_START_MIN ago, whose session may not have claimed it yet.
desk_starting() {
  local f st now
  now="$(date +%s)"
  while IFS= read -r f; do
    [ "$(fm_get "$f" desk_start)" = "$1" ] || continue
    st="$(date -d "$(fm_get "$f" started)" +%s 2>/dev/null)" || continue
    [ $((now - st)) -lt $((AQ_DESK_START_MIN * 60)) ] && { fm_get "$f" slug; return; }
  done < <(items_in "$AQ_DIR/running")
}

# desk_head <resource> -> "<file>\t<slug>\t<class>" of the queued item that takes the resource next:
# the best class (agent-hold classes), then priority, then the oldest. Only an item that could start
# counts: one still held by another tag (at:, after) would keep the desktop from the rest, and a
# desk:auth item counts only while the human is here.
desk_head() {
  local res="$1" f slug after tags pri cls rank p ranks away="" HOLD DESK_SCAN=1
  ranks="$("$AQ_HOLD" classes 2>/dev/null)"
  human_away && away=1
  # One awk reads every queued header (header_rows), not an fm_get per field per item: on 506
  # queued items that was 1,012 forks, 1.6 s of a 2.7 s listing (ar-2359).
  while IFS=$'\x1f' read -r f _ slug _ _ after tags _ _ _ _ pri; do
    [[ " $tags " == *" hold:$res "* ]] || continue
    cls="$(desk_class "$tags")"
    [ "$cls" = auth ] && [ -n "$away" ] && continue
    HOLD=""; hold_for "$after" "$tags" "" "$f"
    [ -z "$HOLD" ] || continue
    rank="$(awk -F'\t' -v c="$cls" '$1 == c { print $2 }' <<<"$ranks")"
    case "$pri" in urgent) p=0 ;; normal) p=2 ;; low) p=3 ;; *) p=1 ;; esac
    printf '%s\t%s\t%s\t%s\t%s\n' "${rank:-9}" "$p" "$f" "$slug" "$cls"
  done < <([ ! -d "$AQ_DIR/queued" ] || find "$AQ_DIR/queued" -maxdepth 1 -name '*.md' ! -name '.*' -printf '%T@\t%p\n' | header_rows) |
    sort -t$'\t' -k1,1n -k2,2n -k3,3 | awk -F'\t' -v OFS='\t' 'NR == 1 { print $3, $4, $5 }'
}

# desk_wait <resource> <tags> <file> -> sets HOLD while that free resource goes to another waiter
# first: one start per release, the best-ranked, where every waiter used to start and race for the
# claim. A desk:auth item waits while the human is away, since nobody can answer its prompt.
desk_wait() {
  local head
  [ -n "$3" ] || return 0
  if [ "$(desk_class "$2")" = auth ] && human_away; then
    HOLD="hold:$1 (desk:auth waits for the human, away)"; return
  fi
  memo "desk-start:$1" desk_starting "$1"
  [ -z "$MEMO_V" ] || { HOLD="hold:$1 (behind $MEMO_V, starting)"; return; }
  memo "desk:$1" desk_head "$1"; head="$MEMO_V"
  [ -n "$head" ] && [ "${head%%$'\t'*}" != "$3" ] || return 0
  head="${head#*$'\t'}"
  HOLD="hold:$1 (behind ${head%%$'\t'*}, ${head#*$'\t'})"
}

# hold_resource <name> -- an agent-hold resource name: one path segment of letters, digits, . _ -.
hold_resource() { [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] && [ "$1" != . ] && [ "$1" != .. ]; }

# hold_pending <resource> [<names>] -> who holds that agent-hold resource and why, or nothing once it is
# free or grants one of <names> (grant_names: the work's row, epic and plan ids).
# Asked as no session (check --no-caller): the session the item will start does not exist yet,
# so the asker's own claim or grant is not one it would have. A resource a session needs (the
# mac-mini desktop, claimed by another) is waited on here instead of by a session polling or
# guessing an at: time: on 2026-11-06 a store-forms item needed mac-desktop while a session with
# no queue item held it, so there was nothing to put it after:. A failing agent-hold holds.
hold_pending() {
  local out rc
  # shellcheck disable=SC2086 # <names> is a word list: one --for name each
  out="$("$AQ_HOLD" check "$1" --no-caller ${2:+--for $2} 2>/dev/null)"; rc=$?
  [ "$rc" -ne 0 ] || return 0
  [ "$rc" -eq 1 ] && [ -n "$out" ] || { echo "agent-hold check failed, exit $rc"; return; }
  printf '%s\n' "${out#held: "$1" }"
}

# rbw_pending <folder>/<name> <rbw_listing output> -> why that Bitwarden entry still holds an item, or
# nothing once rbw lists it (folder up to the first /). rbw_listing reads the list: read-only, so it never prompts and never reads a secret: only
# `rbw unlocked` and `rbw list --fields folder,name`, never get, unlock or sync (Auth-State Safety);
# rbw-agent's own sync brings a new entry in. Locked, missing or slow rbw (AQ_RBW_TIMEOUT_S, so a hung
# rbw-agent cannot stall a listing or a dispatch pass) holds, and the list says so. The item that deploys a key
# is filed with the ask to add it: keys added to rbw for trader on 2026-11-12 sat undeployed until asked.
rbw_pending() {
  case "$2" in listed | listed$'\n'*) ;; *) echo "$2"; return ;; esac
  grep -qxF -- "${1%%/*}"$'\t'"${1#*/}" <<<"${2#listed}" || echo "not in rbw yet"
}

# rbw_listing -> "listed" then rbw's folder/name list, or why it could not be read (rbw_pending).
rbw_listing() {
  local out
  timeout "$AQ_RBW_TIMEOUT_S" "$AQ_RBW" unlocked </dev/null >/dev/null 2>&1 || { echo "rbw locked or missing"; return; }
  out="$(timeout "$AQ_RBW_TIMEOUT_S" "$AQ_RBW" list --fields folder,name </dev/null 2>/dev/null)" || { echo "rbw list failed"; return; }
  printf 'listed\n%s\n' "$out"
}

# ask_pending <id>[=<option>[+<option>]] -> why that agent-ask still holds an item, or nothing once
# it is answered: with one of those options when named (the answer's first word, else the one
# option the answer names, agent-ask answer-names), or in free text, an answer that names no option,
# which reaches the work through the item's brief (fleet-dispatch ask_decisions). A phase gated on the
# human's decision (live money, a vendor) is queued behind its ask instead of held by an open
# session: on 2026-11-06 trader-real-money-plan sat 6h+ refusing to queue phases that would have
# started on their own. Pending, cancelled, no such ask, an empty answer, an answer naming another
# option or several, and any other answer to an ask that lists no options all hold. 2026-11-12: three
# Shape City items failed on free-text answers to e76omL, xTxBqv and zIi8Xc.
# gate: aq-ask-pending
ask_pending() {
  local id="${1%%=*}" want="" f st ans names
  [[ "$1" == *=* ]] && want="${1#*=}"
  [[ "$id" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "not an ask id"; return; }
  f="$(compgen -G "$AQ_ASKS/*/$id.md" | awk 'NR==1')"
  [ -n "$f" ] || { echo "no such ask"; return; }
  st="$(sed -n '/^status: /{s///p;q;}' "$f")"
  [ "$st" = answered ] || { echo "${st:-unreadable}"; return; }
  # Any answer releases: the human's, the judge's or an agent's. Who may answer is agent-ask's call
  # (an approval, a judge human-only ask or one at the human floor takes only the human's), so the
  # gate does not ask again. 2026-11-23: routine retry and drop asks held 40+ rows on the human.
  [ -n "$want" ] || return 0
  ans="$(sed -n '/^answer: /{s///p;q;}' "$f")"; ans="${ans%% *}"; ans="${ans%[.,;:!]}"
  case "+${want,,}+" in *"+${ans,,}+"*) return 0 ;; esac
  if [ -n "$ans" ] && [ -n "$(ask_options "$id")" ]; then
    names="$(AGENT_ASK_ROOT="$AQ_ASKS" "$AQ_ASK" answer-names "$id" 2>/dev/null)" || names="unreadable"
    [ -n "$names" ] || return 0
    case "$names" in *$'\n'*) ;; *) case "+${want,,}+" in *"+${names,,}+"*) return 0 ;; esac ;; esac
  fi
  echo "answered ${ans:-nothing}, not $want"
}

# ask_options <id> -> the ask's answer vocabulary, one option per line; nothing when it has none.
ask_options() {
  local f; f="$(compgen -G "$AQ_ASKS/*/${1%%=*}.md" | awk 'NR==1')"
  [ -n "$f" ] || return 0
  sed -n '/^options: */{s///p;q;}' "$f" | tr '|' '\n'
}

# nightly_pending <repo> <local stamp> [<day>] -> what that day's scheduled runs of that repo still wait
# for (day: the item's at: date, else the stamp's), or nothing when every one has finished or passed its
# slot plus timeout (a missing run is the triage's red). A missing or stale state file, or schedules-sync
# failing, holds. The day is the at: date so a finished night stays released after midnight.
nightly_pending() {
  local out
  out="$(SCHEDULES_NOW="$(date -d "${2/T/ }" +%s)" "$AQ_SCHEDULES" pending "$1" ${3:+--day "$3"} 2>/dev/null)" && return 0
  printf '%s\n' "${out:-schedules state unreadable}"
}

# pr_state <owner/repo#N> -> the PR's state (MERGED, OPEN, CLOSED) from its forge (so_pr_view: a
# Forgejo-canonical repo, home-config, from Forgejo's API, else gh), or nothing when it cannot say,
# which holds the item. MERGED never changes, so it is cached for good; any other answer, a failed
# read included, for AQ_PR_TTL seconds, so a list or a dispatch pass costs one call per PR. Why: a
# Forgejo PR read through gh failed on every pass, uncached: 5,241 REST calls on 2026-11-14.
pr_state() {
  local ref="$1" f state
  f="$AQ_PR_CACHE/$(printf '%s' "$ref" | tr '/#' '__')"
  if [ -f "$f" ]; then
    state="$(cat "$f")"
    if [ "$state" = MERGED ] || [ $(( $(date +%s) - $(stat -c %Y "$f") )) -lt "$AQ_PR_TTL" ]; then
      echo "$state"; return
    fi
  fi
  state="$(so_pr_view "$ref" "$(so_pr_dir "$ref")" state .state)" || state=""
  mkdir -p "$AQ_PR_CACHE" && printf '%s\n' "$state" > "$f"
  echo "$state"
}

# HDR_AWK: the awk function both header readers (header_rows, item_recs) split a line by, as fm_get
# reads a key: hdr(line) is true for a `key: value` line and sets HK to the key, up to the first
# colon (never empty), and HV to the value with its leading spaces dropped.
HDR_AWK='function hdr(line,  i) { i = index(line, ":"); if (i < 2) return 0
  HK = substr(line, 1, i - 1); HV = substr(line, i + 1); sub(/^ +/, "", HV); return 1 }'

# header_rows < "<mtime>\t<file>" lines -> one line per file, fields split by \x1f: the file, its
# mtime, then the first slug, finished, status, after, tags, project, mode, phases, weight and
# priority of its header (HDR_AWK).
header_rows() {
  awk -F '\t' "$HDR_AWK"'{
    f = $2; delete h
    while ((getline line < f) > 0 && line != "---") if (hdr(line) && !(HK in h)) h[HK] = HV
    close(f)
    printf "%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n", f, $1, h["slug"], h["finished"],
      h["status"], h["after"], h["tags"], h["project"], h["mode"], h["phases"], h["weight"], h["priority"] }'
}

# queue_index active | done [slug...] -> header_rows for every item file in the active states, or
# in done/, there only the files named for these slugs when some are given (as slug_files narrows):
# one find, one awk.
queue_index() {
  local d=() s n=()
  if [ "$1" = done ]; then
    shift
    for s in "$@"; do [ ${#n[@]} -eq 0 ] || n+=(-o); n+=(-name "*$s*.md"); done
    [ ${#n[@]} -gt 0 ] || n=(-name '*.md')
    [ ! -d "$AQ_DIR/done" ] ||
      find "$AQ_DIR/done" -mindepth 2 -maxdepth 2 \( "${n[@]}" \) ! -name '.*' ! -path "$AQ_DIR/done/.*" -printf '%T@\t%p\n'
  else
    for s in $ACTIVE; do [ -d "$AQ_DIR/$s" ] && d+=("$AQ_DIR/$s"); done
    [ "${#d[@]}" -eq 0 ] || find "${d[@]}" -maxdepth 1 -name '*.md' ! -name '.*' -printf '%T@\t%p\n'
  fi | header_rows
}

# index_load -> fills the caller's index (items_json declares it) from queue_index: QI_LIVE, the
# slugs with a live item; QI_ST and QI_FIN, each slug's latest done status and finish, the item
# latest_done picks (finished, then mtime, then path); and by file QI_AFTER, QI_TAGS and, for an
# item with no weight line, QI_WMETA (project, mode and phases). done/ holds most of the queue, so
# a listing of active items reads there only the files of the slugs its items wait on.
index_load() { # <listed file>...
  local f s
  local -A want=()
  index_rows "$(queue_index active)"
  for f in "$@"; do
    case "$f" in "$AQ_DIR"/done/*) index_rows "$(queue_index done)"; return ;; esac
    for s in ${QI_AFTER[$f]-}; do want[$s]=1; done
  done
  [ ${#want[@]} -eq 0 ] || index_rows "$(queue_index done "${!want[@]}")"
}
index_rows() { # <queue_index output>
  local f m slug fin st after tags project mode phases w key
  local -A latest=()
  while IFS=$'\x1f' read -r f m slug fin st after tags project mode phases w _; do
    [ -n "$f" ] || continue
    if [ -n "$slug" ]; then
      case "$f" in
        "$AQ_DIR"/done/*)
          key="$fin"$'\t'"$m"$'\t'"$f"
          [[ "$key" < "${latest[$slug]-}" ]] || { latest[$slug]="$key"; QI_ST[$slug]="$st"; QI_FIN[$slug]="$fin"; } ;;
        *) QI_LIVE[$slug]=1 ;;
      esac
    fi
    [ -z "$after" ] || QI_AFTER[$f]="$after"
    [ -z "$tags" ] || QI_TAGS[$f]="$tags"
    [ -n "$w" ] || QI_WMETA[$f]="$project"$'\x1f'"$mode"$'\x1f'"$phases"
  done <<<"$1"
}

# item_recs <file>... -> one record per item file for ITEM_JQ, all read by one awk: state, file,
# task and the first weight in its header, then its header keys and values; fields end in \x1f and
# the record in \x1e. Header keys by HDR_AWK; the object keeps the last of a repeated key and the
# rules (after, tags, weight) read the first.
item_recs() {
  printf '%s\n' "$@" | AQ_DONE="$AQ_DIR/done/" awk "$HDR_AWK"'{
    f = $0; task = ""; body = 0; w = ""; sw = 0; kv = ""
    while ((getline line < f) > 0) {
      if (body) { task = task line "\n"; continue }
      if (line == "---") { body = 1; continue }
      if (hdr(line)) { kv = kv HK "\037" HV "\037"; if (HK == "weight" && !sw++) w = HV }
    }
    close(f)
    sub(/\n+$/, "", task)
    if (index(f, ENVIRON["AQ_DONE"]) == 1) st = "done"; else { st = f; sub(/\/[^\/]*$/, "", st); sub(/.*\//, "", st) }
    printf "%s\037%s\037%s\037%s\037%s\036", st, f, task, w, kv }'
}

# The side table (items_json, by file: hold, derived weight, the latest finish of its `after:` items), a \x1d,
# then item_recs records -> a JSON array of items: every header key, plus state, file, task, ready
# and, for a held queued item, hold. `ready` is when the item could first start: queued, or the finish of
# its last `after:` item or the time of its `at:` tag when that came later, so a deliberate hold is not
# read as waiting; none while any hold is pending (after:, at:, ask:, pr:, nightly:, hold:, rbw:). A
# hold that released by an event (ask answered, PR merged) leaves ready at queued: its time is not
# recorded. The one rule for an item's wait: `stats` medians it, the hub shows it, fleet-bench ages the
# queued step from it.
# A queued item whose body's last Blocked or Unblocked heading is `## Blocked ...` (a session's
# blocked note, landing.md) holds on it, so dispatch never starts it and the age check does not age
# it; a later `## Unblocked ...` heading releases it. Why: binks-zai-rate-limit sat 6 days in
# queued/ with a Blocked section, read as runnable and aged as a stuck queue (ar-4471).
# An item with no weight line gets weight_of's answer, so every reader sees a weight, and one with
# no priority line reads high, add's default: a missing key there broke every read of the queue (ar-1399).
# `row` is the "<board>:<key>" of the sheet row the item closes on merge, the board being the item's
# project or the one its `board` key names (project_board): its `row:` (file_story, link_row), else
# the board row it was promoted from (`from: board:`), else no key: an item whose story row was never
# filed writes `row:` empty, and "" as a row broke judge-eval (ar-1551). The one definition agent-land,
# fleet-dispatch and judge-eval read, whatever the item's origin.
# `by` is who started the item's session, the one answer every reader takes (fleet-states.md Owners):
# dispatch (a dispatch run; redispatch is a retired value older items carry), resume (a restore), hand (a hand start
# through fleet-dispatch, a scratch send), ask (ask-resume's headless run of an answered ask, from: ask:<id>).
# An origin this map does not name reads as written; an item with no origin (a --running record, from: session
# or item:<slug>) has no `by`, which every reader takes as not dispatch.
ORIGIN_BY='{"run": "dispatch", "redispatch": "dispatch", "resume": "resume", "hand": "hand", "scratch": "hand", "ask": "ask"}'
ITEM_JQ='def lepoch($s): ($s + ":00Z" | fromdateiso8601) as $l | ($l - (($l | localtime | mktime) - $l)) as $e | $l - (($e | localtime | mktime) - $e);
  def at_ready($tags; $q): [$tags | split(" ")[] | select(startswith("at:")) | ltrimstr("at:")
    | try (if test("^[0-9]{4}-") then lepoch(.) else lepoch(($q | fromdateiso8601 | localtime | strftime("%Y-%m-%d")) + "T" + .) end | todate) catch empty];
  split("\u001d") as [$side, $recs]
  | ($side | split("\u001e")[:-1] | map(split("\u001f") | {key: .[0], value: {hold: .[1], weight: .[2], afin: .[3], stack: (.[4] // "")}})
     | from_entries) as $by
  | $recs | split("\u001e")[:-1] | map(split("\u001f")[:-1] as $f | ($by[$f[1]] // {}) as $x
  | ([range(4; $f | length; 2) as $i | {($f[$i]): $f[$i + 1]}] | add // {})
    + {weight: (if $f[3] != "" then $f[3] else $x.weight end), state: $f[0], file: $f[1], task: $f[2]}
    + (if ($x.hold // "") == "" then {} else {hold: $x.hold} end)
    + (if ($x.stack // "") == "" then {} else {stacked_on: $x.stack} end)
  | (if .state == "queued" and (.hold // "") == "" then
      ([.task | scan("(?m)^## (?:[Uu]n)?[Bb]locked\\b[^\n]*")] | last) as $h
      | if $h != null and ($h | test("^## [Bb]locked")) then .hold = "blocked: \"\($h)\" in its body; a later \"## Unblocked\" heading releases it" else . end
    else . end)
  | .priority //= "high"
  | (if (.origin // "") == "" then . else .by = ('"$ORIGIN_BY"'[.origin] // .origin) end)
  | (if (.hold // "") != "" then null
     else ([.queued, (.requeued // empty), ($x.afin // "" | select(. != ""))] + at_ready(.tags // ""; .queued)) | max end) as $due
  | (if $due != null and (.started // "") != "" and $due > .started then .started else $due end) as $ready
  | (if $ready then .ready = $ready else . end)
  | if (.row // "") != "" then . elif (.from // "" | startswith("board:")) then .row = (.from | ltrimstr("board:"))
    else del(.row) end)'

# item_side <file> <after> <tags> <weight> <project> <mode> <phases> <after's finish> -> the file's
# entry in ITEM_JQ's side table, from its header values: the hold of a queued item, a weight for an
# item with no weight line, and the finish of its `after:` item; nothing when all three are empty.
item_side() {
  local d HOLD="" WEIGHT="" HOLD_STACK=""
  case "$1" in
    "$AQ_DIR"/done/*) ;;
    *) d="${1%/*}"; [ "${d##*/}" != queued ] || hold_for "$2" "$3" "$1" ;;
  esac
  [ -n "$4" ] || weight_of "$5" "$6" "$7"
  [ -z "$HOLD$WEIGHT$8$HOLD_STACK" ] || printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1e' "$1" "$HOLD" "$WEIGHT" "$8" "$HOLD_STACK"
}

# items_json [--rows] <jq filter> <file>... -> these items as one JSON array (ITEM_JQ) through the filter.
# --rows derives no hold or weight (no index_load, no item_side), so its ready is not a wait: an item
# carries its header keys, state, file and task alone, for a writer that reads only those (collect_rows).
# A listing reads every header in the queue once (index_load) and the listed files once
# (item_recs), and asks each hold once (memo), never a fork per file or per `after:` slug.
items_json() {
  local rows="" filter f a w p mo ph s afin
  [ "$1" != --rows ] || { rows=1; shift; }
  filter="$1"
  shift
  [ $# -gt 0 ] || { unlock_read; jq -nc "[] | $filter"; return; }
  local -A LIST_MEMO=() QI_LIVE=() QI_ST=() QI_FIN=() QI_AFTER=() QI_TAGS=() QI_WMETA=()
  local LIST_MEMO_ON=1 recs
  [ -n "$rows" ] || index_load "$@"
  recs="$(item_recs "$@")"
  unlock_read
  {
    [ -n "$rows" ] || for f in "$@"; do
      a="${QI_AFTER[$f]-}" w=1 p="" mo="" ph="" afin=""
      for s in $a; do [[ "${QI_FIN[$s]-}" < "$afin" ]] || afin="${QI_FIN[$s]-}"; done
      [ -z "${QI_WMETA[$f]+x}" ] || { w=""; IFS=$'\x1f' read -r p mo ph <<<"${QI_WMETA[$f]}"; }
      item_side "$f" "$a" "${QI_TAGS[$f]-}" "$w" "$p" "$mo" "$ph" "$afin"
    done
    printf '\x1d%s' "$recs"
  } | jq -Rsc "$ITEM_JQ | $filter"
}

# item_json <file> -> that item as one JSON object. One item asks the store for its own `after:` items
# instead of reading the whole queue's index.
item_json() {
  local f m slug fin st a tags project mode phases w d s fs afin="" recs
  IFS=$'\x1f' read -r f m slug fin st a tags project mode phases w _ < <(printf '0\t%s\n' "$1" | header_rows)
  for s in $a; do
    d="$(latest_done "$s")"; [ -n "$d" ] || continue
    fs="$(fm_get "$d" finished)"; [[ "$fs" < "$afin" ]] || afin="$fs"
  done
  recs="$(item_recs "$1")"
  unlock_read
  { item_side "$1" "$a" "$tags" "$w" "$project" "$mode" "$phases" "$afin"; printf '\x1d%s' "$recs"; } |
    jq -Rsc "$ITEM_JQ | .[]"
}

# Queue order: a `red` item first (something is broken), then an urgent one, then a `sprint` one (its row
# is held by an open sprint, fleet-dispatch promote), then priority; inside each of those buckets the
# class mix (MIX_JQ) when AQ_CLASSES is on; then queued time. No project rank: the order comes from the
# item and its row, and a project's share of starts is fleet-dispatch's DISPATCH_PROJECT_SHARE cap.
# The one queue order: every reader (next, list, fleet-dispatch next_items) takes it as is, so a lower
# tier starts only when no item of a higher one can: a pass takes the first it can place.
# `after` and other tags hold, not reorder. Cleanup gets its turns from the mix's cleanup share.
# An item that works an open board row ranks by that row's priority (row_prio, from row_prios), so a
# retag re-ranks it and the item's own line is only the fallback when notes cannot answer (ar-3011).
# Two keep their own: a red, whose priority its filer set, and a cleanup item on a #low row, which
# dispatch promotes at high (fleet-dispatch row_priority) and so still ranks high.
# A red outranks urgent on purpose: the human's rule is that anything broken goes first.
ORDER='def untagged($t): ((.tags // "") | if type == "array" then join(" ") else tostring end
    | [splits("\\s+")] | index([$t])) == null;
  def row_prio: ($rowprio[.row // ""]) as $r
    | if $r == null or (untagged("red") | not) then .
      elif $r == "low" and (untagged("cleanup") | not) then .priority = "high"
      else .priority = $r end;
  def bucket: [untagged("red"), (.priority != "urgent"), untagged("sprint"),
    ({"urgent":0,"high":1,"normal":2,"low":3}[.priority] // 1)];
  (if $rowprio == null then . else map(row_prio) end)
  | if $mix == null then sort_by(bucket, .queued) else mix($mix; bucket) end'

# Classes of service (AQ_CLASSES, plan can-we-move-our-mellow-sphinx P3): an item is in the first class
# whose `tags` it carries, else whose `from` it came from, else whose `projects` holds its project,
# else whose `kinds` holds its row type
# (`type:`, which `add` stamps from `notes row parse`), else the `default` class. Match a cleanup class
# by kind, not by the `cleanup` tag: fleet-dispatch puts that tag on every kinds.json cleanup kind, fix
# included. Inside a bucket the items interleave by class: each next place goes to the class whose count
# is lowest against its `share`, the count being its items started in the last `window_days` (mix_json)
# plus the places this order already gave it; ties go in file order, and the oldest item of the class
# takes the place. Counts carry from bucket to bucket; a held item takes a place and adds no count, as
# it starts nothing (next skips it). A class with no share goes after every class with one, and a
# class with nothing in the bucket takes no place, so its turns go to the rest by their shares.
# `lag_places` bounds what the window's history can do (the human, ask EF60vp: elastic, no rigidness):
# at each bucket's start every class with a runnable item in it has its count cut to at most
# lag_places / (sum of shares) above the lowest count/share among them, as CFS places a waking task
# near min_vruntime; a class with only held items there sets no floor, as it starts nothing. The cut
# count carries into the next bucket like any other. So a class served a lot this week waits about
# lag_places places at most, and one served little gets at most lag_places * share / (sum of shares)
# places ahead. Shares are weights: the bound divides by their sum. No lag_places is no bound. A class with a `min_live`
# (a whole number, ar-3943) that has fewer live items (running or waiting, plus the places this order already
# gave it) goes first among the classes with a startable head item in its bucket, ahead of the shares,
# and that item carries `short: true` for fleet-dispatch (pick_item keeps run units for it). It ranks and
# starts nothing past the pace target. An AQ_CLASSES not
# `on: true`, or unreadable, is no mix.
AQ_CLASSES="${AGENT_QUEUE_CLASSES:-$HOME/.config/fleet-dispatch/classes.json}"
CLASS_JQ='def class_of($cs): ((.tags // "") | if type == "array" then join(" ") else tostring end | [splits("\\s+")]) as $tg
  | (.from // "") as $f
  | (.project // "") as $p
  | (.type // "") as $k
  | ([$cs[] | select(any(.tags[]?; . as $t | $tg | index([$t]) != null))][0]
     // [$cs[] | select(any(.from[]?; . == $f))][0]
     // [$cs[] | select(any(.projects[]?; . == $p))][0]
     // [$cs[] | select(any(.kinds[]?; . == $k))][0]
     // [$cs[] | select(.default == true)][0]
     // {name: "none"}).name;'
MIX_JQ='def mix($m; bucket): ($m.classes | map(.name)) as $names
  | ($m.classes | map({(.name): (.share // 0)}) | add) as $share
  | ([$share[] | select(. > 0)] | add // 0) as $sum
  | ($m.classes | map({(.name): (.min_live // 0)}) | add) as $minlive
  | def ratio($c; $n): if ($share[$c] // 0) > 0 then (($n[$c] // 0) / $share[$c]) else infinite end;
  def short($c; $s): ($minlive[$c] // 0) > (($s.l[$c]) // 0) and $s.q[$c][0].hold == null;
  def bound: if $m.lag_places == null or $sum == 0 then . else
      (.q | to_entries | map(select(($share[.key] // 0) > 0 and any(.value[]; .hold == null)) | .key)) as $in
      | if ($in | length) == 0 then . else
          . as $s | (($in | map(ratio(.; $s.n)) | min) + $m.lag_places / $sum) as $top
          | reduce $in[] as $c (.; .n[$c] = ([(.n[$c] // 0), $top * $share[$c]] | min))
        end
    end;
  reduce (group_by(bucket)[] | sort_by(.queued)) as $b ({out: [], n: $m.done, l: ($m.live // {})};
    .q = ($b | map({c: class_of($m.classes), i: .}) | group_by(.c) | map({key: .[0].c, value: map(.i)}) | from_entries)
    | bound
    | until((.q | map(length) | add // 0) == 0;
        . as $s
        | ($s.q | to_entries | map(select(.value | length > 0) | .key)
           | min_by(. as $c | [(if short($c; $s) then 0 else 1 end), ratio($c; $s.n), ($names | map(. == $c) | index(true) // 1e9)])) as $c
        | short($c; $s) as $short
        | .q[$c][0] as $it
        | .out += [if $short and $it.hold == null then $it + {short: true} else $it end] | .q[$c] |= .[1:]
        | if $it.hold == null then .n[$c] = ((.n[$c] // 0) + 1) | .l[$c] = ((.l[$c] // 0) + 1) else . end)
    | del(.q))
  | .out;'

# class_cfg [--mix] -> AQ_CLASSES on one line: a class list, a window_days of whole days (default 7)
# a lag_places, when set, of a number not below 0, and a min_live per class, when set, of a whole number not below 0. Plain, it is the order's config and needs
# `on: true`; --mix (agent-queue mix) takes it on or off and also needs a starve_days of whole days
# (default 3) inside the window. Only mix checks starve_days, so
# a bad watch setting never turns the order off. Any other file fails, printing nothing.
class_cfg() {
  jq -ce --argjson mix "$([ "${1:-}" = --mix ] && echo true || echo false)" 'def days: type == "number" and . >= 1 and . == floor;
    select(($mix or .on == true) and (.classes | type) == "array" and (.classes | length) > 0 and (.window_days // 7 | days)
      and (.lag_places == null or (.lag_places | type == "number" and . >= 0))
      and all(.classes[]; .min_live == null or (.min_live | type == "number" and . >= 0 and . == floor))
      and (($mix | not) or ((.starve_days // 3 | days) and (.starve_days // 3) <= (.window_days // 7))))' \
    "$AQ_CLASSES" 2>/dev/null
}

# class_started <cfg> -> {window: {<class>: n}, recent: {<class>: n}, live: {<class>: n}} (live: those running or waiting): each class's started items that
# closed in the last window_days or are still running, waiting or in review (the mix's count, so a
# class that just started one is not picked again as if it had not), and of those the ones started in
# the last starve_days. It reads without the lock: an item moves between states by a rename and a write
# rewrites it by one, so a race miscounts one item at worst, and a second lock wait per listing would
# double every list's wait under load (a held lock made each 10 s on 2026-11-18).
class_started() {
  local cfg=$1 days FILES=()
  days="$(jq -r '.window_days // 7' <<<"$cfg")"
  list_files done --since "$(since_day "$((days - 1))")" running waiting review
  items_json --rows "$CLASS_JQ $cfg"' as $cfg | (now - ($cfg.starve_days // 3) * 86400) as $cut
    | def count: group_by(.c) | map({(.[0].c): length}) | add // {};
    [.[] | select((.started // "") != "")
      | {c: class_of($cfg.classes), live: (.state == "running" or .state == "waiting"),
         recent: ((.started | sub("\\.[0-9]+"; "") | fromdateiso8601? // 0) >= $cut)}]
    | {window: count, recent: (map(select(.recent)) | count), live: (map(select(.live)) | count)}' "${FILES[@]}"
}

# mix_json -> the class config plus `done`, class_started's window counts (MIX_JQ's base); null when
# AQ_CLASSES is not `on` or class_cfg refuses it.
mix_json() {
  local cfg
  cfg="$(class_cfg)" || { echo null; return 0; }
  class_started "$cfg" 2>/dev/null | jq -c --argjson cfg "$cfg" '$cfg + {done: .window, live: .live}' 2>/dev/null || echo null
}

# mix [--json] -> each class of service (AQ_CLASSES, on or off): its share, its `projects` (fleet-dispatch's
# project floor reads them), its runnable items (queued,
# no hold: what admission counts), its items started in window_days (class_started, what the mix
# balances on) and that as a percent of every class's, and `starved`, each class with runnable items
# and none started in starve_days. fleet-bench pipeline shows it; `pipeline --check mix` trips on a starved class.
cmd_mix() {
  local json='' cfg q s out
  case "${1:-}" in --json) json=1 ;; '') ;; *) die "unknown option: $1" ;; esac
  cfg="$(class_cfg --mix)" || die "$AQ_CLASSES has no class list, a window_days or starve_days that is not whole days inside the window, a lag_places that is not a number of 0 or more, or a class min_live that is not a whole number of 0 or more"
  q="$(snap_json "$CLASS_JQ $cfg"' as $cfg | [.[] | select(.hold == null) | class_of($cfg.classes)]
    | group_by(.) | map({(.[0]): length}) | add // {}' queued)" || die "the queue could not be read"
  s="$(class_started "$cfg")" || die "the started items could not be read"
  out="$(jq -nc --argjson cfg "$cfg" --argjson q "$q" --argjson s "$s" '([$s.window[]] | add // 0) as $total
    | {on: ($cfg.on == true), window_days: ($cfg.window_days // 7), starve_days: ($cfg.starve_days // 3),
       classes: [$cfg.classes[] | .name as $n
         | {name: $n, share: (.share // 0), projects: (.projects // []), runnable: ($q[$n] // 0), live: ($s.live[$n] // 0), min_live: (.min_live // 0), started: ($s.window[$n] // 0), recent: ($s.recent[$n] // 0),
            pct: (if $total > 0 then ($s.window[$n] // 0) * 100 / $total | round else null end)}]}
    | .starved = [.classes[] | select(.runnable > 0 and .recent == 0) | .name]')"
  [ -z "$json" ] || { printf '%s\n' "$out"; return 0; }
  jq -r 'def r($w): tostring | " " * ($w - length) + .;
    "mix (\(if .on then "on" else "off" end)): items started in \(.window_days)d against each class share",
    "class        share  started    pct  runnable  started \(.starve_days)d  live/min",
    (.classes[] | "\(.name + "          " | .[0:10]) \("\(.share)%" | r(7)) \(.started | r(8)) \(if .pct == null then "-" else "\(.pct)%" end | r(6)) \(.runnable | r(9)) \(.recent | r(10))  \(if .min_live > 0 then "\(.live)/\(.min_live)" else "\(.live)" end | r(8))"),
    (if (.starved | length) > 0 then "starved: \(.starved | join(", ")) (runnable, none started in \(.starve_days)d)" else "starved: none" end)' <<<"$out"
}

# order_filter <states...> -> ORDER with $rowprio (row_prios) bound. A listing with queued items binds
# $mix (mix_json); any other orders without it, so a read of running or done items pays no read of done/.
order_filter() {
  local mix=null rows
  [[ " $* " != *" queued "* ]] || mix="$(mix_json)"
  rows="$(row_prios "$@")"
  printf '%s %s %s as $mix | %s as $rowprio | %s' "$CLASS_JQ" "$MIX_JQ" "${mix:-null}" "${rows:-null}" "$ORDER"
}

# row_prios <states...> -> {"<board>:<id>": priority} of each open board row an item in those states
# (done aside) works (its row: or from: board: header, ITEM_JQ's .row), one `notes board --json` read,
# or nothing when no item works a row or notes cannot answer (each item then keeps its own line). The
# row is where an item's priority lives (ar-3011): ORDER's row_prio reads it, so a retag re-ranks the
# item. Only the rows items work: the map is bound into the jq program text, and the whole board's
# (4,700 rows) was past the kernel's argument limit, so every ordered list failed. An untagged row reads
# normal in the feed, as fleet-dispatch row_priority maps it.
row_prios() {
  local keys s f files=()
  for s in "$@"; do
    case "$s" in queued | running | waiting | review) for f in "$AQ_DIR/$s"/*.md; do [ ! -e "$f" ] || files+=("$f"); done ;; esac
  done
  [ "${#files[@]}" -gt 0 ] || return 0
  keys="$(awk 'FNR == 1 { fm = 1 } /^---$/ { fm = 0 } fm && sub(/^(row|from): *(board:)?/, "") { sub(/[ \t\r]+$/, ""); if (index($0, ":")) print }' \
    "${files[@]}" /dev/null 2>/dev/null | sort -u)"
  [ -n "$keys" ] || return 0
  notes board --json 2>/dev/null | jq -c --arg keys "$keys" '($keys | split("\n") | map({(.): true}) | add) as $want
    | [.rows[]? | select((.state == "open" or .state == "doing") and .project != null and .id != null
      and (.priority == "urgent" or .priority == "high" or .priority == "normal" or .priority == "low"))
      | {key: "\(.project):\(.id)", value: .priority}
      | select($want[.key])] | from_entries' 2>/dev/null
}

# row_prio_write <file> <priority> -- put the item's new priority on its board row through notes (`ptask
# tag --add`, which replaces the row's one priority tag), as gate_row writes a tag, so the row the
# queue order reads (row_prios) says it too. An item with no row has only its own line. Says the
# command to run by hand when notes fails.
row_prio_write() {
  local row prof
  row="$(item_row "$1")" prof="$(fm_get "$1" profile)"
  [ -n "$row" ] || return 0
  gate_row "$row" "$prof" "$(fm_get "$1" lane)" "$2" ||
    echo "agent-queue: board row ${row#*:} still has its old priority, which the queue order reads: $GATE_HINT" >&2
}

# since_day <value> -> the local day a --since names: YYYY-MM-DD as given, Nd or N that many days
# ago (up to 4 digits: date reads a longer run, like 20261114, as a time of day); anything else
# dies. list_files compares days as strings, so an unparsed `7d` sorted after every day and read
# no done item: stats said done_24h 0 against 274 (ar-2430).
since_day() {
  if [[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] && date -d "$1" +%F >/dev/null 2>&1; then
    printf '%s\n' "$1"
  elif [[ "$1" =~ ^([0-9]{1,4})d?$ ]]; then
    date -d "$((10#${BASH_REMATCH[1]})) days ago" +%F || die "--since $1: date could not count back"
  else
    die "--since is a day (YYYY-MM-DD) or days back (7d or 7), not '$1'"
  fi
}

# list_files <states...> [--date D] [--since D] -> appends the caller's FILES with the item files in
# those states, each state oldest first; done is one day (--date, today by default) or every day
# from --since on, which wins.
list_files() {
  local states=() date="" since="" s d n f
  while [ $# -gt 0 ]; do
    case "$1" in --date) date="$2"; shift 2 ;; --since) since="$2"; shift 2 ;; *) states+=("$1"); shift ;; esac
  done
  for s in "${states[@]}"; do
    if [ "$s" = "done" ] && [ -n "$since" ]; then
      for d in "$AQ_DIR"/done/*/; do
        n="${d%/}"; n="${n##*/}"
        [ -d "$d" ] && [[ ! "$n" < "$since" ]] || continue
        for f in "$d"*.md; do [ -e "$f" ] && FILES+=("$f"); done
      done
    elif [ "$s" = "done" ]; then
      for f in "$AQ_DIR/done/${date:-$(date +%F)}"/*.md; do [ -e "$f" ] && FILES+=("$f"); done
    else
      while IFS= read -r f; do FILES+=("$f"); done < <(items_in "$AQ_DIR/$s")
    fi
  done
}

# snap_json <jq filter> <states...> [--date D] [--since D] -> items_json of those states. With no
# lock held it takes the shared one for the listing and the read alone (items_json lets it go), so it
# runs where it reads: a $(...) cannot let go of a lock its parent holds.
snap_json() {
  local rows="" filter FILES=()
  [ "$1" != --rows ] || { rows=--rows; shift; }
  filter="$1"
  shift
  [ -n "${AQ_HELD-}" ] || lock_read
  list_files "$@"
  items_json $rows "$filter" "${FILES[@]}"
}

# collect <states...> [--date D] [--since D] -> a JSON array of items, in queue order.
collect() { snap_json "$(order_filter "$@")" "$@"; }

# collect_rows <states...> -> collect for a writer that reads only an item's slug, row and plan
# under the exclusive lock (link_row, repoint_row, add_plan): no hold, weight, ready or order is
# derived, which asked gh, rbw and asks for every queued item, about 2.5 s on 611 items (ar-2544).
collect_rows() { snap_json --rows . "$@"; }

# header_set <file> <key> <value> -> rewrite the header field in place, atomically.
header_set() {
  local f="$1" k="$2" v="$3" tmp
  case "$v" in *$'\n'*) die "a value cannot span lines: $k" ;; esac
  tmp="$(mktemp "$(dirname "$f")/.set.XXXXXX")" || die "cannot write in $(dirname "$f")"
  # The value rides in the environment: awk -v would read a backslash in a free-text value as an escape.
  HV="$v" awk -v k="$k" '
    !done && $0 == "---" { if (!seen) print k ": " ENVIRON["HV"]; done = 1; print; next }
    !done && index($0, k ":") == 1 { print k ": " ENVIRON["HV"]; seen = 1; next }
    { print }' "$f" > "$tmp" && mv -- "$tmp" "$f"
}

# header_del <file> <key>... -> drop those header fields in place, atomically.
header_del() {
  local f="$1" tmp; shift
  tmp="$(mktemp "$(dirname "$f")/.del.XXXXXX")" || die "cannot write in $(dirname "$f")"
  awk -v ks="$*" '
    BEGIN { n = split(ks, k, " ") }
    !done && $0 == "---" { done = 1 }
    !done { for (i = 1; i <= n; i++) if (index($0, k[i] ":") == 1) next }
    { print }' "$f" > "$tmp" && mv -- "$tmp" "$f"
}

# move_to <file> <state> -> the new path. done/ is dated by today, and a name that is already
# there (the same slug finished twice in a day) gets a numeric suffix.
move_to() {
  local f="$1" to="$2" dir name dest n=2
  if [ "$to" = "done" ]; then dir="$AQ_DIR/done/$(date +%F)"; else dir="$AQ_DIR/$to"; fi
  mkdir -p "$dir"
  name="$(basename "$f" .md)"; dest="$dir/$name.md"
  while [ -e "$dest" ]; do dest="$dir/$name-$n.md"; n=$((n + 1)); done
  mv -- "$f" "$dest" && printf '%s\n' "$dest"
}

# project_resolve <name> -> the project an item is filed under, or nothing when dispatch could not
# start it: another spelling becomes its project (project_lookup; an unknown name stays as given), a repo key with an `owner` in
# the registry becomes that lab project (dotfiles has no sheet; its work counts on agent-runtime's),
# and the project must reach a checkout through the registry (project-name.sh's project_repo_path).
# A game inside a repo is runnable; a notes-only project is not. With no map there is nothing to ask.
project_resolve() {
  [ -f "$AQ_MAP" ] || { printf '%s\n' "$1"; return 0; }
  local name owner
  name="$(project_lookup "$1")" || name="$1"
  owner="$(project_field "$name" owner)"
  name="${owner:-$name}"
  [ -n "$name" ] && [ -n "$(project_repo_path "$name")" ] && printf '%s\n' "$name"
}

# The one resolver of which lab project an item's work counts on, inside a repo that holds several
# (the playground's games, dotfiles' agent-runtime and notes-cockpit): project_credit at add,
# cmd_attribute at land. Both only move an item between projects that share one checkout.

# project_credit <project> <from> <epic> -> the project the item's own evidence names: the sheet its
# row is on (`from: board:<p>:<key>`), else the sheet whose row code the epic id `<code>-<N>`
# carries; when that project shares <project>'s checkout. Else <project>.
project_credit() {
  local p="" dir
  case "$2" in board:*) p="${2#board:}"; p="${p%%:*}" ;; esac
  [ -n "$p" ] || [ -z "$3" ] || p="$(project_of_code "${3%-*}")"
  if [ -n "$p" ] && [ "$p" != "$1" ] && p="$(project_resolve "$p")" &&
    dir="$(project_repo_path "$1")" && [ -n "$dir" ] && [ "$(project_repo_path "$p")" = "$dir" ]; then
    printf '%s\n' "$p"
  else
    printf '%s\n' "$1"
  fi
}

project_of_cwd() {
  local top
  top="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 0
  top="$(dirname "$top")"
  [ -f "$AQ_MAP" ] && jq -r --arg r "$top" '.paths[$r] // empty' "$AQ_MAP" 2>/dev/null
}

# project_board <project> -> "<board><TAB><profile><TAB><row code>" of the lab sheet the project's rows
# go on: the project its `owner` names (dotfiles: its work counts on agent-runtime), else its `board`
# (dotfiles-private -> agent-runtime), else its own, the order project_board in project-name.sh uses.
# Profile and code are empty when that board has no sheet.
project_board() {
  jq -r --arg p "$1" '((.trackers[$p] | objects | (.owner // .board)) // $p) as $b
    | (.trackers[$b] | objects) // {} | [$b, .lab // "", .code // ""] | @tsv' "$AQ_MAP" 2>/dev/null
}

# bare_words < text -> each line without markers or #tags: a row's words, as the board compares them.
bare_words() { sed -E 's/<!--[^>]*-->//g; s/(^| )#[A-Za-z][A-Za-z0-9_/:.-]*//g; s/ +/ /g; s/^ //; s/ $//'; }

# row_brief <row words> <body> -> the brief a row holds for the task <body>: the body whole, markers
# off (an unclosed one cut at its opener), less its first line when that line is the row's own
# words, so a one-line task adds no brief and a long title the row was cut from stays whole. The
# row is the task's one record (QUEUE.md); notes stores a brief line shaped like a task escaped, so
# a checklist in it is never a child row.
row_brief() {
  local body first rest
  body="$(sed -E 's/<!--[^>]*-->//g; s/<!--.*$//; s/^.*-->//' <<<"$2")"
  first="$(head -1 <<<"$body")" rest="$(tail -n +2 <<<"$body")"
  if [ "$(bare_words <<<"$first")" = "$(bare_words <<<"$1")" ]; then printf '%s' "$rest"; else printf '%s' "$body"; fi
}

# overflow_row <project> <title> <priority> <epic> <want> <task> <gates> <name> [<tags>] -- an add the queue does
# not take leaves its board row un-started, ranked as filed (`#requested` first) with the whole task under
# it as its brief, carrying <gates> (board gate tags, no #) when it waits on any, and says so on stderr, and
# prints `held <name> -> <board>:<id>` on stdout, the line every caller reads the row from (never stderr). A project
# with no board to file on gets the command to run by hand and a non-zero return: the caller still holds
# the task, and nothing was written.
overflow_row() {
  local kept board prof id gates="${7:-}"
  kept="$(file_story "$1" "$2" "$3" "$4" "$5" "$6" keep "$gates" "${9:-}")"
  if [ "$kept" = inbox ]; then
    echo "agent-queue: a session's follow-up is no board row: it is in the outbox, and inbox-triage files it or joins its twin" >&2
    echo "inboxed $8 -> inbox"
  elif [ "$kept" = gated ]; then
    echo "agent-queue: $1's board refused $8 (the reason is above): nothing was filed or kept, so file it again tomorrow, or keep it with notes improve $1" >&2
    return 6
  elif [ -n "$kept" ]; then
    IFS=$'\t' read -r board prof id <<<"$kept"
    if [ -n "$gates" ]; then
      echo "agent-queue: its board row $id on $board waits on #${gates// / #}: dispatch promotes it once that clears" >&2
    else
      echo "agent-queue: its board row $id on $board is left un-started with its rank and brief: dispatch promotes it as the queue drains" >&2
    fi
    echo "held $8 -> $board:$id${gates:+ (#${gates// / #})}"
  else
    echo "agent-queue: $1 has no board row to file this on: notes ptask $1 --agent add \"<type(area): title> #size/s${gates:+ #${gates// / #}}\"" >&2
    return 1
  fi
}

# file_story <project> <title> <priority> <epic> <want> <body> [<keep>] [<gates>] [<tags>] -> "<board><TAB><profile><TAB><id>" of the story row
# the item closes on merge, or nothing, or `gated` when the board's intake gate or daily cap (intake_daily_cap, QUEUE.md "Admission")
# refused the row: a plan's phase or a follow-up past the cap files no row, and its caller files no item either. An item not promoted from the board is still a story on its
# project's agent board, so a task shows under its feature the moment it is added: one `[/]` row
# through `notes ptask` (the rows' one writer), `#of/<epic>` when the item names an epic of this
# project (--epic, or its plan's `epic:` line), else the standing epic of its area's system, which
# `notes ptask` links, at the item's priority, on the board project_board names, with no size: the
# machine load the item runs at was no estimate, so the nightly `agentctl-inbox-triage --backlog --size`
# scores the row. The row is started, so dispatch never promotes it a second time. An open
# row with the same text is linked instead of written twice. A project with no lab sheet or no row
# code files nothing, and a failed write never stops the add. The row is the task: the item's
# <body> is its brief (row_brief), and the item keeps a snapshot of it beside the run.
# A plan phase's row also carries `#takes/<id>` for each row it takes (AQ_ITEM_TAKES, ar-3886).
# <want> is the channel of a human's want, or empty: the notes writer then stamps #requested.
# An empty <priority> files the row untagged: a machine filer's, judged by the priority rubric.
# <keep> non-empty files the row un-started (an add over the cap, see overflow_row). <gates>, board gate
# tags with no #, go on the row it files, and onto an open twin it links (gate_row). <tags>, the item's,
# add `interrupt` to those when they hold it (interrupt_tag), so an open twin joins too.
# Who files it, for `notes ptask add --origin`: a plan's phases (AQ_ITEM_PLAN) file directly,
# and so does the row of an item being worked (<keep> empty:
# its own record, not a follow-up). A kept row from a queue item or runner is its follow-up: notes sends
# it to the outbox (exit 4), and this prints `inbox` instead of a row; from a session the human opened,
# notes checks it first and a shortlist of similar rows (exit 5) is reported on stderr, with no row. `--origin agent-queue` is notes-cli's
# ORIGIN_STORY (ingest.rs): the ingest record marks the row a story, which `notes log --steps` leaves
# out of backlog intake; a want or a plan phase is intake, so its row keeps its own origin.
file_story() {
  local project text="$2" prio="$3" of="" lab code row out rc=0 id brief detail=() want=() origin=() keep="${7:-}" gates="${8:-}" g gt=""
  ! interrupt_tag "${9:-}" || gates+="${gates:+ }interrupt"
  for g in $gates; do gt+=" #$g"; done
  [ -z "${5:-}" ] || want=(--want "$5")
  if [ -n "${5:-}" ]; then :
  elif [ -n "${AQ_ITEM_PLAN:-}" ]; then origin=(--origin plan)
  elif [ -z "$keep" ]; then origin=(--origin agent-queue); fi
  [ -f "$AQ_MAP" ] || return 0
  IFS=$'\t' read -r project lab code < <(project_board "$1")
  [ -n "$lab" ] && [ -n "$code" ] || return 0
  command -v notes >/dev/null || { echo "agent-queue: no story row filed: no notes on PATH" >&2; return 0; }
  [ "${4%-*}" = "$code" ] && of=" #of/$4"
  # A plan phase that takes rows (add_plan sets AQ_ITEM_TAKES) tags its new row #takes/<id> for each: the taken row is handed
  # over. A twin row linked instead of filed keeps its own tags.
  for g in ${AQ_ITEM_TAKES:-}; do [[ "$g" =~ ^[a-z0-9]+-[0-9]+$ ]] && of+=" #takes/$g"; done
  # The row's words: no markers or #tags of the task's own. The board refuses untyped text, so the
  # row is `notes`'s typed form of them, cut to the board's 80.
  text="$(bare_words <<<"$text")"
  [ -n "$text" ] || return 0
  row="$(notes --profile "$lab" ptask "$project" --agent propose -- "$text" 2>&1)" ||
    { echo "agent-queue: no story row filed on $project: ${row##*$'\n'}" >&2; return 0; }
  # `--detail=`: a brief that opens with a dash is its value, not a flag.
  brief="$(row_brief "$row" "${6:-}")"
  [ -z "$brief" ] || detail=("--detail=$brief")
  out="$(notes --profile "$lab" ptask "$project" --agent add "${detail[@]}" "${want[@]}" "${origin[@]}" -- "$row${prio:+ #$prio}$of$gt" 2>&1)" || rc=$?
  id="$(sed -nE '/.*<!--.*\bid:([a-z0-9]+-[0-9]+).*/{s//\1/p;q;}' <<<"$out")"
  case "$rc" in
    4) if [ -n "$keep" ]; then printf 'inbox\n'
       elif [ -n "${5:-}" ]; then echo "agent-queue: no story row filed on $project: a session's want goes to the outbox for triage, so the item has no row" >&2
       else echo "agent-queue: no story row filed on $project: it went to the outbox, so the item has no row: add agent-queue to agent_direct_filers in the notes config" >&2; fi
       return 0 ;;
    5) echo "agent-queue: no story row filed on $project: notes lists similar open rows; join the one that is this work, or file it with notes ptask $project --agent add --checked <their ids>:" >&2
       printf '%s\n' "$out" >&2; return 0 ;;
    0) [ -n "$id" ] || { echo "agent-queue: story row on $project has no id, not linked: ${out##*$'\n'}" >&2; return 0; }
       [ -n "$keep" ] || notes --profile "$lab" ptask "$project" --agent start "$id" >/dev/null 2>&1 ||
         echo "agent-queue: story row $id on $project could not be started" >&2 ;;
    3) [ -n "$id" ] || { echo "agent-queue: no story row filed: ${out##*$'\n'}" >&2; return 0; }
       # The twin is open: start it unless a live item already did, or the row is left on the board.
       if [ -z "$keep" ] && grep -q ': - \[ \] ' <<<"$out"; then notes --profile "$lab" ptask "$project" --agent start "$id" >/dev/null 2>&1; fi
       # shellcheck disable=SC2086 # gates is a space-separated list of tags
       [ -z "$gates" ] || gate_row "$project:$id" "$lab" agent $gates ||
         { echo "agent-queue: the open row $id on $project did not take its gates, so nothing was filed: $GATE_HINT" >&2; return 0; } ;;
    6) # The board's intake gate or its daily cap (notes EXIT_GATED): nothing was written, and the reason is the last line.
       echo "agent-queue: no story row filed on $project: ${out##*$'\n'}" >&2; printf 'gated\n'; return 0 ;;
    *) echo "agent-queue: no story row filed on $project: ${out##*$'\n'}" >&2; return 0 ;;
  esac
  printf '%s\t%s\t%s\n' "$project" "$lab" "$id"
}

# area_held <project> <area> [<slug>] -- warn when another active item of the project already holds the area.
# Dispatch never picks a row on a held area (fleet-dispatch queue_areas); a start by hand (add --running, a
# session's own claim) is the human's call, so it is told who holds it and goes ahead.
area_held() {
  local held
  [ -n "$2" ] || return 0
  held="$(collect_rows $ACTIVE | jq -r --arg p "${1,,}" --arg a "${2,,}" --arg s "${3:-}" '[.[]
    | select((.project | ascii_downcase) == $p and .slug != $s and ((.area // "") | ascii_downcase) == $a)
    | "\(.slug) (\(.state)\(if .session then " in " + .session else "" end))"] | join(", ")')" ||
    { echo "agent-queue: could not check the queue for another item on area $2" >&2; return 0; }
  [ -z "$held" ] || echo "agent-queue: area $2 on $1 is already held by $held; dispatch starts no second session there, so check this is not the same work" >&2
}

# cause_owner <tags> [slug]: refuses when a live item other than <slug> already carries one of <tags>'
# `cause:`, so one red has one owner: triage's red fixes, fix-red's hand-queued ones and a session's
# own claim all come through add, and set and reopen check it too. A later phase of the same plan
# (AQ_ITEM_PLAN, add --plan) is the same work. Under the lock, so two filers cannot both pass.
# gate: aq-cause-owner
cause_owner() {
  local c own rows
  [[ " $1 " == *" cause:"?* ]] || return 0
  rows="$(collect_rows $ACTIVE)" || die "could not check the queue for an item that owns a cause:"
  for c in $1; do
    [[ "$c" == cause:?* ]] || continue
    own="$(jq -r --arg c " $c " --arg s "${2:-}" --arg p "${AQ_ITEM_PLAN:-}" "$PLAN_ITEMS_JQ"' first(.[]
      | select(.slug != $s and ((" " + (.tags // "") + " ") | contains($c)) and ($p == "" or (names_plan($p) | not)))
      | .slug) // empty' <<<"$rows")"
    [ -z "$own" ] || die "$c is already owned by $own: work it there, or take it over with agent-queue claim $own"
  done
}

# link_row <id> <project> -> "<board><TAB><profile><TAB><id>" of an open row on the project's agent board, started
# now, for an item that works a row already filed. Refused when the project has no board, the row is
# not open there, or a live item already names it (two items cannot both close one row). `from:` stays
# the item's origin: a board origin also means dispatch's presence gate and the judge's picks.
link_row() {
  local id="$1" project lab code taken out
  IFS=$'\t' read -r project lab code < <(project_board "$2")
  [ -n "$lab" ] && [ -n "$code" ] || die "--row $id: $2 has no agent board (no lab or code in $AQ_MAP, nor a board key naming one)"
  taken="$(collect_rows $ACTIVE | jq -r --arg r "$project:$id" 'first(.[] | select(.row == $r) | .slug) // empty')" ||
    die "--row $id: could not check the queue for an item on that row"
  [ -z "$taken" ] || die "--row $id: $taken already works that row; to take it over: agent-queue claim $taken"
  command -v notes >/dev/null || die "--row $id: no notes on PATH"
  out="$(notes --profile "$lab" ptask "$project" --agent start "$id" 2>&1)" ||
    die "--row $id: not an open row on the $project agent board: ${out##*$'\n'}"
  printf '%s\t%s\t%s\n' "$project" "$lab" "$id"
}

# named_row <title> -> the one row id (`ucp-134`) the title names as its subject, else nothing and
# rc 1: none, or two that differ. A subject is the first word (`ucp-134: ...`) or an id in brackets
# (`... (ucp-134)`, `[ucp-134]`); an id in the sentence (`after ar-40 lands`) only mentions a row.
# An item added for a row already filed then works that row (link_row, when it is open and no live
# item has it) instead of filing a second one beside it, so the row the human reads closes when
# the work lands (ucp-134 stayed open after its epic shipped, 2026-11-04). cmd_add_one skips it for a plan
# phase (AQ_ITEM_PLAN): its title leads with the phase name, so an id the name starts with is no row it works.
named_row() {
  local ids
  ids="$({ grep -oiE '^[[:space:]]*[a-z]{2,4}-[0-9]+([:[:space:]]|$)' <<<"$1"; grep -oiE '[([][a-z]{2,4}-[0-9]+[])]' <<<"$1"; } |
    tr -cd 'A-Za-z0-9\n-' | tr 'A-Z' 'a-z' | sort -u)"
  [ -n "$ids" ] && [ "$(grep -c . <<<"$ids")" = 1 ] && printf '%s\n' "$ids"
}

# prior_story <slug> <project> -> "<board><TAB><profile><TAB><id>" of the row this slug's last item recorded,
# when that row is still open on this project's board (started now if it was not), else nothing. A re-queue
# keeps its row by its id, not by its words: on 2026-11-06 two re-queued trader phases got second rows
# (tr-76, tr-77) because the first ones were written before rows were typed, so no text matched.
prior_story() {
  local f row prof board
  f="$(latest_done "$1")"; [ -n "$f" ] || return 0
  row="$(item_row "$f")"; prof="$(fm_get "$f" profile)"
  board="$(project_board "$2" | cut -f1)"
  [ "${row%%:*}" = "$board" ] && [ -n "$prof" ] && command -v notes >/dev/null || return 0
  notes --profile "$prof" ptask "$board" --agent start "${row#*:}" >/dev/null 2>&1 || return 0
  printf '%s\t%s\t%s\n' "$board" "$prof" "${row#*:}"
}

# --- verbs ---
# add_priority <priority> <named> <plan> <tags> <from> -> the priority an add files at. <named> is
# non-empty when the caller named one (or adds --running, --want, --dry-run, --check). The high default
# is the human's add by hand. A session decides: high is for what blocks a release or a red on main,
# and a default high from sessions made most of the queue high (ar-2943). A session's plan is
# agent-authored, so its phases are next in line (high) at most; urgent stays for the human's own add
# (no session around it), a red, and dispatch's promote of a row (the row is the source), and a phase
# that takes an urgent row still rises to it (plan_takes_rank). 63 of 85 urgent items in 3 days were
# session plan phases that inherited urgent (ar-4349).
add_priority() {
  local session="${CLAUDE_CODE_SESSION_ID:-}${AGENT_QUEUE_ITEM:-}"
  # A machine filer's plan (--from auto:*) names none: its phases go at normal, so a session that runs
  # the filer, or a dispatch pass that inherited AGENT_QUEUE_ITEM, is not refused for it.
  local filer_plan=''
  [ -z "$3" ] || [[ "$5" != auto:?* ]] || filer_plan=1
  [ -n "$2" ] || [ -z "$session" ] || [ -n "$filer_plan" ] ||
    die "a session's add passes --priority: urgent for what the human needs now, high when it blocks a release or a red on main, normal for real work in its turn, low for upkeep or cleanup"
  if [ -n "$3" ] && [ "$1" = urgent ] && [ -n "$session" ] && [[ " $4 " != *" red "* && "$5" != board:* ]]; then
    echo "agent-queue: a session's plan queues at high at most; urgent is the human's own add or a red" >&2
    echo high
  elif [ -n "$filer_plan" ] && [ -z "$2" ]; then
    echo normal
  else
    echo "$1"
  fi
}

# add_row_prio <file> <priority> -- a row filed before this add (--row, its title's row, a re-queue's
# row) takes the --priority the human's own add named, since the order reads the row (row_prios); a
# story row was filed at it already. A session's add leaves a linked row as it is: every session names
# a priority (ar-2943), and its "low" would demote the human's #urgent row. It retags with bump.
add_row_prio() {
  [ -z "${CLAUDE_CODE_SESSION_ID:-}${AGENT_QUEUE_ITEM:-}" ] || return 0
  [ -n "${AQ_LOCKED-}" ] || unlock # notes writes the row and can be slow; the rest of add only reads
  row_prio_write "$1" "$2"
}

# landing_after <item slug> <text> -> the blockers of <slug>'s own `after:` that would hold a new add, when
# <text> says land and the item has a PR recorded (pr: or open_pr:, landing.md sets it first): the add is
# that item's landing. A landing follow-up its session files without --after carries no trigger, so triage
# files it #low, which ranks last (before ar-4626 the sweep put it on a backlog tier no pass took: ucp-2567, 2568
# and 2569 sat there for 11 hours, 2026-11-21, ar-4451). Gated on what its item waited on, it is pinned
# (gate_open) and pull-after starts it when that blocker closes ok. A blocker that closed or died is no
# gate; one with an open PR still is, since a landing is no plan phase (stack_dependent). Nothing for any other follow-up.
landing_after() {
  local f s out=''
  [ -n "$1" ] && [ -z "${AGENT_QUEUE_PULL:-}" ] || return 0
  f="$(find_item "$1")" && [ -n "$f" ] || return 0
  [ -n "$(fm_get "$f" pr)$(fm_get "$f" open_pr)" ] || return 0
  [[ "$2" =~ (^|[^A-Za-z])[Ll]and(ing)?([^A-Za-z]|$) ]] || return 0
  for s in $(word_list "$(fm_get "$f" after)"); do
    after_status "$s"
    [ -n "$AST" ] || out+="${out:+ }$s"
  done
  printf '%s' "$out"
}

# add_writes_work <add args...> -> exit 0 when the add would file work: anything but a --running
# record or a plan --dry-run/--check, read from the args before any `--`.
add_writes_work() {
  local a
  for a in "$@"; do
    case "$a" in --) break ;; --running | --dry-run | --check) return 1 ;; esac
  done
  return 0
}

# work_machine_guard <add args...> -- a work machine queues nothing: no dispatcher runs there and
# home runners never take work, so an item filed there never starts (project_work_machine).
work_machine_guard() {
  add_writes_work "$@" && project_work_machine || return 0
  die "this is a work machine ($PROJECT_MACHINE_PROFILE): no dispatcher runs here and home runners never take work. Put the follow-up in the project's tracker (ticket), or work it in this session"
}

# cmd_add: an add over the admission cap that already has its row (--row, or a board pull from
# promote) leaves that row where it is. Only one with no row gets an overflow row: a board pull's
# overflow row was a twin that dispatch skipped to the human sheet beside the first (2026-11-25).
cmd_add() {
  local project="" mode=oneshot priority=high tags="" after="" from=human agent=claude slug=""
  local running="" session="" task=() tag planf="" dry="" check="" weight="" title="" epic="" repeat="" from_given="" want="" row="" priority_given=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project="${2:?}"; shift 2 ;;
      --mode) mode="${2:?}"; shift 2 ;;
      --priority) priority="${2:?}"; priority_given=1; shift 2 ;;
      --weight) weight="${2:?}"; shift 2 ;;
      --tags) tags="$(word_list "${2:?}")"; shift 2 ;;
      --after) after="$after ${2:?}"; shift 2 ;;
      --from) from="${2:?}"; from_given=1; shift 2 ;;
      --agent) agent="${2:?}"; shift 2 ;;
      --slug) slug="${2:?}"; shift 2 ;;
      --title) title="$(one_line "${2:?}")"; shift 2 ;;
      --epic) epic="${2:?}"; shift 2 ;;
      --want) want="${2:?}"; ! headless || die "--want names a human's channel; a headless Claude run ($CLAUDE_CODE_ENTRYPOINT) has no human at hand, so its add carries none"; shift 2 ;;
      --row) row="${2:?}"; shift 2 ;;
      --running) running=1; shift ;;
      --session) session="${2:?}"; shift 2 ;;
      --plan) planf="${2:?}"; shift 2 ;;
      --dry-run|--check) dry=1; [ "$1" = --dry-run ] || check=1; shift ;;
      --repeat) repeat=1; shift ;;
      --) shift; task+=("$@"); break ;;
      -*) die "unknown option: $1" ;;
      *) task+=("$1"); shift ;;
    esac
  done
  after="$(word_list "$after")"
  priority="$(add_priority "$priority" "$priority_given$running$want$dry" "$planf" "$tags" "$from")" || exit 1
  if [ -n "$planf" ]; then
    [ "${#task[@]}" -eq 0 ] || die "--plan writes its own tasks; pass no task with it"
    [ -z "$want" ] || die "--want names a human's channel; --plan items are agent-made and carry none"
    [ -z "$row" ] || die "--row links one item; a plan's phases each file a story under its epic: line"
    [ "$mode" = oneshot ] && [ -z "$running" ] || die "--plan items are queued oneshot items: no --mode plan or --running"
    plan_check_markers "$planf" "$check"
    # --from board:<project>:<id> is dispatch's promote of a plan row filed before ar-5605 (its brief is
    # plan_row_task's): that row goes on the plan's `rows:` line (add_plan), which agent-land closes with
    # the last phase, so no phase item names it.
    local plan_row=''
    case "$from" in board:?*:?*) plan_row="${from##*:}" from=auto:plan-row ;; esac
    if [ -z "$dry" ] && ! pull_ok "" "$from" "$from_given" && ! own_plan_item "$planf"; then
      [ -z "$plan_row" ] || { echo "agent-queue: its row $plan_row is left where it is: dispatch promotes it" >&2; exit "$AQ_EX_HELD"; }
      # A caller that may not queue (a dispatched session, reap's reconcile_plans) files the chain itself
      # on the board: each open phase its own row, every later one gated #after/ the row before (add_plan
      # reads each phase's `held` line), which dispatch promotes in turn. No row stands for the whole
      # plan. Why: 97 "run the open phases of plan X" rows sat beside their phase rows or for plans
      # nobody ran, and the ledger dropped 93 of them (ar-5605, plan delightful-leaf P4).
      AQ_ADMITTED=1 plan_add_waiting
      exit "$AQ_EX_HELD"
    fi
    AQ_ADMITTED=1 plan_add_waiting; return
  fi
  [ -z "$dry" ] || die "--dry-run and --check go with --plan"
  local text
  if [ "${#task[@]}" -gt 0 ]; then text="${task[*]}"; elif [ ! -t 0 ]; then text="$(cat)"; fi
  [ -n "$(printf '%s' "${text:-}" | tr -d '[:space:]')" ] || die "no task: pass it as arguments or on stdin"
  case "$mode" in oneshot | plan) ;; *) die "--mode is oneshot or plan, not $mode" ;; esac
  prio_rank "$priority" >/dev/null || die "--priority is urgent, high, normal or low, not $priority"
  case "$weight" in '' | heavy | light) ;; *) die "--weight is heavy or light, not $weight" ;; esac
  [ -z "$running" ] || [ -n "$from_given$want" ] || from="$(running_from)"
  case "$from" in human | session | shepherd | canary | trainee | research:?* | auto:?* | item:?* | ask:?* | board:?*:?*) ;; *) die "--from is human, session, shepherd, canary, trainee, research:<facet>, auto:<filer>, item:<slug>, ask:<id> or board:<project>:<key>, not $from" ;; esac
  case "$agent" in *[!a-z0-9-]* | '') die "--agent is one word, not $agent" ;; esac
  local row_id='^[a-z0-9]+-[0-9]+$'
  [ -z "$epic" ] || [[ "$epic" =~ $row_id ]] || die "--epic is a row id, <code>-<N>, not $epic"
  if [ -n "$row" ]; then
    [[ "$row" =~ $row_id ]] || die "--row is a row id, <code>-<N>, not $row"
    [ -z "$epic$want" ] || die "--epic and --want shape a new story; --row links a row already filed"
    case "$from" in board:* | canary | trainee) die "--row is for an item not promoted from the board and not a canary or trainee review, not --from $from" ;; esac
  fi
  check_tags "$tags"
  # A hand-started session records itself and its window, in a worktree session on any world.
  local window=''
  [ -z "$running" ] || [ -n "$session" ] || IFS=$'\t' read -r session window < <(hand_start)
  session="$(qualified "$session")" || exit 1
  [ -n "$project" ] || project="$(project_of_cwd)"
  [ -n "$project" ] || die "no --project, and this directory is not a repo project-map knows"
  local resolved
  resolved="$(project_resolve "$project")" || die "unknown project: $project (no checkout for it in $AQ_MAP)"
  [ -n "$epic" ] || epic="$(plan_epic "${AQ_ITEM_PLAN:-}")"
  project="$(project_credit "$resolved" "$from" "${row:-$epic}")"
  # A title naming one row (named_row) is linked at the story step, after admission, on the
  # board of the project that row's code credits; a link that fails keeps this project.
  local named='' named_project=''
  if [ -z "$row$epic$want${AQ_ITEM_PLAN:-}" ] && named="$(named_row "${title:-$(head -1 <<<"$text")}")"; then
    named_project="$(project_credit "$resolved" "$from" "$named")"
  fi
  [ -n "$weight" ] || { weight_of "$project" "$mode" "${AQ_ITEM_PHASES:-}"; weight="$WEIGHT"; }
  local slug_from_text=''
  [ -n "$slug" ] || slug_from_text=1
  slug="$(slugify "${slug:-$text}")"
  [ -n "$slug" ] || die "could not derive a slug; pass --slug"
  # The queue holds only work that can start: an add still waiting on a gate (an after: item not done ok,
  # or a hold tag not clear, hold_for) is filed as its board row carrying the gate (#after/<row-id>,
  # #rbw/..., gate_board_tag) and queues nothing; dispatch promotes the row once `gate` reads it clear
  # (QUEUE.md "Admission"). A --running record is already started, so it files no gate: an --after it
  # names must already have closed ok, or the add is refused (ar-3260). Dispatch's pull of a board row
  # (promote) judged that row's gates clear the moment before, so none is read twice.
  local GATES='' AFTER_ITEMS='' AQ_ADD_STACKS="$(add_stacks "$text" "$tags")"
  if [ -n "$running" ] && [ -n "$after" ]; then
    check_after "$after" "$slug"
    start_gate "$slug" "$after" "" "start --running" "add it without --running, and it starts once that clears"
  fi
  if [ -z "$running" ] && { [ -z "${AGENT_QUEUE_PULL:-}" ] || [[ "$from" != board:* ]]; }; then
    add_gates "$slug" "${after:-$(landing_after "${AGENT_QUEUE_ITEM:-}" "$text")}" "$tags"; after="$AFTER_ITEMS"
  fi
  # Admission: every add that is not running or the board's own pull counts against the cap
  # (see admit); a queue item's session adding without --from is recorded as from the item.
  local capped=1
  case "$from" in trainee | auto:epics | auto:validate | canary) capped='' ;; esac
  [ "${AGENT_QUEUE_PULL:-}" != hand ] || capped=''
  [[ "$from" != board:* ]] || ! plan_phase_task "$text" || capped=''
  { [ -z "$running" ] && [ -z "$GATES" ] && [ -z "${AQ_ADMITTED:-}" ]; } || capped=''
  [ -z "$capped" ] || [ -n "$from_given" ] || [ -z "${AGENT_QUEUE_ITEM:-}" ] || from="item:$AGENT_QUEUE_ITEM"
  [ -z "$capped" ] || ! pull_ok "$running" "$from" "$from_given" || make_room "$priority" "$tags" "$slug"
  lock
  [ -z "$(find_item "$slug")" ] || die "already in the queue: $slug"
  local why
  cause_owner "$tags"
  # Checked before slug is reused below: an explicit --slug is the same work by name.
  [ -n "$repeat" ] || why="$(finished_ok "$slug" "${slug_from_text:+$text}" "$from")"
  [ -z "${why:-}" ] || { echo "agent-queue: $why" >&2; exit "$AQ_EX_FINISHED"; }
  # Under the lock, so two filers at once cannot both pass on the same count.
  local hold_title="${title:-$(head -1 <<<"$text")}"
  if [ -n "$GATES" ] || ! pull_ok "$running" "$from" "$from_given"; then
    local bwhy=board-only
    [ -z "$GATES" ] || bwhy=gated
    admission_log "$from" "$project" "$slug" "$hold_title" "" "" "$bwhy"
    unlock
    [ -n "$GATES" ] || board_only_say
    case "$row:$from" in
      :board:*) [ -z "$GATES" ] || die "$slug waits on #${GATES// / #}, so row ${from#board:} stays on the board until that clears"
        echo "agent-queue: its row ${from#board:} is left where it is: dispatch promotes it" >&2 ;;
      :canary | :trainee) [ -z "$GATES" ] || die "a $from item waits on no gate: add it once #${GATES// / #} clears"
        overflow_row "$project" "$hold_title" "$priority" "$epic" "${want:-$(requested_tag "$tags" && echo human)}" "$text" "" "$slug" "$tags" || exit $? ;;
      :*) overflow_row "$project" "$hold_title" "$priority" "$epic" "${want:-$(requested_tag "$tags" && echo human)}" "$text" "$GATES" "$slug" "$tags" || exit $? ;;
      *) if [ -n "$GATES" ]; then
           local rboard rlab
           IFS=$'\t' read -r rboard rlab _ < <(project_board "$project")
           # shellcheck disable=SC2086 # GATES is a space-separated list of tags
           gate_row "$rboard:$row" "$rlab" agent $GATES || die "row $row did not take its gates, so nothing was held: $GATE_HINT"
           echo "agent-queue: row $row waits on #${GATES// / #}: dispatch promotes it once that clears" >&2
           echo "held $slug -> $rboard:$row (#${GATES// / #})"
         else
           echo "agent-queue: row $row is left where it is: dispatch promotes it" >&2
         fi ;;
    esac
    exit "$AQ_EX_HELD"
  fi
  if [ -n "$capped" ] && ! admit "$from" "$priority" "$tags" "$project" "$slug" "$hold_title"; then
    unlock # the board write is notes' and can be slow: the lock covers only the count
    if [ -n "$row" ] || [[ "$from" == board:* ]]; then echo "agent-queue: row ${row:-${from##*:}} is left un-started where it is: dispatch promotes it as the queue drains" >&2
    else overflow_row "$project" "$hold_title" "$priority" "$epic" "${want:-$(requested_tag "$tags" && echo human)}" "$text" "" "$slug" "$tags" || { [ "$?" != 6 ] || exit 6; }; fi
    exit "$AQ_EX_HELD"
  fi
  check_after "$after" "$slug"
  local state=queued now; now="$(now_utc)"
  [ -n "$running" ] && state=running
  # `type(area): title` on the task's first line or its --title, parsed by the grammar's one home.
  local ctype='' carea='' sid='' parsed ok=''
  if parsed="$(head -1 <<<"${title:-$text}" | notes row parse 2>/dev/null)" && [ -n "$parsed" ]; then
    IFS=$'\t' read -r ctype carea _ ok <<<"$parsed"
  else
    echo "agent-queue: notes row parse failed, so $slug is untyped (an old notes? notes-bootstrap --build-only)" >&2
  fi
  [ "$ok" = 1 ] || ctype='' carea=''
  [ -z "$running" ] || area_held "$project" "$carea"
  # Only a session taking the item works it. One queueing it for later did not, and outcomes
  # would charge that session's cost and revert count to this item.
  [ -z "$running" ] || sid="$(claude_sid)" || sid=
  local story='' sboard='' sprof='' srow=''
  # No story row for work with its own record: a canary (fleet-bench canary), a trainee review (the trainee's row), an ask's resume (the ask).
  case "$from" in
    board:* | canary | trainee | ask:*) ;;
    *) if [ -n "$row" ]; then
         # A row moved to another sheet keeps its id, so its code can name the sheet it left; the
         # sheet the caller named is the other one it can be open on (apo-108 on dodginballs,
         # 2026-11-10). Neither: the code sheet's refusal, as before.
         local linked
         if linked="$(link_row "$row" "$project" 2>&1)"; then
           story="$linked"
         elif [ "$project" != "$resolved" ] && story="$(link_row "$row" "$resolved" 2>/dev/null)"; then
           project="$resolved"
         else
           printf '%s\n' "$linked" >&2; exit 1
         fi
       else
         story="$(prior_story "$slug" "$project")"
         if [ -z "$story" ] && [ -n "$named" ] && story="$(link_row "$named" "$named_project" 2>/dev/null)"; then
           project="$named_project"
           echo "agent-queue: $slug works row $named, which its title names; it closes that row when it lands" >&2
         fi
         [ -n "$story" ] || { story="$(file_story "$project" "${title:-$(head -1 <<<"$text")}" "$priority" "$epic" "$want" "$text" "" "" "$tags")"; priority_given=''; }
       fi ;;
  esac
  case "$story" in gated) echo "agent-queue: $slug is not queued: its board row was refused by the daily cap or the gate (the reason is above)" >&2; exit 6 ;; ?*) IFS=$'\t' read -r sboard sprof srow <<<"$story" ;; esac
  mkdir -p "$AQ_DIR/$state"
  local f tmp
  f="$AQ_DIR/$state/$(date +%Y%m%d-%H%M%S)-$slug.md"
  tmp="$(mktemp "$AQ_DIR/$state/.add.XXXXXX")" || die "cannot write in $AQ_DIR/$state"
  {
    printf 'slug: %s\nproject: %s\nmode: %s\npriority: %s\nweight: %s\n' "$slug" "$project" "$mode" "$priority" "$weight"
    [ -n "$title" ] && printf 'title: %s\n' "$title"
    [ -n "$ctype" ] && printf 'type: %s\narea: %s\n' "$ctype" "$carea"
    [ -n "$tags" ] && printf 'tags: %s\n' "$tags"
    [ -n "$after" ] && printf 'after: %s\n' "$after"
    [ -n "${AQ_ITEM_PLAN:-}" ] && printf 'plan: %s\nphases: %s\n' "$AQ_ITEM_PLAN" "$AQ_ITEM_PHASES"
    printf 'from: %s\nagent: %s\nqueued: %s\n' "$from" "$agent" "$now"
    [ -n "$running" ] && printf 'started: %s\n' "$now"
    [ -n "$session" ] && printf 'session: %s\n' "$session"
    [ -n "$window" ] && printf 'window: %s\n' "$window"
    [ -n "$sid" ] && printf 'sessions: %s\naccount: %s\n' "$sid" "$(claude_account)"
    [ -n "$story" ] && printf 'row: %s:%s\nlane: agent\nprofile: %s\n' "$sboard" "$srow" "$sprof"
    printf -- '---\n%s\n' "$text"
  } > "$tmp" && mv -- "$tmp" "$f" || die "could not write $f"
  item_event item-added "$f" --to "$state"
  echo "$state $slug -> $f"
  [ -z "$story" ] || echo "story $srow on the $sboard agent board${epic:+, under $epic}"
  [ -z "$running" ] || mark_row "$f" run
  [ -z "$story" ] || [ -z "$priority_given" ] || add_row_prio "$f" "$priority"
  [ -z "$running" ] && [ "${AGENT_QUEUE_START:-1}" = 1 ] || return 0
  # A --plan phase starts from add_plan, once its whole chain is written.
  [ -z "${AQ_ITEM_PLAN:-}" ] || return 0
  [ "$mode" = plan ] || { human_at_hand "$from" && { [ "$priority" = urgent ] || [ -n "$want" ] || human_session; }; } || return 0
  start_at_add "$f" "$slug" "$priority"
}

# human_at_hand <from> -- the human filed this, by hand or through a session they sit in: from human,
# no dispatched session's $AGENT_QUEUE_ITEM, and not a headless run. A hand start skips the load and
# run-unit gates, so a machine filer, or an unattended session that took the default from, waits for a
# dispatch pass.
human_at_hand() { [ "$1" = human ] && [ -z "${AGENT_QUEUE_ITEM:-}" ] && ! headless; }
# human_session -- the caller is an interactive Claude session (a headless `claude -p` sets another entrypoint).
human_session() { [ "${CLAUDE_CODE_ENTRYPOINT:-}" = cli ]; }

# dispatch_log <text> -- one line in the dispatch log, in fleet-dispatch's own shape, so a start that did
# not happen is told where the ones that did are. Before it, the reason reached only the filer's stderr.
dispatch_log() {
  local d="${FLEET_DISPATCH_DIR:-$HOME/.agent/dispatch}"
  mkdir -p "$d" && printf -- '- %s %s\n' "$(date '+%Y-%m-%d %H:%M')" "$*" >> "$d/log.md"
}

# start_at_add <file> <slug> <priority> -- start a just-queued item now: a plan session, the human's
# urgent ask (it waited up to a dispatch pass, ar-2944), what the human adds from their own interactive
# session or with --want (a normal or low one still waits its turn), and each queued phase of the human's urgent or
# high --plan (the queue holds no gated one). Not a normal or low one (waits_turn), not under the dispatch hold.
# Every outcome but a start is logged here; fleet-dispatch start logs the start itself.
start_at_add() {
  local h w
  w="$(waits_turn "$2" "$3")" && { echo "$w"; dispatch_log "start now: ${w#agent-queue: }"; return 0; }
  # A free desk resource still goes to its best-ranked waiter first (desk_wait).
  h="$(hold_reason "$1")"
  [ -z "$h" ] || { echo "agent-queue: $2 waits its turn ($h), so a dispatch pass starts it"; dispatch_log "start now: $2 waits its turn ($h)"; return 0; }
  w="$(dispatch_held "$2" 2>&1)" && { echo "$w" >&2; dispatch_log "start now: ${w#agent-queue: }"; return 0; }
  # The starter writes this item back through this script: free the lock, and keep the fd out of tmux.
  unlock
  fleet-dispatch start --item "$2" || {
    echo "agent-queue: $2 could not start now, so it stays queued for the next dispatch pass" >&2
    dispatch_log "start now: $2 could not start now, so it stays queued for the next dispatch pass"
  }
}

# start <slug> -- start a queued item now through start_at_add, with its guards (a low one, a desk
# wait and the dispatch hold keep it queued). fleet-dispatch reap calls it for a requeued item of the human's.
cmd_start() {
  local slug="${1:?usage: agent-queue start <slug>}" f
  f="$(find_item "$slug")" && [ "$(state_of "$f")" = queued ] || die "$slug is not queued"
  [ "$(fm_get "$f" from)" = human ] || die "$slug is not the human's: only a pass starts it"
  start_at_add "$f" "$slug" "$(fm_get "$f" priority)"
}

# weight_of <project> <mode> <phases> -> sets WEIGHT, heavy or light, for an item added without
# --weight. Heavy: a plan session (it holds the whole plan), an item that carries two or more
# phases, or a checkout that is a Unity project (a session there runs an editor and pool gates),
# which a listing asks once per project. Else light.
weight_of() {
  local words MEMO_V
  read -ra words <<<"$3"
  if [ "$2" = plan ] || [ "${#words[@]}" -ge 2 ]; then WEIGHT=heavy; return; fi
  memo "unity:$1" unity_weight "$1"
  WEIGHT="$MEMO_V"
}
unity_weight() {
  local dir
  dir="$(project_repo_path "$1" 2>/dev/null)" || dir=""
  if [ -n "$dir" ] && [ -f "$dir/ProjectSettings/ProjectVersion.txt" ]; then echo heavy; else echo light; fi
}

# plan_takes_rank <rows> <plan priority> <plan> -> "<slug><TAB><taken row ids><TAB><priority>" for each phase item
# of add_plan's rows (its 6th column holds the phase names) that `takes <row-id>`: the higher of the plan's
# priority and each taken row's, the board being the one place a row's priority lives. phase_takes reads the
# marker, and agent-land reads it again to close the rows. The board is read once, before anything is written;
# a read that fails dies, and a taken row that is not open is warned about and gives no priority.
plan_takes_rank() {
  local s0 nm tk board="" rid rp p0 i slugs=() ids=()
  while IFS=$'\t' read -r s0 _ _ _ _ nm _; do
    tk="$(phase_takes "$nm" | paste -sd' ')"
    [ -z "$tk" ] || { slugs+=("$s0"); ids+=("$tk"); }
  done <<<"$1"
  [ "${#slugs[@]}" -gt 0 ] || return 0
  board="$(notes board --json 2>/dev/null)" && [ -n "$board" ] || die "--plan $3: a phase takes a board row and notes board --json failed, so its priority is unknown (nothing was added)"
  for i in "${!slugs[@]}"; do
    p0="$2"
    for rid in ${ids[$i]}; do
      rp="$(jq -r --arg id "$rid" '[.rows[]? | select(.id == $id and (.state == "open" or .state == "doing"))] | first | .priority // empty' <<<"$board")" ||
        die "--plan $3: notes board --json was not JSON (nothing was added)"
      if [ -z "$rp" ]; then echo "agent-queue: ${slugs[$i]} takes $rid, which is not an open row on any board: no priority to inherit from it" >&2
      elif [ "$(prio_rank "$rp" || echo 9)" -lt "$(prio_rank "$p0" || echo 9)" ]; then p0="$rp"; fi
    done
    printf '%s\t%s\t%s\n' "${slugs[$i]}" "${ids[$i]}" "$p0"
  done
}
# takes_field <ranked> <slug> <column> [<default>] -> that column of the slug's plan_takes_rank line, else the default.
takes_field() { local v; v="$(awk -F'\t' -v s="$2" -v c="$3" '$1 == s { print $c; exit }' <<<"$1")"; printf '%s\n' "${v:-${4-}}"; }
# takes_suffix <ranked> <slug> -> the --dry-run tail of a phase that takes rows: TAB takes <ids> TAB priority <p>.
takes_suffix() { local t; t="$(takes_field "$1" "$2" 2)"; [ -z "$t" ] || printf '\ttakes %s\tpriority %s' "$t" "$(takes_field "$1" "$2" 3)"; }
# takes_raised <ranked> <plan priority> -> succeeds when a taken row raised some phase above the plan's priority:
# that phase starts at its own priority, even in a low plan.
takes_raised() { awk -F'\t' -v p="$2" '$1 != "" && $3 != p { r = 1 } END { exit !r }' <<<"$1"; }
# add_plan: cmd_add --plan, reading its locals. One item per unchecked phase, in checklist
# order, each `after:` the one before (the first after --after), carrying `plan:` and
# `phases:` (its checklist numbers). A phase line with `(with N)` joins phase N's item when
# phase N is open too, for phases that share a branch; the item runs where its first phase is.
# A phase line declares its own wait: `(independent)` waits on --after alone, `(after N; needs <result>)`
# on the item carrying earlier phase N (`(after N, M; needs ...)` on several; on --after alone when all
# landed; refused when one is deferred). The marker must name the result the phase consumes: one with no
# `needs`, one whose reason is a shared file, and one that does not parse are refused. A `(with N)` line
# takes its item's wait, so a marker on it is refused. Every slug is checked before any item is written.
#
# plan_groups <plan> -> the plan's open phases grouped into items, one JSON array, or the marker error. It
# depends on the file alone, so every caller reads the markers the same way: add_plan, a session's add
# (which files only a board row, so it checks here before filing it) and `add --plan --check`, which
# plan-standard.sh runs on a plan at ExitPlanMode.
plan_groups() {
  local planf="$1" groups
  groups="$(plan_phase_list "$planf" | jq -c '
    # after_marker: the phase numbers its `(after N[, M]; needs <result>)` marker names, [] with none. A marker
    # that gives no consumed result, names a shared file, or does not parse is an error: the wait must be a
    # result the phase uses, never a file two phases edit (a shared file is a merge to resolve).
    def after_marker:
      . as $ph
      | [.name | scan("\\(after [Pp]?[0-9][^)]*\\)")] as $m
      | if ($m | length) == 0 then []
        elif ($m | length) > 1 then error("phase \($ph.n): more than one (after ...) marker; list the phases in one: (after 1, 2; needs <result>)")
        else ($m[0] | .[7:-1]) as $b
          | if ($b | test("\\(")) then
              error("phase \($ph.n): (after \($b)) has a parenthesis inside the marker; write the result without one: (after N; needs <result>)")
            elif ($b | test("^[Pp]?[0-9]+(, *[Pp]?[0-9]+)*( *;( *needs)?)? *$")) then
              error("phase \($ph.n): (after \($b)) names no result it consumes; write (after \($b | sub(" *;.*$"; "")); needs <the output this phase uses>)")
            elif ($b | test("\\b(same file|shared file)\\b"; "i")) or ($b | sub("; *needs .*$"; "") | test("\\b(edits?|conflicts?)\\b"; "i")) then
              error("phase \($ph.n): (after \($b)) waits on a shared file, which is a merge to resolve, not a wait; mark the phase (independent), or name the result it consumes: (after N; needs <result>)")
            elif ($b | test("^[Pp]?[0-9]+(, *[Pp]?[0-9]+)*; *needs +[^ ]")) then
              [$b | split(";")[0] | scan("[0-9]+") | tonumber]
            else error("phase \($ph.n): (after \($b)) does not parse; write (after N; needs <result>) or (after N, M; needs <result>)") end
        end;
    to_entries | map(.value + {idx: .key,
      with: ((.value.name | capture("\\(with (?<w>[0-9]+)([;,][^)]*)?\\)") | .w | tonumber) // null),
      indep: (.value.name | test("\\(independent([;,][^)]*)?\\)")),
      after: (if .value.state == "open" and (.value.n | type) == "number" then (.value | after_marker) else [] end),
      at: ((.value.name | capture("\\(at (?<d>[0-9]{4}-[0-9]{2}-[0-9]{2}) (?<t>[0-9]{2}:[0-9]{2})([;,][^)]*)?\\)") | "at:\(.d)T\(.t)") // null)}) as $all
    | def byn($k): if $k == null then null else ($all | map(select(.n == $k)) | first) end;
      (if any($all[] | select(.state == "open"); . as $o | ($all | map(select(.n == $o.n)) | length) > 1)
       then error("two phases carry the same number; label each phase once") else . end)
    | reduce ($all[] | select(.state == "open" and (.n | type) == "number")) as $p ({of: {}, items: []};
        byn($p.with) as $w
        | ($p.after | join(", ")) as $al
        | ([$p.after[] | . as $k | byn($k) as $t | select($t == null or $t.idx >= $p.idx) | $k]) as $none
        | ([$p.after[] | . as $k | select(byn($k).state == "deferred")]) as $deferred
        | (if $p.indep and ($p.after | length) > 0 then error("phase \($p.n): (independent) and (after \($al)) contradict")
           elif ($none | length) > 0 then
             error("phase \($p.n): (after \($none[0])) names no earlier phase")
           elif ($deferred | length) > 0 then
             error("phase \($p.n): (after \($deferred[0])) waits on a deferred phase; undefer it or drop the marker")
           else . end)
        | if $w != null and $w.idx < $p.idx and $w.state == "open" then
            (if $p.indep or ($p.after | length) > 0 or $p.at != null then
               error("phase \($p.n): a (with \($p.with)) line takes the wait of phase \($p.with)'"'"'s item; mark that line") else . end)
            | .of[$p.n | tostring] = .of[$p.with | tostring]
            | .items[.of[$p.n | tostring]] += [$p]
          else
            # dep: "chain" waits on the item before, "base" on --after alone (every named phase landed
            # is no wait), else the comma list of the items it waits on, each by its first phase.
            . as $st
            | ([$p.after[] | . as $k | select(byn($k).state != "done") | $st.items[$st.of[$k | tostring]][0].n] | unique) as $deps
            | (if $p.indep then "base"
               elif ($p.after | length) == 0 then "chain"
               elif ($deps | length) == 0 then "base"
               else ($deps | map(tostring) | join(",")) end) as $dep
            | .of[$p.n | tostring] = (.items | length) | .items += [[$p + {dep: $dep}]] end)
    | .items | map({dep: .[0].dep, phases: map(.n), at: (.[0].at // ""),
        names: map(.name | gsub(" ?\\(with [0-9]+([;,][^)]*)?\\)"; "") | gsub(" ?\\(after [Pp]?[0-9][^)]*\\)"; "") | gsub(" ?\\(independent([;,][^)]*)?\\)"; "")
          | gsub(" ?\\(at [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}([;,][^)]*)?\\)"; "") | sub("^([0-9]+[.)]|[Pp][0-9]+[.:)]?) +"; ""))}
      | .titles = (.names | map(sub("[.:] .*$"; "") | sub("[.:]$"; "") | .[0:80]))
      | .full = (.names | map(sub("[.]$"; "")) | join("; ") | .[0:100]))' 2>&1)" ||
    die "--plan $planf: could not read its Phases checklist: ${groups#jq: error (at *): }"
  printf '%s\n' "$groups"
}
# plan_check_markers <plan> <check>: cmd_add --plan reads the plan's markers before anything else. A session's
# add files only a board row, and a marker the parser refuses would otherwise surface at dispatch's promote,
# long after the plan was written. With <check> that is all: exit 0 when they parse.
plan_check_markers() {
  [ -f "$1" ] || die "--plan $1: no such file"
  plan_groups "$(realpath "$1")" >/dev/null || exit $?
  [ -z "$2" ] || exit 0
}
# plan_epic_gate <plan> <dry>: an `epic: new` proposal (plan-approved.sh) is the epic the plan's phases
# go under. While inbox-triage has it, or its record cannot be read, nothing is filed and a promote
# retries next pass (exit AQ_EX_HELD); once dropped, or never proposed, the plan needs an epic before it
# runs. A settled one is written into the plan (plan_epic_settle), except on a dry run.
plan_epic_gate() {
  local planf="$1" dry="$2" verdict
  verdict="$(plan_epic_verdict "$planf")"
  case "$verdict" in
    "epic "*) [ -n "$dry" ] || plan_epic_settle "$planf" "${verdict#epic }" || true ;;
    pending|unknown)
      if [ "$verdict" = pending ]; then echo "agent-queue: $planf waits on its epic: new proposal in inbox-triage (notes log --trace '$(plan_epic_tag "$planf")'); nothing filed" >&2
      else echo "agent-queue: $planf: the verdict on its epic: new proposal could not be read (notes log --trace failed); nothing filed" >&2; fi
      exit "$AQ_EX_HELD" ;;
    dropped*) die "$planf: its epic: new proposal was dropped (${verdict#dropped }): name an open epic on its epic: line, or propose another" ;;
    none) die "$planf: its epic: new line was never proposed (plan-approved.sh proposes it when the plan is approved): name an open epic on its epic: line, or file the epic and write its id there" ;;
  esac
}

# add_plan: cmd_add --plan, reading its locals (the markers: plan_groups, above).
add_plan() {
  [ -f "$planf" ] || die "--plan $planf: no such file"
  planf="$(realpath "$planf")"
  local groups
  groups="$(plan_groups "$planf")" || exit $?
  plan_epic_gate "$planf" "$dry"
  [ -n "$project" ] || project="$(project_of_cwd)"
  [ -n "$project" ] || die "no --project, and this directory is not a repo project-map knows"
  project="$(project_resolve "$project")" || die "unknown project: $project (no checkout for it in $AQ_MAP)"
  # A plan is queued once: by its owner, or by hand. The calling session's own item does not count.
  # Its items already active are checked against the chain below, once their slugs are known.
  local taken
  taken="$(plan_taken "$planf")" || exit $?
  # A sub-phase line is no queue item: its number is not an integer, so no item's `phases:` can carry it.
  local subs
  subs="$(plan_phase_list "$planf" | jq -r '[.[] | select(.state == "open" and (.n | type) == "string") | .n] | join(" ")')"
  [ -z "$subs" ] || echo "agent-queue: skipped open sub-phase(s) $subs of $planf: queue each as an item of its own" >&2
  [ "$(jq length <<<"$groups")" -gt 0 ] || die "--plan $planf: no unchecked phase in its ## Phases checklist$(plan_superseded "$planf" && echo ' (the plan is superseded: its phases are another plan'"'"'s)')"
  local prefix
  prefix="$(slugify "${slug:-$(basename "$planf" .md)}" | cut -c1-32 | sed 's/-$//')"
  [ -n "$prefix" ] || die "could not derive a slug prefix; pass --slug"
  local rows ranked
  rows="$(plan_item_rows "$prefix" "$planf" <<<"$groups")"
  ranked="$(plan_takes_rank "$rows" "$priority" "$planf")" || exit 1
  # A phase an earlier add filed on its board row behind a gate (plan_gated_rows) waits there: a second add keeps
  # it on that row (rowof: its slug -> row id) and files only the phases on no row and in no item, so a line
  # added to a filed chain mid-flight is filed once. A gated row naming the plan with no phase number on it
  # (the plan's own row) refuses the add, as the chain is not filed yet.
  local board mid
  local -A rowof=() rowph=()
  board="$(notes board --json 2>/dev/null)" || board=''
  mid="$(plan_gated_rows "$board" | jq -rs --arg p "$planf" "$PLAN_ITEMS_JQ"' .[] | select(names_plan($p)) | [.slug, (.task | gsub("[\t\n]"; " "))] | @tsv')"
  local mid_id mid_task mid_ph re='(^|[[:space:]])Phases? ([0-9]+( and [0-9]+)*) of the plan ' plain=''
  while IFS=$'\t' read -r mid_id mid_task; do
    [ -n "$mid_id" ] || continue
    if [[ "$mid_task" =~ $re ]]; then
      mid_ph="${BASH_REMATCH[2]// and / }"
      rowof["$prefix-p${mid_ph%% *}"]="$mid_id" rowph["$mid_id"]="$mid_ph"
    else plain+="${plain:+ }$mid_id"; fi
  done <<<"$mid"
  # gate: none
  [ -z "$plain" ] || die "phases of $planf already wait on the board: rows $plain (nothing was added; queue a phase that is not on one with a plain add)"
  # An add that stopped part way (a lock it timed out on, ar-2922) left the first items of the chain:
  # this add keeps each under the slug it would give it and queues the rest after them. An item of
  # the plan under any other slug, or a chain already whole, refuses it. The calling session's own
  # item (`own`: a phase session adding a line to its plan) and the phases on their rows are kept too.
  local s d dep ph text prev="$after" wait left=" $taken " fresh=() own=''
  while IFS=$'\t' read -r s dep ph text _; do
    if [[ " $taken " == *" $s "* ]]; then
      left="${left/ $s / }"
      [ "$(fm_get "$(find_item "$s")" phases)" = "$ph" ] || die "$s is queued with other phases than $planf gives it now (nothing was added)"
    elif [ -n "${rowof[$s]:-}" ]; then
      # gate: none
      [ "${rowph[${rowof[$s]}]}" = "$ph" ] || die "row ${rowof[$s]} holds phases ${rowph[${rowof[$s]}]} of $planf, which gives $s phases $ph now (nothing was added; keep each filed phase's P<N> label)"
    elif [ "$s" = "${AGENT_QUEUE_ITEM:-}" ] && [ -n "$(find_item "$s")" ]; then
      [ "$(fm_get "$(find_item "$s")" phases)" = "$ph" ] || die "$s, this session's item, holds other phases than $planf gives it now (nothing was added)"
      own="$s"
    else fresh+=("$s"); fi
  done <<<"$rows"
  # gate: none
  [ -z "${left// /}" ] && [ ${#fresh[@]} -gt 0 ] || die "the phases of $planf are already queued or filed: ${taken:-no item}${rowof[*]:+, rows $(printf '%s\n' "${rowof[@]}" | sort -V | paste -sd' ')} (nothing was added)"
  for s in "${fresh[@]}"; do [ -z "$(find_item "$s")" ] || die "already in the queue: $s (nothing was added)"; done
  check_after "$after"
  # Promoted from its plan row: the row goes on the plan's `rows:` line before any phase is written, so
  # a chain this add leaves short still closes it with its last phase.
  # A plan whose every phase already landed queues nothing, so its row goes on no rows: line (promote
  # hands such a row back with a failed verdict).
  if [ -n "${plan_row:-}" ]; then
    local s0 open=''
    while IFS=$'\t' read -r s0 _; do
      if [ -n "$repeat" ] || [ -z "$(finished_ok "$s0")" ]; then open=1; break; fi
    done <<<"$rows"
    [ -n "$open" ] || { echo "agent-queue: every phase of $planf already landed; tick its boxes (nothing was added)" >&2; exit "$AQ_EX_FINISHED"; }
    if [ -n "$dry" ]; then echo "would put row $plan_row on the rows: line of $planf"
    else plan_rows_add "$planf" "$plan_row" || die "could not put row $plan_row on the rows: line of $planf (nothing was added)"; fi
  fi
  # A phase whose item already finished ok landed with its box left unticked: it is skipped, never run
  # twice, and the next phase still goes after it (an ok after: releases at once).
  # A phase that waits on one not yet landed is no queue item: cmd_add files it as its board row, gated
  # #after/<that phase's row> (add_gates), and each phase after it waits on that row id in turn (key).
  local n=0 total why skipped=0 added=() out rc held=0 pend=()
  local -A key=()
  total="$(wc -l <<<"$rows")"
  local at ptags pprio
  while IFS=$'\t' read -r s dep ph text ttl _ at; do
    IFS=$'\t' read -r pprio ptags < <(phase_hold "$(takes_field "$ranked" "$s" 3 "$priority")" "$tags" "$at")
    case "$dep" in
      chain) wait="$prev" ;;
      base) wait="$after" ;;
      *) wait=''; for d in ${dep//,/ }; do wait+="${wait:+,}${key[$prefix-p$d]:-$prefix-p$d}"; done ;;
    esac
    why=''
    [ -n "$repeat" ] || why="$(finished_ok "$s")"
    if [ -n "$why" ]; then
      echo "agent-queue: skipped $why; tick its box in $planf" >&2
      skipped=$((skipped + 1)); prev="$s"; continue
    fi
    if [ -n "${rowof[$s]:-}" ]; then
      echo "agent-queue: kept $s on its board row ${rowof[$s]}, filed by an earlier add of $planf" >&2
      key[$s]="${rowof[$s]}"
      plan_gate_kept "$s" "${rowof[$s]}" "${pend[@]}"; pend=()
      n=$((n + 1)) prev="${rowof[$s]}"; continue
    fi
    if [[ " $taken " == *" $s "* ]] || [ "$s" = "$own" ]; then
      if [ "$s" = "$own" ]; then echo "agent-queue: kept $s, this session's own item" >&2
      else echo "agent-queue: kept $s, queued by an earlier add of $planf" >&2; ! kept_queued "$s" || added+=("$s"); fi
      [ ${#pend[@]} = 0 ] || echo "agent-queue: $s is an item, not a row, so it is not gated on ${pend[*]}: set its after: by hand if it must wait" >&2
      pend=()
      n=$((n + 1)) prev="$s"; continue
    fi
    if [ -n "$dry" ]; then
      printf 'would queue %s\tphases %s\tafter %s%s%s\n  %s\n' "$s" "$ph" "${wait:--}" "$(takes_suffix "$ranked" "$s")" "${at:+$'\t'$at $pprio}" "$text"
      pend+=("$s")
    else
      rc=0
      ttl="$(plan_phase_title "$planf" "$ph" "$ttl")"
      out="$(AQ_ITEM_PLAN="$planf" AQ_ITEM_PHASES="$ph" AQ_ROWS_FILED="${key[*]}" AQ_ITEM_TAKES="$(takes_field "$ranked" "$s" 2)" \
        cmd_add_one ${project:+--project "$project"} --priority "$pprio" ${ptags:+--tags "$ptags"} ${weight:+--weight "$weight"} \
          --from "$from" --agent "$agent" --slug "$s" --title "$ttl" ${wait:+--after "$wait"} ${repeat:+--repeat} -- "$text")" || rc=$?
      [ -z "$out" ] || printf '%s\n' "$out"
      if [ "$rc" = 0 ]; then added+=("$s") pend+=("$s")
      elif [ "$rc" = "$AQ_EX_HELD" ] && [[ "$out" =~ (^|$'\n')"held $s -> "[^:]+:([a-z0-9]+-[0-9]+) ]]; then
        key[$s]="${BASH_REMATCH[2]}" held=$((held + 1)) pend+=("$s")
      elif [ "$rc" = "$LOCK_BUSY" ] && [ "$held" = 0 ]; then plan_lock_short "$n" "$total" "$planf"
      elif [ "$rc" = 6 ]; then die "queued $n of $total items from $planf; the board's daily cap refused $s, so it and the rest are not queued: a rerun today meets the same cap, so run the same add again tomorrow (it keeps what is queued)"
      else
        # A rerun keeps a phase held on a gated row but files one on an ungated row again, so that case names the plain adds.
        [ "$held" = 0 ] || die "queued $n of $total items from $planf ($held of them wait on their board rows); $s and the rest are not queued: add each with a plain add --after the phase before it (its slug or row id)"
        die "queued $n of $total items from $planf; $s and the rest are not queued: run the same add again to queue them"
      fi
    fi
    n=$((n + 1)); prev="${key[$s]:-$s}"
  done <<<"$rows"
  [ "$skipped" -lt "$total" ] || exit "$AQ_EX_FINISHED"
  # The whole chain is written: each phase whose wait is met starts now (start_at_add).
  [ "${AGENT_QUEUE_START:-1}" = 1 ] && [ "${#added[@]}" -gt 0 ] && human_at_hand "$from" || return 0
  # Once per plan, not per phase: the priority and the dispatch hold are the same for every phase.
  takes_raised "$ranked" "$priority" || ! waits_turn "$(basename "$planf")" "$priority" || return 0
  ! dispatch_held "${added[*]}" || return 0
  local f
  for s in "${added[@]}"; do f="$(find_item "$s")" && [ -n "$f" ] && start_at_add "$f" "$s" "$(takes_field "$ranked" "$s" 3 "$priority")"; done
}
# own_plan_item <plan>: the calling session's item ($AGENT_QUEUE_ITEM) is running and a phase of that plan (its plan:).
# cmd_add --plan lets such a session add a line to its own plan (add_plan keeps the filed phases) and file
# the new phase itself: through overflow_row it is a board row all the same, as a dispatched caller's add is.
own_plan_item() {
  local f
  [ -n "${AGENT_QUEUE_ITEM:-}" ] && f="$(find_item "$AGENT_QUEUE_ITEM")" && [[ "$f" == */running/* ]] && [ -n "$(fm_get "$f" plan)" ] &&
    [ "$(realpath -m "$(fm_get "$f" plan)")" = "$(realpath -m "$1")" ]
}
# plan_gate_kept <slug> <row id> <slug>...: add_plan kept phase <slug> on its board row, below the phases
# this add filed (the rest): a line's place in the checklist is its declaration, so the row waits on each
# of them too, gated after/<its row> (a held phase's row id in key, a queued one's own row, item_row),
# beside the gates it has. Reads add_plan's locals key, dry and board. A dry run prints the gate.
plan_gate_kept() {
  local s=$1 id=$2 k r f tags=()
  shift 2
  for k in "$@"; do
    r="${key[$k]:-}"
    if [ -z "$r" ] && f="$(find_item "$k")" && [ -n "$f" ]; then r="$(item_row "$f")" r="${r#*:}"; fi
    [ -z "$dry" ] || r="${r:-<row of $k>}"
    if [ -n "$r" ]; then tags+=("after/$r")
    else echo "agent-queue: $s on row $id is not gated on $k, which has no board row: gate it by hand" >&2; fi
  done
  [ ${#tags[@]} -gt 0 ] || return 0
  if [ -n "$dry" ]; then echo "would gate row $id ($s) on ${tags[*]}"; return 0; fi
  local proj prof lane
  # A unit separator, not a tab: read collapses an empty whitespace field, so no profile would shift the lane.
  IFS=$'\x1f' read -r proj prof lane < <(jq -r --arg id "$id" 'first(.rows[]? | select(.id == $id)
    | [.project, (.profile // ""), (.lane // "agent")]) | join("\u001f")' <<<"$board" 2>/dev/null) || true
  # gate: none
  gate_row "${proj:-?}:$id" "${prof:-}" "${lane:-agent}" "${tags[@]}" ||
    die "the phases above $s are filed, but its row $id is not gated on them: $GATE_HINT"
  echo "gated row $id ($s) on ${tags[*]}"
}
# plan_item_rows <prefix> <plan> < groups -> one TSV row per queue item of add_plan's phase groups:
# slug, dep, phases, brief, phase name (the title is plan_phase_title's), names, at: tag (empty when the phase has no `(at ...)` marker).
plan_item_rows() {
  jq -r --arg pre "$1" --arg plan "$2" '.[]
    | (.phases | length > 1) as $many
    | [($pre + "-p\(.phases[0])"), (.dep | tostring), (.phases | join(" ")),
       ("\(if $many then "Phases \(.phases | join(" and "))" else "Phase \(.phases[0])" end) of the plan \($plan): \(.titles | join("; ")). "
        + "Read the plan whole, then do ONLY \(if $many then "these phases, on one branch" else "this phase" end), to merged. "
        + "When it lands, tick its box\(if $many then "es" else "" end) in the plan'"'"'s Phases checklist with the PR number and add a Results line. "
        + "If the phase is already landed, or something it waits on (a named PR, an earlier phase, a deploy) is not in place, stop and say what is missing instead of working around it."),
       .full, (.names | join(" | ")), .at]
    | @tsv'
}
# phase_hold <priority> <tags> <at-tag> -> "<priority>\t<tags>" for one plan phase. A phase marked
# `(at <date> <HH:MM>)` waits on that time (its at: hold, filed as its board row's #at/ gate), so it
# is never urgent: an urgent row holds a sprint's cut, and a time wait would hold it for days
# (ar-3833). Only that phase carries the hold.
phase_hold() {
  local prio="$1" tags="$2" at="$3"
  [ -z "$at" ] || { tags="${tags:+$tags }$at"; [ "$prio" != urgent ] || prio=high; }
  printf '%s\t%s\n' "$prio" "$tags"
}
# plan_taken <plan> -> the slugs of the plan's items already active, the calling session's own not counted.
# Exits LOCK_BUSY when the queue stays locked, else 1: a reader of the queue that fails reads no items.
plan_taken() {
  local rc=0 out
  out="$(collect_rows $ACTIVE | jq -r --arg p "$1" --arg own "${AGENT_QUEUE_ITEM:-}" \
    "$PLAN_ITEMS_JQ"' .[] | select(.slug != $own and names_plan($p)) | .slug' | paste -sd' ')" || rc=$?
  [ "$rc" != "$LOCK_BUSY" ] || exit "$LOCK_BUSY"
  [ "$rc" = 0 ] || die "could not check the queue for items of $1, so nothing was added"
  printf '%s\n' "$out"
}
# kept_queued <slug>: the item an earlier add queued is still queued. A try that stopped on the lock
# never reached the start step, so the rerun starts it with the phases it adds itself.
kept_queued() { case "$(find_item "$1")" in */queued/*) ;; *) return 1 ;; esac; }
# plan_lock_short <n> <total> <plan>: a phase add missed the lock, so nothing of that phase was written
# (cmd_add takes the lock first); plan_add_waiting reruns, and the rerun keeps the n before it.
plan_lock_short() {
  echo "agent-queue: the queue stayed locked; queued $1 of $2 items from $3" >&2
  exit "$LOCK_BUSY"
}
# plan_add_waiting: add_plan, rerun while the queue stays locked. Each take_lock already waits
# LOCK_WAIT, so a rerun is the wait, not a delay: PLAN_LOCK_TRIES of them bound it. A rerun keeps the
# items an earlier try queued (add_plan "kept"), so the chain ends whole, or short with the same add
# resuming it (ar-2922: one busy queue left P1 only and every later phase was added by hand).
PLAN_LOCK_TRIES=6
plan_add_waiting() {
  local try rc
  for ((try = 1; try <= PLAN_LOCK_TRIES; try++)); do
    rc=0; (add_plan) || rc=$?
    [ "$rc" = "$LOCK_BUSY" ] || { [ "$rc" = 0 ] || exit "$rc"; return 0; }
    [ "$try" = "$PLAN_LOCK_TRIES" ] || echo "agent-queue: the queue is busy; adding the plan again ($try of $PLAN_LOCK_TRIES tries)" >&2
  done
  echo "agent-queue: the queue stayed locked for $PLAN_LOCK_TRIES tries; run the same add again, it keeps what is queued and adds the rest" >&2
  exit "$LOCK_BUSY"
}
# One item through cmd_add, in a subshell so its die stops only that item.
cmd_add_one() { (cmd_add "$@"); }

# sizing_join <items json array> -> the array with each item's `points` and `size` band read from the
# board row it works (item_row's "<board>:<key>"), the one size store: `notes board --json` names
# both on every row, open or closed in the last SIZING_DONE_DAYS. An item with no row, or whose row
# is gone, keeps the `size:` it was started with and has no points. A board that cannot be read joins
# nothing: the list is still the queue.
SIZING_DONE_DAYS=60
sizing_join() {
  local joined
  command -v notes >/dev/null && joined="$(jq -c --slurpfile b <(notes board --json --done-days "$SIZING_DONE_DAYS" 2>/dev/null |
    jq -c '[(.rows + .done)[] | select(.id != null) | {key: (.project + ":" + .id), value: {points, size}}] | from_entries' 2>/dev/null) '
    ($b[0] // {}) as $m
    | map(($m[.row // ""] // {}) as $r
      | (if $r.size then .size = $r.size else . end) + (if $r.points then {points: $r.points} else {} end))' <<<"$1" 2>/dev/null)" &&
    [ -n "$joined" ] && { printf '%s\n' "$joined"; return 0; }
  printf '%s\n' "$1"
}

cmd_list() {
  local json="" state=active date="" since="" points=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --points) points=1; shift ;;
      --state) state="${2:?}"; shift 2 ;;
      --date) date="${2:?}"; shift 2 ;;
      --since) since="$(since_day "${2:?}")" || exit 1; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  local states
  case "$state" in
    active) states="waiting review running queued" ;;
    all) states="waiting review running queued done" ;;
    queued | running | waiting | review | done) states="$state" ;;
    *) die "--state is queued, running, waiting, review, done, active or all" ;;
  esac
  # shellcheck disable=SC2086
  # A queue that cannot be read is a failure, never an empty list: a reader that acts on what is
  # missing (plans_orphaned) would read every item as gone.
  local items; items="$(collect $states ${date:+--date "$date"} ${since:+--since "$since"})" || die "could not read the queue"
  [ -n "$points" ] || [ -n "$json" ] || points=1
  [ -z "$points" ] || items="$(sizing_join "$items")"
  if [ -n "$json" ]; then
    jq -c '.[]' <<<"$items"
    return 0
  fi
  [ "$(jq length <<<"$items")" -gt 0 ] || { echo "queue: nothing ${state/active/queued, running, waiting or review}"; return 0; }
  # Grouped by state in this order, queue order inside each group.
  jq -r '(["waiting","review","running","queued","done"]) as $o
    | sort_by(.state as $s | $o | index($s)) | .[]
    | [.state, .priority, .slug, .project, .mode,
       (.hold // .status // .session // ""), (.tags // ""), .from,
       (if .size and .points then "\(.size)/\(.points)" else (.size // "") end)] | map(if . == "" then "-" else . end) | @tsv' <<<"$items"
}

cmd_next() {
  local items
  items="$(collect queued | jq -c '[.[] | select(.hold == null)] | first // empty')" || die "could not read the queue"
  [ -n "$items" ] || return 1
  if [ "${1:-}" = --json ]; then printf '%s\n' "$items"; else jq -r .file <<<"$items"; fi
}

cmd_show() {
  local slug="${1:?usage: agent-queue show <slug>}" f
  lock_read
  f="$(find_item "$slug" any)"; [ -n "$f" ] || die "no item: $slug"
  if [ "${2:-}" = --json ] && [ "${3:-}" = --points ]; then sizing_join "[$(item_json "$f")]" | jq -c '.[0]'; return 0; fi
  if [ "${2:-}" = --json ]; then item_json "$f"; return 0; fi
  printf 'state: %s\nfile: %s\n' "$(state_of "$f")" "$f"
  cat -- "$f"
}

# The item this session is working, so agent-land can close it with no slug: exit 1 when none,
# 2 when more than one (pass the slug). The Claude session id decides first: an item lists every
# session that worked it (`sessions:`), whatever window it ran in. Without one, the tmux session,
# and only a running item: a hub session hosts many conversations, and a waiting item of an
# earlier one is not this one's (2026-11-05 a land closed c1103's waiting item that way).
# --sid asks of that Claude session alone, with no tmux fallback.
cmd_mine() {
  local session='' sid only=0 newest=0 slugs files last
  while [ $# -gt 0 ]; do
    case "$1" in
      --session) session="${2:?--session needs a value}"; shift 2 ;;
      --sid) sid="${2:?--sid needs a value}" only=1; shift 2 ;;
      --newest) newest=1; shift ;;
      *) die "usage: agent-queue mine [--session s | --sid id] [--newest]" ;;
    esac
  done
  [ "$only" -eq 1 ] || sid="$(claude_sid)" || sid=""
  # One read answers both asks, so they see the queue at one moment; none when neither is asked.
  local items=""
  if [ -z "$session" ] && [ -n "$sid" ]; then
    items="$(collect running waiting review)" || die "could not read the queue"
    slugs="$(jq -r --arg s "$sid" '.[] | select((.sessions // "") | split(" ") | index($s)) | .slug' <<<"$items")" ||
      die "could not read the queue"
  fi
  [ "$only" -eq 0 ] || [ -n "${slugs:-}" ] || return 1
  if [ -z "${slugs:-}" ]; then
    [ -n "$session" ] || session="$(own_session)" || { [ -n "$sid" ] && return 1; die "not in tmux: pass --session <server>:<session>"; }
    [ -n "$items" ] || items="$(collect running waiting review)" || die "could not read the queue"
    slugs="$(jq -r --arg s "$session" '.[] | select(.state == "running" and .session == $s) | .slug' <<<"$items")" || die "could not read the queue"
  fi
  [ -n "$slugs" ] || return 1
  if [ "$(wc -l <<<"$slugs")" -gt 1 ]; then
    if [ "$newest" -eq 0 ]; then
      echo "agent-queue: more than one item is this session's: $(tr '\n' ' ' <<<"$slugs")" >&2
      return 2
    fi
    # --newest (a resume): a running item before a waiting or review one, whose header a PR poller
    # may rewrite; among those, the one updated last, since every header write rewrites its file.
    files="$(jq -r --arg l "$slugs" '[.[] | select(.slug as $x | $l | split("\n") | index([$x]))] |
      (map(select(.state == "running")) | select(length > 0)) // . | .[].file' <<<"$items")" ||
      die "could not read the queue"
    last="$(xargs -rd '\n' sh -c 'find "$@" -maxdepth 0 -printf "%T@\t%p\n"' find <<<"$files" | LC_ALL=C sort -n | tail -n 1 | cut -f2-)"
    slugs="$(jq -r --arg f "$last" 'first(.[] | select(.file == $f) | .slug) // empty' <<<"$items")"
    [ -n "$slugs" ] || die "could not read the queue"
  fi
  printf '%s\n' "$slugs"
}

# claim <slug> [--sid id] -- add a Claude session to the sessions that worked this item, done or not. Run by
# fleet-dispatch start for the id it launches with, and by agent-land; adding one already there is a no-op.
# The caller's own claim of a queued item also starts it: running, with its tmux session and window.
cmd_claim() {
  local slug="${1:?usage: agent-queue claim <slug> [--sid id]}" sid f cur own=''
  shift
  case "${1:-}" in --sid) sid="${2:?--sid needs a value}" ;; '') sid="$(claude_sid)" || die "no Claude session: pass --sid"; own=1 ;; *) die "usage: agent-queue claim <slug> [--sid id]" ;; esac
  case "$sid" in *[!A-Za-z0-9_-]*) die "not a session id: $sid" ;; esac
  lock
  # `any`: a task split across repos lands its second PR on a done item, from another session.
  f="$(find_item "$slug" any)"; [ -n "$f" ] || die "no item: $slug"
  # The caller's own session names its account when the item has none; a --sid caller (fleet-dispatch
  # start) records the account it launched on itself. An item another harness worked (agent: codex,
  # claude-cloud) keeps none: a Claude session landing it did not do its work.
  case "$(fm_get "$f" agent)" in ''|claude)
    [ -z "$own" ] || [ -n "$(fm_get "$f" account)" ] || header_set "$f" account "$(claude_account)" ;;
  esac
  cur="$(fm_get "$f" sessions)"
  case " $cur " in
    *" $sid "*) echo "$slug: $sid already claimed" ;;
    *) header_set "$f" sessions "${cur:+$cur }$sid"
      item_event item-claimed "$f" --why "$sid"
      echo "$slug: claimed by $sid" ;;
  esac
  # A session that claims a queued item for itself works it, so it runs, recorded as add --running
  # records a hand start: a queued item is dispatch's to start, and it started a second session on one
  # (diversity-p4, trader #132 and #133, 2026-11-11, ar-1693). A --sid claim is a starter's record.
  [ -n "$own" ] && [ "$(state_of "$f")" = queued ] || return 0
  area_held "$(fm_get "$f" project)" "$(fm_get "$f" area)" "$slug"
  AQ_LOCKED=1 cmd_move "$slug" running || return
  local session='' window=''
  IFS=$'\t' read -r session window < <(hand_start)
  f="$(find_item "$slug")"
  [ -z "$session" ] || header_set "$f" session "$session"
  [ -z "$window" ] || header_set "$f" window "$window"
}

# close_on <host> <tmux-close args...> -- tmux-close here, or on that fleet worker over ssh.
close_on() {
  local host="$1"; shift
  [ -n "$host" ] || { "$TMUX_CLOSE" "$@"; return; }
  # shellcheck source=../lib/fleet-hosts.sh
  declare -F fleet_host_run >/dev/null || . "${FLEET_HOSTS_LIB:-$AQ_BIN/../lib/fleet-hosts.sh}"
  fleet_host_run "$host" tmux-close "$@"
}

cmd_cancel() {
  local slug="${1:?usage: agent-queue cancel <slug> [--why <text>] [--ask <id>]}" f why="" ask="" by
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --why) why="${2:?--why needs a reason}"; shift 2 ;;
      --ask) ask="${2:?--ask needs an ask id}"; shift 2 ;;
      *) die "usage: agent-queue cancel <slug> [--why <text>] [--ask <id>]" ;;
    esac
  done
  cancel_check "$why"
  by="$(cancel_who)"
  lock
  f="$(find_item "$slug")"; [ -n "$f" ] || { cancel_record_only "$slug" "$why" "$by"; return; }
  cancel_guard "$f" "$ask"
  why="$(cancel_why "$why" "$ask")"
  cancel_close "$f" "$why" "$by" "$(dead_cause "$f")" ""
}

# cancel_close <file> <why> <by> <cause> <end> -- close an active item as cancelled: its window or session
# when it owns one, then status, cancelled_by:, cancel_why:, cancel_cause: and, for a return, end_reason:.
# The caller holds the lock and has checked <why>.
cancel_close() {
  local f="$1" why="$2" by="$3" cause="$4" end="$5" slug session server window host dest
  slug="$(fm_get "$f" slug)"
  # `session:` is <server>:<tmux session>; a value with no server names nothing to kill.
  session="$(fm_get "$f" session)"; server="${session%%:*}"; window="$(fm_get "$f" window)"
  case "$session" in *:*) session="${session#*:}" ;; *) session='' ;; esac
  # A session on a fleet worker is closed there: here the same name is some other session.
  host="$(fm_get "$f" host)"
  # Close what the item owns: its window when it recorded one (a hand start), its session only
  # when fleet-dispatch made it (`origin:`), else nothing. tmux-close spares world sessions.
  if [ -n "$session" ] && [ "$(state_of "$f")" != queued ] && [ -z "${AQ_RETURN_KEEP_SESSION-}" ]; then
    if [ -n "$window" ]; then
      close_on "$host" -L "$server" window "$window" 2>/dev/null && echo "closed window $window of $session" ||
        echo "agent-queue: window $window was not open on $server" >&2
    elif [ -n "$(fm_get "$f" origin)" ]; then
      close_on "$host" -L "$server" session "$session" && echo "killed session $session" ||
        echo "agent-queue: session $session was not closed on $server" >&2
    else
      echo "agent-queue: left $server:$session open: a hand-started item that recorded no window owns no session" >&2
    fi
  fi
  header_set "$f" status cancelled
  header_set "$f" finished "$(now_utc)"
  header_del "$f" end_reason
  cancel_stamp "$f" "$why"
  [ -z "$cause" ] || header_set "$f" cancel_cause "$cause"
  [ -z "$end" ] || header_set "$f" end_reason "$end"
  dest="$(move_to "$f" "done")" || die "could not move $f"
  # A return says so in the chain record too, where the item file is no longer at hand.
  [ -z "$end" ] || why="$end: $why"
  item_event item-cancelled "$dest" --to done ${by:+--by "$by"} ${why:+--why "$why"}
  echo "${end:-cancelled} $slug -> $dest"
}

# dead_cause <file> -> why an item about to be cancelled is already dead, from the file alone: the
# first slug in its after: that closed other than ok, and what that item recorded: its own
# cancel_cause: when it was itself a cascade, so the root cause is carried down a chain, else who closed
# it and why. Empty when no after: slug closed dead.
dead_cause() {
  local root s st pf c by why
  root="$(dead_root "$1")" || return 0
  s="${root% *}" st="${root#* }"
  pf="$(latest_done "$s")"
  c="$(fm_get "$pf" cancel_cause)"
  if [ -z "$c" ]; then
    by="$(fm_get "$pf" cancelled_by)" why="$(fm_get "$pf" cancel_why)"
    c="after $s closed $st${by:+ by $by}${why:+: $why}"
  fi
  printf '%s' "$c"
}

# dead_root <file> -> "<slug> <status>": the first slug in the item's after: that closed other than
# ok, the one its dead hold names (hold_for). Fails when none did.
dead_root() {
  local s AST
  for s in $(fm_get "$1" after); do
    after_status "$s"
    case "$AST" in ok | "") continue ;; esac
    printf '%s %s' "$s" "$AST"
    return 0
  done
  return 1
}

# chain_of <slug> <file> -> "<slug><TAB><file>" for the item and every queued item after: it,
# transitively, the item first: what a return takes with it. Only queued items wait on an item still
# open, so only they follow.
chain_of() {
  local -a chain=("$1") files=("$2")
  local i=0 s g
  while [ "$i" -lt "${#chain[@]}" ]; do
    s="${chain[i]}"; i=$((i + 1))
    while IFS= read -r g; do
      [ -n "$g" ] && waits_on "$g" "$s" || continue
      case " ${chain[*]} " in *" $(fm_get "$g" slug) "*) continue ;; esac
      chain+=("$(fm_get "$g" slug)") files+=("$g")
    done < <(items_in "$AQ_DIR/queued")
  done
  for i in "${!chain[@]}"; do printf '%s\t%s\n' "${chain[i]}" "${files[i]}"; done
}

# return <slug> --why <text> -- send an item back to its board: it closes as cancelled with end_reason:
# returned, its board row is un-started (the row holds the brief, so nothing goes with the item),
# and every queued item after: it goes back too, transitively, each with cancel_cause: naming the
# item returned. A plain cancel leaves those items dead (their
# after: closed cancelled), and a cleanup that cancelled the dead ones one by one lost about 40 chains on
# 2026-11-12 (ar-2299); a return takes the chain with it, so no item is left waiting on a closed one.
# --drop closes each row undelivered instead (`notes ptask drop`), the human's drop of a chain.
cmd_return() {
  local usage="usage: agent-queue return <slug> --why <text> [--ask <id>] [--drop]"
  local slug="${1:?$usage}" why="" ask="" drop="" by f g s i cause
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --why) why="${2:?--why needs a reason}"; shift 2 ;;
      --ask) ask="${2:?--ask needs an ask id}"; shift 2 ;;
      --drop) drop=1; shift ;;
      *) die "$usage" ;;
    esac
  done
  [ -n "$why" ] || die "a return says why: $usage"
  cancel_check "$why"
  by="$(cancel_who)"
  lock
  f="$(find_item "$slug")"; [ -n "$f" ] || die "nothing active with slug $slug"
  [ -z "${AQ_RETURN_QUEUED:-}" ] || [ "$(state_of "$f")" = queued ] || die "$slug is $(state_of "$f") now, not queued: not returned"
  # Name the whole chain before closing any of it: a closed item no longer reads as a dependency.
  local -a chain=() files=() rows=() profs=() lanes=()
  while IFS=$'\t' read -r s g; do chain+=("$s") files+=("$g"); done < <(chain_of "$slug" "$f")
  for i in "${!chain[@]}"; do
    rows+=("$(item_row "${files[i]}")") profs+=("$(fm_get "${files[i]}" profile)") lanes+=("$(fm_get "${files[i]}" lane)")
  done
  # An item with a board row goes back to it with its brief, so a plain return of it is not held. The
  # cancel guard holds the rest, every item before the first closes: --drop closes the rows undelivered,
  # and an item with no row would leave the human's work nowhere.
  for i in "${!chain[@]}"; do
    [ -z "$drop" ] && [ -n "${rows[i]}" ] || cancel_guard "${files[i]}" "$ask"
  done
  why="$(cancel_why "$why" "$ask")"
  # What each item still waits on goes back onto its row, worked out before any item closes: a
  # follower's after: names an item still live here. One that has no board form refuses the return.
  local -a gates=()
  local gt
  for i in "${!chain[@]}"; do
    gt=""
    if [ -z "$drop" ] && [ -n "${rows[i]}" ]; then gt="$(return_gates "${files[i]}" " ${chain[*]} ")" || exit 1; fi
    gates+=("$gt")
  done
  for i in "${!chain[@]}"; do
    # The root keeps the cause it was already dead by, if any; each follower names the item returned.
    if [ "$i" -eq 0 ]; then cause="$(dead_cause "${files[i]}")"; else cause="returned with $slug"; fi
    cancel_close "${files[i]}" "$why" "$by" "$cause" returned
  done
  # notes writes the rows and may call agent-queue: the lock goes first, as in close_row_on_item.
  unlock
  # A row that stays started reads as an orphan with no item: say so and exit 1, as reopen does.
  local rc=0 did=un-started
  [ -z "$drop" ] || did=dropped
  for i in "${!chain[@]}"; do
    [ -n "${rows[i]}" ] || continue
    # The gates go on while the row is still started, so no pass can pick it open without them; a row
    # that did not take them stays started rather than open with nothing to wait on.
    # shellcheck disable=SC2086 # gates[i] is a space-separated list of hashtags
    if [ -n "${gates[i]}" ] && ! gate_row "${rows[i]}" "${profs[i]}" "${lanes[i]}" ${gates[i]}; then
      echo "agent-queue: ${chain[i]} is returned, but its board row ${rows[i]#*:} on ${rows[i]%%:*} did not take its gates, so it stays started: $GATE_HINT, then un-start it" >&2
      rc=1; continue
    fi
    unstart_row "${rows[i]}" "${profs[i]}" "${lanes[i]}" ${drop:+"$why"} ||
      { echo "agent-queue: ${chain[i]} is returned, but its board row ${rows[i]#*:} on ${rows[i]%%:*} was not $did: $UNSTART_HINT" >&2; rc=1; }
  done
  return "$rc"
}

# cancel_record_only <slug>: an item whose file was deleted outside agent-queue still sits at its
# last step in the chain record (notes log --steps), which fleet-bench counts as chain_drift for
# good. Cancel closes it there, with the project and title of its add; no row is named.
cancel_record_only() {
  local slug=$1 why=${2-} by=${3-} added
  record_active "$slug" || die "nothing active with slug $slug"
  added=$(notes log --days 3650 --item "$slug" --json 2>/dev/null | jq -sc 'map(select(.action == "item-added")) | last // {}')
  chain_event queue item-cancelled "$(jq -r '.from // "-"' <<<"$added")" "$(jq -r '.text // "-"' <<<"$added")" \
    --item "$slug" --to done ${by:+--by "$by"} ${why:+--why "$why"}
  # chain_event swallows a failed write, and here the write is the whole cancel
  ! record_active "$slug" || die "$slug is still active in the record: notes ingest record did not close it"
  echo "cancelled $slug in the record: its file was already gone"
}
record_active() {
  notes log --steps --json 2>/dev/null |
    jq -e --arg s "$1" 'any(.steps[]? | select(.step != "done"); (.items // []) | index($s))' >/dev/null
}

cmd_bump() {
  local slug="${1:?usage: agent-queue bump <slug> <priority>}" prio="${2:?usage: agent-queue bump <slug> <priority>}" f
  prio_rank "$prio" >/dev/null || die "priority is urgent, high, normal or low, not $prio"
  lock
  f="$(find_item "$slug")"; [ -n "$f" ] || die "nothing active with slug $slug"
  header_set "$f" priority "$prio"
  item_event item-set "$f" --why "priority=$prio"
  echo "$slug -> $prio"
  # The row is where the order reads it (row_prios); notes writes it, so the lock goes first.
  unlock
  row_prio_write "$f" "$prio"
  # Priority never overrides an after: (a dependency claim), so an urgent item it holds says so.
  local after hold
  after="$(fm_get "$f" after)"
  [ "$prio" = urgent ] && [ -n "$after" ] && [[ "$f" == */queued/* ]] || return 0
  hold="$(hold_reason "$f")"
  case "$hold" in
    "after "*" closed "*) echo "agent-queue: $slug is held $hold" >&2 ;;
    "after "*" "*) echo "agent-queue: $slug is held $hold: it starts when those land; agent-queue set $slug after= runs it now" >&2 ;;
    "after "*) echo "agent-queue: $slug is held $hold: it starts when that lands; agent-queue set $slug after= runs it now" >&2 ;;
  esac
}

# The fields only the dispatcher and the session record. Identity fields (slug, queued) are not
# settable: they are what the item is. `from` is, so a project rename can move a board origin, and
# `title` is, so an item whose plan changed stops showing its old title (one line, as add --title
# writes it). The board row's own words are its sheet's: `notes ptask edit`.
SETTABLE=" asked asker title project mode priority tags type after agent started waiting review finished session window account model effort size lane_run end_reason salvage branch lost plan phases pr open_pr merged landed_by partial closing_pr fix_tries land_tries takeover_tries pr_owner fix_human cost_usd gateway_cost_usd work_min report ask note status area origin lane profile from touches row host routed canary trainee direct review_fix proves_at validate verdict verdict_head "

# One landed_by pair, <session id>=<owner>/<repo>#<N> (cmd_set).
LANDED_PAIR='[^= ]+=[^# ]+/[^# ]+#[0-9]+'
cmd_set() {
  local slug="${1:?usage: agent-queue set <slug> <key=value>...}" f kv k
  shift
  [ $# -gt 0 ] || die "usage: agent-queue set <slug> <key=value>..."
  for kv in "$@"; do
    k="${kv%%=*}"
    [ "$k" != "$kv" ] || die "not key=value: $kv"
    case "$SETTABLE" in *" $k "*) ;; *) die "not a settable field: $k" ;; esac
    [ "$k" != tags ] || check_tags "${kv#*=}"
    [ "$k" != priority ] || prio_rank "${kv#*=}" >/dev/null || die "priority is urgent, high, normal or low, not ${kv#*=}"
    [ "$k" != after ] || check_after "$(word_list "${kv#*=}")" "$slug"
    # phases: the plan checklist numbers the item holds, as add --plan writes them (ar-2905).
    [ "$k" != phases ] || [[ "$(word_list "${kv#*=}")" =~ ^([0-9]+( [0-9]+)*)?$ ]] || die "phases is plan checklist numbers such as 3 4, not ${kv#*=}"
    # merged: the merge commit of each PR in pr:, in step; a PR ref here (fix-ci-ghw, 2026-11-13) failed merge proof every reap.
    [ "$k" != merged ] || [[ "$(word_list "${kv#*=}")" =~ ^([0-9a-f]+( [0-9a-f]+)*)?$ ]] || die "merged is the merge commit sha of each PR in pr:, not ${kv#*=}"
    # landed_by: "<session id>=<owner>/<repo>#<N>" per PR a session landed, read by the nightly outcomes pass (ar-2779).
    [ "$k" != landed_by ] || [[ "$(word_list "${kv#*=}")" =~ ^($LANDED_PAIR(\ $LANDED_PAIR)*)?$ ]] || die "landed_by is <session id>=<owner>/<repo>#<N> per PR, not ${kv#*=}"
    [ "$k" != end_reason ] || [ -z "${kv#*=}" ] || check_end "${kv#*=}"
    # review_fix: what a trainee's batch review changed before it landed the diff, read by fleet-bench's Trainee table.
    [ "$k" != review_fix ] || [[ "${kv#*=}" =~ ^(none|small)?$ ]] || die "review_fix is none or small, not ${kv#*=}"
    # verdict, verdict_head: a validate item's review of the critical PR it was filed for, read by agent-land's validate_gate.
    [ "$k" != verdict ] || [[ "${kv#*=}" =~ ^(pass|fail)?$ ]] || die "verdict is pass or fail, not ${kv#*=}"
    [ "$k" != verdict_head ] || [[ "${kv#*=}" =~ ^([0-9a-f]{7,40})?$ ]] || die "verdict_head is the commit sha the verdict reviewed, not ${kv#*=}"
    [ "$k" != effort ] || [[ "${kv#*=}" =~ ^[a-z]*$ ]] || die "effort is a word such as medium or high, not ${kv#*=}"
    # proves_at: when a red fix's probe can first read it (the next run of a CronJob), read by fleet-bench triage (cause_tries).
    # The round trip refuses a time of the right shape that is no date (2026-11-31), which triage would read as none.
    [ "$k" != proves_at ] || [ -z "${kv#*=}" ] || [ "$(date -u -d "${kv#*=}" +%FT%TZ 2>/dev/null)" = "${kv#*=}" ] || die "proves_at is a UTC time such as 2026-11-22T12:00:00Z, not ${kv#*=}"
    if [ "$k" = project ] && [ "$(project_resolve "${kv#*=}")" != "${kv#*=}" ]; then
      die "unknown project: ${kv#*=} (not a canonical project in $AQ_MAP)"
    fi
  done
  lock
  f="$(find_item "$slug" any)"; [ -n "$f" ] || die "no item: $slug"
  [[ "$f" == "$AQ_DIR"/done/* ]] || for kv in "$@"; do [ "${kv%%=*}" != tags ] || cause_owner "${kv#*=}" "$slug"; done
  # A gate on a queued item sends it back to its board row (below), so one with no row is refused
  # before anything is written: it would stay queued with a pending hold.
  local new_after new_tags HOLD HOLD_DEAD
  if [ "$(state_of "$f")" = queued ] && [[ " $* " == *" tags="* || " $* " == *" after="* ]] && [ -z "$(item_row "$f")" ] && [[ " $* " != *" row="* ]]; then
    new_after="$(fm_get "$f" after)" new_tags="$(fm_get "$f" tags)"
    for kv in "$@"; do
      case "$kv" in after=*) new_after="$(word_list "${kv#*=}")" ;; tags=*) new_tags="${kv#*=}" ;; esac
    done
    hold_for "$new_after" "$new_tags" "" "$f"
    [ -z "$HOLD" ] || die "$slug has no board row to wait on its gate ($HOLD): give it one (agent-queue set $slug row=<board>:<id>) first; the queue holds only work that can start"
  fi
  # The row it works before the set, with the profile and lane that row is on (item_row).
  local left_row="" left_prof="" left_lane="" set_kv=()
  case " $* " in *" row="* | *" from="*)
    left_row="$(item_row "$f")" left_prof="$(fm_get "$f" profile)" left_lane="$(fm_get "$f" lane)" ;;
  esac
  # merged: is the merge of each PR in pr:, so a new pr: drops an old merged: unless this set names
  # one too (agent-land sets both), or done ok would pass on the last PR's merge (cmd_move). A done ok
  # item has passed that check, so its merged: is the proof it shipped: a pr: fixed or cleared after
  # the PR record is gone keeps it, unless the new pr: lists a different number of PRs, which would
  # put the lists out of step for reopen --unland (ar-3899, seen 2026-11-19 on the audio items).
  # Keys are matched per argument: a title= or note= value holding " merged=" names no merged:.
  local new_pr="" set_pr="" set_merged=""
  for kv in "$@"; do
    case "${kv%%=*}" in pr) set_pr=1 new_pr="${kv#*=}" ;; merged) set_merged=1 ;; esac
  done
  if [ -n "$set_pr" ] && [ -z "$set_merged" ] && [ "$new_pr" != "$(fm_get "$f" pr)" ]; then
    local -a new_refs old_oids
    read -ra new_refs <<<"$new_pr"
    read -ra old_oids <<<"$(fm_get "$f" merged)"
    [ "$(state_of "$f")" = done ] && [ "$(fm_get "$f" status)" = ok ] &&
      { [ "${#new_refs[@]}" -eq 0 ] || [ "${#new_refs[@]}" -eq "${#old_oids[@]}" ]; } ||
      header_del "$f" merged
  fi
  for kv in "$@"; do
    case "$kv" in
      session=*) kv="session=$(qualified "${kv#*=}")" || exit 1 ;;
      after=*) kv="after=$(word_list "${kv#*=}")" ;;
      phases=*) kv="phases=$(word_list "${kv#*=}")" ;;
      title=*) kv="title=$(one_line "${kv#*=}")" ;;
    esac
    header_set "$f" "${kv%%=*}" "${kv#*=}"
    set_kv+=("$kv")
  done
  item_event item-set "$f" --why "${set_kv[*]}"
  echo "$slug: $*"
  # priority= goes on the row too, as bump writes it: the order reads the row (row_prios).
  for kv in "$@"; do
    [ "${kv%%=*}" = priority ] && [ "$(state_of "$f")" != done ] || continue
    [ -n "${AQ_LOCKED-}" ] || unlock
    row_prio_write "$f" "${kv#*=}"
  done
  [ -z "$left_row" ] || [ "$left_row" = "$(item_row "$f")" ] || repoint_row "$slug" "$f" "$left_row" "$left_prof" "$left_lane"
  # A queued item the set gave a gate waits on its board row, not in the queue (cmd_add): it goes back
  # there carrying it (return_gates).
  case " $* " in *" tags="* | *" after="*) ;; *) return 0 ;; esac
  [ "$(state_of "$f")" = queued ] || return 0
  hold_for "$(fm_get "$f" after)" "$(fm_get "$f" tags)" "" "$f"
  [ -n "$HOLD" ] || return 0
  [ -n "${AQ_LOCKED-}" ] || unlock
  ( cmd_return "$slug" --why "the set gave it a gate ($HOLD): it waits on its board row" ) ||
    die "$slug is queued with a gate ($HOLD) it could not take back to its board row: agent-queue return $slug --why <why>, or set it back"
}

# repoint_row <slug> <file> <row> <profile> <lane> -- an active item re-pointed to another row
# (`set row=` or `from=board:`) no longer works <row> (on <profile> and <lane>, as it was before the
# set), so that row is un-started now instead of reading as board_orphan_started until reap's orphan
# pass, and the row it works now is marked as a move to its state would mark it (mark_row). A row
# another active item names is that item's, and a done item's rows are its close's business.
repoint_row() {
  local slug=$1 f=$2 row=$3 prof=$4 other
  [ "$(state_of "$f")" != done ] && command -v notes >/dev/null || return 0
  other="$(collect_rows $ACTIVE | jq -r --arg r "$row" --arg s "$slug" 'first(.[] | select(.row == $r and .slug != $s) | .slug) // empty')" ||
    { echo "agent-queue: $slug left row ${row#*:}, not un-started: the queue could not be read" >&2; return 0; }
  [ -n "${AQ_LOCKED-}" ] || unlock
  if [ -n "$other" ]; then :
  elif unstart_row "$row" "$prof" "$5"; then
    echo "$slug: board row ${row#*:} on ${row%%:*} un-started, the item works another row"
  else
    echo "agent-queue: $slug left board row ${row#*:} on ${row%%:*}, not un-started; if it is still started: $UNSTART_HINT" >&2
  fi
  case "$(state_of "$f")" in queued) mark_row "$f" start ;; *) mark_row "$f" run ;; esac
}

# unstart_row <row> <profile> <lane> [<why>] -- un-start that board row through notes, the rows' one
# writer (the agent lane's flag and the profile as mark_row gives them); given a why, drop it
# undelivered instead (return --drop). Fails when notes does, with the command to run by hand in
# UNSTART_HINT. The caller has let the queue lock go.
unstart_row() {
  local row=$1 prof=$2 flag=() verb=unstart why=()
  case "$3" in '' | agent) flag=(--agent) ;; esac
  [ -z "${4-}" ] || { verb=drop why=(--why "$4"); }
  UNSTART_HINT="notes ${prof:+--profile $prof }ptask ${row%%:*} ${flag[*]} $verb ${row#*:}${4:+ --why <why>}"
  command -v notes >/dev/null &&
    notes ${prof:+--profile "$prof"} ptask "${row%%:*}" "${flag[@]}" "$verb" "${row#*:}" ${why[@]+"${why[@]}"} >/dev/null 2>&1
}

# gate_row <row> <profile> <lane> <tag>... -- add those gate tags to the board row through notes
# (`ptask tag --add`), as unstart_row writes it. Fails when notes does, with the command in GATE_HINT.
gate_row() {
  local row=$1 prof=$2 flag=() add=() t
  case "$3" in '' | agent) flag=(--agent) ;; esac
  shift 3
  for t in "$@"; do add+=(--add "$t"); done
  GATE_HINT="notes ${prof:+--profile $prof }ptask ${row%%:*} ${flag[*]} tag ${add[*]} ${row#*:}"
  command -v notes >/dev/null &&
    notes ${prof:+--profile "$prof"} ptask "${row%%:*}" "${flag[@]}" tag "${add[@]}" "${row#*:}" >/dev/null 2>&1
}

# return_gates <file> <chain> -> the board gate tags (no #, space-separated) for what a returned item still
# waits on, so its row waits on the board for the same: each live after: slug as after/<its row's id>,
# and each hold tag holding it now (gate_board_tag). An ask: tag goes back answered or not, so the
# human's answer still reaches the work when the row is promoted again (fleet-dispatch ask_decisions).
# An after: slug that closed ok is met, and one that closed otherwise is the dead cause the return
# settles, so neither goes. Nor does an after: item with no row that is in <chain> (the slugs this
# return closes, space-padded): it closes here undelivered, so nothing is left to wait on. Dies naming
# a hold with no board form: any other after: item with no row, or a tag value a hashtag cannot carry.
return_gates() { pending_gates "$(fm_get "$1" slug)" "$(fm_get "$1" after)" "$(fm_get "$1" tags)" "$2" return; }

# pending_gates <slug> <after> <tags> <chain> <verb> -> return_gates for these header values; <verb> is
# the act a die names (`return`, or `hold` for an add, cmd_add). An add passes no chain.
pending_gates() {
  local slug=$1 chain=$4 verb=$5 s g row t attag="" desk="" out="" AST HOLD HOLD_DEAD GB
  for s in $2; do
    after_status "$s"
    [ -z "$AST" ] || continue
    g="$(find_item "$s")" row=""
    [ -z "$g" ] || row="$(item_row "$g")"
    [ -n "$row" ] || [[ "$chain" != *" $s "* ]] || continue
    if [ -z "$row" ]; then
      [ "$verb" = return ] || die "cannot hold $slug on the board: it waits on $s, which has no board row for its row to wait on (#after/<row-id>); give $s a row (agent-queue set $s row=<board>:<id>), or add $slug without --after $s"
      die "cannot return $slug: it waits on $s, which has no board row for its row to wait on (#after/<row-id>); return $s, which takes $slug back with it, or set $slug after= without it"
    fi
    [[ "${row#*:}" =~ ^[A-Za-z0-9_./-]+$ ]] ||
      die "cannot $verb $slug: it waits on $s, whose row id '${row#*:}' has no board form (a hashtag is letters, digits and _ . / -)"
    out+=" after/${row#*:}"
  done
  for t in $3; do [[ "$t" =~ ^at:[0-9]{4}-[0-9]{2}-[0-9]{2}T ]] && attag="$t"; done
  for t in $3; do
    case "$t" in
      ask:?*) ;;
      # Not a gate: the rank its hold: gives it among the desk's waiters (desk_wait), which promote puts back.
      desk:?*) desk="desk/${t#desk:}"; continue ;;
      # Judged with the item's at: date, as hold_for judges a nightly: on that night.
      at:* | rbw:* | pr:* | hold:* | nightly:*) hold_for "" "$t${attag:+ $attag}"; [[ "$HOLD" == "$t"* ]] || continue ;;
      *) continue ;;
    esac
    gate_board_tag "$t" ${attag:+"${attag:3:10}"} ||
      die "cannot $verb $slug: its hold $t has no board form (a hashtag is letters, digits and _ . / -); ${chain:+set $slug tags= without it first}${chain:-pass --tags without it}"
    out+=" $GB"
  done
  [[ -z "$desk" || " $out" != *" hold/"* ]] || out+=" $desk"
  printf '%s' "${out# }"
}

# add_gates <slug> <after> <tags> -> sets AFTER_ITEMS to the item slugs of <after> and GATES to the board
# gate tags (no #, space-separated) the add still waits on: pending_gates for its hold, plus after/<id>
# for each <after> word that is an open row's id and no item's slug (add --plan chains a phase filed on the
# board so). Empty GATES: it can start now. Dies on a hold that never releases, since a row waiting on it
# would never start either.
add_gates() {
  local s st HOLD HOLD_DEAD rows=""
  AFTER_ITEMS="" GATES=""
  for s in $2; do
    if [[ "$s" =~ ^[a-z0-9]+-[0-9]+$ ]] && [ -z "$(find_item "$s")" ] && [ -z "$(done_status "$s")" ]; then rows+=" $s"
    else AFTER_ITEMS+="${AFTER_ITEMS:+ }$s"; fi
  done
  check_after "$AFTER_ITEMS" "$1"
  hold_for "$AFTER_ITEMS" "$3"
  [ -z "$HOLD_DEAD" ] || die "$1 would never start: $HOLD"
  [ -z "$HOLD" ] || GATES="$(pending_gates "$1" "$AFTER_ITEMS" "$3" "" hold)" || exit 1
  for s in $rows; do
    # A row add_plan just filed is open: no board read to say so.
    [[ " ${AQ_ROWS_FILED-} " != *" $s "* ]] || { GATES+="${GATES:+ }after/$s"; continue; }
    st="$( (cmd_gate "after/$s") 2>&1)" && continue
    case "$st" in pending*) GATES+="${GATES:+ }after/$s" ;; *) die "--after $s: ${st#* after/$s: }" ;; esac
  done
}

# retask <slug> [task...] -- replace a queued item's task, from args or stdin like add: the correction
# for a task that holds a wrong fact, since the task is what its session is briefed with. A started
# item is refused: its session already has the brief, so tell the session instead. The header stays
# as filed (its row, title and holds); `set title=` when the correction changes what the item is
# called, `set type= area=` when it changes its kind.
# The row is the task's record, so its brief is rewritten first (row_brief, `notes ptask edit
# --brief`), and the item's body is then the snapshot of the new task; a row that cannot be
# rewritten leaves both as they were.
cmd_retask() {
  local slug="${1:?usage: agent-queue retask <slug> [task...]}" f text tmp was row prof flag=() words out
  shift
  if [ $# -gt 0 ]; then text="$*"; elif [ ! -t 0 ]; then text="$(cat)"; fi
  [ -n "$(printf '%s' "${text:-}" | tr -d '[:space:]')" ] || die "no task: pass it as arguments or on stdin"
  lock
  f="$(find_item "$slug")"; [ -n "$f" ] || die "nothing active with slug $slug"
  [ "$(state_of "$f")" = queued ] || die "$slug is $(state_of "$f"): its session already has the brief; tell the session"
  row="$(item_row "$f")"
  if [ -n "$row" ]; then
    prof="$(fm_get "$f" profile)"
    case "$(fm_get "$f" lane)" in '' | agent) flag=(--agent) ;; esac
    # notes writes the row and may call agent-queue: the lock goes first, as in close_row_on_item.
    unlock
    command -v notes >/dev/null || die "$slug: no notes on PATH to rewrite its board row ${row#*:}"
    words="$(notes board --json 2>/dev/null | jq -r --arg p "${row%%:*}" --arg k "${row#*:}" \
      'first(.rows[]? | select(.project == $p and .id == $k) | .text) // empty')"
    [ -n "$words" ] || die "$slug: its board row ${row#*:} is not open on ${row%%:*}, so nothing was rewritten"
    out="$(notes ${prof:+--profile "$prof"} ptask "${row%%:*}" "${flag[@]}" edit "${row#*:}" "--brief=$(row_brief "$words" "$text")" 2>&1)" ||
      die "$slug: its board row ${row#*:} on ${row%%:*} was not rewritten, so neither was the item: ${out##*$'\n'}"
    lock
    f="$(find_item "$slug")"
    [ -n "$f" ] && [ "$(state_of "$f")" = queued ] ||
      die "$slug started while its row was rewritten: row ${row#*:} has the new brief, its session the old; tell the session"
  fi
  was="$(fm_body "$f" | awk 'NR==1')"
  tmp="$(mktemp "$(dirname "$f")/.retask.XXXXXX")" || die "cannot write in $(dirname "$f")"
  { awk '{ print } $0 == "---" { exit }' "$f"; printf '%s\n' "$text"; } > "$tmp" && mv -- "$tmp" "$f"
  item_event item-set "$f" --why "task rewritten, was: $was"
  echo "$slug: task rewritten"
}

# attribute <slug> -- credit an item by the files its PR changed, repo-relative paths on stdin.
# The candidates are the registry projects with a `path` in the item's repo (its project's `repo`,
# else the project itself). The one owning the most changed files gets the item, and every one
# owning any is recorded in `touches:`. No file under a path, or a tie for the most, leaves
# `project:` as it is. agent-land runs it on a merge. Prints what it recorded, or nothing.
cmd_attribute() {
  [ $# -eq 1 ] || die "usage: agent-queue attribute <slug> < changed-paths"
  local f project res win touches
  [ -f "$AQ_MAP" ] || return 0
  lock
  f="$(find_item "$1" any)"; [ -n "$f" ] || die "no item: $1"
  project="$(fm_get "$f" project)"
  res="$(credit_of "$project")" || die "could not read $AQ_MAP"
  [ -n "$res" ] || return 0
  win="${res%%$'\t'*}" touches="${res#*$'\t'}"
  header_set "$f" touches "$touches"
  if [ -n "$win" ] && [ "$win" != "$project" ]; then
    header_set "$f" project "$win"
    echo "credited to $win (touches $touches)"
  else
    echo "touches $touches"
  fi
}

# credit_of <project> < changed-paths -> "<winner>\t<touches>", or nothing when no path matches: the
# attribution rule itself, shared by `attribute` (which records it), `credit-of` (which only prints
# it, for credit-backfill) and session-outcomes. A path is an app's when it is under the app's tracker
# `path`, else when one of its directories is named after the app (infra/flux/apps/prod/<app>/,
# store/<app>/). The winner owns the most paths, and is empty on a tie.
credit_of() {
  jq -nRr --slurpfile m "$AQ_MAP" --arg p "$1" '
    ($m[0].trackers // {}) as $t
    | (($t[$p] | objects | .repo) // $p) as $repo
    | [$t | to_entries[] | select((.value | objects | .repo) == $repo and (.value.path // "") != "")
       | {key, dir: (.value.path | rtrimstr("/") + "/")}] as $cands
    | [inputs | select(. != "") | . as $f
       | [$cands[] | .dir as $d | select($f | startswith($d)) | .key] as $in
       | if $in != [] then $in[] else ($f | split("/") | .[0:-1]) as $ds | $cands[] | select(.key as $k | $ds | index($k)) | .key end]
    | group_by(.) | map({key: .[0], n: length})
    | sort_by(-.n, .key)
    | select(length > 0)
    | (if length > 1 and .[0].n == .[1].n then "" else .[0].key end) + "\t" + (map(.key) | sort | join(" "))'
}

cmd_credit_of() {
  [ $# -eq 1 ] || die "usage: agent-queue credit-of <project> < changed-paths"
  [ -f "$AQ_MAP" ] || return 0
  credit_of "$1" || die "could not read $AQ_MAP"
}

# END_REASONS and UNRATED_ENDS: lib/end-reasons.sh.
check_end() { case " $END_REASONS " in *" $1 "*) ;; *) die "end_reason is one of: $END_REASONS, not $1" ;; esac; }

# cancel_who -> who a cancel is attributed to: the Claude session, else the item the caller works,
# else nothing (a terminal). A caller with an identity owes a reason; the human at a terminal does not.
cancel_who() { printf '%s' "${CLAUDE_CODE_SESSION_ID:-${AGENT_QUEUE_ITEM:-}}"; }
# cancel_check <why> -> die when a session or script cancels with no reason.
cancel_check() {
  case "$1" in *$'\n'*) die "--why is one line" ;; esac
  [ -n "$1" ] || [ -z "$(cancel_who)" ] || die "a cancel from a session or script needs --why \"<reason>\": who cancelled it and why stay on the item"
}
# cancel_guard <file> <ask> -> die when a session or script cancels work the human asked for (human_work)
# without an answered ask that names the item: an answer about other work is not one about this. Any
# --ask is checked so, since the item records it as the decision. The judge answers such an ask like
# any other, and its policy sends a bulk one (10 or more records) to the human (ar-4765); a session's
# or shepherd's own answer is no ruling, so only the judge's or the human's counts. The human at
# a terminal or the Queue tab's button is not held. 2026-11-12: two cleanups cancelled 220 from: human
# items, one by looping a dead chain.
cancel_guard() {
  local slug pend f by
  slug="$(fm_get "$1" slug)"
  if [ -n "$2" ]; then
    [[ "$2" =~ ^[A-Za-z0-9_-]+$ ]] || die "--ask takes an ask id, not $2"
    pend="$(ask_pending "$2")"
    # gate: aq-cancel-guard
    [ -z "$pend" ] || die "$slug: ask $2 is $pend: --ask names an answered ask"
    # An empty by is legacy (before answered_by), when every answer was the human's.
    f="$(compgen -G "$AQ_ASKS/*/$2.md" | awk 'NR == 1')"
    by="$(sed -n '/^answered_by: */{s///p;q;}' "$f")"
    case "$by" in '' | human | judge) ;; *) die "$slug: ask $2 is answered by $by: --ask names an ask the judge or the human answered" ;; esac
    grep -qwF -- "$slug" "$f" || die "$slug: ask $2 does not name $slug: --ask names the answer about this item"
    return 0
  fi
  # gate: aq-cancel-guard
  [ -n "$(cancel_who)" ] || return 0
  human_work "$(fm_get "$1" from)" "$(fm_get "$1" tags)" || return 0
  die "$slug is work the human asked for: a session or script cancels it only with --ask <id>, an answered ask naming it (agent-ask post), or the human cancels it from a terminal or the Queue tab"
}
# cancel_why <why> <ask> -> the reason with the ask that settled it, so the item names the decision.
cancel_why() { printf '%s' "$1${2:+${1:+ }(ask $2)}"; }
# cancel_stamp <file> <why> -> cancelled_by: and cancel_why: on the item, the one record of a cancel.
cancel_stamp() {
  local who; who="$(cancel_who)"
  [ -z "$who" ] || header_set "$1" cancelled_by "$who"
  [ -z "$2" ] || header_set "$1" cancel_why "$2"
}

# move <slug> <state> [--status s] [--end reason] [--if <state>] -- --end records why the run ended
# (end_reason:); --if is the compare in a compare-and-set: the
# move happens only while the item is still in the state the caller read, so a pass that read it a
# moment ago never undoes a move made since (a requeue, the session's own close).
cmd_move() {
  local slug="${1:?usage: agent-queue move <slug> <state> [--status s] [--end reason] [--cause c] [--if state]}" to="${2:?usage: agent-queue move <slug> <state>}"
  local status="" end="" cause="" expect="" why="" ask="" f from dest run tags
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --status) status="${2:?--status needs a value}"; shift 2 ;;
      --end) end="${2:?--end needs a reason}"; check_end "$end"; shift 2 ;;
      --if) expect="${2:?--if needs a state}"; shift 2 ;;
      --cause) cause="${2:?--cause needs a cause}"; shift 2
        case " $MOVE_CAUSES " in *" $cause "*) ;; *) die "--cause is one of $MOVE_CAUSES (lib/end-reasons.sh), not $cause" ;; esac ;;
      --why) why="${2:?--why needs a reason}"; shift 2 ;;
      --ask) ask="${2:?--ask needs an ask id}"; shift 2 ;;
      *) die "usage: agent-queue move <slug> <state> [--status s] [--end reason] [--cause c] [--why text] [--ask id] [--if state]" ;;
    esac
  done
  case "$to" in queued | running | waiting | review | done) ;; *) die "state is queued, running, waiting, review or done, not $to" ;; esac
  [ -z "$cause" ] || [ "$to" = queued ] || die "--cause says why a started item goes back to the queue: use it with move <slug> queued"
  if [ "$to" = "done" ]; then
    case "$status" in ok | failed | cancelled) ;; *) die "move to done needs --status ok, failed or cancelled" ;; esac
  fi
  if [ "$to" = done ] && [ "$status" = cancelled ]; then cancel_check "$why"
  elif [ -n "$why$ask" ]; then die "--why and --ask record a cancel: use them with move <slug> done --status cancelled"; fi
  [ -n "${AQ_LOCKED-}" ] || lock
  f="$(find_item "$slug")"; [ -n "$f" ] || die "nothing active with slug $slug"
  from="$(state_of "$f")"
  [ -z "$expect" ] || [ "$from" = "$expect" ] || { echo "agent-queue: $slug is $from, not $expect: left as it is" >&2; return 3; }
  [ "$from" != "$to" ] || { echo "$slug already $to"; return 0; }
  # The queue holds only work that can start (cmd_add): an item that still waits goes back to its row
  # with that gate, as a set does (cmd_set), so fleet-dispatch reap's requeue of a gone session's item
  # does not leave it stranded where it was.
  if [ "$to" = queued ]; then
    local HOLD HOLD_DEAD
    hold_for "$(fm_get "$f" after)" "$(fm_get "$f" tags)" "" "$f"
    if [ -n "$HOLD" ]; then
      [ -n "$(item_row "$f")" ] && [ -z "${AQ_LOCKED-}" ] ||
        die "$slug waits on $HOLD, and the queue holds only work that can start: give it a board row (agent-queue set $slug row=<board>:<id>) and return it (agent-queue return $slug --why <why>)"
      unlock
      ( cmd_return "$slug" --why "moved to queued while it waits on $HOLD: its board row waits on it" ) ||
        die "$slug waits on $HOLD and could not go back to its board row: agent-queue return $slug --why <why>"
      return 0
    fi
  fi
  # A start waits on what holds it, as the queue does: a queued item whose after: is live or dead, or
  # whose tag gate is not clear, is not started by hand ahead of it (ar-3260). A waiting or review item
  # already started, so its move back to running is a resume and reads no gate. Nor does a queued item
  # that records a session: fleet-dispatch start set it after the launch, and judged the hold before it,
  # so a gh or rbw blip read here would leave that live session on an item still queued.
  if [ "$to" = running ] && [ "$from" = queued ] && [ -z "$(fm_get "$f" session)" ]; then
    start_gate "$slug" "$(fm_get "$f" after)" "$(fm_get "$f" tags)" start "dispatch starts it once that clears, or clear it first (agent-queue set $slug after= or tags= without it)" "$f"
  fi
  if [ "$status" = cancelled ]; then cancel_guard "$f" "$ask"; why="$(cancel_why "$why" "$ask")"; fi
  if [ "$to" = done ] && [ "$status" = ok ] && [ "$(fm_get "$f" partial)" = yes ]; then
    die "$slug has a partial landing; finish with agent-land <N> without --partial before closing it ok"
  fi
  # Done ok with a PR means merged: an ok close with the PR still open strands it, since nothing
  # reads that item again and its after: items start on work that never landed (#1145, #1146).
  if [ "$to" = done ] && [ "$status" = ok ] && [ -n "$(fm_get "$f" pr)" ] && [ -z "$(fm_get "$f" merged)" ]; then
    die "$slug has pr:$(fm_get "$f" pr) and no merged:, so done ok would close it with the PR open: land it with agent-land <N>, which records the merge, or move it to review until the PR merges (fleet-dispatch reap closes it then)"
  fi
  run="$(fm_get "$f" lane_run)"
  case "$to" in
    # Back in the queue, the item runs nowhere: the next start launches a fresh session and
    # records it, and until then a stale `session:` points shepherd and fleet-sessions at a window
    # that no longer works it. `sessions:` stays: it is the history of who worked the item.
    # lane_run goes too: the next start logs a run of its own, and host: too, since the next start
    # may run it here.
    # `requeued` is when it went back: ITEM_JQ reads its ready time from there, since `started` is gone
    # and a restart a week later would otherwise read as a week of waiting since the predecessor finished.
    queued) [ -z "$(fm_get "$f" started)" ] || header_set "$f" requeued "$(now_utc)"
      header_del "$f" session window started waiting review origin lane_run host desk_start ;;
    running) [ -n "$(fm_get "$f" started)" ] || header_set "$f" started "$(now_utc)"
      # A new run has not ended yet: the last run's reason goes.
      header_del "$f" end_reason
      # A hold: tag gates one start: once running, the item's own session may claim that resource,
      # and a tag left on would hold the item behind its own claim if it is ever requeued.
      tags="$(fm_get "$f" tags)"
      # Its desk_start keeps the next waiter off the resource until this session claims it; its
      # desk: class stays, so a later requeue keeps its rank.
      case " $tags " in *" hold:"*)
        header_set "$f" desk_start "$(tr ' ' '\n' <<<"$tags" | sed -n 's/^hold://p' | awk 'NR==1')"
        tags="$(tr ' ' '\n' <<<"$tags" | grep -v '^hold:' | paste -sd' ')"
        if [ -n "$tags" ]; then header_set "$f" tags "$tags"; else header_del "$f" tags; fi ;;
      esac ;;
    waiting) header_set "$f" waiting "$(now_utc)" ;;
    review) header_set "$f" review "$(now_utc)" ;;
    # A run that landed or was cancelled has no end to report: a reason left from a wait on its PR goes.
    done) header_set "$f" status "$status"; header_set "$f" finished "$(now_utc)"
      [ "$status" != cancelled ] || cancel_stamp "$f" "$why"
      case "$status" in ok | cancelled) header_del "$f" end_reason; end="" ;; esac ;;
  esac
  [ -z "$end" ] || header_set "$f" end_reason "$end"
  dest="$(move_to "$f" "$to")" || die "could not move $f"
  item_event item-moved "$dest" --to "$to" --why "$from -> $to${status:+ ($status)}${why:+: $why}"
  echo "$slug: $from -> $to"
  lane_outcome "$run" "$from" "$to" "$status" "$end" "$cause"
  # The row's section follows the item: Now while it runs or waits on someone, Next up once back in
  # the queue. waiting and review keep the mark: the item started.
  case "$to" in running) mark_row "$dest" run ;; queued) mark_row "$dest" start ;; esac
  [ "$to" = done ] && [ "$status" = ok ] || return 0
  close_row_on_item "$slug" "$dest"
  pull_after "$slug" "$dest"
}

# mark_row <file> <run|start> -- the item's board row records its queue state, through notes, the rows'
# one writer: `run` adds run:MMDD (the sweep puts the row in Now), `start` takes it off again (Next up).
# The item is the state and the row its view, so a row the write cannot reach warns and the move stands.
mark_row() {
  local row prof flag=()
  row="$(item_row "$1")" prof="$(fm_get "$1" profile)"
  [ -n "$row" ] && command -v notes >/dev/null || return 0
  case "$(fm_get "$1" lane)" in '' | agent) flag=(--agent) ;; esac
  notes ${prof:+--profile "$prof"} ptask "${row%%:*}" "${flag[@]}" "$2" "${row#*:}" >/dev/null 2>&1 ||
    echo "agent-queue: board row ${row#*:} on ${row%%:*} not marked $2: notes ${prof:+--profile $prof }ptask ${row%%:*} ${flag[*]} $2 ${row#*:}" >&2
}

# close_row_on_item <slug> <file> -- an item closed ok with no PR closes its row, the item as proof:
# its session's close is the claim, as the merge is for an item with a PR (agent-land, or
# fleet-dispatch close_row when its session died first). Its sessions read the move as closing the
# row, and a row left started reads as an orphan. A row already closed (a doc kind closes its own
# with doc: proof) is left as it is; a close that fails warns unless the board shows the row closed.
# Before pull_after, which pulls the rows waiting on this one: this frees the lock before calling notes.
close_row_on_item() {
  local slug=$1 row prof lane pr flag=() out key board
  IFS=$'\x1f' read -r row prof lane pr < <(item_json "$2" |
    jq -r '[.row // "", .profile // "", .lane // "", .pr // ""] | join("\u001f")')
  [ -n "$row" ] && [ -z "$pr" ] || return 0
  case "$lane" in '' | agent) flag=(--agent) ;; esac
  [ -n "${AQ_LOCKED-}" ] || unlock
  key="${row#*:}"
  if out="$(notes ${prof:+--profile "$prof"} ptask "${row%%:*}" "${flag[@]}" done "$key" --proof "item:$slug" 2>&1)"; then
    echo "$slug: board row $key closed"
    return 0
  fi
  # Quiet only when the board reads and its open rows no longer hold this one (by id: lv-9 is not lv-90).
  [[ "$key" =~ ^[a-z]{2,4}-[0-9]+$ ]] && key="id:$key"
  if board="$(notes ${prof:+--profile "$prof"} ptask "${row%%:*}" "${flag[@]}" list 2>/dev/null)" && ! grep -qwF -- "$key" <<<"$board"; then
    return 0
  fi
  echo "agent-queue: $slug is done, but its board row ${row#*:} on ${row%%:*} may still be open (${out##*$'\n'}): notes ${prof:+--profile $prof }ptask ${row%%:*} ${flag[*]} done ${row#*:} --proof item:$slug" >&2
}

# word_list <value> -> a comma or space list as one line of words split by single spaces, each once:
# the form `tags:` and `after:` store.
word_list() {
  printf '%s' "$1" | tr ',' ' ' | awk '{ for (i = 1; i <= NF; i++) if (!seen[$i]++) o = o (o == "" ? "" : " ") $i } END { print o }'
}

# check_after <slugs> [<own slug>] -- die on an `after:` slug no item has, or one naming the item
# itself, since neither ever releases: add, add --plan and `set after=` check.
# gate: aq-check-after
check_after() {
  local s
  for s in $1; do
    [ "$s" != "${2-}" ] || die "--after $s: an item cannot wait on itself"
    [ -n "$(find_item "$s")" ] || [ -n "$(done_status "$s")" ] || die "--after $s: no item has that slug"
  done
}

# check_tags <tags> -- die on a hold tag the queue could not read, so a gate is never silently
# open or shut: add and `set tags=` both check.
# gate: aq-check-tags
check_tags() {
  local tag why opts rest opt
  for tag in $1; do
    case "$tag" in
      at:*) [[ "$tag" =~ ^at:([0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T)?([01][0-9]|2[0-3]):[0-5][0-9]$ ]] ||
        die "a time tag is at:HH:MM or at:YYYY-MM-DDTHH:MM, not $tag" ;;
      pr:*) [[ "$tag" =~ ^pr:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+$ ]] || die "a PR tag is pr:<owner>/<repo>#<N>, not $tag" ;;
      nightly:*) [[ "$tag" =~ ^nightly:[A-Za-z0-9_.-]+$ ]] || die "a nightly tag is nightly:<repo>, the repo's name, not $tag" ;;
      ask:*) [[ "$tag" =~ ^ask:[A-Za-z0-9_-]+(=[^[:space:]]+)?$ ]] || die "an ask tag is ask:<id>[=<option>[+<option>]], not $tag"
        # An ask already cancelled, or answered with another option, can never release
        # the item: on 2026-11-07 can-we-get-cloud-vast-clarke-p3-live was queued behind an ask the
        # judge had answered at post, and upwork-p2..p5 behind one cancelled later.
        why="$(ask_pending "${tag#ask:}")"
        case "$why" in
          "" | pending) ;;
          "no such ask") die "$tag: no agent-ask has that id; post the ask first" ;;
          *) die "$tag: that ask can never release it ($why); post a new one with agent-ask post" ;;
        esac
        # With no option named, every answer releases the item, a "stop" among them.
        # A name the ask does not offer can never match an answer, so the item would wait for good.
        # An answer matches on its first word (ask_pending), and a slug may itself contain a +.
        opts="$(ask_options "${tag#ask:}")"
        [ -n "$opts" ] || continue
        if [[ "$tag" != *=* ]]; then
          die "$tag: that ask offers ${opts//$'\n'/,}; name the answers that release the item: $tag=<option>[+<option>]"
        fi
        rest="+${tag#*=}+"; rest="${rest,,}"
        while IFS= read -r opt; do
          opt="${opt%% *}"; opt="${opt%[.,;:!]}"
          rest="${rest//"+${opt,,}+"/+}"
        done <<<"$opts"
        [ "$rest" = + ] || die "$tag: that ask offers ${opts//$'\n'/,}, and those are what an answer can match" ;;
      hold:*) hold_resource "${tag#hold:}" || die "a hold tag is hold:<resource>, an agent-hold name (letters, digits, . _ -), not $tag" ;;
      desk:*) "$AQ_HOLD" classes | cut -f1 | grep -qx -- "${tag#desk:}" ||
        die "a desk tag is desk:<class>, one of: $("$AQ_HOLD" classes | cut -f1 | paste -sd' '), not $tag" ;;
      rbw:*) [[ "$tag" =~ ^rbw:[^/[:space:]]*/[^[:space:]]+$ ]] || die "an rbw tag is rbw:<folder>/<name>: a top-level folder (empty for an entry in no folder: rbw:/<name>), then the entry name after the first /, no spaces in either, not $tag" ;;
    esac
  done
}

# story_row_for <slug> <file> -- file the story row of an item that has none, from its title, priority and
# brief (file_story, started with the item), and link it with `set row=`. Fails when no row was filed or linked.
# Called without the lock: file_story runs notes, and set takes the lock itself.
story_row_for() {
  local slug=$1 f=$2 title prio proj board prof id
  title="$(fm_get "$f" title)"; [ -n "$title" ] || title="$(fm_body "$f" | awk 'NR==1')"
  prio="$(fm_get "$f" priority)"; proj="$(fm_get "$f" project)"
  IFS=$'\t' read -r board prof id < <(file_story "$proj" "$title" "${prio:-high}" "" "" "$(fm_body "$f")" "" "" "$(fm_get "$f" tags)" </dev/null)
  [ -n "$id" ] || return 1
  "$0" set "$slug" row="$board:$id" lane=agent profile="$prof" </dev/null >/dev/null ||
    { echo "agent-queue: row $board:$id filed but not linked to $slug; link it with agent-queue set $slug row=$board:$id" >&2; return 2; }
}

# requeue <slug> --hold <resource> | --ask <id>[=<option>] -- send an active item back to its board row,
# gated on an agent-hold resource or on an agent-ask the human has not answered. --hold is for a session that
# finds a resource it needs held by another (`agent-hold claim` said busy); --ask for a headless run
# (Codex) that needs the human, whose run ends when it stops: the answer starts it again and its brief
# carries the decision (fleet-dispatch ask_decisions), where a run left waiting would have no session to
# hear it. Not a redo: the model did nothing wrong, so its lane run is dropped, not reported to
# model-lane, as a cancel is.
cmd_requeue() {
  local usage="usage: agent-queue requeue <slug> --hold <resource> [--class <class>] | --ask <id>[=<option>[+<option>]]"
  local slug="${1:?$usage}" res="" ask="" cls="" tag f tags
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --hold) res="${2:?--hold needs a resource}"; shift 2 ;;
      --ask) ask="${2:?--ask needs an ask id}"; shift 2 ;;
      --class) cls="${2:?--class needs a class (agent-hold classes)}"; shift 2 ;;
      *) die "$usage" ;;
    esac
  done
  [ -n "$res$ask" ] && { [ -z "$res" ] || [ -z "$ask" ]; } || die "$usage"
  [ -z "$cls" ] || [ -n "$res" ] || die "$usage"
  [ -z "$cls" ] || check_tags "desk:$cls"
  if [ -n "$res" ]; then
    hold_resource "$res" || die "not an agent-hold resource: $res (letters, digits, . _ -)"
    # A free resource would restart the item at once: the caller claims it instead.
    [ -n "$(hold_pending "$res")" ] || die "$res is not held: claim it (agent-hold claim $res) instead of requeueing"
    tag="hold:$res"
  else
    tag="ask:$ask"
    # An answered or missing ask would release it at once, or never: check_tags says which.
    check_tags "$tag"
    [ -n "$(ask_pending "$ask")" ] || die "ask ${ask%%=*} is already answered: read the answer and go on instead of requeueing"
  fi
  lock
  f="$(find_item "$slug")"; [ -n "$f" ] || die "nothing active with slug $slug"
  # The wait is the board row's (cmd_add). A hand-queued item may have none (add --running filed no row,
  # or its story row was refused): file one from the item, as backfill-briefs does, so the return has a
  # row to gate. notes writes it and may call agent-queue, so the lock goes first.
  if [ -z "$(item_row "$f")" ]; then
    local rc=0
    unlock
    story_row_for "$slug" "$f" || rc=$?
    case "$rc" in
      0) ;;
      2) die "$slug has a filed row it is not linked to (above): link it, then requeue again" ;;
      *) die "$slug has no board row to wait on $tag, and none could be filed for it: give it one (agent-queue set $slug row=<board>:<id>) and requeue again" ;;
    esac
    lock
    f="$(find_item "$slug")"; [ -n "$f" ] || die "nothing active with slug $slug"
    # The filing took a while with the lock off: the gate may have cleared since the checks above.
    if [ -n "$res" ]; then [ -n "$(hold_pending "$res")" ] || die "$res was released while the row was filed: claim it (agent-hold claim $res) instead of requeueing"
    else [ -n "$(ask_pending "$ask")" ] || die "ask ${ask%%=*} was answered while the row was filed: read the answer and go on instead of requeueing"; fi
  fi
  tags="$(fm_get "$f" tags)"
  local want="$tags"
  case " $want " in *" $tag "*) ;; *) want="${want:+$want }$tag" ;; esac
  # One class per item: a new --class replaces the last.
  [ -z "$cls" ] || want="$(tr ' ' '\n' <<<"$want" | grep -v '^desk:' | paste -sd' ') desk:$cls"
  want="${want# }"
  [ "$want" = "$tags" ] || { header_set "$f" tags "$want"; item_event item-set "$f" --why "tags=$want"; }
  header_del "$f" lane_run
  unlock
  # Its row takes the gate (#ask/<id>, #hold/<res>, with #desk/<class>) and the item closes returned:
  # the row is promoted once the gate clears, and the answer reaches the new item's brief
  # (fleet-dispatch ask_decisions). The session that asked is not closed: it is the caller, and stops.
  AQ_RETURN_KEEP_SESSION=1 cmd_return "$slug" --why "requeued behind $tag: its row waits on it"
}

# handoff <slug> --note <file> [--dir <checkout>] -- a running item's session passes the item to a fresh
# session, so the work goes on without the context the long run carries (lever 2 of plan
# lets-do-a-thoruoghou-abundant-teapot, P4; the long-session-handoff hook says when). The work must be on
# origin first: a checkout with uncommitted changes, or a head with work the trunk lacks that origin does not
# have, is refused, so nothing is lost with the old window. That head becomes `salvage:` (salvage_line in the
# next brief), unless the item has a PR, which the next brief continues (pr_line). The note becomes `handoff:`,
# which the next brief names first (handoff_line). The item goes back to queued with end_reason: handoff, an
# unrated end (lib/end-reasons.sh), and `handoffs:` counts them: AGENT_HANDOFF_MAX (2) per item, so a run that
# keeps handing off finishes where it is instead.
cmd_handoff() {
  local usage="usage: agent-queue handoff <slug> --note <file> [--dir <checkout>]"
  local slug="${1:?$usage}" note="" dir="$PWD" f n max="${AGENT_HANDOFF_MAX:-2}" br sha trunk remote sv=""
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --note) note="${2:?--note needs a file}"; shift 2 ;;
      --dir) dir="${2:?--dir needs a checkout}"; shift 2 ;;
      *) die "$usage" ;;
    esac
  done
  [ -n "$note" ] || die "$usage"
  [ -s "$note" ] || die "--note $note is missing or empty: write what is done, what is next and what you learned there first"
  note="$(realpath "$note")"
  # Under HOME, which outlives a reboot: /tmp is tmpfs, and the next run may start after one.
  case "$note" in "$(realpath "$HOME")"/*) ;; *) die "--note $note is outside \$HOME, where it can be gone before the next run reads it: put it in your plan file (~/.claude/plans/)" ;; esac
  git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 || die "$dir is not a git checkout: pass --dir <the item's worktree>"
  [ -z "$(git -C "$dir" status --porcelain 2>/dev/null)" ] ||
    die "$dir has uncommitted changes: commit and push them first, so the next session starts from them"
  sha="$(git -C "$dir" rev-parse HEAD)"
  trunk="$(git -C "$dir" rev-parse -q --verify refs/remotes/origin/HEAD || git -C "$dir" rev-parse -q --verify refs/remotes/origin/main)" ||
    die "$dir has no origin/HEAD or origin/main to tell its work from the trunk's"
  # A head the trunk already holds has no work to carry: the next session starts from the trunk.
  if ! git -C "$dir" merge-base --is-ancestor "$sha" "$trunk" 2>/dev/null; then
    br="$(git -C "$dir" symbolic-ref --short -q HEAD)" || die "$dir is on a detached head: put the work on a branch and push it first"
    remote="$(git -C "$dir" ls-remote origin "refs/heads/$br" 2>/dev/null | cut -f1)"
    [ "$remote" = "$sha" ] || die "$br at ${sha:0:12} is not on origin${remote:+ (origin has ${remote:0:12})}: push it first (git push origin $br), so the next session starts from it"
    sv="$br@$sha"
  fi
  lock
  f="$(find_item "$slug")"; [ -n "$f" ] || die "nothing active with slug $slug"
  [ "$(state_of "$f")" = running ] || die "$slug is $(state_of "$f"), not running: only a running item hands off"
  n="$(fm_get "$f" handoffs)"; [[ "$n" =~ ^[0-9]+$ ]] || n=0
  [ "$n" -lt "$max" ] || die "$slug has handed off $n times (AGENT_HANDOFF_MAX $max): finish it in this session"
  [ -z "$(fm_get "$f" pr)" ] || sv=""
  # The move first: one that is refused leaves the item as it was, its handoffs unspent.
  AQ_LOCKED=1 cmd_move "$slug" queued --end handoff --if running || return
  f="$(find_item "$slug")"; [ -n "$f" ] || die "$slug left the queue on its move to queued: nothing to hand off to"
  # An older salvage: (a lost run's) is not this head: the next start begins from the trunk or the PR instead.
  if [ -n "$sv" ]; then header_set "$f" salvage "$sv"; else header_del "$f" salvage; fi
  header_set "$f" handoff "$note"
  header_set "$f" handoffs "$((n + 1))"
  item_event item-set "$f" --why "handoff $((n + 1)) of $max: $note${sv:+, from $sv}"
  echo "$slug: handed off ($((n + 1)) of $max); end this session now (/wind-down auto): the next start reads $note"
}

# ask-holds [<id>] -- each active item held on an ask, `<slug><TAB><ask id><TAB><options>` (options
# `+`-joined as the tag has them, empty for any answer), from the header's slug and tags lines alone.
# Why: agent-ask asks this on every card and answer, and `list --json` builds every item's whole
# record for it, 1.7 s against a few ms (2026-11-13). A board row gated #ask/<id>[/<option>...] is held
# on it the same way, `<row id><TAB><ask id><TAB><options>`: the work waits there, not in the queue
# (cmd_add), and agent-ask's guards (no closer cancels it, an answer starts a dispatch pass) read
# both. A board that cannot be read lists the items alone.
cmd_ask_holds() {
  local id="${1:-}" FILES=()
  if command -v notes >/dev/null; then
    notes board --json 2>/dev/null | jq -r --arg id "$id" "$ROW_TAGS_JQ"'.rows[]? | select(.state == "open" or .state == "doing") | .id as $r
      | row_tags[] | select(startswith("ask/")) | .[4:] | split("/") | select($id == "" or .[0] == $id)
      | [$r, .[0], (.[1:] | join("+"))] | @tsv' 2>/dev/null
  fi
  lock_read
  list_files waiting review running queued
  ((${#FILES[@]})) || return 0
  awk -v id="$id" -v OFS='\t' '
    function flush(  n, i, t, a) {
      if (slug == "") return
      n = split(tags, t, " ")
      for (i = 1; i <= n; i++) {
        if (substr(t[i], 1, 4) != "ask:") continue
        split(substr(t[i], 5), a, "=")
        if (id == "" || a[1] == id) print slug, a[1], a[2]
      }
    }
    FNR == 1 { flush(); slug = ""; tags = ""; head = 1 }
    !head { next }
    $0 == "---" { head = 0; next }
    /^slug: / { slug = substr($0, 7) }
    /^tags: / { tags = substr($0, 7) }
    END { flush() }' "${FILES[@]}"
}

# reopen <slug> [--to running|waiting] [--why <text>] -- put back an item a false close finished,
# such as a reap that read a live session as gone (ar-900, 2026-11-07: the shepherd had to move the
# file under the lock by hand). The latest done item with the slug goes to running (or waiting) with
# its session: and sessions: as they were, so the next reap reads it live again; status: and
# finished: go, note: says why and keeps the close's own note. Its board row, which the close
# un-started, is started again, after the queue lock is let go. Only a failed close is reopened: an ok
# one may have started the items after: it (pull_after) and a cancel closed its session, so either is
# new work under the slug. A reap that parked a live item in waiting/ needs none: the next reap that
# lists its Claude moves it back to running.
cmd_reopen() {
  local usage="usage: agent-queue reopen <slug> [--to running|waiting] [--why text] [--unland <owner>/<repo>#<N>]"
  local slug="${1:?$usage}" to=running why="" unland="" f dest status note row prof flag=() refs=() oids=() kr=() ko=() i cp
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) to="${2:?--to needs a state}"; shift 2 ;;
      --why) why="${2:?--why needs a reason}"; shift 2 ;;
      --unland) unland="${2:?--unland needs <owner>/<repo>#<N>}"; shift 2 ;;
      *) die "$usage" ;;
    esac
  done
  case "$to" in running | waiting) ;; *) die "reopen goes to running or waiting, not $to" ;; esac
  case "$why" in *$'\n'*) die "--why is one line" ;; esac
  [ -z "$unland" ] || [[ "$unland" =~ ^[^/[:space:]]+/[^/#[:space:]]+#[0-9]+$ ]] || die "--unland takes <owner>/<repo>#<N>, not $unland"
  lock
  [ -z "$(find_item "$slug")" ] || die "$slug is still active: nothing to reopen"
  f="$(latest_done "$slug")"; [ -n "$f" ] || die "no finished item: $slug"
  cause_owner "$(fm_get "$f" tags)" "$slug"
  status="$(fm_get "$f" status)" note="$(fm_get "$f" note)"
  if [ -n "$unland" ]; then
    # A false ok close (agent-land took a side PR from another repo, 2026-11-07): that PR comes
    # off the item, its merge commit with it, so the item's own PR lands on it as its first.
    [ "$status" = ok ] || die "--unland undoes an ok close, and $slug closed ${status:-with no status}"
    read -ra refs <<<"$(fm_get "$f" pr)"
    read -ra oids <<<"$(fm_get "$f" merged)"
    # The lists are kept in step (set clears merged: with pr:); one out of step names no commit by index.
    [ "${#oids[@]}" -eq 0 ] || [ "${#oids[@]}" -eq "${#refs[@]}" ] ||
      die "$slug records ${#refs[@]} pr: and ${#oids[@]} merged: entries, not in step: agent-queue set $slug pr=<refs> merged=<shas> first"
    for i in "${!refs[@]}"; do
      # A bare ref is the PR by its number, as once_done reads it.
      [ "${refs[i],,}" = "${unland,,}" ] || [ "${refs[i]}" = "${unland##*#}" ] || kr+=("${refs[i]}") ko+=("${oids[i]:-}")
    done
    [ "${#kr[@]}" -lt "${#refs[@]}" ] || die "$slug records pr:${refs[*]:-nothing}, not $unland"
    header_set "$f" pr "${kr[*]}"
    header_set "$f" merged "${ko[*]}"
    cp="$(fm_get "$f" closing_pr)"
    [ "${cp,,}" != "${unland,,}" ] || header_del "$f" closing_pr
  else
    [ "$status" = failed ] || die "$slug closed $status, not failed: that is new work under the slug (agent-queue add${status:+ --repeat})${status:+, or --unland <owner>/<repo>#<N> when it closed on a PR that was not its work}"
  fi
  header_del "$f" status finished
  [ "$to" = running ] || header_set "$f" waiting "$(now_utc)"
  header_set "$f" note "reopened from done ($status${unland:+, unlanded $unland}${note:+: $note})${why:+: $why}"
  dest="$(move_to "$f" "$to")" || die "could not move $f"
  item_event item-moved "$dest" --to "$to" --why "done ($status) -> $to: reopened${why:+: $why}"
  echo "$slug: done -> $to (reopened, was $status)"
  # The row, through notes, the rows' one writer (it leaves a row already started as it is), read as
  # fleet-dispatch's settle_row un-started it: no profile is notes' default, no lane is the agent lane.
  row="$(item_row "$dest")" prof="$(fm_get "$dest" profile)"
  [ -n "$row" ] || return 0
  case "$(fm_get "$dest" lane)" in '' | agent) flag=(--agent) ;; esac
  unlock
  # An ok close closed the row too: it opens again, its proof off, before it is started. A row
  # that is not closed (the close never reached it) has nothing to reopen, so start still runs.
  if [ -n "$unland" ]; then
    notes ${prof:+--profile "$prof"} ptask "${row%%:*}" "${flag[@]}" reopen "${row#*:}" --why "closed on $unland, not its work${why:+: $why}" >/dev/null 2>&1 ||
      echo "agent-queue: $slug: board row ${row#*:} on ${row%%:*} was not reopened; if it is closed: notes ${prof:+--profile $prof }ptask ${row%%:*} ${flag[*]} reopen ${row#*:} --why <why>" >&2
  fi
  notes ${prof:+--profile "$prof"} ptask "${row%%:*}" "${flag[@]}" start "${row#*:}" >/dev/null 2>&1 ||
    die "$slug is $to, but its board row ${row#*:} on ${row%%:*} could not be started again: notes ${prof:+--profile $prof }ptask ${row%%:*} ${flag[*]} start ${row#*:}"
  mark_row "$dest" run
  echo "$slug: board row ${row#*:} started again"
}

# lane_outcome <lane_run> <from> <to> <status> [end] [cause] -- the model-lane run a dispatch start logged
# gets what became of it and why (CAUSES, lib/end-reasons.sh): done ok is ok and done failed is failed
# (close), and a started item put back in the queue is redo, with the cause its mover passed (--cause)
# or requeue. Every close goes through move (agent-land, the reap, a hand close), so this is the one
# place outcomes are reported. A run whose end says nothing about the model (UNRATED_ENDS, its own
# cause), a cancel and an UNRATED_CAUSES requeue file the run unrated: counted, never scored. A
# model-lane error never fails the move.
lane_outcome() {
  local o='' c=${6:-}
  [ -n "$1" ] || return 0
  case "$3:$4" in
    done:ok) o=ok c=close ;;
    done:failed) o=failed c=close ;;
    done:cancelled) o=unrated c=cancel ;;
    queued:) case "$2" in running | waiting | review) o=redo c=${c:-requeue} ;; *) return 0 ;; esac ;;
    *) return 0 ;;
  esac
  if unrated_end "${5:-}"; then o=unrated c=$5; elif unrated_cause "$c"; then o=unrated; fi
  model-lane outcome "$1" "$o" --cause "$c" >/dev/null 2>&1 || echo "agent-queue: model-lane outcome $1 $o --cause $c failed" >&2
}

# waits_on <file> <slug> -- the item's `after:` names that slug.
waits_on() {
  local s
  local -a a
  read -ra a <<<"$(fm_get "$1" after)"
  for s in "${a[@]}"; do [ "$s" != "$2" ] || return 0; done
  return 1
}

# waits_turn <slug> <priority> -- exit 0, and say so, when agent-queue must not start the item itself:
# a normal or low one waits for a dispatch pass, which starts the queue in priority order, so such work
# never jumps it (the human, 2026-11-12; normal "waits its turn", priority.md). Urgent and high start at
# once. The one place this rule lives.
waits_turn() {
  [ "$2" = normal ] || [ "$2" = low ] || return 1
  echo "agent-queue: $1 is $2 priority, so a dispatch pass starts it in its turn"
}

# dispatch_held <slugs> -- exit 0, and say so, when the dispatch hold (hold_pending, asked as no session)
# keeps agent-queue from starting those items itself, at add or when the item they wait on closes; a
# failing agent-hold holds. The one place both starts check it. 2026-11-12: an urgent plan item
# started at add under the human's dispatch hold.
dispatch_held() {
  local why; why="$(hold_pending dispatch)"
  [ -n "$why" ] || return 1
  echo "agent-queue: dispatch is held ($why), so $1 stays queued for the next dispatch pass" >&2
}

# pull_after <slug> <file> -- an item that closed ok pulls the board rows gated #after/<its row> now
# (fleet-dispatch pull-after: promoted behind the same gates and room a pass checks, the urgent and high
# ones started), so a plan's next phase takes the slot the closing session frees and waits for no
# dispatch pass. An item with no row has nothing waiting on it there. A failed pull leaves the rows for
# the next pass, which reads the row closed. AGENT_QUEUE_START=0 (the shepherd's idle close) still pulls:
# fleet-dispatch pull-after --queue-only queues the rows and starts none (2026-11-21: ar-4357 sat 10h behind
# ar-4356, which the shepherd closed with the pull skipped and the fleet share cap, now DISPATCH_PROJECT_SHARE, kept a pass from filling it).
pull_after() {
  local row rc=0
  row="$(item_row "$2")"
  [ -n "$row" ] || return 0
  # fleet-dispatch adds through this script: free the lock, and keep the fd out of tmux.
  unlock
  if [ "${AGENT_QUEUE_START:-1}" = 1 ]; then fleet-dispatch pull-after "${row#*:}" || rc=$?
  else fleet-dispatch pull-after --queue-only "${row#*:}" || rc=$?; fi
  [ "$rc" = 0 ] ||
    echo "agent-queue: the rows after ${row#*:} were not pulled now, so the next dispatch pass promotes them" >&2
  return 0
}

cmd_stats() {
  local json="" flow=false since
  since="$(since_day 7)"
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --flow) flow=true; shift ;;  # only day-log reads it, and the hub polls stats
      --since) since="$(since_day "${2:?}")" || exit 1; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  local stats
  # shellcheck disable=SC2086
  stats="$(snap_json . $ACTIVE done --since "$since" | jq -c --arg since "$since" --argjson flow "$flow" '
    def mins($a; $b): if $a and $b then ((($b | fromdateiso8601) - ($a | fromdateiso8601)) / 60 | floor) else empty end;
    def median: sort | if length == 0 then null else .[length / 2 | floor] end;
    def p90: sort | if length == 0 then null else .[(length * 0.9 | ceil) - 1] end;
    def age: ((now - (. | fromdateiso8601)) / 60 | floor);
    # Wait runs from ready (ITEM_JQ), so a deliberate hold is not read as dispatch latency. A
    # `--running` or plan item starts the minute it is added; counting its 0 hid every real wait.
    def waits: [.[] | mins(.ready; .started)];
    def waited: waits | map(select(. > 0));
    # A hold_reason line by its first word: "after x", "at:HH:MM", "pr:o/r#N not merged",
    # "nightly:repo (..)".
    def hold_kind: split(" ")[0] | split(":")[0];
    def source: (.from // "human") | split(":")[0];
    def count_by(f): group_by(f) | map({key: (.[0] | f), value: length}) | from_entries;
    def has_pr: (.pr // "") != "";
    def to_pr: [.[] | select(has_pr) | mins(.queued; .finished)] | median;
    def outcomes: {done: length, ok: map(select(.status == "ok")) | length,
      failed: map(select(.status == "failed")) | length, cancelled: map(select(.status == "cancelled")) | length,
      prs: map(select(has_pr)) | length, wait_minutes_median: (waited | median),
      to_pr_minutes_median: to_pr};
    def group(f): group_by(f) | map({key: (.[0] | f), value: outcomes}) | from_entries;
    def spread: {n: length, p50: median, p90: p90};
    # Chain handoff: an item with an after: key goes from the finish of its predecessor (ready) to its start.
    # 0 is a real answer (the next phase started at once), so unlike waits it is counted.
    # An item gated by an event too (ask, pr, nightly, rbw, hold) is left out: its ready time is not recorded.
    def handoffs: [.[] | select((.after // "") != "" and ((.tags // "") | test("(^| )(ask|pr|nightly|rbw|hold):") | not)) | {p: (.priority // "high"), m: mins(.ready; .started), at: .started}
      | select(.m != null)];
    def by_priority: group_by(.p) | map({key: .[0].p, value: ([.[].m] | spread)}) | from_entries;
    def stage($name; f): [.[] | select((f // "") != "") | {day: (f | fromdateiso8601 | strflocaltime("%F")), stage: $name, item: .}];
    def at($name): map(select(.stage == $name) | .item);
    (map(select(.state == "done"))) as $done
    | (map(select(.state == "queued"))) as $queued
    | ($queued | map(select(.hold == null) | {slug, project, minutes: (.queued | age)}) | sort_by(-.minutes)) as $runnable
    | {since: $since,
       active: (map(select(.state != "done")) | count_by(.state)),
       done: ($done | count_by(.status // "unknown")),
       wait_minutes_median: (waited | median),
       wait_minutes_p90: (waited | p90),
       started_at_once: (waits | map(select(. == 0)) | length),
       chain: {by_priority: (handoffs | by_priority),
         h24: (handoffs | map(select((.at | fromdateiso8601) >= now - 86400)) | by_priority)},
       sitting: {queued: ($queued | length), runnable: ($runnable | length),
         held: ($queued | map(select(.hold)) | length),
         held_by: ($queued | map(select(.hold)) | count_by(.hold | hold_kind)),
         runnable_age_minutes_median: ($runnable | map(.minutes) | median),
         oldest_runnable: $runnable[:3]},
       added_per_day: (map(select((.queued // "")[:10] >= $since)) | count_by(.queued[:10])),
       # Flow over the last hours, for throughput and a drain trend: added by queued, started by
       # started, done by finished (failed is the part of done that failed).
       recent: (. as $all | [1, 6, 24] | map(. as $h | (now - $h * 3600) as $t
         | def since(f): map(select((f // "") != "" and (f | fromdateiso8601) >= $t));
           ($done | since(.finished)) as $fin
         | {("done_\($h)h"): ($fin | length), ("failed_\($h)h"): ($fin | map(select(.status == "failed")) | length),
            ("started_\($h)h"): ($all | since(.started) | length),
            ("added_\($h)h"): ($all | since(.queued) | length)}) | add
         # Finished ok since local midnight, the day day-log keeps, one count per slug: shipped merged
         # a commit, checks merged nothing (a watch or alert that cleared). queue::done_today in
         # hub-core is the same rule for the cards; failed and cancelled count in neither.
         | ($done | map(select(.status == "ok" and (.finished // "") != ""
             and (.finished | fromdateiso8601 | strflocaltime("%F")) == (now | strflocaltime("%F"))))) as $ok
         | ([$ok[] | select((.merged // "") != "") | .slug] | unique) as $shipped
         | . + {shipped_today: ($shipped | length),
                checks_today: ([$ok[].slug | select(IN($shipped[]) | not)] | unique | length)}),
       run_minutes_median: ([$done[] | mins(.started; .finished)] | median),
       to_pr_minutes_median: ($done | to_pr),
       per_day: ($done | count_by((.finished // "")[:10])),
       # Per local day, the day day-log keeps: each item counts on the day it reached that stage.
       # .waiting is the last move to waiting, so an item that waited twice counts on the later day.
       flow: (if $flow | not then null else (stage("queued"; .queued) + stage("started"; .started) + stage("waiting"; .waiting)
           + stage("review"; .review) + ($done | stage("done"; .finished)))
         | map(select(.day >= $since)) | group_by(.day)
         | map(at("done") as $fin | at("started") as $went | {key: .[0].day, value: {
             queued: (at("queued") | length), started: ($went | length), waiting: (at("waiting") | length),
             review: (at("review") | length), done: ($fin | length), ok: ($fin | map(select(.status == "ok")) | length),
             failed: ($fin | map(select(.status == "failed")) | length),
             cancelled: ($fin | map(select(.status == "cancelled")) | length),
             lead_minutes: ([$fin[] | mins(.queued; .finished)] | spread),
             wait_minutes: ($went | waited | spread),
             run_minutes: ([$fin[] | mins(.started; .finished)] | spread)}})
         | from_entries end),
       by_project: ($done | group(.project)),
       by_source: ($done | group(source)),
       by_end: ($done | map(select((.end_reason // "") != "")) | count_by(.end_reason)),
       done_by_tag: ([$done[] | (.tags // "" | split(" ") | map(select(. != ""))[]) as $t | {t: $t}] | count_by(.t))}')"
  if [ -n "$json" ]; then printf '%s\n' "$stats"; return 0; fi
  jq -r 'def dur: if . == null then "-" elif . >= 120 then "\(. / 60 | floor)h" else "\(.)m" end;
    def pairs: to_entries | map("\(.key) \(.value)") | join(", ");
    def chain_line: if . == {} then "none" else to_entries | sort_by(.key | {urgent: 0, high: 1, normal: 2, low: 3}[.] // 4)
      | map("\(.key) \(.value.p50)/\(.value.p90) (\(.value.n))") | join(", ") end;
    "since \(.since)",
    "active:  \(.active | pairs | if . == "" then "none" else . end)",
    "done:    \(.done | pairs | if . == "" then "none" else . end)",
    "wait:    median \(.wait_minutes_median // "-") min, p90 \(.wait_minutes_p90 // "-") min from ready to started, \(.started_at_once) started at once and not counted",
    "chain:   handoff p50/p90 min from the predecessor'"'"'s finish to the start (n): \(.chain.by_priority | chain_line); last 24h: \(.chain.h24 | chain_line)",
    (.sitting | "sitting: \(.runnable) can start, oldest \(.oldest_runnable[0].minutes | dur)"
      + (if .runnable > 0 then " (\(.oldest_runnable[0].slug)), median \(.runnable_age_minutes_median | dur)" else "" end)
      + "; \(.held) held" + (if .held > 0 then " (\(.held_by | pairs))" else "" end)),
    "added:   \(.added_per_day | pairs)",
    "run:     median \(.run_minutes_median // "-") min from started to finished",
    "to PR:   median \(.to_pr_minutes_median // "-") min from queued to finished with a PR",
    "per day: \(.per_day | to_entries | map("\(.key) \(.value)") | join(", "))",
    "project: \(.by_project | to_entries | map("\(.key) \(.value.done) (\(.value.prs) PR)") | join(", "))",
    "source:  \(.by_source | to_entries | map("\(.key) \(.value.done) (\(.value.prs) PR)") | join(", "))",
    (if .by_end == {} then empty else "ends:    \(.by_end | pairs)" end)' <<<"$stats"
}

# backfill-briefs [--dry-run | --check]: the board row is the task's one record and holds its brief (plan
# holding-194-can-start-merry-whisper P3). A row whose details are empty, or only `full:`/`was:`
# lines, gets the brief of the item that worked it: the newest open item first, else the newest done
# one. A body is cut at the dispatch template (`Promoted by fleet-dispatch`: the run's instructions,
# not the task's), its markers are stripped, and a first line that is the row's own words is dropped.
# A body that adds 20 characters or fewer to the row is skipped: measured 2026-11-18, each such body
# was the row's earlier wording before the triager re-typed it, not a brief. An open item with no row
# (canary and trainee items excepted: their config is their brief) gets a story row and its brief. A
# row with `brief: ` lines (keep_brief's format, retired by #2406) gets them back without the prefix.
# Rows are written through `notes ptask` alone, matched by their exact line, so a row that changed
# since the read is not written. --dry-run lists each row and its source; --check prints one doctor
# line and fails when any row would be written, which after P2 is a writer losing a brief again.
BRIEF_JQ='def norm: gsub("<!--.*?-->"; "") | gsub("<!--.*$"; "") | gsub("(^|\\s)#[A-Za-z][A-Za-z0-9_/:.-]*"; " ")
    | gsub("^\\s*- \\[.\\]\\s*"; "") | gsub("\\s+"; " ") | ascii_downcase | ltrimstr(" ") | rtrimstr(" ");
  def body: .task | split("\n") | (map(startswith("Promoted by fleet-dispatch")) | index(true)) as $c
    | (if $c then .[:$c] else . end) | map(gsub("\\s*<!--.*?-->"; "") | gsub("\\s*<!--.*$"; "")) | until(length == 0 or (.[-1] | test("\\S")); .[:-1]);
  def stamp: "(\(.state), queued \((.queued // "-") | split("T")[0]))";
  def out: [.kind, .key, .prof // "", .proj // "", .text // "", .slug // "", .stamp // "", .brief // "", .prio // ""]
    | map(tostring + "\u0000") | add;
  ($items | map(select(.row) | (body) as $b | . + {open: (.state != "done"), lines: $b, n: ($b | join("\n") | norm)})
    | group_by(.row) | map({key: .[0].row, value: .}) | from_entries) as $by
  | (($board.rows[] | select(.lane == "agent" and all(.details[]; test("^(full|was):"))))
      | (.raw | norm) as $t | (.project + ":" + .id) as $key | ($by[$key] // []) as $all
      | ($all | map(select(.n != $t and (. as $i | $t | contains($i.n) | not) and (.n | length) > ($t | length) + 20))
          | sort_by(if .open then 0 else 1 end, (.queued // "0" | explode | map(-.)))) as $good
      | if $good[0] then {kind: "row", key: $key, prof: .profile, proj: .project, text: .raw, slug: $good[0].slug,
            stamp: ($good[0] | stamp), brief: (.details + ["from item \($good[0].slug) \($good[0] | stamp)"]
              + ($good[0].lines | if (.[0] | norm) == $t then .[1:] else . end) | join("\n"))}
        else {kind: (if $all[0] then "bare" else "none" end), key: $key} end),
    ($board.rows[] | select(.lane == "agent" and any(.details[]; startswith("brief: ")))
      | {kind: "prefix", key: (.project + ":" + .id), prof: .profile, proj: .project, text: .raw,
         brief: (.details | map(if startswith("brief: ") then .[7:] else . end) | join("\n"))}),
    ($items[] | select(.state != "done" and (.row | not)
        and ((.from // "") | startswith("board:") or IN("canary", "trainee") | not)
        and ((.tags // "") | test("(^| )canary( |$)") | not))
      | {kind: "new", key: .slug, proj: .project, slug: .slug, stamp: stamp, brief: (body | join("\n")), prio: .priority})
  | out'

cmd_backfill_briefs() {
  local dry="" check="" tmp kind key prof proj text slug stamp brief prio f title lab code srow
  local n=0 filed=0 failed=0 bare=0 none=0 nob=0 unpre=0
  case "${1:-}" in
    --dry-run) dry=1 ;;
    --check) dry=1 check=1 ;;
    '') ;;
    *) die "usage: agent-queue backfill-briefs [--dry-run | --check]" ;;
  esac
  # fd 4 takes the per-row lines: stdout, or nothing for --check. A dup, not a reopen of /dev/stdout,
  # which would truncate a log the caller appends to.
  if [ -n "$check" ]; then exec 4>/dev/null; else exec 4>&1; fi
  command -v notes >/dev/null || die "backfill-briefs: no notes on PATH"
  # Files, not arguments: the whole store is past the kernel's argument limit. One list: --since
  # widens done to every day and leaves the open states whole.
  tmp="$(mktemp -d)" || die "backfill-briefs: no temp dir"
  if ! { "$0" list --json --state all --since 3650d | jq -sc . >"$tmp/items" &&
    notes board --json >"$tmp/board" &&
    jq -j -n --slurpfile i "$tmp/items" --slurpfile b "$tmp/board" '$i[0] as $items | $b[0] as $board | '"$BRIEF_JQ" >"$tmp/matches"; }; then
    rm -rf "$tmp"
    # The doctor's line still, so a busy lock reads as a FAIL that says so, not as no check at all.
    [ -z "$check" ] || { echo "FAIL  briefs: could not read the queue or the board (a busy queue lock?), so not checked"; return 1; }
    die "backfill-briefs: could not read the queue, the board, or match them"
  fi
  # One record is nine NUL-ended fields (BRIEF_JQ's out), read on fd 3 so no child eats the stream.
  while IFS= read -r -d '' -u 3 kind && IFS= read -r -d '' -u 3 key && IFS= read -r -d '' -u 3 prof &&
    IFS= read -r -d '' -u 3 proj && IFS= read -r -d '' -u 3 text && IFS= read -r -d '' -u 3 slug &&
    IFS= read -r -d '' -u 3 stamp && IFS= read -r -d '' -u 3 brief && IFS= read -r -d '' -u 3 prio; do
    case "$kind" in
    bare) bare=$((bare + 1)) ;;
    none) none=$((none + 1)) ;;
    row | prefix)
      if [ -n "$dry" ]; then
        if [ "$kind" = row ]; then echo "$key <- $slug $stamp: $(grep -c '' <<<"$brief") lines"; n=$((n + 1))
        else echo "$key: brief: prefix stripped"; unpre=$((unpre + 1)); fi
        continue
      fi
      # `--brief=` replaces the details whole (a row's own `full:`/`was:` lines are in it), and the
      # = form keeps a brief that opens with a dash a value, not a flag.
      if notes --profile "$prof" ptask "$proj" --agent --exact edit --brief="$brief" -- "$text" </dev/null >/dev/null 2>"$tmp/err"; then
        if [ "$kind" = row ]; then n=$((n + 1)); else unpre=$((unpre + 1)); fi
      else
        failed=$((failed + 1)); echo "agent-queue: $key not written: $(tail -1 "$tmp/err")" >&2
      fi ;;
    new)
      f="$(find_item "$slug")"; [ -n "$f" ] || continue
      IFS=$'\t' read -r _ lab code < <(project_board "$proj")
      if [ -z "$lab" ] || [ -z "$code" ]; then nob=$((nob + 1)); continue; fi
      title="$(fm_get "$f" title)"; [ -n "$title" ] || title="$(head -1 <<<"$brief")"
      if [ -n "$dry" ]; then echo "$slug: no row; would file one on the $proj board with its brief"; filed=$((filed + 1)); continue; fi
      # file_story writes the brief with the row, less a first line that is the title.
      IFS=$'\t' read -r proj prof srow < <(file_story "$proj" "$title" "$prio" "" "" "$brief" </dev/null)
      [ -n "$srow" ] || { failed=$((failed + 1)); echo "agent-queue: $slug: no story row filed" >&2; continue; }
      if "$0" set "$slug" row="$proj:$srow" lane=agent profile="$prof" </dev/null >/dev/null; then filed=$((filed + 1))
      else failed=$((failed + 1)); echo "agent-queue: $slug: row $proj:$srow filed but not linked; link it with agent-queue set $slug row=$proj:$srow" >&2; fi ;;
    esac
  done 3<"$tmp/matches" >&4
  exec 4>&-
  rm -rf "$tmp"
  if [ -n "$check" ]; then
    # The nightly doctor's line (agentctl-project-index): fleet-bench's doctor_fail counts a FAIL.
    [ $((n + unpre + filed)) -eq 0 ] && { echo "PASS  briefs: every agent row holds the brief its item has"; return 0; }
    echo "FAIL  briefs: $n rows lack the brief their item has, $unpre carry brief: lines, $filed open items have no row (agent-queue backfill-briefs writes them)"
    return 1
  fi
  if [ -n "$dry" ]; then
    printf 'would fill %s rows with a brief, strip brief: from %s, and file %s rows for items with none;' "$n" "$unpre" "$filed"
  else
    printf 'filled %s rows with a brief, stripped brief: from %s, filed %s rows for items with none; %s not written (why is above);' "$n" "$unpre" "$filed" "$failed"
  fi
  echo " $bare linked only to items that repeat the row; $none never worked by an item; $nob row-less items on a project with no board"
  [ "$failed" -eq 0 ]
}

[[ "${BASH_SOURCE[0]}" != "$0" ]] && return 0

# A write here reaches the other machines at once: store-sync pushes the queue and asks (it does
# nothing when they are clean, or when this queue is not the store's). 8>&-: the sync must not
# inherit the queue lock (fd 8): it would keep .lock held for as long as it waits on its own sync
# lock (store-sync LOCK_WAIT_S), and every queue writer timed out behind it (2026-11-18).
# AGENT_STORE_HOOK: a write made under the hook's own sync starts none, so a sync that writes the
# queue cannot start itself again; a bats stub of store-sync that called agent-queue did, ~600
# processes that outlived their run and orphan-gc's SIGTERM (ar-4050).
[[ "$AQ_DIR/" != "${AGENT_STORE_DIR:-$HOME/.agent}/"* ]] || [ -n "${AGENT_STORE_HOOK:-}" ] ||
  trap 'AGENT_STORE_HOOK=1 store-sync --now --bg 8>&- 2>/dev/null' EXIT
command -v jq >/dev/null || die "jq not on PATH"
case "${1:-}" in
  add) shift; work_machine_guard "$@"; cmd_add "$@" ;;
  list | next | show | mine | claim | cancel | return | bump | set | retask | attribute | move | requeue | handoff | start | reopen | stats | admission | mix | gate) v="$1"; shift; "cmd_$v" "$@" ;;
  lock-miss) shift; cmd_lock_miss "$@" ;;
  credit-of) shift; cmd_credit_of "$@" ;;
  ask-holds) shift; cmd_ask_holds "$@" ;;
  backfill-briefs) shift; cmd_backfill_briefs "$@" ;;
  -h | --help | '') sed -n '2,/^set -uo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
  *) die "unknown verb: $1 (try --help)" ;;
esac
