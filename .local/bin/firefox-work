#!/bin/bash
# Open the Firefox work profile. Its tabs come from browser.startup.homepage in the private
# work.user.js, and Tab Keeper keeps them pinned. install.sh creates the profile.
if [[ "$(uname -s)" == Darwin ]]; then
  exec open -na Firefox --args -P work
fi
setsid firefox -P work >/dev/null 2>&1 </dev/null &
