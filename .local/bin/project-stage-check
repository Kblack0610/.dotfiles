#!/usr/bin/env bash
# project-stage-check - does a project meet its stage, and its systems' criteria?
#
#   project-stage-check <name> [--stage <stage>] [--json]
#   project-stage-check <name> --systems [--system <id>] [--json]   (alias: project-system-check)
#   project-stage-check <name> [--stage <stage> | --systems [--system <id>]] --file
#   project-stage-check <name> --list [--json]
#   project-stage-check --requirements [--json]
#
# Stage mode runs the Requirements rows of stages.md for <stage> (default: the stage its sheet
# declares) and every stage below, for `base` and the project's type. One PASS, FAIL, HUMAN or
# TODO line per row, then a `gate:` line. Exit 0 when nothing blocks, 1 when a FAIL blocks (from
# stages.md's `Enforced from:` date; before it the gate only reports), 2 on usage or an unknown
# project. --json prints the counts, the gate and each row instead, with the same exit. Callers:
# `notes projects --stage <name> --set <stage>` (refuses on 1), project-map-doctor.
# Systems mode runs the Criteria rows of systems.md for every system the project's type has (or
# one, with --system): the same lines, then met/total per system; --json prints those counts and
# each row instead. Exit 1 when any row FAILs, 2 on usage or an unknown project or system.
# --file reconciles the project's agent board with the check: each FAIL row becomes a story under
# the open epic for its target, and each open board row whose title is a row that now PASSes is
# closed with the check as proof. A stage's target is --stage, else the highest of the
# stage after the declared one and the stages open `epic(stage):` rows name; with no open epic for
# it, `epic(stage): <stage> to standard` is filed on the human sheet first. A system's row goes
# under `epic(<system>): ...`, which `notes ptask add` files when it is missing (standing.rs). A
# row already on either sheet under the same title, open or closed or dropped, is never filed
# again. Exit 0, 1 when a write failed, 2 as above.
# --list prints the project's systems (which ones: ~/.local/src/docs/systems.md, "The layers"),
# one `id<TAB>doc|own<TAB>aliases (comma-separated)<TAB>what it is` line each (--json: an array of
# {id, source, aliases, is}). A malformed `systems` entry exits 2.
# --requirements prints every Requirements row of stages.md, for no project: stage, applies, the
# check's kind (`predicate` runs, `human` is signed off, `not-yet` has no check), the requirement,
# and the skills its text names in backticks that exist under ~/.claude/skills (--json: the
# `Enforced from:` date and an array of {stage, applies, requirement, check, kind, skills}).
# How a Check cell is written and run: ~/.local/src/docs/stages.md, "Requirements".
set -uo pipefail

usage() { sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-2}"; }

NAME="" TARGET="" SYSTEMS="" ONLY="" JSON="" FILE="" LIST="" REQS=""
[ "$(basename "$0")" = project-system-check ] && SYSTEMS=1
while [ $# -gt 0 ]; do
  case "$1" in
    --stage) TARGET="${2:-}"; shift 2 || usage ;;
    --systems) SYSTEMS=1; shift ;;
    --system) ONLY="${2:-}"; SYSTEMS=1; shift 2 || usage ;;
    --json) JSON=1; shift ;;
    --file) FILE=1; shift ;;
    --list) LIST=1; shift ;;
    --requirements) REQS=1; shift ;;
    -h|--help) usage 0 ;;
    -*) echo "project-stage-check: unknown flag $1" >&2; usage ;;
    *) [ -z "$NAME" ] || usage; NAME="$1"; shift ;;
  esac
done
[ -n "$NAME$REQS" ] || usage
[ -z "$REQS" ] || [ -z "$NAME$TARGET$SYSTEMS$FILE$LIST" ] || { echo "project-stage-check: --requirements takes no project, only --json" >&2; usage; }
[ -z "$SYSTEMS" ] || [ -z "$TARGET" ] || { echo "project-stage-check: --stage and --systems do not mix" >&2; usage; }
[ -z "$FILE" ] || [ -z "$JSON" ] || { echo "project-stage-check: --file and --json do not mix" >&2; usage; }
[ -z "$LIST" ] || [ -z "$FILE$TARGET$ONLY" ] || { echo "project-stage-check: --list takes only --json" >&2; usage; }

# rows <doc> <section>: the cells of each row of the table under `## <section>`, tab-separated.
# A row starts with a lowercase id, so the header and the `---` line never match. `\|` is a
# literal pipe inside a cell, as GitHub markdown spells it.
rows() {
  awk -v want="## $2" '
    /^## / { intable = ($0 == want); next }
    intable && /^\| *[a-z][a-z-]* *\|/ {
      line = $0; gsub(/\\\|/, "\001", line)
      n = split(line, c, "|"); out = ""
      for (i = 2; i < n; i++) { gsub(/^ +| +$/, "", c[i]); gsub("\001", "|", c[i]); out = out (i > 2 ? "\t" : "") c[i] }
      print out
    }' "$1"
}

# kind_of <check>: `predicate` for a Check cell that is one whole code span (a cell like
# "`regen-anchor.sh` marks it STALE" names a check and never runs), `human`, else `not-yet`.
kind_of() {
  case "$1" in
    human) echo human ;;
    \`*\`) case "${1:1:${#1}-2}" in *\`*) echo not-yet ;; *) echo predicate ;; esac ;;
    *) echo not-yet ;;
  esac
}

# requirements: the --requirements mode, the Requirements rows for no project.
requirements() {
  local stage app req check skills s out=""
  local dir="${SKILLS_DIR:-$HOME/.claude/skills}"
  # The unit separator, not tab: tab is IFS whitespace, so an empty cell would shift the rest.
  while IFS=$'\037' read -r stage app req check _; do
    skills=""
    while IFS= read -r s; do
      [ -n "$s" ] && [ -f "$dir/$s/SKILL.md" ] && case " $skills " in *" $s "*) ;; *) skills="${skills:+$skills }$s" ;; esac
    done < <(grep -o '`[a-z][a-z0-9-]*`' <<<"$req" | tr -d '`')
    out+="$stage"$'\t'"$app"$'\t'"$(kind_of "$check")"$'\t'"$skills"$'\t'"$req"$'\t'"$check"$'\n'
  done < <(rows "$STAGES_DOC" Requirements | tr '\t' '\037')
  [ -n "$out" ] || { echo "project-stage-check: no Requirements rows in $STAGES_DOC" >&2; exit 2; }
  if [ -n "$JSON" ]; then
    printf '%s' "$out" | jq -R -s --arg from "$(sed -n 's/^Enforced from: *\([0-9-]*\).*/\1/p' "$STAGES_DOC" | head -1)" '
      {enforced_from: (if $from == "" then null else $from end),
       requirements: [split("\n")[] | select(length > 0) | split("\t")
         | {stage: .[0], applies: (.[1] | split(", ")), kind: .[2],
            skills: (.[3] | split(" ") | map(select(length > 0))), requirement: .[4], check: .[5]}]}'
  else
    printf '%s' "$out" | awk -F'\t' '{ printf "%-5s %-10s %-9s %s%s\n", $1, $2, $3, $5, ($4 == "" ? "" : " (by " $4 ")") }'
  fi
  exit 0
}

# sheet_rows: one `state<TAB>title` line per task row on both lanes' sheets and their frozen
# version notes, the title from `notes row parse` (the grammar's home, so it reads as
# `projects::row_title` does: marker, stamps, `#` words and the `type(area): ` prefix dropped,
# spaces collapsed), then the lane (`agent` for the agent sheet and its notes, else `human`) and
# the row's id. State is `open`, or `closed` for a ticked row, done or dropped. The
# roadmap leaves dropped rows out, so it cannot be this reader. Fails, saying so, when the
# verb does or answers short.
sheet_rows() {
  local f files=() rows titles
  for f in "$LAB/README.md" "$LAB/agent/README.md" "$LAB"/versions/*.md "$LAB"/agent/versions/*.md; do
    [ -f "$f" ] && files+=("$f")
  done
  [ "${#files[@]}" -gt 0 ] || return 0
  rows="$(awk -v agent="$LAB/agent/" '/^[ \t]*- \[.\] / {
      id = ""; if (match($0, /id:[a-z0-9]+-[0-9]+/)) id = substr($0, RSTART + 3, RLENGTH - 3)
      print (($0 ~ /^[ \t]*- \[[xX]\] /) ? "closed" : "open") "\t" (index(FILENAME, agent) == 1 ? "agent" : "human") "\t" id "\t" $0
    }' "${files[@]}")"
  [ -n "$rows" ] || return 0
  titles="$(cut -f4- <<<"$rows" | notes row parse | cut -f3)" && [ "$(wc -l <<<"$titles")" = "$(wc -l <<<"$rows")" ] \
    || { echo "project-stage-check: notes row parse failed or answered short (an old notes? notes-bootstrap --build-only)" >&2; return 1; }
  paste <(cut -f1 <<<"$rows") - <(cut -f2,3 <<<"$rows") <<<"$titles"
}

# title_of <text>: the title as the sheet stores it (`projects::row_title`): words that start
# with `#` dropped, spaces collapsed, cut at a word to 80 characters (`propose`'s cut).
title_of() {
  jq -rn --arg t "$1" '[$t | splits(" +") | select(length > 0 and (startswith("#") | not))] | join(" ")
    | if length <= 80 then . else .[:80] | (if test(" ") then sub(" [^ ]*$"; "") else . end) end'
}

# stage_epic <stage>: file `epic(stage): <stage> to standard` on the human sheet and print its
# id. The epic tree is the system's to keep (lifecycle.md, "What an epic is"), so a stage with
# gaps never waits on a human to open its epic.
stage_epic() {
  local out id
  out="$(notes ptask "$NAME" add "epic(stage): $1 to standard")" || return 1
  id="$(grep -o 'id:[a-z0-9]*-[0-9]*' <<<"$out" | head -1)"
  [ -n "$id" ] || return 1
  printf 'epic    %-10s  %s to standard (%s)\n' "$1" "$1" "${id#id:}" >&2
  printf '%s\n' "${id#id:}"
}

# file_gaps: the --file mode. It reads this script's own --json, the open epics from `notes
# projects --stats --json` (the roadmap lists only epics with work in a version, so never a
# fresh one) and the rows already on the sheets, and writes only through `notes ptask --agent
# add`, whose twin check holds a concurrent run off an open row.
file_gaps() {
  local epics ladder check rc gaps passes have n=0 filed=0 had=0 closed=0 failed=0 met=0 opened=0
  local target area text full chk epic title row state declared lane id today
  [ -n "$LAB" ] || { echo "project-stage-check: \"$NAME\" has no lab sheet to file rows on" >&2; exit 2; }
  epics="$(notes projects --stats --json 2>/dev/null | jq -c --arg n "$NAME" \
    '[.[] | select((.name | ascii_downcase) == ($n | ascii_downcase)) | .epics[]?]')" \
    || { echo "project-stage-check: notes projects --stats --json failed" >&2; exit 2; }
  have="$(sheet_rows)" || exit 2
  if [ -n "$SYSTEMS" ]; then
    check="$("$0" "$NAME" --systems ${ONLY:+--system "$ONLY"} --json)"; rc=$?
    [ "$rc" -le 1 ] || exit "$rc"
    gaps="$(jq -r '.systems[] | .id as $id | .criteria[] | select(.result == "FAIL")
      | [$id, $id, .criterion, .check] | @tsv' <<<"$check")"
    passes="$(jq -r '.systems[].criteria[] | select(.result == "PASS") | .criterion' <<<"$check")"
  else
    ladder="$(notes projects --stages 2>/dev/null)"
    # With no --stage, the target is the highest of the stage after the declared one and the stages
    # the open `epic(stage):` rows name: an epic opened by hand for a later stage keeps its work
    # coming, and a leftover epic for a stage already passed never pins the target below the next.
    # The check of a stage holds every row below it, so a regression at today's stage is filed too.
    # prod has no next: it checks itself.
    if [ -z "$TARGET" ]; then
      # shellcheck disable=SC2086 # the ladder is a word list on purpose
      declared="$(lab_head_tag "$(lab_front_page "$LAB")" $ladder)"
      [ -n "$declared" ] || { echo "project-stage-check: \"$NAME\" declares no stage; pass --stage" >&2; exit 2; }
      TARGET="$(jq -r --arg ladder "$ladder" --arg d "$declared" '($ladder | split(" ")) as $l
        | ($l | index($d)) as $i | [([$i + 1, ($l | length) - 1] | min)]
          + [.[] | select(.system == "stage") | (.title | split(" ")[0] | rtrimstr(",") | rtrimstr(":")) as $s
            | $l | index($s) | select(. != null)]
        | $l[max]' <<<"$epics")"
    fi
    check="$("$0" "$NAME" ${TARGET:+--stage "$TARGET"} --json)"; rc=$?
    [ "$rc" -le 1 ] || exit "$rc"
    TARGET="$(jq -r .stage <<<"$check")"
    gaps="$(jq -r --arg t "$TARGET" '.requirements[] | select(.result == "FAIL")
      | [$t, .stage, .requirement, .check] | @tsv' <<<"$check")"
    passes="$(jq -r '.requirements[] | select(.result == "PASS") | .requirement' <<<"$check")"
  fi
  # A title that also fails (two rows or systems sharing a text) is a gap, never met.
  passes="$(grep -vxF -f <(cut -f3 <<<"$gaps" | grep .) <<<"$passes" || true)"
  today="$(date +%F)"

  # A row this check filed closes once its check passes: an open agent-sheet row whose title is
  # a PASS row's, closed by its id with the check as proof. A regression files it again.
  while IFS= read -r full; do
    [ -n "$full" ] || continue
    title="$(title_of "$full")"
    while IFS=$'\t' read -r state _ lane id; do
      [ "$state" = open ] && [ "$lane" = agent ] && [ -n "$id" ] || continue
      if notes ptask "$NAME" --agent done "$id" --proof "check:project-stage-check $NAME${SYSTEMS:+ --systems} PASS $today" >/dev/null; then
        met=$((met + 1)); printf 'met     %-10s  %s\n' "$id" "$title"
      else
        failed=$((failed + 1)); printf 'error   %-10s  %s (ptask done failed)\n' "$id" "$title"
      fi
    done < <(awk -F'\t' -v t="$title" '$2 == t' <<<"$have")
  done <<<"$passes"

  # Each row's priority is its own (no writer defaults one): #high while the gate it fails blocks
  # the stage, #low for a report-only gap and for a system's.
  local prio=low
  [ -z "$SYSTEMS" ] && [ "$(jq -r .blocks <<<"$check")" = true ] && prio=high
  while IFS=$'\t' read -r target area full chk; do
    [ -n "$target" ] || continue
    n=$((n + 1))
    title="$(title_of "$full")"
    # A closed twin wins over an open one: a gap the human dropped stays dropped.
    state="$(awk -F'\t' -v t="$title" '$2 == t { s = (s == "closed" || $1 == "closed") ? "closed" : "open" } END { print s }' <<<"$have")"
    if [ -n "$SYSTEMS" ]; then
      epic="$(jq -r --arg s "$target" '[.[] | select(.system == $s) | .id][0] // empty' <<<"$epics")"
    else
      epic="$(jq -r --arg s "$target" '[.[] | select(.system == "stage")
        | select(.title | split(" ")[0] | rtrimstr(",") | rtrimstr(":") == $s) | .id][0] // empty' <<<"$epics")"
    fi
    case "$state" in
      closed) closed=$((closed + 1)); printf 'closed  %-10s  %s\n' "$area" "$title"; continue ;;
      ?*) had=$((had + 1)); printf 'open    %-10s  %s\n' "$area" "$title"; continue ;;
    esac
    # No open epic: a stage's is opened here, once a run; a system's is filed by `notes ptask add`
    # itself when the row carries no #of/ (standing.rs).
    if [ -z "$epic" ] && [ -z "$SYSTEMS" ]; then
      if ! epic="$(stage_epic "$target")"; then
        failed=$((failed + 1)); printf 'error   %-10s  %s (could not file the stage epic)\n' "$area" "$title"; continue
      fi
      opened=$((opened + 1))
      epics="$(jq -c --arg id "$epic" --arg s "$target" '. + [{id: $id, system: "stage", title: "\($s) to standard"}]' <<<"$epics")"
    fi
    row="chore($area): $title${epic:+ #of/$epic} #size/s #$prio"
    text="from project-stage-check $NAME --file, $( [ -n "$SYSTEMS" ] && echo "systems.md $target" || echo "stages.md #$area" ), check: $chk"
    # A cut title keeps the whole requirement on a detail line.
    if [ "$title" = "$full" ]; then
      notes ptask "$NAME" --agent add "$row" --detail "$text" >/dev/null
    else
      notes ptask "$NAME" --agent add "$row" --detail "$full" --detail "$text" >/dev/null
    fi
    rc=$?
    case "$rc" in
      0) filed=$((filed + 1)); printf 'filed   %-10s  %s\n' "$area" "$title" ;;
      3) had=$((had + 1)); printf 'open    %-10s  %s\n' "$area" "$title" ;;
      *) failed=$((failed + 1)); printf 'error   %-10s  %s (ptask add exit %s)\n' "$area" "$title" "$rc" ;;
    esac
  done <<<"$gaps"

  local what="#$TARGET"; [ -z "$SYSTEMS" ] && [ -n "$TARGET" ] || what="systems${ONLY:+ $ONLY}"
  printf 'file: %s %s: %s failing, %s filed, %s already open, %s closed or dropped, %s met and closed' \
    "$NAME" "$what" "$n" "$filed" "$had" "$closed" "$met"
  [ "$opened" -eq 0 ] || printf ', %s epic opened' "$opened"
  [ "$failed" -eq 0 ] || printf ', %s failed' "$failed"
  printf '\n'
  [ "$failed" -eq 0 ]
  exit $?
}

STAGES_DOC="${STAGES_DOC:-$HOME/.local/src/docs/stages.md}"
SYSTEMS_DOC="${SYSTEMS_DOC:-$HOME/.local/src/docs/systems.md}"
DOC="$STAGES_DOC"; [ -z "$SYSTEMS$LIST" ] || DOC="$SYSTEMS_DOC"
[ -r "$DOC" ] || { echo "project-stage-check: $DOC not found" >&2; exit 2; }
[ -z "$REQS" ] || requirements

# shellcheck source=../../.config/shared-hooks/project-name.sh
. "${PROJECT_NAME_LIB:-$HOME/.config/shared-hooks/project-name.sh}"
# shellcheck source=../lib/lab-feed.sh
. "${LAB_FEED_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/lab-feed.sh}"
# lab_roots lives in the private overlay; without it there is no lab dir and no declared stage.
# shellcheck source=/dev/null
[ -r "${LAB_ROOTS_LIB:-$HOME/.config/shared-hooks/lab-roots.sh}" ] && . "${LAB_ROOTS_LIB:-$HOME/.config/shared-hooks/lab-roots.sh}"

LAB=""
if declare -F lab_roots >/dev/null; then
  while IFS= read -r root; do
    [ -f "$root/$NAME/summary.md" ] && { LAB="$root/$NAME"; break; }
  done < <(lab_roots)
fi
TYPE="$(project_inherited "$NAME" type)"
# TAGS: the Applies tags this project takes, `base`, its type, and `store` when it ships through a
# store: every game, and a project with a steam, play or testflight target (release-state's store
# probes) in project-map `targets`, its own entry's, else its lab siblings' as TYPE is inherited.
TAGS="base ${TYPE:-none}"
if [ "$TYPE" = game ]; then TAGS="$TAGS store"
else
  rc=0
  # shellcheck disable=SC2046 # one lab name per word
  jq -e '
    . as $map | def st($n): $map.trackers[$n] | objects | .targets | arrays;
    $ARGS.positional as $ns
    | ([st($ns[0])] | if length > 0 then .[0] else [$ns[1:][] as $s | st($s)[]] end)
    | [.[] | .live // {} | keys[]] | any(IN("steam", "play", "testflight"))' \
    "$(project_map_file)" --args "$NAME" $(project_lab_names "$NAME") </dev/null >/dev/null || rc=$?
  case "$rc" in
    0) TAGS="$TAGS store" ;;
    1) ;;
    *) echo "project-stage-check: cannot read the targets of \"$NAME\" from $(project_map_file)" >&2; exit 2 ;;
  esac
fi
REPO="$(project_repo_path "$NAME" 2>/dev/null || true)"
REPO="${REPO/#\~/$HOME}"
# A project inside a monorepo (`trackers.<name>.path`, as apps/<app>) keeps its own
# README, docs and CHANGELOG there; the predicates run from that root.
sub="$(project_field "$NAME" path)"
ROOT="${REPO:+$REPO${sub:+/$sub}}"
[ -n "$LIST" ] || [ -z "$REPO" ] || [ -d "$REPO" ] || { echo "project-stage-check: $REPO is not checked out here" >&2; exit 2; }
[ -n "$LAB" ] || [ -n "$TYPE" ] || { echo "project-stage-check: no lab dir and no project-map type for \"$NAME\"" >&2; exit 2; }
[ -z "$FILE" ] || file_gaps

# applies <cell>: the Applies cell names one of TAGS.
applies() {
  local t
  for t in ${1//,/ }; do case " $TAGS " in *" $t "*) return 0 ;; esac; done
  return 1
}

# With no project folder, predicates run from an empty dir, never the repo root or lab.
EMPTY="$(mktemp -d)"; trap 'rmdir "$EMPTY"' EXIT
CHECK_DIR="$ROOT"; [ -d "$CHECK_DIR" ] || CHECK_DIR="$EMPTY"

# judge <check>: PASS, FAIL, HUMAN or TODO for one Check cell.
judge() {
  local pred
  case "$(kind_of "$1")" in
    human) echo HUMAN ;;
    predicate)
      pred="${1#\`}"; pred="${pred%\`}"
      # A predicate is plain shell: `ls a b | grep -q .` must not fail on this script's pipefail.
      if (set +o pipefail; STAGE=""; [ -n "$SYSTEMS" ] || STAGE="$TARGET"; export NAME TYPE REPO ROOT LAB STAGE; cd "$CHECK_DIR" || exit 1; eval "$pred") >/dev/null 2>&1; then
        echo PASS
      else
        echo FAIL
      fi ;;
    *) echo TODO ;;
  esac
}

# line <result> <tag> <text> <check>: one report line; a TODO names what checks it today.
# The tag column is a stage (5 wide) or a system id (10 wide).
line() {
  local w=5; [ -z "$SYSTEMS" ] || w=10
  case "$1" in
    TODO) printf '%-5s %-*s  %s (%s)\n' "$1" "$w" "$2" "$3" "$4" ;;
    *) printf '%-5s %-*s  %s\n' "$1" "$w" "$2" "$3" ;;
  esac
}

systems() {
  local id app sys crit check r known="" ids=() res=""
  while IFS=$'\t' read -r id app _; do
    known="${known:+$known }$id"
    applies "$app" || continue
    [ -z "$ONLY" ] || [ "$id" = "$ONLY" ] || continue
    ids+=("$id")
  done < <(rows "$SYSTEMS_DOC" Systems)
  if [ -n "$ONLY" ] && [ "${#ids[@]}" -eq 0 ]; then
    case " $known " in
      *" $ONLY "*) echo "project-stage-check: system \"$ONLY\" does not apply to \"$NAME\", which takes: $TAGS" >&2 ;;
      *) echo "project-stage-check: unknown system \"$ONLY\" (want: $known)" >&2 ;;
    esac
    exit 2
  fi
  while IFS=$'\t' read -r sys app crit check _; do
    case " $known " in *" $sys "*) ;; *) echo "project-stage-check: a Criteria row names unknown system \"$sys\"" >&2; exit 2 ;; esac
    case " ${ids[*]} " in *" $sys "*) ;; *) continue ;; esac
    applies "$app" || continue
    r="$(judge "$check")"
    res+="$sys"$'\t'"$r"$'\t'"$crit"$'\t'"$check"$'\n'
    [ -n "$JSON" ] || line "$r" "$sys" "$crit" "$check"
  done < <(rows "$SYSTEMS_DOC" Criteria)

  if [ -n "$JSON" ]; then
    printf '%s' "$res" | jq -R -s --arg name "$NAME" --arg type "$TYPE" --args '
      [split("\n")[] | select(length > 0) | split("\t") | {system: .[0], result: .[1], criterion: .[2], check: .[3]}] as $rows
      | [$ARGS.positional[] as $id | ($rows | map(select(.system == $id))) as $r
          | {id: $id, met: ($r | map(select(.result == "PASS")) | length), total: ($r | length),
             fail: ($r | map(select(.result == "FAIL")) | length),
             human: ($r | map(select(.result == "HUMAN")) | length),
             todo: ($r | map(select(.result == "TODO")) | length),
             criteria: ($r | map(del(.system)))}] as $s
      | {project: $name, type: (if $type == "" then null else $type end),
         met: ([$s[].met] | add // 0), total: ([$s[].total] | add // 0), systems: $s}' "${ids[@]}"
  else
    printf '%s' "$res" | awk -F'\t' -v name="$NAME" -v order="${ids[*]}" '
      { n[$1]++; if ($2 == "PASS") m[$1]++ }
      END { k = split(order, id, " "); out = ""
            for (i = 1; i <= k; i++) out = out (i > 1 ? ", " : "") id[i] " " m[id[i]] + 0 "/" n[id[i]] + 0
            print "systems: " name ": " out }'
  fi
  case "$res" in *$'\t'FAIL$'\t'*) exit 1 ;; esac
  exit 0
}

list_systems() {
  local own out
  # A malformed entry exits 2 with its key named: an empty list would read as "no own systems".
  own="$(jq -c --arg n "$NAME" '
    def word: type == "string" and test("^[a-z][a-z0-9-]*$");
    def id: type == "string" and test("^[a-z][a-z-]*$");
    def entry: type == "object" and ((.aliases // []) | type == "array" and all(.[]; word))
      and ((.is // "") | type == "string");
    (.trackers[$n].systems // {}) as $s
    | if ($s | type) != "object" then error("\($n): systems is not an object") else . end
    | [$s | to_entries[] | select((.key | id | not) or (.value | entry | not)) | .key] as $bad
    | if $bad == [] then $s
      else error("\($n): bad systems entries: \($bad | join(", ")); want {\"<id>\": {\"is\": \"<line>\", \"aliases\": [\"<word>\"]}}, ids and aliases lowercase") end
  ' "$(project_map_file)")" || { echo "project-stage-check: cannot read the systems of \"$NAME\" from $(project_map_file)" >&2; exit 2; }
  out="$(rows "$SYSTEMS_DOC" Systems | jq -r -R -s --arg type "${TYPE:-none}" --arg tags "$TAGS" --argjson own "$own" --arg json "$JSON" '
    [split("\n")[] | select(length > 0) | split("\t") | {id: .[0], applies: (.[1] | split(", ")), is: .[2]}] as $doc
    | ($doc | map(.id)) as $ids
    | [$own | keys[] | select(. as $k | ($ids | index($k) | not) and ($own[$k].is // "") == "")] as $nois
    | if $nois != [] then error("own systems need an \"is\" line: \($nois | join(", "))") else . end
    | ([$doc[] | select(any(.applies[]; . as $a | $tags | split(" ") | index($a))) | .id]) as $applies
    | [$own | keys[] | select(. as $k | ($ids | index($k)) and ($applies | index($k) | not))] as $off
    | if $off != [] then error("\($off | join(", ")) does not apply to a \($type) project, so it cannot take aliases") else . end
    | ([$applies[], ($own | keys[] | select(. as $k | $ids | index($k) | not))]) as $mine
    | [$own | to_entries[] | .key as $k | (.value.aliases // [])[] | {a: ., k: $k}] as $pairs
    | [$pairs | group_by(.a)[] | select(length > 1 or (.[0].a as $a | $mine | index($a))) | .[0].a] as $clash
    | if $clash != [] then error("an alias names two systems or is itself a system id: \($clash | join(", "))") else . end
    | [$doc[] | select(.id as $i | $applies | index($i))
        | {id, source: "doc", aliases: ($own[.id].aliases // []), is}]
      + [$own | to_entries[] | select(.key as $k | $ids | index($k) | not)
        | {id: .key, source: "own", aliases: (.value.aliases // []), is: .value.is}]
    | if $json == "1" then . else .[] | [.id, .source, (.aliases | join(",")), .is] | @tsv end')" \
    || { echo "project-stage-check: \"$NAME\": the systems list did not build" >&2; exit 2; }
  printf '%s\n' "$out"
  exit 0
}

[ -z "$LIST" ] || list_systems
[ -z "$SYSTEMS" ] || systems

LAB_STAGES="${LAB_STAGES:-$(notes projects --stages 2>/dev/null || true)}"
[ -n "$LAB_STAGES" ] || { echo "project-stage-check: notes projects --stages printed nothing" >&2; exit 2; }

if [ -z "$TARGET" ]; then
  # shellcheck disable=SC2086 # the ladder is a word list on purpose
  [ -n "$LAB" ] && TARGET="$(lab_head_tag "$(lab_front_page "$LAB")" $LAB_STAGES)"
  [ -n "$TARGET" ] || { echo "project-stage-check: \"$NAME\" declares no stage; pass --stage" >&2; exit 2; }
fi
lab_stage_at_least "$TARGET" "${LAB_STAGES%% *}" || { echo "project-stage-check: unknown stage \"$TARGET\" (want: $LAB_STAGES)" >&2; exit 2; }

enforced_from="$(sed -n 's/^Enforced from: *\([0-9-]*\).*/\1/p' "$STAGES_DOC" | head -1)"
today="${STAGE_GATE_TODAY:-$(date +%F)}"

fails=0 res=""
while IFS=$'\t' read -r stage app req check; do
  lab_stage_at_least "$TARGET" "$stage" || continue
  applies "$app" || continue
  r="$(judge "$check")"
  res+="$stage"$'\t'"$r"$'\t'"$req"$'\t'"$check"$'\n'
  [ -n "$JSON" ] || line "$r" "$stage" "$req" "$check"
  [ "$r" != FAIL ] || fails=$((fails + 1))
done < <(rows "$STAGES_DOC" Requirements)

blocks=""
[ "$fails" -gt 0 ] && [ -n "$enforced_from" ] && [[ ! "$today" < "$enforced_from" ]] && blocks=1

if [ -n "$JSON" ]; then
  printf '%s' "$res" | jq -R -s --arg name "$NAME" --arg type "$TYPE" --arg stage "$TARGET" \
      --arg from "$enforced_from" --arg blocks "$blocks" '
    [split("\n")[] | select(length > 0) | split("\t") | {stage: .[0], result: .[1], requirement: .[2], check: .[3]}] as $r
    | {project: $name, type: (if $type == "" then null else $type end), stage: $stage,
       met: ($r | map(select(.result == "PASS")) | length), total: ($r | length),
       fail: ($r | map(select(.result == "FAIL")) | length),
       human: ($r | map(select(.result == "HUMAN")) | length),
       todo: ($r | map(select(.result == "TODO")) | length),
       enforced_from: (if $from == "" then null else $from end), blocks: ($blocks != ""),
       requirements: $r}'
elif [ "$fails" -eq 0 ]; then
  echo "gate: $NAME meets #$TARGET"
elif [ -n "$blocks" ]; then
  echo "gate: $NAME fails $fails row(s) for #$TARGET"
else
  echo "gate: $NAME fails $fails row(s) for #$TARGET (report-only until ${enforced_from:-an Enforced from: date is set})"
fi
[ -z "$blocks" ] || exit 1
exit 0
