#!/usr/bin/env bash
# project-stage-check - does a project meet its stage, and its systems' criteria?
#
#   project-stage-check <name> [--stage <stage>] [--by-dept | --json]
#   project-stage-check <name> --systems [--system <id>] [--json]
#   project-stage-check <name> [--stage <stage> | --systems [--system <id>]] --file [--json]
#   project-stage-check <name> --list [--json]
#   project-stage-check --requirements [--json]
#
# Stage mode runs the Requirements rows of stages.md for <stage> (default: the stage its sheet
# declares) and every stage below, for `base` and the project's type. One PASS, FAIL, HUMAN or
# TODO line per row, then a `gate:` line; --by-dept groups those lines under each department of
# stages.md's Departments table, with its met/total. Exit 0 when nothing blocks, 1 when a FAIL blocks (from
# stages.md's `Enforced from:` date; before it the gate only reports), 2 on usage or an unknown
# project. --json prints the counts, the gate and each row instead, with the same exit. Callers:
# `notes projects --stage <name> --set <stage>` (refuses on 1), project-map-doctor.
# Systems mode runs the Criteria rows of systems.md for every system the project's type has (or
# one, with --system): the same lines, then met/total per system; --json prints those counts and
# each row instead. Exit 1 when any row FAILs, 2 on usage or an unknown project or system.
# --file reconciles the project's agent board with the check. A stage's FAIL rows go on one
# rollup row under the open epic for its target, `chore(stage): meet the <target> stage
# standard`, one brief line per gap, rewritten in place each run and closed when no gap is left
# (file_rollup); each FAIL row of a system becomes a story of its own under `epic(<system>): ...`,
# which `notes ptask add` files when it is missing (standing.rs). A stage's target is --stage,
# else the highest of the stage after the declared one and the stages open `epic(stage):` rows
# name; with no open epic for it, `epic(stage): <stage> to standard` is filed on the human sheet
# first. A gap whose row on either sheet, matched by title or from line, was closed or dropped by
# hand is never filed again, unless it was dropped as a dup of another row for that gap. Each
# open agent row of a row that now PASSes is closed with the check as proof. With --systems, a repo
# with no sheet of its own files on the board project-map names for it (`project_board`, as
# dotfiles-private on agent-runtime), each row and its from line prefixed with the repo's name.
# Exit 0, 1 when a write failed, 2 as above. With --json those lines go to stderr, and stdout gets
# the check's own --json (`stage` is the target) plus filed_open and filed_closed: the gaps the
# agent sheet holds open (a rollup line or a row of its own) and the agent rows of its rows closed.
# --list prints the project's systems (which ones: ~/.local/src/docs/systems.md, "The layers"),
# one `id<TAB>doc|own<TAB>aliases (comma-separated)<TAB>what it is` line each (--json: an array of
# {id, source, aliases, is}). A malformed `systems` entry exits 2.
# --requirements prints every Requirements row of stages.md, for no project: stage, applies, the
# check's kind (`predicate` runs, `human` is signed off, `not-yet` has no check), the requirement,
# and the skills its text names in backticks that exist under ~/.claude/skills (--json: the
# `Enforced from:` date, an array of {stage, applies, requirement, check, kind, skills, dept}, and
# `departments`, the Departments table as an array of {id, title, question, owns}).
# A Requirements row whose Dept is not a Departments id exits 2, in every mode.
# How a Check cell is written and run: ~/.local/src/docs/stages.md, "Requirements".
set -uo pipefail

usage() { sed -n '2,/^[^#]/{/^#/s/^# \{0,1\}//p}' "$0"; exit "${1:-2}"; }

NAME="" TARGET="" SYSTEMS="" ONLY="" JSON="" FILE="" LIST="" REQS="" BY_DEPT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --stage) TARGET="${2:-}"; shift 2 || usage ;;
    --systems) SYSTEMS=1; shift ;;
    --system) ONLY="${2:-}"; SYSTEMS=1; shift 2 || usage ;;
    --json) JSON=1; shift ;;
    --file) FILE=1; shift ;;
    --list) LIST=1; shift ;;
    --requirements) REQS=1; shift ;;
    --by-dept) BY_DEPT=1; shift ;;
    -h|--help) usage 0 ;;
    -*) echo "project-stage-check: unknown flag $1" >&2; usage ;;
    *) [ -z "$NAME" ] || usage; NAME="$1"; shift ;;
  esac
done
[ -n "$NAME$REQS" ] || usage
[ -z "$REQS" ] || [ -z "$NAME$TARGET$SYSTEMS$FILE$LIST" ] || { echo "project-stage-check: --requirements takes no project, only --json" >&2; usage; }
[ -z "$SYSTEMS" ] || [ -z "$TARGET" ] || { echo "project-stage-check: --stage and --systems do not mix" >&2; usage; }
[ -z "$LIST" ] || [ -z "$FILE$TARGET$ONLY" ] || { echo "project-stage-check: --list takes only --json" >&2; usage; }
[ -z "$BY_DEPT" ] || [ -z "$JSON$SYSTEMS$ONLY$FILE$LIST$REQS" ] || { echo "project-stage-check: --by-dept is a stage-mode view and takes only --stage" >&2; usage; }

# rows <doc> <section>: the cells of each row of the table under `## <section>`, tab-separated.
# A row starts with a lowercase id, so the header and the `---` line never match. `\|` is a
# literal pipe inside a cell, as GitHub markdown spells it.
rows() {
  awk -v want="## $2" '
    /^## / { intable = ($0 == want); next }
    intable && /^\| *[a-z][a-z-]* *\|/ {
      line = $0; gsub(/\\\|/, "\001", line)
      n = split(line, c, "|"); out = ""
      for (i = 2; i < n; i++) { gsub(/^ +| +$/, "", c[i]); gsub("\001", "|", c[i]); out = out (i > 2 ? "\t" : "") c[i] }
      print out
    }' "$1"
}

# kind_of <check>: `predicate` for a Check cell that is one whole code span (a cell like
# "`regen-anchor.sh` marks it STALE" names a check and never runs), `human`, else `not-yet`.
kind_of() {
  case "$1" in
    human) echo human ;;
    \`*\`) case "${1:1:${#1}-2}" in *\`*) echo not-yet ;; *) echo predicate ;; esac ;;
    *) echo not-yet ;;
  esac
}

# DEPTS: the Departments ids of stages.md, in order; known_dept <dept> <req> exits 2 on any other.
DEPTS=""
known_dept() {
  [ -n "$DEPTS" ] || DEPTS="$(rows "$STAGES_DOC" Departments | cut -f1 | tr '\n' ' ')"
  case " $DEPTS " in
    *" $1 "*) [ -n "$1" ] && return 0 ;;
  esac
  echo "project-stage-check: the Requirements row \"$2\" names Dept \"$1\", not one of the Departments in $STAGES_DOC: $DEPTS" >&2
  exit 2
}

# requirements: the --requirements mode, the Requirements rows for no project.
requirements() {
  local stage app req check skills s out=""
  local dir="${SKILLS_DIR:-$HOME/.claude/skills}"
  # The unit separator, not tab: tab is IFS whitespace, so an empty cell would shift the rest.
  while IFS=$'\037' read -r stage app req check dept _; do
    known_dept "$dept" "$req"
    skills=""
    while IFS= read -r s; do
      [ -n "$s" ] && [ -f "$dir/$s/SKILL.md" ] && case " $skills " in *" $s "*) ;; *) skills="${skills:+$skills }$s" ;; esac
    done < <(grep -o '`[a-z][a-z0-9-]*`' <<<"$req" | tr -d '`')
    out+="$stage"$'\t'"$app"$'\t'"$(kind_of "$check")"$'\t'"$skills"$'\t'"$req"$'\t'"$check"$'\t'"$dept"$'\n'
  done < <(rows "$STAGES_DOC" Requirements | tr '\t' '\037')
  [ -n "$out" ] || { echo "project-stage-check: no Requirements rows in $STAGES_DOC" >&2; exit 2; }
  if [ -n "$JSON" ]; then
    local depts
    depts="$(rows "$STAGES_DOC" Departments | jq -R -s '[split("\n")[] | select(length > 0) | split("\t") | {id: .[0], title: .[1], question: .[2], owns: .[3]}]')"
    printf '%s' "$out" | jq -R -s --argjson depts "$depts" --arg from "$(sed -n '/^Enforced from:/{s/^Enforced from: *\([0-9-]*\).*/\1/p;q;}' "$STAGES_DOC")" '
      {enforced_from: (if $from == "" then null else $from end), departments: $depts,
       requirements: [split("\n")[] | select(length > 0) | split("\t")
         | {stage: .[0], applies: (.[1] | split(", ")), kind: .[2],
            skills: (.[3] | split(" ") | map(select(length > 0))), requirement: .[4], check: .[5], dept: .[6]}]}'
  else
    printf '%s' "$out" | awk -F'\t' '{ printf "%-5s %-10s %-9s %s%s\n", $1, $2, $3, $5, ($4 == "" ? "" : " (by " $4 ")") }'
  fi
  exit 0
}

# sheet_rows: one line per task row on both lanes' sheets and their frozen version notes, its
# fields tab-separated: state, title, lane, id, mark, close, kids, prio, from. State is `open`,
# or `closed` for a ticked row, done or dropped; the title is from `notes row parse` (the
# grammar's home, so it reads as `projects::row_title` does: marker, stamps, `#` words and the
# `type(area): ` prefix dropped, spaces collapsed); the lane is `agent` for the agent sheet and
# its notes, else `human`. Mark is `todo`, `doing` (`[/]`) or `done`; close says how a ticked row
# closed: `dup:<id>`, `dropped`, `met` (closed with this check's own PASS proof) or `done`. Kids
# is 1 for a row with child rows (indented under it, or naming it in `#of/`), prio its `#urgent`,
# `#high`, `#normal` or `#low`, and from the rest of its `from project-stage-check <name> --file` detail
# line, which a reworded row keeps. An empty field is `-`: tab is IFS whitespace, so `read` would
# shift the rest. The roadmap leaves dropped rows out, so it cannot be this reader. Fails, saying
# so, when the verb does or answers short.
sheet_rows() {
  local f files=() rows titles
  for f in "$FILE_LAB/README.md" "$FILE_LAB/agent/README.md" "$FILE_LAB"/versions/*.md "$FILE_LAB"/agent/versions/*.md; do
    [ -f "$f" ] && files+=("$f")
  done
  [ "${#files[@]}" -gt 0 ] || return 0
  rows="$(awk -v agent="$FILE_LAB/agent/" '
    FNR == 1 { sp = 0; cur = 0 }
    /^[ \t]*- \[.\] / {
      n++; txt[n] = $0; ln[n] = (index(FILENAME, agent) == 1 ? "agent" : "human")
      ind = match($0, /[^ \t]/) - 1
      while (sp > 0 && si[sp] >= ind) sp--
      if (sp > 0) kid[sk[sp]] = 1
      sp++; si[sp] = ind; sk[sp] = n
      m = substr($0, ind + 4, 1); mk[n] = (m == " ") ? "todo" : (m == "/") ? "doing" : (m ~ /[xX]/) ? "done" : "todo"
      id[n] = "-"; if (match($0, /id:[a-z0-9]+-[0-9]+/)) id[n] = substr($0, RSTART + 3, RLENGTH - 3)
      s = $0; while (match(s, /#of\/[a-z0-9]+-[0-9]+/)) { of[substr(s, RSTART + 4, RLENGTH - 4)] = 1; s = substr(s, RSTART + RLENGTH) }
      pr[n] = "-"; if (match($0, /#(urgent|high|normal|low)([ \t]|$)/)) { pr[n] = substr($0, RSTART + 1, RLENGTH - 1); sub(/[ \t]$/, "", pr[n]) }
      cl[n] = "-"
      if (mk[n] == "done") {
        cl[n] = "done"
        if (match($0, /dup:[a-z0-9]+-[0-9]+/)) cl[n] = substr($0, RSTART, RLENGTH)
        else if ($0 ~ /dropped:/) cl[n] = "dropped"
        else if ($0 ~ /check:project-stage-check /) cl[n] = "met"
      }
      fr[n] = "-"; cur = n; next
    }
    cur && fr[cur] == "-" && /^[ \t]+from project-stage-check [^ ]+ --file[,:] / {
      s = $0; sub(/^[ \t]+from project-stage-check [^ ]+ --file[,:] /, "", s); fr[cur] = s; next
    }
    /^[^ \t]/ { cur = 0; sp = 0 }
    END {
      for (i = 1; i <= n; i++)
        print (mk[i] == "done" ? "closed" : "open") "\t" ln[i] "\t" id[i] "\t" mk[i] "\t" cl[i] "\t" \
          ((kid[i] || (id[i] in of)) ? 1 : 0) "\t" pr[i] "\t" fr[i] "\t" txt[i]
    }' "${files[@]}")"
  [ -n "$rows" ] || return 0
  titles="$(cut -f9- <<<"$rows" | notes row parse | cut -f3)" && [ "$(wc -l <<<"$titles")" = "$(wc -l <<<"$rows")" ] \
    || { echo "project-stage-check: notes row parse failed or answered short (an old notes? notes-bootstrap --build-only)" >&2; return 1; }
  paste <(cut -f1 <<<"$rows") - <(cut -f2-8 <<<"$rows") <<<"$titles"
}

# twins <title> <key>: the rows of $have that hold one check row: its title, or a from line
# naming its stage or system and check (`key`), which a row the triager reworded keeps. A rollup
# row is never a twin, nor a row closed as `dup:` of a rollup (from $ROLLUP_IDS) or of another
# twin, followed down its dup chain: the row the chain ends on holds the gap now, so a twin
# merged into an open one leaves the gap open. A chain that leaves the twins, or loops, closes it.
twins() {
  awk -F'\t' -v t="$1" -v k="$2" -v r=" $ROLLUP_IDS " '
    ($2 == t || $9 == k) && !index(r, " " $4 " ") { n++; row[n] = $0; to[n] = ($6 ~ /^dup:/ ? substr($6, 5) : ""); at[$4] = n }
    END {
      for (i = 1; i <= n; i++) {
        j = to[i]; hide = 0
        for (s = 0; j != "" && s < n; s++) {
          if (index(r, " " j " ")) { hide = 1; break }
          if (!(j in at)) break
          if (to[at[j]] == "") { hide = 1; break }
          j = to[at[j]]
        }
        if (!hide) print row[i]
      }
    }' <<<"$have"
}

# brief_of <id>: the detail lines under the agent-sheet row with this id, their indent and
# trailing blanks dropped, up to its first child row.
brief_of() {
  awk -v id="$1" '
    on && (/^[ \t]*- \[.\] / || /^[^ \t]/) { exit }
    on && /[^ \t]/ { sub(/^[ \t]+/, ""); sub(/[ \t]+$/, ""); print; next }
    /^[ \t]*- \[.\] / && match($0, "id:" id "([^0-9]|$)") { on = 1 }' "$FILE_LAB/agent/README.md" 2>/dev/null
}

# title_of <text>: the title as the sheet stores it (`projects::row_title`): words that start
# with `#` dropped, spaces collapsed, cut at a word to 80 characters (`propose`'s cut).
title_of() {
  jq -rn --arg t "$1" '[$t | splits(" +") | select(length > 0 and (startswith("#") | not))] | join(" ")
    | if length <= 80 then . else .[:80] | (if test(" ") then sub(" [^ ]*$"; "") else . end) end'
}

# stage_epic <stage>: file `epic(stage): <stage> to standard` on the human sheet and print its
# id. The epic tree is the system's to keep (lifecycle.md, "What an epic is"), so a stage with
# gaps never waits on a human to open its epic.
stage_epic() {
  local out id
  out="$(notes ptask "$BOARD" add "epic(stage): $1 to standard" --origin project-stage-check)" || return 1
  id="$(grep -o 'id:[a-z0-9]*-[0-9]*' <<<"$out" | awk 'NR==1')"
  [ -n "$id" ] || return 1
  printf 'epic    %-10s  %s to standard (%s)\n' "$1" "$1" "${id#id:}" >&2
  printf '%s\n' "${id#id:}"
}

# file_gaps: the --file mode. It reads this script's own --json, the open epics from `notes
# projects --stats --json` (the roadmap lists only epics with work in a version, so never a
# fresh one) and the rows already on the sheets, and writes only through `notes ptask`, whose
# twin check holds a concurrent run off an open row. A stage's gaps go on one rollup row
# (file_rollup), a system's each on its own row (file_systems). With --json it runs with stdout
# on stderr and writes its one JSON object to $JSON_OUT, never to an fd a child (a detached
# notes refresh) could hold open under the caller's `$(...)`.
file_gaps() {
  local epics ladder check rc gaps passes have n=0 filed=0 had=0 closed=0 failed=0 met=0 opened=0
  local fopen=0 fclosed=0 folded=0 listed_says="" full key title state lane id declared today v
  [ -n "$FILE_LAB" ] || { echo "project-stage-check: \"$NAME\" has no lab sheet and no project-map board to file rows on" >&2; exit 2; }
  epics="$(notes projects --stats --json 2>/dev/null | jq -c --arg n "$BOARD" \
    '[.[] | select((.name | ascii_downcase) == ($n | ascii_downcase)) | .epics[]?]')" \
    || { echo "project-stage-check: notes projects --stats --json failed" >&2; exit 2; }
  have="$(sheet_rows)" || exit 2
  ROLLUP_IDS="$(awk -F'\t' '$9 ~ /^the stages\.md rows / { printf "%s ", $4 }' <<<"$have")"
  # gaps and passes: one `target area text check key` line per FAIL or PASS row, the key what its
  # from line reads after `--file, `. The fields are split by the unit separator, not tab: tab is
  # IFS whitespace, so an empty cell would shift the rest, and @tsv would double a backslash.
  if [ -n "$SYSTEMS" ]; then
    check="$("$0" "$NAME" --systems ${ONLY:+--system "$ONLY"} --json)"; rc=$?
    [ "$rc" -le 1 ] || exit "$rc"
    gaps="$(jq -r '.systems[] | .id as $id | .criteria[] | select(.result == "FAIL")
      | [$id, $id, .criterion, .check, "systems.md \($id), check: \(.check)"] | map(. // "" | tostring) | join("\u001f")' <<<"$check")"
    passes="$(jq -r '.systems[] | .id as $id | .criteria[] | select(.result == "PASS")
      | [$id, $id, .criterion, .check, "systems.md \($id), check: \(.check)"] | map(. // "" | tostring) | join("\u001f")' <<<"$check")"
  else
    ladder="$(notes projects --stages 2>/dev/null)"
    LAB_STAGES="${LAB_STAGES:-$ladder}"
    # With no --stage, the target is the highest of the stage after the declared one and the stages
    # the open `epic(stage):` rows name: an epic opened by hand for a later stage keeps its work
    # coming, and a leftover epic for a stage already passed never pins the target below the next.
    # The check of a stage holds every row below it, so a regression at today's stage is filed too.
    # prod has no next: it checks itself.
    if [ -z "$TARGET" ]; then
      # shellcheck disable=SC2086 # the ladder is a word list on purpose
      declared="$(lab_head_tag "$(lab_front_page "$LAB")" $ladder)"
      [ -n "$declared" ] || { echo "project-stage-check: \"$NAME\" declares no stage; pass --stage" >&2; exit 2; }
      TARGET="$(jq -r --arg ladder "$ladder" --arg d "$declared" '($ladder | split(" ")) as $l
        | ($l | index($d)) as $i | [([$i + 1, ($l | length) - 1] | min)]
          + [.[] | select(.system == "stage") | (.title | split(" ")[0] | rtrimstr(",") | rtrimstr(":")) as $s
            | $l | index($s) | select(. != null)]
        | $l[max]' <<<"$epics")"
    fi
    check="$("$0" "$NAME" ${TARGET:+--stage "$TARGET"} --json)"; rc=$?
    [ "$rc" -le 1 ] || exit "$rc"
    TARGET="$(jq -r .stage <<<"$check")"
    gaps="$(jq -r --arg t "$TARGET" '.requirements[] | select(.result == "FAIL")
      | [$t, .stage, .requirement, .check, "stages.md #\(.stage), check: \(.check)"] | map(. // "" | tostring) | join("\u001f")' <<<"$check")"
    passes="$(jq -r --arg t "$TARGET" '.requirements[] | select(.result == "PASS")
      | [$t, .stage, .requirement, .check, "stages.md #\(.stage), check: \(.check)"] | map(. // "" | tostring) | join("\u001f")' <<<"$check")"
  fi
  # On another project's board a row names its repo, in its text and key, or two repos' rows would
  # read as one. Both the filing and the PASS-closing below read these lines.
  if [ "$BOARD" != "$NAME" ]; then
    for v in gaps passes; do
      printf -v "$v" '%s' "$(awk -F'\037' -v OFS='\037' -v p="$NAME: " 'NF { $3 = p $3; $5 = p $5 } 1' <<<"${!v}")"
    done
  fi
  # A text that also fails (two rows or systems sharing a text) is a gap, never met.
  passes="$(awk -F'\037' 'FILENAME == ARGV[1] { f[$3]; next } $3 != "" && !($3 in f)' <(printf '%s\n' "$gaps") <(printf '%s\n' "$passes"))"
  today="$(date +%F)"

  # A row of its own closes once its check passes: an open agent-sheet twin of a PASS row, closed
  # by its id with the check as proof.
  while IFS=$'\037' read -r _ _ full _ key; do
    [ -n "$full" ] || continue
    title="$(title_of "$full")"
    while IFS=$'\t' read -r state _ lane id _; do
      [ "$lane" = agent ] || continue
      if [ "$state" = closed ]; then fclosed=$((fclosed + 1)); continue; fi
      [ "$id" != - ] || continue
      if notes ptask "$BOARD" --agent "done" "$id" --proof "check:project-stage-check $NAME${SYSTEMS:+ --systems} PASS $today" >/dev/null; then
        met=$((met + 1)) fclosed=$((fclosed + 1)); printf 'met     %-10s  %s\n' "$id" "$title"
      else
        failed=$((failed + 1)); printf 'error   %-10s  %s (ptask done failed)\n' "$id" "$title"
      fi
    done < <(twins "$title" "$key")
  done <<<"$passes"

  if [ -n "$SYSTEMS" ]; then file_systems; else file_rollup; fi

  if [ -n "$JSON" ]; then
    jq -c --argjson o "$fopen" --argjson c "$fclosed" '. + {filed_open: $o, filed_closed: $c}' <<<"$check" > "$JSON_OUT" \
      || { failed=$((failed + 1)); printf 'error   %-10s  %s\n' sheets "the filed rows could not be counted"; }
  fi
  if [ -n "$SYSTEMS" ]; then
    printf 'file: %s systems%s: %s failing, %s filed, %s already open, %s closed or dropped, %s met and closed' \
      "$NAME" "${ONLY:+ $ONLY}" "$n" "$filed" "$had" "$closed" "$met"
  else
    printf 'file: %s #%s: %s failing, %s, %s held by their own row, %s closed or dropped, %s met and closed' \
      "$NAME" "$TARGET" "$n" "$listed_says" "$had" "$closed" "$met"
    [ "$folded" -eq 0 ] || printf ', %s folded' "$folded"
  fi
  [ "$opened" -eq 0 ] || printf ', %s epic opened' "$opened"
  [ "$failed" -eq 0 ] || printf ', %s failed' "$failed"
  printf '\n'
  [ "$failed" -eq 0 ]
  exit $?
}

# held <twins>: how its open and closed twins hold a gap, as `<state> <agent open> <agent closed>`.
# A twin closed by hand wins (`closed`): a gap the human dropped stays dropped. One this check
# closed on a PASS is no twin, so a regression is filed again.
held() {
  awk -F'\t' '$1 == "closed" && $6 != "met" { c = 1; if ($3 == "agent") ac++ }
    $1 == "open" { o = 1; if ($3 == "agent") ao++ }
    END { print (c ? "closed" : o ? "open" : "new"), ao + 0, ac + 0 }' <<<"$1"
}

# file_systems: each failing systems.md row on its own agent row, under its system's epic, or
# bare for `notes ptask add` to link the standing epic (standing.rs). Uses file_gaps' locals.
file_systems() {
  local target area full chk key t ao ac epic row text
  while IFS=$'\037' read -r target area full chk key; do
    [ -n "$target" ] || continue
    n=$((n + 1))
    title="$(title_of "$full")"; t="$(twins "$title" "$key")"
    read -r state ao ac < <(held "$t")
    fopen=$((fopen + ao)) fclosed=$((fclosed + ac))
    case "$state" in
      closed) closed=$((closed + 1)); printf 'closed  %-10s  %s\n' "$area" "$title"; continue ;;
      open) had=$((had + 1)); printf 'open    %-10s  %s\n' "$area" "$title"; continue ;;
    esac
    epic="$(jq -r --arg s "$target" '[.[] | select(.system == $s) | .id][0] // empty' <<<"$epics")"
    row="chore($area): $title${epic:+ #of/$epic} #size/s #low"
    text="from project-stage-check $NAME --file, $key"
    # A cut title keeps the whole requirement on a detail line.
    if [ "$title" = "$full" ]; then
      notes ptask "$BOARD" --agent add "$row" --detail "$text" --origin project-stage-check >/dev/null
    else
      notes ptask "$BOARD" --agent add "$row" --detail "$full" --detail "$text" --origin project-stage-check >/dev/null
    fi
    rc=$?
    case "$rc" in
      0) filed=$((filed + 1)) fopen=$((fopen + 1)); printf 'filed   %-10s  %s\n' "$area" "$title" ;;
      3) had=$((had + 1)); printf 'open    %-10s  %s\n' "$area" "$title" ;;
      *) failed=$((failed + 1)); printf 'error   %-10s  %s (ptask add exit %s)\n' "$area" "$title" "$rc" ;;
    esac
  done <<<"$gaps"
}

# target_epic: set epic to the open stage epic of TARGET, filing it first when there is none.
target_epic() {
  epic="$(jq -r --arg s "$TARGET" '[.[] | select(.system == "stage")
    | select(.title | split(" ")[0] | rtrimstr(",") | rtrimstr(":") == $s) | .id][0] // empty' <<<"$epics")"
  [ -z "$epic" ] || return 0
  if ! epic="$(stage_epic "$TARGET")"; then
    failed=$((failed + 1)); printf 'error   %-10s  %s (could not file the stage epic)\n' rollup "meet the $TARGET stage standard"
    return 1
  fi
  opened=$((opened + 1))
}

# gap_title <line>: the title of a rollup's `#<stage>: <text>, check: <check>` line.
gap_title() { local r="${1#\#*: }"; title_of "${r%%, check: *}"; }

# retag_rollup <rid> <its priority, - for none> <the gate's>: the priority follows the gate, as a new
# rollup's does. One set by hand (#urgent) stays, and so does one on a row the open sprint holds
# (stages.md, Frozen rows): the cut carries it. Returns 1 only when the tag failed otherwise.
retag_rollup() {
  local rid="$1" rprio="$2" prio="$3" terr args
  case "$rprio" in low|high|-) ;; *) return 0 ;; esac
  [ "$rprio" != "$prio" ] || return 0
  args=(--add "$prio"); [ "$rprio" = - ] || args+=(--remove "$rprio")
  terr="$(notes ptask "$BOARD" --agent tag "$rid" "${args[@]}" 2>&1 >/dev/null)" && return 0
  if grep -q 'sprint: the cut carries open rows' <<<"$terr"; then
    printf 'held    %-10s  meet the %s stage standard, #%s kept: the open sprint holds it\n' "$rid" "$TARGET" "$rprio"
    return 0
  fi
  printf 'error   %-10s  meet the %s stage standard (ptask tag failed)\n' "$rid" "$TARGET"
  return 1
}

# file_rollup: a stage's gaps on one agent row, `chore(stage): meet the <target> stage standard`,
# its brief a from line and one `#<stage>: <requirement>, check: <check>` line per gap. A run
# rewrites that list in place, retitles a rollup of a lower stage when the target rises, folds
# into it each open row this check filed for one of its gaps (`drop --dup`, undone by `reopen`),
# and closes it once no gap is left to list. A gap closed by hand, or held by an open row this
# check cannot fold (in progress, with children, on the human sheet, or with no from line), stays
# off the list. A rollup closed by hand is not filed again for its stage. Uses file_gaps' locals.
file_rollup() {
  local target area full chk key t ao ac lines="" pass_lines="" folds="" f l id s mark prio=low
  local rid="" rstage="" rmark="" rprio="" rprio_ others="" by_hand old="" brief args=() out epic ok=1 news=0
  local head="the stages.md rows this project fails for #$TARGET, one a line; a met row leaves the list and the row closes when none is left"
  [ "$(jq -r .blocks <<<"$check")" = true ] && prio=high
  while IFS=$'\037' read -r _ area full chk _; do
    [ -n "$full" ] && pass_lines+="#$area: $full, check: $chk"$'\n'
  done <<<"$passes"
  while IFS=$'\037' read -r target area full chk key; do
    [ -n "$target" ] || continue
    n=$((n + 1))
    title="$(title_of "$full")"; t="$(twins "$title" "$key")"
    read -r state ao ac < <(held "$t")
    if [ "$state" = closed ]; then
      closed=$((closed + 1)) fopen=$((fopen + ao)) fclosed=$((fclosed + ac)); printf 'closed  %-10s  %s\n' "$area" "$title"; continue
    fi
    id="$(awk -F'\t' '$1 == "open" && !($3 == "agent" && $5 == "todo" && $7 == 0 && $9 != "-" && $4 != "-") { print ($4 == "-" ? "a row with no id" : $4); exit }' <<<"$t")"
    if [ -n "$id" ]; then
      had=$((had + 1)) fopen=$((fopen + ao)); printf 'open    %-10s  %s (held by %s)\n' "$area" "$title" "$id"; continue
    fi
    lines+="#$area: $full, check: $chk"$'\n'
    f="$(awk -F'\t' -v t="$title" '$1 == "open" { print $4 "\t" t }' <<<"$t")"
    [ -z "$f" ] || folds+="$f"$'\n'
  done <<<"$gaps"

  # The open rollups at or below the target: the target's own is kept, else the highest below it.
  while IFS=$'\t' read -r id s mark rprio_; do
    lab_stage_at_least "$TARGET" "$s" || continue
    if [ -z "$rid" ] || { [ "$rstage" != "$TARGET" ] && lab_stage_at_least "$s" "$rstage"; }; then
      [ -z "$rid" ] || others+="$rid"$'\t'"$rmark"$'\n'
      rid="$id" rstage="$s" rmark="$mark" rprio="$rprio_"
    else
      others+="$id"$'\t'"$mark"$'\n'
    fi
  done < <(awk -F'\t' '$1 == "open" && $3 == "agent" && $9 ~ /^the stages\.md rows / {
      s = $9; sub(/^[^#]*#/, "", s); sub(/,.*/, "", s); print $4 "\t" s "\t" $5 "\t" $8 }' <<<"$have")

  if [ -z "$lines" ]; then
    listed_says="0 listed"
    [ -n "$rid" ] || return 0
    # Nothing left to list: each open rollup closes, with the check as its proof; one in progress
    # is left to the session working it.
    local proof="check:project-stage-check $NAME PASS $today"
    [ "$n" -eq 0 ] || proof="check:project-stage-check $NAME --file, each gap left is held or closed by its own row, $today"
    old="$(brief_of "$rid" | grep '^#')"
    while IFS=$'\t' read -r id mark; do
      [ -n "$id" ] || continue
      if [ "$mark" = doing ]; then
        printf 'open    %-10s  meet the %s stage standard, no gap left but in progress, left as it is\n' "$id" "$TARGET"
        [ "$id" != "$rid" ] || old=""; continue
      fi
      if notes ptask "$BOARD" --agent "done" "$id" --proof "$proof" >/dev/null; then
        printf 'row     %-10s  meet the %s stage standard, closed: no gap left to list\n' "$id" "$TARGET"
        listed_says="0 listed, $id closed"
      else
        failed=$((failed + 1)); printf 'error   %-10s  meet the %s stage standard (ptask done failed)\n' "$id" "$TARGET"
      fi
    done <<<"$rid"$'\t'"$rmark"$'\n'"$others"
  else
    brief="from project-stage-check $NAME --file: $head"$'\n'"${lines%$'\n'}"
    if [ -z "$rid" ]; then
      by_hand="$(awk -F'\t' -v r=" $ROLLUP_IDS " -v want="#$TARGET," '$1 == "closed" && $3 == "agent" &&
        $9 ~ /^the stages\.md rows / && index($9, want) && $6 != "met" && !($6 ~ /^dup:/ && index(r, " " substr($6, 5) " ")) { print $4; exit }' <<<"$have")"
      if [ -n "$by_hand" ]; then
        printf 'closed  %-10s  meet the %s stage standard was closed by hand, so it is not filed again (notes ptask %s reopen %s)\n' \
          "$by_hand" "$TARGET" "$NAME" "$by_hand"
        listed_says="0 listed, $by_hand closed by hand"
        return 0
      fi
      target_epic || { listed_says="0 listed"; return 0; }
      while IFS= read -r l; do args+=(--detail "$l"); done <<<"$brief"
      out="$(notes ptask "$BOARD" --agent add "chore(stage): meet the $TARGET stage standard #of/$epic #size/m #$prio" "${args[@]}" --origin project-stage-check)"; rc=$?
      # Exit 3 is add's twin check: a concurrent run filed the rollup first, and its list stands.
      if [ "$rc" -eq 3 ]; then
        printf 'open    %-10s  meet the %s stage standard, filed by another run\n' rollup "$TARGET"
        listed_says="0 listed, the rollup held by another run"; return 0
      fi
      rid="$(grep -o 'id:[a-z0-9]*-[0-9]*' <<<"$out" | awk 'NR == 1')"; rid="${rid#id:}"
      if [ "$rc" -ne 0 ] || [ -z "$rid" ]; then
        failed=$((failed + 1)); printf 'error   %-10s  meet the %s stage standard (ptask add exit %s%s)\n' rollup "$TARGET" "$rc" "$([ "$rc" -ne 0 ] || echo ', no id')"
        listed_says="0 listed"; return 0
      fi
      printf 'row     %-10s  meet the %s stage standard, filed\n' "$rid" "$TARGET"
    else
      # A rollup of a lower stage is retitled before its list says the target, so a failed
      # retitle leaves the row as it was for the next run to retry.
      if [ "$rstage" != "$TARGET" ]; then
        if ! target_epic; then
          ok=0
        elif notes ptask "$BOARD" --agent edit "$rid" --text "chore(stage): meet the $TARGET stage standard #of/$epic" >/dev/null; then
          printf 'row     %-10s  meet the %s stage standard, retitled from #%s\n' "$rid" "$TARGET" "$rstage"
        else
          ok=0 failed=$((failed + 1)); printf 'error   %-10s  meet the %s stage standard (ptask edit --text failed)\n' "$rid" "$TARGET"
        fi
      fi
      old="$(brief_of "$rid")"
      if [ "$ok" = 1 ] && [ "$old" != "$brief" ] && ! notes ptask "$BOARD" --agent edit "$rid" --brief "$brief" >/dev/null; then
        failed=$((failed + 1)) ok=0; printf 'error   %-10s  meet the %s stage standard (ptask edit --brief failed)\n' "$rid" "$TARGET"
      fi
      old="$(grep '^#' <<<"$old")"
      retag_rollup "$rid" "$rprio" "$prio" || failed=$((failed + 1))
    fi
    # Nothing folds into a list that was not written: its gaps would be on neither.
    [ "$ok" = 1 ] || { listed_says="the list on $rid not written"; return 0; }
    while IFS= read -r l; do
      [ -n "$l" ] || continue
      area="${l#\#}"; area="${area%%: *}"
      if grep -qxF -- "$l" <<<"$old"; then printf 'open    %-10s  %s\n' "$area" "$(gap_title "$l")"
      else news=$((news + 1)) filed=$((filed + 1)); printf 'filed   %-10s  %s\n' "$area" "$(gap_title "$l")"; fi
    done <<<"$lines"
    fopen=$((fopen + $(grep -c . <<<"$lines")))
    listed_says="$(grep -c . <<<"$lines") listed on $rid ($news new)"
    while IFS=$'\t' read -r id title; do
      [ -n "$id" ] || continue
      if notes ptask "$BOARD" --agent drop "$id" --dup "$rid" >/dev/null; then
        folded=$((folded + 1)); printf 'folded  %-10s  %s (into %s)\n' "$id" "$title" "$rid"
      else
        failed=$((failed + 1)); printf 'error   %-10s  %s (ptask drop --dup %s failed)\n' "$id" "$title" "$rid"
      fi
    done <<<"$folds"
    while IFS=$'\t' read -r id mark; do
      [ -n "$id" ] || continue
      if [ "$mark" = doing ]; then printf 'open    %-10s  another stage rollup, in progress, left as it is\n' "$id"; continue; fi
      if notes ptask "$BOARD" --agent drop "$id" --dup "$rid" >/dev/null; then
        folded=$((folded + 1)); printf 'folded  %-10s  another stage rollup (into %s)\n' "$id" "$rid"
      else
        failed=$((failed + 1)); printf 'error   %-10s  another stage rollup (ptask drop --dup %s failed)\n' "$id" "$rid"
      fi
    done <<<"$others"
  fi
  # The lines the list lost: met when that row passes now, else gone (closed or held by its own row).
  while IFS= read -r l; do
    [ -n "$l" ] && ! grep -qxF -- "$l" <<<"$lines" || continue
    if grep -qxF -- "$l" <<<"$pass_lines"; then
      met=$((met + 1)); printf 'met     %-10s  %s\n' "$rid" "$(gap_title "$l")"
    else
      printf 'gone    %-10s  %s\n' "$rid" "$(gap_title "$l")"
    fi
  done <<<"$old"
}

STAGES_DOC="${STAGES_DOC:-$HOME/.local/src/docs/stages.md}"
SYSTEMS_DOC="${SYSTEMS_DOC:-$HOME/.local/src/docs/systems.md}"
DOC="$STAGES_DOC"; [ -z "$SYSTEMS$LIST" ] || DOC="$SYSTEMS_DOC"
[ -r "$DOC" ] || { echo "project-stage-check: $DOC not found" >&2; exit 2; }
[ -z "$REQS" ] || requirements

# shellcheck source=../../.config/shared-hooks/project-name.sh
. "${PROJECT_NAME_LIB:-$HOME/.config/shared-hooks/project-name.sh}"
# shellcheck source=../lib/lab-feed.sh
. "${LAB_FEED_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/lab-feed.sh}"
# lab_roots lives in the private overlay; without it there is no lab dir and no declared stage.
# shellcheck source=/dev/null
[ -r "${LAB_ROOTS_LIB:-$HOME/.config/shared-hooks/lab-roots.sh}" ] && . "${LAB_ROOTS_LIB:-$HOME/.config/shared-hooks/lab-roots.sh}"

LAB=""
if declare -F lab_roots >/dev/null; then
  while IFS= read -r root; do
    [ -f "$root/$NAME/summary.md" ] && { LAB="$root/$NAME"; break; }
  done < <(lab_roots)
fi
# BOARD, FILE_LAB: where --file writes. A repo with no sheet of its own files its systems gaps on the
# board project-map names for it (`project_board`: dotfiles-private -> agent-runtime), under its own name;
# the checks keep reading LAB, the project's own.
BOARD="$NAME" FILE_LAB="$LAB"
if [ -z "$LAB" ] && [ -n "$SYSTEMS" ] && declare -F lab_roots >/dev/null; then
  b="$(project_board "$NAME")"
  if [ -n "$b" ] && [ "$b" != "$NAME" ]; then
    while IFS= read -r root; do
      [ -f "$root/$b/summary.md" ] && { BOARD="$b" FILE_LAB="$root/$b"; break; }
    done < <(lab_roots)
  fi
fi
TYPE="$(project_inherited "$NAME" type)"
# TAGS: the Applies tags this project takes, `base`, its type, and `store` when it ships through a
# store: every game, and a project with a steam, play or testflight target (release-state's store
# probes) in project-map `targets`, its own entry's, else its lab siblings' as TYPE is inherited.
TAGS="base ${TYPE:-none}"
if [ "$TYPE" = game ]; then TAGS="$TAGS store"
else
  rc=0
  # shellcheck disable=SC2046 # one lab name per word
  jq -e '
    . as $map | def st($n): $map.trackers[$n] | objects | .targets | arrays;
    $ARGS.positional as $ns
    | ([st($ns[0])] | if length > 0 then .[0] else [$ns[1:][] as $s | st($s)[]] end)
    | [.[] | .live // {} | keys[]] | any(IN("steam", "play", "testflight"))' \
    "$(project_map_file)" --args "$NAME" $(project_lab_names "$NAME") </dev/null >/dev/null || rc=$?
  case "$rc" in
    0) TAGS="$TAGS store" ;;
    1) ;;
    *) echo "project-stage-check: cannot read the targets of \"$NAME\" from $(project_map_file)" >&2; exit 2 ;;
  esac
fi
REPO="$(project_repo_path "$NAME" 2>/dev/null || true)"
REPO="${REPO/#\~/$HOME}"
# A project inside a monorepo (`trackers.<name>.path`, as apps/<app>) keeps its own
# README, docs and CHANGELOG there; the predicates run from that root.
sub="$(project_field "$NAME" path)"
ROOT="${REPO:+$REPO${sub:+/$sub}}"
# DOC_REF: the tree the doc helpers read, the remote default branch as last fetched, since a clone can be
# weeks behind it. A repo with no origin has no other copy, so it reads its working tree.
DOC_REF="" DOC_SUB="$sub"
if [ -z "$LIST" ] && [ -n "$REPO" ] && [ -d "$REPO" ] && git -C "$REPO" remote get-url origin >/dev/null 2>&1; then
  DOC_REF="$(git -C "$REPO" rev-parse --verify -q refs/remotes/origin/HEAD)" \
    || echo "project-stage-check: $REPO has an origin but no origin/HEAD, so docs are read from its working tree (git -C $REPO remote set-head origin -a)" >&2
fi
[ -n "$LIST" ] || [ -z "$REPO" ] || [ -d "$REPO" ] || { echo "project-stage-check: $REPO is not checked out here" >&2; exit 2; }
[ -n "$LAB" ] || [ -n "$TYPE" ] || { echo "project-stage-check: no lab dir and no project-map type for \"$NAME\"" >&2; exit 2; }
if [ -n "$FILE" ] && [ -n "$JSON" ]; then
  JSON_OUT="$(mktemp)"; (file_gaps) >&2; rc=$?
  cat "$JSON_OUT"; rm -f "$JSON_OUT"; exit "$rc"
fi
[ -z "$FILE" ] || file_gaps

# applies <cell>: the Applies cell names one of TAGS.
applies() {
  local t
  for t in ${1//,/ }; do case " $TAGS " in *" $t "*) return 0 ;; esac; done
  return 1
}

# With no project folder, predicates run from an empty dir, never the repo root or lab.
EMPTY="$(mktemp -d)"; trap 'rmdir "$EMPTY"' EXIT
CHECK_DIR="$ROOT"; [ -d "$CHECK_DIR" ] || CHECK_DIR="$EMPTY"

# The doc helpers a predicate calls (stages.md, "Requirements"), each relative to ROOT.
doc_path() { printf '%s%s' "${DOC_SUB:+$DOC_SUB/}" "$1"; }
doc() {
  local p
  for p; do
    if [ -n "$DOC_REF" ]; then git -C "$REPO" cat-file -e "$DOC_REF:$(doc_path "$p")" 2>/dev/null || return 1
    else [ -f "$p" ] || return 1; fi
  done
}
doc_text() {
  if [ -n "$DOC_REF" ]; then git -C "$REPO" show "$DOC_REF:$(doc_path "$1")"; else cat -- "$1"; fi
}
doc_files() {
  if [ -n "$DOC_REF" ]; then
    git -C "$REPO" ls-tree -r --name-only --full-tree "$DOC_REF" -- ${DOC_SUB:+"$DOC_SUB"} | sed "s#^${DOC_SUB:+$DOC_SUB/}##"
  else
    git ls-files --cached --others --exclude-standard 2>/dev/null || find . -type f -not -path './.git/*' -printf '%P\n'
  fi
}
doc_grep() {
  local pat="$1" p ps=()
  shift
  if [ -n "$DOC_REF" ]; then
    # A pathspec `*` crosses `/`, so `<dir>/*.md` is every doc under it, as --include is below.
    for p; do case "$p" in *.md) ps+=("$(doc_path "$p")") ;; *) ps+=("$(doc_path "$p")/*.md") ;; esac; done
    git -C "$REPO" grep -qiE -e "$pat" "$DOC_REF" -- "${ps[@]}"
  else
    grep -rqiE --include='*.md' -e "$pat" -- "$@"
  fi
}

# judge <check>: PASS, FAIL, HUMAN or TODO for one Check cell.
judge() {
  local pred
  case "$(kind_of "$1")" in
    human) echo HUMAN ;;
    predicate)
      pred="${1#\`}"; pred="${pred%\`}"
      # A predicate is plain shell: `ls a b | grep -q .` must not fail on this script's pipefail.
      if (set +o pipefail; STAGE=""; [ -n "$SYSTEMS" ] || STAGE="$TARGET"; export NAME TYPE REPO ROOT LAB STAGE; cd "$CHECK_DIR" || exit 1; eval "$pred") >/dev/null 2>&1; then
        echo PASS
      else
        echo FAIL
      fi ;;
    *) echo TODO ;;
  esac
}

# line <result> <tag> <text> <check>: one report line; a TODO names what checks it today.
# The tag column is a stage (5 wide) or a system id (10 wide).
line() {
  local w=5; [ -z "$SYSTEMS" ] || w=10
  case "$1" in
    TODO) printf '%-5s %-*s  %s (%s)\n' "$1" "$w" "$2" "$3" "$4" ;;
    *) printf '%-5s %-*s  %s\n' "$1" "$w" "$2" "$3" ;;
  esac
}

systems() {
  local id app sys crit check r known="" ids=() res=""
  while IFS=$'\t' read -r id app _; do
    known="${known:+$known }$id"
    applies "$app" || continue
    [ -z "$ONLY" ] || [ "$id" = "$ONLY" ] || continue
    ids+=("$id")
  done < <(rows "$SYSTEMS_DOC" Systems)
  if [ -n "$ONLY" ] && [ "${#ids[@]}" -eq 0 ]; then
    case " $known " in
      *" $ONLY "*) echo "project-stage-check: system \"$ONLY\" does not apply to \"$NAME\", which takes: $TAGS" >&2 ;;
      *) echo "project-stage-check: unknown system \"$ONLY\" (want: $known)" >&2 ;;
    esac
    exit 2
  fi
  while IFS=$'\t' read -r sys app crit check _; do
    case " $known " in *" $sys "*) ;; *) echo "project-stage-check: a Criteria row names unknown system \"$sys\"" >&2; exit 2 ;; esac
    case " ${ids[*]} " in *" $sys "*) ;; *) continue ;; esac
    applies "$app" || continue
    r="$(judge "$check")"
    res+="$sys"$'\t'"$r"$'\t'"$crit"$'\t'"$check"$'\n'
    [ -n "$JSON" ] || line "$r" "$sys" "$crit" "$check"
  done < <(rows "$SYSTEMS_DOC" Criteria)

  if [ -n "$JSON" ]; then
    printf '%s' "$res" | jq -R -s --arg name "$NAME" --arg type "$TYPE" --args '
      [split("\n")[] | select(length > 0) | split("\t") | {system: .[0], result: .[1], criterion: .[2], check: .[3]}] as $rows
      | [$ARGS.positional[] as $id | ($rows | map(select(.system == $id))) as $r
          | {id: $id, met: ($r | map(select(.result == "PASS")) | length), total: ($r | length),
             fail: ($r | map(select(.result == "FAIL")) | length),
             human: ($r | map(select(.result == "HUMAN")) | length),
             todo: ($r | map(select(.result == "TODO")) | length),
             criteria: ($r | map(del(.system)))}] as $s
      | {project: $name, type: (if $type == "" then null else $type end),
         met: ([$s[].met] | add // 0), total: ([$s[].total] | add // 0), systems: $s}' "${ids[@]}"
  else
    printf '%s' "$res" | awk -F'\t' -v name="$NAME" -v order="${ids[*]}" '
      { n[$1]++; if ($2 == "PASS") m[$1]++ }
      END { k = split(order, id, " "); out = ""
            for (i = 1; i <= k; i++) out = out (i > 1 ? ", " : "") id[i] " " m[id[i]] + 0 "/" n[id[i]] + 0
            print "systems: " name ": " out }'
  fi
  case "$res" in *$'\t'FAIL$'\t'*) exit 1 ;; esac
  exit 0
}

list_systems() {
  local own out
  # A malformed entry exits 2 with its key named: an empty list would read as "no own systems".
  own="$(jq -c --arg n "$NAME" '
    def word: type == "string" and test("^[a-z][a-z0-9-]*$");
    def id: type == "string" and test("^[a-z][a-z-]*$");
    def entry: type == "object" and ((.aliases // []) | type == "array" and all(.[]; word))
      and ((.is // "") | type == "string");
    (.trackers[$n].systems // {}) as $s
    | if ($s | type) != "object" then error("\($n): systems is not an object") else . end
    | [$s | to_entries[] | select((.key | id | not) or (.value | entry | not)) | .key] as $bad
    | if $bad == [] then $s
      else error("\($n): bad systems entries: \($bad | join(", ")); want {\"<id>\": {\"is\": \"<line>\", \"aliases\": [\"<word>\"]}}, ids and aliases lowercase") end
  ' "$(project_map_file)")" || { echo "project-stage-check: cannot read the systems of \"$NAME\" from $(project_map_file)" >&2; exit 2; }
  out="$(rows "$SYSTEMS_DOC" Systems | jq -r -R -s --arg type "${TYPE:-none}" --arg tags "$TAGS" --argjson own "$own" --arg json "$JSON" '
    [split("\n")[] | select(length > 0) | split("\t") | {id: .[0], applies: (.[1] | split(", ")), is: .[2]}] as $doc
    | ($doc | map(.id)) as $ids
    | [$own | keys[] | select(. as $k | ($ids | index($k) | not) and ($own[$k].is // "") == "")] as $nois
    | if $nois != [] then error("own systems need an \"is\" line: \($nois | join(", "))") else . end
    | ([$doc[] | select(any(.applies[]; . as $a | $tags | split(" ") | index($a))) | .id]) as $applies
    | [$own | keys[] | select(. as $k | ($ids | index($k)) and ($applies | index($k) | not))] as $off
    | if $off != [] then error("\($off | join(", ")) does not apply to a \($type) project, so it cannot take aliases") else . end
    | ([$applies[], ($own | keys[] | select(. as $k | $ids | index($k) | not))]) as $mine
    | [$own | to_entries[] | .key as $k | (.value.aliases // [])[] | {a: ., k: $k}] as $pairs
    | [$pairs | group_by(.a)[] | select(length > 1 or (.[0].a as $a | $mine | index($a))) | .[0].a] as $clash
    | if $clash != [] then error("an alias names two systems or is itself a system id: \($clash | join(", "))") else . end
    | [$doc[] | select(.id as $i | $applies | index($i))
        | {id, source: "doc", aliases: ($own[.id].aliases // []), is}]
      + [$own | to_entries[] | select(.key as $k | $ids | index($k) | not)
        | {id: .key, source: "own", aliases: (.value.aliases // []), is: .value.is}]
    | if $json == "1" then . else .[] | [.id, .source, (.aliases | join(",")), .is] | @tsv end')" \
    || { echo "project-stage-check: \"$NAME\": the systems list did not build" >&2; exit 2; }
  printf '%s\n' "$out"
  exit 0
}

[ -z "$LIST" ] || list_systems
[ -z "$SYSTEMS" ] || systems

LAB_STAGES="${LAB_STAGES:-$(notes projects --stages 2>/dev/null || true)}"
[ -n "$LAB_STAGES" ] || { echo "project-stage-check: notes projects --stages printed nothing" >&2; exit 2; }

if [ -z "$TARGET" ]; then
  # shellcheck disable=SC2086 # the ladder is a word list on purpose
  [ -n "$LAB" ] && TARGET="$(lab_head_tag "$(lab_front_page "$LAB")" $LAB_STAGES)"
  [ -n "$TARGET" ] || { echo "project-stage-check: \"$NAME\" declares no stage; pass --stage" >&2; exit 2; }
fi
lab_stage_at_least "$TARGET" "${LAB_STAGES%% *}" || { echo "project-stage-check: unknown stage \"$TARGET\" (want: $LAB_STAGES)" >&2; exit 2; }

enforced_from="$(sed -n '/^Enforced from: *\([0-9-]*\).*/{s//\1/p;q;}' "$STAGES_DOC")"
today="${STAGE_GATE_TODAY:-$(date +%F)}"

fails=0 res=""
# The unit separator, not tab: tab is IFS whitespace, so an empty cell would shift the rest.
while IFS=$'\037' read -r stage app req check dept _; do
  known_dept "$dept" "$req"
  lab_stage_at_least "$TARGET" "$stage" || continue
  applies "$app" || continue
  r="$(judge "$check")"
  res+="$stage"$'\t'"$r"$'\t'"$req"$'\t'"$check"$'\t'"$dept"$'\n'
  [ -n "$JSON$BY_DEPT" ] || line "$r" "$stage" "$req" "$check"
  [ "$r" != FAIL ] || fails=$((fails + 1))
done < <(rows "$STAGES_DOC" Requirements | tr '\t' '\037')

if [ -n "$BY_DEPT" ]; then
  while IFS=$'\t' read -r id title _; do
    grep -q $'\t'"$id"'$' <<<"$res" || continue
    printf '%s\n' "$(awk -F'\t' -v d="$id" -v t="$title" '$5 == d { n++; if ($2 == "PASS") m++ } END { printf "%s: %d/%d met", t, m, n }' <<<"$res")"
    while IFS=$'\037' read -r stage r req check d; do
      [ "$d" != "$id" ] || printf '  %s\n' "$(line "$r" "$stage" "$req" "$check")"
    done < <(tr '\t' '\037' <<<"$res")
  done < <(rows "$STAGES_DOC" Departments)
fi

blocks=""
[ "$fails" -gt 0 ] && [ -n "$enforced_from" ] && [[ ! "$today" < "$enforced_from" ]] && blocks=1

if [ -n "$JSON" ]; then
  printf '%s' "$res" | jq -R -s --arg name "$NAME" --arg type "$TYPE" --arg stage "$TARGET" \
      --arg from "$enforced_from" --arg blocks "$blocks" '
    [split("\n")[] | select(length > 0) | split("\t") | {stage: .[0], result: .[1], requirement: .[2], check: .[3], dept: .[4]}] as $r
    | {project: $name, type: (if $type == "" then null else $type end), stage: $stage,
       met: ($r | map(select(.result == "PASS")) | length), total: ($r | length),
       fail: ($r | map(select(.result == "FAIL")) | length),
       human: ($r | map(select(.result == "HUMAN")) | length),
       todo: ($r | map(select(.result == "TODO")) | length),
       enforced_from: (if $from == "" then null else $from end), blocks: ($blocks != ""),
       requirements: $r}'
elif [ "$fails" -eq 0 ]; then
  echo "gate: $NAME meets #$TARGET"
elif [ -n "$blocks" ]; then
  echo "gate: $NAME fails $fails row(s) for #$TARGET"
else
  echo "gate: $NAME fails $fails row(s) for #$TARGET (report-only until ${enforced_from:-an Enforced from: date is set})"
fi
[ -z "$blocks" ] || exit 1
exit 0
