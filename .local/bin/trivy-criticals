#!/usr/bin/env bash
# trivy-criticals - how many critical CVEs that have a fix run on home-k3s, image by image?
#
# trivy-operator scans every running image into a VulnerabilityReport. Most images carry some
# critical, and a critical with no fixed version is not work anyone can do, so only CVEs that
# Trivy gives a fixedVersion count; the others are counted apart and never trip. One image
# running in several workloads counts once, and a CVE found in several packages of one image
# counts once (fixable when any of them has a fix). The sentinel `home-k3s-trivy-criticals`
# watch runs this with --max as a ratchet bound: it only goes down, as bumps land.
#
# Usage:
#   trivy-criticals [--context <kube context>] [--max <n>]
# Prints one line per image with a fixable critical, most first, then the totals as the last line.
# Exit: 0 at or under --max (always, without it), 1 above it, 2 the reports could not be read.
set -uo pipefail

ctx=home-k3s max=""
while [ $# -gt 0 ]; do
  case "$1" in
    --context) ctx="${2:?--context needs a value}"; shift 2 ;;
    --max) max="${2:?--max needs a value}"; shift 2 ;;
    -h|--help) sed -n '2,/^set -uo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
    *) echo "trivy-criticals: unknown argument: $1" >&2; exit 64 ;;
  esac
done
case "$max" in ''|*[!0-9]*) [ -z "$max" ] || { echo "trivy-criticals: --max takes a count" >&2; exit 64; } ;; esac

if ! reports="$(kubectl --context "$ctx" --request-timeout=60s get vulnerabilityreports -A -o json)" \
   || ! out="$(jq -r '
      [ .items[]
        | .report as $r
        | (($r.registry.server // "") | if . == "" then "" else . + "/" end)
          + $r.artifact.repository
          + (if ($r.artifact.tag // "") != "" then ":" + $r.artifact.tag else "@" + ($r.artifact.digest // "") end) as $img
        | $r.vulnerabilities[]? | select(.severity == "CRITICAL")
        | {img: $img, id: .vulnerabilityID, fix: ((.fixedVersion // "") != "")} ]
      | group_by([.img, .id]) | map({img: .[0].img, fix: any(.[]; .fix)})
      | (map(select(.fix)) | group_by(.img) | map({img: .[0].img, n: length}) | sort_by(-.n, .img)) as $per
      | ($per[] | "\(.n)\t\(.img)"),
        "TOTAL\t\($per | map(.n) | add // 0)\t\($per | length)\t\(map(select(.fix | not)) | length)"
    ' <<<"$reports" 2>/dev/null)"; then
  echo "Trivy vulnerability reports on $ctx could not be read"
  exit 2
fi

total="" images="" nofix=""
while IFS=$'\t' read -r n a b c; do
  if [ "$n" = TOTAL ]; then total="$a" images="$b" nofix="$c"; else printf '%4d fixable  %s\n' "$n" "$a"; fi
done <<<"$out"
[ -n "$total" ] || { echo "Trivy vulnerability reports on $ctx could not be read"; exit 2; }

printf 'Fixable critical CVEs on %s: %d in %d images%s; %d more have no fix\n' \
  "$ctx" "$total" "$images" "${max:+ (bound $max)}" "$nofix"
[ -z "$max" ] || [ "$total" -le "$max" ]
