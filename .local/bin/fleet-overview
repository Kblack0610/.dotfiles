#!/usr/bin/env bash
# fleet-overview - the waybar fleet chips as one document, for the phone widget.
#
#   fleet-overview    print {state, html} as one line of JSON
#
# Each chip builds its `phone` lines in the run that builds its bar text, so the widget and the
# bar read the same source and cannot disagree. This only runs the chips and joins them: Pango
# spans become the <font> the Companion app's Template widget renders, in colours that read on
# a light or a dark widget. A chip with no phone lines (its Prometheus read failed) gives its
# hover, which says why, and a chip that prints nothing gets a line saying so. state is the worst
# chip: ok, warn or critical. agent-mqtt-publish publishes this as summary/overview.
set -uo pipefail

CHIP_DIR="${FLEET_OVERVIEW_CHIPS:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../../.config/waybar}"
CHIPS=(ai_agents dispatch ci_runners day)

case "${1:-}" in
    -h|--help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

# shellcheck source=../../.config/waybar/pango.sh
. "$CHIP_DIR/pango.sh"

tmp="$(mktemp -d)" || exit 1
trap 'rm -rf "$tmp"' EXIT

# In parallel: a dead Prometheus costs each chip its read timeout, and agentctl gives the whole
# publisher five seconds.
for c in "${CHIPS[@]}"; do "$CHIP_DIR/$c.sh" > "$tmp/$c" 2>/dev/null & done
wait

for c in "${CHIPS[@]}"; do
    jq -e .class "$tmp/$c" >/dev/null 2>&1 ||
        jq -cn --arg c "$c" '{class: "critical", phone: "\($c): the chip printed nothing"}' > "$tmp/$c"
    cat "$tmp/$c"
done | jq -cs --arg stamp "as of $(date +%H:%M)" \
    --arg ok "${LEVEL_COLOUR[0]}" --arg warn "${LEVEL_COLOUR[1]}" --arg red "${LEVEL_COLOUR[2]}" '
    {($ok): "#43a047", ($warn): "#f9a825", ($red): "#e53935"} as $palette
    | {state: (map(.class) | if index("critical") then "critical" elif index("warn") then "warn" else "ok" end),
       html: (map(.phone // .tooltip) + [$stamp] | join("\n")
              | gsub("<span color=\u0027(?<c>[^\u0027]+)\u0027>"; "<font color=\u0027\($palette[.c] // .c)\u0027>")
              | gsub("</span>"; "</font>") | gsub("\n"; "<br>"))}'
