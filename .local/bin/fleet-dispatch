#!/usr/bin/env bash
# fleet-dispatch - start one session per easy board row, for the shepherd to see through.
#
#   fleet-dispatch run [--dry-run]   one pass: start the queue items the gates allow, else fill from the board and start those
#   fleet-dispatch kick              the fast path an event runs: start the queued items the gates and room allow, in seconds; no reap, triage, judge or board fill, and it stands down while a pass runs
#   fleet-dispatch candidates        open rows eligible to judge, one JSON object per line
#   fleet-dispatch suggest [--json|--write]  the Candidates: open rows of every dev+ project, ranked, with why, auto, verdict, held; --write stores them for the hub fold
#   fleet-dispatch covered           the projects an untagged worker takes: stage dev or later, a repo, not on DISPATCH_OFF_PROJECTS
#   fleet-dispatch report            latest verdict per row: picked or skipped, and why
#   fleet-dispatch verdicts          the same as JSON lines, each with plan: true for a skip by a DISPATCH_PLAN_RULES rule
#   fleet-dispatch exits [--dry-run] give each skipped agent row its rule's exit (skip_exits; each run pass does); --dry-run lists them
#   fleet-dispatch fill [--dry-run] [--json]  promote picked board rows into agent-queue; --dry-run lists them
#   fleet-dispatch promote --project P [--profile X] [--agent] [--dispatch] [--tags T] --raw LINE  queue one board row as it stands: the Board tab's Start; --tags rides on the item; --dispatch makes it a capped pull like dispatch's own
#   fleet-dispatch pull-after [--queue-only] ID  promote, and start unless low or --queue-only, the open rows gated #after/ID: agent-queue runs it when ID's item closes ok
#   fleet-dispatch reap              settle items whose session is gone; waiting/ <-> running/ by the session; a row whose #ask/ gate was answered another way is held or dropped, one on a cancelled ask closes on its done item's merged PR, follows the ask it joined, or is asked again
#   fleet-dispatch headroom [--json] how many more queue items could start now, and the margin under each limit
#   fleet-dispatch idle-cap          rc 1 when live sessions are at the pace target with under DISPATCH_IDLE_CAP_PCT of them busy,
#                                    naming the idle ones; rc 2 when the fleet state cannot be read (watch fleet-cap-mostly-idle)
#   fleet-dispatch starved           rc 1 naming an urgent or high queue item no pass has started in DISPATCH_STARVED_MIN,
#                                    an urgent one from the human even under a dispatch hold or load,
#                                    or board rows no pass has judged in that time (the human here or away; not at a full fleet),
#                                    or a queue under DISPATCH_LOW_WATER with rows to pick and no start in twice that,
#                                    or a trainee pool dry that long while a trainee harness has a slot
#   fleet-dispatch sprint-stalled    rc 1 naming each agent row of an open sprint with no queue item, session or open gate
#                                    for DISPATCH_STARVED_MIN (watch sprint-stalled); rc 2 when a read fails
#   fleet-dispatch stopped [--json]  rc 1 and one line when a hold has stopped every pass for DISPATCH_STARVED_MIN:
#                                    how long, why, what clears it (hub Home, the briefing, queue-starved)
#   fleet-dispatch stats             one JSON object: runnable work, starts and reaps in the last hour, flapping items
#   fleet-dispatch item-tier SLUG    the queue item's tier (item_tier): agent-land gates a tier-3 one
#   fleet-dispatch trainee-pool [--json]  the board rows a trainee takes, how many each refusal turns away, and the floor open or shut
#   fleet-dispatch trainee-review SLUG  a trainee run's tail, in its worktree: its diff to a patch that waits for a batch review
#   fleet-dispatch trainee-reject SLUG --why TEXT  send a trainee's row back to the normal queue, on claude
#   fleet-dispatch validate SLUG --pr OWNER/REPO#N --head SHA --why TEXT  queue a second agent's review of an item's critical PR (agent-land)
#   fleet-dispatch trainee-rollup [--dry]  each trainee reject cause seen DISPATCH_ROLLUP_MIN times in DISPATCH_ROLLUP_DAYS: one fix row on the board, joined night to night by its cause (nightly-measure runs it)
#   fleet-dispatch direct-land SLUG [--rc N]  a direct run's tail, in its worktree: a clean run's diff committed, a PR opened and landed on CI
#   fleet-dispatch start --project P [--profile X] [--agent] [--model M] [--harness H]
#       (--item SLUG | --brief FILE --row KEY [--mode plan] [--now] [--cwd REPO]
#        | --resume ID --session NAME --cwd DIR [--server S] [--window NAME] [--item SLUG] [--prompt TEXT])
#       [--host W]                   start ONE session the way every agent must: see cmd_start
#   fleet-dispatch hosts [--json]    who holds the fleet lease; each fleet worker: placed or not, run units, load, and why it takes no session; then (text only) each project with queued light items no worker can take, and why
#   fleet-dispatch harness-ready H...  each headless harness this machine runs as a fleet worker, else "H: why" (probe_hosts asks it on each worker)
#   fleet-dispatch kit                 the launchers this machine runs a fleet session on (claude, codex, opencode, agy) and srt when it can hold a run (probe_hosts and start --host ask it on each worker)
#   fleet-dispatch lane-sandbox CWD    a claude session's lane sandbox env, then its --settings flags, built here under DISPATCH_SANDBOX_PROFILE (start --host asks it on the worker)
#   fleet-dispatch harness-prep H SID CWD  make a sandboxed run's config_dir, run dir and srt settings here; prints "config<TAB>run dir<TAB>config_dir" (start --host asks it on the worker)
#   fleet-dispatch trainee-patch SLUG   the base, one line, then the patch a trainee run left here (a dispatcher fetches it from the worker)
#   fleet-dispatch run-result SLUG      one line on what a headless run left (patch files and lines, else PR, note or state), for its replay's agent-panel row
#   fleet-dispatch item-end H SID...   why the H run that claimed those ids ended, from this machine's record (a dispatcher asks the worker it ran on)
#   (run, kick, reap, start, fill, promote, pull-after and exits do nothing on a machine that does not hold the fleet lease: lease_guard)
#   fleet-dispatch record [--here]   keep each world's pane record, then (on the lease holder) each fleet worker's; page when a world's server died
#   fleet-dispatch restore [--server S] [--dry-run] [--here]  reopen a lost server's conversations as windows, here and (on the lease holder) on each fleet worker; one a queue item prompts wakes in a batch of the wake budget (wake-pace.sh), the rest under the `restore` hold
#
# A pass walks the workers in workers.json in file order, and a row goes to the first that may
# take it: `#worker/<name>` plus a `#tier/N` within its max_tier (tier meanings: policy.md), and
# inside its `lane` and `only_tag` when it names them. Which projects dispatch is their stage
# (dispatchable) less DISPATCH_OFF_PROJECTS (off_project), never a list per worker. A worker marked `untagged`
# takes rows with no `#worker` tag instead, and with no `#tier` tag the judge's reading decides.
# The human assigns `fleet` rows; agents may assign `requested` rows, which must carry `#requested`.
# The queue comes first, and the board tops it up while fewer than DISPATCH_LOW_WATER items are runnable.
# A board item starts under the same gates as any queue item, the human here or away.
# Facts are code; the judgment (is this row clear, agent-only, in one area and really that tier?)
# is one model call per pass against policy.md, cached per row in verdicts.jsonl until the
# row's judged text changes (row_sig) or its rule leaves the policy (a policy edit only dates it; a changed rule gets a new id). A picked row is started on its sheet and added
# to agent-queue under its id, at its own priority (`from: board:<project>:<id>`); its item gets a detached `wt new` session on the agent world
# running its kind's entry skill (kinds.json; /one-shot for code), tagged @dispatch; the item records that session. Pause: `agent-hold set dispatch`.
# `start` is that same launch for a session an agent starts by hand or restores after a reboot.
# Tier 3 runs unattended through one gate in every project (policy.md "Tier"): a tier-3 row (t3_rows)
# merges at any hour behind the red-fix gate, which agent-land checks on the item (item_tier). The
# human-merge list (DISPATCH_T3_SKIP) never starts.
# Tuning is the DISPATCH_* block, set in the agentctl conf.

set -uo pipefail

# The agentctl conf is the one home of the DISPATCH_* tuning, each key with its value and why. The
# runner exports it; a run from a shell (headroom, a hand start) reads it here, so both see the limits
# the timer pass uses. A value already in the environment wins (the runner, tests). The code holds no
# default for any of DISPATCH_CONF_KEYS: a conf that is missing, did not parse or lost a key exits 78
# naming each missing key, where a silent default would run a different fleet (plan
# pasted-content-id-62f7-no-synthetic-lark P3). What stays below is mechanism: paths, test seams, the
# matching vocabulary the judge policy names, and switches whose empty value is off.
: "${DISPATCH_CONF:=$HOME/.config/agentctl/agents/fleet-dispatch.conf}"
DISPATCH_CONF_KEYS=(
  DISPATCH_PROFILES DISPATCH_PER_PASS DISPATCH_LOW_WATER DISPATCH_ORPHAN_HOURS
  DISPATCH_TARGET_PRESENT DISPATCH_TARGET_AWAY DISPATCH_STATE_FRESH_MIN DISPATCH_MAX_LOAD
  DISPATCH_HOST_MEM_MIN_PCT DISPATCH_START_LOAD DISPATCH_START_LOAD_MIN
  DISPATCH_RED_FLOOR DISPATCH_PLAN_LOAD_FLOOR DISPATCH_FIX_TRIES DISPATCH_TRAINEE_REVIEW_HOURS
  DISPATCH_FLEET_SHARE DISPATCH_FLEET_SHARE_H
  DISPATCH_ROLLUP_DAYS DISPATCH_ROLLUP_MIN DISPATCH_ROLLUP_BOARD
  DISPATCH_ROLLUP_TAGS DISPATCH_PROVIDER_HOLD_MIN
  DISPATCH_SPRINT_FLOOR DISPATCH_RUN_FLOOR DISPATCH_STARVED_MIN
  DISPATCH_IDLE_CAP_PCT DISPATCH_FLAP_MOVES DISPATCH_FINDING_FRESH_MIN DISPATCH_JUDGE_MAX
  DISPATCH_DETAIL_CHARS DISPATCH_PLAN_BACKLOG DISPATCH_EXIT_MAX DISPATCH_START_WAIT
  DISPATCH_REAP_GRACE DISPATCH_REAP_CONFIRM DISPATCH_HOST_DEAD DISPATCH_PREEMPT
  DISPATCH_OFF_PROJECTS DISPATCH_CLEANUP_PROJECTS
  DISPATCH_ASK_FRESH_H DISPATCH_PREEMPT_REST DISPATCH_PLAN_RECONCILE
  DISPATCH_EPIC_VERIFY DISPATCH_LANE_FLOOR DISPATCH_CANARY_KEEP
)
# dispatch_conf_load -- set each DISPATCH_* the conf names that the environment does not, then exit 78
# (EX_CONFIG) when any of DISPATCH_CONF_KEYS is still unset
dispatch_conf_load() {
  local k v missing=()
  while IFS='=' read -r k v; do
    [ -n "${!k+x}" ] || printf -v "$k" '%s' "$v"
  done < <(sed -n "s/^\(DISPATCH_[A-Z0-9_]*\)=[\"']\{0,1\}\([^\"']*\)[\"']\{0,1\}[[:space:]]*$/\1=\2/p" "$DISPATCH_CONF" 2>/dev/null)
  for k in "${DISPATCH_CONF_KEYS[@]}"; do [ -n "${!k+x}" ] || missing+=("$k"); done
  [ "${#missing[@]}" -eq 0 ] && return 0
  printf 'fleet-dispatch: %s does not set %s (each a bare KEY=VALUE line, no trailing comment); that conf is the one home of the dispatch tuning and the code holds no default\n' \
    "$DISPATCH_CONF" "${missing[*]}" >&2
  exit 78
}
# The verbs a worker runs for the dispatching machine (probe_hosts, start --host, on_workers) are
# mechanism, and a worker carries no private overlay, so they load no conf. One that read a tuning key
# would still stop loud: an unbound variable under set -u.
case "$([ "${BASH_SOURCE[0]}" = "$0" ] && echo "${1:-} ${2:-}")" in
  "kit "* | "harness-ready "* | "lane-sandbox "* | "harness-prep "* | "trainee-patch "* | "item-end "* | "record --here" | "restore --here") DISPATCH_WORKER_VERB=1 ;;
  *) DISPATCH_WORKER_VERB=''; dispatch_conf_load ;;
esac

: "${FLEET_STATE_FILE:=${XDG_STATE_HOME:-$HOME/.local/state}/fleet/state.json}"
: "${DISPATCH_PROC_STAT:=/proc/stat}"   # the CPU busy the load pace reads (cpu_busy)
: "${DISPATCH_CPU_SAMPLES:=$HOME/.cache/fleet-dispatch/cpu-samples}"   # this machine's, never ~/.agent, which syncs: the minute record's /proc/stat samples (cpu_sample)
: "${DISPATCH_TRAINEE_REPOS:=$HOME/.dotfiles}"   # the checkouts a trainee may work in, space-separated: its provider is a free one that sees the row and the repo, so public repos only (trainee_public_why)
: "${PLANNED_REBOOT_WINDOW_S:=1800}"   # a lost server this soon after a planned reboot's boot does not page (planned_reboot)
# The first message restore types into a reopened conversation whose queue item is running (each %s: the
# item), so it carries on without a nudge: on 2026-11-16 restored sessions sat idle until the human
# nudged each one.
: "${RESTORE_PROMPT:=fleet-dispatch restore reopened this session after its tmux server was lost (a crash or reboot). Carry on with queue item %s from where you stopped; first check what changed while you were down (git status, your PR, agent-queue show %s).}"
: "${DISPATCH_JUDGE_CMD:=agentctl-run --agent dispatch-judge}"
# Projects whose work runs on the home cluster: only their items wait while the k3s domain is red or
# unreadable (cluster_item, pick_item). On 2026-11-23 a failing cluster-janitor watch turned it red twice for 15
# minutes and the machine-wide gate held every start, Unity included.
: "${DISPATCH_CLUSTER_PROJECTS:=home-config}"
: "${DISPATCH_PLAN_RULES:=unclear bundle too-big multi-area stage-scope question tier-above unknown}"   # policy rules whose skip sends an agent row to inbox-plan (skip_exits)
: "${DISPATCH_HUMAN_RULES:=needs-person release prod-write compliance personal design}"   # policy rules whose skip moves an agent row to the human sheet or improvements.md (skip_exits)
# The judge's policy is its agent conf's PROMPT (agentctl-run puts it ahead of the rows); read
# here so a policy edit re-judges rows (policy_sig), and for the rule ids a verdict may name.
: "${DISPATCH_POLICY:=$(. "${AGENTCTL_CONF_DIR:-$HOME/.config/agentctl/agents}/dispatch-judge.conf" 2>/dev/null; printf '%s' "${PROMPT:-}")}"
# Its reply shape is the conf's SCHEMA; each call holds it to exactly the rows it sends (judge).
: "${DISPATCH_SCHEMA:=$(. "${AGENTCTL_CONF_DIR:-$HOME/.config/agentctl/agents}/dispatch-judge.conf" 2>/dev/null; printf '%s' "${SCHEMA:-}")}"
HERE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
# shellcheck source=../lib/judge.sh
. "$HERE/../lib/judge.sh"
# shellcheck source=../src/agent-run/lib/sandbox.sh
. "$HERE/../src/agent-run/lib/sandbox.sh"
# The fleet worker roster (home-config's `fleet_workers` group) and the one ssh path to a worker.
# shellcheck source=../lib/fleet-hosts.sh
. "${FLEET_HOSTS_LIB:-$HERE/../lib/fleet-hosts.sh}"
: "${DISPATCH_WORKERS:=$HOME/.config/fleet-dispatch/workers.json}"
: "${DISPATCH_KINDS:=$HOME/.config/fleet-dispatch/kinds.json}"   # per row type: rank, entry, rung, exit, enabled (load_kinds)
: "${DISPATCH_CLASSES:=$HOME/.config/fleet-dispatch/classes.json}"   # its `idle_pool` knob: the pools whose idle slots rank rows (load_pool_idle)
: "${DISPATCH_LOADAVG:=/proc/loadavg}"
: "${DISPATCH_SANDBOX_PROFILE:=}"   # a lane sandbox profile (agent-run docs/contract.md "Lane sandbox") every claude start runs under; empty is off, and a start that cannot hold the profile is refused (lane_sandbox)
: "${DISPATCH_SANDBOX_GH_TOKEN_FILE:=}"   # the sandboxed session's own repo-scoped GitHub token file, as GH_TOKEN_FILE is for a runner; empty gives it no token
: "${PARKED_DIR:=${CLAUDE_ACCT_PARKED_DIR:-$HOME/.agent/parked}}"   # claude-acct park: a parked pane is never reaped and holds no run unit
# The machine-mode level scales the limits that bind starts; the conf holds the mid numbers.
# Scaled into names of their own, never back into the exported DISPATCH_* a child would scale again.
# shellcheck source=../lib/machine-mode.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/machine-mode.sh"
# shellcheck source=../lib/end-reasons.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/end-reasons.sh"
# shellcheck source=../lib/wake-pace.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/wake-pace.sh"
LEVEL=$(machine_level)
[ -n "$DISPATCH_WORKER_VERB" ] || read -r PER_PASS MAX_LOAD < <(level_scale DISPATCH_PER_PASS "$DISPATCH_PER_PASS" DISPATCH_MAX_LOAD "$DISPATCH_MAX_LOAD")
# Tier-3 rows fill never promotes, whatever the judge says (decide rows and the release kind are off in
# kinds.json): the human-merge list, release cuts, secrets and auth and production data migrations (ask BwiKfB, 2026-11-21), plus
# money (the go hard gate), anything needing a device or the human's own machine, and wishes. Case-insensitive ERE.
: "${DISPATCH_T3_SKIP:=\b(device|pads?|headset|playtest)\b|\b(waybar|hypr[a-z]*|ananicy|sysctl|sudo|wi-?fi)\b|\b(secrets?|passwords?|credentials?|rbw|sops|o?auth(entication|enticate|orization|orize|n|z)?[0-9]*|(api|access|signing|ssh|deploy) (keys?|tokens?))\b|\b(bank(ing)?|payments?|billing)\b|\b(prod|production|dns)\b|\b(data|schema|database|db) migrations?\b|\bmigrate (the )?(data|database|db|schema)\b|\brelease cuts?\b|\bcut (a |the )?release\b|would be cool|should i\b|\bmaybe\b|\bideally\b|investigate whether}"
# Observer rows: an improvement row (`#kpi/<k>`, filed by `fleet-bench improve`) or a typed finding
# retro and triage file. jq (Oniguruma) regex, matched case-insensitively against the row body.
: "${DISPATCH_T3_OBSERVER:=#kpi/|^[a-z]+\((kpi|lesson|watch|runner|unit|logs)\):}"
# A row that touches what policy.md's tier 3 calls shared infrastructure is never cleanup, whatever
# its kind: a `chore(deps): bump X` or a `fix: the deploy step` is an upgrade or a pipeline change,
# not a deletion, so it does not rank as cleanup (review of #1222, 2026-11-06). Matched case-blind.
: "${DISPATCH_CLEANUP_NOT:=\b(deps?|dependenc(y|ies)|bump(s|ed)?|pin(s|ned)?|upgrade[sd]?|version|migrat(e|es|ion|ions)|schema|deploy(s|ment)?|release|ci|workflows?)\b}"
DIR="${FLEET_DISPATCH_DIR:-$HOME/.agent/dispatch}"
VERDICTS="$DIR/verdicts.jsonl"
AQ_EX_FINISHED=4   # agent-queue add's exit when the slug's item already finished ok (its finished_ok)
AQ_EX_HELD=5       # agent-queue add's exit when the cap held an add (its admit)
LOG="$DIR/log.md"
CODEX_SESSIONS="${DISPATCH_CODEX_SESSIONS:-$HOME/.codex/sessions}"             # Codex's rollouts, where item_end reads why a run ended
DISPATCH_PROC="${DISPATCH_PROC:-/proc}"                                          # where codex_run_live reads a run's environment
CODEX_ROLLOUT_JQ="${DISPATCH_CODEX_ROLLOUT_JQ:-$HOME/.local/lib/codex-rollout.jq}"
OC_SESSION_JQ="${DISPATCH_OPENCODE_SESSION_JQ:-$HOME/.local/lib/opencode-session.jq}"
OC_DB="${DISPATCH_OPENCODE_DB:-$HOME/.local/share/opencode/opencode.db}"   # the shared opencode.db, where item_end reads why a go or nim run ended
NOTES_INGEST="${DISPATCH_NOTES_INGEST:-$HOME/.local/state/notes/ingest.jsonl}"   # notes' record of every row write, who and by which channel: where asker_map reads whose words a #requested row is
LANE_RUNS="${DISPATCH_LANE_RUNS:-$HOME/.agent/model-lane/runs.jsonl}"   # model-lane's run log: trainee_load reads which slugs a ladder run took, trainee-rollup its trainee reject reasons
AGY_RUNS="${DISPATCH_AGY_RUNS:-$HOME/.agent/agy/runs}"   # each agy run's log (agent-agy), srt settings and tmp: where item_end reads why it ended
AGY_RESULT_JQ="${DISPATCH_AGY_RESULT_JQ:-$HOME/.local/lib/agy-result.jq}"
HARNESSES="${DISPATCH_HARNESSES:-$HOME/.config/agentctl/harnesses.json}"   # the gateway harnesses: model map, timeout, key files
MATRIX="${BENCH_MATRIX:-$HOME/.config/fleet-bench/matrix.json}"   # fleet-bench's canary matrix: its `excluded` kinds with a match are the work route() keeps off a headless harness
HEADROOM="$DIR/headroom.json"   # the last real pass's `headroom --json`, which stats publishes
CANDIDATES="${FLEET_DISPATCH_STATE:-$HOME/.local/state/agentctl/dispatch}/candidates.jsonl"   # the last real pass's `suggest --json`, which the hub Candidates fold reads (hub_core::queue::candidates); derived, so out of the autocommitted ~/.agent
TRAINEE_DIR="${FLEET_DISPATCH_STATE:-$HOME/.local/state/agentctl/dispatch}/trainee"   # <slug>.patch and <slug>.base: the diff a trainee run left and its base, which a batch review applies (cmd_trainee_review, trainee_batch_start)
TRAINEE_DRY="${FLEET_DISPATCH_STATE:-$HOME/.local/state/agentctl/dispatch}/trainee-dry"   # <harness> TAB <epoch> a line: since when each trainee harness with a slot has found no queued or board row it takes (trainee_floor_start), which starved reads
PROVIDER_ENDS="${FLEET_DISPATCH_STATE:-$HOME/.local/state/agentctl/dispatch}/provider-ends.tsv"   # <slug>@<last session id> TAB <source> TAB <hold until epoch, 0 for a run that did not end on the provider>: each recent ended run provider_hold_scan classified, so a run's end is read once

# Tier 3 (CI, gates, runners, build and deploy, harness, tooling) never gets a merging session from a
# worker, whatever workers.json says: the human's decision of 2026-10-27, after a dispatched session
# spent 50 minutes on a `ci:` row. Raising this is a conversation, not a config edit. Tier 3 runs
# unattended only through its own gate (policy.md "Tier"): a red item and a tier-3 row of any project
# (t3_picks, in day_picks) merge behind the red-fix gate, which agent-land enforces.
UNATTENDED_TIER_CEILING=2
LANE_CACHE="$DIR/lane-cache"   # <day> TAB <slug> TAB <verdict json>: the verdict of an item no source could take, for the rest of the day
unset TRAINEE_GATE    # set only by trainee_floor_why, never inherited
NO_ROUTE=()   # this pass's "<slug> (<why>)" for items no source with room could take; NO_ROOM, the account reason

say() { printf 'fleet-dispatch: %s\n' "$*" >&2; }
logline() { mkdir -p "$DIR"; printf -- '- %s %s\n' "$(date '+%Y-%m-%d %H:%M')" "$*" >> "$LOG"; }

# --- facts ---------------------------------------------------------------------------

# stage_of <listed path> -> the project's stage, read by the shared head-tag reader against the one
# ladder (`notes projects --stages`), never a private copy of either. The path is the one
# `notes projects` lists, which is summary.md where the profile's index links the summary (bnb);
# the tags live on the front page (`lab_front_page`, notes' `front_page`), so read that.
# shellcheck source=../lib/lab-feed.sh
. "${LAB_FEED_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/lab-feed.sh}"
# Read once at load, since stage_of runs in subshells; `item-tier`, one queue item's read for
# agent-land, needs no ladder, so it skips the notes call.
[ "${BASH_SOURCE[0]}" = "$0" ] && [ "${1:-}" = item-tier ] || LAB_STAGES="${LAB_STAGES:-$(notes projects --stages 2>/dev/null || true)}"
stage_of() {
  [ -n "$LAB_STAGES" ] || { say "notes projects --stages printed nothing: no project stage can be read"; return 1; }
  local page
  page=$(lab_front_page "$(dirname "$1")") || return 1
  # shellcheck disable=SC2086 # the ladder is a word list on purpose
  lab_head_tag "$page" $LAB_STAGES
}

# dispatchable <stage>: agents build from dev on; a draft is still a concept, and no stage is
# a question for the human, so neither gets a session.
dispatchable() { lab_stage_at_least "$1" dev; }

# off_project <project> -> why the project dispatches nothing whatever its stage, nothing when it may:
# it is on DISPATCH_OFF_PROJECTS. candidates, t3_rows, take_epic and covered read it; the one off list.
off_project() {
  [[ " $DISPATCH_OFF_PROJECTS " != *" $1 "* ]] || echo "no worker covers $1: it is on DISPATCH_OFF_PROJECTS, so its rows stay with the human"
}

# Each row helper a board walk (cmd_candidates, t3_rows) calls once a row has a `_set` form that sets a
# global, as tag_of sets TAG, and the plain form prints it. A walk calls the `_set` form, so a row costs
# no fork: a fat process forking about 37 subshells a row held a dispatch pass at 10 to 17 min of CPU
# (ar-4512).

# prio_rank <text> -> 0 urgent, 1 high, 3 low; prio_rank_set sets PRIO.
prio_rank_set() {
  case "$1" in
    *'#urgent'*) PRIO=0 ;;
    *'#high'*) PRIO=1 ;;
    *'#low'*) PRIO=3 ;;
    *) PRIO=1 ;;   # a bare row is high: the row grammar's default, and the queue priority it gets
  esac
}
prio_rank() { prio_rank_set "$1"; echo "$PRIO"; }

# load_prios -- PRIO_BY[<project>]: focus|high|low, as `notes projects --prios` reads the `#prio/<word>` the
# human set (`notes projects --prio`), read once per process; a normal project has no key. notes is the one
# reader of the tag: a focus past its `Focus until:` reads as high there, so no focus outlives its hours.
# A failed read leaves every project normal, the safe default: it ranks them all the same.
load_prios() {
  declare -p PRIO_BY >/dev/null 2>&1 && return 0
  declare -gA PRIO_BY=()
  local n p
  while IFS=$'\t' read -r n p _; do
    [ -z "$n" ] || PRIO_BY[$n]=$p
  done < <(notes projects --prios 2>/dev/null)
}

# The one rank every caller sorts by (the judge's cap, picks, fill --dry-run): a row an open sprint holds
# (`sprint` 0, row_sprint), its committed rows before the open version's rows it did not commit (`uncommitted`
# 1, UNCOMMITTED, row_sprint_set), then cleanup of an AI system (cleanup_row), then the project's #prio, then, while
# any row's repo gates on an idle pool (`pool_idle`, load_pool_idle), the head of the feed rank (frank's
# millions: due bucket, priority, #requested, notes-cli Rank::key) and then such a row (pool_term, a
# tie-breaker below every human rank and above age; with no pool idle it orders nothing), then the row's
# feed rank (`frank`, the `rank` of
# `notes board --json`: due date, priority, #requested, then oldest, notes-cli src/rank.rs, so the
# order within a project is the board's own and dispatch derives none of it; a row the feed does not
# rank goes after every ranked one), then worker order, then its kind (kinds.json `rank`: a bug
# first), then stage.
# rank_fields adds the counted inputs and a `why` naming them, so the order explains itself; `why` only
# explains the feed's rank, it does not decide it. A row aimed at its project's Target: version carries
# the feed's `release_due`, which the rank read as its due date when sooner, so the why says "release due".
# Dates are this year's MMDD:
# a due date half a year back is next year's, a created date in the future is last year's.
# shellcheck disable=SC2016
RANK_JQ='
def day0($s): "\($s)T00:00:00Z" | fromdateiso8601;
def offset($x; $today): if $x == null then null
  else (try (((day0("\($today[0:4])-\($x.m)-\($x.d)") - day0($today)) / 86400) | floor) catch null) end;
def tagdate($b; $tag): [$b | capture("(^|\\s)#" + $tag + "(?<m>[01][0-9])(?<d>[0-3][0-9])(\\s|$)")] | first;
def rank_fields($today; $pprio):
  ((.text // "") | split("<!--")[0] // "") as $b
  | (offset(tagdate($b; "due"); $today) | if . != null and . < -180 then . + 365 else . end) as $own
  | (if .release_due == null then null
     else (try (((day0(.release_due) - day0($today)) / 86400) | floor) catch null) end) as $rd
  | ([$own, $rd] | map(select(. != null)) | min) as $dd
  | (if $rd != null and ($own == null or $rd < $own) then "release " else "" end) as $rel
  | (offset(tagdate($b; "c"); $today) | if . != null and . > 0 then . - 365 else . end) as $cd
  | . + {pprio: ({"focus": 0, "high": 1, "low": 3}[$pprio] // 2),
         due: (if $dd == null then 3 elif $dd < 0 then 0 elif $dd == 0 then 1 elif $dd <= 3 then 2 else 3 end),
         due_in: $dd, age: (if $cd == null then 0 else -$cd end),
         req: (if $b | test("(^|\\s)#requested(\\s|$)") then 0 else 1 end)}
  | . + {why: ([(if .sprint != 0 then empty elif (.uncommitted // 0) == 1 then "open sprint, uncommitted" else "open sprint" end),
                (if .cleanup == 0 then "cleanup" else empty end),
                (if $pprio != "" then "\($pprio) project" else empty end),
                (if (.pool_idle // "") != "" then "idle pool \(.pool_idle)" else empty end),
                (if .due_in == null or .due_in > 3 then empty elif .due_in < 0 then "\($rel)overdue \(-.due_in)d"
                 elif .due_in == 0 then "\($rel)due today" else "\($rel)due in \(.due_in)d" end),
                (if .req == 0 then "requested" else empty end),
                (if (.worker // "") != "" then .worker else empty end),
                ({"0": "#urgent", "1": "#high", "3": "#low"}[(.prio | tostring)] // empty),
                (.klabel // "" | select(. != "")),
                .stage,
                (if .age > 0 then "\(.age)d old" else empty end)] | join(", "))};
# area_key: the area picks holds one row to; a gated row has no verdict to name one, so it is its own,
# and so is a tier-3 row (worker tier3, t3_picks): no area holds one.
def area_key: if (.area // "") == "" or .worker == "tier3" then "row:\(.key)" else .area end;
def pool_term($pi): if $pi then [((.frank // 1e15) / 1000000 | floor), (if (.pool_idle // "") != "" then 0 else 1 end)] else [] end;
def rank: any(.[]; (.pool_idle // "") != "") as $pi
  | sort_by((.sprint // 1), (.uncommitted // 0), (.cleanup // 1), (.pprio // 2), pool_term($pi), (.frank // 1e15), (.wrank // 0), (.krank // 1), ({"prod": 0, "beta": 1}[.stage] // 2), (.t3rank // []));
'

# repo_dir <project> -> the checkout its code lives in; nothing for a notes-only project.
# The registry's own resolver (project-name.sh), reading DISPATCH_PROJECT_MAP.
# shellcheck source=../../.config/shared-hooks/project-name.sh
. "${PROJECT_NAME_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../../.config/shared-hooks/project-name.sh}"
: "${DISPATCH_PROJECT_MAP:=$(project_map_file)}"
# shellcheck source=../lib/plan-phases.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/plan-phases.sh"
repo_dir() { PROJECT_MAP_FILE="$DISPATCH_PROJECT_MAP" project_repo_path "$1"; }
# pr_repo_dir <pr ref> <project> -> the checkout an item's PR merged into (so_pr_dir, on dispatch's map).
pr_repo_dir() { PROJECT_MAP_FILE="$DISPATCH_PROJECT_MAP" so_pr_dir "$@"; }
# shellcheck source=../lib/session-outcomes.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/session-outcomes.sh"   # forge_canonical (origin-repo.sh), so_forgejo_*
# shellcheck source=../lib/agent-merge-proof.sh
. "${MERGE_PROOF_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/agent-merge-proof.sh}"
# shellcheck source=../lib/pr-ci.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/pr-ci.sh"
# shellcheck source=../lib/harness-projects.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/harness-projects.sh"   # harness_project_why: route, gateway_launch
# shellcheck source=../lib/chain-event.sh
. "${CHAIN_EVENT_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/chain-event.sh}"
# dispatch_event <action> <project> <text> [record flags...] -> this runner's start, reap or
# settle on the chain log; it has no queue item or session of its own, so it names itself.
dispatch_event() { chain_event dispatch "$@" --by fleet-dispatch; }

# tag_of <text> <namespace> -> sets TAG to the value of the row's first `#<namespace>/<value>` tag,
# or empty. Only the text before a `<!--` marker counts: a tag inside a proof stamp is record, not
# routing. It sets a global, with no fork: the board walks read several tags a row (ar-3988).
tag_of() {
  local body=" ${1%%<!--*}" re="[[:space:]]#$2/([A-Za-z0-9_.-]+)"
  TAG=''
  [[ "$body" =~ $re ]] && TAG=${BASH_REMATCH[1]}
  return 0
}

# row_tier <text> -> 1|2|3, or nothing when the row carries no tier. A row typed or scoped ci
# or infra (`ci:`, `ci(area):`, `fix(ci):`) is tier 3 however it is tagged. row_tier_set sets TIER
# (empty, rc 1, for none).
row_tier_set() {
  local body="${1#- \[?\] }"
  TIER=''
  case "${body,,}" in ci:* | ci\(* | infra:* | infra\(* | *\(ci\):* | *\(infra\):*) TIER=3; return 0 ;; esac
  tag_of "$1" tier
  case "$TAG" in 1 | 2 | 3) TIER=$TAG ;; *) return 1 ;; esac
}
row_tier() { row_tier_set "$1" || return 1; echo "$TIER"; }

# The kind registry, kinds.json, is keyed by notes-cli's ROW_TYPES (a bats test pins the two): per
# type its `rank` within a priority, the `label` why names, the `entry` skill a session starts on,
# its autonomy `rung` (build, propose, human), its `exit` (pr, doc+ask, proof), `enabled`, and
# `cleanup`: true when a row of that kind in a
# DISPATCH_CLEANUP_PROJECTS project is cleanup, or an ERE its body must match too (cleanup_row). A
# kind that is off never dispatches a row: the `release` kind is off, since no row starts a cut
# (ucp-2709 P15). A row with no type, or one the registry lacks, ranks 1, is not cleanup, dispatches
# and starts /one-shot; with no registry every kind does.
declare -gA KIND_RANK=() KIND_LABEL=() KIND_ENTRY=() KIND_ON=() KIND_EXIT=() KIND_CLEANUP=()
KINDS_LOADED=0
load_kinds() {
  local k r l e on x c
  [ "$KINDS_LOADED" = 1 ] && return 0
  KINDS_LOADED=1
  [ -r "$DISPATCH_KINDS" ] || { say "no kind registry at $DISPATCH_KINDS: every kind ranks alike and dispatches"; return 0; }
  # "-" stands for empty, because read collapses empty tab fields; join, not @tsv, so a cleanup
  # pattern keeps its backslashes.
  while IFS=$'\t' read -r k r l e on x c; do
    KIND_RANK[$k]=$r KIND_LABEL[$k]=${l#-} KIND_ENTRY[$k]=${e#-} KIND_ON[$k]=$on KIND_EXIT[$k]=${x#-}
    KIND_CLEANUP[$k]=${c#-}
  done < <(jq -r 'def d: if . == "" then "-" else . end;
    to_entries[] | [.key, (.value.rank // 1), (.value.label // "" | d), (.value.entry // "" | d), (.value.enabled // false),
      (.value.exit // "" | d),
      (.value.cleanup // false | if . == true then "true" elif type == "string" then d else "-" end)]
    | map(tostring | gsub("[\t\n]"; " ")) | join("\t")' "$DISPATCH_KINDS")
}

# row_kind <text> -> the row's type, from the grammar's one home (`notes row parse`); nothing for a
# bare or unknown row. ROW_KIND holds the rows a pass has loaded (row_kinds_load), so a lookup in a
# lookup costs no parse; a row not in it is parsed on the spot, and kept. row_kind_set sets KIND.
declare -gA ROW_KIND=()
# The board extras' names (load_extras): a walk takes them as loaded when one is declared (trainee_rows), so none comes in from the environment.
unset DET PLN PAR RNK GAT RLD
row_kind_set() {
  KIND=''
  [ -n "$1" ] || return 0
  if [ -n "${ROW_KIND[$1]+x}" ]; then KIND=${ROW_KIND[$1]}
  elif KIND=$(printf '%s\n' "${1//$'\n'/ }" | notes row parse 2>/dev/null | cut -f1); then ROW_KIND[$1]=$KIND
  else KIND=''
  fi
  [ "$KIND" != - ] || KIND=''
  return 0
}
row_kind() { row_kind_set "$1"; [ -z "$KIND" ] || printf '%s\n' "$KIND"; }

# row_kinds_load -- the `key TAB text` lines of `rows` on stdin: every text's type into ROW_KIND with
# one `notes row parse`, which answers a line per line. A parse that fails or answers short loads
# nothing and says so, and row_kind then parses row by row.
row_kinds_load() {
  local -a texts=() types=()
  local key text i
  while IFS=$'\t' read -r key text; do [ -n "$text" ] && texts+=("$text"); done
  [ ${#texts[@]} -gt 0 ] || return 0
  mapfile -t types < <(printf '%s\n' "${texts[@]}" | notes row parse 2>/dev/null | cut -f1)
  if [ ${#types[@]} -ne ${#texts[@]} ]; then
    say "notes row parse failed or answered short (an old notes? notes-bootstrap --build-only)"
    return 0
  fi
  for i in "${!texts[@]}"; do ROW_KIND[${texts[$i]}]=${types[$i]}; done
}

# kind_off <kind> -> why the registry keeps a row of that kind from dispatching, nothing when it may:
# the kind is off. The project's stage is dispatchable's to read, once. kind_off_set sets KIND_OFF.
kind_off_set() {
  local k="$1"
  KIND_OFF=''
  [ -n "$k" ] && [ -n "${KIND_ON[$k]+x}" ] || return 0
  [ "${KIND_ON[$k]}" = true ] || KIND_OFF="kind $k is off"
}
kind_off() { kind_off_set "$1"; [ -z "$KIND_OFF" ] || echo "$KIND_OFF"; }

# row_size_set <text> -> sets SIZE to S, M, L or XL from the row's `#size/` tag, '' when it has none: the one
# size a sized row has. The judge sizes only the rest (size_back writes its answer onto the row).
row_size_set() { tag_of "$1" size; SIZE=''; case "${TAG,,}" in s | m | l | xl) SIZE=${TAG^^} ;; esac; }

# workers -> one line per worker in registry order: rank, name, max tier capped at the ceiling,
# only_tag, lane, untagged. "-" stands for empty, because read collapses empty tab fields.
workers() {
  jq -r --argjson c "$UNATTENDED_TIER_CEILING" 'to_entries | to_entries[] | .key as $rank | .value
    | [$rank, .key, ([.value.max_tier // 0, $c] | min | floor),
       (.value.only_tag // "-"), (.value.lane // "-"), (.value.untagged // false)] | @tsv' \
    "$DISPATCH_WORKERS" 2>/dev/null
}

# row_worker <workers> <lane> <row text> -> sets W_RANK, W_NAME and W_TIER for the first worker
# that may take the row, rc 1 when none may. A row with no tier tag counts as the highest tier
# an untagged worker takes, and the judge must read it no higher.
row_worker() {
  local lane="$2" text="$3" tag row_t t rank name max only wlane untagged
  tag_of "$text" worker; tag=$TAG
  row_tier_set "$text"; row_t=$TIER
  while IFS=$'\t' read -r rank name max only wlane untagged; do
    if [ "$untagged" = true ]; then [ -z "$tag" ] || continue; else [ "$tag" = "$name" ] || continue; fi
    [ "$only" = - ] || [[ " $text " == *" #$only "* ]] || continue
    [ "$wlane" = - ] || [ "$wlane" = "$lane" ] || continue
    t=$row_t
    [ -n "$t" ] || [ "$untagged" != true ] || t=$max
    [ -n "$t" ] && [ "$t" -le "$max" ] || continue
    W_RANK=$rank W_NAME=$name W_TIER=$t
    return 0
  done <<<"$1"
  return 1
}

# re_icase <text> <ERE> -> 0 when the ERE matches the one-line text case-blind, as `grep -qiE` does, with
# no fork: bash's =~ is the same glibc regex, \b included. A board walk asked grep 8,400 times a pass (ar-4911).
re_icase() { local r on=; shopt -q nocasematch && on=1; shopt -s nocasematch; [[ $1 =~ $2 ]]; r=$?; [ -n "$on" ] || shopt -u nocasematch; return "$r"; }

# A board walk's rows as records, a row's fields split by ROW_US and each row ended by ROW_RS (no row
# text holds either), so one jq a board builds every row's object: rows_recs(f) runs f on each row's
# field array. A row f fails on is named on stderr and left out, as its own jq call left it out.
ROW_US=$'\x1f' ROW_RS=$'\x1e'
ROW_RECS_JQ='def rows_recs(f): split("\u001e")[:-1][] | split("\u001f") | . as $r | try f catch ("fleet-dispatch: board row \($r[0]) left out: \(.)\n" | stderr | empty);'

# cleanup_row <project> <row text> -> 0 when the row cleans up an AI system: its project is in
# DISPATCH_CLEANUP_PROJECTS and its kind is cleanup in kinds.json (KIND_CLEANUP: true, or a pattern
# the body matches too) and the body names no shared infrastructure (DISPATCH_CLEANUP_NOT), else 1.
# RANK_JQ's `cleanup`; the one source. cleanup_row_set sets CLEANUP.
cleanup_row_set() {
  local body="${2%%<!--*}" c
  CLEANUP=1
  [[ " $DISPATCH_CLEANUP_PROJECTS " == *" $1 "* ]] || return 0
  load_kinds
  row_kind_set "$2"
  c=${KIND_CLEANUP[${KIND:-_}]:-}
  body=${body#- \[?\] }
  if { [ "$c" = true ] || { [ -n "$c" ] && re_icase "$body" "$c"; }; } && ! re_icase "$body" "$DISPATCH_CLEANUP_NOT"; then CLEANUP=0; fi
  return 0
}
cleanup_row() { cleanup_row_set "$@"; echo "$CLEANUP"; }

# untagged_reads <workers> <lane> -> 0 when an untagged worker reads the lane (its own, or every lane), else 1.
untagged_reads() {
  local rank name max only wlane untagged
  while IFS=$'\t' read -r rank name max only wlane untagged; do
    [ "$untagged" = true ] && { [ "$wlane" = - ] || [ "$wlane" = "$2" ]; } && return 0
  done <<<"$1"
  return 1
}

# nobody_why <workers> <lane> <row text> -> why no worker takes a row row_worker turned
# down, the first of: it is tier 3, or untiered where no untagged worker reads its lane, so the
# tier-3 gate takes it (t3_rows) unless a DISPATCH_T3_SKIP word keeps it with the human; no untagged
# worker reads its lane; its tier is past the unattended ceiling (a human-lane row); or its tags and
# tier fit none. A project off_project names never gets here: candidates gives that reason instead.
# nobody_why_set sets NOBODY.
nobody_why_set() {
  local lane="$2" text="$3" covers=0 t m
  ! untagged_reads "$1" "$lane" || covers=1
  row_tier_set "$text"; t=$TIER
  if [ "$lane" = agent ] && { [ "$t" = 3 ] || { [ -z "$t" ] && [ "$covers" = 0 ]; }; }; then
    m=$(grep -oiE -m1 -- "$DISPATCH_T3_SKIP" <<<"${text%%<!--*}" | awk 'NR==1')
    if [ -n "$m" ]; then NOBODY="tier3 skip: $m"
    elif [ "$t" = 3 ]; then NOBODY="tier3 only: the tier-3 gate takes it"
    else NOBODY="tier3 only: no day worker reads the $lane lane"; fi
    return 0
  fi
  if [ "$covers" = 0 ]; then NOBODY="no untagged worker reads the $lane lane"; return 0; fi
  if [ -n "$t" ] && [ "$t" -gt "$UNATTENDED_TIER_CEILING" ]; then NOBODY="tier $t: past the unattended ceiling"; return 0; fi
  NOBODY="no worker takes its tags or tier"
}
nobody_why() { nobody_why_set "$@"; echo "$NOBODY"; }

sig() { sha256sum | cut -c1-12; }

# SIG_OF[<string>]: its sig, as sig prints it, for the strings a board read hashed in one batch
# (sigs_load), so a walk's row_sig and detail_sig cost no fork; a string not in it is hashed on the spot.
declare -gA SIG_OF=()
# sigs_load <string>... -- their sigs into SIG_OF with one hasher process; a string with a newline is
# left to sig_set. A hasher that fails or answers short loads nothing, and sig_set then hashes string by string.
sigs_load() {
  local -a ss=() hs=()
  local s i
  for s in "$@"; do [ -n "$s" ] && [[ "$s" != *$'\n'* ]] && [ -z "${SIG_OF[$s]+x}" ] && ss+=("$s"); done
  [ ${#ss[@]} -gt 0 ] || return 0
  mapfile -t hs < <(printf '%s\n' "${ss[@]}" | python3 -c 'import hashlib, sys
for s in sys.stdin.buffer.read().split(b"\n")[:-1]: print(hashlib.sha256(s).hexdigest()[:12])' 2>/dev/null)
  [ ${#hs[@]} -eq ${#ss[@]} ] || return 0
  for i in "${!ss[@]}"; do SIG_OF[${ss[$i]}]=${hs[$i]}; done
}
# sig_set <string> -> sets SIG, the sig of the string: SIG_OF's, else hashed now.
sig_set() {
  if [ -n "$1" ] && [ -n "${SIG_OF[$1]+x}" ]; then SIG=${SIG_OF[$1]}; else SIG=$(printf '%s' "$1" | sig); fi
}

# row_sig <row text> -> a verdict's cache key: the sig of the text the judge rules on, whitespace
# squeezed. The trailing <!-- --> comment, #of/ links and the priority tags (#urgent #high #low) are
# left out: no verdict field reads them, and triage's --backlog --link and --priority passes add them
# to hundreds of rows at once. The type(area) prefix stays: area is judged. sig_text sets SIG_TEXT, the
# text it hashes; row_sig_set sets SIG.
sig_text() {
  local w o="" t=()
  read -ra t <<<"${1%%<!--*}"
  for w in "${t[@]+"${t[@]}"}"; do
    case "$w" in '#of/'*|'#urgent'|'#high'|'#low') ;; *) o+="${o:+ }$w" ;; esac
  done
  SIG_TEXT=$o
}
row_sig_set() { sig_text "$1"; sig_set "$SIG_TEXT"; }
row_sig() { row_sig_set "$1"; echo "$SIG"; }

# row_sigs_load -- the `key TAB text` lines of `rows` on stdin: every text's row_sig into SIG_OF, in one
# batch (sigs_load), as row_kinds_load loads their kinds.
row_sigs_load() {
  local key text
  local -a ts=()
  while IFS=$'\t' read -r key text; do [ -z "$text" ] || { sig_text "$text"; ts+=("$SIG_TEXT"); }; done
  sigs_load "${ts[@]+"${ts[@]}"}"
}

# policy_sig -> changes whenever the policy does. It dates a verdict (fresh or stale), it does not void
# one: an old verdict stays in force while the rule it names is in the policy (usable) and the row's
# line and details are unchanged, so it is not judged again. Re-judging every row after an edit spent
# the judge's whole day budget on 1,076 unchanged rows by 06:20 (2026-11-07), and new rows waited for
# the next day; a rule whose meaning changes gets a new id, which re-judges exactly its rows. Before
# that, voiding verdicts left 0 of 1,414 to pick from for 9 hours (#1222). The worker registry is not
# in it: picks re-reads workers.json and the tier ceiling on every pass.
policy_sig() { cat "$DISPATCH_POLICY" 2>/dev/null | sig; }

# policy_rules -> the policy's rule ids as a JSON array, for ROW_JQ's usable
policy_rules() { judge_rules "$DISPATCH_POLICY" | jq -Rsc 'split("\n") | map(select(length > 0))'; }

# Row facts from `notes board --json`, whose parser owns them. details_json: the row's detail lines
# as one JSON string, cut to DISPATCH_DETAIL_CHARS. planned: inbox-plan wrote it a `goal:`.
# holds($c): a verdict still covers candidate $c: its text is unchanged and, for a verdict that
# recorded one, so are its details. Verdicts from before details were read carry no dsig and hold
# on the text alone, so reading details did not re-judge the 547 held rows that already had some.
ROW_JQ='
def details_json($n): (.details // []) | join("\n") | .[0:$n] | tojson;
def planned: any(.details[]?; test("^goal:"; "i"));
def plan_tagged: any(.tags[]?; . == "plan");
def holds($c): .line == $c.line and (.dsig == null or .dsig == $c.dsig);
# usable($rs): a judged verdict (not error or failed) naming a rule the policy still defines, whatever policy it was made under
def usable($rs): (.verdict == "dispatch" or .verdict == "skip") and (.rule as $r | $rs | index($r) != null);
def eff_size($d): if (.row_size // "") != "" then .row_size else ($d.size // "") end;
# row_area($d; $games): the area a row holds: the first game of its project ($games, game_areas) its text
# names before the trailing comment, else the area verdict $d named, lowercased; "" with neither.
def row_area($d; $games): ((.text // "") | split("<!--") | .[0] // "" | ascii_downcase) as $t
  | (first(($games[.project] // [])[] | select(. as $g | $t | test("\\b\($g)\\b"))) // (if ($d.area | type) == "string" then $d.area | ascii_downcase else "" end));'

# detail_sig <details json> -> the dsig of a row's details; "none" for a row with none. detail_sig_set sets DSIG.
detail_sig_set() { if [ "$1" = '""' ]; then DSIG=none; else sig_set "$1"; DSIG=$SIG; fi; }
detail_sig() { detail_sig_set "$1"; echo "$DSIG"; }

# load_gates -- GATE_ST, GATE_WHY, GATE_Q and GATE_STACK by board gate tag: its state (clear, pending or dead),
# hold_for's words, its queue form, and the slug of the item an #after/ gate cleared as stacked on (its open PR), for every gate an open row carries, from one
# `agent-queue gate --json --all` (the one evaluator; it reads rbw and the board once). Once a pass:
# each entry point calls it before its subshells, as fleet_hosts, and load_extras when none did. A
# read that failed leaves GATES_FAILED, and then no board row starts (cmd_candidates, t3_rows): any
# row could carry a gate that is not clear.
load_gates() {
  [ -z "${GATES_LOADED:-}" ] || return 0
  declare -gA GATE_ST=() GATE_WHY=() GATE_Q=() GATE_STACK=()
  GATES_LOADED=1 GATES_FAILED=''
  local out rc=0 t s w q k
  out=$(agent-queue gate --json --all 2>/dev/null) || rc=$?
  if [ "$rc" != 0 ] && [ "$rc" != 3 ]; then
    GATES_FAILED="agent-queue gate --all failed (exit $rc)"
    say "$GATES_FAILED, so no board row starts this pass"
    return 0
  fi
  # A unit separator, not a tab: a tab is IFS whitespace, and read folds an empty why into the next field.
  while IFS=$'\x1f' read -r t s w q k; do
    [ -n "$t" ] && GATE_ST[$t]=$s GATE_WHY[$t]=$w GATE_Q[$t]=$q GATE_STACK[$t]=$k
  done < <(jq -r '"\(.tag)\u001f\(.state)\u001f\(.why)\u001f\(.queue)\u001f\(.stack // "")"' <<<"$out")
}

# gate_wait <gate tags> -> why the row may not start yet, one clause a gate that is not clear;
# nothing when all are.
gate_wait() {
  local g out=''
  for g in $1; do
    case "${GATE_ST[$g]:-}" in
      clear) ;;
      dead) out+="${out:+; }gate #$g never clears: ${GATE_WHY[$g]}" ;;
      *) out+="${out:+; }waits on ${GATE_WHY[$g]:-$g}" ;;
    esac
  done
  printf '%s' "$out"
}

# load_extras -- fill the caller's `local -A DET PLN PAR RNK RLD GAT` from one board read, by "<project>\t<lane>\t<id>":
# DET the row's "<planned 0|1>\t<details json>", PLN 1 when the row is tagged #plan, RNK its feed `rank`
# (RANK_JQ's `frank`), RLD its feed `release_due` (the project's Target: day the rank read, RANK_JQ's why), GAT its gate tags (load_gates); PAR by id alone (a child may sit on another
# project's board), 1 for a parent: an open row names it in `#of/`.
load_extras() {
  local board p l i r t g d rd
  load_gates
  board=$(notes board --json 2>/dev/null) && load_sprints "$board"
  while IFS=$'\t' read -r p l i r rd t g d; do
    DET["$p"$'\t'"$l"$'\t'"$i"]="$g"$'\t'"$d"
    [ "$rd" = - ] || RLD["$p"$'\t'"$l"$'\t'"$i"]=$rd
    [ "$t" = 1 ] && PLN["$p"$'\t'"$l"$'\t'"$i"]=1
    [ "$r" = - ] || RNK["$p"$'\t'"$l"$'\t'"$i"]=$r
  done < <(jq -r --argjson n "$DISPATCH_DETAIL_CHARS" "$ROW_JQ"'
    .rows[]? | select(.id != null)
    | "\(.project)\t\(.lane)\t\(.id)\t\(.rank // "-")\t\(.release_due // "-")\t\(if plan_tagged then 1 else 0 end)\t\(if planned then 1 else 0 end)\t\(details_json($n))"' <<<"$board")
  # Every row's dsig in one batch, so a walk hashes no details row by row (ar-4512).
  local -a ds=()
  for d in "${DET[@]}"; do d=${d#*$'\t'}; [ "$d" = '""' ] || ds+=("$d"); done
  sigs_load "${ds[@]+"${ds[@]}"}"
  while read -r i; do
    [ -n "$i" ] && PAR[$i]=1
  done < <(jq -r '.rows[]? | select(.state == "open" or .state == "doing") | .tags[]? | select(startswith("of/")) | .[3:]' <<<"$board")
  [ "${#GATE_ST[@]}" -gt 0 ] || return 0
  while IFS=$'\t' read -r p l i t; do
    for g in $t; do
      [ -z "${GATE_ST[$g]+x}" ] || GAT["$p"$'\t'"$l"$'\t'"$i"]+="${GAT["$p"$'\t'"$l"$'\t'"$i"]:+ }$g"
    done
  # tags_cased: a gate's value keeps its case (an ask id), as agent-queue gate --all keys it.
  done < <(jq -r '.rows[]? | select(.id != null) | (.tags_cased // .tags // []) as $t | select($t | length > 0) | "\(.project)\t\(.lane)\t\(.id)\t\($t | join(" "))"' <<<"$board")
}

# SPRINT_ROW["<project>\t<id>"]: the open rows of each open sprint, from the board feed's `sprints` (a queued
# sprint has not started), read by load_sprints from the one board read load_extras makes, or on first use:
# 1 for a row its window holds (`tasks`, the snapshot and its interrupts), 2 for one of the open version's
# unstarted agent rows it does not (`uncommitted`, notes-cli window::open_window), so a row that unblocks
# mid-sprint ranks as sprint at once, after the committed ones (row_sprint_set's UNCOMMITTED), with no relock. While only
# the snapshot counted, 20 open v0.5.5 rows waited on a human relock (2026-11-21, ar-4331).
# SPRINT_PROJECT[<project>]: a project one of whose open sprint's rows nobody has started yet (`open` or
# `uncommitted`, not `doing`), the projects the sprint floor's board scan reads (sprint_top_up).
declare -gA SPRINT_ROW=() SPRINT_PROJECT=()
SPRINT_LOADED=''
load_sprints() {
  local p i st
  [ -n "$1" ] || return 0   # an empty read (exit 0, no output) is a failed one: sync_sprint_tags must not strip on it
  SPRINT_ROW=() SPRINT_PROJECT=() SPRINT_LOADED=1
  while IFS=$'\t' read -r p i st; do
    [ -n "$p" ] || continue
    if [ "$st" != uncommitted ]; then SPRINT_ROW["$p"$'\t'"$i"]=1
    elif [ -z "${SPRINT_ROW["$p"$'\t'"$i"]:-}" ]; then SPRINT_ROW["$p"$'\t'"$i"]=2
    fi
    [ "$st" = doing ] || SPRINT_PROJECT["$p"]=1
  done < <(jq -r '.sprints[]? | select(.queued != true) | .project as $p
    | ((.tasks[]? | select((.state == "open" or .state == "doing") and .id != null) | "\($p)\t\(.id)\t\(.state)"),
       (.uncommitted[]? | "\($p)\t\(.)\tuncommitted"))' <<<"$1" 2>/dev/null)
}
# sprint_rows_ready -- load_sprints on first use; a board read that fails loads nothing, so the next use reads again.
sprint_rows_ready() {
  local b
  [ -z "$SPRINT_LOADED" ] || return 0
  b=$(notes board --json 2>/dev/null) && load_sprints "$b"
  return 0
}

# row_sprint <project> <id> -> 0 when an open sprint holds the row (SPRINT_ROW), else 1: a candidate's
# `sprint`, which RANK_JQ ranks first as `cleanup` ranks a cleanup row, and promote tags the item with.
row_sprint() { row_sprint_set "$1" "$2"; echo "$SPRINT"; }
# row_sprint_set <project> <id> -> sets SPRINT as row_sprint prints it, and UNCOMMITTED: 1 for a sprint row its
# window did not commit (SPRINT_ROW 2), else 0, the rank key after `sprint`, so committed rows rank first within the sprint.
row_sprint_set() {
  local v=${SPRINT_ROW["$1"$'\t'"$2"]:-}
  if [ -n "$v" ]; then SPRINT=0; else SPRINT=1; fi
  if [ "$v" = 2 ]; then UNCOMMITTED=1; else UNCOMMITTED=0; fi
}

# game_areas < candidate lines -> {"<project>": ["<game>", ...]}: the game directories under the
# Assets/Games of each candidate's repo, lowercased. ROW_JQ's row_area locks the game a row names, so a
# fix in one game does not hold every row of the system word its prefix names: on 2026-11-23 one
# fix(gameplay) item in one game held all 97 playground gameplay rows. No Assets/Games, no entry.
game_areas() {
  local name repo g gs
  jq -r 'select((.repo // "") != "") | "\(.project)\t\(.repo)"' 2>/dev/null | awk '!seen[$0]++' |
    while IFS=$'\t' read -r name repo; do
      [ -d "$repo/Assets/Games" ] || continue
      gs=()
      for g in "$repo"/Assets/Games/*/; do g=${g%/}; g=${g##*/}; [[ $g =~ ^[A-Za-z0-9]+$ ]] && gs+=("${g,,}"); done
      if [ "${#gs[@]}" -gt 0 ]; then jq -cn --arg p "$name" '{($p): $ARGS.positional}' --args "${gs[@]}"; fi
    done | jq -sc 'add // {}'
}

# POOL_IDLE["<repo>"]=<pool>: each repo whose CI gates on an idle pool, read once a pass (its entry point
# calls load_pool_idle before its subshells, as load_gates) from Prometheus, the source the starved-pool
# hold and the hub Pools tab read. A pool is idle while cc:pool_busy is under `busy_below` of its
# cc:pool_slots, for the pools the `idle_pool` knob of classes.json lists; a repo gates on a pool when
# github_pool_workflow lists a workflow of it there. On 2026-11-21 14 of 15 Unity runners sat idle while
# fleet projects took 79% of starts. No knob, or no answer, is no idle pool, so the rank term orders nothing.
declare -gA POOL_IDLE=()
POOL_IDLE_LOADED=''
load_pool_idle() {
  local cfg re below idle wf r p
  [ -z "$POOL_IDLE_LOADED" ] || return 0
  POOL_IDLE_LOADED=1
  cfg=$(jq -ce '.idle_pool | select((.pools | type) == "array" and (.pools | length) > 0 and (.busy_below | type) == "number")' "$DISPATCH_CLASSES" 2>/dev/null) || return 0
  # shellcheck source=../lib/prom.sh
  . "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/prom.sh"
  re=$(prom_label_re "$(jq -c .pools <<<"$cfg")"); below=$(jq -r .busy_below <<<"$cfg")
  [ -n "$re" ] || return 0
  # The comparison keeps only the idle pools; one with no slots divides to NaN or +Inf, which it drops.
  idle=$(PROM_TIMEOUT=5 prom_q "cc:pool_busy{pool=~\"$re\"} / cc:pool_slots{pool=~\"$re\"} < $below") &&
    wf=$(PROM_TIMEOUT=5 prom_q "count by (pool, repo) (github_pool_workflow{pool=~\"$re\"})") ||
    { say "idle pool: prometheus did not answer, so no row ranks for an idle pool"; return 0; }
  while IFS=$'\t' read -r r p; do [ -z "$r" ] || POOL_IDLE[$r]=$p; done < <(jq -rn --argjson i "$idle" --argjson w "$wf" '
    ($i.data.result | map(.metric.pool)) as $idle
    | [$w.data.result[] | .metric | select(.repo and .pool and (.pool as $p | $idle | index($p)))]
    | unique_by(.repo) | .[] | "\(.repo)\t\(.pool)"' 2>/dev/null)
}

# pool_idle_of <project> -> the idle pool its repo gates on (POOL_IDLE), nothing when none is idle;
# the entry point ran load_pool_idle in its own shell, so a $(...) of this reads its map.
pool_idle_of() {
  local r
  [ "${#POOL_IDLE[@]}" -gt 0 ] || return 0
  r=$(item_repo "$1"); [ -n "$r" ] || return 0
  printf '%s' "${POOL_IDLE[$r]:-}"
}

# load_focus -- FOCUS_PROJECTS: the projects the human put on `#prio/focus` (`notes projects --prio <p> --set focus`),
# space-separated, read once per process. Only what stats and headroom report: a focus is a rank (RANK_JQ
# and agent-queue's ORDER put its work first), and nothing is held or skipped for it.
load_focus() {
  [ -n "${FOCUS_PROJECTS+x}" ] && return 0
  FOCUS_PROJECTS=$(notes projects --prios 2>/dev/null | awk -F '\t' '$2 == "focus" { printf "%s%s", (n++ ? " " : ""), $1 }')
}

# row_off_set <project> <key> <text> -> sets OFF to why the row may not dispatch whatever the judge says:
# its kind (kind_off), or it is a parent, which closes when its children do. Nothing when it may. A
# hand `fleet-dispatch start` reads none of this. Every open agent row is planned work, so no tier
# bars one: work never stops while a row is open (the human, 2026-11-23). It leaves KIND set (row_kind_set).
row_off_set() {
  row_kind_set "$3"; kind_off_set "$KIND"
  OFF=$KIND_OFF
  [ -n "$OFF" ] || [ -z "${PAR[$2]:-}" ] || OFF="a parent: open rows name it in #of/"
}

# held_load <judged> -- the judged_keys lines into HELD, which held reads; a walk loads them once.
held_load() {
  local l
  declare -gA HELD=()
  while IFS= read -r l; do [ -z "$l" ] || HELD[$l]=1; done <<<"$1"
}
# held <project> <lane> <key> <line> <dsig> -- a judged_keys line (HELD) still covers the row
held() {
  local k="$1"$'\t'"$2"$'\t'"$3"
  [ -n "${HELD["$k"$'\t'"$4"$'\t'"$5"]+x}" ] || [ -n "${HELD["$k"$'\t'"$4"$'\t*']+x}" ] || [ -n "${HELD["$k"$'\t*\t*']+x}" ]
}

# np <profile> <args...> -> notes, under that profile, or notes' own default when it is empty
# (a hand `start` may leave the profile to the CLI).
np() {
  local p="$1"
  shift
  if [ -n "$p" ]; then notes --profile "$p" "$@"; else notes "$@"; fi
}

# session_live <session> <server> [host] -- rc 1 only on evidence the tmux session is gone: tmux
# says so, or its fleet worker left the roster, so nothing could ever answer for it (reap then reads
# its PR). A worker that does not answer, or fails some other way, cannot tell, and cannot-tell is
# live: every reader counts its units and reap leaves it be.
session_live() {
  [ -n "${3:-}" ] || { tmux -L "$2" has-session -t "=$1" 2>/dev/null; return; }
  fleet_hosts >/dev/null
  fleet_host "$3" >/dev/null || return 1
  fleet_host_run "$3" tmux -L "$2" has-session -t "=$1" 2>/dev/null
  [ $? -ne 1 ]
}

# on_host <host> <command> [args...] -- run it on that fleet worker, or here when <host> is empty.
on_host() {
  local h="$1"; shift
  if [ -n "$h" ]; then fleet_host_run "$h" "$@"; else "$@"; fi
}

# The env prefix that starts claude on the account claude-acct names: the one `room` picks (the best
# with room, under its weekly pace), else `pick`, since a hand start is never refused. A run pass has
# already chosen from `claude-acct room --json` (acct_room) and passes that account in RUN_ACCOUNT.
# Empty for the main account or when claude-acct is missing. Accounts share ~/.claude/projects, so
# a resumed session works from either one.
account_dir() {
  if [ "${RUN_ACCOUNT+set}" = set ]; then printf '%s' "$RUN_ACCOUNT"; return; fi
  local rows
  rows=$(claude-acct room --json 2>/dev/null)
  if jq -e '.pick != null' <<<"$rows" >/dev/null 2>&1; then
    jq -r '.pick as $p | .accounts[] | select(.name == $p) | .dir' <<<"$rows"; return
  fi
  say "start: no account has room ($(jq -r '.why // "no answer"' <<<"$rows" 2>/dev/null || echo "no answer")); a hand start goes ahead on pick's"
  claude-acct pick || true
}
# account_env [dir]: the prefix for that account (the chosen one when no argument). Main unsets
# the dir: a pane gets the tmux server's environment, which may carry an alt account.
account_env() {
  local dir; if [ "$#" -gt 0 ]; then dir=$1; else dir=$(account_dir); fi
  if [ -n "$dir" ]; then printf 'CLAUDE_CONFIG_DIR=%q ' "$dir"; else printf 'env -u CLAUDE_CONFIG_DIR '; fi
}
# token_env [dir]: the launch-line prefix handing that account's long-lived token to a claude
# session (`claude-acct setup-token`), or nothing when it has none. The line carries a command
# substitution its pane's shell runs at launch, never the token itself. Only the answer that starts
# with the assignment counts. A claude-cloud-run pane takes none: a cloud session needs the login.
token_env() {
  local dir p; if [ "$#" -gt 0 ]; then dir=$1; else dir=$(account_dir); fi
  p=$(claude-acct token-prefix "$dir" 2>/dev/null) || return 0
  case "$p" in CLAUDE_CODE_OAUTH_TOKEN=*) printf '%s' "$p" ;; esac
  return 0
}

# telemetry_env <cwd> [item]: the launch-line prefix claude-telemetry.sh's claude_launch_env gives:
# a parent Claude session's identity dropped, the shared launch env and (on the LAN) the OTel export,
# with spans labelled by project and queue item. A pane gets the tmux server's environment and runs no
# rc file, so only its launch line can carry these.
telemetry_env() {
  local f="$HOME/.config/shared-hooks/claude-telemetry.sh" env
  # shellcheck disable=SC2016
  env=$(cd "$1" 2>/dev/null && AGENT_QUEUE_ITEM=${2:-} bash -c '. "$1" >/dev/null && claude_launch_env' _ "$f") ||
    { say "no launch env from $f, so this start exports no telemetry and keeps the tmux server's Claude session vars"; return 0; }
  printf '%s' "$env"
}

# item_sessions -> one line per running, waiting or review queue item, its fields split by
# US (0x1f, so an empty field survives `read`): slug, server, tmux session, who started it (`by`), project, area,
# state, weight, agent, started, Claude session ids, host. The item's `session:` is the one record of
# where it runs, `<server>:<tmux session>` (tmux turns a ':' in a session name into '_', so one ':'
# splits), and `host:` the fleet worker that server is on, empty for this machine.
# An item started in a hub window records no `session:`, only the Claude sessions that worked it
# (`sessions:`), and one started from a plain shell may record neither; both come out with an empty
# server and session, and only reap reads them (settle_sessionless for the second).
item_sessions() {
  agent-queue list --json --state active 2>/dev/null | jq -r '
    select(.state != "queued")
    | ((.session // "") | index(":")) as $i
    | [.slug, (if $i then .session[:$i] else "" end), (if $i then .session[$i + 1:] else "" end),
       (.by // ""), .project, (.area // ""), .state, (.weight // "light"),
       (.agent // "claude"), (.started // ""), (.sessions // ""), (.host // "")] | join("\u001f")' 2>/dev/null
  return 0
}

# panel_lists <agent> -- agent-panel lists this agent's sessions, by Claude session id: Claude, and
# a harness claude-lazer launches. Another agent's `sessions:` ids (a codex thread) are never there.
panel_lists() { [ "$1" = claude ] || [ "$(harness_launcher "$1")" = claude-lazer ]; }

# past_reap_grace <started> -- exit 0 once an item started at least DISPATCH_REAP_GRACE seconds ago.
past_reap_grace() {
  local t
  t=$(date -d "$1" +%s 2>/dev/null) || return 1
  [ $(( $(date +%s) - t )) -ge "$DISPATCH_REAP_GRACE" ]
}

# claude_gone <server> <tmux session> <agent> <started> <session ids> -- exit 0 when agent-panel
# says the item's Claude has exited while its tmux session lives on (or, for a hub item, when none
# of the Claude sessions that worked it is live). A tmux session alone is not a session: a shell
# left after claude exits keeps it, and an item in a hub window has none of its own. Exit 1 (keep
# the item) when it cannot tell: an agent that is not Claude (agent-panel lists only Claude, which
# a harness launched by claude-lazer is), a
# parked pane (its claude exited on purpose), an item started in the last DISPATCH_REAP_GRACE
# seconds (its claude may still be booting), or a panel it cannot read or that lists nobody.
# An item that records its session ids is alive only while one of them is on the panel; the tmux
# session counts only for one that records none: worktree lanes are recycled, and a new Claude in
# an old item's lane is not its session (2026-11-07 ar-255, ar-487). A recorded Claude whose process
# still runs (claude_pid_live) is alive whatever the panel lists. REAP_PANEL caches one read per pass,
# so its verdict is one witness: reap settles on it only when the reap before also missed (reap_confirm).
claude_gone() {
  local server="$1" sess="$2" agent="$3" started="$4" sids="$5"
  panel_lists "$agent" || return 1
  if [ -n "$sess" ]; then
    parked "$sess" && return 1
  else
    [ -n "$sids" ] || return 1
  fi
  past_reap_grace "$started" || return 1
  [ -n "${REAP_PANEL+set}" ] || REAP_PANEL=$(agent-panel list --json 2>/dev/null) || REAP_PANEL=''
  [ -n "$REAP_PANEL" ] || return 1
  jq -e -s --arg t "$server/$sess" --arg ids "$sids" '
    ($ids | split(" ") | map(select(. != ""))) as $ids
    | any(.[]; if $ids != [] then (.session_id // "") as $s | $s != "" and ($ids | index($s)) != null
               else $t != "/" and ((.target // "") | sub(":[^:/]*$"; "")) == $t end)
    | not' <<<"$REAP_PANEL" >/dev/null || return 1
  [ -z "$sids" ] || ! claude_pid_live "$sids"
}

# codex_gone <slug> <agent> <started> -- exit 0 when the item runs on a Codex launcher, started past
# DISPATCH_REAP_GRACE ago, and its run is no longer live (codex_run_live). The tmux session is no
# witness for a Codex item: wt recycles worktree lanes, so a Claude item can take the same session
# name, and agent-panel lists that Claude, never the Codex run (ar-1087). Like claude_gone it is one
# witness, and reap settles on it only when the reap before also read it gone (reap_confirm).
codex_gone() {
  [ "$(harness_launcher "$2")" = codex ] || return 1
  past_reap_grace "$3" || return 1
  ! codex_run_live "$1"
}

# codex_run_live <slug> -- exit 0 while a process running `agent-codex run` or `resume` (the launch line's timeout,
# or agent-codex itself) has AGENT_QUEUE_ITEM=<slug> in its environment. Only the launcher's own
# processes count: a daemon a Codex command started inherits the variable and may outlive the run. Only
# this user's processes are read (pgrep -u), and one that exited since pgrep listed it is skipped. A
# pgrep that fails, or a live process whose environment will not read, cannot tell, and cannot-tell is live.
codex_run_live() {
  local pids p
  pids=$(pgrep -u "$(id -u)" -f 'agent-codex (run|resume)' 2>/dev/null); [ $? -le 1 ] || return 0
  for p in $pids; do
    [ -e "$DISPATCH_PROC/$p" ] || continue
    [ -r "$DISPATCH_PROC/$p/environ" ] || return 0
    tr '\0' '\n' <"$DISPATCH_PROC/$p/environ" | grep -qxF "AGENT_QUEUE_ITEM=$1" && return 0
  done
  return 1
}

# claude_pid_live <session ids> -- exit 0 when a Claude process recorded for one of those ids is
# running: its ~/.claude*/sessions/<pid>.json names the id, the pid is alive and not a zombie, and,
# when the file records procStart, started when the file says, so a reused pid is not a session.
# agent-panel is a view of those files and can leave a live Claude out; the process is what makes a
# session gone. Each file is parsed alone, so one half-written file hides no other.
claude_pid_live() {
  local f pid start st
  for f in "$HOME"/.claude*/sessions/*.json; do
    [ -e "$f" ] || continue
    IFS=$'\t' read -r pid start < <(jq -r --arg ids "$1" '
      ($ids | split(" ") | map(select(. != ""))) as $ids
      | select((.sessionId // "") as $s | .pid != null and $s != "" and ($ids | index($s)) != null)
      | [.pid, (.procStart // "")] | @tsv' "$f" 2>/dev/null) && [ -n "$pid" ] || continue
    st=$(sed 's/.*) //' "/proc/$pid/stat" 2>/dev/null) || continue
    [ -n "$st" ] || continue
    [ "${st%% *}" != Z ] || continue
    [ -z "$start" ] || [ "$(cut -d' ' -f20 <<<"$st")" = "$start" ] || continue
    return 0
  done
  return 1
}

# reap_confirm <slug> [what was missed] -- exit 0 when an earlier reap, at least DISPATCH_REAP_CONFIRM seconds before,
# also read the item's Claude as gone (claude_gone); else record this miss and exit 1. One agent-panel
# read is not a witness: on 2026-11-07 (ar-900) a panel at 78% CPU under load 33 left a live session
# out, and reap failed an urgent item whose re-read a minute later listed it. A reap that does not
# read the item gone clears its mark (reap_seen), so only consecutive misses count. The mark stays
# once confirmed, so an item settle_item leaves active (waiting on its open PR) stays gone; it goes
# when the item closes, and cmd_reap prunes the marks of slugs no longer active.
reap_confirm() {
  local f="$DIR/reap-miss/$1" first
  first=$(cat "$f" 2>/dev/null)
  if [ -n "$first" ]; then
    [ $(( $(date +%s) - first )) -ge "$DISPATCH_REAP_CONFIRM" ]; return
  fi
  mkdir -p "${f%/*}" && date +%s > "$f"
  logline "reap: queue item $1's ${2:-Claude is not on agent-panel}; a reap ${DISPATCH_REAP_CONFIRM}s or more from now settles it if it still is not"
  return 1
}
reap_seen() { [ ! -e "$DIR/reap-miss/$1" ] || rm -f "$DIR/reap-miss/$1"; }

# reap_stuck <slug> <item json> <hours> <reason> <human-sheet title> -- reap cannot settle the item
# this pass, and nothing will change that on its own: a partial landing nobody finishes, a PR its forge
# cannot read, a row with no merge proof. The reason is logged when the title changes, never on every
# pass (2026-11-16 to 11-18: 526 identical lines from 6 sessions and 2 items; the title, not the reason,
# so a new session name in the reason is no change), and once it has stood <hours> (0: at once) one
# human-sheet row says what to do, or one page when the sheet refuses it (keyed needs:dispatch:stuck:<slug>:<title hash>, so agent-notify drops a repeat of one fact for a day), then nothing more while it
# stands. $DIR/stuck/<slug> holds "<first epoch> <filed 0|1>" and the title; each pass rewrites it, so
# a marker no pass has seen in a day is pruned by cmd_reap. reap_unstuck clears it once the item settles.
# gate: fd-reap-stuck
reap_stuck() {
  local f="$DIR/stuck/$1" first='' filed=0 was='' now where
  now=$(date +%s)
  { read -r first filed && IFS= read -r was; } 2>/dev/null < "$f"
  if [ "$was" != "$5" ] || [ -z "$first" ]; then first=$now filed=0; logline "$4"; fi
  if [ "$filed" != 1 ] && [ $(( now - first )) -ge $(( $3 * 3600 )) ]; then
    filed=1 where=$(human_sheet_row "$2" "$5 (queue item $1) #size/s")
    logline "queue item $1: $where: $5"
    case "$where" in "not filed"*) agent-notify -t 'Needs you' -d "needs:dispatch:stuck:$1:$(printf %s "$5" | cksum | cut -d" " -f1)" "$5 (queue item $1; $where)" >/dev/null 2>&1 ;; esac
    echo "human row for queue item $1 ($where)"
  fi
  mkdir -p "${f%/*}" && printf '%s %s\n%s\n' "$first" "$filed" "$5" > "$f"
}
reap_unstuck() { [ ! -e "$DIR/stuck/$1" ] || rm -f "$DIR/stuck/$1"; }

# human_sheet_row <item json> <row text> -> where the row went: the human sheet of the board the item
# came from (a dotfiles item's row is on agent-runtime), else its project's. fleet-dispatch is a
# direct filer (its stamp files each escalation once, and triage could drop one that waits on the
# human), so the row goes on the sheet; exit 4 is a vouch notes could not make.
human_sheet_row() {
  local prof sheet row rc=0
  IFS=$'\x1f' read -r prof sheet < <(jq -r '[.profile // "", .project // ""] | join("\u001f")' <<<"$1")
  row=$(item_row "$1")
  [ -z "$row" ] || IFS=$'\x1f' read -r prof sheet _ <<<"$row"
  np "$prof" ptask "$sheet" add "$2" --origin fleet-dispatch >/dev/null 2>&1 || rc=$?
  case "$rc" in
    0) echo "on the $sheet sheet" ;;
    4) echo "in the outbox for the $sheet sheet" ;;
    *) echo "not filed: the $sheet sheet refused the row" ;;
  esac
}

# host_lost <host> -- exit 0 when that fleet worker has gone unanswered (ssh 255) on every reap for
# DISPATCH_HOST_DEAD seconds: a killed container or a dead box, whose sessions went with it, so its
# items are re-dispatched (settle_item). Asked once a reap (REAP_HOST caches it). $DIR/host-miss/<host>
# holds the first miss, and its mtime the last: a host that answers loses its mark, and a miss after a
# gap longer than DISPATCH_HOST_DEAD with no reap asking (no item there) starts the count again.
# An answer of any kind, even a failed command, is a live host, and a miss counts only while this
# machine reaches the store's origin (store-sync-age): a dispatcher cut off reads every worker as down.
declare -gA REAP_HOST=()
host_lost() {
  local h="$1" f="$DIR/host-miss/$1" now first last
  if [ -z "${REAP_HOST[$h]+set}" ]; then
    REAP_HOST[$h]=0
    if fleet_host_run "$h" true >/dev/null 2>&1 || [ $? -ne 255 ]; then rm -f "$f"
    elif ! store-sync-age >/dev/null 2>&1; then
      # No witness of our own link: the store has not reached origin in 30 minutes (store-sync-age), so a
      # worker that does not answer may be this machine cut off (2026-09-08: 21h of link loss): no miss is
      # counted, and one past DISPATCH_HOST_DEAD after the last starts the run again.
      logline "reap: fleet worker $h did not answer, and this machine has not synced the store in 30 minutes either: no miss counted"
    else
      now=$(date +%s)
      first=$(cat "$f" 2>/dev/null) last=$(stat -c %Y "$f" 2>/dev/null) || last=0
      if [ -z "$first" ] || [ $(( now - last )) -gt "$DISPATCH_HOST_DEAD" ]; then
        mkdir -p "${f%/*}" && echo "$now" > "$f"
        logline "reap: fleet worker $h did not answer; a reap ${DISPATCH_HOST_DEAD}s or more from now re-queues its items if it still has not"
      else
        touch "$f"
        [ $(( now - first )) -lt "$DISPATCH_HOST_DEAD" ] || REAP_HOST[$h]=1
      fi
    fi
  fi
  [ "${REAP_HOST[$h]}" = 1 ]
}

# restoring <server> <tmux session> <session ids> -- exit 0 when a lost pane record (world_lost) still
# holds a conversation in that tmux session, or one of those Claude sessions: restore has not reopened
# it yet. A record that will not read holds every session of its server, since cannot-tell is live.
# REAP_LOST caches one read per pass.
restoring() {
  if [ -z "${REAP_LOST+set}" ]; then
    local f srv held
    REAP_LOST=''
    for f in "$PANES"/*.lost.json; do
      [ -e "$f" ] || continue
      srv=${f##*/}; srv=${srv%.lost.json}
      held=$(jq -r --arg s "$srv" '.panes[] | select(.claude != "") | "\($s)/\(.session)", "sid:\(.claude)"' "$f" 2>/dev/null) ||
        held="$srv/*"
      REAP_LOST+="$held"$'\n'
    done
  fi
  [ -n "$REAP_LOST" ] || return 1
  { [ -n "$2" ] && grep -qxF -e "$1/$2" -e "$1/*" <<<"$REAP_LOST"; } ||
    { [ -n "$3" ] && grep -qxF -f <(printf 'sid:%s\n' $3) <<<"$REAP_LOST"; }
}

# parked <tmux session> -- a claude-acct park ledger names the session, or one of its windows: its
# claude exited on purpose, so reap keeps it and it holds no run unit and adds no load.
parked() { [ -e "$PARKED_DIR/$1" ] || compgen -G "$PARKED_DIR/$1:*" >/dev/null; }

# WAITS_JQ -- a jq def: a session waiting on the human, which holds no slot. NEEDS whose reason does not end in
# `carrying on` (fleet-sessions' own test: one carrying on past its ask is busy). pace_target and waiting_item both read it.
WAITS_JQ='def waits: .bucket == "NEEDS" and ((.reason // "") | endswith("carrying on") | not);'

# waiting_item <slug> -- exit 0 when the queue item's session waits on the human in the fleet state document
# (WAITS_JQ). One read a process; a missing or unreadable document names none.
waiting_item() {
  [ -n "${WAITING_ITEMS+set}" ] || WAITING_ITEMS=$(jq -r "$WAITS_JQ"'.sessions[] | select(waits) | .item // empty' "$FLEET_STATE_FILE" 2>/dev/null)
  [ -n "$1" ] && grep -qxF -- "$1" <<<"$WAITING_ITEMS"
}

# live_runs -> "<project>/<area> <weight>[ <host>]" for every running Claude session (panel_lists) this runner started
# itself, with the fleet worker it runs on. A hand launch or a restore is tagged and tracked like any
# other, but holds none of the runner's units: a dozen restored sessions must not stop dispatch for the day.
# A parked session holds none either: its claude has exited and costs nothing until it is unparked.
# With --gateway, only the other runs (codex, a gateway harness) on a fleet worker: none holds a unit
# of the Claude target, but each holds one of its worker's fleet_max_live (probe_hosts).
live_runs() {
  local slug server sess by project area state weight _agent _started _sids host gw="${1:-}"
  while IFS=$'\x1f' read -r slug server sess by project area state weight _agent _started _sids host; do
    [ -n "$sess" ] || continue
    [ "$by" = dispatch ] || continue
    # A gateway run in review is its replay (gateway_launch), which holds no run unit.
    if [ "$gw" = --gateway ]; then { [ -n "$host" ] && ! panel_lists "$_agent" && [ "$state" != review ]; } || continue
    else panel_lists "$_agent" || continue   # the target is Claude's (pace_target): a codex or gateway run holds its own source's room, not a unit of it
    fi
    [ -n "$host" ] || ! parked "$sess" || continue
    # A session here waiting on the human holds no unit, as pace_target counts it no live session (a worker's row is a pass behind: it keeps its unit).
    [ -n "$host" ] || [ "$gw" = --gateway ] || ! waiting_item "$slug" || continue
    session_live "$sess" "$server" "$host" && printf '%s/%s %s%s\n' "$project" "$area" "$weight" "${host:+ $host}"
  done < <(item_sessions)
  return 0
}

# weight_units <weight> -> the run units an item of that weight holds.
weight_units() { [ "$1" = heavy ] && echo 2 || echo 1; }

# units_on <host> < live_runs -> the run units those sessions hold on that fleet worker, or on this
# machine when <host> is empty.
units_on() {
  local u=0 w h
  while read -r _ w h; do [ -n "$w" ] && [ "$h" = "$1" ] && u=$(( u + $(weight_units "$w") )); done
  echo "$u"
}

# live_units -> the run units the runner's live sessions hold on this machine, out of TARGET.
live_units() { live_runs | units_on ''; }

# pace_target -- TARGET is the live Claude sessions the fleet fills to now, TARGET_WHEN which cap:
# the live count plus what the Claude accounts' spend has spare at their weekly pace (claude-acct's
# fleet.spare, from ACCT_ROWS when the caller already read it: the working Opus sessions more that
# keeps holds on top of the measured burn), at most DISPATCH_TARGET_PRESENT while the human is here
# and DISPATCH_TARGET_AWAY while away, and never under DISPATCH_RUN_FLOOR (the floor wins over the
# cap). It reads spend, not a session count: the session carry (fleet.carries, 19) held against every
# live session, idle and waiting ones too, read full while the accounts spent 0.7/h of 1.6/h, and a
# Sonnet or Haiku session burns less, so it leaves more spare (2026-11-18, ar-3230). Each start is
# counted as one more Opus session, so the cheap guess never overspends. Present and away share the
# spare: a fixed present 30 ran 34 Claude sessions while the accounts carried 19 and codex, go and
# ocfree sat idle (2026-11-18). A pass reads its own (each start reads room again, so it shares
# none). An unread spare is the cap: room still refuses an account past its line. The target is
# Claude's budget only: an item routed to another source is held by that
# source's room, not by it (other_source_start). TOTAL_LIVE is every
# Claude session in the fleet state document (a codex or opencode run is not one: its row's account
# is the harness name, agent-core HARNESSES), hand starts included (they count toward the target
# and are never refused), but parked ones, finished ones (its vocab.finished, which the close
# verdict winds down), the shepherd pass, which its own .counts leaves out too, and ones waiting their
# landing turn (open_job queue): they spend no tokens and no CPU while a train ahead of them gates, and
# on 2026-11-14 22 of them held the present target of 30 while 618 items waited. A NEEDS session
# waiting on the human is not counted either, so sessions that cannot move never fill the target
# (NEEDS_LIVE is how many: headroom `needs`); one carrying on past its own ask is busy and still
# counts (ar-3811, human 2026-11-20). WORKING_LIVE is how many of TOTAL_LIVE are busy (WORKING, or
# NEEDS carrying on: headroom `working`), IDLE_LIVE one "<target> <bucket>: <reason>" line for each of
# the rest (cmd_idle_cap). TARGET_BY says what set TARGET: cap (present or away), spare or floor. It is empty when
# the document is missing or older than DISPATCH_STATE_FRESH_MIN, and an unknown count holds every start.
pace_target() {
  if human_here; then TARGET=$DISPATCH_TARGET_PRESENT TARGET_WHEN=present
  else TARGET=$DISPATCH_TARGET_AWAY TARGET_WHEN=away; fi
  local spare live
  spare=$(jq -r '.fleet.spare // empty' <<<"${ACCT_ROWS:-$(claude-acct room --json 2>/dev/null)}" 2>/dev/null)
  live=$(jq -c --argjson now "$(date +%s)" --argjson fresh "$(( DISPATCH_STATE_FRESH_MIN * 60 ))" '
    select($now - (.generated_epoch // 0) <= $fresh) | (.vocab.finished // []) as $done
    | '"$WAITS_JQ"'
    [.sessions[] | select(.bucket != "PARKED" and (.bucket | IN($done[]) | not) and ((.labels // []) | index("shepherd") | not)
        and ((.account // "") | IN("codex", "opencode") | not))]
    | (map(select(.open_job != "queue" and (waits | not)))) as $live
    | {live: ($live | length),
       needs: map(select(.open_job != "queue" and waits)) | length,
       working: ($live | map(select(.bucket == "WORKING" or .bucket == "NEEDS")) | length),
       idle: ($live | map(select(.bucket != "WORKING" and .bucket != "NEEDS")
         | "\(.target) \(.bucket)\(if (.reason // "") != "" then ": \(.reason)" else "" end)"))}' \
    "$FLEET_STATE_FILE" 2>/dev/null)
  TOTAL_LIVE=$(jq -r '.live // empty' <<<"$live" 2>/dev/null)
  NEEDS_LIVE=$(jq -r '.needs // empty' <<<"$live" 2>/dev/null)
  WORKING_LIVE=$(jq -r '.working // empty' <<<"$live" 2>/dev/null)
  IDLE_LIVE=$(jq -r '.idle[]? // empty' <<<"$live" 2>/dev/null)
  NEEDS_NOTE=; [ "${NEEDS_LIVE:-0}" -gt 0 ] && NEEDS_NOTE=", not counting $NEEDS_LIVE waiting on the human"
  TARGET_BY=cap
  if [[ "$spare" =~ ^-?[0-9]+$ && "$TOTAL_LIVE" =~ ^[0-9]+$ ]]; then
    spare=$(( TOTAL_LIVE + spare )); [ "$spare" -ge 0 ] || spare=0
    [ "$spare" -ge "$TARGET" ] || TARGET=$spare TARGET_BY=spare
  fi
  # A floor at or over the target holds it: a session's close cannot lower it (TARGET_BY floor).
  if [ "${DISPATCH_RUN_FLOOR:-0}" -gt 0 ] && [ "$TARGET" -le "$DISPATCH_RUN_FLOOR" ]; then TARGET=$DISPATCH_RUN_FLOOR TARGET_BY=floor; fi
}

# HUMAN_ASK_JQ: `human_ask` is an item from a #requested row whose words are the human's: dispatch
# copies the tag onto it, and stamps `asker:` at promote from notes' ingest record (asker_map). An
# `asker: agent` item's #requested came from an agent: a session's `--want human` follow-up, the outbox,
# an ask sweep. notes puts #requested on every `--want`, so on 2026-11-23 the 75% fleet share passed its
# 30% cap on a session's leftovers (plan fleet-product-work-first P3). No asker (a row the record does
# not reach, or an item from before it) keeps the tag's word.
# shellcheck disable=SC2016
HUMAN_ASK_JQ='def human_ask: ((" " + (.tags // "") + " ") | test(" #?requested ")) and (.asker // "") != "agent";'

# asker_map -- ASKER_MAP, read once a process: {<row id>: "human" | "agent"} for each row notes' ingest
# record ($NOTES_INGEST) holds. human: an event in the human's words, a `want` of focus, voice, request or
# meeting (their own surfaces, whoever relays them), `--want human` added outside any agent session by
# no named tool (a terminal, the human's Start; fleet-dispatch writes sessionless rows too), or
# #requested written by the human's own hand. agent: the row was added or
# filed and none of those: a session's or queue item's `--want human` (its follow-up: wind-down files
# leftovers that way), one filed from the outbox, or the machine channels notes names (outbox, ask). A row
# the record does not reach is in neither, so its #requested keeps its word. Unreadable, the map is empty.
# Call it in the pass's own shell, as share_state.
asker_map() {
  [ -z "${ASKER_MAP:-}" ] || return 0
  ASKER_MAP='{}'
  [ -r "$NOTES_INGEST" ] || return 0
  # shellcheck disable=SC2016
  ASKER_MAP=$({ grep -E '"action":"(added|filed)"|"want":"|"by":"human"' "$NOTES_INGEST" || true; } | jq -sc '
    def human_words: (.want // "") as $w | ((.session_id // "") == "" and ((.by // "") | IN("", "human"))) as $hand
      | ($w | IN("focus", "voice", "request", "meeting")) or ($w == "human" and .action == "added" and $hand)
        or ((.by // "") == "human" and $hand and ((.text // .row // .why // "") | test("#requested")));
    [.[] | select((.id // "") != "")] | group_by(.id)
    | map({key: .[0].id, value: (if any(.[]; human_words) then "human"
        elif any(.[]; .action | IN("added", "filed")) then "agent" else empty end)}) | from_entries' 2>/dev/null) ||
    ASKER_MAP='{}'
  [ -n "$ASKER_MAP" ] || ASKER_MAP='{}'
}

# row_asker <row id> -> human or agent, whose words the row's #requested is (asker_map), or nothing
# when the record does not reach the row.
row_asker() { asker_map; jq -r --arg k "$1" '.[$k] // empty' <<<"$ASKER_MAP"; }

# SHARE_JQ: `share_held($s)` is an item the fleet share cap holds, $s being SHARE_STATE: the share is
# full and the item is on a fleet project, no red, no human_ask (the human's ask, ask XI2fDO) and no
# urgent `from: human` (human_urgent's urgent test; its fresh asks and plan phases pass on the human
# floor, HUMAN_PASS). A Claude canary or any other urgent waits like the rest, a board row's #urgent
# included (`from: board:`): 180 of the 1132 starts in the 3 days to 2026-11-21 passed the cap that
# way while the fleet held 79% of them (plan swhow-me-asll-data-modular-otter P3). A canary pinned to a
# harness with its own source ($s.sourced, harnesses.json `source`) passes, as a trainee start does: it
# spends no Claude session, and held, the week's set never ran while the fleet sat over its share (ask
# GDUmQQ, ar-4554). A land or fix-ci requeue of an item's own PR (`pr`, `pr_owner` and its
# `<owner>_tries` stamp, the test item_brief reads) passes too: it starts a Claude session, but a stranded
# PR costs more than one, and DISPATCH_FIX_TRIES bounds the tries; held, share_return sent hc-857 back to
# its row and left home-config#1406 green and unmerged (2026-11-23). The one test share_why and
# queue_depth apply.
# shellcheck disable=SC2016
SHARE_JQ="$HUMAN_ASK_JQ"'def share_held($s): (.project // "") as $p | (.agent // "claude") as $a | $s.full and any($s.projects[]; . == $p)
  and (((.pr // "") != "" and (.pr_owner // "") != "" and (.[.pr_owner + "_tries"] // "") != "") | not)
  and ((.priority == "urgent" and (.from // "human") == "human") | not)
  and ((" " + (.tags // "") + " ") | test(" #?red ") | not) and (human_ask | not)
  and (((" " + (.tags // "") + " ") | contains(" canary ")) and any(($s.sourced // [])[]; . == $a) | not);'

# share_state -- SHARE_STATE, read once a process: {full, fleet, total, projects}, the queue items
# started in the last DISPATCH_FLEET_SHARE_H hours (any state, hand starts and cancelled ones too, as
# each spent a session), how many are on DISPATCH_FLEET_PROJECTS, and full when those are
# DISPATCH_FLEET_SHARE percent or more of them. start_items adds this pass's own starts (share_count).
# Call it in the pass's own shell, not a $( ): a subshell's read is lost. Off or unreadable it is
# never full, so the cap never stops a pass.
share_state() {
  [ -z "${SHARE_STATE:-}" ] || return 0
  SHARE_STATE='{"full":false,"fleet":0,"total":0,"projects":[]}'
  [ "${DISPATCH_FLEET_SHARE:-0}" -gt 0 ] 2>/dev/null || return 0
  local s prios ps=${DISPATCH_FLEET_PROJECTS-}
  if [ -z "${DISPATCH_FLEET_PROJECTS+x}" ]; then
    # A failed read is `unread`, which headroom names, so the cap is never off without a word.
    prios=$(notes projects --prios 2>/dev/null) || { SHARE_STATE='{"full":false,"fleet":0,"total":0,"projects":[],"unread":true}'; return 0; }
    ps=$(awk -F '\t' '$2 == "low" { printf "%s%s", (n++ ? " " : ""), $1 }' <<<"$prios")
  fi
  [ -n "${ps// }" ] || return 0
  s=$({ agent-queue list --json --state done --since "$(( (DISPATCH_FLEET_SHARE_H + 23) / 24 ))d" &&
    agent-queue list --json --state active; } 2>/dev/null |
    jq -sc --argjson cut "$(( $(date +%s) - DISPATCH_FLEET_SHARE_H * 3600 ))" --arg p "$ps" '
      [$p | splits(" +") | select(. != "")] as $ps
      | [.[] | select(((.started // "") | sub("\\.[0-9]+"; "") | try fromdateiso8601 catch 0) >= $cut)]
      | {fleet: (map(select(.project as $x | any($ps[]; . == $x))) | length), total: length, projects: $ps}') &&
    [ -n "$s" ] || return 0
  # The harnesses that spend from their own source, not a Claude account: a canary pinned to one passes (SHARE_JQ).
  s=$(jq -c --argjson src "$(jq -c '[.harnesses // {} | to_entries[] | select(.value.source) | .key]' "$HARNESSES" 2>/dev/null || echo '[]')" \
    '.sourced = $src' <<<"$s") || return 0
  share_set "$s"
}

# share_set <state json> -- SHARE_STATE from its counts, `full` worked out again.
share_set() {
  SHARE_STATE=$(jq -c --argjson pct "$DISPATCH_FLEET_SHARE" '.full = (.total > 0 and .fleet * 100 >= $pct * .total)' <<<"$1")
}

# share_count <item json> -- count a start this pass made into SHARE_STATE, once it has been read.
share_count() {
  [ -n "${SHARE_STATE:-}" ] || return 0
  share_set "$(jq -c --argjson it "$1" '.total += 1 | if any(.projects[]; . == ($it.project // "")) then .fleet += 1 else . end' <<<"$SHARE_STATE")"
}

# share_full -- rc 0 while the fleet share is at or over its cap.
share_full() { share_state; [ "$(jq -r .full <<<"$SHARE_STATE")" = true ]; }

# share_why <item json> -> why the fleet share cap holds the item, or nothing: share_held (which passes a
# land or fix-ci requeue of the item's own PR, SHARE_JQ), outside the human and sprint floors (HUMAN_PASS), which are the human's own work and never cut off, and outside the
# trainee floor (TRAINEE_PASS), whose start runs on a free trainee key and spends no session the cap
# guards. A Claude canary waits like any fleet item. pick_item lets the first held item go when nothing
# else can start, so the cap never leaves a slot idle.
share_why() {
  [ "${HUMAN_PASS:-0}${TRAINEE_PASS:-0}" = 00 ] || return 0
  share_state
  jq -r --argjson s "$SHARE_STATE" --argjson pct "${DISPATCH_FLEET_SHARE:-0}" --argjson h "$DISPATCH_FLEET_SHARE_H" "$SHARE_JQ"'
    select(share_held($s))
    | "fleet share: \($s.fleet) of the \($s.total) items started in \($h)h are fleet work (\($s.projects | join(", "))), at or over DISPATCH_FLEET_SHARE=\($pct)%"' <<<"$1" 2>/dev/null
  return 0
}

# share_return -- each queued item from a board row that the fleet share cap holds (share_why) and that
# has waited DISPATCH_STARVED_MIN or longer goes back to its row (agent-queue return): the queue holds only
# work that can start, and the fill promotes the row again once the share has room. Held in queued/, a
# let-go fill's leftovers sat behind every other project's fresh row: ar-3412 and four more 9h on
# 2026-11-21, the queued age p90 494m against its 420m bound (watch queue-age, ar-4554). A canary has no
# row; canary_top_up queues no Claude lane's while the share is full. A sprint row is left to its floor
# (sprint_floor_start). Run after the pass, so the floors and the let-go have started what they would.
share_return() {
  share_full || return 0
  local cut it slug why err
  cut=$(date -u -d "-$DISPATCH_STARVED_MIN min" +%Y-%m-%dT%H:%M:%SZ)
  while IFS= read -r it; do
    [ -n "$it" ] || continue
    why=$(share_why "$it"); [ -n "$why" ] || continue
    slug=$(jq -r .slug <<<"$it")
    if ! err=$(AQ_RETURN_QUEUED=1 agent-queue return "$slug" --why "held by the $why, for ${DISPATCH_STARVED_MIN}m or more: its row waits for room" 2>&1 >/dev/null); then
      say "queue item $slug stays queued, held by the $why: agent-queue return refused it${err:+: ${err//$'\n'/; }}"; continue
    fi
    say "returned queue item $slug to its board row: the $why"
    logline "returned queue item $slug to its board row: held by the $why"
  done < <(agent-queue list --json --state queued 2>/dev/null |
    jq -c --arg cut "$cut" 'select((.from // "") | startswith("board:")) | select((" " + (.tags // "") + " ") | contains(" sprint ") | not) | select((.queued // "") != "" and .queued <= $cut)' 2>/dev/null)
  return 0
}

# floor_open -- the live run sessions, plus what this pass started, are under DISPATCH_RUN_FLOOR: the
# weekly pace does not hold this start. Load, fleet-assess, the reserve and holds still do.
# FLOOR_LIVE is the count cmd_run read before its first start, so a start the session list has not
# caught up with still counts once.
floor_open() {
  [ "${DISPATCH_RUN_FLOOR:-0}" -gt 0 ] 2>/dev/null || return 1
  local live=${FLOOR_LIVE:-$(live_runs | grep -c . || true)}
  [ $(( live + ${STARTED:-0} )) -lt "$DISPATCH_RUN_FLOOR" ]
}

# live_tagged <tag> -> the sessions of the items tagged <tag> the runner started that are live, one a
# line: the red floor's count (live_reds) and the canaries canary_top_up keeps. live_plans -> those of
# the approved plan phases (human_plan_phases' items): the plan load floor's count.
live_tagged() { live_where '(" " + (.tags // "") + " ") | contains(" '"$1"' ")'; }
live_plans() { live_where '(.plan // "") != "" and (.from // "human") == "human"'; }
live_where() {
  agent-queue list --json --state active 2>/dev/null | jq -r '
    select(.state != "queued" and .by == "dispatch")
    | select('"$1"')
    | (.host // "") as $h | (.session // "") | select(contains(":")) | index(":") as $i | "\(.[:$i]) \(.[$i + 1:]) \($h)"' 2>/dev/null |
    while read -r server sess host; do session_live "$sess" "$server" "$host" && echo "$sess"; done
  return 0
}
live_reds() { live_tagged red; }

# watch_reds -> how many red items of a tripped watch (tags `red watch`, fleet-bench triage) are
# running, or queued and not held: each one widens the red floor by one.
watch_reds() {
  # One count, 0 when the queue cannot be read: under pipefail a locked queue failed the pipe after jq
  # had printed 0 for the empty input, so `|| echo 0` made it "0\n0" and every pass died in the red
  # floor's arithmetic (2026-11-18 00:51 to 01:36, nothing started).
  local n
  n=$(agent-queue list --json --state active 2>/dev/null | jq -s '[.[] | select(.state == "running" or (.state == "queued" and (.hold // "") == ""))
    | select((" " + (.tags // "") + " ") | contains(" red ") and contains(" watch "))] | length' 2>/dev/null) || n=0
  echo "${n:-0}"
}

# red_floor_open -- a red start is due past the machine gates: RED_PASS says the start is a red item,
# and the live red sessions plus the reds this pass started are under DISPATCH_RED_FLOOR plus one for
# each tripped watch's red item. The pace target, load, fleet-assess and the weekly pace do not hold it;
# agent-hold, the reserve and the github budget still do, and a red cluster still holds cluster work. RED_LIVE and RED_WATCH are
# cmd_run's counts before its first start, as FLOOR_LIVE.
red_floor_open() {
  [ "${RED_PASS:-0}" = 1 ] || return 1
  [ "$(red_floor_slots)" -gt 0 ]
}

# red_floor_slots -> how many more red starts the red floor takes now: DISPATCH_RED_FLOOR plus one for
# each tripped watch's red item, less the live red sessions and the reds this pass started; 0 when
# DISPATCH_RED_FLOOR is 0. red_floor_open, the full-target path and pass_order read this one count.
red_floor_slots() {
  [ "${DISPATCH_RED_FLOOR:-0}" -gt 0 ] 2>/dev/null || { echo 0; return 0; }
  local live=${RED_LIVE:-$(live_reds | grep -c . || true)} watch=${RED_WATCH:-$(watch_reds)} n
  n=$(( DISPATCH_RED_FLOOR + watch - live - ${RED_STARTED:-0} ))
  [ "$n" -gt 0 ] || n=0
  echo "$n"
}

# plan_load_floor_open -- an approved plan phase's start is due past this machine's load: PLAN_PASS says
# the human floor is starting approved plan phases past load (human_floor_start), and the live ones the
# runner started plus this pass's (PLAN_STARTED) are under DISPATCH_PLAN_LOAD_FLOOR. Load
# and a fleet-assess HOLD on load do not hold it (machine_why); every other gate still does. PLAN_LIVE
# is cmd_run's count before its first start, as RED_LIVE.
plan_load_floor_open() {
  [ "${PLAN_PASS:-0}" = 1 ] || return 1
  [ "${DISPATCH_PLAN_LOAD_FLOOR:-0}" -gt 0 ] 2>/dev/null || return 1
  local live=${PLAN_LIVE:-$(live_plans | grep -c . || true)}
  [ $(( live + ${PLAN_STARTED:-0} )) -lt "$DISPATCH_PLAN_LOAD_FLOOR" ]
}

# ASK_JQ: `fresh_ask($now; $h)` is an item from a #requested row (dispatch copies the tag onto it)
# whose row was asked in the last $h hours, DISPATCH_ASK_FRESH_H: `asked:` is the row's own created
# date (the board feed's `since`), stamped at promote, so its asked day ends inside the window. Not
# `queued`: the requested floor promotes week-old rows, which would read as asked today. Not
# `from: human`: that is agent-queue's default for an add with no --from, so a session's own
# follow-ups carry it too (all 21 fresh ones, 2026-11-18). Not a bare #requested either: an agent's
# `--want` stamps it too, so the ask is human_ask (HUMAN_ASK_JQ). An item with no `asked:` is no fresh ask.
# `runs_now` is what preempts and reserves run units: urgent, or a fresh ask.
# shellcheck disable=SC2016
ASK_JQ="$HUMAN_ASK_JQ"'
def fresh_ask($now; $h): ((.asked // "") | try ("\(.)T00:00:00Z" | fromdateiso8601) catch null) as $t
  | $h > 0 and $t != null and ($t + 86400) > ($now - $h * 3600) and human_ask;
def runs_now($now; $h): .priority == "urgent" or fresh_ask($now; $h);'

# runs_now <item json> -- the item is urgent or a fresh ask (ASK_JQ).
runs_now() {
  jq -e --argjson now "$(date +%s)" --argjson h "$DISPATCH_ASK_FRESH_H" "$ASK_JQ runs_now(\$now; \$h)" <<<"$1" >/dev/null 2>&1
}

# short_item <item json> -- the item is in a class under its classes.json min_live (agent-queue marks it `short`).
short_item() { jq -e '.short == true' <<<"$1" >/dev/null 2>&1; }

# short_floor_open -- SHORT_PASS says the start is a short item (short_item; start_item sets it per item,
# short_floor_start for its pass): an account refused for its weekly pace alone takes it, as on the run
# floor (acct_room). The reserve, the 5h window, committed burn, load, fleet-assess, agent-hold and
# the github budget still hold it (ar-4890: unity at 1 of its min_live 6 while the pace held every start).
short_floor_open() { [ "${SHORT_PASS:-0}" = 1 ]; }

# pass_order <item json lines> -> the order a pass tries them in: the reds the red floor has slots for
# (red_floor_slots, a tripped watch's first, as red_items), then the human's urgent items and fresh asks
# that are not red (runs_now), then the short items (short_item), then the rest in agent-queue's order.
# agent-queue lists every red first, so reds past the floor and cleanup took a pass's start cap before
# a class under its min_live (ar-4890: 1 unity of its 6 live, the pass stopped on load after reds and a
# cleanup row). A red is urgent at add, so only a non-red runs_now item keeps its place ahead of them.
# Input jq cannot read is named and passed on in queue order, so the pass says why it is unsorted.
pass_order() {
  [ -n "$1" ] || return 0
  jq -sc --argjson n "$(red_floor_slots)" --argjson now "$(date +%s)" --argjson h "$DISPATCH_ASK_FRESH_H" "$ASK_JQ"'
    def has($t): (" " + (.tags // "") + " ") | contains(" \($t) ");
    ([.[] | select(has("red"))] | sort_by(has("watch") | not) | .[:$n]) as $reds
    | ($reds | map(.slug)) as $floor
    | [.[] | select(.slug as $s | $floor | index([$s]) | not)] as $rest
    | [$rest[] | select((has("red") | not) and runs_now($now; $h))] as $human
    | ($human | map(.slug)) as $first
    | [$rest[] | select(.slug as $s | $first | index([$s]) | not)] as $rest
    | ($reds + $human + [$rest[] | select(.short == true)] + [$rest[] | select(.short != true)])[]' <<<"$1" \
    || { say "pass_order: jq could not read the queue items, so they start in queue order"; printf '%s\n' "$1"; }
}

# runs_now_label <item json> -> "urgent" or "ask", the word the run log names it by.
runs_now_label() { if [ "$(jq -r .priority <<<"$1")" = urgent ]; then echo urgent; else echo ask; fi; }

# human_urgent <item json lines> -> the human's own work among them, which their standing rule keeps
# clear of the weekly pace (dotfiles CLAUDE.md, "Hard limits on budgets"; the human floor): the items they
# queued as urgent, their fresh asks (ASK_JQ), and the ready phases of the plans they approved
# (human_plan_phases), in queue order. Past a full pace target they wait in queue order like any item.
human_urgent() {
  jq -sc --argjson plan "$(human_plan_phases "$1" | jq -sc 'map(.slug)')" \
    --argjson now "$(date +%s)" --argjson h "$DISPATCH_ASK_FRESH_H" "$ASK_JQ"'
    .[] | select((.priority == "urgent" and (.from // "human") == "human") or fresh_ask($now; $h)
                 or (.slug as $s | $plan | index($s)))' <<<"$1"
}

# human_plan_phases <item json lines> -> the first phase of each approved plan among them, in queue
# order: a plan item the human queued (`from: human`; agent-queue admits no machine filer's plan as
# approved), one a plan, and none of a plan the human floor already started a phase of this pass
# (PLANS_STARTED). The items are runnable ones, so an `after:` or tag hold already keeps a phase out.
# They pass the weekly pace on the human floor; under a full pace target they wait in queue order,
# as the plan floor that started them past it is gone (plan vast-soaring-prism P3).
human_plan_phases() {
  local p sup="[]"
  # A superseded plan's phases are another plan's (plan_superseded): none starts here.
  while IFS= read -r p; do
    if plan_superseded "$p"; then sup=$(jq -c --arg p "$p" '. + [$p]' <<<"$sup"); fi
  done < <(jq -r '.plan // empty' <<<"$1" 2>/dev/null | sort -u)
  jq -sc --arg done "${PLANS_STARTED:-}" --argjson sup "$sup" '($done | split("\n")) as $d
    | to_entries | map(select((.value.plan // "") != "" and (.value.from // "human") == "human"
        and (.value.plan as $p | ($d | index($p) | not) and ($sup | index($p) | not))))
    | group_by(.value.plan) | map(first) | sort_by(.key)[] | .value' <<<"$1" 2>/dev/null
  return 0
}

# live_sprints -> the sessions of the urgent sprint items (tag `sprint`) the runner started that are live:
# the sprint floor's count.
live_sprints() { live_where '((" " + (.tags // "") + " ") | contains(" sprint ")) and .priority == "urgent"'; }

# sync_sprint_tags -- keep each queued board item's `sprint` tag in step with row_sprint so an item
# promoted during an open sprint loses `sprint` when the sprint closes or its row leaves it, and one
# queued before its row joined an open sprint gains it. Skips when the board read failed (SPRINT_LOADED
# empty) so an unreadable feed never strips sprint tags.
sync_sprint_tags() {
  local slug row tags project key has in_sprint new_tags t why tl
  [ "$DRY" = 0 ] || return 0
  sprint_rows_ready
  [ -n "$SPRINT_LOADED" ] || return 0
  while IFS=$'\t' read -r slug row tags; do
    [ -n "$slug" ] && [ -n "$row" ] || continue
    project=${row%%:*} key=${row#*:}
    [ "$project" != "$row" ] && [ -n "$project" ] && [ -n "$key" ] || continue
    has=0; [[ " $tags " != *" sprint "* ]] || has=1
    in_sprint=0; [ "$(row_sprint "$project" "$key")" = 0 ] && in_sprint=1
    [ "$has" != "$in_sprint" ] || continue
    if [ "$in_sprint" = 1 ]; then
      new_tags="${tags:+$tags }sprint"
      why="added sprint tag ($row is in an open sprint)"
    else
      new_tags=''
      read -ra tl <<<"$tags"
      for t in "${tl[@]}"; do
        [ "$t" = sprint ] || new_tags="${new_tags:+$new_tags }$t"
      done
      why="removed sprint tag ($row left the open sprint)"
    fi
    if agent-queue set "$slug" "tags=$new_tags" >/dev/null 2>&1; then
      say "queue item $slug: $why"
      unset NEXT_QUEUED
    else
      say "queue item $slug: agent-queue set failed, sprint tag left as it is (wanted: $why)"
    fi
  done < <(agent-queue list --json --state queued 2>/dev/null |
    jq -r 'select((.row // "") != "") | [(.slug // ""), (.row // ""), (.tags // "")] | @tsv' 2>/dev/null)
  return 0
}

# sprint_top_up -- queue an open sprint's dispatchable rows (fill_day's `sprint` floor) on every run pass,
# before the floors and the queue pass read the queue, so the queue order (agent-queue's `sprint` bucket) and
# the sprint floor take them ahead of the queued items off the sprint. The low-water fill reads the board only
# after the queue pass, and over the low water not for sprint rows at all, so on 2026-11-21 sprint rows that
# turned dispatchable could wait behind queued off-sprint low items, and an urgent one the sprint floor never
# saw (ar-3816). <room> is the pass's room: it queues up to that or DISPATCH_LOW_WATER, whichever is more,
# as the low-water fill does, under the queue cap. Nothing to do with no unstarted open sprint row
# (SPRINT_PROJECT), under a gate the sprint floor's start would stop at (gate under HUMAN_PASS), at the queue
# cap, or in a dry run. Its judge call reads the sprint's rows alone and keeps its JUDGE_RC to itself, so the
# pass's own fill still judges every new row; a judge that fails here fails rc 1 with SPRINT_JUDGE_RC and
# SPRINT_JUDGE_WHY set, which cmd_run makes the pass's, so the pass calls a failing judge once.
sprint_top_up() {
  local want qroom JUDGE_RC='' JUDGE_WHY='' FILLED=0
  [ "$DRY" = 0 ] || return 0
  sprint_rows_ready
  sync_sprint_tags
  [ "${#SPRINT_PROJECT[@]}" -gt 0 ] || return 0
  [ -z "$(HUMAN_PASS=1 gate)" ] || return 0
  want=$DISPATCH_LOW_WATER; [ "${1:-0}" -le "$want" ] || want=$1
  qroom=$(queue_headroom); [ "$want" -le "$qroom" ] || want=$qroom
  [ "$want" -gt 0 ] || return 0
  load_findings || return 0
  if ! fill_day "$want" sprint; then
    SPRINT_JUDGE_RC=$JUDGE_RC SPRINT_JUDGE_WHY=$JUDGE_WHY
    say "sprint: $(judge_failed), so no sprint row was queued ahead of the queue pass"
    return 1
  fi
  [ "$FILLED" = 0 ] && return 0
  say "queued $FILLED dispatchable row(s) of the open sprint ahead of the queue pass"
  unset NEXT_QUEUED
}

# sprint_floor_start -- start the urgent items of an open sprint (tag `sprint`, promote) past the pace
# target and the weekly pace while fewer than DISPATCH_SPRINT_FLOOR run, at most DISPATCH_PER_PASS a
# pass when that is set, in queue order. Load, fleet-assess, agent-hold, the reserve and the
# github budget still hold it (gate under HUMAN_PASS), and each start after the first reads the gate
# again (start_items). A side start like the trainee floor's: the hold stands (start_item). Rc FLOOR_SHUT
# when nothing is due. Urgent sprint rows sat hours behind a full pace target (ar-3816).
sprint_floor_start() {
  local items n slots NO_ROUTE=()
  [ "${DISPATCH_SPRINT_FLOOR:-0}" -gt 0 ] 2>/dev/null || return "$FLOOR_SHUT"
  NEXT_QUEUED=${NEXT_QUEUED-$(next_items --points)}
  items=$(jq -c 'select(.priority == "urgent" and ((" " + (.tags // "") + " ") | contains(" sprint ")))' <<<"$NEXT_QUEUED" 2>/dev/null)
  [ -n "$items" ] || return "$FLOOR_SHUT"
  n=$(grep -c . <<<"$items")
  slots=$(( DISPATCH_SPRINT_FLOOR - $(live_sprints | grep -c . || true) ))
  [ "$n" -gt "$slots" ] && n=$slots
  [ "$PER_PASS" -gt 0 ] && [ "$n" -gt "$PER_PASS" ] && n=$PER_PASS
  [ "$n" -gt 0 ] && [ -z "$(HUMAN_PASS=1 gate)" ] || return "$FLOOR_SHUT"
  say "the open sprint's urgent rows start on the sprint floor, past the pace target (DISPATCH_SPRINT_FLOOR=$DISPATCH_SPRINT_FLOOR, $n open)"
  HUMAN_PASS=1 SPRINT_PASS=1 FLOOR_QUIET=1 UNITS_FREE=$(( n * 2 )) start_items "$items" "$n"
}

# human_floor_open -- HUMAN_PASS says the start is the human's urgent item or fresh ask (human_floor_start): an account
# refused for its weekly pace alone takes it, as on a floor (acct_room); PLAN_PASS adds the plan load floor (plan_load_floor_open). The reserve, the 5h window,
# committed burn, load, fleet-assess, agent-hold and the github budget still hold it.
human_floor_open() { [ "${HUMAN_PASS:-0}" = 1 ]; }

# human_floor_start <item json lines> <room> <why> -- start the human's urgent items and fresh asks among them past
# <why>, the gates that held the pass, once nothing but the weekly pace holds it; the hold stands
# (start_item). Past this machine's load only the approved plan phases among them start, on the plan
# load floor (plan_load_floor_open). Rc FLOOR_SHUT when none is queued or another gate holds.
human_floor_start() {
  local urgent rc past=''
  urgent=$(human_urgent "$1")
  [ -n "$urgent" ] || return "$FLOOR_SHUT"
  if [ -n "$(HUMAN_PASS=1 gate)" ]; then
    urgent=$(human_plan_phases "$urgent")
    [ -n "$urgent" ] && [ -z "$(HUMAN_PASS=1 PLAN_PASS=1 gate)" ] || return "$FLOOR_SHUT"
    past=$(HUMAN_PASS=1 machine_here_why) PLAN_PASS=1
  fi
  say "$3; the human's urgent items and asks start past the weekly pace${past:+; past $past only approved plan phases start, on the plan load floor (DISPATCH_PLAN_LOAD_FLOOR=$DISPATCH_PLAN_LOAD_FLOOR)}"
  HUMAN_PASS=1 FLOOR_GATE=$3
  start_items "$urgent" "$2"; rc=$?
  HUMAN_PASS=0 PLAN_PASS=0 FLOOR_GATE=''
  return "$rc"
}

# plan_load_past -> the machine holds a start on the plan load floor goes past (PLAN_PASS), or nothing.
plan_load_past() { [ "${PLAN_PASS:-0}" = 1 ] || return 0; PLAN_PASS=0 machine_here_why; }

# is_red <item json> -- the item carries the red tag.
is_red() { [[ " $(jq -r '.tags // ""' <<<"$1") " == *" red "* ]]; }

# acct_room -- the account a run start may take, from claude-acct's published answer: one
# `claude-acct room --json` a step (ACCT_ROWS holds it, local to the caller that shares it; each
# start asks afresh, since a start moves the burn). Its pick, the best account with room; while a
# floor is open and there is none, the best refused for its pace alone (room.reasons == ["pace"]):
# the reserve, its 5h window and committed burn still refuse. Sets ACCT_DIR (empty for the main
# account), ACCT_WHY (claude-acct's own refusal sentence, plus why an open floor lifted none) when none may, and ACCT_PAST_PACE=1 when
# the start goes past an account's pace. rc 1 when none may, 2 when none may and an account cannot
# be read, or claude-acct gave no answer.
acct_room() {
  local lift=false pick unread
  ACCT_DIR='' ACCT_WHY='' ACCT_PAST_PACE=0
  [ -n "${ACCT_ROWS:-}" ] || ACCT_ROWS=$(claude-acct room --json 2>/dev/null)
  if ! jq -e '.accounts | type == "array"' <<<"$ACCT_ROWS" >/dev/null 2>&1; then
    ACCT_ROWS='' ACCT_WHY="claude-acct room --json gave no answer"; return 2
  fi
  if floor_open || red_floor_open || human_floor_open || short_floor_open; then lift=true; fi
  pick=$(jq -r --argjson lift "$lift" '[(.pick as $p | .accounts[] | select(.name == $p) | "0 \(.dir)"),
      (select($lift) | .accounts | sort_by(.rank)[] | select(.room.reasons == ["pace"]) | "1 \(.dir)")]
    | first // empty' <<<"$ACCT_ROWS")
  if [ -n "$pick" ]; then ACCT_PAST_PACE=${pick%% *} ACCT_DIR=${pick#* }; return 0; fi
  # With a floor open and an account past its pace, say why the floor did not lift it.
  IFS=$'\x1f' read -r unread ACCT_WHY < <(jq -r --argjson lift "$lift" '
    [any(.accounts[]; .state == "unread"),
       (.why // "claude-acct gave no reason")
       + (if $lift and any(.accounts[].room.reasons[]?; . == "pace")
          then "; the run floor lifts an account refused for its pace alone, and every one past its pace has another refusal" else "" end)]
    | map(tostring) | join("\u001f")' <<<"$ACCT_ROWS")
  [ "$unread" = true ] && return 2
  return 1
}

# other_room -> rc 0 when a source some harness in the map spends (its `source`) has room, read from
# the sources claude-acct room --json carries (ACCT_ROWS, which acct_room read).
other_room() {
  [ -r "$HARNESSES" ] && [ -n "${ACCT_ROWS:-}" ] || return 1
  jq -e --slurpfile map "$HARNESSES" '[$map[0].harnesses[]? | .source // empty] as $s
    | any(.sources[]?; .room.ok == true and (.name as $n | any($s[]; . == $n)))' <<<"$ACCT_ROWS" >/dev/null 2>&1
}

# item_tier <item json> -> the item's tier: what its title or task says (row_tier), else its `tier<N>`
# tag (fill_day stamps one), else 3 for one on a harness project
# (DISPATCH_CLEANUP_PROJECTS), else 1. The gate rides on the item, so an item a session or the human
# queued by hand (`agent-queue add`, no judge) on a harness project still gets the tier-3 gate:
# item_brief names it at start, agent-land checks it at land (`fleet-dispatch item-tier`).
item_tier() {
  local text t tags project
  text=$(jq -r '[.title // empty, .task // empty] | join("\n")' <<<"$1")
  t=$(row_tier "$text")
  tags=" $(jq -r '.tags // ""' <<<"$1") "
  project=$(jq -r '.project // ""' <<<"$1")
  if [ -z "$t" ]; then
    if [[ "$tags" =~ \ tier([1-9])\  ]]; then t=${BASH_REMATCH[1]}
    elif [[ -n "$project" && " $DISPATCH_CLEANUP_PROJECTS " == *" $project "* ]]; then t=3
    fi
  fi
  echo "${t:-1}"
}

# cmd_item_tier <slug> -- print item_tier for a queue item: agent-land's tier-3 check.
cmd_item_tier() {
  local it
  it=$(agent-queue show "${1:?item-tier: needs a slug}" --json 2>/dev/null) && [ -n "$it" ] || { say "item-tier: no queue item $1"; return 1; }
  item_tier "$it"
}

# excluded_kind <item json> -> the first `excluded` kind of MATRIX whose `match` (a case-insensitive ERE)
# hits the item's headline (item_headline) or one of its tags written `#tag`, counting only an entry
# whose `stack`, when it names one, holds the item's project (fleet-bench's scoping of an excluded cell).
# rc 1 when none does; rc 2, failing closed, when MATRIX or the item is unreadable or a `match` is not a
# valid ERE. It reads only the entries with a kind and a match, for every headless harness (a `harness`
# there scopes nothing); fleet-bench's matrix prints these beside the mode entries a `harness` scopes and
# the refusals it reads from the harness's map entry, so every excluded kind it shows is one route() refuses.
excluded_kind() {
  local text tags rows kind re rc
  tags=$(jq -r '.tags // "" | if type == "array" then join(" ") else . end | split(" ") | map(select(. != "") | "#" + .) | join(" ")' <<<"$1") || return 2
  text="$(item_headline "$1") $tags"
  rows=$(jq -r --arg p "$(jq -r '.project // ""' <<<"$1")" '.stacks as $s | .excluded[]? | select(.kind and .match)
      | select(.stack == null or (($s[.stack].projects // []) | index($p)))
      | "\(.kind)\t\(.match)"' "$MATRIX" 2>/dev/null) || return 2
  while IFS=$'\t' read -r kind re; do
    [ -n "$kind" ] || continue
    grep -qiE -- "$re" <<<"$text"; rc=$?
    [ "$rc" = 0 ] && { echo "$kind"; return 0; }
    [ "$rc" = 1 ] || return 2
  done <<<"$rows"
  return 1
}

# lane_cached <slug> -> the verdict a pass recorded today for an item no source could take;
# lane_cache <slug> <verdict> records it, so later passes do not ask model-lane again for every
# Opus item while only other sources have room. Only a skip reads it: a start classifies afresh.
# A fallback verdict (model-lane could not reach its LLM) is an error, not a pick, so it is kept only
# LANE_FALLBACK_TTL seconds: a retry backoff, so an outage costs one classify per item per TTL, not
# per pass, and the item routes on the real pick once the classifier answers. A row with no cached_at
# (written before the TTL) is past it.
LANE_FALLBACK_TTL=${LANE_FALLBACK_TTL:-900}
lane_cached() {
  awk -F'\t' -v d="$(date +%F)" -v s="$1" '$1 == d && $2 == s { print $3; exit }' "$LANE_CACHE" 2>/dev/null |
    jq -c --argjson ttl "$LANE_FALLBACK_TTL" 'select(.by != "fallback" or now - (.cached_at // 0) < $ttl)' 2>/dev/null
}
lane_cache() {
  local d; d=$(date +%F); mkdir -p "$DIR"
  { awk -F'\t' -v d="$d" -v s="$1" '$1 == d && $2 != s' "$LANE_CACHE" 2>/dev/null; printf '%s\t%s\t%s\n' "$d" "$1" "$(jq -c '.cached_at = (now | floor)' <<<"$2")"; } > "$LANE_CACHE.tmp" &&
    mv -f "$LANE_CACHE.tmp" "$LANE_CACHE"
}

# live_hand -> one line per live queue item a run slot does not hold: any `by` but dispatch (a hand
# start, a resume, a --running record with no origin). They add load, which the gate reads, but no run slot. A parked one adds no load.
live_hand() {
  local slug server sess by project area state _weight _agent _started _sids host
  while IFS=$'\x1f' read -r slug server sess by project area state _weight _agent _started _sids host; do
    [ -n "$sess" ] || continue
    [ "$by" != dispatch ] || continue
    [ -n "$host" ] || ! parked "$sess" || continue
    session_live "$sess" "$server" "$host" && printf '%s/%s\n' "$project" "$area"
  done < <(item_sessions)
  return 0
}

# queue_areas -> "<project>/<area>" for every active queue item that names an area. An item holds
# its area from start until reap closes it, so a session that ended unreaped still holds it.
queue_areas() {
  agent-queue list --json --state active 2>/dev/null | jq -r 'select(.area) | "\(.project)/\(.area)"' 2>/dev/null
  return 0
}

# rows <profile> <project> <lane> -> "<key>\t<raw line>" for each OPEN row on the open version. The
# key is the row's id, which outlives an edit to its text; a row with no id yet goes by its text
# until promote starts it, which stamps one.
rows() {
  local flag=()
  [ "$3" = agent ] && flag=(--agent)
  np "$1" ptask "$2" "${flag[@]}" list 2>/dev/null | cut -f3- |
    sed -E 's/^[^\t]*\t(.*<!--([^>]* )?id:([a-z]{2,4}-[0-9]+)( [^>]*)?-->[[:space:]]*)$/\3\t\1/'
}

# row_line <profile> <project> <lane> <key> -> that row's raw line, nothing when it is not on the
# board. The board is read whole first: piped into something that stops early, a large board dies
# of SIGPIPE and pipefail reads the 141 as "not there".
row_line() {
  local board
  board=$(rows "$1" "$2" "$3")
  K="$4" awk -F'\t' '$1 == ENVIRON["K"] { print substr($0, length($1) + 2); exit }' <<<"$board"
}

# row_lane <profile> <project> <lane> <key> -> the lane the row is on: the one given, else the other
# board's, said on stderr; exit 1 when it is on neither. A hand start typed without --agent found
# nothing and was told its open agent row was "no longer open" (2026-11-19).
row_lane() {
  local other=agent
  [ "$3" = human ] || other=human
  if [ -n "$(row_line "$1" "$2" "$3" "$4")" ]; then echo "$3"
  elif [ -n "$(row_line "$1" "$2" "$other" "$4")" ]; then say "start: $4 is on the $other board, so it starts from there"; echo "$other"
  else return 1
  fi
}

# row_priority <raw line> [project] -> the queue priority the row asks for: a bare row is high, the
# default of the row grammar and of agent-queue alike, and so is a cleanup row whatever its #low.
# row_priority_set sets PRIORITY; prio_word_set <prio_rank> <cleanup_row> sets it from the two, which a walk has.
prio_word_set() {
  case "$1" in
    0) PRIORITY=urgent ;;
    3) if [ "$2" = 0 ]; then PRIORITY=high; else PRIORITY=low; fi ;;
    *) PRIORITY=high ;;
  esac
}
row_priority_set() {
  local c=1
  prio_rank_set "$1"
  if [ "$PRIO" = 3 ] && [ -n "${2:-}" ]; then cleanup_row_set "$2" "$1"; c=$CLEANUP; fi
  prio_word_set "$PRIO" "$c"
}
row_priority() { row_priority_set "$@"; echo "$PRIORITY"; }

# IN_FORCE_JQ: in_force($tries), of one row's verdict records in file order, the ones still in force.
# A `failed` record (its item ended failed, or its row sat orphaned) expires every verdict before it,
# so the row is judged again, or picked again when it is `gated` and needs no verdict. Once $tries
# (DISPATCH_FIX_TRIES) failed records follow the row's last `cleared`, the newest of them holds the
# row whatever changed, and ask_failed_rows asks the human; the `cleared` it writes with that ask
# starts the count again. A `failed` with `hold: true` (a cause a retry cannot change, as promote
# records it) holds at once. `error` records stay in, for the reader to skip or show.
IN_FORCE_JQ='def in_force($tries):
    to_entries as $e
    | ([$e[] | select(.value.verdict == "cleared") | .key] | max // -1) as $c
    | [$e[] | select(.value.verdict == "failed")] as $f
    | [$f[] | select(.key > $c)] as $n
    | if ($n | length) > 0 and (($n | length) >= $tries or any($n[]; .value.hold == true)) then [$f[-1].value]
      else ([$f[] | .key] | max // -1) as $lf
        | [$e[] | select(.key > $lf and .value.verdict != "failed" and .value.verdict != "cleared") | .value]
      end;'

# judged_keys -> "<project>\t<lane>\t<key>\t<line sig>\t<details sig>" for each verdict in force
# (in_force): made under the current policy, or a dispatch or skip whose rule the policy still has
# (policy_sig), checked against the row by held. A row its failures hold is held whatever changed
# ("*"). A verdict with no dsig holds whatever the details (ROW_JQ holds). An `error` holds nothing.
# A malformed line is skipped, never the end of the read.
judged_keys() {
  [ -f "$VERDICTS" ] || return 0
  jq -rRn --arg sig "$(policy_sig)" --argjson rules "$(policy_rules)" --argjson tries "$DISPATCH_FIX_TRIES" "$ROW_JQ$IN_FORCE_JQ"'
    [inputs | fromjson? | objects] | group_by([.project, .lane, .key])[] | in_force($tries)[]
    | if .verdict == "failed" then [.project, .lane, .key, "*", "*"]
    elif .verdict == "error" then empty
    elif .policy == $sig or usable($rules) then [.project, .lane, .key, (.line // ""), (.dsig // "*")]
    else empty end | @tsv' "$VERDICTS" 2>/dev/null
}

# cmd_candidates -> one JSON line per open row a worker takes (with SUGGEST=1, every agent row too)
# that no verdict holds, with its details. A #plan row waits for inbox-plan and is left out; suggest
# shows it as blocked, and so a row with a gate not yet clear (gate_wait), shown as its `gate_wait`;
# an agent-lane row whose gates all cleared is `gated`: committed work, which picks takes with no verdict
# (a human-lane row is still judged, since only the verdict says the human's row is agent work). When the
# gates could not be read (GATES_FAILED) it lists no row but under suggest. CLEANUP_ONLY,
# REQUESTED_ONLY, GATED_ONLY, SPRINT_ONLY and FLOOR_PROJECTS (fill_day's floors) read only their rows (floor_row), in the projects
# that can hold one (floor_project); ONLY_PROJECT reads that one project alone (trainee_rows' split). A project off_project names is no candidate: it says why under OFF_SAY (the `candidates`
# command, and a pass's one judge read, so not once per read), and suggest lists its agent rows with that reason.
cmd_candidates() {
  local judged table prof name sheet _v stage pprio repo lane key text rank worker tier line today nobody active poff recs
  local x planned dj dsig plan off kind board gates gwait pidle fgates prio priority cleanup sprint uncommitted rsize
  today=${DISPATCH_TODAY:-$(date +%F)}
  judged=$(judged_keys)
  table=$(workers)
  [ -n "$table" ] || return 0
  held_load "$judged"
  # A caller that walks many times (trainee_rows) declares and loads the extras once for every walk.
  if ! declare -p DET >/dev/null 2>&1; then
    local -A DET=() PLN=() PAR=() RNK=() GAT=() RLD=()
    load_extras
  fi
  [ -z "${GATES_FAILED:-}" ] || [ "${SUGGEST:-0}" = 1 ] || return 0
  load_kinds
  load_prios
  for prof in $DISPATCH_PROFILES; do
    while IFS=$'\t' read -r name sheet _v _; do
      [ -n "$name" ] || continue
      [ -z "${ONLY_PROJECT:-}" ] || [ "$name" = "$ONLY_PROJECT" ] || continue
      ! floor_pass || floor_project "$name" || continue
      stage=$(stage_of "$sheet")
      dispatchable "$stage" || continue
      poff=$(off_project "$name")
      [ -z "$poff" ] || [ "${SUGGEST:-0}" = 1 ] || { [ "${OFF_SAY:-0}" != 1 ] || say "$poff"; continue; }
      pprio=${PRIO_BY[$name]:-}
      repo=$(repo_dir "$name")
      [ -n "$repo" ] && [ -d "$repo" ] || continue
      pidle=$(pool_idle_of "$name")
      # suggest marks a project worked on in the last day, so a gap in worker cover shows.
      active=false
      [ "${SUGGEST:-0}" = 1 ] && [ -n "$(git -C "$repo" log -1 --since=24.hours --format=%h 2>/dev/null)" ] && active=true
      for lane in human agent; do
        board=$(rows "$prof" "$name" "$lane")
        row_kinds_load <<<"$board"
        row_sigs_load <<<"$board"
        # Each value below comes from a _set helper, never $(...): a row costs no subshell (ar-4512).
        # A row's fields go into one record (ROW_RS, ROW_US) and one jq a board builds every object:
        # a jq a row was 3,704 forks a pass and most of a walk's time (ar-4911).
        recs=''
        while IFS=$'\t' read -r key text; do
          [ -n "$key" ] || continue
          case "$text" in '- [ ]'*) ;; *) continue ;; esac
          plan=${PLN["$name"$'\t'"$lane"$'\t'"$key"]:-0}
          [ "$plan" = 0 ] || [ "${SUGGEST:-0}" = 1 ] || continue
          row_off_set "$name" "$key" "$text"; off=$OFF kind=$KIND
          [ -z "$off" ] || [ "${SUGGEST:-0}" = 1 ] || continue
          gates=${GAT["$name"$'\t'"$lane"$'\t'"$key"]:-}
          gwait=''; [ -z "$gates" ] || gwait=$(gate_wait "$gates")
          [ -z "$gwait" ] || [ "${SUGGEST:-0}" = 1 ] || continue
          fgates=''; [ "$lane" != agent ] || [ -n "$gwait" ] || fgates=$gates
          ! floor_pass || floor_row "$name" "$text" "$fgates" "$key" || continue
          nobody=''
          if [ -n "$poff" ] || ! row_worker "$table" "$lane" "$text"; then
            # suggest shows the agent rows no worker takes too, after the ones one does.
            [ "${SUGGEST:-0}" = 1 ] && [ "$lane" = agent ] || continue
            rank=99 worker=''; row_tier_set "$text"; tier=${TIER:-null}
            if [ -n "$poff" ]; then nobody=$poff; else nobody_why_set "$table" "$lane" "$text"; nobody=$NOBODY; fi
          else
            rank=$W_RANK worker=$W_NAME tier=$W_TIER
          fi
          row_sig_set "$text"; line=$SIG
          x=${DET["$name"$'\t'"$lane"$'\t'"$key"]:-$'0\t""'}
          planned=${x%%$'\t'*} dj=${x#*$'\t'}
          detail_sig_set "$dj"; dsig=$DSIG
          held "$name" "$lane" "$key" "$line" "$dsig" && continue
          prio_rank_set "$text"; prio=$PRIO
          cleanup_row_set "$name" "$text"; cleanup=$CLEANUP
          prio_word_set "$prio" "$cleanup"; priority=$PRIORITY
          row_sprint_set "$name" "$key"; sprint=$SPRINT uncommitted=$UNCOMMITTED
          row_size_set "$text"; rsize=$SIZE
          recs+="$key$ROW_US$text$ROW_US$dj$ROW_US$dsig$ROW_US$planned$ROW_US$plan$ROW_US$line$ROW_US$prio$ROW_US"
          recs+="$priority$ROW_US$tier$ROW_US$worker$ROW_US$rank$ROW_US$cleanup$ROW_US$sprint$ROW_US$uncommitted$ROW_US$nobody$ROW_US"
          recs+="$kind$ROW_US${KIND_RANK[${kind:-_}]:-1}$ROW_US${KIND_LABEL[${kind:-_}]:-}$ROW_US$rsize$ROW_US$off$ROW_US"
          recs+="${RNK["$name"$'\t'"$lane"$'\t'"$key"]:-null}$ROW_US$gates$ROW_US$gwait$ROW_US${RLD["$name"$'\t'"$lane"$'\t'"$key"]:-}$ROW_RS"
        done <<<"$board"
        [ -z "$recs" ] || jq -Rsc --arg profile "$prof" --arg project "$name" --arg stage "$stage" \
          --arg lane "$lane" --arg repo "$repo" --arg today "$today" --arg pprio "$pprio" \
          --argjson active "$active" --arg pidle "$pidle" "$RANK_JQ$ROW_RECS_JQ"'rows_recs(
            .[0] as $key | .[1] as $text | (.[2] | fromjson) as $details | .[3] as $dsig
            | (.[4] | fromjson) as $planned | (.[5] | fromjson) as $plan | .[6] as $line | (.[7] | fromjson) as $prio
            | .[8] as $priority | (.[9] | fromjson) as $tier | .[10] as $worker | (.[11] | fromjson) as $wrank
            | (.[12] | fromjson) as $cleanup | (.[13] | fromjson) as $sprint | (.[14] | fromjson) as $uncommitted
            | .[15] as $nobody | .[16] as $kind | (.[17] | fromjson) as $krank | .[18] as $klabel | .[19] as $rsize
            | .[20] as $off | (.[21] | fromjson) as $frank | .[22] as $gates | .[23] as $gwait | .[24] as $rdue
            | {profile: $profile, project: $project, stage: $stage, lane: $lane, key: $key,
              text: $text, repo: $repo, prio: $prio, priority: $priority, tier: $tier, line: $line,
              worker: $worker, wrank: $wrank, frank: $frank, cleanup: $cleanup, sprint: $sprint, uncommitted: $uncommitted, details: $details, dsig: $dsig, planned: ($planned == 1),
              kind: $kind, krank: $krank, klabel: $klabel, row_size: $rsize}
              + (if $plan == 1 then {plan: true} else {} end)
              + (if $off != "" then {off: $off} else {} end)
              + (if $rdue != "" then {release_due: $rdue} else {} end)
              + (if $pidle != "" then {pool_idle: $pidle} else {} end)
              + (if $gwait != "" then {gate_wait: $gwait} elif $gates != "" and $lane == "agent" then {gated: true, gates: $gates} else {} end)
              + (if $nobody != "" then {nobody: $nobody, active: $active} else {} end) | rank_fields($today; $pprio))' <<<"$recs"
      done
    done < <(notes --profile "$prof" projects 2>/dev/null)
  done
}

# --- judgment ------------------------------------------------------------------------

# judge <candidates> -- one model call for the unjudged rows; every verdict lands in the cache. Each
# names the policy rule that decided it (`rule`, an id judge_rules reads from the policy) and its
# call (`judge_call`, its calls.jsonl line). Rows the reply left out are asked for once more in a
# call of their own: on 2026-11-11 ucp-469 was left out at 07:18 and judged at 07:33, but its error
# verdict held runner-score red for 24h. A row the calls could not judge gets an `error` verdict
# saying why: the call failed, the reply named no rule of the policy, or both calls left it out.
judge() {
  local cands="$1" verdicts cid rc missing rules
  [ -n "$cands" ] || return 0
  # Over the cap, each project's best-ranked row (RANK_JQ) in turn, then each one's second, and so
  # on: in rank order alone the cap re-judged the same agent-runtime rows and never reached notes-cockpit.
  # Within a round a cleanup row goes first, and rank already puts it first in its project; ahead of
  # the rounds it took every slot from a project with no cleanup (review of #1222).
  rules=$(policy_rules)
  cands=$(jq -sc --argjson max "$DISPATCH_JUDGE_MAX" "$RANK_JQ"'
      rank | to_entries | group_by(.value.project)
      | map(to_entries | map({round: .key, i: .value.key, row: .value.value})) | flatten
      | sort_by(.round, (.row.cleanup // 1), .i) | .[:$max][].row' <<<"$cands")
  [ -r "$DISPATCH_POLICY" ] || { JUDGE_WHY="no policy at $DISPATCH_POLICY"; say "$JUDGE_WHY"; return 1; }
  [ -z "$DISPATCH_SCHEMA" ] || jq -e '.properties.verdicts.type == "array"' "$DISPATCH_SCHEMA" >/dev/null 2>&1 ||
    { JUDGE_WHY="no readable schema with a verdicts array at $DISPATCH_SCHEMA"; say "$JUDGE_WHY"; return 1; }
  mkdir -p "$DIR"
  cid=$(judge_call_id)
  judge_ask "$cands" "$cid" "$rules"; rc=$?
  # A budget stop is no verdict on any row, so it leaves no error line and they are judged again.
  if [ "$rc" = "$EX_BUDGET" ]; then touch "$VERDICTS"; say "judge $JUDGE_WHY"; return "$rc"; fi
  # A pass that could not judge must not read as "no row qualifies".
  if [ "$rc" != 0 ] || [ -z "$JUDGE_VERDICTS" ]; then
    verdict_errors "$cands" "$JUDGE_WHY" "$cid" >> "$VERDICTS"
    say "judge $JUDGE_WHY for $(wc -l <<<"$cands") row(s)${JUDGE_REPLY:+: $JUDGE_REPLY}"; return 1
  fi
  verdicts=$JUDGE_VERDICTS
  printf '%s\n' "$verdicts" >> "$VERDICTS"
  size_back "$cands" "$verdicts"
  missing=$(judge_missing "$cands" "$verdicts")
  [ -n "$missing" ] || return 0
  say "judge: the reply left out $(wc -l <<<"$missing") row(s), asking again for them"
  cid=$(judge_call_id)
  judge_ask "$missing" "$cid" "$rules"; rc=$?
  # A retry stopped at its budget leaves no error line either; the pass names the stop (settle).
  if [ "$rc" = "$EX_BUDGET" ]; then JUDGE_WHY="the retry for $(wc -l <<<"$missing") left-out row(s) $JUDGE_WHY"; say "judge: $JUDGE_WHY"; return "$rc"; fi
  if [ "$rc" != 0 ]; then
    verdict_errors "$missing" "the reply had no verdict for this row, and the retry $JUDGE_WHY" "$cid" >> "$VERDICTS"
    return 0
  fi
  [ -z "$JUDGE_VERDICTS" ] || { printf '%s\n' "$JUDGE_VERDICTS" >> "$VERDICTS"; size_back "$missing" "$JUDGE_VERDICTS"; }
  verdict_errors "$(judge_missing "$missing" "$JUDGE_VERDICTS")" "neither the reply nor its retry had a verdict for this row" "$cid" >> "$VERDICTS"
}

# judge_ask <rows> <call id> <policy rule ids> -- one model call for <rows>; on success sets
# JUDGE_VERDICTS to the reply's verdict lines for <rows> (a rule the policy lacks is an `error` line;
# a verdict on a row not asked is dropped, so a retry cannot re-record one judged already), else
# JUDGE_WHY to why and returns the call's code (EX_BUDGET for a budget stop). JUDGE_REPLY is the
# reply's head, for the log line of a reply with no verdicts.
judge_ask() {
  local rows n prompt wd out rc err schema=()
  JUDGE_VERDICTS='' JUDGE_REPLY=''
  # Rows are numbered and counted: on 2026-11-07 two 40-row passes came back with 39 verdicts,
  # each dropping one row whole (hc-122, ar-269), and a dropped row is asked for again.
  # The count is of the numbered lines themselves, so the two never disagree. Asking was not
  # enough (2026-11-11, ucp-469 dropped from 41), so the call's schema holds the reply to it too.
  rows=$(jq -c '{project, stage, lane, key, text, tier} + (if (.row_size // "") != "" then {size: .row_size} else {} end)
    + (if (.details // "") != "" then {details} else {} end)' <<<"$1" | awk '{ print NR ". " $0 }')
  n=$(grep -c . <<<"$rows")
  prompt="## Rows to judge

$rows

## Answer

There are $n rows above. Return exactly $n verdicts in the structured output, one per numbered row, in the same order. Copy project, lane and key exactly as given."
  # The call runs in an empty directory: from inside a repo, that repo's Stop hook runs its
  # tests after the answer, and the model's last message becomes a reply to the hook instead
  # of the verdicts (2026-10-27, run from ~/.dotfiles: every pass failed on one row).
  wd=$(mktemp -d)
  # Claude Code checks the reply against this schema and hands a short one back to the model in
  # the same call, so a dropped row is usually answered there; judge asks once more for the rest.
  if [ -n "$DISPATCH_SCHEMA" ]; then
    # The rule is held to the policy's ids too: "(stage)" (now stage-scope), copied with the policy's parentheses, was
    # an error verdict on 2026-11-14 that kept runner-score red for a day.
    jq --argjson n "$n" --argjson rules "$3" '.properties.verdicts += {minItems: $n, maxItems: $n}
        | if ($rules | length) > 0 then .properties.verdicts.items.properties.rule += {enum: $rules} else . end' "$DISPATCH_SCHEMA" > "$wd/schema.json" ||
      { rm -rf -- "$wd"; JUDGE_WHY="could not read the schema at $DISPATCH_SCHEMA"; return 1; }
    schema=(--schema "$wd/schema.json")
  fi
  # shellcheck disable=SC2086 # the command is a word list by design (overridable in tests)
  out=$(cd "$wd" && AGENTCTL_CALL_ID="$2" $DISPATCH_JUDGE_CMD ${schema[@]+"${schema[@]}"} -p "$prompt" 2>"$wd/err")
  rc=$?
  err=$(head -c 200 "$wd/err" | tr '\n' ' ')
  rm -rf -- "$wd"
  if [ "$rc" = "$EX_BUDGET" ]; then JUDGE_WHY="stopped at its budget"; return "$rc"; fi
  if [ "$rc" != 0 ]; then JUDGE_WHY="call failed (exit $rc)${err:+: $err}"; return "$rc"; fi
  # The reply is the schema's one object (SCHEMA in the agent's conf); prose yields no verdicts.
  JUDGE_VERDICTS=$(jq -c '.verdicts[]?' <<<"$out" 2>/dev/null |
    jq -c --arg at "$(date -Iseconds)" --arg sig "$(policy_sig)" --arg call "$2" --argjson rules "$3" \
      --argjson c "$(jq -sc 'map({k: ([.project, .lane, .key] | tostring), line, dsig})' <<<"$1")" '
      select(type == "object"
        and (.project | type) == "string" and (.lane | type) == "string"
        and (.key | type) == "string" and (.verdict == "dispatch" or .verdict == "skip"))
      | ([.project, .lane, .key] | tostring) as $k | select(any($c[]; .k == $k))
      | {project, lane, key, tier, size, area, clear, agent_only, verdict, rule, reason, at: $at,
         policy: $sig, line: ([$c[] | select(.k == $k) | .line] | first),
         dsig: ([$c[] | select(.k == $k) | .dsig] | first), judge_call: $call}
      | . as $v | if any($rules[]; . == $v.rule) then $v
        else {project, lane, key, verdict: "error", reason: "rule \(.rule // "" | tojson) is not in the policy",
              at, policy, line, judge_call} end')
  [ -n "$JUDGE_VERDICTS" ] || { JUDGE_WHY="the reply had no verdicts"; JUDGE_REPLY=${out:0:200}; }
}

# judge_missing <rows> <verdicts> -> each of <rows> no verdict line names.
judge_missing() {
  jq -c --argjson got "$(jq -sc 'map([.project, .lane, .key] | tostring)' <<<"$2")" \
    'select(([.project, .lane, .key] | tostring) as $k | any($got[]; . == $k) | not)' <<<"$1"
}

# size_back <candidates> <verdicts> -- tag each unsized row (with an id) the judge sized with that
# `#size/`, so the row is the one size store (the human's choice, ask Q0lKDF). The verdict is then
# recorded again for the row's new text, which differs only by that tag, so it is not judged twice.
size_back() {
  local prof p lane key s raw flag
  while IFS=$'\t' read -r prof p lane key s; do
    flag=(); [ "$lane" = agent ] && flag=(--agent)
    np "$prof" ptask "$p" "${flag[@]}" tag --add "size/$s" "$key" >/dev/null 2>&1 || { say "size_back: could not tag $p $key size/$s"; continue; }
    raw=$(row_line "$prof" "$p" "$lane" "$key")
    [ -n "$raw" ] || continue
    jq -c --arg p "$p" --arg l "$lane" --arg k "$key" --arg line "$(row_sig "$raw")" \
      'select(.project == $p and .lane == $l and .key == $k) | . + {line: $line}' <<<"$2" >> "$VERDICTS"
  done < <(jq -r --slurpfile c <(printf '%s\n' "$1") '
    ($c | map({key: ([.project, .lane, .key] | tostring), value: .}) | from_entries) as $by
    | $by[[.project, .lane, .key] | tostring] as $r
    | select($r != null and ($r.row_size // "") == "" and .verdict != "error"
        and ((.size // "") | IN("S", "M", "L")) and (.key | test("^[a-z]{2,4}-[0-9]+$")))
    | [$r.profile, .project, .lane, .key, (.size | ascii_downcase)] | @tsv' <<<"$2")
}

# verdict_errors <rows> <reason> <call id> -- an `error` verdict line for each row. judged_keys
# skips errors, so the next pass judges those rows again.
verdict_errors() {
  [ -n "$1" ] || return 0
  jq -c --arg r "$2" --arg call "$3" --arg at "$(date -Iseconds)" --arg sig "$(policy_sig)" \
    '{project, lane, key, verdict: "error", reason: $r, at: $at, policy: $sig, line, judge_call: $call}' <<<"$1"
}

# skip_exits [--dry-run] -- give each open agent row whose latest verdict is a skip, still current
# for the row's text, the exit its rule names (policy.md "Always skip"), so no skip parks a row:
#  - plan (DISPATCH_PLAN_RULES): tag it #plan, and #go beside it on a #requested row (the judge asked
#    for this plan, not the person, so inbox-plan does not hold it for their review), while fewer than
#    DISPATCH_PLAN_BACKLOG #plan rows are open, then kick inbox-plan; its plan splits or rewrites the
#    row, so the judge reads it again with the plan. A row the rest wait behind keeps its verdict and
#    is tagged on a later pass. A row inbox-plan already planned (a `goal:` detail) that the judge,
#    reading that plan, still skips by such a rule takes the human exit: a second plan would not help.
#  - human (DISPATCH_HUMAN_RULES): an #urgent, #high, bare or #requested row is filed on the human sheet
#    (human_sheet_row), a #low one kept in improvements.md (`notes improve`) unless an open row gates
#    #after/ on it (then the sheet, whose row follow_moved_gates moves that gate to), its #worker/ tag off
#    so no worker takes it there; then the agent row is dropped with a --why naming where it went.
#  - waits: gated #after/<row> on the first open row its verdict's reason, else its text, names (its
#    own id and #of/ links aside) or #pr/<owner>/<repo>/<N> on a PR named so, when the judge read the
#    rest of it as one it would start (S or M, clear, agent-only, one area): a cleared gate starts a
#    row with no verdict. Any other waits skip takes the plan exit.
#  - kind: a row of a kind kinds.json turns off (epic aside, and not a parent) never reaches the judge,
#    so with no verdict it takes the human exit, as rule `kind`: no worker or judge reads it on the lane.
# Each exit taken appends the verdict again with `exit` (and `exit_at`) to verdicts.jsonl, so counting
# exits is a jq query, and that latest verdict, carrying its exit, is not taken again. At most
# DISPATCH_EXIT_MAX exits a pass (0 is no cap), so a backlog of skips drains over passes, not in one. A
# row already started is left alone. --dry-run writes
# nothing and prints `<exit> TAB <project> TAB <id> TAB <rule>` per row (`plan-wait` for a plan row
# past the room), then the counts. Sets PLAN_TAGGED and EXITS_TAKEN.
skip_exits() {
  local dry='' board rows room p prof id raw line dsig dj rule req prio planned d e body why where gate
  local -a add
  local -A ids=() n=()
  case "${1:-}" in
    '') ;;
    --dry-run) dry=1 ;;
    *) say "usage: fleet-dispatch exits [--dry-run]"; return 2 ;;
  esac
  PLAN_TAGGED=0 EXITS_TAKEN=0
  board=$(notes board --json 2>/dev/null) || { say "skip_exits: notes board --json failed"; return 0; }
  room=$(jq -r "$ROW_JQ"'[.rows[]? | select(plan_tagged)] | length' <<<"$board")
  room=$(( DISPATCH_PLAN_BACKLOG - ${room:-0} ))
  while IFS= read -r id; do [ -z "$id" ] || ids[$id]=1; done < <(jq -r '.rows[]? | select(.id != null) | .id' <<<"$board")
  # gated[<row id>]: an open row waits on it (#after/), so its exit must leave a row for that gate to
  # follow (follow_moved_gates); improvements.md leaves none, and the gate would read dead (ar-1380).
  local -A gated=()
  while IFS= read -r id; do [ -z "$id" ] || gated[$id]=1; done < <(jq -r '.rows[]? | select(.state == "open" or .state == "doing")
    | (.tags_cased // .tags // [])[] | select(startswith("after/")) | .[6:]' <<<"$board")
  # A row of a kind kinds.json turns off (not epic) never reaches the judge, so it has no verdict: it
  # takes the human exit as rule `kind`, its line `-` (no verdict to hold), unless it is a parent or its
  # latest verdict already carries an exit, of any rule (a drop that failed: no second copy).
  local kinds
  kinds=$(jq -ce 'objects' "$DISPATCH_KINDS" 2>/dev/null) ||
    { say "skip_exits: no kind registry at $DISPATCH_KINDS: no kind exit this pass"; kinds='{}'; }
  rows=$(jq -r --argjson prules "$(policy_rules)" --argjson n "$DISPATCH_DETAIL_CHARS" \
      --argjson kinds "$kinds" \
      --arg at "$(date -Iseconds)" --arg sig "$(policy_sig)" \
      --slurpfile v <(latest_verdicts) "$ROW_JQ"'
    ($v | map(select(.lane == "agent" and .verdict == "skip" and .exit == null and usable($prules)))
       | map({key: "\(.project)\t\(.key)", value: .}) | from_entries) as $by
    | ($v | map(select(.lane == "agent" and .exit != null))
       | map({key: "\(.project)\t\(.key)", value: true}) | from_entries) as $gone
    | ($kinds | to_entries | map(select(.value.enabled == false and .key != "epic") | {key, value: true}) | from_entries) as $off
    | ([.rows[]? | select(.state == "open") | .tags[]? | select(startswith("of/")) | {key: .[3:], value: true}] | from_entries) as $parents
    | .rows[]? | select(.lane == "agent" and .state == "open" and .id != null and (plan_tagged | not))
    | $by["\(.project)\t\(.id)"] as $d
    | if $d != null then
        "\(.profile)\t\(.project)\t\(.id)\t\($d.line)\t\($d.dsig // "-")\t\(details_json($n))\t\($d.rule)\t\(.requested == true)\t\(planned)\t\($d | tojson)\t\(.raw)"
      elif $off[.type // ""] and ($parents[.id] | not) and ($gone["\(.project)\t\(.id)"] | not) then
        "\(.profile)\t\(.project)\t\(.id)\t-\t-\t\(details_json($n))\tkind\t\(.requested == true)\tfalse\t\({project, lane: "agent", key: .id, verdict: "skip", rule: "kind", reason: "kind \(.type) is off", at: $at, policy: $sig} | tojson)\t\(.raw)"
      else empty end' <<<"$board")
  # raw last: read hands it the rest of the line; details_json and the verdict are JSON, with no bare
  # tab. No field is empty: a tab is IFS whitespace, so read would fold an empty one into its neighbour
  while IFS=$'\t' read -r prof p id line dsig dj rule req planned d raw; do
    [ -n "$id" ] || continue
    # the verdict must still hold for the row as it reads now (ROW_JQ holds)
    [ "$rule" = kind ] || [ "$(row_sig "$raw")" = "$line" ] || continue
    [ "$dsig" = - ] || [ "$(detail_sig "$dj")" = "$dsig" ] || continue
    body=${raw#- \[?\] }; body=${body%%<!--*}; body=${body%"${body##*[![:space:]]}"}
    e='' gate=''
    if [ "$rule" = waits ]; then
      gate=$(waits_gate "$id" "$(jq -r '.reason // ""' <<<"$d")" "$body")
      if [ -n "$gate" ] && [[ $gate == after/* ]] && [ -z "${ids[${gate#after/}]:-}" ]; then gate=''; fi
      [ -n "$gate" ] && jq -e '(.size | IN("S", "M")) and .clear == true and .agent_only == true and ((.area // "") != "")' <<<"$d" >/dev/null || gate=''
      if [ -n "$gate" ]; then e=gate; else e=plan; fi
    elif [[ " $DISPATCH_PLAN_RULES " == *" $rule "* ]]; then e=plan
    elif [[ " $DISPATCH_HUMAN_RULES " == *" $rule "* ]] || [ "$rule" = kind ]; then e=human
    fi
    [ -n "$e" ] || continue
    if [ "$e" = plan ] && [ "$planned" = true ]; then
      # a plan made before the verdict that dsig cannot date: the judge may not have read it yet
      [ "$dsig" != - ] || continue
      e=human
    fi
    if [ "$e" = human ]; then
      prio=$(prio_rank "$body")
      if [ "$req" = true ] || [ "$prio" -le 1 ] || [ -n "${gated[$id]-}" ]; then e=sheet; else e=improve; fi
    fi
    if [ "$e" = plan ] && [ "$room" -le 0 ]; then
      [ -z "$dry" ] || { printf 'plan-wait\t%s\t%s\t%s\n' "$p" "$id" "$rule"; n[plan-wait]=$(( ${n[plan-wait]:-0} + 1 )); }
      continue
    fi
    if [ -n "$dry" ]; then
      printf '%s\t%s\t%s\t%s\n' "${gate:-$e}" "$p" "$id" "$rule"
      n[$e]=$(( ${n[$e]:-0} + 1 )); [ "$e" != plan ] || room=$(( room - 1 ))
      continue
    fi
    [ "$DISPATCH_EXIT_MAX" = 0 ] || [ "$EXITS_TAKEN" -lt "$DISPATCH_EXIT_MAX" ] || break
    if [ "$rule" = kind ]; then why="dispatch never starts it: $(jq -r '.reason // ""' <<<"$d") (kinds.json)"
    else why="dispatch skipped it ($rule): $(jq -r '.reason // ""' <<<"$d")"; fi
    case "$e" in
      plan)
        add=(--add plan); [ "$req" = true ] && add+=(--add go)
        np "$prof" ptask "$p" --agent tag "${add[@]}" "$id" >/dev/null 2>&1 || { say "skip_exits: could not tag $p $id for a plan"; continue; }
        PLAN_TAGGED=$(( PLAN_TAGGED + 1 )); room=$(( room - 1 )) ;;
      gate)
        np "$prof" ptask "$p" --agent tag --add "$gate" "$id" >/dev/null 2>&1 || { say "skip_exits: could not gate $p $id #$gate"; continue; }
        e=$gate ;;
      sheet | improve)
        body=$(sed -E 's/(^|[[:space:]])#worker\/[^[:space:]]+//g; s/^[[:space:]]+//' <<<"$body")
        if [ "$e" = sheet ]; then
          where=$(human_sheet_row "$(jq -cn --arg pr "$prof" --arg p "$p" '{profile: $pr, project: $p}')" "$body (agent row $id)")
          case "$where" in "not filed"*) say "skip_exits: $p $id $where"; continue ;; esac
        else
          np "$prof" improve "$p" --why "$why" -- "$body" >/dev/null 2>&1 || { say "skip_exits: notes improve refused $p $id"; continue; }
          where="kept in $p improvements.md"
        fi
        # Filed is the exit: a drop that fails is said and its exit recorded all the same, so a later pass
        # files no second copy; the agent row stays open for a hand drop.
        np "$prof" ptask "$p" --agent drop "$id" --why "$where: $why" >/dev/null 2>&1 ||
          say "skip_exits: $p $id is $where, but the agent row would not drop: drop it by hand" ;;
    esac
    EXITS_TAKEN=$(( EXITS_TAKEN + 1 ))
    mkdir -p "$DIR"   # a kind exit can be the first verdict on record
    jq -c --arg e "$e" --arg at "$(date -Iseconds)" '. + {exit: $e, exit_at: $at}' <<<"$d" >> "$VERDICTS"
  done <<<"$rows"
  if [ -n "$dry" ]; then
    for e in "${!n[@]}"; do printf '%s %s\n' "$e" "${n[$e]}"; done | sort | paste -sd' ' | sed 's/^/exits: /'
    return 0
  fi
  [ "$EXITS_TAKEN" = 0 ] || say "gave $EXITS_TAKEN skipped row(s) their exit"
  [ "$PLAN_TAGGED" = 0 ] && return 0
  say "tagged $PLAN_TAGGED for a plan"
  "$HERE/agentctl-inbox-plan" --kick || say "skip_exits: could not start inbox-plan"
}

# waits_gate <own id> <text>... -> the gate a waits skip waits behind: `pr/<owner>/<repo>/<N>` for the
# first `<owner>/<repo>#<N>`, else `after/<id>` for the first row id (not <own id>, not an #of/ or
# #after/ link), searching each text in turn; nothing when none names one.
waits_gate() {
  local own="$1" t m
  shift
  for t in "$@"; do
    t=$(sed -E 's/(^|[[:space:]])#(of|after)\/[^[:space:]]*//g' <<<"$t")
    m=$(grep -oE '\b[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+\b' <<<"$t" | awk 'NR==1')
    [ -z "$m" ] || { echo "pr/${m%#*}/${m##*#}"; return 0; }
    m=$(grep -oE '\b[a-z]{2,4}-[0-9]+\b' <<<"$t" | grep -vxF -- "$own" | awk 'NR==1')
    [ -z "$m" ] || { echo "after/$m"; return 0; }
  done
}

# suggest [--json] -- the Candidates list: every open agent-lane row (and every row a worker takes)
# of each project from dev up with a repo, in each DISPATCH_PROFILES profile (the list `run` reads), in RANK_JQ order. Each
# carries `why`; `auto`, whether a worker in workers.json takes it (widening one is a line there);
# `verdict`, the latest under this policy for this text, or `unjudged`; `held`, whether an active
# queue item holds its area (never on a row judged tier 3, which no area holds); and `blocked`, every counted reason it would not start (nobody_why,
# a gate not yet clear (gate_wait), size, the judge's skip, a held area; a row whose gates cleared
# reads neither size nor skip, as picks does not), with `active` on a row no worker takes when its repo moved
# in the last day. Display only: it never judges, claims or queues. `--write` stores it for the hub
# Candidates fold (candidates_write); each real `run` does that.
cmd_suggest() {
  local cands
  load_gates; load_pool_idle
  cands=$(SUGGEST=1 VERDICTS=/dev/null cmd_candidates)
  [ -n "$cands" ] || { [ "${1:-}" = --json ] || echo "suggest: no open agent row"; return 0; }
  jq -sc --arg sig "$(policy_sig)" --argjson games "$(game_areas <<<"$cands")" --argjson prules "$(policy_rules)" --slurpfile v <(latest_verdicts) \
    --argjson busy "$(queue_areas | jq -Rsc 'split("\n") | map(select(length > 0) | ascii_downcase)')" "$RANK_JQ$ROW_JQ"'
    ($v | map({key: ([.project, .lane, .key] | tostring), value: .}) | from_entries) as $by
    | map(. as $c | $by[[.project, .lane, .key] | tostring] as $d
      | . + {auto: (.worker != ""), area: row_area($d; $games), stale: ($d != null and $d.verdict != "failed" and $d.policy != $sig),
             verdict: (if $d == null then "unjudged" elif $d.verdict == "failed" then "failed"
                       elif ($d | usable($prules) | not) or ($d | holds($c) | not) then "unjudged" else $d.verdict end)}
      | . + {held: (.area != "" and $d.tier != 3 and ("\(.project | ascii_downcase)/\(.area)" as $a | $busy | index($a)) != null),
             size: eff_size($d), reason: ($d.reason // "")})
    | map(. + {blocked: [(.off // empty), (.nobody // empty), (if .plan then "waits on a plan" else empty end), (.gate_wait // empty),
        (if (.gated | not) and (.size | IN("L", "XL")) then "size/l: too big for a pick" else empty end),
        (if ((.gated | not) and .verdict == "skip") or .verdict == "failed" then "judge: \(.verdict)\(if .reason != "" then ", \(.reason)" else "" end)" else empty end),
        (if .held then "area held by a queue item" else empty end)]})
    | rank | .[]' <<<"$cands" |
    if [ "${1:-}" = --json ]; then cat; else
      jq -r '"\(if .auto then "auto" else "man " end)  \(.verdict | .[0:8] | . + " " * (8 - length))  \(.project) \(.key)  [\(.why)]\(if (.blocked | length) > 0 then "  blocked: \(.blocked | join("; "))" else "" end)"'
    fi
}

# candidates_write -- `suggest --write`: the snapshot the hub Candidates fold reads, so no view pays a
# live suggest (55s on 1,600 rows, 2026-11-09). Written whole or not at all: a failed read, or an
# empty one while notes does not answer (suggest reads that as no rows), leaves the last one
# standing, and the fold's `as of` shows its age. An empty read with notes up is an empty list.
candidates_write() {
  local why=
  mkdir -p "${CANDIDATES%/*}"
  if ! cmd_suggest --json > "$CANDIDATES.$$"; then why="suggest failed"
  elif [ ! -s "$CANDIDATES.$$" ] && ! notes projects --stats --json >/dev/null 2>&1; then why="notes did not answer"
  fi
  if [ -z "$why" ]; then mv -f "$CANDIDATES.$$" "$CANDIDATES"; return 0; fi
  rm -f "$CANDIDATES.$$"; say "suggest --write: $why, the candidates snapshot is left as it was"; return 1
}

# candidates_drop <project> <lane> <key> -- take a promoted row out of the snapshot now, so the fold
# does not offer it again until the next pass rewrites the file. The mtime is the pass's, since the
# fold's `as of` is when the list was computed.
candidates_drop() {
  [ -s "$CANDIDATES" ] || return 0
  jq -c --arg p "$1" --arg l "$2" --arg k "$3" 'select(.project != $p or .lane != $l or .key != $k)' \
    "$CANDIDATES" > "$CANDIDATES.$$" 2>/dev/null && touch -r "$CANDIDATES" "$CANDIDATES.$$" \
    && mv -f "$CANDIDATES.$$" "$CANDIDATES" || rm -f "$CANDIDATES.$$"
}

# latest verdict per row, as JSON lines, of those in force (in_force): a row its failures hold reads
# `failed`, and one whose failure expired its verdicts reads none until it is judged again. An
# `error` record does not replace an earlier verdict: a call that failed or named no rule says
# nothing about the row, so its stale-but-usable verdict stays and the row is judged again
# (judged_keys skips errors); with no other, the error shows.
latest_verdicts() {
  [ -f "$VERDICTS" ] || return 0
  jq -cRn --argjson tries "$DISPATCH_FIX_TRIES" "$IN_FORCE_JQ"'[inputs | fromjson? | objects] | group_by([.project, .lane, .key])[]
    | in_force($tries) | ((map(select(.verdict != "error")) | last) // last) | values' "$VERDICTS" 2>/dev/null
}

# picks <candidates> <room> -> the rows to launch: the row's latest verdict is a dispatch made
# under a policy that still defines its rule, for its current text, S or M, clear, agent-only, naming one area, and
# judged no higher a tier than the row counts as (all checked here too, so a lax verdict cannot
# launch anything); never two on an area, held by an active item or picked now; in RANK_JQ order.
# A `gated` row (cmd_candidates: its gates all cleared) is committed work: no verdict or size
# is asked of it, only the tier ceiling, and a `failed` verdict (its session died) still holds it. It
# keeps the area a verdict named, so the area rule still holds it; with none it is its own (area_key).
picks() {
  local cands="$1" room="$2"
  [ "$room" -gt 0 ] && [ -n "$cands" ] || return 0
  jq -sc --argjson room "$room" --argjson games "$(game_areas <<<"$cands")" --argjson prules "$(policy_rules)" --argjson max "$UNATTENDED_TIER_CEILING" \
    --argjson busy "$(queue_areas | jq -Rsc 'split("\n") | map(select(length > 0) | ascii_downcase)')" \
    --slurpfile v <(latest_verdicts) "$RANK_JQ$ROW_JQ"'
    ($v | map({key: ([.project, .lane, .key] | tostring), value: .}) | from_entries) as $by
    | map(. as $c | $by[[.project, .lane, .key] | tostring] as $d
      | if $c.gated == true then
          select(($d == null or $d.verdict != "failed") and ($c.tier | type) == "number" and $c.tier <= $max) | . + {area: row_area($d; $games)}
        else
          select($d != null and $d.verdict == "dispatch" and (eff_size($d) | IN("S", "M"))
              and $d.clear == true and $d.agent_only == true and ($d | usable($prules)) and ($d | holds($c))
              and ($d.tier | type) == "number" and $d.tier <= $c.tier and $c.tier <= $max
              and ($d.area | type) == "string" and $d.area != "")
          | . + {area: row_area($d; $games)} end)
    | map(select(.area == "" or ("\(.project | ascii_downcase)/\(.area)" as $a | $busy | index($a) | not)))
    | rank | unique_by([.project, area_key]) | rank
    | .[:$room] | .[]' <<<"$cands"
}

# --- launch --------------------------------------------------------------------------

# new_sid -> a fresh session id for `claude --session-id`, so the item claims it before the pane
# starts and the session's preflight never takes the queue lock.
new_sid() {
  local u
  u=$(cat /proc/sys/kernel/random/uuid 2>/dev/null || uuidgen 2>/dev/null) && [ -n "$u" ] || return 1
  printf '%s\n' "$u" | tr '[:upper:]' '[:lower:]'
}

# launch_mode <mode> -- set the caller's flags and ready: claude's flags for that mode, and the
# footer that shows it came up. A session in any mode but bypass may still need bypass later (a
# plan once approved), and claude offers it then only when it was allowed at launch.
launch_mode() {
  case "$1" in
    bypassPermissions) flags="--permission-mode bypassPermissions" ready="bypass permissions on" ;;
    plan) flags="--permission-mode plan --allow-dangerously-skip-permissions" ready="plan mode on" ;;
    *) flags="--permission-mode $(printf '%q' "$1") --allow-dangerously-skip-permissions" ready='' ;;
  esac
}

# dropped_tools <item json> -- " --disallowedTools <list>" for a queue item's claude start or resume,
# or nothing. The list is CLAUDE_AUTO_DROP_TOOLS, read the way telemetry_env reads the launch env, so
# an env value wins and the default lives once, in claude-telemetry.sh (which says why). A task that
# names one of them, ultracode or /loop keeps every tool. That file also refuses a value that is not a
# list of tool names, on stderr, which is why only its stdout is discarded here.
# It goes before --permission-mode: the flag takes a list, so the brief after it would join it.
dropped_tools() {
  local drop f="$HOME/.config/shared-hooks/claude-telemetry.sh"
  [ -r "$f" ] || { say "$f is missing, so this start drops no tools"; return 0; }
  # shellcheck disable=SC2016
  drop=$(bash -c '. "$1" >/dev/null; printf %s "${CLAUDE_AUTO_DROP_TOOLS-}"' _ "$f")
  [ -n "$drop" ] || return 0
  jq -r .task <<<"$1" | grep -qiE "ultracode|/loop|${drop//,/|}" && return 0
  printf ' --disallowedTools %s' "$drop"
}

# claude_effort <item json> -- " --effort <level>" for a claude start or resume of an item that carries
# an effort (a canary lane's), or nothing. A level claude does not take refuses the start (rc 2), so a
# typo never runs, and scores, at the default effort under the lane's name.
claude_effort() {
  local e; e=$(jq -r '.effort // empty' <<<"${1:-null}")
  case "$e" in
    '') ;;
    low | medium | high | xhigh | max) printf ' --effort %s' "$e" ;;
    *) say "start: effort '$e' is not one claude takes (low, medium, high, xhigh, max)"; return 2 ;;
  esac
}

# claude_pin <item json> -> the model a claude item names before any start ran it (a canary lane's,
# fleet-bench canary queue --model): a pin like --model, so the lane is the model it says. A model a
# start recorded (the item has sessions) is not one, so a requeued item is picked afresh.
claude_pin() { jq -r 'select((.agent // "claude") == "claude" and (.sessions // "") == "") | .model // empty' <<<"${1:-null}"; }

# lane_sandbox <cwd> -- set the caller's sbx_env and sbx_flags for a claude start under
# DISPATCH_SANDBOX_PROFILE, both empty when the knob is empty (the lane runs as before). The profile
# and the lane's GitHub token go through lib/sandbox.sh, the code agentctl-run runs a lane under, so a
# session and a runner cannot drift: the hard gates are forced on, the git common dir of <cwd> is
# writable. The token reaches the pane as a file read by its shell, never on the launch line. rc 1 and
# no start when the profile is missing, malformed or unreadable (the item stays queued). With a
# worker <host>, that worker builds both (`fleet-dispatch lane-sandbox` there), from its own HOME,
# repo and token file, since the session runs there.
lane_sandbox() {
  local json out
  sbx_env='' sbx_flags=''
  [ -n "$DISPATCH_SANDBOX_PROFILE" ] || return 0
  if [ -n "${2:-}" ]; then
    out=$(fleet_host_run "$2" env DISPATCH_SANDBOX_PROFILE="$DISPATCH_SANDBOX_PROFILE" DISPATCH_SANDBOX_GH_TOKEN_FILE="$DISPATCH_SANDBOX_GH_TOKEN_FILE" fleet-dispatch lane-sandbox "$1") && [ -n "$out" ] ||
      { say "start: $2 cannot apply lane sandbox '$DISPATCH_SANDBOX_PROFILE' (fleet-dispatch lane-sandbox there); nothing started"; return 1; }
    { IFS= read -r sbx_env; IFS= read -r sbx_flags; } <<<"$out"
    return 0
  fi
  # lib/sandbox.sh refuses through role_die (agentctl-run's, which exits). It is defined inside this
  # subshell so the exit ends the load and never the dispatcher, and no global copy of it can drift.
  json=$(role_die() { say "$*"; exit 78; }
    cd "$1" && SANDBOX_PROFILE=$DISPATCH_SANDBOX_PROFILE GH_TOKEN_FILE=$DISPATCH_SANDBOX_GH_TOKEN_FILE && sandbox_load && sandbox_claude_settings) && [ -n "$json" ] ||
    { say "start: lane sandbox '$DISPATCH_SANDBOX_PROFILE' cannot be applied; nothing started"; return 1; }
  sbx_flags=" --settings $(printf '%q' "$json")"
  if [ -n "$DISPATCH_SANDBOX_GH_TOKEN_FILE" ]; then
    sbx_env="GH_TOKEN=\"\$(tr -d '[:space:]' < $(printf '%q' "$DISPATCH_SANDBOX_GH_TOKEN_FILE"))\" env -u GITHUB_TOKEN "
  else
    sbx_env='env -u GH_TOKEN -u GITHUB_TOKEN '
  fi
}

# cmd_lane_sandbox <cwd> -- lane_sandbox here for a dispatcher's start --host: its sbx_env, then its
# sbx_flags, one line each.
cmd_lane_sandbox() { local sbx_env sbx_flags; lane_sandbox "$1" || return 1; printf '%s\n%s\n' "$sbx_env" "$sbx_flags"; }

# last_mode <id> -> the permission mode it last ran in, from the transcript, which outlives its
# server: a permission-mode line, or the mode on a user turn, whichever is last.
last_mode() {
  local t
  t=$(compgen -G "$HOME/.claude/projects/*/$1.jsonl" | awk 'NR==1')
  [ -n "$t" ] || return 0
  tac "$t" | grep -m1 -o '"permissionMode":"[A-Za-z]*"' | cut -d'"' -f4
}

# resume_mode <id> <item mode> -> the mode a resume reopens in: the transcript's last one, else plan
# for a plan item (a resume must not skip its approval), else bypassPermissions.
resume_mode() {
  local m; m=$(last_mode "$1")
  if [ -n "$m" ]; then echo "$m"; elif [ "$2" = plan ]; then echo plan; else echo bypassPermissions; fi
}

# start_ready <server> <session> <pane> <ready text> [host] -- an account that never opened this folder asks "Do you
# trust this folder?" first, defaulting to "No, exit". claude-acct trust answers it once and waits
# for claude's mode footer, on the machine whose tmux holds the pane: a worker's own, over ssh. Run
# here for a worker pane, it waited on a session this machine does not have, and every razer-laptop
# start sat on the prompt (2026-11-18).
start_ready() {
  if [ -n "${5:-}" ]; then
    fleet_host_run "$5" claude-acct trust "$1" "$3" "$4" >/dev/null || say "$2: claude on $5 did not show \"$4\"; look at its pane there"
    return 0
  fi
  command -v claude-acct >/dev/null 2>&1 || return 0
  claude-acct trust "$1" "$3" "$4" >/dev/null || say "$2: claude did not show \"$4\"; look at its pane"
}

# harness_launcher <harness> -> the wrapper that runs it: its `launcher` in the map, else its own name.
harness_launcher() { jq -er --arg h "$1" '.harnesses[$h].launcher // $h' "$HARNESSES" 2>/dev/null || echo "$1"; }

# The launchers whose runs go through the LiteLLM gateway (gateway_launch): codex, claude-cloud and claude do not.
# SPENDS_GATEWAY_JQ: true for an item (or {agent: <harness>}) whose harness, by its launcher, spends it.
GATEWAY_LAUNCHERS='["opencode","claude-lazer"]'
SPENDS_GATEWAY_JQ='(.agent // "claude") as $a | ($map[0].harnesses[$a].launcher // $a) as $l | $gl | index($l) != null'

# harness_spends_gateway <harness> -- rc 0 when its runs go through the LiteLLM gateway.
harness_spends_gateway() {
  jq -ne --arg h "$1" --slurpfile map "$HARNESSES" --argjson gl "$GATEWAY_LAUNCHERS" "{agent: \$h} | $SPENDS_GATEWAY_JQ" >/dev/null 2>&1
}

# harness_key_file <harness> -> the key file it spends: its own `key_file`, else the gateway's (the eval key).
harness_key_file() { jq -r --arg h "$1" '(.harnesses[$h].key_file // .gateway.key_file) | sub("^~"; env.HOME)' "$HARNESSES"; }

# harness_source <harness> -> the source its runs spend, its `source` in the map (a row of claude-acct's
# sources file; claude-acct is the one reader of how much that source has left).
harness_source() { jq -r --arg h "$1" '.harnesses[$h].source // empty' "$HARNESSES" 2>/dev/null; }

# harness_route <harness> <model> -> the gateway's name of the model's route, whose deployment budget
# the source's key budget does not show: an opencode id is <provider>/<gateway model>, every other
# launcher passes the gateway's name. Nothing for a model the harness does not map.
harness_route() {
  local id
  id=$(jq -r --arg h "$1" --arg m "$2" '.harnesses[$h].models[$m] // empty' "$HARNESSES" 2>/dev/null)
  [ "$(harness_launcher "$1")" != opencode ] || id=${id#*/}
  printf '%s' "$id"
}

# harness_ready_why <harness> -> why this machine cannot run it as a fleet worker does, rc 1, or nothing.
# A worker runs codex, on its own ChatGPT login (the codex and agent-codex it runs), and a sandboxed
# opencode harness (headless, its own config_dir) or agy harness (agy and agent-agy, on its own
# Google login), which need the map entry, the launcher, the lane sandbox's profile and srt's tools
# (SANDBOX_SRT_NEEDS); opencode also its config and key file. The map, the configs and the profiles
# come with the private overlay; the key files and srt with home-config's fleet-worker role; the
# codex and agy logins are the human's (`codex login`, `agy` there).
harness_ready_why() {
  local h="$1" l sbx cfg key prof why rc=0
  [ -r "$HARNESSES" ] || { echo "no harness map at $HARNESSES"; return 1; }
  jq -e --arg h "$h" '.harnesses | has($h)' "$HARNESSES" >/dev/null 2>&1 || { echo "$HARNESSES has no $h"; return 1; }
  l=$(harness_launcher "$h")
  if [ "$l" = codex ]; then
    command -v codex >/dev/null 2>&1 && command -v agent-codex >/dev/null 2>&1 || { echo "codex or agent-codex is not on PATH"; return 1; }
    # Bounded: it runs inside every pass's ssh probe, and a login check that hangs would stall the probe.
    timeout 10 codex login status >/dev/null 2>&1 || rc=$?
    [ "$rc" -ne 124 ] || { echo "codex login status did not answer in 10s"; return 1; }
    [ "$rc" -eq 0 ] || { echo "codex is not logged in here (codex login, as the human)"; return 1; }
    return 0
  fi
  [ "$l" = agy ] || { [ "$l" = opencode ] && [ -n "$(jq -r --arg h "$h" '.harnesses[$h].config_dir // empty' "$HARNESSES")" ]; } ||
    { echo "it is neither codex, agy nor an opencode harness with a config_dir, and a worker runs only those"; return 1; }
  sbx=$(harness_sandbox "$h"); [ -n "$sbx" ] || { echo "it names no lane sandbox, and a worker runs only a sandboxed harness"; return 1; }
  command -v "$l" >/dev/null 2>&1 || { echo "$l is not on PATH"; return 1; }
  prof="$SANDBOX_DIR/$sbx.json"
  jq -e "$SANDBOX_SHAPE" "$prof" >/dev/null 2>&1 || { echo "its lane sandbox $prof is missing or not a valid profile"; return 1; }
  why=$(sandbox_srt_refusal); [ -z "$why" ] || { echo "lane sandbox '$sbx' cannot hold $h: $why"; return 1; }
  if [ "$l" = agy ]; then
    command -v agent-agy >/dev/null 2>&1 || { echo "agent-agy is not on PATH"; return 1; }
    # /usage spends no quota. Bounded as codex's is: a logged-out agy waits on a browser sign-in.
    timeout 20 agy --output-format json -p /usage >/dev/null 2>&1 || rc=$?
    [ "$rc" -ne 124 ] || { echo "agy /usage did not answer in 20s: not signed in here? (agy, as the human)"; return 1; }
    [ "$rc" -eq 0 ] || { echo "agy /usage failed here (rc $rc)"; return 1; }
    return 0
  fi
  cfg=$(jq -r --arg h "$h" '.harnesses[$h].config // "" | sub("^~"; env.HOME)' "$HARNESSES")
  [ -n "$cfg" ] && [ -r "$cfg" ] || { echo "its config ${cfg:-(none in the map)} is not readable"; return 1; }
  key=$(harness_key_file "$h"); [ -r "$key" ] || { echo "its key file $key is not readable"; return 1; }
}

# cmd_harness_ready <harness>... -- one line each: the name when this machine runs it (harness_ready_why),
# else "<name>: <why>". probe_hosts runs it on each worker that lists fleet_harnesses; an older
# fleet-dispatch there prints nothing on stdout, so none of them reads ready.
cmd_harness_ready() {
  local h why
  for h; do
    if why=$(harness_ready_why "$h"); then echo "$h"; else echo "$h: $why"; fi
  done
}

# cmd_kit -- one line, space-separated: each launcher this machine runs a fleet session on (claude when
# it is on PATH and fleet-node finds every Claude account signed in, codex, opencode, agy), and srt when
# srt can hold a run here (sandbox_srt_refusal). probe_hosts and start --host ask it on each worker, so
# a worker takes an item on the harness it has, and a sandboxed start only where srt is.
cmd_kit() {
  local t kit=()
  command -v claude >/dev/null 2>&1 && "$HERE/fleet-node" ready >/dev/null 2>&1 && kit+=(claude)
  for t in codex opencode agy; do command -v "$t" >/dev/null 2>&1 && kit+=("$t"); done
  [ -n "$(sandbox_srt_refusal)" ] || kit+=(srt)
  echo "${kit[*]}"
}

# host_has <kit> <tool> -- the tool is in that kit (cmd_kit's line).
host_has() { [[ " $1 " == *" $2 "* ]]; }

# host_start_why <host> <item> <harness> -> why start --host cannot open that item on that worker, rc 1;
# nothing, rc 0, when it can. The worker's kit is this pass's probe (HOST_KIT), else asked now (a hand
# start): it needs the harness's launcher, and under DISPATCH_SANDBOX_PROFILE srt too (claude's lane
# sandbox and the sandboxed harnesses are built on it).
host_start_why() {
  local kit l rc=0
  # ssh's 255 is a worker that did not answer; any other failure (an older fleet-dispatch, no kit verb) is an empty kit.
  if [ -n "${HOST_KIT[$1]+set}" ]; then kit=${HOST_KIT[$1]}; else kit=$(fleet_host_run "$1" fleet-dispatch kit 2>/dev/null) || { rc=$?; kit=''; }; fi
  [ "$rc" != 255 ] || { echo "$1 did not answer (fleet-dispatch kit there); $2 stays queued"; return 1; }
  l=$(harness_launcher "$3")
  host_has "$kit" "$l" || { echo "$2 would run on $3, and $1 has no $l it can run (fleet-dispatch kit there: ${kit:-nothing}); it stays queued"; return 1; }
  [ -z "$DISPATCH_SANDBOX_PROFILE" ] || host_has "$kit" srt ||
    { echo "$1 has no srt (fleet-dispatch kit there: ${kit:-nothing}), so it cannot hold lane sandbox '$DISPATCH_SANDBOX_PROFILE'; $2 stays queued"; return 1; }
}

# prep_srt <lane sandbox> <cwd> <harness> <out> <settings cmd...> -- write the srt settings the command
# builds under the lane sandbox, loaded from the item's repo, to <out>; rc 1, said, when it cannot be applied.
prep_srt() {
  local sbx="$1" cwd="$2" h="$3" out="$4"; shift 4
  (role_die() { say "$*"; exit 78; }
    cd "$cwd" && SANDBOX_PROFILE=$sbx GH_TOKEN_FILE='' && sandbox_load && "$@" >"$out") ||
    { say "start: lane sandbox '$sbx' cannot be applied to $h; nothing started"; return 1; }
}

# harness_prep <harness> <session id> <cwd> -> "<config>\t<run dir>\t<config_dir>" for a sandboxed opencode run: makes
# its config_dir and run dir and writes the srt settings (run dir/srt-<id>.json) from the lane sandbox,
# with the item's repo as the cwd; rc 1, said, when it cannot. Run where the run will run: here, or on a
# fleet worker (cmd_start --host, over fleet_host_run), so every path and srt's own package are that
# machine's. An agy run gets only its run dir (AGY_RUNS: the srt settings, its tmp, and the log agent-agy
# keeps, masked from the run), its settings from sandbox_agy_settings.
harness_prep() {
  local h="$1" sid="$2" cwd="$3" why sbx cdir run cfg file
  [[ "$sid" =~ ^[A-Za-z0-9_]+$ ]] || { say "start: $sid is no session id"; return 2; }
  why=$(harness_ready_why "$h") || { say "start: $why"; return 1; }
  sbx=$(harness_sandbox "$h")
  if [ "$(harness_launcher "$h")" = agy ]; then
    mkdir -p "$AGY_RUNS/tmp" || { say "start: no run dir $AGY_RUNS for $h"; return 1; }
    prep_srt "$sbx" "$cwd" "$h" "$AGY_RUNS/srt-$sid.json" sandbox_agy_settings "$AGY_RUNS/tmp" || return 1
    printf '%s\n' "$AGY_RUNS"; return 0
  fi
  cdir=$(jq -r --arg h "$h" '.harnesses[$h].config_dir | sub("^~"; env.HOME)' "$HARNESSES")
  cfg=$(jq -r --arg h "$h" '.harnesses[$h].config | sub("^~"; env.HOME)' "$HARNESSES")
  file=$(harness_key_file "$h")
  mkdir -p "$cdir" || { say "start: no config_dir $cdir for $h"; return 1; }
  run=$(harness_run_dir "$HARNESSES" "$h")
  cfg=$(realpath -e -- "$cfg") || { say "start: no config $cfg for $h"; return 1; }
  mkdir -p "$run/data" "$run/cache" "$run/state" "$run/tmp" || { say "start: no run dir $run for $h"; return 1; }
  prep_srt "$sbx" "$cwd" "$h" "$run/srt-$sid.json" sandbox_srt_settings --ro "$cfg" --ro "$(realpath -e -- "$file")" --rw "$cdir" || return 1
  printf '%s\t%s\t%s\n' "$cfg" "$run" "$cdir"
}

# gateway_runenv <jail> <slug> <cfg> <config dir> <run dir> <harness:model> -> a sandboxed opencode run's
# env, which its replay (gateway_replay) takes too. AGENT_RUN_PAIR names the run for agent-core.
gateway_runenv() {
  printf '%s AGENT_QUEUE_ITEM=%q OPENCODE_CONFIG=%q OPENCODE_CONFIG_DIR=%q' "$1" "$2" "$3" "$4"
  printf ' OPENCODE_DISABLE_CLAUDE_CODE=1 OPENCODE_DISABLE_PROJECT_CONFIG=1 XDG_DATA_HOME=%q XDG_CACHE_HOME=%q' "$5/data" "$5/cache"
  printf ' XDG_STATE_HOME=%q AGENT_RUN_PAIR=%q' "$5/state" "$6"
}

# gateway_replay <cmd> <tail> <runenv> <srtc> <slug> <viewer> <srt settings> -> the sandboxed launch line:
# after its tail the pane stays a session: @headless marks it, and the viewer opens the run's transcript
# in the same jail and srt settings, unattended no more (opencode's TUI on its session id, without
# --auto; agy's on its conversation). AGENT_RUN_RESULT is what the run left (run-result), for
# agent-core's row. reap closes the session once its item leaves review (reap_replays), so the srt
# settings go on the shell's exit, a kill too.
gateway_replay() {
  local replay
  replay="tmux set-option -t \"\$TMUX_PANE\" @headless $(printf '%q' "$5") 2>/dev/null; $3"
  replay="$replay AGENT_RUN_RESULT=\"\$(fleet-dispatch run-result $(printf '%q' "$5") 2>/dev/null)\" $4 $6"
  printf '%s' "trap $(printf '%q' "rm -f $(printf '%q' "$7")") EXIT; trap 'exit 129' HUP TERM; $1; $2; $replay; }"
}

# replay_record <harness> <item> <server> <session> [host] -- for a sandboxed harness, record the session
# its run's pane stays open in on its replay (gateway_replay), as DIR/replay/<item>@<session>, which
# reap_replays reads to close it.
replay_record() {
  [ "$1" != claude ] && [ -n "$(harness_sandbox "$1")" ] || return 0
  { mkdir -p "$DIR/replay" && printf '%s\t%s\t%s\n' "$3" "$4" "${5:-}" > "$DIR/replay/$2@$4"; } ||
    say "could not record $4 for reap; its replay stays open until closed by hand"
}

# sandbox_wrap <harness> <item json> <session id> <jail and srt prefix> [direct pair] -- put cmd (a sandboxed
# run's env and srt, gateway_launch's) inside the harness's timeout, and set tail to what follows the run.
# A canary's steps the brief leaves out read and write fleet state, so they run here, outside the
# sandbox, before and after it; the run can neither reach its oracle nor write its score. The oracle
# runs the code the model wrote, so the score runs that command back inside the jail. A start that
# fails skips the run and the score: the tree was never put at base, so a score there would grade the
# merged code. A trainee's run is followed by its review hand-off (cmd_trainee_review), which reads the
# diff the run left whatever way the run ended; a direct run's by its landing (cmd_direct_land), given
# the run's exit status, so a run that did not end clean lands nothing. The score is given why the
# session ended (cmd_item_end, read here where the run ran), so a provider refusal or a timeout scores
# not run, never a model fail.
sandbox_wrap() {
  local slug tmo
  slug=$(jq -r .slug <<<"$2")
  tmo="timeout $(jq -r --arg h "$1" '.harnesses[$h].timeout_min' "$HARNESSES")m"
  if is_canary "$2"; then
    cmd="fleet-bench canary start $(printf '%q' "$(jq -r .canary <<<"$2")") && { $tmo $cmd"
    tail="BENCH_CANARY_WRAP=$(printf '%q' "$4") AGENT_QUEUE_ITEM=$(printf '%q' "$slug") fleet-bench canary score $(printf '%q' "$(jq -r .canary <<<"$2")") --end \"\$(fleet-dispatch item-end $(printf '%q' "$1") $3)\" && agent-queue move $(printf '%q' "$slug") done --status ok"
  else
    cmd="{ $tmo $cmd"
    tail="fleet-dispatch trainee-review $(printf '%q' "$slug")"
    [ -z "${5:-}" ] || tail="fleet-dispatch direct-land $(printf '%q' "$slug") --rc \$?"
  fi
}

# gateway_jail <run dir> <sid> -> two lines for a sandboxed run: the jail, the cleared env plus the run's
# tmp for srt's sockets (TMPDIR) and for the child, which srt hands CLAUDE_CODE_TMPDIR as its TMPDIR
# (else /tmp/claude, masked here); and srt on this run's settings. Both the run and the oracle its score
# runs (BENCH_CANARY_WRAP) go inside them.
gateway_jail() {
  printf '%s TMPDIR=%q CLAUDE_CODE_TMPDIR=%q\n' "$(sandbox_env_clear)" "$1/tmp" "$1/tmp"
  printf 'srt --settings %q --\n' "$1/srt-$2.json"
}

# agy_parts <run dir> <sid> <slug> <harness:model> <model id> <brief> -> five lines for gateway_launch's
# agy case: the jail (env -i, the run's tmp), the srt prefix, the run env, agy's print-mode args and the
# replay's viewer (agy's TUI on the run's conversation). agy has no switch for its global rules or its
# subagent tools, so the jail is what holds it: the shell it gives the model sees the worktree, agy's
# binary and state (~/.gemini/antigravity-cli) and the run's tmp (sandbox_agy_settings). agent-agy,
# outside the jail, keeps the run's log in the masked run dir for item_end and agentctl-session-outcomes.
# Print mode takes the brief as -p's value, so every flag goes ahead of it.
agy_parts() {
  local jail srtc
  { read -r jail; read -r srtc; } < <(gateway_jail "$1" "$2")
  printf '%s\n%s\n%s AGENT_QUEUE_ITEM=%q AGENT_RUN_PAIR=%q\n' "$jail" "$srtc" "$jail" "$3" "$4"
  printf 'agy --output-format stream-json --dangerously-skip-permissions --model %q -p %q\n' "$5" "$6"
  printf '%s\n' "agy \$(jq -rR 'fromjson? | select(.event == \"init\") | \"--conversation \" + .conversation_id' $(printf '%q' "$1/$2.jsonl") 2>/dev/null | head -n 1)"
}

# gateway_launch <harness> <model> <item json> <brief> [direct pair] -- past every refusal, set cmd to the launch
# line, and sid to the session id an opencode or agy run takes. Refuses (rc 2, or 1 for the budget or room) before
# anything starts. No default model: on this lane the pairing is the experiment, and the map is what
# stops `--model opus` on claude-lazer, which pins every slot to Sonnet, from mislabelling the run.
# A pane inherits its tmux server's environment, so each line drops the master key.
# A direct pair (cmd_start, direct_why) is a run model-lane promoted the pair for: its tail lands the diff.
gateway_launch() {
  local harness="$1" model="$2" it="$3" brief="$4" drc="${5:-}" slug id left file src repo dir thread salvage effort cdir pwhy proj sbx run cfg jail srtc tail prep runenv argv viewer
  [ -r "$HARNESSES" ] || { say "start: no harness map at $HARNESSES"; return 2; }
  jq -e --arg h "$harness" '.harnesses | has($h)' "$HARNESSES" >/dev/null || { say "start: unknown harness: $harness"; return 2; }
  [ -n "$model" ] || { say "start: harness $harness needs --model, or a model: on the item"; return 2; }
  id=$(jq -r --arg h "$harness" --arg m "$model" '.harnesses[$h].models[$m] // empty' "$HARNESSES")
  [ -n "$id" ] || { say "start: harness $harness has no model $model"; return 2; }
  # The backstop to route(): a hand --harness start reaches here without it.
  proj=$(jq -r '.project // ""' <<<"$it")
  pwhy=$(harness_project_why "$HARNESSES" "$harness" "$proj") ||
    { say "start: $harness refuses $(jq -r .slug <<<"$it"): $pwhy"; return 2; }
  # A harness with a project allowlist is public-only: an opencode run under its own config_dir (the
  # launch below), or an agy run in a lane sandbox that masks all of ~/ (agy has no switch for its
  # global rules), each in its own lane sandbox, in the item's own repo. cwd is cmd_start's, so a hand
  # --cwd cannot take it elsewhere. Without the sandbox its shell could read every private path and the pane env.
  if [ "$(jq -r --arg h "$harness" '.harnesses[$h] | has("projects")' "$HARNESSES")" = true ]; then
    { [ "$(harness_launcher "$harness")" = opencode ] && [ -n "$(jq -r --arg h "$harness" '.harnesses[$h].config_dir // empty' "$HARNESSES")" ]; } ||
      { [ "$(harness_launcher "$harness")" = agy ] && sandbox_masks_home "$(harness_sandbox "$harness")"; } ||
      { say "start: $harness has a projects allowlist, so it must be an opencode harness with a config_dir, or an agy one whose lane sandbox masks ~/, or its run would load the private rules"; return 2; }
    [ "$(realpath -m -- "$cwd")" = "$(realpath -m -- "$(repo_dir "$proj")")" ] ||
      { say "start: $harness runs only in $proj's own repo, not $cwd"; return 2; }
    [ -n "$(harness_sandbox "$harness")" ] ||
      { say "start: $harness has a projects allowlist, so it must name a lane sandbox (sandbox:), or its shell could read the private paths and the pane env"; return 2; }
  fi
  # Room is claude-acct's verdict on the source the harness spends; a cloud session spends a Claude
  # account, picked at launch, so it asks for any account with room.
  if [ "$(harness_launcher "$harness")" = claude-cloud ]; then
    left=$(claude-acct room --json 2>/dev/null)
    jq -e '.pick != null' <<<"$left" >/dev/null 2>&1 || { say "start: $harness has no room: $(jq -r '.why // empty' <<<"$left" 2>/dev/null)"; return 1; }
  else
    src=$(harness_source "$harness")
    [ -n "$src" ] || { say "start: harness $harness has no source in $HARNESSES"; return 2; }
    # --model: the model's own route (harness_route), which route() asks the same verdict of.
    left=$(claude-acct room --source "$src" --model "$(harness_route "$harness" "$model")" 2>&1) || { say "start: $harness has no room: $left"; return 1; }
  fi
  slug=$(jq -r .slug <<<"$it")
  file=$(harness_key_file "$harness")
  takes_plan "$harness" || [ "$(jq -r .mode <<<"$it")" != plan ] || { say "start: $harness runs to its end and cannot wait on a plan; $slug is a plan item"; return 2; }
  sbx=$(harness_sandbox "$harness")
  if [ -n "$sbx" ]; then
    case "$(harness_launcher "$harness")" in opencode | agy) ;;
      *) say "start: $harness names lane sandbox '$sbx', which only an opencode or agy harness holds; nothing started"; return 2 ;;
    esac
    [ -n "$drc" ] || pwhy=$(sandbox_item_why "$it" "$harness") || { say "start: $harness $pwhy ($slug)"; return 2; }
  fi
  case "$(harness_launcher "$harness")" in
    claude-lazer)
      launch_mode "$(jq -r 'if .mode == "plan" then "plan" else "bypassPermissions" end' <<<"$it")"
      cmd="AGENT_QUEUE_ITEM=$(printf '%q' "$slug") $(telemetry_env "$cwd" "$slug")env -u CLAUDE_CONFIG_DIR -u LITELLM_MASTER_KEY CLAUDE_LAZER_KEY=$(printf '%q' "$file") AGENT_HARNESS=$(printf '%q' "$harness")"
      sid=$(new_sid) || { say "start: no session id for queue item $slug; it stays queued"; return 1; }
      cmd="$cmd ANTHROPIC_CUSTOM_HEADERS=$(printf '%q' "x-litellm-tags: queue:$slug") claude-lazer --model $(printf '%q' "$id") --session-id $sid $flags $(printf '%q' "$brief")"
      ;;
    opencode)
      # Standalone: the background service would not see this run's env or config. Nothing else
      # can name the run for the outcome join, so the id is chosen here.
      sid="ses_eval$(date +%s%N)"
      cfg=$(jq -r --arg h "$harness" '.harnesses[$h].config | sub("^~"; env.HOME)' "$HARNESSES")
      cmd="AGENT_QUEUE_ITEM=$(printf '%q' "$slug") OPENCODE_CONFIG=$(printf '%q' "$cfg") env -u LITELLM_MASTER_KEY"
      # config_dir stands in for ~/.config/opencode, whose global rules, agents, commands and plugins
      # are private: a public-only harness (ocfree) loads none of them, nor Claude Code's (~/.claude),
      # nor an AGENTS.md found above the worktree (~/AGENTS.md is the private overlay's).
      cdir=$(jq -r --arg h "$harness" '.harnesses[$h].config_dir // empty | sub("^~"; env.HOME)' "$HARNESSES")
      if [ -n "$cdir" ]; then
        # A sandboxed run's harness_prep makes it, on the machine the run runs on.
        [ -n "$sbx" ] || mkdir -p "$cdir" || { say "start: no config_dir $cdir for $harness"; return 1; }
        cmd="$cmd OPENCODE_CONFIG_DIR=$(printf '%q' "$cdir") OPENCODE_DISABLE_CLAUDE_CODE=1 OPENCODE_DISABLE_PROJECT_CONFIG=1"
      fi
      if [ -n "$sbx" ]; then
        # The lane sandbox (lib/sandbox.sh, srt): the shell opencode gives the model sees the worktree,
        # the harness's config and key, and its config_dir (the run dir inside it); its network is the
        # profile's hosts alone (no host loopback, where the unsandboxed opencode service listens) and its
        # env SANDBOX_ENV_KEEP. Data, cache, state and srt's sockets live in the run dir, so the shared
        # opencode.db (other harnesses' sessions) and auth.json stay masked. No srt refuses the start.
        # harness_prep builds all of it where the run runs: a fleet worker's (cmd_start --host) over ssh.
        [ -n "$cdir" ] || { say "start: $harness names lane sandbox '$sbx' but no config_dir to keep its runs in; nothing started"; return 2; }
        if [ -n "${host:-}" ]; then prep=$(fleet_host_run "$host" fleet-dispatch harness-prep "$harness" "$sid" "$cwd")
        else prep=$(harness_prep "$harness" "$sid" "$cwd"); fi &&
          IFS=$'\t' read -r cfg run cdir <<<"$prep" && [ -n "$cdir" ] ||
          { say "start: lane sandbox '$sbx' cannot be applied to $harness${host:+ on $host}; nothing started"; return 1; }
        { read -r jail; read -r srtc; } < <(gateway_jail "$run" "$sid")
        runenv=$(gateway_runenv "$jail" "$slug" "$cfg" "$cdir" "$run" "$harness:$model")
        cmd="$runenv $srtc"
        sandbox_wrap "$harness" "$it" "$sid" "$jail $srtc" "$drc"
      else
        cmd="$cmd timeout $(jq -r --arg h "$harness" '.harnesses[$h].timeout_min' "$HARNESSES")m"
      fi
      cmd="$cmd opencode run --standalone --auto --session $sid"
      cmd="$cmd --title $(printf '%q' "$slug") --model $(printf '%q' "$id") --agent build $(printf '%q' "$brief") </dev/null"
      [ -z "$sbx" ] || cmd=$(gateway_replay "$cmd" "$tail" "$runenv" "$srtc" "$slug" "opencode --standalone --session $sid" "$run/srt-$sid.json")
      ;;
    agy)
      # The Antigravity CLI, on the human's Google login (AI Pro), only inside its lane sandbox (agy_parts says why).
      [ -n "$sbx" ] || { say "start: $harness runs agy, which runs only in a lane sandbox (sandbox: in $HARNESSES); nothing started"; return 2; }
      sid="agy_$(date +%s%N)"
      if [ -n "${host:-}" ]; then prep=$(fleet_host_run "$host" fleet-dispatch harness-prep "$harness" "$sid" "$cwd")
      else prep=$(harness_prep "$harness" "$sid" "$cwd"); fi && run=$prep && [ -n "$run" ] ||
        { say "start: lane sandbox '$sbx' cannot be applied to $harness${host:+ on $host}; nothing started"; return 1; }
      { read -r jail; read -r srtc; read -r runenv; read -r argv; read -r viewer; } < <(agy_parts "$run" "$sid" "$slug" "$harness:$model" "$id" "$brief")
      cmd="agent-agy run --log $(printf '%q' "$run/$sid.jsonl") -- $runenv $srtc"
      sandbox_wrap "$harness" "$it" "$sid" "$jail $srtc" "$drc"
      cmd=$(gateway_replay "$cmd $argv" "$tail" "$runenv" "$srtc" "$slug" "$viewer" "$run/srt-$sid.json")
      ;;
    codex)
      # The ChatGPT login bills the plan; an API key in the pane's env would bill per token instead.
      # agent-codex claims the thread id on the item when codex names it. Codex runs only the hooks
      # it has trusted, and a hooks.json the sync rewrote is trusted no more: the bypass makes a fleet
      # run fire ~/.codex/hooks.json as written (the guards, and the Stop check that it closed its item).
      # An item whose last run's thread can be taken up resumes it (resume_thread), here, on the
      # salvage branch that run pushed when it left work (agent-codex checks it out, or refuses).
      cmd="AGENT_QUEUE_ITEM=$(printf '%q' "$slug") env -u LITELLM_MASTER_KEY -u OPENAI_API_KEY -u CODEX_API_KEY"
      cmd="$cmd timeout $(jq -r --arg h "$harness" '.harnesses[$h].timeout_min' "$HARNESSES")m agent-codex"
      read -r thread _ < <(resume_thread "$it" "$harness") || thread=''
      if [ -n "$thread" ]; then
        salvage=$(jq -r '.salvage // empty' <<<"$it")
        cmd="$cmd resume ${salvage:+--salvage $(printf '%q' "$salvage") }$thread -m $(printf '%q' "$id")"
      else
        cmd="$cmd run -m $(printf '%q' "$id")"
      fi
      cmd="$cmd --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust --skip-git-repo-check"
      # An item's effort: (a canary lane's, fleet-bench canary queue --effort) overrides config.toml's.
      effort=$(jq -r '.effort // empty' <<<"$it")
      [ -z "$effort" ] || cmd="$cmd -c model_reasoning_effort=$(printf '%q' "$effort")"
      [ -n "$thread" ] || cmd="$cmd --color never"   # a resume takes no --color
      cmd="$cmd $(printf '%q' "$brief")"
      ;;
    claude-cloud)
      # A Claude cloud session: a fresh GitHub clone on Anthropic's VM, billed to the plan, with none of
      # this machine's skills, hooks or queue. So only an oneshot item below tier 3 may go, and only
      # from a GitHub repo; claude-cloud-run keeps the pane until the session's PR is found.
      [ "$(jq -r .mode <<<"$it")" != plan ] || { say "start: a cloud session cannot wait on a plan; $slug is a plan item"; return 2; }
      [ "$(item_tier "$it")" != 3 ] || { say "start: $slug is tier 3, which merges behind a local gate a cloud session lacks"; return 2; }
      repo=$(cloud_repo "$cwd") || { say "start: $slug has no GitHub repo for a cloud session to clone: $cwd"; return 2; }
      # acct is cmd_start's (dynamic scope): the claude account this session bills, recorded as account=.
      dir=$(account_dir); acct=$(basename "${dir:-main}")
      cmd="AGENT_QUEUE_ITEM=$(printf '%q' "$slug") $(account_env "$dir")CLOUD_TIMEOUT_MIN=$(jq -r --arg h "$harness" '.harnesses[$h].timeout_min' "$HARNESSES")"
      cmd="$cmd claude-cloud-run $(printf '%q' "$slug") $(printf '%q' "$repo") $(printf '%q' "$brief")"
      ;;
    *) say "start: no launcher for harness $harness"; return 2 ;;
  esac
}

# cloud_repo <dir> -> owner/repo of the GitHub remote a cloud session would clone; rc 1 for any other host.
cloud_repo() {
  local url; url=$(git -C "$1" remote get-url origin 2>/dev/null) || return 1
  [[ "$url" == *github.com[:/]* ]] || return 1
  url=${url#*github.com[:/]}; url=${url%.git}
  [[ "$url" == */* && "$url" != */*/* ]] && printf '%s\n' "$url"
}

# cloud_routed <slug> -> rc 0 when the queued item is a claude one tagged cloud-ok, which runs in a cloud
# session: the tag is the human's word that it is self-contained, on GitHub, and needs no local skill.
# An item that names another model (agent: codex, model: opus) is not routed: the cloud has one model.
# agent=claude-cloud is what a start recorded, so a re-queued item routes again.
cloud_routed() {
  agent-queue show "$1" --json 2>/dev/null |
    jq -e '((.agent // "claude") | . == "claude" or . == "claude-cloud") and ((.model // "") | . == "" or . == "cloud") and ((" " + (.tags // "") + " ") | contains(" cloud-ok "))' >/dev/null 2>&1
}

# headless <harness> -- the harness runs to its end with no slash commands or human at the pane: its
# `headless` in the map. Codex fires the hooks in ~/.codex/hooks.json; opencode fires none.
headless() { harness_flag "$1" headless; }

# resumes <harness> -- a later run can take up an earlier run's thread: its `resume` in the map (codex,
# through agent-codex resume). A harness with no resume: true (every opencode-launcher one) stays refused plan items and --resume.
resumes() { harness_flag "$1" resume; }

# harness_flag <harness> <key> -- that key is true in the harness's map entry.
harness_flag() { jq -e --arg h "$1" --arg k "$2" '.harnesses[$h][$k] == true' "$HARNESSES" >/dev/null 2>&1; }

# is_canary <item json> -- the item is a fleet-bench canary: it replays a merged PR and is scored fresh.
is_canary() { [[ " $(jq -r '.tags // ""' <<<"$1") " == *" canary "* ]]; }

# harness_tier_why <harness> <item json> -> why the harness may not take the item, rc 1: the item's tier
# (item_tier) is over the harness's `max_tier` in the map, its trust ceiling until its runs score beside
# claude's (raising it is the human's promotion step). Nothing and rc 0 when the harness names no
# max_tier, the item is a canary (it replays a merged PR and opens no PR: an eval, not work), or the
# harness takes it as a trainee row (trainee_why), whose diff an Opus review lands or rejects. rc 2,
# failing closed, when max_tier is not 1, 2 or 3. Why: the human held unscored harnesses off anything
# critical (2026-11-12).
harness_tier_why() {
  local max tier
  max=$(jq -r --arg h "$1" '.harnesses[$h] // {} | if has("max_tier") then .max_tier | tojson else "none" end' "$HARNESSES" 2>/dev/null) ||
    { echo "$HARNESSES is unreadable, so its max_tier is unknown"; return 2; }
  [ "$max" != none ] || return 0
  [[ "$max" =~ ^[123]$ ]] || { echo "its max_tier in $HARNESSES is not 1, 2 or 3"; return 2; }
  ! is_canary "$2" || return 0
  tier=$(item_tier "$2")
  [ "$tier" -gt "$max" ] || return 0
  # A trainee row is held to the trainee block's tiers instead: an Opus review lands its diff or not.
  # Only in a lane sandbox, where every run but a canary or a direct one is stamped a trainee's.
  [ -z "$(harness_sandbox "$1")" ] || ! trainee_why "$2" "$1" >/dev/null || return 0
  echo "it takes tier $max work at most (max_tier in $HARNESSES, until its runs score beside claude), and this is tier $tier"
  return 1
}

# harness_sandbox <harness> -> the lane sandbox profile its runs are held to (its `sandbox` in the map), or nothing.
harness_sandbox() { jq -r --arg h "$1" '.harnesses[$h].sandbox // empty' "$HARNESSES" 2>/dev/null; }

# sandbox_item_why <item json> <harness> [model] [verdict] -> why a sandboxed harness cannot run the
# item, or nothing. Its run sees its worktree alone (no skills, queue, gh or push), so it takes a canary
# item that names its task (`canary`, fleet-bench canary queue sets it), a row of a class model-lane
# promoted the pair for (direct_why), or a trainee row (trainee_why): fleet-dispatch runs the canary
# steps, the direct landing, or the trainee's review hand-off, around the run (gateway_launch).
sandbox_item_why() {
  local why
  is_canary "$1" && [ -n "$(jq -r '.canary // empty' <<<"$1")" ] && return 0
  [ -n "${3:-}" ] && direct_why "$1" "$2" "$3" "${4:-}" >/dev/null && return 0
  why=$(trainee_why "$1" "$2") && return 0
  echo "runs in a sandbox that sees its worktree alone, so it takes only a canary item with its task id (canary:), a class promoted for it or a trainee row, and $why"
  return 1
}

# direct_why <item json> <harness> <model> <verdict> -> why the pair cannot run the item directly, rc 1,
# or nothing. A trainee pair that model-lane score promoted for a class (the ladder's third rung) is in
# the verdict's `direct` for that class, apart from a lane's `promoted`, which is no licence to land
# unreviewed; it runs a row ladder_row_why lets through, of any #pts, still in its sandbox, tier-capped
# and inside the harness's ladder slots (ladder_open_why), and its diff lands on CI with no review (cmd_direct_land).
direct_why() {
  local it="$1" pair="$2:$3" verdict="${4:-}"
  [ -n "$(harness_sandbox "$2")" ] || { echo "$2 runs in no lane sandbox"; return 1; }
  jq -e --arg p "$pair" 'any(.direct[]?; . == $p)' <<<"${verdict:-null}" >/dev/null 2>&1 ||
    { echo "model-lane promoted $pair for no class of this item"; return 1; }
  ladder_row_why "$it" "a direct run" || return 1
  trainee_load
  ladder_open_why "$2"
}

# trainee_load -- the trainee block of lanes.yaml (`model-lane trainee`) in TRAINEE_CONF, read once in
# this shell so the checks route() runs in subshells reuse it; {} (no trainee lane) when it cannot be read.
trainee_load() {
  # The slugs a ladder run already took (lane trainee in model-lane's run log), one read a pass: a board row
  # promoted again has a fresh queue item with no `.trainee`, so the log is the one record of the first try.
  [ -n "${TRAINEE_TRIED+x}" ] || TRAINEE_TRIED=$(jq -rR 'fromjson? | select(.lane == "trainee") | .item // empty' "$LANE_RUNS" 2>/dev/null | sort -u)
  [ -z "${TRAINEE_CONF:-}" ] || return 0
  TRAINEE_CONF=$(model-lane trainee 2>/dev/null) && jq -e 'type == "object"' <<<"$TRAINEE_CONF" >/dev/null 2>&1 || TRAINEE_CONF='{}'
}

# item_points <item json> -> the item's points: its board row's now (`points`, which runnable joins
# from the board), else the #pts/N its task was queued with, or nothing. The row is the one size store:
# a row sized after it was queued kept its item off every trainee (2 of 606 queued tasks carry #pts).
item_points() { jq -r 'first((.points | tostring | select(test("^[0-9]+$"))), ((.task // "") | match("#pts/([0-9]+)\\b"; "i").captures[0].string))' <<<"$1"; }

# ladder_row_why <item json> <who> [tiers] [tier3 share] -> why no sandboxed ladder run (a trainee's or
# a direct one) takes the item, rc 1, or nothing: it takes a row whose kind opens a PR at a tier in
# <tiers> (default 1), not a plan, a canary, a verify or review item, one that names its own model, or
# one a ladder run took before (`trainee:` or `direct:`, or a lane trainee run in model-lane's log under its
# slug, so a rejected or failed row goes to claude).
# With a share N above 0, a tier-3 row tier3_pick takes is let through too. <who> names the run.
ladder_row_why() {
  local it="$1" who="$2" tiers="${3:-1}" share="${4:-0}" tags tier kind prev
  tags=" $(jq -r '.tags // ""' <<<"$it") "
  ! is_canary "$it" && [[ "$tags" != *" trainee-review "* && "$tags" != *" verify "* && "$tags" != *" validate "* ]] ||
    { echo "it is a canary, verify, validate or review item"; return 1; }
  prev=$(jq -r '.trainee // .direct // empty' <<<"$it")
  [ -z "$prev" ] || { echo "a ladder run took it once already ($prev)"; return 1; }
  trainee_load
  [ -z "$TRAINEE_TRIED" ] || ! grep -qxF -- "$(jq -r '.slug // "-"' <<<"$it")" <<<"$TRAINEE_TRIED" || { echo "a ladder run took it once already (model-lane's run log)"; return 1; }
  [ -z "$(claude_pin "$it")" ] || { echo "it names its own model"; return 1; }
  [ "$(jq -r .mode <<<"$it")" != plan ] || { echo "it is a plan item"; return 1; }
  tier=$(item_tier "$it")
  if [[ " $tiers " != *" $tier "* ]] && ! { [ "$tier" = 3 ] && tier3_pick "$it" "$share"; }; then
    echo "it is tier $tier, and $who takes tier ${tiers// /, } only$([ "$share" -gt 0 ] && echo ", and one tier-3 cleanup row in $share")"
    return 1
  fi
  load_kinds; kind=$(item_kind "$it")
  [ -z "$kind" ] || [ "${KIND_EXIT[$kind]:-pr}" = pr ] || { echo "its kind $kind opens no PR"; return 1; }
}

# tier3_pick <item json> <share> -> rc 0 when a ladder run takes the tier-3 row: share is above 0,
# cleanup_row accepts it (a fix, chore or deleting refactor on a cleanup project that names no shared
# infrastructure), and the cksum of its slug (salted) is a multiple of share, so one such row in share trains.
tier3_pick() {
  local n
  [ "${2:-0}" -gt 0 ] || return 1
  [ "$(cleanup_row "$(jq -r '.project // ""' <<<"$1")" "$(jq -r '[.title // empty, .task // empty] | join(" ")' <<<"$1")")" = 0 ] || return 1
  # Salted, so the sample is apart from route's model pick, which takes the bare slug's cksum.
  n=$(cksum <<<"tier3:$(jq -r .slug <<<"$1")" | cut -d' ' -f1)
  [ $((n % $2)) = 0 ]
}

# trainee_why <item json> [harness] -> why no trainee takes the item, rc 1, or nothing. A trainee (the
# training ladder's second rung, lanes.yaml `trainee:`) takes a row ladder_row_why lets through at the
# block's `tiers` and `tier3_share`, of at most `points`; with a harness, one of its `candidates`
# with a ladder slot open (ladder_open_why). Its project is the
# harness's `projects` allowlist (harness_project_why), checked beside this. These tiers stand in for
# the harness's max_tier, which caps the runs no review gates (harness_tier_why).
trainee_why() {
  local it="$1" h="${2:-}" pts max open
  pts=$(item_points "$it")
  [ -n "$pts" ] || { echo "it carries no #pts/N"; return 1; }
  trainee_load
  max=$(jq -r '.points // empty' <<<"$TRAINEE_CONF")
  [ -n "$max" ] || { echo "lanes.yaml has no trainee: lane (model-lane trainee)"; return 1; }
  ladder_row_why "$it" "a trainee" "$(jq -r '(.tiers // [1]) | map(tostring) | join(" ")' <<<"$TRAINEE_CONF")" \
    "$(jq -r '.tier3_share // 0' <<<"$TRAINEE_CONF")" || return 1
  [ "$pts" -le "$max" ] || { echo "it is $pts points, and a trainee takes $max at most"; return 1; }
  trainee_public_why "$it" || return 1
  [ -n "$h" ] || return 0
  jq -e --arg h "$h" 'any(.candidates[]?; .harness == $h)' <<<"$TRAINEE_CONF" >/dev/null ||
    { echo "$h is no trainee in lanes.yaml"; return 1; }
  ladder_open_why "$h"
}

# trainee_public_why <item json> -> why a trainee may not see or do the row, rc 1, or nothing. Its
# provider is a free one, which sees the row and its repo, and its gateway sandbox builds no cargo or npm.
# So the row's repo is one of DISPATCH_TRAINEE_REPOS, its words match none of that repo's
# .githooks/sensitive-tokens.txt, and each file it names (row_paths) is tracked there, a markdown file, or
# a shell or bats file outside any cargo or npm tree; a directory, every file under it. A bare word the repo
# does not track (a jq .field, a runtime state.json) is no file the row names, so it is skipped; a path
# with a slash is refused. A row that names no file passes: the lane sandbox (sandbox/gateway.json,
# agy.json) denies every read outside the worktree, so the work stays in the repo whatever the row
# says, and cmd_trainee_review checks the files the diff touched (trainee_diff_why). Until 2026-11-23
# such a row was refused, and the floor ran dry with 332 of them open (ar-4739).
trainee_public_why() {
  local it="$1" repo text toks tok files f manifests
  repo=$(repo_dir "$(jq -r '.project // ""' <<<"$it")")
  [ -n "$repo" ] && [[ " $DISPATCH_TRAINEE_REPOS " == *" $repo "* ]] ||
    { echo "its repo ${repo:-(none)} is not one a trainee may see (DISPATCH_TRAINEE_REPOS)"; return 1; }
  [ -r "$repo/.githooks/sensitive-tokens.txt" ] || { echo "$repo has no .githooks/sensitive-tokens.txt to check its words by"; return 1; }
  text=$(jq -r '[.title // empty, .task // empty] | join("\n")' <<<"$it")
  ! grep -qEf <(grep -vE '^[[:space:]]*(#|$)' "$repo/.githooks/sensitive-tokens.txt") <<<"$text" ||
    { echo "its words match $repo/.githooks/sensitive-tokens.txt"; return 1; }
  toks=$(row_paths "$text" "$repo")
  manifests=$(trainee_manifests "$repo")
  while IFS= read -r tok; do
    [ -n "$tok" ] || continue
    files=$(git -C "$repo" ls-files -- "$tok" 2>/dev/null)
    [ -n "$files" ] || files=$(git -C "$repo" ls-files -- "*/$tok" 2>/dev/null)
    [ -n "$files" ] || [[ "$tok" != */* ]] || { echo "it names $tok, which $repo does not track"; return 1; }
    [ -n "$files" ] || continue
    while IFS= read -r f; do
      trainee_file_ok "$repo" "$f" "$manifests" || { echo "it names $f, which is no markdown file, nor a shell or bats file outside a cargo or npm tree"; return 1; }
    done <<<"$files"
  done <<<"$toks"
}

# trainee_manifests <repo> -> the directories a Cargo.toml or package.json is tracked in, "." for the
# root, one a line: trainee_file_ok refuses any file at or under one.
trainee_manifests() {
  git -C "$1" ls-files -- 'Cargo.toml' '*/Cargo.toml' 'package.json' '*/package.json' 2>/dev/null | sed -E 's#/[^/]+$##; t; s#.*#.#'
}

# trainee_diff_why <repo> <base> -> the first file the staged diff against <base> touches that
# trainee_file_ok refuses, as a reject reason, rc 1; nothing, rc 0, when every file passes. The row's
# words no longer have to name its files (trainee_public_why), so the diff is where the sandbox's
# limit (no cargo or npm build) is held. A deleted file, or a rename's source, is judged by its path alone.
trainee_diff_why() {
  local f manifests
  manifests=$(trainee_manifests "$1")
  # --no-renames lists a rename's source too, and -z keeps a path with non-ASCII bytes unquoted.
  while IFS= read -r -d '' f; do
    [ -n "$f" ] || continue
    trainee_file_ok "$1" "$f" "$manifests" ||
      { echo "its diff touches $f, which is no markdown file, nor a shell or bats file outside a cargo or npm tree, so the sandbox could not build it"; return 1; }
  done < <(git -C "$1" diff --cached --name-only --no-renames -z "$2" 2>/dev/null)
}

# row_paths <text> <repo> -> the files and directories a row names, one a line: each word with a slash
# or a file extension (no URL, no #tag, no id comment, no <placeholder> or glob), and each bare word that is a .local/bin command
# the repo tracks. A leading ~/ or ./ and trailing punctuation go.
row_paths() {
  local words cmds
  words=$(sed -E 's/<!--[^>]*-->//g; s/(^|[[:space:]])#[A-Za-z0-9_/:.-]+//g' <<<"$1" | tr -s ' \t`"'"'"'(),;[]' '\n' |
    sed -E 's#^~/##; s#^\./##; s/[.:]+$//; s#/+$##' | grep -vE '^[a-z]+://|[<>*{}$]' | grep . | sort -u)
  cmds=$(git -C "$2" ls-files -- '.local/bin/*' 2>/dev/null | sed 's#.*/##')
  grep -E '/|\.[A-Za-z0-9]+$' <<<"$words"
  [ -z "$cmds" ] || grep -vE '/|\.[A-Za-z0-9]+$' <<<"$words" | grep -xFf <(echo "$cmds") | sed 's#^#.local/bin/#'
  return 0
}

# trainee_file_ok <repo> <file> <manifest dirs> -- rc 0 when the gateway sandbox can build what a change
# to the file needs: a .md file anywhere, since editing markdown needs no cargo or npm (the batch review
# and CI build a tree whose code embeds one); or a .sh, .bash, .zsh or .bats file, or one with no extension whose first line is
# a sh, bash or zsh shebang, in no directory a Cargo.toml or package.json sits in or above.
trainee_file_ok() {
  local d
  [[ "${2##*/}" != *.md ]] || return 0
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    # "." is a manifest at the repo root: the whole tree builds with it.
    [ "$d" != . ] && [[ "$2" != "$d"/* ]] || return 1
  done <<<"$3"
  case "${2##*/}" in
    *.sh | *.bash | *.zsh | *.bats) return 0 ;;
    *.*) return 1 ;;
  esac
  head -n 1 "$1/$2" 2>/dev/null | grep -qE '^#!.*[/ ](ba|z)?sh([[:space:]]|$)'
}

# ladder_counts <harness> -> the rows a ladder run took on the harness (trainee: or direct:) whose run has
# ended and that wait, in review or on an ask, to be landed or sent back; rc 1 when the queue is unreadable.
# A waiting diff spends nothing on its source, so it holds no live slot (trainee-steady-queue P1); the live
# ones are the source's (claude-acct room --source).
ladder_counts() {
  agent-queue list --json --state active 2>/dev/null | jq -sre --arg h "$1" '[.[] | select(.state != "queued" and .state != "running" and .agent == $h
    and ((.trainee // .direct // "") | startswith($h + ":")))] | length'
}

# provider_hold_why <source> -> why the source takes no start, rc 0, or nothing, rc 1: a run on it ended
# on a provider refusal (end_reason provider) and its window has not reset (provider_hold_scan). It holds
# route and the ladder floors only; a hand `start --harness` ignores it, like every room check. The
# 11-19 canary lane sent 8 runs into one spent 5h budget, each dying at its first message.
provider_hold_why() {
  local until
  [ -n "$1" ] && [ -r "$PROVIDER_ENDS" ] || return 1
  until=$(awk -F'\t' -v s="$1" '$2 == s && $3 > m { m = $3 } END { print m + 0 }' "$PROVIDER_ENDS")
  [ "$until" -gt "$(date +%s)" ] || return 1
  echo "a run on $1 ended on a provider refusal, so it takes no start until $(date -d "@$until" "+%F %H:%M")"
}

# provider_hold_scan -- once a pass: the runs of the last hold window that ended (done, or in review) on
# an opencode harness with a source, each classified once by item_end into PROVIDER_ENDS. A run that
# ended `provider` holds its source until its end plus the harness's provider_hold_min
# (DISPATCH_PROVIDER_HOLD_MIN when it names none). One ledger row a run, dropped once the run is older
# than the window; a run item_end cannot read (a worker that does not answer) is asked again next pass.
# The scan is the dispatcher's, so a hold covers runs on every fleet worker, which a worker's own tail could not.
provider_hold_scan() {
  local win now it slug src agent end ended hold file sessions reason key
  local -A seen=() keep=()
  win=$(jq -r --argjson d "$DISPATCH_PROVIDER_HOLD_MIN" '[.harnesses[] | select(.source != null) | .provider_hold_min // $d] | max // empty' "$HARNESSES" 2>/dev/null) || return 0
  [[ "$win" =~ ^[0-9]+$ ]] || return 0
  now=$(date +%s)
  # A hold still standing is kept whatever the queue read says, so an unreadable queue never lifts one.
  [ ! -r "$PROVIDER_ENDS" ] || while IFS=$'\t' read -r key src hold; do
    seen[$key]="$src	$hold"; [ "${hold:-0}" -le "$now" ] || keep[$key]="$src	$hold"
  done <"$PROVIDER_ENDS"
  while IFS= read -r it; do
    [ -n "$it" ] || continue
    IFS=$'\t' read -r slug agent file ended sessions reason < <(jq -r '[.slug, .agent, .file // "-", .finished // "-", .sessions // "-", .end_reason // "-"] | @tsv' <<<"$it")
    if [ "$ended" != - ]; then ended=$(date -d "$ended" +%s 2>/dev/null) || continue
    else ended=$(stat -c %Y "$file" 2>/dev/null) || continue; fi
    [ "$ended" -gt $(( now - win * 60 )) ] || continue
    key="$slug@${sessions##* }"   # a requeued slug runs under a new session id, so each run is read once
    keep[$key]="${seen[$key]:-}"
    [ -z "${seen[$key]:-}" ] || continue
    src=$(harness_source "$agent")
    if [ "$reason" != - ]; then end=$reason; else end=$(item_end "$it"); fi
    [ -n "$end" ] || continue   # unread: asked again next pass
    hold=0
    [ "$end" != provider ] || hold=$(( ended + $(jq -r --arg h "$agent" --argjson d "$DISPATCH_PROVIDER_HOLD_MIN" '.harnesses[$h].provider_hold_min // $d' "$HARNESSES") * 60 ))
    keep[$key]="$src	$hold"
    [ "$hold" = 0 ] || logline "provider hold: $slug ended on a provider refusal, so $src takes no start until $(date -d "@$hold" "+%F %H:%M")"
  done < <({ agent-queue list --json --state done --since "$(date -d "-$win minutes" +%F)" 2>/dev/null; agent-queue list --json --state review 2>/dev/null; } |
    jq -c --slurpfile H "$HARNESSES" 'select(.agent != null and ($H[0].harnesses[.agent].source // null) != null and (($H[0].harnesses[.agent].launcher // "") | IN("opencode", "agy")))' 2>/dev/null)
  mkdir -p "${PROVIDER_ENDS%/*}" && for key in "${!keep[@]}"; do [ -z "${keep[$key]}" ] || printf '%s\t%s\n' "$key" "${keep[$key]}"; done >"$PROVIDER_ENDS.tmp" &&
    mv "$PROVIDER_ENDS.tmp" "$PROVIDER_ENDS"
}

# ladder_open_why <harness> -> why the harness takes no more ladder rows, rc 1, or nothing. It is open when:
#  - lanes.yaml has a trainee block (model-lane prints {} when it is off or malformed), so the off switch,
#    `candidates: []`, stops a direct run too, which lands with no review,
#  - its source is not held (provider_hold_why),
#  - its source has room (`claude-acct room --source`): the source's cap, computed in the sources file from
#    the provider's published limit, less every item live on it, canaries and other harnesses included,
#    so a trainee's slots are what the canaries leave (trainee-steady-queue P3); a source with no cap there
#    takes one trainee item at a time, as a harness lanes.yaml named no max_live for once did,
#  - it holds fewer waiting diffs than the block's `max_waiting` (2 when unset), so a review that waits on
#    claude stops a harness only once that many of its diffs wait, never at its first.
ladder_open_why() {
  local h="$1" waiting max src hold why row rc
  jq -e '[.candidates[]?] | length > 0' <<<"${TRAINEE_CONF:-null}" >/dev/null 2>&1 ||
    { echo "lanes.yaml has no trainee: lane (model-lane trainee)"; return 1; }
  src=$(harness_source "$h")
  [ -n "$src" ] || { echo "$h has no source in $HARNESSES"; return 1; }
  hold=$(provider_hold_why "$src") && { echo "$h: $hold"; return 1; }
  row=$(claude-acct room --source "$src" --json 2>/dev/null); rc=$?
  why=$(jq -r 'if .room.ok | not then .room.why // empty elif .max_live == null and (.live // 0) >= 1
    then "its \(.live) live item and no cap in the sources file (max_live, or rpm and run_rpm) take its one slot" else empty end' <<<"$row" 2>/dev/null) || why=''
  [ "$rc" = 0 ] && [ -z "$why" ] || { echo "$h: $src: ${why:-claude-acct room --source gave no answer}"; return 1; }
  waiting=$(ladder_counts "$h") || { echo "the queue is unreadable, so $h's ladder rows are unknown"; return 1; }
  max=$(jq -r '.max_waiting // 2' <<<"$TRAINEE_CONF")
  [ "$waiting" -lt "$max" ] || { echo "$h holds $waiting waiting diffs, its max_waiting in lanes.yaml"; return 1; }
}

# trainee_brief <item json> -- a trainee's run: the task, done in its worktree and left there. The
# sandbox lets it neither commit nor reach the queue, gh or the human, so its diff goes to review.
trainee_brief() {
  jq -r .task <<<"$1"
  echo
  echo "You run in a sandbox that sees this worktree alone: no skills, agent-queue, gh, push or human. Ignore any step above that needs one."
  echo "Make the smallest change in this worktree that fully does the task, run the repo's own tests for what you changed where they run here, and stop."
  echo "Do not commit, push or open a pull request: leave your edits in the working tree. They are checked and landed, or the task is sent back, after you stop."
  echo "If the task cannot be done without a decision from the human, change nothing and stop."
}

# linked_base -> HEAD of the linked worktree this runs in, rc 1 in a main checkout or none: a ladder
# tail resets its worktree to that base, which in a main checkout would discard work.
linked_base() {
  local b
  b=$(git rev-parse HEAD 2>/dev/null) && [ "$(cd "$(git rev-parse --git-dir)" && pwd -P)" != "$(cd "$(git rev-parse --git-common-dir)" && pwd -P)" ] && echo "$b"
}

# cmd_trainee_review <slug> -- the tail of a trainee's run (gateway_launch), outside its sandbox, in its
# worktree. The diff it left becomes TRAINEE_DIR/<slug>.patch beside its base (<slug>.base), the
# worktree goes back to that base so wt reaps it, and the row waits in review, where reap leaves an
# item with a note, for the next batch review (trainee_batch_start). No diff, or no reviewer lane
# (lanes.yaml trainee:), is a reject (cmd_trainee_reject).
cmd_trainee_review() {
  local slug="${1:?trainee-review: needs a slug}" it trn base patch why
  it=$(agent-queue show "$slug" --json 2>/dev/null) && [ -n "$it" ] || { say "trainee-review: no queue item $slug"; return 1; }
  trn=$(jq -r '.trainee // empty' <<<"$it")
  [ -n "$trn" ] || { say "trainee-review: no trainee ran $slug"; return 2; }
  [ "$(jq -r .state <<<"$it")" = running ] || { say "trainee-review: $slug is $(jq -r .state <<<"$it"), not running"; return 2; }
  # The reset below discards what the diff saved, so it runs only in a linked worktree, never a main checkout.
  base=$(linked_base) || { say "trainee-review: $PWD is no linked worktree"; return 1; }
  mkdir -p "$TRAINEE_DIR" || { say "trainee-review: no $TRAINEE_DIR"; return 1; }
  patch="$TRAINEE_DIR/$slug.patch"
  git add -A && git diff --cached --binary "$base" >"$patch" && echo "$base" >"$TRAINEE_DIR/$slug.base" ||
    { say "trainee-review: could not save the diff $trn left on $slug"; return 1; }
  [ -s "$patch" ] || { cmd_trainee_reject "$slug" --why "$(trainee_empty_why "$it" "$trn")"; return; }
  why=$(trainee_diff_why "$(git rev-parse --show-toplevel)" "$base") ||
    { cmd_trainee_reject "$slug" --why "$why" || return  # still running: the worktree keeps the diff
      git reset -q --hard "$base" && git clean -fdq || say "trainee-review: could not put $PWD back at $base, so wt reap leaves it"
      return 0; }
  # The worktree goes back to its base only once the row waits in review: until then it holds the diff too.
  trainee_load
  if [ -z "$(jq -r '.reviewer_model // empty' <<<"$TRAINEE_CONF")" ]; then
    cmd_trainee_reject "$slug" --why "lanes.yaml names no trainee reviewer" || return
  else
    agent-queue set "$slug" "note=trainee $trn left a diff; the next trainee batch review lands it or sends the row back" >/dev/null &&
      agent-queue move "$slug" review >/dev/null ||
      { say "trainee-review: could not move $slug to review; it stays running, its diff in $patch and in $PWD"; return 1; }
    say "trainee-review: $slug's diff is $patch; it waits for the next batch review"
  fi
  git reset -q --hard "$base" && git clean -fdq || say "trainee-review: could not put $PWD back at $base, so wt reap leaves it"
}

# trainee_empty_why <item json> <trainee> -> the reject reason for a run that left no diff: what ended its
# session (item_end) when that was not the model finishing its turn, else "left no diff". The review runs
# where the run ran, so the item's host is dropped and its record is read here. 12 of 16 empty-diff
# free-model runs on 2026-11-19 ended on a provider refusal or the timeout (agent-runtime
# docs/canary-free-failures-2026-11-19.md), and "left no diff" read as the model giving up.
trainee_empty_why() {
  local end
  end=$(item_end "$(jq -c 'del(.host)' <<<"$1")")
  case "$end" in
    provider) echo "$2's session ended on a provider refusal or error (end provider: a rate limit, budget or provider fault), with no diff" ;;
    refused) echo "$2's session ended on the provider refusing its key (end refused), with no diff" ;;
    limit) echo "$2's session ended on a usage limit (end limit), with no diff" ;;
    timeout) echo "$2's session ran out its harness timeout (end timeout), with no diff" ;;
    cut) echo "$2's session was cut off mid-work (end cut), with no diff" ;;
    *) echo "$2 left no diff" ;;
  esac
}

# trainee_waiting -> the rows whose diff waits for a batch review, as item JSON lines: in review, a
# trainee's, their patch in TRAINEE_DIR, no PR yet (an approved row whose PR has not merged is no new
# diff), and no per-diff review-<slug> item (the old hand-off) open. A run on a fleet worker left its
# patch in the worker's TRAINEE_DIR, so it is fetched here first (trainee_fetch).
trainee_waiting() {
  agent-queue list --json --state active 2>/dev/null | jq -sc '(map(.slug) | map({key: ., value: 1}) | from_entries) as $s
    | .[] | select(.state == "review" and (.trainee // "") != "" and ((.pr // "") == "") and ($s["review-" + .slug] | not))' |
    while IFS= read -r it; do
      [ -s "$TRAINEE_DIR/$(jq -r .slug <<<"$it").patch" ] || trainee_fetch "$it" || continue
      echo "$it"
    done
  return 0
}

# trainee_fetch <item json> -- copy the patch and base a trainee run on the item's fleet worker (host:)
# left in that worker's TRAINEE_DIR into this one's; rc 1, the files untouched, when it ran here, the
# worker does not answer, or it holds no patch.
trainee_fetch() {
  local host slug tmp
  IFS=$'\t' read -r host slug < <(jq -r '[.host // "", .slug] | @tsv' <<<"$1")
  [ -n "$host" ] || return 1
  mkdir -p "$TRAINEE_DIR" || return 1
  tmp="$TRAINEE_DIR/$slug.fetch.$$"
  fleet_host_run "$host" fleet-dispatch trainee-patch "$slug" >"$tmp" 2>/dev/null && [ -s "$tmp" ] &&
    tail -n +2 "$tmp" >"$tmp.patch" && [ -s "$tmp.patch" ] && head -n 1 "$tmp" >"$TRAINEE_DIR/$slug.base" &&
    mv -f "$tmp.patch" "$TRAINEE_DIR/$slug.patch" || { rm -f "$tmp" "$tmp.patch"; return 1; }
  rm -f "$tmp"
  logline "trainee: fetched $slug's patch from $host"
}

# cmd_trainee_patch <slug> -- this machine's base for that row's trainee diff, one line, then the patch
# (TRAINEE_DIR); rc 1, nothing printed, with no patch. A dispatcher runs it on the worker (trainee_fetch).
cmd_trainee_patch() {
  [[ "${1:-}" =~ ^[A-Za-z0-9._-]+$ ]] || { say "trainee-patch: no slug"; return 2; }
  [ -s "$TRAINEE_DIR/$1.patch" ] && [ -s "$TRAINEE_DIR/$1.base" ] || return 1
  head -n 1 "$TRAINEE_DIR/$1.base" && cat "$TRAINEE_DIR/$1.patch"
}

# cmd_run_result <slug> -- one line on what a headless run left, for its replay's agent-panel row
# (gateway_launch, AGENT_RUN_RESULT): the patch its review hand-off wrote, by files and lines, else
# its item's PR, else its note, else its state. Run in the pane, after the tail, on the run's machine.
cmd_run_result() {
  [[ "${1:-}" =~ ^[A-Za-z0-9._-]+$ ]] || { say "run-result: no slug"; return 2; }
  local it
  if [ -s "$TRAINEE_DIR/$1.patch" ]; then
    awk '/^diff --git /{f++; h=1; next} /^@@/{h=0; next} h{next} /^\+/{a++} /^-/{d++}
      END{printf "patch written, %d file%s, +%d -%d\n", f, (f == 1 ? "" : "s"), a, d}' "$TRAINEE_DIR/$1.patch"
    return
  fi
  it=$(agent-queue show "$1" --json 2>/dev/null) && [ -n "$it" ] || { echo "no queue item"; return; }
  jq -r 'if (.pr // "") != "" then "PR \(.pr), \(.state)"
    elif (.note // "") != "" then (.note | gsub("\\s+"; " ") | if length > 120 then .[:117] + "..." else . end)
    else .state + (if (.status // "") != "" then " (\(.status))" else "" end) end' <<<"$it"
}

# cmd_item_end <harness> <session id>... -- why the run of that harness that claimed those ids ended,
# from this machine's record of it (item_end); nothing when none is found. A dispatcher runs it on the
# worker a run was placed on (item_end).
cmd_item_end() {
  local agent=${1:-} id
  [[ "$agent" =~ ^[a-z0-9-]+$ ]] || { say "item-end: no harness"; return 2; }
  shift
  for id in "$@"; do [[ "$id" =~ ^[A-Za-z0-9_-]+$ ]] || { say "item-end: $id is not a session id"; return 2; }; done
  item_end "$(jq -nc --arg a "$agent" --arg s "$*" '{agent: $a, sessions: $s}')"
}

# trainee_review_task <item json> <trainee> <base> <patch> <task key> -> one row's part of a batch
# review's brief (trainee_batch_task).
trainee_review_task() {
  local slug repo t3=''
  slug=$(jq -r .slug <<<"$1")
  repo=$(repo_dir "$(jq -r '.project // ""' <<<"$1")")
  # A tier-3 row lands behind agent-land's review_gate, so its review says so up front.
  [ "$(item_tier "$1")" != 3 ] || t3=" This row is tier 3: before landing, run /code-review high on the PR, fix or answer each finding, and add the PR body line \"Review: /code-review high, <what it found and what you did>\", which agent-land requires."
  cat <<EOF
## Queue item $slug

The trainee $2 ran this row in a sandbox, on base $3 of ${repo:-its project repo}, and could not commit. Its whole change is the patch $4.$t3

The row it was given:
$(jq -r .task <<<"$1")

- Approve: cut a worktree of ${repo:-the repo} off origin/main, \`git apply --3way $4\`, make the small fixes, and take it to landed by the one-shot skill from its step 3a (final-pass, validate, PR, land). The PR body carries the lines "Item: $slug"${5:+, "Task: $5"} and "Trainee: $2, approved by review". Before landing, record what you changed: \`agent-queue set $slug review_fix=none\` when the patch landed as it was, \`review_fix=small\` when you fixed or added something on top. Land with \`agent-land <N> --item $slug\`.
- Reject: \`fleet-dispatch trainee-reject $slug --why "<one line: what was wrong>"\`. The row goes back to the normal queue, on claude.
EOF
}

# trainee_batch_task <batch slug> <item json lines> -> a batch review item's whole brief (item_brief
# passes it as it stands): one part a waiting row, made when the batch is filed and started.
trainee_batch_task() {
  local it trn
  cat <<EOF
This is agent-queue item $1. Review each diff the trainees left below, one at a time, and land it or send its row back: one PR per approved row.

Approve only when the diff does the row correctly and fully and needs at most small fixes; anything more is a reject, so the trainee's record stays true. When every row below is landed or sent back, \`agent-queue move $1 done --status ok\`.
EOF
  while IFS= read -r it; do
    [ -n "$it" ] || continue
    trn=$(jq -r .trainee <<<"$it")
    echo
    trainee_review_task "$it" "$trn" "$(cat "$TRAINEE_DIR/$(jq -r .slug <<<"$it").base" 2>/dev/null || echo unknown)" \
      "$TRAINEE_DIR/$(jq -r .slug <<<"$it").patch" "$(cut -d$'\x1f' -f4 <<<"$(item_row "$it")")"
  done <<<"$2"
}

# trainee_batch_headless <batch slug> -> what a batch review on a headless harness (the reviewer_fallback,
# trainee_reviewer_pin) adds to its brief: no slash commands, so the one-shot skill is read, and a tier-3
# row stops at its open PR, since agent-land's review_gate wants the Review line /code-review high writes.
# own_parked_pr gives that green PR a claude lander, as it does any headless tier-3 run's (item_brief --pr-only).
trainee_batch_headless() {
  cat <<EOF

You run headless: no slash commands and no human at the pane. Where a row says to take it to landed by the one-shot skill, read ~/.claude/skills/one-shot/SKILL.md and follow it from step 3a. A tier-3 row cannot land from here: agent-land wants the Review line that /code-review high writes, which you cannot run, and you never write that line yourself. Approve one as far as its open PR (the one-shot skill's --pr-only), then \`agent-queue set <slug> review_fix=<none|small> pr=<owner>/<repo>#<N>\` and leave its item in review: once its checks are green, dispatch starts a Claude lander that reviews and lands it. A row at its open PR counts as done for this batch, so close $1 as above once each row is landed, at its open PR, or sent back.
EOF
}

# cmd_trainee_reject <slug> --why <text> -- the row goes back to the normal queue on claude (its outcome
# a redo on the trainee's run, ladder_back), with the reason as its note; its `trainee:` stays, so no
# trainee takes it again (trainee_why).
cmd_trainee_reject() {
  local slug="${1:?trainee-reject: needs a slug}" why='' it trn run
  shift
  [ "${1:-}" = --why ] && [ -n "${2:-}" ] || { say "trainee-reject: needs --why \"<one line>\""; return 2; }
  why=$2
  it=$(agent-queue show "$slug" --json 2>/dev/null) && [ -n "$it" ] || { say "trainee-reject: no queue item $slug"; return 1; }
  trn=$(jq -r '.trainee // empty' <<<"$it")
  [ -n "$trn" ] || { say "trainee-reject: no trainee ran $slug"; return 2; }
  # The why goes on the trainee's run, the reject reason `model-lane score` prints per pair; the requeue
  # below files the same redo again, which model-lane checks no bar for twice.
  run=$(jq -r '.lane_run // empty' <<<"$it")
  [ -z "$run" ] || model-lane outcome "$run" redo --why "$why" --cause reject >/dev/null 2>&1 || logline "model-lane outcome $run redo failed; $slug's reject reason is in its note only"
  ladder_back "$slug" "trainee $trn rejected: $why" reject || { say "trainee-reject: could not send $slug back to the queue"; return 1; }
  rm -f "$TRAINEE_DIR/$slug.patch" "$TRAINEE_DIR/$slug.base"
  say "trainee-reject: $slug is back in the queue, on claude: $why"
}

# cmd_validate <slug> --pr <owner>/<repo>#<N> --head <sha> --why <text>: agent-land's hand-off of a
# critical landing (validate_gate). It files validate-<slug>-<head:0:8>, a second agent's review of that
# head, which records its verdict on its own item and runs agent-land again. It is `after:` the author
# item, live with that open PR, so its worktree is cut from the PR's head (stack_base). From
# auto:validate, so admission never holds it. One already filed for the head is left as it is.
cmd_validate() {
  local slug="${1:?validate: needs a slug}" ref='' head='' why='' vslug it out rc=0
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --pr) ref=${2:-} ;;
      --head) head=${2:-} ;;
      --why) why=${2:-} ;;
      *) say "validate: unknown argument: $1"; return 2 ;;
    esac
    shift 2 || { say "validate: $1 needs a value"; return 2; }
  done
  [[ "$ref" =~ ^[^/]+/[^/#]+#[0-9]+$ && "$head" =~ ^[0-9a-f]{8,40}$ ]] && [ -n "$why" ] ||
    { say "validate: needs --pr <owner>/<repo>#<N>, --head <sha> and --why <text>"; return 2; }
  it=$(agent-queue show "$slug" --json 2>/dev/null) && [ -n "$it" ] || { say "validate: no queue item $slug"; return 1; }
  vslug="validate-$slug-${head:0:8}"
  # A live one is filed already; one closed with no verdict (its session died) is filed again.
  [[ ! "$(item_state "$vslug")" =~ ^(queued|running|waiting|review)$ ]] || { say "validate: $vslug is filed already"; return 0; }
  out=$(validate_task "$vslug" "$slug" "$ref" "$head" "$why" | AGENT_QUEUE_PULL=dispatch AGENT_QUEUE_START=0 agent-queue add \
    --project "$(jq -r .project <<<"$it")" --slug "$vslug" --after "$slug" --priority high --tags validate --from auto:validate \
    --title "check(validate): $slug, ${ref##*/}" 2>&1) || rc=$?
  [ "$rc" -eq 0 ] || { say "validate: could not queue $vslug: ${out##*$'\n'}"; return 1; }
  logline "queued $vslug: $ref is critical ($why)"
  say "validate: queued $vslug"
}

# validate_self_why <item json> <resume sid> <session> -> rc 1 and why, when a validate item (cmd_validate)
# would run as its author: no author item (`after:`) or itself, or a resume of a conversation, or into
# a tmux session, that worked the author item. A fresh start is a new conversation. agent-land checks
# the same on the verdict (validate_gate: no shared session).
validate_self_why() {
  local slug author a as
  [[ " $(jq -r '.tags // ""' <<<"$1") " == *" validate "* ]] || return 0
  slug=$(jq -r .slug <<<"$1"); author=$(jq -r '.after // ""' <<<"$1")
  [ -n "$author" ] && [ "$author" != "$slug" ] || { echo "is a validate item whose after: names no author item but itself, so it validates nothing"; return 1; }
  [ -n "$2$3" ] || return 0
  a=$(agent-queue show "$author" --json 2>/dev/null) || a=''
  [ -z "$2" ] || [[ " $(jq -r '.sessions // ""' <<<"${a:-null}") " != *" $2 "* ]] ||
    { echo "validates $author, which conversation $2 worked: a second agent validates it, never its author"; return 1; }
  as=$(jq -r '.session // ""' <<<"${a:-null}")   # <server>:<session>
  if [ -n "$3" ] && [ -n "$as" ] && { [ "$3" = "$as" ] || [ "$3" = "${as#*:}" ]; }; then
    echo "validates $author, whose session is $as: a second agent validates it, never its author"; return 1
  fi
}

# validate_task <validate slug> <author slug> <owner/repo#N> <head> <why>: a validate item's whole brief
# (item_brief passes it as it stands).
validate_task() {
  local n=${3##*#} repo=${3%#*}
  cat <<EOF
This is agent-queue item $1: a review by a second agent of PR $3, the work of queue item $2, before it lands. The work is critical ($5), so agent-land merges it only on your pass verdict. You did not write it: review it as a stranger, and do not fix it yourself; the author makes any fix.

1. Work at the PR's head $4. Your worktree is cut from it; if \`git rev-parse HEAD\` differs, run \`gh pr checkout $n -R $repo --detach\`.
2. Read what it was asked to do (\`agent-queue show $2\`) and the change (\`gh pr view $n -R $repo\`, \`gh pr diff $n -R $repo\`). Run /code-review high on it, and the tests that cover what it changed.
3. Pass only when the diff does what its item asks, correctly, with no finding left unanswered; else fail. Record it on this item, with what you checked or the findings on one line:
   \`agent-queue set $1 verdict=<pass|fail> verdict_head=\$(git rev-parse HEAD) note="<what you checked, or the findings>"\`
4. Run \`agent-land $n --repo $repo --item $2\` from this worktree. On a pass it merges the PR and closes $2; on a fail it leaves the PR open and sends $2 back to the queue with your note.
5. Run \`agent-queue move $1 done --status ok\`, then wind down.
EOF
}

# rollup_causes <since> <stamps json> -> one TSV line per trainee reject cause in LANE_RUNS since <since>
# (UTC, YYYY-MM-DDTHH:MM:SS): the cause, its row title, its count, the per-pair counts, the harnesses, and
# one reason as written. A reject is a lane trainee run with an outcome of redo or failed. Its cause is
# the `(end <reason>)` trainee_empty_why writes, "no diff" for "left no diff", "no reason recorded" for a
# run with no `why`, else the reviewer's first four words; at most 40 characters, so the title fits the
# board's 80. One cause on one pair names that pair; on two or more it names no model, since a cause
# every model hits is the harness's or the source's. The cause is the key, so a cause that spreads to a
# second pair keeps its count and its row: a reject no newer than its cause's stamp (the last night that
# cause was filed or found open) is not counted again, and a cause whose row closed starts from nothing.
# A line of the log that is no JSON (a torn append) is skipped.
rollup_causes() {
  jq -Rnr --arg since "$1" --argjson stamps "$2" '
    def words: ascii_downcase | gsub("[^a-z0-9]+"; " ") | ltrimstr(" ") | rtrimstr(" ") | split(" ") | .[0:4] | join(" ");
    def fit: if length <= 40 then . else .[0:40] | sub(" [^ ]*$"; "") end;
    [inputs | fromjson? // empty
      | select(type == "object" and .lane == "trainee" and (.outcome == "redo" or .outcome == "failed") and ((.ts // "")[0:19] >= $since))
      | ((.harness // "claude") + ":" + (.ran // "-")) as $pair
      | ((.why // "") | ltrimstr($pair + "'"'"'s ") | ltrimstr($pair + " ")) as $w
      | ([$w | capture("\\(end (?<e>[a-z-]+)").e] | first) as $e
      | {pair: $pair, harness: (.harness // "claude"), ts: .ts[0:19], why: (.why // "no reason recorded (outcome \(.outcome))"),
         cause: (if $e then "keep ending on end " + $e elif $w == "left no diff" then "keep leaving no diff"
                 elif $w == "" then "end with no reason recorded" else "are rejected for " + ($w | words) end | fit)}]
    | group_by(.cause)[]
    | . as $all | $all[0].cause as $c
    | [$all[] | select(.ts > ($stamps[$c] // ""))] as $new
    | select($new | length > 0)
    | ($all | map(.pair) | unique) as $pairs
    | [$c, "fix(trainee): " + (if ($pairs | length) == 1 then $pairs[0] else "trainee" end) + " runs " + $c,
       ($new | length), ($new | group_by(.pair) | map("\(.[0].pair) \(length)") | join(", ")),
       ($new | map(.harness) | unique | join(", ")), ($new | last | .why)] | @tsv' "$LANE_RUNS"
}

# cmd_trainee_rollup [--dry] -- each recurring cause of trainee rejects made one fix row, so the ladder
# stops paying for the same failure night after night (why-are-more-trainees-twinkling P4): rollup_causes
# over the last DISPATCH_ROLLUP_DAYS, and a cause seen DISPATCH_ROLLUP_MIN times or more files one row on
# the DISPATCH_ROLLUP_BOARD agent board, or joins the open fix(trainee) row there whose title ends in that
# cause, whichever pair it names. Each cause filed or joined is stamped in $DIR/trainee-rollup.tsv (cause
# TAB UTC time; a stamp older than the window is dropped), so the next night counts only newer rejects.
# fleet-dispatch is a direct filer, so the row goes on the board; it goes through the queue and review like
# any other row, and nothing here patches anything. nightly-measure runs it, so each pass declares its
# outcome (rollup_done): WORKED when it filed or joined a row, NOOP when no cause cleared the bar, FAILED.
cmd_trainee_rollup() {
  local dry=0 stamps since board lines cause title n pairs hs why hit where rc out=0 acted=0 now f="$DIR/trainee-rollup.tsv"
  [ "${1:-}" != --dry ] || dry=1
  [ -r "$LANE_RUNS" ] || { say "trainee-rollup: no run log at $LANE_RUNS"; rollup_done "$dry" FAILED "no run log at $LANE_RUNS"; return; }
  stamps=$(jq -Rsc 'split("\n") | map(select(length > 0) | split("\t") | {(.[0]): .[1]}) | add // {}' "$f" 2>/dev/null) || stamps='{}'
  now=$(date -u +%FT%T)
  since=$(date -u -d "@$(( $(date +%s) - DISPATCH_ROLLUP_DAYS * 86400 ))" +%FT%T)
  lines=$(rollup_causes "$since" "$stamps") || { say "trainee-rollup: could not read $LANE_RUNS"; rollup_done "$dry" FAILED "could not read $LANE_RUNS"; return; }
  [ -n "$lines" ] || { echo "trainee-rollup: no new trainee rejects since ${since%T*}"; rollup_done "$dry" NOOP "no new trainee rejects"; return; }
  board=$(notes ptask "$DISPATCH_ROLLUP_BOARD" --agent list 2>/dev/null) || { say "trainee-rollup: cannot read the $DISPATCH_ROLLUP_BOARD board, so no row is filed"; rollup_done "$dry" FAILED "cannot read the $DISPATCH_ROLLUP_BOARD board"; return; }
  while IFS=$'\t' read -r cause title n pairs hs why; do
    if [ "$n" -lt "$DISPATCH_ROLLUP_MIN" ]; then echo "under the bar ($n of $DISPATCH_ROLLUP_MIN): $title ($pairs)"; continue; fi
    # the whole cause, up to the row's tags or marker: a longer title that starts the same is another cause
    hit=$(cut -f4 <<<"$board" | grep -iE -m1 -- "^- \[[ /]\] fix\(trainee\): [^ ]+ runs $cause( #| <!--|$)")
    if [ -n "$hit" ]; then
      echo "joined $(sed -n 's/.*<!-- id:\([^ ]*\).*/\1/p' <<<"$hit" | grep . || echo 'its open row'): $title ($n since ${since%T*}: $pairs)"
    elif [ "$dry" = 1 ]; then
      echo "would file: $title ($n since ${since%T*}: $pairs)"; continue
    else
      if [[ "$title" == "fix(trainee): trainee runs "* ]]; then where="the harness or source ($hs): more than one model hits it"
      else where="how ${pairs% *} runs, or drop the pair (model-lane): no other model hits it"; fi
      rc=0
      notes ptask "$DISPATCH_ROLLUP_BOARD" --agent add "$title $DISPATCH_ROLLUP_TAGS" --origin fleet-dispatch \
        --detail "$n trainee rejects since ${since%T*}: $pairs. Fix it in $where." \
        --detail "e.g. $why" \
        --detail "evidence: jq -c 'select(.lane == \"trainee\" and (.outcome == \"redo\" or .outcome == \"failed\"))' ~/.agent/model-lane/runs.jsonl; filed by fleet-dispatch trainee-rollup" \
        >/dev/null 2>&1 || rc=$?
      case "$rc" in
        0|4) echo "filed: $title ($n since ${since%T*}: $pairs)"; logline "trainee-rollup: filed $title ($n: $pairs)" ;;
        3) echo "joined its twin, which notes refused it as: $title" ;;
        *) say "trainee-rollup: the $DISPATCH_ROLLUP_BOARD board refused $title (notes exit $rc)"; out=1; continue ;;
      esac
    fi
    stamps=$(jq -c --arg c "$cause" --arg n "$now" '.[$c] = $n' <<<"$stamps")
    acted=$((acted + 1))
  done <<<"$lines"
  [ "$dry" = 1 ] && return "$out"
  { mkdir -p "$DIR" && jq -r --arg s "$since" 'to_entries[] | select(.value >= $s) | [.key, .value] | @tsv' <<<"$stamps" > "$f.tmp" && mv -f "$f.tmp" "$f"; } ||
    { say "trainee-rollup: could not write $f"; out=1; }
  if [ "$out" != 0 ]; then rollup_done 0 FAILED "the $DISPATCH_ROLLUP_BOARD board refused a row, or $f was not written"
  elif [ "$acted" -gt 0 ]; then rollup_done 0 WORKED "$acted cause(s) filed or joined"
  else rollup_done 0 NOOP "no cause reached $DISPATCH_ROLLUP_MIN rejects"; fi
}

# rollup_done <dry> <verdict> <words> -- a trainee-rollup pass's outcome under agentctl, which reads a step
# that declares none as STALLED (agentctl-steps), and its status: 1 for FAILED, else 0. --dry declares nothing.
rollup_done() {
  if [ "$1" = 0 ]; then
    # shellcheck source=/dev/null
    . "$HOME/.local/lib/agent-proof.sh" 2>/dev/null && proof_runner_outcome "$2" "$3" 2>/dev/null
  fi
  [ "$2" != FAILED ]
}

# ladder_back <slug> <note> [cause] -- a ladder run's row back to the normal queue on claude, the note saying
# why; agent-queue move reads the running -> queued step as a redo on the run, which model-lane counts, with
# that cause (MOVE_CAUSES; requeue when none).
ladder_back() {
  agent-queue set "$1" agent=claude model= routed= "note=$2" >/dev/null && agent-queue move "$1" queued ${3:+--cause "$3"} >/dev/null
}

# DIRECT_GUARDED: paths a direct run's diff may not touch, as an ERE on the repo-relative path. Its
# commit runs the repo's hooks outside the sandbox and lands on its CI, so a diff that edits either
# would run or grade itself; core.hooksPath is added to these.
DIRECT_GUARDED='^(\.github|\.forgejo|\.githooks|\.husky)/'

# cmd_direct_land <slug> [--rc <n>] -- the tail of a direct run (gateway_launch), outside its sandbox,
# in its worktree, given the run's exit status: the diff a run that ended clean left is committed on the
# worktree's branch, pushed, opened as a PR and landed by agent-land once checks that ran are green
# (--ran-checks), with no review; agent-land records the PR on the item and closes its row. A run that
# exited non-zero, no diff, a diff on DIRECT_GUARDED paths, or a commit, push, PR or landing that fails
# closes the PR and sends the row back (direct_back); a PR that merged before agent-land failed stays.
cmd_direct_land() {
  local slug="${1:?direct-land: needs a slug}" rc=0 it drc base branch guard hp bad title key url pr
  [ "${2:-}" != --rc ] || rc="${3:-1}"
  it=$(agent-queue show "$slug" --json 2>/dev/null) && [ -n "$it" ] || { say "direct-land: no queue item $slug"; return 1; }
  drc=$(jq -r '.direct // empty' <<<"$it")
  [ -n "$drc" ] || { say "direct-land: no direct run took $slug"; return 2; }
  [ "$(jq -r .state <<<"$it")" = running ] || { say "direct-land: $slug is $(jq -r .state <<<"$it"), not running"; return 2; }
  # direct_back resets the worktree, so this runs only in a linked worktree, never a main checkout.
  base=$(linked_base) || { say "direct-land: $PWD is no linked worktree"; return 1; }
  [ "$rc" = 0 ] || { direct_back "the run exited $rc (a timeout, crash or provider error)"; return; }
  branch=$(git symbolic-ref --short -q HEAD) || { direct_back "its worktree is on no branch"; return; }
  git add -A || { direct_back "its diff could not be staged"; return; }
  ! git diff --cached --quiet || { direct_back "it left no diff"; return; }
  guard=$DIRECT_GUARDED
  hp=$(git config --local core.hooksPath) && guard="$guard|^${hp%/}/"
  bad=$(git diff --cached --name-only | grep -E "$guard" | awk 'NR<=3' | paste -sd, -)
  [ -z "$bad" ] || { direct_back "its diff touches hook or CI paths ($bad), which a direct run may not"; return; }
  # The board's trailing tags (#pts/3 #size/s) are no part of a commit or PR title.
  title=$(item_headline "$it" | sed -E 's/([[:space:]]+#[^[:space:]]+)+[[:space:]]*$//')
  key=$(cut -d$'\x1f' -f4 <<<"$(item_row "$it")")
  # The commit runs the repo's own hooks (the token scan), which the sandboxed run could not reach.
  git commit -q -m "$title" -m "Direct: $drc" || { direct_back "the commit failed (the repo's hooks)"; return; }
  git push -q -u origin "$branch" || { direct_back "the push of $branch failed"; return; }
  url=$(gh pr create --head "$branch" --title "$title" --body "$(direct_pr_body "$it" "$drc" "$key")") ||
    { git push -q origin --delete "$branch"; direct_back "gh pr create failed"; return; }
  pr=${url##*/}
  local lrc=0
  agent-land "$pr" --item "$slug" --ran-checks || lrc=$?
  [ "$lrc" != 0 ] || { say "direct-land: $slug landed as #$pr, by $drc with no review"; return 0; }
  # Exit 5: critical work waits on its validate item, whose session lands it; the PR stays open.
  if [ "$lrc" = 5 ]; then
    agent-queue move "$slug" review >/dev/null || say "direct-land: could not park $slug in review; it stays running"
    say "direct-land: #$pr is critical, so it waits on a second agent's review; $slug is in review"; return 0
  fi
  # agent-land can fail after its merge (the record, the row); the work is in, so nothing is redone.
  [ "$(gh pr view "$pr" --json state -q .state 2>/dev/null)" != MERGED ] ||
    { say "direct-land: #$pr merged, but agent-land failed after it; $slug stays running: agent-land $pr --item $slug records it"; return 1; }
  gh pr close "$pr" --delete-branch --comment "agent-land refused or failed this direct run of $drc; the row goes back to the queue, on claude." >/dev/null ||
    say "direct-land: could not close #$pr"
  direct_back "agent-land #$pr failed"
}

# direct_pr_body <item json> <pair> <task key> -> a direct run's PR body: the row it ran and the Task:
# line the board reads (agent-land stamps the Item: line).
direct_pr_body() {
  jq -r .task <<<"$1"
  echo
  echo "Direct run: $2, which model-lane score promoted for this class. It ran in its lane sandbox, and this PR lands on its checks with no review."
  echo
  [ -z "$3" ] || echo "Task: $3"
}

# direct_back <why> -- a direct run that did not land, read from cmd_direct_land's slug, drc and base: the
# row goes back on claude (ladder_back), and the worktree back at its base so wt reaps it; its `direct:`
# stays, so no ladder run takes it again (ladder_row_why).
direct_back() {
  ladder_back "$slug" "direct run $drc did not land: $1" || { say "direct-land: could not send $slug back to the queue ($1)"; return 1; }
  git reset -q --hard "$base" && git clean -fdq || say "direct-land: could not put $PWD back at $base, so wt reap leaves it"
  say "direct-land: $slug is back in the queue, on claude: $1"
}

# takes_plan <harness> -- it can run a plan item: a pane that waits on the human at its plan, or a
# headless run that resumes, which posts the plan as an ask and is resumed on the answer (item_brief).
takes_plan() { ! headless "$1" || resumes "$1"; }

# resume_thread <item json> <harness> -> "<thread id> <rollout file>" when a start of the item on that
# harness takes up its last run's thread instead of starting cold: the harness resumes, the last run was
# on it, its rollout is on disk, and the item has no PR (fix_ci_brief owns a PR's red) and is no canary,
# which is scored fresh. The cases it covers: a requeue at the usage limit, an answered ask, a plan's approval.
resume_thread() {
  resumes "$2" && [ "$(jq -r '.agent // "claude"' <<<"$1")" = "$2" ] || return 0
  [ -z "$(jq -r '.pr // ""' <<<"$1")" ] && ! is_canary "$1" || return 0
  item_rollout "$1"
}

# worker_store_pull <host> <item> -- push the start of <item> and have <host>'s store pull it, then
# check that store reads it running. A worker's session closes its item in the worker's own store
# clone, which pulled only on its own writes and its 15-minute timer: a close made before the running
# move arrived moved the stale queued copy to done while origin moved it to running, a rename/rename
# that stopped the worker's sync (razer-laptop, 2026-11-18, ar-3439). The pull runs as a transient
# user unit: it gets the service manager's ssh agent, which an ssh exec lacks, and it waits on the
# sync lock behind a run already under way, where `systemctl start` would join that run and its
# older fetch. The check, not either exit code, is the verdict: store-sync exits 0 on a SKIP or a
# BACKUP that left origin without the write. Each of the two syncs is bounded by WORKER_PULL_SECS
# (the pull on the worker, ssh's own ConnectTimeout the link), so a slow remote holds a pass about
# two minutes at most.
WORKER_PULL_SECS=60
worker_store_pull() {
  local st
  timeout "$WORKER_PULL_SECS" store-sync --now >/dev/null 2>&1
  fleet_host_run "$1" timeout "$WORKER_PULL_SECS" systemd-run --user --wait --quiet --collect store-sync >/dev/null 2>&1 ||
    { say "start: $1 could not run its store sync, so its store may not hold $2 as running; a close there before its next sync conflicts"; return 0; }
  st=$(fleet_host_run "$1" agent-queue show "$2" 2>/dev/null | sed -n '1s/^state: //p')
  [ "$st" = running ] || say "start: the store on $1 reads $2 as ${st:-unreadable}, not running (did this machine's store-sync reach origin?); a close there before its next sync conflicts"
}

# stack_base <item json> <project> <slug> [host] -> the head commit of the open PR the item is stacked on (its
# `after:` item is live with an open PR, agent-queue stack_pr), the base its worktree is cut from, so the
# phase builds on its dependency's code while that PR waits for its checks. Nothing for an item that
# is not stacked. rc 1, and the item stays queued, when the head cannot be read or it is stacked on
# several PRs (one worktree has one base). agent-land merges it only after the dependency closed ok.
stack_base() {
  local on sha ref host=${4:-}
  on=$(jq -r '.stacked_on // empty' <<<"$1")
  [ -n "$on" ] || return 0
  [ -z "$host" ] || { say "start: $3 is stacked on an open PR, which only a worktree here builds on; start it without --host"; return 2; }
  # shellcheck disable=SC2086 # words: slug=owner/repo#N
  set -- $on "$2" "$3"
  [ $# -eq 3 ] || { say "start: ${!#} is stacked on ${on// /, }: one worktree builds on one open PR; it starts once all but one have merged"; return 1; }
  ref=${1#*=}
  sha=$(so_pr_view "$ref" "$(pr_repo_dir "$ref" "$2")" headRefOid .headRefOid) && [ -n "$sha" ] ||
    { say "start: could not read the head of $ref, which $3 is stacked on; it stays queued"; return 1; }
  say "start: $3 is stacked on ${1%%=*}'s open PR $ref, so its worktree is cut from ${sha:0:12}"
  echo "$sha"
}

# start_host_checks <host> <harness> <hjson> <item json> <cwd> <slug> -> rc 2 with the reason said when the worker's kit cannot take this start: a harness its fleet_harnesses does not list, a codex thread that lives on this machine, a repo it has no clone of.
start_host_checks() {
  local host=$1 harness=$2 hjson=$3 it=$4 cwd=$5 item=$6
  [ "$harness" = claude ] || jq -e --arg h "$harness" '.harnesses | index($h)' <<<"$hjson" >/dev/null ||
    { say "start: $item would run on $harness, which $host does not list in fleet_harnesses"; return 2; }
  # A codex thread to take up lives in this machine's ~/.codex (item_rollout), so its resume runs here.
  [ -z "$(resume_thread "$it" "$harness")" ] ||
    { say "start: $item resumes its last $harness thread, which is on this machine; start it here, without --host"; return 2; }
  jq -e --arg d "$cwd" '.repos | index($d)' <<<"$hjson" >/dev/null ||
    { say "start: $host has no clone of $cwd (fleet_repos); $item stays queued"; return 2; }
}

# dispatch_tag <host> <server> <session> <window> <pane> <label> -- tag what an agent started with @dispatch.
# set-option takes a pane target, where a bare "=name" is "no such session"; the colon makes it session:window.
# A --window start is one window of a shared session (a world restore opens each conversation as one), so its
# label goes on that window: a window with no option of its own falls back to the session's, so a session
# label marked every window of a restored hub:dotfiles [dispatch] (2026-11-21). Any other start owns its session.
dispatch_tag() {
  local scope=() tgt="=$3:"
  [ -z "$4" ] || { scope=(-w); tgt=${5:-=$3:}; }
  on_host "$1" tmux -L "$2" set-option "${scope[@]}" -t "$tgt" @dispatch "$6" || say "could not tag $3${4:+:$4} with @dispatch"
}

# cmd_start -- THE way an agent starts a session, whoever it is: this runner's `run` pass, an
# agent launching one for a board row, a reboot restore. Each comes out tagged @dispatch on its
# server, on the session, or on the window for a --window start (the human reads [dispatch] as "an agent started this"), except a resume of the human's
# own conversation (no item from a start, see the --resume branch), and a session doing work
# has a queue item whose `session:` names it, which reap, fleet-sessions and agent-web read.
# Before this, only `run` did either, and agents tagged their hand launches with set-option,
# which the human had to ask about twice.
#   --item SLUG             start that queued item: a worktree off --cwd (default: the project's
#                           repo) with `wt new`, claude on the item's brief there.
#   --host NAME             with --item: open it on that fleet worker (fleet-hosts.sh) over ssh, not here.
#                           On a harness whose launcher the worker's kit has (claude, codex, opencode, agy; past claude also listed in
#                           fleet_harnesses and read ready), in a repo it lists (fleet_repos); under DISPATCH_SANDBOX_PROFILE only where its kit has srt; its
#                           queue and ask writes go to the worker's own store clone, which store-sync pushes.
#   --harness NAME          with --item: run it on claude or a gateway harness in harnesses.json, not
#                           the item's `agent:`: claude-lazer and opencode on the eval key, codex on the ChatGPT plan, agy on the AI Pro login, lazer-reserve
#                           on the claude-reserve key (where a run pass routes a Sonnet-lane item, start_item).
#   --brief FILE --row KEY  claim the open row (an id in any case), promote it into a queue item with the brief as
#                           its task, and start that item as --item does. --mode plan makes it a plan item:
#                           the session opens in plan mode and waits on the human's approval.
#   --resume ID             a new session --session NAME in --cwd DIR running claude --resume, or, for an
#                           item on a harness that resumes (codex), agent-codex resume on its last thread.
#                           The sheet is not touched: the row was claimed before the reboot.
#                           --item SLUG re-attaches the started item that session was working;
#                           without it, the running, waiting or review item that lists ID, the newest when several do (`agent-queue mine --sid --newest`).
#                           --window NAME opens it as a window of --session instead, which may
#                           already hold others: a world session like hub:dotfiles.
#                           It reopens in the mode its transcript last shows; with none, plan for
#                           a plan item, else bypass. --prompt TEXT is its first message (claude
#                           only): how agent-ask reopen hands an ended session the answer to its ask.
#                           It leaves the pane it opened in START_PANE, which its caller clears (restore_world tags it).
cmd_start() {
  local base='' START_NOW='' project='' prof='' lane=human agent_work=1 key='' server='' model='' brief_file='' trn='' drc='' \
    resume='' cwd='' session='' window='' joined='' target='' area='' item='' it='' st='' flags='' ready='' harness='' prompt='' sid='' on='' verdict='' sbx_env='' sbx_flags='' host='' hjson='' hwhy='' rh='' qmode='' eff='' hold='' brief cmd label origin acct mode rec size
  while [ $# -gt 0 ]; do
    case "$1" in
      --agent) lane=agent; shift; continue ;;
      --now) START_NOW=1; shift; continue ;;
      --project | --profile | --row | --server | --model | --brief | --resume | --cwd | --session | --window | --area | --item | --harness | --host | --mode | --prompt) ;;
      *) say "start: unknown argument: $1"; return 2 ;;
    esac
    [ $# -ge 2 ] && [ -n "$2" ] || { say "start: $1 needs a value"; return 2; }
    case "$1" in
      --mode) qmode=$2 ;;
      --project) project=$2 ;;
      --profile) prof=$2 ;;
      --row) key=$2; if [[ "$key" =~ ^[A-Za-z]{2,4}-[0-9]+$ ]]; then key=${key,,}; fi ;; # ids are written lower-case, typed both ways
      --server) server=$2 ;;
      --model) model=$2 ;;
      --brief) brief_file=$2 ;;
      --resume) resume=$2 ;;
      --cwd) cwd=$2 ;;
      --session) session=$2 ;;
      --window) window=$2 ;;
      --area) area=$2 ;;
      --item) item=$2 ;;
      --harness) harness=$2 ;;
      --host) host=$2 ;;
      --prompt) prompt=$2 ;;
    esac
    shift 2
  done
  [ -z "$harness" ] || [ -z "$resume" ] || { say "start: --harness starts an item; a resume stays on what it ran"; return 2; }
  [ -z "$harness" ] || [ -n "$item" ] || { say "start: --harness needs --item"; return 2; }
  [ -z "$prompt" ] || [ -n "$resume" ] || { say "start: --prompt is the first message of a --resume"; return 2; }
  [[ "$prompt" != -* ]] || { say "start: --prompt cannot start with -: claude would read it as a flag"; return 2; }
  case "$qmode" in '' | oneshot | plan) ;; *) say "start: --mode is oneshot or plan, not $qmode"; return 2 ;; esac
  [ -z "$qmode" ] || [ -n "$brief_file" ] || { say "start: --mode sets the item --brief makes; a queued item keeps its own"; return 2; }
  [ -z "$START_NOW" ] || [ -n "$brief_file" ] || { say "start: --now starts a --row past its #after gates, so it needs --brief"; return 2; }
  if [ -n "$host" ]; then
    [ -n "$item" ] && [ -z "$resume$brief_file" ] || { say "start: --host starts a queued --item"; return 2; }
    fleet_hosts >/dev/null
    hjson=$(fleet_host "$host") || { say "start: $host is not in the fleet roster ($FLEET_HOSTS_GROUP)"; return 2; }
  fi
  # A new session goes where the manifests say; --server only puts a resume back where it was.
  [ -z "$server" ] || [ -n "$resume" ] || { say "start: --server is for --resume; the agent world comes from the manifests"; return 2; }
  [ -n "$server" ] || server=$(tmux-world agents)
  [ -n "$server" ] || { say "start: no world declares @agents on this machine"; return 1; }
  if [ -n "$brief_file" ]; then
    [ -z "$resume$item" ] || { say "start: give exactly one of --brief, --item or --resume"; return 2; }
    [ -n "$project" ] || { say "start: --project is required"; return 2; }
    [ -n "$key" ] || { say "start: --brief needs the --row it works"; return 2; }
    [ -z "$session" ] || { say "start: --brief cuts its own worktree session; --session is for --resume"; return 2; }
    brief=$(cat -- "$brief_file") && [ -n "$brief" ] || { say "start: empty or unreadable brief: $brief_file"; return 2; }
    lane=$(row_lane "$prof" "$project" "$lane" "$key") || { say "start: $key is not on either board of $project"; return 1; }
    # The row becomes a queue item and the item is what starts: one record and one launch for
    # every session. The item's brief adds /one-shot and how to close the row, so a brief that
    # opens with /one-shot is not run through it twice.
    promote "$(jq -cn --arg profile "$prof" --arg project "$project" --arg lane "$lane" --arg key "$key" --arg area "$area" \
      '{profile: $profile, project: $project, lane: $lane, key: $key, area: $area}')" "" "${brief#/one-shot }" "" "$qmode" >/dev/null || return 1
    # A plan row's chain may queue no phase to start now: its first open phase waits on its own row.
    [ -n "$PROMOTED" ] || { say "start: row $key queued no item to start now: ${EPIC_TOOK:-the chain of its plan waits on its rows}"; return 0; }
    item=$PROMOTED key=''
  elif [ -z "$item$resume" ]; then
    say "start: give exactly one of --brief, --item or --resume"
    return 2
  fi
  if [ -n "$resume" ]; then
    # One writer per transcript: a second claude on a live conversation would also take its item.
    ! claude_pid_live "$resume" || { say "start: conversation $resume is still running; end it before resuming it"; return 1; }
    # A resume works the item that lists its conversation, so a hand resume keeps AGENT_QUEUE_ITEM too.
    # A conversation that worked several items resumes the one updated last (ar-2676).
    [ -n "$item" ] || item=$(agent-queue mine --sid "$resume" --newest 2>/dev/null) || item=''
  fi
  if [ -n "$item" ] && [ -z "$resume" ]; then
    [ -n "$harness" ] || [ -n "$model" ] || ! cloud_routed "$item" || harness=claude-cloud
    # Before the lock: model-lane may ask an LLM (20s timeout), and another start must not wait on it.
    verdict=${START_VERDICT:-}; [ -n "$verdict" ] || [ -n "$model" ] || verdict=$(lane_pick "$item" "$harness")
    # One start of a queue item at a time, from the queued check until the item is running: on
    # 11-04 a pass and a hand start both saw one item queued, and the pass's launch failed. fd 7
    # closes when this item is running, or when the caller (start_item, or the process) ends.
    mkdir -p "$DIR"; exec 7>"$DIR/.start.lock"
    flock -w "$DISPATCH_START_WAIT" 7 || { say "start: another start held the queue lock for ${DISPATCH_START_WAIT}s; $item stays queued"; return 1; }
  fi
  if [ -n "$item" ]; then
    # --points: a trainee row's points may live on its board row alone (item_points), as in runnable.
    it=$(agent-queue show "$item" --json --points 2>/dev/null) || { say "start: no queue item: $item"; return 2; }
    st=$(jq -r .state <<<"$it"); hwhy=$(validate_self_why "$it" "$resume" "$session") || { say "start: $item $hwhy"; return 2; }
    if [ -n "$resume" ]; then
      case "$st" in running | waiting | review) ;; *) say "start: $item is $st; --resume re-attaches an item already started"; return 1 ;; esac
      rh=$(jq -r '.agent // "claude"' <<<"$it")
      if [ "$rh" = claude ]; then rh=''
      else
        # A harness that resumes takes up its last thread, the one id resume_thread names.
        resumes "$rh" || { say "start: $item ran on $rh, which cannot resume; --resume is for claude or a harness that resumes"; return 2; }
        [ "$(resume_thread "$it" "$rh" | cut -d' ' -f1)" = "$resume" ] || { say "start: $resume is not the last $rh thread of $item with a rollout, and no PR on the item; nothing to resume"; return 1; }
        ! codex_run_live "$item" || { say "start: the $rh run of $item is still live; end it before resuming it"; return 1; }
      fi
    else
      [ -z "$key$session" ] || { say "start: --item is a launch of its own: no --row or --session"; return 2; }
      [ "$st" = queued ] || { say "start: $item is $st, not queued"; return 1; }
      # agent-queue refuses to move a held item to running (ar-3260): asked before the launch, so a
      # refused start leaves no session working an item still queued.
      hold=$(jq -r '.hold // empty' <<<"$it")
      [ -z "$hold" ] || { say "start: $item waits on $hold; it starts once that clears"; return 1; }
    fi
    project=$(jq -r .project <<<"$it")
    [ -n "$area" ] || area=$(jq -r '.area // empty' <<<"$it")
  fi
  [ -n "$project" ] || { say "start: --project is required"; return 2; }

  if [ -n "$resume" ]; then
    [ -z "$key" ] || { say "start: --resume takes the --item it was working, not --row"; return 2; }
    [ -n "$session" ] && [ -n "$cwd" ] || { say "start: --resume needs --session and --cwd"; return 2; }
    [ -d "$cwd" ] || { say "start: not a directory: $cwd"; return 2; }
    # One agent per session: the item and the label belong to the whole session, so a
    # restore never lands in a session someone already has (a main checkout's, say), unless
    # --window says it is one window among others.
    if session_live "$session" "$server"; then
      [ -n "$window" ] || { say "start: session $session already exists on $server; pass another --session"; return 1; }
      joined=1
    fi
    origin=${START_ORIGIN:-resume}
    # A resume is an agent's work only when its item came from a start (it has an origin). With no
    # such item it is the human's own conversation: a scratch send (Prefix+F), a reboot restore of a
    # session they opened, so it gets no @dispatch label. Its item still records origin=resume, which
    # is `by` resume, so it holds no run slot (live_runs).
    [ -n "$(jq -r '.origin // empty' <<<"${it:-null}")" ] || agent_work=''
    if [ -n "$rh" ]; then
      [ -z "$prompt" ] || { say "start: --prompt resumes a claude conversation, not a $rh thread"; return 2; }
      [ -z "$DISPATCH_SANDBOX_PROFILE" ] || { say "start: $item runs on $rh, which cannot enforce lane sandbox '$DISPATCH_SANDBOX_PROFILE'; nothing started"; return 2; }
      gateway_launch "$rh" "$(jq -r '.model // empty' <<<"$it")" "$it" "$(item_brief "$it" "$rh")" || return
    else
      launch_mode "$(resume_mode "$resume" "$(jq -r '.mode // empty' <<<"${it:-null}")")"
      eff=$(claude_effort "$it") || return 2
      [ -n "$model" ] || model=$(jq -r '.model // empty' <<<"${it:-null}")   # a resume keeps the model its start ran
      lane_sandbox "$cwd" || return 1
      cmd="${item:+AGENT_QUEUE_ITEM=$(printf '%q' "$item") }$(telemetry_env "$cwd" "$item")$(token_env)$(account_env)${sbx_env}claude${model:+ --model $(printf '%q' "$model")}$eff${item:+$(dropped_tools "$it")}$sbx_flags $flags --resume $(printf '%q' "$resume")${prompt:+ $(printf '%q' "$prompt")}"
    fi
    if [ -n "$joined" ]; then
      target=$(tmux -L "$server" new-window -d -P -F '#{pane_id}' -t "=$session:" -n "$window" -c "$cwd" "$cmd") && START_PANE=$target ||
        { say "could not open window $window in $session on $server"; return 1; }
    else
      START_PANE=$(tmux -L "$server" new-session -d -P -F '#{pane_id}' -s "$session" ${window:+-n "$window"} -c "$cwd" "$cmd") ||
        { say "could not create session $session on $server"; return 1; }
    fi
    # A window joined into a live session is one Claude among others there, so the item does not
    # take that session: reap goes by its `sessions:` ids instead (claude_gone).
    rec=("origin=$origin"); [ -n "$joined" ] || rec+=("session=$server:$session")
    # --resume keeps the conversation's session id, so that is the one the item claims.
    [ -z "$item" ] || { agent-queue set "$item" "${rec[@]}" >/dev/null && agent-queue claim "$item" --sid "$resume" >/dev/null; } ||
      say "restored $session, but could not record it on queue item $item"
  else
    [ -n "$cwd" ] || cwd=$(repo_dir "$project")
    [ -n "$cwd" ] && [ -d "$cwd" ] || { say "start: no repo to cut a worktree from for $project (--cwd)"; return 2; }
    origin=${START_ORIGIN:-hand}
    [ -n "$harness" ] || harness=$(jq -r '.agent // "claude"' <<<"$it")
    # A worker runs the harness its kit has, and past claude only one its fleet_harnesses
    # lists (harness_prep refuses an opencode one it cannot run there).
    [ -z "$host" ] || hwhy=$(host_start_why "$host" "$item" "$harness") || { say "start: $hwhy"; return 2; }
    [ -z "$host" ] || start_host_checks "$host" "$harness" "$hjson" "$it" "$cwd" "$item" || return 2
    base=$(stack_base "$it" "$project" "$item" "$host") || return $?
    if [ "$harness" = claude ]; then
      # A pin is not the lane's pick, so like --model it logs no lane run.
      [ -n "$model" ] || { model=$(claude_pin "$it"); [ -z "$model" ] || verdict=''; }
      [ -n "$model" ] || model=$(jq -r '.dispatch_model // empty' <<<"$verdict" 2>/dev/null)
      model=${model:-opus}
      eff=$(claude_effort "$it") || return 2
      acct=$(account_dir); mode=$(jq -r .mode <<<"$it")
      sid=$(new_sid) || { say "start: no session id for queue item $item; it stays queued"; return 1; }
      lane_sandbox "$cwd" "$host" || return 1
      cmd="AGENT_QUEUE_ITEM=$(printf '%q' "$item") $(telemetry_env "$cwd" "$item")$(token_env "$acct")$(account_env "$acct")${sbx_env}claude --model $(printf '%q' "$model")$eff$(dropped_tools "$it") --session-id $sid$sbx_flags"
      [ "$mode" = plan ] || mode=bypassPermissions
      launch_mode "$mode"
      cmd="$cmd $flags $(printf '%q' "$(item_brief "$it")")"
      acct=$(basename "${acct:-main}"); on=$acct${DISPATCH_SANDBOX_PROFILE:+, sandbox $DISPATCH_SANDBOX_PROFILE}${host:+, host $host}
    else
      # Only a claude start is held to the profile: the other launchers have no flag for it, and running
      # one open while the knob says every session is sandboxed is the failure the knob prevents.
      [ -z "$DISPATCH_SANDBOX_PROFILE" ] || { say "start: $item would run on $harness, which cannot enforce lane sandbox '$DISPATCH_SANDBOX_PROFILE'; nothing started"; return 2; }
      [ -n "$model" ] || model=$(jq -r '.model // empty' <<<"$it")
      # A cloud session's model is its environment's, so the map's one entry stands for it.
      [ "$(harness_launcher "$harness")" != claude-cloud ] || model=${model:-cloud}
      # A sandboxed pair model-lane promoted for the item's class runs it directly (direct_why); its tail lands it.
      [ -z "$(harness_sandbox "$harness")" ] || is_canary "$it" || ! direct_why "$it" "$harness" "$model" "$verdict" >/dev/null || drc="$harness:$model"
      gateway_launch "$harness" "$model" "$it" "$(item_brief "$it" "$harness")" "$drc" || return
      # What the run bills: the source the map names for the harness; a cloud session bills the claude
      # account gateway_launch chose (acct).
      [ "$(harness_launcher "$harness")" = claude-cloud ] || acct=$(harness_source "$harness")
      on=$harness
    fi
    # A worker prepares its own account dirs (shared setup, first-run done) before the pane opens: the
    # dispatcher's pick linked this machine's, and a worker's were left on the theme picker (razer-laptop,
    # 2026-11-18).
    [ -z "$host" ] || [ "$harness" != claude ] || fleet_host_run "$host" claude-acct link >/dev/null || say "start: claude-acct link failed on $host; its pane may open on a first-run screen"
    session=$(cd "$cwd" && WT_NEW_CMD="$cmd" wt new ${host:+--host "$host"} ${base:+--base "$base"} --server "$server" --detach -c "$cwd" | tail -1)
    [ -n "$session" ] || { say "wt new failed for queue item $item; it stays queued"; return 1; }
    size=$(item_size "$it")
    # A sandboxed run of anything but a canary or a direct one is a trainee's (sandbox_item_why): `trainee:`
    # marks the row as trained once, counts toward its harness's cap, and its review hand-off reads it;
    # `direct:` marks a direct run the same way, for its landing.
    trn=''; [ -n "$drc" ] || [ "$harness" = claude ] || [ -z "$(harness_sandbox "$harness")" ] || is_canary "$it" || trn="$harness:$model"
    agent-queue set "$item" "session=$server:$session" "account=$acct" "origin=$origin" "model=$model" "agent=$harness" ${size:+"size=$size"} ${host:+"host=$host"} ${trn:+"trainee=$trn"} ${drc:+"direct=$drc"} >/dev/null &&
      agent-queue move "$item" running >/dev/null || say "started $session, but could not mark queue item $item running"
    # The id was chosen above, so the claim is made here and not in the session's own start, where
    # it waited on the queue lock (up to 2.9 s, 2026-11-06). Both outcome joins go through `sessions:`.
    [ -z "$sid" ] || agent-queue claim "$item" --sid "$sid" >/dev/null || say "could not claim $sid on queue item $item"
    replay_record "$harness" "$item" "$server" "$session" "$host"
    if [ "$harness" = claude ]; then lane_log "$item" "$(item_headline "$it")" "$verdict" "$model"
    # A trainee or direct run logs under lane trainee (one record per pair, which model-lane score and
    # its send-back read), with the class of the verdict that routed it when one did.
    elif [ -n "$trn$drc" ]; then
      lane_log "$item" "$(item_headline "$it")" "$(jq -cn --argjson v "${verdict:-null}" --arg m "$model" '($v // {}) + {lane: "trainee", by: "rule", model: $m}')" "$model" "$harness"
    # A routed start is not an experiment: it logs under the lane model-lane picked, with its harness.
    elif [ -n "$verdict" ]; then lane_log "$item" "$(item_headline "$it")" "$verdict" "$model" "$harness"
    elif [ "$harness" = claude-cloud ]; then :   # not a pairing the human picked, and no model of ours ran
    else eval_log "$item" "$(item_headline "$it")" "$harness" "$model"
    fi
    dispatch_event started "$project" "$(item_headline "$it")" --item "$item" --to "$server:$session" --why "$model on $on"
    exec 7>&-
    [ -z "$host" ] || worker_store_pull "$host" "$item"
  fi
  [ -z "$ready" ] || start_ready "$server" "$session" "${target:-=$session:}" "$ready" "$host"

  label="$project: $(cut -c1-60 <<<"${item:-resumed}")"
  [ -z "$agent_work" ] || dispatch_tag "$host" "$server" "$session" "$window" "$target" "$label"
  logline "started $session on $server${host:+ at $host} ($origin) for $project: ${item:+queue item $item}${resume:+${item:+, }resume $resume}"
  echo "started $session: $label"
}

# --- the pane record: what a world's server held, and the one way to reopen it --------------

PANES="$DIR/panes"   # <server>.json the live record, <server>.lost.json a dead server's last one

# planned_reboot -- session-snapshot down's marker predates this boot, and the boot is under
# PLANNED_REBOOT_WINDOW_S old. Bounded both ways, so a down with no reboot yet, or a marker an `up`
# never cleared, still lets a real server death page.
planned_reboot() {
  local m="${AGENT_MAINTENANCE:-$HOME/.agent/maintenance}" boot
  [ -e "$m" ] || return 1
  boot=${FLEET_BOOT_TIME:-$(awk '/^btime/ {print $2}' /proc/stat)}
  [ "$(stat -c %Y "$m")" -lt "$boot" ] && [ $(( $(date +%s) - boot )) -lt "$PLANNED_REBOOT_WINDOW_S" ]
}

# world_lost <server> -- the recorded server is gone: keep its record for restore, and page.
# A record with no conversations has nothing to restore, so it never replaces one that does. A
# restore that reopened only some keeps its lost record (a rerun finishes it), so when the server dies
# again the new record's conversations join that one instead of replacing it. A conversation in both
# takes the new record's window and cwd (the newer); shell panes of the old record stay, listed only.
world_lost() {
  local srv=$1 n lost="$PANES/$1.lost.json"
  n=$(jq '[.panes[] | select(.claude != "")] | length' "$PANES/$srv.json" 2>/dev/null)
  n=${n:-0}
  if [ "$n" -eq 0 ]; then
    rm -f "$PANES/$srv.json"
  elif [ ! -s "$lost" ]; then
    mv -f "$PANES/$srv.json" "$lost"
  elif jq --slurpfile old "$lost" '
      [.panes[] | select(.claude != "")] as $new
      | .panes = ([$old[0].panes[] | select(.claude as $c | $c == "" or ($new | map(.claude) | index($c) | not))] + $new)' \
      "$PANES/$srv.json" > "$lost.new"; then
    mv -f "$lost.new" "$lost"; rm -f "$PANES/$srv.json"
  else
    # An unreadable old record restores nothing (restore reads it with jq too), so it is replaced, said aloud.
    rm -f "$lost.new"; mv -f "$PANES/$srv.json" "$lost"
    logline "tmux server $srv: the earlier lost record was unreadable and is replaced"
  fi
  logline "tmux server $srv died with $n conversation(s) on it"
  # A planned reboot (session-snapshot down) is not an outage: its `up` pages what came back.
  ! planned_reboot || return 0
  agent-notify -p high -t "tmux $srv server died" "$n conversation(s) were on it. Reopen them: fleet-dispatch restore" ||
    say "could not page: tmux server $srv died"
}

# record_world <server> <panel file> -- rewrite its record, after noticing the server it described
# is gone. A server has an instance (pid and start time), so one restarted between two records
# still shows. agent-panel owns the pane to conversation join; no panel file keeps the last record.
record_world() {
  local srv=$1 panel=$2 file="$PANES/$1.json" inst was panes
  inst=$(tmux -L "$srv" display-message -p '#{pid} #{start_time}' 2>/dev/null)
  was=$(jq -r '.instance // empty' "$file" 2>/dev/null)
  [ -z "$was" ] || [ "$was" = "$inst" ] || world_lost "$srv"
  [ -n "$inst" ] && [ -n "$panel" ] || return 0
  # Tab, not \037: tmux 3.4 and 3.5a print a control byte in a -F format as octal text, and a tab raw.
  panes=$(tmux -L "$srv" list-panes -a -F $'#{pane_id}\t#{session_name}\t#{window_name}\t#{pane_current_path}' 2>/dev/null) || return 0
  jq -Rn --arg server "$srv" --arg instance "$inst" --arg at "$(date -Iseconds)" --slurpfile panel "$panel" '
    (reduce $panel[] as $row ({}; .[$row.pane] = $row)) as $by |
    {server: $server, instance: $instance, at: $at, panes: [inputs | split("\t") | $by[$server + "/" + .[0]] as $c |
      {session: .[1], window: .[2], cwd: ($c.cwd // .[3]), claude: ($c.session_id // "")}]}' \
    <<<"$panes" > "$file.tmp" && mv -f "$file.tmp" "$file"
}

# on_workers [--quiet] <verb> [args...] -- run `fleet-dispatch <verb> --here [args...]` on each fleet
# worker but this machine (fleet_peers), all at once, then print each one's output in roster order,
# each line prefixed with the worker's name. A worker's tmux servers die on their own and only it can
# read them, so each one keeps its own pane record and reopens its own sessions; --here keeps it from
# fanning out again. Rc 1, said, when a worker's own verb failed. One that does not answer (ssh 255)
# is no failure: its record stays there for its own next run, and a laptop asleep is not a failed
# reopen. Restore says it; the minute record (--quiet) does not, or it would every minute.
on_workers() {
  local quiet='' name rc=0 r dir names=() pids=()
  [ "$1" != --quiet ] || { quiet=1; shift; }
  fleet_hosts >/dev/null
  mapfile -t names < <(fleet_peers)
  [ "${#names[@]}" -gt 0 ] || return 0
  dir=$(mktemp -d) || return 1
  for name in "${names[@]}"; do
    { fleet_host_run "$name" fleet-dispatch "$1" --here "${@:2}" >"$dir/$name" 2>&1; echo $? >"$dir/$name.rc"; } &
    pids+=("$!")
  done
  wait "${pids[@]}"
  for name in "${names[@]}"; do
    sed "s/^/$name: /" "$dir/$name"
    r=$(cat "$dir/$name.rc")
    case "$r" in
      0) ;;
      255) [ -n "$quiet" ] || say "$1: $name did not answer; its own record stays there" ;;
      *) say "$1: $name exited $r"; rc=1 ;;
    esac
  done
  rm -rf "$dir"
  return "$rc"
}

# fans_out -> rc 0 when this machine holds the fleet lease (`fleet-lease held`), so it asks every
# other worker: the holder runs fleet-state.service, the one minute record, and no other machine
# fans out, or each would ask every one.
fans_out() { fleet-lease held >/dev/null 2>&1; }

# cmd_record [--here] -- every world a manifest declares, then, on the lease holder (fans_out), each
# fleet worker's (on_workers), unless --here. fleet-state.service runs it each minute, so a record is at
# most that old; a world's sockets give no event to await for a pane's cwd or id. That tick is also
# what wakes a paced restore's next batch here (restore_tick) and takes the CPU sample the load pace
# reads (cpu_sample).
cmd_record() {
  local here=''
  [ "${1:-}" != --here ] || here=1
  [ -n "$here" ] || cpu_sample   # the lease holder's tick, on the machine whose pass reads it; a worker's pace reads load average
  record_here || return 1
  restore_tick
  [ -n "$here" ] || ! fans_out || on_workers --quiet record
}

# record_here -- the pane record of every world a manifest declares on this machine, under record's lock.
record_here() {
  local f srv panel="$PANES/.panel"
  mkdir -p "$PANES"
  exec 8>"$PANES/.lock"
  flock 8 || return 1
  agent-panel list --json > "$panel" 2>/dev/null || { say "record: agent-panel failed; each record stays as it was"; panel=''; }
  for f in "${TMUX_SERVERS_DIR:-$HOME/.config/tmux-servers}"/*.conf; do
    [ -r "$f" ] || continue
    srv=${f##*/}
    record_world "${srv%.conf}" "$panel"
  done
  exec 8>&-
}


# wound_down <id> -- it asked to close: armed, or fired since its window last showed in a record.
# wind-down.sh disarm clears both on the next prompt, so a conversation taken up again is reopened.
wound_down() { compgen -G "$HOME/.agent/spin-down/$1.[rf]*" >/dev/null || compgen -G "$HOME/.agent/spin-down/*__$1.[rf]*" >/dev/null; }

# restore_world <lost record> <dry run 0|1> -- reopen each conversation as a window of the session
# it was in, through start, with the running or waiting queue item that lists its Claude session
# (`agent-queue mine --sid --newest`: when several do, a running one, then the one updated last),
# so the item records where it runs again. A claude conversation whose item is running gets
# RESTORE_PROMPT as its first message and carries on; any other comes back at an empty prompt (the
# human's own conversation, or an item waiting on someone). The manifest brings back the declared
# sessions and windows first; a plain shell is listed, not reopened. A prompted reopen is a wake and
# is paced (wake_take): one past the batch is left for a later pass, listed in RESTORE_OWED
# (restore_pace reads it). Consumed only when every reopen worked and none is owed, so a rerun
# finishes, and only as read at the start, under record's lock: a death world_lost adds to it
# meanwhile stays owed. Each reopened pane is tagged @fleet_restored with the record's time, when its
# server was last seen alive, so fleet-sessions runs its close timer on from the quiet it had then.
restore_world() {
  local f=$1 dry=$2 srv sess win cwd id mode project item it prompt said failed=0 opened=0 owed=0 walked alive
  walked=$(sha256sum < "$f")
  srv=$(jq -r .server "$f")
  alive=$(date -d "$(jq -r '.at // empty' "$f")" +%s 2>/dev/null) || alive=
  [ "$dry" = 1 ] || tmx ensure "$srv" >/dev/null || say "restore: tmx ensure $srv failed"
  while IFS=$'\037' read -r sess win cwd id; do
    if [ -z "$id" ]; then echo "$srv:$sess:$win: no conversation, not reopened ($cwd)"; continue; fi
    if wound_down "$id"; then echo "$srv:$sess:$win: wound down on purpose, skipped"; continue; fi
    if claude_pid_live "$id"; then echo "$srv:$sess:$win: already running, skipped"; continue; fi
    if [ ! -d "$cwd" ]; then echo "$srv:$sess:$win: $cwd is gone, skipped (claude --resume $id)"; continue; fi
    item=$(agent-queue mine --sid "$id" --newest 2>/dev/null) || item=''
    it=''; [ -z "$item" ] || it=$(agent-queue show "$item" --json 2>/dev/null) || it=''
    mode=$(resume_mode "$id" "$(jq -r '.mode // empty' <<<"$it" 2>/dev/null)")
    prompt='' said='' START_PANE=''
    if [ "$(jq -r '[.state, .agent // "claude"] | join(" ")' <<<"$it" 2>/dev/null)" = 'running claude' ]; then
      prompt=${RESTORE_PROMPT//\%s/$item}; said=', prompted to carry on'
    fi
    if [ "$dry" = 1 ]; then echo "$srv:$sess:$win: would reopen $id in $cwd ($mode)${item:+ for queue item $item}$said${prompt:+, in a wake batch}"; continue; fi
    # A prompted reopen is a wake: it reruns the session's gate, suite or Unity run. It waits on the
    # lost record for a batch (wake_take) and comes back with its prompt then, never at an empty one
    # nobody nudges.
    if [ -n "$prompt" ] && ! wake_take restore "$id"; then
      echo "$srv:$sess:$win: waits for a wake batch${item:+ (queue item $item)}"; RESTORE_OWED+=("$id"); owed=$((owed + 1)); continue
    fi
    project=$(resolve_project_name "$cwd")
    if cmd_start --project "${project:-${cwd##*/}}" --server "$srv" --session "$sess" --window "$win" \
        --cwd "$cwd" --resume "$id" ${item:+--item "$item"} ${prompt:+--prompt "$prompt"} </dev/null >/dev/null; then
      echo "$srv:$sess:$win: reopened in $mode${item:+ for queue item $item}$said"; opened=$((opened + 1))
      # Its claude is new but its conversation is not: fleet-sessions adds the quiet it had when the
      # server was last seen to its age, so a window closed-now before the reboot closes now again, not
      # an hour after its reopen, and the outage itself is not quiet (ar-4141). The option dies with the pane.
      if [ -z "$START_PANE" ] || [ -z "$alive" ]; then
        say "restore: $srv:$sess:$win has no pane or record time to tag @fleet_restored; it closes an hour after its reopen"
      elif ! tmux -L "$srv" set-option -pq -t "$START_PANE" @fleet_restored "$alive"; then
        say "restore: could not tag $srv:$sess:$win @fleet_restored; it closes an hour after its reopen"
      fi
    else
      failed=$((failed + 1))
    fi
  done < <(jq -r '.panes[] | [.session, .window, .cwd, .claude] | join("\u001f")' "$f")
  [ "$dry" = 1 ] && return 0
  echo "$srv: reopened $opened, failed $failed"
  [ "$owed" = 0 ] || echo "$srv: $owed wait for a wake batch"
  [ "$failed" = 0 ] || return 1
  [ "$owed" = 0 ] || return 0
  (
    flock 7 || exit 1
    [ "$(sha256sum < "$f")" = "$walked" ] || { echo "$srv: its record grew during the restore; rerun fleet-dispatch restore"; exit 1; }
    mv -f "$f" "${f%.lost.json}.restored.json"
  ) 7>"$PANES/.lock"
}

# cmd_restore [--here] -- the one verb after a lost server or a reboot: this machine's lost servers,
# then, on the lease holder (fans_out), each fleet worker's on that worker (on_workers), unless --here. A record
# first, so a death the minute timer has not seen yet counts, and a server already restarted by
# hand is not missed. The wakes are paced (restore_pace): the rest wake from the minute record.
cmd_restore() {
  local server='' dry=0 here='' rc=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --server) [ $# -ge 2 ] || { say "restore: --server needs a value"; return 2; }; server=$2; shift 2 ;;
      --dry-run) dry=1; shift ;;
      --here) here=1; shift ;;
      *) say "restore: unknown argument: $1"; return 2 ;;
    esac
  done
  record_here
  # One walk at a time, so a hand restore and the minute's next batch never reopen one conversation twice.
  exec 6>"$PANES/.restore.lock"
  flock 6 || return 1
  # 6>&-: the walk runs with the lock fd closed (bash keeps its saved copy close-on-exec), so nothing
  # it starts, a tmux server, a claude or a notify, holds the lock once the walk ends.
  restore_here "$dry" "$server" 6>&- || rc=1
  exec 6>&-
  local wargs=(); [ -z "$server" ] || wargs+=(--server "$server"); [ "$dry" = 0 ] || wargs+=(--dry-run)
  if [ -z "$here" ] && fans_out; then on_workers restore "${wargs[@]}" || rc=1; fi
  return "$rc"
}

# restore_here <dry run 0|1> [<server>] -- walk this machine's lost records (that server's alone when
# named), then pace what they still owe (restore_pace). The caller holds the restore lock.
restore_here() {
  local dry=$1 server=${2:-} f rc=0 found=0
  RESTORE_OWED=()
  for f in "$PANES"/${server:-*}.lost.json; do
    [ -r "$f" ] || continue
    found=1
    restore_world "$f" "$dry" || rc=1
  done
  [ "$found" = 1 ] || echo "restore: no lost server on record"
  [ "$dry" = 1 ] || restore_pace "$server"
  return "$rc"
}

RESTORE_BY='fleet-dispatch restore'
RESTORE_OWED_FILE="$PANES/.restore-owed"   # a walk left wakes owed: restore_tick walks again

# restore_pace [<server>] -- after a walk: while a conversation waits for a wake batch, the load hold
# `restore` stands, its roster the ones still waiting (re-set when that changes, a hold someone else
# set left alone), and the owed marker tells the minute record to walk again (restore_tick). A load
# hold, as a fleet-pace `hold` is: the machine reads HOLD until it is back under the low mark, so
# dispatch starts nothing new meanwhile and the next batch wakes only on CLEAR, fleet-pace's `go`.
# Once none waits, the hold is released (only the one restore set) and the marker goes; a walk of
# one --server leaves both to a full walk.
restore_pace() {
  local owed=${#RESTORE_OWED[@]} hold roster
  hold=$(agent-hold show restore 2>/dev/null)
  if [ "$owed" -gt 0 ]; then
    roster=$(IFS=,; printf '%s' "${RESTORE_OWED[*]}")
    if [ -z "$hold" ] || { [ "$(sed -n 's/^by: //p' <<<"$hold")" = "$RESTORE_BY" ] &&
                           [ "$(sed -n 's/^roster: //p' <<<"$hold")" != "$roster" ]; }; then
      agent-hold set restore --kind load --by "$RESTORE_BY" --roster "$roster" \
        "a restore wakes its reopened sessions $WAKE_BUDGET at a time, on CLEAR; $owed wait for a batch" >/dev/null ||
        say "restore: could not set the restore hold"
    fi
    printf '%s\n' "$owed" > "$RESTORE_OWED_FILE"
    echo "restore: $owed wait for a wake batch of at most $WAKE_BUDGET; the minute record wakes the next on CLEAR"
  elif [ -z "${1:-}" ]; then
    rm -f "$RESTORE_OWED_FILE"
    if [ "$(sed -n 's/^by: //p' <<<"$hold")" = "$RESTORE_BY" ]; then
      agent-hold release restore >/dev/null && echo "restore: every conversation is awake; released the restore hold"
    fi
  fi
  return 0
}

# restore_tick -- the minute record's half of a paced restore: while a walk left wakes owed and the
# budget has room (wake_room), the next batch, `restore --here`, in fleet-restore.service, started
# without waiting: the record's own unit times out in 2 minutes and kills its cgroup, a server
# restore starts included. Nothing owed starts nothing, so a lost server nobody restored stays the
# human's page.
restore_tick() {
  [ -e "$RESTORE_OWED_FILE" ] || return 0
  [ "$(wake_room)" -gt 0 ] || return 0
  systemctl --user start --no-block fleet-restore.service ||
    say "restore: could not start fleet-restore.service; $(cat "$RESTORE_OWED_FILE") still wait (fleet-dispatch restore)"
}

# --- queue items: agent-queue owns the record, this runner only starts and settles them ----

item_state() { agent-queue show "$1" --json 2>/dev/null | jq -r '.state // empty'; }

# item_ask <slug> <item json> -> the ask tag (agent-queue requeue --ask) of the pending ask the item
# waits on: the newest one filed for it (`agent-ask post --task <slug>`, by created), else the one its `ask:` names;
# nothing when no such ask is pending. The tag names every option the ask offers, since any answer the
# human gives is the decision the run stopped for. Fails when the asks cannot be read, so the caller
# moves nothing on a guess.
item_ask() {
  local own asks; own=$(jq -r '.ask // ""' <<<"$2")
  # --open: a parked ask still holds its item; parking only takes it off the boards.
  asks=$(agent-ask list --all --open 2>/dev/null) || return 1
  awk -F'\t' -v s="$1" -v own="$own" '
    function tag(   n, o, i, t) {
      n = split($7, o, "|"); t = ""
      for (i = 1; i <= n; i++) { sub(/ .*/, "", o[i]); if (o[i] != "") t = t (t == "" ? "" : "+") o[i] }
      return $1 (t == "" ? "" : "=" t)
    }
    $8 == s && $12 >= at { id = tag(); at = $12 } $1 == own { mine = tag() }
    END { print (id != "" ? id : mine) }' <<<"$asks"
}

# note_add <slug> <item json> <text> -- the item's note becomes this text, with the note it had kept
# after "; was: ", so what the session itself wrote there is not lost. Only the oldest "was:" is kept,
# so a run requeued again and again does not grow a chain.
note_add() {
  local was; was=$(jq -r '.note // ""' <<<"$2")
  [[ "$was" != *"; was: "* ]] || was=${was#*; was: }
  agent-queue set "$1" "note=$3${was:+; was: $was}" >/dev/null
}

# ask_decisions <tags> -> one line per ask: tag naming what the human decided. The ask that released
# an item has no session left to hear its answer, so the brief is where the answer reaches the work.
ask_decisions() {
  local tag id line
  for tag in $1; do
    case "$tag" in
      ask:?*)
        id="${tag#ask:}"; id="${id%%=*}"
        line="$(agent-ask decision "$id" 2>/dev/null)" || continue
        [ -z "$line" ] || echo "The human already decided this in ask $id, so follow it: $line"
        ;;
    esac
  done
  return 0
}

# item_brief <item json> [harness] -> the prompt a queue item's session starts on: plan mode gets
# the task as typed, oneshot runs it through its kind's entry skill (kinds.json `entry`, by the
# item's type or its title's prefix; /one-shot when the kind names none), --pr-only for a tier-3 one,
# not a red, on a headless harness (pinned there: route sends it no routed one), which cannot run the
# red-fix gate's review. A kind whose `exit` is doc+ask or proof opens no PR, so its brief ends on that close
# instead of agent-land (doc_ask_brief, proof_brief). A headless harness (opencode, codex) has no
# slash commands or human at the pane, so it reads the skill and closes differently, and a plan item
# on one plans first (plan_stage). A start that resumes the item's last run (resume_thread) gets
# resume_brief instead, and one that does not, of an item with salvaged work, is told where it is
# (salvage_line), and one an earlier run handed off reads that run's note first (handoff_line). A Forgejo repo lands with agent-land too, which merges through that forge's API.
# A `canary` item (fleet-bench canary queue) opens no PR: its task is the whole brief, as is a trainee's
# review item's (cmd_trainee_review writes it). A trainee's run (a sandboxed harness on anything but a
# canary) gets trainee_brief: it cannot commit, so it leaves its change in the worktree.
item_brief() {
  local it="$1" harness="${2:-claude}" slug mode tags pr_only='' row key kind entry='' exit_='' nopr=''
  slug=$(jq -r .slug <<<"$it"); mode=$(jq -r .mode <<<"$it"); tags=" $(jq -r '.tags // ""' <<<"$it") "
  if is_canary "$it" || [[ "$tags" == *" trainee-review "* || "$tags" == *" validate "* ]]; then
    jq -r .task <<<"$it"
    [[ "$tags" != *" trainee-batch "* ]] || ! headless "$harness" || trainee_batch_headless "$slug"
    return 0
  fi
  if [ -n "$(harness_sandbox "$harness")" ]; then trainee_brief "$it"; return 0; fi
  if [ "$harness" = claude-cloud ]; then
    key=$(cut -d$'\x1f' -f4 <<<"$(item_row "$it")")
    jq -r .task <<<"$it"
    echo
    ask_decisions "$tags"
    echo "This runs in a Claude Code cloud session on a fresh clone of the repo: no local skills, hooks, agent-queue or agent-land. Follow the repo's own CLAUDE.md and tooling."
    echo "Work on a new branch, run the repo's own tests for what you changed, push, and open a pull request. Never merge it."
    echo "The PR body carries the line \"Item: $slug\"${key:+ and the line \"Task: $key\"}: fleet-dispatch finds the PR by that line, and the human's merge closes the item."
    echo "If a step needs a decision from the human, put the question in the PR body, build the rest with that step off, and end the session."
    return 0
  fi
  if [ -n "$(resume_thread "$it" "$harness")" ]; then resume_brief "$it"; return; fi
  case "$(jq -r 'select((.pr // "") != "") | (.pr_owner // "fix") as $o | select((.[$o + "_tries"] // "") != "") | $o' <<<"$it")" in
  fix) fix_ci_brief "$it" "$harness"; return ;;
  land) land_brief "$it" "$harness"; return ;;
  esac
  if [[ "$tags" != *" red "* ]] && headless "$harness" && [ "$(item_tier "$it")" = 3 ]; then
    pr_only=' --pr-only'
  fi
  load_kinds
  kind=$(item_kind "$it")
  [ -z "$kind" ] || { entry=${KIND_ENTRY[$kind]:-}; exit_=${KIND_EXIT[$kind]:-}; }
  entry=${entry:-/one-shot}
  # A verify item (reconcile_epics) carries its whole method in its task: no entry skill, and it
  # closes on proof, whatever kind its title parses as.
  [[ "$tags" != *" verify "* ]] || { entry='' exit_=proof kind=verify; }
  # A kind that opens no PR has no PR to stop at, and no tier-3 merge gate to name.
  case "$exit_" in doc+ask | proof) nopr=1 pr_only='' ;; esac
  if headless "$harness"; then
    [ "$mode" != plan ] || plan_stage "$slug" "$tags"
    [ -z "$entry" ] || printf 'Read ~/.claude/skills/%s/SKILL.md and follow it%s for this task:\n' "${entry#/}" "${pr_only:+ with$pr_only}"
  elif [ "$mode" != plan ] && [ -n "$entry" ]; then
    printf '%s%s ' "$entry" "$pr_only"
  fi
  jq -r .task <<<"$it"
  echo
  ask_decisions "$tags"
  handoff_line "$it"
  salvage_line "$it"
  lost_line "$it"
  pr_line "$it"
  [[ "$tags" != *" red "* ]] || echo "This is a red: read ~/.claude/skills/fix-red/SKILL.md first and work to it."
  [[ "$tags" != *" escalate "* ]] || echo "Its earlier fixes did not hold (retry: names them), so this is its escalation: before any fix, do the root-cause pass of fix-red section 3 through debug, and say on the item why each earlier try did not hold. If this one does not hold either, triage asks the human once, pointing at what this item found."
  [[ "$tags" == *" red "* || -n "$pr_only" || -n "$nopr" || "$(item_tier "$it")" != 3 ]] || echo "This is tier 3 (harness or tooling), and it merges only behind the red-fix gate: step 5 of ~/.claude/skills/fix-red/SKILL.md (/code-review high, each finding fixed or answered in the PR, the line \"Review: /code-review high, <what it found and what you did>\" in the PR body). agent-land refuses a tier-3 PR without that line or without checks that ran green. Run no test on the workstation: the PR's CI is its test run, so put that run's result in the PR body."
  row=$(item_row "$it")
  key=$(cut -d$'\x1f' -f4 <<<"$row")
  if [ "$exit_" = doc+ask ]; then
    doc_ask_brief "$slug" "$kind" "$row" "$(jq -r .project <<<"$it")"
    return
  fi
  if [ "$exit_" = proof ]; then
    proof_brief "$slug" "$kind" "$row" "$(jq -r .project <<<"$it")" "$harness"
    return
  fi
  if [ -n "$row" ] && [ -n "$pr_only" ]; then
    echo "This is agent-queue item $slug, promoted from a board row that is already started. Open the PR and do not merge: the human's merge closes the row."
    echo "When the PR is open: agent-queue set $slug pr=<owner>/<repo>#<N>; agent-queue move $slug review (fleet-dispatch reap closes it once the PR merges)"
  elif [ -n "$pr_only" ]; then
    echo "This is agent-queue item $slug, and that item is its only record: touch no board or sheet row for it."
    echo "When the PR is open: agent-queue set $slug pr=<owner>/<repo>#<N>; agent-queue move $slug review (fleet-dispatch reap closes it once the PR merges)"
  else
    echo "This is agent-queue item $slug${key:+, promoted from the board row \"$key\"}, and that item is its record: touch no other board or sheet row."
    echo "Merge with agent-land <N> (AGENT_QUEUE_ITEM=$slug is set): it records the PR on the item, moves it to done${key:+ and closes the row with the PR as proof}."
  fi
  echo "The PR body carries the line \"Item: $slug\"${key:+ and the line \"Task: $key\"}."
  if headless "$harness"; then
    echo "Right after the PR opens, run: agent-queue set $slug pr=<owner/repo#N>. A run cut off with a PR open then waits for the human instead of reading failed."
    [ -n "$pr_only" ] || echo "Run agent-land in the foreground: a background command dies when this run exits."
    echo "Run final-pass (~/.claude/skills/final-pass/SKILL.md) on the diff before the PR opens; skip only its /simplify call. Skip wind-down (this run ends when you stop) and any other step that needs a Claude slash command, and name each step you skipped in the PR body."
    no_human "$slug"
    return
  fi
  ask_rule
}

# plan_stage <slug> <tags> -- what a headless plan item does first: write the plan, post it as an
# approval ask, requeue behind it and stop. The answer resumes the run (resume_thread) with the decision
# in its brief, where a Claude plan item waits in its pane at the plan. A start that cannot resume, after
# the human decided, builds on that decision instead of planning again.
plan_stage() {
  if [ -n "$(ask_decisions "$2")" ]; then
    echo "This is a plan item whose plan, ~/.claude/plans/$1.md, the human has decided on below: build it if they approved it, or revise it and post it for approval again if they asked for changes."
    echo
    return 0
  fi
  echo "This is a plan item: plan first, and change nothing in any repo until the human approves the plan. Write it to ~/.claude/plans/$1.md, then post it: agent-ask post --kind approval --options 'approve=build the plan as written|revise=change the plan first' --recommend approve --why \"<one sentence>\" --context \"The plan is ~/.claude/plans/$1.md\" \"Approve the plan for $1?\". Then run agent-queue requeue $1 --ask <id> and stop: the answer resumes this run, and you build only once it approves."
  echo "Once the plan is approved, build it as below."
  echo
}

# handoff_line <item json> -- an earlier run of the item handed it to this fresh session to keep its context
# small (agent-queue handoff, `handoff:` its note): the new session reads that note before anything else.
handoff_line() {
  local note; note=$(jq -r '.handoff // empty' <<<"$1")
  [ -n "$note" ] || return 0
  echo "An earlier run of this item handed it to this fresh session to keep context small (agent-queue handoff): read $note first. It says what is done, what is next and what that run learned; do not redo what it finished, and keep that file as this run's plan."
}

# salvage_line <item json> -- an earlier run of the item pushed its unfinished work (`salvage:`, from
# agent-codex or, for a run lost with its host, settle_item) and this start does not resume that run:
# the new session starts from that work.
salvage_line() {
  local sv; sv=$(jq -r '.salvage // empty' <<<"$1")
  [ -n "$sv" ] || return 0
  echo "An earlier run of this item left its unfinished work on branch ${sv%@*} at ${sv##*@} on origin: start from it, not from the trunk (git fetch origin ${sv%@*} && git reset --keep ${sv##*@}, on this worktree's branch). If a PR is already open from ${sv%@*}, push to that branch instead of opening a second one."
}

# lost_line <item json> -- an earlier run of the item was lost with its host (settle_item, `lost:`):
# the new session hears where it ran and the status note that run left, the only account of how far it
# got past its last push. Its work is on salvage_line's branch or pr_line's PR, or nowhere.
lost_line() {
  local lost note; lost=$(jq -r '.lost // empty' <<<"$1")
  [ -n "$lost" ] || return 0
  note=$(jq -r '.note // ""' <<<"$1"); [[ "$note" == *"; was: "* ]] && note=${note#*; was: } || note=''
  echo "An earlier run of this item on ${lost%% *} was lost when that machine stopped answering: anything it had not pushed is gone with it.${note:+ Its last note: $note}"
}

# pr_line <item json> -- an earlier run of the item opened its PR and stopped (on an ask, the usage
# limit or after a partial landing, settle_item) without closing the item: the new session continues
# that PR, or after a partial landing makes the rest, never a second PR for the same work.
pr_line() {
  # `// ""` again: "" splits to [], whose [0] is null, which -r prints as "null" (ar-1583's brief)
  local pr co; pr=$(jq -r '.pr // "" | split(" ")[0] // ""' <<<"$1")
  [ -n "$pr" ] || return 0
  if [ "$(jq -r '.partial // ""' <<<"$1")" = yes ]; then
    echo "An earlier run of this item merged $(jq -r .pr <<<"$1") as a partial landing (agent-land --partial): do the part that is left in the other repo, and land it with agent-land without --partial, which closes the item. If nothing is left, close it that way on $pr."
  else
    co="gh pr checkout ${pr##*#}"; [[ "$pr" != */*#* ]] || co+=" -R ${pr%#*}"
    echo "An earlier run of this item already opened $pr: check out its head branch ($co), continue the work there and push to it. Do not open a second PR."
  fi
}

# resume_brief <item json> -- the prompt a resumed run (resume_thread) continues on: its thread already
# holds the first brief, so this says why it stopped, what the human decided since, where its work is
# now (agent-codex checked it out at the salvage sha, or there is none) and how to stop again.
resume_brief() {
  local slug sv mode end tags
  IFS=$'\x1f' read -r slug sv mode end tags < <(jq -r '[.slug, .salvage // "", .mode // "", .end_reason // "", .tags // ""] | join("\u001f")' <<<"$1")
  if [ "$end" = limit ]; then
    echo "This is agent-queue item $slug. Your last run on it stopped at the plan's usage limit, and the plan has room again."
  else
    echo "This is agent-queue item $slug. Your last run on it stopped before the item closed, and this run takes it up."
  fi
  ask_decisions " $tags "
  [ "$mode" != plan ] || echo "If the human approved your plan, build it now. If they asked for changes, revise the plan and post it for approval again, the same way."
  if [ -n "$sv" ]; then
    echo "The current directory holds the work your last run left, checked out at ${sv##*@} (on ${sv%@*} on origin): build on it here. If a PR is already open from ${sv%@*}, push to that branch instead of opening a second one."
  else
    echo "Your last run left no work the trunk lacks: start from the current directory."
  fi
  echo "Carry on with the task from where you stopped, under the brief you were first given: what it said about the PR, the item and closing still holds."
  no_human "$slug"
}

# fix_ci_brief <item json> <harness> -- the brief of an item own_parked_pr requeued red: its work is already
# its open PR, red at the head `fix_tries:` names, so the session owns that red through the fix-ci skill on
# the PR's own branch. It never merges: the PR goes back to where it was parked, and a green one gets
# a lander (own_parked_pr, land_brief).
fix_ci_brief() {
  local slug pr n head repo=''
  IFS=$'\x1f' read -r slug pr n head < <(jq -r '(.fix_tries | split(" ")) as $t | [.slug, .pr, $t[0], ($t[1] // "")] | join("\u001f")' <<<"$1")
  [[ "$pr" != */*#* ]] || repo=" -R ${pr%#*}"
  if headless "$2"; then printf 'Read ~/.claude/skills/fix-ci/SKILL.md and follow it for PR %s.\n' "$pr"
  else printf '/fix-ci %s\n' "$pr"; fi
  echo
  echo "This is agent-queue item $slug. Its PR $pr is red${head:+ at ${head:0:12}} and the session that opened it has ended, so this session owns the red: fix-ci try $n of $DISPATCH_FIX_TRIES."
  echo "Work on the PR's own branch, never a new one: gh pr checkout ${pr##*#}$repo here (when git says another worktree has the branch, work in that one: git worktree list), fix the red checks at their cause as /fix-ci says, and push to that branch. Never open a second PR."
  echo "Do not merge, and touch no board or sheet row: when the checks are green, or fix-ci stops on a red it cannot fix and files its row, run agent-queue move $slug review and end. Once its checks are green, the next pass gives it a lander (own_parked_pr)."
  if headless "$2"; then no_human "$slug"; else ask_rule; fi
}

# land_brief <item json> <harness> -- the brief of an item own_parked_pr requeued green, or in conflict
# with its base (`land_tries: <n> <head> conflict`): its work is its open PR at the head `land_tries:`
# names, and its session ended without merging it (a --pr-only run, fix-ci, or a window closed for takeover). This session decides it as one row of ingest-prs: land it through
# agent-land, close it with the reason, or ask the human, and only that.
land_brief() {
  local slug pr n head why repo='' land_repo=''
  IFS=$'\x1f' read -r slug pr n head why < <(jq -r '(.land_tries | split(" ")) as $t | [.slug, .pr, $t[0], ($t[1] // ""), ($t[2] // "")] | join("\u001f")' <<<"$1")
  [[ "$pr" != */*#* ]] || { repo=" -R ${pr%#*}"; land_repo=" --repo ${pr%#*}"; }
  if [ "$why" = conflict ]; then
    echo "This is agent-queue item $slug. Its PR $pr is open and in conflict with its base${head:+ at ${head:0:12}}, so its checks cannot run, and the session that opened it has ended without merging it, so this session decides it: merge its base into its branch and resolve the conflicts (never a rebase or a force push), then land it, or close it (try $n of $DISPATCH_FIX_TRIES)."
  else
    echo "This is agent-queue item $slug. Its PR $pr is open and green${head:+ at ${head:0:12}}, and the session that opened it has ended without merging it, so this session decides it: land it or close it (try $n of $DISPATCH_FIX_TRIES)."
  fi
  echo
  echo "1. Read the PR (gh pr view ${pr##*#}$repo, its diff and checks), the item (agent-queue show $slug) and its board row. Give it one verdict as ~/.claude/skills/ingest-prs/SKILL.md defines them: LAND, FIX-THEN-LAND, or CLOSE when it is superseded, already on its base, or no longer wanted. A draft, or a PR waiting on a human approval, is the human's call (below)."
  echo "2. LAND or FIX-THEN-LAND: work on the PR's own branch (gh pr checkout ${pr##*#}$repo; when another worktree has the branch, work in that one), merge its base in if it is behind, never a second PR. A tier-3 item (fleet-dispatch item-tier $slug prints 3) needs /code-review high and the line \"Review: /code-review high, <what it found and what you did>\" in the PR body first. Then run agent-land ${pr##*#}$land_repo --item $slug in the foreground."
  echo "3. CLOSE: close the PR with a one-line comment giving the reason (superseded by #<n>, on its base at <sha>, or why it is no longer wanted), never deleting the branch, and end: reap fails the item on its closed PR."
  if headless "$2"; then no_human "$slug"; else echo "If the verdict is the human's call (a product decision, or a repo that needs their approval to merge), file it with agent-ask post (options land and close, your recommendation in --recommend) and end: the item waits on the answer."; fi
}

# ask_rule -- a question blocks only the step that needs it. Reap moves the item to waiting/ once the
# session stops with its ask pending, so the session never moves it itself.
# no_human <slug> -- the same for a headless harness, whose run ends when it stops: the item goes back
# in the queue behind the ask, and the answer starts it again with the decision in its brief.
no_human() { echo "If a step needs a decision from the human, file it with agent-ask post (your recommendation in --recommend), run agent-queue requeue $1 --ask <id>, and stop: the answer starts this item again. Nobody watches this run, and one that stops with its item still running counts as failed."; }

ask_rule() {
  echo "If a step needs a decision from the human, only that step is blocked, not the task: ask it here and file it with agent-ask post (your recommendation in --recommend), build the rest with that step switched off, and end your turn on the question only when nothing else is left, leaving this window open."
}

# proof_brief <slug> <kind> <item_row> <project> <harness> -- how a proof kind (kinds.json `exit`:
# release) closes: the live proof its entry skill names, recorded on the item, its row closed on that
# proof, never a PR or agent-land. fleet-sessions reads the session DONE once the item moves on; a
# session gone before the close is settled failed and its row stays started, for a human to look.
proof_brief() {
  local slug="$1" kind="$2" prof project lane key flag='' pf='' wd=''
  IFS=$'\x1f' read -r prof project lane key <<<"$3"
  project=${project:-$4}
  [ "${lane:-agent}" = agent ] && flag=' --agent'
  [ -z "$prof" ] || pf=" --profile $prof"
  echo "This is agent-queue item $slug${key:+, promoted from the board row \"$key\"}, a $kind row: it ends on live proof, never a PR or agent-land."
  headless "$5" || wd='; then /wind-down auto'
  echo "Close in one turn: agent-queue set $slug note=\"<proof>\"${key:+; notes$pf ptask $project$flag done \"$key\" --proof \"<proof>\"}; agent-queue move $slug done --status ok$wd."
  if headless "$5"; then no_human "$slug"; else ask_rule; fi
}

# doc_ask_brief <slug> <kind> <item_row> <project> -- how a doc+ask kind (kinds.json `exit`, the
# propose rung) closes: a doc in the project's lab docs/ and one ask, recorded on the item, its row
# closed on the doc, never a PR, a merge or a publish. fleet-sessions reads the session DONE once
# the item holds both (handoff_of), so the ask is handed over, not waited on.
doc_ask_brief() {
  local slug="$1" kind="$2" prof project lane key docs flag='' pf=''
  IFS=$'\x1f' read -r prof project lane key <<<"$3"
  project=${project:-$4}
  docs=$(np "$prof" projects 2>/dev/null | awk -F'\t' -v p="$project" '$1 == p { print $2; exit }')
  docs=${docs:+${docs%/*}/docs}
  [ "${lane:-agent}" = agent ] && flag=' --agent'
  [ -z "$prof" ] || pf=" --profile $prof"
  echo "This is agent-queue item $slug${key:+, promoted from the board row \"$key\"}, a $kind row: it ends on a doc and an ask, never a PR, a merge or a publish."
  echo "Write the doc under ${docs:-the docs/ dir beside the project summary.md}, then file one agent-ask post for the decision it leads to, with --options, --recommend and a --context that names the doc."
  echo "Then, in the same turn: agent-queue set $slug report=<doc path> ask=<ask id>${key:+; notes$pf ptask $project$flag done \"$key\" --proof doc:<doc path>}; agent-queue move $slug done --status ok; then /wind-down auto."
  echo "That ask is the deliverable, not a wait: once the item holds both, the shepherd reads this session as done."
}

# item_row <item json> -> "<profile> <project> <lane> <key>", joined by the unit separator, of an
# item with a row (agent-queue's `row`: its story, or the board row it was promoted from), else
# nothing. Not a tab: read collapses runs of tabs, so the empty profile of a default-profile row
# would shift every field after it.
item_row() {
  jq -r 'select((.row // "") != "") | .row as $r
    | [(.profile // ""), ($r | split(":")[0]), (.lane // "agent"), ($r | split(":")[1:] | join(":"))] | join("\u001f")' <<<"$1"
}

# close_row <slug> [open] [item json] -- an item with a row, done ok, whose row is still started (or, with `open`, not
# started yet: a row gated on a cancelled ask or held by failures, land_row): the session died before
# agent-land closed it, or closed the item before its PR merged (land_orphan). Closed only on merge proof (agent-merge-proof.sh) of the item's
# merged: commit in the checkout of the repo its PR names, with proof "pr:<N> commit:<sha12>"; with no proof the
# row is left started and the reason logged once (reap_stuck), so a false close never happens. A close notes
# refuses (an open child row) goes the same way: its first error line is logged, keyed on the row so a changing error is one fact.
close_row() {
  local it=${3:-} row prof project lane key flag=() oid pr dir out err rc=1 info state r line MERGE_PROOF_REMOTE=${MERGE_PROOF_REMOTE:-origin}
  [ -n "$it" ] || it=$(agent-queue show "$1" --json 2>/dev/null) || return 0
  row=$(item_row "$it"); [ -n "$row" ] || return 0
  IFS=$'\x1f' read -r prof project lane key <<<"$row"
  [ "$lane" = agent ] && flag=(--agent)
  line=$(row_line "$prof" "$project" "$lane" "$key")
  [[ $line == '- [/]'* || ( "${2:-}" = open && $line == '- [ ]'* ) ]] || { reap_unstuck "$1"; return 0; }
  # The row closes on the item's first PR: pr: and merged: are lists in step, one PR per repo.
  oid=$(jq -r '.merged // "" | split(" ")[0] // empty' <<<"$it"); pr=$(jq -r '.pr // "" | split(" ")[0] // empty' <<<"$it")
  dir=$(pr_repo_dir "$pr" "$project")
  # A merged: that is no commit (fix-ci-ghw's held its PR ref, 2026-11-13) is re-read from the forge,
  # for an item with one PR, so the lists stay in step; agent-queue set refuses such a value now.
  if [ -n "$oid" ] && [[ ! "$oid" =~ ^[0-9a-f]+$ ]] && [ "$(jq -r '.pr // "" | split(" ") | length' <<<"$it")" = 1 ] &&
    info=$(item_pr_state "$1" "$it"); then
    read -r state info _ <<<"$info"; info=${info#-}
    if [ "$state" = MERGED ] && [ -n "$info" ] && { ! own_record "$1" "$it" || agent-queue set "$1" "merged=$info" >/dev/null; }; then oid=$info; fi
  fi
  # Proven on the forge's remote, as agent-land proves it: home-config's only remote is forgejo.
  local frc=1
  if [ -n "$dir" ]; then r=$(so_forge_remote "$dir"); frc=$?; [ "$frc" != 0 ] || MERGE_PROOF_REMOTE=${r%% *}; fi
  if [ -z "$oid" ]; then out='no merged commit'
  elif [ -z "$dir" ]; then out="no checkout of the repo $pr names"
  elif [ "$frc" = 2 ]; then out="$dir is Forgejo-canonical with no remote on a listed Forgejo host"
  elif ! r=$(merge_proof_branch "$dir"); then out="no $MERGE_PROOF_REMOTE branch to prove on in $dir"
  else out=$(merge_proof "$dir" "${pr##*#}" "$r" "$oid" 2>&1); rc=$?
  fi
  if [ "$rc" != 0 ]; then
    # Not at once: a refusal can be a checkout that has not fetched yet, and the next fetch proves it.
    reap_stuck "$1" "$it" "$DISPATCH_ORPHAN_HOURS" \
      "queue item $1: $project row left $([[ $line == '- [ ]'* ]] && echo open || echo started), no merge proof: $out" \
      "chore(board): no merge proof for PR $pr ($out); close $project row $key with its proof, or correct the item's merged:"
    return 0
  fi
  if ! err=$(np "$prof" ptask "$project" "${flag[@]}" done "$key" --proof "pr:$([[ "$pr" == */*#* ]] && echo "$pr" || echo "${pr##*#}") commit:${oid:0:12}" 2>&1); then
    err=$(grep -m1 . <<<"$err"); err=${err#error: }
    reap_stuck "$1" "$it" "$DISPATCH_ORPHAN_HOURS" "queue item $1: closing $project row $key failed: ${err:-notes gave no reason}" \
      "chore(board): dispatch cannot close $project row $key on merged PR $pr; run notes ptask $project done $key to see why, then fix the row or close it"
    return 0
  fi
  reap_unstuck "$1"
  logline "closed $project $lane row on merge proof ($out): $key"
  dispatch_event settled "$project" "row closed on merge proof" --item "$1" --id "$key" --pr "$pr" --sha "$oid"
  echo "closed $project: $key (queue item $1, PR $pr merged)"
}

# settle_row <slug> -- an item with a row that ended failed or cancelled hands it back: un-start it
# and record `failed` with the item and its end reason, so the row is judged again, or held and asked
# about at DISPATCH_FIX_TRIES failures (in_force, ask_failed_rows). A run that ended for a cause outside the model (unrated_end: a usage limit, a provider
# fault, a refusal, a cut) records nothing: nothing about the row failed, so it stays a candidate,
# and a hold earlier real failures left stands. Idempotent: a row no longer started is left alone, and
# so is a row a newer item names (row_newer_item).
settle_row() {
  local it row prof project lane key flag=()
  it=$(agent-queue show "$1" --json 2>/dev/null) || return 0
  [ "$(jq -r '.state + "/" + (.status // "")' <<<"$it")" = done/ok ] && return 0
  [ "$(jq -r .state <<<"$it")" = "done" ] || return 0
  row=$(item_row "$it"); [ -n "$row" ] || return 0
  IFS=$'\x1f' read -r prof project lane key <<<"$row"
  [ "$lane" = agent ] && flag=(--agent)
  [[ "$(row_line "$prof" "$project" "$lane" "$key")" == '- [/]'* ]] || return 0
  ! row_newer_item "$it" || return 0
  np "$prof" ptask "$project" "${flag[@]}" unstart "$key" >/dev/null 2>&1
  local end; end=$(jq -r '.end_reason // ""' <<<"$it")
  unrated_end "$end" ||
    jq -cn --arg p "$project" --arg l "$lane" --arg k "$key" --arg at "$(date -Iseconds)" --arg st "$(jq -r .status <<<"$it")" \
      --arg s "$1" --arg e "$end" \
      '{project: $p, lane: $l, key: $k, verdict: "failed", reason: "queue item \($s) ended \($st)\(if $e != "" then ", \($e)" else "" end)", at: $at}' >> "$VERDICTS"
  logline "settled queue item $1: $project $lane row un-started: $key"
  dispatch_event settled "$project" "row un-started: item ended $(jq -r .status <<<"$it")" --item "$1" --id "$key"
  echo "un-started $project: $key (queue item $1 ended $(jq -r .status <<<"$it")${end:+, $end})"
}

# row_newer_item <item json> -- another queue item names this item's row and holds it: still active (a
# fill starts the row), or ended ok after it (its landing closes the row: land_orphan). The row started is that item's, so an older run settling again (reap reads two
# days of ended items) must not un-start it or count its own failure twice: on 2026-11-21 one failed
# item un-started ar-4041 under its rerun three times, and its two "failures" asked about a row whose
# PR had merged (ar-4678). A queue that cannot be read reads as none, the behaviour before.
row_newer_item() {
  local row fin file since
  IFS=$'\x1f' read -r row fin file < <(jq -r '[.row // "", .finished // "", .file // ""] | join("\u001f")' <<<"$1")
  since=$(date -d "${fin:0:10} -1 day" +%F 2>/dev/null) || since=$(date -d '-2 days' +%F)
  { agent-queue list --json 2>/dev/null; agent-queue list --json --state done --since "$since" 2>/dev/null; } |
    jq -se --arg r "$row" --arg f "$fin" --arg file "$file" \
      'any(.[]; .row == $r and .file != $file and (.state != "done" or (.status == "ok" and (.finished // "") > $f)))' >/dev/null
}

# PR_STATE_JSON, PR_STATE_JQ -- what one read of an item's PR asks for, and the line it prints:
# "<state> <merge oid> <head oid> <ci> <mergeable>", - for a missing oid or mergeable, ci as CI_JQ reads
# the checks, mergeable as gh reads it (MERGEABLE, CONFLICTING, UNKNOWN).
PR_STATE_JSON=state,mergeCommit,headRefOid,statusCheckRollup,mergeable
PR_STATE_JQ="$CI_JQ"' [.state, (.mergeCommit.oid // "-"), (.headRefOid // "-"), ci, (.mergeable // "-")] | join(" ")'

# item_pr_state <slug> <item json> -> PR_STATE_JQ's line for the item's PR; fails when its forge cannot
# be read (so_pr_view). A bare pr: names no repo and one project spans repos, so it reads from the
# project's checkout and prints nothing unless a line of the PR's body is exactly the item's `Item:` stamp.
item_pr_state() {
  local pr project
  IFS=$'\x1f' read -r pr project < <(jq -r '[.pr // "", .project // ""] | join("\u001f")' <<<"$2")
  [ -n "$pr" ] || return 1
  if [[ "$pr" == */*#* ]]; then so_pr_view "$pr" "$(pr_repo_dir "$pr" "$project")" "$PR_STATE_JSON" "$PR_STATE_JQ"; return; fi
  so_pr_view "$pr" "$(repo_dir "$project")" "$PR_STATE_JSON,body" \
    "select(any(.body | split(\"\n\")[] | rtrimstr(\"\r\"); . == \"Item: $1\")) | $PR_STATE_JQ"
}

# own_record <slug> <item json> -- the slug names this record: agent-queue show and set read a reused
# slug's newest item, so a write by slug for an older record would land on another item (land_row).
own_record() { [ "$(agent-queue show "$1" --json 2>/dev/null | jq -r '.file // ""')" = "$(jq -r '.file // ""' <<<"$2")" ]; }

# land_orphan <slug> [open] [item json] -- a started row whose item ended ok before its PR merged (closed by hand
# before agent-queue refused that): the row goes by that PR, not by the orphan timer. A merged:
# commit, or a PR its forge reads as MERGED (item_pr_state, then recorded), goes to close_row; OPEN leaves it started for the
# merge. Returns 1 when no PR holds the row, so the timer decides: no PR or closed unmerged; 2 when
# the forge did not answer. `open` lets close_row close a row not started, and the item json reads that
# record instead of the slug's newest (land_row).
land_orphan() {
  local it=${3:-} oid info state
  [ -n "$it" ] || it=$(agent-queue show "$1" --json 2>/dev/null) || return 1
  oid=$(jq -r '.merged // ""' <<<"$it")
  if [ -z "$oid" ]; then
    [ -n "$(jq -r '.pr // ""' <<<"$it")" ] || return 1
    info=$(item_pr_state "$1" "$it") || return 2
    read -r state oid _ <<<"$info"; oid=${oid#-}
    case "$state" in
    # From land_row, an open PR holds the row only for an item that ended ok: a failed or cancelled
    # run's PR left open is nobody's, and must not keep a held row from its ask.
    OPEN) [ -z "${3:-}" ] || [ "$(jq -r '.status // ""' <<<"$it")" = ok ] || return 1; return 0 ;;
    MERGED) [ -n "$oid" ] || return 1
      ! own_record "$1" "$it" || agent-queue set "$1" "merged=$oid" >/dev/null || return 1
      it=$(jq -c --arg m "$oid" '.merged = $m' <<<"$it") ;;
    *) return 1 ;;
    esac
  fi
  close_row "$1" "${2:-}" "$it"
}

# land_row <project> <row id> -- an open agent row whose work merged while it stayed open: each done
# item naming it with a PR, newest first, goes to land_orphan with its own record, so a later run
# under the same slug (agent-queue show reads the newest) does not hide the one that landed. On
# 2026-11-22 ar-225's ok item hid behind its failed rerun, ar-3634's behind a re-fill, and both rows
# were asked about again. A partial landing is not the row's work (ar-1270). Returns land_orphan's
# 0 (closed, or a PR still open) or 2 (the forge did not answer) from the first item that is not 1;
# 1 when no PR of any item merged or is open; 3 when the done items cannot be read.
land_row() {
  local it rc
  row_done_items || return 3
  while IFS= read -r it; do
    rc=0; land_orphan "$(jq -r .slug <<<"$it")" open "$it" </dev/null || rc=$?
    [ "$rc" = 1 ] || return "$rc"
  done < <(jq -sc --arg r "$1:$2" 'map(select(.row == $r and .partial != "yes")) | sort_by(.finished // "") | reverse | .[]' <<<"$ROW_DONE")
  return 1
}

# row_done_items -- ROW_DONE: every done queue item that names a row and a PR, a JSON object a line,
# read once a process (about 2 s over every done item) and only by a pass that needs it.
row_done_items() {
  [ -z "${ROW_DONE_READ:-}" ] || return 0
  ROW_DONE=$(agent-queue list --json --state done --since 3650d 2>/dev/null | jq -c 'select((.row // "") != "" and (.pr // "") != "")') || return 1
  ROW_DONE_READ=1
}

# unstart_orphans -- an agent-lane row started with no active queue item naming it (its `row`)
# is an orphan: its session never filed an item, or died before reap could see one. If an item done ok
# in the last DISPATCH_ORPHAN_HOURS plus a day names it, its PR decides first (land_orphan); a PR open
# longer than that falls to the timer. A row seen orphaned on every pass for DISPATCH_ORPHAN_HOURS is un-started and given a failed verdict, as
# settle_row does, so it is judged again, or held and asked about at DISPATCH_FIX_TRIES failures; the grace keeps a
# session that started a row a minute ago from losing it. First sightings live in $DIR/orphans.tsv;
# a row that stops being one drops out. Human-lane rows are the human's own and never touched. A
# queue or board it cannot read changes nothing. The board feed covers every profile, as the KPI does.
unstart_orphans() {
  local items landed linked board feed chains brief plan prof name key first now slug seen=''
  feed=$(notes board --json 2>/dev/null) && board=$(jq -ce '.rows | arrays' <<<"$feed") || return 0
  items=$(agent-queue list --json 2>/dev/null) || return 0
  # A plan row promote queued as its chain (plan_row_plan) is its plan's while the chain lives: an active
  # item or a gated board row names that plan (PLAN_ITEMS_JQ). agent-land closes it with the last phase.
  chains=$({ printf '%s\n' "$items"; plan_gated_rows "$feed"; } | jq -cs .) || chains='[]'
  landed=$(agent-queue list --json --state done --since "$(date -d "-$((DISPATCH_ORPHAN_HOURS / 24 + 1)) days" +%F)" 2>/dev/null) || return 0
  landed=$(jq -rs 'map(select(.status == "ok" and (.row // "") != "" and (.lane // "agent") == "agent")) | sort_by(.finished)
    | .[] | "\(.row | sub(":"; "\t"))\t\(.slug)"' <<<"$landed")
  mkdir -p "$DIR"
  linked=$(jq -r 'select(.state != "done" and (.row // "") != "" and (.lane // "agent") == "agent")
    | .row | sub(":"; "\t")' <<<"$items")
  now=$(date +%s)
  while IFS=$'\t' read -r prof name key brief; do
    [ "$prof" != - ] || prof=''
    grep -qxF "$name"$'\t'"$key" <<<"$linked" && continue
    plan=$(plan_row_plan "$brief") || plan=''
    [ -z "$plan" ] || ! jq -e --arg p "$plan" "$PLAN_ITEMS_JQ"' any(.[]; names_plan($p))' <<<"$chains" >/dev/null || continue
    slug=$(K="$name"$'\t'"$key" awk -F'\t' '$1"\t"$2 == ENVIRON["K"] { s = $3 } END { print s }' <<<"$landed")
    [ -n "$slug" ] && land_orphan "$slug" && continue
    first=$(K="${prof:--}"$'\t'"$name"$'\t'"$key" awk -F'\t' '$1"\t"$2"\t"$3 == ENVIRON["K"] { print $4; exit }' "$DIR/orphans.tsv" 2>/dev/null)
    first=${first:-$now}
    if [ $(( now - first )) -lt $(( DISPATCH_ORPHAN_HOURS * 3600 )) ]; then
      seen+="${prof:--}"$'\t'"$name"$'\t'"$key"$'\t'"$first"$'\n'
      continue
    fi
    np "$prof" ptask "$name" --agent unstart "$key" >/dev/null 2>&1 ||
      { logline "orphan $name agent row $key: un-start failed"; continue; }
    jq -cn --arg p "$name" --arg k "$key" --arg at "$(date -Iseconds)" --arg h "$DISPATCH_ORPHAN_HOURS" \
      '{project: $p, lane: "agent", key: $k, verdict: "failed", reason: "started \($h)h with no queue item", at: $at}' >> "$VERDICTS"
    logline "un-started orphan $name agent row (started ${DISPATCH_ORPHAN_HOURS}h with no queue item): $key"
    dispatch_event settled "$name" "orphan row un-started: ${DISPATCH_ORPHAN_HOURS}h with no queue item" --id "$key"
    echo "un-started $name: $key (started with no queue item)"
  done < <(jq -r '.[] | select(.lane == "agent" and .state == "doing")
    | [(if (.profile // "") == "" then "-" else .profile end), .project, (.id // (.text | ascii_downcase)), ((.details // []) | if type == "array" then join(" ") else tostring end)] | @tsv' <<<"$board")
  printf '%s' "$seen" > "$DIR/orphans.tsv.new" && mv "$DIR/orphans.tsv.new" "$DIR/orphans.tsv"
}

# item_end <item json> -> why an item's run ended (end_reason), from its harness's own record: a Codex
# rollout (codex-rollout.jq), an opencode session (opencode-session.jq) or an agy run's log (agy-result.jq),
# the one classifier for each.
# Nothing for an item on another launcher, or one whose record cannot be found: no evidence is not a
# reason, and such an end rates as before. The item's `sessions:` hold the ids its run claimed; the
# launcher's timeout tells a timeout from a cut. A run on a fleet worker (`host:`) left its record in
# the worker's ~/.codex or opencode.db, so the worker classifies it (cmd_item_end); a worker that does
# not answer, or an older one without item-end, gives nothing.
item_end() {
  local agent f launcher t host
  IFS=$'\t' read -r agent host < <(jq -r '[.agent // "claude", .host // ""] | @tsv' <<<"$1")
  launcher=$(harness_launcher "$agent")
  case "$launcher" in codex | opencode | agy) ;; *) return 0 ;; esac
  if [ -n "$host" ]; then
    # shellcheck disable=SC2046  # the ids, one word each (cmd_item_end checks them)
    fleet_host_run "$host" fleet-dispatch item-end "$agent" $(jq -r '.sessions // ""' <<<"$1") 2>/dev/null |
      awk 'NR == 1 && /^[a-z_-]+$/'
    return 0
  fi
  t=$(jq -r --arg h "$agent" '(.harnesses[$h].timeout_min // 0) * 60' "$HARNESSES" 2>/dev/null) || t=0
  if [ "$launcher" = opencode ]; then item_oc_end "$1" "${t:-0}"; return; fi
  if [ "$launcher" = agy ]; then item_agy_end "$1" "${t:-0}"; return; fi
  read -r _ f < <(item_rollout "$1") && [ -n "$f" ] || return 0
  jq -rs --argjson timeout_s "${t:-0}" -f "$CODEX_ROLLOUT_JQ" "$f" 2>/dev/null
}

# item_oc_end <item json> <timeout seconds> -> the end_reason of the newest opencode session the item
# claimed that an opencode.db holds: the shared one, then each lane-sandboxed harness's own (ocfree's runs
# never reach the shared one). The id comes from the item and goes into SQL, so only ses_<alnum> passes.
item_oc_end() {
  local id db rows why
  for id in $(jq -r '(.sessions // "") | split(" ") | reverse | .[]' <<<"$1"); do
    [[ "$id" =~ ^ses_[A-Za-z0-9]+$ ]] || continue
    while IFS= read -r db; do
      [ -r "$db" ] || continue
      rows=$(sqlite3 -readonly -json "$db" "SELECT type, time_created, time_updated, json_extract(data, '\$.finish') AS finish,
        json_extract(data, '\$.error.type') AS etype FROM session_message WHERE session_id = '$id' ORDER BY seq" 2>/dev/null) || continue
      [ -n "$rows" ] || continue
      why=$(jq -r --argjson timeout_s "$2" -f "$OC_SESSION_JQ" <<<"$rows" 2>/dev/null)
      [ -z "$why" ] || { echo "$why"; return 0; }
    done < <(printf '%s\n' "$OC_DB"; harness_run_dbs "$HARNESSES")
  done
}

# item_agy_end <item json> <timeout seconds> -> the end_reason of the newest agy run the item claimed
# whose log (agent-agy's, AGY_RUNS/<id>.jsonl) is on disk. Only agy_<digits> passes: the id names a file.
item_agy_end() {
  local id why
  for id in $(jq -r '(.sessions // "") | split(" ") | reverse | .[]' <<<"$1"); do
    [[ "$id" =~ ^agy_[0-9]+$ ]] && [ -r "$AGY_RUNS/$id.jsonl" ] || continue
    why=$(jq -rnR --argjson timeout_s "$2" -f "$AGY_RESULT_JQ" "$AGY_RUNS/$id.jsonl" 2>/dev/null)
    [ -z "$why" ] || { echo "$why"; return 0; }
  done
}

# item_rollout <item json> -> "<thread id> <rollout file>" of the newest thread its last run, on a Codex
# launcher, claimed in `sessions:` whose rollout is on disk; nothing for another launcher or no rollout.
item_rollout() {
  local id f
  [ "$(harness_launcher "$(jq -r '.agent // "claude"' <<<"$1")")" = codex ] || return 0
  for id in $(jq -r '(.sessions // "") | split(" ") | reverse | .[]' <<<"$1"); do
    f=$(find "$CODEX_SESSIONS" -name "rollout-*-$id.jsonl" -type f -print -quit 2>/dev/null)
    [ -z "$f" ] || { echo "$id $f"; return 0; }
  done
}

# restart_human_item <slug> <item json> <end reason> -- the human's own requeued item keeps its start-now
# lane (agent-queue start: add's guards, no new bypass), except after a usage limit: a hand start would
# launch into the same limit, so a pass starts it when there is room. stdin and fd 3 are closed, so the
# launch cannot read the reap loop's pipe.
restart_human_item() {
  [ "$3" = limit ] || [ "$(jq -r '.from // ""' <<<"$2")" != human ] || agent-queue start "$1" </dev/null 3<&- || true
}

# settle_item <slug> <session> -- its session is gone. Closed by the session: nothing to do.
# Still open, it goes by its PR's state (merged: when the item has one, else item_pr_state): MERGED records merged: and is done ok (and
# a board row still started closes on merge proof, close_row), OPEN waits in review/ for the merge
# (where a --pr-only run leaves it; waiting/ is only for an item whose session needs the human), CLOSED is failed; a state its forge cannot read (so_pr_view), or a bare pr: whose PR
# lacks the item's stamp, leaves it for the next pass. No PR but a `report` (a doc+ask kind's
# doc, a stack-review report) is done ok: that was the deliverable. A waiting or review item with
# neither stays parked on its blocker, any other item with neither is failed, the reason in note.
# Every move is a compare-and-set on the state read here (`--if`), and a note is written only after
# it: an item its session closed or a human requeued meanwhile is left as it is. merged: goes first,
# since agent-queue closes an item with a PR ok only once it has one; it is the PR's fact either way.
# A Codex or opencode run that ends without closing also records why (item_end, --end): this is the only live writer of
# end_reason, and the reason is named in the note. A run that was blocked, not wrong, goes back to queued/
# instead of failing: one with a pending ask for its item is held on that ask (PR or not), and one that
# ended at the plan's usage limit, after a partial landing, or before its `after:` item finished, waits
# there for its next start.
# Each note is added in front of the one the session left (note_add), never over it.
settle_item() {
  local st it pr report info state='' oid head='' ci='' mergeable='' end=() why='' ask after; st=$(item_state "$1")
  # set_end -- why this run ended, asked only by the branches that record it.
  set_end() { why=$(item_end "$it"); [ -z "$why" ] || end=(--end "$why"); }
  # requeue_blocked <slug> <session> <reason> -- back to queued/, where the next start waits on what blocked
  # it. Reads settle_item's st, it, end and why: call set_end first so the end reason goes with it.
  requeue_blocked() {
    agent-queue move "$1" queued ${end[@]+"${end[@]}"} --if "$st" >/dev/null || return 0
    note_add "$1" "$it" "session $2 ended: $3; requeued${why:+ (end_reason: $why)}"
    logline "reaped $2: session gone, queue item $1 requeued: $3"
    echo "requeued queue item $1 ($2 ended: $3)"; restart_human_item "$1" "$it" "$why"
  }
  case "$st" in running | waiting | review | queued) ;; *) logline "reaped $2: queue item $1 ${st:-gone}"; return 0 ;; esac
  it=$(item_with_branch_pr "$1" "$2")
  # A partial merge proves only one repo landed, and with its session gone nobody makes the final
  # landing (ucp-162 sat in review from 2026-11-08): the next start finishes it (pr_line), once. A second
  # run that also ends without it parks in review, where the human sees it, instead of looping.
  if [ "$(jq -r '.partial // ""' <<<"$it")" = yes ]; then
    if [[ "$(jq -r '.note // ""' <<<"$it")" != *"ended: its final landing"* ]]; then
      set_end; requeue_blocked "$1" "$2" "its final landing, after $(jq -r '.pr // "a PR"' <<<"$it") merged as a partial"
      return 0
    fi
    [ "$st" = review ] || agent-queue move "$1" review --if "$st" >/dev/null || return 0
    reap_stuck "$1" "$it" 0 "reaped $2: queue item $1 waits for its final landing (partial, its requeued run ended without it)" \
      "chore(land): $(jq -r '.pr // "its PR"' <<<"$it") merged as a partial and two runs ended without the final landing; land the rest or close it"
    return 0
  fi
  IFS=$'\x1f' read -r pr report oid < <(jq -r '[.pr // "", .report // "", .merged // ""] | join("\u001f")' <<<"$it")
  if [ -n "$pr" ] && [ -n "$oid" ]; then state=MERGED
  elif [ -n "$pr" ]; then info=$(item_pr_state "$1" "$it") || info=''; read -r state oid head ci mergeable <<<"$info"; oid=${oid#-} head=${head#-}
  fi
  # A run that filed a question for its item and stopped without `agent-queue requeue --ask` (4 of 24
  # Codex runs that asked, 2026-11-10) goes back to its board row gated #ask/<id> while its work is
  # unfinished (no report, no PR or an open one): the human's answer promotes the row again
  # (agent-ask start_held), where a failed item turned the answer into a new board row. An item with no
  # row is not requeued here (the guard below reads its row) and fails as below. A report or a merge is the work
  # done, ask or not.
  if [ -z "$report" ] && { [ -z "$pr" ] || [ "$state" = OPEN ]; }; then
    ask=$(item_ask "$1" "$it") || {
      reap_stuck "$1" "$it" "$DISPATCH_ORPHAN_HOURS" "reaped $2: queue item $1 left: agent-ask could not be read" \
        "chore(review): reap has not read agent-ask for ${DISPATCH_ORPHAN_HOURS}h, so it cannot settle the item"
      return 0
    }
    if [ -n "$ask" ] && [ -n "$(jq -r '.row // (.from // "" | select(startswith("board:"))) // empty' <<<"$it")" ]; then
      note_add "$1" "$it" "session $2 ended on ask ${ask%%=*}; its row waits until the human answers it"
      agent-queue requeue "$1" --ask "$ask" >/dev/null 2>&1 || {
        note_add "$1" "$it" "session $2 ended on ask ${ask%%=*}; its return to its board row failed, so it stays here"
        reap_stuck "$1" "$it" "$DISPATCH_ORPHAN_HOURS" "reaped $2: queue item $1 left: requeue on ask ${ask%%=*} failed" \
          "chore(review): agent-queue requeue --ask ${ask%%=*} has failed for ${DISPATCH_ORPHAN_HOURS}h; requeue or close the item"
        return 0
      }
      logline "reaped $2: session gone, queue item $1 returned to its board row behind ask ${ask%%=*}"
      echo "returned queue item $1 to its board row behind ask ${ask%%=*} ($2 ended)"
      return 0
    fi
    # Its host is lost (host_lost, the third argument): the run went with the machine, so a running or
    # waiting item with its work unfinished goes back to queued/, and the next pass starts it on a node
    # that answers. `salvage:` takes the branch the run's Stop hook last pushed (`branch:`), unless a PR
    # holds the work (pr_line), and `lost:` names the host and the run's Claude sessions: the new brief
    # says where the run was (lost_line), and a session it names that wakes with its host is told to stop
    # (10-git-workflow.sh). A review item is parked, not running: own_parked_pr owns its PR.
    if [ -n "${3:-}" ] && { [ "$st" = running ] || [ "$st" = waiting ]; }; then
      local br sids
      agent-queue move "$1" queued --cause lost --if "$st" >/dev/null || return 0
      br=$(jq -r 'select((.pr // "") == "") | .branch // empty' <<<"$it")
      sids=$(jq -r '.sessions // ""' <<<"$it")
      agent-queue set "$1" "lost=$3${sids:+ $sids}" ${br:+"salvage=$br"} >/dev/null ||
        logline "reaped $2: queue item $1 requeued, but lost: and salvage: did not record: its next brief starts from the trunk"
      note_add "$1" "$it" "session $2 lost with its host $3, unanswered for ${DISPATCH_HOST_DEAD}s; requeued from ${br:-${pr:-the trunk}}"
      dispatch_event reaped "$(jq -r '.project // empty' <<<"$it")" "host $3 lost" --item "$1" --why "item was $st"
      logline "reaped $2: host $3 lost, queue item $1 requeued from ${br:-${pr:-the trunk}}"
      echo "requeued queue item $1 (its host $3 is lost)"
      return 0
    fi
  fi
  # A PR read again (a merge with its commit) ends any wait reap_stuck held, so a later stall logs anew.
  case "$state" in OPEN | CLOSED) reap_unstuck "$1" ;; MERGED) [ -z "$oid" ] || reap_unstuck "$1" ;; esac
  # Already parked on its open PR, this pass reaps nothing: no event for every pass of the wait,
  # unless its checks finished with nobody on it (own_parked_pr).
  [ "$state:$st" != OPEN:review ] || { own_parked_pr "$1" "$2" "$it" "$head" "$ci" "$mergeable"; return 0; }
  case "$st:$pr$report" in waiting: | review:)
    [ -z "$(jq -r '.note // ""' <<<"$it")" ] || return 0
    note_add "$1" "$it" "session $2 ended; $st without a PR"
    logline "reaped $2: queue item $1 stays $st without a PR"
    return 0 ;;
  esac
  # A PR its forge cannot read (a repo gh does not know: kblack0610/asset-library-hd#4 logged on every
  # pass, 2026-11-16 to 11-18) is no change: logged once, the human asked once it has stood a while.
  case "$pr:$state" in :* | *:MERGED | *:OPEN | *:CLOSED) ;; *)
    reap_stuck "$1" "$it" "$DISPATCH_ORPHAN_HOURS" "reaped $2: queue item $1 left: could not read PR $pr" \
      "chore(review): reap has not read PR $pr for ${DISPATCH_ORPHAN_HOURS}h; correct the item's pr: or close the item"
    return 0 ;;
  esac
  dispatch_event reaped "$(jq -r '.project // empty' <<<"$it")" "session $2 gone" --item "$1" --why "item was $st"
  if [ -n "$pr" ]; then
    case "$state" in
    MERGED)
      [ -n "$oid" ] || {
        reap_stuck "$1" "$it" "$DISPATCH_ORPHAN_HOURS" "reaped $2: queue item $1 left: PR $pr merged with no merge commit its forge could read" \
          "chore(review): PR $pr merged with no merge commit its forge reads; record it (agent-queue set merged=<sha>) or close the item"
        return 0
      }
      agent-queue set "$1" "merged=$oid" >/dev/null || return 0
      agent-queue move "$1" "done" --status ok --if "$st" >/dev/null || return 0
      logline "reaped $2: session gone, queue item $1 done, PR $pr merged"
      close_row "$1" ;;
    OPEN)
      set_end
      # Stopped at the usage limit with its PR open: the next start continues on that PR (pr_line).
      [ "$why" != limit ] || { requeue_blocked "$1" "$2" "the plan's usage limit, with PR $pr open"; return 0; }
      agent-queue move "$1" "review" ${end[@]+"${end[@]}"} --if "$st" >/dev/null || return 0
      note_add "$1" "$it" "session $2 ended with PR $pr open${why:+ (end_reason: $why)}"
      logline "reaped $2: session gone, queue item $1 in review on its open PR $pr"
      echo "review queue item $1 (PR $pr open, $2 ended)" ;;
    CLOSED)
      set_end
      agent-queue move "$1" "done" --status failed ${end[@]+"${end[@]}"} --if "$st" >/dev/null || return 0
      note_add "$1" "$it" "PR $pr closed unmerged; session $2 ended${why:+ (end_reason: $why)}"
      logline "reaped $2: session gone, queue item $1 failed: PR $pr closed unmerged"
      echo "failed queue item $1 (PR $pr closed unmerged)" ;;
    esac
  elif [ -n "$report" ]; then
    agent-queue move "$1" "done" --status ok --if "$st" >/dev/null || return 0
    logline "reaped $2: session gone, queue item $1 done with its report $report"
  else
    set_end
    # The plan turned the run away at its usage limit: nothing about the item failed, so it goes back
    # to queued/ and its next start waits on the source's room, which claude-acct holds reached from
    # the refusal until the window resets (ar-1120). agent-codex pushed any work it left to salvage/<slug>
    # when it exited, and the next start resumes its thread there (resume_thread). A run started before
    # its `after:` items finished (a hand start does not check holds) goes back to its board row gated
    # #after/ on them (agent-queue return): the queue holds only work that can start. One with no row
    # to go back to fails as below.
    [ "$why" != limit ] || { requeue_blocked "$1" "$2" "the plan's usage limit"; return 0; }
    for after in $(jq -r '.after // ""' <<<"$it"); do
      case "$(item_state "$after")" in queued | running | waiting | review)
        if agent-queue return "$1" --why "session $2 ended before $after, which it waits after, closed: its row waits on it" >/dev/null 2>&1; then
          logline "reaped $2: session gone, queue item $1 returned to its board row: it waits after $after"
          echo "returned queue item $1 ($2 ended; it waits after $after)"
          return 0
        fi
        break ;; esac
    done
    takeover_branch "$1" "$2" "$it" "$st" ${end[@]+"${end[@]}"} && return 0
    agent-queue move "$1" "done" --status failed ${end[@]+"${end[@]}"} --if "$st" >/dev/null || return 0
    note_add "$1" "$it" "session $2 ended before it closed the item${why:+ (end_reason: $why)}"
    logline "reaped $2: session gone, queue item $1 failed: no PR${why:+, end_reason $why}"
    echo "failed queue item $1 ($2 ended without closing it${why:+, end_reason $why})"
  fi
}

# branch_pr <item json> -> `<owner>/<repo>#<N>` of the newest open or merged PR whose head is exactly the item's
# recorded branch and sha (`branch: <name>@<sha>`, push_item), read from the project's checkout. A PR at an older
# head (the run pushed more after it) or one closed unmerged is no proof for that work: takeover_branch owns it.
# Fails when there is none, the item has no branch, or the checkout is a Forgejo repo (gh sees only its mirror,
# which has no PRs). Only the project's primary checkout is read, as takeover_branch does.
branch_pr() {
  local br project dir
  IFS=$'\x1f' read -r br project < <(jq -r '[.branch // "", .project // ""] | join("\u001f")' <<<"$1")
  [[ "$br" == ?*@?* ]] || return 1
  dir=$(repo_dir "$project")
  [ -n "$dir" ] && ! forge_canonical "$dir" || return 1
  (cd "$dir" && gh pr list --head "${br%@*}" --state all --json number,url,state,headRefOid 2>/dev/null) |
    jq -er --arg sha "${br##*@}" '[.[] | select(.state != "CLOSED" and .headRefOid == $sha)] | max_by(.number)
      | (.url | capture("github.com/(?<r>[^/]+/[^/]+)/pull/") | .r) + "#\(.number)"' 2>/dev/null
}

# item_with_branch_pr <slug> <session> -> the item's JSON as agent-queue shows it, for settle_item. An item with
# no pr: and no report whose Stop hook pushed a branch, and whose run opened a PR from that head before its
# session ended without recording it (agent-land never ran), gets that PR recorded first: it then settles by
# the MERGED/OPEN/CLOSED arms, not as "no PR" and not by a takeover that starts a second copy of work already
# in review.
item_with_branch_pr() {
  local it pr
  it=$(agent-queue show "$1" --json 2>/dev/null)
  if [ -z "$(jq -r '(.pr // "") + (.report // "")' <<<"$it" 2>/dev/null)" ] && pr=$(branch_pr "$it") &&
    agent-queue set "$1" "pr=$pr" >/dev/null; then
    logline "reaped $2: queue item $1 had no PR recorded; its branch's PR $pr recorded"
    it=$(agent-queue show "$1" --json 2>/dev/null)
  fi
  printf '%s\n' "$it"
}

# takeover_branch <slug> <session> <item json> <state> [--end <why>] -- an item with no PR and no report
# whose session ended without closing it, after its Stop hook pushed work (`branch: <name>@<sha>`, push_item)
# its trunk lacks: that work is taken over, not failed with it (ar-3741: the shepherd closes a stalled
# window once its work is pushed). The item goes back to queued/ with `salvage:` on that head, so its next
# start begins there (salvage_line, resume_thread), DISPATCH_FIX_TRIES times, counted on `takeover_tries:`
# across heads, since a run that pushes and stops again is not converging. Returns 1, and the item fails
# as before, for a branch with nothing to land (its head on the trunk), one the checkout cannot fetch, or
# spent tries.
takeover_branch() {
  local slug=$1 sess=$2 it=$3 st=$4 br tries project dir ref name sha r sv MERGE_PROOF_REMOTE=''
  shift 4
  IFS=$'\x1f' read -r br tries project sv < <(jq -r '[.branch // "", .takeover_tries // "", .project // "", .salvage // ""] | join("\u001f")' <<<"$it")
  [[ "$br" == ?*@?* ]] || return 1
  name=${br%@*} sha=${br##*@}
  [[ "$tries" =~ ^[0-9]+$ ]] || tries=0
  [ "$tries" -lt "$DISPATCH_FIX_TRIES" ] || return 1
  dir=$(repo_dir "$project")
  [ -n "$dir" ] || return 1
  # The trunk on the forge's remote, as close_row proves a merge; the branch on origin, where push_item pushes it.
  r=$(so_forge_remote "$dir") && MERGE_PROOF_REMOTE=${r%% *}
  ref=$(merge_proof_ref "$dir") || return 1
  # Offline judges against the last fetch; a head this checkout never sees is no work to hand over.
  git -C "$dir" fetch -q "${ref%%/*}" "+refs/heads/${ref#*/}:refs/remotes/$ref" 2>/dev/null
  git -C "$dir" cat-file -e "$sha^{commit}" 2>/dev/null || git -C "$dir" fetch -q origin "refs/heads/$name" 2>/dev/null
  git -C "$dir" cat-file -e "$sha^{commit}" 2>/dev/null || return 1
  ! git -C "$dir" merge-base --is-ancestor "$sha" "$ref" 2>/dev/null || return 1
  agent-queue set "$slug" "salvage=$br" "takeover_tries=$((tries + 1))" >/dev/null || return 1
  # Moved on by someone else meanwhile (its session closed it, a human requeued it): theirs, not a
  # failure, and the stamps go back as they were, so its next start is not told to resume this branch.
  agent-queue move "$slug" queued "$@" --cause takeover --if "$st" >/dev/null || {
    agent-queue set "$slug" "salvage=$sv" "takeover_tries=$([ "$tries" = 0 ] || echo "$tries")" >/dev/null
    return 0
  }
  note_add "$slug" "$it" "session $sess ended with its work on branch $name at ${sha:0:12}, not on $ref; requeued from it (takeover $((tries + 1)) of $DISPATCH_FIX_TRIES)"
  dispatch_event requeued "$project" "branch $name left with nobody on it: takeover $((tries + 1))" --item "$slug" --sha "$sha"
  logline "reaped $sess: queue item $slug requeued from branch $name at ${sha:0:12} (takeover $((tries + 1)) of $DISPATCH_FIX_TRIES)"
  echo "takeover queue item $slug (branch $name at ${sha:0:12}, try $((tries + 1)) of $DISPATCH_FIX_TRIES)"
}

# own_parked_pr <slug> <session> <item json> <head oid> <ci> [mergeable] -- a review item whose session is gone
# gets an owner once its PR checks finish, since nothing else restarts a parked PR. Red (ci FAIL): a
# fix-ci session (16 of 20 parked PRs were red on 2026-11-09). Green (ci PASS): a lander that lands
# or closes it (land_brief), since a headless tier-3 run is --pr-only and fix-ci moves its
# item back here without merging: 26 sat in review on 2026-11-12, 11 of them green. In conflict with
# its base (CONFLICTING), whatever its checks read: the lander too, told to merge the base in first,
# since GitHub runs no pull_request checks on a PR it cannot merge, so it would wait with no owner
# (ar-3741: a stalled session's window closes onto its PR). It goes back to
# queued/ (--if review) as a oneshot stamped `<fix|land>_tries: <n> <head>[ conflict]` and `pr_owner`, which
# item_brief reads, and the next pass starts it behind every gate a queued item waits on (agent-hold,
# the weekly pace, load, the run gate); while the agent-queue cap holds adds it waits in
# review/. DISPATCH_FIX_TRIES tries of each, then one human-sheet row and a page keyed needs:dispatch:pr:<pr>:<owner>:<head> (a new head is a new fact; agent-notify drops a repeat within a day) (fleet-bench triage instead
# escalates a red, then asks once), stamped `fix_human: <head> <owner>...`; a head that
# moves after that row (the human pushed) starts the count again. The stamp quiets only the owners it
# names, so a head whose fix-ci row went to the human and that later reads green still gets a lander,
# and the reverse (#2182 sat in review green with nobody on it). A lander that asks the human is held
# on its ask by settle_item before this runs. A session reap cannot witness (`unrecorded`, a cloud run)
# is never read as gone here.
own_parked_pr() {
  local slug=$1 it=$3 head=$4 owner verb color cause tries human hhead howners pr project note trn held where why='' clear=()
  # cause: the requeue's cause on the run's outcome (MOVE_CAUSES): a green PR's lander merges the run's
  # diff unchanged, so that run is filed unrated (land); a red or conflicting PR rates as redo.
  case "${6:-}:$5" in
  CONFLICTING:*) owner=land verb=land color='in conflict with its base' why=' conflict' cause=conflict ;;
  *:FAIL) owner=fix verb=fix-ci color=red cause=fix-ci ;;
  *:PASS) owner=land verb=land color=green cause=land ;;
  *) return 0 ;;
  esac
  # A green critical PR waiting on its validate item has a lander: that item's session (agent-land validate_gate).
  [ "$color" != green ] || [ -z "$(jq -r '.validate // ""' <<<"$it")" ] ||
    ! [[ "$(item_state "$(jq -r .validate <<<"$it")")" =~ ^(queued|running|waiting|review)$ ]] || return 0
  [ -n "$head" ] && [ "$2" != unrecorded ] || return 0
  IFS=$'\x1f' read -r tries human pr project note trn < <(jq -r --arg f "${owner}_tries" '[.[$f] // "", .fix_human // "", .pr, .project // "", .note // "", .trainee // ""] | join("\u001f")' <<<"$it")
  tries=${tries%% *}
  [[ "$tries" =~ ^[0-9]+$ ]] || tries=0
  # A stamp from before it named its owners (the head alone) was a fix-ci row: every live one was, 2026-11-17.
  read -r hhead howners <<<"$human"
  [ -z "$hhead" ] || howners=${howners:-fix}
  if [ "$hhead" = "$head" ]; then
    if [ "$tries" -ge "$DISPATCH_FIX_TRIES" ]; then case " $howners " in *" $owner "*) return 0 ;; esac; fi
    # written out in full, so the hub reads a head-only stamp's owner as this pass did (queue.rs stuck_on)
    clear=("fix_human=$head $howners")
  elif [ -n "$human" ]; then tries=0 howners='' clear=(fix_human= fix_tries= land_tries=)
  fi
  if [ "$tries" -lt "$DISPATCH_FIX_TRIES" ]; then
    held="PR $pr $color at ${head:0:12}; $verb held by admission"
    # A trainee's PR goes past the cap, as a trainee add does (QUEUE.md): no trainee run counts until its
    # PR lands, and the trainee floor starts its owners one trainee review at a time (trainee_land_start).
    if [ -z "$trn" ] && ! jq -e .admits >/dev/null 2>&1 < <(agent-queue admission --json 2>/dev/null); then
      # Said once, on the item and in the log, not on every pass of the hold.
      [ "$note" = "$held" ] || { agent-queue set "$slug" "note=$held" >/dev/null; logline "queue item $slug: $held"; }
      return 0
    fi
    # A tier-3 lander runs on claude: the Review line agent-land asks for comes from /code-review high,
    # which a headless harness cannot run (the reason its first run was --pr-only).
    [ "$owner" != land ] || [ "$(item_tier "$it")" != 3 ] || clear+=(agent=claude)
    agent-queue set "$slug" "${owner}_tries=$((tries + 1)) $head$why" "pr_owner=$owner" mode=oneshot "${clear[@]}" \
      "note=PR $pr $color at ${head:0:12}; $verb try $((tries + 1)) of $DISPATCH_FIX_TRIES" >/dev/null || return 0
    agent-queue move "$slug" queued --cause "$cause" --if review >/dev/null || return 0
    logline "reaped $2: queue item $slug requeued for $verb, PR $pr $color at ${head:0:12} (try $((tries + 1)) of $DISPATCH_FIX_TRIES)"
    dispatch_event requeued "$project" "PR $color with nobody on it: $verb try $((tries + 1))" --item "$slug" --pr "$pr" --sha "$head"
    echo "$verb queue item $slug (PR $pr $color at ${head:0:12}, try $((tries + 1)) of $DISPATCH_FIX_TRIES)"
    return 0
  fi
  # The sheet (human_sheet_row): the stamp goes first, so a failed write never files the row twice; a
  # sheet that refuses the row still gets the page, once.
  agent-queue set "$slug" "fix_human=$head${howners:+ $howners} $owner" >/dev/null || return 0
  local title="fix(ci): PR $pr is $color at ${head:0:12} after $tries fix-ci tries; fix it"
  [ "$owner" = fix ] || title="chore(review): PR $pr is $color at ${head:0:12} after $tries land tries; land it"
  where=$(human_sheet_row "$it" "$title or close it (queue item $slug) #size/s")
  agent-queue set "$slug" "note=PR $pr $color at ${head:0:12} after $tries $verb tries; $where" >/dev/null
  agent-notify -t 'Needs you' -d "needs:dispatch:pr:$pr:$owner:${head:0:12}" "PR $pr $color after $tries $verb tries ($where)" >/dev/null 2>&1
  logline "queue item $slug: PR $pr $color at ${head:0:12} after $tries $verb tries, $where"
  echo "human row for queue item $slug (PR $pr $color after $tries $verb tries, $where)"
}

# settle_sessionless <slug> <started> -- a started item recording no session, tmux or Claude: nothing
# witnesses it ending and nothing can nudge it, so PRs #909 and #910 sat open with nobody on them. Its
# PR or report still decides what it can (settle_item): merged or closed settles it, open parks it in
# review/, a report is done. Anything else stays put, never failed, since no-witness is not gone, and is
# flagged once on the item and in the log, ahead of any note it had. fleet-bench's ownerless_running
# counts it, so the board-chain watch pages it.
settle_sessionless() {
  local it pr note flag
  past_reap_grace "$2" || return 0
  it=$(agent-queue show "$1" --json 2>/dev/null) || return 0
  pr=$(jq -r '.pr // ""' <<<"$it")
  if [ -n "$pr$(jq -r '.report // ""' <<<"$it")" ]; then
    settle_item "$1" unrecorded
    settle_row "$1"
    [ "$(item_state "$1")" != "done" ] || return 0
  fi
  flag="no session recorded${pr:+ (PR $pr)}: nothing watches this item; agent-queue claim it from a session, or close it"
  note=$(jq -r '.note // ""' <<<"$it")
  case "$note" in *"$flag"*) return 0 ;; esac
  agent-queue set "$1" "note=$flag${note:+; was: $note}" >/dev/null || return 0
  logline "queue item $1: $flag"
  echo "flagged queue item $1 ($flag)"
}

# red_items <item json lines> -> the red items among them, a tripped watch's first, so the floor slot
# its item adds is not taken by another red.
red_items() {
  jq -sc 'map(select((" " + (.tags // "") + " ") | contains(" red ")))
    | sort_by((" " + (.tags // "") + " ") | contains(" watch ") | not)[]' <<<"$1"
}

# red_floor_due <red item json lines> -- one is queued and the red floor may start it past the gates.
red_floor_due() { [ -n "$1" ] && RED_PASS=1 red_floor_open && [ -z "$(RED_PASS=1 gate)" ]; }

# red_floor_start <red item json lines> <room> <why> -- start them on the red floor. The start goes
# past <why>, the gates that held the pass, without proving them open, so the hold stands (start_item).
red_floor_start() {
  local rc
  say "$3; red items start on the red floor (DISPATCH_RED_FLOOR=$DISPATCH_RED_FLOOR, plus ${RED_WATCH:-0} for tripped watches)"
  RED_PASS=1 FLOOR_GATE=$3; start_items "$1" "$2"; rc=$?
  RED_PASS=0 FLOOR_GATE=''
  return "$rc"
}

# FLOOR_SHUT: the rc a floor or side start (trainee, sprint, the other-source pass) returns when it is
# not due, so the caller goes on as it would have.
FLOOR_SHUT=10

# other_source_start <item json lines> <why> -- past a full Claude pace target, start the items that route
# to a non-Claude source with room: the target is Claude's budget (pace_target), so codex, go, ocfree and
# the gateway teams wait on their own room (max_live, reserve and budget, in claude-acct room --json), never on it.
# CLAUDE_FULL=1 makes route refuse claude, so an item starts only on another candidate. Tried: an item pinned
# to a harness whose source has room (a non-Claude lane's canary among them), one whose cached verdict (lane_cached) names such a harness, and at
# most one unclassified item a slot (its verdict is cached when it routes nowhere, so a pass asks
# model-lane little). Bound: the free slots of the sources with room (their cap less live: room --json max_live is max_live or rpm over run_rpm; 1 a pass for one
# with no cap), at most DISPATCH_PER_PASS when set; start_items reads the gate again each start.
# Rc FLOOR_SHUT when nothing is due.
other_source_start() {
  local items rows slots open s v fresh
  rows=${ACCT_ROWS:-$(claude-acct room --json 2>/dev/null)}
  open=$(jq -c --slurpfile map "$HARNESSES" '[.sources[]? | select(.room.ok == true) | .name] as $ok
    | [$map[0].harnesses | to_entries[]? | select(.value.source as $s | $s != null and any($ok[]; . == $s)) | .key]' <<<"$rows" 2>/dev/null)
  slots=$(jq -r --slurpfile map "$HARNESSES" '[$map[0].harnesses[]? | .source // empty] as $s
    | [.sources[]? | select(.room.ok == true and (.name as $n | any($s[]; . == $n)))
       | if .max_live then ([.max_live - (.live // 0), 0] | max) else 1 end] | add // 0' <<<"$rows" 2>/dev/null)
  [[ "$slots" =~ ^[0-9]+$ ]] && [ "$slots" -gt 0 ] || return "$FLOOR_SHUT"
  [ "$PER_PASS" -gt 0 ] && [ "$slots" -gt "$PER_PASS" ] && slots=$PER_PASS
  items=$(fresh=0; while IFS= read -r s; do
    [ -n "$s" ] || continue
    if item_pinned "$s"; then
      jq -e --argjson o "${open:-[]}" '.agent as $a | any($o[]; . == $a)' <<<"$s" >/dev/null 2>&1 && printf '%s\n' "$s"
      continue
    fi
    v=$(lane_cached "$(jq -r .slug <<<"$s")")
    if [ -n "$v" ]; then
      jq -e --argjson o "${open:-[]}" 'any(.candidates[]?; .harness as $h | $h != "claude" and any($o[]; . == $h))' <<<"$v" >/dev/null 2>&1 && printf '%s\n' "$s"
    elif [ "$fresh" -lt "$slots" ]; then fresh=$((fresh + 1)); printf '%s\n' "$s"; fi
  done < <(jq -c 'select(((" " + (.tags // "") + " ") | contains(" red ")) | not)' <<<"$1"))
  [ -n "$items" ] || return "$FLOOR_SHUT"
  [ -z "$(gate)" ] || return "$FLOOR_SHUT"
  say "$2; $slots slot(s) free on other sources, so items routed off Claude start past it"
  OTHER_PASS=1 CLAUDE_FULL=1 FLOOR_QUIET=1 UNITS_FREE=$(( slots * 2 )) start_items "$items" "$slots"
}

# canary_top_up -- hold DISPATCH_CANARY_KEEP canary items queued or running: the ones missing are
# queued by `fleet-bench canary queue --max N` as dispatch's own pull (AGENT_QUEUE_PULL=dispatch, so
# agent-queue takes them), one task a lane a round, so a week's set trickles in as each one finishes
# instead of sitting in the queue whole (the cap and the queue age count every queued item). They start
# in queue order like any item, the class mix (classes.json `cleanup`, tag `canary`) keeping their class
# from falling behind. While the fleet share is full only the lanes on their own source queue (--off-claude:
# a Claude lane's canary would wait at the cap). Skipped in a dry run, at 0, and while floor_gate is shut
# (a red cluster with the gateway down), dispatch's hold included;
# a failure is said once, never the end of the pass.
canary_top_up() {
  local live have want out rc=0 note='' FLOOR_WHY
  [ "$DRY" = 0 ] && [ "${DISPATCH_CANARY_KEEP:-0}" -gt 0 ] 2>/dev/null || return 0
  # A canary the fleet share holds is not counted: it cannot start, so it keeps no lane busy.
  share_state
  have=$(agent-queue list --json --state queued 2>/dev/null | jq -s --argjson s "$SHARE_STATE" "$SHARE_JQ"'[.[] | select((" " + (.tags // "") + " ") | contains(" canary ")) | select(share_held($s) | not)] | length') || have=
  [[ "$have" =~ ^[0-9]+$ ]] || { say "canary top-up: the queue is unreadable, so none is queued"; return 0; }
  live=$(live_tagged canary | grep -c . || true)
  want=$(( DISPATCH_CANARY_KEEP - have - live ))
  [ "$want" -gt 0 ] || return 0
  floor_gate; [ -z "$FLOOR_WHY" ] || return 0   # only when canaries are missing: it reads gate and the gateway
  # While the share is full a Claude lane's canary would wait in queued/, so only the lanes on their own source queue (SHARE_JQ).
  local off=(); if share_full; then off=(--off-claude); note=", the fleet share full: no Claude lane"; fi
  out=$(AGENT_QUEUE_PULL=dispatch fleet-bench canary queue --max "$want" "${off[@]}" 2>&1) || rc=$?
  [ "$rc" = 0 ] || note="$note, not every lane queued"
  [ -n "$out" ] || [ "$rc" = 0 ] || out="fleet-bench exited $rc"
  [ -z "$out" ] || say "canary top-up (keep $DISPATCH_CANARY_KEEP, $have queued, $want wanted$note): ${out//$'\n'/; }"
}

# trainee_floor_why -> FLOOR_WHY, why the trainee floor is shut now (no trainee: lane, else floor_gate's
# answer on the trainee's own resources, TRAINEE_GATE=1: the agent-hold, the gateway and the
# GitHub budget; no Claude account, no load here), empty when it may start; trainee-pool reads it too,
# so the readout and the pass say one thing.
trainee_floor_why() {
  trainee_load
  jq -e '[.candidates[]?.harness] | length > 0' <<<"$TRAINEE_CONF" >/dev/null 2>&1 ||
    { FLOOR_WHY="lanes.yaml has no trainee: lane (model-lane trainee)"; return 0; }
  TRAINEE_GATE=1 floor_gate
}

# trainee_floor_start -- keep the trainee slots busy (each source's room, lanes.yaml max_waiting) past the
# pace target: the free keys sat at 0% on 11-18 while every pass ran over it. First the owner of a
# trainee's PR (trainee_land_start), else the batch review (trainee_batch_start), one trainee review
# live at a time, then one start a pass on each trainee harness with a slot: the first queued
# row it takes (trainee_queued_pick), else the top-ranked board row it takes (trainee_board_pick),
# promoted and started in the same step, so no promoted row waits in the queue. The gate still holds
# it, route still needs the trainee's source room, and each pass says why the floor is shut when it
# is: a silent starved floor goes unseen. Rc FLOOR_SHUT when nothing started.
# Off with lanes.yaml trainee `candidates: []`.
trainee_floor_start() {
  local before=${STARTED:-0} why h hs=() shut=() dry=() queued board='' bread=0 bfail=0 it c key rc
  trainee_load
  mapfile -t hs < <(jq -r '[.candidates[]?.harness] | unique[]' <<<"$TRAINEE_CONF")
  trainee_floor_why; why=$FLOOR_WHY
  # A shut floor is no dry pool: its hold or gate is what starved and the Stopped line name.
  [ -z "$why" ] || { rm -f "$TRAINEE_DRY"; say "trainee floor: shut, $why"; return "$FLOOR_SHUT"; }
  # The batch review and a trainee PR's owner run on claude, which this machine's load (machine_here_why)
  # and unreadable account usage hold, and the trainee's own gate skips: start_item would settle the
  # whole pass BLOCKED on it. With no account room the owner waits in route and the batch review goes
  # to reviewer_fallback (trainee_reviewer_pin).
  local cwhy
  cwhy=$(machine_here_why)
  [ -n "$cwhy" ] || cwhy=$(acct_room; [ $? = 2 ] && printf 'account usage unreadable (%s)' "$ACCT_WHY")
  if [ -n "$cwhy" ]; then rc=$FLOOR_SHUT
    [ -z "$(trainee_waiting)$(trainee_land_items)" ] || say "trainee floor: the batch review and a trainee PR's owner (claude) wait: $cwhy; the trainee slots still fill"
  else
    trainee_land_start; rc=$?
    case "$rc" in 0 | "$FLOOR_SHUT") ;; *) say "trainee floor: a trainee PR's owner did not start (rc $rc); the trainee slots still fill" ;; esac
    trainee_batch_start; rc=$?
  fi
  # A batch that could not be filed or started is logged, never the end of the pass (the queue may be locked).
  case "$rc" in 0 | "$FLOOR_SHUT") ;; *) say "trainee floor: the batch review did not file or start (rc $rc); the trainee slots still fill" ;; esac
  queued=${NEXT_QUEUED-$(next_items --points)}
  for h in "${hs[@]}"; do
    [ -n "$(harness_sandbox "$h")" ] || { shut+=("$h runs in no lane sandbox"); continue; }
    why=$(ladder_open_why "$h") || { shut+=("$why"); continue; }
    it=$(trainee_queued_pick "$h" "$queued")
    if [ -z "$it" ]; then
      [ "$bread" = 1 ] || { board=$(trainee_rows) || { say "trainee floor: the board read failed"; bfail=1; }; bread=1; }
      c=$(trainee_board_pick "$h" "$board")
      [ -n "$c" ] || { shut+=("$h has a slot, and no queued or board row is one it takes"); dry+=("$h"); continue; }
      key=$(jq -r .key <<<"$c")
      board=$(jq -c --arg k "$key" --arg p "$(jq -r .project <<<"$c")" 'select(.key != $k or .project != $p)' <<<"$board")
      if [ "$DRY" = 1 ]; then say "trainee floor: would promote $(jq -r .project <<<"$c") row $key and start it on $h"; continue; fi
      PROMOTED=''
      promote "$c" "$(jq -r '[if .cleanup == 0 then "cleanup" else empty end, if .tier then "tier\(.tier)" else empty end] | join(" ")' <<<"$c")" \
        "$(row_task "$c")" >/dev/null && [ -n "$PROMOTED" ] || { shut+=("$h: could not promote row $key"); continue; }
      it=$(agent-queue show "$PROMOTED" --json --points)
      say "trainee floor: promoted row $key to queue item $PROMOTED for $h"
    fi
    TRAINEE_PASS=1 TRAINEE_HARNESS=$h FLOOR_QUIET=1 UNITS_FREE=2 start_items "$it" 1; rc=$?
    [ "$rc" = 0 ] || return "$rc"
    queued=$(jq -c --arg s "$(jq -r .slug <<<"$it")" 'select(.slug != $s)' <<<"$queued")
  done
  [ "${#shut[@]}" -eq 0 ] || { why=$(printf '%s; ' "${shut[@]}"); say "trainee floor: ${why%; }"; }
  # Each harness with a slot and no row it takes is dry since the first pass that found it so, one line
  # a harness; a harness that started or was shut for another reason drops its line. starved reads the
  # ages. A failed board read says nothing about the pool, so it leaves the marks as they were. On
  # 2026-11-23 it ran dry at 06:21 with free slots on go and ocfree, and nothing said so (ar-4739).
  [ "$DRY" = 1 ] || [ "$bfail" = 1 ] || trainee_dry_mark "${dry[@]}"
  [ "${STARTED:-0}" -gt "$before" ] || return "$FLOOR_SHUT"
}

# trainee_dry_mark <harness>... -- TRAINEE_DRY holds one "<harness> TAB <epoch>" line for each harness
# named: its old epoch when it was dry already, else now. Every other harness's line goes, and with
# none named the file goes.
trainee_dry_mark() {
  local h since out=''
  [ "$#" -gt 0 ] || { rm -f "$TRAINEE_DRY"; return 0; }
  for h in "$@"; do
    since=$(awk -F'\t' -v h="$h" '$1 == h && $2 ~ /^[0-9]+$/ { print $2; exit }' "$TRAINEE_DRY" 2>/dev/null)
    out+="$h"$'\t'"${since:-$(date +%s)}"$'\n'
  done
  mkdir -p "${TRAINEE_DRY%/*}" && printf '%s' "$out" >"$TRAINEE_DRY.tmp" && mv "$TRAINEE_DRY.tmp" "$TRAINEE_DRY"
}

# trainee_ok <item json> <harness> -- rc 0 when the trainee harness may run the row: trainee_why (no
# harness, so no queue read a row: the caller asked ladder_open_why once) and its projects allowlist.
trainee_ok() {
  trainee_why "$1" >/dev/null && harness_project_why "$HARNESSES" "$2" "$(jq -r '.project // ""' <<<"$1")" >/dev/null
}

# trainee_queued_pick <harness> <item json lines> -> the first queued item, in queue order, the
# harness's trainees may run: unpinned, with points (row or #pts/N), and trainee_ok.
trainee_queued_pick() {
  local it
  while IFS= read -r it; do
    [ -n "$it" ] || continue
    ! item_pinned "$it" || continue
    trainee_ok "$it" "$1" && { echo "$it"; return 0; }
  done < <(jq -c 'select(((.points // "") | tostring | test("^[0-9]+$")) or ((.task // "") | test("#pts/[0-9]+"; "i")))' <<<"$2" 2>/dev/null)
  return 0
}

# trainee_board_pick <harness> <trainee_rows> -> the first row, in their rank, the harness's trainees
# may run once promoted (its item as row_item builds it, trainee_row_why).
trainee_board_pick() {
  local c
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    trainee_row_why "$c" "$1" >/dev/null && { echo "$c"; return 0; }
  done < <(jq -c 'select((.text // "") | test("#pts/[0-9]+"; "i"))' <<<"$2" 2>/dev/null)
  return 0
}

# trainee_row_why <candidate row> <harness>... -> why no trainee takes the board row, rc 1, or nothing
# (rc 0): the first refusal of trainee_why (which holds trainee_public_why), then each harness's projects
# allowlist. The verdict trainee_board_pick reads per harness, asked once for them all.
trainee_row_why() {
  local ri h row="$1"; shift
  ri=$(row_item "$row")
  trainee_why "$ri" || return 1
  for h in "$@"; do harness_project_why "$HARNESSES" "$h" "$(jq -r '.project // ""' <<<"$ri")" >/dev/null && return 0; done
  echo "no trainee harness takes its project"; return 1
}

# trainee_reason_key <why> -> the refusal with its row's own words taken out (a number, a file, a repo
# path), so rows refused for one reason count under one line.
trainee_reason_key() {
  sed -E 's#^its repo .* is not one a trainee#its repo is not one a trainee#
    s#^.* has no \.githooks/sensitive-tokens\.txt.*#its repo has no .githooks/sensitive-tokens.txt#
    s#^its words match .*#its words match the repo sensitive-tokens.txt#
    s#^it names [^,]*, which .* does not track$#it names a file which the repo does not track#
    s#^it names [^,]*, which (.*)#it names a file which \1#
    s#^its kind .* opens no PR#its kind opens no PR#
    s#^a ladder run took it once already .*#a ladder run took it once already#
    s#[0-9]+#N#g' <<<"$1"
}

# trainee_rows -> the board rows the trainee floor weighs, in RANK_JQ order: every open agent-lane row a
# worker takes (all_open) and the tier-3 rows (t3_rows), judged or not, since trainee_row_why is the trainee's rule and the promoted item still meets
# item_tier and trainee_public_why. The judged rows alone (day_picks) were about 9 a day of 653 open
# #pts/1-3 rows (2026-11-19). A verdict still holds a row as picks and t3_ready read it: `failed` (its
# session died), and a `skip` the policy still defines for the row's current text, unless the row is
# gated; an area a verdict
# named and an active item holds (queue_areas) is skipped, except on a tier-3 row, which gets
# t3_picks' worker and no area hold.
trainee_rows() {
  local d prof w i k projects=() order
  d=$(mktemp -d) || return 1
  # One board read: the projects' order, and each row's full brief (row_item), which a row's own
  # .details carries only up to DISPATCH_DETAIL_CHARS. Without it no row can be judged as promote
  # would queue it, so a failed read fails the walk.
  notes board --json >"$d/board" 2>/dev/null || { echo "fleet-dispatch: trainee_rows: notes board --json failed" >&2; rm -rf "$d"; return 1; }
  # Both walks go one row at a time, so each runs once per project (ONLY_PROJECT), up to 8 at once,
  # the biggest board first. Whole-board, the two took 157 of trainee-pool's 172 s, past fleet-bench's
  # BENCH_TRAINEE_CMD timeout, agent-runtime's 1,409 agent rows the long pole (2026-11-23, ar-3988).
  # The gates are read once, before the walks fork: each walk read them itself, about 18 s each.
  # Each walk writes its own file: a row line can pass PIPE_BUF, so one pipe could tear it.
  # The board extras too (load_extras, and with them the gates): each walk read the whole board again
  # for them, 36 reads a pass (ar-4512). The forked walks see these locals, and so load none.
  local -A DET=() PLN=() PAR=() RNK=() GAT=() RLD=()
  load_extras
  mapfile -t projects < <(for prof in $DISPATCH_PROFILES; do notes --profile "$prof" projects 2>/dev/null | cut -f1; done | awk 'NF && !seen[$0]++')
  order=$(jq -r '[.rows[]? | select(.state == "open") | .project] as $r
    | $ARGS.positional | to_entries | sort_by(.value as $p | [-($r | map(select(. == $p)) | length), .key]) | .[].value' "$d/board" --args "${projects[@]}" 2>/dev/null) &&
    [ -n "$order" ] || order=$(printf '%s\n' "${projects[@]}")
  mapfile -t projects <<<"$order"
  w=$(nproc 2>/dev/null || echo 1); [ "$w" -le 8 ] || w=8
  # In a subshell, so wait -n waits on these walks alone, never on a job of the caller's.
  (
    n=0
    for i in "${!projects[@]}"; do
      [ -n "${projects[$i]}" ] || continue
      for k in t3 open; do
        if [ "$n" -ge "$w" ]; then wait -n; n=$((n - 1)); fi
        if [ "$k" = t3 ]; then
          { ONLY_PROJECT=${projects[$i]} t3_rows '' | jq -c '. + {worker: "tier3", t3rank: [.rank, .prio, (0 - .order)]}' >"$d/t3.$i" || : >"$d/failed"; } &
        else
          { ONLY_PROJECT=${projects[$i]} all_open >"$d/open.$i" || : >"$d/failed"; } &
        fi
        n=$((n + 1))
      done
    done
    wait
  )
  [ ! -e "$d/failed" ] || { echo "fleet-dispatch: trainee_rows: a board walk failed" >&2; rm -rf "$d"; return 1; }
  for i in "${!projects[@]}"; do cat "$d/t3.$i" 2>/dev/null; done >"$d/t3"
  for i in "${!projects[@]}"; do cat "$d/open.$i" 2>/dev/null; done >"$d/open"
  # t3 first: unique_by keeps a row's first copy, and a tier-3 row's copy carries its worker.
  jq -sc --arg today "${DISPATCH_TODAY:-$(date +%F)}" --argjson prules "$(policy_rules)" --argjson games "$(cat "$d/t3" "$d/open" | game_areas)" \
    --argjson busy "$(queue_areas | jq -Rsc 'split("\n") | map(select(length > 0) | ascii_downcase)')" \
    --slurpfile v <(latest_verdicts) --slurpfile b "$d/board" "$RANK_JQ$ROW_JQ"'
    ($v | map({key: ([.project, .lane, .key] | tostring), value: .}) | from_entries) as $by
    | ($b[0].rows // [] | map(select(.id != null) | {key: ([.project, .lane, .id] | tostring), value: ((.details // []) | join("\n"))}) | from_entries) as $briefs
    | map(select(.lane == "agent") | . as $c | $by[[.project, .lane, .key] | tostring] as $d
      | select($d == null or ($d.verdict != "failed" and ($c.gated == true or $d.verdict != "skip"
          or (($d | usable($prules)) and ($d | holds($c))) == false)))
      | . + {area: row_area($d; $games), brief: ($briefs[[.project, .lane, .key] | tostring] // "")}
      | select(.area == "" or .worker == "tier3" or ("\(.project | ascii_downcase)/\(.area)" as $a | $busy | index($a) | not))
      | if .pprio == null then rank_fields($today; .project_prio // "") else . end)
    | unique_by([.project, .key]) | rank | .[]' "$d/t3" "$d/open"
  rm -rf "$d"
}

# cmd_trainee_pool [--json] -- what the trainee floor draws from (trainee_rows, the floor's own read),
# how many a trainee takes, and how many each refusal turns away of the rest, by the checks the
# floor runs (trainee_row_why). One refusal a row, the first. Then per trainee source its slots (the
# source's cap and what it is computed from, claude-acct room --json), how many are busy (every item live
# on it, canaries too) and the next row each of its harnesses takes: the queued item trainee_queued_pick
# gives it, else the board row trainee_board_pick does, each taken off the lists as the floor does.
cmd_trainee_pool() {
  local hs=() row why n ok lines dir w f i pids=() eligible queued h it nexts=() srcs rooms
  trainee_load; load_kinds
  mapfile -t hs < <(jq -r '[.candidates[]?.harness] | unique[]' <<<"$TRAINEE_CONF")
  dir=$(mktemp -d) || return 1
  trainee_rows >"$dir/rows" || { rm -rf "$dir"; return 1; }
  sed -i '/^$/d' "$dir/rows"
  n=$(wc -l <"$dir/rows")
  # Each row's verdict stands alone, so the rows split over up to 8 cores: about 80 ms a row, and
  # 1,298 rows one at a time took 100 s, past fleet-bench's BENCH_TRAINEE_CMD timeout (2026-11-19).
  # Each row carries its rank, so the ones a trainee takes come back in board order for the next-row pick.
  w=$(nproc 2>/dev/null || echo 1); [ "$w" -le 8 ] || w=8
  awk '{ printf "%d\t%s\n", NR, $0 }' "$dir/rows" | split -n "r/$w" - "$dir/part."
  for f in "$dir"/part.*; do
    while IFS=$'\t' read -r i row; do
      if why=$(trainee_row_why "$row" "${hs[@]}"); then echo ok; printf '%s\t%s\n' "$i" "$row" >>"$f.ok"
      else trainee_reason_key "$why"; fi
    done <"$f" >"$f.out" &
    pids+=("$!")
  done
  [ "${#pids[@]}" = 0 ] || wait "${pids[@]}"
  ok=$(cat "$dir"/part.*.out 2>/dev/null | grep -cx ok) || true
  lines=$(cat "$dir"/part.*.out 2>/dev/null | grep -vx ok | grep . | sort | uniq -c | sort -rn | awk '{c=$1; $1=""; sub(/^ /,""); printf "%s\t%s\n", c, $0}') || true
  eligible=$(cat "$dir"/part.*.ok 2>/dev/null | sort -n | cut -f2-) || true
  rm -rf "$dir"
  queued=$(next_items --points)
  for h in "${hs[@]}"; do
    if it=$(trainee_queued_pick "$h" "$queued") && [ -n "$it" ]; then
      nexts+=("$(jq -c --arg h "$h" '{harness: $h, from: "queue", id: .slug, project, title}' <<<"$it")")
      queued=$(jq -c --arg s "$(jq -r .slug <<<"$it")" 'select(.slug != $s)' <<<"$queued")
    elif it=$(trainee_board_pick "$h" "$eligible") && [ -n "$it" ]; then
      nexts+=("$(jq -c --arg h "$h" '{harness: $h, from: "board", id: .key, project, title: (.text | sub("^- \\[.\\] "; ""))}' <<<"$it")")
      eligible=$(jq -c --arg k "$(jq -r .key <<<"$it")" --arg p "$(jq -r .project <<<"$it")" 'select(.key != $k or .project != $p)' <<<"$eligible")
    else nexts+=("$(jq -nc --arg h "$h" '{harness: $h, from: null}')"); fi
  done
  # The floor's own gate, read now: shut with its reason, or open. Its
  # room read (ACCT_ROWS), when it made one, gives the sources their slots; room --json exits 1 with no
  # account to pick, its answer still whole, so only an unreadable answer leaves the slots unknown.
  rooms=${ACCT_ROWS:-$(claude-acct room --json 2>/dev/null)}
  jq -e '.sources | type == "array"' <<<"$rooms" >/dev/null 2>&1 ||
    { echo "trainee pool: claude-acct room --json gave no answer, so no source shows its slots" >&2; rooms=null; }
  trainee_floor_why
  local floor=open floor_why=$FLOOR_WHY
  [ -z "$floor_why" ] || floor=shut
  srcs=$(printf '%s\n' "${nexts[@]}" | jq -sc --slurpfile H "$HARNESSES" --argjson rooms "$rooms" '
    group_by($H[0].harnesses[.harness].source // "")
    | map((.[0].harness | $H[0].harnesses[.].source // "") as $s | ($rooms.sources // [] | map(select(.name == $s)) | first) as $r
      | {name: (if $s == "" then null else $s end), slots: ($r.max_live // null), basis: ($r.max_live_basis // null),
         busy: ($r.live // null), room: ($r.room.ok // null), why: ($r.room.why // (if $s == "" then "the harness names no source" else "claude-acct room --json has no source \($s)" end)),
         next: .})')
  [[ "$srcs" == \[* ]] || srcs='[]'
  if [ "${1:-}" = --json ]; then
    jq -nc --argjson rows "$n" --argjson eligible "$ok" --arg l "$lines" --arg fs "$floor" --arg fw "$floor_why" --argjson srcs "$srcs" \
      '{rows: $rows, eligible: $eligible, floor: {state: $fs, why: $fw},
        refused: [$l | split("\n")[] | select(. != "") | split("\t") | {count: (.[0] | tonumber), why: .[1]}], sources: $srcs}'
    return 0
  fi
  echo "trainee pool: $ok of $n open agent-board rows (the ones the floor sees) are ones a trainee takes (harnesses: ${hs[*]:-none})"
  [ -z "$lines" ] || awk -F'\t' '{printf "  %4d  %s\n", $1, $2}' <<<"$lines"
  echo "trainee floor: $floor${floor_why:+, $floor_why}"
  jq -r '.[] | "source \(.name // "-"): \(if .slots then "\(.slots) slots (\(.basis))" else "no slot cap" end), \(.busy // "?") busy, \(if .room then "open" else "shut, \(.why)" end)",
    (.next[] | "  \(.harness) next: \(if .from == null then "none it takes" else "\(.from) \(.project) \(.id): \(.title | .[0:80])" end)")' <<<"$srcs"
}

# row_item <candidate row> -> the queue item promote would make of it, as trainee_why reads one: its id
# the slug, its words then its full brief (trainee_rows' .brief, the detail lines promote copies) the
# task, and fill_day's cleanup and tier<N> tags. Judged on the words alone, a row whose brief named
# ~/.agent/outcomes was promoted for ocfree and then refused at start (ar-2488, 2026-11-23). A plan
# row's brief names its plan, outside the repo, so it is refused too: promote would queue its phase
# chain under other slugs, never the one item the floor starts. A row with no id gets no brief, as in promote.
row_item() {
  jq -c '(.text | sub("^- \\[.\\] "; "")) as $t | {slug: .key, project, title: $t, task: ($t + (if (.brief // "") != "" then "\n" + .brief else "" end)), mode: "",
    tags: ([if .cleanup == 0 then "cleanup" else empty end, if .tier then "tier\(.tier)" else empty end] | join(" "))}' <<<"$1"
}

# trainee_batch_start -- file and start one review of every waiting diff (trainee_waiting) once lanes.yaml
# trainee `review_batch` of them wait (1 by default: each as it comes), one waits while a trainee holds
# its max_waiting diffs, or the oldest has waited DISPATCH_TRAINEE_REVIEW_HOURS since it moved to review, so
# no slot and no diff stalls on a short batch: state read each pass, no timer. No other is filed while a
# batch item is open, nor while a trainee PR's owner runs (trainee_review_live). A batch item still
# queued (its start failed, say no account had room) is started here again each pass, never left to the
# normal queue, whose cap would hold it behind the pace target. Its brief is made from
# the waiting patches as it is filed (trainee_batch_task); it runs on claude at the reviewer lane's model
# while an account has room, else on lanes.yaml trainee `reviewer_fallback` (trainee_reviewer_pin, asked
# again each pass it is started). Rc FLOOR_SHUT when none is due.
trainee_batch_start() {
  local waiting n want max full='' h open slug model live oldest age=-1 aged why='' batch
  waiting=$(trainee_waiting); n=$(grep -c . <<<"$waiting" || true)
  [ "$n" -gt 0 ] || return "$FLOOR_SHUT"
  batch=$(agent-queue list --json --points --state active 2>/dev/null | jq -c 'select((" " + (.tags // "") + " ") | contains(" trainee-batch "))')
  if [ -n "$batch" ] && jq -se 'any(.[]; .state != "queued")' <<<"$batch" >/dev/null; then
    say "trainee floor: $n diff(s) wait for the batch review already open"; return "$FLOOR_SHUT"
  fi
  live=$(trainee_review_live)
  [ -z "$live" ] || { say "trainee floor: $n diff(s) wait while $live, the trainee review running, finishes"; return "$FLOOR_SHUT"; }
  if [ -n "$batch" ]; then
    batch=$(head -n 1 <<<"$batch"); slug=$(jq -r .slug <<<"$batch")
    if [ "$DRY" = 1 ]; then say "trainee floor: would start $slug, the batch review still queued"; return "$FLOOR_SHUT"; fi
    local before=${STARTED:-0} rc
    # Started as the pin leaves it: the item read above predates it.
    trainee_reviewer_pin "$slug" && batch=$(agent-queue show "$slug" --json --points) ||
      { say "trainee floor: could not pin $slug to its reviewer"; return 1; }
    BATCH_PASS=1 FLOOR_QUIET=1 UNITS_FREE=2 start_items "$batch" 1; rc=$?
    [ "${STARTED:-0}" -gt "$before" ] || say "trainee floor: $slug, the batch review still queued, did not start this pass"
    return "$rc"
  fi
  want=$(jq -r '.review_batch // 1' <<<"$TRAINEE_CONF"); max=$(jq -r '.max_waiting // 2' <<<"$TRAINEE_CONF")
  for h in $(jq -r '[.candidates[]?.harness] | unique[]' <<<"$TRAINEE_CONF"); do
    open=$(ladder_counts "$h") && [ "$open" -ge "$max" ] && { full=$h; break; }
  done
  oldest=$(jq -sr 'map(.review // empty) | min // empty' <<<"$waiting")
  [ -z "$oldest" ] || { oldest=$(date -d "$oldest" +%s 2>/dev/null) && age=$(( ($(date +%s) - oldest) / 3600 )); }
  [ "$age" -ge 0 ] && aged="${age}h" || aged=unknown
  if [ -n "$full" ]; then why=", as $full holds its max_waiting diffs"
  elif [ "$n" -lt "$want" ] && [ "$DISPATCH_TRAINEE_REVIEW_HOURS" -gt 0 ] && [ "$age" -ge "$DISPATCH_TRAINEE_REVIEW_HOURS" ]; then
    why=", as the oldest has waited ${age}h (DISPATCH_TRAINEE_REVIEW_HOURS=$DISPATCH_TRAINEE_REVIEW_HOURS)"
  fi
  [ "$n" -ge "$want" ] || [ -n "$why" ] ||
    { say "trainee floor: $n of review_batch $want diffs wait, the oldest $aged of DISPATCH_TRAINEE_REVIEW_HOURS=$DISPATCH_TRAINEE_REVIEW_HOURS, and no trainee holds its max_waiting diffs"; return "$FLOOR_SHUT"; }
  model=$(jq -r '.reviewer_model // empty' <<<"$TRAINEE_CONF")
  [ -n "$model" ] || { say "trainee floor: $n diff(s) wait, and lanes.yaml names no trainee reviewer"; return "$FLOOR_SHUT"; }
  slug="trainee-batch-$(date +%Y%m%d-%H%M%S)"
  if [ "$DRY" = 1 ]; then say "trainee floor: would file and start $slug, a review of $n diff(s)"; return "$FLOOR_SHUT"; fi
  AGENT_QUEUE_PULL=dispatch AGENT_QUEUE_START=0 agent-queue add --from trainee --project "$(head -n 1 <<<"$waiting" | jq -r .project)" --priority high \
    --tags "trainee-review trainee-batch tier1" --slug "$slug" -- "$(trainee_batch_task "$slug" "$waiting")" >/dev/null &&
    trainee_reviewer_pin "$slug" || { say "trainee floor: could not file $slug"; return 1; }
  say "trainee floor: $slug reviews $n diff(s)$why"
  BATCH_PASS=1 FLOOR_QUIET=1 UNITS_FREE=2 start_items "$(agent-queue show "$slug" --json --points)" 1
}

# trainee_reviewer_pin <batch slug> -- pin the batch review to the harness that reviews it this pass:
# claude at the reviewer lane's model while an account has room (acct_room, the answer start_item gets),
# else lanes.yaml trainee `reviewer_fallback` (codex:sol), so a spent Claude week stalls neither the
# review nor the trainee slots its waiting diffs hold (plan trainee-steady-queue P4). Unreadable usage
# (acct_room rc 2) stays on claude, since start_item holds every start then. With no fallback it stays on
# claude and waits for room, as before. `routed=` is cleared, so item_pinned reads the pin as one.
trainee_reviewer_pin() {
  local slug=$1 h=claude m fb ACCT_ROWS='' ACCT_DIR='' ACCT_WHY='' ACCT_PAST_PACE=0 rc=0
  m=$(jq -r '.reviewer_model // empty' <<<"$TRAINEE_CONF")
  fb=$(jq -r '.reviewer_fallback // empty | select(.harness and .model) | "\(.harness):\(.model)"' <<<"$TRAINEE_CONF" 2>/dev/null)
  if [ -n "$fb" ]; then
    acct_room || rc=$?
    if [ "$rc" = 1 ]; then
      h=${fb%%:*} m=${fb#*:}
      say "trainee floor: $slug, the batch review, goes to $h ($m), lanes.yaml trainee reviewer_fallback: no Claude account has room (${ACCT_WHY:-no reason given})"
    fi
  fi
  agent-queue set "$slug" "agent=$h" "model=$m" routed= >/dev/null
}

# trainee_review_live -> the slug of the trainee review session running now, or nothing: a batch review,
# or the lander or fix-ci session of a trainee's PR (own_parked_pr stamps its pr_owner). The trainee
# floor runs one at a time past the pace target, so Claude spends at most one session on trainee output.
trainee_review_live() {
  agent-queue list --json --state running 2>/dev/null |
    jq -rn 'first(inputs | select(((" " + (.tags // "") + " ") | contains(" trainee-batch ")) or ((.trainee // "") != "" and (.pr_owner // "") != ""))) | .slug'
  return 0
}

# trainee_land_items -> the queued lander and fix-ci items of trainee PRs, one json line each.
trainee_land_items() {
  agent-queue list --json --points --state queued 2>/dev/null | jq -c 'select((.trainee // "") != "" and (.pr_owner // "") != "" and (.pr // "") != "")'
}

# trainee_land_start -- start one queued lander or fix-ci session of a trainee's PR, the first no
# finding holds (own_parked_pr requeued it, past the queue cap), on the trainee floor, past the pace target as the batch review is,
# while no trainee review runs (trainee_review_live): #2639, a green trainee PR, waited a day behind the
# cap and the target, and no trainee run counts until its PR lands. Rc FLOOR_SHUT when none starts.
trainee_land_start() {
  local items live
  items=$(trainee_land_items)
  [ -n "$items" ] || return "$FLOOR_SHUT"
  live=$(trainee_review_live)
  [ -z "$live" ] || { say "trainee floor: $(grep -c . <<<"$items") trainee PR session(s) wait while $live, the trainee review running, finishes"; return "$FLOOR_SHUT"; }
  BATCH_PASS=1 FLOOR_QUIET=1 UNITS_FREE=2 start_items "$items" 1
}

# run_queue <item json lines> <room> -- start up to <room> queued items nothing holds. The machine-wide
# gates are asked once: presence is none of them, and a board-filled item starts under them as the
# human's own items do. A finding
# holds only the items it is about (pick_item), so a starved unity pool never stops a dotfiles item.
# A runnable item left waiting is BLOCKED, not NOOP: on 11-03 a gate held every pass for 7.5h and
# each one published NOOP, which every dashboard showed green. A dispatch hold is BLOCKED the same way.
run_queue() {
  local items="$1" head why
  head=$(head -n 1 <<<"$items")
  why=$(gate)
  if [ -n "$why" ]; then
    RUN_GATED=1
    # A red the machine gates hold may still start on the red floor; then no other red starts this pass,
    # a tripped watch's first, so the floor slot its item adds is not taken by another red.
    # Its start goes past those gates without proving them open, so the hold stands (start_item).
    # Else the human's urgent items go past the weekly pace alone. Then, with the room left, a class
    # under its min_live fills its gap past the weekly pace alone; the rest of the queue stays held.
    local reds='' frc before=${STARTED:-0}; is_red "$head" && reds=$(red_items "$items")
    if red_floor_due "$reds"; then
      # A floor that started nothing has settled its own verdict (a full fleet is NOOP), so it ends the pass.
      red_floor_start "$reds" "$2" "$why"; frc=$?
      [ "$frc" = 0 ] && [ "${STARTED:-0}" -gt "$before" ] || return "$frc"
    else
      human_floor_start "$items" "$2" "$why"; frc=$?
      [ "$frc" = "$FLOOR_SHUT" ] || return "$frc"
    fi
    short_floor_start "$items" $(( $2 - ${STARTED:-0} + before )) "$why"; frc=$?
    [ "$frc" = "$FLOOR_SHUT" ] || return "$frc"
    [ "${STARTED:-0}" -eq "$before" ] || return 0
    settle BLOCKED "$why, queue item $(jq -r .slug <<<"$head") waits"
    [ "$DRY" = 1 ] || return 0
  fi
  start_items "$(pass_order "$items")" "$2"
}

# short_floor_start <item json lines> <room> <why> -- start the short items among them (short_item) past
# <why>, the gates that held the pass, once nothing but the weekly pace holds them (short_floor_open);
# the hold stands (start_item). Rc FLOOR_SHUT when there is no room, none is short or another gate holds.
short_floor_start() {
  local short rc
  [ "${2:-0}" -gt 0 ] || return "$FLOOR_SHUT"
  short=$(jq -c 'select(.short == true)' <<<"$1" 2>/dev/null)
  [ -n "$short" ] && [ -z "$(SHORT_PASS=1 gate)" ] || return "$FLOOR_SHUT"
  say "$3; the items of a class under its classes.json min_live start past the weekly pace"
  SHORT_PASS=1 FLOOR_GATE=$3; start_items "$short" "$2"; rc=$?
  SHORT_PASS=0 FLOOR_GATE=''
  return "$rc"
}

# start_items <item json lines> <room> -- past the pass's gate: start up to <room> items in
# queue order, each the first no finding holds. Every start after the first reads the gate again, so
# one pass cannot stack Unity runs past the load pace. Only a stop before anything started
# is settled; a later one is said, so a pass that started a session still publishes WORKED.
start_items() {
  local items="$1" room="$2" n=0 taken=0 why rc
  while [ "$n" -lt "$room" ] && [ -n "$items" ]; do
    if [ "$n" -gt 0 ]; then
      why=$(gate)
      [ -z "$why" ] || { say "$why, the pass stops after $n started"; return 0; }
    fi
    if ! pick_item "$items" && ! preempt_pick; then
      # Every item too heavy for the units left is a full fleet, not a block: NOOP, as cmd_run says.
      if [ "$n" -gt 0 ] || [ "${FLOOR_QUIET:-0}" = 1 ]; then say "$PICK_WHY"
      elif [ "$PICK_FULL" = 1 ]; then settle NOOP "$PICK_WHY"
      # A full fleet share holds by design: cmd_run goes on to the board for another project's
      # row, and a pass that starts none is NOOP, the hold named, never the BLOCKED fleet-liveness reads as a stall.
      elif [ "${PICK_WHY#fleet share full}" != "$PICK_WHY" ]; then
        if [ "${HELD_FALLS_THROUGH:-0}" = 1 ]; then SHARE_HELD=$PICK_WHY; say "$PICK_WHY"; else settle NOOP "$PICK_WHY"; fi
      # cmd_run goes on to the board and settles the pass there, BLOCKED by this unless a row starts.
      elif [ "${HELD_FALLS_THROUGH:-0}" = 1 ] && [ "${FIRING+set}" = set ]; then QUEUE_HELD=$PICK_WHY; say "$PICK_WHY"
      else settle BLOCKED "$PICK_WHY"; fi
      return 0
    fi
    start_item "$PICKED"; rc=$?
    case "$rc" in 0 | 4 | 5) ;; 3) return 0 ;; *) return "$rc" ;; esac
    items=$(jq -c --arg s "$(jq -r .slug <<<"$PICKED")" 'select(.slug != $s)' <<<"$items")
    [ "$rc" -ne 5 ] || continue
    [ "$rc" -eq 0 ] && STARTED=$(( ${STARTED:-0} + 1 )) && share_count "$PICKED"
    [ "$rc" -eq 0 ] && [ -n "${PICK_PPASS:-}" ] && POOL_PASSED=1   # pool_pass: spent only by a start
    [ "$rc" -eq 0 ] && is_red "$PICKED" && RED_STARTED=$(( ${RED_STARTED:-0} + 1 ))
    # Any approved plan phase a start of this pass took, by any path, counts toward the plan load floor (live_plans' test).
    [ "$rc" -eq 0 ] && jq -e '(.plan // "") != "" and (.from // "human") == "human"' <<<"$PICKED" >/dev/null 2>&1 && PLAN_STARTED=$(( ${PLAN_STARTED:-0} + 1 ))
    if [ "$rc" -eq 0 ] && [ "${HUMAN_PASS:-0}" = 1 ]; then
      local plan; plan=$(jq -r '.plan // ""' <<<"$PICKED")
      [ -z "$plan" ] || PLANS_STARTED="${PLANS_STARTED:+$PLANS_STARTED$'\n'}$plan"
    fi
    if [ "$rc" -eq 0 ] && [ -n "$PLACE_HOST" ]; then HOST_FREE[$PLACE_HOST]=$(( HOST_FREE[$PLACE_HOST] - 1 ))
    elif [ "$rc" -eq 0 ]; then UNITS_FREE=$(( UNITS_FREE - $(weight_units "$(jq -r '.weight // "light"' <<<"$PICKED")") ))
    fi
    [ "$rc" -eq 4 ] && taken=$((taken + 1)) || n=$((n + 1))
  done
  # No item it tried had a source with room it may run on: held, so BLOCKED, naming what it tried.
  if [ "$n" -eq 0 ] && [ "$taken" -eq 0 ] && [ "${#NO_ROUTE[@]}" -gt 0 ] && [ "${SPRINT_PASS:-0}${TRAINEE_PASS:-0}${BATCH_PASS:-0}${OTHER_PASS:-0}" = 0000 ]; then
    why=$(printf '%s, ' "${NO_ROUTE[@]:0:3}")
    [ "${#NO_ROUTE[@]}" -le 3 ] || why="$why$(( ${#NO_ROUTE[@]} - 3 )) more, "
    settle BLOCKED "${NO_ROOM:+$NO_ROOM, and }no queue item has a source with room it may run on: ${why%, }"
    return 0
  fi
  # Every item this pass picked was started by someone else: the work moved, nothing failed.
  [ "$n" -gt 0 ] || [ "$taken" -eq 0 ] || [ "${SPRINT_PASS:-0}${TRAINEE_PASS:-0}${BATCH_PASS:-0}${OTHER_PASS:-0}" != 0000 ] || settle NOOP "another start took the $taken queue item(s) this pass picked"
  [ "$n" -gt 0 ] && [ -n "$items" ] || return 0
  # A limit, not the machine, stopped the pass: say which, so the human can raise it (headroom).
  # Not on a floor past a full fleet: the pace target already holds the rest, by design.
  [ "${FLOOR_QUIET:-0}" = 0 ] || return 0
  why=$(gate)
  [ -z "$why" ] || return 0
  local limit="the $TARGET_WHEN pace target $TARGET"; [ "$PER_PASS" -gt 0 ] && [ "$room" -ge "$PER_PASS" ] && limit=DISPATCH_PER_PASS
  settle WORKED "under-used: started $n, $limit is the limit while $(grep -c . <<<"$items") runnable wait and the gates are open (fleet-dispatch headroom)"
  [ "$DRY" = 1 ] || logline "under-used: started $n, $limit is the limit, $(grep -c . <<<"$items") runnable left"
  return 0
}

# next_items -> the queued items a pass may try, in agent-queue's order (red, urgent, project rank, priority, then the class mix and age),
# one JSON object a line, whatever harness each runs on: start_item routes it to a source with room.
# With --points each carries its board row's points, which a trainee reads (item_points): every caller
# that feeds a start passes it, and a count does not, so it pays no board read.
next_items() {
  runnable "$@" 2>/dev/null
  return 0
}

# load_findings -- FIRING is the findings firing now, read once a pass; rc 1 when they cannot be
# read, which holds every item.
load_findings() {
  [ "${FIRING+set}" = set ] && return 0
  local f
  f=$(fleet-bench findings --json 2>/dev/null) && f=$(firing_findings <<<"$f") || return 1
  FIRING=$f
}

# pick_item <item json lines> -- PICKED is the first item that has a place and no firing finding
# holds, except that the first urgent item or fresh ask (runs_now) waiting only on run units (PICK_RESERVED, which
# preempt_pick may make room for) keeps the free ones: a later item that would use them waits too. Rc 1 with the reason in PICK_WHY when every one is held, or the findings cannot be read.
# PICK_NOTE names the items ahead of PICKED that the fleet share cap held (share_why), so the start's
# activity.log line shows the hold firing, or that the cap let PICKED go. The cap never lets go onto
# this machine's units while an item it does not hold waits on them (uheld).
# The place is this machine while the item fits in UNITS_FREE and, when there are fleet workers to
# go to, its own pace is open (machine_why); else the first worker that takes it (place_host), in
# PLACE_HOST. A canary item goes to a worker whose fleet_first names its class ahead of
# this machine (place_host first): the dispatcher keeps its own units for the human and plain work.
# PICK_FULL is 1 when units alone held them all. On a floor pass the items are only the
# floor's, so PICK_WHY says so and names the gate (FLOOR_GATE) the rest of the queue waits on: on
# 2026-11-07 "starved pool:unity ... every queue item waits" stood for 2 unity items of an idle
# project while the other 40 waited on account pace, which the message never named.
pick_item() {
  local items="$1" it why need free host mwhy='' mread=0 fhit=0 uwait=0 held=() waits="every queue item waits" reserved='' kept=''
  local shold=0 sfirst='' shost='' swhy='' mhit=0 ppass='' uheld='' uneed=0 chit=0 cread=0 cwords=''
  share_state   # in this shell, so every share_why reads one count
  if [ "${RED_PASS:-0}" = 1 ]; then waits="every red item waits; the rest wait on ${FLOOR_GATE:-the gate}"
  elif [ "${TRAINEE_PASS:-0}${BATCH_PASS:-0}" != 00 ]; then waits="the trainee floor's item waits"; fi
  PICKED='' PICK_WHY='' PICK_FULL=1 PLACE_HOST='' PICK_RESERVED='' PICK_NOTE='' PICK_PPASS=''
  load_findings || { PICK_WHY="fleet-bench findings unreadable"; PICK_FULL=0; return 1; }
  free=${UNITS_FREE:-$TARGET}
  while IFS= read -r it; do
    [ -n "$it" ] || continue
    need=$(weight_units "$(jq -r '.weight // "light"' <<<"$it")")
    host='' why='' uwait=0
    # With no fleet worker the gate read this machine's pace, except the trainee floor's (TRAINEE_GATE),
    # so a trainee start reads it here either way.
    if host=$(place_host "$it" first); then :
    elif [ "$need" -le "$free" ] && { { [ ${#HOST_PROBE[@]} -eq 0 ] && [ "${TRAINEE_PASS:-0}" = 0 ]; } || { [ "$mread" = 1 ] || { mwhy=$(machine_why); mread=1; }; [ -z "$mwhy" ]; }; }; then :
    elif host=$(place_host "$it"); then :
    elif [ "$need" -gt "$free" ]; then uwait=1; why="$([ "$need" -gt 1 ] && echo heavy || echo light) needs $need run units, $free free"
    else why="$mwhy, and no fleet worker takes it"; PICK_FULL=0 mhit=1
    fi
    ppass=''
    # Cluster work waits while the k3s domain is red or unreadable, read once a pick; nothing else does.
    if [ -z "$why" ] && cluster_item "$it"; then
      [ "$cread" = 1 ] || { cwords=$(fleet-shepherd infra 2>/dev/null); cread=1; }
      [ -z "$cwords" ] || { why="$cwords, and this is cluster work (DISPATCH_CLUSTER_PROJECTS)"; PICK_FULL=0 chit=1; }
    fi
    if [ -z "$why" ]; then
      why=$(held_by "$it" "$FIRING")
      if pool_pass "$it" "$why"; then ppass=$why why=''; fi
      [ -z "$why" ] || { PICK_FULL=0; fhit=1; }
    fi
    if [ -z "$why" ]; then
      why=$(share_why "$it")
      [ -z "$why" ] || { PICK_FULL=0; shold=$(( shold + 1 )); [ -n "$sfirst" ] || { sfirst=$it shost=$host swhy=$why; }; }
    fi
    # The first urgent item or fresh ask (runs_now) that waits only on units, and could fit them all,
    # keeps the free ones: a later item that would use them waits too, or a stream of light items starves a heavy one.
    if [ -n "$reserved" ] && [ -z "$why" ] && [ -z "$host" ] && ! runs_now "$it"; then
      why="the $free free run units wait for $(runs_now_label "$PICK_RESERVED") $reserved"
    elif [ -n "$kept" ] && [ -z "$why" ] && [ -z "$host" ] && ! runs_now "$it" && ! short_item "$it"; then
      why="the $free free run units wait for $kept, its class under min_live"
    elif [ -z "$reserved" ] && [ "$uwait" = 1 ] && [ "$need" -le "$TARGET" ] && runs_now "$it" && [ -z "$(finding_hold "$it")" ]; then
      reserved=$(jq -r .slug <<<"$it") PICK_RESERVED=$it
    elif [ -z "$kept" ] && [ "$uwait" = 1 ] && [ "$need" -le "$TARGET" ] && short_item "$it" && [ -z "$(finding_hold "$it")" ] && [ -z "$(share_why "$it")" ]; then
      kept=$(jq -r .slug <<<"$it")
    fi
    # The first item the share does not hold that waits only on run units it could fit: the share's
    # let-go leaves those units to it. Without this a light fleet item took the one free unit each pass
    # while heavy Unity items waited for two: 86 of 124 fleet Claude starts in 24h to 2026-11-23 went
    # out on the let-go, all 77 local ones with other projects' heavy items queued (ar-4499).
    if [ "${SHARE_LET_GO:-0}" = 1 ] && [ -z "$uheld" ] && [ "$uwait" = 1 ] && [ "$need" -le "$TARGET" ] && [ -z "$(finding_hold "$it")" ] && [ -z "$(share_why "$it")" ]; then
      uheld=$(jq -r .slug <<<"$it") uneed=$need
    fi
    if [ -z "$why" ]; then
      PICKED=$it PLACE_HOST=$host
      [ "$shold" = 0 ] || PICK_NOTE="; passed $shold item$([ "$shold" = 1 ] || echo s) held by $swhy"
      [ -z "$ppass" ] || { PICK_PPASS=1; PICK_NOTE+="; urgent, it went past the finding $ppass (one a pass)"; }
      return 0
    fi
    [ "$DRY" = 0 ] || say "queue item $(jq -r .slug <<<"$it") waits: $why"
    held+=("$(jq -r .slug <<<"$it") ($why)")
  done <<<"$items"
  # The fleet share cap lets go when nothing else can start: the first item it held takes the place
  # it had, unless the free units wait for a reserved item or one the share does not hold (uheld); a
  # fleet worker's place it takes either way. Only the start after the fill (SHARE_LET_GO) lets go:
  # the queue pass first tops the board up with other projects' rows, and a floor's list is filtered, so a hold there is no proof.
  if [ -n "$sfirst" ] && [ "${SHARE_LET_GO:-0}" = 1 ]; then
    if [ -z "$reserved$uheld" ] || [ -n "$shost" ]; then
      PICKED=$sfirst PLACE_HOST=$shost PICK_NOTE="; the fleet share cap let it go, as nothing else could start ($swhy)"
      return 0
    fi
    # A wait for units is a full fleet (NOOP), as when units alone hold every item; with a finding or
    # load holding another item the ladder below names that instead (ar-4450).
    if [ -n "$uheld" ] && [ "$fhit$mhit" = 00 ]; then
      PICK_FULL=1 PICK_WHY="run units: $uheld needs $uneed, $free free, so the fleet share cap does not let $(jq -r .slug <<<"$sfirst") go to them; $(printf '%s, ' "${held[@]:0:3}")${held[3]:+$(( ${#held[@]} - 3 )) more, }$waits"
      return 1
    fi
  fi
  if [ "$PICK_FULL" = 1 ]; then PICK_WHY="run units: $(printf '%s, ' "${held[@]:0:3}")${held[3]:+$(( ${#held[@]} - 3 )) more, }$waits"
  elif [ "$fhit" = 1 ]; then PICK_WHY="finding firing: $(printf '%s, ' "${held[@]:0:3}")${held[3]:+$(( ${#held[@]} - 3 )) more, }$waits"
  elif [ "$chit" = 1 ] && [ "$shold$mhit" = 00 ]; then PICK_WHY="cluster: $(printf '%s, ' "${held[@]:0:3}")${held[3]:+$(( ${#held[@]} - 3 )) more, }$waits"
  # The share names the pass only when load held none of the rest: a pass read "fleet share full" and
  # settled NOOP while load held 22 other items (2026-11-21, ar-4450).
  elif [ "$shold" -gt 0 ] && [ "$mhit" = 0 ]; then PICK_WHY="fleet share full: $(printf '%s, ' "${held[@]:0:3}")${held[3]:+$(( ${#held[@]} - 3 )) more, }$waits"
  else PICK_WHY="machine pace: $(printf '%s, ' "${held[@]:0:3}")${held[3]:+$(( ${#held[@]} - 3 )) more, }$waits"; fi
  return 1
}

# --- preempt: an urgent item or fresh ask waiting only on run units takes them from a runner session

# preempt_victims <units> -> "<slug> <server> <session>" for each runner session (`by` dispatch, a
# Claude on this machine, neither urgent nor a fresh ask): those whose weight alone covers <units> run units first, then
# the rest (a heavy urgent item among light sessions takes one a pass, the reserve keeping what each
# frees); within each, lowest priority first, then the newest start. A hand or restored session is
# never one, nor a fleet worker's (park is local), nor another harness's (park exits a Claude), nor
# one preempted in the last DISPATCH_PREEMPT_REST minutes (preempted_lately, in preempt_for).
preempt_victims() {
  agent-queue list --json --state active 2>/dev/null | jq -sr --argjson u "$1" \
    --argjson now "$(date +%s)" --argjson h "$DISPATCH_ASK_FRESH_H" "$ASK_JQ"'
    map(select(.state != "queued" and .by == "dispatch" and (.host // "") == ""
        and (.agent // "claude") == "claude" and (runs_now($now; $h) | not)
        and ((.session // "") | index(":")) != null))
    | sort_by([(if (.weight // "light") == "heavy" then 2 else 1 end) >= $u,
               ({"high": 1, "low": 2}[.priority // "high"] // 1), (.started // "")]) | reverse
    | .[] | (.session | index(":")) as $i | "\(.slug) \(.session[:$i]) \(.session[$i + 1:])"' 2>/dev/null
  return 0
}

# preempted_lately <slug> -- the run log has a preempt park of <slug> in the last
# DISPATCH_PREEMPT_REST minutes. Log lines start "- YYYY-MM-DD HH:MM", so the stamps compare as text.
preempted_lately() {
  [ -f "$LOG" ] && [ "${DISPATCH_PREEMPT_REST:-0}" -gt 0 ] 2>/dev/null || return 1
  local cut last
  cut=$(date -d "-$DISPATCH_PREEMPT_REST min" '+%Y-%m-%d %H:%M')
  last=$(grep -F " preempted $1 (" "$LOG" | tail -n 1 | cut -c3-18)
  [ -n "$last" ] && [[ ! "$last" < "$cut" ]]
}

# preempt_for <item json> -- park one runner session (preempt_victims) so the urgent item or fresh ask fits
# this machine's run units (UNITS_FREE). claude-acct park refuses a session mid-turn, so a busy one
# waits for the next pass and the next one in line is tried now; it never kills a turn. One park a
# pass (PREEMPTED). A dry run names the victim it would park and parks nothing. Rc 0 once one is parked.
preempt_for() {
  [ "$DISPATCH_PREEMPT" = 1 ] && [ "${PREEMPTED:-0}" = 0 ] || return 1
  local slug need free v server sess out tried=0 kind
  slug=$(jq -r .slug <<<"$1") kind=$(runs_now_label "$1")
  need=$(weight_units "$(jq -r '.weight // "light"' <<<"$1")")
  free=${UNITS_FREE:-0}; [ "$free" -ge 0 ] || free=0
  [ "$need" -gt "$free" ] || return 1
  while read -r v server sess; do
    [ -n "$sess" ] || continue
    ! parked "$sess" && session_live "$sess" "$server" || continue
    if preempted_lately "$v"; then say "preempt spares $v: preempted under ${DISPATCH_PREEMPT_REST}m ago"; continue; fi
    tried=1
    if [ "$DRY" = 1 ]; then say "would preempt $v ($server/$sess) for $kind $slug"; return 1; fi
    if out=$(claude-acct park "$server/$sess" --why preempt --for "$slug" 2>&1); then
      PREEMPTED=1
      say "preempted $v ($server/$sess) for $kind $slug"
      logline "preempted $v ($server/$sess) for $kind $slug"
      return 0
    fi
    out=$(tail -n 1 <<<"$out" | sed 's/^claude-acct: park [^ ]*: //')
    say "preempt waits: $v: $out"
    logline "preempt waits: $v: $out"
  done < <(preempt_victims $(( need - free )))
  [ "$DRY" = 1 ] || [ "$tried" = 1 ] || say "preempt: no runner session to park for $kind $slug"
  return 1
}

# preempt_pick -- pick_item left the first urgent item or fresh ask waiting only on run units (PICK_RESERVED):
# park a victim for it (preempt_for), re-read the units, and pick that item alone, so the units the
# park freed go to it and to no item ahead of it. Rc 1, with pick_item's PICK_WHY kept, when nothing parks.
preempt_pick() {
  # Past a full Claude target (OTHER_PASS) claude is refused, so a park would free units no start can use.
  # A park frees units here, so while this machine's own pace holds (the gate let the pass on for an
  # open worker) it would interrupt a session for a start that cannot run here.
  [ "${OTHER_PASS:-0}" = 0 ] && [ -n "${PICK_RESERVED:-}" ] && [ -z "$(machine_why)" ] && preempt_for "$PICK_RESERVED" || return 1
  PREEMPT_PARKED=1
  UNITS_FREE=$(( TARGET - $(live_units) ))
  pick_item "$PICK_RESERVED"
}

# preempt_items -> with preempt on, the runnable urgent items and fresh asks (runs_now) no finding holds and TARGET run units
# can fit, in queue order: what a pass at full run units goes on to pick (preempt_pick) instead of
# stopping there. Rc 1 when the findings cannot be read: it cannot tell.
preempt_items() {
  [ "$DISPATCH_PREEMPT" = 1 ] || return 0
  load_findings || return 1
  local it
  while IFS= read -r it; do
    [ -n "$it" ] && [ -z "$(finding_hold "$it")" ] && printf '%s\n' "$it"
  done < <(next_items --points | jq -c --argjson max "$TARGET" \
    --argjson now "$(date +%s)" --argjson h "$DISPATCH_ASK_FRESH_H" "$ASK_JQ"'
    select(runs_now($now; $h) and (if (.weight // "light") == "heavy" then 2 else 1 end) <= $max)' 2>/dev/null)
  return 0
}

# unpark_preempted -- resume the sessions preempt_for parked (ledger why=preempt), oldest park first,
# while their run units fit and no urgent item or fresh ask waits to preempt (preempt_items, which must read). A
# budget (why=budget), agent (why=park) or human (why=human) park is never this pass's to resume. It runs before a pass picks, so a victim gets
# its units back ahead of any new start; a dispatch hold holds it too.
unpark_preempted() {
  [ "$DISPATCH_PREEMPT" = 1 ] || return 0
  local ledgers f free key sess server w units out items urgent
  ledgers=$(for f in "$PARKED_DIR"/*; do
              [ -f "$f" ] && [ "$(sed -n '/^why=/{s///p;q;}' "$f")" = preempt ] || continue
              printf '%s\t%s\n' "$(sed -n '/^parked=/{s///p;q;}' "$f")" "$f"
            done | sort -n)
  [ -n "$ledgers" ] || return 0
  agent-hold check dispatch >/dev/null 2>&1 || return 0
  urgent=$(preempt_items) && [ -z "$urgent" ] || return 0
  free=$(( TARGET - $(live_units) ))
  items=$(item_sessions)
  while IFS=$'\t' read -r _ f; do
    key=${f##*/}
    sess=$(sed -n '/^session=/{s///p;q;}' "$f"); server=$(sed -n '/^server=/{s///p;q;}' "$f")
    w=$(awk -F'\x1f' -v v="$server" -v s="$sess" '$2 == v && $3 == s { print $8; exit }' <<<"$items")
    units=$(weight_units "${w:-light}")
    [ "$units" -le "$free" ] || break
    if [ "$DRY" = 1 ]; then say "would unpark $key"; free=$(( free - units )); continue; fi
    # A bulk wake: each takes one from the shared budget (wake-pace.sh), the rest wait for a later pass.
    wake_take preempt "$key" || { say "unpark $key waits for the wake budget"; break; }
    if out=$(claude-acct unpark "$key" 2>&1); then
      say "unparked $key"; logline "unparked $key"
    else
      out=$(tail -n 1 <<<"$out"); say "unpark $key failed: $out"; logline "unpark $key failed: $out"; continue
    fi
    free=$(( free - units ))
  done <<<"$ledgers"
  return 0
}

# --- fleet workers (fleet-hosts.sh): where a pass may place a session besides this machine --------

# The roster is fleet_hosts (home-config's inventory, or FLEET_INVENTORY). With none, every pass
# runs as it does with no workers.

# probe_hosts <live_runs> -- one ssh to each placed worker (fleet_place) for its load, its cores,
# whether wt is on its PATH and its agent-queue forwards (an older one would write the queue on the
# worker), its MemAvailable as a whole percent of MemTotal (-1 when it cannot say, so no later field shifts
# into its place), whether its store is in a merge conflict with origin (.sync/conflict: a session
# there cannot push its queue writes), whether ~/.notes is a clone there (without it every notes and
# board command fails and git-sync-notes.service fails CHDIR: razer-laptop, 2026-11-19, ar-3784), and after a "kit" line its
# `fleet-dispatch kit` (claude, codex, opencode, srt), so a worker with no claude still takes an item
# on a harness it has: HOST_PROBE[<name>] is "<load> <cores> <ready 0|1> <mem %> <conflict 0|1> <notes 0|1>", or "unreachable",
# and HOST_KIT[<name>] the kit, empty from an older fleet-dispatch there (no kit verb). HOST_FREE[<name>] is its fleet_max_live less the run units its live sessions hold,
# and start_items takes each start there off it; HOST_RUNS is the runs that count, the given ones and
# each gateway run on a worker (live_runs --gateway). For a worker that lists fleet_harnesses, the same ssh runs
# `fleet-dispatch harness-ready` on them after a "harnesses" line: HOST_HARN[<name>] is the ones it
# runs, space-separated, and HOST_HARN_WHY[<name>] why each other one is not, "; "-joined. Read once a
# pass, before the gates, so every gate and pick in it reads the same numbers: a gate runs in a
# subshell and cannot write back.
HOST_RUNS=''
declare -gA HOST_PROBE=() HOST_FREE=() HOST_HARN=() HOST_HARN_WHY=() HOST_KIT=()   # -g: global when a test sources this inside a function
probe_hosts() {
  local name place max listed bad out h ready why answers
  HOST_PROBE=() HOST_FREE=() HOST_HARN=() HOST_HARN_WHY=() HOST_KIT=() HOST_RUNS="$1"$'\n'"$(live_runs --gateway)"
  fleet_hosts >/dev/null
  while IFS='|' read -r name place max listed bad; do
    [ "$place" = true ] || continue
    HOST_FREE[$name]=$(( max - $(units_on "$name" <<<"$HOST_RUNS") ))
    # shellcheck disable=SC2016,SC2086 # the worker's shell expands these, not this one; listed splits into names
    if out=$(fleet_host_run "$name" sh -c 'cut -d" " -f1 /proc/loadavg; nproc; command -v wt >/dev/null && test -f "$HOME/.agent/.sync/peer" && echo 1 || echo 0; awk '\''/^MemTotal:/ {t = $2} /^MemAvailable:/ {a = $2} END {print t ? int(a * 100 / t) : -1}'\'' /proc/meminfo; test -e "$HOME/.agent/.sync/conflict" && echo 1 || echo 0; test -e "$HOME/.notes/.git" && echo 1 || echo 0; echo kit; fleet-dispatch kit 2>/dev/null || :; [ $# -eq 0 ] || { echo harnesses; fleet-dispatch harness-ready "$@" 2>/dev/null || :; }' _ $listed 2>/dev/null); then
      HOST_PROBE[$name]=$(sed '/^kit$/,$d; /^harnesses$/,$d' <<<"$out" | tr '\n' ' ')
      HOST_KIT[$name]=$(sed '1,/^kit$/d; /^harnesses$/,$d' <<<"$out" | tr '\n' ' ')
      ready='' why=${bad:+"$bad: not a harness name ([a-z0-9-]), so its probe never asks"} answers=$'\n'"$(sed '1,/^harnesses$/d' <<<"$out")"$'\n'
      for h in $listed; do
        case $answers in
          *$'\n'"$h"$'\n'*) ready+="${ready:+ }$h" ;;
          *$'\n'"$h: "*) why+="${why:+; }$(grep -m1 "^$h: " <<<"$answers")" ;;
          *) why+="${why:+; }$h: no answer from its fleet-dispatch harness-ready (an older fleet-dispatch there)" ;;
        esac
      done
      HOST_HARN[$name]=$ready HOST_HARN_WHY[$name]=$why
    else
      HOST_PROBE[$name]=unreachable
    fi
  # '|', not a tab: IFS collapses a run of tabs, so an empty listed would shift bad into it.
  done < <(fleet_hosts | jq -r '(.harnesses // [] | map(tostring)) as $h | [.name, .place, .max_live, ($h | map(select(test("^[a-z0-9][a-z0-9-]*$"))) | join(" ")), ($h | map(select(test("^[a-z0-9][a-z0-9-]*$") | not) | gsub("[|\n]"; "?")) | join(", "))] | map(tostring) | join("|")')
}

# host_runs <name> <harness> -- the harness's launcher is in that worker's kit (probe_hosts), and
# past claude the worker lists the harness in fleet_harnesses and its probe found it ready: a worker
# runs only the harness it has, and a non-Claude one only by assignment. Under DISPATCH_SANDBOX_PROFILE
# the kit needs srt too, so a pass places no item start --host would refuse (host_start_why).
host_runs() {
  host_has "${HOST_KIT[$1]:-}" "$(harness_launcher "$2")" || return 1
  [ -z "$DISPATCH_SANDBOX_PROFILE" ] || host_has "${HOST_KIT[$1]:-}" srt || return 1
  [ "$2" = claude ] || host_has "${HOST_HARN[$1]:-}" "$2"
}

# host_why <name> -> why that worker takes no session now, or nothing. Its pace is this runner's
# (MAX_LOAD) over its own load and cores; its units are its own fleet_max_live.
host_why() {
  local p="${HOST_PROBE[$1]:-}" load cores ready mem conflict notes
  [ -n "$p" ] || { echo "$1 is not placed (fleet_place false, or not in $FLEET_HOSTS_GROUP)"; return; }
  if [ "$p" = unreachable ]; then
    echo "$1 did not answer over ssh"
    return
  fi
  [ "${HOST_FREE[$1]:-0}" -gt 0 ] || { echo "$1 is at its fleet_max_live"; return; }
  read -r load cores ready mem conflict notes <<<"$p"
  [ "$ready" = 1 ] || { echo "$1 has no wt, or a store that is not a peer clone (store-sync join)"; return; }
  [ "${conflict:-0}" = 0 ] || { echo "$1: its store is in a merge conflict with origin (~/.agent/.sync/conflict), so a session's queue writes cannot reach origin: resolve it there (QUEUE.md, Troubleshooting)"; return; }
  # notes is empty only from a probe older than this field, which reads as having a clone.
  [ "${notes:-1}" = 1 ] || { echo "$1 has no ~/.notes clone, so its notes and board commands fail: clone the vault there (notes-sync-bootstrap.sh, NOTES_SYNC_SETUP.md)"; return; }
  [ -n "${HOST_KIT[$1]// /}" ] || { echo "$1 reports no harness it runs (fleet-dispatch kit there: claude with every account signed in, codex, opencode; an older fleet-dispatch has no kit verb: pull its ~/.dotfiles; an unsigned account: fleet-node signin there)"; return; }
  [[ "$mem" =~ ^[0-9]+$ ]] || { echo "$1 did not report its free memory (/proc/meminfo)"; return; }
  [ "$mem" -ge "$DISPATCH_HOST_MEM_MIN_PCT" ] || { echo "$1: ${mem}% memory free is under the ${DISPATCH_HOST_MEM_MIN_PCT}% floor"; return; }
  over_pace "$load" "${cores:-1}" && echo "$1: load $load on $cores cores is over the $MAX_LOAD pace"
  return 0
}

# remote_open -- some fleet worker takes a session now.
remote_open() {
  local n
  for n in "${!HOST_PROBE[@]}"; do [ -n "$(host_why "$n")" ] || return 0; done
  return 1
}

# host_agent <item json> -> the harness a worker would run the item on, or nothing when the item
# stays on this machine by design: heavy, a plan, a red, a cloud-ok or trainee-batch tag, or a thread
# it resumes here. host_takers and unplaced both read it, so the gap report never drifts from placement.
host_agent() {
  local agent
  ! is_red "$1" || return 0
  agent=$(jq -r 'select((.weight // "light") == "light" and (.plan // "") == ""
    and ((" " + (.tags // "") + " ") | (contains(" cloud-ok ") or contains(" trainee-batch ")) | not)) | .agent // "claude"' <<<"$1")
  [ -n "$agent" ] || return 0
  # A trainee floor start runs on the harness the floor chose for it, so the worker must run that one.
  [ "${TRAINEE_PASS:-0}" != 1 ] || [ -z "${TRAINEE_HARNESS:-}" ] || agent=$TRAINEE_HARNESS
  [ -z "$(resume_thread "$1" "$agent")" ] || return 0
  echo "$agent"
}

# host_takers <item json> -> the roster's workers provisioned for this item, one name a line: a
# light item with no plan and no cloud route, in a repo the worker has cloned (fleet_repos), on a
# harness the worker runs (host_runs: its kit, and past claude fleet_harnesses, probed ready). Heavy work (Unity), plans,
# a codex item that resumes its thread (the rollout is in this machine's ~/.codex, item_rollout),
# a trainee batch review (it reads the diffs in this machine's TRAINEE_DIR), a red (its watch state,
# runner logs and units are this lease holder's, and its probe needs this machine's mounts and
# kubeconfig: ar-3613 reached razer-laptop, which has neither; a red canary too, and a red no floor
# starts here waits for this machine) and other harnesses stay here. Roster order. With
# "first", only the workers whose fleet_first names a class of the item, the item's own tags
# canary (is_canary), and trainee for a trainee floor start (TRAINEE_PASS); an item with neither has none.
host_takers() {
  local dir classes=null agent name
  if [ "${2:-}" = first ]; then
    classes=$(jq -c --arg tr "${TRAINEE_PASS:-0}" '(" " + (.tags // "") + " ") as $t
      | [if ($t | contains(" canary ")) then "canary" else empty end, if $tr == "1" then "trainee" else empty end]' <<<"$1")
    [ "$classes" != '[]' ] || return 0
  fi
  agent=$(host_agent "$1"); [ -n "$agent" ] || return 0
  dir=$(repo_dir "$(jq -r .project <<<"$1")"); [ -n "$dir" ] || return 0
  while IFS= read -r name; do
    host_runs "$name" "$agent" || continue
    echo "$name"
  done < <(fleet_hosts | jq -sr --arg d "$dir" --argjson c "$classes" 'map(select(.repos | index($d))
    | select($c == null or any(.first[]?; . as $x | $c | index($x)))) | .[].name')
}

# place_host <item json> [first] -> the first worker host_takers names that takes a session now.
place_host() {
  local name
  [ ${#HOST_PROBE[@]} -gt 0 ] || return 1
  while IFS= read -r name; do
    [ -n "${HOST_PROBE[$name]:-}" ] && [ -z "$(host_why "$name")" ] && { echo "$name"; return 0; }
  done < <(host_takers "$1" "${2:-}")
  return 1
}

# lease_guard <verb> -- rc 0 on the machine that holds the fleet lease. A run pass or a kick goes through the
# gate every singleton unit has (fleet-lease fleet-dispatch), which takes the lease when it is free;
# a verb run by hand only reads it (fleet-lease held), so a hand start never moves the lease.
# Elsewhere <verb> does nothing, not even publish a pass outcome, and says why, with fleet-lease's
# rc: 1 another machine holds it, 2 this machine cannot tell (no remote answered, no holder known,
# or its store is no peer clone).
lease_guard() {
  local line rc
  if [ "$1" = run ] || [ "$1" = kick ]; then line=$(fleet-lease fleet-dispatch 2>&1); else line=$(fleet-lease held 2>&1); fi && return 0
  rc=$?
  say "$1: ${line#fleet-lease: }"
  return "$rc"
}

# stuck_on <worker> -> how many of its Claude items, started over DISPATCH_REAP_GRACE ago, have no
# transcript there for any session id they record. Claude writes <id>.jsonl on its first turn, so one
# with none never got past its start: on 2026-11-18, 27 sat on razer-laptop's first-run screen and
# nothing paged. agent-panel is no witness: it does not check that a transcript exists.
# Nothing when the worker does not answer. stdin: the active queue as `agent-queue list --json`, read once
# for every worker. One find over main's projects dir, which `claude-acct link` shares into every account
# (so a session moved between accounts is still found), plus each account's own for one not linked yet;
# -H follows a start point that is that shared link.
stuck_on() {
  local started acct sids s n=0 rc=0 found items=() names=() dirs=(.claude/projects)
  while IFS=$'\037' read -r started acct sids; do
    past_reap_grace "$started" || continue
    items+=("$sids")
    case "$acct" in '' | main) ;; *) dirs+=("$acct/projects") ;; esac
    for s in $sids; do names+=(-o -name "$s.jsonl"); done
  done < <(jq -r --arg h "$1" '
    select(.host == $h and .state != "queued" and (.agent // "claude") == "claude" and (.sessions // "") != "")
    | [(.started // ""), (.account // ""), .sessions] | join("\u001f")' 2>/dev/null)
  [ ${#items[@]} -gt 0 ] || { echo 0; return 0; }
  mapfile -t dirs < <(printf '%s\n' "${dirs[@]}" | sort -u)
  # A dir missing there is find's rc 1, not an answer missing; 255 is ssh's own.
  found=$(fleet_host_run "$1" find -H "${dirs[@]}" -maxdepth 2 \( "${names[@]:1}" \) -printf '%f\n' 2>/dev/null) || rc=$?
  [ "$rc" -ne 255 ] || return 0
  for sids in "${items[@]}"; do
    for s in $sids; do grep -qxF "$s.jsonl" <<<"$found" && continue 2; done
    n=$(( n + 1 ))
  done
  echo "$n"
}

# cmd_hosts [--json] -- who holds the fleet lease (fleet-lease status), then each worker in the
# roster, as a pass would read it now.
cmd_hosts() {
  local h name rows=() queue
  fleet_roster_fetch
  fleet_hosts >/dev/null
  [ "${1:-}" = --json ] || fleet-lease status 2>&1
  probe_hosts "$(live_runs)"
  queue=$(agent-queue list --json --state active 2>/dev/null)
  while IFS= read -r h; do
    [ -n "$h" ] || continue
    name=$(jq -r .name <<<"$h")
    rows+=("$(jq -c --arg p "${HOST_PROBE[$name]:-}" --arg f "${HOST_FREE[$name]:-}" --arg w "$(host_why "$name")" --arg s "$(stuck_on "$name" <<<"$queue")" \
      --arg hr "${HOST_HARN[$name]:-}" --arg hw "${HOST_HARN_WHY[$name]:-}" --arg k "${HOST_KIT[$name]:-}" \
      '{name, dest, place, max_live, free: ($f | tonumber? // null), stuck: ($s | tonumber? // null), probe: $p, kit: ($k | split(" ") | map(select(. != ""))), why: $w, repos,
        harnesses: (.harnesses // []), harness_ready: ($hr | split(" ") | map(select(. != ""))), harness_why: $hw}' <<<"$h")")
  done < <(fleet_hosts)
  [ ${#rows[@]} -gt 0 ] || { [ "${1:-}" = --json ] || say "no fleet workers in $(fleet_inventory || echo the inventory)"; return 0; }
  if [ "${1:-}" = --json ]; then printf '%s\n' "${rows[@]}"
  else printf '%s\n' "${rows[@]}" | jq -r '"\(.name)\t\(.dest)\t\(if .place then "placed" else "not placed" end)\t\(.free // "-")/\(.max_live) free\t\(if .why == "" then "open" else .why end)\(if (.stuck // 0) > 0 then "; \(.stuck) stuck at start (no transcript past the reap grace)" else "" end)\(if .kit != [] then "; has \(.kit | join(", "))" else "" end)\(if .harness_ready != [] then "; runs \(.harness_ready | join(", "))" else "" end)\(if .harness_why != "" then "; cannot run \(.harness_why)" else "" end)"'
    unplaced <<<"$queue"; fi
}

# unplaced -> one line per project and reason for the queued light items no worker could take on
# any pass (host_takers names none), so a gap in the workers' standard repo list (home-config
# fleet_workers fleet_repos) or a harness no worker runs shows here. A worker that is merely busy
# still takes the item later, so capacity is not a reason. stdin: the active queue as
# `agent-queue list --json`. After probe_hosts, which host_takers reads.
unplaced() {
  local it agent dir why roster
  roster=$(fleet_hosts | jq -sc .)
  while IFS= read -r it; do
    agent=$(host_agent "$it"); [ -n "$agent" ] || continue
    [ -z "$(host_takers "$it")" ] || continue
    dir=$(repo_dir "$(jq -r .project <<<"$it")"); [ -n "$dir" ] || continue
    if jq -e --arg d "$dir" 'any(.[]; .repos | index($d))' <<<"$roster" >/dev/null; then
      why="no worker runs $agent ready"
    else
      why="no worker clones $dir"
    fi
    printf '%s\t%s\n' "$(jq -r .project <<<"$it")" "$why"
  done < <(jq -c 'select(.state == "queued")' 2>/dev/null) |
    sort | uniq -c | while read -r n rest; do
      printf 'unplaceable: %s, %s queued light item%s: %s\n' "${rest%%$'\t'*}" "$n" "$([ "$n" = 1 ] || echo s)" "${rest#*$'\t'}"
    done
}

# item_repo <project> -> the repo name its code is pushed to, the runner exporter's `repo` label
# (origin's last path segment), else its checkout's basename; nothing for a notes-only project.
item_repo() {
  local dir url
  dir=$(repo_dir "$1"); [ -n "$dir" ] || return 0
  url=$(git -C "$dir" remote get-url origin 2>/dev/null) || url=$dir
  url=${url%/}; url=${url##*/}; url=${url##*:}
  printf '%s' "${url%.git}"
}

# pool_pass <item json> <held_by output> -- an urgent item held by starved pools alone goes past them,
# one a pass (POOL_PASSED, set by the start it made): its few CI jobs cost the pool less than the red
# it fixes left open. On 11-22 the hold kept urgent ucp-3033 queued 100 min while 25 other items
# started (ar-3172, ask hqkYtZ). Any other finding still holds it.
pool_pass() {
  [ -n "$2" ] && [ "${POOL_PASSED:-0}" = 0 ] && [ "$(jq -r .priority <<<"$1")" = urgent ] &&
    ! tr ',' '\n' <<<"$2" | grep -qv '^starved pool:'
}

# finding_hold <item json> -> the findings in FIRING that hold the item (held_by), less the starved
# pools an urgent item goes past (pool_pass): the test the reserve, preempt and starved share with the pick.
finding_hold() {
  local h; h=$(held_by "$1" "$FIRING")
  pool_pass "$1" "$h" || printf '%s' "$h"
}

# held_by <item json> <findings> -> "<rule> <scope>" of each firing finding that holds this item,
# comma-joined, else nothing. A starved pool holds the items whose repo has jobs waiting in it (all
# of them when the finding names no repos), and only when capacity or admission binds: a pool starved on labels
# (bind "labels": slots sit free, or the jobs are pinned to one host) gains nothing from a session
# not starting, since its gate asks for a different label. On 2026-11-05 a frame sweep pinned to the
# razer laptop held 6 unity-core-playground items for 7h with the box 80% idle.
# Admission holds as capacity does: the admitted slots are full, so another session's gate only queues behind them (ar-3132).
held_by() {
  local repo f rule scope out=()
  repo=$(item_repo "$(jq -r .project <<<"$1")")
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    rule=$(jq -r .rule <<<"$f"); scope=$(jq -r .scope <<<"$f")
    case "$rule:$scope" in
      starved:pool:*)
        jq -e --arg r "$repo" '.bind != "labels" and (.repos == null or (.repos | index($r)) != null)' <<<"$f" >/dev/null || continue ;;
    esac
    out+=("$rule $scope")
  done <<<"$2"
  [ ${#out[@]} -eq 0 ] || (IFS=,; echo "${out[*]}")
}

# item_headline <item json> -> its title, else the first non-blank line of its task: the one name a
# log, an event and the model-lane pick all use for the item.
item_headline() {
  jq -r '(.title // "" | select(test("\\S"))) // ([(.task // "") | split("\n")[] | select(test("\\S")) | sub("^\\s+"; "")][0] // "")' <<<"$1"
}

# item_size <item json> -> s, m or l from the `#size/` tag in its task, which promote copies from the
# board row (size_back tags the row with the judge's size, so the row's tag is the effective size);
# any case, as row_size_set reads it; nothing for an unsized or `xl` item, a size model-lane does not
# take. The one read lane_pick and start's `size=` header share.
item_size() { jq -r '[(.task // "") | match("#size/([sml])\\b"; "i").captures[0].string | ascii_downcase][0] // empty' <<<"$1"; }

# item_kind <item json> -> the item's row type: its `type:` (promote copies it from the board row),
# else its title or task parsed as a row (row_kind); nothing for a bare one. The kind the session
# prompt's entry skill and the model-lane class (kind/size) share.
item_kind() {
  local k
  k=$(jq -r '.type // empty' <<<"$1"); [ -n "$k" ] || k=$(row_kind "$(jq -r '.title // .task // ""' <<<"$1")")
  [ -z "$k" ] || printf '%s\n' "$k"
}

# lane_pick <slug> <harness> -> model-lane's verdict for a queued Claude item started with no --model,
# at DISPATCH_LANE_FLOOR; nothing when it is not queued, runs another harness, or model-lane fails.
# It classifies the item's headline, its board #size/ tag and its kind (item_kind), which make the
# task class a candidate is promoted for (model-lane score), never the whole task: the body carries
# the same dispatch boilerplate on every item, and its words would pick the lane. Not the item's
# weight either: agent-queue derives that from load (a Unity checkout or a plan is heavy), not size.
# Every start of an item comes through cmd_start (a pass, a hand start, a plan phase, an after: chain),
# so this is the one place an item's model is picked.
lane_pick() {
  local it size kind
  it=$(agent-queue show "$1" --json 2>/dev/null) || return 0
  [ "$(jq -r .state <<<"$it")" = queued ] && [ "${2:-$(jq -r '.agent // "claude"' <<<"$it")}" = claude ] || return 0
  [ -z "$(claude_pin "$it")" ] || return 0   # a pinned model is the human's or a canary's pick, as --model is
  size=$(item_size "$it"); kind=$(item_kind "$it")
  model-lane classify "$(item_headline "$it")" --floor "$DISPATCH_LANE_FLOOR" ${size:+--size "$size"} ${kind:+--kind "$kind"} 2>/dev/null |
    jq -ce 'select(.lane and .dispatch_model)' 2>/dev/null || true
}

# lane_log <slug> <task> <verdict json> <model ran> [harness] -- the started item's pick goes in model-lane's
# log, with the verdict's task class, and its run id on the item as lane_run, so the item's close reports
# the outcome (agent-queue move) and the lane, or a candidate promoted for the class, can demote on evidence. No verdict (model-lane failed) logs nothing:
# the item ran on opus, and a broken router never blocks a start.
lane_log() {
  local id cls
  [ -n "$3" ] || return 0
  cls=$(jq -r '.class // empty' <<<"$3")
  id=$(model-lane log --item "$1" --task "$2" --lane "$(jq -r .lane <<<"$3")" --by "$(jq -r '.by // "rule"' <<<"$3")" \
    --picked "$(jq -r '.model // .dispatch_model' <<<"$3")" --ran "$4" ${5:+--harness "$5"} ${cls:+--class "$cls"} 2>/dev/null) && [ -n "$id" ] ||
    { logline "model-lane log failed for queue item $1; it runs unrated"; return 0; }
  agent-queue set "$1" "lane_run=$id" >/dev/null || logline "could not stamp lane_run=$id on queue item $1"
}

# eval_log <slug> <task> <harness> <model> -- a gateway run logs under lane eval: the human picked the
# pairing, and an experiment must not count against the lane that shares its model.
eval_log() {
  local id
  id=$(model-lane log --item "$1" --task "$2" --lane eval --by human --harness "$3" --picked "$4" --ran "$4" 2>/dev/null) && [ -n "$id" ] ||
    { logline "model-lane log failed for queue item $1; it runs unrated"; return 0; }
  agent-queue set "$1" "lane_run=$id" >/dev/null || logline "could not stamp lane_run=$id on queue item $1"
}

# item_pinned <item json> -- rc 0 when the human pinned the item to a harness: an `agent:` other than
# claude (or claude-cloud, which cloud_routed reads) that no route recorded (`routed:`, start_item), so a
# requeued routed item routes again.
item_pinned() {
  jq -e '(.agent // "claude") as $a | ($a != "claude" and $a != "claude-cloud" and $a != (.routed // ""))' <<<"$1" >/dev/null 2>&1
}

# route <item json> <verdict json, or empty> -- the candidate a run start takes: ROUTE_HARNESS and
# ROUTE_MODEL (empty for claude, which runs the verdict's model), or rc 1 with every refusal in
# ROUTE_WHY. A pinned item's harness is its one candidate; an item with no verdict candidates runs on
# claude. Candidates go in fit order and, within a fit, by their source's rank, lowest first (use it or
# lose it): claude's is the rank of the account acct_room picked (its rc in the caller's ACCT_RC), every
# other's the rank of its source in ACCT_ROWS. Claude needs an account with room. Another harness needs
# its source's room, this machine (a fleet worker and a sandbox profile run claude only), an item it can
# hold (takes_plan: a headless one that cannot resume takes no plan item), on a headless one never an
# excluded kind of work (excluded_kind: deploy, prod, secrets and the rest, pinned or not, and none at
# all while that list is unreadable), an item of a project its `projects` allowlist names when it has
# one (harness_project_why, pinned or not: ocfree carries public input only), an item no higher than
# its `max_tier` unless a canary or a trainee row (harness_tier_why, pinned or not), only a canary or trainee item when
# it runs in its own lane sandbox (sandbox_item_why; a trainee row offers the trainees first), and, when routed rather
# than pinned, a tier within the unattended ceiling: only a red goes past it, and only to a harness that can run the
# red-fix gate, or a trainee row (trainee_why: its review lands it, behind review_gate when it is tier 3). A `metered`
# harness (pay-per-use, GLM) is overflow: routed, it takes only a class it was promoted for or its trial
# pick, only while no account has room, and only tier-1 work, so an unscored lane never spends on spare work.
route() {
  local it="$1" verdict="$2" cands h m src tier pinned=0 overflow excl='' erc='' hl pwhy project trn why=()
  ROUTE_HARNESS='' ROUTE_MODEL='' ROUTE_WHY=''
  project=$(jq -r '.project // ""' <<<"$it")
  item_pinned "$it" && pinned=1
  if [ "$pinned" = 1 ]; then cands=$(jq -c '[{harness: .agent, model: (.model // ""), fit: 0}]' <<<"$it")
  else cands=$(jq -c '.candidates // empty | select(length > 0)' <<<"${verdict:-null}" 2>/dev/null); fi
  [ -n "$cands" ] || cands='[{"harness": "claude", "model": "", "fit": 0}]'
  # A trainee row (trainee_why) offers the trainees ahead of every other fit, one model per harness picked
  # by the slug, so a trainee takes it whenever its source has room, the Claude hold or not; a trainee
  # past its cap or with no room falls to the verdict's own candidates. Only a harness in a lane sandbox
  # trains: that is where its cap and review hand-off are applied (sandbox_item_why, gateway_launch). A
  # pair the verdict promoted for the class is no trainee there: it stays at its own fit and runs direct.
  if [ "$pinned" = 0 ] && trainee_why "$it" >/dev/null &&
    trn=$(jq -c --argjson t "$TRAINEE_CONF" --slurpfile H "$HARNESSES" --argjson n "$(cksum <<<"$(jq -r .slug <<<"$it")" | cut -d' ' -f1)" \
      --argjson v "${verdict:-null}" '. as $c | (($v // {}).direct // []) as $p
        | [$t.candidates[] | select(($H[0].harnesses[.harness].sandbox // "") != "" and ("\(.harness):\(.model)" as $k | $p | index($k) | not))]
        | [group_by(.harness)[] | .[$n % length] | . + {fit: -1}] + $c' <<<"$cands"); then
    cands=$trn
  fi
  # A trainee-floor start (trainee_floor_start) takes the floor's harness as a trainee, nothing else.
  if [ "${TRAINEE_PASS:-0}" = 1 ]; then
    cands=$(jq -c --arg h "${TRAINEE_HARNESS:-}" '[.[] | select(.fit == -1 and .harness == $h)]' <<<"$cands")
    [ "$cands" != '[]' ] || { ROUTE_WHY="the trainee floor starts ${TRAINEE_HARNESS:-a trainee} as a trainee only, and it is none for this item"; return 1; }
  fi
  tier=$(item_tier "$it")
  while read -r h m; do
    if [ "$h" = claude ]; then
      [ "${CLAUDE_FULL:-0}" = 0 ] || { why+=("claude: the Claude pace target is full"); continue; }
      [ -z "${PLACE_HOST:-}" ] || host_runs "$PLACE_HOST" claude || { why+=("claude: placed on $PLACE_HOST, which does not run it (fleet-dispatch hosts)"); continue; }
      [ "${ACCT_RC:-1}" = 0 ] && { ROUTE_HARNESS=claude; return 0; }
      why+=("claude: no account has room"); continue
    fi
    src=$(harness_source "$h") hl=0
    headless "$h" && hl=1
    [ "$hl" = 0 ] || [ -n "$erc" ] || { excl=$(excluded_kind "$it"); erc=$?; }   # once, and only for a headless one
    overflow=0; [ "$pinned" = 0 ] && harness_flag "$h" metered && overflow=1
    if [ -z "$src" ]; then why+=("$h: no source in $HARNESSES")
    elif harness_spends_gateway "$h" && { load_gateway_down; [ -n "$GATEWAY_DOWN" ]; }; then why+=("$h: $GATEWAY_DOWN")
    elif ! pwhy=$(harness_project_why "$HARNESSES" "$h" "$project"); then why+=("$h: $pwhy")
    elif ! pwhy=$(harness_tier_why "$h" "$it"); then why+=("$h: $pwhy")
    elif [ -n "$(harness_sandbox "$h")" ] && ! pwhy=$(sandbox_item_why "$it" "$h" "$m" "$verdict"); then why+=("$h: $pwhy")
    elif [ -z "$m" ]; then why+=("$h: the item names no model: for it")
    elif [ -n "${PLACE_HOST:-}" ] && ! host_runs "$PLACE_HOST" "$h"; then why+=("$h: placed on $PLACE_HOST, which does not run it (its kit and fleet_harnesses, fleet-dispatch hosts)")
    elif [ -n "$DISPATCH_SANDBOX_PROFILE" ]; then why+=("$h: cannot hold sandbox $DISPATCH_SANDBOX_PROFILE")
    elif ! takes_plan "$h" && [ "$(jq -r .mode <<<"$it")" = plan ]; then why+=("$h: runs headless and cannot resume, and this is a plan item")
    elif [ "$hl" = 1 ] && [ "$erc" = 0 ]; then why+=("$h: runs headless, and this is $excl work (excluded in $MATRIX)")
    elif [ "$hl" = 1 ] && [ "$erc" = 2 ]; then why+=("$h: runs headless, and the exclusion list $MATRIX is unreadable or has a bad match")
    elif [ "$overflow" = 1 ] && ! jq -e --arg c "$h:$m" '.trial == $c or any(.promoted[]?, .direct[]?; . == $c)' <<<"${verdict:-null}" >/dev/null 2>&1; then
      why+=("$h: pay-per-use, so it takes only a class it was promoted for or its trial pick")
    elif [ "$overflow" = 1 ] && [ "${ACCT_RC:-1}" = 0 ]; then why+=("$h: pay-per-use, and an account has room")
    elif [ "$overflow" = 1 ] && [ "$tier" -gt 1 ]; then why+=("$h: pay-per-use takes tier-1 work only, and this is tier $tier")
    elif [ "$pinned" = 0 ] && [ "$tier" -gt "$UNATTENDED_TIER_CEILING" ] && ! is_red "$it" &&
      ! { [ -n "$(harness_sandbox "$h")" ] && trainee_why "$it" "$h" >/dev/null; }; then
      why+=("$h: tier $tier is past the unattended ceiling")
    elif [ "$pinned" = 0 ] && [ "$tier" -gt "$UNATTENDED_TIER_CEILING" ] && is_red "$it" && headless "$h"; then why+=("$h: runs headless, so it cannot hold the red-fix gate")
    elif pwhy=$(provider_hold_why "$src"); then why+=("$h: $pwhy")
    elif ! jq -e --arg s "$src" 'any(.sources[]?; .name == $s and .room.ok == true)' <<<"$ACCT_ROWS" >/dev/null 2>&1; then
      why+=("$h: $(jq -r --arg s "$src" '[.sources[]? | select(.name == $s) | "\($s): \(.room.why)"][0] // "no source \($s) in claude-acct room --json"' <<<"$ACCT_ROWS")")
    # The source has room, but the model's own route may not (its deployment budget or pace): every
    # start but a claude-cloud one asks this same verdict (gateway_launch), so what would refuse the
    # start is skipped here, never a failed start on every pass.
    elif [ "$(harness_launcher "$h")" != claude-cloud ] && pwhy=$(harness_route "$h" "$m") && [ -n "$pwhy" ] &&
      ! pwhy=$(claude-acct room --source "$src" --model "$pwhy" 2>&1); then why+=("$h: $pwhy")
    else ROUTE_HARNESS=$h ROUTE_MODEL=$m; return 0
    fi
  done < <(jq -r --argjson c "$cands" --arg d "${ACCT_DIR:-}" --slurpfile map "$HARNESSES" '. as $r | ($map[0].harnesses // {}) as $hs
      | $c | map(.rank = (if .harness == "claude" then ([$r.accounts[]? | select(.dir == $d) | .rank] | first)
          else ($hs[.harness].source // "") as $s | ([$r.sources[]? | select(.name == $s) | .rank] | first) end // 1e9))
      | sort_by(.fit, .rank)[] | "\(.harness) \(.model)"' <<<"$ACCT_ROWS" 2>/dev/null ||
    # No readable map: claude is the one harness a start could launch.
    jq -r '.[] | select(.harness == "claude") | "claude "' <<<"$cands")
  ROUTE_WHY=$(printf '%s; ' "${why[@]}"); ROUTE_WHY=${ROUTE_WHY%; }
  return 1
}

# start_item <item json> -- past the gates: route it (route) and start it, and publish what happened.
# rc 3 when usage cannot be read, which ends the pass: the next item could not be routed either. rc 4
# when another start (a hand start, say) took the item first: that is not a failed launch, and the
# pass goes on. rc 5 when no candidate it may run on has room (an Opus item while only lazer-reserve has room,
# a pinned harness whose source is spent): the pass goes on to the next item, which may.
start_item() {
  local it="$1" slug rc verdict='' cached floor='' keep=0 harness=claude
  local ACCT_ROWS='' ACCT_DIR ACCT_WHY ACCT_PAST_PACE ACCT_RC=0 SHORT_PASS=${SHORT_PASS:-0}
  slug=$(jq -r .slug <<<"$it")
  if [ "$DRY" = 1 ]; then say "would start queue item $slug: $(jq -r '"\(.project) \(.mode) \(.priority)"' <<<"$it")"; return 0; fi
  ! short_item "$it" || SHORT_PASS=1
  # Asked again here, as launch does: the gate's answer may be minutes old. ACCT_WHY names the
  # closest account and why its verdict refuses, as in gate. ACCT_ROWS is local, so a later gate
  # asks afresh after this start.
  acct_room || ACCT_RC=$?
  # A trainee floor start spends no account: an account it cannot read holds it only when claude-acct
  # gave no answer at all, as then no source's room can be read either.
  if [ "$ACCT_RC" = 2 ] && { [ "${TRAINEE_PASS:-0}" = 0 ] || [ -z "$ACCT_ROWS" ]; }; then
    settle BLOCKED "queue item $slug waits: account usage unreadable ($ACCT_WHY)"; return 3
  fi
  # Today's verdict for an item no source could take skips it without asking model-lane again; a
  # start always classifies afresh, and cmd_start logs that verdict, so model-lane is asked once.
  cached=$(lane_cached "$slug")
  if [ -n "$cached" ] && ! route "$it" "$cached"; then :
  else
    item_pinned "$it" || cloud_routed "$slug" || verdict=$(lane_pick "$slug" claude)
    # A broken router is not a fact about the item: the next pass asks again.
    route "$it" "$verdict" || { [ -z "$verdict" ] || lane_cache "$slug" "$verdict"; }
  fi
  if [ -z "$ROUTE_HARNESS" ]; then
    say "queue item $slug has no source with room it may run on: $ROUTE_WHY"
    NO_ROUTE+=("$slug ($ROUTE_WHY)"); [ "$ACCT_RC" = 0 ] || NO_ROOM=$ACCT_WHY
    return 5
  fi
  harness=$ROUTE_HARNESS
  local plan_past; plan_past=$(plan_load_past)
  [ -z "$plan_past" ] || plan_past=", past $plan_past on the plan load floor (DISPATCH_PLAN_LOAD_FLOOR=$DISPATCH_PLAN_LOAD_FLOOR)"
  if [ "$harness" = claude ]; then
    # A floor start leaves the hold standing (keep, settle): a red-floor one went past the machine
    # gates, and a run-floor one past an account over its pace has no room either.
    if [ "${BATCH_PASS:-0}" = 1 ]; then
      floor=" on the trainee floor: a batch review of the waiting trainee diffs"; keep=1
      [ -z "$(jq -r '.pr_owner // ""' <<<"$it")" ] || floor=" on the trainee floor: the $(jq -r .pr_owner <<<"$it") session of a trainee's PR"
    elif red_floor_open; then floor=" on the red floor (DISPATCH_RED_FLOOR=$DISPATCH_RED_FLOOR)"; keep=1
    elif [ "${SPRINT_PASS:-0}" = 1 ]; then floor=" on the sprint floor, past the pace target: an urgent row of the open sprint (DISPATCH_SPRINT_FLOOR=$DISPATCH_SPRINT_FLOOR)"; keep=1
    elif human_floor_open; then
      floor=" on the human floor, past the weekly pace: $([ "$(runs_now_label "$it")" = urgent ] && echo "urgent from the human" || echo "the human's ask")"
      [ -z "$(jq -r '.plan // ""' <<<"$it")" ] || floor=" on the human floor, past the weekly pace: a ready phase of a plan the human approved"
      keep=$ACCT_PAST_PACE
      [ -z "$plan_past" ] || { floor="$floor$plan_past"; keep=1; }
    elif short_floor_open && [ "$ACCT_PAST_PACE" = 1 ]; then
      floor=" on the class floor, past the weekly pace: its class is under its classes.json min_live"; keep=1
    elif floor_open; then
      floor=" on the run floor (DISPATCH_RUN_FLOOR=$DISPATCH_RUN_FLOOR)"
      keep=$ACCT_PAST_PACE
    fi
    START_ORIGIN=run START_VERDICT=$verdict RUN_ACCOUNT=$ACCT_DIR cmd_start --item "$slug" ${PLACE_HOST:+--host "$PLACE_HOST"}
  else
    if item_pinned "$it"; then floor=" on $harness ($ROUTE_MODEL), the harness it is pinned to"
    elif [ -n "$(harness_sandbox "$harness")" ] && direct_why "$it" "$harness" "$ROUTE_MODEL" "$verdict" >/dev/null; then floor=" on $harness ($ROUTE_MODEL), a direct run (model-lane promoted it for the class) it lands on CI with no review"
    elif [ -n "$(harness_sandbox "$harness")" ]; then floor=" on $harness ($ROUTE_MODEL), a trainee run (lanes.yaml trainee:) a batch review lands or sends back"
    else floor=" on $harness ($ROUTE_MODEL), routed by model-lane"; fi
    # A start past the account hold leaves it standing, like a floor start.
    [ "$ACCT_RC" = 0 ] || { floor="$floor while $ACCT_WHY"; keep=1; }
    if [ "${TRAINEE_PASS:-0}" = 1 ]; then floor="$floor, on the trainee floor (lanes.yaml trainee:, a free slot)"; keep=1; fi
    if [ "${BATCH_PASS:-0}" = 1 ]; then floor="$floor, on the trainee floor: a batch review of the waiting trainee diffs"; keep=1; fi
    [ -z "$plan_past" ] || { floor="$floor$plan_past"; keep=1; }
    START_ORIGIN=run START_VERDICT=$verdict cmd_start --item "$slug" --harness "$harness" --model "$ROUTE_MODEL" ${PLACE_HOST:+--host "$PLACE_HOST"}
  fi
  rc=$?; exec 7>&-
  if [ "$rc" -eq 0 ]; then
    # The route is recorded beside the `agent:` cmd_start set, so a requeued item routes again.
    [ "$harness" = claude ] || item_pinned "$it" || agent-queue set "$slug" "routed=$harness" >/dev/null ||
      say "could not record routed=$harness on queue item $slug"
    [ "$keep" = 0 ] || FLOOR_HELD=1
    settle WORKED "started queue item $slug${PLACE_HOST:+ on $PLACE_HOST}$floor${PICK_NOTE:-}"
  elif [ "$(item_state "$slug")" != queued ]; then
    say "queue item $slug was started by another start"; return 4
  else
    settle FAILED "could not start queue item $slug"; return 1
  fi
}

# --- verbs ---------------------------------------------------------------------------

# held_state -> "<held_since epoch> <held_why>" from the runner state agent-proof.sh keeps (the first
# BLOCKED pass of an unbroken run, and the latest one's reason); nothing while no hold stands.
held_state() {
  local dir since
  # shellcheck source=/dev/null
  . "$HOME/.local/lib/agent-proof.sh" 2>/dev/null || return 0
  dir="$(proof_state_dir)/fleet-dispatch"
  since=$(cat "$dir/held_since" 2>/dev/null)
  [[ "$since" =~ ^[0-9]+$ ]] || return 0
  printf '%s %s\n' "$since" "$(cat "$dir/held_why" 2>/dev/null)"
}

# held_short <why> -> the pass's reason without what the Stopped line says elsewhere: the pass's
# notes ahead of its gate (tier-3 and plan counts, a judge that could not judge), the item that
# waits, the run-out forecast and the parentheses.
held_short() {
  # A judge's reason can hold its own parentheses ("left-out row(s)") but never "; ". A "budget:"
  # lead is the stop itself (a pass with nothing else to do) and stays, the notes after it go.
  sed -E 's/^(budget: could not judge the new rows[^;]*; )?((tagged [0-9]+ for a plan|could not judge the new rows[^;]*); )+/\1/
    s/,? (queue item [^ ]+|every queue item) waits$//
    s/, runs out [^,]* at this rate//
    s/ \([^)]*\)//g' <<<"$1"
}

# held_clears <why> -> what ends the hold, in the words of the gate that holds.
held_clears() {
  case "$1" in
    "held"*) echo "Clears with agent-hold release dispatch" ;;
    "no account has room"*) echo "Clears when an account is back under its pace" ;;
    "account usage unreadable"*) echo "Clears when claude-acct reads usage again" ;;
    "finding firing"*) echo "Clears when its finding stops firing" ;;
    "fleet-assess says HOLD"* | "load "*) echo "Clears when the machine's load falls" ;;
    "github budget"*) echo "Clears when the GitHub API budget refills" ;;
    "budget: could not judge"*) echo "Clears when dispatch-judge's daily budget resets" ;;
    *) echo "fleet-dispatch run --dry-run names the gate" ;;
  esac
}

# stopped [--json] -- rc 1 and the Stopped line when a hold has stood DISPATCH_STARVED_MIN or longer:
# "Dispatch stopped 13h05m: <why>. <what clears it>." It is the one line every surface shows (hub Home's
# Stopped row through fleet-sessions, the briefing, queue-starved's probe), at most 160 characters;
# --json is {runner, since, line}. A run-floor start does not end the hold, a pass past an open
# gate does (agent-proof.sh). A hold under the threshold, or none, prints nothing and is rc 0.
cmd_stopped() {
  local since why held clears head max line
  read -r since why < <(held_state) || return 0
  [ -n "$since" ] || return 0
  held=$(( $(date +%s) - since ))
  [ "$held" -ge $(( DISPATCH_STARVED_MIN * 60 )) ] || return 0
  why=$(held_short "$why"); clears=$(held_clears "$why")
  . "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/prom.sh"
  head="Dispatch stopped $(prom_dur "$held"): "
  max=$(( 160 - ${#head} - ${#clears} - 3 ))
  # Too long: cut at the last clause that fits.
  while [ "${#why}" -gt "$max" ] && [[ "$why" == *[,\;]" "* ]]; do why=${why%[,;] *}; done
  [ "${#why}" -le "$max" ] || why="${why:0:$max}"
  line="$head$why. $clears."
  if [ "${1:-}" = --json ]; then
    jq -nc --arg line "$line" --argjson since "$since" '{runner: "fleet-dispatch", since: $since, line: $line}'
  else
    echo "$line"
  fi
  return 1
}

# starved -- rc 1 when urgent or high queue items have been runnable (no hold) for over
# DISPATCH_STARVED_MIN minutes and no run pass has started a queue item in that time: it names them
# and the last pass's outcome. A standing hold past that long trips it too, led by the Stopped line,
# and no run start clears it then: a run-floor start goes past an account hold, and on 11-05/06 one
# every hour cleared this while every other pass stopped. A deep queue the passes are moving is not starved, and neither is one
# held on purpose (agent-hold), high items behind a fleet at its pace target, or the load gates, whose alarm is
# fleet-thermal: a busy machine is not a broken queue, and any other gate still trips. Neither a hold nor load
# clears an urgent item from the human, which no limit may cut off. Only a run start counts: a hand start or a redispatch proves nothing
# about the pass, and on 11-04 a hand start would have hidden a gate that stopped every pass for
# 7.5h. A NOOP pass reads healthy to fleet-liveness, so this is what pages a queue nothing starts:
# the Sentinel watch queue-starved runs it. The board starves too: rows nobody judges never reach the
# queue, so it trips when rows wait unjudged and no pass has judged any that long, the human here or
# away (the fill judges either way; a fleet at its pace target holds them).
# (2026-11-05, while the human was away: 220 rows, no judge since 11-02, every pass stopped at held queue items.) And the
# low water starves: runnable under DISPATCH_LOW_WATER, rows a pass would pick, and no run start in
# twice DISPATCH_STARVED_MIN (low_starved), which is a fill that has stopped filling.
cmd_starved() {
  local items board low last cut started why stopped dead dry side queue qrc human mine
  load_gates   # once, for the picks and unjudged rows it counts
  cut=$(( $(date +%s) - DISPATCH_STARVED_MIN * 60 ))
  queue=$(runnable); qrc=$?
  # The human's urgent items, fresh asks and approved plan phases over the window: their standing rule keeps them
  # clear of every limit, so neither a hold nor load makes their wait on purpose, and it pages
  # (queue-starved) for the human to decide. 2026-11-10: four sat 4h, 2h of it under a dispatch hold
  # that read as nothing starved (ar-1432).
  mine=$(human_urgent "$queue" | jq -c --argjson cut "$cut" 'select(.t != null and .t < $cut)')
  local fmt='"\(.slug) (\(if (.plan // "") != "" then "a ready phase of a plan the human approved" else (if .priority == "urgent" then "urgent from the human" else "an ask the human made" end) end), queued \(.queued))"'
  human=$(jq -r "$fmt" <<<"$mine")
  if ! agent-hold check dispatch >/dev/null 2>&1; then
    [ -n "$human" ] || { echo "dispatch is held (agent-hold), so nothing is starved"; return 0; }
    # gate stops at the hold and names it in the words the Stopped line uses.
    echo "dispatch is $(gate); the human's urgent items wait on it (agent-hold release dispatch clears it):"
    sed 's/^/  /' <<<"$human"
    return 1
  fi
  stopped=$(cmd_stopped)
  started=$(last_run_start)
  dead=$(dead_holds)
  if [ -n "$dead" ]; then
    echo "board rows gated on what can never clear: (notes ptask <project> --agent tag --remove <gate> <id>, plus --add the gate that replaced it, or drop the row)"
    sed 's/^/  /' <<<"$dead"
  fi
  dry=$(trainee_dry "$cut")
  [ -z "$dry" ] || echo "$dry"
  side=$dead$dry
  # A run start in the window proves the passes move the queue, which clears the high items they work
  # through in order. It does not clear an urgent item they passed over: that one sits first in the
  # order, so a pass that started others and not it is held by something specific to it (2026-11-10:
  # four human urgent items sat 2h behind a weekly pace while run-floor starts kept this healthy).
  if [ -z "$stopped" ] && [ -n "$started" ] && [ "$(date -d "$started" +%s 2>/dev/null || echo 0)" -ge "$cut" ] &&
    ! jq -e --argjson cut "$cut" 'select(.priority == "urgent" and .t != null and .t < $cut)' <<<"$queue" >/dev/null 2>&1; then
    [ -z "$side" ]; return
  fi
  # Away, the target's carry and gate share one room read (ACCT_ROWS); here, a full fleet reads none.
  local ACCT_ROWS='' ACCT_DIR ACCT_WHY ACCT_PAST_PACE room=0
  human_here || ACCT_ROWS=$(claude-acct room --json 2>/dev/null)
  local TARGET TARGET_WHEN TOTAL_LIVE NEEDS_LIVE NEEDS_NOTE
  pace_target
  [ "$qrc" = 0 ] || { echo "agent-queue unreadable"; return 1; }
  items=$(jq -cs --argjson cut "$cut" '
    [.[] | select((.priority == "urgent" or .priority == "high") and .t != null and .t < $cut)]
    | sort_by(.t) | .[] | . + {line: "\(.slug) (\(.priority)\(if ((" " + (.tags // "") + " ") | contains(" red ")) then ", red" else "" end), queued \(.queued)"}' <<<"$queue") || { echo "agent-queue unreadable"; return 1; }
  # Each item names the firing finding that holds it (held_by, as pick_item reads it): the last pass's
  # line names another item's start when the passes go past this one. On 11-22 an urgent item sat
  # 100 min behind "starved pool:unity" while the probe showed only a run-floor start of another item (ar-3172).
  if [ -n "$items" ]; then
    local it fw lines='' FIRING fread=1
    load_findings || fread=0
    while IFS= read -r it; do
      if [ "$fread" = 1 ]; then fw=$(finding_hold "$it"); fw=${fw:+, held by finding $fw}; else fw=', findings unreadable, which hold it'; fi
      lines+="$(jq -r .line <<<"$it")$fw)"$'\n'
    done <<<"$items"
    items=${lines%$'\n'}
  fi
  # A fleet at its pace target never reaches the fill, so its unjudged rows wait (below): no scan.
  board=''; [ -n "$TOTAL_LIVE" ] && [ "$TOTAL_LIVE" -ge "$TARGET" ] || board=$(board_starved "$cut")
  low=$(low_starved "$(( cut - DISPATCH_STARVED_MIN * 60 ))")
  [ -n "$stopped$items$board$low" ] || { [ -z "$side" ]; return; }
  # A full fleet is working, not blocked (cmd_run): at its pace target no pass starts a high item,
  # so one waits on sessions finishing, and no pass reaches the fill there, so unjudged board rows
  # wait too (board_starved is not read). Only that case holds: an urgent item may preempt a runner session there, and the red
  # and human floors go past the target, so a red item, a standing
  # hold or low water still trips. On 11-11 this tripped 4h at 42 of 25 live sessions. Once the
  # fleet is under its target, a waiting item trips it at once.
  if [ -n "$TOTAL_LIVE" ] && [ "$TOTAL_LIVE" -ge "$TARGET" ] && [ -z "$stopped$low" ] &&
    ! grep -qE '\(urgent, |, red, ' <<<"$items"; then
    echo "held by a full fleet ($TOTAL_LIVE live sessions, the $TARGET_WHEN pace target is $TARGET$NEEDS_NOTE), so nothing is starved"
    [ -z "$side" ]; return
  fi
  # Held by load only when every closed gate is a load gate; an account with no room still starves,
  # and gate leaves that one out while another source has room, so room is read here from the verdict
  # gate reads too (ACCT_ROWS, asked once for both).
  acct_room || room=$?
  why=$(gate)
  if [ -n "$why" ] && ! sed 's/; /\n/g' <<<"$why" | grep -qvE '^(fleet-assess says HOLD|load )' &&
    [ "$room" = 0 ]; then
    # How many approved plan phases wait on load, beside the plan load floor that lets some past it. With
    # that floor full they wait on the human's own bound (DISPATCH_PLAN_LOAD_FLOOR): not starved.
    local live_pl note
    live_pl=$(live_plans | grep -c . || true)
    note="$(jq -s '[.[] | select((.plan // "") != "")] | length' <<<"$mine") approved plan phase(s) wait on load; the plan load floor has $live_pl of DISPATCH_PLAN_LOAD_FLOOR=$DISPATCH_PLAN_LOAD_FLOOR live"
    if [ "${DISPATCH_PLAN_LOAD_FLOOR:-0}" -gt 0 ] 2>/dev/null && [ "$live_pl" -ge "$DISPATCH_PLAN_LOAD_FLOOR" ]; then
      human=$(jq -r 'select((.plan // "") == "") | '"$fmt" <<<"$mine")
    fi
    [ -n "$human" ] || { echo "held by load ($why), so nothing is starved ($note)"; [ -z "$side" ]; return; }
    echo "held by load ($why), and the human's urgent items wait on it ($note):"
    sed 's/^/  /' <<<"$human"
  fi
  # shellcheck source=/dev/null
  . "$HOME/.local/lib/agent-proof.sh" 2>/dev/null &&
    last=$(tail -n 1 "$(proof_state_dir)/fleet-dispatch/activity.log" 2>/dev/null)
  [ -z "$stopped" ] || echo "$stopped"
  if [ -n "$items" ]; then
    echo "runnable over ${DISPATCH_STARVED_MIN} min and not started:"
    sed 's/^/  /' <<<"$items"
  fi
  [ -z "$board" ] || echo "$board"
  [ -z "$low" ] || echo "$low"
  echo "last run start: ${started:-none in the log}; last pass: ${last:-none recorded}"
  return 1
}

# trainee_dry <cut epoch> -> one line per harness dry since before <cut>: it had a slot and found no
# queued or board row it takes on every pass since (TRAINEE_DRY, trainee_dry_mark), so its free key
# sit idle. A dry pool is a supply fault no run start clears, so starved reports it beside the dead holds.
trainee_dry() {
  local h since
  [ -s "$TRAINEE_DRY" ] || return 0
  while IFS=$'\t' read -r h since; do
    [[ "$since" =~ ^[0-9]+$ ]] && [ "$since" -le "$1" ] || continue
    echo "trainee pool dry since $(date -d "@$since" '+%F %H:%M'): $h had a slot and no queued or board row a trainee takes (fleet-dispatch trainee-pool names each refusal)"
  done <"$TRAINEE_DRY"
}

# dead_holds -> one line per open board row gated on what can never clear, each gate `agent-queue gate`
# calls dead (load_gates): an #after/ on a row that was dropped or does not exist, an #ask/ the human
# cancelled, that no longer exists, or that was answered with another option (reap holds or drops an
# agent row on the human's answer, and closes, moves or asks again on a cancel: settle_answered_gates; an #after/ on a
# row sent to the human sheet follows it there: follow_moved_gates). Nothing promotes such a row, so it
# waits for good unless someone sees it: this is where they surface. On 2026-11-07 trader's Kalshi
# phases sat behind cancelled ask ybXZIM and nothing named them.
dead_holds() {
  local board p i t g
  load_gates
  board=$(notes board --json 2>/dev/null) || return 0
  while IFS=$'\t' read -r p i t; do
    for g in $t; do
      [ "${GATE_ST[$g]:-}" = dead ] || continue
      printf '%s (%s, #%s: %s)\n' "$i" "$p" "$g" "${GATE_WHY[$g]}"
    done
  done < <(jq -r '.rows[]? | select((.state == "open" or .state == "doing") and .id != null) | "\(.project)\t\(.id)\t\((.tags_cased // .tags // []) | join(" "))"' <<<"$board")
  return 0
}

# low_starved <cut epoch> -> a line when runnable is under DISPATCH_LOW_WATER, no run pass has
# started a queue item since <cut> (twice DISPATCH_STARVED_MIN), and the board has rows a pass would
# pick: the top-up is not happening. Else nothing. Rows waiting on a judge are board_starved's.
low_starved() {
  local depth started n
  depth=$(queue_depth)
  [ "$depth" -lt "$DISPATCH_LOW_WATER" ] 2>/dev/null || return 0
  started=$(last_run_start)
  [ -z "$started" ] || [ "$(date -d "$started" +%s 2>/dev/null || echo 0)" -lt "$1" ] || return 0
  n=$(picks "$(all_open)" "$DISPATCH_LOW_WATER" | grep -c . || true)
  [ "$n" -gt 0 ] || return 0
  echo "runnable $depth under the low water $DISPATCH_LOW_WATER with no run start since $(date -d "@$1" +%H:%M), and $n board row(s) a pass would pick"
}

# board_starved <cut epoch> -> a line naming the unjudged rows when the board has some and no verdict
# was written since <cut>, the human here or away (a pass judges either way); else nothing. An `error`
# verdict counts as written, and so does a budget stop's touch: a pass whose judge fails or stops
# already publishes FAILED or BLOCKED (settle), which fleet-liveness reads.
board_starved() {
  local judged n
  judged=$(stat -c %Y "$VERDICTS" 2>/dev/null || echo 0)
  [ "$judged" -lt "$1" ] || return 0
  n=$(unjudged_rows | grep -c . || true)
  [ "$n" -gt 0 ] || return 0
  if [ "$judged" = 0 ]; then judged=never; else judged=$(date -d "@$judged" -Iminutes); fi
  echo "$n board rows unjudged, none judged since $judged"
}

# sprint-stalled -- rc 1 naming each agent-lane row of an open sprint (SPRINT_ROW) left DISPATCH_STARVED_MIN
# minutes or longer unstarted (so no session holds it), with no active queue item on it and nothing it waits on:
# no gate pending or dead (a dead one is queue-starved's, dead_holds) and nothing row_off_set names. A verdict
# holding the row, or no worker taking it, is the stall itself, so rows are read as suggest reads them, verdicts
# ignored, and each line names the row's last verdict. First sightings live in $DIR/sprint-stalled.tsv, as
# unstart_orphans keeps its own; a row that stops being one counts again from its next sighting. A dispatch
# hold (agent-hold) is deliberate: nothing trips and the sightings restart. A failed read is rc 2 `unreadable:`
# (Sentinel's UNKNOWN). Event-free by necessity: an unowned row has no event, so the watch sprint-stalled
# samples it. Why: on 2026-11-21 v0.5.5 held 25 open rows, none queued, and nothing paged (ar-4333).
cmd_sprint_stalled() {
  local seen_f="$DIR/sprint-stalled.tsv" verdicts="$VERDICTS" cands linked now first key project seen='' out='' keys='[]' last stopped n=0
  mkdir -p "$DIR"
  if ! agent-hold check dispatch >/dev/null 2>&1; then
    rm -f "$seen_f"
    echo "dispatch is held (agent-hold), so no sprint row is stalled"; return 0
  fi
  load_gates
  [ -z "${GATES_FAILED:-}" ] || { echo "unreadable: $GATES_FAILED"; return 2; }
  linked=$(agent-queue list --json 2>/dev/null) || { echo "unreadable: agent-queue list --json failed"; return 2; }
  linked=$(jq -r 'select(.state != "done" and (.row // "") != "") | .row | sub(":"; "\t")' <<<"$linked")
  # cmd_candidates reads an empty board or worker table as no rows, which would wipe the sightings.
  notes board --json 2>/dev/null | jq -e 'has("sprints")' >/dev/null || { echo "unreadable: notes board --json failed or has no sprints"; return 2; }
  [ -n "$(workers)" ] || { echo "unreadable: no workers in $DISPATCH_WORKERS"; return 2; }
  cands=$(VERDICTS=/dev/null SUGGEST=1 SPRINT_ONLY=1 cmd_candidates | jq -c 'select(.lane == "agent"
    and (.gate_wait // "") == "" and (.off // "") == "")')
  now=$(date +%s)
  while IFS=$'\t' read -r project key; do
    [ -n "$key" ] || continue
    grep -qxF "$project"$'\t'"$key" <<<"$linked" && continue
    first=$(K="$project"$'\t'"$key" awk -F'\t' '$1"\t"$2 == ENVIRON["K"] { print $3; exit }' "$seen_f" 2>/dev/null)
    first=${first:-$now}
    seen+="$project"$'\t'"$key"$'\t'"$first"$'\n'
    [ $(( now - first )) -ge $(( DISPATCH_STARVED_MIN * 60 )) ] || continue
    keys=$(jq -c --arg k "$project"$'\t'"$key" '. + [$k]' <<<"$keys")
  done < <(jq -r '"\(.project)\t\(.key)"' <<<"$cands")
  printf '%s' "$seen" > "$seen_f.new" && mv "$seen_f.new" "$seen_f"
  [ "$keys" != '[]' ] || { echo "no open sprint row has gone ${DISPATCH_STARVED_MIN} min with no queue item, session or gate ($(grep -c . <<<"$seen" || true) unowned for less)"; return 0; }
  # The last verdict of each stalled row: one read of the cache, the one judged_keys reads.
  last=$(jq -rn --argjson k "$keys" 'reduce (inputs | select(.lane == "agent")) as $v ({};
      "\($v.project)\t\($v.key)" as $x | if ($k | index($x)) != null then .[$x] = "\($v.verdict)\(if ($v.reason // "") != "" then ": \($v.reason)" else "" end)" else . end)
    | to_entries[] | "\(.key)\t\(.value)"' "$verdicts" 2>/dev/null)
  echo "open sprint rows with no queue item, no session and nothing they wait on for ${DISPATCH_STARVED_MIN}+ min:"
  while IFS=$'\t' read -r project key first; do
    jq -e --arg k "$project"$'\t'"$key" 'index($k) != null' <<<"$keys" >/dev/null || continue
    n=$(( n + 1 )) out+="${out:+, }$key"
    jq -r --arg min "$(( (now - first) / 60 ))" --arg v "$(K="$project"$'\t'"$key" awk -F'\t' '$1"\t"$2 == ENVIRON["K"] { print substr($0, length($1) + length($2) + 3); exit }' <<<"$last")" \
      --arg p "$project" --arg k "$key" 'select(.project == $p and .key == $k)
      | "  \(.key) (\(.project)\(if (.uncommitted // 0) == 1 then ", uncommitted" else "" end), \($min) min)"
        + (if (.nobody // "") != "" then "; no worker takes it: \(.nobody)" else "" end)
        + (if .plan == true then "; #plan, waits on inbox-plan" else "" end)
        + (if $v != "" then "; last verdict \($v)" else "; never judged" end)' <<<"$cands"
  done <<<"$seen"
  stopped=$(cmd_stopped)
  [ -z "$stopped" ] || echo "$stopped"
  echo "$n open sprint row(s) stalled: $out (fleet-dispatch suggest says why each waits)"
  return 1
}

# idle-cap -- rc 1 when the fleet's live Claude sessions are at the pace target (pace_target, so the
# same sessions it counts) and under DISPATCH_IDLE_CAP_PCT of them are busy: sessions that cannot move
# hold the target, no pass starts, and cmd_starved reads that full fleet as working, so nothing else
# trips (plan ar-3741-takeover P6). The trip names each idle one, then the verdict as its last line
# (the line triage carries, and the one Sentinel's output tail always keeps). A target the accounts'
# spare set (TARGET_BY spare: live plus spare) is not a trip: closing an idle session lowers it as
# much, so it frees no start. Under the target, or with enough busy, it is rc 0. A missing or stale
# fleet state document, or a DISPATCH_IDLE_CAP_PCT that is not a whole number, is rc 2 with an
# `unreadable:` line, which Sentinel reads as UNKNOWN, never a trip. The watch fleet-cap-mostly-idle runs it.
cmd_idle_cap() {
  local ACCT_ROWS='' TARGET TARGET_WHEN TARGET_BY TOTAL_LIVE NEEDS_LIVE NEEDS_NOTE WORKING_LIVE IDLE_LIVE
  [[ "$DISPATCH_IDLE_CAP_PCT" =~ ^[0-9]+$ ]] || { echo "unreadable: DISPATCH_IDLE_CAP_PCT=$DISPATCH_IDLE_CAP_PCT is not a whole percent"; return 2; }
  pace_target
  [[ "$TOTAL_LIVE" =~ ^[0-9]+$ && "$WORKING_LIVE" =~ ^[0-9]+$ ]] || {
    echo "unreadable: the fleet state document ($FLEET_STATE_FILE) is missing or older than $DISPATCH_STATE_FRESH_MIN min"; return 2; }
  local at="$TOTAL_LIVE live Claude sessions, the $TARGET_WHEN pace target is $TARGET$NEEDS_NOTE"
  if [ "$TOTAL_LIVE" -lt "$TARGET" ]; then echo "under the target: $at"; return 0; fi
  if [ "$TARGET_BY" = spare ]; then echo "at a target the Claude accounts' spare set, which an idle session's close lowers as much: $at"; return 0; fi
  if [ $(( WORKING_LIVE * 100 )) -ge $(( TOTAL_LIVE * DISPATCH_IDLE_CAP_PCT )) ]; then
    echo "at the target and busy: $WORKING_LIVE of $at are working (DISPATCH_IDLE_CAP_PCT=$DISPATCH_IDLE_CAP_PCT)"; return 0
  fi
  [ -z "$IDLE_LIVE" ] || sed 's/^/  /' <<<"$IDLE_LIVE"
  echo "at the target and mostly idle: $WORKING_LIVE of $at are working, under DISPATCH_IDLE_CAP_PCT=$DISPATCH_IDLE_CAP_PCT%, so no pass starts until the idle ones above move (fleet-shepherd due, fleet-sessions)"
  return 1
}

# headroom [--json] -- the window over the limits: how many more queue items a start could take now
# (free run units while every gate is open, else 0 and the gate that holds), and the margin under
# the load cap. The human reads it before raising DISPATCH_PER_PASS or a pace target; nothing
# here raises a limit.
cmd_headroom() {
  local live hand slots load load1 busy cores runnable why could=0 floor_live red_live red_watch starts pend
  # One room read for the away target and the gate: headroom starts nothing, so it cannot go stale.
  local ACCT_ROWS; ACCT_ROWS=$(claude-acct room --json 2>/dev/null)
  pace_target
  live=$(live_units)
  floor_live=$(live_runs | grep -c . || true)
  # The gate's machine pace lifts while a worker is open, so read the workers as a pass does (after
  # a pass, its own reading stands).
  [ ${#HOST_PROBE[@]} -gt 0 ] || probe_hosts "$(live_runs)"
  red_live=$(live_reds | grep -c . || true) red_watch=$(watch_reds)
  hand=$(live_hand | grep -c . || true)
  slots=$(( TARGET - live ))
  # The fleet's room under the target bounds the units a pass may fill; unknown, it is none.
  [ "$slots" -le $(( TARGET - ${TOTAL_LIVE:-$TARGET} )) ] || slots=$(( TARGET - ${TOTAL_LIVE:-$TARGET} ))
  cores=$(nproc 2>/dev/null || echo 1)
  read -r load load1 busy < <(pace_load "$cores")
  [ "$load1" != - ] || load=''
  read -r starts pend < <(pending_load)
  local items; items=$(next_items)
  runnable=$(grep -c . <<<"$items" || true)
  why=$(gate)
  if [ -z "$why" ]; then could=$(( slots < runnable ? slots : runnable )); [ "$could" -gt 0 ] || could=0; fi
  local focus_runnable=0; load_focus
  share_state
  [ -z "$FOCUS_PROJECTS" ] || focus_runnable=$(jq -s <<<"$items" --arg f " $FOCUS_PROJECTS " '[.[] | select(.project as $p | $f | contains(" \($p) "))] | length')
  jq -cn --argjson runnable "$runnable" --argjson live "$live" --argjson hand "$hand" --argjson max_live "$TARGET" \
    --arg target_when "$TARGET_WHEN" --arg total_live "${TOTAL_LIVE:-}" --arg needs "${NEEDS_LIVE:-}" --arg working "${WORKING_LIVE:-}" --argjson target_present "$DISPATCH_TARGET_PRESENT" --argjson target_away "$DISPATCH_TARGET_AWAY" \
    --argjson per_pass "$PER_PASS" --arg level "$LEVEL" --argjson could "$could" --argjson cores "$cores" \
    --arg load "${load:-}" --arg load1 "${load1#-}" --arg busy "${busy#-}" --argjson starts "$starts" --argjson pend "$pend" --arg max_load "$MAX_LOAD" --arg held "$why" \
    --argjson floor "${DISPATCH_RUN_FLOOR:-0}" --argjson floor_live "$floor_live" --argjson red_floor "${DISPATCH_RED_FLOOR:-0}" --argjson red_live "$red_live" --argjson red_watch "${red_watch:-0}" \
    --arg focus "$FOCUS_PROJECTS" --argjson focus_runnable "${focus_runnable:-0}" --argjson share "$SHARE_STATE" --argjson share_cap "${DISPATCH_FLEET_SHARE:-0}" '
    def num: if . == "" then null else tonumber end;
    {could_start: $could, per_pass: $per_pass, level: $level, per_pass_limited: ($per_pass > 0 and $could > $per_pass),
     runnable: $runnable, live_runs: $live, live_hand: $hand, max_live: $max_live, slots_free: ($max_live - $live),
     target: $max_live, target_when: $target_when, target_present: $target_present, target_away: $target_away, total_live: ($total_live | num), needs: ($needs | num), working: ($working | num),
     load: ($load | num), load1: ($load1 | num), cpu_busy: ($busy | num), starting: $starts, load_pending: $pend, load_cap: (($max_load | tonumber) * $cores * 100 | round / 100),
     load_room: (if $load == "" then null else ((($max_load | tonumber) * $cores) - ($load | tonumber) - $pend) * 100 | round / 100 end),
     run_floor: $floor, floor_live: $floor_live, red_floor: $red_floor, red_watch: $red_watch, red_live: $red_live,
     focus: ($focus | split(" ") | map(select(. != ""))), focus_runnable: $focus_runnable,
     fleet_share: ($share + {cap: $share_cap, pct: (if $share.total > 0 then $share.fleet * 100 / $share.total | round else null end)}),
     held: (if $held != "" then $held
            elif $total_live == "" then "live sessions unreadable: the fleet state document is missing or stale"
            elif ($total_live | tonumber) >= $max_live then "pace target: \($total_live) live sessions, the \($target_when) target is \($max_live)"
            elif $live >= $max_live then "run units: every one of the \($max_live) is used"
            elif $runnable == 0 then "nothing runnable" else null end)}
    # The held reason as one word, so the feed (numbers only) can carry it as a 0/1 per kind.
    | .held_kind = (.held // "" | if . == "" or . == "nothing runnable" then null
        elif startswith("pace target") or startswith("run units") then "slots" elif startswith("load ") then "load"
        elif test("account") then "account"
        elif startswith("fleet-assess") then "assess" else "other" end)' |
    if [ "${1:-}" = --json ]; then cat; else
      jq -r '"could start now: \(.could_start) of \(.runnable) runnable (a pass starts \(if .per_pass > 0 then "up to \(.per_pass)" else "what the gates allow" end), level \(.level))" +
        (if .held then ", held: \(.held)" else "" end),
        "  pace:      \(.total_live // "?") of \(.target) live Claude sessions (\(.needs // "?") more wait on the human, not counted), the \(.target_when) target (the live ones plus the Opus sessions the Claude spend has spare at pace, at most present \(.target_present), away \(.target_away)); hand starts count toward it and are never refused",
        "  run units: \(.live_runs)/\(.max_live) used, \(.slots_free) free (heavy 2, light 1), \(.live_hand) more started by hand",
        "  load:      \(.load // "?")\(if .cpu_busy != null then " (1-min load \(.load1), \(.cpu_busy) cores busy; the pace reads the lower)" else "" end)\(if .starting > 0 then " plus \(.load_pending) for \(.starting) started in the last '"$DISPATCH_START_LOAD_MIN"' min" else "" end) of a \(.load_cap) cap, \(.load_room // "?") room",
        "  run floor: \(.floor_live) of \(.run_floor) run sessions live; under it the weekly pace of an account refused for its pace alone does not hold a start (committed burn, the reserve and the 5h window still do)",
        "  red floor: \(.red_live) of \(if .red_floor > 0 then .red_floor + .red_watch else 0 end) red sessions live (\(.red_floor), plus \(.red_watch) for tripped watches); under it the pace target, weekly pace, load and fleet-assess do not hold a red",
        (if .fleet_share.cap > 0 and .fleet_share.unread == true then "  fleet share: off, as `notes projects --prios` failed and no #prio/low project could be read" elif .fleet_share.cap > 0 and (.fleet_share.projects | length) > 0 then "  fleet share: \(.fleet_share.fleet) of \(.fleet_share.total) items started in '"$DISPATCH_FLEET_SHARE_H"'h are fleet work (\(.fleet_share.projects | join(", "))), \(.fleet_share.pct // 0)% against a \(.fleet_share.cap)% cap\(if .fleet_share.full then ": full, so only reds and work the human asked for start their items until nothing else can" else "" end)" else empty end),
        (if (.focus | length) > 0 then "  focus:     \(.focus | join(" ")) first; \(.focus_runnable) runnable item(s) of it start ahead of the other projects (reds and urgent items still go first)" else empty end)'
    fi
}

# runnable [--points] -> the queued items nothing holds (agent-queue sets hold for a tag window or an unmet
# after:), one JSON object a line; --points joins each one's board row `points` (agent-queue list --points).
# Each carries t, the epoch it became runnable: its queued epoch. Fails when the queue is unreadable.
runnable() {
  local q
  q=$(agent-queue list --json ${1:+"$1"} --state queued 2>/dev/null) || return 1
  jq -c 'select(.hold == null) | . + {t: (.queued | try fromdateiso8601 catch null)}' <<<"$q"
}

# queue_depth -> the queued items no hold stops: what the low water mark measures. An item the fleet
# share cap holds (share_held) is not counted, so the board tops up other projects' work first.
queue_depth() {
  share_state
  runnable 2>/dev/null | jq -c --argjson s "$SHARE_STATE" "$SHARE_JQ"'select(share_held($s) | not)' | grep -c . || true
}

# queue_headroom -> how many more items agent-queue's cap admits now (agent-queue admission): the most a
# fill promotes, since an add over the cap is held and its row un-started again. Unreadable, it is no
# limit here: agent-queue still holds each add past the cap.
# start_pull -> the AGENT_QUEUE_PULL of a `start` or `promote` from the command line: `hand` (never held by
# the cap, agent-queue pull_ok) when no queue item's session runs it, the human at a terminal or the
# hub; a session dispatch started that starts another is a pull like dispatch's own, capped. A machine
# caller with no item says so with `promote --dispatch` (fleet-bench triage's reds).
start_pull() { [ -n "${AGENT_QUEUE_ITEM:-}" ] && echo dispatch || echo hand; }

queue_headroom() {
  agent-queue admission --json 2>/dev/null | jq -er 'if .on then ([.limit - .runnable, 0] | max) else 999999 end' 2>/dev/null || echo 999999
}

# last_run_start -> "YYYY-MM-DD HH:MM" of the last queue item a run pass started, from the log.
last_run_start() {
  grep -E '^- [0-9-]+ [0-9:]+ started .* \(run\) .*queue item ' "$LOG" 2>/dev/null | tail -n 1 | cut -d' ' -f2,3
}

# stats -- one JSON object for the feed (agent-mqtt-publish summary/dispatch), numbers only where a
# number will do, because mqtt2prom keeps nothing else: runnable items and the oldest one's age, by
# all and by urgent (runnable_urgent, oldest_urgent_s: priority urgent only, and only what a start would
# take, as next_items does) with the high ones counted apart (runnable_high, oldest_high_s); the low water and whether runnable is under it;
# the last pass and last run start;
# reap moves in the last hour, and the items moved
# DISPATCH_FLAP_MOVES or more times where reap made the same move twice in a row with no start
# logged between: something else undid the first heal (11-04: running -> waiting twice). Moves that
# alternate follow a session asking and being answered, which is reap working (11-10: two questions
# in an hour), so a reap misreading the panel the same way is not caught here; a start (hand,
# run, redispatch) sets running, and a session moving itself (to review, say) is not an undo;
# the agent board's open rows (`notes board --json` totals: board_agent the agent board (Today),
# board_backlog the agent rows still carrying the retired backlog token, counted in neither), left out when the board
# is unreadable, so the chip reads - and never 0; held_s, how long a
# hold has stopped the passes (0 with none, so the series never goes stale; its words are `stopped`'s).
# The starved verdict is not here: the queue-starved watch publishes it (watch/queue_starved), and
# recomputing it here made stats take 18s of the publisher's lock (ar-2310).
cmd_stats() {
  local now q aq since started pass=null hr=null board held_since
  now=$(date +%s); since=$(date -d "@$(( now - 3600 ))" '+%Y-%m-%d %H:%M')
  # The last pass's headroom, while it is younger than three passes: an old one is no answer.
  [ -n "$(find "$HEADROOM" -mmin -45 2>/dev/null)" ] && hr=$(jq -c . "$HEADROOM" 2>/dev/null) || hr=null
  q=$(runnable) || { echo '{"error":"agent-queue unreadable"}'; return 1; }
  aq=$(agent-queue stats --json --since "$(date -d yesterday +%F)" 2>/dev/null) && jq -e .active <<<"$aq" >/dev/null 2>&1 || aq=null
  board=$(notes board --json 2>/dev/null | jq -c '.totals | select(.open != null)
    | {board_agent: .agent, board_backlog: .backlog}' 2>/dev/null)
  load_focus
  read -r held_since _ < <(held_state)
  started=$(last_run_start); [ -z "$started" ] || started=$(date -d "$started" +%s 2>/dev/null)
  # shellcheck source=/dev/null
  . "$HOME/.local/lib/agent-proof.sh" 2>/dev/null &&
    pass=$(stat -c %Y "$(proof_state_dir)/fleet-dispatch/last-outcome" 2>/dev/null || echo null)
  awk -v since="$since" '
    ($2 " " $3) < since { next }
    $4 == "reaped" && match($0, /queue item [^ ]+ [a-z]+ -> [a-z]+$/) { split(substr($0, RSTART), w, " "); print "move", w[3], w[4], w[6]; next }
    $4 == "reaped" { print "settle", "-"; next }
    $4 == "started" && match($0, /queue item [^ ,]+/) { split(substr($0, RSTART, RLENGTH), w, " "); print "start", w[3], "-", "running" }' "$LOG" 2>/dev/null |
    jq -Rsc --argjson now "$now" --slurpfile q <(printf '%s\n' "$q") \
      --argjson pass "${pass:-null}" --argjson start "${started:-null}" --argjson flap "$DISPATCH_FLAP_MOVES" --argjson hr "${hr:-null}" --argjson aq "$aq" --argjson board "${board:-null}" \
      --argjson low "$DISPATCH_LOW_WATER" \
      --argjson held "${held_since:-null}" --argjson focus_n "$(wc -w <<<"$FOCUS_PROJECTS")" '
      [split("\n")[] | select(length > 0) | split(" ")] as $ev
      | ($q | map(select(.priority == "urgent"))) as $u
      | ($q | map(select(.priority == "high"))) as $hi
      | def age(x): if (x | map(.t // empty) | length) == 0 then null else $now - (x | map(.t // empty) | min) end;
        def undone: . as $m | any(range(1; $m | length); $m[.].kind == "move" and $m[.].from == $m[. - 1].from and $m[.].to == $m[. - 1].to);
        ($ev | map(select(.[0] == "move" or .[0] == "start") | {kind: .[0], slug: .[1], from: .[2], to: .[3]}) | group_by(.slug)
          | map(select((map(select(.kind == "move")) | length) >= $flap and undone) | .[0].slug)) as $flapping
      | {state: ($q | length), runnable: ($q | length), runnable_urgent: ($u | length), runnable_high: ($hi | length),
         oldest_runnable_s: age($q), oldest_urgent_s: age($u), oldest_high_s: age($hi),
         last_pass_epoch: $pass, last_run_start_epoch: $start,
         reaped_1h: ($ev | map(select(.[0] == "move" or .[0] == "settle")) | length),
         flapping_items: ($flapping | length), flapping: $flapping,
         could_start: ($hr.could_start // null),
         low_water: $low, under_low_water: (if ($q | length) < $low then 1 else 0 end),
         held_s: (if $held == null then 0 else $now - $held end), focus_projects: $focus_n}
      + ($board // {})
      # The whole queue, as agent-queue counts it: every state and flow by the hour.
      + (if $aq == null then {} else
          {queued: ($aq.active.queued // 0), running: ($aq.active.running // 0), waiting: ($aq.active.waiting // 0), review: ($aq.active.review // 0)}
          + ($aq.recent // {}) end)
      # The room the last pass had, with why it was held as a 0/1 per kind.
      + (if $hr == null then {} else
          {room_live_runs: $hr.live_runs, room_max_live: $hr.max_live, room_live_hand: ($hr.live_hand // null),
           room_load: $hr.load, room_load_cap: $hr.load_cap, room_load1: ($hr.load1 // null), room_cpu_busy: ($hr.cpu_busy // null),
           room_run_floor: ($hr.run_floor // null), room_floor_live: ($hr.floor_live // null), room_total_live: ($hr.total_live // null)}
          + (["slots", "load", "account", "assess", "other"]
             | map({key: "room_held_\(.)", value: (if $hr.held_kind == . then 1 else 0 end)}) | from_entries) end)'
}

# reap -- settle the queue items whose session is gone (settle_item, then settle_row for an
# item with a row), go by its PR for one that records no session (settle_sessionless), and keep each
# live one's state true to its session: waiting/ while it waits on the human
# (Claude's own `waiting` status, which an open plan or dialog is, or a pending agent-ask it filed and
# stopped on), running/ again once it does not, except an item it parked in review/ on its PR, which
# stays there. It is the one writer of that move for a live session.
# A session neither read can see is left where it is.
# replay_mark <server> <session> [host] -> the slug a headless run's replay tagged its session with
# (@headless, gateway_launch), empty while the run is still going or the session is gone.
replay_mark() { on_host "${3:-}" tmux -L "$1" show-options -qv -t "=$2:" @headless 2>/dev/null; }

# reap_replays -- close each headless run's replay once its item has left the run: cmd_start records
# the session as DIR/replay/<slug>@<session> (server, session, host), one per run of the slug, since a
# move to queued/ drops the item's own session:. An item running, waiting or in review on that session
# keeps it; any other state or another session closes it, and only once its @headless names the item,
# so the run itself is never cut short. A session already gone drops the record.
reap_replays() {
  local f slug server sess host it
  for f in "$DIR"/replay/*; do
    [ -e "$f" ] || continue
    slug=${f##*/} slug=${slug%@*}
    IFS=$'\t' read -r server sess host < "$f" && [ -n "$sess" ] || { rm -f "$f"; continue; }
    # An item is never deleted (done/ keeps it), so no answer is a queue that could not be read: keep it.
    it=$(agent-queue show "$slug" --json 2>/dev/null) && [ -n "$it" ] || continue
    jq -e --arg s "$server:$sess" '(.state | IN("running", "waiting", "review")) and .session == $s' <<<"$it" >/dev/null 2>&1 && continue
    if [ "$(replay_mark "$server" "$sess" "$host")" = "$slug" ]; then
      on_host "$host" tmux-close -L "$server" session "$sess" >/dev/null 2>&1 || continue
      logline "closed $sess: the headless run of queue item $slug left its run ($(jq -r .state <<<"$it"))"
      rm -f "$f"
    elif ! session_live "$sess" "$server" "$host"; then rm -f "$f"
    fi
  done
}

# store_fresh -- this machine's store holds origin as of now, once a reap: an item a peer host's
# session closed ok reads closed here, not running. A worker's session closes its item in its own
# clone and pushes it; this clone lags that by up to a sync, and a reap that fails the stale running
# copy makes a second close of the same item, a merge conflict that stops the peer's sync
# (razer-laptop, 2026-11-20: 5 items closed ok, each failed here 1 to 24 minutes later, ar-4091).
# The check, not store-sync's exit code, is the verdict (worker_store_pull): a SKIP or BACKUP exits 0.
store_fresh() {
  if [ -z "${REAP_FRESH:-}" ]; then
    if timeout "$WORKER_PULL_SECS" store-sync --now </dev/null >/dev/null 2>&1 && store-sync-age --max-min 2 </dev/null >/dev/null 2>&1; then
      REAP_FRESH=yes
    else
      REAP_FRESH=no
    fi
  fi
  [ "$REAP_FRESH" = yes ]
}

cmd_reap() {
  local s d slug server sess _by project area state _weight agent started sids host want waits='' seen='' gone live lost active=()
  unset REAP_PANEL REAP_LOST REAP_FRESH; REAP_HOST=()
  fleet_hosts >/dev/null   # once, so each session_live subshell inherits the roster
  # A board item cancelled or failed with no session of its own (cancelled while queued, say).
  for d in "$(date +%F)" "$(date -d yesterday +%F 2>/dev/null)"; do
    [ -n "$d" ] || continue
    agent-queue list --json --state "done" --date "$d" 2>/dev/null |
      jq -r 'select((.row // "") != "" and .status != "ok") | .slug' 2>/dev/null |
      while IFS= read -r s; do settle_row "$s"; done
  done
  while IFS=$'\x1f' read -r slug server sess _by project area state _weight agent started sids host; do
    [ -n "$slug" ] || continue
    active+=("$slug")
    if [ -z "$sess$sids" ]; then settle_sessionless "$slug" "$started"; continue; fi
    # A tmux session gone is its own witness; a Claude missing from agent-panel needs a second reap
    # (reap_confirm), and until then the item is left as it is: its Claude is not read as live either.
    # A fleet worker that does not answer says nothing on one reap, so its item stays as it is; one
    # that has not answered for DISPATCH_HOST_DEAD (host_lost) is lost, its session with it, and its
    # item is re-queued to a node that answers (settle_item). A live session on a worker is beyond this
    # agent-panel's sight: its pane ends with its claude (wt's _prepare), so its tmux session is the witness.
    # A session or conversation a lost pane record still holds is owed a reopen by restore, so its
    # absence is no witness, and clears any miss, until restore consumes the record (ar-2140). One
    # whose tmux session is back is read as usual.
    gone='' lost='' live=0
    [ -z "$sess" ] || { session_live "$sess" "$server" "$host"; live=$?; }
    if [ -z "$host" ] && { [ -z "$sess" ] || [ "$live" != 0 ]; } && restoring "$server" "$sess" "$sids"; then reap_seen "$slug"; continue
    elif [ "$live" = 1 ]; then gone=1
    # A headless run whose replay opened while its item is still running: the run and its tail ended,
    # and the tail did not move the item, as a closed window used to say (gateway_launch).
    elif [ "$state" = running ] && [ -n "$sess" ] && [ -e "$DIR/replay/$slug@$sess" ] && [ "$(replay_mark "$server" "$sess" "$host")" = "$slug" ]; then gone=1
    elif [ -n "$host" ]; then host_lost "$host" || continue; gone=1 lost=$host
    elif claude_gone "$server" "$sess" "$agent" "$started" "$sids"; then reap_confirm "$slug" || continue; gone=1
    elif codex_gone "$slug" "$agent" "$started"; then reap_confirm "$slug" "Codex run is not live" || continue; gone=1
    else reap_seen "$slug"
    fi
    if [ -n "$gone" ]; then
      # A peer host's item is closed by its session in that host's clone: read origin before reading it
      # as unclosed, or this failed close conflicts with the peer's ok (ar-4091).
      [ -z "$host" ] || store_fresh || { logline "reaped $sess: queue item $slug left for the next pass: this store could not be brought up to origin"; continue; }
      settle_item "$slug" "${sess:-${sids##* }}" "$lost"
      settle_row "$slug"
      # Closed, its mark goes at once: an item put back (agent-queue reopen) starts with no miss on record.
      [ "$(item_state "$slug")" != "done" ] || reap_seen "$slug"
      continue
    fi
    [ -n "$sess" ] || continue
    want=running
    # A headless harness's run never waits on the human: it asks by requeueing its item (no_human). Its
    # tmux name is a recycled lane, so a pending ask a past session filed there would read as this item's
    # and hold its replay open for hours (ar-4406: two agy replays, 6 and 9 hours).
    if ! headless "$agent"; then
      [ -n "$seen" ] || { waits=$(waiting_sessions) && seen=1 || seen=unreadable; }
      [ "$seen" = 1 ] || continue
      # By the item's own Claude when it records one (claude_gone's rule), else by its tmux session.
      if [ -n "$sids" ] && panel_lists "$agent"; then grep -qxF -f <(printf 'sid:%s\n' $sids) <<<"$waits" && want=waiting
      else grep -qxF -e "$server/$sess" -e "$sess" <<<"$waits" && want=waiting; fi
    fi
    # Parked on its PR and not asking the human: the session is idle at its PR, not working. One
    # that left review/ to ask the human goes back there once answered (its review: stamp says so).
    [ "$want:$state" != running:review ] || continue
    [ "$want:$state" != running:waiting ] || [ -z "$(agent-queue show "$slug" --json 2>/dev/null | jq -r '.review // empty')" ] || want=review
    [ "$state" = "$want" ] && continue
    agent-queue move "$slug" "$want" --if "$state" >/dev/null && logline "reaped $sess: queue item $slug $state -> $want"
  done < <(item_sessions)
  # A mark whose item is no longer active (closed by its session, cancelled) would count for a later
  # item under the slug. No active item at all may be a queue that could not be read: keep them then.
  [ ${#active[@]} -eq 0 ] || for s in "$DIR"/reap-miss/*; do
    [ -e "$s" ] || continue
    [[ " ${active[*]} " == *" ${s##*/} "* ]] || rm -f "$s"
  done
  # A stuck marker no pass has rewritten in a day is an item that settled (reap_stuck).
  [ ! -d "$DIR/stuck" ] || find "$DIR/stuck" -type f -mmin +1440 -delete 2>/dev/null
  # A re-post's record outlives any pass that could still find a row on its cancelled ask.
  [ ! -d "$DIR/reposed" ] || find "$DIR/reposed" -type f -mtime +30 -delete 2>/dev/null
  reap_replays
  unstart_orphans
  ask_failed_rows
  settle_answered_gates
  follow_moved_gates
  reconcile_plans
  reconcile_epics
  return 0
}

# ask_failed_rows -- an open agent-board row its failures hold (in_force: DISPATCH_FIX_TRIES failed
# records since its last `cleared`, or one marked `hold`) gets one ask carrying each
# failure's reason: start it again, or drop it. It is a gate, not an approval: the judge answers it
# by its policy, and only one the judge sends on reaches the human (2026-11-23: these filled the
# human's list with retry picks no human needed to make). The row is gated on the ask (#ask/<id>/retry) and a
# `cleared` record naming the ask ends the hold, so only the answer decides: retry clears the gate,
# and the row is judged (or, gated, picked) again with DISPATCH_FIX_TRIES more tries; drop settles
# it (settle_answered_gates, agent lane only). The `cleared` goes in before the tag, so a tag that
# fails costs at most a bounded retry, never a row held with no ask; that ask is cancelled. A started,
# done or dropped row, a human-lane row (the human's own Start ignores verdicts) and a row with no id
# are left alone.
ask_failed_rows() {
  local held board prof p key text fails n hold why rec ctx aid rc
  held=$(judged_keys | awk -F'\t' '$2 == "agent" && $4 == "*" && $5 == "*"')
  [ -n "$held" ] || return 0
  board=$(notes board --json 2>/dev/null) || return 0
  while IFS=$'\x1f' read -r prof p key text; do
    grep -qxF "$p"$'\tagent\t'"$key"$'\t*\t*' <<<"$held" || continue
    # Work that merged though the row stayed open closes it, or waits on its open PR: asking to start
    # it again would redo landed work (2026-11-21: ar-4041 and ar-225 asked after their PRs merged). A
    # queue or forge that cannot be read asks as before, since the human decides when nothing proves it.
    rc=0; land_row "$p" "$key" || rc=$?
    [ "$rc" != 0 ] || continue
    # The failures since the row's last `cleared`: their count, whether one holds at once, and their reasons.
    fails=$(jq -rRn --arg p "$p" --arg k "$key" \
      '[inputs | fromjson? | objects | select(.project == $p and .lane == "agent" and .key == $k and (.verdict == "failed" or .verdict == "cleared"))]
       | (to_entries | map(select(.value.verdict == "cleared") | .key) | max // -1) as $c | .[$c + 1:]
       | "\(length)\t\(any(.[]; .hold == true))\t\(map(.reason // "no reason recorded") | join("; "))"' "$VERDICTS" 2>/dev/null | tr -cd '\t -~')
    IFS=$'\t' read -r n hold why <<<"$fails"
    why=${why:0:600} rec=retry
    [ "$hold" != true ] || rec=drop
    ctx="$key is a row on the $p board: \"$text\". Its last $n runs failed: $why. Dispatch holds it until this is answered."
    aid=$(env -u CLAUDE_CODE_SESSION_ID -u TMUX -u TMUX_PANE -u AGENTCTL_NAME agent-ask post --kind gate --project "$p" ${prof:+--profile "$prof"} \
        --options "retry=judge the row again and start it, with $DISPATCH_FIX_TRIES more tries|drop=drop the row from the board" \
        --recommend "$rec" --why "each try is a fresh session, and $DISPATCH_FIX_TRIES more failures ask again" --context "$ctx" \
        -- "Start board row $key again after its last $n runs failed?" </dev/null 2>/dev/null | tail -n 1)
    [ -n "$aid" ] || { logline "ask_failed_rows: the ask for $p agent row $key did not post"; continue; }
    jq -cn --arg p "$p" --arg k "$key" --arg a "$aid" --arg at "$(date -Iseconds)" \
      '{project: $p, lane: "agent", key: $k, verdict: "cleared", reason: "asked the human: ask \($a)", ask: $a, at: $at}' >> "$VERDICTS" ||
      { agent-ask cancel "$aid" "fleet-dispatch could not record it" </dev/null >/dev/null 2>&1; continue; }
    if np "$prof" ptask "$p" --agent tag --add "ask/$aid/retry" "$key" </dev/null >/dev/null 2>&1; then
      logline "asked about $p agent row $key after $n failures: ask $aid"
      echo "asked about $p: $key (failed $n times, ask $aid)"
    else
      agent-ask cancel "$aid" "fleet-dispatch could not gate row $key on it" </dev/null >/dev/null 2>&1
      logline "ask_failed_rows: could not gate $p agent row $key on ask $aid, so it is judged again"
    fi
  done < <(jq -r '.rows[]? | select(.state == "open" and .lane == "agent" and .id != null)
    | [.profile // "", .project, .id, ((.text // .raw // "") | gsub("[^ -~]|[#\"]"; ""))[0:120]]
    | join("\u001f")' <<<"$board")
  return 0
}

# settle_answered_gates -- each open agent-board row gated #ask/<id>/<options> on an ask the human
# answered with another option: that gate reads dead (load_gates), so nothing promotes the row, and
# since the queue stopped holding (ar-3121) nothing else settled it either (2026-11-18: consoles-p3
# kept held, dept-tabs-p6-posthog skipped, both rows sat in dead_holds). An answer that says to skip
# the work (SETTLE_SKIP_RE) drops the row, the answer as its why. Any other answer only says not this
# way or not yet, and a drop cannot be undone from here, so the row stays: its gate is swapped for
# #hold/row-<row id>, an agent-hold the human releases to start it. A missing ask and a
# human-sheet row stay in dead_holds for a person. A cancelled ask (nobody
# decided: agent-ask cancel has no actor) leaves its rows dead the same way (ar-3863, 2026-11-19):
# one cancelled because it joined an older ask moves its rows' gate to that ask. Any other cancel
# sets no hold, which only a person clears (ar-4646: ucp-463 sat held on work #2129 had merged): a
# done queue item on the row whose PR merged closes it on merge proof (land_row), and otherwise
# the ask is posed again (repose_ask) and the row gated on the new one.
SETTLE_SKIP_RE='\b(skip|skipped|drop|cancel|cancelled|abandon|scrap|not needed|no longer needed)\b'
settle_answered_gates() {
  local board prof p id t g aid ask st ans who why hold had rsn to rc
  load_gates
  [ -z "$GATES_FAILED" ] || return 0
  board=$(notes board --json 2>/dev/null) || return 0
  while IFS=$'\x1f' read -r prof p id t; do
    for g in $t; do
      [[ $g == ask/?* ]] && [ "${GATE_ST[$g]:-}" = dead ] || continue
      aid=${g#ask/}; aid=${aid%%/*}
      ask=$(agent-ask show "$aid" </dev/null 2>/dev/null) || continue
      st=$(sed -n '/^status: */{s///p;q;}' <<<"$ask")
      # Any answer, as ask_pending reads it: the human's, the judge's or an agent's.
      if [ "$st" = cancelled ]; then
        rsn=$(sed -n '/^closed_reason: */{s///p;q;}' <<<"$ask" | tr -cd ' -~' | tr -d '#<>' | cut -c1-160)
        # join_ask moved the asker's sessions to the older ask: the gate follows, options and all.
        if [[ $rsn =~ ^joined\ ([A-Za-z0-9_-]+): ]] && to=${BASH_REMATCH[1]} && agent-ask show "$to" </dev/null >/dev/null 2>&1; then
          if np "$prof" ptask "$p" --agent tag --add "ask/$to${g#ask/$aid}" --remove "$g" "$id" </dev/null >/dev/null 2>&1; then
            logline "moved $p row $id from #$g to ask $to: ask $aid joined it"
          else
            say "settle_answered_gates: could not retag $p row $id from #$g to #ask/$to"
          fi
          continue 2
        fi
        # 0: closed, or a PR is open or its proof is not in yet (reap_stuck says why); 2: the forge
        # did not answer, so the next pass reads it again. 1: no merged PR, so the work is not done.
        rc=0; land_row "$p" "$id" || rc=$?
        [ "$rc" != 3 ] || { say "settle_answered_gates: could not read the done queue items"; return 0; }
        [ "$rc" = 1 ] || continue 2
        repose_ask "$prof" "$p" "$id" "$g" "$aid" "$ask" "$rsn"
        continue 2
      else
        [ "$st" = answered ] || continue
      fi
      # The answer goes into a marker or a hold line: one line of plain ASCII, no # (a tag) or <> (a marker end).
      ans=$(sed -n '/^answer: */{s///p;q;}' <<<"$ask" | tr -cd ' -~' | tr -d '#<>' | cut -c1-160)
      who=$(sed -n '/^answered_by: */{s///p;q;}' <<<"$ask"); case "$who" in ''|human) who="the human" ;; *) who="the $who" ;; esac
      why="$who answered \"$ans\" to ask $aid, and #$g waited on another answer"
      if grep -Eiq "$SETTLE_SKIP_RE" <<<"$ans"; then
        if np "$prof" ptask "$p" --agent drop "$id" --why "$why" </dev/null >/dev/null 2>&1; then
          logline "dropped $p row $id: $why"
        else
          say "settle_answered_gates: could not drop $p row $id ($why)"
        fi
        continue 2
      fi
      # The hold first: a #hold/ gate with no hold behind it reads clear, and the row would start. One
      # already set (a person, an earlier settle) is kept as it is, and never released on a failure here.
      hold=row-$id had=
      agent-hold show "$hold" </dev/null >/dev/null 2>&1 && had=1
      [ -n "$had" ] || agent-hold set "$hold" --kind resource --by fleet-dispatch "$why; agent-hold release $hold starts board row $id ($p)" </dev/null >/dev/null 2>&1 ||
        { say "settle_answered_gates: could not hold $p row $id for ask $aid"; continue 2; }
      if np "$prof" ptask "$p" --agent tag --add "hold/$hold" --remove "$g" "$id" </dev/null >/dev/null 2>&1; then
        logline "held $p row $id until agent-hold release $hold: $why"
      else
        [ -n "$had" ] || agent-hold release "$hold" </dev/null >/dev/null 2>&1
        say "settle_answered_gates: could not retag $p row $id from #$g to #hold/$hold"
      fi
      continue 2
    done
  # Open rows only: a started row's item already passed its gates. A unit separator, not a tab: read
  # folds an empty profile into the next field across a tab.
  done < <(jq -r '.rows[]? | select(.state == "open" and .lane == "agent" and .id != null)
    | "\(.profile // "")\u001f\(.project)\u001f\(.id)\u001f\((.tags_cased // .tags // []) | join(" "))"' <<<"$board")
  return 0
}

# follow_moved_gates -- each open agent- or human-lane row gated #after/<id> on a row that reads dead
# (dropped, or gone from the board) follows that row to where its work went: the open human-sheet row
# of the same profile, on any project's sheet, whose text says "(agent row <id>)", which skip_exits
# files on the dropped row's own sheet (a row id is unique, and a gate may cross projects: apo-181 waits
# on ucp-2631, ar-4768). The gate becomes #after/<that row's id>, so the row waits on the work, not on a
# closed copy. A dead gate with no such row, or whose copy has closed (whatever its marker), stays for
# dead_holds and a person. Why: on 2026-11-22 ucp-2693 and ucp-2984 waited on ucp-2691 and ucp-2688,
# both sent to the sheet as ucp-2983 and ucp-2988, and queue-starved paged (ar-3172).
follow_moved_gates() {
  local board prof p lane id t g old to
  local -a lf
  load_gates
  [ -z "$GATES_FAILED" ] || return 0
  board=$(notes board --json 2>/dev/null) || return 0
  while IFS=$'\x1f' read -r prof p lane id t; do
    for g in $t; do
      [[ $g == after/?* ]] && [ "${GATE_ST[$g]:-}" = dead ] || continue
      old=${g#after/}
      to=$(jq -r --arg m "(agent row $old)" --arg self "$id" --arg pr "$prof" 'first(.rows[]?
        | select(.lane == "human" and .state == "open" and .id != null and .id != $self
            and (.profile // "") == $pr and ((.raw // "") | contains($m)))) | .id' <<<"$board")
      [ -n "$to" ] || continue
      lf=(); [ "$lane" != agent ] || lf=(--agent)
      if np "$prof" ptask "$p" "${lf[@]}" tag --remove "$g" --add "after/$to" "$id" </dev/null >/dev/null 2>&1; then
        logline "moved $p row $id from #$g to #after/$to: row $old went there"
      else
        say "follow_moved_gates: could not retag $p row $id from #$g to #after/$to"
      fi
    done
  done < <(jq -r '.rows[]? | select(.state == "open" and (.lane | IN("agent", "human")) and .id != null)
    | "\(.profile // "")\u001f\(.project)\u001f\(.lane)\u001f\(.id)\u001f\((.tags_cased // .tags // []) | join(" "))"' <<<"$board")
  return 0
}

# repose_ask <profile> <project> <row id> <gate> <ask id> <ask file> <closed reason> -- the cancelled
# ask posed again from its own fields, and the row's gate moved to the new ask with its option, so the
# human decides (lesson 2026-09-16: a cancel is nobody deciding). Once per cancelled ask: REPOSED/<ask id>
# names the new one, so every row gated on it, this pass or a later one (a retag that failed), moves
# to that same ask and the human gets one question. An ask this posed, cancelled again, is left dead,
# and dead_holds lists it (queue-starved). A post that fails leaves the gate for the next pass.
REPOSED_MARK='Re-posed by fleet-dispatch:'
REPOSED="$DIR/reposed"
repose_ask() {
  local prof=$1 p=$2 id=$3 g=$4 aid=$5 ask=$6 rsn=$7 f q kind ap opts='' n ctx new
  local -A A=()
  for f in question kind project options option_notes context recommend recommend_why; do
    A[$f]=$(sed -n "/^$f: */{s///p;q;}" <<<"$ask")
  done
  ctx=${A[context]}
  [[ $ctx != "$REPOSED_MARK"* ]] || return 0
  new=$(cat "$REPOSED/$aid" 2>/dev/null)
  if ! { [[ $new =~ ^[A-Za-z0-9_-]+$ ]] && agent-ask show "$new" </dev/null >/dev/null 2>&1; }; then
    q=${A[question]} kind=${A[kind]:-question} ap=${A[project]:-$p}
    # A retry-or-drop ask ask_failed_rows posted (a `cleared` verdict names it) goes back as the gate it
    # is now, so the judge answers it; ones posted before 2026-11-23 were approvals.
    [ "$kind" != approval ] || ! jq -Rne --arg a "$aid" 'any(inputs | fromjson? | objects; .verdict == "cleared" and .ask == $a)' "$VERDICTS" >/dev/null 2>&1 || kind=gate
    [ -n "$q" ] || { say "settle_answered_gates: cancelled ask $aid has no question to pose again ($p row $id)"; return 0; }
    # `options:` holds the slugs and `option_notes:` their meanings, pipe-aligned; post takes slug=meaning
    # and refuses a bare slug, so a missing meaning (a gate's default approve|hold) reads as agent-ask's audit words.
    if [ -n "${A[options]}" ]; then
      local -a os ns
      IFS='|' read -r -a os <<<"${A[options]}"; IFS='|' read -r -a ns <<<"${A[option_notes]}"
      for n in "${!os[@]}"; do opts+="${opts:+|}${os[n]}=${ns[n]:-as the asker offered it}"; done
    fi
    ctx="$REPOSED_MARK ask $aid was cancelled (${rsn:-no reason given}) before anyone answered it, and board row $id ($p) waits on this answer.${ctx:+ $ctx}"
    new=$(env -u CLAUDE_CODE_SESSION_ID -u TMUX -u TMUX_PANE -u AGENTCTL_NAME agent-ask post --kind "$kind" --project "$ap" ${prof:+--profile "$prof"} \
        ${opts:+--options "$opts"} ${A[recommend]:+--recommend "${A[recommend]}"} ${A[recommend_why]:+--why "${A[recommend_why]}"} \
        --context "$ctx" -- "$q" </dev/null 2>/dev/null | tail -n 1)
    [[ $new =~ ^[A-Za-z0-9_-]+$ ]] && agent-ask show "$new" </dev/null >/dev/null 2>&1 ||
      { say "settle_answered_gates: could not pose cancelled ask $aid again for $p row $id"; return 0; }
    mkdir -p "$REPOSED" && printf '%s\n' "$new" > "$REPOSED/$aid" ||
      say "settle_answered_gates: could not record ask $new as the re-post of $aid"
  fi
  if np "$prof" ptask "$p" --agent tag --add "ask/$new${g#ask/$aid}" --remove "$g" "$id" </dev/null >/dev/null 2>&1; then
    logline "posed cancelled ask $aid again as $new: $p row $id waits on it"
    echo "asked again about $p: $id (ask $aid was cancelled, now ask $new)"
  else
    say "settle_answered_gates: could not retag $p row $id from #$g to #ask/$new"
  fi
}

# reconcile_plans -- file an approved plan its session left behind on the board: one low row naming
# the plan (agent-queue add --plan from a filer; only the board fills the queue), which dispatch
# pulls like any row and promote queues as the plan's chain. Once only: a plan the queue has held,
# or one filed here before (PLANS_FILED), is not filed again, or every pass would add a row.
# ask-sweep reads PLANS_FILED too, so it asks the human about no plan filed here. One still open
# after that shows in plans_unqueued.
# `- [-]` is how a human drops a phase.
PLANS_FILED="$DIR/plans-filed"
reconcile_plans() {
  [ "$DISPATCH_PLAN_RECONCILE" = 1 ] || return 0
  local orphans c plan project held out rc
  orphans=$(plans_orphaned) || return 0
  [ -n "$orphans" ] || return 0
  held=$(agent-queue list --json --state done --since "$(date -d "$PLAN_LEDGER_DAYS days ago" +%F)" 2>/dev/null | jq -r '.plan // empty') || return 0
  [ ! -s "$PLANS_FILED" ] || held+=$'\n'"$(cat "$PLANS_FILED")"
  # By file name, as PLAN_ITEMS_JQ and ask-sweep match: an item names ~/.claude/plans/<f>, the
  # ledger the account's own ~/.claude-<acct>/plans/<f>.
  held=$(sed 's#.*/##' <<<"$held")
  while IFS= read -r c; do
    plan=$(jq -r .plan <<<"$c"); project=$(jq -r .project <<<"$c")
    grep -qxF -- "${plan##*/}" <<<"$held" && continue
    out=$(AGENT_QUEUE_START=0 agent-queue add --plan "$plan" --project "$project" --priority low --from auto:plans 2>&1); rc=$?
    if [ "$rc" -eq 0 ] || [ "$rc" -eq "$AQ_EX_HELD" ]; then
      mkdir -p "$DIR"; printf '%s\n' "$plan" >> "$PLANS_FILED"
      logline "filed $(basename "$plan") to run its open phases: its session is gone"
    else
      say "could not file the phases of $plan: $out"
    fi
  done <<<"$orphans"
}

# reconcile_epics -- queue one verify item for each open epic whose every leaf has landed (fleet-bench's
# landed_unverified, read the same way): its session gathers proof of the outcome and closes the epic
# on it (epic_verify_task), asking the human only when the proof is their word. Nothing else closes a
# landed epic (lifecycle.md, "Merged is not done"). Its slug carries the epic's done count, so a slug
# the queue ever held is never queued again: a verify that failed or found gaps waits for a human or
# for the gap rows to land, which raises the count and queues the next check. A profile with board
# automation off gets none. Admission never holds its add (`from: auto:epics`, agent-queue admit),
# however deep the queue: one item per landed epic. Its story row carries `#of/<epic>` (--epic), so
# the item links the epic it checks; notes reads a `check(epics)` row as no leaf (epics::is_epic_check),
# so it neither holds the epic open nor raises the done count that would key a second verify.
reconcile_epics() {
  [ "$DISPATCH_EPIC_VERIFY" = 1 ] || return 0
  local landed prof project id done_ title slug out rc
  landed=$(notes projects --stats --json 2>/dev/null | jq -r '.[] | select(.automation != false) | . as $p
    | (.epics // [])[] | select(.open == 0 and .done > 0)
    | [($p.profile // ""), $p.name, .id, .done, (.title | gsub("[\t\n]"; " "))] | join("\u001f")') || return 0
  [ -n "$landed" ] || return 0
  while IFS=$'\x1f' read -r prof project id done_ title; do
    slug="verify-$id-$done_"
    # One lookup per landed epic, active or done: the whole queue is seconds to read every pass.
    [ -z "$(agent-queue show "$slug" --json 2>/dev/null)" ] || continue
    out=$(epic_verify_task "$prof" "$project" "$id" "$title" | AGENT_QUEUE_PULL=dispatch AGENT_QUEUE_START=0 agent-queue add --project "$project" --slug "$slug" --epic "$id" \
      --title "check(epics): verify $id $title" --priority high --tags verify --from auto:epics 2>&1); rc=$?
    if [ "$rc" -eq 0 ]; then
      logline "queued $slug: every leaf of epic $id on $project has landed"
    elif [ "$rc" -ne "$AQ_EX_FINISHED" ]; then
      say "could not queue the verify of epic $id on $project: ${out##*$'\n'}"
    fi
  done <<<"$landed"
}

# epic_verify_task <profile> <project> <epic id> <title> -> the task of a verify item (reconcile_epics):
# what the epic promised, proof of it seen live, and the epic closed on that proof. item_brief gives
# a `verify` item proof_brief's close (its own story row and the item), never a PR.
epic_verify_task() {
  local pf=''
  [ -z "$1" ] || pf=" --profile $1"
  echo "Verify epic $3 on $2: \"$4\". Every leaf has landed, so it waits on proof of its outcome, and a PR only proves a leaf landed."
  echo "Read what it promised: its row on the human sheet and its leaves, plans and PRs (notes$pf projects --roadmap $2 --json). Then see that outcome work live and keep the evidence: a run id, a URL, a screenshot path, a command and its output."
  echo "When it works, close the epic on that evidence: notes$pf ptask $2 done $3 --proof \"<evidence>\". An open check(...): verify $3 row on the human sheet is this same check: close it with the same proof."
  echo "When part of it does not work, send one follow-up per gap under the epic (notes$pf ptask $2 --agent add \"fix(<area>): <gap> #size/<s|m|l> #of/$3\", which goes to the outbox for inbox-triage to file), leave the epic open, and close this item with those gaps named as its proof: the rows triage files, once they land, queue the epic's next verify."
  echo "Only when no artifact can prove it (a look, a feel, a play only the human can judge) post one agent-ask naming what to try and what counts as yes, and once they answer yes close the epic with --proof \"human: <their words>\"."
}

# waiting_sessions -> "<server>/<tmux session>" for each Claude waiting on its human (agent-panel),
# and the bare tmux session of each pending ask whose Claude is not working; fails when either cannot
# be read, so a pass that cannot see never moves an item. A session with an open question carries on
# with what does not depend on the answer, so a pending ask follows the panel while it is busy or in
# a shell (agent-panel's own `~`): counting only busy would flip a session on a gate every pass. An
# item names a session, not a window, so a session several Claudes share (a world session) says
# nothing about any one item and is left out: one window waiting would otherwise flip every item on it.
# The same two reads by Claude session id come out as "sid:<id>", for an item that records its own:
# one id is one Claude, so no session is shared there.
waiting_sessions() {
  local panel asks shared working wsids
  panel=$(agent-panel list --json 2>/dev/null) || return 1
  # --open: a session whose ask is parked still waits on its human; parking only hides the row.
  asks=$(agent-ask list --all --open 2>/dev/null) || return 1
  shared=$(jq -r 'select(.status != "shell") | .target | sub(":[^:/]*$"; "")' <<<"$panel" 2>/dev/null | sort | uniq -d)
  working=$(jq -r 'select(.status == "busy" or .status == "shell") | .target | sub(":[^:/]*$"; "") | sub(".*/"; "")' <<<"$panel" 2>/dev/null)
  wsids=$(jq -r 'select(.status == "busy" or .status == "shell") | .session_id // empty' <<<"$panel" 2>/dev/null)
  {
    jq -r 'select(.status == "waiting") | .target | sub(":[^:/]*$"; "")' <<<"$panel" 2>/dev/null
    cut -f13 <<<"$asks" | grep . | grep -vxF -f <(printf '%s\n' "$working")
  } | grep -vxF -f <(printf '%s\n' "$shared"; sed 's,.*/,,' <<<"$shared")
  {
    jq -r 'select(.status == "waiting") | .session_id // empty' <<<"$panel" 2>/dev/null
    cut -f16 <<<"$asks" | grep . | grep -vxF -f <(printf '%s\n' "$wsids")
  } | sed 's/^/sid:/'
  return 0
}

# firing_findings -> the shared faults firing now, one per line. Open is not firing: a finding stays
# open for an hour after its last sample, which would hold starts long after the fault cleared.
# A blind finding is not one: it says a reader has a gap (a worktree name the merges source cannot
# map, say), not that new work would make anything worse, so it holds nothing. Nor is a throughput
# drop: it names no stage that binds, so holding starts on it lowers the merges and live sessions
# it waits on, and it clears only once the fleet has starved to its demand floor (ar-3991); the
# stage it could mean holds on its own (a starved pool that binds on capacity or admission).
# Each line is {rule, scope, repos, bind}; held_by decides which items a finding is about.
firing_findings() {
  jq -c --argjson now "$(date +%s)" --argjson fresh "$DISPATCH_FINDING_FRESH_MIN" '
    select(.rule == "starved")
    | select((.epoch // $now) >= $now - $fresh * 60) | {rule, scope, repos, bind}'
}

# pending_load -> "<starts> <load>": the sessions started in the last DISPATCH_START_LOAD_MIN minutes
# (the `started` lines the log already holds) and the load they have
# not yet put on the 1-min average. A start's load arrives minutes late, so a loop of starts that
# each read the load sees the same low number; counting the starts closes that. Hand starts and a
# pass's own earlier starts are in the log the moment cmd_start returns. A resume counts too: a
# restored session boots and loads like a new one. A dry run writes no log line, so its own would-starts
# count instead, and it stops where the real pass would. An unreadable window refuses, like every gate.
pending_load() {
  local n
  [ "$DISPATCH_START_LOAD" != 0 ] || { echo "0 0.0"; return; }
  n=$(awk -v c="$(date -d "-$DISPATCH_START_LOAD_MIN min" '+%Y-%m-%d %H:%M')" '$4 == "started" && ($2 " " $3) >= c' "$LOG" 2>/dev/null | grep -c . || true)
  [ "${DRY:-0}" != 1 ] || n=$(( ${n:-0} + ${STARTED:-0} ))
  LC_ALL=C awk -v n="${n:-0}" -v l="$DISPATCH_START_LOAD" 'BEGIN { printf "%d %.1f\n", n, n * l }'
}

# load_why <red 0|1> -> why this machine's load holds a start, or nothing; a red floor start goes past it.
# over_pace <load> <cores> [pending] -- that load, plus what recent starts will add, is over the
# MAX_LOAD pace per core. This machine's gate (its load from pace_load) and each fleet worker's
# (its probe's 1-min load, host_why) read it the same way.
over_pace() { awk -v l="$1" -v c="$2" -v p="${3:-0}" -v m="$MAX_LOAD" 'BEGIN { exit !((l + p) / c > m) }'; }

# cpu_jiffies -> "<busy> <total>" since boot from the aggregate cpu line of /proc/stat. Iowait counts
# busy: a CPU waiting on a disk has no room a new session's git and installs would not fight for.
cpu_jiffies() { awk '$1 == "cpu" { b = $2 + $3 + $4 + $6 + $7 + $8 + $9; printf "%.0f %.0f\n", b, b + $5; exit }' "$DISPATCH_PROC_STAT" 2>/dev/null; }

# cpu_sample -- add this machine's /proc/stat reading to DISPATCH_CPU_SAMPLES, "<epoch> <busy> <total>"
# a line, oldest first, keeping those of the last CPU_SPAN_MAX seconds. The minute record (cmd_record)
# takes one, so the load pace reads CPU busy over the last minute or so without a sample of its own.
cpu_sample() {
  local j f="$DISPATCH_CPU_SAMPLES"
  j=$(cpu_jiffies) && [ -n "$j" ] || return 0
  mkdir -p "${f%/*}" 2>/dev/null
  { { awk -v now="$(date +%s)" -v hi="$CPU_SPAN_MAX" 'NF == 3 && now - $1 <= hi' "$f" 2>/dev/null; echo "$(date +%s) $j"; } > "$f.$$" && mv -f "$f.$$" "$f"; } 2>/dev/null || rm -f "$f.$$"
}

# cpu_busy <cores> -> the cores busy now, from the /proc/stat delta since the newest sample
# (cpu_sample) at least CPU_SPAN_MIN seconds old; nothing when no sample is from the last
# CPU_SPAN_MAX seconds or /proc/stat is unread. Under CPU_SPAN_MIN one frame swings (a 2 s top
# frame read 17-41% within one busy hour, ar-975); past CPU_SPAN_MAX it is no longer now.
CPU_SPAN_MIN=30 CPU_SPAN_MAX=300
cpu_busy() {
  local j
  j=$(cpu_jiffies) && [ -n "$j" ] || return 0
  awk -v now="$(date +%s)" -v j="$j" -v c="$1" -v lo="$CPU_SPAN_MIN" -v hi="$CPU_SPAN_MAX" '
    NF == 3 && now - $1 >= lo && now - $1 <= hi { b = $2; t = $3; got = 1 }
    END { split(j, n, " "); if (got && n[2] > t) printf "%.1f\n", (n[1] - b) / (n[2] - t) * c }' "$DISPATCH_CPU_SAMPLES" 2>/dev/null
}

# pace_load <cores> -> "<load> <load1> <busy>": the load this machine's pace judges, the lower of the
# 1-min load average and the cores busy now (cpu_busy), then each reading ("-" for one unread). Load
# average lags a spike by minutes and counts threads blocked in the kernel, which use no CPU: on
# 2026-11-17 the 0.9 pace held 150+ runnable items for an hour with the CPU 66% idle (ar-2851). A CPU
# at the pace, or waiting on its disks, reads busy too, and fleet-assess's HOLD still judges load average alone.
pace_load() {
  local load1 busy
  load1=$(cut -d' ' -f1 "$DISPATCH_LOADAVG" 2>/dev/null)
  busy=$(cpu_busy "$1")
  if [ -n "$busy" ] && awk -v b="$busy" -v l="${load1:-0}" 'BEGIN { exit !(b < l) }'; then
    echo "$busy ${load1:--} $busy"
  else
    echo "${load1:-0} ${load1:--} ${busy:--}"
  fi
}

load_why() {
  local load load1 busy cores starts pend
  cores=$(nproc 2>/dev/null || echo 1)
  read -r load load1 busy < <(pace_load "$cores")
  read -r starts pend < <(pending_load)
  [ "$1" = 0 ] && over_pace "$load" "$cores" "$pend" &&
    echo "load ${load}$([ "$busy" = - ] || echo " (1-min load $load1, $busy cores busy; the pace reads the lower)")$([ "$starts" = 0 ] || echo " plus $pend for $starts started in the last ${DISPATCH_START_LOAD_MIN} min") on ${cores} cores is over the ${MAX_LOAD} pace"
  return 0
}

# assess_why <red 0|1> -> "fleet-assess says HOLD" while fleet-assess puts this machine over its high
# mark (load, memory, stall, temperature, a local load hold), or nothing; the red floor goes past it.
# It reads only this machine, so like load_why it holds a start here, not one a fleet worker takes.
# <1> is 1 on the red floor, which goes past every HOLD, and 2 on the plan load floor, which goes past a
# HOLD on load alone: its probe puts load's mark out of reach, as fleet-assess's verdict names only its
# first reason and load comes first, so memory, stall and temperature still hold by its own thresholds,
# and "HOLD held, load ..." is load's low mark.
assess_why() {
  local v
  [ "$1" != 1 ] || return 0
  if [ "$1" = 2 ]; then
    v=$(FLEET_HOLD_LOAD_X=1000000 fleet-assess --watch-probe 2>/dev/null) && return 0
    [[ "$v" == "HOLD held, load "* ]] && return 0
  else
    fleet-assess --watch-probe >/dev/null 2>&1 && return 0
  fi
  echo "fleet-assess says HOLD"
}

# machine_why -> this machine's own holds (assess_why, load_why), "; "-joined, or nothing.
# gate reads it whole and drops it while a fleet worker is open; pick_item reads it per start.
machine_why() {
  local red=0 assess=0 p parts=() out
  if red_floor_open; then red=1 assess=1; elif plan_load_floor_open; then red=1 assess=2; fi
  for p in "$(assess_why "$assess")" "$(load_why "$red")"; do [ -z "$p" ] || parts+=("$p"); done
  [ "${#parts[@]}" -gt 0 ] || return 0
  out=$(printf '%s; ' "${parts[@]}"); printf '%s' "${out%; }"
}

# machine_here_why -> machine_why while no fleet worker takes a session (remote_open), else nothing:
# this machine's own pace holds only a start here, so while a worker takes one the pass goes on and
# pick_item places each item on whichever is open (place_host). gate reads it, and so does the
# trainee floor for its claude starts (trainee_floor_start), whose own gate skips it.
machine_here_why() {
  local mach
  mach=$(machine_why)
  [ -z "$mach" ] || ! remote_open || mach=''
  printf '%s' "$mach"
}

# gateway_why -> why the LiteLLM gateway cannot serve a run now, or nothing: its unauthenticated
# /health/readiness must answer status healthy with its database connected (budgets and keys live there).
# Unreadable refuses, as every gate does.
gateway_why() {
  local url body said
  url=$(jq -er '.gateway.url' "$HARNESSES" 2>/dev/null) || { echo "the gateway is unread ($HARNESSES names no gateway.url)"; return 0; }
  body=$(curl -sS -f -m 10 "$url/health/readiness" 2>/dev/null) || body=''
  jq -e '.status == "healthy" and ((.db // "connected") == "connected")' <<<"$body" >/dev/null 2>&1 && return 0
  said=$(jq -r '[.status, .db] | map(select(type == "string")) | join(", ")' <<<"$body" 2>/dev/null)
  echo "the gateway is not ready ($url/health/readiness: ${said:-no answer})"
}

# floor_gate -- FLOOR_WHY, why a floor of gateway harnesses (trainees, canaries) is shut: gate's
# answer, else the gateway when the cluster is red or unreadable (load_gateway_down). The gateway is the
# floor's one cluster dependency: a red k3s domain shut every trainee start on 11-19 while it answered (ar-3699).
floor_gate() {
  FLOOR_WHY=$(gate)
  [ -n "$FLOOR_WHY" ] || { load_gateway_down; FLOOR_WHY=$GATEWAY_DOWN; }
  return 0
}

# cluster_item <item json> -- rc 0 for cluster work: an item of a project DISPATCH_CLUSTER_PROJECTS
# names, which waits while the k3s domain is red or unreadable (pick_item). Every other item starts
# whatever the cluster says.
cluster_item() { [[ " $DISPATCH_CLUSTER_PROJECTS " == *" $(jq -r '.project // ""' <<<"$1") "* ]]; }

# load_gateway_down -- GATEWAY_DOWN, read once a pass (cmd_run clears GATEWAY_READ): "<infra words>,
# and <gateway_why>" when the cluster is red or unreadable and the LiteLLM gateway does not answer
# ready, else nothing. A start that spends the gateway waits on it (floor_gate, route).
load_gateway_down() {
  local infra
  [ "${GATEWAY_READ:-0}" = 1 ] && return 0
  GATEWAY_READ=1 GATEWAY_DOWN=''
  infra=$(fleet-shepherd infra 2>/dev/null); [ -n "$infra" ] || return 0
  GATEWAY_DOWN=$(gateway_why); [ -z "$GATEWAY_DOWN" ] || GATEWAY_DOWN="$infra, and $GATEWAY_DOWN"
}

# gate -> why this pass must not start anything, or nothing when it may. Anything it cannot read
# refuses: a start nobody can justify costs more than waiting for the next pass. Findings are not
# here: one is about a pool or a repo, so pick_item asks them per item.
# A nightly red is deliberately not here: nightlies stay red while sessions merge normally, so it
# would stop everything, and the shepherd's NIGHTLY row handles it.
# Every gate is read and every closed one named, joined by "; ": naming the first only hid a load
# hold behind an account hold for a whole day. A hold stops the reading: nothing else matters then.
# TRAINEE_GATE=1 (trainee_floor_why) reads neither the Claude accounts nor this machine's load: a
# trainee start spends its own free source, which route checks, and pick_item judges the load of the
# host it places on. The dispatcher's own load and an unreadable Claude usage shut it on 11-18 while
# every trainee run went to razer-laptop at load 4 (ar-3507).
gate() {
  local load github rc out hold why=()
  # A hold names who set it and why ("by <who>: <reason>"), which the Stopped line shows.
  hold=$(agent-hold check dispatch 2>/dev/null) ||
    { hold=$(sed -nE '1s/^held: [^ ]+ since [^ ]+ //p' <<<"$hold"); echo "held (agent-hold dispatch)${hold:+ $hold}"; return; }
  if [ "${TRAINEE_GATE:-0}" = 0 ]; then
    # The verdict's own words say which account is short and why (ACCT_WHY); keep them.
    acct_room; rc=$?
    case $rc in
      0) ;;
      # No account room is not a stop while another source a harness spends has room (start_item
      # routes there); unreadable usage always is.
      1) other_room || why+=("$ACCT_WHY, and no other source has room") ;;
      *) why+=("account usage unreadable ($ACCT_WHY)") ;;
    esac
    local mach
    mach=$(machine_here_why)
    [ -z "$mach" ] || why+=("$mach")
  fi
  # The cluster is no gate here: a red k3s domain holds only cluster work (cluster_item, in pick_item)
  # and starts that spend the gateway (load_gateway_down, in route and floor_gate).
  github=$(fleet-assess --github 2>/dev/null)
  case "$github" in
    '' | *unreadable*) why+=("github budget unreadable") ;;
    *LOW*) why+=("$github") ;;
  esac
  [ "${#why[@]}" -eq 0 ] && return
  out=$(printf '%s; ' "${why[@]}"); echo "${out%; }"
}

# judge_failed -- the words a pass whose judge failed carries, with the judge's own reason.
judge_failed() { printf 'could not judge the new rows%s' "${JUDGE_WHY:+ ($JUDGE_WHY)}"; }

# settle <outcome> <why>: say what this pass did and publish it for fleet-liveness. agentctl turns
# a run that publishes nothing into STALLED. A dry run is not a run. A FAILED or BLOCKED pass's
# words are its reason (proof_outcome).
settle() {
  [ "${PLAN_TAGGED:-0}" = 0 ] || set -- "$1" "tagged $PLAN_TAGGED for a plan; $2"
  case "${TRIAGE_FAILED:+x}:$1" in
    x:NOOP | x:BLOCKED) set -- FAILED "triage failed ($TRIAGE_FAILED); $2" ;;
    x:*) set -- "$1" "triage failed ($TRIAGE_FAILED); $2" ;;
  esac
  case "${JUDGE_RC:-0}:$1:$2" in
    0:* | *:"could not judge"*) ;;
    "$EX_BUDGET":NOOP:*) set -- BLOCKED "budget: $(judge_failed); $2" ;;
    # A gate held the pass, so the gate is its reason and the judge's stop a note before it: as a
    # "budget:" lead it named the judge's daily cap as the stop on every surface (ar-1675).
    "$EX_BUDGET":BLOCKED:*) set -- BLOCKED "$(judge_failed); $2" ;;
    *:NOOP:* | *:BLOCKED:*) set -- FAILED "$(judge_failed); $2" ;;
    *) set -- "$1" "$(judge_failed); $2" ;;
  esac
  say "$2"
  # A kick is no pass: its stops are said, never published as fleet-dispatch's outcome, which would end or
  # set the hold and the liveness proof of the pass that reads the whole fleet (KICK, cmd_kick).
  [ "$DRY" = 0 ] && [ "${KICK:-0}" = 0 ] || return 0
  # A pass that started an item past a closed gate (start_item sets FLOOR_HELD) leaves the hold
  # standing (held_since): its WORKED and any later NOOP prove no gate open.
  [ "${FLOOR_HELD:-0}" = 1 ] && local PROOF_HELD_KEEP=1
  # shellcheck source=/dev/null
  . "$HOME/.local/lib/agent-proof.sh" 2>/dev/null || return 0
  proof_outcome fleet-dispatch "$1" "$2" 2>/dev/null || true
}

# settle_board <outcome> <why> -- settle a pass on its board step. A pass that came here past held
# queue items and starts nothing is BLOCKED by the hold, never a NOOP that dashboards read as green.
settle_board() {
  if [ "${STARTED:-0}" -gt 0 ] && [ "$1" = NOOP ]; then say "$2"   # the pass already published WORKED
  elif [ -n "${QUEUE_HELD:-}" ] && [ "$1" = NOOP ]; then settle BLOCKED "$QUEUE_HELD; $2"
  elif [ -n "${SHARE_HELD:-}" ] && [ "$1" = NOOP ]; then settle NOOP "$SHARE_HELD; $2"; else settle "$@"; fi
}

# triage_pass: reds become rows and red items before the pass counts its room, so a fix queued here
# starts this pass. The guards live in fleet-bench. A failure is named in the outcome, never stops the pass.
# It reports under fleet-bench's own name: under this unit's AGENTCTL_NAME its NOOP or WORKED became
# this pass's, and ended a standing hold (held_since) at the top of every pass.
triage_pass() {
  local out
  out=$(AGENTCTL_NAME=fleet-bench fleet-bench triage 2>&1) || TRIAGE_FAILED=$(tail -n 1 <<<"$out" | cut -c1-100)
}

# pass_mark <step> -- add "<step> <s>s", the seconds since the last mark, to PASS_TIMES; main says the
# whole line when the pass ends, so a slow pass names its slow step (ar-4911: 6 to 16 min a pass).
pass_mark() { PASS_TIMES+="${PASS_TIMES:+, }$1 $(( SECONDS - ${PASS_MARK:-0} ))s"; PASS_MARK=$SECONDS; }

# The longest a timed pass waits for a kick's lock: a kick starts a session or two, so well under it.
KICK_WAIT_S=${KICK_WAIT_S:-120}

# pass_reset -- the per-pass state a `run` pass and a `kick` start from.
pass_reset() {
  HUMAN_PASS=0 SPRINT_PASS=0 PLAN_PASS=0 PLAN_STARTED=0 PLANS_STARTED=''
  QUEUE_HELD='' SHARE_HELD='' SHARE_STATE='' PREEMPTED=0 STARTED=0 RED_STARTED=0 RED_PASS=0 RUN_GATED=0 FLOOR_HELD=0 FLOOR_GATE='' GATEWAY_READ=0 JUDGE_RC= JUDGE_WHY= PLAN_TAGGED=0 TRIAGE_FAILED= NO_ROOM=
  NO_ROUTE=(); unset NEXT_QUEUED   # set once a pass has read the queue (trainee or sprint floor), even to nothing
}

# pass_room -- how many sessions a pass may start now. Sets the caller's locals live (this machine's
# run units), gap (the pace target less every live session) and room (the starts that fit, per-pass cap
# included); also UNITS_FREE and FLOOR_LIVE. Read after pace_target.
pass_room() {
  local runs h remote=0; runs=$(live_runs)
  live=$(units_on '' <<<"$runs")
  FLOOR_LIVE=$(grep -c . <<<"$runs" || true)
  probe_hosts "$runs"
  RED_LIVE=$(live_reds | grep -c . || true) RED_WATCH=$(watch_reds) PLAN_LIVE=$(live_plans | grep -c . || true)
  UNITS_FREE=$(( TARGET - live ))
  # Room is this machine's units plus every placed worker's.
  # A worker adds room only when it takes a session now (host_why), not merely by being placed.
  for h in "${!HOST_FREE[@]}"; do [ -n "$(host_why "$h")" ] || remote=$(( remote + HOST_FREE[$h] )); done
  room=$UNITS_FREE; [ "$room" -ge 0 ] || room=0
  room=$(( room + remote ))
  # The target counts every live session, hand starts too. At it no unit is free, so only an urgent item or
  # fresh ask that parks a runner session for itself starts (preempt_pick): the total stays where it is.
  gap=$(( TARGET - TOTAL_LIVE )); [ "$gap" -gt 0 ] || { gap=0; UNITS_FREE=0; }
  [ "$room" -le "$gap" ] || room=$gap
  [ "$PER_PASS" -gt 0 ] && [ "$room" -gt "$PER_PASS" ] && room=$PER_PASS
  return 0
}

# cmd_kick -- the fast path an event runs: start what is already queued against the room, in seconds.
# The same gates, pace target and start as a pass (load_gates, pass_room, run_queue), over the queue as it
# stands: no reap, triage, judge, board fill or floor, which the timed `run` keeps. A pass holding the lock
# already covers the event, so the kick stands down; it publishes no outcome (settle, KICK).
cmd_kick() {
  KICK=1 DRY=0
  mkdir -p "$DIR"
  exec 9>"$DIR/.lock"
  flock -n 9 || { settle NOOP "kick: a pass is running, it covers this"; return 0; }
  # The mark tells a timed pass that the lock is a kick's, held for seconds: it waits (cmd_run), where a
  # pass holding the lock is waited on by nobody. Burst kicks would otherwise leave every timed pass a NOOP.
  : > "$DIR/.kick"
  local rc; kick_start; rc=$?
  rm -f "$DIR/.kick"
  return "$rc"
}

# kick_start -- cmd_kick past its lock: the gates, the room, the start.
kick_start() {
  local live room gap
  fleet_hosts >/dev/null
  # `agent-hold check` exits 0 when nothing holds dispatch, as cmd_run reads it.
  agent-hold check dispatch >/dev/null 2>&1 || { settle NOOP "kick: held (agent-hold dispatch), starting nothing"; return 0; }
  GATES_LOADED=''; load_gates
  pass_reset
  pace_target
  [ -n "$TOTAL_LIVE" ] || { settle NOOP "kick: live sessions unreadable (the fleet state document is missing or stale), the pass reads it"; return 0; }
  # The state document is a snapshot: sessions started since it was written are not in it, and a burst of
  # kicks would each see the same gap. Count them as live (a pass starts once a quarter hour, so has no burst).
  local since fresh_started
  since=$(jq -r '.generated_epoch // 0' "$FLEET_STATE_FILE" 2>/dev/null)
  fresh_started=$(agent-queue list --json --state running 2>/dev/null | jq -s --argjson s "${since:-0}" \
    '[.[] | select(((.started // "") | sub("\\.[0-9]+"; "") | try fromdateiso8601 catch 0) >= $s)] | length' 2>/dev/null)
  TOTAL_LIVE=$(( TOTAL_LIVE + ${fresh_started:-0} ))
  pass_room
  [ "$room" -gt 0 ] || { settle NOOP "kick: at the pace target ($TOTAL_LIVE of $TARGET live), starting nothing"; return 0; }
  local items; items=$(next_items --points)
  [ -n "$items" ] || { settle NOOP "kick: nothing queued to start"; return 0; }
  run_queue "$items" "$room"; local rc=$?
  [ "${STARTED:-0}" -eq 0 ] || say "kick: started $STARTED"
  return "$rc"
}

cmd_run() {
  local why live room gap
  fleet_hosts >/dev/null   # once, so each subshell of the pass inherits the roster
  DRY=0
  [ "${1:-}" = --dry-run ] && DRY=1
  mkdir -p "$DIR"
  exec 9>"$DIR/.lock"
  # A NOOP that never read the gates leaves a standing hold as it is (PROOF_HELD_KEEP, agent-proof.sh).
  # A kick holds it for seconds: the pass waits out KICK_WAIT_S for it, never for another pass.
  flock -n 9 || { [ -e "$DIR/.kick" ] && flock -w "$KICK_WAIT_S" 9; } || { PROOF_HELD_KEEP=1 settle NOOP "another pass is running"; return 0; }

  [ "$DRY" = 1 ] || { cmd_reap; pass_mark reap; provider_hold_scan; pass_mark scan; }   # the scan reads the runs the reap just closed
  # Once a pass, so each subshell of the pass reads the same gates; after the reap, whose returns
  # write gates onto the rows they un-start (agent-queue return_gates).
  GATES_LOADED=''; load_gates; pass_mark gates
  pass_reset
  [ "$DRY" = 1 ] || { triage_pass; pass_mark triage; }
  # Each skip takes the exit its rule names (plan, the human, a gate); a dry run only reads.
  [ "$DRY" = 1 ] || ! agent-hold check dispatch >/dev/null 2>&1 || skip_exits
  pace_target
  [ -n "$TOTAL_LIVE" ] || { settle BLOCKED "live sessions unreadable: the fleet state document ($FLEET_STATE_FILE) is missing or older than $DISPATCH_STATE_FRESH_MIN min, so the pace target cannot be read"; return 0; }
  say "pace target: $TOTAL_LIVE of $TARGET live sessions (the human is $TARGET_WHEN: the live ones plus the Opus sessions the Claude spend has spare at pace, at most present $DISPATCH_TARGET_PRESENT, away $DISPATCH_TARGET_AWAY)$NEEDS_NOTE"
  unpark_preempted
  pass_room
  # A full fleet is working, not blocked: NOOP, unless an urgent item or fresh ask may preempt a runner session
  # (preempt_pick); then the pass, past the gate, picks among those (preempt_items) and starts at most one.
  local urgent=''; [ "$room" -gt 0 ] || urgent=$(preempt_items)
  # An urgent item or fresh ask that waits on run units alone, with no runner session to park for it, goes on to
  # the red floor: returning there held every red for a day behind three heavy urgent items (11-13).
  # A start, a park, a finding's hold or an error ends the pass here as before.
  if [ -n "$urgent" ] && [ -z "$(gate)" ]; then
    local before=${STARTED:-0} urc; PREEMPT_PARKED=0; start_items "$urgent" 1; urc=$?
    [ "$urc" = 0 ] && [ "${STARTED:-0}" -eq "$before" ] && [ "${PICK_FULL:-0}" = 1 ] && [ "$PREEMPT_PARKED" = 0 ] || return "$urc"
  fi
  sprint_top_up "$room" || JUDGE_RC=$SPRINT_JUDGE_RC JUDGE_WHY=$SPRINT_JUDGE_WHY
  # Canaries are queued here (canary_top_up) and start in queue order like any item.
  canary_top_up
  # The side floors start past the target, in this order, before the queue order buries what they hold: each
  # trainee's row and a due batch review (trainee_floor_start, queued or promoted from the board in the same
  # step) and the urgent rows of an open sprint (sprint_floor_start). With room, each start takes one of it,
  # so the pass starts no more than before; a park, a finding's hold or an error ends the pass here.
  local floor_fn frc fbefore
  for floor_fn in trainee_floor_start sprint_floor_start; do
    fbefore=${STARTED:-0}; "$floor_fn"; frc=$?
    case "$frc" in 0 | "$FLOOR_SHUT") ;; *) return "$frc" ;; esac
    if [ "${STARTED:-0}" -gt "$fbefore" ]; then
      unset NEXT_QUEUED; room=$(( room - STARTED + fbefore )); [ "$room" -ge 0 ] || room=0
    fi
  done
  if [ "$room" -le 0 ]; then
    local full="$live of $TARGET run units${HOST_FREE[*]:+, every fleet worker full}"
    [ "$gap" -gt 0 ] || full="$TOTAL_LIVE live sessions, the $TARGET_WHEN pace target is $TARGET$NEEDS_NOTE"
    # The red floor goes past a full fleet as it goes past load and the weekly pace: from 11-12 11:40
    # a fleet over its target started no red for 21h while 20 watch reds waited (ar-1531 wants an
    # owner on each the hour it trips). Its own bound, DISPATCH_RED_FLOOR plus one per tripped watch
    # (red_floor_open, read again each start), caps what starts; the run units it lifts here.
    local reds queued='' slots; slots=$(red_floor_slots)
    [ "$PER_PASS" -gt 0 ] && [ "$slots" -gt "$PER_PASS" ] && slots=$PER_PASS
    if [ "$slots" -gt 0 ]; then queued=${NEXT_QUEUED-$(next_items --points)}; reds=$(red_items "$queued"); fi
    if [ "$slots" -gt 0 ] && red_floor_due "$reds"; then
      UNITS_FREE=$(( slots * 2 )) red_floor_start "$reds" "$slots" "pace target: $full"; return
    fi
    # Nothing else interrupts a full target: canaries, plan phases and idle projects wait their turn
    # in the class mix (plan vast-soaring-prism P3).
    local before=${STARTED:-0} prc
    # The pace target is Claude's: an item that routes to another source with room starts past it.
    if [ "$gap" -le 0 ]; then
      [ -n "$queued" ] || queued=${NEXT_QUEUED-$(next_items --points)}
      other_source_start "$queued" "pace target: $full"; prc=$?
      case "$prc" in 0 | "$FLOOR_SHUT") ;; *) return "$prc" ;; esac
      [ "${STARTED:-0}" -eq "$before" ] || return 0
    fi
    PROOF_HELD_KEEP=1 settle_board NOOP "at $full, starting nothing"; return 0
  fi
  # The queue comes first; the board tops it up while fewer than DISPATCH_LOW_WATER items are
  # runnable, so the next pass has work before this one runs dry. An item a firing finding holds is
  # not runnable, so the pass goes on to the board, whose rows pass the same holds. On 2026-11-05 held
  # unity items kept every pass off the board for 7h: the rows filed to fix the hold never started,
  # and 220 rows sat unjudged. Above the low water, a floor still reads the board for its own rows
  # only (low_water_floors).
  local items rc depth want cgap rgap pgaps only=''; items=${NEXT_QUEUED-$(next_items --points)}
  if [ -n "$items" ]; then
    HELD_FALLS_THROUGH=1; run_queue "$items" "$room"; rc=$?; HELD_FALLS_THROUGH=0
    if [ -z "$QUEUE_HELD$SHARE_HELD" ]; then
      [ "$rc" -eq 0 ] && [ "$RUN_GATED" = 0 ] || return "$rc"
      depth=$(queue_depth)
      if [ "$depth" -lt "$DISPATCH_LOW_WATER" ]; then
        say "runnable $depth is under the low water $DISPATCH_LOW_WATER, topping the queue up from the board"
      else
        rgap=$(class_gap requested requested); cgap=$(class_gap cleanup cleanup); pgaps=$(project_gaps)
        only=$(low_water_floors "$rgap" "$cgap" "$pgaps"); [ -n "$only" ] || return 0
      fi
    fi
  fi
  # Every gate: presence is none of them, here or away.
  why=$(gate)
  if [ -n "$why" ]; then
    PROOF_HELD_KEEP=1 settle_board NOOP "$why, starting nothing"
    [ "$DRY" = 1 ] || return 0
  fi
  room=$(( room - STARTED ))
  # Promote to the low water, or to the units this pass can start if that is more.
  want=$(( DISPATCH_LOW_WATER - ${depth:-0} )); [ "$want" -gt "$room" ] || want=$room
  if [ -n "$only" ]; then
    want=0
    [[ " $only " != *" requested "* ]] || want=$rgap
    [[ " $only " != *" cleanup "* ]] || want=$(( want + cgap ))
    want=$(( want + $(awk '{ n += $1 } END { print n + 0 }' <<<"$pgaps") ))
  fi
  # The floors and the low water top up under the cap, never past it; committed rows take what it leaves.
  local qroom; qroom=$(queue_headroom); [ "$want" -le "$qroom" ] || want=$qroom

  # Unread findings would hold whatever fill promotes, so they stop the pass before the judge.
  load_findings || { settle_board NOOP "fleet-bench findings unreadable, starting nothing"; [ "$DRY" = 1 ] || return 0; }
  fill_day "$want" "$only" "$qroom" || { settle FAILED "$(judge_failed)"; return 1; }
  if [ "$DRY" = 1 ]; then [ "$FILLED" -gt 0 ] || settle_board NOOP "no row qualifies this pass"; return 0; fi
  [ "$room" -gt 0 ] || return 0
  local let_go; let_go=$(share_let_go "$only" "$FILLED") || return 0
  # Past the gates already: what fill promoted starts now, through the same start as any item.
  items=$(next_items --points)
  [ -n "$items" ] || { settle_board NOOP "no row qualifies this pass"; return 0; }
  SHARE_LET_GO=$let_go start_items "$(pass_order "$items")" "$room"   # the one unfiltered start the fleet share cap may let go in
}

# low_water_floors <requested gap> <cleanup gap> [project gaps] -> the classes a run pass over the low water still
# reads the board for, space-separated: `requested` and `cleanup` while their class is under its classes.json
# min_live (class_gap), `project:<name>` for each project of a project class under its min_live
# (project_gaps' lines), and `gated` on every pass, for committed rows (an agent row whose #at/, #after/
# or other gates all cleared), which wait on no depth: on 2026-11-19, with 38 items runnable, ar-2894
# sat 10h past its #at/ and seven #after/ rows past the rows they waited on.
low_water_floors() {
  local only=''
  if [ "$1" -gt 0 ]; then
    only=requested
    say "requested is $1 under its min_live, topping requested rows up from the board"
  fi
  if [ -n "${DISPATCH_CLEANUP_PROJECTS// }" ] && [ "$2" -gt 0 ]; then
    only="${only:+$only }cleanup"
    say "cleanup is $2 under its min_live, topping cleanup up from the board"
  fi
  local gap ps p
  while read -r gap ps; do
    [ -n "$ps" ] || continue
    say "$ps is $gap under its min_live, topping $ps rows up from the board"
    for p in $ps; do only="${only:+$only }project:$p"; done
  done <<<"${3:-}"
  only="${only:+$only }gated"
  printf %s "$only"
}

# share_let_go <floors> <promoted> -> 1 when the fleet share cap may let go for the pass's start, 0 when
# it may not, and fails when the pass has nothing new to start. Committed rows alone brought a pass over
# the low water here: run_queue already ran the queue, so with nothing promoted there is nothing new to
# start, and the share cap does not let go for them. A project floor (`project:<name>`) counts as
# gated here: its rows are product rows like any committed one, so it lets go of nothing either.
share_let_go() {
  local f rest=''
  for f in $1; do [[ "$f" == project:* ]] || rest="${rest:+$rest }$f"; done
  [ "$rest" = gated ] || { echo 1; return 0; }
  [ "$2" -gt 0 ] || return 1
  echo 0
}

# unjudged_rows ->the open rows no verdict covers yet, tier-3 rows and day candidates, once each. A
# row both list goes to the judge as its tier-3 copy (tier 3, the highest the gate allows it), so the
# judge may `dispatch` it at any tier: picks takes a tier 1 or 2 dispatch, t3_ready a tier 3 one.
# A gated row (cmd_candidates) is never judged: its gates cleared, so it is committed work.
unjudged_rows() { { t3_rows "$(judged_keys)"; cmd_candidates; } | jq -sc 'map(select(.gated | not)) | unique_by([.project, .lane, .key])[]'; }

# fill_now <room> -- `fill` by hand: up to <room> day picks (fill_day).
fill_now() { fill_day "$1"; }

# judge_once -- judge the open rows no verdict covers, once a pass, however many fills ask. A dry
# run never judges: it names what the cache says, and verdicts.jsonl stays as it was. A budget stop
# is not a failed fill: the cached verdicts still pick, and settle names the stop.
judge_once() {
  if [ -z "${JUDGE_RC:-}" ]; then
    JUDGE_RC=0
    if [ "$DRY" != 1 ]; then
      judge "$(OFF_SAY=1 unjudged_rows)"; JUDGE_RC=$?
    fi
  fi
  [ "$JUDGE_RC" = "$EX_BUDGET" ] || return "$JUDGE_RC"
}

# day_picks <room> -> the rows a session may take: picks over every open row, judged ones
# included (a row judged on an earlier pass can be picked now), and the tier-3 rows (t3_picks, which
# merge behind the red-fix gate), in RANK_JQ order, one day row an area (a tier-3 row holds none), up to <room>.
day_picks() {
  { picks "$(all_open)" 999; t3_picks "$(t3_rows '')"; } |
    jq -sc --argjson room "$1" "$RANK_JQ"'rank | unique_by([.project, area_key]) | rank | .[:$room] | .[]'
}

# row_task <candidate row> -> the task promote gives its item: the row's own words.
row_task() { jq -r .text <<<"$1" | sed 's/^- \[.\] //'; }

# fill_day <room> [floors] [cap room] -- promote up to <room> day_picks into the queue, `from: board:`;
# with <cap room> (a run pass's queue headroom) every committed (`gated`) pick goes too, ahead of the
# <room> others and up to <cap room> in all, since its gates clearing is its start. A cleanup
# row's item is tagged `cleanup` (the floor counts them), and every item `tier<N>` (item_tier). With
# `cleanup`, `requested`, `gated`, `sprint` or `project:<name>` (the floors: over the low water, and sprint_top_up's on every
# pass) every scan under it, the judge's included when this pass has not judged yet, reads only those rows
# (floor_row). A full fleet share (share_full) leaves the fleet's rows out, the tier-3 gate's too.
fill_day() {
  local picked c tags pl CLEANUP_ONLY=${CLEANUP_ONLY:-} REQUESTED_ONLY=${REQUESTED_ONLY:-}
  [[ " ${2:-} " != *" cleanup "* ]] || CLEANUP_ONLY=1
  [[ " ${2:-} " != *" requested "* ]] || REQUESTED_ONLY=1
  local GATED_ONLY=${GATED_ONLY:-} SPRINT_ONLY=${SPRINT_ONLY:-} FLOOR_PROJECTS=${FLOOR_PROJECTS:-} f
  [[ " ${2:-} " != *" gated "* ]] || GATED_ONLY=1
  for f in ${2:-}; do [[ "$f" != project:* ]] || FLOOR_PROJECTS="${FLOOR_PROJECTS:+$FLOOR_PROJECTS }${f#project:}"; done
  [[ " ${2:-} " != *" sprint "* ]] || SPRINT_ONLY=1
  FILLED=0
  # Committed rows alone want no judge: a gated row is never judged (unjudged_rows).
  load_pool_idle   # once, before the judge's and the picks' subshells
  [ "${2:-}" = gated ] || judge_once || return 1
  picked=$(day_picks 999)
  # While the fleet share is full, the fill passes over fleet rows but #red ones and #requested ones in
  # the human's words (no `agent` in asker_map), the cleanup floor's included: a row's item comes from
  # the board, so share_held would hold any other. It lets go when nothing else can start: a low-water
  # fill with no other row and nothing runnable in the queue takes the fleet rows too.
  if share_full; then
    local kept
    asker_map
    kept=$(jq -c --argjson s "$SHARE_STATE" --argjson askers "$ASKER_MAP" '(.project // "") as $p
      | (.key // "") as $id
      | select((any($s.projects[]; . == $p) | not) or ((.text // "") | test("(^|\\s)#red(\\s|$)"))
          or (((.text // "") | test("(^|\\s)#requested(\\s|$)")) and $askers[$id] != "agent"))' <<<"$picked")
    if [ -n "$kept" ] || [ -n "${2:-}" ] || [ -n "$(runnable 2>/dev/null)" ]; then
      [ "$kept" = "$picked" ] || say "the fleet share is full ($(jq -r '"\(.fleet) of \(.total)"' <<<"$SHARE_STATE") starts in ${DISPATCH_FLEET_SHARE_H}h, DISPATCH_FLEET_SHARE=$DISPATCH_FLEET_SHARE%), so the board fills from other projects"
      picked=$kept
    fi
  fi
  if [ -n "${3:-}" ]; then
    local committed rest
    committed=$(jq -c 'select(.gated == true)' <<<"$picked"); committed=$(head -n "$3" <<<"$committed")
    rest=$(( $3 - $(grep -c . <<<"$committed" || true) )); [ "$rest" -le "$1" ] || rest=$1
    picked=$(printf '%s\n' "$committed"; jq -c 'select(.gated != true)' <<<"$picked" | awk -v n="$rest" 'NR<=n')
  else
    picked=$(head -n "$1" <<<"$picked")
  fi
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    FILLED=$(( FILLED + 1 ))
    if [ "$DRY" = 1 ]; then echo "would queue: $(jq -r '"\(.project) (\(.stage)) \(.lane), \(.worker), \(.area), \(.priority): \(.key) [\(.why // "")]"' <<<"$c")"
    else
      tags=$(jq -r '[if .cleanup == 0 then "cleanup" else empty end, if .tier then "tier\(.tier)" else empty end] | join(" ")' <<<"$c")
      # The idle-pool rank term, logged per pick so its effect can be counted against pool_busy_share.
      pl=$(jq -r 'select((.pool_idle // "") != "") | "rank term idle pool \(.pool_idle): \(.project) \(.lane) row \(.key)"' <<<"$c")
      [ -z "$pl" ] || logline "$pl"
      promote "$c" "$tags" "$(row_task "$c")"
    fi
  done <<<"$picked"
  return 0
}

# item_tag_depth <tag> -> the runnable items carrying <tag>: what a class top-up (cleanup, requested) measures.
item_tag_depth() { runnable 2>/dev/null | jq -c --arg t " $1 " 'select((" " + (.tags // "") + " ") | contains($t))' | grep -c . || true; }

# project_gaps -> one `<gap> <project>...` line per classes.json class that names `projects` and sets a
# min_live (unity, trader), while its projects' live items (running or waiting) and runnable ones
# (queued, no hold) together are fewer than that min_live: the project floor's top-up above the low
# water, so a project the human did not put on focus still has sessions while a focus project fills the
# queue (plan fleet-product-work-first P4: at 14:03 on 2026-11-23, 34 Unity items queued and no trader
# one). It counts a project's items whatever class they rank in, as the floor is that project's
# sessions: a #requested trader item ranks in `requested` and is still a trader session. Nothing when
# the mix is off or either read fails.
project_gaps() {
  local mix active
  mix=$(agent-queue mix --json 2>/dev/null) && active=$(agent-queue list --json --state active 2>/dev/null) || return 0
  jq -rs --argjson m "$mix" 'if $m.on != true then empty else . as $it
    | $m.classes[] | select(.min_live > 0 and ((.projects // []) | length) > 0) | .projects as $ps
    | ([$it[] | select((.project // "") as $p | any($ps[]; . == $p))
        | select(.state == "running" or .state == "waiting" or (.state == "queued" and .hold == null))] | length) as $n
    | select(.min_live > $n) | "\(.min_live - $n) \($ps | join(" "))" end' <<<"$active" 2>/dev/null || true
}

# class_gap <class> <tag> -> how many runnable items carrying <tag> the class lacks under its classes.json
# min_live (the number the mix and this top-up share), 0 when the mix is off, the class has none, or
# `agent-queue mix` cannot be read. The tag, not the class, counts the items: a cleanup row of kind fix
# is in the bug class (agent-queue CLASS_JQ), and the requested class also holds every item from the human.
class_gap() {
  local min; min=$(agent-queue mix --json 2>/dev/null | jq -r --arg c "$1" 'if .on == true then [.classes[] | select(.name == $c) | .min_live][0] // 0 else 0 end' 2>/dev/null) || min=0
  [[ "$min" =~ ^[0-9]+$ ]] || min=0
  [ "$min" -gt 0 ] || { echo 0; return; }
  local gap=$(( min - $(item_tag_depth "$2") )); [ "$gap" -gt 0 ] || gap=0
  echo "$gap"
}

# floor_pass -> 0 when fill_day reads the board for its floors' rows alone (CLEANUP_ONLY, REQUESTED_ONLY,
# GATED_ONLY, SPRINT_ONLY, FLOOR_PROJECTS), which every scan under it then filters by floor_project and floor_row.
floor_pass() { [ -n "${CLEANUP_ONLY:-}${REQUESTED_ONLY:-}${GATED_ONLY:-}${SPRINT_ONLY:-}${FLOOR_PROJECTS:-}" ]; }

# floor_project <project> -> 0 for a project a floor pass may find a row in: any under the requested or
# gated floor, one of DISPATCH_CLEANUP_PROJECTS under the cleanup floor, one of FLOOR_PROJECTS under its
# project floor, one with an unstarted open sprint row (SPRINT_PROJECT) under the sprint floor.
floor_project() {
  [ -n "${REQUESTED_ONLY:-}${GATED_ONLY:-}" ] && return 0
  [ -n "${CLEANUP_ONLY:-}" ] && [[ " $DISPATCH_CLEANUP_PROJECTS " == *" $1 "* ]] && return 0
  [ -n "${FLOOR_PROJECTS:-}" ] && [[ " $FLOOR_PROJECTS " == *" $1 "* ]] && return 0
  [ -n "${SPRINT_ONLY:-}" ] && [ -n "${SPRINT_PROJECT[$1]:-}" ]
}

# floor_row <project> <row> [gates] [id] -> 0 for a row a floor pass may read: a `#requested` row when the
# requested floor is under, a cleanup row of DISPATCH_CLEANUP_PROJECTS when the cleanup floor is, an
# agent row whose gates all cleared (<gates>, cmd_candidates' `gated`) under GATED_ONLY, any row of a
# FLOOR_PROJECTS project under its project floor, and a row an open sprint holds (row_sprint on <id>) under SPRINT_ONLY. It sets SPRINT, CLEANUP and KIND (row_sprint_set,
# cleanup_row_set), so a walk copies its own before it calls this.
floor_row() {
  [ -n "${GATED_ONLY:-}" ] && [ -n "${3:-}" ] && return 0
  [ -n "${REQUESTED_ONLY:-}" ] && [[ "${2%%<!--*}" =~ (^|[[:space:]])#requested([[:space:]]|$) ]] && return 0
  [ -n "${FLOOR_PROJECTS:-}" ] && [[ " $FLOOR_PROJECTS " == *" $1 "* ]] && return 0
  [ -n "${SPRINT_ONLY:-}" ] && [ -n "${4:-}" ] && row_sprint_set "$1" "$4" && [ "$SPRINT" = 0 ] && return 0
  [ -n "${CLEANUP_ONLY:-}" ] && [[ " $DISPATCH_CLEANUP_PROJECTS " == *" $1 "* ]] && cleanup_row_set "$1" "$2" && [ "$CLEANUP" = 0 ]
}

# take_epic <profile> <project> <epic id> [repeat] -- take an epic row on by lifecycle.md "Taking an
# epic on" (promote's call for an `epic(` row), never as one item: the epic row stays open, and no
# session holds the whole epic. promote has already read the epic row's own gates (#after/, #ask/,
# #hold/). The first path that fits wins:
#  1. the human first: an open decide( leaf (#of/<epic>) holds it, and nothing is taken.
#  2. a plan chain: a plan whose epic: line names it and has an open phase (not superseded). One whose
#     chain is in the queue is in flight; one the human approved whose session is gone (plans_orphaned,
#     as reconcile_plans reads it) is queued as its chain (agent-queue add --plan --from auto:epics);
#     any other (not approved, or its own session still holds it) holds the epic for the human.
#  3. the board: its agent-lane leaves stay there, and dispatch takes them leaf by leaf. The human's
#     own Start ([repeat], cmd_promote) tags each open s or m one whose kind dispatches
#     (kind_off) #requested, so the requested floor takes them first; an l or xl leaf is named
#     as needing a plan (skip_exits plans it as it does any l row).
# rc 1, the why said, when nothing is taken; else rc 0 with nothing for the caller to start, and what
# was taken in EPIC_TOOK (cmd_start --brief says it).
take_epic() {
  local prof="$1" project="$2" id="$3" repeat="${4-}" board leaves dec plans f orphans active items queue=() flight=() wait=() out rc
  local k kind size sheet stage why taggable=() big=()
  board=$(notes board --json 2>/dev/null) || { say "skip $project: epic $id: notes board --json failed, so its leaves cannot be read"; return 1; }
  leaves=$(jq -c --arg p "$project" --arg e "$id" '.rows[]? | select(.project == $p and .parent == $e and .id != null and .state != "done")' <<<"$board")
  dec=$(jq -r 'select(.type == "decide") | .id' <<<"$leaves" | paste -sd' ' -)
  [ -z "$dec" ] || { say "skip $project: epic $id waits on the human: open decide row $dec"; return 1; }
  plans=$(epic_plans | jq -r --arg e "$id" 'select(.epic == $e and any(.phases[]; .state == "open")) | .file')
  if [ -n "$plans" ]; then
    # In flight: an active item names the plan, or a phase it filed waits on its board row (plan_gated_rows).
    orphans=$(plans_orphaned) && active=$(agent-queue list --json --state active 2>/dev/null) ||
      { say "skip $project: epic $id: the plan ledger, sessions or queue cannot be read, so its plans' chains cannot be"; return 1; }
    items=$({ printf '%s\n' "$active"; plan_gated_rows "$board" 2>/dev/null; } | jq -sc .)
    while IFS= read -r f; do
      if jq -e --arg p "$f" "$PLAN_ITEMS_JQ"' any(.[]; names_plan($p))' <<<"$items" >/dev/null; then flight+=("${f##*/}")
      elif jq -e --arg n "${f##*/}" 'select((.plan // "") | split("/") | last == $n)' <<<"$orphans" 2>/dev/null | grep -q .; then queue+=("$f")
      else wait+=("${f##*/}"); fi
    done <<<"$plans"
  fi
  [ "${#wait[@]}" = 0 ] ||
    { say "skip $project: epic $id waits on the human: its plan ${wait[*]} has no approval in the last $PLAN_LEDGER_DAYS days (plan-approved.sh), or the session that approved it is still live"; return 1; }
  for f in "${queue[@]}"; do
    rc=0
    out=$(AGENT_QUEUE_PULL="${PULL:-dispatch}" AGENT_QUEUE_START=0 agent-queue add --plan "$f" --project "$project" --priority low --from auto:epics 2>&1) || rc=$?
    # Held: its phases filed on their gated board rows, which dispatch pulls as each gate clears (reconcile_plans).
    if [ "$rc" -eq 0 ] || [ "$rc" -eq "$AQ_EX_HELD" ]; then flight+=("${f##*/}"); logline "took epic $id on $project as the chain of $(basename "$f")"
    else say "epic $id: could not queue the chain of $f: $out"; fi
  done
  if [ "${#queue[@]}" -gt 0 ] || [ "${#flight[@]}" -gt 0 ]; then
    [ "${#flight[@]}" -gt 0 ] || { say "skip $project: epic $id: no chain of its plans could be queued"; return 1; }
    EPIC_TOOK="took $project epic $id: the chain of ${flight[*]}"
    echo "$EPIC_TOOK"
    return 0
  fi
  [ -n "$(jq -r 'select(.lane == "agent" and .type != "epic") | .id' <<<"$leaves")" ] ||
    { say "skip $project: epic $id has nothing to take: no story on the agent board and no plan (lifecycle.md, Writing an epic's stories)"; return 1; }
  sheet=$(np "$prof" projects 2>/dev/null | awk -F'\t' -v p="$project" '$1 == p { print $2; exit }')
  stage=$(stage_of "$sheet") && [ -n "$stage" ] ||
    { say "skip $project: epic $id: its project's stage cannot be read, so whether its stories dispatch cannot be"; return 1; }
  dispatchable "$stage" || { say "skip $project: epic $id: its project is at stage $stage, before dev, so dispatch starts none of its stories"; return 1; }
  why=$(off_project "$project")
  [ -z "$why" ] || { say "skip $project: epic $id: $why"; return 1; }
  load_kinds
  while IFS=$'\t' read -r k kind size; do
    [ -n "$k" ] || continue
    case "$size" in l | xl) big+=("$k"); continue ;; esac
    [ -z "$(kind_off "$kind")" ] || continue
    taggable+=("$k")
  done < <(jq -r 'select(.lane == "agent" and .state == "open" and .type != "epic" and .requested != true)
    | [.id, (.type // "-"), ((.size // "-") | ascii_downcase)] | @tsv' <<<"$leaves")
  if [ -n "$repeat" ]; then
    for k in "${taggable[@]}"; do
      np "$prof" ptask "$project" --agent tag --add requested "$k" >/dev/null 2>&1 || say "epic $id: could not tag $k #requested"
    done
    [ "${#taggable[@]}" = 0 ] || logline "took epic $id on $project on the board: ${taggable[*]} tagged #requested"
  fi
  EPIC_TOOK="took $project epic $id: its stories dispatch leaf by leaf from the board${repeat:+, ${#taggable[@]} tagged #requested}${big[*]:+; ${big[*]} need a plan (size l or xl)}"
  echo "$EPIC_TOOK"
  return 0
}

# promote <row> <tags> <task> [repeat] [mode] -- claim the open row on its board, then add it to the queue
# under its id, at the row's priority (as a plan item for mode plan); a row that cannot be added is un-started again. The start stamps an id
# on a row with none; a row still without one (its project has no code) is refused, since nothing
# could join an item to it. The new item's slug is left in PROMOTED. A row with a gate not yet clear
# (load_gates) is refused before the start, the human's Start too: the gate is the row's own word that
# it waits. One exception: `start --now` (START_NOW, set by cmd_start alone, never a fill) takes a
# pending #after/ as clear and logs it, since an order between rows is not a decision; an ask, rbw,
# hold or dead gate still refuses. The cleared ones go onto the item as its queue tags (an ask: one is what ask_decisions
# reads), all but a time of day, which would hold the item again the next morning; once the item is
# queued their hashtags come off the row.
promote() {
  local c="$1" tags="$2" task="$3" repeat="${4-}" qmode="${5-}" prof project lane key area line out id slug flag=() rc=0
  local g q gwait gates=() rm=() stacks=''
  prof=$(jq -r .profile <<<"$c"); project=$(jq -r .project <<<"$c"); lane=$(jq -r .lane <<<"$c")
  key=$(jq -r .key <<<"$c"); area=$(jq -r '.area // empty' <<<"$c")
  [ "$lane" = agent ] && flag=(--agent)
  line=$(row_line "$prof" "$project" "$lane" "$key")
  [ -n "$line" ] || { say "skip $project: $key is not on the $lane board"; return 1; }
  [[ "$line" == '- [ ]'* ]] || { say "skip $project: row no longer open: $key"; return 1; }
  load_gates
  [ -z "$GATES_FAILED" ] || { say "skip $project: $GATES_FAILED, so its gates cannot be read: $key"; return 1; }
  for g in $(grep -oE '(^|[[:space:]])#[A-Za-z0-9_./-]+' <<<"${line%%<!--*}" | sed 's/^[[:space:]]*#//'); do
    # A returned hold:'s desk class rides as #desk/<class> (agent-queue pending_gates): back on the item, off the row.
    case "$g" in desk/?*) tags="${tags:+$tags }desk:${g#desk/}" rm+=(--remove "$g"); continue ;; esac
    [ -z "${GATE_ST[$g]+x}" ] || gates+=("$g")
  done
  if [ "${#gates[@]}" -gt 0 ]; then
    local passed=()
    if [ -n "${START_NOW:-}" ]; then
      for g in "${gates[@]}"; do
        [[ "$g" == after/* && "${GATE_ST[$g]}" == pending ]] || continue
        GATE_ST[$g]=clear passed+=("#$g")
      done
    fi
    gwait=$(gate_wait "${gates[*]}")
    [ -z "$gwait" ] || { say "skip $project: $key $gwait"; return 1; }
    [ "${#passed[@]}" = 0 ] || logline "human start past ${passed[*]}: $project $key"
    for g in "${gates[@]}"; do
      rm+=(--remove "$g")
      # An #after/ that cleared as stacked leaves the item `after:` that item: it starts on its PR's
      # head (cmd_start) and agent-land merges it once that item closed ok.
      [ -z "${GATE_STACK[$g]:-}" ] || stacks="${stacks:+$stacks,}${GATE_STACK[$g]}"
      for q in ${GATE_Q[$g]}; do [[ "$q" == at:[0-9][0-9]:* ]] || tags="${tags:+$tags }$q"; done
    done
  fi
  # An epic is never one item: it is taken on by its path (take_epic), its row left open.
  if [ "$(row_kind "$line")" = epic ]; then
    PROMOTED='' EPIC_TOOK=''
    take_epic "$prof" "$project" "$key" "$repeat" || return 1
    [ "${#rm[@]}" = 0 ] || np "$prof" ptask "$project" "${flag[@]}" tag "${rm[@]}" "$key" >/dev/null 2>&1 ||
      say "take $key: taken, but its cleared gates (${gates[*]}) are still on its row"
    return 0
  fi
  out=$(np "$prof" ptask "$project" "${flag[@]}" --exact start -- "$line" 2>&1) ||
    { say "skip $project: could not start row: $key ($out)"; return 1; }
  id=$(sed -n 's/^  id://p' <<<"$out")
  [ -n "$id" ] || [[ "$line" != *"id:$key "* ]] || id=$key
  if [ -z "$id" ]; then
    np "$prof" ptask "$project" "${flag[@]}" --exact unstart -- "- [/]${line#- \[ \]}" >/dev/null 2>&1
    say "skip $project: row has no id and start gave it none (no code in project-map.json?), un-started: $key"
    return 1
  fi
  # A #requested row's item carries the tag, which puts it in the requested class (classes.json).
  [[ " $tags " == *" requested "* ]] || [[ ! "${line%%<!--*}" =~ (^|[[:space:]])#requested([[:space:]]|$) ]] ||
    tags="${tags:+$tags }requested"
  # A row an open sprint holds is a `sprint` item, whichever path promotes it: the queue order and the sprint floor read the tag.
  sprint_rows_ready
  [ "$(row_sprint "$project" "$key")" != 0 ] || [[ " $tags " == *" sprint "* ]] || tags="${tags:+$tags }sprint"
  # The row's words are the item's title: no checkbox, id comment or #tags.
  local title board brief rest=''
  title=$(sed -E 's/^- \[.\] //; s/<!--[^>]*-->//g; s/(^| )#[A-Za-z0-9_/:.-]+//g; s/ +$//' <<<"$line")
  # The row is the task's record (QUEUE.md): the item's body is the task's first line, the row's
  # brief, then the rest of the task (the lines after its first), a snapshot of what it starts
  # with. A brief the task already carries (a --brief written from the row) is not repeated.
  board=$(notes board --json 2>/dev/null) || say "promote $id: notes board --json failed, so the item has no brief from its row"
  brief=$(jq -r --arg p "$project" --arg k "$id" \
    'first(.rows[]? | select(.project == $p and .id == $k) | .details // [] | join("\n")) // empty' <<<"$board" 2>/dev/null)
  # A #requested row's created date rides as `asked:`, what a fresh ask is measured from (ASK_JQ).
  # And whose words its #requested is rides as `asker:` (asker_map), which human_ask reads.
  local asked='' asker=''
  if [[ " $tags " == *" requested "* ]]; then
    asked=$(jq -r --arg p "$project" --arg k "$id" \
      'first(.rows[]? | select(.project == $p and .id == $k) | .since // empty) // empty' <<<"$board" 2>/dev/null)
    asker_map; asker=$(row_asker "$id")   # the map read here, so the subshell inherits it
  fi
  if [ -n "$brief" ] && [[ "$task" != *"$brief"* ]]; then
    [[ "$task" != *$'\n'* ]] || rest=$'\n'"${task#*$'\n'}"
    task="${task%%$'\n'*}"$'\n'"$brief$rest"
  fi
  # A plan row (agent-queue add --plan from a session that may not queue; its brief names the plan,
  # plan_row_plan) is queued as the plan's chain, one session a phase, never one session for all of
  # them: the row goes on the plan's rows: line and stays started until agent-land closes it with
  # the last phase. A --mode plan start keeps the one plan item it asked for.
  local plan='' gone=''
  [ -n "$qmode" ] || plan=$(plan_row_plan "$brief") || plan=''
  # A plan row whose plan is gone is refused by name, never queued as one session for every phase.
  [ -z "$plan" ] || [ -f "$plan" ] || gone="agent-queue: its plan $plan is gone, so its phases cannot be queued"
  # AGENT_QUEUE_START=0 for every caller: add starts only a plan item itself, and each caller of
  # promote starts what it promoted (cmd_start) or leaves it queued for a pass, so add never must.
  if [ -n "$gone" ]; then
    out=$gone rc=1
  elif [ -n "$plan" ]; then
    out=$(AGENT_QUEUE_PULL="${PULL:-dispatch}" AGENT_QUEUE_START=0 agent-queue add --plan "$plan" --project "$project" --priority "$(row_priority "$line" "$project")" \
        --from "board:$project:$id" ${tags:+--tags "$tags"} ${stacks:+--after "$stacks"} ${repeat:+--repeat} 2>&1) || rc=$?
  else
    out=$(AGENT_QUEUE_PULL="${PULL:-dispatch}" AGENT_QUEUE_START=0 agent-queue add --project "$project" --priority "$(row_priority "$line" "$project")" --from "board:$project:$id" --slug "$id" \
        ${qmode:+--mode "$qmode"} ${title:+--title "$title"} ${tags:+--tags "$tags"} ${stacks:+--after "$stacks"} ${repeat:+--repeat} -- "$task" 2>&1) || rc=$?
  fi
  if [ "$rc" -ne 0 ]; then
    # The row's own item already finished ok, so its work landed and the row escaped closing. An agent
    # row stays started: the orphan pass closes it on that item's merge proof (land_orphan), or hands it
    # back after DISPATCH_ORPHAN_HOURS. A human row goes back now with a failed verdict naming why, marked
    # `hold` since a retry cannot change it (in_force), so
    # neither is queued again every pass. The human's own Start (cmd_promote) passes --repeat instead.
    # A plan row whose phases all landed, or whose plan is gone, has no item for the orphan pass to
    # close it on, so it goes back with a failed verdict whatever its lane.
    if [ "$rc" -eq "$AQ_EX_FINISHED" ] || [ -n "$gone" ]; then
      if [ "$lane" = agent ] && [ -z "$plan" ]; then say "skip $project: row left started for the orphan pass: ${out#agent-queue: }"; return 1; fi
      np "$prof" ptask "$project" "${flag[@]}" unstart "$id" >/dev/null 2>&1
      mkdir -p "$DIR"
      jq -cn --arg p "$project" --arg l "$lane" --arg k "$key" --arg r "${out#agent-queue: }" --arg at "$(date -Iseconds)" \
        '{project: $p, lane: $l, key: $k, verdict: "failed", reason: $r, hold: true, at: $at}' >> "$VERDICTS"
      say "skip $project: row un-started, recorded failed: ${out#agent-queue: }"
      return 1
    fi
    np "$prof" ptask "$project" "${flag[@]}" unstart "$id" >/dev/null 2>&1
    say "could not queue $project row, un-started: $id ($out)"
    return 1
  fi
  # The `<state> <slug> -> <file>` line, not the first: a warning on add's stderr may come before it.
  # A chain prints one such line a phase, `held` for each phase it filed on its own row: its first
  # queued phase is what was promoted, and it works its own story row, not this one.
  slug=$(awk '$1 == "queued" && $3 == "->" { print $2; exit }' <<<"$out"); PROMOTED=$slug
  candidates_drop "$project" "$lane" "$key"
  [ -n "$plan" ] || agent-queue set "$slug" "lane=$lane" ${prof:+"profile=$prof"} ${area:+"area=$area"} ${asked:+"asked=$asked"} ${asker:+"asker=$asker"} ${PROMOTE_MODEL:+"model=$PROMOTE_MODEL"} >/dev/null
  # A chain's phases each carry the row's tags, #requested included, so each carries its asker too.
  if [ -n "$plan" ] && [ -n "$asker" ]; then
    local s
    for s in $(awk '$1 == "queued" && $3 == "->" { print $2 }' <<<"$out"); do agent-queue set "$s" "asker=$asker" >/dev/null; done
  fi
  [ "${#rm[@]}" = 0 ] || np "$prof" ptask "$project" "${flag[@]}" tag "${rm[@]}" "$id" >/dev/null 2>&1 ||
    say "promote $id: queued, but its cleared gates (${gates[*]}) are still on its row"
  if [ -n "$plan" ]; then logline "filed the chain of $(basename "$plan") from $project $lane row${tags:+ ($tags)}: $id${slug:+, first item $slug}"
  else logline "filled queue item $slug from $project $lane row${tags:+ ($tags)}: $id"; fi
  echo "queued $project: $id"
}

# cmd_promote --project P [--profile X] [--agent] [--dispatch] [--model M] [--tags T] --raw LINE -- queue one row as the
# human saw it: the Board tab's Start. A row that changed since, or is already started, is refused. No load
# gate: the item starts like any board item (a row gate not yet clear refuses it, promote). --dispatch is a
# machine caller's pull, capped like dispatch's own (fleet-bench triage's reds, which as a hand start went
# past the cap with no make_room); without it a caller with no queue item is the human's hand start.
# --model pins the item's model (claude_pin), as triage pins its escalation of a red to Opus.
cmd_promote() {
  local project='' prof='' lane=human raw='' tags='' board key PROMOTE_MODEL=''   # promote() reads it; local, so it holds for this call alone
  while [ $# -gt 0 ]; do
    case "$1" in
      --agent) lane=agent; shift; continue ;;
      --dispatch) PULL=dispatch; shift; continue ;;
      --project | --profile | --raw | --tags | --model) [ $# -ge 2 ] || { say "promote: $1 needs a value"; return 2; } ;;
      *) say "promote: unknown argument: $1"; return 2 ;;
    esac
    case "$1" in --project) project=$2 ;; --profile) prof=$2 ;; --raw) raw=$2 ;; --tags) tags=$2 ;; --model) PROMOTE_MODEL=$2 ;; esac
    shift 2
  done
  [ -n "$project" ] && [ -n "$raw" ] || { say "promote: --project and --raw are required"; return 2; }
  board=$(rows "$prof" "$project" "$lane")
  key=$(R="$raw" awk -F'\t' 'substr($0, length($1) + 2) == ENVIRON["R"] { print $1; exit }' <<<"$board")
  [ -n "$key" ] || { say "promote: not on the $project $lane board as given, so it changed: $raw"; return 1; }
  promote "$(jq -cn --arg profile "$prof" --arg project "$project" --arg lane "$lane" --arg key "$key" \
    '{profile: $profile, project: $project, lane: $lane, key: $key}')" "$tags" "$(sed 's/^- \[.\] //' <<<"$raw")" repeat
}

# cmd_pull_after <row id> -- the open board rows gated #after/<row id>, pulled the moment that row's item
# closed ok (agent-queue pull_after), so a plan's next phase takes the slot the closing session frees and
# waits for no pass. Each is promoted as a pass would (its other gates still hold it: promote), its add
# a pull of AGENT_QUEUE_PULL=after, for which agent-queue's cap makes room (make_room) rather than hold
# it, since a held row waits for a pass; a row it could not
# queue gets a log line. An urgent or high one started at once (start --item); a low one waits for a
# pass in its turn (agent-queue waits_turn). The row it waited on may still read open (an item with a PR
# closes its row at the merge, after this move), so its after/ counts clear here: the ok close is the
# proof. Under the dispatch hold (agent-hold) nothing is pulled; the pass after the release does it.
# --queue-only (agent-queue under AGENT_QUEUE_START=0, the shepherd's idle close) queues the rows and
# starts none.
cmd_pull_after() {
  local id='' board c pri err kept='' rc queue_only='' a
  for a in "$@"; do
    case "$a" in
      --queue-only) queue_only=1 ;;
      -*) say "pull-after: unknown argument: $a"; return 2 ;;
      *) id=$a ;;
    esac
  done
  [ -n "$id" ] || { say "usage: fleet-dispatch pull-after [--queue-only] <row id>"; return 2; }
  agent-hold check dispatch >/dev/null 2>&1 || { say "pull-after $id: dispatch is held, so the rows after it wait for a pass"; return 0; }
  board=$(notes board --json 2>/dev/null) || { say "pull-after $id: notes board --json failed, so a pass promotes the rows after it"; return 1; }
  load_gates
  GATE_ST[after/$id]=clear
  err=$(mktemp) || return 1
  # The rows come on fd 3, so nothing the body runs can read them: on stdin, the first start ate every
  # row after it (2026-11-20: ar-4071 behind ar-4069, chain-after-stuck). The start also gets
  # </dev/null, as in restore_world, so it never reads the closing session's stdin, and 3<&-, so the
  # session it launches does not keep the row pipe.
  while IFS= read -r -u 3 c; do
    [ -n "$c" ] || continue
    PROMOTED=''
    # Its reason goes to the log too: the closing session's stderr is gone once it ends. AQ_ROOM_KEEP
    # stops this pull's adds returning the rows it already queued to make room (agent-queue make_room).
    rc=0; AQ_ROOM_KEEP="$kept" promote "$c" "" "$(jq -r .raw <<<"$c" | sed 's/^- \[.\] //')" 2>"$err" || rc=$?
    cat "$err" >&2
    [ "$rc" = 0 ] || { logline "pull-after $id: row $(jq -r .key <<<"$c") was not queued: $(tail -n 1 "$err" | sed 's/^fleet-dispatch: //')"; continue; }
    # A plan row whose chain filed every phase on its own row queued nothing to start.
    [ -n "$PROMOTED" ] || continue
    kept="$kept $PROMOTED"
    [ -z "$queue_only" ] || continue
    pri=$(agent-queue show "$PROMOTED" --json 2>/dev/null | jq -r '.priority // empty')
    if [ "$pri" = low ]; then say "pull-after $id: $PROMOTED is low priority, so a pass starts it in its turn"; continue; fi
    cmd_start --item "$PROMOTED" </dev/null 3<&- || say "pull-after $id: $PROMOTED could not start now, so it stays queued for a pass"
  done 3< <(jq -c --arg g "after/$id" '.rows[]? | select(.state == "open" and .id != null and ((.tags // []) | index($g)))
    | {profile: (.profile // ""), project, lane, key: .id, raw: (.raw // .text // "")}' <<<"$board")
  rm -f "$err"
  return 0
}

# all_open -- candidates without the judged filter: every open, eligible row
all_open() { VERDICTS=/dev/null cmd_candidates; }

# cmd_fill [--dry-run] [--json] -- by hand: promote up to DISPATCH_PER_PASS picks (DISPATCH_LOW_WATER at 0) into the queue, no
# gate. --dry-run is the order a pass would promote rows in, with no judge call and no write:
# `ready` rows are day_picks (cached verdicts only, a live area skipped, tier-3 rows included), then
# `unjudged` rows, which no current verdict covers and the next pass judges first.
cmd_fill() {
  local ready unj dry=0 json=''
  while [ $# -gt 0 ]; do
    case "$1" in --dry-run) dry=1 ;; --json) json=1 ;; *) say "fill: unknown argument: $1"; return 2 ;; esac
    shift
  done
  load_gates; load_pool_idle   # once, so each subshell of the fill reads the same gates and pools
  if [ "$dry" = 0 ]; then
    DRY=0; mkdir -p "$DIR"; exec 9>"$DIR/.lock"
    flock -n 9 || { say "fill: another pass is running"; return 0; }
    fill_now "$(( PER_PASS > 0 ? PER_PASS : DISPATCH_LOW_WATER ))"; return
  fi
  ready=$(day_picks 999)
  unj=$(unjudged_rows)
  if [ -n "$json" ]; then
    { [ -z "$ready" ] || jq -c '. + {state: "ready"}' <<<"$ready"
      [ -z "$unj" ] || jq -c '. + {state: "unjudged"}' <<<"$unj"; }
    return 0
  fi
  [ -n "$ready$unj" ] || { echo "fill: no open row to promote"; return 0; }
  [ -z "$ready" ] || jq -r '"ready     \(.project) (\(.stage)) \(.lane), \(.worker), \(.area), \(.priority): \(.key) [\(.why // "")]"' <<<"$ready"
  [ -z "$unj" ] || jq -r '"unjudged  \(.project) (\(.stage)) \(.lane): \(.key)"' <<<"$unj"
}

# --- tier 3 rows: one gate in every project, the red-fix gate ----------------------------

# t3_rows <judged> -> the open agent-lane rows of every DISPATCH_PROFILES project at stage dev or later
# that a worker may not take because of tier alone: no tier tag below 3 and none of DISPATCH_T3_SKIP
# (the human-merge list). `order` is the
# row's place on its board, newest first; `rank` puts what the human asked for, then observer rows,
# first (cleanup rows rank by kinds.json like any other, in t3_picks).
# A row with a gate not yet clear is left out, as a #plan row is, and one whose gates all cleared is
# `gated` (cmd_candidates); none when the gates could not be read (GATES_FAILED). ONLY_PROJECT: that project alone.
t3_rows() {
  local judged="$1" prof name sheet _v stage repo key text body t line n x planned dj dsig board gates pidle pprio recs
  local prio priority cleanup sprint uncommitted rsize
  held_load "$judged"
  if ! declare -p DET >/dev/null 2>&1; then
    local -A DET=() PLN=() PAR=() RNK=() GAT=() RLD=()
    load_extras
  fi
  [ -z "${GATES_FAILED:-}" ] || return 0
  load_kinds
  load_prios
  for prof in $DISPATCH_PROFILES; do
    while IFS=$'\t' read -r name sheet _v _; do
      [ -n "$name" ] || continue
      [ -z "${ONLY_PROJECT:-}" ] || [ "$name" = "$ONLY_PROJECT" ] || continue
      [ -z "$(off_project "$name")" ] || continue
      ! floor_pass || floor_project "$name" || continue
      stage=$(stage_of "$sheet")
      dispatchable "$stage" || continue
      repo=$(repo_dir "$name")
      [ -n "$repo" ] && [ -d "$repo" ] || continue
      pidle=$(pool_idle_of "$name")
      pprio=${PRIO_BY[$name]:-}
      n=0
      board=$(rows "$prof" "$name" agent)
      row_kinds_load <<<"$board"
      row_sigs_load <<<"$board"
      recs=''   # one record a row, one jq a board (ROW_RECS_JQ), as cmd_candidates
      while IFS=$'\t' read -r key text; do
        [ -n "$key" ] || continue
        n=$(( n + 1 ))
        case "$text" in '- [ ]'*) ;; *) continue ;; esac
        row_tier_set "$text"; t=$TIER
        [ -z "$t" ] || [ "$t" = 3 ] || continue
        body=${text#- \[ \] }
        re_icase "${body%%<!--*}" "$DISPATCH_T3_SKIP" && continue
        [ -z "${PLN["$name"$'\t'agent$'\t'"$key"]:-}" ] || continue
        row_off_set "$name" "$key" "$text"; [ -z "$OFF" ] || continue
        gates=${GAT["$name"$'\t'agent$'\t'"$key"]:-}
        [ -z "$gates" ] || [ -z "$(gate_wait "$gates")" ] || continue
        # A gated row starts with no verdict (t3_ready), so only a #tier/3 tag makes one tier 3 here;
        # an untagged one stays with the worker path, where the board worker takes it.
        [ -z "$gates" ] || [ "$t" = 3 ] || continue
        ! floor_pass || floor_row "$name" "$text" "$gates" "$key" || continue
        row_sig_set "$text"; line=$SIG
        x=${DET["$name"$'\t'agent$'\t'"$key"]:-$'0\t""'}
        planned=${x%%$'\t'*} dj=${x#*$'\t'}
        detail_sig_set "$dj"; dsig=$DSIG
        held "$name" agent "$key" "$line" "$dsig" && continue
        prio_rank_set "$text"; prio=$PRIO
        cleanup_row_set "$name" "$text"; cleanup=$CLEANUP
        prio_word_set "$prio" "$cleanup"; priority=$PRIORITY
        row_sprint_set "$name" "$key"; sprint=$SPRINT uncommitted=$UNCOMMITTED
        row_size_set "$text"; rsize=$SIZE
        recs+="$key$ROW_US$text$ROW_US$dj$ROW_US$dsig$ROW_US$planned$ROW_US$body$ROW_US$line$ROW_US$prio$ROW_US$priority$ROW_US"
        recs+="$n$ROW_US$rsize$ROW_US$cleanup$ROW_US${RNK["$name"$'\t'agent$'\t'"$key"]:-null}$ROW_US$sprint$ROW_US$uncommitted$ROW_US$gates$ROW_RS"
      done <<<"$board"
      [ -z "$recs" ] || jq -Rsc --arg project "$name" --arg stage "$stage" --arg repo "$repo" \
        --arg obs "$DISPATCH_T3_OBSERVER" --arg profile "$prof" --arg pprio "$pprio" --arg pidle "$pidle" \
        "$ROW_RECS_JQ"'rows_recs(
          .[0] as $key | .[1] as $text | (.[2] | fromjson) as $details | .[3] as $dsig | (.[4] | fromjson) as $planned
          | .[5] as $body | .[6] as $line | (.[7] | fromjson) as $prio | .[8] as $priority | (.[9] | fromjson) as $order
          | .[10] as $rsize | (.[11] | fromjson) as $cleanup | (.[12] | fromjson) as $frank | (.[13] | fromjson) as $sprint
          | (.[14] | fromjson) as $uncommitted | .[15] as $gates
          | {profile: $profile, project: $project, stage: $stage, lane: "agent", key: $key,
            text: $text, repo: $repo, prio: $prio, priority: $priority, tier: 3, line: $line, order: $order, wrank: 0, frank: $frank, row_size: $rsize,
            cleanup: $cleanup, sprint: $sprint, uncommitted: $uncommitted, project_prio: $pprio,
            details: $details, dsig: $dsig, planned: ($planned == 1),
            rank: (if ($body | test("(^| )#requested( |$)")) then -1 elif ($body | test($obs; "i")) then 0 else 1 end)}
            + (if $pidle != "" then {pool_idle: $pidle} else {} end)
            + (if $gates != "" then {gated: true, gates: $gates} else {} end))' <<<"$recs"
    done < <(notes --profile "$prof" projects 2>/dev/null)
  done
}

# t3_ready <rows> -> the t3_rows whose verdict, under a policy that still defines its rule and for the row's current
# text, is a `dispatch` the judge read as tier 3, S or M, clear, agent-only and in one area, with that
# area on the row. A dispatch it read as tier 1 or 2 is a day worker's (picks).
# A `gated` row needs no verdict, as in picks: only a `failed` one (its session died) holds it.
t3_ready() {
  [ -n "$1" ] || return 0
  jq -sc --argjson prules "$(policy_rules)" --argjson games "$(game_areas <<<"$1")" --slurpfile v <(latest_verdicts) "$ROW_JQ"'
    ($v | map({key: ([.project, .lane, .key] | tostring), value: .}) | from_entries) as $by
    | .[] | . as $c | $by[[.project, .lane, .key] | tostring] as $d
    | if $c.gated == true then select($d == null or $d.verdict != "failed") | . + {area: row_area($d; $games)}
      else
        select($d != null and $d.verdict == "dispatch" and $d.tier == 3
          and (eff_size($d) | IN("S", "M")) and $d.clear == true and $d.agent_only == true
          and ($d | usable($prules)) and ($d | holds($c))
          and ($d.area | type) == "string" and $d.area != "")
        | . + {area: row_area($d; $games)} end' <<<"$1"
}

# t3_picks <rows> -> the t3_ready rows a session may take, in RANK_JQ order with the project's #prio
# (t3_rows' project_prio), as picks ranks the day rows they merge with (cleanup first). Each (worker
# tier3) merges behind the red-fix gate (policy.md "Tier"), which item_brief names and agent-land
# enforces. No area holds a tier-3 row: the one-an-area cap had no number on record (plan
# vast-soaring-prism P4, ar-4446).
t3_picks() {
  t3_ready "$1" | jq -sc --arg today "${DISPATCH_TODAY:-$(date +%F)}" "$RANK_JQ"'
    map(. + {worker: "tier3", t3rank: [.rank, .prio, (0 - .order)]} | rank_fields($today; .project_prio // ""))
    | rank | .[]'
}

cmd_report() {
  latest_verdicts | jq -r --arg sig "$(policy_sig)" '[.verdict, .size // "-", (.tier // "-" | tostring),
      .project, .lane, .area // "-", .key, (.reason // "") + (if .verdict != "failed" and .policy != $sig then " (stale: policy changed)" else "" end)] | @tsv' |
    sort | awk -F'\t' '{ printf "%-9s %-2s t%-2s %-16s %-6s %-12s %s\n           %s\n", $1, $2, $3, $4, $5, $6, substr($7, 1, 90), $8 }'
}

# cmd_covered -> the projects whose agent rows an untagged worker takes, one a line: each project of
# DISPATCH_PROFILES at stage dev or later (dispatchable), with a repo, and not off (off_project); none
# when no untagged worker reads the agent lane. inbox-triage's lane rule reads it, so a line for one
# of them is filed where the worker reads.
cmd_covered() {
  local prof name sheet repo _v
  untagged_reads "$(workers)" agent || return 0
  for prof in $DISPATCH_PROFILES; do
    while IFS=$'\t' read -r name sheet _v _; do
      [ -n "$name" ] && [ -z "$(off_project "$name")" ] && dispatchable "$(stage_of "$sheet")" || continue
      repo=$(repo_dir "$name")
      [ -n "$repo" ] && [ -d "$repo" ] && echo "$name"
    done < <(notes --profile "$prof" projects 2>/dev/null)
  done | sort -u
}

# cmd_verdicts -- latest_verdicts, each with plan: true when it is a skip by one of
# DISPATCH_PLAN_RULES (a row skip_exits sends for a plan); fleet-bench's next_up_blocked reads it
cmd_verdicts() {
  latest_verdicts | jq -c --arg rules "$DISPATCH_PLAN_RULES" \
    '($rules | split(" ") | map(select(. != ""))) as $r | . + {plan: (.verdict == "skip" and ((.rule // "") | IN($r[])))}'
}

main() {
  # Dispatch is a singleton: on any machine but the fleet lease's holder the verbs that start and
  # reap sessions stand down before they read anything.
  case "${1:-}" in
    run) lease_guard "$1" || return $(($? == 2)) ;;   # another holder is no fault, a lease no remote can say is
    kick) lease_guard "$1" || return $(($? == 2)) ;;   # the kick unit and the pass share the lease, and its rcs
    reap | start | fill | promote | pull-after | exits) lease_guard "$1" || return 1 ;;
  esac
  case "${1:-}" in
    run)
      PASS_TIMES='' PASS_MARK=$SECONDS
      shift; cmd_run "$@"; local rc=$?
      local ran=$PASS_TIMES   # empty when the pass lost the lock (a NOOP) or left before the gates
      pass_mark "pass (${STARTED:-0} started)"
      # After the pass, so the floors and the cap's let-go have started what they would; under its lock.
      [ "$DRY" = 1 ] || ! flock -n 9 2>/dev/null || share_return
      pass_mark share
      # The judge after the pass, so no start waits on a model call: inside the fill alone it ran only on
      # passes that reached the board, and on 2026-11-23 a flapping k3s red and the load gate left 1,855
      # rows unjudged. A pass whose fill judged already does not judge again (judge_once).
      [ "$DRY" = 1 ] || ! flock -n 9 2>/dev/null || ! agent-hold check dispatch >/dev/null 2>&1 || { load_pool_idle; judge_once; } || true
      pass_mark judge
      # After the pass, so it counts what the pass left: stats reads this, never the gates itself.
      [ "$DRY" = 1 ] || { cmd_headroom --json > "$HEADROOM.$$" 2>/dev/null && mv -f "$HEADROOM.$$" "$HEADROOM" || rm -f "$HEADROOM.$$"; }
      # The candidates snapshot too, but only from the pass that holds the lock: a skipped pass would
      # read every board a second time beside the one running.
      [ "$DRY" = 1 ] || ! flock -n 9 2>/dev/null || candidates_write || true
      pass_mark "headroom and candidates"
      [ -z "$ran" ] || say "pass steps: $PASS_TIMES; ${SECONDS}s in all"
      return "$rc" ;;
    kick) cmd_kick ;;
    candidates) load_pool_idle; OFF_SAY=1 cmd_candidates ;;
    covered) cmd_covered ;;
    suggest) shift; if [ "${1:-}" = --write ]; then candidates_write; else cmd_suggest "$@"; fi ;;
    fill) shift; cmd_fill "$@" ;;
    promote) shift; PULL=$(start_pull) cmd_promote "$@" ;;
    pull-after) shift; PULL=after cmd_pull_after "$@" ;;
    report) cmd_report ;;
    verdicts) cmd_verdicts ;;
    exits) shift; skip_exits "$@" ;;
    reap) cmd_reap ;;
    starved) cmd_starved ;;
    sprint-stalled) cmd_sprint_stalled ;;
    stats) cmd_stats ;;
    stopped) shift; cmd_stopped "$@" ;;
    start) shift; PULL=$(start_pull) cmd_start "$@" ;;
    record) shift; cmd_record "$@" ;;
    restore) shift; cmd_restore "$@" ;;
    headroom) shift; cmd_headroom "$@" ;;
    idle-cap) cmd_idle_cap ;;
    item-tier) shift; cmd_item_tier "$@" ;;
    trainee-pool) shift; cmd_trainee_pool "$@" ;;
    trainee-review) shift; cmd_trainee_review "$@" ;;
    trainee-reject) shift; cmd_trainee_reject "$@" ;;
    validate) shift; cmd_validate "$@" ;;
    trainee-rollup) shift; cmd_trainee_rollup "$@" ;;
    direct-land) shift; cmd_direct_land "$@" ;;
    hosts) shift; cmd_hosts "$@" ;;
    harness-ready) shift; cmd_harness_ready "$@" ;;
    kit) cmd_kit ;;
    lane-sandbox) shift; cmd_lane_sandbox "$@" ;;
    harness-prep) shift; harness_prep "$@" ;;
    trainee-patch) shift; cmd_trainee_patch "$@" ;;
    run-result) shift; cmd_run_result "$@" ;;
    item-end) shift; cmd_item_end "$@" ;;
    -h | --help) sed -n '2,48p' "$0" ;;
    *) sed -n '2,20p' "$0" >&2; return 2 ;;
  esac
}

# Sourceable for tests; runs main only when executed.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
