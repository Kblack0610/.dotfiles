#!/usr/bin/env bash
# fleet-dispatch - start one session per easy board row, for the shepherd to see through.
#
#   fleet-dispatch run [--dry-run]   one pass: start up to DISPATCH_PER_PASS queue items, else fill from the board and start those
#   fleet-dispatch candidates        open rows eligible to judge, one JSON object per line
#   fleet-dispatch suggest [--json]  the Candidates: open rows of every dev+ project, ranked, with why, auto, verdict, held
#   fleet-dispatch report            latest verdict per row: picked or skipped, and why
#   fleet-dispatch fill [--dry-run] [--json]  promote picked board rows into agent-queue; --dry-run lists them
#   fleet-dispatch promote --project P [--profile X] [--agent] [--tags T] --raw LINE  queue one board row as it stands: the Board tab's Start; --tags rides on the item (night)
#   fleet-dispatch reap              settle items whose session is gone; waiting/ <-> running/ by the session
#   fleet-dispatch headroom [--json] how many more queue items could start now, and the margin under each limit
#   fleet-dispatch starved           rc 1 naming an urgent or high queue item no pass has started in DISPATCH_STARVED_MIN,
#                                    or board rows no pass has judged in that time while the human was away,
#                                    or a queue under DISPATCH_LOW_WATER with rows to pick and no start in twice that
#   fleet-dispatch stopped [--json]  rc 1 and one line when a hold has stopped every pass for DISPATCH_STARVED_MIN:
#                                    how long, why, what clears it (hub Home, the briefing, queue-starved)
#   fleet-dispatch stats             one JSON object: runnable work, starts and reaps in the last hour, flapping items
#   fleet-dispatch item-tier SLUG    the queue item's tier (item_tier): agent-land gates a tier-3 one
#   fleet-dispatch start --project P [--profile X] [--agent] [--model M] [--harness H]
#       (--item SLUG | --brief FILE --row KEY [--cwd REPO]
#        | --resume ID --session NAME --cwd DIR [--server S] [--window NAME] [--item SLUG])
#       [--host W]                   start ONE session the way every agent must: see cmd_start
#   fleet-dispatch hosts [--json]    each fleet worker: placed or not, run units, load, and why it takes no session
#   fleet-dispatch record            keep each world's pane record; page when a world's server died
#   fleet-dispatch restore [--server S] [--dry-run]  reopen a lost server's conversations as windows
#
# A pass walks the workers in workers.json in file order, and a row goes to the first that may
# take it: `#worker/<name>` plus a `#tier/N` within its max_tier (tier meanings: policy.md), and
# inside its `projects`, `lane` and `only_tag` when it names them. A worker marked `untagged`
# takes rows with no `#worker` tag instead, and with no `#tier` tag the judge's reading decides.
# The human assigns `fleet` rows; agents may assign `requested` rows, which must carry `#requested`.
# The queue comes first, and the board tops it up while fewer than DISPATCH_LOW_WATER items are runnable.
# A board item starts while the human is away, or within DISPATCH_PRESENT_PER_HOUR while they are here.
# Facts are code; the judgment (is this row clear, agent-only, in one area and really that tier?)
# is one model call per pass against policy.md, cached per row in verdicts.jsonl until the
# row's text changes or its rule leaves the policy (a policy edit only dates it: judged again, last). A picked row is started on its sheet and added
# to agent-queue under its id, at its own priority (`from: board:<project>:<id>`); its item gets a detached `wt new` session on the agent world
# running its kind's entry skill (kinds.json; /one-shot for code), tagged @dispatch; the item records that session. Pause: `agent-hold set dispatch`.
# `start` is that same launch for a session an agent starts by hand or restores after a reboot.
# Tier 3 runs unattended in two lanes (policy.md "Tiers"): a tier-3 cleanup row (kinds.json `cleanup`)
# merges at any hour behind the red-fix gate, which agent-land checks on the item (item_tier); any
# other tier-3 row is a `night` item, which agent-queue holds to the night window and stops at a PR.
# Tuning is the DISPATCH_* block, set in the agentctl conf.

set -uo pipefail

# The agentctl conf is the one home of the DISPATCH_* tuning. The runner exports it; a run from a
# shell (headroom, a hand start) reads it here, so both see the limits the timer pass uses. A value
# already in the environment wins (the runner, tests).
: "${DISPATCH_CONF:=$HOME/.config/agentctl/agents/fleet-dispatch.conf}"
while IFS='=' read -r _k _v; do
  [ -n "${!_k+x}" ] || printf -v "$_k" '%s' "$_v"
done < <(sed -n "s/^\(DISPATCH_[A-Z_]*\)=[\"']\{0,1\}\([^\"']*\)[\"']\{0,1\}[[:space:]]*$/\1=\2/p" "$DISPATCH_CONF" 2>/dev/null)
unset _k _v

: "${DISPATCH_PROFILES:=bnb}"
: "${DISPATCH_PER_PASS:=1}"   # new sessions a pass; each start after the first reads the gate again
: "${DISPATCH_LOW_WATER:=3}"   # runnable queue items under which a pass tops the queue up from the board; 0: only an empty queue
: "${DISPATCH_PRESENT_PER_HOUR:=1}"   # board items started an hour while the human is here; 0: board items wait for away
: "${DISPATCH_ORPHAN_HOURS:=72}"   # hours an agent row stays started with no queue item before reap un-starts it
: "${DISPATCH_MAX_LIVE:=6}"   # run units the runner's own sessions may hold: a heavy item 2, a light one 1
: "${DISPATCH_MAX_LOAD:=0.7}"   # 1-min load per core; the fleet-pace target
: "${DISPATCH_START_LOAD:=2.5}"   # 1-min load one session started in the last DISPATCH_START_LOAD_MIN minutes will still add; 0 is off. Provisional: 2.8 measured over 21 starts on 24 cores (2026-11-07), medium confidence; re-measure when the session mix changes
: "${DISPATCH_START_LOAD_MIN:=5}"   # minutes a start counts as not yet in the load
: "${DISPATCH_MIN_IDLE:=30}"    # percent of the machine free, idle plus nice time, over the real idle sample (real_idle); the conf holds the human's floor
: "${DISPATCH_IDLE_WINDOW:=60}"   # seconds the real idle sample spans: one 2 s top frame swung 17-41% on one busy hour (human, ask bo20dU, 2026-11-07)
: "${DISPATCH_PROC_STAT:=/proc/stat}"
: "${DISPATCH_RED_FLOOR:=2}"   # red items that may start past the weekly pace, real idle, load and the fleet-assess HOLD, apart from the run floor: a fix held behind a busy machine keeps the fleet red (human, 2026-11-06)
: "${DISPATCH_PROJECT_FLOOR:=1}"   # starts a pass may make past real idle (never an account's pace), one per project with no running or waiting item: Unity and fleet work held every slot while trader's requested plans waited 5h behind the idle floor (human, 2026-11-07)
: "${DISPATCH_RUN_FLOOR:=0}"   # run sessions that may start past the weekly pace and idle gates: hand starts never wait on pace, so without one no run starts while they fill the week
: "${DISPATCH_STARVED_MIN:=60}"   # an urgent or high item runnable this long pages (watch queue-starved)
: "${DISPATCH_FLAP_MOVES:=3}"   # reap moves of one item in an hour that make it flapping (stats)
: "${DISPATCH_FINDING_FRESH_MIN:=20}"   # two fleet-bench samples: a finding stays open 60 min after it stops firing
: "${DISPATCH_JUDGE_MAX:=40}"   # rows judged per pass; the rest wait for the next pass
: "${DISPATCH_JUDGE_CMD:=agentctl-run --agent dispatch-judge}"
: "${DISPATCH_DETAIL_CHARS:=800}"   # of a row's detail lines, what the judge reads
: "${DISPATCH_PLAN_RULES:=unclear bundle too-big}"   # policy rules whose skip sends an agent row to inbox-plan
: "${DISPATCH_PLAN_BACKLOG:=10}"   # open #plan rows at which plan_skips tags no more; 0 turns it off
# The judge's policy is its agent conf's PROMPT (agentctl-run puts it ahead of the rows); read
# here so a policy edit re-judges rows (policy_sig), and for the rule ids a verdict may name.
: "${DISPATCH_POLICY:=$(. "${AGENTCTL_CONF_DIR:-$HOME/.config/agentctl/agents}/dispatch-judge.conf" 2>/dev/null; printf '%s' "${PROMPT:-}")}"
HERE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
# shellcheck source=../lib/judge.sh
. "$HERE/../lib/judge.sh"
# shellcheck source=../src/agent-run/lib/sandbox.sh
. "$HERE/../src/agent-run/lib/sandbox.sh"
# The fleet worker roster (home-config's `fleet_workers` group) and the one ssh path to a worker.
# shellcheck source=../lib/fleet-hosts.sh
. "${FLEET_HOSTS_LIB:-$HERE/../lib/fleet-hosts.sh}"
: "${DISPATCH_DEMAND_TTL:=2400}"   # seconds a cloud worker's demand key holds (demand_pass): two 15-minute passes plus slack, so one missed pass does not stop the box
: "${DISPATCH_KUBE_ENV:=$HOME/.config/command-center/env}"   # where CC_KUBE_CONTEXT, the cluster the governor's ConfigMap lives on, is set
: "${DISPATCH_WORKERS:=$HOME/.config/fleet-dispatch/workers.json}"
: "${DISPATCH_KINDS:=$HOME/.config/fleet-dispatch/kinds.json}"   # per row type: rank, entry, rung, exit, stages, enabled, off (load_kinds)
: "${DISPATCH_LOADAVG:=/proc/loadavg}"
: "${DISPATCH_START_WAIT:=120}"   # seconds a start waits for another start of a queue item to claim its own
: "${DISPATCH_DROP_TOOLS=Workflow,ScheduleWakeup,Artifact}"   # tools a new queue session starts without (see dropped_tools); empty keeps every tool
: "${DISPATCH_SANDBOX_PROFILE:=}"   # a lane sandbox profile (agent-run docs/contract.md "Lane sandbox") every claude start runs under; empty is off, and a start that cannot hold the profile is refused (lane_sandbox)
: "${DISPATCH_SANDBOX_GH_TOKEN_FILE:=}"   # the sandboxed session's own repo-scoped GitHub token file, as GH_TOKEN_FILE is for a runner; empty gives it no token
: "${DISPATCH_REAP_GRACE:=600}"   # seconds after a start before reap may read a missing Claude as gone: a claude still booting has no registry entry yet
: "${DISPATCH_REAP_CONFIRM:=120}"   # seconds between the two reaps that must both miss a Claude before it counts as gone: two reads closer than that share one load spike, so they are one witness. Provisional: one false fail (ar-900, 2026-11-07) whose re-read a minute later listed the session, low confidence; revisit on the next false reap or one held a pass too long
: "${PARKED_DIR:=${CLAUDE_ACCT_PARKED_DIR:-$HOME/.agent/parked}}"   # claude-acct park: a parked pane is never reaped
# Night items: the default notes profile's agent lanes of the dotfiles boards.
: "${DISPATCH_NIGHT_PROFILE:=}"   # empty: notes' own default profile, where those boards live
: "${DISPATCH_NIGHT_PROJECTS:=agent-runtime notes-cockpit}"
: "${DISPATCH_NIGHT_MAX:=3}"
# The machine-mode level scales the three limits that bind starts; the conf holds the mid numbers.
# Scaled into names of their own, never back into the exported DISPATCH_* a child would scale again.
# shellcheck source=../lib/machine-mode.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/machine-mode.sh"
LEVEL=$(machine_level)
read -r PER_PASS NIGHT_MAX MAX_LOAD < <(level_scale DISPATCH_PER_PASS "$DISPATCH_PER_PASS" \
  DISPATCH_NIGHT_MAX "$DISPATCH_NIGHT_MAX" DISPATCH_MAX_LOAD "$DISPATCH_MAX_LOAD")
: "${DISPATCH_NIGHT_GATE:=make -C tests test-fast, then the shell tests CI on the PR green (the ui tier runs only in CI, never on this machine)}"
# Rows fill never promotes for the night, whatever the judge says (decide rows are off in kinds.json): anything needing a
# device or the human's own machine, secrets, prod, wishes. Case-insensitive ERE.
: "${DISPATCH_NIGHT_SKIP:=\b(device|pads?|headset|playtest)\b|\b(waybar|hypr[a-z]*|ananicy|sysctl|sudo|wi-?fi)\b|\b(secrets?|passwords?|credentials?|rbw|sops)\b|\b(prod|production|dns)\b|would be cool|should i\b|\bmaybe\b|\bideally\b|investigate whether}"
# Observer rows: an improvement row (`#kpi/<k>`, filed by `fleet-bench improve`) or a typed finding
# retro and triage file. jq (Oniguruma) regex, matched case-insensitively against the row body.
: "${DISPATCH_NIGHT_OBSERVER:=#kpi/|^[a-z]+\((kpi|lesson|watch|runner|unit|logs)\):}"
# The AI systems: in these projects a row whose kind is cleanup in kinds.json (fix, chore, a deletion
# refactor) is cleanup (cleanup_row). Cleanup ranks ahead of every other board row (a red is a queue item, which runs before the board), promotes as high whatever its #low, and a tier-3 one merges behind the red-fix gate
# at any hour (the human's asks of 2026-11-05 and 2026-11-06). Empty turns it off.
: "${DISPATCH_CLEANUP_PROJECTS=agent-runtime notes-cockpit}"
# A row that touches what policy.md's tier 3 calls shared infrastructure is never cleanup, whatever
# its kind: a `chore(deps): bump X` or a `fix: the deploy step` is an upgrade or a pipeline change,
# not a deletion, so it stays off the merging lane (review of #1222, 2026-11-06). Matched case-blind.
: "${DISPATCH_CLEANUP_NOT:=\b(deps?|dependenc(y|ies)|bump(s|ed)?|pin(s|ned)?|upgrade[sd]?|version|migrat(e|es|ion|ions)|schema|deploy(s|ment)?|release|ci|workflows?)\b}"
# Runnable `cleanup` items under which a pass tops cleanup rows up from the board even above the low
# water: a full queue of other work kept every cleanup row off the board (2026-11-06). 0 turns it off.
: "${DISPATCH_CLEANUP_FLOOR:=2}"
# 0 stops reap queueing the phases an approved plan's dead session left (reconcile_plans).
: "${DISPATCH_PLAN_RECONCILE:=1}"
# The lowest model-lane lane a started item runs on: every dispatched session lands its own PR,
# and the human approved Sonnet for that (2026-11-05), not Haiku.
: "${DISPATCH_LANE_FLOOR:=sonnet}"
DIR="${FLEET_DISPATCH_DIR:-$HOME/.agent/dispatch}"
VERDICTS="$DIR/verdicts.jsonl"
AQ_EX_FINISHED=4   # agent-queue add's exit when the slug's item already finished ok (its finished_ok)
AQ_EX_HELD=5       # agent-queue add's exit when admission held an automated add (its admit)
LOG="$DIR/log.md"
HARNESSES="${DISPATCH_HARNESSES:-$HOME/.config/agentctl/harnesses.json}"   # the gateway harnesses: model map, timeout, key files
IDLE="$DIR/idle"   # "<epoch> <percent>": the last real_idle sample, which a pass's gates reuse for DISPATCH_IDLE_WINDOW seconds and cmd_starved for DISPATCH_STARVED_MIN
HEADROOM="$DIR/headroom.json"   # the last real pass's `headroom --json`, which stats publishes

# Tier 3 (CI, gates, runners, build and deploy, harness, tooling) never gets a merging session from a
# worker, whatever workers.json says: the human's decision of 2026-10-27, after a dispatched session
# spent 50 minutes on a `ci:` row. Raising this is a conversation, not a config edit. Tier 3 runs
# unattended only through its own lanes (policy.md "Tier"): a red item and a tier-3 cleanup row merge
# behind the red-fix gate (t3_cleanup_picks), every other row goes to an open PR as a night item (fill_night).
UNATTENDED_TIER_CEILING=2
LANE_CACHE="$DIR/lane-cache"   # <day> TAB <slug> TAB <verdict json>: the verdict of an item no source could take, for the rest of the day
NO_ROUTE=()   # this pass's "<slug> (<why>)" for items no source with room could take; NO_ROOM, the account reason

say() { printf 'fleet-dispatch: %s\n' "$*" >&2; }
logline() { mkdir -p "$DIR"; printf -- '- %s %s\n' "$(date '+%Y-%m-%d %H:%M')" "$*" >> "$LOG"; }

# --- facts ---------------------------------------------------------------------------

# stage_of <listed path> -> the project's stage, read by the shared head-tag reader against the one
# ladder (`notes projects --stages`), never a private copy of either. The path is the one
# `notes projects` lists, which is summary.md where the profile's index links the summary (bnb);
# the tags live on the front page (`lab_front_page`, notes' `front_page`), so read that.
# shellcheck source=../lib/lab-feed.sh
. "${LAB_FEED_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/lab-feed.sh}"
# Read once at load, since stage_of runs in subshells; `item-tier`, one queue item's read for
# agent-land, needs no ladder, so it skips the notes call.
[ "${BASH_SOURCE[0]}" = "$0" ] && [ "${1:-}" = item-tier ] || LAB_STAGES="${LAB_STAGES:-$(notes projects --stages 2>/dev/null || true)}"
stage_of() {
  [ -n "$LAB_STAGES" ] || { say "notes projects --stages printed nothing: no project stage can be read"; return 1; }
  # shellcheck disable=SC2086 # the ladder is a word list on purpose
  lab_head_tag "$(lab_front_page "$(dirname "$1")")" $LAB_STAGES
}

# dispatchable <stage>: agents build from dev on; a draft is still a concept, and no stage is
# a question for the human, so neither gets a session.
dispatchable() { lab_stage_at_least "$1" dev; }

prio_rank() {
  case "$1" in
    *'#urgent'*) echo 0 ;;
    *'#high'*) echo 1 ;;
    *'#low'*) echo 3 ;;
    *) echo 1 ;;   # a bare row is high: the row grammar's default, and the queue priority it gets
  esac
}

# prio_of <listed path> -> focus|high|low from the `#prio/<word>` the human set in the front page's
# head (`notes projects --prio`), nothing for a normal project. The head is above the first `## `.
prio_of() {
  sed -n '/^## /q; p' "$(lab_front_page "$(dirname "$1")")" 2>/dev/null | grep -oE '(^|[[:space:]])#prio/(focus|high|low)\b' | head -1 | sed 's|.*#prio/||'
}

# The one rank every caller sorts by (the judge's cap, picks, fill --dry-run): cleanup of an AI system
# (cleanup_row), then the project's priority,
# then the row's due date (overdue, today, within 3 days, later or none), then what the human asked
# for (#requested, as fill_night ranks it), then worker
# order, then the row's priority, then its kind (kinds.json `rank`: a bug first), then stage, then
# oldest first.
# rank_fields adds the counted inputs and a `why` naming them, so the order explains itself; no model scores anything. Dates are this year's MMDD:
# a due date half a year back is next year's, a created date in the future is last year's.
# shellcheck disable=SC2016
RANK_JQ='
def day0($s): "\($s)T00:00:00Z" | fromdateiso8601;
def offset($x; $today): if $x == null then null
  else (try (((day0("\($today[0:4])-\($x.m)-\($x.d)") - day0($today)) / 86400) | floor) catch null) end;
def tagdate($b; $tag): [$b | capture("(^|\\s)#" + $tag + "(?<m>[01][0-9])(?<d>[0-3][0-9])(\\s|$)")] | first;
def rank_fields($today; $pprio):
  ((.text // "") | split("<!--")[0] // "") as $b
  | (offset(tagdate($b; "due"); $today) | if . != null and . < -180 then . + 365 else . end) as $dd
  | (offset(tagdate($b; "c"); $today) | if . != null and . > 0 then . - 365 else . end) as $cd
  | . + {pprio: ({"focus": 0, "high": 1, "low": 3}[$pprio] // 2),
         due: (if $dd == null then 3 elif $dd < 0 then 0 elif $dd == 0 then 1 elif $dd <= 3 then 2 else 3 end),
         due_in: $dd, age: (if $cd == null then 0 else -$cd end),
         req: (if $b | test("(^|\\s)#requested(\\s|$)") then 0 else 1 end)}
  | . + {why: ([(if .cleanup == 0 then "cleanup" else empty end),
                (if $pprio != "" then "\($pprio) project" else empty end),
                (if .due_in == null or .due_in > 3 then empty elif .due_in < 0 then "overdue \(-.due_in)d"
                 elif .due_in == 0 then "due today" else "due in \(.due_in)d" end),
                (if .req == 0 then "requested" else empty end),
                (if (.worker // "") != "" then .worker else empty end),
                ({"0": "#urgent", "1": "#high", "3": "#low"}[(.prio | tostring)] // empty),
                (.klabel // "" | select(. != "")),
                .stage,
                (if .age > 0 then "\(.age)d old" else empty end)] | join(", "))};
def rank: sort_by((.cleanup // 1), (.pprio // 2), (.due // 3), (.req // 1), (.wrank // 0), .prio, (.krank // 1), ({"prod": 0, "beta": 1}[.stage] // 2), -(.age // 0));
'

# repo_dir <project> -> the checkout its code lives in; nothing for a notes-only project.
# The registry's own resolver (project-name.sh), reading DISPATCH_PROJECT_MAP.
# shellcheck source=../../.config/shared-hooks/project-name.sh
. "${PROJECT_NAME_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../../.config/shared-hooks/project-name.sh}"
: "${DISPATCH_PROJECT_MAP:=$(project_map_file)}"
# shellcheck source=../lib/plan-phases.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/plan-phases.sh"
repo_dir() { PROJECT_MAP_FILE="$DISPATCH_PROJECT_MAP" project_repo_path "$1"; }
# pr_repo_dir <pr ref> <project> -> the checkout an item's PR merged into: the repo an
# <owner>/<repo>#<N> ref names (one project spans repos: agent-runtime lands in .dotfiles,
# .dotfiles-private and home-config), else, for a bare number, the project's own.
pr_repo_dir() {
  [[ "$1" =~ ^[^/]+/([^/#]+)#[0-9]+$ ]] || { repo_dir "$2"; return; }
  repo_dir "$(PROJECT_MAP_FILE="$DISPATCH_PROJECT_MAP" project_of_repos_json "${BASH_REMATCH[1]}" | jq -r '.[]')"
}
# shellcheck source=../lib/agent-merge-proof.sh
. "${MERGE_PROOF_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/agent-merge-proof.sh}"
# shellcheck source=../lib/chain-event.sh
. "${CHAIN_EVENT_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/chain-event.sh}"
# dispatch_event <action> <project> <text> [record flags...] -> this runner's start, reap or
# settle on the chain log; it has no queue item or session of its own, so it names itself.
dispatch_event() { chain_event dispatch "$@" --by fleet-dispatch; }

# tag_value <text> <namespace> -> the value of the row's first `#<namespace>/<value>` tag.
# Only the text before a `<!--` marker counts: a tag inside a proof stamp is record, not routing.
tag_value() {
  local body="${1%%<!--*}"
  grep -oE "(^|[[:space:]])#$2/[A-Za-z0-9_.-]+" <<<"$body" | head -1 | sed "s|.*#$2/||"
}

# row_tier <text> -> 1|2|3, or nothing when the row carries no tier. A row typed or scoped ci
# or infra (`ci:`, `ci(area):`, `fix(ci):`) is tier 3 however it is tagged.
row_tier() {
  local body
  body=$(sed 's/^- \[.\] //' <<<"$1" | tr '[:upper:]' '[:lower:]')
  case "$body" in ci:* | ci\(* | infra:* | infra\(* | *\(ci\):* | *\(infra\):*) echo 3; return ;; esac
  tag_value "$1" tier | grep -xE '[123]'
}

# The kind registry, kinds.json, is keyed by notes-cli's ROW_TYPES (a bats test pins the two): per
# type its `rank` within a priority, the `label` why names, the `entry` skill a session starts on,
# its autonomy `rung` (build, propose, human), its `exit` (pr, doc+ask, proof), the `stages` it dispatches
# at, `enabled`, an optional `off` list of projects, and `cleanup`: true when a row of that kind in a
# DISPATCH_CLEANUP_PROJECTS project is cleanup, or an ERE its body must match too (cleanup_row). A
# row with no type, or one the registry lacks, ranks 1, is not cleanup, dispatches and starts
# /one-shot; with no registry every kind does.
declare -gA KIND_RANK=() KIND_LABEL=() KIND_ENTRY=() KIND_ON=() KIND_STAGES=() KIND_OFF=() KIND_EXIT=() KIND_CLEANUP=()
KINDS_LOADED=0
load_kinds() {
  local k r l e on st off x c
  [ "$KINDS_LOADED" = 1 ] && return 0
  KINDS_LOADED=1
  [ -r "$DISPATCH_KINDS" ] || { say "no kind registry at $DISPATCH_KINDS: every kind ranks alike and dispatches"; return 0; }
  # "-" stands for empty, because read collapses empty tab fields; join, not @tsv, so a cleanup
  # pattern keeps its backslashes.
  while IFS=$'\t' read -r k r l e on st off x c; do
    KIND_RANK[$k]=$r KIND_LABEL[$k]=${l#-} KIND_ENTRY[$k]=${e#-} KIND_ON[$k]=$on KIND_STAGES[$k]=$st KIND_OFF[$k]=$off KIND_EXIT[$k]=${x#-}
    KIND_CLEANUP[$k]=${c#-}
  done < <(jq -r 'def d: if . == "" then "-" else . end;
    to_entries[] | [.key, (.value.rank // 1), (.value.label // "" | d), (.value.entry // "" | d), (.value.enabled // false),
      ((.value.stages // []) | join(",") | d), ((.value.off // []) | join(",") | d), (.value.exit // "" | d),
      (.value.cleanup // false | if . == true then "true" elif type == "string" then d else "-" end)]
    | map(tostring | gsub("[\t\n]"; " ")) | join("\t")' "$DISPATCH_KINDS")
}

# row_kind <text> -> the row's type, from the grammar's one home (`notes row parse`); nothing for a
# bare or unknown row. ROW_KIND holds the rows a pass has loaded (row_kinds_load), so a lookup in a
# `$(...)` costs no fork; a row not in it is parsed on the spot.
declare -gA ROW_KIND=()
row_kind() {
  local t
  [ -n "$1" ] || return 0
  if [ -n "${ROW_KIND[$1]+x}" ]; then t=${ROW_KIND[$1]}
  else t=$(printf '%s\n' "${1//$'\n'/ }" | notes row parse 2>/dev/null | cut -f1) || t=''
  fi
  [ "$t" = - ] || [ -z "$t" ] || printf '%s\n' "$t"
  return 0
}

# row_kinds_load -- the `key TAB text` lines of `rows` on stdin: every text's type into ROW_KIND with
# one `notes row parse`, which answers a line per line. A parse that fails or answers short loads
# nothing and says so, and row_kind then parses row by row.
row_kinds_load() {
  local -a texts=() types=()
  local key text i
  while IFS=$'\t' read -r key text; do [ -n "$text" ] && texts+=("$text"); done
  [ ${#texts[@]} -gt 0 ] || return 0
  mapfile -t types < <(printf '%s\n' "${texts[@]}" | notes row parse 2>/dev/null | cut -f1)
  if [ ${#types[@]} -ne ${#texts[@]} ]; then
    say "notes row parse failed or answered short (an old notes? notes-bootstrap --build-only)"
    return 0
  fi
  for i in "${!texts[@]}"; do ROW_KIND[${texts[$i]}]=${types[$i]}; done
}

# kind_off <kind> <project> <stage> -> why the registry keeps a row of that kind from dispatching
# there, nothing when it may: the kind is off, off in that project, or not at that stage.
kind_off() {
  local k="$1"
  [ -n "$k" ] && [ -n "${KIND_ON[$k]+x}" ] || return 0
  if [ "${KIND_ON[$k]}" != true ]; then echo "kind $k is off"
  elif [[ ",${KIND_OFF[$k]}," == *",$2,"* ]]; then echo "kind $k is off in $2"
  elif [[ ",${KIND_STAGES[$k]}," != *",$3,"* ]]; then echo "kind $k does not dispatch at $3"
  fi
}

# row_size <text> -> S, M, L or XL from the row's `#size/` tag, nothing when it has none: the one
# size a sized row has. The judge sizes only the rest (size_back writes its answer onto the row).
row_size() { tag_value "$1" size | grep -xiE 's|m|l|xl' | tr '[:lower:]' '[:upper:]'; }

# workers -> one line per worker in registry order: rank, name, max tier capped at the ceiling,
# projects, only_tag, lane, untagged. "-" stands for empty, because read collapses empty tab fields.
workers() {
  jq -r --argjson c "$UNATTENDED_TIER_CEILING" 'to_entries | to_entries[] | .key as $rank | .value
    | [$rank, .key, ([.value.max_tier // 0, $c] | min | floor),
       ((.value.projects // []) | join(",") | if . == "" then "-" else . end),
       (.value.only_tag // "-"), (.value.lane // "-"), (.value.untagged // false)] | @tsv' \
    "$DISPATCH_WORKERS" 2>/dev/null
}

# row_worker <workers> <project> <lane> <row text> -> "<rank> <worker> <tier>" for the first worker
# that may take the row, nothing when none may. A row with no tier tag counts as the highest tier
# an untagged worker takes, and the judge must read it no higher.
row_worker() {
  local project="$2" lane="$3" text="$4" tag row_t t rank name max projects only wlane untagged
  tag=$(tag_value "$text" worker)
  row_t=$(row_tier "$text")
  while IFS=$'\t' read -r rank name max projects only wlane untagged; do
    if [ "$untagged" = true ]; then [ -z "$tag" ] || continue; else [ "$tag" = "$name" ] || continue; fi
    [ "$projects" = - ] || [[ ",$projects," == *",$project,"* ]] || continue
    [ "$only" = - ] || [[ " $text " == *" #$only "* ]] || continue
    [ "$wlane" = - ] || [ "$wlane" = "$lane" ] || continue
    t=$row_t
    [ -n "$t" ] || [ "$untagged" != true ] || t=$max
    [ -n "$t" ] && [ "$t" -le "$max" ] || continue
    echo "$rank $name $t"
    return 0
  done <<<"$1"
  return 1
}

# cleanup_row <project> <row text> -> 0 when the row cleans up an AI system: its project is in
# DISPATCH_CLEANUP_PROJECTS and its kind is cleanup in kinds.json (KIND_CLEANUP: true, or a pattern
# the body matches too) and the body names no shared infrastructure (DISPATCH_CLEANUP_NOT), else 1.
# RANK_JQ's `cleanup`; the one source.
cleanup_row() {
  local body="${2%%<!--*}" k c
  [[ " $DISPATCH_CLEANUP_PROJECTS " == *" $1 "* ]] || { echo 1; return; }
  load_kinds
  k=$(row_kind "$2")
  c=${KIND_CLEANUP[${k:-_}]:-}
  body=${body#- \[?\] }
  if { [ "$c" = true ] || { [ -n "$c" ] && grep -qiE -- "$c" <<<"$body"; }; } && ! grep -qiE -- "$DISPATCH_CLEANUP_NOT" <<<"$body"; then echo 0; else echo 1; fi
}

# nobody_why <workers> <project> <lane> <row text> -> why no worker takes a row row_worker turned
# down, the first of: no untagged worker lists the project (on the night path, the skip word that
# keeps it off that too), its tier is past the unattended ceiling, or its tags and tier fit none.
nobody_why() {
  local project="$2" lane="$3" text="$4" rank name max projects only wlane untagged covers=0 t m
  while IFS=$'\t' read -r rank name max projects only wlane untagged; do
    [ "$untagged" = true ] || continue
    [ "$projects" = - ] || [[ ",$projects," == *",$project,"* ]] || continue
    [ "$wlane" = - ] || [ "$wlane" = "$lane" ] || continue
    covers=1
  done <<<"$1"
  if [ "$covers" = 0 ]; then
    if [[ " $DISPATCH_NIGHT_PROJECTS " == *" $project "* ]]; then
      m=$(grep -oiE -m1 -- "$DISPATCH_NIGHT_SKIP" <<<"${text%%<!--*}" | head -1)
      if [ -n "$m" ]; then echo "night skip: $m"; else echo "night only: no day worker covers $project"; fi
    else
      echo "no worker covers $project"
    fi
    return
  fi
  t=$(row_tier "$text")
  if [ -n "$t" ] && [ "$t" -gt "$UNATTENDED_TIER_CEILING" ]; then echo "tier $t: past the unattended ceiling"; return; fi
  echo "no worker takes its tags or tier"
}

sig() { sha256sum | cut -c1-12; }

# policy_sig -> changes whenever the policy does. It dates a verdict (fresh or stale), it does not void
# one: an old verdict stays usable while the rule it names is in the policy (usable) and is judged
# again after the never-judged rows, so one edit never leaves the board with no verdict to pick
# from (#1222 left 0 of 1,414 for 9 hours of passes). The worker registry is not in it: picks
# re-reads workers.json and the tier ceiling on every pass.
policy_sig() { cat "$DISPATCH_POLICY" 2>/dev/null | sig; }

# policy_rules -> the policy's rule ids as a JSON array, for ROW_JQ's usable
policy_rules() { judge_rules "$DISPATCH_POLICY" | jq -Rsc 'split("\n") | map(select(length > 0))'; }

# Row facts from `notes board --json`, whose parser owns them. details_json: the row's detail lines
# as one JSON string, cut to DISPATCH_DETAIL_CHARS. planned: inbox-plan wrote it a `goal:`.
# holds($c): a verdict still covers candidate $c: its text is unchanged and, for a verdict that
# recorded one, so are its details. Verdicts from before details were read carry no dsig and hold
# on the text alone, so reading details did not re-judge the 547 held rows that already had some.
ROW_JQ='
def details_json($n): (.details // []) | join("\n") | .[0:$n] | tojson;
def planned: any(.details[]?; test("^goal:"; "i"));
def plan_tagged: any(.tags[]?; . == "plan");
def holds($c): .line == $c.line and (.dsig == null or .dsig == $c.dsig);
# usable($rs): a judged verdict (not error or failed) naming a rule the policy still defines, whatever policy it was made under
def usable($rs): (.verdict == "dispatch" or .verdict == "skip") and (.rule as $r | $rs | index($r) != null);
def eff_size($d): if (.row_size // "") != "" then .row_size else ($d.size // "") end;'

# detail_sig <details json> -> the dsig of a row's details; "none" for a row with none
detail_sig() { if [ "$1" = '""' ]; then echo none; else printf '%s' "$1" | sig; fi; }

# load_extras -- fill the caller's `local -A DET PLN PAR` from one board read, by "<project>\t<lane>\t<id>":
# DET the row's "<planned 0|1>\t<details json>", PLN 1 when the row is tagged #plan; PAR by id alone
# (a child may sit on another project's board), 1 for a parent: an open row names it in `#of/`.
load_extras() {
  local board p l i t g d
  board=$(notes board --json 2>/dev/null)
  while IFS=$'\t' read -r p l i t g d; do
    DET["$p"$'\t'"$l"$'\t'"$i"]="$g"$'\t'"$d"
    [ "$t" = 1 ] && PLN["$p"$'\t'"$l"$'\t'"$i"]=1
  done < <(jq -r --argjson n "$DISPATCH_DETAIL_CHARS" "$ROW_JQ"'
    .rows[]? | select(.id != null)
    | "\(.project)\t\(.lane)\t\(.id)\t\(if plan_tagged then 1 else 0 end)\t\(if planned then 1 else 0 end)\t\(details_json($n))"' <<<"$board")
  while read -r i; do
    [ -n "$i" ] && PAR[$i]=1
  done < <(jq -r '.rows[]? | select(.state == "open" or .state == "doing") | .tags[]? | select(startswith("of/")) | .[3:]' <<<"$board")
}

# row_off <project> <stage> <key> <text> -> why the row may not dispatch whatever the judge says:
# its kind (kind_off), or it is a parent, which closes when its children do. Nothing when it may.
row_off() {
  local why
  why=$(kind_off "$(row_kind "$4")" "$1" "$2")
  [ -n "$why" ] || [ -z "${PAR[$3]:-}" ] || why="a parent: open rows name it in #of/"
  printf '%s' "$why"
}

# held <judged> <project> <lane> <key> <line> <dsig> -- a judged_keys line still covers the row
held() {
  local k="$2"$'\t'"$3"$'\t'"$4"
  grep -qxF -e "$k"$'\t'"$5"$'\t'"$6" -e "$k"$'\t'"$5"$'\t*' -e "$k"$'\t*\t*' <<<"$1"
}

# np <profile> <args...> -> notes, under that profile, or notes' own default when it is empty
# (a hand `start` may leave the profile to the CLI).
np() {
  local p="$1"
  shift
  if [ -n "$p" ]; then notes --profile "$p" "$@"; else notes "$@"; fi
}

# session_live <session> <server> [host] -- rc 1 only on evidence the tmux session is gone: tmux
# says so, or its fleet worker left the roster, so nothing could ever answer for it (reap then reads
# its PR). A worker that does not answer, or fails some other way, cannot tell, and cannot-tell is
# live: every reader counts its units and reap leaves it be.
session_live() {
  [ -n "${3:-}" ] || { tmux -L "$2" has-session -t "=$1" 2>/dev/null; return; }
  fleet_hosts >/dev/null
  fleet_host "$3" >/dev/null || return 1
  fleet_host_run "$3" tmux -L "$2" has-session -t "=$1" 2>/dev/null
  [ $? -ne 1 ]
}

# on_host <host> <command> [args...] -- run it on that fleet worker, or here when <host> is empty.
on_host() {
  local h="$1"; shift
  if [ -n "$h" ]; then fleet_host_run "$h" "$@"; else "$@"; fi
}

# The env prefix that starts claude on the account claude-acct pick chooses
# (the same choice `cl` makes); empty for the main account or when claude-acct is missing. A run
# pass has already chosen from `claude-acct room --json` (acct_room), and passes that account in RUN_ACCOUNT.
# Accounts share ~/.claude/projects, so a resumed session works from either one.
account_dir() {
  if [ "${RUN_ACCOUNT+set}" = set ]; then printf '%s' "$RUN_ACCOUNT"; else claude-acct pick || true; fi
}
# account_env [dir]: the prefix for that account (the chosen one when no argument). Main unsets
# the dir: a pane gets the tmux server's environment, which may carry an alt account.
account_env() {
  local dir; if [ "$#" -gt 0 ]; then dir=$1; else dir=$(account_dir); fi
  if [ -n "$dir" ]; then printf 'CLAUDE_CONFIG_DIR=%q ' "$dir"; else printf 'env -u CLAUDE_CONFIG_DIR '; fi
}

# telemetry_env <cwd> [item]: the launch-line prefix that labels a session's spans with its project
# and queue item. A pane gets the tmux server's environment, so only its launch line can say which
# item it works. Empty off the LAN, where the snippet defines nothing and nothing is exported.
telemetry_env() {
  local attrs
  attrs=$(cd "$1" && AGENT_QUEUE_ITEM=${2:-} bash -c '. "$HOME/.config/shared-hooks/claude-telemetry.sh" && claude_telemetry_launch' 2>/dev/null) || return 0
  printf 'OTEL_RESOURCE_ATTRIBUTES=%q ' "$attrs"
}

# item_sessions -> one line per running or waiting queue item with a session, its fields split by
# US (0x1f, so an empty field survives `read`): slug, server, tmux session, origin, project, area,
# state, weight, agent, started, Claude session ids, host. The item's `session:` is the one record of
# where it runs, `<server>:<tmux session>` (tmux turns a ':' in a session name into '_', so one ':'
# splits), and `host:` the fleet worker that server is on, empty for this machine.
# An item started in a hub window records no `session:`, only the Claude sessions that worked it
# (`sessions:`); it comes out with an empty server and session, and only reap reads it.
item_sessions() {
  agent-queue list --json --state active 2>/dev/null | jq -r '
    select(.state != "queued")
    | select(((.session // "") | contains(":")) or (.sessions // "") != "")
    | ((.session // "") | index(":")) as $i
    | [.slug, (if $i then .session[:$i] else "" end), (if $i then .session[$i + 1:] else "" end),
       (.origin // ""), .project, (.area // ""), .state, (.weight // "light"),
       (.agent // "claude"), (.started // ""), (.sessions // ""), (.host // "")] | join("\u001f")' 2>/dev/null
  return 0
}

# panel_lists <agent> -- agent-panel lists this agent's sessions, by Claude session id: Claude, and
# a harness claude-lazer launches. Another agent's `sessions:` ids (a codex thread) are never there.
panel_lists() { [ "$1" = claude ] || [ "$(harness_launcher "$1")" = claude-lazer ]; }

# claude_gone <server> <tmux session> <agent> <started> <session ids> -- exit 0 when agent-panel
# says the item's Claude has exited while its tmux session lives on (or, for a hub item, when none
# of the Claude sessions that worked it is live). A tmux session alone is not a session: a shell
# left after claude exits keeps it, and an item in a hub window has none of its own. Exit 1 (keep
# the item) when it cannot tell: an agent that is not Claude (agent-panel lists only Claude, which
# a harness launched by claude-lazer is), a
# parked pane (its claude exited on purpose), an item started in the last DISPATCH_REAP_GRACE
# seconds (its claude may still be booting), or a panel it cannot read or that lists nobody.
# An item that records its session ids is alive only while one of them is on the panel; the tmux
# session counts only for one that records none: worktree lanes are recycled, and a new Claude in
# an old item's lane is not its session (2026-11-07 ar-255, ar-487). A recorded Claude whose process
# still runs (claude_pid_live) is alive whatever the panel lists. REAP_PANEL caches one read per pass,
# so its verdict is one witness: reap settles on it only when the reap before also missed (reap_confirm).
claude_gone() {
  local server="$1" sess="$2" agent="$3" started="$4" sids="$5" t
  panel_lists "$agent" || return 1
  if [ -n "$sess" ]; then
    [ -e "$PARKED_DIR/$sess" ] && return 1
    compgen -G "$PARKED_DIR/$sess:*" >/dev/null && return 1
  else
    [ -n "$sids" ] || return 1
  fi
  t=$(date -d "$started" +%s 2>/dev/null) || return 1
  [ $(( $(date +%s) - t )) -ge "$DISPATCH_REAP_GRACE" ] || return 1
  [ -n "${REAP_PANEL+set}" ] || REAP_PANEL=$(agent-panel list --json 2>/dev/null) || REAP_PANEL=''
  [ -n "$REAP_PANEL" ] || return 1
  jq -e -s --arg t "$server/$sess" --arg ids "$sids" '
    ($ids | split(" ") | map(select(. != ""))) as $ids
    | any(.[]; if $ids != [] then (.session_id // "") as $s | $s != "" and ($ids | index($s)) != null
               else $t != "/" and ((.target // "") | sub(":[^:/]*$"; "")) == $t end)
    | not' <<<"$REAP_PANEL" >/dev/null || return 1
  [ -z "$sids" ] || ! claude_pid_live "$sids"
}

# claude_pid_live <session ids> -- exit 0 when a Claude process recorded for one of those ids is
# running: its ~/.claude*/sessions/<pid>.json names the id, the pid is alive and not a zombie, and,
# when the file records procStart, started when the file says, so a reused pid is not a session.
# agent-panel is a view of those files and can leave a live Claude out; the process is what makes a
# session gone. Each file is parsed alone, so one half-written file hides no other.
claude_pid_live() {
  local f pid start st
  for f in "$HOME"/.claude*/sessions/*.json; do
    [ -e "$f" ] || continue
    IFS=$'\t' read -r pid start < <(jq -r --arg ids "$1" '
      ($ids | split(" ") | map(select(. != ""))) as $ids
      | select((.sessionId // "") as $s | .pid != null and $s != "" and ($ids | index($s)) != null)
      | [.pid, (.procStart // "")] | @tsv' "$f" 2>/dev/null) && [ -n "$pid" ] || continue
    st=$(sed 's/.*) //' "/proc/$pid/stat" 2>/dev/null) || continue
    [ -n "$st" ] || continue
    [ "${st%% *}" != Z ] || continue
    [ -z "$start" ] || [ "$(cut -d' ' -f20 <<<"$st")" = "$start" ] || continue
    return 0
  done
  return 1
}

# reap_confirm <slug> -- exit 0 when an earlier reap, at least DISPATCH_REAP_CONFIRM seconds before,
# also read the item's Claude as gone (claude_gone); else record this miss and exit 1. One agent-panel
# read is not a witness: on 2026-11-07 (ar-900) a panel at 78% CPU under load 33 left a live session
# out, and reap failed an urgent item whose re-read a minute later listed it. A reap that does not
# read the item gone clears its mark (reap_seen), so only consecutive misses count. The mark stays
# once confirmed, so an item settle_item leaves active (waiting on its open PR) stays gone; it goes
# when the item closes, and cmd_reap prunes the marks of slugs no longer active.
reap_confirm() {
  local f="$DIR/reap-miss/$1" first
  first=$(cat "$f" 2>/dev/null)
  if [ -n "$first" ]; then
    [ $(( $(date +%s) - first )) -ge "$DISPATCH_REAP_CONFIRM" ]; return
  fi
  mkdir -p "${f%/*}" && date +%s > "$f"
  logline "reap: queue item $1's Claude is not on agent-panel; a reap ${DISPATCH_REAP_CONFIRM}s or more from now settles it if it still is not"
  return 1
}
reap_seen() { [ ! -e "$DIR/reap-miss/$1" ] || rm -f "$DIR/reap-miss/$1"; }

# live_runs -> "<project>/<area> <weight>[ <host>]" for every running session this runner started
# itself, with the fleet worker it runs on. A hand launch or a restore is tagged and tracked like any
# other, but holds none of the runner's units: a dozen restored sessions must not stop dispatch for the day.
live_runs() {
  local slug server sess origin project area state weight _agent _started _sids host
  while IFS=$'\x1f' read -r slug server sess origin project area state weight _agent _started _sids host; do
    [ -n "$slug" ] || continue
    case "$origin" in '' | run) ;; *) continue ;; esac
    session_live "$sess" "$server" "$host" && printf '%s/%s %s%s\n' "$project" "$area" "$weight" "${host:+ $host}"
  done < <(item_sessions)
  return 0
}

# weight_units <weight> -> the run units an item of that weight holds.
weight_units() { [ "$1" = heavy ] && echo 2 || echo 1; }

# units_on <host> < live_runs -> the run units those sessions hold on that fleet worker, or on this
# machine when <host> is empty.
units_on() {
  local u=0 w h
  while read -r _ w h; do [ -n "$w" ] && [ "$h" = "$1" ] && u=$(( u + $(weight_units "$w") )); done
  echo "$u"
}

# live_units -> the run units the runner's live sessions hold on this machine, out of DISPATCH_MAX_LIVE.
live_units() { live_runs | units_on ''; }

# floor_open -- the live run sessions, plus what this pass started, are under DISPATCH_RUN_FLOOR: the
# weekly pace and real idle do not hold this start. Load, fleet-assess, the reserve and holds still do.
# FLOOR_LIVE is the count cmd_run read before its first start, so a start the session list has not
# caught up with still counts once.
floor_open() {
  [ "${DISPATCH_RUN_FLOOR:-0}" -gt 0 ] 2>/dev/null || return 1
  local live=${FLOOR_LIVE:-$(live_runs | grep -c . || true)}
  [ $(( live + ${STARTED:-0} )) -lt "$DISPATCH_RUN_FLOOR" ]
}

# live_reds -> how many red items the runner started have a live session, for the red floor.
live_reds() {
  agent-queue list --json --state active 2>/dev/null | jq -r '
    select(.state != "queued" and ((.origin // "") == "" or .origin == "run"))
    | select((" " + (.tags // "") + " ") | contains(" red "))
    | (.host // "") as $h | (.session // "") | select(contains(":")) | index(":") as $i | "\(.[:$i]) \(.[$i + 1:]) \($h)"' 2>/dev/null |
    while read -r server sess host; do session_live "$sess" "$server" "$host" && echo "$sess"; done
  return 0
}

# red_floor_open -- a red start is due past the machine gates: RED_PASS says the start is a red item,
# and the live red sessions plus the reds this pass started are under DISPATCH_RED_FLOOR. Real idle,
# load, fleet-assess and the weekly pace do not hold it; agent-hold, the reserve, the cluster and the
# github budget still do. RED_LIVE is cmd_run's count before its first start, as FLOOR_LIVE.
red_floor_open() {
  [ "${RED_PASS:-0}" = 1 ] || return 1
  [ "${DISPATCH_RED_FLOOR:-0}" -gt 0 ] 2>/dev/null || return 1
  local live=${RED_LIVE:-$(live_reds | grep -c . || true)}
  [ $(( live + ${RED_STARTED:-0} )) -lt "$DISPATCH_RED_FLOOR" ]
}

# busy_projects -> the projects with a running or waiting queue item, one a line. A hand or plan start
# counts too, so the project floor lifts only a project nothing is working on.
busy_projects() {
  agent-queue list --json --state active 2>/dev/null |
    jq -r 'select(.state == "running" or .state == "waiting") | .project // empty' | sort -u
  return 0
}

# idle_project_items <item json lines> -> in queue order, the light items of every project that
# BUSY_PROJECTS (cmd_run's read before its first start) does not name: the project floor's picks. All
# of a project's items, not its first, so a head item a finding holds does not starve the rest;
# start_items starts one a project. Light only: real idle is the gate that keeps heavy Unity runs off.
idle_project_items() {
  local busy=${BUSY_PROJECTS-$(busy_projects)}
  jq -c --arg busy "$busy" '($busy | split("\n") | map(select(. != ""))) as $b
    | select((.weight // "light") == "light" and ((.project // "") as $p | $b | index($p) | not))' <<<"$1"
}

# project_floor_open -- a project-floor start is due past real idle: PROJECT_PASS says the start is an
# idle project's first item (idle_project_items), and this pass's project-floor starts are under
# DISPATCH_PROJECT_FLOOR. Load, fleet-assess, agent-hold and every account's pace and reserve still hold it.
project_floor_open() {
  [ "${PROJECT_PASS:-0}" = 1 ] || return 1
  [ "${DISPATCH_PROJECT_FLOOR:-0}" -gt 0 ] 2>/dev/null || return 1
  [ "${PROJECT_STARTED:-0}" -lt "$DISPATCH_PROJECT_FLOOR" ]
}

# is_red <item json> -- the item carries the red tag.
is_red() { [[ " $(jq -r '.tags // ""' <<<"$1") " == *" red "* ]]; }

# acct_room -- the account a run start may take, from claude-acct's published answer: one
# `claude-acct room --json` a step (ACCT_ROWS holds it, local to the caller that shares it; each
# start asks afresh, since a start moves the burn). Its pick, the best account with room; while a
# floor is open and there is none, the best refused for its pace alone (room.reasons == ["pace"]):
# the reserve, its 5h window and committed burn still refuse. Sets ACCT_DIR (empty for the main
# account), ACCT_WHY (claude-acct's own refusal sentence) when none may, and ACCT_PAST_PACE=1 when
# the start goes past an account's pace. rc 1 when none may, 2 when none may and an account cannot
# be read, or claude-acct gave no answer.
acct_room() {
  local lift=false pick unread
  ACCT_DIR='' ACCT_WHY='' ACCT_PAST_PACE=0
  [ -n "${ACCT_ROWS:-}" ] || ACCT_ROWS=$(claude-acct room --json 2>/dev/null)
  if ! jq -e '.accounts | type == "array"' <<<"$ACCT_ROWS" >/dev/null 2>&1; then
    ACCT_ROWS='' ACCT_WHY="claude-acct room --json gave no answer"; return 2
  fi
  if floor_open || red_floor_open; then lift=true; fi
  pick=$(jq -r --argjson lift "$lift" '[(.pick as $p | .accounts[] | select(.name == $p) | "0 \(.dir)"),
      (select($lift) | .accounts | sort_by(.rank)[] | select(.room.reasons == ["pace"]) | "1 \(.dir)")]
    | first // empty' <<<"$ACCT_ROWS")
  if [ -n "$pick" ]; then ACCT_PAST_PACE=${pick%% *} ACCT_DIR=${pick#* }; return 0; fi
  IFS=$'\x1f' read -r unread ACCT_WHY < <(jq -r '[any(.accounts[]; .state == "unread"), .why // "claude-acct gave no reason"]
    | map(tostring) | join("\u001f")' <<<"$ACCT_ROWS")
  [ "$unread" = true ] && return 2
  return 1
}

# other_room -> rc 0 when a source some harness in the map spends (its `source`) has room, read from
# the sources claude-acct room --json carries (ACCT_ROWS, which acct_room read).
other_room() {
  [ -r "$HARNESSES" ] && [ -n "${ACCT_ROWS:-}" ] || return 1
  jq -e --slurpfile map "$HARNESSES" '[$map[0].harnesses[]? | .source // empty] as $s
    | any(.sources[]?; .room.ok == true and (.name as $n | any($s[]; . == $n)))' <<<"$ACCT_ROWS" >/dev/null 2>&1
}

# item_tier <item json> -> the item's tier: what its title or task says (row_tier), else its `tier<N>`
# tag (fill_day stamps one), else 3 for a `night` item or one on a harness project
# (DISPATCH_CLEANUP_PROJECTS), else 1. The gate rides on the item, so an item a session or the human
# queued by hand (`agent-queue add`, no judge) on a harness project still gets the tier-3 gate:
# item_brief names it at start, agent-land checks it at land (`fleet-dispatch item-tier`).
item_tier() {
  local text t tags project
  text=$(jq -r '[.title // empty, .task // empty] | join("\n")' <<<"$1")
  t=$(row_tier "$text")
  tags=" $(jq -r '.tags // ""' <<<"$1") "
  project=$(jq -r '.project // ""' <<<"$1")
  if [ -z "$t" ]; then
    if [[ "$tags" =~ \ tier([1-9])\  ]]; then t=${BASH_REMATCH[1]}
    elif [[ "$tags" == *" night "* ]] || [[ -n "$project" && " $DISPATCH_CLEANUP_PROJECTS " == *" $project "* ]]; then t=3
    fi
  fi
  echo "${t:-1}"
}

# cmd_item_tier <slug> -- print item_tier for a queue item: agent-land's tier-3 check.
cmd_item_tier() {
  local it
  it=$(agent-queue show "${1:?item-tier: needs a slug}" --json 2>/dev/null) && [ -n "$it" ] || { say "item-tier: no queue item $1"; return 1; }
  item_tier "$it"
}

# lane_cached <slug> -> the verdict a pass recorded today for an item no source could take;
# lane_cache <slug> <verdict> records it, so later passes do not ask model-lane again for every
# Opus item while only other sources have room. Only a skip reads it: a start classifies afresh.
lane_cached() { awk -F'\t' -v d="$(date +%F)" -v s="$1" '$1 == d && $2 == s { print $3; exit }' "$LANE_CACHE" 2>/dev/null; }
lane_cache() {
  local d; d=$(date +%F); mkdir -p "$DIR"
  { awk -F'\t' -v d="$d" -v s="$1" '$1 == d && $2 != s' "$LANE_CACHE" 2>/dev/null; printf '%s\t%s\t%s\n' "$d" "$1" "$(jq -c . <<<"$2")"; } > "$LANE_CACHE.tmp" &&
    mv -f "$LANE_CACHE.tmp" "$LANE_CACHE"
}

# live_hand -> one line per live queue item a run slot does not hold: started by hand, redispatched
# or resumed. They add load, which the gate reads, but no run slot.
live_hand() {
  local slug server sess origin project area state _weight _agent _started _sids host
  while IFS=$'\x1f' read -r slug server sess origin project area state _weight _agent _started _sids host; do
    [ -n "$slug" ] || continue
    case "$origin" in '' | run) continue ;; esac
    session_live "$sess" "$server" "$host" && printf '%s/%s\n' "$project" "$area"
  done < <(item_sessions)
  return 0
}

# queue_areas -> "<project>/<area>" for every active queue item that names an area. An item holds
# its area from start until reap closes it, so a session that ended unreaped still holds it.
queue_areas() {
  agent-queue list --json --state active 2>/dev/null | jq -r 'select(.area) | "\(.project)/\(.area)"' 2>/dev/null
  return 0
}

# rows <profile> <project> <lane> -> "<key>\t<raw line>" for each OPEN row on the open version. The
# key is the row's id, which outlives an edit to its text; a row with no id yet goes by its text
# until promote starts it, which stamps one.
rows() {
  local flag=()
  [ "$3" = agent ] && flag=(--agent)
  np "$1" ptask "$2" "${flag[@]}" list 2>/dev/null | cut -f3- |
    sed -E 's/^[^\t]*\t(.*<!--([^>]* )?id:([a-z]{2,4}-[0-9]+)( [^>]*)?-->[[:space:]]*)$/\3\t\1/'
}

# row_line <profile> <project> <lane> <key> -> that row's raw line, nothing when it is not on the
# board. The board is read whole first: piped into something that stops early, a large board dies
# of SIGPIPE and pipefail reads the 141 as "not there".
row_line() {
  local board
  board=$(rows "$1" "$2" "$3")
  K="$4" awk -F'\t' '$1 == ENVIRON["K"] { print substr($0, length($1) + 2); exit }' <<<"$board"
}

# row_priority <raw line> [project] -> the queue priority the row asks for: a bare row is high, the
# default of the row grammar and of agent-queue alike, and so is a cleanup row whatever its #low.
row_priority() {
  case "$(prio_rank "$1")" in
    0) echo urgent ;;
    3) if [ -n "${2:-}" ] && [ "$(cleanup_row "$2" "$1")" = 0 ]; then echo high; else echo low; fi ;;
    *) echo high ;;
  esac
}

# judged_keys -> "<project>\t<lane>\t<key>\t<line sig>\t<details sig>" for each verdict made under
# the current policy, checked against the row by held. A `failed` record holds for the key whatever
# changed ("*"), so a row whose session died is not picked again on its own; a verdict with no dsig
# holds whatever the details (ROW_JQ holds). An `error` holds nothing: the row is judged again.
judged_keys() {
  [ -f "$VERDICTS" ] || return 0
  jq -r --arg sig "$(policy_sig)" '
    if .verdict == "failed" then [.project, .lane, .key, "*", "*"]
    elif .verdict == "error" then empty
    elif .policy == $sig then [.project, .lane, .key, (.line // ""), (.dsig // "*")]
    else empty end | @tsv' "$VERDICTS" 2>/dev/null
}

# cmd_candidates -> one JSON line per open row a worker takes (with SUGGEST=1, every agent row too)
# that no verdict holds, with its details. A #plan row waits for inbox-plan and is left out; suggest
# shows it as blocked. CLEANUP_ONLY (fill_day's cleanup floor) reads only the cleanup projects'
# cleanup rows.
cmd_candidates() {
  local judged table prof name sheet _v stage pprio repo lane key text rank worker tier line today nobody active
  local x planned dj dsig plan off kind board
  local -A DET=() PLN=() PAR=()
  today=${DISPATCH_TODAY:-$(date +%F)}
  judged=$(judged_keys)
  table=$(workers)
  [ -n "$table" ] || return 0
  load_extras
  load_kinds
  for prof in $DISPATCH_PROFILES; do
    while IFS=$'\t' read -r name sheet _v _; do
      [ -n "$name" ] || continue
      [ -z "${CLEANUP_ONLY:-}" ] || [[ " $DISPATCH_CLEANUP_PROJECTS " == *" $name "* ]] || continue
      stage=$(stage_of "$sheet")
      dispatchable "$stage" || continue
      pprio=$(prio_of "$sheet")
      repo=$(repo_dir "$name")
      [ -n "$repo" ] && [ -d "$repo" ] || continue
      # suggest marks a project worked on in the last day, so a gap in worker cover shows.
      active=false
      [ "${SUGGEST:-0}" = 1 ] && [ -n "$(git -C "$repo" log -1 --since=24.hours --format=%h 2>/dev/null)" ] && active=true
      for lane in human agent; do
        board=$(rows "$prof" "$name" "$lane")
        row_kinds_load <<<"$board"
        while IFS=$'\t' read -r key text; do
          [ -n "$key" ] || continue
          case "$text" in '- [ ]'*) ;; *) continue ;; esac
          plan=${PLN["$name"$'\t'"$lane"$'\t'"$key"]:-0}
          [ "$plan" = 0 ] || [ "${SUGGEST:-0}" = 1 ] || continue
          off=$(row_off "$name" "$stage" "$key" "$text")
          [ -z "$off" ] || [ "${SUGGEST:-0}" = 1 ] || continue
          kind=$(row_kind "$text")
          [ -z "${CLEANUP_ONLY:-}" ] || [ "$(cleanup_row "$name" "$text")" = 0 ] || continue
          nobody=''
          if ! read -r rank worker tier < <(row_worker "$table" "$name" "$lane" "$text"); then
            # suggest shows the agent rows no worker takes too, after the ones one does.
            [ "${SUGGEST:-0}" = 1 ] && [ "$lane" = agent ] || continue
            rank=99 worker='' tier=$(row_tier "$text"); tier=${tier:-null}
            nobody=$(nobody_why "$table" "$name" "$lane" "$text")
          fi
          line=$(printf '%s' "$text" | sig)
          x=${DET["$name"$'\t'"$lane"$'\t'"$key"]:-$'0\t""'}
          planned=${x%%$'\t'*} dj=${x#*$'\t'}
          dsig=$(detail_sig "$dj")
          held "$judged" "$name" "$lane" "$key" "$line" "$dsig" && continue
          jq -cn --arg profile "$prof" --arg project "$name" --arg stage "$stage" \
            --arg lane "$lane" --arg key "$key" --arg text "$text" --arg repo "$repo" \
            --argjson details "$dj" --arg dsig "$dsig" --argjson planned "$planned" --argjson plan "$plan" \
            --arg line "$line" --argjson prio "$(prio_rank "$text")" --arg priority "$(row_priority "$text" "$name")" --argjson tier "$tier" \
            --arg worker "$worker" --argjson wrank "$rank" --arg today "$today" --arg pprio "$pprio" \
            --argjson cleanup "$(cleanup_row "$name" "$text")" --arg nobody "$nobody" --argjson active "$active" \
            --arg kind "$kind" --argjson krank "${KIND_RANK[${kind:-_}]:-1}" --arg klabel "${KIND_LABEL[${kind:-_}]:-}" \
            --arg rsize "$(row_size "$text")" --arg off "$off" \
            "$RANK_JQ"'{profile: $profile, project: $project, stage: $stage, lane: $lane, key: $key,
              text: $text, repo: $repo, prio: $prio, priority: $priority, tier: $tier, line: $line,
              worker: $worker, wrank: $wrank, cleanup: $cleanup, details: $details, dsig: $dsig, planned: ($planned == 1),
              kind: $kind, krank: $krank, klabel: $klabel, row_size: $rsize}
              + (if $plan == 1 then {plan: true} else {} end)
              + (if $off != "" then {off: $off} else {} end)
              + (if $nobody != "" then {nobody: $nobody, active: $active} else {} end) | rank_fields($today; $pprio)'
        done <<<"$board"
      done
    done < <(notes --profile "$prof" projects 2>/dev/null)
  done
}

# --- judgment ------------------------------------------------------------------------

# judge <candidates> -- one model call for the unjudged rows; every verdict lands in the cache. Each
# names the policy rule that decided it (`rule`, an id judge_rules reads from the policy) and its
# call (`judge_call`, its calls.jsonl line). A row the call could not judge gets an `error` verdict
# saying why: the call failed, the reply named no rule of the policy, or it left the row out.
judge() {
  local cands="$1" prompt out verdicts wd rc cid err rules missing n rows
  [ -n "$cands" ] || return 0
  # Over the cap, each project's best-ranked row (RANK_JQ) in turn, then each one's second, and so
  # on: in rank order alone the cap re-judged the same agent-runtime rows and never reached notes-cockpit.
  # Within a round a cleanup row goes first, and rank already puts it first in its project; ahead of
  # the rounds it took every slot from a project with no cleanup (review of #1222).
  # A row whose old verdict still holds (a policy edit made it stale) goes after every row with
  # none, so an edit costs the board's new rows nothing; a stale dispatch, the verdict that
  # acts, before a stale skip.
  rules=$(policy_rules)
  cands=$(jq -sc --argjson prules "$rules" --argjson max "$DISPATCH_JUDGE_MAX" --slurpfile v <(latest_verdicts) "$RANK_JQ$ROW_JQ"'
      ($v | map({key: ([.project, .lane, .key] | tostring), value: .}) | from_entries) as $by
      | map(. as $c | . + {stale: (($by[[.project, .lane, .key] | tostring] // {}) as $d
          | if ($d | usable($prules)) and ($d | holds($c)) then (if $d.verdict == "dispatch" then 1 else 2 end) else 0 end)})
      | rank | to_entries | group_by(.value.project)
      | map(to_entries | map({round: .key, i: .value.key, row: .value.value})) | flatten
      | sort_by(.row.stale, .round, (.row.cleanup // 1), .i) | .[:$max][].row | del(.stale)' <<<"$cands")
  [ -r "$DISPATCH_POLICY" ] || { JUDGE_WHY="no policy at $DISPATCH_POLICY"; say "$JUDGE_WHY"; return 1; }
  # Rows are numbered and counted: on 2026-11-07 two 40-row passes came back with 39 verdicts,
  # each dropping one row whole (hc-122, ar-269), and a dropped row is an error verdict.
  # The count is of the numbered lines themselves, so the two never disagree.
  rows=$(jq -c '{project, stage, lane, key, text, tier} + (if (.row_size // "") != "" then {size: .row_size} else {} end)
    + (if (.details // "") != "" then {details} else {} end)' <<<"$cands" | awk '{ print NR ". " $0 }')
  n=$(grep -c . <<<"$rows")
  prompt="## Rows to judge

$rows

## Answer

There are $n rows above. Return exactly $n verdicts in the structured output, one per numbered row, in the same order. Copy project, lane and key exactly as given."
  # The call runs in an empty directory: from inside a repo, that repo's Stop hook runs its
  # tests after the answer, and the model's last message becomes a reply to the hook instead
  # of the verdicts (2026-10-27, run from ~/.dotfiles: every pass failed on one row).
  wd=$(mktemp -d)
  cid=$(judge_call_id)
  # shellcheck disable=SC2086 # the command is a word list by design (overridable in tests)
  out=$(cd "$wd" && AGENTCTL_CALL_ID="$cid" $DISPATCH_JUDGE_CMD -p "$prompt" 2>"$wd/err")
  rc=$?
  err=$(head -c 200 "$wd/err" | tr '\n' ' ')
  rm -rf -- "$wd"
  mkdir -p "$DIR"
  # A budget stop is no verdict on any row, so it leaves no error line and they are judged again.
  if [ "$rc" = "$EX_BUDGET" ]; then JUDGE_WHY="stopped at its budget"; touch "$VERDICTS"; say "judge $JUDGE_WHY"; return "$rc"; fi
  if [ "$rc" != 0 ]; then
    JUDGE_WHY="call failed (exit $rc)${err:+: $err}"
    verdict_errors "$cands" "$JUDGE_WHY" "$cid" >> "$VERDICTS"
    say "judge $JUDGE_WHY"; return 1
  fi
  # The reply is the schema's one object (SCHEMA in the agent's conf); prose yields no verdicts.
  verdicts=$(jq -c '.verdicts[]?' <<<"$out" 2>/dev/null |
    jq -c --arg at "$(date -Iseconds)" --arg sig "$(policy_sig)" --arg call "$cid" --argjson rules "$rules" \
      --argjson c "$(jq -sc 'map({k: ([.project, .lane, .key] | tostring), line, dsig})' <<<"$cands")" '
      select(type == "object"
        and (.project | type) == "string" and (.lane | type) == "string"
        and (.key | type) == "string" and (.verdict == "dispatch" or .verdict == "skip"))
      | ([.project, .lane, .key] | tostring) as $k
      | {project, lane, key, tier, size, area, clear, agent_only, tier3_only, verdict, rule, reason, at: $at,
         policy: $sig, line: ([$c[] | select(.k == $k) | .line] | first),
         dsig: ([$c[] | select(.k == $k) | .dsig] | first), judge_call: $call}
      | . as $v | if any($rules[]; . == $v.rule) then $v
        else {project, lane, key, verdict: "error", reason: "rule \(.rule // "" | tojson) is not in the policy",
              at, policy, line, judge_call} end')
  # A pass that could not judge must not read as "no row qualifies".
  if [ -z "$verdicts" ]; then
    JUDGE_WHY="the reply had no verdicts"
    verdict_errors "$cands" "$JUDGE_WHY" "$cid" >> "$VERDICTS"
    say "judge returned no verdicts for $(wc -l <<<"$cands") row(s): ${out:0:200}"; return 1
  fi
  missing=$(jq -c --argjson got "$(jq -sc 'map([.project, .lane, .key] | tostring)' <<<"$verdicts")" \
    'select(([.project, .lane, .key] | tostring) as $k | any($got[]; . == $k) | not)' <<<"$cands")
  {
    printf '%s\n' "$verdicts"
    verdict_errors "$missing" "the reply had no verdict for this row" "$cid"
  } >> "$VERDICTS"
  size_back "$cands" "$verdicts"
}

# size_back <candidates> <verdicts> -- tag each unsized row (with an id) the judge sized with that
# `#size/`, so the row is the one size store (the human's choice, ask Q0lKDF). The verdict is then
# recorded again for the row's new text, which differs only by that tag, so it is not judged twice.
size_back() {
  local prof p lane key s raw flag
  while IFS=$'\t' read -r prof p lane key s; do
    flag=(); [ "$lane" = agent ] && flag=(--agent)
    np "$prof" ptask "$p" "${flag[@]}" tag --add "size/$s" "$key" >/dev/null 2>&1 || { say "size_back: could not tag $p $key size/$s"; continue; }
    raw=$(row_line "$prof" "$p" "$lane" "$key")
    [ -n "$raw" ] || continue
    jq -c --arg p "$p" --arg l "$lane" --arg k "$key" --arg line "$(printf '%s' "$raw" | sig)" \
      'select(.project == $p and .lane == $l and .key == $k) | . + {line: $line}' <<<"$2" >> "$VERDICTS"
  done < <(jq -r --slurpfile c <(printf '%s\n' "$1") '
    ($c | map({key: ([.project, .lane, .key] | tostring), value: .}) | from_entries) as $by
    | $by[[.project, .lane, .key] | tostring] as $r
    | select($r != null and ($r.row_size // "") == "" and .verdict != "error"
        and ((.size // "") | IN("S", "M", "L")) and (.key | test("^[a-z]{2,4}-[0-9]+$")))
    | [$r.profile, .project, .lane, .key, (.size | ascii_downcase)] | @tsv' <<<"$2")
}

# verdict_errors <rows> <reason> <call id> -- an `error` verdict line for each row. judged_keys
# skips errors, so the next pass judges those rows again.
verdict_errors() {
  [ -n "$1" ] || return 0
  jq -c --arg r "$2" --arg call "$3" --arg at "$(date -Iseconds)" --arg sig "$(policy_sig)" \
    '{project, lane, key, verdict: "error", reason: $r, at: $at, policy: $sig, line, judge_call: $call}' <<<"$1"
}

# plan_skips -- tag #plan each open agent row the judge skipped by one of DISPATCH_PLAN_RULES (not
# defined enough to start), and each cleanup row (cleanup_row) it read as not clear or size L or XL
# under a dispatch or a tier-3 skip (that skip hid both, so those rows never moved: 87 on
# 2026-11-06; a needs-person, release, prod-write or decide skip waits on the human, not a plan), that
# inbox-plan never planned (no `goal:` detail), while fewer than DISPATCH_PLAN_BACKLOG #plan rows
# are open, then kick inbox-plan. Its plan splits or rewrites the row, so the judge reads it again
# with the plan. A design or question skip waits on the human, not a plan. Sets PLAN_TAGGED.
plan_skips() {
  local board rows room p prof id raw line dsig dj why size
  PLAN_TAGGED=0
  [ "$DISPATCH_PLAN_BACKLOG" -gt 0 ] || return 0
  board=$(notes board --json 2>/dev/null) || { say "plan_skips: notes board --json failed"; return 0; }
  room=$(jq -r "$ROW_JQ"'[.rows[]? | select(plan_tagged)] | length' <<<"$board")
  room=$(( DISPATCH_PLAN_BACKLOG - ${room:-0} ))
  [ "$room" -gt 0 ] || return 0
  rows=$(jq -r --argjson prules "$(policy_rules)" --arg rules "$DISPATCH_PLAN_RULES" --argjson n "$DISPATCH_DETAIL_CHARS" \
      --slurpfile v <(latest_verdicts) "$ROW_JQ"'
    ($rules | split(" ") | map(select(length > 0))) as $r
    | ($v | map(select(.lane == "agent" and usable($prules)))
       | map(. + {why: (if .verdict == "skip" and (.rule as $u | $r | index($u)) then "rule"
                        elif .verdict == "skip" and .rule != "tier3" and .tier3_only != true then empty
                        elif .clear == false then "unclear" else "size:" + ((.size // "") | ascii_upcase) end)})
       | map({key: "\(.project)\t\(.key)", value: .}) | from_entries) as $by
    | .rows[]? | select(.lane == "agent" and .id != null and (plan_tagged | not) and (planned | not))
    | $by["\(.project)\t\(.id)"] as $d | select($d != null)
    | "\(.profile)\t\(.project)\t\(.id)\t\($d.line)\t\($d.dsig // "-")\t\(details_json($n))\t\($d.why)\t\(.raw)"' <<<"$board")
  # raw last: read hands it the rest of the line; details_json is JSON, with no bare tab. No field
  # is empty: a tab is IFS whitespace, so read would fold an empty one into its neighbour
  while IFS=$'\t' read -r prof p id line dsig dj why raw; do
    [ -n "$id" ] && [ "$room" -gt 0 ] || continue
    if [ "$why" != rule ]; then
      [ "$(cleanup_row "$p" "$raw")" = 0 ] || continue
      size=$(row_size "$raw" || true); size=${size:-${why#size:}}
      [ "$why" = unclear ] || [ "$size" = L ] || [ "$size" = XL ] || continue
    fi
    # the verdict must still hold for the row as it reads now (ROW_JQ holds)
    [ "$(printf '%s' "$raw" | sig)" = "$line" ] || continue
    [ "$dsig" = - ] || [ "$(detail_sig "$dj")" = "$dsig" ] || continue
    if np "$prof" ptask "$p" --agent tag --add plan "$id" >/dev/null 2>&1; then
      PLAN_TAGGED=$(( PLAN_TAGGED + 1 )); room=$(( room - 1 ))
    else say "plan_skips: could not tag $p $id"; fi
  done <<<"$rows"
  [ "$PLAN_TAGGED" = 0 ] && return 0
  say "tagged $PLAN_TAGGED for a plan"
  "$HERE/agentctl-inbox-plan" --kick || say "plan_skips: could not start inbox-plan"
}

# suggest [--json] -- the Candidates list: every open agent-lane row (and every row a worker takes)
# of each project from dev up with a repo, in every notes profile, in RANK_JQ order. Each
# carries `why`; `auto`, whether a worker in workers.json takes it (widening one is a line there);
# `verdict`, the latest under this policy for this text, or `unjudged`; `held`, whether an active
# queue item holds its area; and `blocked`, every counted reason it would not start (nobody_why,
# size, the judge's skip, a held area), with `active` on a row no worker takes when its repo moved
# in the last day. Display only: it never judges, claims or queues.
cmd_suggest() {
  local profs cands
  profs=$(notes projects --stats --json 2>/dev/null | jq -r '[.[].profile] | unique | join(" ")' 2>/dev/null)
  [ -n "$profs" ] || profs=$DISPATCH_PROFILES
  cands=$(SUGGEST=1 DISPATCH_PROFILES="$profs" VERDICTS=/dev/null cmd_candidates)
  [ -n "$cands" ] || { [ "${1:-}" = --json ] || echo "suggest: no open agent row"; return 0; }
  jq -sc --arg sig "$(policy_sig)" --argjson prules "$(policy_rules)" --slurpfile v <(latest_verdicts) \
    --argjson busy "$(queue_areas | jq -Rsc 'split("\n") | map(select(length > 0) | ascii_downcase)')" "$RANK_JQ$ROW_JQ"'
    ($v | map({key: ([.project, .lane, .key] | tostring), value: .}) | from_entries) as $by
    | map(. as $c | $by[[.project, .lane, .key] | tostring] as $d
      | . + {auto: (.worker != ""), area: (($d.area // "") | ascii_downcase), stale: ($d != null and $d.verdict != "failed" and $d.policy != $sig),
             verdict: (if $d == null then "unjudged" elif $d.verdict == "failed" then "failed"
                       elif ($d | usable($prules) | not) or ($d | holds($c) | not) then "unjudged" else $d.verdict end)}
      | . + {held: (.area != "" and ("\(.project | ascii_downcase)/\(.area)" as $a | $busy | index($a)) != null),
             size: eff_size($d), reason: ($d.reason // "")})
    | map(. + {blocked: [(.off // empty), (.nobody // empty), (if .plan then "waits on a plan" else empty end),
        (if .size | IN("L", "XL") then "size/l: too big for a pick" else empty end),
        (if .verdict == "skip" or .verdict == "failed" then "judge: \(.verdict)\(if .reason != "" then ", \(.reason)" else "" end)" else empty end),
        (if .held then "area held by a queue item" else empty end)]})
    | rank | .[]' <<<"$cands" |
    if [ "${1:-}" = --json ]; then cat; else
      jq -r '"\(if .auto then "auto" else "man " end)  \(.verdict | .[0:8] | . + " " * (8 - length))  \(.project) \(.key)  [\(.why)]\(if (.blocked | length) > 0 then "  blocked: \(.blocked | join("; "))" else "" end)"'
    fi
}

# latest verdict per row, as JSON lines. An `error` record does not replace an earlier verdict: a call
# that failed or named no rule says nothing about the row, so its stale-but-usable verdict stays
# and the row is judged again (judged_keys reads the file itself and skips errors).
latest_verdicts() {
  [ -f "$VERDICTS" ] || return 0
  jq -sc 'group_by([.project, .lane, .key]) | map((map(select(.verdict != "error")) | last) // last) | .[]' "$VERDICTS" 2>/dev/null
}

# picks <candidates> <room> -> the rows to launch: the row's latest verdict is a dispatch made
# under a policy that still defines its rule, for its current text, S or M, clear, agent-only, naming one area, and
# judged no higher a tier than the row counts as (all checked here too, so a lax verdict cannot
# launch anything); never two on an area, held by an active item or picked now; in RANK_JQ order.
picks() {
  local cands="$1" room="$2"
  [ "$room" -gt 0 ] && [ -n "$cands" ] || return 0
  jq -sc --argjson room "$room" --argjson prules "$(policy_rules)" --argjson max "$UNATTENDED_TIER_CEILING" \
    --argjson busy "$(queue_areas | jq -Rsc 'split("\n") | map(select(length > 0) | ascii_downcase)')" \
    --slurpfile v <(latest_verdicts) "$RANK_JQ$ROW_JQ"'
    ($v | map({key: ([.project, .lane, .key] | tostring), value: .}) | from_entries) as $by
    | map(. as $c | $by[[.project, .lane, .key] | tostring] as $d
      | select($d != null and $d.verdict == "dispatch" and (eff_size($d) | IN("S", "M"))
          and $d.clear == true and $d.agent_only == true and ($d | usable($prules)) and ($d | holds($c))
          and ($d.tier | type) == "number" and $d.tier <= $c.tier and $c.tier <= $max
          and ($d.area | type) == "string" and $d.area != "")
      | . + {area: ($d.area | ascii_downcase)})
    | map(select("\(.project | ascii_downcase)/\(.area)" as $a | $busy | index($a) | not))
    | rank | unique_by([.project, .area]) | rank
    | .[:$room] | .[]' <<<"$cands"
}

# --- launch --------------------------------------------------------------------------

# new_sid -> a fresh session id for `claude --session-id`, so the item claims it before the pane
# starts and the session's preflight never takes the queue lock.
new_sid() {
  local u
  u=$(cat /proc/sys/kernel/random/uuid 2>/dev/null || uuidgen 2>/dev/null) && [ -n "$u" ] || return 1
  printf '%s\n' "$u" | tr '[:upper:]' '[:lower:]'
}

# launch_mode <mode> -- set the caller's flags and ready: claude's flags for that mode, and the
# footer that shows it came up. A session in any mode but bypass may still need bypass later (a
# plan once approved), and claude offers it then only when it was allowed at launch.
launch_mode() {
  case "$1" in
    bypassPermissions) flags="--permission-mode bypassPermissions" ready="bypass permissions on" ;;
    plan) flags="--permission-mode plan --allow-dangerously-skip-permissions" ready="plan mode on" ;;
    *) flags="--permission-mode $(printf '%q' "$1") --allow-dangerously-skip-permissions" ready='' ;;
  esac
}

# dropped_tools <item json> -- " --disallowedTools <DISPATCH_DROP_TOOLS>" for a new claude start, or
# nothing. Those tools' schemas ride on every turn of a session that never calls them: in the 7 days
# to 2026-11-06, Workflow had 1 call and ScheduleWakeup 43 (all /loop) across about 2,900 sessions,
# for about 10K chars a turn. Artifact (2026-11-07, ask OaAlhA): 11 calls a week, all from queue
# sessions the human rarely reads, for 35K chars on the turns that carry it; the human's own
# sessions keep it. A task that names one of them, ultracode or /loop keeps every tool.
# It goes before --permission-mode: the flag takes a list, so the brief after it would join it.
dropped_tools() {
  [ -n "$DISPATCH_DROP_TOOLS" ] || return 0
  [[ "$DISPATCH_DROP_TOOLS" =~ ^[A-Za-z0-9_]+(,[A-Za-z0-9_]+)*$ ]] ||
    { say "DISPATCH_DROP_TOOLS is not a comma list of tool names: $DISPATCH_DROP_TOOLS; dropping none"; return 0; }
  jq -r .task <<<"$1" | grep -qiE "ultracode|/loop|${DISPATCH_DROP_TOOLS//,/|}" && return 0
  printf ' --disallowedTools %s' "$DISPATCH_DROP_TOOLS"
}

# lane_sandbox <cwd> -- set the caller's sbx_env and sbx_flags for a claude start under
# DISPATCH_SANDBOX_PROFILE, both empty when the knob is empty (the lane runs as before). The profile
# and the lane's GitHub token go through lib/sandbox.sh, the code agentctl-run runs a lane under, so a
# session and a runner cannot drift: the hard gates are forced on, the git common dir of <cwd> is
# writable. The token reaches the pane as a file read by its shell, never on the launch line. rc 1 and
# no start when the profile is missing, malformed or unreadable (the item stays queued).
lane_sandbox() {
  local json
  sbx_env='' sbx_flags=''
  [ -n "$DISPATCH_SANDBOX_PROFILE" ] || return 0
  # lib/sandbox.sh refuses through role_die (agentctl-run's, which exits). It is defined inside this
  # subshell so the exit ends the load and never the dispatcher, and no global copy of it can drift.
  json=$(role_die() { say "$*"; exit 78; }
    cd "$1" && SANDBOX_PROFILE=$DISPATCH_SANDBOX_PROFILE GH_TOKEN_FILE=$DISPATCH_SANDBOX_GH_TOKEN_FILE && sandbox_load && sandbox_claude_settings) && [ -n "$json" ] ||
    { say "start: lane sandbox '$DISPATCH_SANDBOX_PROFILE' cannot be applied; nothing started"; return 1; }
  sbx_flags=" --settings $(printf '%q' "$json")"
  if [ -n "$DISPATCH_SANDBOX_GH_TOKEN_FILE" ]; then
    sbx_env="GH_TOKEN=\"\$(tr -d '[:space:]' < $(printf '%q' "$DISPATCH_SANDBOX_GH_TOKEN_FILE"))\" env -u GITHUB_TOKEN "
  else
    sbx_env='env -u GH_TOKEN -u GITHUB_TOKEN '
  fi
}

# last_mode <id> -> the permission mode it last ran in, from the transcript, which outlives its
# server: a permission-mode line, or the mode on a user turn, whichever is last.
last_mode() {
  local t
  t=$(compgen -G "$HOME/.claude/projects/*/$1.jsonl" | head -1)
  [ -n "$t" ] || return 0
  tac "$t" | grep -m1 -o '"permissionMode":"[A-Za-z]*"' | cut -d'"' -f4
}

# resume_mode <id> <item mode> -> the mode a resume reopens in: the transcript's last one, else plan
# for a plan item (a resume must not skip its approval), else bypassPermissions.
resume_mode() {
  local m; m=$(last_mode "$1")
  if [ -n "$m" ]; then echo "$m"; elif [ "$2" = plan ]; then echo plan; else echo bypassPermissions; fi
}

# start_ready <server> <session> <pane> <ready text> -- an account that never opened this folder asks "Do you
# trust this folder?" first, defaulting to "No, exit". claude-acct trust answers it once and waits
# for claude's mode footer.
start_ready() {
  command -v claude-acct >/dev/null 2>&1 || return 0
  claude-acct trust "$1" "$3" "$4" >/dev/null || say "$2: claude did not show \"$4\"; look at its pane"
}

# harness_launcher <harness> -> the wrapper that runs it: its `launcher` in the map, else its own name.
harness_launcher() { jq -er --arg h "$1" '.harnesses[$h].launcher // $h' "$HARNESSES" 2>/dev/null || echo "$1"; }

# harness_key_file <harness> -> the key file it spends: its own `key_file`, else the gateway's (the eval key).
harness_key_file() { jq -r --arg h "$1" '(.harnesses[$h].key_file // .gateway.key_file) | sub("^~"; env.HOME)' "$HARNESSES"; }

# harness_source <harness> -> the source its runs spend, its `source` in the map (a row of claude-acct's
# sources file; claude-acct is the one reader of how much that source has left).
harness_source() { jq -r --arg h "$1" '.harnesses[$h].source // empty' "$HARNESSES" 2>/dev/null; }

# gateway_launch <harness> <model> <item json> <brief> -- past every refusal, set cmd to the launch
# line, and sid to the session id an opencode run takes. Refuses (rc 2, or 1 for the budget or room) before
# anything starts. No default model: on this lane the pairing is the experiment, and the map is what
# stops `--model opus` on claude-lazer, which pins every slot to Sonnet, from mislabelling the run.
# A pane inherits its tmux server's environment, so each line drops the master key.
gateway_launch() {
  local harness="$1" model="$2" it="$3" brief="$4" slug id left file src repo dir
  [ -r "$HARNESSES" ] || { say "start: no harness map at $HARNESSES"; return 2; }
  jq -e --arg h "$harness" '.harnesses | has($h)' "$HARNESSES" >/dev/null || { say "start: unknown harness: $harness"; return 2; }
  [ -n "$model" ] || { say "start: harness $harness needs --model, or a model: on the item"; return 2; }
  id=$(jq -r --arg h "$harness" --arg m "$model" '.harnesses[$h].models[$m] // empty' "$HARNESSES")
  [ -n "$id" ] || { say "start: harness $harness has no model $model"; return 2; }
  # Room is claude-acct's verdict on the source the harness spends; a cloud session spends a Claude
  # account, picked at launch, so it asks for any account with room.
  if [ "$(harness_launcher "$harness")" = claude-cloud ]; then
    left=$(claude-acct room --json 2>&1)
    jq -e '.pick != null' <<<"$left" >/dev/null 2>&1 || { say "start: $harness has no room: $(jq -r '.why // empty' <<<"$left" 2>/dev/null)"; return 1; }
  else
    src=$(harness_source "$harness")
    [ -n "$src" ] || { say "start: harness $harness has no source in $HARNESSES"; return 2; }
    left=$(claude-acct room --source "$src" 2>&1) || { say "start: $harness has no room: $left"; return 1; }
  fi
  slug=$(jq -r .slug <<<"$it")
  file=$(harness_key_file "$harness")
  ! headless "$harness" || [ "$(jq -r .mode <<<"$it")" != plan ] || { say "start: $harness runs to its end and cannot wait on a plan; $slug is a plan item"; return 2; }
  case "$(harness_launcher "$harness")" in
    claude-lazer)
      launch_mode "$(jq -r 'if .mode == "plan" then "plan" else "bypassPermissions" end' <<<"$it")"
      cmd="AGENT_QUEUE_ITEM=$(printf '%q' "$slug") $(telemetry_env "$cwd" "$slug")env -u CLAUDE_CONFIG_DIR -u LITELLM_MASTER_KEY CLAUDE_LAZER_KEY=$(printf '%q' "$file") AGENT_HARNESS=$(printf '%q' "$harness")"
      sid=$(new_sid) || { say "start: no session id for queue item $slug; it stays queued"; return 1; }
      cmd="$cmd ANTHROPIC_CUSTOM_HEADERS=$(printf '%q' "x-litellm-tags: queue:$slug") claude-lazer --model $(printf '%q' "$id") --session-id $sid $flags $(printf '%q' "$brief")"
      ;;
    opencode)
      # Standalone: the background service would not see this run's env or config. Nothing else
      # can name the run for the outcome join, so the id is chosen here.
      sid="ses_eval$(date +%s%N)"
      cmd="AGENT_QUEUE_ITEM=$(printf '%q' "$slug") OPENCODE_CONFIG=$(jq -r --arg h "$harness" '.harnesses[$h].config | sub("^~"; env.HOME) | @sh' "$HARNESSES") env -u LITELLM_MASTER_KEY"
      cmd="$cmd timeout $(jq -r --arg h "$harness" '.harnesses[$h].timeout_min' "$HARNESSES")m opencode run --standalone --auto --session $sid"
      cmd="$cmd --title $(printf '%q' "$slug") --model $(printf '%q' "$id") --agent build $(printf '%q' "$brief") </dev/null"
      ;;
    codex)
      # The ChatGPT login bills the plan; an API key in the pane's env would bill per token instead.
      # agent-codex claims the thread id on the item when codex names it.
      cmd="AGENT_QUEUE_ITEM=$(printf '%q' "$slug") env -u LITELLM_MASTER_KEY -u OPENAI_API_KEY -u CODEX_API_KEY"
      cmd="$cmd timeout $(jq -r --arg h "$harness" '.harnesses[$h].timeout_min' "$HARNESSES")m agent-codex run -m $(printf '%q' "$id")"
      cmd="$cmd --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check --color never $(printf '%q' "$brief")"
      ;;
    claude-cloud)
      # A Claude cloud session: a fresh GitHub clone on Anthropic's VM, billed to the plan, with none of
      # this machine's skills, hooks or queue. So only an oneshot item below tier 3 may go, and only
      # from a GitHub repo; claude-cloud-run keeps the pane until the session's PR is found.
      [ "$(jq -r .mode <<<"$it")" != plan ] || { say "start: a cloud session cannot wait on a plan; $slug is a plan item"; return 2; }
      [ "$(item_tier "$it")" != 3 ] || { say "start: $slug is tier 3, which merges behind a local gate a cloud session lacks"; return 2; }
      repo=$(cloud_repo "$cwd") || { say "start: $slug has no GitHub repo for a cloud session to clone: $cwd"; return 2; }
      # acct is cmd_start's (dynamic scope): the claude account this session bills, recorded as account=.
      dir=$(account_dir); acct=$(basename "${dir:-main}")
      cmd="AGENT_QUEUE_ITEM=$(printf '%q' "$slug") $(account_env "$dir")CLOUD_TIMEOUT_MIN=$(jq -r --arg h "$harness" '.harnesses[$h].timeout_min' "$HARNESSES")"
      cmd="$cmd claude-cloud-run $(printf '%q' "$slug") $(printf '%q' "$repo") $(printf '%q' "$brief")"
      ;;
    *) say "start: no launcher for harness $harness"; return 2 ;;
  esac
}

# cloud_repo <dir> -> owner/repo of the GitHub remote a cloud session would clone; rc 1 for any other host.
cloud_repo() {
  local url; url=$(git -C "$1" remote get-url origin 2>/dev/null) || return 1
  [[ "$url" == *github.com[:/]* ]] || return 1
  url=${url#*github.com[:/]}; url=${url%.git}
  [[ "$url" == */* && "$url" != */*/* ]] && printf '%s\n' "$url"
}

# cloud_routed <slug> -> rc 0 when the queued item is a claude one tagged cloud-ok, which runs in a cloud
# session: the tag is the human's word that it is self-contained, on GitHub, and needs no local skill.
# An item that names another model (agent: codex, model: opus) is not routed: the cloud has one model.
# agent=claude-cloud is what a start recorded, so a re-queued item routes again.
cloud_routed() {
  agent-queue show "$1" --json 2>/dev/null |
    jq -e '((.agent // "claude") | . == "claude" or . == "claude-cloud") and ((.model // "") | . == "" or . == "cloud") and ((" " + (.tags // "") + " ") | contains(" cloud-ok "))' >/dev/null 2>&1
}

# headless <harness> -- the harness runs to its end with no slash commands, hooks or human at the pane:
# its `headless` in the map.
headless() { jq -e --arg h "$1" '.harnesses[$h].headless == true' "$HARNESSES" >/dev/null 2>&1; }

# cmd_start -- THE way an agent starts a session, whoever it is: this runner's `run` pass, an
# agent launching one for a board row, a reboot restore. Each comes out tagged @dispatch on
# its server (the human reads [dispatch] as "an agent started this"), and a session doing work
# has a queue item whose `session:` names it, which reap, fleet-sessions and agent-web read.
# Before this, only `run` did either, and agents tagged their hand launches with set-option,
# which the human had to ask about twice.
#   --item SLUG             start that queued item: a worktree off --cwd (default: the project's
#                           repo) with `wt new`, claude on the item's brief there.
#   --host NAME             with --item: open it on that fleet worker (fleet-hosts.sh) over ssh, not here.
#                           Claude only, in a repo the worker lists (fleet_repos), unsandboxed; its
#                           queue and ask writes go to the inventory's fleet_state_host (AGENT_STATE_HOST).
#   --harness NAME          with --item: run it on claude or a gateway harness in harnesses.json, not
#                           the item's `agent:`: claude-lazer and opencode on the eval key, codex on the ChatGPT plan, lazer-reserve
#                           on the claude-reserve key (where a run pass routes a Sonnet-lane item, start_item).
#   --brief FILE --row KEY  claim the open row (an id in any case), promote it into a queue item with the brief as
#                           its task, and start that item as --item does.
#   --resume ID             a new session --session NAME in --cwd DIR running claude --resume.
#                           The sheet is not touched: the row was claimed before the reboot.
#                           --item SLUG re-attaches the started item that session was working;
#                           without it, the running or waiting item that lists ID (`agent-queue mine --sid`).
#                           --window NAME opens it as a window of --session instead, which may
#                           already hold others: a world session like hub:dotfiles.
#                           It reopens in the mode its transcript last shows; with none, plan for
#                           a plan item, else bypass.
cmd_start() {
  local project='' prof='' lane=human key='' server='' model='' brief_file='' \
    resume='' cwd='' session='' window='' joined='' target='' area='' item='' it='' st='' flags='' ready='' harness='' sid='' on='' verdict='' sbx_env='' sbx_flags='' host='' hjson='' state_env='' brief cmd label origin acct mode rec size
  while [ $# -gt 0 ]; do
    case "$1" in
      --agent) lane=agent; shift; continue ;;
      --project | --profile | --row | --server | --model | --brief | --resume | --cwd | --session | --window | --area | --item | --harness | --host) ;;
      *) say "start: unknown argument: $1"; return 2 ;;
    esac
    [ $# -ge 2 ] && [ -n "$2" ] || { say "start: $1 needs a value"; return 2; }
    case "$1" in
      --project) project=$2 ;;
      --profile) prof=$2 ;;
      --row) key=$2; if [[ "$key" =~ ^[A-Za-z]{2,4}-[0-9]+$ ]]; then key=${key,,}; fi ;; # ids are written lower-case, typed both ways
      --server) server=$2 ;;
      --model) model=$2 ;;
      --brief) brief_file=$2 ;;
      --resume) resume=$2 ;;
      --cwd) cwd=$2 ;;
      --session) session=$2 ;;
      --window) window=$2 ;;
      --area) area=$2 ;;
      --item) item=$2 ;;
      --harness) harness=$2 ;;
      --host) host=$2 ;;
    esac
    shift 2
  done
  [ -z "$harness" ] || [ -z "$resume" ] || { say "start: --harness starts an item; a resume stays on what it ran"; return 2; }
  [ -z "$harness" ] || [ -n "$item" ] || { say "start: --harness needs --item"; return 2; }
  if [ -n "$host" ]; then
    [ -n "$item" ] && [ -z "$resume$brief_file" ] || { say "start: --host starts a queued --item"; return 2; }
    [ -z "$DISPATCH_SANDBOX_PROFILE" ] || { say "start: a fleet worker cannot hold lane sandbox '$DISPATCH_SANDBOX_PROFILE'; nothing started"; return 2; }
    fleet_hosts >/dev/null
    hjson=$(fleet_host "$host") || { say "start: $host is not in the fleet roster ($FLEET_HOSTS_GROUP)"; return 2; }
    state_env=$(jq -r .state_host <<<"$hjson")
    [ -n "$state_env" ] || { say "start: $host has no fleet_state_host, so its session could not write the queue"; return 2; }
    state_env="AGENT_STATE_HOST=$(printf '%q' "$state_env") "
  fi
  # A new session goes where the manifests say; --server only puts a resume back where it was.
  [ -z "$server" ] || [ -n "$resume" ] || { say "start: --server is for --resume; the agent world comes from the manifests"; return 2; }
  [ -n "$server" ] || server=$(tmux-world agents)
  [ -n "$server" ] || { say "start: no world declares @agents on this machine"; return 1; }
  if [ -n "$brief_file" ]; then
    [ -z "$resume$item" ] || { say "start: give exactly one of --brief, --item or --resume"; return 2; }
    [ -n "$project" ] || { say "start: --project is required"; return 2; }
    [ -n "$key" ] || { say "start: --brief needs the --row it works"; return 2; }
    [ -z "$session" ] || { say "start: --brief cuts its own worktree session; --session is for --resume"; return 2; }
    brief=$(cat -- "$brief_file") && [ -n "$brief" ] || { say "start: empty or unreadable brief: $brief_file"; return 2; }
    # The row becomes a queue item and the item is what starts: one record and one launch for
    # every session. The item's brief adds /one-shot and how to close the row, so a brief that
    # opens with /one-shot is not run through it twice.
    promote "$(jq -cn --arg profile "$prof" --arg project "$project" --arg lane "$lane" --arg key "$key" --arg area "$area" \
      '{profile: $profile, project: $project, lane: $lane, key: $key, area: $area}')" "" "${brief#/one-shot }" >/dev/null || return 1
    item=$PROMOTED key=''
  elif [ -z "$item$resume" ]; then
    say "start: give exactly one of --brief, --item or --resume"
    return 2
  fi
  if [ -n "$resume" ]; then
    # One writer per transcript: a second claude on a live conversation would also take its item.
    ! conversation_live "$resume" || { say "start: conversation $resume is still running; end it before resuming it"; return 1; }
    # A resume works the item that lists its conversation, so a hand resume keeps AGENT_QUEUE_ITEM too.
    if [ -z "$item" ]; then
      item=$(agent-queue mine --sid "$resume" 2>&1)
      case $? in 0) ;; 2) say "start: ${item#agent-queue: }; pass --item"; return 1 ;; *) item='' ;; esac
    fi
  fi
  if [ -n "$item" ] && [ -z "$resume" ]; then
    [ -n "$harness" ] || [ -n "$model" ] || ! cloud_routed "$item" || harness=claude-cloud
    # Before the lock: model-lane may ask an LLM (20s timeout), and another start must not wait on it.
    verdict=${START_VERDICT:-}; [ -n "$verdict" ] || [ -n "$model" ] || verdict=$(lane_pick "$item" "$harness")
    # One start of a queue item at a time, from the queued check until the item is running: on
    # 11-04 a pass and a hand start both saw one item queued, and the pass's launch failed. fd 7
    # closes when this item is running, or when the caller (start_item, or the process) ends.
    mkdir -p "$DIR"; exec 7>"$DIR/.start.lock"
    flock -w "$DISPATCH_START_WAIT" 7 || { say "start: another start held the queue lock for ${DISPATCH_START_WAIT}s; $item stays queued"; return 1; }
  fi
  if [ -n "$item" ]; then
    it=$(agent-queue show "$item" --json 2>/dev/null) || { say "start: no queue item: $item"; return 2; }
    st=$(jq -r .state <<<"$it")
    if [ -n "$resume" ]; then
      case "$st" in running | waiting) ;; *) say "start: $item is $st; --resume re-attaches an item already started"; return 1 ;; esac
      [ "$(jq -r '.agent // "claude"' <<<"$it")" = claude ] || { say "start: $item ran on $(jq -r .agent <<<"$it"); --resume is for claude"; return 2; }
    else
      [ -z "$key$session" ] || { say "start: --item is a launch of its own: no --row or --session"; return 2; }
      [ "$st" = queued ] || { say "start: $item is $st, not queued"; return 1; }
    fi
    project=$(jq -r .project <<<"$it")
    [ -n "$area" ] || area=$(jq -r '.area // empty' <<<"$it")
  fi
  [ -n "$project" ] || { say "start: --project is required"; return 2; }

  if [ -n "$resume" ]; then
    [ -z "$key" ] || { say "start: --resume takes the --item it was working, not --row"; return 2; }
    [ -n "$session" ] && [ -n "$cwd" ] || { say "start: --resume needs --session and --cwd"; return 2; }
    [ -d "$cwd" ] || { say "start: not a directory: $cwd"; return 2; }
    # One agent per session: the item and the label belong to the whole session, so a
    # restore never lands in a session someone already has (a main checkout's, say), unless
    # --window says it is one window among others.
    if session_live "$session" "$server"; then
      [ -n "$window" ] || { say "start: session $session already exists on $server; pass another --session"; return 1; }
      joined=1
    fi
    origin=${START_ORIGIN:-resume}
    launch_mode "$(resume_mode "$resume" "$(jq -r '.mode // empty' <<<"${it:-null}")")"
    lane_sandbox "$cwd" || return 1
    cmd="${item:+AGENT_QUEUE_ITEM=$(printf '%q' "$item") }$(telemetry_env "$cwd" "$item")$(account_env)${sbx_env}claude${model:+ --model $(printf '%q' "$model")}$sbx_flags $flags --resume $(printf '%q' "$resume")"
    if [ -n "$joined" ]; then
      target=$(tmux -L "$server" new-window -d -P -F '#{pane_id}' -t "=$session:" -n "$window" -c "$cwd" "$cmd") ||
        { say "could not open window $window in $session on $server"; return 1; }
    else
      tmux -L "$server" new-session -d -s "$session" ${window:+-n "$window"} -c "$cwd" "$cmd" ||
        { say "could not create session $session on $server"; return 1; }
    fi
    # A window joined into a live session is one Claude among others there, so the item does not
    # take that session: reap goes by its `sessions:` ids instead (claude_gone).
    rec=("origin=$origin"); [ -n "$joined" ] || rec+=("session=$server:$session")
    # --resume keeps the conversation's session id, so that is the one the item claims.
    [ -z "$item" ] || { agent-queue set "$item" "${rec[@]}" >/dev/null && agent-queue claim "$item" --sid "$resume" >/dev/null; } ||
      say "restored $session, but could not record it on queue item $item"
  else
    [ -n "$cwd" ] || cwd=$(repo_dir "$project")
    [ -n "$cwd" ] && [ -d "$cwd" ] || { say "start: no repo to cut a worktree from for $project (--cwd)"; return 2; }
    origin=${START_ORIGIN:-hand}
    [ -n "$harness" ] || harness=$(jq -r '.agent // "claude"' <<<"$it")
    [ -z "$host" ] || [ "$harness" = claude ] || { say "start: $item would run on $harness; a fleet worker runs claude only"; return 2; }
    [ -z "$host" ] || jq -e --arg d "$cwd" '.repos | index($d)' <<<"$hjson" >/dev/null ||
      { say "start: $host has no clone of $cwd (fleet_repos); $item stays queued"; return 2; }
    if [ "$harness" = claude ]; then
      [ -n "$model" ] || model=$(jq -r '.dispatch_model // empty' <<<"$verdict" 2>/dev/null)
      model=${model:-opus}
      acct=$(account_dir); mode=$(jq -r .mode <<<"$it")
      sid=$(new_sid) || { say "start: no session id for queue item $item; it stays queued"; return 1; }
      lane_sandbox "$cwd" || return 1
      cmd="${state_env}AGENT_QUEUE_ITEM=$(printf '%q' "$item") $(telemetry_env "$cwd" "$item")$(account_env "$acct")${sbx_env}claude --model $(printf '%q' "$model")$(dropped_tools "$it") --session-id $sid$sbx_flags"
      [ "$mode" = plan ] || mode=bypassPermissions
      launch_mode "$mode"
      cmd="$cmd $flags $(printf '%q' "$(item_brief "$it")")"
      acct=$(basename "${acct:-main}"); on=$acct${DISPATCH_SANDBOX_PROFILE:+, sandbox $DISPATCH_SANDBOX_PROFILE}${host:+, host $host}
    else
      # Only a claude start is held to the profile: the other launchers have no flag for it, and running
      # one open while the knob says every session is sandboxed is the failure the knob prevents.
      [ -z "$DISPATCH_SANDBOX_PROFILE" ] || { say "start: $item would run on $harness, which cannot enforce lane sandbox '$DISPATCH_SANDBOX_PROFILE'; nothing started"; return 2; }
      [ -n "$model" ] || model=$(jq -r '.model // empty' <<<"$it")
      # A cloud session's model is its environment's, so the map's one entry stands for it.
      [ "$(harness_launcher "$harness")" != claude-cloud ] || model=${model:-cloud}
      gateway_launch "$harness" "$model" "$it" "$(item_brief "$it" "$harness")" || return
      # What the run bills: the source the map names for the harness; a cloud session bills the claude
      # account gateway_launch chose (acct).
      [ "$(harness_launcher "$harness")" = claude-cloud ] || acct=$(harness_source "$harness")
      on=$harness
    fi
    session=$(cd "$cwd" && WT_NEW_CMD="$cmd" wt new ${host:+--host "$host"} --server "$server" --detach -c "$cwd" | tail -1)
    [ -n "$session" ] || { say "wt new failed for queue item $item; it stays queued"; return 1; }
    size=$(item_size "$it")
    agent-queue set "$item" "session=$server:$session" "account=$acct" "origin=$origin" "model=$model" "agent=$harness" ${size:+"size=$size"} ${host:+"host=$host"} >/dev/null &&
      agent-queue move "$item" running >/dev/null || say "started $session, but could not mark queue item $item running"
    # The id was chosen above, so the claim is made here and not in the session's own start, where
    # it waited on the queue lock (up to 2.9 s, 2026-11-06). Both outcome joins go through `sessions:`.
    [ -z "$sid" ] || agent-queue claim "$item" --sid "$sid" >/dev/null || say "could not claim $sid on queue item $item"
    if [ "$harness" = claude ]; then lane_log "$item" "$(item_headline "$it")" "$verdict" "$model"
    # A routed start is not an experiment: it logs under the lane model-lane picked, with its harness.
    elif [ -n "$verdict" ]; then lane_log "$item" "$(item_headline "$it")" "$verdict" "$model" "$harness"
    elif [ "$harness" = claude-cloud ]; then :   # not a pairing the human picked, and no model of ours ran
    else eval_log "$item" "$(item_headline "$it")" "$harness" "$model"
    fi
    dispatch_event started "$project" "$(item_headline "$it")" --item "$item" --to "$server:$session" --why "$model on $on"
    exec 7>&-
  fi
  [ -z "$ready" ] || start_ready "$server" "$session" "${target:-=$session:}" "$ready"

  label="$project: $(cut -c1-60 <<<"${item:-resumed}")"
  # set-option takes a pane target, where a bare "=name" is "no such session"; the colon makes it session:window.
  # A session this only joined keeps what it was: the label is for a session an agent started.
  [ -n "$joined" ] || on_host "$host" tmux -L "$server" set-option -t "=$session:" @dispatch "$label" ||
    say "could not tag $session with @dispatch"
  logline "started $session on $server${host:+ at $host} ($origin) for $project: ${item:+queue item $item}${resume:+${item:+, }resume $resume}"
  echo "started $session: $label"
}

# --- the pane record: what a world's server held, and the one way to reopen it --------------

PANES="$DIR/panes"   # <server>.json the live record, <server>.lost.json a dead server's last one

# world_lost <server> -- the recorded server is gone: keep its record for restore, and page.
# A record with no conversations has nothing to restore, so it never replaces one that does.
world_lost() {
  local srv=$1 n
  n=$(jq '[.panes[] | select(.claude != "")] | length' "$PANES/$srv.json" 2>/dev/null)
  n=${n:-0}
  if [ "$n" -gt 0 ]; then mv -f "$PANES/$srv.json" "$PANES/$srv.lost.json"; else rm -f "$PANES/$srv.json"; fi
  logline "tmux server $srv died with $n conversation(s) on it"
  agent-notify -p high -t "tmux $srv server died" "$n conversation(s) were on it. Reopen them: fleet-dispatch restore" ||
    say "could not page: tmux server $srv died"
}

# record_world <server> <panel file> -- rewrite its record, after noticing the server it described
# is gone. A server has an instance (pid and start time), so one restarted between two records
# still shows. agent-panel owns the pane to conversation join; no panel file keeps the last record.
record_world() {
  local srv=$1 panel=$2 file="$PANES/$1.json" inst was panes
  inst=$(tmux -L "$srv" display-message -p '#{pid} #{start_time}' 2>/dev/null)
  was=$(jq -r '.instance // empty' "$file" 2>/dev/null)
  [ -z "$was" ] || [ "$was" = "$inst" ] || world_lost "$srv"
  [ -n "$inst" ] && [ -n "$panel" ] || return 0
  panes=$(tmux -L "$srv" list-panes -a -F $'#{pane_id}\037#{session_name}\037#{window_name}\037#{pane_current_path}' 2>/dev/null) || return 0
  jq -Rn --arg server "$srv" --arg instance "$inst" --arg at "$(date -Iseconds)" --slurpfile panel "$panel" '
    (reduce $panel[] as $row ({}; .[$row.pane] = $row)) as $by |
    {server: $server, instance: $instance, at: $at, panes: [inputs | split("\u001f") | $by[$server + "/" + .[0]] as $c |
      {session: .[1], window: .[2], cwd: ($c.cwd // .[3]), claude: ($c.session_id // "")}]}' \
    <<<"$panes" > "$file.tmp" && mv -f "$file.tmp" "$file"
}

# cmd_record -- every world a manifest declares. fleet-state.service runs it each minute, so a
# record is at most that old; a world's sockets give no event to await for a pane's cwd or id.
cmd_record() {
  local f srv panel="$PANES/.panel"
  mkdir -p "$PANES"
  exec 8>"$PANES/.lock"
  flock 8 || return 1
  agent-panel list --json > "$panel" 2>/dev/null || { say "record: agent-panel failed; each record stays as it was"; panel=''; }
  for f in "${TMUX_SERVERS_DIR:-$HOME/.config/tmux-servers}"/*.conf; do
    [ -r "$f" ] || continue
    srv=${f##*/}
    record_world "${srv%.conf}" "$panel"
  done
  exec 8>&-
}

# conversation_live <id> -- a claude with that id is running now, so reopening it would be a second.
conversation_live() {
  local pid
  for pid in $(awk 1 "$HOME/.claude/sessions"/*.json 2>/dev/null |
    jq -Rr --arg id "$1" 'fromjson? | select(.sessionId == $id) | .pid'); do
    kill -0 "$pid" 2>/dev/null && return 0
  done
  return 1
}

# wound_down <id> -- it asked to close: armed, or fired since its window last showed in a record.
# wind-down.sh disarm clears both on the next prompt, so a conversation taken up again is reopened.
wound_down() { compgen -G "$HOME/.agent/spin-down/*__$1.[rf]*" >/dev/null; }

# restore_world <lost record> <dry run 0|1> -- reopen each conversation as a window of the session
# it was in, through start, with the running or waiting queue item that lists its Claude session
# (`agent-queue mine --sid`), so the item records where it runs again. The manifest brings back the
# declared sessions and windows first; a plain shell is listed, not reopened. Consumed only when
# every reopen worked, so a rerun finishes.
restore_world() {
  local f=$1 dry=$2 srv sess win cwd id mode project item failed=0 opened=0
  srv=$(jq -r .server "$f")
  [ "$dry" = 1 ] || tmx ensure "$srv" >/dev/null || say "restore: tmx ensure $srv failed"
  while IFS=$'\037' read -r sess win cwd id; do
    if [ -z "$id" ]; then echo "$srv:$sess:$win: no conversation, not reopened ($cwd)"; continue; fi
    if wound_down "$id"; then echo "$srv:$sess:$win: wound down on purpose, skipped"; continue; fi
    if conversation_live "$id"; then echo "$srv:$sess:$win: already running, skipped"; continue; fi
    if [ ! -d "$cwd" ]; then echo "$srv:$sess:$win: $cwd is gone, skipped (claude --resume $id)"; continue; fi
    item=$(agent-queue mine --sid "$id" 2>/dev/null) || item=''
    mode=$(resume_mode "$id" "$([ -z "$item" ] || agent-queue show "$item" --json 2>/dev/null | jq -r '.mode // empty')")
    if [ "$dry" = 1 ]; then echo "$srv:$sess:$win: would reopen $id in $cwd ($mode)${item:+ for queue item $item}"; continue; fi
    project=$(resolve_project_name "$cwd")
    if cmd_start --project "${project:-${cwd##*/}}" --server "$srv" --session "$sess" --window "$win" \
        --cwd "$cwd" --resume "$id" ${item:+--item "$item"} </dev/null >/dev/null; then
      echo "$srv:$sess:$win: reopened in $mode${item:+ for queue item $item}"; opened=$((opened + 1))
    else
      failed=$((failed + 1))
    fi
  done < <(jq -r '.panes[] | [.session, .window, .cwd, .claude] | join("\u001f")' "$f")
  [ "$dry" = 1 ] && return 0
  echo "$srv: reopened $opened, failed $failed"
  [ "$failed" = 0 ] || return 1
  mv -f "$f" "${f%.lost.json}.restored.json"
}

# cmd_restore -- the one verb after a lost server or a reboot. A record first, so a death the
# minute timer has not seen yet counts, and a server already restarted by hand is not missed.
cmd_restore() {
  local server='' dry=0 f rc=0 found=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --server) [ $# -ge 2 ] || { say "restore: --server needs a value"; return 2; }; server=$2; shift 2 ;;
      --dry-run) dry=1; shift ;;
      *) say "restore: unknown argument: $1"; return 2 ;;
    esac
  done
  cmd_record
  for f in "$PANES"/${server:-*}.lost.json; do
    [ -r "$f" ] || continue
    found=1
    restore_world "$f" "$dry" || rc=1
  done
  [ "$found" = 1 ] || echo "restore: no lost server on record"
  return "$rc"
}

# --- queue items: agent-queue owns the record, this runner only starts and settles them ----

item_state() { agent-queue show "$1" --json 2>/dev/null | jq -r '.state // empty'; }

# item_brief <item json> [harness] -> the prompt a queue item's session starts on: plan mode gets
# the task as typed, oneshot runs it through its kind's entry skill (kinds.json `entry`, by the
# item's type or its title's prefix; /one-shot when the kind names none), --pr-only for a `night`
# item. A kind whose `exit` is doc+ask or proof opens no PR, so its brief ends on that close
# instead of agent-land (doc_ask_brief, proof_brief). A headless harness (opencode, codex) has no
# slash commands, hooks or human at the pane, so it reads the skill and closes differently.
# A `canary` item (fleet-bench canary queue) opens no PR: its task is the whole brief.
item_brief() {
  local it="$1" harness="${2:-claude}" slug mode tags pr_only='' row key kind entry='' exit_='' nopr=''
  slug=$(jq -r .slug <<<"$it"); mode=$(jq -r .mode <<<"$it"); tags=" $(jq -r '.tags // ""' <<<"$it") "
  if [[ "$tags" == *" canary "* ]]; then jq -r .task <<<"$it"; return 0; fi
  if [ "$harness" = claude-cloud ]; then
    key=$(cut -d$'\x1f' -f4 <<<"$(item_row "$it")")
    jq -r .task <<<"$it"
    echo
    echo "This runs in a Claude Code cloud session on a fresh clone of the repo: no local skills, hooks, agent-queue or agent-land. Follow the repo's own CLAUDE.md and tooling."
    echo "Work on a new branch, run the repo's own tests for what you changed, push, and open a pull request. Never merge it."
    echo "The PR body carries the line \"Item: $slug\"${key:+ and the line \"Task: $key\"}: fleet-dispatch finds the PR by that line, and the human's merge closes the item."
    echo "If a step needs a decision from the human, put the question in the PR body, build the rest with that step off, and end the session."
    return 0
  fi
  [[ "$tags" == *" night "* ]] && pr_only=' --pr-only'
  load_kinds
  kind=$(jq -r '.type // empty' <<<"$it"); [ -n "$kind" ] || kind=$(row_kind "$(jq -r '.title // .task // ""' <<<"$it")")
  [ -z "$kind" ] || { entry=${KIND_ENTRY[$kind]:-}; exit_=${KIND_EXIT[$kind]:-}; }
  entry=${entry:-/one-shot}
  # A kind that opens no PR has no PR to stop at, and no tier-3 merge gate to name.
  case "$exit_" in doc+ask | proof) nopr=1 pr_only='' ;; esac
  if headless "$harness"; then
    printf 'Read ~/.claude/skills/%s/SKILL.md and follow it%s for this task:\n' "${entry#/}" "${pr_only:+ with$pr_only}"
  elif [ "$mode" != plan ]; then
    printf '%s%s ' "$entry" "$pr_only"
  fi
  jq -r .task <<<"$it"
  echo
  [[ "$tags" != *" red "* ]] || echo "This is a red: read ~/.claude/skills/fix-red/SKILL.md first and work to it."
  [[ "$tags" == *" red "* || -n "$pr_only" || -n "$nopr" || "$(item_tier "$it")" != 3 ]] || echo "This is tier 3 (harness or tooling), and it merges only behind the red-fix gate: step 5 of ~/.claude/skills/fix-red/SKILL.md (/code-review high, each finding fixed or answered in the PR, the line \"Review: /code-review high, <what it found and what you did>\" in the PR body). agent-land refuses a tier-3 PR without that line or without checks that ran green. Before agent-land, run the bats files the Stop hook picks for the files you changed and put the result in the PR body."
  row=$(item_row "$it")
  key=$(cut -d$'\x1f' -f4 <<<"$row")
  if [ "$exit_" = doc+ask ]; then
    doc_ask_brief "$slug" "$kind" "$row" "$(jq -r .project <<<"$it")"
    return
  fi
  if [ "$exit_" = proof ]; then
    proof_brief "$slug" "$kind" "$row" "$(jq -r .project <<<"$it")" "$harness"
    return
  fi
  if [ -n "$row" ] && [ -n "$pr_only" ]; then
    echo "This is agent-queue item $slug, promoted from a board row that is already started. Open the PR and do not merge: the human's merge closes the row."
    echo "When the PR is open: agent-queue set $slug pr=<owner>/<repo>#<N>; agent-queue move $slug waiting (fleet-dispatch reap closes it once the PR merges)"
  elif [ -n "$pr_only" ]; then
    echo "This is agent-queue item $slug, and that item is its only record: touch no board or sheet row for it."
    echo "When the PR is open: agent-queue set $slug pr=<owner>/<repo>#<N>; agent-queue move $slug waiting (fleet-dispatch reap closes it once the PR merges)"
  else
    echo "This is agent-queue item $slug${key:+, promoted from the board row \"$key\"}, and that item is its record: touch no other board or sheet row."
    echo "Merge with agent-land <N> (AGENT_QUEUE_ITEM=$slug is set): it records the PR on the item, moves it to done${key:+ and closes the row with the PR as proof}."
  fi
  echo "The PR body carries the line \"Item: $slug\"${key:+ and the line \"Task: $key\"}."
  if headless "$harness"; then
    echo "Right after gh pr create, run: agent-queue set $slug pr=<owner/repo#N>. A run cut off with a PR open then waits for the human instead of reading failed."
    echo "Run agent-land in the foreground: a background command dies when this run exits."
    echo "Skip what this harness lacks (final-pass, wind-down) and say so in the PR body."
    no_human
    return
  fi
  ask_rule
}

# ask_rule -- a question blocks only the step that needs it. Reap moves the item to waiting/ once the
# session stops with its ask pending, so the session never moves it itself.
# no_human -- the same for a headless harness, where nobody is at the pane to answer.
no_human() { echo "If it needs a human, say why and stop: nobody watches this run, and it counts as failed."; }

ask_rule() {
  echo "If a step needs a decision from the human, only that step is blocked, not the task: ask it here and file it with agent-ask post (your recommendation in --recommend), build the rest with that step switched off, and end your turn on the question only when nothing else is left, leaving this window open."
}

# proof_brief <slug> <kind> <item_row> <project> <harness> -- how a proof kind (kinds.json `exit`:
# release) closes: the live proof its entry skill names, recorded on the item, its row closed on that
# proof, never a PR or agent-land. fleet-sessions reads the session DONE once the item moves on; a
# session gone before the close is settled failed and its row stays started, for a human to look.
proof_brief() {
  local slug="$1" kind="$2" prof project lane key flag='' pf='' wd=''
  IFS=$'\x1f' read -r prof project lane key <<<"$3"
  project=${project:-$4}
  [ "${lane:-agent}" = agent ] && flag=' --agent'
  [ -z "$prof" ] || pf=" --profile $prof"
  echo "This is agent-queue item $slug${key:+, promoted from the board row \"$key\"}, a $kind row: it ends on the live proof its skill names, never a PR or agent-land."
  headless "$5" || wd='; then /wind-down auto'
  echo "Close in one turn: agent-queue set $slug note=\"<proof>\"${key:+; notes$pf ptask $project$flag done \"$key\" --proof \"<proof>\"}; agent-queue move $slug done --status ok$wd."
  if headless "$5"; then no_human; else ask_rule; fi
}

# doc_ask_brief <slug> <kind> <item_row> <project> -- how a doc+ask kind (kinds.json `exit`, the
# propose rung) closes: a doc in the project's lab docs/ and one ask, recorded on the item, its row
# closed on the doc, never a PR, a merge or a publish. fleet-sessions reads the session DONE once
# the item holds both (handoff_of), so the ask is handed over, not waited on.
doc_ask_brief() {
  local slug="$1" kind="$2" prof project lane key docs flag='' pf=''
  IFS=$'\x1f' read -r prof project lane key <<<"$3"
  project=${project:-$4}
  docs=$(np "$prof" projects 2>/dev/null | awk -F'\t' -v p="$project" '$1 == p { print $2; exit }')
  docs=${docs:+${docs%/*}/docs}
  [ "${lane:-agent}" = agent ] && flag=' --agent'
  [ -z "$prof" ] || pf=" --profile $prof"
  echo "This is agent-queue item $slug${key:+, promoted from the board row \"$key\"}, a $kind row: it ends on a doc and an ask, never a PR, a merge or a publish."
  echo "Write the doc under ${docs:-the docs/ dir beside the project summary.md}, then file one agent-ask post for the decision it leads to, with --options, --recommend and a --context that names the doc."
  echo "Then, in the same turn: agent-queue set $slug report=<doc path> ask=<ask id>${key:+; notes$pf ptask $project$flag done \"$key\" --proof doc:<doc path>}; agent-queue move $slug done --status ok; then /wind-down auto."
  echo "That ask is the deliverable, not a wait: once the item holds both, the shepherd reads this session as done."
}

# item_row <item json> -> "<profile> <project> <lane> <key>", joined by the unit separator, of an
# item with a row (agent-queue's `row`: its story, or the board row it was promoted from), else
# nothing. Not a tab: read collapses runs of tabs, so the empty profile of a default-profile row
# would shift every field after it.
item_row() {
  jq -r 'select((.row // "") != "") | .row as $r
    | [(.profile // ""), ($r | split(":")[0]), (.lane // "agent"), ($r | split(":")[1:] | join(":"))] | join("\u001f")' <<<"$1"
}

# close_row <slug> -- an item with a row, done ok, whose row is still started: the session died before
# agent-land closed it, or closed the item before its PR merged (land_orphan). Closed only on merge proof (agent-merge-proof.sh) of the item's
# merged: commit in the checkout of the repo its PR names, with proof "pr:<N> commit:<sha12>"; with no proof the
# row is left started and the reason logged, so a false close never happens.
close_row() {
  local it row prof project lane key flag=() oid pr dir out
  it=$(agent-queue show "$1" --json 2>/dev/null) || return 0
  row=$(item_row "$it"); [ -n "$row" ] || return 0
  IFS=$'\x1f' read -r prof project lane key <<<"$row"
  [ "$lane" = agent ] && flag=(--agent)
  [[ "$(row_line "$prof" "$project" "$lane" "$key")" == '- [/]'* ]] || return 0
  # The row closes on the item's first PR: pr: and merged: are lists in step, one PR per repo.
  oid=$(jq -r '.merged // "" | split(" ")[0] // empty' <<<"$it"); pr=$(jq -r '.pr // "" | split(" ")[0] // empty' <<<"$it")
  dir=$(pr_repo_dir "$pr" "$project")
  if [ -z "$oid" ] || [ -z "$dir" ] || ! out=$(merge_proof "$dir" "${pr##*#}" "$(merge_proof_branch "$dir")" "$oid" 2>&1); then
    logline "queue item $1: $project row left started, no merge proof: ${out:-${oid:+no checkout of the repo $pr names}${oid:-no merged commit}}"
    return 0
  fi
  np "$prof" ptask "$project" "${flag[@]}" done "$key" --proof "pr:${pr##*#} commit:${oid:0:12}" >/dev/null 2>&1 ||
    { logline "queue item $1: closing $project row $key failed"; return 0; }
  logline "closed $project $lane row on merge proof ($out): $key"
  dispatch_event settled "$project" "row closed on merge proof" --item "$1" --id "$key" --pr "$pr" --sha "$oid"
  echo "closed $project: $key (queue item $1, PR $pr merged)"
}

# settle_row <slug> -- an item with a row that ended failed or cancelled hands it back: un-start it
# and record `failed`, so it is not promoted again until its text
# changes. Idempotent: a row no longer started is left alone (done by its session, or settled).
settle_row() {
  local it row prof project lane key flag=()
  it=$(agent-queue show "$1" --json 2>/dev/null) || return 0
  [ "$(jq -r '.state + "/" + (.status // "")' <<<"$it")" = done/ok ] && return 0
  [ "$(jq -r .state <<<"$it")" = "done" ] || return 0
  row=$(item_row "$it"); [ -n "$row" ] || return 0
  IFS=$'\x1f' read -r prof project lane key <<<"$row"
  [ "$lane" = agent ] && flag=(--agent)
  [[ "$(row_line "$prof" "$project" "$lane" "$key")" == '- [/]'* ]] || return 0
  np "$prof" ptask "$project" "${flag[@]}" unstart "$key" >/dev/null 2>&1
  jq -cn --arg p "$project" --arg l "$lane" --arg k "$key" --arg at "$(date -Iseconds)" --arg st "$(jq -r .status <<<"$it")" \
    '{project: $p, lane: $l, key: $k, verdict: "failed", reason: "queue item ended \($st)", at: $at}' >> "$VERDICTS"
  logline "settled queue item $1: $project $lane row un-started: $key"
  dispatch_event settled "$project" "row un-started: item ended $(jq -r .status <<<"$it")" --item "$1" --id "$key"
  echo "un-started $project: $key (queue item $1 ended $(jq -r .status <<<"$it"))"
}

# pr_state <owner/repo#N> -> "<state> <merge oid>" as gh reads it; fails when gh cannot.
pr_state() { gh pr view "${1##*#}" -R "${1%#*}" --json state,mergeCommit -q '.state + " " + (.mergeCommit.oid // "")' 2>/dev/null; }

# item_pr_state <slug> <item json> -> "<state> <merge oid>" of the item's PR; fails when gh cannot read
# it. A bare pr: names no repo and one project spans repos, so it reads from the project's checkout
# and prints nothing unless a line of the PR's body is exactly the item's `Item:` stamp.
item_pr_state() {
  local pr dir
  pr=$(jq -r '.pr // ""' <<<"$2")
  if [[ "$pr" == */*#* ]]; then pr_state "$pr"; return; fi
  dir=$(repo_dir "$(jq -r .project <<<"$2")")
  [ -n "$pr" ] && [ -n "$dir" ] || return 1
  (cd "$dir" && gh pr view "$pr" --json state,mergeCommit,body -q \
    "select(any(.body | split(\"\n\")[] | rtrimstr(\"\r\"); . == \"Item: $1\")) | .state + \" \" + (.mergeCommit.oid // \"\")" 2>/dev/null)
}

# land_orphan <slug> -- a started row whose item ended ok before its PR merged (closed by hand
# before agent-queue refused that): the row goes by that PR, not by the orphan timer. A merged:
# commit, or a PR gh reads as MERGED (then recorded), goes to close_row; OPEN leaves it started for the
# merge. Returns 1 when no PR holds the row, so the timer decides: no PR, closed unmerged, or unreadable
# (a Forgejo PR, which gh cannot see, needs merged: on the item).
land_orphan() {
  local it oid info state
  it=$(agent-queue show "$1" --json 2>/dev/null) || return 1
  oid=$(jq -r '.merged // ""' <<<"$it")
  if [ -z "$oid" ]; then
    info=$(item_pr_state "$1" "$it") || return 1
    read -r state oid <<<"$info"
    case "$state" in
    OPEN) return 0 ;;
    MERGED) [ -n "$oid" ] && agent-queue set "$1" "merged=$oid" >/dev/null || return 1 ;;
    *) return 1 ;;
    esac
  fi
  close_row "$1"
}

# unstart_orphans -- an agent-lane row started with no active queue item naming it (its `row`)
# is an orphan: its session never filed an item, or died before reap could see one. If an item done ok
# in the last DISPATCH_ORPHAN_HOURS plus a day names it, its PR decides first (land_orphan); a PR open
# longer than that falls to the timer. A row seen orphaned on every pass for DISPATCH_ORPHAN_HOURS is un-started and given a failed verdict, as
# settle_row does, so dispatch does not promote it again until its text changes; the grace keeps a
# session that started a row a minute ago from losing it. First sightings live in $DIR/orphans.tsv;
# a row that stops being one drops out. Human-lane rows are the human's own and never touched. A
# queue it cannot read changes nothing. 2026-11-05: 40 started rows, 33 of them with no item.
unstart_orphans() {
  local items landed linked prof name _rest key text first now slug seen=''
  items=$(agent-queue list --json 2>/dev/null) || return 0
  landed=$(agent-queue list --json --state done --since "$(date -d "-$((DISPATCH_ORPHAN_HOURS / 24 + 1)) days" +%F)" 2>/dev/null) || return 0
  landed=$(jq -rs 'map(select(.status == "ok" and (.row // "") != "" and (.lane // "agent") == "agent")) | sort_by(.finished)
    | .[] | "\(.row | sub(":"; "\t"))\t\(.slug)"' <<<"$landed")
  mkdir -p "$DIR"
  linked=$(jq -r 'select(.state != "done" and (.row // "") != "" and (.lane // "agent") == "agent")
    | .row | sub(":"; "\t")' <<<"$items")
  now=$(date +%s)
  for prof in $(printf '%s\n' "${DISPATCH_NIGHT_PROFILE:--}" $DISPATCH_PROFILES | awk '!x[$0]++'); do
    [ "$prof" = - ] && prof=''
    while IFS=$'\t' read -r name _rest; do
      [ -n "$name" ] || continue
      while IFS=$'\t' read -r key text; do
        [[ "$text" == '- [/]'* ]] || continue
        grep -qxF "$name"$'\t'"$key" <<<"$linked" && continue
        slug=$(K="$name"$'\t'"$key" awk -F'\t' '$1"\t"$2 == ENVIRON["K"] { s = $3 } END { print s }' <<<"$landed")
        [ -n "$slug" ] && land_orphan "$slug" && continue
        first=$(K="${prof:--}"$'\t'"$name"$'\t'"$key" awk -F'\t' '$1"\t"$2"\t"$3 == ENVIRON["K"] { print $4; exit }' "$DIR/orphans.tsv" 2>/dev/null)
        first=${first:-$now}
        if [ $(( now - first )) -lt $(( DISPATCH_ORPHAN_HOURS * 3600 )) ]; then
          seen+="${prof:--}"$'\t'"$name"$'\t'"$key"$'\t'"$first"$'\n'
          continue
        fi
        np "$prof" ptask "$name" --agent unstart "$key" >/dev/null 2>&1 ||
          { logline "orphan $name agent row $key: un-start failed"; continue; }
        jq -cn --arg p "$name" --arg k "$key" --arg at "$(date -Iseconds)" --arg h "$DISPATCH_ORPHAN_HOURS" \
          '{project: $p, lane: "agent", key: $k, verdict: "failed", reason: "started \($h)h with no queue item", at: $at}' >> "$VERDICTS"
        logline "un-started orphan $name agent row (started ${DISPATCH_ORPHAN_HOURS}h with no queue item): $key"
        dispatch_event settled "$name" "orphan row un-started: ${DISPATCH_ORPHAN_HOURS}h with no queue item" --id "$key"
        echo "un-started $name: $key (started with no queue item)"
      done < <(rows "$prof" "$name" agent)
    done < <(np "$prof" projects 2>/dev/null)
  done
  printf '%s' "$seen" > "$DIR/orphans.tsv.new" && mv "$DIR/orphans.tsv.new" "$DIR/orphans.tsv"
}

# settle_item <slug> <session> -- its session is gone. Closed by the session: nothing to do.
# Still open, it goes by its PR's state (merged: when the item has one, else item_pr_state): MERGED records merged: and is done ok (and
# a board row still started closes on merge proof, close_row), OPEN waits in waiting/ for the merge
# (where a --pr-only run leaves it), CLOSED is failed; a state gh cannot read, or a bare pr: whose PR
# lacks the item's stamp, leaves it for the next pass. No PR but a `report` (a doc+ask kind's
# doc, a stack-review report) is done ok: that was the deliverable. Neither is failed, the reason in note.
# Every move is a compare-and-set on the state read here (`--if`), and a note is written only after
# it: an item its session closed or a human requeued meanwhile is left as it is. merged: goes first,
# since agent-queue closes an item with a PR ok only once it has one; it is the PR's fact either way.
settle_item() {
  local st it pr report info state oid; st=$(item_state "$1")
  case "$st" in running | waiting | queued) ;; *) logline "reaped $2: queue item $1 ${st:-gone}"; return 0 ;; esac
  it=$(agent-queue show "$1" --json 2>/dev/null)
  dispatch_event reaped "$(jq -r '.project // empty' <<<"$it")" "session $2 gone" --item "$1" --why "item was $st"
  IFS=$'\x1f' read -r pr report oid < <(jq -r '[.pr // "", .report // "", .merged // ""] | join("\u001f")' <<<"$it")
  if [ -n "$pr" ]; then
    if [ -n "$oid" ]; then state=MERGED
    else info=$(item_pr_state "$1" "$it") || info=''; read -r state oid <<<"$info"
    fi
    case "$state" in
    MERGED)
      [ -n "$oid" ] || { logline "reaped $2: queue item $1 left: PR $pr merged with no merge commit gh could read"; return 0; }
      agent-queue set "$1" "merged=$oid" >/dev/null || return 0
      agent-queue move "$1" "done" --status ok --if "$st" >/dev/null || return 0
      logline "reaped $2: session gone, queue item $1 done, PR $pr merged"
      close_row "$1" ;;
    OPEN)
      [ "$st" = waiting ] && return 0
      agent-queue move "$1" "waiting" --if "$st" >/dev/null || return 0
      agent-queue set "$1" "note=session $2 ended with PR $pr open" >/dev/null
      logline "reaped $2: session gone, queue item $1 waits on its open PR $pr"
      echo "waiting queue item $1 (PR $pr open, $2 ended)" ;;
    CLOSED)
      agent-queue move "$1" "done" --status failed --if "$st" >/dev/null || return 0
      agent-queue set "$1" "note=PR $pr closed unmerged; session $2 ended" >/dev/null
      logline "reaped $2: session gone, queue item $1 failed: PR $pr closed unmerged"
      echo "failed queue item $1 (PR $pr closed unmerged)" ;;
    *) logline "reaped $2: queue item $1 left: gh could not read PR $pr" ;;
    esac
  elif [ -n "$report" ]; then
    agent-queue move "$1" "done" --status ok --if "$st" >/dev/null || return 0
    logline "reaped $2: session gone, queue item $1 done with its report $report"
  else
    agent-queue move "$1" "done" --status failed --if "$st" >/dev/null || return 0
    agent-queue set "$1" "note=session $2 ended before it closed the item" >/dev/null
    logline "reaped $2: session gone, queue item $1 failed: no PR"
    echo "failed queue item $1 ($2 ended without closing it)"
  fi
}

# run_queue <item json lines> <room> -- start up to <room> queued items nothing holds. The machine-wide
# gates are asked once: presence is none of them. The human's and the shepherd's items run while they
# are here because they asked for them; a board-filled one is runnable only while they are away or the
# present trickle has room (runnable), and start_items counts the trickle down. A finding
# holds only the items it is about (pick_item), so a starved unity pool never stops a dotfiles item.
# A runnable item left waiting is BLOCKED, not NOOP: on 11-03 a gate held every pass for 7.5h and
# each one published NOOP, which every dashboard showed green. A human's dispatch hold is NOOP.
run_queue() {
  local items="$1" head why
  head=$(head -n 1 <<<"$items")
  why=$(gate)
  if [ -n "$why" ]; then
    RUN_GATED=1
    # A red the machine gates hold may still start on the red floor; then only reds start this pass.
    # Its start goes past those gates without proving them open, so the hold stands (start_item).
    if is_red "$head" && RED_PASS=1 red_floor_open && [ -z "$(RED_PASS=1 gate)" ]; then
      say "$why; red items start on the red floor (DISPATCH_RED_FLOOR=$DISPATCH_RED_FLOOR)"
      RED_PASS=1; start_items "$(jq -c 'select((" " + (.tags // "") + " ") | contains(" red "))' <<<"$items")" "$2"
      local rc=$?; RED_PASS=0; return "$rc"
    fi
    # A project nothing is working on may start one item past real idle: one busy
    # project cannot hold every other project's work behind the idle floor.
    local idle_items; idle_items=$(idle_project_items "$items")
    if [ -n "$idle_items" ] && PROJECT_PASS=1 project_floor_open && [ -z "$(PROJECT_PASS=1 gate)" ]; then
      say "$why; a project nothing is working on starts on the project floor (DISPATCH_PROJECT_FLOOR=$DISPATCH_PROJECT_FLOOR)"
      PROJECT_PASS=1; start_items "$idle_items" "$2"
      local prc=$?; PROJECT_PASS=0; return "$prc"
    fi
    settle "$(held_outcome "$why")" "$why, queue item $(jq -r .slug <<<"$head") waits"
    [ "$DRY" = 1 ] || return 0
  fi
  start_items "$items" "$2"
}

# start_items <item json lines> <room> -- past the pass's gate: start up to <room> items in
# queue order, each the first no finding holds; a board item started while the human is here spends
# the present trickle, and once it is spent the rest of the board items wait. Every start after the first reads the gate again, so
# one pass cannot stack Unity runs past the load and idle pace. Only a stop before anything started
# is settled; a later one is said, so a pass that started a session still publishes WORKED.
start_items() {
  local items="$1" room="$2" n=0 taken=0 why rc left
  while [ "$n" -lt "$room" ] && [ -n "$items" ]; do
    if [ "$n" -gt 0 ]; then
      why=$(gate)
      [ -z "$why" ] || { say "$why, the pass stops after $n started"; return 0; }
    fi
    if ! pick_item "$items"; then
      # Every item too heavy for the units left is a full fleet, not a block: NOOP, as cmd_run says.
      if [ "$n" -gt 0 ]; then say "$PICK_WHY"
      elif [ "$PICK_FULL" = 1 ]; then settle NOOP "$PICK_WHY"
      # cmd_run goes on to the board and settles the pass there, BLOCKED by this unless a row starts.
      elif [ "${HELD_FALLS_THROUGH:-0}" = 1 ] && [ "${FIRING+set}" = set ]; then QUEUE_HELD=$PICK_WHY; say "$PICK_WHY"
      else settle BLOCKED "$PICK_WHY"; fi
      return 0
    fi
    start_item "$PICKED"; rc=$?
    case "$rc" in 0 | 4 | 5) ;; 3) return 0 ;; *) return "$rc" ;; esac
    items=$(jq -c --arg s "$(jq -r .slug <<<"$PICKED")" 'select(.slug != $s)' <<<"$items")
    [ "$rc" -ne 5 ] || continue
    [ "$rc" -eq 0 ] && STARTED=$(( ${STARTED:-0} + 1 ))
    [ "$rc" -eq 0 ] && is_red "$PICKED" && RED_STARTED=$(( ${RED_STARTED:-0} + 1 ))
    if [ "$rc" -eq 0 ] && [ "${PROJECT_PASS:-0}" = 1 ]; then
      PROJECT_STARTED=$(( ${PROJECT_STARTED:-0} + 1 ))
      items=$(jq -c --arg p "$(jq -r '.project // ""' <<<"$PICKED")" 'select((.project // "") != $p)' <<<"$items")
    fi
    if [ "$rc" -eq 0 ] && [[ "$(jq -r '.from // ""' <<<"$PICKED")" == board:* ]] && human_here; then
      left=${PRESENT_LEFT:-$(present_left)}
      [ "$DRY" = 1 ] || logline "present start: queue item $(jq -r .slug <<<"$PICKED") (DISPATCH_PRESENT_PER_HOUR=$DISPATCH_PRESENT_PER_HOUR)"
      PRESENT_LEFT=$(( left - 1 ))
      [ "$PRESENT_LEFT" -gt 0 ] || items=$(jq -c 'select(.from // "" | startswith("board:") | not)' <<<"$items")
    fi
    if [ "$rc" -eq 0 ] && [ -n "$PLACE_HOST" ]; then HOST_FREE[$PLACE_HOST]=$(( HOST_FREE[$PLACE_HOST] - 1 ))
    elif [ "$rc" -eq 0 ]; then UNITS_FREE=$(( UNITS_FREE - $(weight_units "$(jq -r '.weight // "light"' <<<"$PICKED")") ))
    fi
    [ "$rc" -eq 4 ] && taken=$((taken + 1)) || n=$((n + 1))
  done
  # No item it tried had a source with room it may run on: held, so BLOCKED, naming what it tried.
  if [ "$n" -eq 0 ] && [ "$taken" -eq 0 ] && [ "${#NO_ROUTE[@]}" -gt 0 ]; then
    why=$(printf '%s, ' "${NO_ROUTE[@]:0:3}")
    [ "${#NO_ROUTE[@]}" -le 3 ] || why="$why$(( ${#NO_ROUTE[@]} - 3 )) more, "
    settle BLOCKED "${NO_ROOM:+$NO_ROOM, and }no queue item has a source with room it may run on: ${why%, }"
    return 0
  fi
  # Every item this pass picked was started by someone else: the work moved, nothing failed.
  [ "$n" -gt 0 ] || [ "$taken" -eq 0 ] || settle NOOP "another start took the $taken queue item(s) this pass picked"
  [ "$n" -gt 0 ] && [ -n "$items" ] || return 0
  # A limit, not the machine, stopped the pass: say which, so the human can raise it (headroom).
  why=$(gate)
  [ -z "$why" ] || return 0
  local limit=DISPATCH_PER_PASS; [ "$room" -lt "$PER_PASS" ] && limit=DISPATCH_MAX_LIVE
  settle WORKED "under-used: started $n, $limit is the limit while $(grep -c . <<<"$items") runnable wait and the gates are open (fleet-dispatch headroom)"
  [ "$DRY" = 1 ] || logline "under-used: started $n, $limit is the limit, $(grep -c . <<<"$items") runnable left"
  return 0
}

# held_outcome <gate reason> -> the outcome of a pass that left runnable work: NOOP when the human
# held dispatch on purpose (agent-hold), else BLOCKED.
held_outcome() { case "$1" in "held (agent-hold"*) echo NOOP ;; *) echo BLOCKED ;; esac; }

# What a start takes out of runnable, as a jq condition: next_items and stats' urgent/high counts read it.
TAKEN_JQ='(.waits | not)'

# next_items -> the queued items a pass may try, in agent-queue's order (red, priority, project rank, cleanup, age),
# one JSON object a line, whatever harness each runs on: start_item routes it to a source with room.
next_items() {
  runnable 2>/dev/null | jq -c "select($TAKEN_JQ)" 2>/dev/null
  return 0
}

# load_findings -- FIRING is the findings firing now, read once a pass; rc 1 when they cannot be
# read, which holds every item.
load_findings() {
  [ "${FIRING+set}" = set ] && return 0
  local f
  f=$(fleet-bench findings --json 2>/dev/null) && f=$(firing_findings <<<"$f") || return 1
  FIRING=$f
}

# pick_item <item json lines> -- PICKED is the first item that has a place and no firing finding
# holds; rc 1 with the reason in PICK_WHY when every one is held, or the findings cannot be read.
# The place is this machine while the item fits in UNITS_FREE and, when there are fleet workers to
# go to, its own pace is open (machine_why); else the first worker that takes it (place_host), in
# PLACE_HOST. PICK_FULL is 1 when units alone held them all.
pick_item() {
  local items="$1" it why need free host mwhy='' mread=0 fhit=0 held=()
  PICKED='' PICK_WHY='' PICK_FULL=1 PLACE_HOST=''
  load_findings || { PICK_WHY="fleet-bench findings unreadable"; PICK_FULL=0; return 1; }
  free=${UNITS_FREE:-$DISPATCH_MAX_LIVE}
  while IFS= read -r it; do
    [ -n "$it" ] || continue
    need=$(weight_units "$(jq -r '.weight // "light"' <<<"$it")")
    host='' why=''
    if [ "$need" -le "$free" ] && { [ ${#HOST_PROBE[@]} -eq 0 ] || { [ "$mread" = 1 ] || { mwhy=$(machine_why); mread=1; }; [ -z "$mwhy" ]; }; }; then :
    elif host=$(place_host "$it"); then :
    elif [ "$need" -gt "$free" ]; then why="$([ "$need" -gt 1 ] && echo heavy || echo light) needs $need run units, $free free"
    else why="$mwhy, and no fleet worker takes it"; PICK_FULL=0
    fi
    if [ -z "$why" ]; then why=$(held_by "$it" "$FIRING"); [ -z "$why" ] || { PICK_FULL=0; fhit=1; }; fi
    if [ -z "$why" ]; then PICKED=$it PLACE_HOST=$host; return 0; fi
    [ "$DRY" = 0 ] || say "queue item $(jq -r .slug <<<"$it") waits: $why"
    held+=("$(jq -r .slug <<<"$it") ($why)")
  done <<<"$items"
  if [ "$PICK_FULL" = 1 ]; then PICK_WHY="run units: $(printf '%s, ' "${held[@]:0:3}")${held[3]:+$(( ${#held[@]} - 3 )) more, }every queue item waits"
  elif [ "$fhit" = 1 ]; then PICK_WHY="finding firing: $(printf '%s, ' "${held[@]:0:3}")${held[3]:+$(( ${#held[@]} - 3 )) more, }every queue item waits"
  else PICK_WHY="machine pace: $(printf '%s, ' "${held[@]:0:3}")${held[3]:+$(( ${#held[@]} - 3 )) more, }every queue item waits"; fi
  return 1
}

# --- fleet workers (fleet-hosts.sh): where a pass may place a session besides this machine --------

# The roster is fleet_hosts (home-config's inventory, or FLEET_INVENTORY). With none, every pass
# runs as it does with no workers.

# probe_hosts <live_runs> -- one ssh to each placed worker (fleet_place) for its load, its cores, and
# whether wt and claude are on its PATH and its agent-queue forwards (an older one would write the
# queue on the worker): HOST_PROBE[<name>] is "<load> <cores> <ready 0|1>", or
# "unreachable". HOST_FREE[<name>] is its fleet_max_live less the run units its live sessions hold,
# and start_items takes each start there off it. HOST_POWER[<name>] is its fleet_power. Read once a
# pass, before the gates, so every gate and pick in it reads the same numbers: a gate runs in a
# subshell and cannot write back.
declare -A HOST_PROBE=() HOST_FREE=() HOST_POWER=()
probe_hosts() {
  local name place max power out
  HOST_PROBE=() HOST_FREE=() HOST_POWER=()
  fleet_hosts >/dev/null
  while IFS=$'\t' read -r name place max power; do
    [ "$place" = true ] || continue
    HOST_POWER[$name]=$power
    HOST_FREE[$name]=$(( max - $(units_on "$name" <<<"$1") ))
    # shellcheck disable=SC2016 # the worker's shell expands nothing here; the quotes are for cut
    if out=$(fleet_host_run "$name" sh -c 'cut -d" " -f1 /proc/loadavg; nproc; command -v wt >/dev/null && command -v claude >/dev/null && grep -qs state_forward "$(readlink -f "$(command -v agent-queue)")" && echo 1 || echo 0' 2>/dev/null); then
      HOST_PROBE[$name]=$(tr '\n' ' ' <<<"$out")
    else
      HOST_PROBE[$name]=unreachable
    fi
  done < <(fleet_hosts | jq -r '[.name, .place, .max_live, .power] | @tsv')
}

# host_why <name> -> why that worker takes no session now, or nothing. Its pace is this runner's
# (MAX_LOAD) over its own load and cores; its units are its own fleet_max_live.
host_why() {
  local p="${HOST_PROBE[$1]:-}" load cores ready
  [ -n "$p" ] || { echo "$1 is not placed (fleet_place false, or not in $FLEET_HOSTS_GROUP)"; return; }
  if [ "$p" = unreachable ]; then
    echo "$1 did not answer over ssh${HOST_POWER[$1]:+${HOST_POWER[$1]/#governor/: off or booting (the ci-runner-governor starts it on demand), or its tailnet is down}}"
    return
  fi
  [ "${HOST_FREE[$1]:-0}" -gt 0 ] || { echo "$1 is at its fleet_max_live"; return; }
  read -r load cores ready <<<"$p"
  [ "$ready" = 1 ] || { echo "$1 has no wt, no claude, or an agent-queue that does not forward"; return; }
  over_pace "$load" "${cores:-1}" && echo "$1: load $load on $cores cores is over the $MAX_LOAD pace"
  return 0
}

# remote_open -- some fleet worker takes a session now.
remote_open() {
  local n
  for n in "${!HOST_PROBE[@]}"; do [ -n "$(host_why "$n")" ] || return 0; done
  return 1
}

# host_takers <item json> -> the roster's workers provisioned for this item, one name a line: a
# light claude item with no plan and no cloud route, in a repo the worker has cloned (fleet_repos).
# Heavy work (Unity), plans and other harnesses stay here: a worker is provisioned for light claude
# sessions. Roster order, a worker the governor powers last: it costs money while it runs.
host_takers() {
  local dir
  jq -e '(.weight // "light") == "light" and (.agent // "claude") == "claude" and (.plan // "") == ""
    and ((" " + (.tags // "") + " ") | contains(" cloud-ok ") | not)' <<<"$1" >/dev/null || return 0
  dir=$(repo_dir "$(jq -r .project <<<"$1")"); [ -n "$dir" ] || return 0
  fleet_hosts | jq -sr --arg d "$dir" 'map(select(.repos | index($d))) | sort_by(.power == "governor") | .[].name'
}

# place_host <item json> -> the first worker host_takers names that takes a session now.
place_host() {
  local name
  [ ${#HOST_PROBE[@]} -gt 0 ] || return 1
  while IFS= read -r name; do
    [ -n "${HOST_PROBE[$name]:-}" ] && [ -z "$(host_why "$name")" ] && { echo "$name"; return 0; }
  done < <(host_takers "$1")
  return 1
}

# --- cloud workers: the demand the ci-runner-governor starts them on ---------------------------

# demand_pass <live_runs> -- for each placed worker the governor powers (fleet_power: governor),
# write the demand this pass has for it into the "<host>.demand" key of the governor's override
# ConfigMap: the run units its sessions hold, plus the waiting items it would take, at most its
# fleet_max_live. Each waiting item counts once, for the first place that takes it in the order
# pick_item uses: this machine's free units while its own pace is open, then an open home worker,
# then a powered one with room. Nothing counts while another gate is closed or a finding holds the
# item: a box started into a closed gate would run for nothing. Each key ends DISPATCH_DEMAND_TTL
# from now, so a dispatcher that stops writing lets the governor stop the box. The governor side:
# home-config apps/ci-runner-governor/governor.py, the "workers" paragraph.
demand_pass() {
  local name it t takers took why='' here=0 need data='{}' says=() live
  local -A cap=() want=()
  for name in "${!HOST_POWER[@]}"; do
    [ "${HOST_POWER[$name]}" = governor ] && want[$name]=0
  done
  [ ${#want[@]} -gt 0 ] || return 0
  if why=$(GATE_NO_MACHINE=1 gate) && [ -n "$why" ]; then :
  elif ! load_findings; then why="fleet-bench findings unreadable"
  fi
  if [ -z "$why" ]; then
    [ "$UNITS_FREE" -le 0 ] || [ -n "$(machine_why)" ] || here=$UNITS_FREE
    for name in "${!HOST_FREE[@]}"; do cap[$name]=${HOST_FREE[$name]}; done
    while IFS= read -r it; do
      [ -n "$it" ] && [ -z "$(held_by "$it" "$FIRING")" ] || continue
      need=$(weight_units "$(jq -r '.weight // "light"' <<<"$it")")
      if [ "$need" -le "$here" ]; then here=$(( here - need )); continue; fi
      takers=$(host_takers "$it")
      while IFS= read -r t; do
        [ -n "$t" ] && [ "${cap[$t]:-0}" -gt 0 ] || continue
        [ -n "${want[$t]+x}" ] || [ -z "$(host_why "$t")" ] || continue
        cap[$t]=$(( cap[$t] - 1 ))
        [ -z "${want[$t]+x}" ] || want[$t]=$(( want[$t] + 1 ))
        break
      done <<<"$takers"
    done < <(next_items)
  fi
  for name in "${!want[@]}"; do
    live=$(units_on "$name" <<<"$1")
    data=$(jq -c --arg k "$name.demand" --argjson d "$(( live + want[$name] ))" --argjson u "$(( $(date +%s) + DISPATCH_DEMAND_TTL ))" \
      '.[$k] = ({demand: $d, until: $u} | tojson)' <<<"$data")
    says+=("$(( live + want[$name] )) for $name ($live live, ${want[$name]} waiting${why:+, none counted: $why})")
  done
  took=$(printf '%s; ' "${says[@]}"); demand_write "$data" "${took%; }"
}

# demand_write <data json> <what> -- merge-patch those keys into the governor's override ConfigMap,
# one call for every worker, so no other key moves (machine-mode's pin, agent-web's override); the
# ConfigMap is made when missing, and patched after all when another writer made it first. A dry
# run says what it would write.
demand_write() {
  local ctx out ok=0 try k=() lits=()
  [ "$DRY" = 0 ] || { say "would write demand $2"; return 0; }
  # shellcheck source=/dev/null
  ctx=${CC_KUBE_CONTEXT:-$(. "$DISPATCH_KUBE_ENV" 2>/dev/null; printf '%s' "${CC_KUBE_CONTEXT:-}")}
  [ -n "$ctx" ] || { say "demand $2 unwritten: no CC_KUBE_CONTEXT in $DISPATCH_KUBE_ENV"; return 0; }
  k=(kubectl --context "$ctx" --request-timeout=10s -n monitoring)
  mapfile -t lits < <(jq -r 'to_entries[] | "--from-literal=\(.key)=\(.value)"' <<<"$1")
  for try in 1 2; do
    out=$("${k[@]}" patch configmap ci-runner-governor-override --type merge -p "$(jq -c '{data: .}' <<<"$1")" 2>&1) && { ok=1; break; }
    [ "$try" = 1 ] && [[ "$out" == *NotFound* ]] || break
    out=$("${k[@]}" create configmap ci-runner-governor-override "${lits[@]}" 2>&1) && { ok=1; break; }
    [[ "$out" == *AlreadyExists* ]] || break
  done
  if [ "$ok" = 1 ]; then say "demand $2"; else say "demand $2 unwritten: $(tail -n 1 <<<"$out")"; fi
}

# cmd_hosts [--json] -- each worker in the roster, as a pass would read it now.
cmd_hosts() {
  local h name rows=()
  probe_hosts "$(live_runs)"
  while IFS= read -r h; do
    [ -n "$h" ] || continue
    name=$(jq -r .name <<<"$h")
    rows+=("$(jq -c --arg p "${HOST_PROBE[$name]:-}" --arg f "${HOST_FREE[$name]:-}" --arg w "$(host_why "$name")" \
      '{name, dest, place, max_live, free: ($f | tonumber? // null), probe: $p, why: $w, repos, power}' <<<"$h")")
  done < <(fleet_hosts)
  [ ${#rows[@]} -gt 0 ] || { [ "${1:-}" = --json ] || say "no fleet workers in $(fleet_inventory || echo the inventory)"; return 0; }
  if [ "${1:-}" = --json ]; then printf '%s\n' "${rows[@]}"
  else printf '%s\n' "${rows[@]}" | jq -r '"\(.name)\t\(.dest)\t\(if .place then "placed" else "not placed" end)\t\(.free // "-")/\(.max_live) free\t\(if .why == "" then "open" else .why end)"'; fi
}

# item_repo <project> -> the repo name its code is pushed to, the runner exporter's `repo` label
# (origin's last path segment), else its checkout's basename; nothing for a notes-only project.
item_repo() {
  local dir url
  dir=$(repo_dir "$1"); [ -n "$dir" ] || return 0
  url=$(git -C "$dir" remote get-url origin 2>/dev/null) || url=$dir
  url=${url%/}; url=${url##*/}; url=${url##*:}
  printf '%s' "${url%.git}"
}

# scope_dir <project> -> the checkout of a fleet-bench project name, which may be an alias
# (`platform`) the queue never uses.
scope_dir() {
  local p
  p=$(jq -r --arg s "$1" '.aliases[$s] // $s' "$DISPATCH_PROJECT_MAP" 2>/dev/null) || p=$1
  repo_dir "${p:-$1}"
}

# held_by <item json> <findings> -> "<rule> <scope>" of each firing finding that holds this item,
# comma-joined, else nothing. A starved pool holds the items whose repo has jobs waiting in it (all
# of them when the finding names no repos), and only when capacity binds: a pool starved on labels
# (bind "labels": slots sit free, or the jobs are pinned to one host) gains nothing from a session
# not starting, since its gate asks for a different label. On 2026-11-05 a frame sweep pinned to the
# razer laptop held 6 unity-core-playground items for 7h with the box 80% idle. A throughput drop
# holds the items on that project's repo; a starved host (local test slots, no repo known) every item.
held_by() {
  local project dir repo f rule scope out=()
  project=$(jq -r .project <<<"$1"); dir=$(repo_dir "$project"); repo=$(item_repo "$project")
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    rule=$(jq -r .rule <<<"$f"); scope=$(jq -r .scope <<<"$f")
    case "$rule:$scope" in
      starved:pool:*)
        jq -e --arg r "$repo" '.bind != "labels" and (.repos == null or (.repos | index($r)) != null)' <<<"$f" >/dev/null || continue ;;
      throughput-drop:*)
        [ "$scope" = "$project" ] || { [ -n "$dir" ] && [ "$(scope_dir "$scope")" = "$dir" ]; } || continue ;;
    esac
    out+=("$rule $scope")
  done <<<"$2"
  [ ${#out[@]} -eq 0 ] || (IFS=,; echo "${out[*]}")
}

# item_headline <item json> -> its title, else the first non-blank line of its task: the one name a
# log, an event and the model-lane pick all use for the item.
item_headline() {
  jq -r '(.title // "" | select(test("\\S"))) // ([(.task // "") | split("\n")[] | select(test("\\S")) | sub("^\\s+"; "")][0] // "")' <<<"$1"
}

# item_size <item json> -> s, m or l from the `#size/` tag in its task, which promote copies from the
# board row (size_back tags the row with the judge's size, so the row's tag is the effective size);
# any case, as row_size reads it; nothing for an unsized or `xl` item, a size model-lane does not
# take. The one read lane_pick and start's `size=` header share.
item_size() { jq -r '[(.task // "") | match("#size/([sml])\\b"; "i").captures[0].string | ascii_downcase][0] // empty' <<<"$1"; }

# lane_pick <slug> <harness> -> model-lane's verdict for a queued Claude item started with no --model,
# at DISPATCH_LANE_FLOOR; nothing when it is not queued, runs another harness, or model-lane fails.
# It classifies the item's headline and its board #size/ tag, never the whole task: the body carries
# the same dispatch boilerplate on every item, and its words would pick the lane. Not the item's
# weight either: agent-queue derives that from load (a Unity checkout or a plan is heavy), not size.
# Every start of an item comes through cmd_start (a pass, a hand start, a plan phase, an after: chain),
# so this is the one place an item's model is picked.
lane_pick() {
  local it size
  it=$(agent-queue show "$1" --json 2>/dev/null) || return 0
  [ "$(jq -r .state <<<"$it")" = queued ] && [ "${2:-$(jq -r '.agent // "claude"' <<<"$it")}" = claude ] || return 0
  size=$(item_size "$it")
  model-lane classify "$(item_headline "$it")" --floor "$DISPATCH_LANE_FLOOR" ${size:+--size "$size"} 2>/dev/null |
    jq -ce 'select(.lane and .dispatch_model)' 2>/dev/null || true
}

# lane_log <slug> <task> <verdict json> <model ran> [harness] -- the started item's pick goes in model-lane's
# log and its run id on the item as lane_run, so the item's close reports the outcome (agent-queue
# move) and the lane can graduate or demote on evidence. No verdict (model-lane failed) logs nothing:
# the item ran on opus, and a broken router never blocks a start.
lane_log() {
  local id
  [ -n "$3" ] || return 0
  id=$(model-lane log --item "$1" --task "$2" --lane "$(jq -r .lane <<<"$3")" --by "$(jq -r '.by // "rule"' <<<"$3")" \
    --picked "$(jq -r '.model // .dispatch_model' <<<"$3")" --ran "$4" ${5:+--harness "$5"} 2>/dev/null) && [ -n "$id" ] ||
    { logline "model-lane log failed for queue item $1; it runs unrated"; return 0; }
  agent-queue set "$1" "lane_run=$id" >/dev/null || logline "could not stamp lane_run=$id on queue item $1"
}

# eval_log <slug> <task> <harness> <model> -- a gateway run logs under lane eval: the human picked the
# pairing, and an experiment must not count against the lane that shares its model.
eval_log() {
  local id
  id=$(model-lane log --item "$1" --task "$2" --lane eval --by human --harness "$3" --picked "$4" --ran "$4" 2>/dev/null) && [ -n "$id" ] ||
    { logline "model-lane log failed for queue item $1; it runs unrated"; return 0; }
  agent-queue set "$1" "lane_run=$id" >/dev/null || logline "could not stamp lane_run=$id on queue item $1"
}

# item_pinned <item json> -- rc 0 when the human pinned the item to a harness: an `agent:` other than
# claude (or claude-cloud, which cloud_routed reads) that no route recorded (`routed:`, start_item), so a
# requeued routed item routes again.
item_pinned() {
  jq -e '(.agent // "claude") as $a | ($a != "claude" and $a != "claude-cloud" and $a != (.routed // ""))' <<<"$1" >/dev/null 2>&1
}

# route <item json> <verdict json, or empty> -- the candidate a run start takes: ROUTE_HARNESS and
# ROUTE_MODEL (empty for claude, which runs the verdict's model), or rc 1 with every refusal in
# ROUTE_WHY. A pinned item's harness is its one candidate; an item with no verdict candidates runs on
# claude. Candidates go in fit order and, within a fit, by their source's rank, lowest first (use it or
# lose it): claude's is the rank of the account acct_room picked (its rc in the caller's ACCT_RC), every
# other's the rank of its source in ACCT_ROWS. Claude needs an account with room. Another harness needs
# its source's room, this machine (a fleet worker and a sandbox profile run claude only), an item it can
# hold (a headless one takes no plan item) and, when routed rather than pinned, a tier within the
# unattended ceiling: a red goes past it, only to a harness that can run the red-fix gate.
route() {
  local it="$1" verdict="$2" cands h m src tier pinned=0 why=()
  ROUTE_HARNESS='' ROUTE_MODEL='' ROUTE_WHY=''
  item_pinned "$it" && pinned=1
  if [ "$pinned" = 1 ]; then cands=$(jq -c '[{harness: .agent, model: (.model // ""), fit: 0}]' <<<"$it")
  else cands=$(jq -c '.candidates // empty | select(length > 0)' <<<"${verdict:-null}" 2>/dev/null); fi
  [ -n "$cands" ] || cands='[{"harness": "claude", "model": "", "fit": 0}]'
  tier=$(item_tier "$it")
  while read -r h m; do
    if [ "$h" = claude ]; then
      [ "${ACCT_RC:-1}" = 0 ] && { ROUTE_HARNESS=claude; return 0; }
      why+=("claude: no account has room"); continue
    fi
    src=$(harness_source "$h")
    if [ -z "$src" ]; then why+=("$h: no source in $HARNESSES")
    elif [ -z "$m" ]; then why+=("$h: the item names no model: for it")
    elif [ -n "${PLACE_HOST:-}" ]; then why+=("$h: placed on $PLACE_HOST, which runs claude only")
    elif [ -n "$DISPATCH_SANDBOX_PROFILE" ]; then why+=("$h: cannot hold sandbox $DISPATCH_SANDBOX_PROFILE")
    elif headless "$h" && [ "$(jq -r .mode <<<"$it")" = plan ]; then why+=("$h: runs headless, and this is a plan item")
    elif [ "$pinned" = 0 ] && [ "$tier" -gt "$UNATTENDED_TIER_CEILING" ] && ! is_red "$it"; then why+=("$h: tier $tier is past the unattended ceiling")
    elif [ "$pinned" = 0 ] && [ "$tier" -gt "$UNATTENDED_TIER_CEILING" ] && headless "$h"; then why+=("$h: runs headless, so it cannot hold the red-fix gate")
    elif ! jq -e --arg s "$src" 'any(.sources[]?; .name == $s and .room.ok == true)' <<<"$ACCT_ROWS" >/dev/null 2>&1; then
      why+=("$h: $(jq -r --arg s "$src" '[.sources[]? | select(.name == $s) | "\($s): \(.room.why)"][0] // "no source \($s) in claude-acct room --json"' <<<"$ACCT_ROWS")")
    else ROUTE_HARNESS=$h ROUTE_MODEL=$m; return 0
    fi
  done < <(jq -r --argjson c "$cands" --arg d "${ACCT_DIR:-}" --slurpfile map "$HARNESSES" '. as $r | ($map[0].harnesses // {}) as $hs
      | $c | map(.rank = (if .harness == "claude" then ([$r.accounts[]? | select(.dir == $d) | .rank] | first)
          else ($hs[.harness].source // "") as $s | ([$r.sources[]? | select(.name == $s) | .rank] | first) end // 1e9))
      | sort_by(.fit, .rank)[] | "\(.harness) \(.model)"' <<<"$ACCT_ROWS" 2>/dev/null ||
    # No readable map: claude is the one harness a start could launch.
    jq -r '.[] | select(.harness == "claude") | "claude "' <<<"$cands")
  ROUTE_WHY=$(printf '%s; ' "${why[@]}"); ROUTE_WHY=${ROUTE_WHY%; }
  return 1
}

# start_item <item json> -- past the gates: route it (route) and start it, and publish what happened.
# rc 3 when usage cannot be read, which ends the pass: the next item could not be routed either. rc 4
# when another start (a hand start, say) took the item first: that is not a failed launch, and the
# pass goes on. rc 5 when no candidate it may run on has room (an Opus item while only Codex has room,
# a pinned harness whose source is spent): the pass goes on to the next item, which may.
start_item() {
  local it="$1" slug rc verdict='' cached floor='' keep=0 harness=claude
  local ACCT_ROWS='' ACCT_DIR ACCT_WHY ACCT_PAST_PACE ACCT_RC=0
  slug=$(jq -r .slug <<<"$it")
  if [ "$DRY" = 1 ]; then say "would start queue item $slug: $(jq -r '"\(.project) \(.mode) \(.priority)"' <<<"$it")"; return 0; fi
  # Asked again here, as launch does: the gate's answer may be minutes old. ACCT_WHY names the
  # closest account and why its verdict refuses, as in gate. ACCT_ROWS is local, so a later gate
  # asks afresh after this start.
  acct_room || ACCT_RC=$?
  [ "$ACCT_RC" != 2 ] || { settle BLOCKED "queue item $slug waits: account usage unreadable ($ACCT_WHY)"; return 3; }
  # Today's verdict for an item no source could take skips it without asking model-lane again; a
  # start always classifies afresh, and cmd_start logs that verdict, so model-lane is asked once.
  cached=$(lane_cached "$slug")
  if [ -n "$cached" ] && ! route "$it" "$cached"; then :
  else
    item_pinned "$it" || cloud_routed "$slug" || verdict=$(lane_pick "$slug" claude)
    # A broken router is not a fact about the item: the next pass asks again.
    route "$it" "$verdict" || { [ -z "$verdict" ] || lane_cache "$slug" "$verdict"; }
  fi
  if [ -z "$ROUTE_HARNESS" ]; then
    say "queue item $slug has no source with room it may run on: $ROUTE_WHY"
    NO_ROUTE+=("$slug ($ROUTE_WHY)"); [ "$ACCT_RC" = 0 ] || NO_ROOM=$ACCT_WHY
    return 5
  fi
  harness=$ROUTE_HARNESS
  if [ "$harness" = claude ]; then
    # A floor start leaves the hold standing (keep, settle): a red-floor one went past the machine
    # gates, and a run-floor one past an account over its pace has no room either.
    if red_floor_open; then floor=" on the red floor (DISPATCH_RED_FLOOR=$DISPATCH_RED_FLOOR)"; keep=1
    elif project_floor_open; then floor=" on the project floor (DISPATCH_PROJECT_FLOOR=$DISPATCH_PROJECT_FLOOR)"; keep=1
    elif floor_open; then
      floor=" on the run floor (DISPATCH_RUN_FLOOR=$DISPATCH_RUN_FLOOR)"
      keep=$ACCT_PAST_PACE
    fi
    START_ORIGIN=run START_VERDICT=$verdict RUN_ACCOUNT=$ACCT_DIR cmd_start --item "$slug" ${PLACE_HOST:+--host "$PLACE_HOST"}
  else
    if item_pinned "$it"; then floor=" on $harness ($ROUTE_MODEL), the harness it is pinned to"
    else floor=" on $harness ($ROUTE_MODEL), routed by model-lane"; fi
    # A start past the account hold leaves it standing, like a floor start.
    [ "$ACCT_RC" = 0 ] || { floor="$floor while $ACCT_WHY"; keep=1; }
    START_ORIGIN=run START_VERDICT=$verdict cmd_start --item "$slug" --harness "$harness" --model "$ROUTE_MODEL"
  fi
  rc=$?; exec 7>&-
  if [ "$rc" -eq 0 ]; then
    # The route is recorded beside the `agent:` cmd_start set, so a requeued item routes again.
    [ "$harness" = claude ] || item_pinned "$it" || agent-queue set "$slug" "routed=$harness" >/dev/null ||
      say "could not record routed=$harness on queue item $slug"
    [ "$keep" = 0 ] || FLOOR_HELD=1
    settle WORKED "started queue item $slug${PLACE_HOST:+ on $PLACE_HOST}$floor"
  elif [ "$(item_state "$slug")" != queued ]; then
    say "queue item $slug was started by another start"; return 4
  else
    settle FAILED "could not start queue item $slug"; return 1
  fi
}

# --- verbs ---------------------------------------------------------------------------

# held_state -> "<held_since epoch> <held_why>" from the runner state agent-proof.sh keeps (the first
# BLOCKED pass of an unbroken run, and the latest one's reason); nothing while no hold stands.
held_state() {
  local dir since
  # shellcheck source=/dev/null
  . "$HOME/.local/lib/agent-proof.sh" 2>/dev/null || return 0
  dir="$(proof_state_dir)/fleet-dispatch"
  since=$(cat "$dir/held_since" 2>/dev/null)
  [[ "$since" =~ ^[0-9]+$ ]] || return 0
  printf '%s %s\n' "$since" "$(cat "$dir/held_why" 2>/dev/null)"
}

# held_short <why> -> the pass's reason without what the Stopped line says elsewhere: the night and
# plan counts, the item that waits, the run-out forecast and the parentheses.
held_short() {
  sed -E 's/^(queued [0-9]+ for the night|tagged [0-9]+ for a plan); //g
    s/,? (queue item [^ ]+|every queue item) waits$//
    s/, runs out [^,]* at this rate//
    s/ \([^)]*\)//g' <<<"$1"
}

# held_clears <why> -> what ends the hold, in the words of the gate that holds.
held_clears() {
  case "$1" in
    "no account has room"*) echo "Clears when an account is back under its pace" ;;
    "account usage unreadable"*) echo "Clears when claude-acct reads usage again" ;;
    "finding firing"*) echo "Clears when its finding stops firing" ;;
    "fleet-assess says HOLD"* | "load "* | "real idle "*) echo "Clears when the machine's load falls" ;;
    "github budget"*) echo "Clears when the GitHub API budget refills" ;;
    *) echo "fleet-dispatch run --dry-run names the gate" ;;
  esac
}

# stopped [--json] -- rc 1 and the Stopped line when a hold has stood DISPATCH_STARVED_MIN or longer:
# "Dispatch stopped 13h05m: <why>. <what clears it>." It is the one line every surface shows (hub Home's
# Stopped row through fleet-sessions, the briefing, queue-starved's probe), at most 160 characters;
# --json is {runner, since, line}. A run-floor start does not end the hold, a pass past an open
# gate does (agent-proof.sh). A hold under the threshold, or none, prints nothing and is rc 0.
cmd_stopped() {
  local since why held clears head max line
  read -r since why < <(held_state) || return 0
  [ -n "$since" ] || return 0
  held=$(( $(date +%s) - since ))
  [ "$held" -ge $(( DISPATCH_STARVED_MIN * 60 )) ] || return 0
  why=$(held_short "$why"); clears=$(held_clears "$why")
  . "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/prom.sh"
  head="Dispatch stopped $(prom_dur "$held"): "
  max=$(( 160 - ${#head} - ${#clears} - 3 ))
  # Too long: cut at the last clause that fits.
  while [ "${#why}" -gt "$max" ] && [[ "$why" == *[,\;]" "* ]]; do why=${why%[,;] *}; done
  [ "${#why}" -le "$max" ] || why="${why:0:$max}"
  line="$head$why. $clears."
  if [ "${1:-}" = --json ]; then
    jq -nc --arg line "$line" --argjson since "$since" '{runner: "fleet-dispatch", since: $since, line: $line}'
  else
    echo "$line"
  fi
  return 1
}

# starved -- rc 1 when urgent or high queue items have been runnable (no hold) for over
# DISPATCH_STARVED_MIN minutes and no run pass has started a queue item in that time: it names them
# and the last pass's outcome. A standing hold past that long trips it too, led by the Stopped line,
# and no run start clears it then: a run-floor start goes past an account hold, and on 11-05/06 one
# every hour cleared this while every other pass stopped. A deep queue the passes are moving is not starved, and neither is one
# held on purpose (agent-hold) or by the load gates, whose alarm is fleet-thermal: a busy machine is
# not a broken queue, and any other gate still trips. A board item is not starved while it waits for
# the human to leave. Only a run start counts: a hand start or a redispatch proves nothing
# about the pass, and on 11-04 a hand start would have hidden a gate that stopped every pass for
# 7.5h. A NOOP pass reads healthy to fleet-liveness, so this is what pages a queue nothing starts:
# the Sentinel watch queue-starved runs it. The board starves too: rows nobody judges never reach the
# queue, so it trips when rows wait unjudged and no pass has judged any while the human was away that
# long (2026-11-05: 220 rows, no judge since 11-02, every pass stopped at held queue items). And the
# low water starves: runnable under DISPATCH_LOW_WATER, rows a pass would pick, and no run start in
# twice DISPATCH_STARVED_MIN (low_starved), which is a fill that has stopped filling.
cmd_starved() {
  local items board low last cut started why stopped dead
  agent-hold check dispatch >/dev/null 2>&1 || { echo "dispatch is held (agent-hold), so nothing is starved"; return 0; }
  cut=$(( $(date +%s) - DISPATCH_STARVED_MIN * 60 ))
  stopped=$(cmd_stopped)
  started=$(last_run_start)
  dead=$(dead_holds)
  if [ -n "$dead" ]; then
    echo "held on an ask that can never be answered:"
    sed 's/^/  /' <<<"$dead"
  fi
  if [ -z "$stopped" ] && [ -n "$started" ] && [ "$(date -d "$started" +%s 2>/dev/null || echo 0)" -ge "$cut" ]; then [ -z "$dead" ]; return; fi
  items=$(runnable | jq -rs --argjson cut "$cut" '
    [.[] | select((.priority == "urgent" or .priority == "high") and (.waits | not) and .t != null and .t < $cut)]
    | sort_by(.t) | .[] | "\(.slug) (\(.priority), queued \(.queued))"') || { echo "agent-queue unreadable"; return 1; }
  board=$(board_starved "$cut")
  low=$(low_starved "$(( cut - DISPATCH_STARVED_MIN * 60 ))")
  [ -n "$stopped$items$board$low" ] || { [ -z "$dead" ]; return; }
  # Held by load only when every closed gate is a load gate; an account with no room still starves,
  # and gate leaves that one out while another source has room, so room is read here from the verdict
  # gate reads too (ACCT_ROWS, asked once for both).
  # Idle is the last pass's sample, as old as the window this verdict reads: a reader never samples.
  local ACCT_ROWS='' ACCT_DIR ACCT_WHY ACCT_PAST_PACE room=0 IDLE_CACHED=$(( DISPATCH_STARVED_MIN * 60 ))
  acct_room || room=$?
  why=$(gate)
  if [ -n "$why" ] && ! sed 's/; /\n/g' <<<"$why" | grep -qvE '^(fleet-assess says HOLD|load |real idle )' &&
    [ "$room" = 0 ]; then
    echo "held by load ($why), so nothing is starved"; [ -z "$dead" ]; return
  fi
  # shellcheck source=/dev/null
  . "$HOME/.local/lib/agent-proof.sh" 2>/dev/null &&
    last=$(tail -n 1 "$(proof_state_dir)/fleet-dispatch/activity.log" 2>/dev/null)
  [ -z "$stopped" ] || echo "$stopped"
  if [ -n "$items" ]; then
    echo "runnable over ${DISPATCH_STARVED_MIN} min and not started:"
    sed 's/^/  /' <<<"$items"
  fi
  [ -z "$board" ] || echo "$board"
  [ -z "$low" ] || echo "$low"
  echo "last run start: ${started:-none in the log}; last pass: ${last:-none recorded}"
  return 1
}

# dead_holds -> one line per queued item held on an ask that was cancelled, no longer exists, or the
# human answered with another option: no
# answer can release it (agent-queue ask_pending), so it waits for good unless someone sees it. On
# 2026-11-07 trader's Kalshi phases sat behind cancelled ask ybXZIM and nothing named them.
dead_holds() {
  agent-queue list --json --state queued 2>/dev/null |
    jq -r 'select((.hold // "") | test("^ask:[^ ]+ \\((cancelled|no such ask|answered [^,]*, not [^)]+)\\)")) | "\(.slug) (\(.project), \(.hold))"'
  return 0
}

# low_starved <cut epoch> -> a line when runnable is under DISPATCH_LOW_WATER, no run pass has
# started a queue item since <cut> (twice DISPATCH_STARVED_MIN), and the board has rows a pass would
# pick: the top-up is not happening. Else nothing. Rows waiting on a judge are board_starved's.
low_starved() {
  local depth started n
  depth=$(queue_depth)
  [ "$depth" -lt "$DISPATCH_LOW_WATER" ] 2>/dev/null || return 0
  started=$(last_run_start)
  [ -z "$started" ] || [ "$(date -d "$started" +%s 2>/dev/null || echo 0)" -lt "$1" ] || return 0
  n=$(picks "$(all_open)" "$DISPATCH_LOW_WATER" | grep -c . || true)
  [ "$n" -gt 0 ] || return 0
  echo "runnable $depth under the low water $DISPATCH_LOW_WATER with no run start since $(date -d "@$1" +%H:%M), and $n board row(s) a pass would pick"
}

# board_starved <cut epoch> -> a line naming the unjudged rows when the board has some, no verdict
# was written since <cut>, and the human has been away since before <cut> (rows judge only then);
# else nothing. An `error` verdict counts as written, and so does a budget stop's touch: a pass whose
# judge fails or stops already publishes FAILED or BLOCKED (settle), which fleet-liveness reads.
board_starved() {
  local judged state mins n
  judged=$(stat -c %Y "$VERDICTS" 2>/dev/null || echo 0)
  [ "$judged" -lt "$1" ] || return 0
  read -r state mins _ < <(fleet-presence 2>/dev/null)
  [ "$state" = away ] && [ "${mins:-0}" -ge "$DISPATCH_STARVED_MIN" ] 2>/dev/null || return 0
  n=$(unjudged_rows | grep -c . || true)
  [ "$n" -gt 0 ] || return 0
  if [ "$judged" = 0 ]; then judged=never; else judged=$(date -d "@$judged" -Iminutes); fi
  echo "$n board rows unjudged, none judged since $judged"
}

# headroom [--json] -- the window over the limits: how many more queue items a start could take now
# (free run units while every gate is open, else 0 and the gate that holds), and the margin under
# load and idle. The human reads it before raising DISPATCH_PER_PASS or DISPATCH_MAX_LIVE; nothing
# here raises a limit.
cmd_headroom() {
  local live hand slots load cores idle runnable why could=0 floor_live red_live starts pend
  live=$(live_units)
  floor_live=$(live_runs | grep -c . || true)
  red_live=$(live_reds | grep -c . || true)
  hand=$(live_hand | grep -c . || true)
  slots=$(( DISPATCH_MAX_LIVE - live ))
  load=$(cut -d' ' -f1 "$DISPATCH_LOADAVG" 2>/dev/null)
  cores=$(nproc 2>/dev/null || echo 1)
  idle=$(real_idle)
  read -r starts pend < <(pending_load)
  runnable=$(next_items | grep -c . || true)
  local idle_projects; idle_projects=$(idle_project_items "$(next_items)" | jq -r .project | sort -u | grep -c . || true)
  why=$(IDLE_NOW=$idle gate)
  if [ -z "$why" ]; then could=$(( slots < runnable ? slots : runnable )); [ "$could" -gt 0 ] || could=0; fi
  jq -cn --argjson runnable "$runnable" --argjson live "$live" --argjson hand "$hand" --argjson max_live "$DISPATCH_MAX_LIVE" \
    --argjson per_pass "$PER_PASS" --arg level "$LEVEL" --argjson could "$could" --argjson cores "$cores" \
    --arg load "${load:-}" --argjson starts "$starts" --argjson pend "$pend" --arg max_load "$MAX_LOAD" --arg idle "${idle:-}" --argjson min_idle "$DISPATCH_MIN_IDLE" --arg held "$why" \
    --argjson floor "${DISPATCH_RUN_FLOOR:-0}" --argjson floor_live "$floor_live" --argjson red_floor "${DISPATCH_RED_FLOOR:-0}" --argjson red_live "$red_live" \
    --argjson project_floor "${DISPATCH_PROJECT_FLOOR:-0}" --argjson idle_projects "$idle_projects" '
    def num: if . == "" then null else tonumber end;
    {could_start: $could, per_pass: $per_pass, level: $level, per_pass_limited: ($could > $per_pass),
     runnable: $runnable, live_runs: $live, live_hand: $hand, max_live: $max_live, slots_free: ($max_live - $live),
     load: ($load | num), starting: $starts, load_pending: $pend, load_cap: (($max_load | tonumber) * $cores * 100 | round / 100),
     load_room: (if $load == "" then null else ((($max_load | tonumber) * $cores) - ($load | tonumber) - $pend) * 100 | round / 100 end),
     idle: ($idle | num), min_idle: $min_idle, run_floor: $floor, floor_live: $floor_live, red_floor: $red_floor, red_live: $red_live,
     project_floor: $project_floor, idle_projects: $idle_projects,
     idle_room: (if $idle == "" then null else (($idle | tonumber) - $min_idle) * 10 | round / 10 end),
     held: (if $held != "" then $held elif $live >= $max_live then "DISPATCH_MAX_LIVE: every run unit is used"
            elif $runnable == 0 then "nothing runnable" else null end)}
    # The held reason as one word, so the feed (numbers only) can carry it as a 0/1 per kind.
    | .held_kind = (.held // "" | if . == "" or . == "nothing runnable" then null
        elif startswith("DISPATCH_MAX_LIVE") then "slots" elif startswith("load ") then "load"
        elif startswith("real idle") then "idle" elif test("account") then "account"
        elif startswith("fleet-assess") then "assess" else "other" end)' |
    if [ "${1:-}" = --json ]; then cat; else
      jq -r '"could start now: \(.could_start) of \(.runnable) runnable (a pass starts up to \(.per_pass), level \(.level))" +
        (if .held then ", held: \(.held)" else "" end),
        "  run units: \(.live_runs)/\(.max_live) used, \(.slots_free) free (heavy 2, light 1), \(.live_hand) more started by hand",
        "  load:      \(.load // "?")\(if .starting > 0 then " plus \(.load_pending) for \(.starting) started in the last '"$DISPATCH_START_LOAD_MIN"' min" else "" end) of a \(.load_cap) cap, \(.load_room // "?") room",
        "  idle:      \(.idle // "?")% against a \(.min_idle)% floor, \(.idle_room // "?") points room",
        "  run floor: \(.floor_live) of \(.run_floor) run sessions live; under it the weekly pace and idle do not hold a start",
        "  red floor: \(.red_live) of \(.red_floor) red sessions live; under it pace, idle, load and fleet-assess do not hold a red",
        "  project floor: \(.idle_projects) project(s) with light work and nothing running; up to \(.project_floor) start a pass past real idle"'
    fi
}

# runnable -> the queued items nothing holds (agent-queue sets hold for a tag window or an unmet
# after:), one JSON object a line. While the human is here a board item starts only within the present
# trickle (present_left), and a night item not at all: `waits` is true while they are here and it is
# spent (always, for a night item, which runs with nobody to ask), and its t, the epoch it
# became runnable, is when they left if it was queued before that; any other item's t is its queued epoch. Away with no minutes (`away -
# none`: nobody attached or logged in) has no leaving time, so t stays the queued epoch. Presence is
# read only when an item could wait on it. Fails when the queue is unreadable.
runnable() {
  local q state='' mins=- _s here=true left=0
  q=$(agent-queue list --json --state queued 2>/dev/null) || return 1
  [[ "$q" != *board:* ]] || read -r state mins _s < <(fleet-presence 2>/dev/null)
  [ "$state" != away ] || { here=false; [ "$mins" = - ] || left=$(( $(date +%s) - mins * 60 )); }
  local trickle=false; [ "$here" = false ] || [ "$(present_left)" -eq 0 ] || trickle=true
  jq -c --argjson here "$here" --argjson trickle "$trickle" --argjson left "$left" '
    select(.hold == null) | (.from // "" | startswith("board:")) as $board
    | (.queued | try fromdateiso8601 catch null) as $t
    | ((" " + (.tags // "") + " ")) as $tags | ($tags | contains(" night ")) as $night
    | . + {waits: ($board and $here and ($tags | contains(" red ") | not) and ($night or ($trickle | not))), t: (if $board and $t != null and $t < $left then $left else $t end)}' <<<"$q"
}

# present_left -> how many board items a pass may still start while the human is here: the
# DISPATCH_PRESENT_PER_HOUR trickle less the `present start:` lines the log holds from the last hour.
# Counted from the log the starts already write, so no second store; 0 when the trickle is off.
present_left() {
  local n
  n=$(awk -v c="$(date -d '-60 min' '+%Y-%m-%d %H:%M')" '/ present start: / && ($2 " " $3) >= c' "$LOG" 2>/dev/null | grep -c . || true)
  n=$(( DISPATCH_PRESENT_PER_HOUR - ${n:-0} ))
  echo $(( n > 0 ? n : 0 ))
}

# human_here -> rc 0 unless fleet-presence says away. Unreadable counts as here: the slower rate.
human_here() { case "$(fleet-presence 2>/dev/null)" in away*) return 1 ;; esac; return 0; }

# queue_depth -> the queued items no hold stops, those waiting on the trickle included: what the
# low water mark measures.
queue_depth() { runnable 2>/dev/null | grep -c . || true; }

# last_run_start -> "YYYY-MM-DD HH:MM" of the last queue item a run pass started, from the log.
last_run_start() {
  grep -E '^- [0-9-]+ [0-9:]+ started .* \(run\) .*queue item ' "$LOG" 2>/dev/null | tail -n 1 | cut -d' ' -f2,3
}

# stats -- one JSON object for the feed (agent-mqtt-publish summary/dispatch), numbers only where a
# number will do, because mqtt2prom keeps nothing else: runnable items and the oldest one's age, by
# all and by urgent (runnable_urgent, oldest_urgent_s: priority urgent only, and only what a start would
# take, as next_items does) with the high ones counted apart (runnable_high, oldest_high_s); the low water and whether runnable is under it; the present trickle's rate
# and its starts in the last hour; starved (the queue-starved verdict); the last pass and last run start;
# reap moves in the last hour, and the items moved
# DISPATCH_FLAP_MOVES or more times (a session the reap cannot read steadily); the open board rows
# by lane, left out when the board is unreadable, so the chip reads - and never 0; held_s, how long a
# hold has stopped the passes (0 with none, so the series never goes stale; its words are `stopped`'s).
cmd_stats() {
  local now q aq since started pass=null starved=false hr=null board held_since
  now=$(date +%s); since=$(date -d "@$(( now - 3600 ))" '+%Y-%m-%d %H:%M')
  # The last pass's headroom, while it is younger than three passes: an old one is no answer.
  [ -n "$(find "$HEADROOM" -mmin -45 2>/dev/null)" ] && hr=$(jq -c . "$HEADROOM" 2>/dev/null) || hr=null
  q=$(runnable) || { echo '{"error":"agent-queue unreadable"}'; return 1; }
  aq=$(agent-queue stats --json --since "$(date -d yesterday +%F)" 2>/dev/null) && jq -e .active <<<"$aq" >/dev/null 2>&1 || aq=null
  board=$(notes board --json 2>/dev/null | jq -c '.rows | {board_agent: map(select(.lane == "agent")) | length,
    board_human: map(select(.lane == "human")) | length, board_playtest: map(select(.lane == "playtest")) | length}' 2>/dev/null)
  cmd_starved >/dev/null 2>&1 || starved=true
  read -r held_since _ < <(held_state)
  started=$(last_run_start); [ -z "$started" ] || started=$(date -d "$started" +%s 2>/dev/null)
  # shellcheck source=/dev/null
  . "$HOME/.local/lib/agent-proof.sh" 2>/dev/null &&
    pass=$(stat -c %Y "$(proof_state_dir)/fleet-dispatch/last-outcome" 2>/dev/null || echo null)
  awk -v since="$since" '
    ($2 " " $3) < since { next }
    $4 == "reaped" && match($0, /queue item [^ ]+ [a-z]+ -> [a-z]+$/) { split(substr($0, RSTART), w, " "); print "move", w[3]; next }
    $4 == "reaped" { print "settle", "-"; next }
    $4 == "present" && $5 == "start:" { print "present", "-" }' "$LOG" 2>/dev/null |
    jq -Rsc --argjson now "$now" --argjson q "$(jq -sc . <<<"$q")" --argjson starved "$starved" \
      --argjson pass "${pass:-null}" --argjson start "${started:-null}" --argjson flap "$DISPATCH_FLAP_MOVES" --argjson hr "${hr:-null}" --argjson aq "$aq" --argjson board "${board:-null}" \
      --argjson low "$DISPATCH_LOW_WATER" --argjson per "$DISPATCH_PRESENT_PER_HOUR" \
      --argjson held "${held_since:-null}" '
      [split("\n")[] | select(length > 0) | split(" ")] as $ev
      | ($q | map(select('"$TAKEN_JQ"'))) as $take
      | ($take | map(select(.priority == "urgent"))) as $u
      | ($take | map(select(.priority == "high"))) as $hi
      | def age(x): if (x | map(.t // empty) | length) == 0 then null else $now - (x | map(.t // empty) | min) end;
        ($ev | map(select(.[0] == "move") | .[1]) | group_by(.) | map(select(length >= $flap) | .[0])) as $flapping
      | {state: ($q | length), runnable: ($q | length), runnable_urgent: ($u | length), runnable_high: ($hi | length),
         oldest_runnable_s: age($q), oldest_urgent_s: age($u), oldest_high_s: age($hi), starved: $starved,
         last_pass_epoch: $pass, last_run_start_epoch: $start,
         reaped_1h: ($ev | map(select(.[0] == "move" or .[0] == "settle")) | length),
         flapping_items: ($flapping | length), flapping: $flapping,
         could_start: ($hr.could_start // null),
         low_water: $low, under_low_water: (if ($q | length) < $low then 1 else 0 end),
         present_per_hour: $per, present_starts_1h: ($ev | map(select(.[0] == "present")) | length),
         held_s: (if $held == null then 0 else $now - $held end)}
      + ($board // {})
      # The whole queue, as agent-queue counts it: every state, holds by kind, flow by the hour.
      + (if $aq == null then {} else
          ($aq.sitting.held_by // {}) as $h
          | {queued: ($aq.active.queued // 0), running: ($aq.active.running // 0), waiting: ($aq.active.waiting // 0),
             held: ($aq.sitting.held // 0), held_after: ($h.after // 0), held_pr: ($h.pr // 0),
             held_time: (($h.night // 0) + ($h.at // 0))} + ($aq.recent // {}) end)
      # The room the last pass had, with why it was held as a 0/1 per kind.
      + (if $hr == null then {} else
          {room_live_runs: $hr.live_runs, room_max_live: $hr.max_live, room_live_hand: ($hr.live_hand // null),
           room_load: $hr.load, room_load_cap: $hr.load_cap, room_idle: $hr.idle, room_min_idle: $hr.min_idle,
           room_run_floor: ($hr.run_floor // null), room_floor_live: ($hr.floor_live // null)}
          + (["slots", "load", "idle", "account", "assess", "other"]
             | map({key: "room_held_\(.)", value: (if $hr.held_kind == . then 1 else 0 end)}) | from_entries) end)'
}

# reap -- settle the queue items whose session is gone (settle_item, then settle_row for an
# item with a row), and keep each live one's state true to its session: waiting/ while it waits on the human
# (Claude's own `waiting` status, which an open plan or dialog is, or a pending agent-ask it filed and
# stopped on), running/ again once it does not. It is the one writer of that move for a live session.
# A session neither read can see is left where it is.
cmd_reap() {
  local s d slug server sess origin project area state _weight agent started sids host want waits='' seen='' gone live active=()
  unset REAP_PANEL
  fleet_hosts >/dev/null   # once, so each session_live subshell inherits the roster
  # A board item cancelled or failed with no session of its own (cancelled while queued, say).
  for d in "$(date +%F)" "$(date -d yesterday +%F 2>/dev/null)"; do
    [ -n "$d" ] || continue
    agent-queue list --json --state "done" --date "$d" 2>/dev/null |
      jq -r 'select((.row // "") != "" and .status != "ok") | .slug' 2>/dev/null |
      while IFS= read -r s; do settle_row "$s"; done
  done
  while IFS=$'\x1f' read -r slug server sess origin project area state _weight agent started sids host; do
    [ -n "$slug" ] || continue
    active+=("$slug")
    # A tmux session gone is its own witness; a Claude missing from agent-panel needs a second reap
    # (reap_confirm), and until then the item is left as it is: its Claude is not read as live either.
    # A fleet worker that does not answer says nothing, so its item stays as it is (fleet-liveness
    # pages a session that stops moving), and a live one there is beyond this agent-panel's sight:
    # its pane ends with its claude (wt's _prepare), so its tmux session is the witness.
    gone='' live=0
    [ -z "$sess" ] || { session_live "$sess" "$server" "$host"; live=$?; }
    if [ "$live" = 1 ]; then gone=1
    elif [ -n "$host" ]; then continue
    elif claude_gone "$server" "$sess" "$agent" "$started" "$sids"; then reap_confirm "$slug" || continue; gone=1
    else reap_seen "$slug"
    fi
    if [ -n "$gone" ]; then
      settle_item "$slug" "${sess:-${sids##* }}"
      settle_row "$slug"
      # Closed, its mark goes at once: an item put back (agent-queue reopen) starts with no miss on record.
      [ "$(item_state "$slug")" != "done" ] || reap_seen "$slug"
      continue
    fi
    [ -n "$sess" ] || continue
    [ -n "$seen" ] || { waits=$(waiting_sessions) && seen=1 || seen=unreadable; }
    [ "$seen" = 1 ] || continue
    # By the item's own Claude when it records one (claude_gone's rule), else by its tmux session.
    want=running
    if [ -n "$sids" ] && panel_lists "$agent"; then grep -qxF -f <(printf 'sid:%s\n' $sids) <<<"$waits" && want=waiting
    else grep -qxF -e "$server/$sess" -e "$sess" <<<"$waits" && want=waiting; fi
    [ "$state" = "$want" ] && continue
    agent-queue move "$slug" "$want" --if "$state" >/dev/null && logline "reaped $sess: queue item $slug $state -> $want"
  done < <(item_sessions)
  # A mark whose item is no longer active (closed by its session, cancelled) would count for a later
  # item under the slug. No active item at all may be a queue that could not be read: keep them then.
  [ ${#active[@]} -eq 0 ] || for s in "$DIR"/reap-miss/*; do
    [ -e "$s" ] || continue
    [[ " ${active[*]} " == *" ${s##*/} "* ]] || rm -f "$s"
  done
  unstart_orphans
  reconcile_plans
  return 0
}

# reconcile_plans -- queue the open phases of an approved plan its session left behind. They run as
# `night` items: a plan's phases carry no tier, so unattended they stop at an open PR. Once only: a
# plan the queue has held before is its items' to finish, or a failing phase would re-queue every
# pass. One still open after that shows in plans_unqueued. `- [-]` is how a human drops a phase.
# They are an automated filer's (`from: auto:plans`), so a queue a day of drain deep holds them
# (agent-queue admit), and the next pass tries again.
reconcile_plans() {
  [ "$DISPATCH_PLAN_RECONCILE" = 1 ] || return 0
  local orphans c plan project held out rc
  orphans=$(plans_orphaned) || return 0
  [ -n "$orphans" ] || return 0
  held=$(agent-queue list --json --state done --since "$(date -d "$PLAN_LEDGER_DAYS days ago" +%F)" 2>/dev/null | jq -r '.plan // empty') || return 0
  while IFS= read -r c; do
    plan=$(jq -r .plan <<<"$c"); project=$(jq -r .project <<<"$c")
    grep -qxF -- "$plan" <<<"$held" && continue
    out=$(AGENT_QUEUE_START=0 agent-queue add --plan "$plan" --project "$project" --tags night --from auto:plans 2>&1); rc=$?
    if [ "$rc" -eq 0 ]; then
      logline "queued the open phases of $(basename "$plan") for the night: its session is gone"
    elif [ "$rc" -ne "$AQ_EX_HELD" ]; then
      say "could not queue the phases of $plan: $out"
    fi
  done <<<"$orphans"
}

# waiting_sessions -> "<server>/<tmux session>" for each Claude waiting on its human (agent-panel),
# and the bare tmux session of each pending ask whose Claude is not working; fails when either cannot
# be read, so a pass that cannot see never moves an item. A session with an open question carries on
# with what does not depend on the answer, so a pending ask follows the panel while it is busy or in
# a shell (agent-panel's own `~`): counting only busy would flip a session on a gate every pass. An
# item names a session, not a window, so a session several Claudes share (a world session) says
# nothing about any one item and is left out: one window waiting would otherwise flip every item on it.
# The same two reads by Claude session id come out as "sid:<id>", for an item that records its own:
# one id is one Claude, so no session is shared there.
waiting_sessions() {
  local panel asks shared working wsids
  panel=$(agent-panel list --json 2>/dev/null) || return 1
  asks=$(agent-ask list --all --pending 2>/dev/null) || return 1
  shared=$(jq -r 'select(.status != "shell") | .target | sub(":[^:/]*$"; "")' <<<"$panel" 2>/dev/null | sort | uniq -d)
  working=$(jq -r 'select(.status == "busy" or .status == "shell") | .target | sub(":[^:/]*$"; "") | sub(".*/"; "")' <<<"$panel" 2>/dev/null)
  wsids=$(jq -r 'select(.status == "busy" or .status == "shell") | .session_id // empty' <<<"$panel" 2>/dev/null)
  {
    jq -r 'select(.status == "waiting") | .target | sub(":[^:/]*$"; "")' <<<"$panel" 2>/dev/null
    cut -f13 <<<"$asks" | grep . | grep -vxF -f <(printf '%s\n' "$working")
  } | grep -vxF -f <(printf '%s\n' "$shared"; sed 's,.*/,,' <<<"$shared")
  {
    jq -r 'select(.status == "waiting") | .session_id // empty' <<<"$panel" 2>/dev/null
    cut -f16 <<<"$asks" | grep . | grep -vxF -f <(printf '%s\n' "$wsids")
  } | sed 's/^/sid:/'
  return 0
}

# cpu_jiffies -> "<free> <total>" since boot from the aggregate cpu line of /proc/stat. Free is idle
# plus nice: nice-19 work (the Unity editors) yields to whatever a start brings, by design. Total is
# the first eight counters; guest time is already inside user and nice.
cpu_jiffies() { awk '$1 == "cpu" { printf "%.0f %.0f\n", $3 + $5, $2 + $3 + $4 + $5 + $6 + $7 + $8 + $9; exit }' "$DISPATCH_PROC_STAT" 2>/dev/null; }

# real_idle -> percent of the machine free over a DISPATCH_IDLE_WINDOW-second /proc/stat delta.
# The kernel has no idle event, so this samples: one sample serves every gate for a window, so a
# pass and its headroom wait once. Prints nothing when /proc/stat cannot be read (or, for a reader, with no sample in its window).
# IDLE_NOW: a reading this call already took, so a report and its gate agree on one sample.
# IDLE_CACHED=<seconds>: a reader's call (cmd_starved, so stats and the queue-starved watch) takes the
# last sample up to that old and never waits out a new one, printing nothing without one: a reader
# under a unit timeout (agent-mqtt-publish, 60s) cannot spend a whole window asleep.
real_idle() {
  [ -z "${IDLE_NOW:-}" ] || { echo "$IDLE_NOW"; return; }
  local at pct f0 t0 f1 t1 age
  # A sample from the future (the clock stepped back) is no sample.
  if { read -r at pct < "$IDLE"; } 2>/dev/null && [[ "$at" =~ ^[0-9]+$ && "$pct" =~ ^[0-9.]+$ ]] &&
    age=$(( $(date +%s) - at )) && [ "$age" -ge 0 ] && [ "$age" -lt "${IDLE_CACHED:-$DISPATCH_IDLE_WINDOW}" ]; then
    echo "$pct"; return
  fi
  [ -z "${IDLE_CACHED:-}" ] || return 0
  read -r f0 t0 < <(cpu_jiffies) || return 0
  sleep "$DISPATCH_IDLE_WINDOW"
  read -r f1 t1 < <(cpu_jiffies) || return 0
  [ $(( t1 - t0 )) -gt 0 ] || return 0
  pct=$(LC_ALL=C awk -v f=$(( f1 - f0 )) -v t=$(( t1 - t0 )) 'BEGIN { printf "%.1f", 100 * f / t }')
  { mkdir -p "$DIR" && echo "$(date +%s) $pct" > "$IDLE.$$" && mv -f "$IDLE.$$" "$IDLE"; } 2>/dev/null || rm -f "$IDLE.$$"
  echo "$pct"
}

# firing_findings -> the shared faults firing now, one per line. Open is not firing: a finding stays
# open for an hour after its last sample, which would hold starts long after the fault cleared.
# A blind finding is not one: it says a reader has a gap (a worktree name the merges source cannot
# map, say), not that new work would make anything worse, so it holds nothing. Each line is
# {rule, scope, repos, bind}; held_by decides which items a finding is about.
firing_findings() {
  jq -c --argjson now "$(date +%s)" --argjson fresh "$DISPATCH_FINDING_FRESH_MIN" '
    select(.rule == "starved" or .rule == "throughput-drop")
    | select((.epoch // $now) >= $now - $fresh * 60) | {rule, scope, repos, bind}'
}

# pending_load -> "<starts> <load>": the sessions started in the last DISPATCH_START_LOAD_MIN minutes
# (the `started` lines the log already holds, as present_left counts its own) and the load they have
# not yet put on the 1-min average. A start's load arrives minutes late, so a loop of starts that
# each read the load sees the same low number; counting the starts closes that. Hand starts and a
# pass's own earlier starts are in the log the moment cmd_start returns. A resume counts too: a
# restored session boots and loads like a new one. An unreadable window refuses, like every gate.
pending_load() {
  local n
  [ "$DISPATCH_START_LOAD" != 0 ] || { echo "0 0.0"; return; }
  n=$(awk -v c="$(date -d "-$DISPATCH_START_LOAD_MIN min" '+%Y-%m-%d %H:%M')" '$4 == "started" && ($2 " " $3) >= c' "$LOG" 2>/dev/null | grep -c . || true)
  LC_ALL=C awk -v n="${n:-0}" -v l="$DISPATCH_START_LOAD" 'BEGIN { printf "%d %.1f\n", n, n * l }'
}

# load_why <red 0|1> -> why this machine's load holds a start, or nothing; a red floor start goes past it.
# over_pace <load> <cores> [pending] -- that load, plus what recent starts will add, is over the
# MAX_LOAD pace per core. This machine's gate and each fleet worker's read it the same way.
over_pace() { awk -v l="$1" -v c="$2" -v p="${3:-0}" -v m="$MAX_LOAD" 'BEGIN { exit !((l + p) / c > m) }'; }

load_why() {
  local load cores starts pend
  load=$(cut -d' ' -f1 "$DISPATCH_LOADAVG" 2>/dev/null)
  cores=$(nproc 2>/dev/null || echo 1)
  read -r starts pend < <(pending_load)
  [ "$1" = 0 ] && over_pace "${load:-0}" "$cores" "$pend" &&
    echo "load ${load}$([ "$starts" = 0 ] || echo " plus $pend for $starts started in the last ${DISPATCH_START_LOAD_MIN} min") on ${cores} cores is over the ${MAX_LOAD} pace"
  return 0
}

# idle_why <red 0|1> -> why this machine's real idle holds a start, or nothing. Read only when it
# decides: a floor start goes past it and should not wait out a sample.
idle_why() {
  local idle
  if [ "$1" = 1 ] || floor_open || project_floor_open; then :
  # A reader with no sample in its window knows of no idle hold, which is not a hold.
  elif idle=$(real_idle) && [ -z "$idle" ]; then [ -n "${IDLE_CACHED:-}" ] || echo "real idle unreadable"
  elif awk -v i="$idle" -v m="$DISPATCH_MIN_IDLE" 'BEGIN { exit !(i < m) }'; then
    echo "real idle ${idle}% is under ${DISPATCH_MIN_IDLE}%"
  fi
  return 0
}

# machine_why -> this machine's own holds (load_why, idle_why), "; "-joined, or nothing.
machine_why() {
  local red=0 l i
  red_floor_open && red=1
  l=$(load_why "$red"); i=$(idle_why "$red")
  printf '%s%s%s' "$l" "${l:+${i:+; }}" "$i"
}

# gate -> why this pass must not start anything, or nothing when it may. Anything it cannot read
# refuses: a start nobody can justify costs more than waiting for the next pass. Findings are not
# here: one is about a pool or a repo, so pick_item asks them per item.
# A nightly red is deliberately not here: nightlies stay red while sessions merge normally, so it
# would stop everything, and the shepherd's NIGHTLY row handles it.
# Every gate is read and every closed one named, joined by "; ": naming the first only hid a load
# hold behind an account hold for a whole day. A hold stops the reading: nothing else matters then.
gate() {
  local load infra github idle rc out why=()
  agent-hold check dispatch >/dev/null 2>&1 || { echo "held (agent-hold dispatch)"; return; }
  # The verdict's own words say which account is short and why (ACCT_WHY); keep them.
  acct_room; rc=$?
  case $rc in
    0) ;;
    # No account room is not a stop while another source a harness spends has room (start_item
    # routes there); unreadable usage always is.
    1) other_room || why+=("$ACCT_WHY, and no other source has room") ;;
    *) why+=("account usage unreadable ($ACCT_WHY)") ;;
  esac
  local red=0; red_floor_open && red=1
  [ "$red" = 1 ] || fleet-assess --watch-probe >/dev/null 2>&1 || why+=("fleet-assess says HOLD")
  # Cluster only, not every urgent trip: a red nightly is urgent, and new sessions do not worsen it.
  infra="$(fleet-shepherd infra 2>/dev/null)" && why+=("$infra")
  # This machine's own pace holds only a start here: while a fleet worker takes one, the pass goes
  # on, and pick_item places each item on whichever is open (place_host).
  # GATE_NO_MACHINE leaves this machine's pace out altogether, unread: demand_pass asks what else holds.
  load='' idle=''
  [ "${GATE_NO_MACHINE:-0}" = 1 ] || { load=$(load_why "$red"); idle=$(idle_why "$red"); }
  [ -z "$load$idle" ] || ! remote_open || load='' idle=''
  [ -z "$load" ] || why+=("$load")
  github=$(fleet-assess --github 2>/dev/null)
  case "$github" in
    '' | *unreadable*) why+=("github budget unreadable") ;;
    *LOW*) why+=("$github") ;;
  esac
  [ -z "$idle" ] || why+=("$idle")
  [ "${#why[@]}" -eq 0 ] && return
  out=$(printf '%s; ' "${why[@]}"); echo "${out%; }"
}

# judge_failed -- the words a pass whose judge failed carries, with the judge's own reason.
judge_failed() { printf 'could not judge the new rows%s' "${JUDGE_WHY:+ ($JUDGE_WHY)}"; }

# settle <outcome> <why>: say what this pass did and publish it for fleet-liveness. agentctl turns
# a run that publishes nothing into STALLED. A dry run is not a run. A FAILED or BLOCKED pass's
# words are its reason (proof_outcome).
settle() {
  # What the night fill promoted, or its judge failing, is part of the pass whatever stopped it after.
  [ "${NIGHT_FILLED:-0}" = 0 ] || [ "$DRY" = 1 ] || set -- "$1" "queued $NIGHT_FILLED for the night; $2"
  [ "${PLAN_TAGGED:-0}" = 0 ] || set -- "$1" "tagged $PLAN_TAGGED for a plan; $2"
  case "${TRIAGE_FAILED:+x}:$1" in
    x:NOOP | x:BLOCKED) set -- FAILED "triage failed ($TRIAGE_FAILED); $2" ;;
    x:*) set -- "$1" "triage failed ($TRIAGE_FAILED); $2" ;;
  esac
  case "${JUDGE_RC:-0}:$1:$2" in
    0:* | *:"could not judge"*) ;;
    "$EX_BUDGET":NOOP:* | "$EX_BUDGET":BLOCKED:*) set -- BLOCKED "budget: $(judge_failed); $2" ;;
    *:NOOP:* | *:BLOCKED:*) set -- FAILED "$(judge_failed); $2" ;;
    *) set -- "$1" "$(judge_failed); $2" ;;
  esac
  say "$2"
  [ "$DRY" = 0 ] || return 0
  # A pass that started an item past a closed gate (start_item sets FLOOR_HELD) leaves the hold
  # standing (held_since): its WORKED and any later NOOP prove no gate open.
  [ "${FLOOR_HELD:-0}" = 1 ] && local PROOF_HELD_KEEP=1
  # shellcheck source=/dev/null
  . "$HOME/.local/lib/agent-proof.sh" 2>/dev/null || return 0
  proof_outcome fleet-dispatch "$1" "$2" 2>/dev/null || true
}

# settle_board <outcome> <why> -- settle a pass on its board step. A pass that came here past held
# queue items and starts nothing is BLOCKED by the hold, never a NOOP that dashboards read as green.
settle_board() {
  if [ "${STARTED:-0}" -gt 0 ] && [ "$1" = NOOP ]; then say "$2"   # the pass already published WORKED
  elif [ -n "${QUEUE_HELD:-}" ] && [ "$1" = NOOP ]; then settle BLOCKED "$QUEUE_HELD; $2"; else settle "$@"; fi
}

# triage_pass: reds become rows and red items before the pass counts its room, so a fix queued here
# starts this pass. The guards live in fleet-bench. A failure is named in the outcome, never stops the pass.
# It reports under fleet-bench's own name: under this unit's AGENTCTL_NAME its NOOP or WORKED became
# this pass's, and ended a standing hold (held_since) at the top of every pass.
triage_pass() {
  local out
  out=$(AGENTCTL_NAME=fleet-bench fleet-bench triage 2>&1) || TRIAGE_FAILED=$(tail -n 1 <<<"$out" | cut -c1-100)
}

cmd_run() {
  local why live room
  fleet_hosts >/dev/null   # once, so each subshell of the pass inherits the roster
  DRY=0
  [ "${1:-}" = --dry-run ] && DRY=1
  mkdir -p "$DIR"
  exec 9>"$DIR/.lock"
  # A NOOP that never read the gates leaves a standing hold as it is (PROOF_HELD_KEEP, agent-proof.sh).
  flock -n 9 || { PROOF_HELD_KEEP=1 settle NOOP "another pass is running"; return 0; }

  [ "$DRY" = 1 ] || cmd_reap
  QUEUE_HELD='' STARTED=0 RED_STARTED=0 RED_PASS=0 PROJECT_STARTED=0 PROJECT_PASS=0 RUN_GATED=0 FLOOR_HELD=0 PRESENT_LEFT= JUDGE_RC= JUDGE_WHY= NIGHT_FILLED=0 PLAN_TAGGED=0 TRIAGE_FAILED= NO_ROOM=
  NO_ROUTE=()
  [ "$DRY" = 1 ] || triage_pass
  # Night rows first, ahead of the run units, the queue's depth and the gates: they only promote, and
  # agent-queue holds a night item to its window. A dispatch hold stops even this. A judge that
  # fails here does not stop the queue: settle names it and turns a NOOP or BLOCKED pass into FAILED,
  # or into BLOCKED when its budget stopped it.
  agent-hold check dispatch >/dev/null 2>&1 && fill_night
  # Skips no session can take for want of a definition go to inbox-plan; a dry run only reads.
  [ "$DRY" = 1 ] || ! agent-hold check dispatch >/dev/null 2>&1 || plan_skips
  local runs; runs=$(live_runs)
  live=$(units_on '' <<<"$runs")
  FLOOR_LIVE=$(grep -c . <<<"$runs" || true)
  probe_hosts "$runs"
  RED_LIVE=$(live_reds | grep -c . || true)
  BUSY_PROJECTS=$(busy_projects)
  UNITS_FREE=$(( DISPATCH_MAX_LIVE - live ))
  demand_pass "$runs"
  # Room is this machine's units plus every placed worker's.
  # A worker adds room only when it takes a session now (host_why), not merely by being placed.
  local h remote=0; for h in "${!HOST_FREE[@]}"; do [ -n "$(host_why "$h")" ] || remote=$(( remote + HOST_FREE[$h] )); done
  room=$UNITS_FREE; [ "$room" -ge 0 ] || room=0
  room=$(( room + remote ))
  [ "$room" -gt "$PER_PASS" ] && room=$PER_PASS
  # A full fleet is working, not blocked: NOOP.
  if [ "$room" -le 0 ]; then PROOF_HELD_KEEP=1 settle_board NOOP "at $live of $DISPATCH_MAX_LIVE run units${HOST_FREE[*]:+, every fleet worker full}, starting nothing"; return 0; fi
  # The queue comes first; the board tops it up while fewer than DISPATCH_LOW_WATER items are
  # runnable, so the next pass has work before this one runs dry. An item a firing finding holds is
  # not runnable, so the pass goes on to the board, whose rows pass the same holds. On 2026-11-05 held
  # unity items kept every pass off the board for 7h: the rows filed to fix the hold never started,
  # and 220 rows sat unjudged. Above the low water, fewer than DISPATCH_CLEANUP_FLOOR runnable cleanup
  # items still read the board, for cleanup rows only: a full queue of other work kept cleanup off it.
  local items rc depth want cdepth only=''; items=$(next_items)
  if [ -n "$items" ]; then
    HELD_FALLS_THROUGH=1; run_queue "$items" "$room"; rc=$?; HELD_FALLS_THROUGH=0
    if [ -z "$QUEUE_HELD" ]; then
      [ "$rc" -eq 0 ] && [ "$RUN_GATED" = 0 ] || return "$rc"
      depth=$(queue_depth)
      if [ "$depth" -lt "$DISPATCH_LOW_WATER" ]; then
        say "runnable $depth is under the low water $DISPATCH_LOW_WATER, topping the queue up from the board"
      else
        [ -n "${DISPATCH_CLEANUP_PROJECTS// }" ] && [ "$DISPATCH_CLEANUP_FLOOR" -gt 0 ] || return 0
        cdepth=$(cleanup_depth)
        [ "$cdepth" -lt "$DISPATCH_CLEANUP_FLOOR" ] || return 0
        only=cleanup
        say "runnable cleanup $cdepth is under the floor $DISPATCH_CLEANUP_FLOOR, topping cleanup up from the board"
      fi
    fi
  fi
  # Every gate but presence: promoting is not starting, and start_items holds a present pass to the trickle.
  why=$(gate)
  if [ -n "$why" ]; then
    PROOF_HELD_KEEP=1 settle_board NOOP "$why, starting nothing"
    [ "$DRY" = 1 ] || return 0
  fi
  room=$(( room - STARTED ))
  want=$(( DISPATCH_LOW_WATER - ${depth:-0} )); [ "$want" -gt "$room" ] || want=$room
  [ -z "$only" ] || want=$(( DISPATCH_CLEANUP_FLOOR - cdepth ))

  # Unread findings would hold whatever fill promotes, so they stop the pass before the judge.
  load_findings || { settle NOOP "fleet-bench findings unreadable, starting nothing"; [ "$DRY" = 1 ] || return 0; }
  fill_day "$want" $only || { settle FAILED "$(judge_failed)"; return 1; }
  if [ "$DRY" = 1 ]; then [ $(( FILLED + NIGHT_FILLED )) -gt 0 ] || settle_board NOOP "no row qualifies this pass"; return 0; fi
  [ "$room" -gt 0 ] || return 0
  # Past the gates already: what fill promoted starts now, through the same start as any item.
  items=$(next_items)
  if [ -z "$items" ]; then
    if [ "$FILLED" -gt 0 ] && human_here; then settle_board NOOP "queued $FILLED; the human is here and this hour's DISPATCH_PRESENT_PER_HOUR=$DISPATCH_PRESENT_PER_HOUR start is used, so they start when they leave"
    else settle_board NOOP "no row qualifies this pass"; fi
    return 0
  fi
  start_items "$items" "$room"
}

# unjudged_rows -> the open rows no verdict covers yet, day candidates and night rows, once each.
unjudged_rows() { { cmd_candidates; night_rows "$(judged_keys)"; } | jq -sc 'unique_by([.project, .lane, .key])[]'; }

# fill_now <room> -- `fill` by hand: the night picks (fill_night), then up to <room> day picks (fill_day).
fill_now() {
  fill_night || return 1
  fill_day "$1" || return 1
  FILLED=$(( FILLED + NIGHT_FILLED ))
}

# judge_once -- judge the open rows no verdict covers, once a pass, however many fills ask. A dry
# run never judges: it names what the cache says, and verdicts.jsonl stays as it was. A budget stop
# is not a failed fill: the cached verdicts still pick, and settle names the stop.
judge_once() {
  if [ -z "${JUDGE_RC:-}" ]; then
    JUDGE_RC=0
    [ "$DRY" = 1 ] || { judge "$(unjudged_rows)"; JUDGE_RC=$?; }
  fi
  [ "$JUDGE_RC" = "$EX_BUDGET" ] || return "$JUDGE_RC"
}

# day_picks <room> -> the rows a merging session may take: picks over every open row, judged ones
# included (a row judged on an earlier pass can be picked now), and the tier-3 cleanup rows
# (t3_cleanup_picks), in RANK_JQ order, one an area, up to <room>.
day_picks() {
  { picks "$(all_open)" 999; t3_cleanup_picks "$(night_rows '')"; } |
    jq -sc --argjson room "$1" "$RANK_JQ"'rank | unique_by([.project, .area]) | rank | .[:$room] | .[]'
}

# fill_day <room> [cleanup] -- promote up to <room> day_picks into the queue, `from: board:`. A cleanup
# row's item is tagged `cleanup` (the floor counts them), and every item `tier<N>` (item_tier). With
# `cleanup` (the floor, over the low water) every scan under it, the judge's included when this pass
# has not judged yet, reads only the cleanup rows of DISPATCH_CLEANUP_PROJECTS (CLEANUP_ONLY).
fill_day() {
  local picked c tags CLEANUP_ONLY=${CLEANUP_ONLY:-}
  [ "${2:-}" != cleanup ] || CLEANUP_ONLY=1
  FILLED=0
  judge_once || return 1
  picked=$(day_picks "$1")
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    FILLED=$(( FILLED + 1 ))
    if [ "$DRY" = 1 ]; then echo "would queue: $(jq -r '"\(.project) (\(.stage)) \(.lane), \(.worker), \(.area), \(.priority): \(.key) [\(.why // "")]"' <<<"$c")"
    else
      tags=$(jq -r '[if .cleanup == 0 then "cleanup" else empty end, if .tier then "tier\(.tier)" else empty end] | join(" ")' <<<"$c")
      promote "$c" "$tags" "$(jq -r .text <<<"$c" | sed 's/^- \[.\] //')"
    fi
  done <<<"$picked"
  return 0
}

# cleanup_depth -> the runnable items a cleanup row promoted (tag `cleanup`): what DISPATCH_CLEANUP_FLOOR measures.
cleanup_depth() { runnable 2>/dev/null | jq -c 'select((" " + (.tags // "") + " ") | contains(" cleanup "))' | grep -c . || true; }

# fill_night -- promote tier-3 rows (night_picks) tagged `night`, which run to an open PR only, up to
# DISPATCH_NIGHT_MAX active at once. A run pass calls it before the queue's depth and the gates:
# promoting is not starting (agent-queue holds a night item to its window, start_items gates every
# start). Behind the day fill's low water and gates (4458b2f1, 2026-11-03), no night item was queued
# in three days while eligible rows sat on the board, and no pass judged.
fill_night() {
  local active night c jrc=0
  NIGHT_FILLED=0
  # A judge that fails still leaves the cached verdicts to pick from; the failure is returned after.
  judge_once || jrc=1
  active=$(agent-queue list --json --state active 2>/dev/null |
    jq -s '[.[] | select((.from | startswith("board:")) and ((" " + (.tags // "") + " ") | contains(" night ")))] | length' 2>/dev/null)
  active=$(( NIGHT_MAX - ${active:-0} )); [ "$active" -gt 0 ] || active=0
  night=$(night_picks "$(night_rows '')" "$active")
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    NIGHT_FILLED=$(( NIGHT_FILLED + 1 ))
    if [ "$DRY" = 1 ]; then echo "would queue for the night: $(jq -r '"\(.project) \(.area): \(.key)"' <<<"$c")"
    else promote "$c" night "$(night_brief "$c")"; fi
  done <<<"$night"
  return "$jrc"
}

# promote <row> <tags> <task> -- claim the open row on its board, then add it to the queue under its
# id, at the row's priority; a row that cannot be added is un-started again. The start stamps an id
# on a row with none; a row still without one (its project has no code) is refused, since nothing
# could join an item to it. The new item's slug is left in PROMOTED.
promote() {
  local c="$1" tags="$2" task="$3" repeat="${4-}" prof project lane key area line out id slug flag=() rc=0
  prof=$(jq -r .profile <<<"$c"); project=$(jq -r .project <<<"$c"); lane=$(jq -r .lane <<<"$c")
  key=$(jq -r .key <<<"$c"); area=$(jq -r '.area // empty' <<<"$c")
  [ "$lane" = agent ] && flag=(--agent)
  line=$(row_line "$prof" "$project" "$lane" "$key")
  [[ "$line" == '- [ ]'* ]] || { say "skip $project: row no longer open: $key"; return 1; }
  out=$(np "$prof" ptask "$project" "${flag[@]}" --exact start -- "$line" 2>&1) ||
    { say "skip $project: could not start row: $key ($out)"; return 1; }
  id=$(sed -n 's/^  id://p' <<<"$out")
  [ -n "$id" ] || [[ "$line" != *"id:$key "* ]] || id=$key
  if [ -z "$id" ]; then
    np "$prof" ptask "$project" "${flag[@]}" --exact unstart -- "- [/]${line#- \[ \]}" >/dev/null 2>&1
    say "skip $project: row has no id and start gave it none (no code in project-map.json?), un-started: $key"
    return 1
  fi
  # The row's words are the item's title: no checkbox, id comment or #tags.
  local title
  title=$(sed -E 's/^- \[.\] //; s/<!--[^>]*-->//g; s/(^| )#[A-Za-z0-9_/:.-]+//g; s/ +$//' <<<"$line")
  out=$(agent-queue add --project "$project" --priority "$(row_priority "$line" "$project")" --from "board:$project:$id" --slug "$id" \
      ${title:+--title "$title"} ${tags:+--tags "$tags"} ${repeat:+--repeat} -- "$task" 2>&1) || rc=$?
  if [ "$rc" -ne 0 ]; then
    # The row's own item already finished ok, so its work landed and the row escaped closing. An agent
    # row stays started: the orphan pass closes it on that item's merge proof (land_orphan), or hands it
    # back after DISPATCH_ORPHAN_HOURS. A human row goes back now with a failed verdict naming why, so
    # neither is queued again every pass. The human's own Start (cmd_promote) passes --repeat instead.
    if [ "$rc" -eq "$AQ_EX_FINISHED" ]; then
      if [ "$lane" = agent ]; then say "skip $project: row left started for the orphan pass: ${out#agent-queue: }"; return 1; fi
      np "$prof" ptask "$project" "${flag[@]}" unstart "$id" >/dev/null 2>&1
      mkdir -p "$DIR"
      jq -cn --arg p "$project" --arg l "$lane" --arg k "$key" --arg r "${out#agent-queue: }" --arg at "$(date -Iseconds)" \
        '{project: $p, lane: $l, key: $k, verdict: "failed", reason: $r, at: $at}' >> "$VERDICTS"
      say "skip $project: row un-started, recorded failed: ${out#agent-queue: }"
      return 1
    fi
    np "$prof" ptask "$project" "${flag[@]}" unstart "$id" >/dev/null 2>&1
    say "could not queue $project row, un-started: $id ($out)"
    return 1
  fi
  # The `<state> <slug> -> <file>` line, not the first: a warning on add's stderr may come before it.
  slug=$(awk '$3 == "->" { print $2; exit }' <<<"$out"); PROMOTED=$slug
  agent-queue set "$slug" "lane=$lane" ${prof:+"profile=$prof"} ${area:+"area=$area"} >/dev/null
  logline "filled queue item $slug from $project $lane row${tags:+ ($tags)}: $id"
  echo "queued $project: $id"
}

# cmd_promote --project P [--profile X] [--agent] [--tags T] --raw LINE -- queue one row as the human saw it: the
# Board tab's Start. A row that changed since, or is already started, is refused. No gate: the item
# starts like any board item: when the human is away, or within the present trickle.
cmd_promote() {
  local project='' prof='' lane=human raw='' tags='' board key
  while [ $# -gt 0 ]; do
    case "$1" in
      --agent) lane=agent; shift; continue ;;
      --project | --profile | --raw | --tags) [ $# -ge 2 ] || { say "promote: $1 needs a value"; return 2; } ;;
      *) say "promote: unknown argument: $1"; return 2 ;;
    esac
    case "$1" in --project) project=$2 ;; --profile) prof=$2 ;; --raw) raw=$2 ;; --tags) tags=$2 ;; esac
    shift 2
  done
  [ -n "$project" ] && [ -n "$raw" ] || { say "promote: --project and --raw are required"; return 2; }
  board=$(rows "$prof" "$project" "$lane")
  key=$(R="$raw" awk -F'\t' 'substr($0, length($1) + 2) == ENVIRON["R"] { print $1; exit }' <<<"$board")
  [ -n "$key" ] || { say "promote: not on the $project $lane board as given, so it changed: $raw"; return 1; }
  promote "$(jq -cn --arg profile "$prof" --arg project "$project" --arg lane "$lane" --arg key "$key" \
    '{profile: $profile, project: $project, lane: $lane, key: $key}')" "$tags" "$(sed 's/^- \[.\] //' <<<"$raw")" repeat
}

# all_open -- candidates without the judged filter: every open, eligible row
all_open() { VERDICTS=/dev/null cmd_candidates; }

# cmd_fill [--dry-run] [--json] -- by hand: promote up to DISPATCH_PER_PASS picks into the queue, no
# gate. --dry-run is the order a pass would promote rows in, with no judge call and no write:
# `ready` rows are day_picks (cached verdicts only, a live area skipped, tier-3 cleanup included), then
# `night` rows (tier 3, promoted with the night tag), then `unjudged` rows, which no current verdict
# covers and the next pass judges first.
cmd_fill() {
  local ready night unj dry=0 json=''
  while [ $# -gt 0 ]; do
    case "$1" in --dry-run) dry=1 ;; --json) json=1 ;; *) say "fill: unknown argument: $1"; return 2 ;; esac
    shift
  done
  if [ "$dry" = 0 ]; then
    DRY=0; mkdir -p "$DIR"; exec 9>"$DIR/.lock"
    flock -n 9 || { say "fill: another pass is running"; return 0; }
    fill_now "$PER_PASS"; return
  fi
  ready=$(day_picks 999)
  night=$(night_picks "$(night_rows '')")
  unj=$(unjudged_rows)
  if [ -n "$json" ]; then
    { [ -z "$ready" ] || jq -c '. + {state: "ready"}' <<<"$ready"
      [ -z "$night" ] || jq -c '. + {state: "night"}' <<<"$night"
      [ -z "$unj" ] || jq -c '. + {state: "unjudged"}' <<<"$unj"; }
    return 0
  fi
  [ -n "$ready$night$unj" ] || { echo "fill: no open row to promote"; return 0; }
  [ -z "$ready" ] || jq -r '"ready     \(.project) (\(.stage)) \(.lane), \(.worker), \(.area), \(.priority): \(.key) [\(.why // "")]"' <<<"$ready"
  [ -z "$night" ] || jq -r '"night     \(.project) (\(.stage)) \(.lane), \(.area), \(.priority): \(.key)"' <<<"$night"
  [ -z "$unj" ] || jq -r '"unjudged  \(.project) (\(.stage)) \(.lane): \(.key)"' <<<"$unj"
}

# --- night: tier 3 to an open PR -------------------------------------------------------

# night_rows <judged> -> the open agent-lane rows of the night projects that no merging session may
# take because of tier alone: no tier tag below 3 and none of DISPATCH_NIGHT_SKIP. `order` is the
# row's place on its board, newest first; `rank` puts what the human asked for, then observer rows,
# first (cleanup rows leave for t3_cleanup_picks, so kinds.json is the one cleanup rank).
night_rows() {
  local judged="$1" name sheet stage repo key text body t line n x planned dj dsig board
  local -A DET=() PLN=() PAR=()
  load_extras
  load_kinds
  for name in $DISPATCH_NIGHT_PROJECTS; do
    sheet=$(np "$DISPATCH_NIGHT_PROFILE" projects 2>/dev/null | awk -F'\t' -v p="$name" '$1 == p { print $2; exit }')
    stage=$(stage_of "$sheet")
    dispatchable "$stage" || continue
    repo=$(repo_dir "$name")
    [ -n "$repo" ] && [ -d "$repo" ] || continue
    n=0
    board=$(rows "$DISPATCH_NIGHT_PROFILE" "$name" agent)
    row_kinds_load <<<"$board"
    while IFS=$'\t' read -r key text; do
      [ -n "$key" ] || continue
      n=$(( n + 1 ))
      case "$text" in '- [ ]'*) ;; *) continue ;; esac
      t=$(row_tier "$text")
      [ -z "$t" ] || [ "$t" = 3 ] || continue
      body=${text#- \[ \] }
      grep -qiE -- "$DISPATCH_NIGHT_SKIP" <<<"${body%%<!--*}" && continue
      [ -z "${CLEANUP_ONLY:-}" ] || [ "$(cleanup_row "$name" "$text")" = 0 ] || continue
      [ -z "${PLN["$name"$'\t'agent$'\t'"$key"]:-}" ] || continue
      [ -z "$(row_off "$name" "$stage" "$key" "$text")" ] || continue
      line=$(printf '%s' "$text" | sig)
      x=${DET["$name"$'\t'agent$'\t'"$key"]:-$'0\t""'}
      planned=${x%%$'\t'*} dj=${x#*$'\t'}
      dsig=$(detail_sig "$dj")
      held "$judged" "$name" agent "$key" "$line" "$dsig" && continue
      jq -cn --arg project "$name" --arg stage "$stage" --arg key "$key" --arg text "$text" \
        --argjson details "$dj" --arg dsig "$dsig" --argjson planned "$planned" \
        --arg body "$body" --arg repo "$repo" --arg line "$line" --argjson prio "$(prio_rank "$text")" \
        --arg priority "$(row_priority "$text" "$name")" --argjson order "$n" --arg obs "$DISPATCH_NIGHT_OBSERVER" \
        --arg profile "$DISPATCH_NIGHT_PROFILE" --arg rsize "$(row_size "$text")" --arg pprio "$(prio_of "$sheet")" \
        --argjson cleanup "$(cleanup_row "$name" "$text")" \
        '{profile: $profile, project: $project, stage: $stage, lane: "agent", key: $key,
          text: $text, repo: $repo, prio: $prio, priority: $priority, tier: 3, line: $line, order: $order, wrank: 0, row_size: $rsize,
          cleanup: $cleanup, project_prio: $pprio,
          details: $details, dsig: $dsig, planned: ($planned == 1),
          rank: (if ($body | test("(^| )#requested( |$)")) then -1 elif ($body | test($obs; "i")) then 0 else 1 end)}'
    done <<<"$board"
  done
}

# t3_ready <rows> -> the night_rows whose verdict, under a policy that still defines its rule and for the row's current
# text, says tier 3 is the only reason a merging session may not take it, and that it is S or M,
# clear, agent-only and in one area, with that area on the row.
t3_ready() {
  [ -n "$1" ] || return 0
  jq -sc --argjson prules "$(policy_rules)" --slurpfile v <(latest_verdicts) "$ROW_JQ"'
    ($v | map({key: ([.project, .lane, .key] | tostring), value: .}) | from_entries) as $by
    | .[] | . as $c | $by[[.project, .lane, .key] | tostring] as $d
    | select($d != null and $d.tier3_only == true and $d.tier == 3
        and (eff_size($d) | IN("S", "M")) and $d.clear == true and $d.agent_only == true
        and ($d | usable($prules)) and ($d | holds($c))
        and ($d.area | type) == "string" and $d.area != "")
    | . + {area: ($d.area | ascii_downcase)}' <<<"$1"
}

# night_picks <rows> [n] -> up to n (default DISPATCH_NIGHT_MAX) t3_ready rows that are not cleanup: a cleanup row
# merges at any hour instead (t3_cleanup_picks). One row an area, so a night's PRs do not collide.
# Human asks first (#requested), then observer rows, then most urgent, then oldest (night_rows' rank).
night_picks() {
  t3_ready "$1" | jq -sc --argjson max "${2:-$NIGHT_MAX}" 'map(select(.cleanup != 0))
    | sort_by(.rank, .prio, -.order) | unique_by([.project, .area]) | sort_by(.rank, .prio, -.order)
    | .[:$max] | .[]'
}

# t3_cleanup_picks <rows> -> the t3_ready rows that are cleanup, each a merging item behind the red-fix
# gate (policy.md "Tier"), in RANK_JQ order with the project's #prio (night_rows' project_prio), as
# picks ranks the day rows they merge with. One tier-3 item in flight an area: an area an active
# queue item holds (queue_areas, the lock picks reads) is skipped.
t3_cleanup_picks() {
  t3_ready "$1" | jq -sc --arg today "${DISPATCH_TODAY:-$(date +%F)}" \
    --argjson busy "$(queue_areas | jq -Rsc 'split("\n") | map(select(length > 0) | ascii_downcase)')" "$RANK_JQ"'
    map(select(.cleanup == 0 and ("\(.project | ascii_downcase)/\(.area)" as $a | $busy | index($a) | not))
      | . + {worker: "tier3-cleanup"} | rank_fields($today; .project_prio // ""))
    | rank | unique_by([.project, .area]) | rank | .[]'
}

# night_brief <row> -- the task a `night` item runs with nobody to ask (start adds /one-shot --pr-only)
night_brief() {
  local project key text repo where
  project=$(jq -r .project <<<"$1"); key=$(jq -r .key <<<"$1"); repo=$(jq -r .repo <<<"$1")
  text=$(jq -r .text <<<"$1" | sed 's/^- \[.\] //')
  where=$(grep -oE '[A-Za-z0-9_./-]*[A-Za-z][A-Za-z0-9_./-]*:[0-9]+(-[0-9]+)?' <<<"${text%%<!--*}" | paste -sd, - | sed 's/,/, /g')
  cat <<EOF
$text

Promoted by fleet-dispatch fill from the $project agent board, row "$key". It is tier 3 (harness or tooling), which runs unattended to an open PR only.
- Repo: $repo. Its private overlay ~/.dotfiles-private holds the rules, agentctl confs and private bins; dotfiles-land says which repo a file belongs in, and a change that touches both is two PRs.
- Where: ${where:-the row names no file:line. Find the code it means first; if you cannot name one, stop blocked.}
- Merge gate: $DISPATCH_NIGHT_GATE.
- Open the PR, do not merge. The human merges in the morning.
- Done means: the change the row describes is in an open PR with its gate green. The row is already started on the board: add no new row and do not mark it done; the human's merge closes it.
- If the row turns out to need a decision, the human, or a repo other than these two, stop blocked with agent-ask post.
EOF
}

cmd_report() {
  latest_verdicts | jq -r --arg sig "$(policy_sig)" '[.verdict, .size // "-", (.tier // "-" | tostring),
      .project, .lane, .area // "-", .key, (.reason // "") + (if .verdict != "failed" and .policy != $sig then " (stale: policy changed)" else "" end)] | @tsv' |
    sort | awk -F'\t' '{ printf "%-9s %-2s t%-2s %-16s %-6s %-12s %s\n           %s\n", $1, $2, $3, $4, $5, $6, substr($7, 1, 90), $8 }'
}

main() {
  case "${1:-}" in
    run)
      shift; cmd_run "$@"; local rc=$?
      # After the pass, so it counts what the pass left: stats reads this, never the gates itself.
      [ "$DRY" = 1 ] || { cmd_headroom --json > "$HEADROOM.$$" 2>/dev/null && mv -f "$HEADROOM.$$" "$HEADROOM" || rm -f "$HEADROOM.$$"; }
      return "$rc" ;;
    candidates) cmd_candidates ;;
    suggest) shift; cmd_suggest "$@" ;;
    fill) shift; cmd_fill "$@" ;;
    promote) shift; cmd_promote "$@" ;;
    report) cmd_report ;;
    reap) cmd_reap ;;
    starved) cmd_starved ;;
    stats) cmd_stats ;;
    stopped) shift; cmd_stopped "$@" ;;
    start) shift; cmd_start "$@" ;;
    record) cmd_record ;;
    restore) shift; cmd_restore "$@" ;;
    headroom) shift; cmd_headroom "$@" ;;
    item-tier) shift; cmd_item_tier "$@" ;;
    hosts) shift; cmd_hosts "$@" ;;
    -h | --help) sed -n '2,37p' "$0" ;;
    *) sed -n '2,20p' "$0" >&2; return 2 ;;
  esac
}

# Sourceable for tests; runs main only when executed.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
