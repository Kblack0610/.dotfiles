#!/usr/bin/env bash
# fleet-dispatch - start one session per easy board row, for the shepherd to see through.
#
#   fleet-dispatch run [--dry-run]   one pass: start the queue head, else fill from the board and start that
#   fleet-dispatch candidates        open rows eligible to judge, one JSON object per line
#   fleet-dispatch report            latest verdict per row: picked or skipped, and why
#   fleet-dispatch fill [--dry-run] [--json]  promote picked board rows into agent-queue; --dry-run lists them
#   fleet-dispatch reap              settle ledger entries whose session is gone
#   fleet-dispatch night [--dry-run] queue up to 3 tier-3 harness rows into night-shift, to a PR only
#   fleet-dispatch start --project P [--profile X] [--agent] [--server S] [--model M]
#       (--item SLUG | --brief FILE --row KEY [--cwd REPO] | --resume ID --session NAME --cwd DIR [--row KEY])
#                                    start ONE session the way every agent must: see cmd_start
#
# A pass walks the workers in workers.json in file order, and a row goes to the first that may
# take it: `#worker/<name>` plus a `#tier/N` within its max_tier (tier meanings: policy.md), and
# inside its `projects`, `lane` and `only_tag` when it names them. A worker marked `untagged`
# takes rows with no `#worker` tag instead, and with no `#tier` tag the judge's reading decides.
# The human assigns `fleet` rows; agents may assign `asks` rows, which must carry `#ask`.
# A pass starts nothing unless the human is away (fleet-presence): see gate.
# Facts are code; the judgment (is this row clear, agent-only, in one area and really that tier?)
# is one model call per pass against policy.md, cached per row in verdicts.jsonl until the
# row's text, the policy or workers.json changes. A picked row is started on its sheet and added
# to agent-queue (low, `from: board:`); its item gets a detached `wt new` session on the lab server
# running /one-shot, tagged @dispatch, with a ledger entry at live/<session>. Pause: `agent-hold set dispatch`.
# `start` is that same launch for a session an agent starts by hand or restores after a reboot.
# `night` is the one way tier 3 runs unattended: the night-shift runner calls it before its run,
# and it queues the dotfiles boards' tier-3 rows as night-shift tasks, which stop at an open PR.
# Tuning is the DISPATCH_* block, set in the agentctl conf.

set -uo pipefail

: "${DISPATCH_PROFILES:=bnb}"
: "${DISPATCH_PER_PASS:=1}"   # one new session a pass: each is easy to evaluate before the next
: "${DISPATCH_MAX_LIVE:=6}"
: "${DISPATCH_MAX_LOAD:=0.7}"   # 1-min load per core; the fleet-overseer pace target
: "${DISPATCH_MIN_IDLE:=30}"    # percent of the machine really idle: niced Unity runs fill it while load looks fine
: "${DISPATCH_FINDING_FRESH_MIN:=20}"   # two fleet-bench samples: a finding stays open 60 min after it stops firing
: "${DISPATCH_JUDGE_MAX:=40}"   # rows judged per pass; the rest wait for the next pass
: "${DISPATCH_JUDGE_CMD:=agentctl-run --role observe}"
: "${DISPATCH_SERVER:=lab}"
: "${DISPATCH_POLICY:=$HOME/.config/fleet-dispatch/policy.md}"
: "${DISPATCH_WORKERS:=$HOME/.config/fleet-dispatch/workers.json}"
: "${DISPATCH_PROJECT_MAP:=$HOME/.config/shared-hooks/project-map.json}"
: "${DISPATCH_LOADAVG:=/proc/loadavg}"
# The night pass: the default notes profile's agent lanes of the dotfiles boards.
: "${DISPATCH_NIGHT_PROFILE:=}"   # empty: notes' own default profile, where those boards live
: "${DISPATCH_NIGHT_PROJECTS:=agent-runtime notes-cockpit}"
: "${DISPATCH_NIGHT_MAX:=3}"
: "${DISPATCH_NIGHT_TURNS:=60}"
: "${DISPATCH_NIGHT_GATE:=make -C tests test-fast, then the shell tests CI on the PR green (the ui tier runs only in CI, never on this machine)}"
# Rows the night pass never queues, whatever the judge says: asks, decisions, anything needing a
# device or the human's own machine, secrets, prod, wishes. Case-insensitive ERE.
: "${DISPATCH_NIGHT_SKIP:=#ask\b|^decide:|\b(device|pads?|headset|playtest)\b|\b(waybar|hypr[a-z]*|ananicy|sysctl|sudo|wi-?fi)\b|\b(secrets?|passwords?|credentials?|rbw|sops)\b|\b(prod|production|dns)\b|would be cool|should i\b|\bmaybe\b|\bideally\b|investigate whether}"
# Ranking, first match wins: rows that delete or fix a broken mechanism, then observer findings.
: "${DISPATCH_NIGHT_FIRST:=\b(delete|remove|drop|retire|prune|strip|broken|never|fails|failing|failed|dead|wrong|stale|leaks?|orphans?|races?)\b}"
: "${DISPATCH_NIGHT_OBSERVER:=^(kpi|retro|dream)\b}"
DIR="${FLEET_DISPATCH_DIR:-$HOME/.agent/dispatch}"
LIVE="$DIR/live"
VERDICTS="$DIR/verdicts.jsonl"
LOG="$DIR/log.md"

# Tier 3 (CI, gates, runners, build and deploy, harness, tooling) never gets a merging session,
# whatever workers.json says: the human's decision of 2026-10-27, after a dispatched session
# spent 50 minutes on a `ci:` row. Raising this is a conversation, not a config edit.
# Tier 3 may run unattended to an open PR only, via night-shift, never past it (human decision 2026-11-02): see night.
UNATTENDED_TIER_CEILING=2

say() { printf 'fleet-dispatch: %s\n' "$*" >&2; }
logline() { mkdir -p "$DIR"; printf -- '- %s %s\n' "$(date '+%Y-%m-%d %H:%M')" "$*" >> "$LOG"; }

# --- facts ---------------------------------------------------------------------------

# stage_of <sheet> -> draft|alpha|beta|prod, from the tag on its Version: line
stage_of() { sed -n 's/^Version:.*#\(draft\|alpha\|beta\|prod\)\b.*/\1/p' "$1" 2>/dev/null | head -1; }

stage_rank() { case "$1" in prod) echo 0 ;; beta) echo 1 ;; *) echo 2 ;; esac; }

prio_rank() {
  case "$1" in
    *'#urgent'*) echo 0 ;;
    *'#high'*) echo 1 ;;
    *'#low'*) echo 3 ;;
    *) echo 2 ;;
  esac
}

# repo_dir <project> -> the checkout its code lives in; nothing for a notes-only project.
# The registry's own resolver (project-name.sh), reading DISPATCH_PROJECT_MAP.
# shellcheck source=../../.config/shared-hooks/project-name.sh
. "${PROJECT_NAME_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../../.config/shared-hooks/project-name.sh}"
repo_dir() { PROJECT_MAP_FILE="$DISPATCH_PROJECT_MAP" project_repo_path "$1"; }

# tag_value <text> <namespace> -> the value of the row's first `#<namespace>/<value>` tag.
# Only the text before a `<!--` marker counts: a tag inside a proof stamp is record, not routing.
tag_value() {
  local body="${1%%<!--*}"
  grep -oE "(^|[[:space:]])#$2/[A-Za-z0-9_.-]+" <<<"$body" | head -1 | sed "s|.*#$2/||"
}

# row_tier <text> -> 1|2|3, or nothing when the row carries no tier. A `ci:` or `infra:`
# row is tier 3 however it is tagged.
row_tier() {
  local body
  body=$(sed 's/^- \[.\] //' <<<"$1" | tr '[:upper:]' '[:lower:]')
  case "$body" in ci:* | infra:*) echo 3; return ;; esac
  tag_value "$1" tier | grep -xE '[123]'
}

# workers -> one line per worker in registry order: rank, name, max tier capped at the ceiling,
# projects, only_tag, lane, untagged. "-" stands for empty, because read collapses empty tab fields.
workers() {
  jq -r --argjson c "$UNATTENDED_TIER_CEILING" 'to_entries | to_entries[] | .key as $rank | .value
    | [$rank, .key, ([.value.max_tier // 0, $c] | min | floor),
       ((.value.projects // []) | join(",") | if . == "" then "-" else . end),
       (.value.only_tag // "-"), (.value.lane // "-"), (.value.untagged // false)] | @tsv' \
    "$DISPATCH_WORKERS" 2>/dev/null
}

# row_worker <workers> <project> <lane> <row text> -> "<rank> <worker> <tier>" for the first worker
# that may take the row, nothing when none may. A row with no tier tag counts as the highest tier
# an untagged worker takes, and the judge must read it no higher.
row_worker() {
  local project="$2" lane="$3" text="$4" tag row_t t rank name max projects only wlane untagged
  tag=$(tag_value "$text" worker)
  row_t=$(row_tier "$text")
  while IFS=$'\t' read -r rank name max projects only wlane untagged; do
    if [ "$untagged" = true ]; then [ -z "$tag" ] || continue; else [ "$tag" = "$name" ] || continue; fi
    [ "$projects" = - ] || [[ ",$projects," == *",$project,"* ]] || continue
    [ "$only" = - ] || [[ " $text " == *" #$only "* ]] || continue
    [ "$wlane" = - ] || [ "$wlane" = "$lane" ] || continue
    t=$row_t
    [ -n "$t" ] || [ "$untagged" != true ] || t=$max
    [ -n "$t" ] && [ "$t" -le "$max" ] || continue
    echo "$rank $name $t"
    return 0
  done <<<"$1"
  return 1
}

sig() { sha256sum | cut -c1-12; }

# policy_sig -> changes whenever the policy or the worker registry does, so both re-judge.
policy_sig() { cat "$DISPATCH_POLICY" "$DISPATCH_WORKERS" 2>/dev/null | sig; }

# np <profile> <args...> -> notes, under that profile, or notes' own default when it is empty
# (a hand `start` may leave the profile to the CLI).
np() {
  local p="$1"
  shift
  if [ -n "$p" ]; then notes --profile "$p" "$@"; else notes "$@"; fi
}

# ledger_field <file> <name> -> that line's value
ledger_field() { sed -n "s/^$2=//p" "$1" | head -1; }

# session_live <session> [server] -- a ledger older than the server= line was always on DISPATCH_SERVER.
session_live() { tmux -L "${2:-$DISPATCH_SERVER}" has-session -t "=$1" 2>/dev/null; }

# The env prefix that starts claude on the account claude-acct pick chooses
# (the same choice `cl` makes); empty for the main account or when claude-acct is missing. A run
# pass has already chosen with `claude-acct room`, and passes that account in RUN_ACCOUNT.
# Accounts share ~/.claude/projects, so a resumed session works from either one.
account_dir() {
  if [ "${RUN_ACCOUNT+set}" = set ]; then printf '%s' "$RUN_ACCOUNT"; else claude-acct pick || true; fi
}
account_env() {
  local dir; dir=$(account_dir)
  [ -n "$dir" ] && printf 'CLAUDE_CONFIG_DIR=%q ' "$dir"
  return 0
}

# ledger_live <ledger file> -- is its session up, on the server the ledger names?
ledger_live() { session_live "${1##*/}" "$(ledger_field "$1" server)"; }

# live_runs -> "<project>/<area>" for every running session this runner started itself. A hand
# launch or a restore is tagged and tracked like any other, but holds none of the runner's
# slots: a dozen restored sessions must not stop dispatch for the day.
live_runs() {
  local f
  for f in "$LIVE"/*; do
    [ -f "$f" ] || continue
    case "$(ledger_field "$f" origin)" in '' | run) ;; *) continue ;; esac
    ledger_live "$f" && printf '%s/%s\n' "$(ledger_field "$f" project)" "$(ledger_field "$f" area)"
  done
  return 0
}

# queue_areas -> "<project>/<area>" for every active queue item that names an area.
queue_areas() {
  agent-queue list --json --state active 2>/dev/null | jq -r 'select(.area) | "\(.project)/\(.area)"' 2>/dev/null
  return 0
}

# rows <profile> <project> <lane> -> "<key>\t<raw line>" for each OPEN row on the current wave
rows() {
  local flag=()
  [ "$3" = agent ] && flag=(--agent)
  np "$1" ptask "$2" "${flag[@]}" list 2>/dev/null | cut -f3-
}

# row_is <profile> <project> <lane> <key> <mark> -- is that row on the board as `- [<mark>]`?
# The board is read whole first: piped into `grep -q`, a large board dies of SIGPIPE and
# pipefail reads the 141 as "not there".
row_is() {
  local board
  board=$(rows "$1" "$2" "$3")
  grep -qF "$4"$'\t'"- [$5]" <<<"$board"
}

# judged_keys -> "<project>\t<lane>\t<key>\t<line sig>" for each verdict that still holds: one
# made under the current policy for the row's current text. A `failed` record holds for the
# key whatever changed ("*"), so a row whose session died is not picked again on its own.
judged_keys() {
  [ -f "$VERDICTS" ] || return 0
  jq -r --arg sig "$(policy_sig)" '
    if .verdict == "failed" then [.project, .lane, .key, "*"]
    elif .policy == $sig then [.project, .lane, .key, (.line // "")]
    else empty end | @tsv' "$VERDICTS" 2>/dev/null
}

cmd_candidates() {
  local judged table prof name sheet _v stage repo lane key text rank worker tier line
  judged=$(judged_keys)
  table=$(workers)
  [ -n "$table" ] || return 0
  for prof in $DISPATCH_PROFILES; do
    while IFS=$'\t' read -r name sheet _v _; do
      [ -n "$name" ] || continue
      stage=$(stage_of "$sheet")
      case "$stage" in alpha | beta | prod) ;; *) continue ;; esac
      wave-lock check "$name" >/dev/null 2>&1 && continue
      repo=$(repo_dir "$name")
      [ -n "$repo" ] && [ -d "$repo" ] || continue
      for lane in human agent; do
        while IFS=$'\t' read -r key text; do
          [ -n "$key" ] || continue
          case "$text" in '- [ ]'*) ;; *) continue ;; esac
          read -r rank worker tier < <(row_worker "$table" "$name" "$lane" "$text") || continue
          line=$(printf '%s' "$text" | sig)
          grep -qxF "$name"$'\t'"$lane"$'\t'"$key"$'\t'"$line" <<<"$judged" && continue
          grep -qxF "$name"$'\t'"$lane"$'\t'"$key"$'\t*' <<<"$judged" && continue
          jq -cn --arg profile "$prof" --arg project "$name" --arg stage "$stage" \
            --arg lane "$lane" --arg key "$key" --arg text "$text" --arg repo "$repo" \
            --arg line "$line" --argjson prio "$(prio_rank "$text")" --argjson tier "$tier" \
            --arg worker "$worker" --argjson wrank "$rank" \
            '{profile: $profile, project: $project, stage: $stage, lane: $lane, key: $key,
              text: $text, repo: $repo, prio: $prio, tier: $tier, line: $line,
              worker: $worker, wrank: $wrank}'
        done < <(rows "$prof" "$name" "$lane")
      done
    done < <(notes --profile "$prof" projects 2>/dev/null)
  done
}

# --- judgment ------------------------------------------------------------------------

# judge <candidates> -- one model call for the unjudged rows; every verdict lands in the cache
judge() {
  local cands="$1" prompt out verdicts wd rc
  [ -n "$cands" ] || return 0
  # Over the cap, in worker order, then prod rows, then beta, then alpha, each by priority.
  cands=$(jq -sc 'sort_by(.wrank, (.stage | {prod: 0, beta: 1}[.] // 2), .prio)[]' <<<"$cands" |
    head -n "$DISPATCH_JUDGE_MAX")
  [ -r "$DISPATCH_POLICY" ] || { say "no policy at $DISPATCH_POLICY"; return 1; }
  prompt="$(cat "$DISPATCH_POLICY")

## Rows to judge

$(jq -c '{project, stage, lane, key, text, tier}' <<<"$cands")

## Answer

For every row above, one JSON object per line, between a line DISPATCH-VERDICTS-START and a line DISPATCH-VERDICTS-END, nothing else between them:
{\"project\": ..., \"lane\": ..., \"key\": ..., \"tier\": 1|2|3, \"size\": \"S|M|L\", \"area\": \"<one lowercase word>\", \"clear\": true|false, \"agent_only\": true|false, \"tier3_only\": true|false, \"verdict\": \"dispatch|skip\", \"reason\": \"<one short sentence>\"}
Copy project, lane and key exactly as given."
  # The call runs in an empty directory: from inside a repo, that repo's Stop hook runs its
  # tests after the answer, and the model's last message becomes a reply to the hook instead
  # of the verdicts (2026-10-27, run from ~/.dotfiles: every pass failed on one row).
  wd=$(mktemp -d)
  # shellcheck disable=SC2086 # the command is a word list by design (overridable in tests)
  out=$(cd "$wd" && $DISPATCH_JUDGE_CMD -p "$prompt" 2>/dev/null)
  rc=$?
  rm -rf -- "$wd"
  [ "$rc" = 0 ] || { say "judge call failed"; return 1; }
  verdicts=$(sed -n '/^DISPATCH-VERDICTS-START$/,/^DISPATCH-VERDICTS-END$/p' <<<"$out" | sed '1d;$d' |
    jq -cR --arg at "$(date -Iseconds)" --arg sig "$(policy_sig)" \
      --argjson c "$(jq -sc 'map({k: ([.project, .lane, .key] | tostring), line})' <<<"$cands")" '
      fromjson? | select(type == "object"
        and (.project | type) == "string" and (.lane | type) == "string"
        and (.key | type) == "string" and (.verdict == "dispatch" or .verdict == "skip"))
      | ([.project, .lane, .key] | tostring) as $k
      | {project, lane, key, tier, size, area, clear, agent_only, tier3_only, verdict, reason, at: $at,
         policy: $sig, line: ([$c[] | select(.k == $k) | .line] | first)}')
  # A pass that could not judge must not read as "no row qualifies".
  [ -n "$verdicts" ] || { say "judge returned no verdicts for $(wc -l <<<"$cands") row(s): ${out:0:200}"; return 1; }
  mkdir -p "$DIR"
  printf '%s\n' "$verdicts" >> "$VERDICTS"
}

# latest verdict per row, as JSON lines
latest_verdicts() {
  [ -f "$VERDICTS" ] || return 0
  jq -sc 'group_by([.project, .lane, .key]) | map(last) | .[]' "$VERDICTS" 2>/dev/null
}

# picks <candidates> <room> -> the rows to launch: the row's latest verdict is a dispatch made
# under the current policy for its current text, S or M, clear, agent-only, naming one area, and
# judged no higher a tier than the row counts as (all checked here too, so a lax verdict cannot
# launch anything); never two on an area, live or picked now; asks first, then most urgent, then
# prod before beta before alpha.
picks() {
  local cands="$1" room="$2"
  [ "$room" -gt 0 ] && [ -n "$cands" ] || return 0
  jq -sc --argjson room "$room" --arg sig "$(policy_sig)" --argjson max "$UNATTENDED_TIER_CEILING" \
    --argjson busy "$({ live_runs; queue_areas; } | jq -Rsc 'split("\n") | map(select(length > 0) | ascii_downcase)')" \
    --slurpfile v <(latest_verdicts) '
    ($v | map({key: ([.project, .lane, .key] | tostring), value: .}) | from_entries) as $by
    | map(. as $c | $by[[.project, .lane, .key] | tostring] as $d
      | select($d != null and $d.verdict == "dispatch" and ($d.size == "S" or $d.size == "M")
          and $d.clear == true and $d.agent_only == true and $d.policy == $sig and $d.line == $c.line
          and ($d.tier | type) == "number" and $d.tier <= $c.tier and $c.tier <= $max
          and ($d.area | type) == "string" and $d.area != "")
      | . + {area: ($d.area | ascii_downcase), srank: ({"prod": 0, "beta": 1}[.stage] // 2)})
    | map(select("\(.project | ascii_downcase)/\(.area)" as $a | $busy | index($a) | not))
    | sort_by(.wrank, .prio, .srank) | unique_by([.project, .area]) | sort_by(.wrank, .prio, .srank)
    | .[:$room] | .[]' <<<"$cands"
}

# --- launch --------------------------------------------------------------------------

# cmd_start -- THE way an agent starts a session, whoever it is: this runner's `run` pass, an
# agent launching one for a board row, a reboot restore. Each comes out tagged @dispatch on
# its server (the human reads [dispatch] as "an agent started this") with a ledger at
# live/<session> naming that server, which reap and fleet-sessions read. Before this, only
# `run` did either, and agents tagged their hand launches with set-option, which the human
# had to ask about twice.
#   --brief FILE --row KEY  claim the open row, cut a worktree off --cwd (default: the
#                           project's repo) with `wt new`, and run claude on the brief there.
#   --resume ID             a new session --session NAME in --cwd DIR running claude --resume.
#                           The sheet is not touched: the row was claimed before the reboot.
cmd_start() {
  local project='' prof='' lane=human key='' server="$DISPATCH_SERVER" model='' brief_file='' \
    resume='' cwd='' session='' area='' item='' it='' brief cmd label origin flag=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --agent) lane=agent; shift; continue ;;
      --project | --profile | --row | --server | --model | --brief | --resume | --cwd | --session | --area | --item) ;;
      *) say "start: unknown argument: $1"; return 2 ;;
    esac
    [ $# -ge 2 ] && [ -n "$2" ] || { say "start: $1 needs a value"; return 2; }
    case "$1" in
      --project) project=$2 ;;
      --profile) prof=$2 ;;
      --row) key=$2 ;;
      --server) server=$2 ;;
      --model) model=$2 ;;
      --brief) brief_file=$2 ;;
      --resume) resume=$2 ;;
      --cwd) cwd=$2 ;;
      --session) session=$2 ;;
      --area) area=$2 ;;
      --item) item=$2 ;;
    esac
    shift 2
  done
  if [ -n "$item" ]; then
    [ -z "$brief_file$resume$key$session" ] || { say "start: --item is a launch of its own: no --brief, --resume, --row or --session"; return 2; }
    it=$(agent-queue show "$item" --json 2>/dev/null) || { say "start: no queue item: $item"; return 2; }
    [ "$(jq -r .state <<<"$it")" = queued ] || { say "start: $item is $(jq -r .state <<<"$it"), not queued"; return 1; }
    project=$(jq -r .project <<<"$it")
    [ -n "$area" ] || area=$(jq -r '.area // empty' <<<"$it")
  fi
  [ -n "$project" ] || { say "start: --project is required"; return 2; }
  [ "$lane" = agent ] && flag=(--agent)

  if [ -n "$item" ]; then
    [ -n "$cwd" ] || cwd=$(repo_dir "$project")
    [ -n "$cwd" ] && [ -d "$cwd" ] || { say "start: no repo to cut a worktree from for $project (--cwd)"; return 2; }
    origin=${START_ORIGIN:-hand}
    model=${model:-opus}
    local acct mode; acct=$(account_dir); mode=$(jq -r .mode <<<"$it")
    cmd="AGENT_QUEUE_ITEM=$(printf '%q' "$item") ${acct:+CLAUDE_CONFIG_DIR=$(printf '%q' "$acct") }claude --model $(printf '%q' "$model")"
    case "$mode" in
      plan) cmd="$cmd --permission-mode plan $(printf '%q' "$(item_brief "$it")")" ;;
      *) cmd="$cmd --permission-mode bypassPermissions $(printf '%q' "$(item_brief "$it")")" ;;
    esac
    session=$(cd "$cwd" && WT_NEW_CMD="$cmd" wt new --server "$server" --detach -c "$cwd" | tail -1)
    [ -n "$session" ] || { say "wt new failed for queue item $item; it stays queued"; return 1; }
    agent-queue set "$item" "session=$session" "account=$(basename "${acct:-main}")" >/dev/null &&
      agent-queue move "$item" running >/dev/null || say "started $session, but could not mark queue item $item running"
  elif [ -n "$brief_file" ] && [ -z "$resume" ]; then
    [ -n "$key" ] || { say "start: --brief needs the --row it works"; return 2; }
    [ -z "$session" ] || { say "start: --brief cuts its own worktree session; --session is for --resume"; return 2; }
    [ -n "$cwd" ] || cwd=$(repo_dir "$project")
    [ -n "$cwd" ] && [ -d "$cwd" ] || { say "start: no repo to cut a worktree from for $project (--cwd)"; return 2; }
    brief=$(cat -- "$brief_file") && [ -n "$brief" ] || { say "start: empty or unreadable brief: $brief_file"; return 2; }
    origin=${START_ORIGIN:-hand}

    # Claim: the row must still be open right now, and `start` must leave THIS row started.
    row_is "$prof" "$project" "$lane" "$key" ' ' ||
      { say "skip $project: row no longer open: $key"; return 1; }
    np "$prof" ptask "$project" "${flag[@]}" start "$key" >/dev/null 2>&1
    row_is "$prof" "$project" "$lane" "$key" / ||
      { say "skip $project: could not start row: $key"; return 1; }

    model=${model:-opus}
    cmd="$(account_env)claude --model $(printf '%q' "$model") --permission-mode bypassPermissions $(printf '%q' "$brief")"
    session=$(cd "$cwd" && WT_NEW_CMD="$cmd" wt new --server "$server" --detach -c "$cwd" | tail -1)
    if [ -z "$session" ]; then
      np "$prof" ptask "$project" "${flag[@]}" start "$key" >/dev/null 2>&1
      say "wt new failed for $project; row un-started"
      return 1
    fi
  elif [ -n "$resume" ] && [ -z "$brief_file" ]; then
    [ -n "$session" ] && [ -n "$cwd" ] || { say "start: --resume needs --session and --cwd"; return 2; }
    [ -d "$cwd" ] || { say "start: not a directory: $cwd"; return 2; }
    # One agent per session: the ledger and the label belong to the whole session, so a
    # restore never lands in a session someone already has (a main checkout's, say).
    if session_live "$session" "$server"; then
      say "start: session $session already exists on $server; pass another --session"
      return 1
    fi
    origin=${START_ORIGIN:-resume}
    cmd="$(account_env)claude${model:+ --model $(printf '%q' "$model")} --permission-mode bypassPermissions --resume $(printf '%q' "$resume")"
    tmux -L "$server" new-session -d -s "$session" -c "$cwd" "$cmd" ||
      { say "could not create session $session on $server"; return 1; }
  else
    say "start: give exactly one of --brief or --resume"
    return 2
  fi

  label="$project: $(cut -c1-60 <<<"${key:-${item:-resumed}}")"
  # set-option takes a pane target, where a bare "=name" is "no such session"; the colon makes it session:window.
  tmux -L "$server" set-option -t "=$session:" @dispatch "$label" ||
    say "could not tag $session with @dispatch"
  mkdir -p "$LIVE"
  printf 'project=%s\nprofile=%s\nlane=%s\nkey=%s\nitem=%s\narea=%s\nmodel=%s\nlabel=%s\nserver=%s\norigin=%s\nstarted=%s\n' \
    "$project" "$prof" "$lane" "$key" "$item" "$area" "${model:-}" "$label" "$server" "$origin" "$(date -Iseconds)" > "$LIVE/$session"
  logline "started $session on $server ($origin) for $project $lane: ${key:-${item:+queue item $item}${resume:+resume $resume}}"
  echo "started $session: $label"
}

# --- queue items: agent-queue owns the record, this runner only starts and settles them ----

item_state() { agent-queue show "$1" --json 2>/dev/null | jq -r '.state // empty'; }

# item_brief <item json> -> the prompt a queue item's session starts on: plan mode gets the
# task as typed, oneshot runs it through /one-shot (--pr-only for a `night` item).
item_brief() {
  local it="$1" slug mode tags pr_only='' row
  slug=$(jq -r .slug <<<"$it"); mode=$(jq -r .mode <<<"$it"); tags=" $(jq -r '.tags // ""' <<<"$it") "
  [[ "$tags" == *" night "* ]] && pr_only=' --pr-only'
  [ "$mode" = plan ] || printf '/one-shot%s ' "$pr_only"
  jq -r .task <<<"$it"
  echo
  row=$(item_row "$it")
  if [ -z "$row" ]; then
    echo "This is agent-queue item $slug, and that item is its only record: touch no board or sheet row for it."
    echo "When the PR merges: agent-queue set $slug pr=<N>; agent-queue move $slug done --status ok"
  elif [ -n "$pr_only" ]; then
    echo "This is agent-queue item $slug, promoted from a board row that is already started. Open the PR and do not merge: the human's merge closes the row."
    echo "When the PR is open: agent-queue set $slug pr=<N>; agent-queue move $slug done --status ok"
  else
    local prof project lane key on=''
    IFS=$'\t' read -r prof project lane key <<<"$row"
    [ "$lane" = agent ] && on=' --agent'
    echo "This is agent-queue item $slug, promoted from the $project $lane board row \"$key\"."
    echo "When the PR merges: agent-queue set $slug pr=<N>; agent-queue move $slug done --status ok; and close the row: notes${prof:+ --profile $prof} ptask $project$on done \"$key\" --proof pr:<N>"
  fi
  echo "If it needs a decision from the human, ask it here and file it with agent-ask post (your recommendation in --recommend), run agent-queue move $slug waiting, then stop and leave this window open."
}

# item_row <item json> -> "<profile>\t<project>\t<lane>\t<key>" of a `from: board:` item, else nothing.
item_row() {
  jq -r 'select(.from | startswith("board:")) | (.from | ltrimstr("board:")) as $r
    | [(.profile // ""), ($r | split(":")[0]), (.lane // "agent"), ($r | split(":")[1:] | join(":"))] | @tsv' <<<"$1"
}

# settle_row <slug> -- a board item that ended failed or cancelled hands its row back: un-start it
# and record `failed`, as reap does for a ledger row, so it is not promoted again until its text
# changes. Idempotent: a row no longer started is left alone (done by its session, or settled).
settle_row() {
  local it row prof project lane key flag=()
  it=$(agent-queue show "$1" --json 2>/dev/null) || return 0
  [ "$(jq -r '.state + "/" + (.status // "")' <<<"$it")" = done/ok ] && return 0
  [ "$(jq -r .state <<<"$it")" = "done" ] || return 0
  row=$(item_row "$it"); [ -n "$row" ] || return 0
  IFS=$'\t' read -r prof project lane key <<<"$row"
  [ "$lane" = agent ] && flag=(--agent)
  row_is "$prof" "$project" "$lane" "$key" / || return 0
  np "$prof" ptask "$project" "${flag[@]}" start "$key" >/dev/null 2>&1
  jq -cn --arg p "$project" --arg l "$lane" --arg k "$key" --arg at "$(date -Iseconds)" --arg st "$(jq -r .status <<<"$it")" \
    '{project: $p, lane: $l, key: $k, verdict: "failed", reason: "queue item ended \($st)", at: $at}' >> "$VERDICTS"
  logline "settled queue item $1: $project $lane row un-started: $key"
  echo "un-started $project: $key (queue item $1 ended $(jq -r .status <<<"$it"))"
}

# settle_item <slug> <session> -- its session is gone. Closed by the session: nothing to do.
# Still open: done, ok when it names a PR, else failed with the reason in note.
settle_item() {
  local st pr; st=$(item_state "$1")
  case "$st" in running | waiting | queued) ;; *) logline "reaped $2: queue item $1 ${st:-gone}"; return 0 ;; esac
  pr=$(agent-queue show "$1" --json 2>/dev/null | jq -r '.pr // empty')
  if [ -n "$pr" ]; then
    agent-queue move "$1" "done" --status ok >/dev/null
    logline "reaped $2: session gone, queue item $1 done with PR $pr"
  else
    agent-queue set "$1" "note=session $2 ended before it closed the item" >/dev/null
    agent-queue move "$1" "done" --status failed >/dev/null
    logline "reaped $2: session gone, queue item $1 failed: no PR"
    echo "failed queue item $1 ($2 ended without closing it)"
  fi
}

# run_item <item json> -- start the queue head. The human's and the shepherd's items need every
# gate but presence: they asked for it, and may be at the desk. A board-filled item waits for away.
run_item() {
  local it="$1" slug scope=any why
  slug=$(jq -r .slug <<<"$it")
  case "$(jq -r .from <<<"$it")" in board:*) scope=away ;; esac
  why=$(gate "$scope")
  if [ -n "$why" ]; then settle NOOP "$why, queue item $slug waits"; [ "$DRY" = 1 ] || return 0; fi
  start_item "$it"
}

# next_item -> the queue head a pass should try: a board item waits for the human to be away
# (run_item's gate), so while they are not, the first human or shepherd item behind it goes first.
next_item() {
  local q
  q=$(agent-queue list --json --state queued 2>/dev/null | jq -sc '[.[] | select(.hold == null)]' 2>/dev/null)
  case "$(fleet-presence 2>/dev/null)" in
    away*) ;;
    *) q=$(jq -c '[.[] | select(.from | startswith("board:") | not)]' <<<"$q" 2>/dev/null) ;;
  esac
  jq -c '.[0] // empty' <<<"${q:-[]}" 2>/dev/null
  return 0
}

# start_item <item json> -- past the gates: start it, and publish what happened.
start_item() {
  local it="$1" slug acct model
  slug=$(jq -r .slug <<<"$it")
  if [ "$DRY" = 1 ]; then say "would start queue item $slug: $(jq -r '"\(.project) \(.mode) \(.priority)"' <<<"$it")"; return 0; fi
  # Asked again here, as launch does: the gate's answer may be minutes old.
  acct=$(claude-acct room 2>/dev/null) || { settle NOOP "no account has room for queue item $slug"; return 0; }
  model=$(model-lane classify "$(jq -r .task <<<"$it")" 2>/dev/null | jq -r '.dispatch_model // empty' 2>/dev/null)
  if START_ORIGIN=run RUN_ACCOUNT=$acct cmd_start --item "$slug" --server "$DISPATCH_SERVER" --model "${model:-opus}"; then
    settle WORKED "started queue item $slug"
  else
    settle FAILED "could not start queue item $slug"; return 1
  fi
}

# --- verbs ---------------------------------------------------------------------------

# reap -- a ledger entry whose row is no longer started, or whose session is gone: done row ->
# drop it; row still started with the session gone -> un-start it and record `failed`, so it
# is not picked again until its text changes. A live session whose row is done is dropped too:
# the human may reuse its tmux session after the dispatched Claude ends, and that must not
# hold a dispatch slot.
cmd_reap() {
  local f s project prof lane key item flag d
  # A board item cancelled or failed with no session of its own (cancelled while queued, say).
  for d in "$(date +%F)" "$(date -d yesterday +%F 2>/dev/null)"; do
    [ -n "$d" ] || continue
    agent-queue list --json --state "done" --date "$d" 2>/dev/null |
      jq -r 'select((.from | startswith("board:")) and .status != "ok") | .slug' 2>/dev/null |
      while IFS= read -r s; do settle_row "$s"; done
  done
  for f in "$LIVE"/*; do
    [ -f "$f" ] || continue
    s="${f##*/}"
    project=$(ledger_field "$f" project); prof=$(ledger_field "$f" profile)
    lane=$(ledger_field "$f" lane); key=$(ledger_field "$f" key); item=$(ledger_field "$f" item)
    if [ -n "$item" ]; then
      if ledger_live "$f"; then
        [ "$(item_state "$item")" = "done" ] || continue
        logline "reaped $s: queue item $item closed (session still up)"
      else
        settle_item "$item" "$s"
        settle_row "$item"
      fi
      rm -f -- "$f"
      continue
    fi
    if ledger_live "$f"; then
      # A restore with no row has nothing to settle while its session runs.
      [ -z "$key" ] && continue
      row_is "$prof" "$project" "$lane" "$key" / && continue
      logline "reaped $s: $project $lane row no longer open (session still up): $key"
      rm -f -- "$f"
      continue
    fi
    flag=(); [ "$lane" = agent ] && flag=(--agent)
    if [ -n "$key" ] && row_is "$prof" "$project" "$lane" "$key" /; then
      np "$prof" ptask "$project" "${flag[@]}" start "$key" >/dev/null 2>&1
      jq -cn --arg p "$project" --arg l "$lane" --arg k "$key" --arg at "$(date -Iseconds)" \
        '{project: $p, lane: $l, key: $k, verdict: "failed", reason: "session ended without the row done", at: $at}' >> "$VERDICTS"
      logline "reaped $s: session gone, row un-started: $project $lane: $key"
      echo "un-started $project: $key ($s ended without it done)"
    else
      logline "reaped $s: session gone${key:+, $project $lane row no longer open: $key}"
    fi
    rm -f -- "$f"
  done
}

# real_idle -> percent of the machine idle over a two-frame top sample; the first frame is since boot.
real_idle() { LC_ALL=C top -bn2 -d2 2>/dev/null | sed -n 's/^%Cpu.* \([0-9.]*\) id,.*/\1/p' | tail -n 1; }

# firing_findings -> the shared faults firing now, one per line. Open is not firing: a finding stays
# open for an hour after its last sample, which would hold starts long after the fault cleared.
firing_findings() {
  jq -r --argjson now "$(date +%s)" --argjson fresh "$DISPATCH_FINDING_FRESH_MIN" '
    select(.rule == "starved" or .rule == "throughput-drop" or .rule == "blind")
    | select((.epoch // $now) >= $now - $fresh * 60) | "\(.rule) \(.scope)"'
}

# gate -> why this pass must not start anything, or nothing when it may. Anything it cannot read
# refuses: a start nobody can justify costs more than waiting for the next pass.
# A nightly red is deliberately not here: nightlies stay red while sessions merge normally, so it
# would stop everything, and the shepherd's NIGHTLY row handles it.
gate() {
  local load cores infra presence findings github idle
  agent-hold check dispatch >/dev/null 2>&1 || { echo "held (agent-hold dispatch)"; return; }
  if [ "${1:-away}" = away ]; then
    presence=$(fleet-presence 2>/dev/null)
    case "$presence" in
      away*) ;;
      *) echo "the human is not away (${presence:-fleet-presence unreadable})"; return ;;
    esac
  fi
  claude-acct room >/dev/null 2>&1
  case $? in
    0) ;;
    1) echo "no account has room under its weekly pace"; return ;;
    *) echo "account usage unreadable"; return ;;
  esac
  fleet-assess --watch-probe >/dev/null 2>&1 || { echo "fleet-assess says HOLD"; return; }
  # Cluster only, not every urgent trip: a red nightly is urgent, and new sessions do not worsen it.
  infra="$(fleet-shepherd infra 2>/dev/null)" && { echo "$infra"; return; }
  load=$(cut -d' ' -f1 "$DISPATCH_LOADAVG" 2>/dev/null)
  cores=$(nproc 2>/dev/null || echo 1)
  awk -v l="${load:-0}" -v c="$cores" -v m="$DISPATCH_MAX_LOAD" 'BEGIN { exit !(l / c > m) }' &&
    { echo "load ${load} on ${cores} cores is over the ${DISPATCH_MAX_LOAD} pace"; return; }
  findings=$(fleet-bench findings --json 2>/dev/null) || { echo "fleet-bench findings unreadable"; return; }
  findings=$(firing_findings <<<"$findings") || { echo "fleet-bench findings unreadable"; return; }
  [ -z "$findings" ] || { echo "finding firing: $(paste -sd, <<<"$findings")"; return; }
  github=$(fleet-assess --github 2>/dev/null)
  case "$github" in
    '' | *unreadable*) echo "github budget unreadable"; return ;;
    *LOW*) echo "$github"; return ;;
  esac
  idle=$(real_idle)
  [ -n "$idle" ] || { echo "real idle unreadable"; return; }
  awk -v i="$idle" -v m="$DISPATCH_MIN_IDLE" 'BEGIN { exit !(i < m) }' &&
    echo "real idle ${idle}% is under ${DISPATCH_MIN_IDLE}%"
}

# settle <outcome> <why>: say what this pass did and publish it for fleet-liveness. agentctl turns
# a run that publishes nothing into STALLED. A dry run is not a run.
settle() {
  say "$2"
  [ "$DRY" = 0 ] || return 0
  # shellcheck source=/dev/null
  . "$HOME/.local/lib/agent-proof.sh" 2>/dev/null || return 0
  proof_report fleet-dispatch "$1" "$2" 2>/dev/null || true
}

cmd_run() {
  local why live room
  DRY=0
  [ "${1:-}" = --dry-run ] && DRY=1
  mkdir -p "$DIR"
  exec 9>"$DIR/.lock"
  flock -n 9 || { settle NOOP "another pass is running"; return 0; }

  [ "$DRY" = 1 ] || cmd_reap
  live=$(live_runs | grep -c . || true)
  room=$(( DISPATCH_MAX_LIVE - live ))
  [ "$room" -gt "$DISPATCH_PER_PASS" ] && room=$DISPATCH_PER_PASS
  if [ "$room" -le 0 ]; then settle NOOP "at $live live dispatched sessions, starting nothing"; return 0; fi
  # The queue comes first; board rows are only looked at while nothing in it is runnable.
  local item; item=$(next_item)
  if [ -n "$item" ]; then run_item "$item"; return; fi
  why=$(gate)
  if [ -n "$why" ]; then
    settle NOOP "$why, starting nothing"
    [ "$DRY" = 1 ] || return 0
  fi

  fill_now "$room" || { settle FAILED "could not judge the new rows"; return 1; }
  if [ "$DRY" = 1 ]; then [ "$FILLED" -gt 0 ] || settle NOOP "no row qualifies this pass"; return 0; fi
  # Past the gates already: what fill promoted starts now, through the same start as any item.
  item=$(next_item)
  [ -n "$item" ] || { settle NOOP "no row qualifies this pass"; return 0; }
  start_item "$item"
}

# fill_now <room> -- judge the new rows, then promote the picks into the queue as low, `from:
# board:`: up to <room> rows a merging session may take, and tier-3 rows (night_picks) tagged
# `night`, which run to an open PR only, up to DISPATCH_NIGHT_MAX active at once.
fill_now() {
  local room="$1" picked night active c
  FILLED=0
  judge "$( { cmd_candidates; night_rows "$(judged_keys)"; } | jq -sc 'unique_by([.project, .lane, .key])[]')" || return 1
  # Every open row again, judged ones included: a row judged on an earlier pass can be picked now.
  picked=$(picks "$(all_open)" "$room")
  active=$(agent-queue list --json --state active 2>/dev/null |
    jq -s '[.[] | select((.from | startswith("board:")) and ((" " + (.tags // "") + " ") | contains(" night ")))] | length' 2>/dev/null)
  active=$(( DISPATCH_NIGHT_MAX - ${active:-0} )); [ "$active" -gt 0 ] || active=0
  night=$(night_picks "$(night_rows '')" | head -n "$active")
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    FILLED=$(( FILLED + 1 ))
    if [ "$DRY" = 1 ]; then echo "would queue: $(jq -r '"\(.project) (\(.stage)) \(.lane), \(.worker), \(.area): \(.key)"' <<<"$c")"
    else promote "$c" "" "$(jq -r .text <<<"$c" | sed 's/^- \[.\] //')"; fi
  done <<<"$picked"
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    FILLED=$(( FILLED + 1 ))
    if [ "$DRY" = 1 ]; then echo "would queue for the night: $(jq -r '"\(.project) \(.area): \(.key)"' <<<"$c")"
    else promote "$c" night "$(night_brief "$c")"; fi
  done <<<"$night"
  return 0
}

# promote <row> <tags> <task> -- claim the open row on its board, then add it to the queue; a row
# that cannot be added is un-started again, as start does for a session that never opened.
promote() {
  local c="$1" tags="$2" task="$3" prof project lane key area out slug flag=()
  prof=$(jq -r .profile <<<"$c"); project=$(jq -r .project <<<"$c"); lane=$(jq -r .lane <<<"$c")
  key=$(jq -r .key <<<"$c"); area=$(jq -r '.area // empty' <<<"$c")
  [ "$lane" = agent ] && flag=(--agent)
  row_is "$prof" "$project" "$lane" "$key" ' ' || { say "skip $project: row no longer open: $key"; return 1; }
  np "$prof" ptask "$project" "${flag[@]}" start "$key" >/dev/null 2>&1
  row_is "$prof" "$project" "$lane" "$key" / || { say "skip $project: could not start row: $key"; return 1; }
  if ! out=$(agent-queue add --project "$project" --priority low --from "board:$project:$key" --slug "$key" \
      ${tags:+--tags "$tags"} -- "$task" 2>&1); then
    np "$prof" ptask "$project" "${flag[@]}" start "$key" >/dev/null 2>&1
    say "could not queue $project row, un-started: $key ($out)"
    return 1
  fi
  slug=$(awk '{ print $2; exit }' <<<"$out")
  agent-queue set "$slug" "lane=$lane" ${prof:+"profile=$prof"} ${area:+"area=$area"} >/dev/null
  logline "filled queue item $slug from $project $lane row${tags:+ ($tags)}: $key"
  echo "queued $project: $key"
}

# all_open -- candidates without the judged filter: every open, eligible row
all_open() { VERDICTS=/dev/null cmd_candidates; }

# cmd_fill [--dry-run] [--json] -- by hand: promote up to DISPATCH_PER_PASS picks into the queue, no
# gate. --dry-run is the order a pass would promote rows in, with no judge call and no write:
# `ready` rows are picks over every open row (cached verdicts only, a live area skipped), then
# `unjudged` rows, which no current verdict covers and the next pass judges first.
cmd_fill() {
  local open ready unj dry=0 json=''
  while [ $# -gt 0 ]; do
    case "$1" in --dry-run) dry=1 ;; --json) json=1 ;; *) say "fill: unknown argument: $1"; return 2 ;; esac
    shift
  done
  if [ "$dry" = 0 ]; then
    DRY=0; mkdir -p "$DIR"; exec 9>"$DIR/.lock"
    flock -n 9 || { say "fill: another pass is running"; return 0; }
    fill_now "$DISPATCH_PER_PASS"; return
  fi
  open=$(all_open)
  ready=$(picks "$open" 999)
  unj=$(cmd_candidates)
  if [ -n "$json" ]; then
    { [ -z "$ready" ] || jq -c '. + {state: "ready"}' <<<"$ready"
      [ -z "$unj" ] || jq -c '. + {state: "unjudged"}' <<<"$unj"; }
    return 0
  fi
  [ -n "$ready$unj" ] || { echo "queue: no open row to start"; return 0; }
  [ -z "$ready" ] || jq -r '"ready     \(.project) (\(.stage)) \(.lane), \(.worker), \(.area): \(.key)"' <<<"$ready"
  [ -z "$unj" ] || jq -r '"unjudged  \(.project) (\(.stage)) \(.lane): \(.key)"' <<<"$unj"
}

# --- night: tier 3 to an open PR -------------------------------------------------------

# night_rows <judged> -> the open agent-lane rows of the night projects that no merging session may
# take because of tier alone: no tier tag below 3 and none of DISPATCH_NIGHT_SKIP. `order` is the
# row's place on its board, newest first; `rank` puts subtract-or-fix rows, then observer rows, first.
night_rows() {
  local judged="$1" name sheet stage repo key text body t line n
  for name in $DISPATCH_NIGHT_PROJECTS; do
    sheet=$(np "$DISPATCH_NIGHT_PROFILE" projects 2>/dev/null | awk -F'\t' -v p="$name" '$1 == p { print $2; exit }')
    stage=$(stage_of "$sheet")
    case "$stage" in alpha | beta | prod) ;; *) continue ;; esac
    wave-lock check "$name" >/dev/null 2>&1 && continue
    repo=$(repo_dir "$name")
    [ -n "$repo" ] && [ -d "$repo" ] || continue
    n=0
    while IFS=$'\t' read -r key text; do
      [ -n "$key" ] || continue
      n=$(( n + 1 ))
      case "$text" in '- [ ]'*) ;; *) continue ;; esac
      t=$(row_tier "$text")
      [ -z "$t" ] || [ "$t" = 3 ] || continue
      body=${text#- \[ \] }
      grep -qiE -- "$DISPATCH_NIGHT_SKIP" <<<"${body%%<!--*}" && continue
      line=$(printf '%s' "$text" | sig)
      grep -qxF "$name"$'\t'agent$'\t'"$key"$'\t'"$line" <<<"$judged" && continue
      grep -qxF "$name"$'\t'agent$'\t'"$key"$'\t*' <<<"$judged" && continue
      jq -cn --arg project "$name" --arg stage "$stage" --arg key "$key" --arg text "$text" \
        --arg body "$body" --arg repo "$repo" --arg line "$line" --argjson prio "$(prio_rank "$text")" \
        --argjson order "$n" --arg first "$DISPATCH_NIGHT_FIRST" --arg obs "$DISPATCH_NIGHT_OBSERVER" \
        --arg profile "$DISPATCH_NIGHT_PROFILE" \
        '{profile: $profile, project: $project, stage: $stage, lane: "agent", key: $key,
          text: $text, repo: $repo, prio: $prio, tier: 3, line: $line, order: $order, wrank: 0,
          rank: (if ($body | test($first; "i")) then 0 elif ($body | test($obs; "i")) then 1 else 2 end)}'
    done < <(rows "$DISPATCH_NIGHT_PROFILE" "$name" agent)
  done
}

# night_picks <rows> -> up to DISPATCH_NIGHT_MAX rows whose verdict, under the current policy and for
# the row's current text, says tier 3 is the only reason a merging session may not take it, and
# that it is S or M, clear, agent-only and in one area. One row an area, so a night's PRs do not
# collide. Subtract or fix first, then observer rows, then most urgent, then oldest.
night_picks() {
  [ -n "$1" ] || return 0
  jq -sc --arg sig "$(policy_sig)" --argjson max "$DISPATCH_NIGHT_MAX" --slurpfile v <(latest_verdicts) '
    ($v | map({key: ([.project, .lane, .key] | tostring), value: .}) | from_entries) as $by
    | map(. as $c | $by[[.project, .lane, .key] | tostring] as $d
      | select($d != null and $d.tier3_only == true and $d.tier == 3
          and ($d.size == "S" or $d.size == "M") and $d.clear == true and $d.agent_only == true
          and $d.policy == $sig and $d.line == $c.line
          and ($d.area | type) == "string" and $d.area != "")
      | . + {area: ($d.area | ascii_downcase)})
    | sort_by(.rank, .prio, -.order) | unique_by([.project, .area]) | sort_by(.rank, .prio, -.order)
    | .[:$max] | .[]' <<<"$1"
}

# night_brief <row> -- the task night-shift runs with nobody to ask (it adds /one-shot --pr-only)
night_brief() {
  local project key text repo where
  project=$(jq -r .project <<<"$1"); key=$(jq -r .key <<<"$1"); repo=$(jq -r .repo <<<"$1")
  text=$(jq -r .text <<<"$1" | sed 's/^- \[.\] //')
  where=$(grep -oE '[A-Za-z0-9_./-]*[A-Za-z][A-Za-z0-9_./-]*:[0-9]+(-[0-9]+)?' <<<"${text%%<!--*}" | paste -sd, - | sed 's/,/, /g')
  cat <<EOF
$text

Queued by fleet-dispatch night from the $project agent board, row "$key". It is tier 3 (harness or tooling), which runs unattended to an open PR only.
- Repo: $repo. Its private overlay ~/.dotfiles-private holds the rules, agentctl confs and private bins; dotfiles-land says which repo a file belongs in, and a change that touches both is two PRs.
- Where: ${where:-the row names no file:line. Find the code it means first; if you cannot name one, stop blocked.}
- Merge gate: $DISPATCH_NIGHT_GATE.
- Open the PR, do not merge. The human merges in the morning.
- Done means: the change the row describes is in an open PR with its gate green, and the PR body names the row ($project agent board: "$key"). The row is already started on the board: add no new row and do not mark it done; the human's merge closes it.
- If the row turns out to need a decision, the human, or a repo other than these two, stop blocked with agent-ask post.
EOF
}

# night_queue <row> <account dir> -- claim the row, then queue it; a row that cannot be queued is
# un-started again, as start does for a session that never opened.
night_queue() {
  local c="$1" acct="$2" prof project key repo
  prof=$(jq -r .profile <<<"$c"); project=$(jq -r .project <<<"$c"); key=$(jq -r .key <<<"$c")
  repo=$(jq -r .repo <<<"$c")
  row_is "$prof" "$project" agent "$key" ' ' || { say "night: row no longer open: $key"; return 1; }
  np "$prof" ptask "$project" --agent start "$key" >/dev/null 2>&1
  row_is "$prof" "$project" agent "$key" / || { say "night: could not start row: $key"; return 1; }
  if ! night-shift queue "$repo" "$(night_brief "$c")" --slug "$key" --project "$project" \
      --max-turns "$DISPATCH_NIGHT_TURNS" ${acct:+--account "$acct"} >/dev/null; then
    np "$prof" ptask "$project" --agent start "$key" >/dev/null 2>&1
    say "night: night-shift queue failed for $key; row un-started"
    return 1
  fi
  logline "night: queued $project agent row for night-shift: $key"
  echo "queued $project: $key"
}

# night [--dry-run] -- the night-shift runner's first step. Behind the same gates as a run pass
# (hold, away, account pace, load, findings, GitHub budget, idle), judge the night projects' new
# rows and queue the picks into night-shift, which stops each at an open PR. It never starts a
# session and never merges. It publishes nothing: the runner it runs under publishes the night.
cmd_night() {
  local why picked c n=0 acct
  DRY=0
  [ "${1:-}" = --dry-run ] && DRY=1
  mkdir -p "$DIR"
  exec 9>"$DIR/.lock"
  flock -n 9 || { say "night: another pass is running, queueing nothing"; return 0; }
  why=$(gate)
  if [ -n "$why" ]; then
    say "night: $why, queueing nothing"
    [ "$DRY" = 1 ] || return 0
  fi
  judge "$(night_rows "$(judged_keys)")" || { say "night: could not judge the new rows, queueing nothing"; return 1; }
  picked=$(night_picks "$(night_rows '')")
  [ -n "$picked" ] || { say "night: no tier-3 row qualifies tonight"; return 0; }
  if [ "$DRY" = 1 ]; then
    jq -r '"would queue: \(.project) \(.area): \(.key)"' <<<"$picked"
    return 0
  fi
  # The account the tasks run on, asked here as launch does: the gate's answer may be minutes old.
  acct=$(claude-acct room 2>/dev/null) || { say "night: no account has room, queueing nothing"; return 0; }
  while IFS= read -r c; do
    night_queue "$c" "$acct" && n=$(( n + 1 ))
  done <<<"$picked"
  say "night: queued $n of $(grep -c . <<<"$picked")"
}

cmd_report() {
  latest_verdicts | jq -r --arg sig "$(policy_sig)" '[.verdict, .size // "-", (.tier // "-" | tostring),
      .project, .lane, .area // "-", .key, (.reason // "") + (if .verdict != "failed" and .policy != $sig then " (stale: policy changed)" else "" end)] | @tsv' |
    sort | awk -F'\t' '{ printf "%-9s %-2s t%-2s %-16s %-6s %-12s %s\n           %s\n", $1, $2, $3, $4, $5, $6, substr($7, 1, 90), $8 }'
}

main() {
  case "${1:-}" in
    run) shift; cmd_run "$@" ;;
    candidates) cmd_candidates ;;
    fill) shift; cmd_fill "$@" ;;
    report) cmd_report ;;
    reap) cmd_reap ;;
    night) shift; cmd_night "$@" ;;
    start) shift; cmd_start "$@" ;;
    -h | --help) sed -n '2,28p' "$0" ;;
    *) sed -n '2,12p' "$0" >&2; return 2 ;;
  esac
}

# Sourceable for tests; runs main only when executed.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
