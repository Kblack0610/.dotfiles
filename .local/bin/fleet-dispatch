#!/usr/bin/env bash
# fleet-dispatch - start one session per easy board row, for the shepherd to see through.
#
#   fleet-dispatch run [--dry-run]   one pass: gates, candidates, judge new rows, launch picks
#   fleet-dispatch candidates        open rows eligible to judge, one JSON object per line
#   fleet-dispatch report            latest verdict per row: picked or skipped, and why
#   fleet-dispatch reap              settle ledger entries whose session is gone
#   fleet-dispatch start --project P [--profile X] [--agent] [--server S] [--model M]
#       (--brief FILE --row KEY [--cwd REPO] | --resume ID --session NAME --cwd DIR [--row KEY])
#                                    start ONE session the way every agent must: see cmd_start
#
# A pass walks the workers in workers.json in file order, and a row goes to the first that may
# take it: `#worker/<name>` plus a `#tier/N` within its max_tier (tier meanings: policy.md), and
# inside its `projects`, `lane` and `only_tag` when it names them. A worker marked `untagged`
# takes rows with no `#worker` tag instead, and with no `#tier` tag the judge's reading decides.
# The human assigns `fleet` rows; agents may assign `asks` rows, which must carry `#ask`.
# A pass starts nothing unless the human is away (fleet-presence): see gate.
# Facts are code; the judgment (is this row clear, agent-only, in one area and really that tier?)
# is one model call per pass against policy.md, cached per row in verdicts.jsonl until the
# row's text, the policy or workers.json changes. A picked row is started on its sheet and
# gets a detached `wt new` session on the lab server running /one-shot, tagged @dispatch,
# with a ledger entry at live/<session> that fleet-sessions reads. Pause with `agent-hold set dispatch`.
# `start` is that same launch for a session an agent starts by hand or restores after a reboot.
# Tuning is the DISPATCH_* block, set in the agentctl conf.

set -uo pipefail

: "${DISPATCH_PROFILES:=bnb}"
: "${DISPATCH_PER_PASS:=1}"   # one new session a pass: each is easy to evaluate before the next
: "${DISPATCH_MAX_LIVE:=6}"
: "${DISPATCH_MAX_LOAD:=0.7}"   # 1-min load per core; the fleet-overseer pace target
: "${DISPATCH_MIN_IDLE:=30}"    # percent of the machine really idle: niced Unity runs fill it while load looks fine
: "${DISPATCH_FINDING_FRESH_MIN:=20}"   # two fleet-bench samples: a finding stays open 60 min after it stops firing
: "${DISPATCH_JUDGE_MAX:=40}"   # rows judged per pass; the rest wait for the next pass
: "${DISPATCH_JUDGE_CMD:=agentctl-run --role observe}"
: "${DISPATCH_SERVER:=lab}"
: "${DISPATCH_POLICY:=$HOME/.config/fleet-dispatch/policy.md}"
: "${DISPATCH_WORKERS:=$HOME/.config/fleet-dispatch/workers.json}"
: "${DISPATCH_PROJECT_MAP:=$HOME/.config/shared-hooks/project-map.json}"
: "${DISPATCH_LOADAVG:=/proc/loadavg}"
DIR="${FLEET_DISPATCH_DIR:-$HOME/.agent/dispatch}"
LIVE="$DIR/live"
VERDICTS="$DIR/verdicts.jsonl"
LOG="$DIR/log.md"

# Tier 3 (CI, gates, runners, build and deploy, harness, tooling) never runs unattended,
# whatever workers.json says: the human's decision of 2026-10-27, after a dispatched session
# spent 50 minutes on a `ci:` row. Raising this is a conversation, not a config edit.
UNATTENDED_TIER_CEILING=2

say() { printf 'fleet-dispatch: %s\n' "$*" >&2; }
logline() { mkdir -p "$DIR"; printf -- '- %s %s\n' "$(date '+%Y-%m-%d %H:%M')" "$*" >> "$LOG"; }

# --- facts ---------------------------------------------------------------------------

# stage_of <sheet> -> draft|alpha|beta|prod, from the tag on its Version: line
stage_of() { sed -n 's/^Version:.*#\(draft\|alpha\|beta\|prod\)\b.*/\1/p' "$1" 2>/dev/null | head -1; }

stage_rank() { case "$1" in prod) echo 0 ;; beta) echo 1 ;; *) echo 2 ;; esac; }

prio_rank() {
  case "$1" in
    *'#urgent'*) echo 0 ;;
    *'#high'*) echo 1 ;;
    *'#low'*) echo 3 ;;
    *) echo 2 ;;
  esac
}

# repo_dir <project> -> the checkout its code lives in; nothing for a notes-only project.
# The registry names the repo (`repo`, null = notes-only, absent = the project's own name),
# and `paths` maps a checkout to its repo name.
repo_dir() {
  local repo
  repo=$(jq -r --arg p "$1" '.trackers[$p] as $t
    | if $t == null or ($t | has("repo") | not) then $p else ($t.repo // "") end' \
    "$DISPATCH_PROJECT_MAP" 2>/dev/null)
  [ -n "$repo" ] || return 0
  jq -r --arg r "$repo" '.paths | to_entries[] | select(.value == $r) | .key' \
    "$DISPATCH_PROJECT_MAP" 2>/dev/null | head -1
}

# tag_value <text> <namespace> -> the value of the row's first `#<namespace>/<value>` tag.
# Only the text before a `<!--` marker counts: a tag inside a proof stamp is record, not routing.
tag_value() {
  local body="${1%%<!--*}"
  grep -oE "(^|[[:space:]])#$2/[A-Za-z0-9_.-]+" <<<"$body" | head -1 | sed "s|.*#$2/||"
}

# row_tier <text> -> 1|2|3, or nothing when the row carries no tier. A `ci:` or `infra:`
# row is tier 3 however it is tagged.
row_tier() {
  local body
  body=$(sed 's/^- \[.\] //' <<<"$1" | tr '[:upper:]' '[:lower:]')
  case "$body" in ci:* | infra:*) echo 3; return ;; esac
  tag_value "$1" tier | grep -xE '[123]'
}

# workers -> one line per worker in registry order: rank, name, max tier capped at the ceiling,
# projects, only_tag, lane, untagged. "-" stands for empty, because read collapses empty tab fields.
workers() {
  jq -r --argjson c "$UNATTENDED_TIER_CEILING" 'to_entries | to_entries[] | .key as $rank | .value
    | [$rank, .key, ([.value.max_tier // 0, $c] | min | floor),
       ((.value.projects // []) | join(",") | if . == "" then "-" else . end),
       (.value.only_tag // "-"), (.value.lane // "-"), (.value.untagged // false)] | @tsv' \
    "$DISPATCH_WORKERS" 2>/dev/null
}

# row_worker <workers> <project> <lane> <row text> -> "<rank> <worker> <tier>" for the first worker
# that may take the row, nothing when none may. A row with no tier tag counts as the highest tier
# an untagged worker takes, and the judge must read it no higher.
row_worker() {
  local project="$2" lane="$3" text="$4" tag row_t t rank name max projects only wlane untagged
  tag=$(tag_value "$text" worker)
  row_t=$(row_tier "$text")
  while IFS=$'\t' read -r rank name max projects only wlane untagged; do
    if [ "$untagged" = true ]; then [ -z "$tag" ] || continue; else [ "$tag" = "$name" ] || continue; fi
    [ "$projects" = - ] || [[ ",$projects," == *",$project,"* ]] || continue
    [ "$only" = - ] || [[ " $text " == *" #$only "* ]] || continue
    [ "$wlane" = - ] || [ "$wlane" = "$lane" ] || continue
    t=$row_t
    [ -n "$t" ] || [ "$untagged" != true ] || t=$max
    [ -n "$t" ] && [ "$t" -le "$max" ] || continue
    echo "$rank $name $t"
    return 0
  done <<<"$1"
  return 1
}

sig() { sha256sum | cut -c1-12; }

# policy_sig -> changes whenever the policy or the worker registry does, so both re-judge.
policy_sig() { cat "$DISPATCH_POLICY" "$DISPATCH_WORKERS" 2>/dev/null | sig; }

# np <profile> <args...> -> notes, under that profile, or notes' own default when it is empty
# (a hand `start` may leave the profile to the CLI).
np() {
  local p="$1"
  shift
  if [ -n "$p" ]; then notes --profile "$p" "$@"; else notes "$@"; fi
}

# ledger_field <file> <name> -> that line's value
ledger_field() { sed -n "s/^$2=//p" "$1" | head -1; }

# session_live <session> [server] -- a ledger older than the server= line was always on DISPATCH_SERVER.
session_live() { tmux -L "${2:-$DISPATCH_SERVER}" has-session -t "=$1" 2>/dev/null; }

# The env prefix that starts claude on the account with the most room left (claude-acct pick,
# the same choice `cl` makes); empty for the main account or when claude-acct is missing. A run
# pass has already chosen with `claude-acct room`, and passes that account in RUN_ACCOUNT.
# Accounts share ~/.claude/projects, so a resumed session works from either one.
account_env() {
  local dir
  if [ "${RUN_ACCOUNT+set}" = set ]; then dir=$RUN_ACCOUNT
  else dir=$(claude-acct pick) || dir=""; fi
  [ -n "$dir" ] && printf 'CLAUDE_CONFIG_DIR=%q ' "$dir"
  return 0
}

# ledger_live <ledger file> -- is its session up, on the server the ledger names?
ledger_live() { session_live "${1##*/}" "$(ledger_field "$1" server)"; }

# live_runs -> "<project>/<area>" for every running session this runner started itself. A hand
# launch or a restore is tagged and tracked like any other, but holds none of the runner's
# slots: a dozen restored sessions must not stop dispatch for the day.
live_runs() {
  local f
  for f in "$LIVE"/*; do
    [ -f "$f" ] || continue
    case "$(ledger_field "$f" origin)" in '' | run) ;; *) continue ;; esac
    ledger_live "$f" && printf '%s/%s\n' "$(ledger_field "$f" project)" "$(ledger_field "$f" area)"
  done
  return 0
}

# rows <profile> <project> <lane> -> "<key>\t<raw line>" for each OPEN row on the current wave
rows() {
  local flag=()
  [ "$3" = agent ] && flag=(--agent)
  np "$1" ptask "$2" "${flag[@]}" list 2>/dev/null | cut -f3-
}

# row_is <profile> <project> <lane> <key> <mark> -- is that row on the board as `- [<mark>]`?
# The board is read whole first: piped into `grep -q`, a large board dies of SIGPIPE and
# pipefail reads the 141 as "not there".
row_is() {
  local board
  board=$(rows "$1" "$2" "$3")
  grep -qF "$4"$'\t'"- [$5]" <<<"$board"
}

# judged_keys -> "<project>\t<lane>\t<key>\t<line sig>" for each verdict that still holds: one
# made under the current policy for the row's current text. A `failed` record holds for the
# key whatever changed ("*"), so a row whose session died is not picked again on its own.
judged_keys() {
  [ -f "$VERDICTS" ] || return 0
  jq -r --arg sig "$(policy_sig)" '
    if .verdict == "failed" then [.project, .lane, .key, "*"]
    elif .policy == $sig then [.project, .lane, .key, (.line // "")]
    else empty end | @tsv' "$VERDICTS" 2>/dev/null
}

cmd_candidates() {
  local judged table prof name sheet _v stage repo lane key text rank worker tier line
  judged=$(judged_keys)
  table=$(workers)
  [ -n "$table" ] || return 0
  for prof in $DISPATCH_PROFILES; do
    while IFS=$'\t' read -r name sheet _v _; do
      [ -n "$name" ] || continue
      stage=$(stage_of "$sheet")
      case "$stage" in alpha | beta | prod) ;; *) continue ;; esac
      wave-lock check "$name" >/dev/null 2>&1 && continue
      repo=$(repo_dir "$name")
      [ -n "$repo" ] && [ -d "$repo" ] || continue
      for lane in human agent; do
        while IFS=$'\t' read -r key text; do
          [ -n "$key" ] || continue
          case "$text" in '- [ ]'*) ;; *) continue ;; esac
          read -r rank worker tier < <(row_worker "$table" "$name" "$lane" "$text") || continue
          line=$(printf '%s' "$text" | sig)
          grep -qxF "$name"$'\t'"$lane"$'\t'"$key"$'\t'"$line" <<<"$judged" && continue
          grep -qxF "$name"$'\t'"$lane"$'\t'"$key"$'\t*' <<<"$judged" && continue
          jq -cn --arg profile "$prof" --arg project "$name" --arg stage "$stage" \
            --arg lane "$lane" --arg key "$key" --arg text "$text" --arg repo "$repo" \
            --arg line "$line" --argjson prio "$(prio_rank "$text")" --argjson tier "$tier" \
            --arg worker "$worker" --argjson wrank "$rank" \
            '{profile: $profile, project: $project, stage: $stage, lane: $lane, key: $key,
              text: $text, repo: $repo, prio: $prio, tier: $tier, line: $line,
              worker: $worker, wrank: $wrank}'
        done < <(rows "$prof" "$name" "$lane")
      done
    done < <(notes --profile "$prof" projects 2>/dev/null)
  done
}

# --- judgment ------------------------------------------------------------------------

# judge <candidates> -- one model call for the unjudged rows; every verdict lands in the cache
judge() {
  local cands="$1" prompt out verdicts wd rc
  [ -n "$cands" ] || return 0
  # Over the cap, in worker order, then prod rows, then beta, then alpha, each by priority.
  cands=$(jq -sc 'sort_by(.wrank, (.stage | {prod: 0, beta: 1}[.] // 2), .prio)[]' <<<"$cands" |
    head -n "$DISPATCH_JUDGE_MAX")
  [ -r "$DISPATCH_POLICY" ] || { say "no policy at $DISPATCH_POLICY"; return 1; }
  prompt="$(cat "$DISPATCH_POLICY")

## Rows to judge

$(jq -c '{project, stage, lane, key, text, tier}' <<<"$cands")

## Answer

For every row above, one JSON object per line, between a line DISPATCH-VERDICTS-START and a line DISPATCH-VERDICTS-END, nothing else between them:
{\"project\": ..., \"lane\": ..., \"key\": ..., \"tier\": 1|2|3, \"size\": \"S|M|L\", \"area\": \"<one lowercase word>\", \"clear\": true|false, \"agent_only\": true|false, \"verdict\": \"dispatch|skip\", \"reason\": \"<one short sentence>\"}
Copy project, lane and key exactly as given."
  # The call runs in an empty directory: from inside a repo, that repo's Stop hook runs its
  # tests after the answer, and the model's last message becomes a reply to the hook instead
  # of the verdicts (2026-10-27, run from ~/.dotfiles: every pass failed on one row).
  wd=$(mktemp -d)
  # shellcheck disable=SC2086 # the command is a word list by design (overridable in tests)
  out=$(cd "$wd" && $DISPATCH_JUDGE_CMD -p "$prompt" 2>/dev/null)
  rc=$?
  rm -rf -- "$wd"
  [ "$rc" = 0 ] || { say "judge call failed"; return 1; }
  verdicts=$(sed -n '/^DISPATCH-VERDICTS-START$/,/^DISPATCH-VERDICTS-END$/p' <<<"$out" | sed '1d;$d' |
    jq -cR --arg at "$(date -Iseconds)" --arg sig "$(policy_sig)" \
      --argjson c "$(jq -sc 'map({k: ([.project, .lane, .key] | tostring), line})' <<<"$cands")" '
      fromjson? | select(type == "object"
        and (.project | type) == "string" and (.lane | type) == "string"
        and (.key | type) == "string" and (.verdict == "dispatch" or .verdict == "skip"))
      | ([.project, .lane, .key] | tostring) as $k
      | {project, lane, key, tier, size, area, clear, agent_only, verdict, reason, at: $at,
         policy: $sig, line: ([$c[] | select(.k == $k) | .line] | first)}')
  # A pass that could not judge must not read as "no row qualifies".
  [ -n "$verdicts" ] || { say "judge returned no verdicts for $(wc -l <<<"$cands") row(s): ${out:0:200}"; return 1; }
  mkdir -p "$DIR"
  printf '%s\n' "$verdicts" >> "$VERDICTS"
}

# latest verdict per row, as JSON lines
latest_verdicts() {
  [ -f "$VERDICTS" ] || return 0
  jq -sc 'group_by([.project, .lane, .key]) | map(last) | .[]' "$VERDICTS" 2>/dev/null
}

# picks <candidates> <room> -> the rows to launch: the row's latest verdict is a dispatch made
# under the current policy for its current text, S or M, clear, agent-only, naming one area, and
# judged no higher a tier than the row counts as (all checked here too, so a lax verdict cannot
# launch anything); never two on an area, live or picked now; asks first, then most urgent, then
# prod before beta before alpha.
picks() {
  local cands="$1" room="$2"
  [ "$room" -gt 0 ] && [ -n "$cands" ] || return 0
  jq -sc --argjson room "$room" --arg sig "$(policy_sig)" --argjson max "$UNATTENDED_TIER_CEILING" \
    --argjson busy "$(live_runs | jq -Rsc 'split("\n") | map(select(length > 0) | ascii_downcase)')" \
    --slurpfile v <(latest_verdicts) '
    ($v | map({key: ([.project, .lane, .key] | tostring), value: .}) | from_entries) as $by
    | map(. as $c | $by[[.project, .lane, .key] | tostring] as $d
      | select($d != null and $d.verdict == "dispatch" and ($d.size == "S" or $d.size == "M")
          and $d.clear == true and $d.agent_only == true and $d.policy == $sig and $d.line == $c.line
          and ($d.tier | type) == "number" and $d.tier <= $c.tier and $c.tier <= $max
          and ($d.area | type) == "string" and $d.area != "")
      | . + {area: ($d.area | ascii_downcase), srank: ({"prod": 0, "beta": 1}[.stage] // 2)})
    | map(select("\(.project | ascii_downcase)/\(.area)" as $a | $busy | index($a) | not))
    | sort_by(.wrank, .prio, .srank) | unique_by([.project, .area]) | sort_by(.wrank, .prio, .srank)
    | .[:$room] | .[]' <<<"$cands"
}

# --- launch --------------------------------------------------------------------------

brief_for() {
  local c="$1" project lane key prof stage text flag=''
  project=$(jq -r .project <<<"$c"); lane=$(jq -r .lane <<<"$c"); key=$(jq -r .key <<<"$c")
  prof=$(jq -r .profile <<<"$c"); stage=$(jq -r .stage <<<"$c")
  text=$(jq -r .text <<<"$c" | sed 's/^- \[.\] //')
  [ "$lane" = agent ] && flag=' --agent'
  cat <<EOF
/one-shot $text

Dispatched by fleet-dispatch from $project ($stage), $lane sheet row "$key".
You are already in a fresh worktree off the trunk: work here, do not cut another.
When the PR merges, record done on THAT row: notes --profile $prof ptask $project$flag done "$key" --proof pr:<N>
If the task needs a decision or clarification from the human, ask it here and file the same question with agent-ask post (your recommendation in --recommend), then stop and leave this window open.
EOF
}

launch() {
  local c="$1" project lane key prof repo text area model flag=()
  project=$(jq -r .project <<<"$c"); lane=$(jq -r .lane <<<"$c"); key=$(jq -r .key <<<"$c")
  prof=$(jq -r .profile <<<"$c"); repo=$(jq -r .repo <<<"$c"); text=$(jq -r .text <<<"$c")
  area=$(jq -r .area <<<"$c")
  [ "$lane" = agent ] && flag=(--agent)
  model=$(model-lane classify "$text" 2>/dev/null | jq -r '.dispatch_model // empty' 2>/dev/null)
  # Asked again here, so a start never lands on a fallback: the gate's answer may be minutes old.
  RUN_ACCOUNT=$(claude-acct room 2>/dev/null) || { say "no account has room for $key"; return 1; }
  START_ORIGIN=run RUN_ACCOUNT=$RUN_ACCOUNT cmd_start --profile "$prof" --project "$project" "${flag[@]}" --row "$key" \
    --server "$DISPATCH_SERVER" --model "${model:-opus}" --cwd "$repo" --area "$area" --brief <(brief_for "$c")
}

# cmd_start -- THE way an agent starts a session, whoever it is: this runner's `run` pass, an
# agent launching one for a board row, a reboot restore. Each comes out tagged @dispatch on
# its server (the human reads [dispatch] as "an agent started this") with a ledger at
# live/<session> naming that server, which reap and fleet-sessions read. Before this, only
# `run` did either, and agents tagged their hand launches with set-option, which the human
# had to ask about twice.
#   --brief FILE --row KEY  claim the open row, cut a worktree off --cwd (default: the
#                           project's repo) with `wt new`, and run claude on the brief there.
#   --resume ID             a new session --session NAME in --cwd DIR running claude --resume.
#                           The sheet is not touched: the row was claimed before the reboot.
cmd_start() {
  local project='' prof='' lane=human key='' server="$DISPATCH_SERVER" model='' brief_file='' \
    resume='' cwd='' session='' area='' brief cmd label origin flag=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --agent) lane=agent; shift; continue ;;
      --project | --profile | --row | --server | --model | --brief | --resume | --cwd | --session | --area) ;;
      *) say "start: unknown argument: $1"; return 2 ;;
    esac
    [ $# -ge 2 ] && [ -n "$2" ] || { say "start: $1 needs a value"; return 2; }
    case "$1" in
      --project) project=$2 ;;
      --profile) prof=$2 ;;
      --row) key=$2 ;;
      --server) server=$2 ;;
      --model) model=$2 ;;
      --brief) brief_file=$2 ;;
      --resume) resume=$2 ;;
      --cwd) cwd=$2 ;;
      --session) session=$2 ;;
      --area) area=$2 ;;
    esac
    shift 2
  done
  [ -n "$project" ] || { say "start: --project is required"; return 2; }
  [ "$lane" = agent ] && flag=(--agent)

  if [ -n "$brief_file" ] && [ -z "$resume" ]; then
    [ -n "$key" ] || { say "start: --brief needs the --row it works"; return 2; }
    [ -z "$session" ] || { say "start: --brief cuts its own worktree session; --session is for --resume"; return 2; }
    [ -n "$cwd" ] || cwd=$(repo_dir "$project")
    [ -n "$cwd" ] && [ -d "$cwd" ] || { say "start: no repo to cut a worktree from for $project (--cwd)"; return 2; }
    brief=$(cat -- "$brief_file") && [ -n "$brief" ] || { say "start: empty or unreadable brief: $brief_file"; return 2; }
    origin=${START_ORIGIN:-hand}

    # Claim: the row must still be open right now, and `start` must leave THIS row started.
    row_is "$prof" "$project" "$lane" "$key" ' ' ||
      { say "skip $project: row no longer open: $key"; return 1; }
    np "$prof" ptask "$project" "${flag[@]}" start "$key" >/dev/null 2>&1
    row_is "$prof" "$project" "$lane" "$key" / ||
      { say "skip $project: could not start row: $key"; return 1; }

    model=${model:-opus}
    cmd="$(account_env)claude --model $(printf '%q' "$model") --permission-mode bypassPermissions $(printf '%q' "$brief")"
    session=$(cd "$cwd" && WT_NEW_CMD="$cmd" wt new --server "$server" --detach -c "$cwd" | tail -1)
    if [ -z "$session" ]; then
      np "$prof" ptask "$project" "${flag[@]}" start "$key" >/dev/null 2>&1
      say "wt new failed for $project; row un-started"
      return 1
    fi
  elif [ -n "$resume" ] && [ -z "$brief_file" ]; then
    [ -n "$session" ] && [ -n "$cwd" ] || { say "start: --resume needs --session and --cwd"; return 2; }
    [ -d "$cwd" ] || { say "start: not a directory: $cwd"; return 2; }
    # One agent per session: the ledger and the label belong to the whole session, so a
    # restore never lands in a session someone already has (a main checkout's, say).
    if session_live "$session" "$server"; then
      say "start: session $session already exists on $server; pass another --session"
      return 1
    fi
    origin=${START_ORIGIN:-resume}
    cmd="$(account_env)claude${model:+ --model $(printf '%q' "$model")} --permission-mode bypassPermissions --resume $(printf '%q' "$resume")"
    tmux -L "$server" new-session -d -s "$session" -c "$cwd" "$cmd" ||
      { say "could not create session $session on $server"; return 1; }
  else
    say "start: give exactly one of --brief or --resume"
    return 2
  fi

  label="$project: $(cut -c1-60 <<<"${key:-resumed}")"
  # set-option takes a pane target, where a bare "=name" is "no such session"; the colon makes it session:window.
  tmux -L "$server" set-option -t "=$session:" @dispatch "$label" ||
    say "could not tag $session with @dispatch"
  mkdir -p "$LIVE"
  printf 'project=%s\nprofile=%s\nlane=%s\nkey=%s\narea=%s\nmodel=%s\nlabel=%s\nserver=%s\norigin=%s\nstarted=%s\n' \
    "$project" "$prof" "$lane" "$key" "$area" "${model:-}" "$label" "$server" "$origin" "$(date -Iseconds)" > "$LIVE/$session"
  logline "started $session on $server ($origin) for $project $lane: ${key:-resume $resume}"
  echo "started $session: $label"
}

# --- verbs ---------------------------------------------------------------------------

# reap -- a ledger entry whose row is no longer started, or whose session is gone: done row ->
# drop it; row still started with the session gone -> un-start it and record `failed`, so it
# is not picked again until its text changes. A live session whose row is done is dropped too:
# the human may reuse its tmux session after the dispatched Claude ends, and that must not
# hold a dispatch slot.
cmd_reap() {
  local f s project prof lane key flag
  for f in "$LIVE"/*; do
    [ -f "$f" ] || continue
    s="${f##*/}"
    project=$(ledger_field "$f" project); prof=$(ledger_field "$f" profile)
    lane=$(ledger_field "$f" lane); key=$(ledger_field "$f" key)
    if ledger_live "$f"; then
      # A restore with no row has nothing to settle while its session runs.
      [ -z "$key" ] && continue
      row_is "$prof" "$project" "$lane" "$key" / && continue
      logline "reaped $s: $project $lane row no longer open (session still up): $key"
      rm -f -- "$f"
      continue
    fi
    flag=(); [ "$lane" = agent ] && flag=(--agent)
    if [ -n "$key" ] && row_is "$prof" "$project" "$lane" "$key" /; then
      np "$prof" ptask "$project" "${flag[@]}" start "$key" >/dev/null 2>&1
      jq -cn --arg p "$project" --arg l "$lane" --arg k "$key" --arg at "$(date -Iseconds)" \
        '{project: $p, lane: $l, key: $k, verdict: "failed", reason: "session ended without the row done", at: $at}' >> "$VERDICTS"
      logline "reaped $s: session gone, row un-started: $project $lane: $key"
      echo "un-started $project: $key ($s ended without it done)"
    else
      logline "reaped $s: session gone${key:+, $project $lane row no longer open: $key}"
    fi
    rm -f -- "$f"
  done
}

# real_idle -> percent of the machine idle over a two-frame top sample; the first frame is since boot.
real_idle() { LC_ALL=C top -bn2 -d2 2>/dev/null | sed -n 's/^%Cpu.* \([0-9.]*\) id,.*/\1/p' | tail -n 1; }

# firing_findings -> the shared faults firing now, one per line. Open is not firing: a finding stays
# open for an hour after its last sample, which would hold starts long after the fault cleared.
firing_findings() {
  jq -r --argjson now "$(date +%s)" --argjson fresh "$DISPATCH_FINDING_FRESH_MIN" '
    select(.rule == "starved" or .rule == "throughput-drop" or .rule == "blind")
    | select((.epoch // $now) >= $now - $fresh * 60) | "\(.rule) \(.scope)"'
}

# gate -> why this pass must not start anything, or nothing when it may. Anything it cannot read
# refuses: a start nobody can justify costs more than a pass that waits 15 minutes.
# A red main is deliberately not here: nightlies stay red while sessions merge normally, so it
# would stop everything, and the shepherd's MAIN row handles it.
gate() {
  local load cores infra presence findings github idle
  agent-hold check dispatch >/dev/null 2>&1 || { echo "held (agent-hold dispatch)"; return; }
  presence=$(fleet-presence 2>/dev/null)
  case "$presence" in
    away*) ;;
    *) echo "the human is not away (${presence:-fleet-presence unreadable})"; return ;;
  esac
  claude-acct room >/dev/null 2>&1
  case $? in
    0) ;;
    1) echo "no account has room under its weekly pace"; return ;;
    *) echo "account usage unreadable"; return ;;
  esac
  fleet-assess --watch-probe >/dev/null 2>&1 || { echo "fleet-assess says HOLD"; return; }
  # Cluster only, not every urgent trip: a red nightly is urgent, and new sessions do not worsen it.
  infra="$(fleet-shepherd infra 2>/dev/null)" && { echo "$infra"; return; }
  load=$(cut -d' ' -f1 "$DISPATCH_LOADAVG" 2>/dev/null)
  cores=$(nproc 2>/dev/null || echo 1)
  awk -v l="${load:-0}" -v c="$cores" -v m="$DISPATCH_MAX_LOAD" 'BEGIN { exit !(l / c > m) }' &&
    { echo "load ${load} on ${cores} cores is over the ${DISPATCH_MAX_LOAD} pace"; return; }
  findings=$(fleet-bench findings --json 2>/dev/null) || { echo "fleet-bench findings unreadable"; return; }
  findings=$(firing_findings <<<"$findings") || { echo "fleet-bench findings unreadable"; return; }
  [ -z "$findings" ] || { echo "finding firing: $(paste -sd, <<<"$findings")"; return; }
  github=$(fleet-assess --github 2>/dev/null)
  case "$github" in
    '' | *unreadable*) echo "github budget unreadable"; return ;;
    *LOW*) echo "$github"; return ;;
  esac
  idle=$(real_idle)
  [ -n "$idle" ] || { echo "real idle unreadable"; return; }
  awk -v i="$idle" -v m="$DISPATCH_MIN_IDLE" 'BEGIN { exit !(i < m) }' &&
    echo "real idle ${idle}% is under ${DISPATCH_MIN_IDLE}%"
}

# settle <outcome> <why>: say what this pass did and publish it for fleet-liveness. agentctl turns
# a run that publishes nothing into STALLED. A dry run is not a run.
settle() {
  say "$2"
  [ "$DRY" = 0 ] || return 0
  # shellcheck source=/dev/null
  . "$HOME/.local/lib/agent-proof.sh" 2>/dev/null || return 0
  proof_report fleet-dispatch "$1" "$2" 2>/dev/null || true
}

cmd_run() {
  local why live room cands picked c n started=0
  DRY=0
  [ "${1:-}" = --dry-run ] && DRY=1
  mkdir -p "$DIR"
  exec 9>"$DIR/.lock"
  flock -n 9 || { settle NOOP "another pass is running"; return 0; }

  [ "$DRY" = 1 ] || cmd_reap
  live=$(live_runs | grep -c . || true)
  room=$(( DISPATCH_MAX_LIVE - live ))
  [ "$room" -gt "$DISPATCH_PER_PASS" ] && room=$DISPATCH_PER_PASS
  if [ "$room" -le 0 ]; then settle NOOP "at $live live dispatched sessions, starting nothing"; return 0; fi
  why=$(gate)
  if [ -n "$why" ]; then
    settle NOOP "$why, starting nothing"
    [ "$DRY" = 1 ] || return 0
  fi

  judge "$(cmd_candidates)" || { settle FAILED "could not judge the new rows"; return 1; }
  # Every open row again, judged ones included: a row judged on an earlier pass can be picked now.
  cands=$(all_open)
  picked=$(picks "$cands" "$room")
  [ -n "$picked" ] || { settle NOOP "no row qualifies this pass"; return 0; }
  n=$(grep -c . <<<"$picked")
  while IFS= read -r c; do
    if [ "$DRY" = 1 ]; then
      echo "would start: $(jq -r '"\(.project) (\(.stage)) \(.lane), \(.worker), \(.area): \(.key)"' <<<"$c")"
    else
      launch "$c" && started=$(( started + 1 ))
    fi
  done <<<"$picked"
  [ "$DRY" = 0 ] || return 0
  if [ "$started" -gt 0 ]; then settle WORKED "started $started of $n"; else settle FAILED "picked $n, started none"; return 1; fi
}

# all_open -- candidates without the judged filter: every open, eligible row
all_open() { VERDICTS=/dev/null cmd_candidates; }

cmd_report() {
  latest_verdicts | jq -r --arg sig "$(policy_sig)" '[.verdict, .size // "-", (.tier // "-" | tostring),
      .project, .lane, .area // "-", .key, (.reason // "") + (if .verdict != "failed" and .policy != $sig then " (stale: policy changed)" else "" end)] | @tsv' |
    sort | awk -F'\t' '{ printf "%-9s %-2s t%-2s %-16s %-6s %-12s %s\n           %s\n", $1, $2, $3, $4, $5, $6, substr($7, 1, 90), $8 }'
}

main() {
  case "${1:-}" in
    run) shift; cmd_run "$@" ;;
    candidates) cmd_candidates ;;
    report) cmd_report ;;
    reap) cmd_reap ;;
    start) shift; cmd_start "$@" ;;
    -h | --help) sed -n '2,20p' "$0" ;;
    *) sed -n '2,10p' "$0" >&2; return 2 ;;
  esac
}

# Sourceable for tests; runs main only when executed.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
