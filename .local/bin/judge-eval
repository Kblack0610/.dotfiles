#!/usr/bin/env bash
# judge-eval - every judge lane scored against its ground truth, per rule, under its current prompt.
#
#   judge-eval [lane|--all] [--any-prompt] [--days N] [--json]
#       one scored lane (a runner conf with SCORE=) or all of them (the default): per lane and rule the
#       verdicts, errors, coverage, scored, precision with its 95% interval, false-defer %, kappa,
#       p95 and cost per verdict, and which rules are live.
#       --any-prompt counts verdicts under every prompt; --days keeps the last N days.
#   judge-eval prompts [lane|--all]
#       what each lane is told and held to, in full: for every runner conf with a SCORE= or PROMPT=
#       (the default is all of them), the conf's header comment, model, scoring truth, each PROMPT
#       file with its includes in place and its sha (the prompt boundary a score is cut at), the
#       SCHEMA, the conf gates the call obeys (its own DELAY_RULES, AUDIT_RATES, PROMOTE_BARS,
#       PRECEDENTS and the judge's hard stops, the calling runner's conf settings, and the data
#       files a caller's decisions read) and the lines that call the lane, where its input is built.
#       A PROMPT file that cannot be read, or a lane with no PROMPT, is an error (exit 1), never a skipped lane.
#   judge-eval kpi [--json]
#       fleet-bench's judge KPIs over 7 and 28 days, every prompt, both windows scored from one read of the sources.
#   SENTINEL_SINCE (an epoch, set by a Sentinel probe) starts every window no earlier than a watch's fix.
#   judge-eval log [answered|would-answer|passed|wrong] [--level L] [--human-only] [--days N] [--limit N] [--json]
#       the answer judge's verdicts, newest first and under any prompt: what it said, why, the
#       quote behind it, its impact level, whether a human-stop rule made it human-only, its call
#       id (calls.jsonl .raw) and what you did. The same rows reach Log's Judges' verdicts section.
#   judge-eval cells [--any-prompt] [--days N] [--json]
#       the answer judge per type and impact level (self, repo, fleet): verdicts, scored,
#       precision with its 95% interval, pending, whether the cell is live (a DELAY_RULES row names
#       its type at or above its level), the live answers you reviewed (by message or audit), and
#       how often a floor raised the judge's level. A live answer you never reviewed
#       is not scored, so silence never counts as agreement.
#
#   judge-eval promote [--any-prompt] [--ask] [--json]
#       each shadow cell of the answer judge against the bar for its level: PROMOTE_BARS in
#       ask-judge.conf, `<level>=<percent>`, the Wilson 95% lower bound its precision must reach.
#       A level with no bar (fleet) and a hard-stop type are never candidates, and a
#       cell is held while a narrower cell of its type is shadow with scored answers under its
#       own bar, since a row's level is a ceiling that opens every level under it. --ask posts
#       one approval ask per candidate (the briefing runs it on Mondays), unless one for that
#       cell is pending or was answered or closed in the last PROMOTE_QUIET_DAYS days.
#
# Read-only. The standard, each lane's truth and the formulas: ~/.local/src/docs/judges.md.

set -uo pipefail

# agent-ask's helpers (ask root) and AGENT_ASK_LIVE_BAR, the scored rows a
# lane's score needs; judge.sh comes with it (judge_ask_docs, the calls.jsonl path).
# shellcheck source=agent-ask
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/agent-ask"
# shellcheck source=../lib/end-reasons.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/end-reasons.sh"
# shellcheck source=../lib/prompt-render.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/prompt-render.sh"

: "${FLEET_DISPATCH_DIR:=$HOME/.agent/dispatch}"
: "${JUDGE_EVAL_QUEUE_CMD:=agent-queue list --json --state all}"
# The notes ingest record: what became of each row a runner wrote (its 30 days are all it keeps).
: "${JUDGE_EVAL_INGEST_CMD:=notes log --json --days 30}"
CONF_DIR="${AGENTCTL_CONF_DIR:-$HOME/.config/agentctl/agents}"
# How long a runner's write stands before it counts as right: a filed row untouched, a skipped row
# not started by hand.
SETTLE_H=48
# A row the ask-sweep model filed carries its quote: ask-sweep file_row writes `<row>; asked MM-DD "<quote>"`.
SWEEP_ROW_RE='; asked [0-9]{2}-[0-9]{2} "'
# judge_precision counts only rules with this many scored answers, and a false-defer percent only lanes
# with this many scored defers: below it one miss swings 10+ points.
KPI_LABELS=10
# A Sentinel probe's fix watermark (watch-companion-loop resolve), an epoch, 0 for none: a window starts
# at the later of its own start and this, so a fixed red stops counting the verdicts before its fix.
WATERMARK=0; [[ "${SENTINEL_SINCE:-}" =~ ^[0-9]+$ ]] && WATERMARK="$SENTINEL_SINCE"
MISSES=10
# Verdicts one read carries to the dashboards: about a week of asks, so a filter still has rows.
VERDICTS=200
LOG_LIMIT=50
# How long an answered promotion ask keeps its cell from being asked again: four Monday briefings, so
# a hold stands for a month and the cell comes back with a month more answers behind it.
PROMOTE_QUIET_DAYS=28

say() { printf 'judge-eval: %s\n' "$*" >&2; }
# JUDGE_LEVELS as a JSON array, narrowest first.
LEVELS_JSON="$(jq -cn --arg l "$JUDGE_LEVELS" '$l | split(" ")')"

# lane_shas <agent>: the sha of each file its conf's PROMPT names now (colon-separated), one per
# line, as agentctl-run records it on a call (lib prompt-render.sh, prompt_sha). A lane that runs
# several passes has one prompt per pass, and a call under any of them is under the current prompt.
lane_shas() {
  local prompt p
  local -a files
  prompt="$( . "$CONF_DIR/$1.conf" 2>/dev/null; printf '%s' "${PROMPT:-}")"
  IFS=: read -ra files <<<"$prompt"
  for p in "${files[@]+"${files[@]}"}"; do prompt_sha "$p" 2>/dev/null || true; done
}

# The scored lanes, the registry: every runner conf that names a SCORE.
# SCORES is {lane: its conf's SCORE, the truth source it is scored by (judges.md)}.
SCORES="$(for c in "$CONF_DIR"/*.conf; do s="$( . "$c" 2>/dev/null; printf '%s' "${SCORE:-}")"
  [ -n "$s" ] && printf '%s\t%s\n' "$(basename "$c" .conf)" "$s"; done |
  jq -Rsc 'split("\n") | map(select(length > 0) | split("\t") | {(.[0]): .[1]}) | add // {}')"
AGENTS="$(jq -r 'keys | join(" ")' <<<"$SCORES")"

# eval_collect <dir>: every source the scoring reads, one file each in <dir>, read once per run however
# many windows it scores. The reads are independent, so they run side by side.
eval_collect() {
  local d="$1" f
  judge_ask_docs "$ASKS_ROOT" | jq -sc 'map(select((.judge // "") != ""))' > "$d/asks" &
  # A call keeps only the fields the scoring reads: its prompt and raw text are most of the file.
  zcat -f -- "$AGENTCTL_CALLS"* 2>/dev/null | jq -sc --arg a "$AGENTS" '[.[] | objects | select(.agent as $x | $a | split(" ") | index($x))
    | {id, agent, at, prompt_sha, duration_ms, cost_usd, exit, is_error}]' > "$d/calls" 2>/dev/null &
  jq -sc '[.[] | objects]' "$FLEET_DISPATCH_DIR/verdicts.jsonl" > "$d/verdicts" 2>/dev/null &
  $JUDGE_EVAL_QUEUE_CMD 2>/dev/null | jq -sc '[.[] | objects | select(((.from // "") | startswith("board:")) or .row != null)]' > "$d/queue" 2>/dev/null &
  $JUDGE_EVAL_INGEST_CMD 2>/dev/null | jq -sc --arg sweepre "$SWEEP_ROW_RE" '[.[] | objects | select(.id != null) | select((.action | IN("filed", "planned", "edited",
    "dropped", "rehomed", "tagged")) or (.action == "added" and ((.text // "") | contains("#of/") or test($sweepre))))
    | {ts, action, id, by, from, to, text, why}]' > "$d/ingest" 2>/dev/null &
  # {lane: [each sha its PROMPT files have now]}, one jq for every lane.
  for f in $AGENTS; do lane_shas "$f" | awk -v a="$f" 'length { print a "\t" $0 }'; done |
    jq -Rsc --arg a "$AGENTS" '[split("\n")[] | select(length > 0) | split("\t")] as $l
      | [$a | split(" ")[] | . as $x | {($x): [$l[] | select(.[0] == $x) | .[1]]}] | add // {}' > "$d/shas"
  wait
  for f in asks calls verdicts queue ingest; do [ -s "$d/$f" ] || echo '[]' > "$d/$f"; done
  answer_picks "$(jq -c '.[]' "$d/asks")" > "$d/picks"
}

# eval_jq <dir> <agents> <any-prompt 0|1> <days or empty> <program> [jq args]: JQ_EVAL over the
# sources eval_collect wrote to <dir>, then <program>, which calls report(<days or "">) once per window.
eval_jq() {
  local d="$1" want="$2" any="$3" days="$4" prog="$5" src
  shift 5
  src="$(jq -c --arg a "$AGENTS" '. as $m | $a | split(" ") | map({(.): ($m[.] // "")}) | add // {}' <<<"$SCORES")"
  jq -n --slurpfile A "$d/asks" --slurpfile C "$d/calls" --slurpfile V "$d/verdicts" \
    --slurpfile Q "$d/queue" --slurpfile P "$d/picks" --slurpfile S "$d/shas" \
    --slurpfile I "$d/ingest" --argjson src "$src" --argjson settle "$((SETTLE_H * 3600))" \
    --arg sweepre "$SWEEP_ROW_RE" --argjson live "$(live_rules | jq -Rsc 'split("\n") | map(select(length > 0))')" \
    --arg want "$want" --argjson any "$any" --arg days "$days" --argjson now "$(date +%s)" --argjson wm "$WATERMARK" \
    --arg hard "$JUDGE_HARD_STOPS" --argjson unrated "$(unrated_json)" --argjson levels "$LEVELS_JSON" \
    --argjson bar "$AGENT_ASK_LIVE_BAR" --argjson nmiss "$MISSES" --argjson nverdicts "$VERDICTS" "$@" \
    '$A[0] as $asks | $C[0] as $calls | $V[0] as $verdicts | $Q[0] as $queue | $P[0] as $picks | $S[0] as $shas | '"$JQ_EVAL $prog"
}

# eval_json <agents> <any-prompt 0|1> <days or empty> -> the whole report as one JSON object
eval_json() {
  local tmp rc=0
  tmp="$(mktemp -d)" || return 1
  eval_collect "$tmp"
  eval_jq "$tmp" "$1" "$2" "$3" 'report($days)' || rc=$?
  rm -rf "$tmp"
  return "$rc"
}

# JQ_EVAL: the scoring, over the slurped sources above.
# shellcheck disable=SC2016
JQ_EVAL="$JQ_EPOCH"'
  def pct($a; $b): if $b > 0 then ($a * 1000 / $b | round) / 10 else null end;
  def quantile($q): sort | if length == 0 then null else .[((length - 1) * $q) | floor] end;
  # Wilson score interval, 95%, for k right of n, in percent.
  def wilson($k; $n): if $n == 0 then [null, null] else
    ($k / $n) as $p | 3.8416 as $z2 | (1 + $z2 / $n) as $d
    | (($p + $z2 / (2 * $n)) / $d) as $c | (((($p * (1 - $p) / $n) + $z2 / (4 * $n * $n)) | sqrt) * 1.96 / $d) as $h
    | [(($c - $h) * 1000 | round) / 10 | if . <= 0 then 0 else . end, (($c + $h) * 1000 | round) / 10 | if . > 100 then 100 else . end] end;
  def bykey(f): group_by(f) | map({((.[0] | f)): .}) | add // {};
  def kappa: (.tp + .fp + .fn + .tn) as $n | if $n == 0 then null else
    ((.tp + .tn) / $n) as $po | (((.tp + .fp) * (.tp + .fn) + (.fn + .tn) * (.fp + .tn)) / ($n * $n)) as $pe
    | if $pe >= 1 then null else ((($po - $pe) / (1 - $pe)) * 100 | round) / 100 end end;

  $I[0] as $ingest
  # Each call and verdict row carries its epoch (.e), parsed once for every window.
  | ($calls | map(. + {e: (.at | epoch)})) as $calls
  # Each truth source scores the lane whose conf names it in SCORE=.
  | ($src | to_entries | map({(.value): .key}) | reverse | add // {}) as $by
  | ($calls | map({(.id): .}) | add // {}) as $call
  # A row the ingest record scores has no call of its own: it is under the current prompt when
  # written after the first call made with it since the last call under another prompt.
  # $shas[agent] is every prompt the lane runs now; a lane with none counts the calls that recorded none.
  | def current($a; $s): ($shas[$a] // []) as $l | if $l == [] then $s == "" else $l | index([$s]) != null end;
  ($calls | map(select((.prompt_sha // "") != "") | {agent, s: .prompt_sha, e} | select(.e != null))
     | group_by(.agent) | map(.[0].agent as $a | ([.[] | select(current($a; .s) | not) | .e] | max) as $other
       | {($a): ([.[] | select(current($a; .s) and ($other == null or .e > $other)) | .e] | min)})
     | add // {}) as $since_sha
  |

  # One verdict row each: {agent, id, project, question, rule, type, kind (answer|defer|error),
  # live, want, outcome (tp|fp|fn|tn|pending|unscorable), unscorable (why, on an unscorable one),
  # human, reason, evidence, at, call}. The human label of an ask with options is the option its
  # answer names (answer_picks); a free-text ask keeps its answer unless a session typed it.
  [$asks[] | select(.judge_rule != "gate" or (.judge_call // "") != "")
    | . as $a | ($a.judge | if . == "human" then "defer" elif . == "error" then "error" else "answer" end) as $kind
    | (if $a.judge == "take-recommend" then $a.recommend // "" else ($a.judge | ltrimstr("answer:")) end) as $want
    | ($picks[$a.id] // (if ($a.options // "") != "" or (($a.answer // "") | startswith("in session:")) then null else $a.answer end)) as $human
    # Why the human answer cannot label this verdict, or null; the outcome below is unscorable on it.
    | (if $a.status != "answered" then "\($a.status // "closed") unanswered"
       elif ($a.answered_by // "human") != "human" then "answered by the \($a.answered_by)"
       elif $human == null then (if ($a.options // "") == "" then "free text in session" else "answer naming no option" end)
       elif $kind == "answer" then null
       elif ($a.judge_rule // "") == "unclear-ask" then "unclear ask"
       elif any($a.judge_type, $a.judge_rule; IN(($hard | splits(" +"))) and . != "") then "hard stop"
       elif ($a.judge_type // "") == "" then "untyped deferral"
       elif ($a.recommend // "") == "" then "no recommendation" else null end) as $why
    | {agent: $by["ask-answers"], id: $a.id, project: $a.project, question: $a.question, rule: ($a.judge_rule // ""),
       # An ask judged before the human-only flag (ar-4352, 2026-11-21) recorded it as level
       # `critical`, with the level the judge gave lost; it reads as human-only with no level. The clause
       # goes once those asks age out of the 28-day KPI window, 2026-12-19.
       type: ($a.judge_type // ""), level: (($a.judge_level // "") | if . == "critical" then "" else . end),
       level_raised: ($a.judge_level_raised == "true"),
       human_only: ($a.judge_human_only == "true" or $a.judge_level == "critical"),
       kind: $kind, live: ($a.answered_by == "judge"),
       assumed: ($a.answered_by == "judge" and ($a.assume_at // "") != ""), want: $want,
       human: (if $a.answered_by == "judge" then $a.judge_override // "" else $human // $a.answer // "" end),
       reason: ($a.judge_reason // ""), evidence: ($a.judge_evidence // ""),
       at: $a.judged_at, answered_at: $a.answered_at, judge_call: ($a.judge_call // ""),
       outcome: (if $kind == "error" then null
         # A live answer is right only when the human named its option (`kept`): `none` is a
         # message that named no option, silence, which must never count as agreement.
         elif $a.answered_by == "judge" then
           ({"": "pending", kept: "tp", none: "unscorable"}[$a.judge_override // ""] // "fp")
         elif $a.status == "pending" then "pending"
         elif $why != null then "unscorable"
         elif $kind == "answer" then (if ($human | ascii_downcase) == ($want | ascii_downcase) then "tp" else "fp" end)
         elif ($human | ascii_downcase) == ($a.recommend | ascii_downcase) then "fn" else "tn" end)}
    | . + {unscorable: (if .outcome != "unscorable" then null elif .live then "live answer not reviewed" else $why end)}] as $askrows
   # Dispatch: an error line is one verdict each (the row is judged again); otherwise the newest
   # verdict per row, labelled by its queue item: done ok landed, done otherwise or a later
   # `failed` line did not. A run that ended for a cause outside the model (UNRATED_ENDS) labels
   # nothing. A `cleared` (fleet-dispatch ask_failed_rows, which restarts the failure count once it
   # asks the human) does not undo a failure, so the newest `failed` per row counts.
   | ($verdicts | map(select(.verdict == "failed"))
      | map({key: "\(.project)\u0000\(.key)", verdict, e: (.at | epoch)}) | group_by(.key)
      | map(last | {(.key): .e}) | add // {}) as $failed
   | ($queue | map(select((.from // "") | startswith("board:")))
      | map({key: (.from | ltrimstr("board:")),
             value: (.state + "/" + (if .status != "ok" and ((.end_reason // "") | IN($unrated[])) then "unrated" else .status // "" end))})
      | from_entries) as $item
   # Every start of a queue item, keyed by its board row, with who started it (`by`, agent-queue ORIGIN_BY).
   | ($queue | map(select(.started != null) | {key: (.row // (.from | ltrimstr("board:"))), e: (.started | epoch), by})) as $starts
   | ($starts | bykey(.key)) as $startsby | ($starts | bykey(.key | split(":") | last)) as $startsbyid
   # The ingest record, each event with its epoch. The planner writes in the minute up to its
   # `planned` record on the row, and those writes touch nothing.
   | ($ingest | map(. + {e: (.ts | epoch)}) | map(select(.e != null))) as $ev
   | ($ev | map(select(.action == "planned")) | bykey(.id)) as $plans
   | def planner($id; $e): any(($plans[$id] // [])[].e; (. - 60) <= $e and $e <= .);
   # Split rows, by the row they were split from: #of/<id> in the text of an added row, or +#of/<id> in a
   # re-tag. The -#of/<id> of a re-tag moves the row away from <id>, so it splits nothing from it (ar-5230:
   # 26 of 46 inbox-plan misses in a week were a session re-parenting a child of the planned row to an epic).
   ($ev | map(select(.action == "added" or .action == "tagged")
        | ([(if .action == "added" then (.text // "") else "" end | capture("(^|\\s)#of/(?<p>[A-Za-z0-9_-]+)").p),
            ((.why // "") | capture("(^|\\s)\\+#of/(?<p>[A-Za-z0-9_-]+)").p)] | first) as $p
        | select($p != null) | {p: $p, id, e})
      | bykey(.p)) as $kids
   # A re-tag that only changes the priority is a call of the priority pass, scored on its own lane,
   # so it touches nothing the triager or planner wrote.
   | def prios: (.why // "") | split(" ") | map(select(test("^[+-]#(urgent|high|normal|low)$")));
   def prio_only: .action == "tagged" and (((.why // "") | split(" ") | map(select(length > 0))) as $w
       | ($w | length) > 0 and ($w | length) == (prios | length));
   # Likewise a re-tag by a pass or session of only size, plan, hold, ask or after words (#pts/N from inbox-size,
   # #plan #go from dispatch, a hold or an ordering) is gating or sizing the row, not a correction of what the triager filed.
   # A human re-tag (by human) stays a touch: the triager files a size, and a person changing it corrects it.
   def pass_only: prio_only or (.action == "tagged" and ((.by // "") | IN("", "human") | not)
       and (((.why // "") | split(" ") | map(select(length > 0))) as $w
       | ($w | length) > 0 and ($w | all(test("^[+-]#(urgent|high|normal|low|pts/[0-9]+|size/[sml]|plan|go|hold/[^ ]+|after/[^ ]+|ask/[^ ]+|desk/[^ ]+)$")))));
   # A dup is a later line joined to the row: it repeats the row, so it corrects nothing.
   ($ev | map(select((.action | IN("edited", "dropped", "rehomed", "tagged")) and (pass_only | not))) | bykey(.id)) as $touch
   # Priority: each priority the priority pass set (`by` inbox-priority, or inbox-triage on a
   # priority-only re-tag from before the pass named itself), right when nobody else changes the
   # priority of the row for the settle window. A later pass on the row inside the window supersedes
   # it, unless someone changed the priority before that pass ran. Pending for the whole window from
   # the tag, even once superseded: a superseded miss resolved at the next pass filled a young window
   # with misses alone (runner_score_inbox_priority 0 on an 81% lane, 2026-11-24).
   # $end only bounds the search for a change; the verdict time is always the tag plus the window.
   | def prio_pass: .action == "tagged" and ((.by // "") == "inbox-priority" or ((.by // "") == "inbox-triage" and prio_only));
   ($ev | map(select(.action == "tagged" and (prios | length > 0))) | bykey(.id)) as $prioev
   | [$ev[] | select(prio_pass) | . as $s
      | ([prios[] | select(startswith("+")) | ltrimstr("+#")] | last) as $set
      | select($set != null)
      | ($prioev[$s.id] // []) as $later
      | ([$later[] | select(.e > $s.e and prio_pass) | .e] | min) as $next
      | (if $next != null and $next <= ($s.e + $settle) then $next else $s.e + $settle end) as $end
      | ([$later[] | select(.e > $s.e and .e <= $end and (prio_pass | not)
           and (prios | any(. == "-#\($set)" or (startswith("+") and . != "+#\($set)"))))] | first) as $t
      | select($t != null or $end == $s.e + $settle)
      | {agent: $by["priority-kept"], id: $s.id, project: (if ($s.to // "") == "" then $s.from else $s.to end),
         question: ($s.text // ""), rule: $set, kind: "answer", want: $set,
         human: (if $t == null then "" else ($t.why // "") + (if ($t.by // "") == "" then "" else " by \($t.by)" end) end),
         reason: "", at: $s.ts, answered_at: (if $t == null then null else $t.ts end), judge_call: "",
         outcome: (if ($now - $s.e) < $settle then "pending" elif $t != null then "fp" else "tp" end)}] as $priorows
   # A row a runner wrote is right when nothing edits, drops, moves or re-tags it for the settle
   # window, writes by the planner aside; untouched($src) makes the verdict for the lane scored by $src.
   # Each settle-window verdict here (and the priority and defer ones) stays pending until its window
   # ends, wrong or right: a miss known early would fill a young window (a fix watermark) with misses
   # alone, since a right answer needs the whole window (runner-score at 21% on an 87% lane, 2026-11-22).
   | def untouched($src): . as $f
      | ([($touch[$f.id] // [])[] | select(.e > $f.e and .e <= ($f.e + $settle) and (planner($f.id; .e) | not))] | first) as $t
      | {agent: $by[$src], id: $f.id, project: (if ($f.to // "") == "" then $f.from else $f.to end),
         question: ($f.text // ""), rule: "", kind: "answer", want: "untouched",
         human: (if $t == null then "" else $t.action + (if ($t.by // "") == "" then "" else " by \($t.by)" end) end), reason: "", at: $f.ts,
         answered_at: (if $t == null then null else $t.ts end), judge_call: "",
         outcome: (if ($now - $f.e) < $settle then "pending" elif $t != null then "fp" else "tp" end)};
   # Triage: each row the triager filed (`by` its runner name, or no writer on events from before
   # the record named the runner).
   [$ev[] | select(.action == "filed" and ((.by // "human") | IN("", "human", "inbox-triage"))) | untouched("triage-untouched")] as $triagerows
   # Ask sweep: each row its model filed, known by the quote it carries (SWEEP_ROW_RE), whoever ran
   # it. Its plan rows carry none, since no model wrote them, and the planner wrote a row split from one.
   | [$ev[] | select(.action == "added" and ((.text // "") | test($sweepre) and (contains("#of/") | not))) | untouched("sweep-untouched")] as $sweeprows
   # Plan: each row the planner planned, right when it (or a row split from it in the same run)
   # starts before any re-split: a later plan, or a row split from it by someone else after it.
   | [$plans[] | min_by(.e) as $p
      | ([$p.id] + [($kids[$p.id] // [])[] | select(planner($p.id; .e)) | .id]) as $ids
      | ([$ids[] as $i | ($startsbyid[$i] // [])[] | select(.e != null and .e >= $p.e) | .e] | min) as $go
      | ([($plans[$p.id] // [])[].e | select(. > $p.e)] + [($kids[$p.id] // [])[] | select(.e > $p.e and (planner($p.id; .e) | not)) | .e] | min) as $resplit
      | ($resplit != null and ($go == null or $resplit < $go)) as $wrong
      | {agent: $by["plan-dispatched"], id: $p.id, project: ($p.from // ""), question: ($p.text // ""), rule: "",
         kind: "answer", want: "started whole", human: (if $wrong then "re-split" elif $go != null then "started" else "" end),
         reason: ($p.why // ""), at: $p.ts, answered_at: null, judge_call: "",
         outcome: (if $wrong then "fp" elif $go != null then "tp" else "pending" end)}] as $planrows
   | ($askrows + [($verdicts | map(select(.verdict == "error"))[]
           | {agent: $by["dispatch-queue"], id: .key, project, question: .key, rule: (.rule // ""), kind: "error",
              want: "", human: "", reason: (.reason // ""), at, judge_call: (.judge_call // ""), outcome: null}),
          # A skip is a false defer when the row is started by hand after its run of skips began.
          ($verdicts | map(select(.verdict == "dispatch" or .verdict == "skip"))
           | group_by([.project, .key]) | map(sort_by(.at | epoch // 0))[]
           | . as $r | last as $v | "\($v.project):\($v.key)" as $row | ($item[$row] // "") as $st
           | (($failed["\($v.project)\u0000\($v.key)"] // -1) >= ($v.at | epoch // 0)) as $fail
           | ((([$r | to_entries[] | select(.value.verdict != "skip") | .key] | max) // -1) + 1) as $i
           | ($r[$i].at | epoch // 0) as $skip0
           | ([($startsby[$row] // [])[] | select((.by | IN("dispatch", "resume") | not) and .e != null and .e >= $skip0) | .e] | min) as $hand
           | {agent: $by["dispatch-queue"], id: $v.key, project: $v.project, question: $v.key, rule: ($v.rule // ""),
              kind: (if $v.verdict == "dispatch" then "answer" else "defer" end), want: "start",
              human: (if $fail then "failed" elif $v.verdict == "skip" and $hand != null then "started by hand" else $st end),
              reason: ($v.reason // ""), at: $v.at, answered_at: null, judge_call: ($v.judge_call // ""),
              outcome: (if $v.verdict == "skip" then
                  (if ($now - $skip0) < $settle then "pending" elif $hand != null then "fn" else "tn" end)
                elif $fail or ($st | test("^done/(failed|cancelled)")) then "fp"
                elif $st == "done/ok" then "tp" else "pending" end)})] + $triagerows + $planrows + $priorows + $sweeprows)
  | map(select(.agent != null) | . + {e: (.at | epoch)}) as $all | ($all | bykey(.agent)) as $lane

  | ($all | map(select(.judge_call != "")) | group_by(.judge_call) | map({(.[0].judge_call): length}) | add // {}) as $share
  | def stats: . as $r
      | ($r | map(select(.kind == "error")) | length) as $err
      | {verdicts: ($r | length), errors: $err,
         answered: ($r | map(select(.kind == "answer")) | length),
         live_answered: ($r | map(select(.live == true)) | length),
         human_only: ($r | map(select(.human_only == true)) | length),
         human_only_live: ($r | map(select(.human_only == true and .live == true)) | length),
         assumed: ($r | map(select(.assumed == true)) | length),
         assumed_overridden: ($r | map(select(.assumed == true and .outcome == "fp")) | length),
         deferred: ($r | map(select(.kind == "defer")) | length),
         pending: ($r | map(select(.outcome == "pending")) | length),
         unscorable: ($r | map(select(.outcome == "unscorable")) | length),
         unscorable_by: ($r | map(select(.outcome == "unscorable") | .unscorable) | group_by(.)
           | map({(.[0]): length}) | add // {}),
         tp: ($r | map(select(.outcome == "tp")) | length), fp: ($r | map(select(.outcome == "fp")) | length),
         fn: ($r | map(select(.outcome == "fn")) | length), tn: ($r | map(select(.outcome == "tn")) | length)}
      | . + {scored: (.tp + .fp + .fn + .tn), coverage: pct(.answered; .verdicts - .errors),
             unscorable_pct: pct(.unscorable; .verdicts - .errors),
             live_pct: pct(.live_answered; .verdicts - .errors), precision: pct(.tp; .tp + .fp), false_defer_pct: pct(.fn; .fn + .tn), kappa: kappa}
      | . + (wilson(.tp; .tp + .fp) | {precision_lo: .[0], precision_hi: .[1]})
      # Each verdict carries its share of its call: one dispatch call judges many rows.
      | . + ([$r[] | select($call[.judge_call] != null)] as $j | [$j[] | $call[.judge_call].duration_ms | numbers] as $d
             | {p50_ms: ($d | quantile(0.5)), p95_ms: ($d | quantile(0.95)),
                cost_per_verdict: (if ($j | length) == 0 then null else
                  (([$j[] | ($call[.judge_call].cost_usd // 0) / $share[.judge_call]] | add) / ($j | length) * 10000 | round) / 10000 end)});

  # One row of the verdict list: what the judge said, and what became of it in plain words.
  def listed: {id, project, question, rule, type, level, level_raised, human_only, call: .judge_call, judge: .want, reason, evidence,
        said: (if .kind == "error" then "error" elif .live then "answered"
               elif .kind == "answer" then "would answer" else "passed" end),
        you: (if .outcome == "pending" then "pending" elif .live and .outcome == "tp" then "kept"
              elif .live and .human == "none" then "not reviewed" else .human end),
        score: ({tp: "right", tn: "right", fp: "wrong", fn: "needless", pending: "pending"}[.outcome // ""] // "-"),
        at: .e};

  # report($days): the report over the last $days days ("" for all of them). Everything above is
  # the same for every window, so kpi scores both of its windows from one build.
  def report($days):
  (if $days == "" then null else $now - ($days | tonumber) * 86400 end
     | if $wm > 0 and (. == null or . < $wm) then $wm else . end) as $since
  | def inscope($agent): .e as $e
      | ($since == null or ($e != null and $e >= $since))
        and ($any == 1 or current($agent; ($call[.judge_call // ""] // {}).prompt_sha // "")
             or ((.judge_call // "") == "" and (($src[$agent] // "") | IN("triage-untouched", "plan-dispatched", "priority-kept", "sweep-untouched"))
                 and $since_sha[$agent] != null and $e != null and $e >= $since_sha[$agent]));
  {at: $now, scope: {prompt: (if $any == 1 then "any" else "current" end), days: (if $days == "" then null else ($days | tonumber) end)},
   agents: [($want | split(" "))[] as $ag
     | ($lane[$ag] // [] | map(select(inscope($ag)))) as $mine
     | ($calls | map(select(.agent == $ag and (.e as $e | $since == null or ($e != null and $e >= $since))
                            and ($any == 1 or current($ag; .prompt_sha // ""))))) as $cl
     | ($src[$ag] // "") as $sc
     | (if $sc == "ask-answers" then $live elif $sc == "dispatch-queue" then ["*"] else [] end) as $lv
     # The word a score cell puts after its percent; a lane with no counted outcome has none.
     | ({"ask-answers": "agree", "dispatch-queue": "merged", "triage-untouched": "untouched",
         "plan-dispatched": "dispatched", "priority-kept": "kept", "sweep-untouched": "untouched"}[$sc]) as $lb
     | {agent: $ag, prompt_sha: ($shas[$ag] // [] | join(" ")), score: $sc,
        truth: ({"ask-answers": "the human answer to the ask, and the review of a live answer (kept or another option; none is not scored)",
                 "dispatch-queue": "the queue item a dispatched row became: done ok landed, failed or cancelled did not; a skip is a false defer when the row is then started by hand",
                 "triage-untouched": "the ingest record: a filed row is right when nothing edits, drops, moves or re-tags it for \($settle / 3600)h",
                 "plan-dispatched": "the ingest record and the queue: a planned row is right when it starts before anyone re-splits it",
                 "sweep-untouched": "the ingest record: a row the sweep model filed is right when nothing edits, drops, moves or re-tags it for \($settle / 3600)h",
                 "priority-kept": "the ingest record: a priority the pass set is right when nobody else changes the priority of the row for \($settle / 3600)h",
                 "unrecorded": "not recorded: the lane leaves no counted outcome, so only its calls show"}[$sc]
               // "unknown SCORE \($sc | tojson): judges.md lists the truth sources"),
        live: $lv,
        calls: {n: ($cl | length), errors: ($cl | map(select((.exit // 0) != 0 or .is_error == true)) | length),
                p50_ms: ([$cl[].duration_ms | numbers] | quantile(0.5)), p95_ms: ([$cl[].duration_ms | numbers] | quantile(0.95)),
                cost_usd: (($cl | map(.cost_usd // 0) | add // 0) * 10000 | round / 10000)},
        total: ($mine | stats),
        rules: ($mine | group_by(.rule) | map(.[0].rule as $rl | stats + {rule: $rl,
                  live: any($lv[]; . == "*" or startswith($rl + "@"))})
                | sort_by(-.verdicts)),
        misses: ($mine | map(select(.outcome == "fp")) | sort_by(-(.answered_at // .at | epoch // 0)) | .[0:$nmiss]
                 | map({id, project, question, judge: .want, reason, answer: .human, rule,
                        answered_at: (.answered_at // .at | epoch)}))}
       # What the human reads rather than a score, so every prompt counts: a policy change must
       # not empty the list or reset the week. score_7d is the week as the Workers score cell and
       # the day-log rollup show it, a percent only from AGENT_ASK_LIVE_BAR rows; the runner_score KPI counts the
       # current prompt only.
       + (($lane[$ag] // []) as $every
          | ($every | map(select((.e // 0) >= $now - 7 * 86400)) | stats) as $wk
          | ($wk.tp + $wk.fp) as $n
          | {week: $wk,
             score_7d: {window: "7d", right: $wk.tp, n: $n, pending: $wk.pending,
                        value: (if $lb != null and $n >= $bar then $wk.precision else null end),
                        text: (if $lb == null then "-" elif $n < $bar then "n<\($bar)"
                               else "\($wk.precision | round)% \($lb)" end),
                        title: (if $lb == null then "\($sc): no counted outcome"
                                else "7d, \($wk.tp) of \($n) right, \($wk.pending) pending, \($sc)"
                                     + (if $n < $bar then "; a percent at \($bar) rows" else "" end) end)}}
          + (if $src[$ag] != "ask-answers" then {} else
             {verdicts: ($every | map(select($since == null or (.e // 0) >= $since))
               | sort_by(-(.e // 0)) | .[0:$nverdicts] | map(listed)),
              # One cell per type and impact level, in scope: what a promotion is weighed on. A
              # live cell counts only reviewed answers (`audited`), never silence.
              cells: ($mine | map(select(.kind != "error")) | group_by([.type, .level])
                | map(.[0] as $c | stats + {type: $c.type, level: $c.level,
                    live: any($lv[]; . == "*" or . == "\($c.type)@\($c.level)"),
                    audited: (map(select(.live and (.outcome | IN("tp", "fp")))) | length),
                    level_raised_pct: pct(map(select(.level_raised)) | length; length)})
                | sort_by(.type, (.level as $l | $levels | index($l) // -1)))} end))]};'

# report <json>: the table, one block per agent.
report() {
  jq -r '
    def n: if . == null then "-" else tostring end;
    def p: if . == null then "-" else "\(.)%" end;
    def ms: if . == null then "-" else "\(. / 100 | round / 10)s" end;
    def money($d): if . == null then "-" else (pow(10; $d)) as $m | (. * $m | round) as $c
      | "$\($c / $m | floor).\($c % $m | tostring | if length < $d then "0" * ($d - length) + . else . end)" end;
    def pad($w): tostring | if length >= $w then .[0:$w] else . + " " * ($w - length) end;
    def lpad($w): tostring | if length >= $w then . else " " * ($w - length) + . end;
    def row($name): "  " + ($name | pad(15)) + (.verdicts | lpad(6)) + (.errors | lpad(5)) + (.coverage | p | lpad(7))
      + (.scored | lpad(7)) + ((.precision | p) + (if .precision == null then "" else " [\(.precision_lo)-\(.precision_hi)]" end) | lpad(18))
      + (.false_defer_pct | p | lpad(8)) + (.kappa | n | lpad(7)) + (.p95_ms | ms | lpad(7)) + (.cost_per_verdict | money(3) | lpad(7));
    "scope: \(.scope.prompt) prompt\(if .scope.days then ", last \(.scope.days) days" else "" end)",
    (.agents[] | "",
      "\(.agent)  prompt \(.prompt_sha | if . == "" then "none" else split(" ") | map(.[0:7]) | join(",") end)  live: \(if .live == ["*"] then "every rule" elif .live == [] then "none" else .live | join(", ") end)",
      "  truth: \(.truth)",
      "  calls \(.calls.n), \(.calls.errors) failed, p50 \(.calls.p50_ms | ms), p95 \(.calls.p95_ms | ms), \(.calls.cost_usd | money(2))",
      (if .total.assumed > 0 then "  assumed \(.total.assumed), \(.total.assumed_overridden) overridden" else empty end),
      (if .total.verdicts == 0 then "  no verdicts in scope" else
        "  " + ("rule" | pad(15)) + ("verd" | lpad(6)) + ("err" | lpad(5)) + ("cover" | lpad(7)) + ("scored" | lpad(7))
          + ("precision [95%]" | lpad(18)) + ("f-defer" | lpad(8)) + ("kappa" | lpad(7)) + ("p95" | lpad(7)) + ("$/v" | lpad(7)) + "  live",
        (.rules[] | row(if .rule == "" then "(no rule)" else .rule end)
           + "  " + (if .live then "live" else "shadow" end)),
        (.total | row("all")),
        # The share no human answer can label, and why: a lane mostly unscorable never earns a score.
        (.total | select(.unscorable > 0) | "  unscorable \(.unscorable) of \(.verdicts - .errors) (\(.unscorable_pct)%): "
           + (.unscorable_by | to_entries | sort_by(-.value, .key) | map("\(.value) \(.key)") | join(", "))) end),
      (if (.misses | length) > 0 then "  wrong answers, newest first:",
        (.misses[] | "    \(.id | .[0:24])  \(.project)  judge \(.judge | .[0:24])  truth \(.answer | .[0:24])  \(.question | .[0:60])") else empty end))' <<<"$1"
}

# kpi_json: {kpi: {"7d": v, "28d": v}} for fleet-bench, as comms-lint kpi gives its own. Both windows
# are scored from one read of the sources and one build of the verdicts, inside one jq.
kpi_json() {
  local tmp rc=0
  tmp="$(mktemp -d)" || return 1
  eval_collect "$tmp"
  VERDICTS=0 eval_jq "$tmp" "$AGENTS" 1 "" "$JQ_KPI" --argjson min "$KPI_LABELS" --argjson need "$AGENT_ASK_LIVE_BAR" || rc=$?
  rm -rf "$tmp"
  return "$rc"
}

# JQ_KPI: the KPIs of both windows, appended to JQ_EVAL.
# shellcheck disable=SC2016
JQ_KPI='
    def fdefer: if .fn + .tn >= $min then .false_defer_pct else null end;
    def k: {judge_errors: ([.agents[] | if .score == "unrecorded" then .calls.errors else .total.errors end] | add),
            judge_precision: ([.agents[] | select(.score | IN("ask-answers", "dispatch-queue")) | .rules[]
              | select(.tp + .fp >= $min) | .precision] | min),
            ask_answered_pct: (.agents[] | select(.score == "ask-answers") | .total.live_pct),
            # The share of human-only verdicts the judge answered itself: never, by the rule and
            # the flag check in live_answer, so any one is a trip.
            judge_human_only_live_pct: (.agents[] | select(.score == "ask-answers") | .total
              | if .human_only > 0 then (.human_only_live * 1000 / .human_only | round) / 10 else null end),
            # The share of judged asks a human-stop rule sent to the human; read, no bar of its own.
            ask_human_only_pct: (.agents[] | select(.score == "ask-answers") | .total
              | if .verdicts - .errors > 0 then (.human_only * 1000 / (.verdicts - .errors) | round) / 10 else null end),
            ask_unclear_pct: (.agents[] | select(.score == "ask-answers") | .total as $t
              | (.rules | map(select(.rule == "unclear-ask") | .verdicts) | add // 0) as $u
              | if $t.verdicts - $t.errors > 0 then ($u * 1000 / ($t.verdicts - $t.errors) | round) / 10 else null end),
            dispatch_false_defer_pct: ([.agents[] | select(.score == "dispatch-queue") | .total | fdefer] | .[0])}
         # A runner lane scores from AGENT_ASK_LIVE_BAR rows: below it a single miss swings the number.
         + ([.agents[] | select(.score | IN("triage-untouched", "plan-dispatched", "priority-kept", "sweep-untouched"))
             | {("runner_score_" + (.agent | gsub("-"; "_"))): (if (.total.tp + .total.fp) >= $need then .total.precision else null end)}]
            | add // {});
  (report("7") | k) as $x | (report("28") | k) as $y | $x | keys_unsorted | map({(.): {"7d": $x[.], "28d": $y[.]}}) | add'

# log [filter] [--level L] [--human-only] [--days N] [--limit N] [--json]: see the header.
log() {
  local said="" level="" ho=false days="" limit="$LOG_LIMIT" json=0 out
  while [ $# -gt 0 ]; do
    case "$1" in
      answered|would-answer|passed|wrong) said="$1"; shift ;;
      --level) [[ " $JUDGE_LEVELS " == *" ${2:-x} "* ]] || { say "--level takes one of: $JUDGE_LEVELS"; return 2; }; level="$2"; shift 2 ;;
      --human-only) ho=true; shift ;;
      --days) [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || { say "--days takes a day count"; return 2; }; days="$2"; shift 2 ;;
      --limit) [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || { say "--limit takes a count"; return 2; }; limit="$2"; shift 2 ;;
      --json) json=1; shift ;;
      *) say "usage: judge-eval log [answered|would-answer|passed|wrong] [--level L] [--human-only] [--days N] [--limit N] [--json]"; return 2 ;;
    esac
  done
  # Filtered before the limit, so the whole list is read rather than the dashboards' slice.
  out="$(VERDICTS=1000000 eval_json ask-judge 1 "$days" | jq -c --arg f "$said" --arg l "$level" --argjson ho "$ho" --argjson n "$limit" '
    .agents[0].verdicts | map(select($f == "" or (if $f == "wrong" then .score == "wrong"
      else .said == ($f | sub("-"; " ")) end)) | select($l == "" or .level == $l) | select(($ho | not) or .human_only)) | .[0:$n]')" || { say "could not read the sources"; return 1; }
  if [ "$json" = 1 ]; then printf '%s\n' "$out"; return; fi
  jq -r 'if length == 0 then "no verdicts" else .[] |
      "\(.at | if . then localtime | strftime("%m-%d %H:%M") else "-" end)  \(.project)  \(if .type == "" then .rule else .type end)  \(.said)  you: \(.you | .[0:40])  \(.score)",
      "    \(.question | .[0:100])",
      "    \(if .rule == "" then "" else .rule + ": " end)\(.reason)\(if .evidence == "" then "" else "  \"\(.evidence)\"" end)",
      "    level \(if .level == "" then "-" else .level end)\(if .level_raised then " (raised)" else "" end)\(if .human_only then "  human-only" else "" end)  call \(if .call == "" then "-" else .call end)" end' <<<"$out"
}

# ask_cells <any-prompt 0|1> <days or empty>: the answer judge's cells, as `cells --json` prints them.
ask_cells() { VERDICTS=0 eval_json ask-judge "$1" "$2" | jq -c '[.agents[] | select(.score == "ask-answers") | .cells[]]'; }

# cells [--any-prompt] [--days N] [--json]: see the header.
cells() {
  local any=0 days="" json=0 out
  while [ $# -gt 0 ]; do
    case "$1" in
      --any-prompt) any=1; shift ;;
      --days) [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || { say "--days takes a day count"; return 2; }; days="$2"; shift 2 ;;
      --json) json=1; shift ;;
      *) say "usage: judge-eval cells [--any-prompt] [--days N] [--json]"; return 2 ;;
    esac
  done
  out="$(ask_cells "$any" "$days")" ||
    { say "could not read the sources"; return 1; }
  if [ "$json" = 1 ]; then printf '%s\n' "$out"; return; fi
  jq -r 'def pad($w): tostring | if length >= $w then .[0:$w] else . + " " * ($w - length) end;
    def lpad($w): tostring | if length >= $w then . else " " * ($w - length) + . end;
    def p: if . == null then "-" else "\(.)%" end;
    if length == 0 then "no verdicts in scope" else
      ("type" | pad(24)) + ("level" | pad(9)) + ("verd" | lpad(5)) + ("scored" | lpad(7)) + ("precision [95%]" | lpad(18))
        + ("pend" | lpad(5)) + ("live" | lpad(5)) + ("audited" | lpad(8)) + ("raised" | lpad(7)),
      (.[] | (if .type == "" then "(no type)" else .type end | pad(24)) + (if .level == "" then "-" else .level end | pad(9))
        + (.verdicts | lpad(5)) + (.scored | lpad(7))
        + ((.precision | p) + (if .precision == null then "" else " [\(.precision_lo)-\(.precision_hi)]" end) | lpad(18))
        + (.pending | lpad(5)) + (if .live then "yes" else "no" end | lpad(5)) + (.audited | lpad(8)) + (.level_raised_pct | p | lpad(7))) end' <<<"$out"
}

# promote_json <any-prompt 0|1>: every rated shadow cell of the answer judge with its bar, its
# status (candidate, below, held) and why. The bars are the conf's; none set promotes nothing.
promote_json() {
  local bars
  bars="$(jq -cn --arg s "$(judge_conf PROMOTE_BARS "" | tr ',' ' ')" --arg l "$JUDGE_LEVELS" '
    [$s | splits(" +") | select(test("^[a-z]+=[0-9]+$")) | split("=") | select(.[0] as $x | $l | split(" ") | index($x))
     | {(.[0]): (.[1] | tonumber)}] | add // {}')"
  # Demoted: in the demote list and still opened by a row, so deleting the line is all approval takes.
  ask_cells "$1" "" | jq -c --argjson bars "$bars" --arg hard "$JUDGE_HARD_STOPS" --argjson levels "$LEVELS_JSON" \
    --arg demoted " $(comm -12 <(cut -f1 "$AGENT_ASK_DEMOTED" 2>/dev/null | sort -u) <(AGENT_ASK_DEMOTED=/dev/null live_rules 2>/dev/null | sort -u) | tr '\n' ' ') " '
    [.[] | select(.type != "" and .level != "")] as $cells
    | ($cells | map({("\(.type)@\(.level)"): .}) | add // {}) as $by
    # A cell under its bar: no bar for its level, no right or wrong answer yet, or a low bound under it.
    | def under: ($bars[.level]) as $b | $b == null or (.tp + .fp) == 0 or (.precision_lo // 0) < $b;
    [$cells[] | select(.live | not) | . as $c
      | ($levels | index($c.level)) as $i
      | [$levels[0:$i][] | $by["\($c.type)@\(.)"] // empty | select((.live | not) and (.tp + .fp) > 0 and under)] as $narrow
      | {type, level, tp, fp, precision, precision_lo, precision_hi, bar: $bars[.level],
         demoted: ($demoted | contains(" \($c.type)@\($c.level) "))}
      | . + (if ($hard | split(" ") | index($c.type)) then {status: "held", why: "a hard stop: the human answers it by rule"}
             elif .bar == null then {status: "held", why: "no bar for \(.level): only the human promotes it"}
             elif ($c | under) then {status: "below", why: (if .tp + .fp == 0 then "no scored answers yet"
               else "low bound \(.precision_lo)% under the \(.bar)% bar" end)}
             elif ($narrow | length) > 0 then {status: "held", why: "the row would also open \($narrow | map(if $bars[.level] == null then "\(.level) (no bar)" else "\(.level) (low bound \(.precision_lo)%)" end) | join(", ")), under its bar"}
             else {status: "candidate", why: "low bound \(.precision_lo)% past the \(.bar)% bar over \(.tp + .fp) scored"} end)]'
}

# promote_ask <cell json>: one approval ask for a candidate cell, posted as a runner's ask (no
# session owns it, so the one-open-question rule never folds it into another). Prints its id.
promote_ask() {
  local type level tp n lo bar demoted approve ctx
  IFS=$'\t' read -r type level tp n lo bar demoted < <(jq -r '[.type, .level, .tp, .tp + .fp, .precision_lo, .bar, .demoted] | @tsv' <<<"$1")
  if [ "$demoted" = true ]; then
    approve="a session deletes the $type@$level line in the demote list, so the judge answers that cell on its own again"
  else
    approve="a session sets the $type row in DELAY_RULES to $type@$level by PR, or adds a row at $level above the type's existing one (a new row waits 0 minutes, an existing one keeps its wait)"
  fi
  ctx="DELAY_RULES is the table in ask-judge.conf (the private dotfiles) of the ask types the answer judge answers on its own, each up to an impact level (self: the asking session's own work; repo: one repo others rely on; a row at repo also answers self); $type is one of the policy's ask types. In shadow the judge only records what it would answer, and that cell's would-be answers matched yours on $tp of $n scored asks, a Wilson 95% lower bound of $lo%, past the $bar% bar for $level (PROMOTE_BARS in ask-judge.conf).$([ "$demoted" = true ] && printf ' The cell was demoted after overrides: its line is in %s.' "$AGENT_ASK_DEMOTED") Once live, 1 in N of its answers comes back to you as an audit (AUDIT_RATES), and enough overrides demote it again. Every answer it would have given: judge-eval log."
  ( unset CLAUDE_CODE_SESSION_ID CLAUDE_CODE_SESSION_ATTENDED TMUX TMUX_PANE
    cmd_post --project agent-runtime --agent judge-eval --kind approval \
      --task "promote ask-judge cell $type@$level" \
      --options "approve=$approve|hold=the cell stays shadow, asked again in $PROMOTE_QUIET_DAYS days if it still meets the bar" \
      --recommend approve --why "its would-be answers have a $lo% Wilson low bound over $n scored, past the $bar% bar for $level" \
      --context "$ctx" "Let the answer judge answer $type asks at $level level on its own?" )
}

# promote [--any-prompt] [--ask] [--json]: see the header.
promote() {
  local any=0 ask=0 json=0 out c task asked posted=0 failed=0 id
  while [ $# -gt 0 ]; do
    case "$1" in
      --any-prompt) any=1; shift ;;
      --ask) ask=1; shift ;;
      --json) json=1; shift ;;
      *) say "usage: judge-eval promote [--any-prompt] [--ask] [--json]"; return 2 ;;
    esac
  done
  # An ask quotes the bar's own precision, and --any-prompt mixes in answers the bar never saw.
  [ "$ask" = 1 ] && [ "$any" = 1 ] && { say "--ask reads only the current prompt's answers, not --any-prompt"; return 2; }
  out="$(promote_json "$any")" || { say "could not read the sources"; return 1; }
  if [ "$ask" = 1 ]; then
    # The cells already asked: a promotion ask pending, or answered or closed inside the quiet window.
    asked="$(judge_ask_docs "$ASKS_ROOT" | jq -r --argjson since "$(( $(date +%s) - PROMOTE_QUIET_DAYS * 86400 ))" "$JQ_EPOCH"'
      select((.task // "") | startswith("promote ask-judge cell "))
      | select(.status == "pending" or (([.answered_at, .closed_at] | map(epoch) | max) // 0) >= $since)
      | .task | ltrimstr("promote ask-judge cell ")')"
    while IFS= read -r c; do
      [ -n "$c" ] || continue
      task="$(jq -r '"\(.type)@\(.level)"' <<<"$c")"
      grep -qxF -- "$task" <<<"$asked" && { say "$task: already asked"; continue; }
      if id="$(promote_ask "$c" </dev/null)" && [ -n "$id" ]; then say "$task: asked $id"; posted=$((posted + 1))
      else say "$task: the ask did not post"; failed=$((failed + 1)); fi
    done < <(jq -c '.[] | select(.status == "candidate")' <<<"$out")
    say "posted $posted promotion ask(s)$([ "$failed" = 0 ] || echo ", $failed failed")"
    [ "$failed" = 0 ]; return
  fi
  if [ "$json" = 1 ]; then printf '%s\n' "$out"; return; fi
  jq -r 'def pad($w): tostring | if length >= $w then .[0:$w] else . + " " * ($w - length) end;
    def lpad($w): tostring | if length >= $w then . else " " * ($w - length) + . end;
    if length == 0 then "no shadow cells in scope" else
      ("type" | pad(24)) + ("level" | pad(9)) + ("right" | lpad(7)) + ("precision [95%]" | lpad(18)) + ("bar" | lpad(5)) + "  status",
      (sort_by(.status != "candidate", .status != "below") | .[] | (.type | pad(24)) + (.level | pad(9)) + ("\(.tp)/\(.tp + .fp)" | lpad(7))
        + ((if .precision == null then "-" else "\(.precision)% [\(.precision_lo)-\(.precision_hi)]" end) | lpad(18))
        + ((if .bar == null then "-" else "\(.bar)%" end) | lpad(5))
        + "  \(.status)\(if .demoted then " (demoted)" else "" end): \(.why)") end' <<<"$out"
}

# conf_var <lane> <VAR>: one variable of a lane's conf.
conf_var() { ( . "$CONF_DIR/$1.conf" 2>/dev/null; printf '%s' "${!2:-}" ); }

# The settings of a conf that are not gates: what makes it a runner (what it is, when it runs, what
# it costs). Every other setting of a calling runner's conf is a gate its calls obey.
RUNNER_KEYS=' NAME KIND SCOPE AUTOSTART ENABLED DESCRIPTION SKILL EFFECT LANE DETAIL COMMAND SCHEDULE INBOX
  ROLE PRIORITY TIER OVERSEES HARNESS MODEL ROUTE DATA_CLASS CALL_CONTEXT SCORE PROMPT SCHEMA CALLER
  BUDGET_CALL_USD BUDGET_DAY_USD MAX_CALLS_HOUR '
# The settings of a judge's own conf that gate what its verdict does.
LANE_GATE_VARS='DELAY_RULES AUDIT_RATES PROMOTE_BARS PRECEDENTS'
# The data files a calling runner's decisions read, colon-separated, by caller (JUDGE_EVAL_GATE_FILES_<CALLER>,
# hyphens to underscores): fleet-dispatch reads its kind and class registries.
: "${JUDGE_EVAL_GATE_FILES_FLEET_DISPATCH:=${DISPATCH_KINDS:-$HOME/.config/fleet-dispatch/kinds.json}:${DISPATCH_CLASSES:-$HOME/.config/fleet-dispatch/classes.json}:${DISPATCH_WORKERS:-$HOME/.config/fleet-dispatch/workers.json}}"
# The directories a lane is called from, colon-separated: this script's directory and its lib.
BIN_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
: "${JUDGE_EVAL_CALL_DIRS:=$BIN_DIR:$BIN_DIR/../lib}"

# prompt_lanes: every runner conf that names a SCORE or a PROMPT, one per line: a lane as judges.md
# defines it, the rule hub-core's Conf::instructed also reads.
prompt_lanes() {
  local c a
  for c in "$CONF_DIR"/*.conf; do
    [ -f "$c" ] || continue
    a="$(basename "$c" .conf)"
    [ -n "$(conf_var "$a" SCORE)$(conf_var "$a" PROMPT)" ] && printf '%s\n' "$a"
  done
}

# prompt_lane <lane>: the lane's full instruction set on stdout, its problems on stderr; 1 when any.
prompt_lane() {
  local a="$1" conf="$CONF_DIR/$1.conf" prompt schema caller cc gates f p k l v sites rc=0 body gf
  local -a files
  prompt="$(conf_var "$a" PROMPT)"; schema="$(conf_var "$a" SCHEMA)"; caller="$(conf_var "$a" CALLER)"
  printf '=== %s ===\n' "$a"
  # the conf's own header: its leading comment block
  awk '/^#/ { sub(/^# ?/, ""); print; next } { exit }' "$conf"
  printf 'model: %s\nscored by: %s\nrole: %s\n' "$(conf_var "$a" MODEL)" "$(conf_var "$a" SCORE | sed 's/^$/(not scored)/')" "$(conf_var "$a" ROLE)"
  if [ -z "$prompt" ]; then
    say "$a: its conf names no PROMPT"; rc=1
  else
    IFS=: read -ra files <<<"$prompt"
    for p in "${files[@]}"; do
      if body="$(prompt_expand "$p" 2>/dev/null && printf x)"; then
        printf '\n--- PROMPT %s (sha %s) ---\n%s\n' "$p" "$(prompt_sha "$p")" "${body%x}"
      else
        say "$a: PROMPT=$p is not a readable file"; rc=1
      fi
    done
  fi
  if [ -n "$schema" ]; then
    if [ -r "$schema" ]; then printf '\n--- SCHEMA %s ---\n%s\n' "$schema" "$(cat -- "$schema")"
    else say "$a: SCHEMA=$schema is not a readable file"; rc=1; fi
  fi
  # the values as the conf sets them (a wrapped value is whole), not its first physical line
  gates=""
  for k in $LANE_GATE_VARS; do
    v="$(conf_var "$a" "$k")"; [ -n "$v" ] && gates+="${gates:+$'\n'}$k=\"$v\""
  done
  [ -n "$(conf_var "$a" DELAY_RULES)" ] && gates+="${gates:+$'\n'}JUDGE_HARD_STOPS=\"$JUDGE_HARD_STOPS\""
  printf '\n--- gates in %s.conf ---\n%s\n' "$a" "${gates:-none}"
  if [ -n "$caller" ] && [ ! -f "$CONF_DIR/$caller.conf" ]; then
    printf '\n--- gates in %s.conf (its caller) ---\nno conf named %s (it is a script)\n' "$caller" "$caller"
  fi
  if [ -n "$caller" ] && [ -f "$CONF_DIR/$caller.conf" ]; then
    cc="$(grep -E '^[A-Z][A-Z0-9_]*=' "$CONF_DIR/$caller.conf" | while IFS= read -r l; do
      k="${l%%=*}"; [[ "$RUNNER_KEYS" == *[[:space:]]"$k"[[:space:]]* ]] || printf '%s\n' "$l"; done)"
    printf '\n--- gates in %s.conf (its caller) ---\n%s\n' "$caller" "${cc:-none}"
  fi
  if [ -n "$caller" ]; then
    gf="JUDGE_EVAL_GATE_FILES_$(tr 'a-z-' 'A-Z_' <<<"$caller")"
    IFS=: read -ra files <<<"${!gf:-}"
    for f in "${files[@]}"; do
      [ -n "$f" ] || continue
      if [ -r "$f" ]; then printf '\n--- %s ---\n%s\n' "$f" "$(cat -- "$f")"
      else say "$a: gate file $f is not readable"; rc=1; fi
    done
  fi
  # where the call's input is built: the lines that name this lane, and the lines that run the command
  # variable such a line sets (`: "${AGENT_ASK_JUDGE_CMD:=agentctl-run --agent ask-judge}"`)
  printf '\n--- called from ---\n'
  IFS=: read -ra files <<<"$JUDGE_EVAL_CALL_DIRS"
  sites="$(grep -rnE -- "--agent[ =]\"?$a([^a-z0-9-]|\$)" "${files[@]}" 2>/dev/null | grep -v -e '/agentctl-run:' -e '/judge-eval:')"
  {
    if [ -z "$sites" ]; then echo "(none found)"
    else printf '%s\n' "$sites" | awk -v n=8 'NR <= n { print } END { if (NR > n) print "(" NR - n " more not shown)" }'; fi
    while IFS=: read -r f _ l; do
      [ -n "$f" ] || continue
      v="$(sed -n 's/^: "\${\([A-Z_]*\):=agentctl-run --agent .*/\1/p' <<<"$l")"
      [ -n "$v" ] && grep -nE "[$][{(]?$v([^A-Z_:=]|\$)" "$f" | grep -v ':= *agentctl-run' | awk 'NR <= 4' | sed "s#^#$f:#"
    done <<<"$sites"
  } | sed 's#^.*/\(\.local/\)#\1#' | cut -c1-200
  printf '\n'
  return "$rc"
}

# prompts [lane|--all]: see the header.
prompts() {
  local lanes a rc=0
  local -a want=()
  lanes="$(prompt_lanes)"
  [ -n "$lanes" ] || { say "no runner conf in $CONF_DIR names a SCORE or a PROMPT"; return 1; }
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) shift ;;
      -*) say "usage: judge-eval prompts [lane|--all]"; return 2 ;;
      *) grep -qxF -- "$1" <<<"$lanes" || { say "no lane '$1' (lanes: $(tr '\n' ' ' <<<"$lanes"))"; return 2; }
         want+=("$1"); shift ;;
    esac
  done
  [ "${#want[@]}" -gt 0 ] || mapfile -t want <<<"$lanes"
  for a in "${want[@]}"; do prompt_lane "$a" || rc=1; done
  return "$rc"
}

main() {
  local want="" any=0 days="" json=0 a
  if [ "${1:-}" = log ]; then shift; log "$@"; return; fi
  if [ "${1:-}" = cells ]; then shift; cells "$@"; return; fi
  if [ "${1:-}" = promote ]; then shift; promote "$@"; return; fi
  if [ "${1:-}" = prompts ]; then shift; prompts "$@"; return; fi
  if [ "${1:-}" = kpi ]; then
    shift
    case "${1:-}" in --json) kpi_json ;; "") kpi_json | jq -r 'to_entries[] | "\(.key)\t7d \(.value["7d"] // "-")\t28d \(.value["28d"] // "-")"' ;;
      *) say "usage: judge-eval kpi [--json]"; return 2 ;; esac
    return
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) want="$AGENTS"; shift ;;
      --any-prompt) any=1; shift ;;
      --days) [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || { say "--days takes a day count"; return 2; }; days="$2"; shift 2 ;;
      --json) json=1; shift ;;
      -h|--help) sed -n '2,/^$/{s/^# \{0,1\}//;p}' "$0"; return 0 ;;
      -*) say "unknown option $1"; return 2 ;;
      *) for a in $AGENTS; do [ "$1" = "$a" ] && want="$want $a"; done
         [[ " $want " == *" $1 "* ]] || { say "no scored lane '$1' (lanes: $AGENTS)"; return 2; }; shift ;;
    esac
  done
  local out
  want="${want# }"
  out="$(eval_json "${want:-$AGENTS}" "$any" "$days")" || { say "could not read the sources"; return 1; }
  if [ "$json" = 1 ]; then printf '%s\n' "$out"; else report "$out"; fi
}

main "$@"
