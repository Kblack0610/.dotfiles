#!/usr/bin/env bash
# judge-eval - every judge lane scored against its ground truth, per rule, under its current prompt.
#
#   judge-eval [lane|--all] [--any-prompt] [--days N] [--json]
#       one scored lane (a runner conf with SCORE=) or all of them (the default): per lane and rule the
#       verdicts, errors, coverage, scored, precision with its 95% interval, false-defer %, kappa,
#       p95 and cost per verdict, the live rules and each shadow rule's distance to the bar.
#       --any-prompt counts verdicts under every prompt; --days keeps the last N days.
#   judge-eval kpi [--json]
#       fleet-bench's judge KPIs over 7 and 28 days, every prompt.
#   SENTINEL_SINCE (an epoch, set by a Sentinel probe) starts every window no earlier than a watch's fix.
#   judge-eval log [answered|would-answer|passed|wrong] [--level L] [--days N] [--limit N] [--json]
#       the answer judge's verdicts, newest first and under any prompt: what it said, why, the
#       quote behind it, its impact level, its call id (calls.jsonl .raw) and what you did. The
#       same rows reach Log's Judges' verdicts section.
#   judge-eval cells [--any-prompt] [--days N] [--json]
#       the answer judge per type and impact level (self, repo, fleet, critical): verdicts, scored,
#       precision with its 95% interval, pending, whether the type is live, the live answers you
#       reviewed, and how often a floor raised the judge's level. A live answer you never reviewed
#       is not scored, so silence never counts as agreement.
#
#   judge-eval replay [--limit N] [--out DIR] [--json]
#       the answer judge's current policy over the asks the human answered with an option, newest
#       first: the real `agent-ask judge` on blind copies, by its own agent `ask-judge-replay`,
#       then the usual ask-judge report on the copies. --out keeps them.
#
# Read-only: replay works on copies and spends a model call per ask. The standard, each lane's
# truth and the formulas: ~/.local/src/docs/judges.md.

set -uo pipefail

# agent-ask's helpers (ask root, named_option, live_rules) and its live bar, the one bar for every
# lane; judge.sh comes with it (judge_ask_docs, the calls.jsonl path).
# shellcheck source=agent-ask
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/agent-ask"
# shellcheck source=../lib/end-reasons.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/end-reasons.sh"

: "${FLEET_DISPATCH_DIR:=$HOME/.agent/dispatch}"
: "${JUDGE_EVAL_QUEUE_CMD:=agent-queue list --json --state all}"
# The notes ingest record: what became of each row a runner wrote (its 30 days are all it keeps).
: "${JUDGE_EVAL_INGEST_CMD:=notes log --json --days 30}"
# replay's judge, and what it must not see of an ask: every field the human's answer left on it.
: "${JUDGE_EVAL_REPLAY_CMD:=agentctl-run --agent ask-judge-replay}"
: "${JUDGE_EVAL_REPLAY_JOBS:=4}"
: "${JUDGE_EVAL_BLIND_FIELDS:=answer answered_at answered_by answer_note assume_at assume_answer assume_disarmed resume resumed_at closed_at closed_reason}"
CONF_DIR="${AGENTCTL_CONF_DIR:-$HOME/.config/agentctl/agents}"
# How long a runner's write stands before it counts as right: a filed row untouched, a skipped row
# not started by hand.
SETTLE_H=48
# A row the ask-sweep model filed carries its quote: ask-sweep file_row writes `<row>; asked MM-DD "<quote>"`.
SWEEP_ROW_RE='; asked [0-9]{2}-[0-9]{2} "'
# judge_precision counts only rules with this many scored answers, and a false-defer percent only lanes
# with this many scored defers: below it one miss swings 10+ points.
KPI_LABELS=10
# A Sentinel probe's fix watermark (watch-companion-loop resolve), an epoch, 0 for none: a window starts
# at the later of its own start and this, so a fixed red stops counting the verdicts before its fix.
WATERMARK=0; [[ "${SENTINEL_SINCE:-}" =~ ^[0-9]+$ ]] && WATERMARK="$SENTINEL_SINCE"
MISSES=10
# Verdicts one read carries to the dashboards: about a week of asks, so a filter still has rows.
VERDICTS=200
LOG_LIMIT=50

say() { printf 'judge-eval: %s\n' "$*" >&2; }

# prompt_sha <agent>: the git blob hash of its conf's PROMPT now, as agentctl-run records it.
prompt_sha() {
  local p
  p="$( . "$CONF_DIR/$1.conf" 2>/dev/null; printf '%s' "${PROMPT:-}")"
  [ -n "$p" ] && [ -r "$p" ] && git hash-object "$(readlink -f "$p")" 2>/dev/null
}

# The scored lanes, the registry: every runner conf that names a SCORE.
# SCORES is {lane: its conf's SCORE, the truth source it is scored by (judges.md)}.
SCORES="$(for c in "$CONF_DIR"/*.conf; do s="$( . "$c" 2>/dev/null; printf '%s' "${SCORE:-}")"
  [ -n "$s" ] && printf '%s\t%s\n' "$(basename "$c" .conf)" "$s"; done |
  jq -Rsc 'split("\n") | map(select(length > 0) | split("\t") | {(.[0]): .[1]}) | add // {}')"
AGENTS="$(jq -r 'keys | join(" ")' <<<"$SCORES")"

# eval_json <agents> <any-prompt 0|1> <days or empty> -> the whole report as one JSON object
eval_json() {
  local want="$1" any="$2" days="$3" shas="{}" src a sha tmp rc=0
  tmp="$(mktemp -d)" || return 1
  judge_ask_docs "$ASKS_ROOT" | jq -sc 'map(select((.judge // "") != ""))' > "$tmp/asks"
  zcat -f -- "$AGENTCTL_CALLS"* 2>/dev/null | jq -sc --arg a "$AGENTS" \
    '[.[] | objects | select(.agent as $x | $a | split(" ") | index($x))]' > "$tmp/calls" 2>/dev/null
  jq -sc '[.[] | objects]' "$FLEET_DISPATCH_DIR/verdicts.jsonl" > "$tmp/verdicts" 2>/dev/null
  $JUDGE_EVAL_QUEUE_CMD 2>/dev/null | jq -sc '[.[] | objects | select(((.from // "") | startswith("board:")) or .row != null)]' > "$tmp/queue" 2>/dev/null
  $JUDGE_EVAL_INGEST_CMD 2>/dev/null | jq -sc --arg sweepre "$SWEEP_ROW_RE" '[.[] | objects | select(.id != null) | select((.action | IN("filed", "planned", "edited",
    "dropped", "rehomed", "tagged", "dup")) or (.action == "added" and ((.text // "") | contains("#of/") or test($sweepre))))
    | {ts, action, id, by, from, to, text, why}]' > "$tmp/ingest" 2>/dev/null
  for a in asks calls verdicts queue ingest; do [ -s "$tmp/$a" ] || echo '[]' > "$tmp/$a"; done
  jq -c '.[]' "$tmp/asks" > "$tmp/asklines"
  answer_picks "$(cat "$tmp/asklines")" > "$tmp/picks"
  src="$(jq -c --arg a "$AGENTS" '. as $m | $a | split(" ") | map({(.): ($m[.] // "")}) | add // {}' <<<"$SCORES")"
  for a in $AGENTS; do
    sha="$(prompt_sha "$a")"
    shas="$(jq -c --arg a "$a" --arg s "${sha:-}" '. + {($a): $s}' <<<"$shas")"
  done
  jq -n --slurpfile A "$tmp/asks" --slurpfile C "$tmp/calls" --slurpfile V "$tmp/verdicts" \
    --slurpfile Q "$tmp/queue" --slurpfile P "$tmp/picks" \
    --slurpfile I "$tmp/ingest" --argjson src "$src" --argjson settle "$((SETTLE_H * 3600))" \
    --argjson shas "$shas" --arg sweepre "$SWEEP_ROW_RE" --argjson live "$(live_rules | jq -Rsc 'split("\n") | map(select(length > 0))')" \
    --arg want "$want" --argjson any "$any" --arg days "$days" --argjson now "$(date +%s)" --argjson wm "$WATERMARK" \
    --arg hard "$JUDGE_HARD_STOPS" --argjson unrated "$(unrated_json)" --argjson levels "$(jq -cn --arg l "$JUDGE_LEVELS" '$l | split(" ")')" \
    --argjson bar "$AGENT_ASK_LIVE_BAR" --argjson barp "$AGENT_ASK_LIVE_PRECISION" --argjson nmiss "$MISSES" --argjson nverdicts "$VERDICTS" \
    '$A[0] as $asks | $C[0] as $calls | $V[0] as $verdicts | $Q[0] as $queue | $P[0] as $picks | '"$JQ_EVAL" || rc=$?
  rm -rf "$tmp"
  return "$rc"
}

# JQ_EVAL: the scoring, over the slurped sources above.
# shellcheck disable=SC2016
JQ_EVAL="$JQ_EPOCH"'
  def pct($a; $b): if $b > 0 then ($a * 1000 / $b | round) / 10 else null end;
  def quantile($q): sort | if length == 0 then null else .[((length - 1) * $q) | floor] end;
  # Wilson score interval, 95%, for k right of n, in percent.
  def wilson($k; $n): if $n == 0 then [null, null] else
    ($k / $n) as $p | 3.8416 as $z2 | (1 + $z2 / $n) as $d
    | (($p + $z2 / (2 * $n)) / $d) as $c | (((($p * (1 - $p) / $n) + $z2 / (4 * $n * $n)) | sqrt) * 1.96 / $d) as $h
    | [(($c - $h) * 1000 | round) / 10 | if . <= 0 then 0 else . end, (($c + $h) * 1000 | round) / 10 | if . > 100 then 100 else . end] end;
  def bykey(f): group_by(f) | map({((.[0] | f)): .}) | add // {};
  def kappa: (.tp + .fp + .fn + .tn) as $n | if $n == 0 then null else
    ((.tp + .tn) / $n) as $po | (((.tp + .fp) * (.tp + .fn) + (.fn + .tn) * (.fp + .tn)) / ($n * $n)) as $pe
    | if $pe >= 1 then null else ((($po - $pe) / (1 - $pe)) * 100 | round) / 100 end end;

  $I[0] as $ingest
  # Each truth source scores the lane whose conf names it in SCORE=.
  | ($src | to_entries | map({(.value): .key}) | reverse | add // {}) as $by
  | ($calls | map({(.id): .}) | add // {}) as $call
  | (if $days == "" then null else $now - ($days | tonumber) * 86400 end
     | if $wm > 0 and (. == null or . < $wm) then $wm else . end) as $since
  # A row the ingest record scores has no call of its own: it is under the current prompt when
  # written after the first call made with it since the last call under another prompt.
  | ($calls | map(select((.prompt_sha // "") != "") | {agent, s: .prompt_sha, e: (.at | epoch)} | select(.e != null))
     | group_by(.agent) | map(.[0].agent as $a | ([.[] | select(.s != ($shas[$a] // "")) | .e] | max) as $other
       | {($a): ([.[] | select(.s == ($shas[$a] // "") and ($other == null or .e > $other)) | .e] | min)})
     | add // {}) as $since_sha
  | def inscope($agent): (.at | epoch) as $e
      | ($since == null or ($e != null and $e >= $since))
        and ($any == 1 or (($call[.judge_call // ""] // {}).prompt_sha // "") == ($shas[$agent] // "-")
             or ((.judge_call // "") == "" and (($src[$agent] // "") | IN("triage-untouched", "plan-dispatched", "priority-kept", "sweep-untouched"))
                 and $since_sha[$agent] != null and $e != null and $e >= $since_sha[$agent]));

  # One verdict row each: {agent, id, project, question, rule, type, kind (answer|defer|error),
  # live, want, outcome (tp|fp|fn|tn|pending|unscorable), unscorable (why, on an unscorable one),
  # human, reason, evidence, at, call}. The human label of an ask with options is the option its
  # answer names (answer_picks); a free-text ask keeps its answer unless a session typed it.
  [$asks[] | select(.judge_rule != "gate" or (.judge_call // "") != "")
    | . as $a | ($a.judge | if . == "human" then "defer" elif . == "error" then "error" else "answer" end) as $kind
    | (if $a.judge == "take-recommend" then $a.recommend // "" else ($a.judge | ltrimstr("answer:")) end) as $want
    | ($picks[$a.id] // (if ($a.options // "") != "" or (($a.answer // "") | startswith("in session:")) then null else $a.answer end)) as $human
    # Why the human answer cannot label this verdict, or null; the outcome below is unscorable on it.
    | (if $a.status != "answered" then "\($a.status // "closed") unanswered"
       elif ($a.answered_by // "human") != "human" then "answered by the \($a.answered_by)"
       elif $human == null then (if ($a.options // "") == "" then "free text in session" else "answer naming no option" end)
       elif $kind == "answer" then null
       elif ($a.judge_rule // "") == "unclear-ask" then "unclear ask"
       elif any($a.judge_type, $a.judge_rule; IN(($hard | splits(" +"))) and . != "") then "hard stop"
       elif ($a.judge_type // "") == "" then "untyped deferral"
       elif ($a.recommend // "") == "" then "no recommendation" else null end) as $why
    | {agent: $by["ask-answers"], id: $a.id, project: $a.project, question: $a.question, rule: ($a.judge_rule // ""),
       type: ($a.judge_type // ""), level: ($a.judge_level // ""), level_raised: ($a.judge_level_raised == "true"),
       kind: $kind, live: ($a.answered_by == "judge"),
       assumed: ($a.answered_by == "judge" and ($a.assume_at // "") != ""), want: $want,
       human: (if $a.answered_by == "judge" then $a.judge_override // "" else $human // $a.answer // "" end),
       reason: ($a.judge_reason // ""), evidence: ($a.judge_evidence // ""),
       at: $a.judged_at, answered_at: $a.answered_at, judge_call: ($a.judge_call // ""),
       outcome: (if $kind == "error" then null
         # A live answer is right only when the human named its option (`kept`): `none` is a
         # message that named no option, silence, which must never count as agreement.
         elif $a.answered_by == "judge" then
           ({"": "pending", kept: "tp", none: "unscorable"}[$a.judge_override // ""] // "fp")
         elif $a.status == "pending" then "pending"
         elif $why != null then "unscorable"
         elif $kind == "answer" then (if ($human | ascii_downcase) == ($want | ascii_downcase) then "tp" else "fp" end)
         elif ($human | ascii_downcase) == ($a.recommend | ascii_downcase) then "fn" else "tn" end)}
    | . + {unscorable: (if .outcome != "unscorable" then null elif .live then "live answer not reviewed" else $why end)}] as $askrows
   # Dispatch: an error line is one verdict each (the row is judged again); otherwise the newest
   # verdict per row, labelled by its queue item: done ok landed, done otherwise or a later
   # `failed` line did not. A run that ended for a cause outside the model (UNRATED_ENDS) labels
   # nothing, and a `failed` line a later `cleared` released does not count (later in the file, as
   # judged_keys in fleet-dispatch reads it; group_by keeps file order within a key).
   | ($verdicts | map(select(.verdict == "failed" or .verdict == "cleared"))
      | map({key: "\(.project)\u0000\(.key)", verdict, e: (.at | epoch)}) | group_by(.key)
      | map(last | select(.verdict == "failed") | {(.key): .e}) | add // {}) as $failed
   | ($queue | map(select((.from // "") | startswith("board:")))
      | map({key: (.from | ltrimstr("board:")),
             value: (.state + "/" + (if .status != "ok" and ((.end_reason // "") | IN($unrated[])) then "unrated" else .status // "" end))})
      | from_entries) as $item
   # Every start of a queue item, keyed by its board row; run is fleet-dispatch, resume a restore.
   | ($queue | map(select(.started != null) | {key: (.row // (.from | ltrimstr("board:"))), e: (.started | epoch), origin})) as $starts
   | ($starts | bykey(.key)) as $startsby | ($starts | bykey(.key | split(":") | last)) as $startsbyid
   # The ingest record, each event with its epoch. The planner writes in the minute up to its
   # `planned` record on the row, and those writes touch nothing.
   | ($ingest | map(. + {e: (.ts | epoch)}) | map(select(.e != null))) as $ev
   | ($ev | map(select(.action == "planned")) | bykey(.id)) as $plans
   | def planner($id; $e): any(($plans[$id] // [])[].e; (. - 60) <= $e and $e <= .);
   # Split rows, by the row they were split from (#of/<id> on an added or re-tagged row).
   ($ev | map(select(.action == "added" or .action == "tagged")
        | ((.text // "") + " " + (.why // "") | capture("#of/(?<p>[A-Za-z0-9_-]+)").p) as $p | {p: $p, id, e})
      | bykey(.p)) as $kids
   # A re-tag that only changes the priority is a call of the priority pass, scored on its own lane,
   # so it touches nothing the triager or planner wrote.
   | def prios: (.why // "") | split(" ") | map(select(test("^[+-]#(urgent|high|low)$")));
   def prio_only: .action == "tagged" and (((.why // "") | split(" ") | map(select(length > 0))) as $w
       | ($w | length) > 0 and ($w | length) == (prios | length));
   ($ev | map(select((.action | IN("edited", "dropped", "rehomed", "tagged", "dup")) and (prio_only | not))) | bykey(.id)) as $touch
   # Priority: each priority the priority pass set (`by` inbox-priority, or inbox-triage on a
   # priority-only re-tag from before the pass named itself), right when nobody else changes the
   # priority of the row for the settle window. A later pass on the row inside the window supersedes
   # it, unless someone changed the priority before that pass ran.
   | def prio_pass: .action == "tagged" and ((.by // "") == "inbox-priority" or ((.by // "") == "inbox-triage" and prio_only));
   ($ev | map(select(.action == "tagged" and (prios | length > 0))) | bykey(.id)) as $prioev
   | [$ev[] | select(prio_pass) | . as $s
      | ([prios[] | select(startswith("+")) | ltrimstr("+#")] | last) as $set
      | select($set != null)
      | ($prioev[$s.id] // []) as $later
      | ([$later[] | select(.e > $s.e and prio_pass) | .e] | min) as $next
      | (if $next != null and $next <= ($s.e + $settle) then $next else $s.e + $settle end) as $end
      | ([$later[] | select(.e > $s.e and .e <= $end and (prio_pass | not)
           and (prios | any(. == "-#\($set)" or (startswith("+") and . != "+#\($set)"))))] | first) as $t
      | select($t != null or $end == $s.e + $settle)
      | {agent: $by["priority-kept"], id: $s.id, project: (if ($s.to // "") == "" then $s.from else $s.to end),
         question: ($s.text // ""), rule: $set, kind: "answer", want: $set,
         human: (if $t == null then "" else ($t.why // "") + (if ($t.by // "") == "" then "" else " by \($t.by)" end) end),
         reason: "", at: $s.ts, answered_at: (if $t == null then null else $t.ts end), judge_call: "",
         outcome: (if $t != null then "fp" elif ($now - $s.e) >= $settle then "tp" else "pending" end)}] as $priorows
   # A row a runner wrote is right when nothing edits, drops, moves or re-tags it for the settle
   # window, writes by the planner aside; untouched($src) makes the verdict for the lane scored by $src.
   | def untouched($src): . as $f
      | ([($touch[$f.id] // [])[] | select(.e > $f.e and .e <= ($f.e + $settle) and (planner($f.id; .e) | not))] | first) as $t
      | {agent: $by[$src], id: $f.id, project: (if ($f.to // "") == "" then $f.from else $f.to end),
         question: ($f.text // ""), rule: "", kind: "answer", want: "untouched",
         human: (if $t == null then "" else $t.action + (if ($t.by // "") == "" then "" else " by \($t.by)" end) end), reason: "", at: $f.ts,
         answered_at: (if $t == null then null else $t.ts end), judge_call: "",
         outcome: (if $t != null then "fp" elif ($now - $f.e) >= $settle then "tp" else "pending" end)};
   # Triage: each row the triager filed (`by` its runner name, or no writer on events from before
   # the record named the runner).
   [$ev[] | select(.action == "filed" and ((.by // "human") | IN("", "human", "inbox-triage"))) | untouched("triage-untouched")] as $triagerows
   # Ask sweep: each row its model filed, known by the quote it carries (SWEEP_ROW_RE), whoever ran
   # it. Its plan rows carry none, since no model wrote them, and the planner wrote a row split from one.
   | [$ev[] | select(.action == "added" and ((.text // "") | test($sweepre) and (contains("#of/") | not))) | untouched("sweep-untouched")] as $sweeprows
   # Plan: each row the planner planned, right when it (or a row split from it in the same run)
   # starts before any re-split: a later plan, or a row split from it by someone else.
   | [$plans[] | min_by(.e) as $p
      | ([$p.id] + [($kids[$p.id] // [])[] | select(planner($p.id; .e)) | .id]) as $ids
      | ([$ids[] as $i | ($startsbyid[$i] // [])[] | select(.e != null and .e >= $p.e) | .e] | min) as $go
      | ([($plans[$p.id] // [])[].e | select(. > $p.e)] + [($kids[$p.id] // [])[] | select(planner($p.id; .e) | not) | .e] | min) as $resplit
      | ($resplit != null and ($go == null or $resplit < $go)) as $wrong
      | {agent: $by["plan-dispatched"], id: $p.id, project: ($p.from // ""), question: ($p.text // ""), rule: "",
         kind: "answer", want: "started whole", human: (if $wrong then "re-split" elif $go != null then "started" else "" end),
         reason: ($p.why // ""), at: $p.ts, answered_at: null, judge_call: "",
         outcome: (if $wrong then "fp" elif $go != null then "tp" else "pending" end)}] as $planrows
   | ($askrows + [($verdicts | map(select(.verdict == "error"))[]
           | {agent: $by["dispatch-queue"], id: .key, project, question: .key, rule: (.rule // ""), kind: "error",
              want: "", human: "", reason: (.reason // ""), at, judge_call: (.judge_call // ""), outcome: null}),
          # A skip is a false defer when the row is started by hand after its run of skips began.
          ($verdicts | map(select(.verdict == "dispatch" or .verdict == "skip"))
           | group_by([.project, .key]) | map(sort_by(.at | epoch // 0))[]
           | . as $r | last as $v | "\($v.project):\($v.key)" as $row | ($item[$row] // "") as $st
           | (($failed["\($v.project)\u0000\($v.key)"] // -1) >= ($v.at | epoch // 0)) as $fail
           | ((([$r | to_entries[] | select(.value.verdict != "skip") | .key] | max) // -1) + 1) as $i
           | ($r[$i].at | epoch // 0) as $skip0
           | ([($startsby[$row] // [])[] | select((.origin | IN("run", "resume") | not) and .e != null and .e >= $skip0) | .e] | min) as $hand
           | {agent: $by["dispatch-queue"], id: $v.key, project: $v.project, question: $v.key, rule: ($v.rule // ""),
              kind: (if $v.verdict == "dispatch" then "answer" else "defer" end), want: "start",
              human: (if $fail then "failed" elif $v.verdict == "skip" and $hand != null then "started by hand" else $st end),
              reason: ($v.reason // ""), at: $v.at, answered_at: null, judge_call: ($v.judge_call // ""),
              outcome: (if $v.verdict == "skip" then
                  (if $hand != null then "fn" elif ($now - $skip0) >= $settle then "tn" else "pending" end)
                elif $fail or ($st | test("^done/(failed|cancelled)")) then "fp"
                elif $st == "done/ok" then "tp" else "pending" end)})] + $triagerows + $planrows + $priorows + $sweeprows)
  | map(select(.agent != null)) as $all

  | ($all | map(select(.judge_call != "")) | group_by(.judge_call) | map({(.[0].judge_call): length}) | add // {}) as $share
  | def stats: . as $r
      | ($r | map(select(.kind == "error")) | length) as $err
      | {verdicts: ($r | length), errors: $err,
         answered: ($r | map(select(.kind == "answer")) | length),
         live_answered: ($r | map(select(.live == true)) | length),
         assumed: ($r | map(select(.assumed == true)) | length),
         assumed_overridden: ($r | map(select(.assumed == true and .outcome == "fp")) | length),
         deferred: ($r | map(select(.kind == "defer")) | length),
         pending: ($r | map(select(.outcome == "pending")) | length),
         unscorable: ($r | map(select(.outcome == "unscorable")) | length),
         unscorable_by: ($r | map(select(.outcome == "unscorable") | .unscorable) | group_by(.)
           | map({(.[0]): length}) | add // {}),
         tp: ($r | map(select(.outcome == "tp")) | length), fp: ($r | map(select(.outcome == "fp")) | length),
         fn: ($r | map(select(.outcome == "fn")) | length), tn: ($r | map(select(.outcome == "tn")) | length)}
      | . + {scored: (.tp + .fp + .fn + .tn), coverage: pct(.answered; .verdicts - .errors),
             unscorable_pct: pct(.unscorable; .verdicts - .errors),
             live_pct: pct(.live_answered; .verdicts - .errors), precision: pct(.tp; .tp + .fp), false_defer_pct: pct(.fn; .fn + .tn), kappa: kappa}
      | . + (wilson(.tp; .tp + .fp) | {precision_lo: .[0], precision_hi: .[1]})
      # Each verdict carries its share of its call: one dispatch call judges many rows.
      | . + ([$r[] | select($call[.judge_call] != null)] as $j | [$j[] | $call[.judge_call].duration_ms | numbers] as $d
             | {p50_ms: ($d | quantile(0.5)), p95_ms: ($d | quantile(0.95)),
                cost_per_verdict: (if ($j | length) == 0 then null else
                  (([$j[] | ($call[.judge_call].cost_usd // 0) / $share[.judge_call]] | add) / ($j | length) * 10000 | round) / 10000 end)});

  # One row of the verdict list: what the judge said, and what became of it in plain words.
  def listed: {id, project, question, rule, type, level, level_raised, call: .judge_call, judge: .want, reason, evidence,
        said: (if .kind == "error" then "error" elif .live then "answered"
               elif .kind == "answer" then "would answer" else "passed" end),
        you: (if .outcome == "pending" then "pending" elif .live and .outcome == "tp" then "kept"
              elif .live and .human == "none" then "not reviewed" else .human end),
        score: ({tp: "right", tn: "right", fp: "wrong", fn: "needless", pending: "pending"}[.outcome // ""] // "-"),
        at: (.at | epoch)};

  {at: $now, scope: {prompt: (if $any == 1 then "any" else "current" end), days: (if $days == "" then null else ($days | tonumber) end)},
   bar: {labels: $bar, precision: $barp},
   agents: [($want | split(" "))[] as $ag
     | ($all | map(select(.agent == $ag and inscope($ag)))) as $mine
     | ($calls | map(select(.agent == $ag and ((.at | epoch) as $e | $since == null or ($e != null and $e >= $since))
                            and ($any == 1 or (.prompt_sha // "") == ($shas[$ag] // "-"))))) as $cl
     | ($src[$ag] // "") as $sc
     | (if $sc == "ask-answers" then $live elif $sc == "dispatch-queue" then ["*"] else [] end) as $lv
     # The word a score cell puts after its percent; a lane with no counted outcome has none.
     | ({"ask-answers": "agree", "dispatch-queue": "merged", "triage-untouched": "untouched",
         "plan-dispatched": "dispatched", "priority-kept": "kept", "sweep-untouched": "untouched"}[$sc]) as $lb
     | {agent: $ag, prompt_sha: ($shas[$ag] // ""), score: $sc,
        truth: ({"ask-answers": "the human answer to the ask, and the review of a live answer (kept or another option; none is not scored)",
                 "dispatch-queue": "the queue item a dispatched row became: done ok landed, failed or cancelled did not; a skip is a false defer when the row is then started by hand",
                 "triage-untouched": "the ingest record: a filed row is right when nothing edits, drops, moves or re-tags it for \($settle / 3600)h",
                 "plan-dispatched": "the ingest record and the queue: a planned row is right when it starts before anyone re-splits it",
                 "sweep-untouched": "the ingest record: a row the sweep model filed is right when nothing edits, drops, moves or re-tags it for \($settle / 3600)h",
                 "priority-kept": "the ingest record: a priority the pass set is right when nobody else changes the priority of the row for \($settle / 3600)h",
                 "unrecorded": "not recorded: the lane leaves no counted outcome, so only its calls show"}[$sc]
               // "unknown SCORE \($sc | tojson): judges.md lists the truth sources"),
        live: $lv,
        calls: {n: ($cl | length), errors: ($cl | map(select((.exit // 0) != 0 or .is_error == true)) | length),
                p50_ms: ([$cl[].duration_ms | numbers] | quantile(0.5)), p95_ms: ([$cl[].duration_ms | numbers] | quantile(0.95)),
                cost_usd: (($cl | map(.cost_usd // 0) | add // 0) * 10000 | round / 10000)},
        total: ($mine | stats),
        rules: ($mine | group_by(.rule) | map(.[0].rule as $rl | stats + {rule: $rl,
                  live: ($lv | index("*") != null or index($rl) != null)}
                  | . + {bar: {labels: (.tp + .fp), need: $bar,
                               met: ((.tp + .fp) >= $bar and (.precision // 0) >= $barp)}})
                | sort_by(-.verdicts)),
        misses: ($mine | map(select(.outcome == "fp")) | sort_by(-(.answered_at // .at | epoch // 0)) | .[0:$nmiss]
                 | map({id, project, question, judge: .want, reason, answer: .human, rule,
                        answered_at: (.answered_at // .at | epoch)}))}
       # What the human reads rather than a score, so every prompt counts: a policy change must
       # not empty the list or reset the week. score_7d is the week as the Workers score cell and
       # the day-log rollup show it, a percent only past the bar; the runner_score KPI counts the
       # current prompt only.
       + (($all | map(select(.agent == $ag))) as $every
          | ($every | map(select((.at | epoch // 0) >= $now - 7 * 86400)) | stats) as $wk
          | ($wk.tp + $wk.fp) as $n
          | {week: $wk,
             score_7d: {window: "7d", right: $wk.tp, n: $n, pending: $wk.pending,
                        value: (if $lb != null and $n >= $bar then $wk.precision else null end),
                        text: (if $lb == null then "-" elif $n < $bar then "n<\($bar)"
                               else "\($wk.precision | round)% \($lb)" end),
                        title: (if $lb == null then "\($sc): no counted outcome"
                                else "7d, \($wk.tp) of \($n) right, \($wk.pending) pending, \($sc)"
                                     + (if $n < $bar then "; a percent at \($bar) rows" else "" end) end)}}
          + (if $src[$ag] != "ask-answers" then {} else
             {verdicts: ($every | map(select($since == null or (.at | epoch // 0) >= $since))
               | sort_by(-(.at | epoch // 0)) | .[0:$nverdicts] | map(listed)),
              # One cell per type and impact level, in scope: what a promotion is weighed on. A
              # live cell counts only reviewed answers (`audited`), never silence.
              cells: ($mine | map(select(.kind != "error")) | group_by([.type, .level])
                | map(.[0] as $c | stats + {type: $c.type, level: $c.level,
                    live: (($lv | index("*")) != null or ($lv | index($c.type)) != null),
                    audited: (map(select(.live and (.outcome | IN("tp", "fp")))) | length),
                    level_raised_pct: pct(map(select(.level_raised)) | length; length)})
                | sort_by(.type, (.level as $l | $levels | index($l) // -1)))} end))]}'

# report <json>: the table, one block per agent.
report() {
  jq -r '
    def n: if . == null then "-" else tostring end;
    def p: if . == null then "-" else "\(.)%" end;
    def ms: if . == null then "-" else "\(. / 100 | round / 10)s" end;
    def money($d): if . == null then "-" else (pow(10; $d)) as $m | (. * $m | round) as $c
      | "$\($c / $m | floor).\($c % $m | tostring | if length < $d then "0" * ($d - length) + . else . end)" end;
    def pad($w): tostring | if length >= $w then .[0:$w] else . + " " * ($w - length) end;
    def lpad($w): tostring | if length >= $w then . else " " * ($w - length) + . end;
    def row($name): "  " + ($name | pad(15)) + (.verdicts | lpad(6)) + (.errors | lpad(5)) + (.coverage | p | lpad(7))
      + (.scored | lpad(7)) + ((.precision | p) + (if .precision == null then "" else " [\(.precision_lo)-\(.precision_hi)]" end) | lpad(18))
      + (.false_defer_pct | p | lpad(8)) + (.kappa | n | lpad(7)) + (.p95_ms | ms | lpad(7)) + (.cost_per_verdict | money(3) | lpad(7));
    "scope: \(.scope.prompt) prompt\(if .scope.days then ", last \(.scope.days) days" else "" end); bar: \(.bar.labels) scored answers at \(.bar.precision)% precision",
    (.agents[] | "",
      "\(.agent)  prompt \(.prompt_sha[0:7] | if . == "" then "none" else . end)  live: \(if .live == ["*"] then "every rule" elif .live == [] then "none" else .live | join(", ") end)",
      "  truth: \(.truth)",
      "  calls \(.calls.n), \(.calls.errors) failed, p50 \(.calls.p50_ms | ms), p95 \(.calls.p95_ms | ms), \(.calls.cost_usd | money(2))",
      (if .total.assumed > 0 then "  assumed \(.total.assumed), \(.total.assumed_overridden) overridden" else empty end),
      (if .total.verdicts == 0 then "  no verdicts in scope" else
        "  " + ("rule" | pad(15)) + ("verd" | lpad(6)) + ("err" | lpad(5)) + ("cover" | lpad(7)) + ("scored" | lpad(7))
          + ("precision [95%]" | lpad(18)) + ("f-defer" | lpad(8)) + ("kappa" | lpad(7)) + ("p95" | lpad(7)) + ("$/v" | lpad(7)) + "  bar",
        (.rules[] | row(if .rule == "" then "(no rule)" else .rule end)
           + "  " + (if .live then "live" elif .bar.met then "past bar" else "\(.bar.labels)/\(.bar.need)" end)),
        (.total | row("all")),
        # The share no human answer can label, and why: a lane mostly unscorable never earns its bar.
        (.total | select(.unscorable > 0) | "  unscorable \(.unscorable) of \(.verdicts - .errors) (\(.unscorable_pct)%): "
           + (.unscorable_by | to_entries | sort_by(-.value, .key) | map("\(.value) \(.key)") | join(", "))) end),
      (if (.misses | length) > 0 then "  wrong answers, newest first:",
        (.misses[] | "    \(.id | .[0:24])  \(.project)  judge \(.judge | .[0:24])  truth \(.answer | .[0:24])  \(.question | .[0:60])") else empty end))' <<<"$1"
}

# kpi_json: {kpi: {"7d": v, "28d": v}} for fleet-bench, as comms-lint kpi gives its own.
kpi_json() {
  local w7 w28
  w7="$(VERDICTS=0 eval_json "$AGENTS" 1 7)" && w28="$(VERDICTS=0 eval_json "$AGENTS" 1 28)" || return 1
  jq -cn --argjson a "$w7" --argjson b "$w28" --argjson min "$KPI_LABELS" '
    def fdefer: if .fn + .tn >= $min then .false_defer_pct else null end;
    def k: .bar.labels as $need
           | {judge_errors: ([.agents[] | if .score == "unrecorded" then .calls.errors else .total.errors end] | add),
            judge_precision: ([.agents[] | select(.score | IN("ask-answers", "dispatch-queue")) | .rules[]
              | select(.tp + .fp >= $min) | .precision] | min),
            ask_answered_pct: (.agents[] | select(.score == "ask-answers") | .total.live_pct),
            ask_unclear_pct: (.agents[] | select(.score == "ask-answers") | .total as $t
              | (.rules | map(select(.rule == "unclear-ask") | .verdicts) | add // 0) as $u
              | if $t.verdicts - $t.errors > 0 then ($u * 1000 / ($t.verdicts - $t.errors) | round) / 10 else null end),
            dispatch_false_defer_pct: ([.agents[] | select(.score == "dispatch-queue") | .total | fdefer] | .[0])}
         # A runner lane scores from the one bar: below it a single miss swings the number.
         + ([.agents[] | select(.score | IN("triage-untouched", "plan-dispatched", "priority-kept", "sweep-untouched"))
             | {("runner_score_" + (.agent | gsub("-"; "_"))): (if (.total.tp + .total.fp) >= $need then .total.precision else null end)}]
            | add // {});
    ($a | k) as $x | ($b | k) as $y | $x | keys_unsorted | map({(.): {"7d": $x[.], "28d": $y[.]}}) | add'
}

# log [filter] [--level L] [--days N] [--limit N] [--json]: see the header.
log() {
  local said="" level="" days="" limit="$LOG_LIMIT" json=0 out
  while [ $# -gt 0 ]; do
    case "$1" in
      answered|would-answer|passed|wrong) said="$1"; shift ;;
      --level) [[ " $JUDGE_LEVELS " == *" ${2:-x} "* ]] || { say "--level takes one of: $JUDGE_LEVELS"; return 2; }; level="$2"; shift 2 ;;
      --days) [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || { say "--days takes a day count"; return 2; }; days="$2"; shift 2 ;;
      --limit) [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || { say "--limit takes a count"; return 2; }; limit="$2"; shift 2 ;;
      --json) json=1; shift ;;
      *) say "usage: judge-eval log [answered|would-answer|passed|wrong] [--level L] [--days N] [--limit N] [--json]"; return 2 ;;
    esac
  done
  # Filtered before the limit, so the whole list is read rather than the dashboards' slice.
  out="$(VERDICTS=1000000 eval_json ask-judge 1 "$days" | jq -c --arg f "$said" --arg l "$level" --argjson n "$limit" '
    .agents[0].verdicts | map(select($f == "" or (if $f == "wrong" then .score == "wrong"
      else .said == ($f | sub("-"; " ")) end)) | select($l == "" or .level == $l)) | .[0:$n]')" || { say "could not read the sources"; return 1; }
  if [ "$json" = 1 ]; then printf '%s\n' "$out"; return; fi
  jq -r 'if length == 0 then "no verdicts" else .[] |
      "\(.at | if . then localtime | strftime("%m-%d %H:%M") else "-" end)  \(.project)  \(if .type == "" then .rule else .type end)  \(.said)  you: \(.you | .[0:40])  \(.score)",
      "    \(.question | .[0:100])",
      "    \(if .rule == "" then "" else .rule + ": " end)\(.reason)\(if .evidence == "" then "" else "  \"\(.evidence)\"" end)",
      "    level \(if .level == "" then "-" else .level end)\(if .level_raised then " (raised)" else "" end)  call \(if .call == "" then "-" else .call end)" end' <<<"$out"
}

# cells [--any-prompt] [--days N] [--json]: see the header.
cells() {
  local any=0 days="" json=0 out
  while [ $# -gt 0 ]; do
    case "$1" in
      --any-prompt) any=1; shift ;;
      --days) [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || { say "--days takes a day count"; return 2; }; days="$2"; shift 2 ;;
      --json) json=1; shift ;;
      *) say "usage: judge-eval cells [--any-prompt] [--days N] [--json]"; return 2 ;;
    esac
  done
  out="$(VERDICTS=0 eval_json ask-judge "$any" "$days" | jq -c '[.agents[] | select(.score == "ask-answers") | .cells[]]')" ||
    { say "could not read the sources"; return 1; }
  if [ "$json" = 1 ]; then printf '%s\n' "$out"; return; fi
  jq -r 'def pad($w): tostring | if length >= $w then .[0:$w] else . + " " * ($w - length) end;
    def lpad($w): tostring | if length >= $w then . else " " * ($w - length) + . end;
    def p: if . == null then "-" else "\(.)%" end;
    if length == 0 then "no verdicts in scope" else
      ("type" | pad(24)) + ("level" | pad(9)) + ("verd" | lpad(5)) + ("scored" | lpad(7)) + ("precision [95%]" | lpad(18))
        + ("pend" | lpad(5)) + ("live" | lpad(5)) + ("audited" | lpad(8)) + ("raised" | lpad(7)),
      (.[] | (if .type == "" then "(no type)" else .type end | pad(24)) + (if .level == "" then "-" else .level end | pad(9))
        + (.verdicts | lpad(5)) + (.scored | lpad(7))
        + ((.precision | p) + (if .precision == null then "" else " [\(.precision_lo)-\(.precision_hi)]" end) | lpad(18))
        + (.pending | lpad(5)) + (if .live then "yes" else "no" end | lpad(5)) + (.audited | lpad(8)) + (.level_raised_pct | p | lpad(7))) end' <<<"$out"
}

# replay_labelled: the id and project of each ask the human answered with one option, newest
# first, gates and approvals out. Free text and bare settle-session stamps carry no label.
replay_labelled() {
  local asks
  asks="$(judge_ask_docs "$ASKS_ROOT" | jq -c 'select(.status == "answered" and (.answered_by // "human") == "human"
    and (.options // "") != "" and ((.kind // "") == "gate" or (.kind // "") == "approval" | not))')"
  jq -sr --argjson picks "$(answer_picks "$asks")" '
    map(select(.answer as $a | $picks[.id] or (.options | split("|") | index($a))))
    | sort_by(.created // "") | reverse | .[] | [.id, .project] | @tsv' <<<"$asks"
}

# replay_blind <ask file> <copy>: the ask as it stood when it was posted, pending and unjudged.
# Fails when the answer survived, so a label can never reach the judge.
replay_blind() {
  local fields
  fields="$(tr ' ' '|' <<<"$JUDGE_EVAL_BLIND_FIELDS")"
  sed -E -e '/^(judge|judge_[a-z]+|judged_at): /d' -e "s/^($fields): .*/\\1: /" -e 's/^status: .*/status: pending/' "$1" > "$2"
  ! grep -qE '^answer: .*[^ ]' "$2"
}

# replay [--limit N] [--out DIR] [--json]: see the header. The verdicts are moved onto copies of
# the answered asks, so judge-eval's one scoring reads them like any other.
replay() {
  local limit="" dir="" json=0 ask id project n=0 out rc=0
  ask="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/agent-ask"
  while [ $# -gt 0 ]; do
    case "$1" in
      --limit) [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || { say "--limit takes a count"; return 2; }; limit="$2"; shift 2 ;;
      --out) [ -n "${2:-}" ] || { say "--out takes a directory"; return 2; }; dir="$2"; shift 2 ;;
      --json) json=1; shift ;;
      *) say "usage: judge-eval replay [--limit N] [--out DIR] [--json]"; return 2 ;;
    esac
  done
  local keep=1
  [ -n "$dir" ] || { dir="$(mktemp -d)" || return 1; keep=0; }
  mkdir -p "$dir" || return 1
  while IFS=$'\t' read -r id project; do
    mkdir -p "$dir/blind/$project" "$dir/scored/$project"
    replay_blind "$ASKS_ROOT/$project/$id.md" "$dir/blind/$project/$id.md" ||
      { say "the answer to $id survived the blinding; nothing was sent"; rc=1; break; }
    n=$((n + 1))
    [ "$n" = "${limit:-0}" ] && break
  done < <(replay_labelled)
  if [ "$rc" = 0 ] && [ "$n" -gt 0 ]; then
    find "$dir/blind" -mindepth 2 -name '*.md' -printf '%f\n' | sed 's/\.md$//' |
      AGENT_ASK_ROOT="$dir/blind" AGENT_ASK_PRECEDENTS_ROOT="$ASKS_ROOT" AGENT_ASK_JUDGE_CMD="$JUDGE_EVAL_REPLAY_CMD" \
        xargs -r -P "$JUDGE_EVAL_REPLAY_JOBS" -n 1 "$ask" judge >/dev/null 2>&1
    local copy pat='^(judge|judge_[a-z]+|judged_at): '
    while IFS= read -r copy; do
      project="$(basename "$(dirname "$copy")")"; id="$(basename "$copy")"
      { grep -Ev "$pat" "$ASKS_ROOT/$project/$id"; grep -E "$pat" "$copy"; } > "$dir/scored/$project/$id"
    done < <(find "$dir/blind" -mindepth 2 -name '*.md')
    say "replayed $n ask(s) on blind copies"
    out="$(ASKS_ROOT="$dir/scored" AGENTS="ask-judge ask-judge-replay" eval_json ask-judge 1 "")" || rc=1
    if [ "$rc" = 0 ]; then if [ "$json" = 1 ]; then printf '%s\n' "$out"; else report "$out"; fi; fi
  elif [ "$rc" = 0 ]; then
    say "no labelled asks to replay"
  fi
  [ "$keep" = 1 ] || rm -rf -- "$dir"
  return "$rc"
}

main() {
  local want="" any=0 days="" json=0 a
  if [ "${1:-}" = replay ]; then shift; replay "$@"; return; fi
  if [ "${1:-}" = log ]; then shift; log "$@"; return; fi
  if [ "${1:-}" = cells ]; then shift; cells "$@"; return; fi
  if [ "${1:-}" = kpi ]; then
    shift
    case "${1:-}" in --json) kpi_json ;; "") kpi_json | jq -r 'to_entries[] | "\(.key)\t7d \(.value["7d"] // "-")\t28d \(.value["28d"] // "-")"' ;;
      *) say "usage: judge-eval kpi [--json]"; return 2 ;; esac
    return
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) want="$AGENTS"; shift ;;
      --any-prompt) any=1; shift ;;
      --days) [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || { say "--days takes a day count"; return 2; }; days="$2"; shift 2 ;;
      --json) json=1; shift ;;
      -h|--help) sed -n '2,/^$/{s/^# \{0,1\}//;p}' "$0"; return 0 ;;
      -*) say "unknown option $1"; return 2 ;;
      *) for a in $AGENTS; do [ "$1" = "$a" ] && want="$want $a"; done
         [[ " $want " == *" $1 "* ]] || { say "no scored lane '$1' (lanes: $AGENTS)"; return 2; }; shift ;;
    esac
  done
  local out
  want="${want# }"
  out="$(eval_json "${want:-$AGENTS}" "$any" "$days")" || { say "could not read the sources"; return 1; }
  if [ "$json" = 1 ]; then printf '%s\n' "$out"; else report "$out"; fi
}

main "$@"
