#!/usr/bin/env bash
# agentctl-release-cut - dispatch a project's cut workflow when its sprint says so, so no agent
# or person cuts a release. The rules (early, on time, the #urgent hold and patch, carry,
# promotion) are in `~/.local/src/docs/stages.md` "Release windows", Cut; the projects in
# release-cut/projects.json.
# A timer, not an event: a sheet edit and a clock reaching the cut time have no event to wait on.
# It waits on the cut run it dispatches, so the wave-roll step after it in the same release-window
# pass sees the tag and rolls the sprint, with no pass in between.
#
# Usage:
#   agentctl-release-cut [--dry-run] [project]   # --dry-run: print what it would dispatch and file,
#                                                # change nothing (no dispatch, item, page or marker)
set -uo pipefail

DRY=0 ONE=""
for a in "$@"; do
  case "$a" in
    --dry-run) DRY=1 ;;
    -*) echo "usage: agentctl-release-cut [--dry-run] [project]" >&2; exit 2 ;;
    *) ONE="$a" ;;
  esac
done

CONF="${RELEASE_CUT_CONF:-$HOME/.config/release-cut/projects.json}"
HOOKS="${RELEASE_CUT_HOOKS:-$HOME/.config/shared-hooks/project-name.sh}"
STATE="${AGENTCTL_INBOX:-$HOME/.local/state/agentctl/release-cut}"
# Each cut workflow's budget: the repo's ci-budgets.json on main, `workflows.<stem>.jobs.*.p90` (minutes).
BUDGETS=.github/ci-budgets.json
# The wait on one cut run is this many times its budget, the hang guard ci.md gives timeout-minutes.
CUT_WAIT_FACTOR=3
# Seconds of STEP_TIMEOUT kept free after that wait: timeout's 30 s kill grace, then promote and any
# project after this one.
CUT_HEADROOM=300
# The local minute, in the `cut=` stamp's own format, so the two compare as strings.
NOW="${RELEASE_CUT_NOW:-$(date +%Y-%m-%dT%H:%M)}"

# shellcheck source=/dev/null
. "$HOOKS" || { echo "release-cut: cannot source $HOOKS" >&2; exit 1; }
# shellcheck source=../lib/origin-repo.sh
. "$(dirname "$(readlink -f "$0")")/../lib/origin-repo.sh"
# shellcheck source=/dev/null
. "${AGENT_PROOF_LIB:-$HOME/.local/lib/agent-proof.sh}" 2>/dev/null || true
command -v proof_runner_outcome >/dev/null 2>&1 || proof_runner_outcome() { :; }

dispatched=0 filed=0 failed=0 actions=()
log() {
  [ "$DRY" = 1 ] || { mkdir -p "$STATE"; printf '[%s] release-cut: %s\n' "$(date -Is)" "$*" >> "$STATE/activity.log"; }
  printf '%s\n' "$*"
}
# say: a steady-state line (waiting, not ready), printed but kept out of activity.log.
say() { printf '%s\n' "$*"; }
fail() { failed=$((failed + 1)); log "FAILED $*"; }
# notify KEY TITLE MSG: a high page keyed by KEY, so agent-notify's dedupe sends a held or
# broken cut once per window and not every pass.
notify() {
  [ "$DRY" = 0 ] || return 0
  agent-notify -p high -d "release-cut:$1" -t "$2" "$3" >/dev/null 2>&1 || true
}

# repo_of PROJECT: the owner/name of its checkout's GitHub origin; the remote is the one record.
repo_of() {
  local dir
  dir="$(project_repo_path "$1" 2>/dev/null)" && origin_on_github "$dir" && origin_repo "$dir"
}

# green_sha REPO WORKFLOW TITLE: the commit the newest green full run on main tested: its
# tested-sha-<sha> artifact (a pinned night), else its head (playground scripts/ci/tested-runs.py).
green_sha() {
  local id head tested
  read -r id head < <(gh run list -R "$1" --workflow "$2" --branch main --status success -L 40 \
    --json databaseId,displayTitle,headSha \
    --jq "first(.[] | select(.displayTitle == \"$3\")) | \"\(.databaseId) \(.headSha)\"") || return 1
  [ -n "${id:-}" ] || return 1
  tested="$(gh api "repos/$1/actions/runs/$id/artifacts" \
    --jq '[.artifacts[].name | select(startswith("tested-sha-")) | ltrimstr("tested-sha-")][0] // empty')" || return 1
  printf '%s' "${tested:-$head}"
}

# tag_on_origin REPO TAG: 0 when it exists, 1 when not, 2 when GitHub could not say.
tag_on_origin() {
  local n
  n="$(gh api "repos/$1/git/matching-refs/tags/$2" --jq "[.[] | select(.ref == \"refs/tags/$2\")] | length")" || return 2
  [ "$n" -gt 0 ]
}

# bound_wait NAME VER REPO WF WHY: set `cutwait`, the seconds to wait on one WF run: CUT_WAIT_FACTOR
# times the sum of its jobs' p90 in the repo's ci-budgets.json on main. A live pass fails the cut
# and pages when the workflow has no budget row or the wait does not fit what is left of the
# step's STEP_TIMEOUT (agentctl-steps exports it), since a step killed mid-wait never reaches the
# roll after it; a dry run notes either in `note`.
bound_wait() {
  local name="$1" ver="$2" repo="$3" wf="$4" why="$5" left
  cutwait="$(gh api "repos/$repo/contents/$BUDGETS?ref=main" -H 'Accept: application/vnd.github.raw' 2>/dev/null \
    | jq -e --arg w "${wf%.*}" --argjson f "$CUT_WAIT_FACTOR" \
      '[.workflows[$w].jobs[]?.p90 | numbers] | select(length > 0) | add * 60 * $f | ceil')" || cutwait=""
  if [ -z "$cutwait" ]; then
    [ "$DRY" = 0 ] || { note+="; no $wf budget in $repo $BUDGETS"; return 0; }
    fail "$name $ver: $repo has no $wf budget in $BUDGETS on main, so the wait on its run has no bound ($why)"
    notify "nobudget-$name@$ver" "release cut blocked: $name $ver" "$name $ver is due to cut ($why), but $BUDGETS on main has no ${wf%.*} row."
    return 1
  fi
  [ -n "${STEP_TIMEOUT:-}" ] || return 0
  left=$((STEP_TIMEOUT - SECONDS - CUT_HEADROOM))
  [ "$cutwait" -gt "$left" ] || return 0
  [ "$DRY" = 0 ] || { note+="; its ${cutwait}s wait does not fit STEP_TIMEOUT=${STEP_TIMEOUT}s"; return 0; }
  fail "$name $ver: waiting on a $wf run takes up to ${cutwait}s, more than the ${left}s STEP_TIMEOUT=${STEP_TIMEOUT}s leaves after ${CUT_HEADROOM}s headroom; raise STEP_TIMEOUT in the runner's conf ($why)"
  notify "nofit-$name@$ver" "release cut blocked: $name $ver" "$name $ver is due to cut ($why), but the ${cutwait}s wait on its $wf run does not fit STEP_TIMEOUT=${STEP_TIMEOUT}s."
  return 1
}

# await_cut NAME VER REPO WF ID WHY: wait up to `cutwait` seconds on the WF run ID through
# gh-run-wait (the one run waiter), so the wave-roll step after this one sees its tag. 0 only
# when the run succeeded and VER's tag is on origin.
await_cut() {
  local name="$1" ver="$2" repo="$3" wf="$4" id="$5" why="$6" rc
  GH_REPO="$repo" timeout -k 30 "$cutwait" gh-run-wait "$id" "$wf $name $ver"
  rc=$?
  case "$rc" in
    0) if tag_on_origin "$repo" "$ver"; then
         actions+=("$name $ver tagged"); log "the $wf run $id for $name $ver succeeded; the roll follows its tag ($why)"; return 0
       fi
       fail "$name $ver: the $wf run $id succeeded, but no $ver tag is on origin ($why)" ;;
    1) fail "$name $ver: the $wf run $id ended without success and made no tag ($why)"
       notify "cutfailed-$name@$ver" "release cut failed: $name $ver" "the $wf run $id for $name $ver ended without success and made no tag; the next green run retries it." ;;
    # timeout's 124, its KILL after the grace (137), or gh-run-wait's own guard (4).
    124 | 137 | 4) fail "$name $ver: the $wf run $id still runs after $((cutwait / 60)) min, $CUT_WAIT_FACTOR times its budget; the next pass waits on it ($why)" ;;
    *) fail "$name $ver: cannot read the $wf run $id (gh-run-wait exit $rc) ($why)" ;;
  esac
  return 1
}

# cut_release NAME VER REPO CFG WHY: dispatch the cut workflow for VER, at most once per green SHA,
# and wait on its run.
cut_release() {
  local name="$1" ver="$2" repo="$3" cfg="$4" why="$5" wf tw tt sha mark runs inflight live last="" note="" cutwait="" out id
  # 0.0.0-test is the cut workflow's own proof version, never a release.
  [[ "${ver#v}" != 0.0.0* ]] || { fail "$name $ver: 0.0.0 is the cut workflow's proof version, not cut"; return 1; }
  wf="$(jq -r '.cut_workflow' <<<"$cfg")" tw="$(jq -r '.tests.workflow' <<<"$cfg")" tt="$(jq -r '.tests.title' <<<"$cfg")"
  tag_on_origin "$repo" "$ver"
  case $? in
    0) say "$name $ver: tag already on origin, nothing to cut ($why)"; return 0 ;;
    2) fail "$name $ver: cannot ask GitHub whether tag $ver exists"; return 1 ;;
  esac
  sha="$(green_sha "$repo" "$tw" "$tt")" && [ -n "$sha" ] || {
    fail "$name $ver: no green $tt run on main to cut at ($why)"
    notify "nogreen-$name@$ver" "release cut blocked: $name $ver" "$name $ver is due to cut ($why), but main has no green $tt run."
    return 1
  }
  mark="$STATE/cuts/$name@$ver"
  # A failed run list is also how a workflow not on main yet answers.
  if runs="$(gh run list -R "$repo" --workflow "$wf" -L 20 --json databaseId,status,conclusion \
      --jq '"\([.[] | select(.status != "completed")] | length) \((first(.[] | select(.status != "completed")) | .databaseId) // 0) \(.[0].conclusion // "")"')"; then
    read -r inflight live last <<<"$runs"
    if [ "${inflight:-0}" -gt 0 ]; then
      # Waited on only once this lane has dispatched VER (its mark); another run in flight (another
      # version, a re-send) is left alone, and a later pass decides.
      say "$name $ver: a $wf run is in flight, waiting on it ($why)"
      [ "$DRY" = 0 ] && [ -e "$mark" ] || return 0
      bound_wait "$name" "$ver" "$repo" "$wf" "$why" || return 1
      await_cut "$name" "$ver" "$repo" "$wf" "$live" "$why"
      return
    fi
  elif [ "$DRY" = 1 ]; then
    note="; cannot list $wf runs on $repo (not on main yet?)"
  else
    fail "$name $ver: cannot list $wf runs on $repo (is it on main?) ($why)"
    notify "nowf-$name@$ver" "release cut blocked: $name $ver" "$name $ver is due to cut ($why), but $wf runs on $repo cannot be listed."
    return 1
  fi
  if [ "$(cut -f1 "$mark" 2>/dev/null)" = "$sha" ]; then
    # Dispatched at this SHA and no tag: a newer green SHA retries; a failed run is news.
    if [ -n "$last" ] && [ "$last" != success ]; then
      fail "$name $ver: the $wf run dispatched at ${sha:0:10} ended $last with no tag ($why)"
      notify "cutfailed-$name@$ver" "release cut failed: $name $ver" "$wf for $name $ver at ${sha:0:10} ended $last and made no tag; the next green $tt retries it."
      return 1
    fi
    say "$name $ver: $wf already dispatched at ${sha:0:10} and no tag came; waits for a newer green $tt ($why)"
    return 0
  fi
  bound_wait "$name" "$ver" "$repo" "$wf" "$why" || return 1
  if [ "$DRY" = 1 ]; then
    log "would dispatch $wf on $repo: version=${ver#v} sha=$sha, then wait ${cutwait:-?}s on it ($why)$note"
    actions+=("would cut $name $ver")
    return 0
  fi
  if out="$(gh workflow run "$wf" -R "$repo" --ref main -f version="${ver#v}" -f sha="$sha")"; then
    mkdir -p "$STATE/cuts" && printf '%s\t%s\n' "$sha" "$NOW" > "$mark"
    dispatched=$((dispatched + 1)); actions+=("cut $name $ver")
    log "dispatched $wf for $name $ver at ${sha:0:10} ($why)"
    agent-notify -t "release cut: $name $ver" "$wf dispatched at ${sha:0:10}: $why." >/dev/null 2>&1 || true
    # gh prints the run it created; with none to follow, the next pass waits on it in flight.
    id="$(grep -m 1 -oE '/actions/runs/[0-9]+' <<<"$out")"
    [ -n "$id" ] || { fail "$name $ver: gh printed no run URL for the $wf dispatch, so this pass cannot wait on it ($why)"; return 1; }
    await_cut "$name" "$ver" "$repo" "$wf" "${id##*/}" "$why"
  else
    fail "$name $ver: gh workflow run $wf failed ($why)"
    return 1
  fi
}

# patch_ready NAME VER REPO CFG FIXES: 0 when the newest green full run on main contains every
# FIXES `id=commit` (closed #urgent interrupt rows and their merge commits), so a patch cut ships
# them all; 1 while one is not in a green run yet, or GitHub cannot say.
patch_ready() {
  local name="$1" ver="$2" repo="$3" cfg="$4" fix sha st
  sha="$(green_sha "$repo" "$(jq -r '.tests.workflow' <<<"$cfg")" "$(jq -r '.tests.title' <<<"$cfg")")" && [ -n "$sha" ] || return 1
  for fix in $5; do
    # ahead or identical: the green commit has the fix; behind or diverged: not yet.
    st="$(gh api "repos/$repo/compare/${fix#*=}...$sha" --jq '.status')" \
      || { fail "$name $ver: cannot compare #urgent fix ${fix%%=*} (${fix#*=}) with green ${sha:0:10}"; return 1; }
    case "$st" in
      ahead | identical) ;;
      *) say "$name $ver: #urgent fix ${fix%%=*} landed, waiting for a green full run that contains ${fix#*=}"; return 1 ;;
    esac
  done
}

# cut_tags REPO VER: the tags VER's cut put on origin (VER and each VER-<game><n>), one a line,
# none when it made none; 1 when GitHub could not say.
cut_tags() {
  local refs
  refs="$(gh api "repos/$1/git/matching-refs/tags/$2")" || return 1
  jq -r --arg v "$2" '.[]?.ref | ltrimstr("refs/tags/") | select(. == $v or startswith($v + "-"))' <<<"$refs"
}

# promote NAME REPO CFG: for the newest version this lane cut that has tags on origin, file the
# public promotion item once for each of its tags (a target: the version's own, one per game)
# whose newest beta deployment (environment <target><deployment_suffix>) succeeded. A target with
# no beta proof gets none; each failed beta deployment is logged once as not shipped on this
# version (release.md, Tags and versions), and a rerun that goes green promotes it. An older
# version is not promoted: the newer cut replaces it on beta, and newest-wins keeps it there.
promote() {
  local name="$1" repo="$2" cfg="$3" suffix mark item ver tags="" tag env target id build state rc
  suffix="$(jq -r '.promote.deployment_suffix // empty' <<<"$cfg")"
  [ -n "$suffix" ] || return 0
  while IFS= read -r ver; do
    tags="$(cut_tags "$repo" "$ver")" || { fail "$name $ver: cannot list its tags on $repo, so no promotion is checked"; return 1; }
    [ -z "$tags" ] || break
  done < <(for mark in "$STATE"/cuts/"$name"@*; do [ -f "$mark" ] && printf '%s\n' "${mark##*@}"; done | sort -rV)
  [ -n "$tags" ] || return 0
  while IFS= read -r tag; do
    [ ! -e "$STATE/promoted/$name@$tag" ] || continue
    # The tag's newest deployment to a beta environment names the target, and its latest status.
    id="" env="" build=""
    read -r id env build < <(gh api "repos/$repo/deployments?ref=$tag&per_page=100" \
      --jq "first(.[] | select(.environment | endswith(\"$suffix\"))) | \"\(.id) \(.environment) \(.payload.build? // \"\")\"" 2>/dev/null)
    [ -n "${id:-}" ] || continue
    target="${env%"$suffix"}"
    state="$(gh api "repos/$repo/deployments/$id/statuses" --jq '.[0].state // empty' 2>/dev/null)"
    if [ "$state" = failure ] || [ "$state" = error ]; then
      [ ! -e "$STATE/unshipped/$name@$tag@$id" ] || continue
      [ "$DRY" = 1 ] || { mkdir -p "$STATE/unshipped" && : > "$STATE/unshipped/$name@$tag@$id"; }
      log "$name $tag: the $env deployment $id ended $state: $target is not shipped on $ver, and no default promotion is filed"
      continue
    fi
    [ "$state" = success ] || continue
    item="$(jq -r '.promote.item' <<<"$cfg")"
    item="${item//\{tag\}/$tag}" item="${item//\{build\}/${build:-?}}" item="${item//\{target\}/$target}"
    if [ "$DRY" = 1 ]; then
      log "would file for $name: $item"; actions+=("would file $name $tag promotion"); continue
    fi
    # An automated filer: exit 0 queued, 5 filed as a board row (QUEUE.md "Admission"), 4 the
    # slug already finished; each means the item exists, so the marker stops a second one.
    agent-queue add --project "$name" --from auto:release-cut --slug "steam-default-$name-$tag" \
      --priority high "$item" </dev/null >/dev/null 2>&1
    rc=$?
    [ "$rc" -eq 5 ] || [ "$rc" -eq 0 ] || [ "$rc" -eq 4 ] || { fail "$name $tag: agent-queue add of the promotion failed (exit $rc)"; continue; }
    mkdir -p "$STATE/promoted" && : > "$STATE/promoted/$name@$tag"
    filed=$((filed + 1)); actions+=("filed $name $tag promotion"); log "filed $name $tag promotion: $item"
  done <<<"$tags"
}

[ -r "$CONF" ] || { echo "release-cut: no config at $CONF" >&2; exit 1; }
BOARD="$(notes board --json 2>/dev/null | jq -ce 'objects')" || {
  fail "notes board --json gave no board"; proof_runner_outcome STALLED "notes board --json gave no board"; exit 1; }
# The stats decide whether an epic row closed with proof; without them no early cut is safe.
STATS="$(notes projects --stats --json 2>/dev/null | jq -ce 'arrays')" || {
  fail "notes projects --stats --json gave no stats"; proof_runner_outcome STALLED "notes projects --stats --json gave no stats"; exit 1; }

while IFS= read -r name; do
  [ -z "$ONE" ] || [ "$name" = "$ONE" ] || continue
  cfg="$(jq -c --arg n "$name" '.[$n]' "$CONF")"
  repo="$(repo_of "$name")" || { fail "$name: no GitHub origin for its checkout"; continue; }
  profile="$(jq -r --arg p "$name" 'first(.sprints[]? | select(.project == $p) | .profile) // empty' <<<"$BOARD")"
  [ -n "$profile" ] || { say "$name: no sprint on the board, nothing to cut"; promote "$name" "$repo" "$cfg"; continue; }
  ver="$(notes --profile "$profile" projects --version-of "$name" 2>/dev/null)"
  sp="$(jq -c --arg p "$name" --arg v "$ver" 'first(.sprints[] | select(.project == $p and .version == $v)) // empty' <<<"$BOARD")"
  if [ -z "$sp" ]; then
    say "$name: open version ${ver:-?} has no window, nothing to cut"
    promote "$name" "$repo" "$cfg"; continue
  fi
  committed="$(jq '.tasks | length' <<<"$sp")"
  open_rows="$(jq -r '.tasks[] | select(.state == "open" or .state == "doing") | "  \(.id // "-") [\(.state)] \(.text)"' <<<"$sp")"
  urgent="$(jq -r '[.tasks[] | select((.state == "open" or .state == "doing") and .priority == "urgent") | .id // .text] | join(", ")' <<<"$sp")"
  n_open="$(jq '[.tasks[] | select(.state == "open" or .state == "doing")] | length' <<<"$sp")"
  # Closed #urgent rows that entered after the window opened, with the merge commit agent-land
  # stamped: the fixes a patch cut ships (`id=commit`, space-separated). A row whose PR landed in
  # another repo (`pr_repo`) ships nothing here: this repo's green run can never contain it. Repos
  # match on the lowercased name alone, as notes' shipped.rs `repo_name` does (a marker may be `pr:game#4`).
  fixes="$(jq -r --arg r "$repo" 'def nm: split("/") | last | ascii_downcase;
    [.tasks[] | select(.state == "done" and .interrupt == true and .priority == "urgent" and ((.commit // "") | test("^[0-9a-f]{7,}$")) and ((.pr_repo // $r) | nm) == ($r | nm)) | "\(.id // "-")=\(.commit)"] | join(" ")' <<<"$sp")"
  # Epic rows closed on landed work alone, not on proof of their outcome, keep an early cut off.
  unverified="$(jq -r --argjson st "$STATS" --arg pr "$profile" --arg p "$name" '
    ([$st[] | select(.profile == $pr and .name == $p) | .epics[]? | {key: .id, value: .verified}] | from_entries) as $ep
    | [.tasks[] | select(.state == "done" and .id != null and $ep[.id] == false) | .id] | join(", ")' <<<"$sp")"
  at="$(jq -r '.cut // empty' <<<"$sp")"
  [ -n "$at" ] || at="$(jq -r '.due // empty' <<<"$sp")"
  [[ ! "$at" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || at="${at}T$(jq -r '.cut_hour' <<<"$cfg")"
  # A string compare against NOW, so only the zero-padded local minute is a cut time.
  [ -z "$at" ] || [[ "$at" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$ ]] \
    || { fail "$name $ver: cut time '$at' is not YYYY-MM-DD[THH:MM]"; continue; }

  if [ "$committed" = 0 ]; then
    say "$name $ver: the window commits no rows, nothing to cut"
  elif [ "$n_open" = 0 ] && [ -z "$unverified" ]; then
    cut_release "$name" "$ver" "$repo" "$cfg" "early: all $committed committed rows closed"
  elif [ -z "$urgent" ] && [ -n "$fixes" ] && patch_ready "$name" "$ver" "$repo" "$cfg" "$fixes"; then
    cut_release "$name" "$ver" "$repo" "$cfg" "patch: #urgent fix(es) $(sed -E "s/=[^ ]+//g" <<<"$fixes") on a green full run, carrying $n_open open row(s)"
    [ "$n_open" = 0 ] || printf 'carried to the next sprint:\n%s\n' "$open_rows"
  elif [ -n "$at" ] && [[ ! "$NOW" < "$at" ]]; then
    if [ -n "$urgent" ]; then
      log "$name $ver: past its cut time $at, held by open #urgent row(s): $urgent"
      notify "held-$name@$ver" "release held: $name $ver" "$name $ver passed its cut time $at; open #urgent row(s) hold it: $urgent."
    else
      cut_release "$name" "$ver" "$repo" "$cfg" "on time: cut time $at, carrying $n_open open row(s)"
      [ "$n_open" = 0 ] || printf 'carried to the next sprint:\n%s\n' "$open_rows"
    fi
  elif [ "$n_open" = 0 ]; then
    say "$name $ver: not ready: every row closed, but epic(s) $unverified closed without proof of the outcome; cuts at ${at:-no cut time}"
  else
    say "$name $ver: not ready: $n_open of $committed committed rows open${urgent:+ (#urgent: $urgent)}; cuts at ${at:-no cut time}"
    printf '%s\n' "$open_rows"
  fi
  promote "$name" "$repo" "$cfg"
done < <(jq -r 'keys[] | select(startswith("_") | not)' "$CONF")

summary="${actions[*]:-nothing to cut}"
[ "$DRY" = 0 ] || summary="dry run: $summary"
if [ "$failed" -gt 0 ]; then
  proof_runner_outcome STALLED "$failed failed; $summary"
elif [ "$((dispatched + filed))" -gt 0 ]; then
  proof_runner_outcome WORKED "$summary"
else
  proof_runner_outcome NOOP "$summary"
fi
[ "$failed" = 0 ]
