#!/usr/bin/env bash
# agentctl-inbox-triage: route the outbox and file every project sheet's `## Inbox`, in one sweep.
#
#   agentctl-inbox-triage [--dry-run] [--project <name>] [--backlog [--priority [--retag <word>] | --link | --size | --report]] [--watch]
#   agentctl-inbox-triage --answer <ask id>
#
# A pass starts by splitting lists (`notes outbox split`, `notes ptask <p> split`): two or more checkboxes under a line become one line per ask.
# A `#ask` or `#investigate` outbox line is a question (a quick answer, a longer look): one read-only call answers it into today's notes inbox and the
# line leaves the outbox (`notes outbox answer`), so it is never a row.
# `#p:` outbox lines naming a project exactly, `<id>: <words>` answers and typed inbox lines need no model; the rest of a sweep goes to ONE model
# call (the conf's MODEL; it also gets a `#p:` word that names no project, as a hint), which only proposes rows, a dup, a skip, and whether to plan first.
# A session line (`#agent ... #from/<by>`, a session's own follow-up) never takes the typed path: the model call also gets
# the open rows closest to it (`notes ptask <p> --agent similar`) and answers file, dup or skip; a skip drops the line
# (`dropped` in the ingest record, with the reason), and a filed one never gets `#requested`.
# A session line that is an epic, `epic(<system>): <outcome>`, is a proposal (apply_proposal): file adds it
# #new through epic_new, so the CLI checks it, and the line joins that epic; dup names an open epic; skip
# and improvement need a why.
# An outbox line it cannot place becomes one question to the human (`agent-ask post --kind approval`, which
# the judge never answers): which project, or drop it. The answer runs `--answer <id>`, which moves the
# line to that project's inbox (the next sweep files it) or takes it out of the outbox.
# Every write is the CLI's (`notes outbox move`, `notes ptask --exact file`), so this script never
# edits a sheet, and a skipped or refused line stays put, recorded in the ingest record so later
# sweeps pass it over until its words change (a skipped one is asked once more after this script
# changes). --watch is the runner: a sweep after each save,
# once INBOX_SWEEP_QUIET seconds pass with no other. --backlog re-triages the rows already on the
# boards as the inbox-backlog agent: its own budget, outcome and batch size, so a cleanup never
# stops the intake sweep. --backlog --priority gives each open row with no priority tag one, #urgent, #high,
# #normal or #low, from one Sonnet call per batch (the inbox-priority agent); --retag <word> also re-judges
# the rows tagged #<word>. --backlog --link puts each open typed row with no #of/ under an epic, one Sonnet
# call per batch on the same lane: the model names the row's system and, when one fits, an open
# feature epic or a new #new one; a row with neither goes under its system's standing epic
# (`notes ptask edit --link`). --backlog --size gives each open row with no `#pts/<n>` its
# points by the rubric in .config/inbox-size/prompt.md, one Sonnet call per batch (the inbox-size agent); the tag sets the row's
# #size/ band too, and keeps no answers: its --dry-run shows the calls, the apply asks again.
# The plain --backlog and the --link passes' --dry-run keep their answers, so the apply writes
# what it printed and a dry run stopped at its budget picks up where it stopped. The plain pass
# judges each row by the priority rubric (.config/inbox-triage/rules/priority.md) too: raise a fault filed too low, send an agent row that is a
# nice-to-have to improvements.md, close one that says it is done. It never lists a row fleet-bench
# keys by its prefix (lib/board-keys.sh, backlog_board), whose text fleet-bench alone writes. --backlog --report prints the
# kept answers of every board by verdict, with no model call, for a person to confirm before the apply.
# How it all fits: notes-cli README, "Intake".

set -uo pipefail

NAME="${AGENTCTL_NAME:-inbox-triage}"
TYPES=""   # the row types from `notes row types`, read once a pass
: "${INBOX_TRIAGE_CMD:=agentctl-run --agent inbox-triage}"
: "${INBOX_PRIORITY_CMD:=agentctl-run --agent inbox-priority}"  # --priority: a classify call, so Sonnet (its own conf)
: "${INBOX_SIZE_CMD:=agentctl-run --agent inbox-size}"  # --size: a classify call, so Sonnet (its own conf)
: "${INBOX_BACKLOG_CMD:=agentctl-run --agent inbox-backlog}"  # --backlog: its own conf and budget, so a cleanup pass never spends the intake sweep's day
: "${INBOX_ASK_CMD:=agentctl-run --agent inbox-triage --role observe --context full --max-turns 8}"  # a #ask answer: the observe role may look things up and write nothing, so it keeps the tools a lean route call drops
: "${INBOX_INVESTIGATE_CMD:=agentctl-run --agent inbox-triage --role observe --context full --max-turns 25}"  # a #investigate look: more turns, the same per-call cap
: "${INBOX_TRIAGE_PASSES:=3}"
: "${INBOX_TRIAGE_MAX:=40}"   # the most lines one model call carries (route and --backlog); budget_batch sizes each call under it
: "${INBOX_SWEEP_QUIET:=30}"  # --watch: seconds with no save before a sweep runs
: "${INBOX_RETRY_S:=900}"      # --watch: wait before a failed sweep runs again by itself; doubles each failure
: "${INBOX_RETRY_MAX_S:=7200}" # --watch: the longest that wait grows to
: "${INBOX_ASK_PROJECT_MAX:=5}" # the most "which project?" asks one sweep posts; provisional, revisit when a paste leaves lines over it

EX_NO_PROJECT=3   # `notes outbox move`: the name matches no current project

HERE="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
LIB="$HERE/../lib"
# shellcheck source=/dev/null
. "$LIB/agent-proof.sh"
# shellcheck source=/dev/null
. "$HERE/../src/agent-run/lib/budget.sh"
# shellcheck source=/dev/null
. "$LIB/md-render.sh"
# shellcheck source=/dev/null
. "$LIB/inbox-epics.sh"
# shellcheck source=/dev/null
. "$LIB/prompt-render.sh"
# shellcheck source=../lib/chain-event.sh
. "$LIB/chain-event.sh"
# shellcheck source=../lib/board-keys.sh
. "$LIB/board-keys.sh"   # BOARD_KEY_ERE: the rows fleet-bench finds by their prefix, which --backlog leaves alone
# shellcheck source=../../.config/shared-hooks/project-name.sh
. "${PROJECT_NAME_LIB:-$HERE/../../.config/shared-hooks/project-name.sh}"

# Each call's instructions: a template its agent's conf names as PROMPT (judges.md), found beside
# this script in its repo (the conf's path resolves to the same file once stowed). The rubrics the
# calls share are included from .config/inbox-triage/rules/, so a rule changed is one edit and a
# new prompt version for every call that carries it.
PROMPTS="$HERE/../../.config"
ROUTE_PROMPT="$PROMPTS/inbox-triage/route.md"        # inbox-triage
ASK_PROMPT="$PROMPTS/inbox-triage/ask.md"            # inbox-triage, a #ask or #investigate line
BACKLOG_PROMPT="$PROMPTS/inbox-backlog/prompt.md"    # inbox-backlog
PRIORITY_PROMPT="$PROMPTS/inbox-priority/priority.md" # inbox-priority
LINK_PROMPT="$PROMPTS/inbox-priority/area.md"        # inbox-priority, the --link pass
SIZE_PROMPT="$PROMPTS/inbox-size/prompt.md"          # inbox-size

DRY=0; ONLY=""; BACKLOG=0; PRIORITY=0; SIZE=0; SCORED=0; RETAG=""; LINK=0; LINKED=0; STANDING=0; NEW_EPICS=0; declare -A NEW_SEEN=(); TAGGED=0; WATCH=0; WAIT=0; SUMMARY=""; FILED=0; KEPT=0; FAILED=0; ROUTED=0; OVER=0
REWROTE=0; MOVED=0; DROPPED=0; RAISED=0; CLOSED_DONE=0; REPORT=0; IMPROVED=0; CAPPED=0; BUDGET_STOP=0; ANSWERED=0; ASKED=0; VERDICT=keep; VDEST=""; VPRIO=""
OUT=""; ANSWER_ID=""; DEFERRED='[]'; LINES_DROPPED=0
FLAG=""; RECORD=""; OUTBOX=""
STATE="${AGENTCTL_STATE_DIR:-$HOME/.local/state/agentctl}"
PAUSED="$STATE/PAUSED"
say() { printf 'inbox-triage: %s\n' "$*" >&2; }
# clean <width>: model text as one printable ASCII line, punctuation folded rather than dropped.
clean() { md_ascii | tr -cd ' -~' | cut -c1-"$1"; }

# ask <template> <items> <label> [cmd [sized]]: one model call over <items> lines or rows, its
# prompt <template> filled from the caller's variables (agentctl-run records the template's sha),
# its answer in OUT. A template that does not render is this script's fault, so the pass fails and
# no line is refused. A failed call keeps its stderr in the log and its first words (a usage limit,
# an auth error) as the pass's reason; one stopped at the per-call cap (CALLS_RC_CAPPED) halves the
# next batch, and a clean one lets it grow. It runs from an empty directory, so no repo's Stop hook
# answers in place of the model. A call with its own <cmd> (a #ask answer) leaves the batch size
# alone, unless it passes sized (a --backlog, --priority, --link or --size batch).
ask() {
  local wd err rc first prompt cmd="${4:-$INBOX_TRIAGE_CMD}" sized=1
  [ -n "${4:-}" ] && [ "${5:-}" != sized ] && sized=0
  if ! prompt_render_into prompt "$1"; then
    say "$3: its prompt $1 did not render"
    proof_why "$3: its prompt did not render"
    return 1
  fi
  wd="$(mktemp -d)"; err="$(mktemp)"
  # shellcheck disable=SC2086 # a word list by design, overridable in tests
  OUT="$(cd "$wd" && $cmd --rendered-prompt "$1" -p <<<"$prompt" 2>"$err")"; rc=$?
  [ -s "$err" ] && head -n 20 "$err" >&2
  case "$rc" in
    0) [ "$sized" = 1 ] && budget_batch_note "$NAME" ok "$2" ;;
    "$CALLS_RC_CAPPED")
      if [ "$sized" = 1 ]; then
        budget_batch_note "$NAME" capped "$2"
        say "$3: the call stopped at its per-call cap with $2 items; the next carries $(budget_batch "$NAME" "$INBOX_TRIAGE_MAX")"
      else
        say "$3: the call stopped at its per-call cap"
      fi
      proof_why "$3: a call of $2 stopped at the per-call cap" ;;
    "$EX_BUDGET")
      BUDGET_STOP=1
      say "$3: stopped at its budget"
      proof_why "stopped at its budget" ;;
    *)
      first="$(cat - "$err" <<<"$OUT" | grep -m1 '[^[:space:]]' | clean 120)"
      say "$3: model call failed: ${first:-no output}"
      proof_why "model call failed: ${first:-no output}" ;;
  esac
  rm -rf -- "$wd" "$err"
  return "$rc"
}

# answered <label>: OUT holds an answer block, else the pass's reason says it did not.
answered() {
  grep -qx 'INBOX-TRIAGE-START' <<<"$OUT" && return 0
  say "$1: model returned no answer block"
  proof_why "$1: the model returned no answer block"
  return 1
}

# ask_line <look> <raw> <question> <text> <details>: an outbox line marked for a look (`notes outbox
# list --json` .look, its .question the text without its tags): `ask`, a quick answer, or
# `investigate`, a longer look with more turns and lines.
# One read-only call answers it, `notes outbox answer` writes question and answer to today's notes
# inbox and takes the line out of the outbox. A failed call leaves the line to the next sweep; an
# answer that came back without its block, a call too big for its cap, or a line with no question
# is recorded refused so the line waits for the person.
ask_line() {
  local look="$1" raw="$2" text="$4" details="$5" q reply rc cmd lines investigate="" evidence_lines
  case "$look" in
    investigate) cmd="$INBOX_INVESTIGATE_CMD" lines=30 investigate=1 ;;
    *)           cmd="$INBOX_ASK_CMD" lines=12 ;;
  esac
  evidence_lines=$((lines - 4))
  q="$(md_ascii <<<"$3" | tr -cd ' -~' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
  if [ -z "$q" ]; then note refused outbox "the #$look line holds no question" "$text"; FAILED=$((FAILED + 1)); return 1; fi
  if [ "$DRY" = 1 ]; then printf 'would %s [outbox] %s\n' "${look/#ask/answer}" "$raw"; ANSWERED=$((ANSWERED + 1)); return 0; fi
  ask "$ASK_PROMPT" 1 "$look" "$cmd"; rc=$?
  if [ "$rc" != 0 ]; then
    # A cap is recorded refused; any other failure (a usage limit, the budget) leaves the line for the next sweep.
    [ "$rc" = "$CALLS_RC_CAPPED" ] && { note refused outbox "the answer call stopped at the per-call cap" "$text"; FAILED=$((FAILED + 1)); }
    return "$rc"
  fi
  reply="$(sed -n '/^INBOX-ANSWER-START$/,/^INBOX-ANSWER-END$/p' <<<"$OUT" | sed '1d;$d' | md_ascii | tr -cd '\n -~' | cut -c1-300 | awk -v n="$lines" 'NR<=n')"
  if [ -z "$(tr -d '[:space:]' <<<"$reply")" ]; then
    say "outbox: the answer came back with no block, left: $raw"
    note refused outbox "the model returned no answer block" "$text"
    FAILED=$((FAILED + 1)); return 1
  fi
  if notes outbox answer -- "$raw" <<<"$reply" >/dev/null; then
    ANSWERED=$((ANSWERED + 1))
  else
    say "outbox: not answered, left in the outbox: $raw"
    FAILED=$((FAILED + 1)); return 1
  fi
}

# One model answer line -> n, action, id, line, project, lane, plan (1 or empty), why, epic, own,
# rows (joined by RS), projects (an ask's, joined by commas), split by US.
# shellcheck disable=SC2016 # jq source, not shell
ANSWER_JQ='def s: (. // "") | tostring | gsub("[[:cntrl:]]"; " ");
  fromjson? | select(type == "object" and (.n | type) == "number")
  | [(.n | floor | tostring), (.action | s), (.id | s),
     (.line | if type == "number" then floor | tostring else "" end), (.project | s), (.lane | s),
     (if .plan == true then "1" else "" end), (.why | s), (.epic | s), (.own | s),
     ([.rows[]? | strings | s] | join("\u001e")), ([.projects[]? | strings | s] | join(","))] | join("\u001f")'

# note <action> <from> <why> <text> [near]: a left or refused line in the ingest record, which keeps
# it out of later sweeps until its words change (a left one, until this script changes; see pass).
# near: the projects the lines written beside it were filed to, comma-separated.
note() {
  [ "$DRY" = 1 ] && return 0
  local -a near=()
  [ -z "${5:-}" ] || near=(--near "$5")
  notes ingest record --action "$1" --from "$2" --why "$3" "${near[@]}" -- "$4" >/dev/null 2>&1 \
    || say "$2: not recorded as $1: $4"
}

# left <from> <text> <why> [near]: a line the model passed over, counted and recorded.
left() { KEPT=$((KEPT + 1)); note left "$1" "$3" "$2" "${4:-}"; }

# ask_project <text> <why> <context> <project...>: the human asked which project an outbox line is
# for, or to drop it, as an approval (the judge never answers one: only the human knows what they meant).
# Recorded as `asked` with the ask's id, which keeps the line out of later routing and is how
# --answer finds it. Over the sweep's cap the line is not recorded, only held for the rest of the
# sweep (DEFERRED), so the next sweep asks it: answering an ask moves a line, and that save wakes
# one. A failed post leaves the line with why.
ask_project() {
  local text="$1" why="$2" context="$3" p opts="" q t id errf
  shift 3
  [ "$#" -gt 0 ] || { left outbox "$text" "${why:-unclear which project}"; return 0; }
  if [ "$ASKED" -ge "$INBOX_ASK_PROJECT_MAX" ]; then
    KEPT=$((KEPT + 1)); DEFERRED="$(jq -c --arg t "$text" '. + [$t]' <<<"$DEFERRED")"; return 0
  fi
  for p in "$@"; do opts+="$p=file it on $p|"; done
  # Names every option's project, so a name like zmk_config is not refused as an undefined term.
  context+="${context:+. }The projects it could go to: $*"
  opts+="drop=take the line out of the outbox, it needs no row"
  t="$text"; [ "${#t}" -le 100 ] || t="${t:0:97}..."
  q="Which project is this outbox line for: \"$t\"?"
  if [ "$DRY" = 1 ]; then printf 'would ask [%s] %s\n' "$*" "$q"; ASKED=$((ASKED + 1)); return 0; fi
  # Not this runner's session or pane: the ask is the line's, and the triage runner must not read
  # as blocked on it.
  errf="$(mktemp)"
  if id="$(env -u CLAUDE_CODE_SESSION_ID -u TMUX -u TMUX_PANE -u AGENTCTL_NAME agent-ask post --kind approval --project "$1" \
      --options "$opts" --recommend "$1" --why "${why:-the likeliest of the projects it could be}" --context "$context" \
      --resume 'run:agentctl-inbox-triage --answer' -- "$q" 2>"$errf" | tail -n 1)" && [ -n "$id" ]; then
    rm -f -- "$errf"
    note asked outbox "$id" "$text"
    ASKED=$((ASKED + 1))
  else
    say "outbox: the which-project ask did not post: $(tail -n 1 "$errf")"; rm -f -- "$errf"
    left outbox "$text" "unclear which project (likeliest $1); the ask did not post"
  fi
}

# want_channel <from>: the channel a filed line came in by - the outbox, or a project's own inbox (the human's).
want_channel() { if [ "$1" = outbox ]; then echo outbox; else echo human; fi; }

# file_line <project> <raw> <text> <args...>: one `ptask file`, counted, FILED_ID set to the id of
# the first row it wrote (the CLI prints the rows on stdout). A refusal is recorded with the CLI's reason.
file_line() {
  local p="$1" raw="$2" text="$3" out err errf; shift 3
  FILED_ID=""
  if [ "$DRY" = 1 ]; then printf 'would file [%s] %s:' "$p" "$raw"; printf ' %q' "$@"; echo; FILED=$((FILED + 1)); return 0; fi
  errf="$(mktemp)"
  if out="$(notes ptask "$p" --exact file "$@" -- "$raw" 2>"$errf")"; then
    rm -f -- "$errf"
    printf '%s\n' "$out"
    # A written row's marker, never the echoed `filed <words>` line, which holds the person's words.
    FILED_ID="$(sed -n '/^  - \[ \] .*<!-- id:\([a-z][a-z0-9]*-[0-9][0-9]*\).*/{s//\1/p;q;}' <<<"$out")"
    FILED=$((FILED + 1))
  else
    err="$(<"$errf")"; rm -f -- "$errf"
    [ -n "$out" ] && printf '%s\n' "$out"
    say "$p: not filed, left in the inbox: $raw${err:+ ($err)}"
    note refused "$p" "$(tail -n 1 <<<"${err:-refused}" | clean 160)" "$text"
    FAILED=$((FAILED + 1)); return 1
  fi
}

# move_out <project> <raw> <text> <why> [tagged]: one outbox line into <project>'s inbox, with <why>
# (how the project was picked) on its `moved` event, and MOVED_RAW set to the line as the inbox
# now holds it. A name that is no project (the CLI exits 3) is recorded as refused and the line
# stays in the outbox, unless the line was `tagged` with it: then it is the caller's to route, so
# nothing is recorded or counted.
move_out() {
  local p="$1" raw="$2" text="$3" why="$4" tagged="${5:-}" out err rc errf
  MOVED_RAW="$raw"
  if [ "$DRY" = 1 ]; then printf 'would move [outbox -> %s] %s\n' "$p" "$raw"; ROUTED=$((ROUTED + 1)); return 0; fi
  errf="$(mktemp)"
  if out="$(notes outbox move --project "$p" --why "$why" -- "$raw" 2>"$errf")"; then
    rm -f -- "$errf"
    printf '%s\n' "$out"
    # The line as the inbox holds it now: the `#p:` word is gone, so this is what to file.
    MOVED_RAW="$(sed -n '/^  line: /{s///p;q;}' <<<"$out")"; MOVED_RAW="${MOVED_RAW:-$raw}"
    ROUTED=$((ROUTED + 1))
  else
    rc=$?; err="$(<"$errf")"; rm -f -- "$errf"
    if [ -n "$tagged" ] && [ "$rc" = "$EX_NO_PROJECT" ]; then return "$EX_NO_PROJECT"; fi
    say "outbox: not moved to $p, left in the outbox: $raw${err:+ ($err)}"
    note refused outbox "$(tail -n 1 <<<"${err:-not moved}" | clean 160)" "$text"
    FAILED=$((FAILED + 1)); return 1
  fi
}

# An outbox line that answers an open row: `<id>: <words>`.
# shellcheck disable=SC2016 # jq source, not shell
ID_LINE_RE='^(?<id>[a-z][a-z0-9]*-[0-9]+):\s'

# A session's follow-up carries `#from/<writer>` (the writer adds it): not the person's words, so
# it is never typed-and-filed with no model, never #requested, and a skip drops it.
# One pattern for bash (is_session) and jq (`test`): POSIX classes work in both.
SESSION_RE='(^|[[:space:]])#from/[^[:space:]]'
is_session() { [[ "$1" =~ $SESSION_RE ]]; }

# An epic a session proposes: a session line whose words are `epic(<system>): <outcome>`. An
# unattended writer's epic reaches the outbox as one (`notes ptask add` exits 4), never the sheet.
is_proposal() { is_session "$1" && [[ "$(untagged "$1")" == epic\(* ]]; }

# apply_proposal <action> <id> <project> <rows> <why> <how> <epics> <board>: the model's verdict on
# an epic proposal, with route's line (n, from, raw, text) in scope. file: the epic goes through
# epic_new, so `notes ptask add` checks it as triage's (a listed system, no standing title, an open
# twin's id instead of a second epic), and the line joins it as its `was:` words; dup: the line joins
# the open epic the model names, never a row that is no epic; skip and improvement say why. Every
# outcome keeps the line's words, so a `#plan/<slug>` on it is on the event that holds the verdict.
# PROPOSAL_DEST is the epic's project once the line has left; returns 1 when it stays.
apply_proposal() {
  local action="$1" id="$2" dest="$3" rows="$4" why="$5" how="$6" epics="$7" board="$8"
  local p r epic eid rc src="$from" idf
  local -a args=(--lane human) rowv
  PROPOSAL_DEST=""
  case "$action" in
    file|dup) ;;
    skip|improvement)
      [ -n "$why" ] || { leave "$action of an epic proposal with no why"; return 1; }
      if [ "$action" = skip ]; then drop_session "$from" "$raw" "$text" "$how" || return 1
      else keep_improvement "$from" "$raw" "$text" "$dest" "$how" "$board" || return 1; fi
      PROPOSAL_DEST="${dest:-$from}"; return 0 ;;
    *) leave "${why:-skipped}"; return 1 ;;
  esac
  if [ "$action" = dup ]; then
    eid="$(clean 40 <<<"$id")"
    p="$(awk -F'\t' -v i="$eid" '$1 == i { print $2; exit }' <<<"$epics")"
    [ -n "$eid" ] && [ -n "$p" ] || { leave "dup of ${eid:-no row}, which is no open epic"; return 1; }
    how="epic proposal: joins open epic $eid; $how"
  else
    p="$dest"; [ -n "$p" ] || [ "$from" = outbox ] || p="$from"
    [ -n "$p" ] || { leave "no project"; return 1; }
    # The epic the model wrote, else the line's own words.
    IFS=$'\x1e' read -r -a rowv <<<"$rows"
    epic=""
    for r in "${rowv[@]}"; do [[ "$(untagged "$r")" == epic\(* ]] && { epic="$r"; break; }; done
    idf="$(mktemp)"
    # In this shell, not `$(...)`, so EPIC_TWIN and EPIC_WHY reach here.
    epic_new "$p" "$(clean 150 <<<"${epic:-$text}")" >"$idf"; rc=$?
    eid="$(<"$idf")"; rm -f -- "$idf"
    case "$rc" in
      0) if [ -n "$EPIC_TWIN" ]; then how="epic proposal: twin of open epic $eid; $how"
         else how="epic proposal: filed as new epic $eid; $how"; fi ;;
      2) eid="<the new epic>" how="epic proposal: filed as a new epic; $how" ;;
      *) say "$from: epic proposal not filed, left: $raw ($EPIC_WHY)"
         note refused "$from" "epic proposal not filed: $EPIC_WHY" "$text"
         FAILED=$((FAILED + 1)); return 1 ;;
    esac
  fi
  if [ "$from" = outbox ]; then
    move_out "$p" "$raw" "$text" "$how" || return 1
    raw="$MOVED_RAW" src="$p"
  elif [ "$p" != "$from" ]; then
    args+=(--project "$p")
  fi
  file_line "$src" "$raw" "$text" --dup "$eid" "${args[@]}" --why "$how" || return 1
  PROPOSAL_DEST="$p"
}

# INBOX_SIMILAR_TOP: how many of the closest open rows an inbox line is shown (`notes ptask similar`).
: "${INBOX_SIMILAR_TOP:=10}"

# similar_rows <n> <project> <text>: the open rows closest to a project's inbox line, as
# `n<TAB>id<TAB>percent<TAB>lane<TAB>text`, best first, from both boards of the project (a line
# may repeat a row on either lane). A failed read fails the call: a line shown no candidates
# would be filed with no dedupe.
similar_rows() {
  local n="$1" p="$2" text="$3" out="" got lane
  local -a on
  for lane in human agent; do
    on=(); [ "$lane" = agent ] && on=(--agent)
    got="$(notes ptask "$p" "${on[@]}" similar --top "$INBOX_SIMILAR_TOP" -- "$text" 2>&1)" || {
      say "$p: notes ptask similar failed (an old notes? notes-bootstrap --build-only): $(tail -n 1 <<<"$got")"
      return 1
    }
    [ -z "$got" ] || out+="$(awk -F'\t' -v n="$n" -v l="$lane" '$1 != "-" { printf "%s\t%s\t%s\t%s\t%s\n", n, $1, $2, l, $3 }' <<<"$got")"$'\n'
  done
  sort -s -t $'\t' -k3,3nr <<<"$out" | awk -v top="$INBOX_SIMILAR_TOP" 'NF && ++k <= top'
}

# remove_line <from> <raw> <text> <why>: a session line leaves its outbox or inbox, recorded
# `dropped` with the reason. The one removal, for a skip (drop_session) and an improvement.
remove_line() {
  local from="$1" raw="$2" text="$3" why="$4"
  if [ "$from" = outbox ]; then
    notes outbox drop --why "$why" -- "$raw" >/dev/null
  else
    notes ptask "$from" --exact file --skip --why "$why" -- "$raw" >/dev/null
  fi || {
    say "$from: not dropped, left: $raw"
    # A refused record keeps the line out of later sweeps; <quiet> leaves none, so a line whose
    # write already happened is tried again.
    [ -n "${5:-}" ] || note refused "$from" "the skip could not be applied" "$text"
    FAILED=$((FAILED + 1)); return 1
  }
}

# drop_session <from> <raw> <text> <why>: a session line the model skipped leaves its outbox or
# inbox, recorded `dropped` with the reason, so a follow-up nobody reads never waits there.
drop_session() {
  local from="$1" raw="$2" text="$3" why="$4"
  if [ "$DRY" = 1 ]; then printf 'would drop [%s] %s (%s)\n' "$from" "$raw" "$why"; LINES_DROPPED=$((LINES_DROPPED + 1)); return 0; fi
  remove_line "$from" "$raw" "$text" "$why" || return 1
  LINES_DROPPED=$((LINES_DROPPED + 1))
}

# keep_improvement <from> <raw> <text> <project> <why> <board>: the `improvement` verdict. Only a
# session's follow-up on a project of the board is kept (a person's line is a want, never a
# nice-to-have to shelve); anything else is left. An outbox line names its project, an inbox line
# is about its own. Returns 1 when the line was left or could not be kept.
keep_improvement() {
  local from="$1" raw="$2" text="$3" dest="$4" why="$5" board="$6"
  is_session "$text" || { leave "improvement verdict on a line that is not a session's"; return 1; }
  [ "$from" != outbox ] && dest="${dest:-$from}"
  jq -e --arg p "$dest" 'any(.projects[]; .project == $p)' <<<"$board" >/dev/null \
    || { leave "improvement of no project on the board: ${dest:-none}"; return 1; }
  improve_line "$from" "$raw" "$text" "$dest" "$why"
}

# ask_context <n> <text>: what the person wrote around outbox line <n>, so an answer to the
# project question can be given from its card alone. Reads route's froms and texts.
ask_context() {
  local n="$1" ctx="Your outbox line: $2" k
  for k in $((n - 1)) $((n + 1)); do
    [ "$k" -ge 1 ] && [ "$k" -le "${#texts[@]}" ] && [ "${froms[k - 1]}" = outbox ] || continue
    ctx+=". Written $([ "$k" -lt "$n" ] && echo before || echo after) it: ${texts[k - 1]}"
  done
  printf '%s' "$ctx"
}

# improve_line <from> <raw> <text> <project> <why>: a session's nice-to-have goes to <project>'s
# improvements.md (`notes improve`, the one writer, which never touches ideas.md) and leaves its
# outbox or inbox. The write comes first: a failed removal leaves the line, and the retry finds
# it already kept.
improve_line() {
  local from="$1" raw="$2" text="$3" dest="$4" why="$5"
  if [ "$DRY" = 1 ]; then printf 'would improve [%s -> %s] %s (%s)\n' "$from" "$dest" "$raw" "$why"; IMPROVED=$((IMPROVED + 1)); return 0; fi
  # A failed write records nothing (an older notes with no `improve` verb is fixed by
  # notes-bootstrap --build-only): the line stays and the next sweep asks again.
  notes improve "$dest" --why "$why" -- "$text" >/dev/null || {
    say "$from: not kept as an improvement of $dest (an old notes? notes-bootstrap --build-only), left: $raw"
    proof_why "notes improve failed"
    FAILED=$((FAILED + 1)); return 1
  }
  remove_line "$from" "$raw" "$text" "improvement: kept in $dest improvements.md" quiet || return 1
  IMPROVED=$((IMPROVED + 1))
}

# answer <id> <raw> <text> <board json>: an outbox line `<id>: <words>`, with no model. Its words
# join the open row as a dup does (moved to the row's project, then `file --dup`, which keeps them
# as the row's `was:` line), and a decide row is closed by it. No open row is `left`, with why.
answer() {
  local id="$1" raw="$2" text="$3" row p lane ty how="id answer: $1"
  row="$(jq -r --arg id "$id" 'first(.rows[] | select(.id == $id and (.lane == "human" or .lane == "agent"))
    | [.project, .lane, (.type // "-")] | join("\u001f")) // ""' <<<"$4")"
  [ -n "$row" ] || { left outbox "$text" "no open row $id"; return 0; }
  IFS=$'\x1f' read -r p lane ty <<<"$row"
  move_out "$p" "$raw" "$text" "$how" || return 1
  raw="$MOVED_RAW"
  file_line "$p" "$raw" "$text" --dup "$id" --lane "$lane" --why "$how" || return 1
  [ "$ty" = decide ] || return 0
  pt "$p" "$lane" done "$id" --proof "ingest:$(date +%F)"
}

# The flag every notes inbox writer touches (`ptask add`, the Focus sweep): its stamp, or empty.
flag_state() { [ -n "$FLAG" ] && cat "$FLAG" 2>/dev/null; }

# shared_repos: the projects whose code lives in another project's repo, "name (in repo)", from the
# registry: rules/homes.md says where a row about one of them, or the code they share, belongs.
shared_repos() {
  jq -r '[.trackers // {} | to_entries[] | select((.value.repo // .key) != .key) | "\(.key) (in \(.value.repo))"] | join(", ")' "$(project_map_file)" 2>/dev/null
}

# row_types: the types a row may take, from the grammar's one home (`notes row types`). An
# empty list would let the model file any type, so a failure stops the call.
row_types() {
  local t
  t="$(notes row types 2>/dev/null)" && [ -n "$t" ] && { printf '%s\n' "$t"; return 0; }
  say "notes row types failed (an old notes? notes-bootstrap --build-only)"
  proof_why "notes row types failed"; return 1
}

# route <lines json> <board json>: the one model call for a sweep's untyped lines, each
# {from, raw, text, details}, `from` being `outbox` or the project whose inbox holds it.
route() {
  local lines="$1" board="$2" names shared_repos srcs wide batch open epics systems out types unattended
  types="$(row_types)" || return 1
  names="$(jq -r '[.projects[] | "\(.project) (\(.profile))"] | unique | join(", ")' <<<"$board")"
  shared_repos="$(shared_repos)"
  unattended="$(unattended_projects)"
  srcs="$(jq -c '[.[].from] | unique' <<<"$lines")"
  wide="$(jq 'any(.[]; .from == "outbox")' <<<"$lines")"
  local -a froms=() raws=() texts=() nears=()
  mapfile -d '' -t froms < <(jq -j '.[] | .from, "\u0000"' <<<"$lines")
  mapfile -d '' -t raws < <(jq -j '.[] | .raw, "\u0000"' <<<"$lines")
  mapfile -d '' -t texts < <(jq -j '.[] | .text, "\u0000"' <<<"$lines")
  mapfile -d '' -t nears < <(jq -j '.[] | ((.near // []) | join(",")), "\u0000"' <<<"$lines")
  batch="$(jq -r 'to_entries[] | "\(.key + 1). [\(.value.from)] \(.value.text)" + (if (.value.hint // "") != "" then " (tagged #p:\(.value.hint), which is no project; it may name one of the projects above)" else "" end) + (if (.value.near // []) != [] then " (asked before: the lines written beside it went to \(.value.near | join(" and ")))" else "" end), (.value.details[]? | "   " + .)' <<<"$lines")"
  # An outbox line can go anywhere, so with one in the batch each project shows its newest rows.
  # A project's inbox line is shown only its closest rows (below), never its whole board, which
  # on a board of a thousand rows costs more than the sweep's day budget allows.
  open="$(jq -r --argjson wide "$wide" '
    [.rows[] | select($wide and .project != null and .state != "done" and .id != null)] | group_by(.project)[]
    | sort_by(.since // "") | reverse | .[:8][]
    | "\(.id)\t\(.project)\t\(.lane)\t\(.text)"' <<<"$board" | cut -c1-160)"
  # An inbox line's candidates for a dup: the rows closest to it by the writer's own twin scoring.
  local closest="" k
  for k in "${!froms[@]}"; do
    [ "${froms[k]}" != outbox ] || continue
    closest+="$(similar_rows "$((k + 1))" "${froms[k]}" "${texts[k]}")" || { proof_why "notes ptask similar failed"; return 1; }
    closest+=$'\n'
  done
  closest="$(sed '/^$/d' <<<"$closest" | cut -c1-200)"
  epics="$(epics_open "$board")"
  # The system lists of the projects a line can go to: its own, or every one for an outbox line.
  local -a sysp=()
  mapfile -t sysp < <(jq -r --argjson src "$srcs" --argjson wide "$wide" \
    'if $wide then [.projects[].project] else $src - ["outbox"] end | unique[]' <<<"$board")
  systems="$(systems_of "${sysp[@]}")"
  # The two paragraphs rules/session.md adds: one when a line is a session's, one when it proposes an epic.
  local session_line="" proposal_line="" t
  for t in "${texts[@]}"; do
    is_session "$t" && session_line=1
    is_proposal "$t" && proposal_line=1
  done
  ask "$ROUTE_PROMPT" "${#raws[@]}" route || return
  answered route || return 1
  out="$OUT"
  local n action id of dest lane plan why how epic rows cands r from raw text src eid ctx k near go own_plan
  local -a cv
  local -a args rowv asv
  # The row each filed line wrote (id, project, lane), by n, for a later line that repeats it, and
  # the project of every line filed or joined, by n, for an outbox line left beside it.
  local -A line_id=() line_dest=() left_why=()
  # leave <why>: a line passed over. An outbox one is recorded after the loop, when every line
  # beside it is filed, with their projects (see pass).
  leave() { if [ "$from" = outbox ]; then left_why[$n]="$1"; else left "$from" "$text" "$1"; fi; }
  local filed_board=""
  local own
  while IFS=$'\x1f' read -r n action id of dest lane plan why epic own rows cands; do
    [ "$n" -ge 1 ] 2>/dev/null && [ "$n" -le "${#raws[@]}" ] || continue
    raw="${raws[n - 1]}" from="${froms[n - 1]}" text="${texts[n - 1]}"
    [ -n "$raw" ] || continue
    raws[n - 1]=""   # one answer per line
    why="$(clean 100 <<<"$why")"
    how="model: ${why:-no why}"
    dest="$(clean 60 <<<"$dest")"
    # An outbox line goes where its own words point, read without its neighbours, whenever they
    # point to a project on the board: the neighbours decide only a line whose words name none.
    own="$(clean 60 <<<"$own")"
    if [ "$from" = outbox ] && [ "$action" = file ] && [ -n "$own" ] && [ "$own" != "$dest" ] \
      && jq -e --arg p "$own" 'any(.projects[]; .project == $p)' <<<"$board" >/dev/null; then
      say "outbox: line $n's own words point to $own, its neighbours to ${dest:-none}: filed on $own"
      dest="$own"
      how="own words: $own; model: ${why:-no why}"
    fi
    src="$from"
    if is_proposal "$text"; then
      apply_proposal "$action" "$id" "$dest" "$rows" "$why" "$how" "$epics" "$board" && line_dest[$n]="$PROPOSAL_DEST"
      continue
    fi
    case "$action" in
      file|dup)
        args=()
        if [ "$action" = dup ] && [ -n "$of" ]; then
          # A repeat of a line above joins the row that line filed. Every filing is done by now (the
          # answers are sorted), so one board read after them holds the row: its project and lane,
          # as for any dup, since the CLI may file on a lane the model did not name (`#agent`).
          id="${line_id[$of]:-}"
          [ -n "$id" ] || { leave "dup of line $of, which filed no row"; continue; }
          if [ "$DRY" = 1 ]; then
            dest="${line_dest[$of]}"; args=(--dup "$id")
          else
            [ -n "$filed_board" ] || filed_board="$(notes board --json 2>/dev/null | managed_board)" || filed_board='{"rows": []}'
            dest="$(jq -r --arg id "$id" 'first(.rows[] | select(.id == $id) | .project) // ""' <<<"$filed_board")"
            args=(--dup "$id" --lane "$(jq -r --arg id "$id" 'first(.rows[] | select(.id == $id) | .lane) // "human"' <<<"$filed_board")")
          fi
        elif [ "$action" = dup ]; then
          id="$(clean 40 <<<"$id")"
          [ -n "$id" ] || { leave "dup of no row"; continue; }
          # A dup's project and lane are the open row's, never the model's word for them.
          dest="$(jq -r --arg id "$id" 'first(.rows[] | select(.id == $id) | .project) // ""' <<<"$board")"
          args=(--dup "$id" --lane "$(jq -r --arg id "$id" 'first(.rows[] | select(.id == $id) | .lane) // "human"' <<<"$board")")
        else
          IFS=$'\x1e' read -r -a rowv <<<"$rows"
          asv=()
          # The person's own #plan and #go are theirs, not the model's to drop: #plan plans the row
          # first, and #go lets a requested row's plan run with no review (agentctl-inbox-plan).
          # Every row filed here is requested, so the rule is: a row's #plan holds it for review
          # only when the person typed #plan and no #go; any other #plan gets #go beside it.
          own_plan=''; [[ " ${text,,} " == *" #plan "* ]] && own_plan=1 plan=1
          go=1; [ -n "$own_plan" ] && [[ " ${text,,} " != *" #go "* ]] && go=''
          for r in "${rowv[@]}"; do
            r="$(epic_checked "$(clean 150 <<<"$r")" "${dest:-$from}" "$epics")"
            if [ -n "$plan" ] && [ "${#asv[@]}" = 0 ] && [[ " $r " != *" #plan "* ]]; then r="$r #plan"; fi
            if [ -n "$go" ] && [[ " $r " == *" #plan "* && " $r " != *" #go "* ]]; then r="$r #go"; fi
            [ -n "$r" ] && asv+=("$r")
          done
          [ "${#asv[@]}" -gt 0 ] || { leave "no row"; continue; }
          [ "$lane" = agent ] && args+=(--lane agent)
          # A routed line is a want: the writer stamps it, so no row text here carries #requested.
          # A session's follow-up is no one's want, so it carries no channel and the row no stamp.
          is_session "$text" || args+=(--want "$(want_channel "$from")")
        fi
        if [ "$from" = outbox ]; then
          [ -n "$dest" ] || { leave "no project"; continue; }
          move_out "$dest" "$raw" "$text" "$how" || continue
          raw="$MOVED_RAW"
          src="$dest"
        elif [ -n "$dest" ] && [ "$dest" != "$from" ]; then
          args+=(--project "$dest")
        fi
        # A new epic goes on its sheet before the rows that go under it.
        if [ "$action" = file ]; then
          if [ -n "$epic" ] && eid="$(epic_new "${dest:-$from}" "$(clean 150 <<<"$epic")")"; then
            for r in "${!asv[@]}"; do asv[r]="$(under_epic "${asv[r]}" "$eid")"; done
          fi
          for r in "${asv[@]}"; do args+=(--as "$r"); done
        fi
        file_line "$src" "$raw" "$text" "${args[@]}" --why "$how" || continue
        if [ "$action" = file ]; then
          [ "$DRY" = 1 ] && FILED_ID="<the row of line $n>"
          line_id[$n]="$FILED_ID"
        fi
        line_dest[$n]="${dest:-$from}"
        ;;
      improvement)
        keep_improvement "$from" "$raw" "$text" "$dest" "$how" "$board" && line_dest[$n]="${dest:-$from}" || continue ;;
      ask)
        [ "$from" = outbox ] && ! is_session "$text" || { left "$from" "$text" "${why:-skipped}"; continue; }
        # Only projects on the board, at most three, in the model's order.
        cv=()
        IFS=, read -r -a rowv <<<"$cands"
        for r in "${rowv[@]}"; do
          r="$(clean 60 <<<"$r")"
          [ "${#cv[@]}" -lt 3 ] && [ -n "$r" ] && [[ " ${cv[*]} " != *" $r "* ]] || continue
          jq -e --arg p "$r" 'any(.projects[]; .project == $p)' <<<"$board" >/dev/null && cv+=("$r")
        done
        # What the person wrote around it, so the answer can be given from the card alone.
        ask_project "$text" "$why" "$(clean 600 <<<"$(ask_context "$n" "$text")")" "${cv[@]}"
        ;;
      skip)
        # A session's follow-up that asks for no work leaves, with the reason; anyone else's stays.
        if is_session "$text"; then drop_session "$from" "$raw" "$text" "$how" || continue
        else leave "${why:-skipped}"; fi
        ;;
      *) leave "${why:-skipped}" ;;
    esac
  # A repeat of a line above (field 4, line) sorts after every other answer, so the row it joins is filed first.
  done < <(sed -n '/^INBOX-TRIAGE-START$/,/^INBOX-TRIAGE-END$/p' <<<"$out" | sed '1d;$d' | jq -rR "$ANSWER_JQ" | LC_ALL=C sort -s -t $'\x1f' -k4,4n)
  # A left outbox line names the projects of the nearest outbox lines filed above and below it.
  # One asked again keeps what its first sweep named, since its neighbours then were the person's.
  local m up down
  for n in "${!left_why[@]}"; do
    near="${nears[n - 1]}"
    if [ -z "$near" ]; then
      up="" down=""
      for ((m = n - 1; m >= 1; m--)); do [ "${froms[m - 1]}" = outbox ] && [ -n "${line_dest[$m]:-}" ] && { up="${line_dest[$m]}"; break; }; done
      for ((m = n + 1; m <= ${#froms[@]}; m++)); do [ "${froms[m - 1]}" = outbox ] && [ -n "${line_dest[$m]:-}" ] && { down="${line_dest[$m]}"; break; }; done
      near="$up"; [ -n "$down" ] && [ "$down" != "$up" ] && near="${near:+$near,}$down"
    fi
    left outbox "${texts[n - 1]}" "${left_why[$n]}" "$near"
  done
  # A line with no answer is not recorded: the next sweep asks again.
  for raw in "${raws[@]}"; do [ -n "$raw" ] && KEPT=$((KEPT + 1)); done
  return 0
}

# One --backlog answer line -> n, action, id, project, row, why, split by US.
# shellcheck disable=SC2016 # jq source, not shell
BACKLOG_JQ='def s: (. // "") | tostring | gsub("[[:cntrl:]]"; " ");
  fromjson? | select(type == "object" and (.n | type) == "number")
  | [(.n | floor | tostring), (.action | s), (.id | s), (.project | s), (.row | s), (.why | s), (.epic | s), (.priority | s)] | join("\u001f")'

# pt <project> <lane> <ptask args...>: one ptask write on a lane, or its echo under --dry-run.
pt() {
  local p="$1" lane="$2"; shift 2
  local -a on=()
  [ "$lane" = agent ] && on=(--agent)
  if [ "$DRY" = 1 ]; then printf 'would run: notes ptask'; printf ' %q' "$p" "${on[@]}" "$@"; echo; return 0; fi
  notes ptask "$p" "${on[@]}" "$@" >/dev/null || { say "$p ($lane): refused: $*"; proof_why "$p ($lane): ptask refused an edit"; FAILED=$((FAILED + 1)); return 1; }
}

# backlog_cache <project>: the answers a plain --backlog --dry-run got, one `{lane, raw, action, id,
# project, row, why, epic, priority}` per line, as link_cache is for --link: the next run replays each whose
# row is still byte for byte the same, so the apply writes what the dry run printed (and a person
# checked). A dry run asks the model about the rest; an apply leaves them as they are, since no one
# reviewed an answer for them. The apply removes the file after.
backlog_cache() { printf '%s/inbox-triage/backlog-%s.jsonl' "$STATE" "$1"; }

# backlog <project> <lane> <board json> <project names> <shared repos> [kept]: one lane's open rows, the
# cached answers in <kept> replayed first, the rest in batches (or left, see answers_left).
backlog() {
  local p="$1" lane="$2" board="$3" names="$4" shared_repos="$5" kept="${6:-}" rows ids mine total off=0 size r rc=0 epics
  local raw own state kids action id dest row why epic prio
  epics="$(epics_open "$board")"
  # Each row with its child rows (the indented open rows under it on the sheet), which the
  # model sees as context and which go wherever the row goes.
  # shellcheck disable=SC2016 # jq source, not shell
  rows="$(jq -c --arg p "$p" --arg l "$lane" '[.rows[] | select(.project == $p and .lane == $l and .state != "done")] | sort_by(.line) as $all
    | [$all | to_entries[] | select(.value.id != null and (.value.state == "open" or .value.state == "doing")) | .key as $k
       | .value + {kids: ($all[$k + 1:] | (map(.raw | test("^\\s") | not) | index(true)) as $stop
                         | (if $stop == null then . else .[:$stop] end) | map(.text))}]
    | sort_by(.text | ascii_downcase)' <<<"$board")"
  ids="$(jq -r '.[].id' <<<"$rows")"   # a dup names one of these
  if [ -n "$kept" ]; then
    # shellcheck disable=SC2016 # jq source, not shell
    while IFS=$'\x1f' read -r raw own state kids action id dest row why epic prio; do
      backlog_row "$p" "$lane" "$raw" "$own" "$state" "$kids" "$epics" "$ids" "$action" "$id" "$dest" "$row" "$why" "$epic" "$prio"
    done < <(jq -r --arg l "$lane" --slurpfile live <(printf '%s\n' "$rows") '(($live[0] // []) | INDEX(.raw)) as $by
      | select(.lane == $l) | $by[.raw] as $r | select($r)
      | [.raw, $r.id, $r.state, ($r.kids | length | tostring), .action, .id, .project, .row, .why, .epic, (.priority // "")] | join("\u001f")' <<<"$kept")
  fi
  # shellcheck disable=SC2016 # jq source, not shell
  mine="$(jq -c --arg l "$lane" --slurpfile have <(printf '%s\n' "$kept") \
    '($have | map(select(.lane == $l) | .raw) | INDEX(.)) as $h | map(select($h[.raw] | not))' <<<"$rows")"
  total="$(jq length <<<"$mine")"
  answers_left "$(backlog_cache "$p")" "$p" "$lane" "$total" && { KEPT=$((KEPT + total)); return 0; }
  # Each call carries budget_batch rows; one stopped at the cap asks the same rows again at the
  # halved size, and a single row that caps alone is passed over.
  while [ "$off" -lt "$total" ]; do
    size="$(budget_batch "$NAME" "$INBOX_TRIAGE_MAX")"
    backlog_batch "$p" "$lane" "$(jq -c --argjson o "$off" --argjson m "$size" '.[$o:$o + $m]' <<<"$mine")" "$names" "$shared_repos" "$epics"; r=$?
    [ "$r" = "$CALLS_RC_CAPPED" ] && [ "$size" -gt 1 ] && continue
    [ "$r" = "$EX_BUDGET" ] && break
    [ "$r" = 0 ] || rc=1
    off=$((off + size))
  done
  return "$rc"
}

# backlog_batch <project> <lane> <batch json> <names> <shared repos> <epics>: one call
# over the batch, each answer applied by backlog_row; a --dry-run keeps the answers in backlog_cache.
backlog_batch() {
  local p="$1" lane="$2" batch="$3" names="$4" shared_repos="$5" epics="$6" listing out cache
  local types="$TYPES" project_systems project_epics
  local -a raws ids states kids
  mapfile -d '' -t raws < <(jq -j '.[] | .raw, "\u0000"' <<<"$batch")
  mapfile -t ids < <(jq -r '.[] | .id' <<<"$batch")
  mapfile -t states < <(jq -r '.[] | .state' <<<"$batch")
  mapfile -t kids < <(jq -r '.[] | .kids | length' <<<"$batch")
  # A row's own priority follows its text (none shown: untriaged), so a raise can be judged against it.
  listing="$(jq -r 'to_entries[] | "\(.key + 1). [\(.value.id)]\(if .value.state == "doing" then " (doing)" else "" end)\(if .value.untriaged or .value.priority == null then "" else " (#" + .value.priority + ")" end) \(.value.text)", (.value.kids[] | "   - " + .)' <<<"$batch" | cut -c1-400)"
  project_systems="$(systems_of "$p")"; project_epics="$(epics_of "$p" "$epics")"
  ask "$BACKLOG_PROMPT" "${#raws[@]}" "$p ($lane)" "$INBOX_BACKLOG_CMD" sized || return
  answered "$p ($lane)" || return 1
  out="$OUT" cache="$(backlog_cache "$p")"
  local n action id dest row why epic prio all
  local -a seen=()
  all="$(printf '%s\n' "${ids[@]}")"   # a dup names another row of this batch
  while IFS=$'\x1f' read -r n action id dest row why epic prio; do
    [ "$n" -ge 1 ] 2>/dev/null && [ "$n" -le "${#raws[@]}" ] || continue
    [ -z "${seen[n]:-}" ] || continue   # one answer per row
    seen[n]=1
    backlog_row "$p" "$lane" "${raws[n - 1]}" "${ids[n - 1]}" "${states[n - 1]}" "${kids[n - 1]}" "$epics" "$all" "$action" "$id" "$dest" "$row" "$why" "$epic" "$prio"
    # The verdict as printed, after backlog_row's guards, so the replay writes what the dry run showed.
    [ "$DRY" = 1 ] && jq -cn --arg l "$lane" --arg r "${raws[n - 1]}" --arg a "$VERDICT" --arg i "$id" --arg d "$VDEST" \
      --arg w "$row" --arg y "$why" --arg e "$epic" --arg pr "$VPRIO" '{lane: $l, raw: $r, action: $a, id: $i, project: $d, row: $w, why: $y, epic: $e, priority: $pr}' >>"$cache"
  done < <(sed -n '/^INBOX-TRIAGE-START$/,/^INBOX-TRIAGE-END$/p' <<<"$out" | sed '1d;$d' | jq -rR "$BACKLOG_JQ")
  for ((n = 1; n <= ${#raws[@]}; n++)); do [ -n "${seen[n]:-}" ] || KEPT=$((KEPT + 1)); done
  return 0
}

# row_priority <raw>: the row's own priority tag (urgent, high, normal, low), or empty when it has none.
row_priority() { [[ " $1 " =~ [[:space:]]#(urgent|high|normal|low)[[:space:]] ]] && echo "${BASH_REMATCH[1]}"; return 0; }
# prio_rank <priority>: the rubric's order, an untagged or unknown priority lowest.
prio_rank() { case "$1" in urgent) echo 4 ;; high) echo 3 ;; normal) echo 2 ;; low) echo 1 ;; *) echo 0 ;; esac; }

# improve_row <project> <raw> <why>: a backlog row's words (no checkbox, tags or marker) kept in the
# project's improvements.md by `notes improve`, the one writer, which never touches ideas.md and
# adds nothing when the line is there already, so a retry after a refused drop writes it once.
improve_row() {
  local p="$1" words
  words="$(sed -E 's/^[[:space:]]*- \[.\] //; s/[[:space:]]*<!--.*-->[[:space:]]*$//; s/(^|[[:space:]])#[A-Za-z][^[:space:]]*//g; s/^[[:space:]]+//' <<<"$2")"
  [ -n "$words" ] || return 1
  if [ "$DRY" = 1 ]; then printf 'would run: notes improve'; printf ' %q' "$p" --why "$3" -- "$words"; echo; return 0; fi
  notes improve "$p" --why "$3" -- "$words" >/dev/null || {
    say "$p: not kept as an improvement (an old notes? notes-bootstrap --build-only): $2"
    proof_why "notes improve failed"; FAILED=$((FAILED + 1)); return 1
  }
}

# backlog_row <project> <lane> <raw> <own id> <state> <child count> <epics> <lane ids>
#   <action> <id> <project> <row> <why> <epic> <priority>: one backlog answer applied through ptask.
# A row in progress is only kept, rewritten or raised, a heading over child rows is never closed,
# and a dup names another of <ids> (a live answer: its batch's; a replay: the board's open rows).
# VERDICT, VDEST and VPRIO say what it wrote, or under --dry-run would write: keep when a guard or
# ptask said no.
backlog_row() {
  local p="$1" lane="$2" raw="$3" own="$4" state="$5" nkids="$6" epics="$7" all="$8"
  local action="$9" id="${10}" dest="${11}" row="${12}" why="${13}" epic="${14}" prio="${15:-}" eid
  VERDICT=keep VDEST="" VPRIO=""
  dest="$(clean 60 <<<"$dest")"
  [ "$dest" = "$p" ] && dest=""
  if [ "$state" = doing ]; then
    dest=""
    [ "$action" = rewrite ] || [ "$action" = raise ] || action=keep
  fi
  # ask-sweep finds a plan's finish row by its slug on the plan's own board (sweep_plans), so the row
  # stays on this board, and a rewrite that drops or shortens the slug is kept as it is.
  local slug=""
  [[ $raw =~ finish\ ([^\ :]+):\ [0-9]+\ phases?\ left ]] && slug="${BASH_REMATCH[1]}"
  if [ -n "$slug" ]; then
    [ -n "$dest" ] && say "$p ($lane): $own stays: ask-sweep finds plan $slug's row on this board"
    dest=""
    if [ "$action" = rewrite ] && [[ $row != *"$slug"* ]]; then
      say "$p ($lane): $own kept: the rewrite drops plan slug $slug, which ask-sweep finds it by"
      action=keep
    fi
    [[ $action =~ ^(drop|dup|done|improvement)$ ]] && action=keep
  fi
  # a heading over child rows is never closed: its children would sit under a ticked row
  [ "$nkids" -gt 0 ] && [[ $action =~ ^(drop|dup|done|improvement)$ ]] && action=keep
  case "$action" in
    rewrite)
      row="$(epic_checked "$(clean 150 <<<"$row")" "${dest:-$p}" "$epics")"
      if [ -n "$row" ] && [ -n "$epic" ] && eid="$(epic_new "${dest:-$p}" "$(clean 150 <<<"$epic")")"; then
        row="$(under_epic "$row" "$eid")"
      fi
      if [ -n "$row" ] && pt "$p" "$lane" --exact edit --was --text "$row" -- "$raw"; then
        REWROTE=$((REWROTE + 1)) VERDICT=rewrite
        # the row's line changed, so the move names it by its id
        [ -n "$dest" ] && pt "$p" "$lane" move --project "$dest" "$own" && MOVED=$((MOVED + 1)) VDEST="$dest"
      else
        KEPT=$((KEPT + 1))
      fi
      ;;
    dup)
      id="$(clean 40 <<<"$id")"
      if [ -n "$id" ] && [ "$id" != "$own" ] && grep -qxF -- "$id" <<<"$all" &&
        pt "$p" "$lane" --exact drop --dup "$id" -- "$raw"; then
        DROPPED=$((DROPPED + 1)) VERDICT=dup
      else
        KEPT=$((KEPT + 1))
      fi
      ;;
    drop)
      why="$(clean 100 <<<"$why")"
      if [ -n "$why" ] && pt "$p" "$lane" --exact drop --why "triage: $why" -- "$raw"; then
        DROPPED=$((DROPPED + 1)) VERDICT=drop
      else
        KEPT=$((KEPT + 1))
      fi
      ;;
    done)
      # The row says it is done, but names nothing checkable, so it closes undelivered with the reason.
      why="$(clean 100 <<<"$why")"
      if [ -n "$why" ] && pt "$p" "$lane" --exact drop --why "triage: done: $why" -- "$raw"; then
        CLOSED_DONE=$((CLOSED_DONE + 1)) VERDICT=done
      else
        KEPT=$((KEPT + 1))
      fi
      ;;
    raise)
      # Only up, by the rubric's order; `ptask tag` replaces the row's own priority.
      prio="$(clean 10 <<<"$prio")"
      if [ "$(prio_rank "$prio")" -gt "$(prio_rank "$(row_priority "$raw")")" ] && [ "$prio" != low ] &&
        pt "$p" "$lane" tag --add "$prio" "$own"; then
        RAISED=$((RAISED + 1)) VERDICT=raise VPRIO="$prio"
      else
        KEPT=$((KEPT + 1))
      fi
      ;;
    improvement)
      # The human's own board and a row they asked for are theirs: never an improvement.
      why="$(clean 100 <<<"$why")"
      if [ "$lane" = agent ] && [ -n "$why" ] && ! [[ " $raw " =~ [[:space:]]#requested[[:space:]] ]] &&
        improve_row "$p" "$raw" "$why" &&
        pt "$p" "$lane" --exact drop --why "triage: improvement: kept in improvements.md" -- "$raw"; then
        IMPROVED=$((IMPROVED + 1)) VERDICT=improvement
      else
        KEPT=$((KEPT + 1))
      fi
      ;;
    *)
      if [ -n "$dest" ] && pt "$p" "$lane" --exact move --project "$dest" -- "$raw"; then
        MOVED=$((MOVED + 1)) VDEST="$dest"
      else
        KEPT=$((KEPT + 1))
      fi
      ;;
  esac
}

# answers_kept <cache> <project>: the cached --dry-run answers (one JSON object a line) whose row,
# by lane and raw, is still among the rows on stdin (a JSON array; those of <project> count), one
# a line. A line cut short (a run killed mid-write) is dropped alone, never the whole cache. A dry
# run rewrites the cache to those, and appends its new answers after. The rows go in on stdin and
# the answers as a file: either can pass the 128 KB an argument holds.
answers_kept() {
  local cache="$1" p="$2" kept=''
  mkdir -p "$(dirname "$cache")"
  # shellcheck disable=SC2016 # jq source, not shell
  [ -s "$cache" ] && kept="$(jq -c --arg p "$p" --rawfile c "$cache" '(map(select(.project == $p) | "\(.lane)\u0000\(.raw)") | INDEX(.)) as $live
    | $c | split("\n")[] | fromjson? | select($live["\(.lane)\u0000\(.raw)"])')"
  [ "$DRY" = 1 ] && printf '%s' "${kept:+$kept$'\n'}" >"$cache"
  printf '%s' "$kept"
}

# answers_left <cache> <project> <lane> <rows>: an apply after a dry run writes only the answers
# that run kept, so the <rows> new or changed since are left for the next dry run, not asked
# afresh with no one to review them. True when it left any.
answers_left() {
  [ "$DRY" = 0 ] && [ "$4" -gt 0 ] && [ -s "$1" ] || return 1
  say "$2 ($3): $4 rows new or changed since the dry run left as they are; a dry run asks about them"
}

# answers_done <project> <cache> <refused before>: a dry run names its cache; an apply removes it,
# unless a write was refused since, so the retry writes the same verdicts rather than new ones.
answers_done() {
  if [ "$DRY" = 1 ]; then
    say "$1: answers kept in $2; the apply writes them, and deleting the file asks afresh"
  elif [ "$FAILED" -eq "$3" ]; then
    rm -f -- "$2"
  fi
}

# backlog_report: the answers every board's plain --backlog --dry-run kept (backlog_cache), by
# verdict, each row's id, text and why, then the agent rows open past 30 days, for a person to
# confirm a bucket before the apply writes it. No model call and no write. The counts add up to the
# open rows read (judged plus not yet judged); an answer whose row changed since counts as not yet
# judged, since the apply leaves that row too. The board goes to jq as a file: it passes 128 KB.
backlog_report() {
  local board caches=() f p
  read_board || return 1
  board="$(backlog_board <<<"$BOARD")"
  while IFS= read -r p; do
    [ -z "$ONLY" ] || [ "$p" = "$ONLY" ] || continue
    f="$(backlog_cache "$p")"
    [ -s "$f" ] && caches+=("$f")
  done < <(jq -r '[.rows[].project | select(. != null)] | unique[]' <<<"$board")
  # shellcheck disable=SC2016 # jq source, not shell
  jq -rn --slurpfile b <(printf '%s' "$board") --arg cut "$(date -d '30 days ago' +%F)" --arg today "$(date +%F)" --arg only "$ONLY" '
    def cell: tostring | gsub("[|\n]"; "/");
    def bucket: .a.action as $x
      | if $x == "keep" and (.a.project // "") != "" then "move"
        elif $x == "drop" then "not a task" else $x end;
    def why: if .a.action == "dup" then "dup of \(.a.id)"
      elif .a.action == "raise" then "#\(.a.priority): \(.a.why)"
      elif .a.action == "rewrite" then "-> \(.a.row)\(if (.a.project // "") != "" then " (to \(.a.project))" else "" end)"
      elif bucket == "move" then "to \(.a.project)"
      else .a.why // "" end;
    [$b[0].rows[] | select(.id != null and (.lane == "human" or .lane == "agent") and (.state == "open" or .state == "doing") and ($only == "" or .project == $only))] as $live
    | ($live | INDEX("\(.lane)\u0000\(.raw)")) as $by
    | [inputs | select(type == "object") | . as $a | $by["\(.lane)\u0000\(.raw)"] | select(.) | . + {a: $a}]
    | unique_by(.id) as $judged
    | ($judged | INDEX(.id)) as $verdict
    | ["raise", "improvement", "done", "not a task", "dup", "rewrite", "move", "keep"] as $order
    | ($live | map(select(.lane == "agent" and (.since // .filed // "9999") < $cut)) | sort_by(.since // .filed)) as $old
    | (($live | length) - ($judged | length)) as $left
    | "# Backlog audit, \($today)",
      "",
      "Open rows read: \($live | length) (agent \($live | map(select(.lane == "agent")) | length), human \($live | map(select(.lane == "human")) | length)) on \($live | map(.project) | unique | length) projects. Judged: \($judged | length). Not judged yet: \($left).",
      "",
      "| verdict | rows |", "|---|---|",
      ($order[] as $o | "| \($o) | \($judged | map(select(bucket == $o)) | length) |"),
      "| not judged yet | \($left) |",
      ($order[] as $o | ($judged | map(select(bucket == $o)) | sort_by(.project, .id)) as $rs | select($rs | length > 0)
        | "", "## \($o) (\($rs | length))", "", "| project | id | lane | row | why |", "|---|---|---|---|---|",
          ($rs[] | "| \(.project) | \(.id) | \(.lane) | \(.text | cell) | \(why | cell) |")),
      "", "## Agent rows open since before \($cut) (\($old | length))", "",
      "| project | id | since | row | verdict |", "|---|---|---|---|---|",
      ($old[] | "| \(.project) | \(.id) | \(.since // .filed) | \(.text | cell) | \($verdict[.id] | if . then bucket else "not judged yet" end) |")
  ' "${caches[@]}" </dev/null
}

# The --backlog pass: every project's two boards, the most open rows first.
backlog_pass() {
  local board names shared_repos rc=0 p lane cache kept failed
  read_board || return 1
  board="$(backlog_board <<<"$BOARD")"
  names="$(jq -r '[.projects[].project] | unique | join(", ")' <<<"$board")"
  shared_repos="$(shared_repos)"
  TYPES="$(row_types)" || return 1   # once a pass, read by every backlog_batch
  while IFS= read -r p; do
    [ -n "$ONLY" ] && [ "$p" != "$ONLY" ] && continue
    agentctl report --name "$NAME" "item=$p" >/dev/null 2>&1 || true
    cache="$(backlog_cache "$p")" failed="$FAILED"
    kept="$(jq -c '[.rows[] | select(.id != null and (.state == "open" or .state == "doing"))]' <<<"$board" | answers_kept "$cache" "$p")"
    for lane in human agent; do
      backlog "$p" "$lane" "$board" "$names" "$shared_repos" "$kept" || rc=1
      [ "$BUDGET_STOP" = 0 ] || break 2
    done
    answers_done "$p" "$cache" "$failed"
  done < <(jq -r '[.rows[] | select(.project != null and (.lane == "human" or .lane == "agent") and .state != "done")]
    | group_by(.project) | sort_by(-length) | .[][0].project' <<<"$board")
  [ "$rc" = 0 ] && [ "$BUDGET_STOP" = 1 ] && rc="$EX_BUDGET"
  return "$rc"
}

# The rows board automation may touch: none of a profile with `automation = false`.
managed_board() { jq -c '.rows |= map(select(.automation != false)) | .projects |= map(select(.automation != false))'; }
# The rows the plain --backlog pass and its --report read: managed_board less each row fleet-bench
# keys by its prefix (BOARD_KEY_ERE). A rewrite loses the prefix fleet-bench refreshes and closes
# it by, and its next pass writes the row's text back anyway, so such a row is never asked about,
# a cached answer for one is never replayed or reported, and no row can be called its dup.
backlog_board() { managed_board | jq -c --arg keys "$BOARD_KEY_ERE" '.rows |= map(select((.text // "") | test($keys) | not))'; }

# One --priority answer line -> n, priority, split by US.
# shellcheck disable=SC2016 # jq source, not shell
PRIORITY_JQ='fromjson? | select(type == "object" and (.n | type) == "number")
  | [(.n | floor | tostring), ((.priority // "") | tostring)] | join("\u001f")'

# priority_batch <project> <lane> <batch json>: one call gives each row a priority, and
# `ptask tag` writes each that differs from the row's own (a new priority replaces the old).
priority_batch() {
  local p="$1" lane="$2" batch="$3" listing n prio
  local -a ids cur
  mapfile -t ids < <(jq -r '.[] | .id' <<<"$batch")
  mapfile -t cur < <(jq -r '.[] | if .untriaged then "" else .priority end' <<<"$batch")
  listing="$(jq -r 'to_entries[] | "\(.key + 1). [\(.value.id)] \(.value.text)"' <<<"$batch" | cut -c1-300)"
  ask "$PRIORITY_PROMPT" "${#ids[@]}" "$p ($lane) priority" "$INBOX_PRIORITY_CMD" sized || return
  answered "$p ($lane) priority" || return 1
  local -a seen=()
  while IFS=$'\x1f' read -r n prio; do
    [ "$n" -ge 1 ] 2>/dev/null && [ "$n" -le "${#ids[@]}" ] || continue
    [ -z "${seen[n]:-}" ] || continue   # one answer per row
    seen[n]=1
    case "$prio" in urgent|high|normal|low) ;; *) continue ;; esac
    [ "$prio" = "${cur[n - 1]}" ] && continue
    # The ingest record names the writer inbox-priority, whoever ran the pass: judge-eval scores
    # these tags as that lane's verdicts (SCORE=priority-kept), so a session or queue item must not
    # take the credit, and the triager's own score must not count them.
    AGENTCTL_NAME=inbox-priority AGENT_QUEUE_ITEM='' CLAUDE_CODE_SESSION_ID='' \
      pt "$p" "$lane" tag --add "$prio" "${ids[n - 1]}" && TAGGED=$((TAGGED + 1))
  done < <(sed -n '/^INBOX-TRIAGE-START$/,/^INBOX-TRIAGE-END$/p' <<<"$OUT" | sed '1d;$d' | jq -rR "$PRIORITY_JQ")
  for ((n = 1; n <= ${#ids[@]}; n++)); do [ -n "${seen[n]:-}" ] || KEPT=$((KEPT + 1)); done
  return 0
}

# The --priority pass: every managed board's open rows with no priority tag (and with
# --retag <word> its rows tagged #<word>), in batches, the boards with the most such rows first.
priority_pass() {
  local board rows p lane total off size r rc=0
  read_board || return 1
  board="$(managed_board <<<"$BOARD")"
  # shellcheck disable=SC2016 # jq source, not shell
  rows="$(jq -c --arg retag "$RETAG" --arg only "$ONLY" '[.rows[]
    | select((.lane == "human" or .lane == "agent") and .id != null and (.state == "open" or .state == "doing")
             and ($only == "" or .project == $only) and (.untriaged or ($retag != "" and .priority == $retag)))]' <<<"$board")"
  while IFS=$'\t' read -r p lane; do
    [ -n "$p" ] || continue
    local mine; mine="$(jq -c --arg p "$p" --arg l "$lane" '[.[] | select(.project == $p and .lane == $l)] | sort_by(.line)' <<<"$rows")"
    total="$(jq length <<<"$mine")"; off=0
    agentctl report --name "$NAME" "item=$p" >/dev/null 2>&1 || true
    while [ "$off" -lt "$total" ]; do
      size="$(budget_batch "$NAME" "$INBOX_TRIAGE_MAX")"
      priority_batch "$p" "$lane" "$(jq -c --argjson o "$off" --argjson m "$size" '.[$o:$o + $m]' <<<"$mine")"; r=$?
      [ "$r" = "$CALLS_RC_CAPPED" ] && [ "$size" -gt 1 ] && continue
      [ "$r" = "$EX_BUDGET" ] && break 2
      [ "$r" = 0 ] || rc=1
      off=$((off + size))
    done
  done < <(jq -r 'group_by([.project, .lane]) | sort_by(-length) | .[] | [.[0].project, .[0].lane] | @tsv' <<<"$rows")
  [ "$rc" = 0 ] && [ "$BUDGET_STOP" = 1 ] && rc="$EX_BUDGET"
  return "$rc"
}

# The --size rubric, in SIZE_PROMPT: what each point count means, the one rubric the --size pass
# scores by and a session filing a row reads (notes-cli README, "points"). The scale and its s/m/l
# bands are notes-cli's epics::POINTS; the minutes are measured agent work, queue start to close,
# over 1,937 items closed ok 2026-10-20 to 11-12 (p25 10, median 24, p75 54, p90 114 min).
# Provisional: re-read when the pts-bands Sentinel watch trips (`fleet-bench sizes --check`: over
# the last 7 days of closes of rows scored #pts, the median l is not slower than m or m not slower than s;
# only a small share of the 1,937 items had #pts, so the watch checks the order, not these minutes).

# One --size answer line -> n, pts, split by US.
# shellcheck disable=SC2016 # jq source, not shell
SIZE_JQ='fromjson? | select(type == "object" and (.n | type) == "number" and (.pts | type) == "number")
  | [(.n | floor | tostring), (.pts | floor | tostring)] | join("\u001f")'

# size_batch <project> <lane> <batch json>: one call gives each row its points, and `ptask tag`
# writes each (`--add pts/<n>`, which also sets the row's #size/ to their band).
size_batch() {
  local p="$1" lane="$2" batch="$3" listing n pts
  local -a ids
  mapfile -t ids < <(jq -r '.[] | .id' <<<"$batch")
  listing="$(jq -r 'to_entries[] | "\(.key + 1). [\(.value.id)] \(.value.text)" + (([.value.details[] | select(. != "")]) as $d | if ($d | length) > 0 then "\n   " + ($d[:4] | join("\n   ")) else "" end)' <<<"$batch" | cut -c1-300)"
  ask "$SIZE_PROMPT" "${#ids[@]}" "$p ($lane) size" "$INBOX_SIZE_CMD" sized || return
  answered "$p ($lane) size" || return 1
  local -a seen=()
  while IFS=$'\x1f' read -r n pts; do
    [ "$n" -ge 1 ] 2>/dev/null && [ "$n" -le "${#ids[@]}" ] || continue
    case "$pts" in 1|2|3|5|8|13) ;; *) continue ;; esac   # off the scale: the row is left
    [ -z "${seen[n]:-}" ] || continue   # one answer per row
    seen[n]=1
    # The ingest record names the writer inbox-size, whoever ran the pass, as --priority does.
    AGENTCTL_NAME=inbox-size AGENT_QUEUE_ITEM='' CLAUDE_CODE_SESSION_ID='' \
      pt "$p" "$lane" tag --add "pts/$pts" "${ids[n - 1]}" && SCORED=$((SCORED + 1))
  done < <(sed -n '/^INBOX-TRIAGE-START$/,/^INBOX-TRIAGE-END$/p' <<<"$OUT" | sed '1d;$d' | jq -rR "$SIZE_JQ")
  for ((n = 1; n <= ${#ids[@]}; n++)); do [ -n "${seen[n]:-}" ] || KEPT=$((KEPT + 1)); done
  return 0
}

# The --size pass: every managed board's open top-level rows with no points (epics excepted: an
# epic weighs what its leaves do; child steps too, as --link skips them), in batches, the boards
# with the most such rows first. A row's old #size/, a hand-set one included, is in its text the
# model reads, and the points replace it: the stamp from machine load was no estimate.
size_pass() {
  local board rows p lane total off size r rc=0
  read_board || return 1
  board="$(managed_board <<<"$BOARD")"
  # shellcheck disable=SC2016 # jq source, not shell
  rows="$(jq -c --arg only "$ONLY" '[.rows[]
    | select((.lane == "human" or .lane == "agent") and .id != null and (.state == "open" or .state == "doing")
             and .type != "epic" and .points == null and (.raw | test("^\\s") | not)
             and ($only == "" or .project == $only))]' <<<"$board")"
  while IFS=$'\t' read -r p lane; do
    [ -n "$p" ] || continue
    local mine; mine="$(jq -c --arg p "$p" --arg l "$lane" '[.[] | select(.project == $p and .lane == $l)] | sort_by(.line)' <<<"$rows")"
    total="$(jq length <<<"$mine")"; off=0
    agentctl report --name "$NAME" "item=$p" >/dev/null 2>&1 || true
    while [ "$off" -lt "$total" ]; do
      size="$(budget_batch "$NAME" "$INBOX_TRIAGE_MAX")"
      size_batch "$p" "$lane" "$(jq -c --argjson o "$off" --argjson m "$size" '.[$o:$o + $m]' <<<"$mine")"; r=$?
      [ "$r" = "$CALLS_RC_CAPPED" ] && [ "$size" -gt 1 ] && continue
      [ "$r" = "$EX_BUDGET" ] && break 2
      [ "$r" = 0 ] || rc=1
      off=$((off + size))
    done
  done < <(jq -r 'group_by([.project, .lane]) | sort_by(-length) | .[] | [.[0].project, .[0].lane] | @tsv' <<<"$rows")
  [ "$rc" = 0 ] && [ "$BUDGET_STOP" = 1 ] && rc="$EX_BUDGET"
  return "$rc"
}

# One --link answer line -> n, system, of, epic, split by US.
# shellcheck disable=SC2016 # jq source, not shell
LINK_JQ='def s: (. // "") | tostring | gsub("[[:cntrl:]]"; " ");
  fromjson? | select(type == "object" and (.n | type) == "number")
  | [(.n | floor | tostring), (.system | s), (.of | s), (.epic | s)] | join("\u001f")'

# link_cache <project>: the answers a --link --dry-run got, one `{lane, raw, system, of, epic}`
# per line. The next run reuses each whose row is still byte for byte the same, so the apply
# writes what the dry run printed and a dry run stopped at its budget resumes; only rows changed
# since go to the model. The apply removes the file after.
link_cache() { printf '%s/inbox-triage/link-%s.jsonl' "$STATE" "$1"; }

# system_named <word> <systems tsv>: the id of the system the word names, by its id or an alias.
system_named() {
  [ -n "$1" ] || return 0
  awk -F'\t' -v a="${1,,}" 'tolower($1) == a { print $1; exit } { n = split(tolower($3), w, ","); for (i = 1; i <= n; i++) if (w[i] == a) { print $1; exit } }' <<<"$2"
}

# link_row <project> <lane> <raw> <system> <of> <new epic> <epics> <systems tsv>: one row under
# an epic. An area that already names a system (its id or an alias) stays; any other area becomes
# the model's system id. Then the row takes the open epic the model named, else the new epic it
# proposed (epic_new), else its system's standing epic through `edit --link`. A row with neither
# an open epic nor a system of the project is left as it is, and so is a row whose text does not
# start with its `type(area):` (a tag first, say), since its area cannot be swapped in place.
link_row() {
  local p="$1" lane="$2" raw="$3" sys="$4" of="$5" epic="$6" epics="$7" tsv="$8" text ty area rest own eid r
  text="$(sed -E 's/^[[:space:]]*- \[.\] //; s/[[:space:]]*<!--.*-->[[:space:]]*$//' <<<"$raw")"
  # The type and area come from the grammar's one home, `notes row parse`.
  IFS=$'\t' read -r ty area _ < <(notes row parse <<<"$text")
  [ "$area" = - ] && area=""
  own="$(system_named "$area" "$tsv")"
  if [ -n "$own" ]; then
    sys="$own"
  else
    sys="$(system_named "$sys" "$tsv")"
    rest="${text#"$ty${area:+($area)}:"}"
    if [ -n "$sys" ] && [ "$rest" != "$text" ]; then
      text="$ty($sys): ${rest#"${rest%%[! ]*}"}"
    else
      sys=""
    fi
  fi
  epic_known "$of" "$p" "$epics" || of=""
  # A dry run files no epic (epic_new exits 2 on one it would file), so its row prints under the
  # placeholder `#of/<new>`. A proposal counts once a pass, however many rows it takes.
  if [ -z "$of" ] && [ -n "$sys" ] && [ -n "$epic" ]; then
    epic="$(clean 150 <<<"$epic")" r=0
    eid="$(epic_new "$p" "$epic")" || r=$?
    case "$r" in 0) of="$eid" ;; 2) of='<new>' ;; esac
    if [ -n "$of" ] && [ -z "${NEW_SEEN["$p $epic"]:-}" ]; then NEW_SEEN["$p $epic"]=1; NEW_EPICS=$((NEW_EPICS + 1)); fi
  fi
  if [ -n "$of" ]; then
    pt "$p" "$lane" --exact edit --text "$(under_epic "$text" "$of")" -- "$raw" && LINKED=$((LINKED + 1))
  elif [ -n "$sys" ]; then
    pt "$p" "$lane" --exact edit --link --text "$text" -- "$raw" && STANDING=$((STANDING + 1))
  else
    KEPT=$((KEPT + 1))
  fi
}

# link_batch <project> <lane> <batch json> <epics> <systems tsv>: one call names each row's system
# and epic; a --dry-run keeps the answers in link_cache.
link_batch() {
  local p="$1" lane="$2" batch="$3" epics="$4" tsv="$5" listing n sys of epic cache project_systems feature_epics
  local -a raws
  mapfile -d '' -t raws < <(jq -j '.[] | .raw, "\u0000"' <<<"$batch")
  listing="$(jq -r 'to_entries[] | "\(.key + 1). [\(.value.id)] \(.value.text)"' <<<"$batch" | cut -c1-300)"
  project_systems="$(systems_of "$p")"
  feature_epics="$(epics_of "$p" "$epics" | grep -viE ' to standard$')"
  ask "$LINK_PROMPT" "${#raws[@]}" "$p ($lane) link" "$INBOX_PRIORITY_CMD" sized || return
  answered "$p ($lane) link" || return 1
  cache="$(link_cache "$p")"
  local -a seen=()
  while IFS=$'\x1f' read -r n sys of epic; do
    [ "$n" -ge 1 ] 2>/dev/null && [ "$n" -le "${#raws[@]}" ] || continue
    [ -z "${seen[n]:-}" ] || continue   # one answer per row
    seen[n]=1
    sys="$(clean 40 <<<"$sys")" of="$(clean 40 <<<"$of")"
    [ "$DRY" = 1 ] && jq -cn --arg l "$lane" --arg r "${raws[n - 1]}" --arg s "$sys" --arg o "$of" --arg e "$epic" \
      '{lane: $l, raw: $r, system: $s, of: $o, epic: $e}' >>"$cache"
    link_row "$p" "$lane" "${raws[n - 1]}" "$sys" "$of" "$epic" "$epics" "$tsv"
  done < <(sed -n '/^INBOX-TRIAGE-START$/,/^INBOX-TRIAGE-END$/p' <<<"$OUT" | sed '1d;$d' | jq -rR "$LINK_JQ")
  for ((n = 1; n <= ${#raws[@]}; n++)); do [ -n "${seen[n]:-}" ] || KEPT=$((KEPT + 1)); done
  return 0
}

# The --link pass: each managed project's open, typed, unparented leaves on both boards, the
# project with the most first. A project with no system list is passed over: there is no
# standing epic to fall back on.
link_pass() {
  local board epics rows p lane tsv cache kept failed mine total off size r rc=0 raw sys of epic
  read_board || return 1
  board="$(managed_board <<<"$BOARD")"
  epics="$(epics_open "$board")"
  # shellcheck disable=SC2016 # jq source, not shell
  rows="$(jq -c --arg only "$ONLY" '[.rows[]
    | select((.lane == "human" or .lane == "agent") and .id != null and (.state == "open" or .state == "doing")
             and .type != null and .type != "epic" and (.tags | any(startswith("of/")) | not)
             and (.raw | test("^\\s") | not)
             and ($only == "" or .project == $only))]' <<<"$board")"
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    tsv="$(project-stage-check "$p" --list 2>/dev/null)"
    [ -n "$tsv" ] || { say "$p: no system list, passed over"; continue; }
    agentctl report --name "$NAME" "item=$p" >/dev/null 2>&1 || true
    cache="$(link_cache "$p")" failed="$FAILED"
    kept="$(answers_kept "$cache" "$p" <<<"$rows")"
    if [ -n "$kept" ]; then
      while IFS=$'\x1f' read -r lane raw sys of epic; do
        link_row "$p" "$lane" "$raw" "$sys" "$of" "$epic" "$epics" "$tsv"
      done < <(jq -r '[.lane, .raw, .system, .of, .epic] | join("\u001f")' <<<"$kept")
    fi
    for lane in human agent; do
      # shellcheck disable=SC2016 # jq source, not shell
      mine="$(jq -c --arg p "$p" --arg l "$lane" --slurpfile have <(printf '%s\n' "$kept") \
        '($have | map("\(.lane)\u0000\(.raw)") | INDEX(.)) as $h
        | [.[] | select(.project == $p and .lane == $l and ($h["\(.lane)\u0000\(.raw)"] | not))] | sort_by(.line)' <<<"$rows")"
      total="$(jq length <<<"$mine")"; off=0
      answers_left "$cache" "$p" "$lane" "$total" && continue
      while [ "$off" -lt "$total" ]; do
        size="$(budget_batch "$NAME" "$INBOX_TRIAGE_MAX")"
        link_batch "$p" "$lane" "$(jq -c --argjson o "$off" --argjson m "$size" '.[$o:$o + $m]' <<<"$mine")" "$epics" "$tsv"; r=$?
        [ "$r" = "$CALLS_RC_CAPPED" ] && [ "$size" -gt 1 ] && continue
        [ "$r" = "$EX_BUDGET" ] && break 3
        [ "$r" = 0 ] || rc=1
        off=$((off + size))
      done
    done
    answers_done "$p" "$cache" "$failed"
  done < <(jq -r 'group_by(.project) | sort_by(-length) | .[][0].project' <<<"$rows")
  [ "$rc" = 0 ] && [ "$BUDGET_STOP" = 1 ] && rc="$EX_BUDGET"
  return "$rc"
}

# split_waiting: lists become one line per ask, before anything reads them: everything after this
# treats one line as one item. Every sheet is asked, not only those the board counts, because a
# block indented as a whole counts 0 until it is moved left. Writes, so a dry run skips it.
split_waiting() {
  local p sheets rc=0
  [ "$DRY" = 1 ] && return 0
  [ -n "$ONLY" ] || notes outbox split >&2 || { say "notes outbox split failed"; proof_why "notes outbox split failed"; rc=1; }
  read_board || return 1
  sheets="$(managed_board <<<"$BOARD" | jq -r '.projects[].project' | sort -u)"
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    [ -z "$ONLY" ] || [ "$p" = "$ONLY" ] || continue
    notes ptask "$p" split >&2 || { say "$p: cannot split the inbox"; proof_why "$p: cannot split the inbox"; rc=1; }
  done <<<"$sheets"
  return "$rc"
}

# unattended_projects: the projects an agent-lane worker takes with no tags, as dispatch reads them
# (`fleet-dispatch covered`: stage, repo, off list): there an agent does the work unattended, so
# rules/agent-run.md files a line where the worker reads.
unattended_projects() {
  fleet-dispatch covered 2>/dev/null | paste -sd, - | sed 's/,/, /g'
}

# One sweep's pass: lists split, the outbox, then every inbox.
pass() {
  local ob board all seen near rc=0 mrc p lines from raw text size r details
  split_waiting || rc=1
  ob="$(notes outbox list --json 2>/dev/null)" || { say "notes outbox list failed"; proof_why "notes outbox list failed"; return 1; }
  # What the record says was left or refused, by where it waited and its words. A line the model
  # left before this script last changed is asked once more, so a better router reaches what an
  # older one passed over; a refusal is the CLI's, so it holds until the words change.
  local since rec; since="$(stat -c %Y "$(readlink -f "${BASH_SOURCE[0]}")" 2>/dev/null || echo 0)"
  # And for an outbox line asked again, the projects the lines written beside it were filed to
  # (they left the outbox with their rows), from its newest left record that names them.
  rec='{"seen": {}, "near": {}}'
  # shellcheck disable=SC2016 # jq source, not shell
  if [ -s "$RECORD" ]; then rec="$(jq -cn --argjson since "$since" '
    def epoch: (.ts // "") as $t | try (
      ($t[0:19] + "Z" | fromdateiso8601)
      - (($t | capture("(?<s>[+-])(?<h>[0-9]{2}):(?<m>[0-9]{2})$")? // {s: "+", h: "0", m: "0"})
         | (if .s == "-" then -1 else 1 end) * ((.h | tonumber) * 3600 + (.m | tonumber) * 60))) catch 0;
    [inputs | select((.action == "refused" or .action == "left") and (.text | type) == "string")] as $r
    | {seen: ([$r[] | select(.action == "refused" or epoch >= $since) | {key: ((.from // "") + "\t" + .text), value: true}] | from_entries),
       near: ([$r[] | select(.action == "left" and .from == "outbox" and (.near | type) == "string" and .near != "")
               | {key: .text, value: (.near | split(",") | map(select(. != "")))}] | from_entries)}' "$RECORD")" \
    || { say "the ingest record did not parse; every line is asked as new"; rec='{"seen": {}, "near": {}}'; }
  fi
  seen="$(jq -c .seen <<<"$rec")" near="$(jq -c .near <<<"$rec")"
  local fresh='select($seen[.from + "\t" + .text] | not)'
  # An outbox line the human was asked about waits for the answer while `asked` is its newest
  # outbox record (an answer that could not be applied records `left` after it, which the seen map
  # reads), and a line over this sweep's ask cap waits for the next sweep. A #p: tag the human adds
  # meanwhile still moves it: the tagged path reads neither.
  local asked='{}'
  [ -s "$RECORD" ] && asked="$(jq -cn '[inputs | select(.from == "outbox")] | group_by(.text)
    | map(select(last.action == "asked") | {key: .[0].text, value: true}) | from_entries' "$RECORD" 2>/dev/null || echo '{}')"
  asked="$(jq -c --argjson d "$DEFERRED" '. + ($d | map({key: ., value: true}) | from_entries)' <<<"$asked")"
  # A `#ask` or `#investigate` line is a question, not work: it is answered and leaves the outbox, and goes no further.
  while IFS=$'\x1f' read -r -d '' look raw question text details; do
    ask_line "$look" "$raw" "$question" "$text" "$details"; mrc=$?
    [ "$mrc" = 0 ] || [ "$mrc" = "$EX_BUDGET" ] || rc=1
    [ "$BUDGET_STOP" = 1 ] && break
  done < <(jq -j --argjson seen "$seen" --arg only "$ONLY" ".[] | select(.look and \$only == \"\") | {from: \"outbox\", look, raw, question, text, details} | $fresh
    | .look, \"\u001f\", .raw, \"\u001f\", .question, \"\u001f\", .text, \"\u001f\", ((.details // []) | map(\"  \" + .) | join(\"\\n\")), \"\u0000\"" <<<"$ob")
  ob="$(jq -c '[.[] | select(.look | not)]' <<<"$ob")"
  # A `#p:` line that names a project exactly moves with no model and is triaged from that inbox.
  # One that names none (a typo, a short name) is not refused: it goes to the model with the word
  # as a hint, like a line with no tag.
  local missed='[]'
  while IFS=$'\x1f' read -r -d '' p raw text; do
    move_out "$p" "$raw" "$text" "#p: tag" tagged; mrc=$?
    if [ "$mrc" = "$EX_NO_PROJECT" ]; then
      say "outbox: #p:$p names no project, left for the model: $raw"
      missed="$(jq -c --arg raw "$raw" '. + [$raw]' <<<"$missed")"
    elif [ "$mrc" != 0 ]; then rc=1; fi
  done < <(jq -j --argjson seen "$seen" --arg only "$ONLY" ".[] | select(.project and (\$only == \"\" or .project == \$only))
    | {from: \"outbox\", raw, text, project} | $fresh | .project, \"\u001f\", .raw, \"\u001f\", .text, \"\u0000\"" <<<"$ob")

  read_board || return 1
  board="$(managed_board <<<"$BOARD")"
  # A `<id>: <words>` line answers its open row, with no model.
  [ -z "$ONLY" ] && while IFS=$'\x1f' read -r -d '' p raw text; do
    answer "$p" "$raw" "$text" "$board" || rc=1
  done < <(jq -j --argjson seen "$seen" --arg re "$ID_LINE_RE" --argjson missed "$missed" ".[] | select(((.project | not) or (.raw as \$r | \$missed | index(\$r) != null)) and (.text | test(\$re)))
    | {from: \"outbox\", raw, text} | $fresh | (.text | capture(\$re).id), \"\u001f\", .raw, \"\u001f\", .text, \"\u0000\"" <<<"$ob")
  all='[]'
  [ -z "$ONLY" ] && all="$(jq -c --arg re "$ID_LINE_RE" --argjson missed "$missed" --argjson asked "$asked" --argjson near "$near" '[.[]
    | select(((.project | not) or (.raw as $r | $missed | index($r) != null)) and (.text | test($re) | not) and ($asked[.text] | not))
    | {from: "outbox", raw, text, details, typed: false, hint: (.project // ""), near: ($near[.text] // [] | unique)}]' <<<"$ob")"
  while IFS= read -r p; do
    [ -n "$ONLY" ] && [ "$p" != "$ONLY" ] && continue
    agentctl report --name "$NAME" "item=$p" >/dev/null 2>&1 || true
    lines="$(notes ptask "$p" inbox --json 2>/dev/null)" || { say "$p: cannot read the inbox"; proof_why "$p: cannot read the inbox"; rc=1; continue; }
    all="$(jq -c --arg p "$p" --argjson all "$all" '$all + [.[] | {from: $p, raw, text, details, typed}]' <<<"$lines")"
  done < <(jq -r '.projects[] | select(.inbox > 0) | .project' <<<"$board" | sort -u)
  all="$(jq -c --argjson seen "$seen" --arg re "$SESSION_RE" "[.[] | $fresh | .session = (.text | test(\$re))]" <<<"$all")"

  # Typed already (the CLI reads the row grammar, so this script holds no copy of it): `file`
  # with no --as files it as written. A session's follow-up is never filed this way: the typed
  # path skips the twin check, so it goes to the model with the rows closest to it.
  while IFS=$'\x1f' read -r -d '' from raw text; do
    file_line "$from" "$raw" "$text" --want "$(want_channel "$from")" --why "typed"
  done < <(jq -j '.[] | select(.typed and (.session | not)) | .from, "\u001f", .raw, "\u001f", .text, "\u0000"' <<<"$all")
  size="$(budget_batch "$NAME" "$INBOX_TRIAGE_MAX")"
  all="$(jq -c --argjson max "$size" '[.[] | select((.typed | not) or .session)] | {take: .[:$max], over: (.[$max:] | length)}' <<<"$all")"
  local over; over="$(jq .over <<<"$all")"
  [ "$over" -gt 0 ] && { KEPT=$((KEPT + over)); OVER=1; }
  [ "$(jq '.take | length' <<<"$all")" -gt 0 ] || return "$rc"
  route "$(jq -c .take <<<"$all")" "$board"; r=$?
  # Capped: the next pass asks the same lines at the halved size. One line that caps alone is
  # refused, so it waits for the person instead of being asked again every sweep.
  # CAPPED holds until a call fits, so a sweep whose passes all capped ends FAILED.
  CAPPED=0
  if [ "$r" = "$CALLS_RC_CAPPED" ]; then
    if [ "$size" -gt 1 ]; then
      CAPPED=1; KEPT=$((KEPT + $(jq '.take | length' <<<"$all"))); OVER=1
    else
      FAILED=$((FAILED + 1))
      note refused "$(jq -r '.take[0].from' <<<"$all")" "too big for one call at the per-call cap" "$(jq -r '.take[0].text' <<<"$all")"
    fi
  elif [ "$r" = "$EX_BUDGET" ]; then
    KEPT=$((KEPT + $(jq '.take | length' <<<"$all")))
  elif [ "$r" != 0 ]; then
    rc=1
  fi
  return "$rc"
}

# One sweep: passes until the inbox flag holds still and nothing is over the cap, then the
# inbox page and the proof.
sweep() {
  local k before rc=0 verdict
  FILED=0; KEPT=0; FAILED=0; ROUTED=0; CAPPED=0; BUDGET_STOP=0; ANSWERED=0; ASKED=0; DEFERRED='[]'; LINES_DROPPED=0; IMPROVED=0
  if [ "$WATCH" = 1 ] && [ -e "$PAUSED" ]; then say "the fleet is paused; the sweep waits for the resume"; return 0; fi
  for ((k = 1; k <= INBOX_TRIAGE_PASSES; k++)); do
    before="$(flag_state)"; OVER=0
    pass || rc=1
    [ "$DRY" = 1 ] || [ "$BUDGET_STOP" = 1 ] && break
    [ "$OVER" = 0 ] && [ "$(flag_state)" = "$before" ] && break
  done
  [ "$CAPPED" = 0 ] || rc=1
  [ "$rc" = 0 ] && [ "$BUDGET_STOP" = 1 ] && rc="$EX_BUDGET"
  SUMMARY="moved $ROUTED from the outbox, filed $FILED, left $KEPT, refused $FAILED, answered $ANSWERED, asked you $ASKED, dropped $LINES_DROPPED, improvements $IMPROVED, batch $(budget_batch "$NAME" "$INBOX_TRIAGE_MAX")"
  say "$SUMMARY"
  [ "$DRY" = 1 ] && return "$rc"
  notes ingest page >/dev/null 2>&1 || say "notes ingest page failed"
  # A row waits for its plan: the planner runs as its own unit, so intake never waits on it.
  "$HERE/agentctl-inbox-plan" --kick || true
  verdict=NOOP
  local handled=$((FILED + ROUTED + ANSWERED + ASKED + LINES_DROPPED + IMPROVED))
  [ "$handled" -gt 0 ] && verdict=WORKED
  [ "$rc" = "$EX_BUDGET" ] && { verdict=BLOCKED; SUMMARY="budget: $SUMMARY"; }
  [ "$rc" = 1 ] && verdict=FAILED
  # A sweep that handled a line says so in the record, stopped or not, so its moves and filings
  # read as one run.
  [ $((handled + KEPT + FAILED)) -gt 0 ] \
    && chain_event intake sweep outbox "inbox sweep" --why "$SUMMARY"
  if [ "$rc" != 0 ]; then
    # A stopped sweep leaves its lines waiting: the pipeline line's inbox node reads it from the record.
    local why; why="$(proof_reasons)"
    chain_event intake sweep-stopped outbox "inbox sweep" --why "${why:-$SUMMARY}"
  fi
  proof_report "$NAME" "$verdict" "$SUMMARY"
  agentctl report --name "$NAME" "detail=$SUMMARY" next= >/dev/null 2>&1 || true
  return "$rc"
}

# answer_ask <id>: the human's answer to a which-project ask (ask-resume runs this, no model). A
# project moves the line to its inbox, where the next sweep files it (the move's save wakes the
# runner); `drop` takes it out of the outbox. Any other answer leaves it, with why.
answer_ask() {
  local id="$1" ans text raw p
  ans="$(agent-ask show "$id" 2>/dev/null | sed -n 's/^answer: //p' | awk 'NR==1')"
  # The first word, as a slug: `Scratch.` and `scratch, the menu one` both answer scratch.
  ans="$(awk '{print tolower($1)}' <<<"$ans" | tr -cd 'a-z0-9_-')"
  [ -n "$ans" ] || { say "ask $id: no answer yet"; return 1; }
  text="$(jq -rn --arg id "$id" '[inputs | select(.action == "asked" and .why == $id) | .text] | last // ""' "$RECORD" 2>/dev/null)"
  [ -n "$text" ] || { say "ask $id: no outbox line was asked about with it"; return 1; }
  raw="$(notes outbox list --json 2>/dev/null | jq -r --arg t "$text" 'first(.[] | select(.text == $t) | .raw) // ""')"
  [ -n "$raw" ] || { say "ask $id: the line is no longer in the outbox: $text"; return 0; }
  if [ "$ans" = drop ]; then
    [ "$DRY" = 1 ] && { printf 'would drop [outbox] %s\n' "$raw"; return 0; }
    notes outbox drop -- "$raw" >/dev/null || { left outbox "$text" "the answer drop could not be applied (notes outbox drop failed)"; return 1; }
    say "ask $id: dropped $text"; return 0
  fi
  p="$(notes board --json 2>/dev/null | managed_board | jq -r --arg p "$ans" 'first(.projects[] | select(.project == $p) | .project) // ""')"
  if [ -z "$p" ]; then
    left outbox "$text" "the answer '$ans' names no project; tag it #p:<project>"; return 0
  fi
  move_out "$p" "$raw" "$text" "ask answer: $id"
}

# The directories whose saves wake a sweep: the outbox's, each project's (its human sheet holds
# the inbox; agent boards have none), and the fleet state dir, for PAUSED going away.
watch_dirs() {
  { dirname "$OUTBOX"; dirname "$PAUSED"
    notes board --json 2>/dev/null | jq -r '.projects[].dir'
  } | while IFS= read -r d; do [ -d "$d" ] && printf '%s\n' "$d"; done | sort -u
}

# watch_sweep: one sweep, then WAIT for --watch: 0 after a clean sweep, else the backoff from
# INBOX_RETRY_S, doubling to INBOX_RETRY_MAX_S, so a failed sweep is retried with no save. A sweep
# stopped at its budget takes the same backoff: a refused call costs nothing, and the retry is what
# notices a raise or midnight, which send no event.
watch_sweep() {
  local rc
  sweep; rc=$?
  if [ "$rc" = 0 ]; then WAIT=0; return 0; fi
  if [ "$WAIT" = 0 ]; then WAIT=$INBOX_RETRY_S; else WAIT=$((WAIT * 2)); fi
  [ "$WAIT" -le "$INBOX_RETRY_MAX_S" ] || WAIT=$INBOX_RETRY_MAX_S
  if [ "$rc" = "$EX_BUDGET" ]; then say "the sweep stopped at its budget; it runs again in ${WAIT}s unless a save comes first"
  else say "the sweep failed; it runs again in ${WAIT}s unless a save comes first"; fi
  local at; at=$(($(date +%s) + WAIT))
  agentctl report --name "$NAME" "detail=$SUMMARY; retry $(date -d "@$at" +%H:%M)" "next=$at" >/dev/null 2>&1 || true
}

# --watch: a sweep now, then one after each burst of saves, and again on the backoff after a failure. Writers (notes, nvim) replace a file
# by rename, so the directories are watched, not the files. Returns 1 when inotifywait ends, so
# systemd restarts the runner.
watch() {
  command -v inotifywait >/dev/null || { say "--watch needs inotifywait (inotify-tools)"; return 1; }
  local dirs fd pid got
  local -a d
  while :; do
    dirs="$(watch_dirs)"
    mapfile -t d <<<"$dirs"
    exec {fd}< <(exec inotifywait -m -q -e close_write,moved_to,delete --format '%w%f' \
      --include '/(README\.md|outbox\.md|PAUSED)$' "${d[@]}")
    pid=$!
    watch_sweep
    got=0
    while :; do
      if [ "$WAIT" -gt 0 ]; then
        # A failed sweep (a usage limit, a broken call) has no event that says it would now pass,
        # so it runs again on the backoff when no save comes first.
        read -r -t "$WAIT" -u "$fd" _; got=$?
        if [ "$got" -gt 128 ]; then watch_sweep; continue; fi
      else
        read -r -u "$fd" _; got=$?
      fi
      [ "$got" = 0 ] || break
      # The debounce: each read returns on the next save, or times out once the saves stop.
      while :; do read -r -t "$INBOX_SWEEP_QUIET" -u "$fd" _ || { got=$?; break; }; done
      watch_sweep
      [ "$got" -gt 128 ] || break
      [ "$(watch_dirs)" = "$dirs" ] || { got=dirs; break; }
    done
    exec {fd}<&-
    kill "$pid" 2>/dev/null
    [ "$got" = dirs ] || { say "inotifywait ended"; return 1; }
    say "a project came or went; watching the new set"
  done
}

main() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY=1; shift ;;
      --project) ONLY="${2:-}"; shift 2 ;;
      --backlog) BACKLOG=1; shift ;;
      --priority) PRIORITY=1; shift ;;
      --retag) case "${2:-}" in urgent|high|normal|low) RETAG="$2"; shift 2 ;; *) say "--retag takes urgent, high, normal or low"; return 2 ;; esac ;;
      --link) LINK=1; shift ;;
      --size) SIZE=1; shift ;;
      --report) REPORT=1; shift ;;
      --watch) WATCH=1; shift ;;
      --answer) [ -n "${2:-}" ] || { say "--answer takes an ask id"; return 2; }; ANSWER_ID="$2"; shift 2 ;;
      -h|--help) sed -n '2,5p' "$0"; return 0 ;;
      *) say "unknown argument: $1"; return 2 ;;
    esac
  done
  local rc=0 summary verdict cfg dir
  [ "$PRIORITY" = 0 ] || [ "$BACKLOG" = 1 ] || { say "--priority goes with --backlog"; return 2; }
  [ -z "$RETAG" ] || [ "$PRIORITY" = 1 ] || { say "--retag goes with --priority"; return 2; }
  [ "$LINK" = 0 ] || { [ "$BACKLOG" = 1 ] && [ "$PRIORITY" = 0 ]; } || { say "--link goes with --backlog, without --priority"; return 2; }
  [ "$SIZE" = 0 ] || { [ "$BACKLOG" = 1 ] && [ "$PRIORITY" = 0 ] && [ "$LINK" = 0 ]; } || { say "--size goes with --backlog, without --priority or --link"; return 2; }
  [ "$REPORT" = 0 ] || { [ "$BACKLOG" = 1 ] && [ "$PRIORITY$LINK$SIZE" = 000 ]; } || { say "--report goes with --backlog, without --priority, --link or --size"; return 2; }
  if [ "$REPORT" = 1 ]; then backlog_report; return; fi
  # A plain --backlog pass reports as its own agent, so its BLOCKED or batch size never lands on the intake sweep.
  [ -z "${AGENTCTL_NAME:-}" ] && [ "$BACKLOG$PRIORITY$LINK$SIZE" = 1000 ] && NAME=inbox-backlog
  if [ "$SIZE" = 1 ]; then
    size_pass; rc=$?
    summary="size: scored $SCORED, left $KEPT, refused $FAILED, batch $(budget_batch "$NAME" "$INBOX_TRIAGE_MAX")"
    say "$summary"
    [ "$DRY" = 1 ] && return "$rc"
    verdict=NOOP
    [ "$SCORED" -gt 0 ] && verdict=WORKED
    [ "$rc" = "$EX_BUDGET" ] && { verdict=BLOCKED; summary="budget: $summary"; }
    [ "$rc" = 1 ] && verdict=FAILED
    proof_report "$NAME" "$verdict" "$summary"
    return "$rc"
  fi
  if [ "$LINK" = 1 ]; then
    link_pass; rc=$?
    summary="link: feature $LINKED, standing $STANDING, new epics $NEW_EPICS, left $KEPT, refused $FAILED, batch $(budget_batch "$NAME" "$INBOX_TRIAGE_MAX")"
    say "$summary"
    [ "$DRY" = 1 ] && return "$rc"
    verdict=NOOP
    [ $((LINKED + STANDING)) -gt 0 ] && verdict=WORKED
    [ "$rc" = "$EX_BUDGET" ] && { verdict=BLOCKED; summary="budget: $summary"; }
    [ "$rc" = 1 ] && verdict=FAILED
    proof_report "$NAME" "$verdict" "$summary"
    return "$rc"
  fi
  if [ "$PRIORITY" = 1 ]; then
    priority_pass; rc=$?
    summary="priority: tagged $TAGGED, left $KEPT, refused $FAILED, batch $(budget_batch "$NAME" "$INBOX_TRIAGE_MAX")"
    say "$summary"
    [ "$DRY" = 1 ] && return "$rc"
    verdict=NOOP
    [ "$TAGGED" -gt 0 ] && verdict=WORKED
    [ "$rc" = "$EX_BUDGET" ] && { verdict=BLOCKED; summary="budget: $summary"; }
    [ "$rc" = 1 ] && verdict=FAILED
    proof_report "$NAME" "$verdict" "$summary"
    return "$rc"
  fi
  if [ "$BACKLOG" = 1 ]; then
    backlog_pass; rc=$?
    summary="backlog: rewrote $REWROTE, moved $MOVED, dropped $DROPPED, kept $KEPT, refused $FAILED, raised $RAISED, improvements $IMPROVED, done $CLOSED_DONE, batch $(budget_batch "$NAME" "$INBOX_TRIAGE_MAX")"
    say "$summary"
    [ "$DRY" = 1 ] && return "$rc"
    verdict=NOOP
    [ $((REWROTE + MOVED + DROPPED + RAISED + IMPROVED + CLOSED_DONE)) -gt 0 ] && verdict=WORKED
    [ "$rc" = "$EX_BUDGET" ] && { verdict=BLOCKED; summary="budget: $summary"; }
    [ "$rc" = 1 ] && verdict=FAILED
    proof_report "$NAME" "$verdict" "$summary"
    return "$rc"
  fi
  cfg="$(notes config 2>/dev/null)"
  # `key   value`, the value to the end of the line: a path may hold a space.
  dir="$(sed -n '/^state  */{s///p;q;}' <<<"$cfg")"
  OUTBOX="$(sed -n '/^outbox  */{s///p;q;}' <<<"$cfg")"
  [ -n "$dir" ] && { FLAG="$dir/inbox.changed"; RECORD="$dir/ingest.jsonl"; }
  if [ -n "$ANSWER_ID" ]; then answer_ask "$ANSWER_ID"; return; fi
  if [ "$WATCH" = 1 ]; then
    [ "$DRY" = 0 ] && [ -z "$ONLY" ] && [ -n "$OUTBOX" ] || { say "--watch takes no --dry-run or --project, and needs notes config's outbox"; return 2; }
    watch
    return
  fi
  sweep
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
