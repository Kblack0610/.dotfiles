#!/usr/bin/env bash
# agentctl-inbox-triage: file every project sheet's `## Inbox` lines as typed rows.
#
#   agentctl-inbox-triage [--dry-run] [--project <name>] [--backlog]
#
# A line already written as `type(area): title` is filed as written with no model. The rest
# of a project's lines go to one cheap-model call (model-lane: triage is a classification job),
# which only proposes: a typed row or rows, a duplicate of an open row, or a skip. Every write
# goes through `notes ptask <p> --exact file`, which refuses an untyped row, a missing id or a
# line that changed since it was read, so this script never edits a sheet. A skipped or refused
# line stays in the inbox for the human. Nothing is ever dropped.
#
# Woken by inbox-triage.path when a notes writer touches <state_dir>/inbox.changed. A write
# that lands during a pass changes the flag again, so the pass repeats until the flag holds
# still (at most INBOX_TRIAGE_PASSES times). A line typed into a sheet by hand touches no flag,
# so the runner also has a daily SCHEDULE pass.
#
# --backlog runs the same triage over the rows already on each project's two boards, largest
# project first: the model proposes keep, rewrite (`ptask edit --was`, which keeps the old words
# as a `was:` line), a move to the product the row is about (`ptask move --project`), a dup of
# another row, or a drop with its reason (`ptask drop`, which keeps the row ticked). A row in
# progress is only ever rewritten. Every write is `--exact`, so a row edited since the read is
# left alone.
set -uo pipefail

NAME="${AGENTCTL_NAME:-inbox-triage}"
: "${INBOX_TRIAGE_CMD:=agentctl-run --role distill}"
: "${INBOX_TRIAGE_PASSES:=3}"
: "${INBOX_TRIAGE_MAX:=40}"   # lines sent to the model per project per pass, and rows per --backlog call

LIB="$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib"
# shellcheck source=/dev/null
. "$LIB/agent-proof.sh"
# shellcheck source=/dev/null
. "$LIB/md-render.sh"

DRY=0; ONLY=""; BACKLOG=0; FILED=0; KEPT=0; FAILED=0; FLAG=""
REWROTE=0; MOVED=0; DROPPED=0
say() { printf 'inbox-triage: %s\n' "$*" >&2; }
# clean <width>: model text as one printable ASCII line, punctuation folded rather than dropped.
clean() { md_ascii | tr -cd ' -~' | cut -c1-"$1"; }

# One model answer line -> n, action, id, project, lane, rows (joined by RS), split by US.
# shellcheck disable=SC2016 # jq source, not shell
ANSWER_JQ='def s: (. // "") | tostring | gsub("[[:cntrl:]]"; " ");
  fromjson? | select(type == "object" and (.n | type) == "number")
  | [(.n | floor | tostring), (.action | s), (.id | s), (.project | s), (.lane | s),
     ([.rows[]? | strings | s] | join("\u001e"))] | join("\u001f")'

# file_line <project> <raw> <args...>: one `ptask file`, counted.
file_line() {
  local p="$1" raw="$2"; shift 2
  if [ "$DRY" = 1 ]; then printf 'would file [%s] %s:' "$p" "$raw"; printf ' %q' "$@"; echo; FILED=$((FILED + 1)); return 0; fi
  if notes ptask "$p" --exact file "$@" -- "$raw"; then
    FILED=$((FILED + 1))
  else
    say "$p: not filed, left in the inbox: $raw"
    FAILED=$((FAILED + 1)); return 1
  fi
}

# The flag every notes inbox writer touches (`ptask add`, the Focus sweep): its stamp, or empty.
flag_state() { [ -n "$FLAG" ] && cat "$FLAG" 2>/dev/null; }

# triage <project> <board json> <project names>: one project's inbox.
triage() {
  local p="$1" board="$2" names="$3" lines batch raw prompt out rc wd untyped
  lines="$(notes ptask "$p" inbox --json 2>/dev/null)" || { say "$p: cannot read the inbox"; return 1; }
  # Typed already (the CLI reads the row grammar, so this script holds no copy of it): `file`
  # with no --as files it as written.
  while IFS= read -r -d '' raw; do
    file_line "$p" "$raw"
  done < <(jq -j '.[] | select(.typed) | .raw, "\u0000"' <<<"$lines")
  untyped="$(jq -c --argjson max "$INBOX_TRIAGE_MAX" '[.[] | select(.typed | not)] | .[$max:] as $over | {take: .[:$max], over: ($over | length)}' <<<"$lines")"
  KEPT=$((KEPT + $(jq .over <<<"$untyped")))
  local -a raws=()
  mapfile -d '' -t raws < <(jq -j '.take[] | .raw, "\u0000"' <<<"$untyped")
  [ "${#raws[@]}" -gt 0 ] || return 0
  batch="$(jq -r '.take | to_entries[] | "\(.key + 1). \(.value.text)", (.value.details[] | "   " + .)' <<<"$untyped")"

  local open
  open="$(jq -r --arg p "$p" '.rows[] | select(.project == $p and .state != "done" and .id != null) | "\(.id)\t\(.lane)\t\(.text)"' <<<"$board" | cut -c1-160)"
  prompt="You file raw notes from a person's project inbox as task rows. Project: $p. Other projects: $names.

A row is: type(area): title, then tags. type is one of feat fix perf refactor docs test chore ci run decide check. area is one short lowercase word for the part of the project it touches. The title says what to do in plain words, under 80 characters, keeping the person's meaning and not adding scope. Tags: one priority (#urgent, #high or #low; omit when unclear) and one size (#size/s, #size/m or #size/l). A row that breaks these is refused and the line waits for the person.

For each numbered line, one JSON object per line, between a line INBOX-TRIAGE-START and a line INBOX-TRIAGE-END, nothing else between them:
{\"n\": 1, \"action\": \"file\", \"rows\": [\"fix(audio): the gun sound plays late #high #size/s\"], \"project\": \"$p\", \"lane\": \"human\"}
{\"n\": 2, \"action\": \"dup\", \"id\": \"<id of the open row it repeats>\"}
{\"n\": 3, \"action\": \"skip\"}
file: rows holds one row, or more only when the line plainly asks for separate things. project is another project's name only when the line is plainly about that project. lane is agent only when the line asks an agent to do tooling, CI or repo work and a person need not; otherwise human.
dup: only when an open row below already asks for the same thing.
skip: the line is not a task (a thought, a question, a note to self) or you cannot tell what it asks.

## Inbox lines
$batch
## Open rows (id, lane, text)
$open"
  wd="$(mktemp -d)"
  # shellcheck disable=SC2086 # a word list by design, overridable in tests
  # An empty directory, so no repo's Stop hook answers in place of the model.
  out="$(cd "$wd" && $INBOX_TRIAGE_CMD -p "$prompt" 2>/dev/null)"; rc=$?
  rm -rf -- "$wd"
  [ "$rc" = 0 ] || { say "$p: model call failed"; return 1; }
  grep -qx 'INBOX-TRIAGE-START' <<<"$out" || { say "$p: model returned no answer block"; return 1; }
  local n action id dest lane rows r
  local -a args rowv
  while IFS=$'\x1f' read -r n action id dest lane rows; do
    [ "$n" -ge 1 ] 2>/dev/null && [ "$n" -le "${#raws[@]}" ] || continue
    raw="${raws[n - 1]}"
    [ -n "$raw" ] || continue
    raws[n - 1]=""   # one answer per line
    case "$action" in
      file)
        args=()
        IFS=$'\x1e' read -r -a rowv <<<"$rows"
        for r in "${rowv[@]}"; do
          r="$(clean 150 <<<"$r")"
          [ -n "$r" ] && args+=(--as "$r")
        done
        [ "${#args[@]}" -gt 0 ] || { KEPT=$((KEPT + 1)); continue; }
        dest="$(clean 60 <<<"$dest")"
        [ -n "$dest" ] && [ "$dest" != "$p" ] && args+=(--project "$dest")
        [ "$lane" = agent ] && args+=(--lane agent)
        file_line "$p" "$raw" "${args[@]}"
        ;;
      dup)
        id="$(clean 40 <<<"$id")"
        [ -n "$id" ] || { KEPT=$((KEPT + 1)); continue; }
        file_line "$p" "$raw" --dup "$id"
        ;;
      *) KEPT=$((KEPT + 1)) ;;
    esac
  done < <(sed -n '/^INBOX-TRIAGE-START$/,/^INBOX-TRIAGE-END$/p' <<<"$out" | sed '1d;$d' | jq -rR "$ANSWER_JQ")
  for raw in "${raws[@]}"; do [ -n "$raw" ] && KEPT=$((KEPT + 1)); done
  return 0
}

# One --backlog answer line -> n, action, id, project, row, why, split by US.
# shellcheck disable=SC2016 # jq source, not shell
BACKLOG_JQ='def s: (. // "") | tostring | gsub("[[:cntrl:]]"; " ");
  fromjson? | select(type == "object" and (.n | type) == "number")
  | [(.n | floor | tostring), (.action | s), (.id | s), (.project | s), (.row | s), (.why | s)] | join("\u001f")'

# pt <project> <lane> <ptask args...>: one ptask write on a lane, or its echo under --dry-run.
pt() {
  local p="$1" lane="$2"; shift 2
  local -a on=()
  [ "$lane" = agent ] && on=(--agent)
  if [ "$DRY" = 1 ]; then printf 'would run: notes ptask'; printf ' %q' "$p" "${on[@]}" "$@"; echo; return 0; fi
  notes ptask "$p" "${on[@]}" "$@" >/dev/null || { say "$p ($lane): refused: $*"; FAILED=$((FAILED + 1)); return 1; }
}

# backlog <project> <lane> <board json> <project names> <homes>: one lane's open rows, in batches.
backlog() {
  local p="$1" lane="$2" board="$3" names="$4" homes="$5" rows total off rc=0
  # Each row with its child rows (the indented open rows under it on the sheet), which the
  # model sees as context and which go wherever the row goes.
  # shellcheck disable=SC2016 # jq source, not shell
  rows="$(jq -c --arg p "$p" --arg l "$lane" '[.rows[] | select(.project == $p and .lane == $l and .state != "done")] | sort_by(.line) as $all
    | [$all | to_entries[] | select(.value.id != null and (.value.state == "open" or .value.state == "doing")) | .key as $k
       | .value + {kids: ($all[$k + 1:] | (map(.raw | test("^\\s") | not) | index(true)) as $stop
                         | (if $stop == null then . else .[:$stop] end) | map(.text))}]
    | sort_by(.text | ascii_downcase)' <<<"$board")"
  total="$(jq length <<<"$rows")"
  for ((off = 0; off < total; off += INBOX_TRIAGE_MAX)); do
    backlog_batch "$p" "$lane" "$(jq -c --argjson o "$off" --argjson m "$INBOX_TRIAGE_MAX" '.[$o:$o + $m]' <<<"$rows")" "$names" "$homes" || rc=1
  done
  return "$rc"
}

backlog_batch() {
  local p="$1" lane="$2" batch="$3" names="$4" homes="$5" listing prompt out rc wd
  local -a raws ids states kids
  mapfile -d '' -t raws < <(jq -j '.[] | .raw, "\u0000"' <<<"$batch")
  mapfile -t ids < <(jq -r '.[] | .id' <<<"$batch")
  mapfile -t states < <(jq -r '.[] | .state' <<<"$batch")
  mapfile -t kids < <(jq -r '.[] | .kids | length' <<<"$batch")
  listing="$(jq -r 'to_entries[] | "\(.key + 1). [\(.value.id)]\(if .value.state == "doing" then " (doing)" else "" end) \(.value.text)", (.value.kids[] | "   - " + .)' <<<"$batch" | cut -c1-400)"
  prompt="You clean up one board of a person's project task list. Project: $p. Board: $lane (human: the person's own list; agent: work agents do). Other projects: $names.${homes:+ Projects whose code lives in another project's repo: $homes. A row about only one of those belongs on that project, not on the repo's.}

A clean row is: type(area): title, then tags. type is one of feat fix perf refactor docs test chore ci run decide check. area is one short lowercase word for the part of the project it touches. The title says what to do in plain words, under 90 characters, keeping the row's meaning exactly and adding no scope; the old words are kept beside it, so specifics may go. Where the words are unclear, stay close to them rather than guess, and never turn a question or a complaint into its opposite (\"removed X, why did we do that?\" asks to bring X back or decide on it, not to remove it). Give no priority tag (the row keeps its own); add one size tag (#size/s, #size/m or #size/l) when the row has none. A rewrite that breaks these is refused and the row stays as it is.

For each numbered row, one JSON object per line, between a line INBOX-TRIAGE-START and a line INBOX-TRIAGE-END, nothing else between them:
{\"n\": 1, \"action\": \"rewrite\", \"row\": \"fix(audio): the gun sound plays late #size/s\"}
{\"n\": 2, \"action\": \"rewrite\", \"row\": \"feat(town): add a jail #size/m\", \"project\": \"<other project>\"}
{\"n\": 3, \"action\": \"dup\", \"id\": \"<id of the row it repeats>\"}
{\"n\": 4, \"action\": \"drop\", \"why\": \"<short reason>\"}
keep: the row is clean already. rewrite: it is not. Either carries project, another project's name, when the row is about that project alone (it names that project, or its places, characters, scenes or tests): the row then moves to that project's board, and its area names a part of that project, never the project itself. A row about several projects, or the shared code under them, stays here.
dup: only when another row in this list asks for the same thing; never the row's own id.
drop: only when the row is empty, is not a task, or itself says it is done, answered or superseded. Never drop a row for being old or unclear.
A row marked (doing) is in progress: keep or rewrite it only. Indented lines under a row are its child rows: they stay with it, so a row with children is a heading for them; rewrite it as a title that covers them, and never drop it or call it a dup.

## Rows (n. [id] text, child rows indented)
$listing"
  wd="$(mktemp -d)"
  # shellcheck disable=SC2086 # a word list by design, overridable in tests
  out="$(cd "$wd" && $INBOX_TRIAGE_CMD -p "$prompt" 2>/dev/null)"; rc=$?
  rm -rf -- "$wd"
  [ "$rc" = 0 ] || { say "$p ($lane): model call failed"; return 1; }
  grep -qx 'INBOX-TRIAGE-START' <<<"$out" || { say "$p ($lane): model returned no answer block"; return 1; }
  local n action id dest row why raw own
  local -a seen=()
  while IFS=$'\x1f' read -r n action id dest row why; do
    [ "$n" -ge 1 ] 2>/dev/null && [ "$n" -le "${#raws[@]}" ] || continue
    [ -z "${seen[n]:-}" ] || continue   # one answer per row
    seen[n]=1
    raw="${raws[n - 1]}" own="${ids[n - 1]}"
    dest="$(clean 60 <<<"$dest")"
    [ "$dest" = "$p" ] && dest=""
    if [ "${states[n - 1]}" = doing ]; then
      dest=""
      [ "$action" = rewrite ] || action=keep
    fi
    # a heading over child rows is never closed: its children would sit under a ticked row
    [ "${kids[n - 1]}" -gt 0 ] && { [ "$action" = drop ] || [ "$action" = dup ]; } && action=keep
    case "$action" in
      rewrite)
        row="$(clean 150 <<<"$row")"
        if [ -n "$row" ] && pt "$p" "$lane" --exact edit --was --text "$row" -- "$raw"; then
          REWROTE=$((REWROTE + 1))
          # the row's line changed, so the move names it by its id
          [ -n "$dest" ] && pt "$p" "$lane" move --project "$dest" "$own" && MOVED=$((MOVED + 1))
        else
          KEPT=$((KEPT + 1))
        fi
        ;;
      dup)
        id="$(clean 40 <<<"$id")"
        if [ -n "$id" ] && [ "$id" != "$own" ] && printf '%s\n' "${ids[@]}" | grep -qxF -- "$id" &&
          pt "$p" "$lane" --exact drop --dup "$id" -- "$raw"; then
          DROPPED=$((DROPPED + 1))
        else
          KEPT=$((KEPT + 1))
        fi
        ;;
      drop)
        why="$(clean 100 <<<"$why")"
        if [ -n "$why" ] && pt "$p" "$lane" --exact drop --why "triage: $why" -- "$raw"; then
          DROPPED=$((DROPPED + 1))
        else
          KEPT=$((KEPT + 1))
        fi
        ;;
      *)
        if [ -n "$dest" ] && pt "$p" "$lane" --exact move --project "$dest" -- "$raw"; then
          MOVED=$((MOVED + 1))
        else
          KEPT=$((KEPT + 1))
        fi
        ;;
    esac
  done < <(sed -n '/^INBOX-TRIAGE-START$/,/^INBOX-TRIAGE-END$/p' <<<"$out" | sed '1d;$d' | jq -rR "$BACKLOG_JQ")
  for ((n = 1; n <= ${#raws[@]}; n++)); do [ -n "${seen[n]:-}" ] || KEPT=$((KEPT + 1)); done
  return 0
}

# The --backlog pass: every project's two boards, the most open rows first.
backlog_pass() {
  local board names homes rc=0 p lane
  board="$(notes board --json 2>/dev/null)" || { say "notes board --json failed"; return 1; }
  names="$(jq -r '[.projects[].project] | unique | join(", ")' <<<"$board")"
  homes="$(jq -r '[.trackers // {} | to_entries[] | select((.value.repo // .key) != .key) | "\(.key) (in \(.value.repo))"] | join(", ")' "${PROJECT_MAP_FILE:-$HOME/.config/shared-hooks/project-map.json}" 2>/dev/null)"
  while IFS= read -r p; do
    [ -n "$ONLY" ] && [ "$p" != "$ONLY" ] && continue
    agentctl report --name "$NAME" "item=$p" >/dev/null 2>&1 || true
    for lane in human agent; do
      backlog "$p" "$lane" "$board" "$names" "$homes" || rc=1
    done
  done < <(jq -r '[.rows[] | select(.project != null and (.lane == "human" or .lane == "agent") and .state != "done")]
    | group_by(.project) | sort_by(-length) | .[][0].project' <<<"$board")
  return "$rc"
}

pass() {
  local board names rc=0 p
  board="$(notes board --json 2>/dev/null)" || { say "notes board --json failed"; return 1; }
  names="$(jq -r '[.projects[].project] | unique | join(", ")' <<<"$board")"
  while IFS= read -r p; do
    [ -n "$ONLY" ] && [ "$p" != "$ONLY" ] && continue
    agentctl report --name "$NAME" "item=$p" >/dev/null 2>&1 || true
    triage "$p" "$board" "$names" || rc=1
  done < <(jq -r '.projects[] | select(.inbox > 0) | .project' <<<"$board" | sort -u)
  return "$rc"
}

main() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY=1; shift ;;
      --project) ONLY="${2:-}"; shift 2 ;;
      --backlog) BACKLOG=1; shift ;;
      -h|--help) sed -n '2,4p' "$0"; return 0 ;;
      *) say "unknown argument: $1"; return 2 ;;
    esac
  done
  local rc=0 before k dir summary verdict
  if [ "$BACKLOG" = 1 ]; then
    backlog_pass || rc=1
    summary="backlog: rewrote $REWROTE, moved $MOVED, dropped $DROPPED, kept $KEPT, refused $FAILED"
    say "$summary"
    [ "$DRY" = 1 ] && return "$rc"
    verdict=NOOP
    [ $((REWROTE + MOVED + DROPPED)) -gt 0 ] && verdict=WORKED
    [ "$rc" != 0 ] && verdict=FAILED
    proof_report "$NAME" "$verdict" "$summary"
    return "$rc"
  fi
  dir="$(notes config 2>/dev/null | awk '$1 == "state" {print $2; exit}')"
  [ -n "$dir" ] && FLAG="$dir/inbox.changed"
  for ((k = 1; k <= INBOX_TRIAGE_PASSES; k++)); do
    before="$(flag_state)"
    pass || rc=1
    [ "$DRY" = 1 ] && break
    [ "$(flag_state)" = "$before" ] && break
  done
  summary="filed $FILED, left $KEPT, refused $FAILED"
  say "$summary"
  [ "$DRY" = 1 ] && return "$rc"
  verdict=NOOP
  [ "$FILED" -gt 0 ] && verdict=WORKED
  [ "$rc" != 0 ] && verdict=FAILED
  proof_report "$NAME" "$verdict" "$summary"
  agentctl report --name "$NAME" "detail=$summary" >/dev/null 2>&1 || true
  return "$rc"
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
