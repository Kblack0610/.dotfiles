#!/usr/bin/env bash
# agentctl-wave-roll - cut each project's version when its owner says it shipped.
#
# Who owns the number is project_version_owner (stages.md, "Versions"):
#   tag    one lab note per tag, named from the tag (`notes projects --release --tag`), each
#          tag since RELEASE_NOTES_SINCE and the newest, lowest first. A tag that has reached the
#          sheet's `Version:` releases it: open tasks carry to the next version, the finished
#          one freezes as the tag, the next opens after the tag, and the agent board follows. A
#          tag below the open version (a hotfix nobody planned) gets a note marked as having
#          no planned rows, and the sheet stays open. The sheet's `Version:` is the next open
#          version, and only this roll moves it.
#   sheet  no build, so the sheet counter: cut when its stage's cadence has passed since the last
#          cut and the version has closed rows (`release` in `notes projects --stats --json`), at
#          the bump notes derives, carrying open rows. A project never cut, or one a whole
#          cadence behind, waits for the backfill that splits its history by week.
#   build  a game with no tag of its own yet: left alone until its `<game>-vX.Y.Z` tags exist.
#
# A timer, not a git hook: tags are pushed from CI, other machines and while this box is off,
# and an event hook sees none of those. Comparing sheet to tags every pass catches them all.
#
# Usage:
#   agentctl-wave-roll                 # every project in every profile
#   agentctl-wave-roll <project>       # just one
#   agentctl-wave-roll --dry-run [p]   # print what would roll, write nothing
set -uo pipefail

DRY=0
if [ "${1:-}" = "--dry-run" ]; then DRY=1; shift; fi
ONE="${1:-}"

ROLL="${WAVE_ROLL_BIN:-$HOME/.local/bin/notes-roll}"
HOOKS="${WAVE_ROLL_HOOKS:-$HOME/.config/shared-hooks/project-name.sh}"
INBOX="${AGENTCTL_INBOX:-$HOME/.local/state/agentctl/wave-roll}"
mkdir -p "$INBOX"

# shellcheck source=/dev/null
. "$HOOKS" || { echo "wave-roll: cannot source $HOOKS" >&2; exit 1; }
project_release_lib || { echo "wave-roll: cannot load git-release.sh" >&2; exit 1; }
# Every project's cadence facts (`release`: due, backlog, bump) and `automation`, read once per pass.
STATS="$(notes projects --stats --json 2>/dev/null | jq -ce 'arrays' 2>/dev/null)" || STATS='[]'

is_ver() { [[ "$1" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; }
# has_sheet DIR: the project keeps a versioned working sheet, the rule `notes` uses for one
# (projects.rs sheet_path: a README.md with a Version: line, else a tasks.md). The list's
# second column is the index lane's link, which is summary.md for a whole profile (bnb), so
# it cannot say whether a sheet exists.
has_sheet() {
  [ -n "$1" ] || return 1
  grep -qE '^[[:space:]]*Version:[[:space:]]*v[0-9]+\.[0-9]+\.[0-9]+' "$1/README.md" 2>/dev/null || [ -f "$1/tasks.md" ]
}
patch_after() { local v="${1#v}"; printf 'v%s.%s.%s' "${v%%.*}" "$(cut -d. -f2 <<<"$v")" "$(( ${v##*.} + 1 ))"; }
minor_after() { local v="${1#v}"; printf 'v%s.%s.0' "${v%%.*}" "$(( $(cut -d. -f2 <<<"$v") + 1 ))"; }

# The version to open next: the first PLANNED version above the shipped tag, so a roadmap the
# human already laid out is what becomes current; else the patch after the tag. A planned
# version too far above the tag to be the next release is skipped, and said so.
next_after() { # $1=profile $2=project $3=shipped
  local v state
  while IFS=$'\t' read -r v state _; do
    [ "$state" = planned ] && is_ver "$v" && ! git_version_ge "$3" "$v" || continue
    if git_version_next_ok "$3" "$v"; then printf '%s' "$v"; return; fi
    log "skip planned version $v on $2: too far above tag $3 to be its next release" >&2
  done < <(notes --profile "$1" projects --roadmap "$2" 2>/dev/null)
  patch_after "$3"
}

log() {
  [ "$DRY" = 1 ] || printf '[%s] wave-roll: %s\n' "$(date -Is)" "$*" >> "$INBOX/activity.log"
  printf '%s\n' "$*"
}

# A tag reaches this clone only by fetch, so one pushed from CI or another machine stays
# invisible to `git tag` until someone fetches here, and the pass would never roll for it.
# Tags only (no branches, no working tree), once per repo per pass. A failed fetch still
# compares against the local tags: that answer is stale, never wrong about what it has seen.
declare -A FETCHED=()
fetched=0 fetch_failed=0
fetch_tags() { # $1=project
  local repo
  repo="$(project_repo_path "$1")"
  [ -n "$repo" ] && [ -d "$repo/.git" ] && [ -z "${FETCHED[$repo]:-}" ] || return 0
  FETCHED[$repo]=1
  fetched=$((fetched + 1))
  GIT_TERMINAL_PROMPT=0 timeout 60 git -C "$repo" fetch -q --no-write-fetch-head origin \
    'refs/tags/*:refs/tags/*' 2>/dev/null \
    || { fetch_failed=$((fetch_failed + 1)); log "fetch failed for $repo: comparing against local tags"; }
}

# roll PROFILE NAME LEVEL NEXT WHY [TAG]: one roll of the open version $ver through notes-roll
# at LEVEL (`auto` lets notes derive it), expected to open NEXT; logged, paged and counted.
# A dry run only says what it would do. 0 rolled (or would), 1 the roll failed.
rolled=0 recorded=0 failed=0
roll() {
  local profile="$1" name="$2" level="$3" next="$4" why="$5" tag="${6:-}" open out opened stale
  open="$(notes --profile "$profile" ptask "$name" list 2>/dev/null | grep -c . || true)"
  if [ "$DRY" = 1 ]; then
    printf 'would roll %s/%s: %s -> %s (%s, carry %s)\n' "$profile" "$name" "$ver" "$next" "$why" "$open"
    return 0
  fi
  if out="$("$ROLL" ${tag:+--tag "$tag"} "$profile" "$name" "$level" carry 2>&1 </dev/null)"; then
    rolled=$((rolled + 1))
    # The number notes opened, which for a cadence cut is the bump it derived on the freeze.
    opened="$(sed -n 's/^released [^:]*: v[0-9.]* -> \(v[0-9.]*\).*/\1/p' <<<"$out" | head -1)"
    next="${opened:-$next}"
    log "rolled $name $ver -> $next ($why, carried $open)"
    stale="$(grep -o 'stale (carried [0-9]*x): .*' <<<"$out" || true)"
    agent-notify -t "version released: $name" \
      "$name $ver closed by $why; $next is current, $open task(s) carried.${stale:+ Stale: $stale}"
  else
    failed=$((failed + 1))
    log "FAILED $name $ver -> $next: $(tail -3 <<<"$out" | tr '\n' ' ')"
    agent-notify -p high -t "release failed: $name" "$(tail -5 <<<"$out")"
    return 1
  fi
}

# record PROFILE NAME TAG: the note of a tag below the open version, with no planned rows.
record() {
  local profile="$1" name="$2" tag="$3" out
  if [ "$DRY" = 1 ]; then
    printf 'would record %s/%s: %s, no planned rows (sheet open at %s)\n' "$profile" "$name" "$tag" "$ver"
    return 0
  fi
  if out="$("$ROLL" --tag "$tag" "$profile" "$name" 2>&1 </dev/null)"; then
    recorded=$((recorded + 1))
    log "recorded $name $tag: no planned rows (sheet open at $ver)"
  else
    failed=$((failed + 1))
    log "FAILED to record $name $tag: $(tail -3 <<<"$out" | tr '\n' ' ')"
    agent-notify -p high -t "release note failed: $name $tag" "$(tail -5 <<<"$out")"
    return 1
  fi
}

# by_tag PROFILE NAME SHIPPED DIR: a tag owner's pass (header, `tag`). Each tag since
# RELEASE_NOTES_SINCE plus the newest, lowest first, so a version's rows freeze under the first
# tag that reached it. A failed roll ends the project's pass: later tags wait for the next one.
by_tag() {
  local profile="$1" name="$2" shipped="$3" dir="$4" tag next rolled_on=""
  local -A since=()
  while IFS= read -r tag; do [ -z "$tag" ] || since[$tag]=1; done < <(project_release_tags_since "$name" 2>/dev/null)
  while IFS= read -r tag; do
    # After a roll, the open version it left, read back so this tag compares against it.
    if [ -n "$rolled_on" ]; then
      ver="$(notes --profile "$profile" projects --version-of "$name" 2>/dev/null)"
      if ! is_ver "$ver"; then
        failed=$((failed + 1))
        log "FAILED $name: rolled on $rolled_on but cannot read its open version back ('$ver'); $tag and later wait"
        return 0
      fi
      rolled_on=""
    fi
    if git_version_ge "$tag" "$ver"; then
      next="$(next_after "$profile" "$name" "$tag")"
      roll "$profile" "$name" "$next" "$next" "tag $tag" "$tag" || return 0
      if [ "$DRY" = 1 ]; then ver="$next"; else rolled_on="$tag"; fi
    elif [ -n "${since[$tag]:-}" ] && [ ! -e "$dir/versions/$tag.md" ]; then
      record "$profile" "$name" "$tag" || return 0
    fi
  done < <(printf '%s\n' "${!since[@]}" "$shipped" | grep . | sort -uV)
}

while read -r profile; do
  # Whole lines: tab is IFS whitespace, so `read a b c d` collapses the empty third column.
  while IFS= read -r row; do
    name="${row%%$'\t'*}" ver="${row##*$'\t'}" sheet="$(cut -f2 <<<"$row")"
    [ -n "$name" ] || continue
    [ -z "$ONE" ] || [ "$name" = "$ONE" ] || continue
    st="$(jq -c --arg p "$profile" --arg n "$name" 'first(.[] | select(.profile == $p and .name == $n)) // {}' <<<"$STATS" 2>/dev/null)" || st='{}'
    # A profile with `automation = false` (client work tracked elsewhere) is no loop's to write.
    [ "$(jq -r '.automation != false' <<<"$st")" = true ] || continue
    fetch_tags "$name"
    shipped="$(project_release_version "$name" 2>/dev/null)"
    owner="$(project_version_owner "$name" "$shipped")"
    [ "$owner" != build ] || continue                # a game waits for its own tags
    if ! is_ver "$ver" || ! has_sheet "${sheet:+$(dirname "$sheet")}"; then
      [ "$owner" = sheet ] || log "skip $name: no versioned sheet (shipped $shipped)"
      continue
    fi
    if [ "$owner" = tag ]; then
      # A tag that is not vX.Y.Z (`v0.0.1-dev-baseline`) names no version to roll to.
      # Said on a dry run only: a real pass would log it every 30 minutes.
      if ! is_ver "$shipped"; then
        [ "$DRY" = 0 ] || printf 'skip %s: tag %s is not vX.Y.Z\n' "$name" "$shipped"
        continue
      fi
      by_tag "$profile" "$name" "$shipped" "$(dirname "$sheet")"
    else
      rel="$(jq -c '.release // {}' <<<"$st")"
      [ "$(jq -r '.due // false' <<<"$rel")" = true ] || continue
      if [ "$(jq -r '.backlog // false' <<<"$rel")" = true ]; then
        [ "$DRY" = 0 ] || printf 'backlog %s/%s: %s due since %s, more than one cadence of work: backfill it by week\n' \
          "$profile" "$name" "$ver" "$(jq -r .due_on <<<"$rel")"
        continue
      fi
      bump="$(jq -r '.bump // "patch"' <<<"$rel")"
      if [ "$bump" = minor ]; then next="$(minor_after "$ver")"; else next="$(patch_after "$ver")"; fi
      roll "$profile" "$name" auto "$next" "cadence $(jq -r .cadence_days <<<"$rel")d, $bump"
    fi
  done < <(notes --profile "$profile" projects 2>/dev/null)
done < <(notes config --profiles 2>/dev/null)

[ "$DRY" = 1 ] && exit 0
log "pass done: $rolled rolled, $recorded tag notes recorded, $failed failed, $fetch_failed of $fetched tag fetches failed"

# Publish a verdict, or the unit's PENDING is promoted to STALLED on stop and fleet-liveness
# reads every quiet pass as a stall. Every fetch failing is a stall in its own right: the pass
# ran blind to tags pushed from CI or another machine, so "nothing to roll" would be a guess.
# shellcheck source=/dev/null
. "${AGENT_PROOF_LIB:-$HOME/.local/lib/agent-proof.sh}" 2>/dev/null || true
if command -v proof_report >/dev/null 2>&1; then
  if [ "$failed" -gt 0 ]; then
    proof_outcome wave-roll STALLED "$failed roll(s) failed"
  elif [ "$fetched" -gt 0 ] && [ "$fetch_failed" = "$fetched" ]; then
    proof_outcome wave-roll STALLED "tag fetch failed for all $fetched repos: blind to remote tags"
  elif [ "$((rolled + recorded))" -gt 0 ]; then
    proof_report wave-roll WORKED "$rolled rolled, $recorded tag notes recorded"
  else
    detail="nothing to roll"
    [ "$fetch_failed" = 0 ] || detail+=" ($fetch_failed of $fetched tag fetches failed)"
    proof_report wave-roll NOOP "$detail"
  fi
fi
[ "$failed" = 0 ]
