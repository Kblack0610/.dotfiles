#!/usr/bin/env bash
# agentctl-wave-roll - a release tag closes its wave.
#
# For every project that ships (project_release_version non-empty), once the newest tag has
# reached the sheet's `Version:`, roll it: open tasks carry to the next wave, the finished
# wave freezes, and the next wave opens after the tag. Notes-only projects are left alone.
#
# A timer, not a git hook: tags are pushed from CI, other machines and while this box is off,
# and an event hook sees none of those. Comparing sheet to tags every pass catches them all.
#
# Usage:
#   agentctl-wave-roll                 # every project in every profile
#   agentctl-wave-roll <project>       # just one
#   agentctl-wave-roll --dry-run [p]   # print what would roll, write nothing
set -uo pipefail

DRY=0
if [ "${1:-}" = "--dry-run" ]; then DRY=1; shift; fi
ONE="${1:-}"

COCKPIT="${WAVE_ROLL_COCKPIT:-$HOME/.local/src/tmux/notes-cockpit.sh}"
HOOKS="${WAVE_ROLL_HOOKS:-$HOME/.config/shared-hooks/project-name.sh}"
INBOX="${AGENTCTL_INBOX:-$HOME/.local/state/agentctl/wave-roll}"
mkdir -p "$INBOX"

# shellcheck source=/dev/null
. "$HOOKS" || { echo "wave-roll: cannot source $HOOKS" >&2; exit 1; }

is_ver() { [[ "$1" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; }
# ver_ge A B: A >= B, both bare `vX.Y.Z`.
ver_ge() { [ "$(printf '%s\n%s\n' "${1#v}" "${2#v}" | sort -V | tail -1)" = "${1#v}" ]; }
patch_after() { local v="${1#v}"; printf 'v%s.%s.%s' "${v%%.*}" "$(cut -d. -f2 <<<"$v")" "$(( ${v##*.} + 1 ))"; }

# The version to open next: the first PLANNED wave above the shipped tag, so a roadmap the
# human already laid out is what becomes current; else the patch after the tag.
next_after() { # $1=profile $2=project $3=shipped
  local v state
  while IFS=$'\t' read -r v state _; do
    [ "$state" = planned ] && is_ver "$v" && ! ver_ge "$3" "$v" && { printf '%s' "$v"; return; }
  done < <(notes --profile "$1" projects --waves "$2" 2>/dev/null)
  patch_after "$3"
}

log() {
  [ "$DRY" = 1 ] || printf '[%s] wave-roll: %s\n' "$(date -Is)" "$*" >> "$INBOX/activity.log"
  printf '%s\n' "$*"
}

rolled=0 failed=0
while read -r profile; do
  # Whole lines: tab is IFS whitespace, so `read a b c d` collapses the empty third column.
  while IFS= read -r row; do
    name="${row%%$'\t'*}" ver="${row##*$'\t'}" sheet="$(cut -f2 <<<"$row")"
    [ -n "$name" ] || continue
    [ -z "$ONE" ] || [ "$name" = "$ONE" ] || continue
    shipped="$(project_release_version "$name" "$(dirname "$sheet")/summary.md" 2>/dev/null)"
    [ -n "$shipped" ] || continue                    # notes-only: the wave rolls its own patch
    if ! is_ver "$ver" || [ "$(basename "$sheet")" = summary.md ]; then
      log "skip $name: no versioned sheet (shipped $shipped)"
      continue
    fi
    ver_ge "$shipped" "$ver" || continue            # the open version has not shipped yet
    next="$(next_after "$profile" "$name" "$shipped")"
    open="$(notes --profile "$profile" ptask "$name" list 2>/dev/null | grep -c . || true)"

    if [ "$DRY" = 1 ]; then
      printf 'would roll %s/%s: %s -> %s (tag %s, carry %s)\n' "$profile" "$name" "$ver" "$next" "$shipped" "$open"
      continue
    fi
    # One writer per app: a running /wave owns the sheet. Skip, and the next pass retries.
    if ! wave-lock claim "$name" "wave-roll $ver -> $next" >/dev/null 2>&1; then
      log "skip $name: a wave holds the lock"
      continue
    fi
    if out="$("$COCKPIT" --roll-now "$profile" "$name" "$next" carry 2>&1)"; then
      rolled=$((rolled + 1))
      log "rolled $name $ver -> $next (tag $shipped, carried $open)"
      stale="$(grep -o 'stale (carried [0-9]*x): .*' <<<"$out" || true)"
      agent-notify -t "wave rolled: $name" \
        "$name $ver closed by tag $shipped; $next is current, $open task(s) carried.${stale:+ Stale: $stale}"
    else
      failed=$((failed + 1))
      log "FAILED $name $ver -> $next: $(tail -3 <<<"$out" | tr '\n' ' ')"
      agent-notify -p high -t "wave roll failed: $name" "$(tail -5 <<<"$out")"
    fi
    wave-lock release "$name" >/dev/null 2>&1 || true
  done < <(notes --profile "$profile" projects 2>/dev/null)
done < <(notes config --profiles 2>/dev/null)

[ "$DRY" = 1 ] || log "pass done: $rolled rolled, $failed failed"
[ "$failed" = 0 ]
