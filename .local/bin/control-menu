#!/usr/bin/env bash
# control-menu - every waybar chip's hover from the keyboard (Super+A Space, leader.conf).
#
#   control-menu                the menu: fzf, the chip list on the left, the selected chip's
#                               tooltip on the right; Enter is the chip's click, alt-Enter its
#                               right-click, ctrl-r re-reads the bar text, Esc closes
#   control-menu rows [--live]  the list: key, label, and with --live the chip's bar text
#   control-menu preview <key>  one chip's tooltip as terminal text
#   control-menu click <key> [left|right] [arg]   run a row: a chip's on-click (or
#                               on-click-right), a window row's bind, a hub row's popup
#   control-menu action <key> [left|right] [arg]  the fzf action for that click
#
# A click that opens a terminal window (`kitty --class C -e CMD`, and every hub row) runs CMD in
# this one instead, and its Esc or q comes back to the list: the dropdowns are walked from the
# keyboard without a window per click. Any other click (a GUI app, a URL, a toggle) is launched
# detached and the menu closes, because you are going there.
#
# It holds no list of its own. Which chips exist is modules.registry (key|label|ids); what each
# runs and what a click does is the waybar config (config.base, plus config.pin-full for the
# pin-only machines chip). A chip hidden from the bar (modules.sh) still lists, because the
# preview runs the command behind its `modules.sh gate <id>` prefix, not the gate. The window
# rows are the described exec binds (bindd/bindpd in keybindings.conf and leader.conf), read
# live from `hyprctl binds -j`, each with the chord that reaches it. The hub rows are `hub tabs`
# (hub-core's layout), each previewed with `hub --once --tab` and opened as a hub popup.

set -u

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/waybar"
HUB="${HUB:-$HOME/.local/bin/hub}"
REGISTRY="$CONF_DIR/modules.registry"
SELF="$(realpath "${BASH_SOURCE[0]}")"
# shellcheck source=../../.config/waybar/pango.sh
. "$CONF_DIR/pango.sh"

# The waybar config as one JSON object of module definitions. The files are JSONC; every
# comment in them is a whole line, so dropping those lines leaves JSON (a URL's // survives).
# control_menu.bats parses the real files, so a comment added mid-line fails there first.
config_json() {
    local f
    for f in "$CONF_DIR/config.base" "$CONF_DIR/config.pin-full"; do
        [ -r "$f" ] && sed '/^[[:space:]]*\/\//d' "$f"
    done | jq -s 'map(if type == "array" then add else . end) | add'
}

# registry rows: key<TAB>label<TAB>first module id
registry() {
    awk -F'|' '!/^[[:space:]]*(#|$)/ { split($3, ids, " "); printf "%s\t%s\t%s\n", $1, $2, ids[1] }' "$REGISTRY"
}

# field <module-id> <exec|on-click|on-click-right>, from the config JSON on stdin
field() { jq -r --arg m "$1" --arg f "$2" '.[$m][$f] // empty'; }

# The command behind the gate: `.../modules.sh gate <id> <cmd...>` is <cmd...>.
ungated() { sed -E 's#^.*modules\.sh gate [^ ]+ ##'; }

# run_exec <module-id>: the chip's JSON, or a reason on stderr and a non-zero exit.
run_exec() {
    local cmd
    cmd="$(config_json | field "$1" exec | ungated)"
    [ -n "$cmd" ] || { echo "no exec for $1 in the waybar config" >&2; return 3; }
    sh -c "$cmd"
}

# Every described exec bind as chord<TAB>description<TAB>arg. A leader leaf's chord is the
# path of submap entries that reach it (Super+A u t s); an Esc bind never counts as an entry.
windows() {
    hyprctl binds -j 2>/dev/null | jq -r '
        def bit($n): (. / $n | floor) % 2 == 1;
        def chord: [(.modmask | if bit(64) then "Super" else empty end, if bit(4) then "Ctrl" else empty end,
                     if bit(8) then "Alt" else empty end, if bit(1) then "Shift" else empty end),
                    (if .modmask > 0 and (.key | length) == 1 then .key | ascii_upcase else .key end)] | join("+");
        . as $all
        | def path($s; $depth):
            if $s == "" or $depth > 5 then ""
            else ([$all[] | select(.dispatcher == "submap" and .arg == $s and .submap != $s and .key != "escape")][0]) as $e
                 | if $e == null then "[\($s)]" else (path($e.submap; $depth + 1) + " " + ($e | chord)) end
            end;
        .[] | select(.has_description and .dispatcher == "exec")
        | [((path(.submap; 0) + " " + (if .submap == "" then chord else .key end)) | ltrimstr(" ")), .description, .arg]
        | @tsv'
}

hidden() { grep -qxF "$1" "${XDG_STATE_HOME:-$HOME/.local/state}/waybar/modules.off" 2>/dev/null; }

rows() {
    local live="${1:-}" key label id text n=0
    local conf tmp
    conf="$(config_json)"
    tmp="$(mktemp -d)"
    # --live asks every chip at once and waits for all of them: one slow chip (fleet_pulse's
    # curl) costs its own time, not the sum.
    if [ "$live" = --live ]; then
        while IFS=$'\t' read -r key label id; do
            n=$((n + 1))
            [ -n "$(field "$id" exec <<<"$conf")" ] &&
                (run_exec "$id" 2>/dev/null | jq -r '.text // empty' 2>/dev/null |
                    NO_COLOR=1 pango_ansi | tr '\n' ' ' >"$tmp/$n") &
        done < <(registry)
        wait
    fi
    n=0
    while IFS=$'\t' read -r key label id; do
        n=$((n + 1))
        if [ -z "$(field "$id" exec <<<"$conf")" ]; then
            text="(not in the waybar config: $id)"
        elif [ "$live" = --live ]; then
            text="$(cat "$tmp/$n" 2>/dev/null)"
            [ -n "$text" ] || text="-"
        else
            text=""
        fi
        hidden "$id" && text="$text (hidden on bar)"
        printf '%s\t%-9s %-34s %s\n' "$key" "$key" "$label" "$text"
    done < <(registry)
    rm -rf "$tmp"
    local id title question
    while IFS=$'\t' read -r id title question; do
        printf 'hub\t%-9s %-34s %s\t%s\n' hub "$title" "$question" "$id"
    done < <("$HUB" tabs 2>/dev/null)
    local chord desc arg
    while IFS=$'\t' read -r chord desc arg; do
        case "$arg" in */control-menu | */control-menu\ *) continue ;; esac # this menu, open already
        printf 'win\t%-9s %-34s %s\t%s\n' window "$desc" "$chord" "$arg"
    done < <(windows)
}

id_of() { registry | awk -F'\t' -v k="$1" '$1 == k { print $3; exit }'; }

preview() {
    local key="$1" id out rc err
    if [ "$key" = win ]; then
        printf 'enter runs this bind through hyprctl dispatch exec:\n\n%s\n' "${2:-}"
        return 0
    fi
    if [ "$key" = hub ]; then
        COLUMNS="${FZF_PREVIEW_COLUMNS:-80}" "$HUB" --once --tab "${2:-}" 2>&1
        printf '\nenter: hub --popup --tab %s\n' "${2:-}"
        return 0
    fi
    id="$(id_of "$key")"
    [ -n "$id" ] || { echo "no chip '$key' in $REGISTRY"; return 0; }
    err="$(mktemp)"
    out="$(run_exec "$id" 2>"$err")"
    rc=$?
    if [ "$rc" -ne 0 ] || [ -z "$out" ]; then
        echo "$id: exit $rc, no output"
        cat "$err"
    else
        jq -r '.tooltip // .text // empty' <<<"$out" | pango_ansi
    fi
    rm -f "$err"
    local conf left right
    conf="$(config_json)"
    left="$(field "$id" on-click <<<"$conf")"
    right="$(field "$id" on-click-right <<<"$conf")"
    echo
    echo "enter: ${left:-nothing}"
    [ -n "$right" ] && echo "alt-enter: $right"
    return 0
}

# command_of <key> <left|right> [arg]: the command a row's click runs, as written in its source.
command_of() {
    local id which=on-click
    case "$1" in
    win) printf '%s\n' "${3:-}" ;;
    hub) printf 'kitty --class floating-term -e %q --popup --tab %q\n' "$HUB" "${3:-}" ;;
    *)
        [ "${2:-}" = right ] && which=on-click-right
        id="$(id_of "$1")"
        config_json | field "$id" "$which"
        ;;
    esac
}

# in_place <command>: the CMD of `kitty --class C -e CMD`, the form every terminal dropdown
# takes in the waybar config and the binds; empty for anything else.
in_place() { sed -nE 's/^kitty --class [^ ]+ -e (.+)$/\1/p' <<<"$1"; }

click() {
    local cmd inner which=on-click
    [ "${2:-}" = right ] && which=on-click-right
    case "$1" in
    win) [ -n "${3:-}" ] || { echo "a window row needs its bind's arg" >&2; return 1; } ;;
    hub) [ -n "${3:-}" ] || { echo "a hub row needs its tab" >&2; return 1; } ;;
    esac
    cmd="$(command_of "$1" "${2:-left}" "${3:-}")"
    [ -n "$cmd" ] || { echo "$1 has no $which" >&2; return 1; }
    inner="$(in_place "$cmd")"
    if [ -n "$inner" ]; then
        sh -c "$inner"
        return 0
    fi
    if [ "$1" = win ]; then
        hyprctl dispatch exec "$cmd" >/dev/null
        return
    fi
    setsid -f sh -c "$cmd" >/dev/null 2>&1 </dev/null
}

# action <key> <left|right> [arg]: execute (come back to the list) for a click that runs in
# place, become (close) for one that goes elsewhere. The placeholders stay literal: fzf fills
# them in when it runs the action, so a bind's quotes never pass through this output.
action() {
    local verb=become
    [ -n "$(in_place "$(command_of "$1" "${2:-left}" "${3:-}")")" ] && verb=execute
    printf '%s(%q click {1} %s {3})\n' "$verb" "$SELF" "${2:-left}"
}

menu() {
    command -v fzf >/dev/null 2>&1 || { echo "control-menu needs fzf" >&2; exit 2; }
    # The first list is the registry alone, so the menu opens at once; the bar texts replace it
    # when every chip has answered (fleet_pulse can take its 8s curl timeout).
    rows | fzf --ansi --no-sort --layout=reverse --height=100% \
        --delimiter=$'\t' --with-nth=2 \
        --prompt='control> ' \
        --header='enter click (a dropdown opens here, esc comes back)   alt-enter right-click   ctrl-r refresh   esc close' \
        --preview="$SELF preview {1} {3}" --preview-window='right,60%,wrap' \
        --bind="start:reload($SELF rows --live)" \
        --bind="ctrl-r:reload($SELF rows --live)+refresh-preview" \
        --bind="enter:transform($SELF action {1} left {3})" \
        --bind="alt-enter:transform($SELF action {1} right {3})"
}

case "${1:-menu}" in
    menu) menu ;;
    rows) rows "${2:-}" ;;
    preview) preview "${2:?usage: control-menu preview <key> [arg]}" "${3:-}" ;;
    click) click "${2:?usage: control-menu click <key> [left|right] [arg]}" "${3:-}" "${4:-}" ;;
    action) action "${2:?usage: control-menu action <key> [left|right] [arg]}" "${3:-}" "${4:-}" ;;
    -h | --help) sed -n '2,23p' "$SELF" | sed 's/^# \{0,1\}//' ;;
    *) echo "usage: control-menu [rows [--live] | preview <key> [arg] | click|action <key> [left|right] [arg]]" >&2; exit 2 ;;
esac
