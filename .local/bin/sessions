#!/bin/bash
# sessions - list / resume / compact important Claude sessions from the
# agent-facing registry written by stop-post.d/80-session-register.sh.
#
#   sessions list [project] [--all] [-n N]   show registered sessions (newest first)
#   sessions live                            only the sessions running right now
#   sessions resume <id|prefix|--pick>       reopen a session (claude -r), cd'ing to its repo
#   sessions compact <id|prefix|--pick>      distill a transcript into a digest .md
#
# Registry: ~/.agent/sessions/{project}/sessions.jsonl (one JSON line/session).
# Live state: ~/.claude/sessions/<pid>.json, written by the Claude CLI itself -
# gives sessionId, cwd, name and busy/idle without any hook of ours.
# Agent axis only - nothing here touches ~/.notes/inbox.

set -uo pipefail

# Absolute path to this script - fzf's --preview re-invokes it, and $0 is not
# reliable there (relative invocation, symlink on PATH, shell function wrapper).
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

SESS_ROOT="$HOME/.agent/sessions"
LIVE_ROOT="$HOME/.claude/sessions"
PROJECTS_ROOT="$HOME/.claude/projects"
DEFAULT_LIMIT=25
TAB="$(printf '\t')"

command -v jq >/dev/null 2>&1 || { echo "sessions: jq is required" >&2; exit 1; }

# ---------------------------------------------------------------- helpers ---

resolve_project() {
  # Resolve the current project name the same way the hooks do.
  local dir="${1:-$PWD}"
  if [ -f "$HOME/.config/shared-hooks/project-name.sh" ]; then
    . "$HOME/.config/shared-hooks/project-name.sh"
    resolve_project_name "$dir"
  else
    local base="${dir##*/}"; echo "${base#.}"
  fi
}

_age() {
  # epoch -> compact relative age ("now", "9m", "3h", "2d", "5w")
  local then="${1:-0}" now diff
  now=$(date +%s)
  case "$then" in ''|*[!0-9]*) then=0 ;; esac
  diff=$(( now - then ))
  [ "$diff" -lt 0 ] && diff=0
  if   [ "$diff" -lt 60 ];     then echo "now"
  elif [ "$diff" -lt 3600 ];   then echo "$(( diff / 60 ))m"
  elif [ "$diff" -lt 86400 ];  then echo "$(( diff / 3600 ))h"
  elif [ "$diff" -lt 604800 ]; then echo "$(( diff / 86400 ))d"
  else                              echo "$(( diff / 604800 ))w"
  fi
}

term_width() {
  local w="${COLUMNS:-}"
  [ -n "$w" ] || w="$(tput cols 2>/dev/null)"
  case "$w" in ''|*[!0-9]*) w=100 ;; esac
  [ "$w" -lt 60 ] && w=60
  echo "$w"
}

# Emit registry lines. $1 = project name, or "--all".
registry_lines() {
  if [ "${1:-}" = "--all" ]; then
    find "$SESS_ROOT" -mindepth 2 -maxdepth 2 -name sessions.jsonl -print0 2>/dev/null \
      | xargs -0 cat 2>/dev/null
  else
    cat "$SESS_ROOT/$1/sessions.jsonl" 2>/dev/null
  fi
}

live_lines() {
  # tsv: id \t status \t name \t cwd \t startedAt \t pid  (one per running Claude)
  #
  # Empty fields are emitted as "-" on purpose. TAB counts as IFS whitespace in
  # bash, so `read` collapses runs of it and an empty middle field would silently
  # shift every later field left (cwd landing in name, etc).
  find "$LIVE_ROOT" -maxdepth 1 -name '*.json' -print0 2>/dev/null \
    | xargs -0 -r jq -rc '
        select(.sessionId != null)
        | [ .sessionId,
            (.status // "live"),
            (if (.nameSource // "") == "derived" then "-" else (.name // "-") end),
            (.cwd // "-"),
            (((.startedAt // 0) / 1000) | floor | tostring),
            ((.pid // 0) | tostring) ]
        | map(if . == "" then "-" else . end) | @tsv' 2>/dev/null || true
  # Never fail. These files are created and removed as sessions start and stop,
  # so one can vanish between the find and the jq. Under `set -o pipefail` that
  # surfaces as a spurious non-zero exit in whatever called us - including the
  # fzf preview, which re-runs on every keystroke.
}

_unsentinel() { [ "${1:-}" = "-" ] && echo "" || echo "${1:-}"; }

# Populate LIVE_STATUS / LIVE_NAME keyed by session id.
declare -A LIVE_STATUS=() LIVE_NAME=() LIVE_START=() LIVE_CWD=()
load_live() {
  local id st nm cwd started
  while IFS="$TAB" read -r id st nm cwd started; do
    [ -n "$id" ] || continue
    LIVE_STATUS["$id"]="$st"
    LIVE_NAME["$id"]="$(_unsentinel "$nm")"
    LIVE_START["$id"]="$started"
    LIVE_CWD["$id"]="$(_unsentinel "$cwd")"
  done < <(live_lines)
}

live_marker() {
  # $1 = session id -> a short, aligned live indicator.
  # Statuses come from the Claude CLI: busy = mid-turn, waiting = sitting at the
  # prompt wanting input from you, idle = open but not waiting on anything.
  case "${LIVE_STATUS[${1:-}]:-}" in
    busy)    printf '* busy' ;;
    waiting) printf 'o wait' ;;
    idle)    printf 'o idle' ;;
    '')      printf '' ;;
    *)       printf 'o live' ;;
  esac
}

rows_tsv() {
  # tsv: id \t updated_epoch \t edits \t project \t transcript \t first_prompt
  # (newest first). Empty fields become "-" - see live_lines for why.
  registry_lines "$1" \
    | jq -rc '[.session_id, (.updated|tostring), (.edits|tostring), .project,
               (.transcript // "-"),
               (.first_prompt // "" | gsub("[\\n\\t\\r]+"; " ") | gsub("  +"; " "))]
              | map(if . == "" then "-" else . end) | @tsv' 2>/dev/null \
    | sort -t"$TAB" -k2,2nr
}

ai_title() {
  # $1 = transcript path -> the session's own rolling AI title, or "".
  # Claude Code writes an `ai-title` record into the transcript as a session
  # goes, so every session already has a human-readable name - including closed
  # ones, where the live <pid>.json is long gone. Read from the end and stop at
  # the first hit: ~20ms even on an 8MB transcript.
  local t="${1:-}"
  [ -n "$t" ] && [ -f "$t" ] || return 0
  tac "$t" 2>/dev/null | grep -m1 '"type":"ai-title"' 2>/dev/null \
    | jq -rc '.aiTitle // empty' 2>/dev/null
}

transcript_path() {
  # $1 = session id -> its transcript, registered or not.
  local id="$1" t
  t="$(lookup_field "$id" transcript)"
  [ -n "$t" ] && [ -f "$t" ] && { printf '%s\n' "$t"; return; }
  find "$PROJECTS_ROOT" -maxdepth 2 -name "${id}.jsonl" -print -quit 2>/dev/null
}

resolve_id() {
  # $1 = full id or unique prefix -> prints the full id, or fails with a message.
  local want="$1" matches n
  matches=$(registry_lines --all | jq -rc '.session_id' 2>/dev/null | sort -u | grep -i "^${want}")
  # A live session may not be registered yet (registration happens on Stop).
  if [ -z "$matches" ]; then
    matches=$(live_lines | cut -f1 | sort -u | grep -i "^${want}")
  fi
  # Sessions that made no file edit are never registered at all - and a session
  # killed before it got going is exactly the one you most need to pick back up.
  # Fall back to the transcripts on disk.
  if [ -z "$matches" ]; then
    matches=$(find "$PROJECTS_ROOT" -maxdepth 2 -name "${want}*.jsonl" 2>/dev/null \
      | while read -r f; do b="${f##*/}"; printf '%s\n' "${b%.jsonl}"; done | sort -u)
  fi
  n=$(printf '%s\n' "$matches" | grep -c .)
  if [ "$n" -eq 0 ]; then
    echo "sessions: no session matching '$want'" >&2; return 1
  elif [ "$n" -gt 1 ]; then
    echo "sessions: '$want' is ambiguous - matches $n sessions:" >&2
    printf '%s\n' "$matches" | sed 's/^/  /' >&2
    return 1
  fi
  printf '%s\n' "$matches"
}

lookup_field() {
  # $1 = session id, $2 = jq field -> first match across registries
  registry_lines --all \
    | jq -rc --arg id "$1" --arg f "$2" 'select(.session_id==$id) | .[$f]' 2>/dev/null | head -1
}

session_cwd() {
  # $1 = session id -> best-effort working directory for that session.
  local id="$1" cwd t
  # 1. A live session tells us directly.
  cwd=$(live_lines | awk -F"$TAB" -v i="$id" '$1==i {print $4; exit}')
  cwd="$(_unsentinel "$cwd")"
  [ -n "$cwd" ] && [ -d "$cwd" ] && { echo "$cwd"; return; }
  # 2. Otherwise the transcript records cwd on its first few entries.
  t=$(transcript_path "$id")
  if [ -n "$t" ] && [ -f "$t" ]; then
    cwd=$(head -40 "$t" 2>/dev/null | jq -rc 'select(.cwd != null) | .cwd' 2>/dev/null | head -1)
    [ -n "$cwd" ] && [ -d "$cwd" ] && { echo "$cwd"; return; }
  fi
  echo ""
}

# ------------------------------------------------------------------- list ---

cmd_list() {
  local scope="" showall=false limit="$DEFAULT_LIMIT" liveonly=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --all)     showall=true ;;
      --live)    liveonly=true ;;
      -n)        shift; limit="${1:-$DEFAULT_LIMIT}" ;;
      -n*)       limit="${1#-n}" ;;
      --limit=*) limit="${1#--limit=}" ;;
      *)         scope="$1" ;;
    esac
    shift
  done
  case "$limit" in ''|*[!0-9]*) limit="$DEFAULT_LIMIT" ;; esac

  local key
  if [ "$showall" = true ]; then key="--all"
  elif [ -n "$scope" ]; then key="$scope"
  else key="$(resolve_project)"; fi

  load_live

  local rows
  rows=$(rows_tsv "$key")
  if [ -z "$rows" ]; then
    echo "No registered sessions for '${key}'." >&2
    return 0
  fi

  # Column widths. WHAT gets whatever is left over.
  local width proj_w what_w
  width=$(term_width)
  if [ "$showall" = true ]; then proj_w=14; else proj_w=0; fi
  # 8 id + 2 + 6 age + 2 + 5 edits + 2 + 6 live + 2 (+ proj + 2)
  what_w=$(( width - 8 - 2 - 6 - 2 - 5 - 2 - 6 - 2 - 1 ))
  [ "$proj_w" -gt 0 ] && what_w=$(( what_w - proj_w - 2 ))
  [ "$what_w" -lt 20 ] && what_w=20

  if [ "$proj_w" -gt 0 ]; then
    printf '%-8s  %-6s  %5s  %-6s  %-*s  %s\n' "ID" "AGE" "EDITS" "LIVE" "$proj_w" "PROJECT" "WHAT"
  else
    printf '%-8s  %-6s  %5s  %-6s  %s\n' "ID" "AGE" "EDITS" "LIVE" "WHAT"
  fi

  # A session is only written to the registry when it Stops, so one that started
  # this minute is running but unregistered. For the live view that is exactly the
  # row you care about, so synthesise it from the live state instead of dropping it.
  if [ "$liveonly" = true ]; then
    local lid
    for lid in "${!LIVE_STATUS[@]}"; do
      grep -q "^${lid}${TAB}" <<< "$rows" && continue
      rows+="$(printf '\n%s\t%s\t%s\t%s\t%s\t%s' \
        "$lid" "${LIVE_START[$lid]:-0}" "-" \
        "$(resolve_project "${LIVE_CWD[$lid]:-$PWD}")" "-" "(running, not registered yet)")"
    done
    rows=$(printf '%s\n' "$rows" | grep -v '^$' | sort -t"$TAB" -k2,2nr)
  fi

  local shown=0 total=0
  while IFS="$TAB" read -r id updated edits project transcript prompt; do
    [ -n "$id" ] || continue
    local mark; mark="$(live_marker "$id")"
    if [ "$liveonly" = true ] && [ -z "$mark" ]; then continue; fi
    total=$(( total + 1 ))
    [ "$shown" -ge "$limit" ] && continue
    shown=$(( shown + 1 ))

    # What this session was about, best name first: the name it set for itself,
    # then its own AI title, then the raw opening prompt.
    local what="${LIVE_NAME[$id]:-}"
    [ -n "$what" ] || what="$(ai_title "$(_unsentinel "$transcript")")"
    [ -n "$what" ] || what="$prompt"
    [ -n "$what" ] || what="(no prompt recorded)"
    if [ "${#what}" -gt "$what_w" ]; then
      what="${what:0:$(( what_w - 3 ))}..."
    fi

    if [ "$proj_w" -gt 0 ]; then
      printf '%-8s  %-6s  %5s  %-6s  %-*s  %s\n' \
        "${id:0:8}" "$(_age "$updated")" "$edits" "$mark" "$proj_w" "$project" "$what"
    else
      printf '%-8s  %-6s  %5s  %-6s  %s\n' \
        "${id:0:8}" "$(_age "$updated")" "$edits" "$mark" "$what"
    fi
  done <<< "$rows"

  if [ "$liveonly" != true ] && [ "$total" -gt "$shown" ]; then
    local hint=''
    [ "$showall" = true ] || hint=' or --all for every project'
    printf '\n  %d more - `sessions list -n %d`%s\n' "$(( total - shown ))" "$total" "$hint" >&2
  fi
}

# ------------------------------------------------------------------ index ---
#
# A searchable card per session, built by `claude-recall cards`. The point is
# the ai-title HISTORY: Claude rewrites a session's title as its subject drifts,
# so one session accumulates several, and searching any of them finds it. The
# gsuite session is reachable by "email" (its first title), "gsuite" (its third)
# and "aerc" (its current one).
#
# Columns: id project updated mtime cwd branch title titles_all
#          first_prompt last_prompt files prs

INDEX="$SESS_ROOT/index.tsv"
RECALL="${CLAUDE_RECALL:-claude-recall}"

index_mtime_floor() {
  # Newest mtime already in the index - the watermark for an incremental pass.
  [ -f "$INDEX" ] || { echo 0; return; }
  cut -f4 "$INDEX" 2>/dev/null | sort -n | tail -1 | grep -E '^[0-9]+$' || echo 0
}

cmd_index() {
  local rebuild=false
  for a in "$@"; do case "$a" in --rebuild|-r) rebuild=true ;; esac; done
  command -v "$RECALL" >/dev/null 2>&1 || {
    echo "sessions: $RECALL not found (needed to build the index)" >&2; return 1; }
  mkdir -p "$SESS_ROOT" 2>/dev/null || true

  local tmp; tmp="$(mktemp "${TMPDIR:-/tmp}/sessions-index.XXXXXX")" || return 1
  if [ "$rebuild" = true ] || [ ! -f "$INDEX" ]; then
    "$RECALL" cards > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
    mv "$tmp" "$INDEX"
    printf 'indexed %s sessions (full build)\n' "$(wc -l < "$INDEX")" >&2
    return 0
  fi

  # Incremental: card only what changed, then keep the newest row per id.
  local floor; floor="$(index_mtime_floor)"
  "$RECALL" cards --since-mtime "$floor" > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
  local fresh; fresh="$(wc -l < "$tmp")"
  if [ "${fresh:-0}" -gt 0 ]; then
    # New rows first, so awk's first-seen-wins keeps them over the stale ones.
    cat "$tmp" "$INDEX" | awk -F'\t' '!seen[$1]++' > "$tmp.merged" \
      && mv "$tmp.merged" "$INDEX"
  fi
  rm -f "$tmp" "$tmp.merged" 2>/dev/null || true
  printf 'refreshed %s session(s)\n' "${fresh:-0}" >&2
}

index_rows() {
  # Ensure an index exists, refresh it cheaply, then emit it newest-first.
  if [ ! -f "$INDEX" ]; then
    printf 'sessions: building the index for the first time, one moment...\n' >&2
    cmd_index >/dev/null 2>&1 || return 1
  else
    cmd_index >/dev/null 2>&1 || true
  fi
  sort -t"$TAB" -k4,4nr "$INDEX" 2>/dev/null
}

# ---------------------------------------------------------------- preview ---

cmd_preview() {
  # Everything here is read straight out of the transcript and the registry -
  # no model call, so it is safe to run on every keystroke in the picker.
  # `sessions compact` remains the explicit, on-demand LLM escalation.
  local want="${1:-}"; [ -n "$want" ] || return 0
  local id; id="$(resolve_id "$want" 2>/dev/null)" || { echo "no such session: $want"; return 0; }

  load_live
  local t proj edits head title dir branch mark
  t="$(transcript_path "$id")"
  proj="$(lookup_field "$id" project)"
  edits="$(lookup_field "$id" edits)"
  head="$(lookup_field "$id" head_commit)"
  title="${LIVE_NAME[$id]:-}"
  [ -n "$title" ] || title="$(ai_title "$t")"
  [ -n "$title" ] || title="$(lookup_field "$id" first_prompt)"

  dir="$(session_cwd "$id")"
  # Unregistered sessions carry no project or edit count; derive what we can.
  [ -n "$proj" ] || proj="$([ -n "$dir" ] && resolve_project "$dir")"
  [ -n "$edits" ] || edits="? (never registered - no file edits)"
  mark="$(live_marker "$id")"

  printf '%s\n' "${title:-(untitled)}"
  printf '%s  %s  %s\n' "${id:0:8}" "${proj:-?}" "${mark:-closed}"

  # Last recorded branch, not the first - a session that started on main and
  # branched should show where it ended up.
  [ -n "$t" ] && [ -f "$t" ] && branch="$(tac "$t" 2>/dev/null \
    | grep -m1 -o '"gitBranch":"[^"]\+"' 2>/dev/null | sed 's/.*:"//;s/"$//')"
  printf '%s' "${dir/#$HOME/\~}"
  [ -n "${branch:-}" ] && printf '  [%s]' "$branch"
  printf '\n'
  [ -n "$head" ] && printf '%s\n' "$head"
  printf '\n'

  if [ -n "$t" ] && [ -f "$t" ]; then
    local lastask
    lastask="$(tac "$t" 2>/dev/null | grep -m1 '"type":"last-prompt"' \
      | jq -rc '.lastPrompt // empty' 2>/dev/null | tr '\n' ' ' | cut -c1-400)"
    [ -n "$lastask" ] && printf 'LAST ASK\n  %s\n\n' "$lastask"

    local prs
    prs="$(grep -o '"prUrl":"[^"]*"' "$t" 2>/dev/null | sed 's/.*:"//;s/"$//' | sort -u | head -6)"
    if [ -n "$prs" ]; then
      printf 'PRs OPENED\n'; printf '%s\n' "$prs" | sed 's/^/  /'; printf '\n'
    fi

    local files nfiles
    files="$(grep -o '"trackingPath":"[^"]*"' "$t" 2>/dev/null | sed 's/.*:"//;s/"$//' | sort -u)"
    nfiles="$(printf '%s' "$files" | grep -c . || true)"
    if [ "${nfiles:-0}" -gt 0 ]; then
      printf 'FILES TOUCHED (%s)\n' "$nfiles"
      printf '%s\n' "$files" | head -10 | while read -r p; do printf '  %s\n' "${p/#$HOME/\~}"; done
      [ "$nfiles" -gt 10 ] && printf '  ... %s more\n' "$(( nfiles - 10 ))"
      printf '\n'
    fi
  fi

  printf 'EDITS %s\n' "${edits:-0}"
  local digest="$SESS_ROOT/${proj:-x}/${id}-digest.md"
  if [ -f "$digest" ]; then
    printf '\nDIGEST\n'; sed 's/^/  /' "$digest" | head -30
  else
    printf 'For a written summary: sessions compact %s\n' "${id:0:8}"
  fi
  return 0
}

# ----------------------------------------------------------------- search ---

cmd_filter() {
  # $1 = query (may be empty) -> "id \t rendered row" for every matching session.
  #
  # fzf runs this on every keystroke via `reload`, with its own matcher disabled,
  # so that typing searches the WHOLE card (title history, first and last prompt,
  # touched files, project, branch) while the list stays a tidy fixed-width table.
  # Terms are ANDed and case-insensitive: "voice home" narrows to both.
  local q="${*:-}"
  load_live
  local live_ids=""
  local k; for k in "${!LIVE_STATUS[@]}"; do live_ids+="${k} "; done

  index_rows | awk -F"$TAB" -v q="$q" -v now="$(date +%s)" -v live="$live_ids" '
    function age(t,   d) {
      d = now - t; if (d < 0) d = 0
      if (d < 60)     return "now"
      if (d < 3600)   return int(d/60) "m"
      if (d < 86400)  return int(d/3600) "h"
      if (d < 604800) return int(d/86400) "d"
      return int(d/604800) "w"
    }
    BEGIN {
      nq = split(tolower(q), terms, /[ \t]+/)
      split(live, L, " "); for (i in L) if (L[i] != "") islive[L[i]] = 1
    }
    {
      # $1 id, $2 project, $4 mtime, $6 branch, $7 title, $8 titles_all,
      # $9 first_prompt, $10 last_prompt, $11 files
      hay = tolower($1 " " $2 " " $6 " " $8 " " $9 " " $10 " " $11)
      for (i = 1; i <= nq; i++) if (terms[i] != "" && index(hay, terms[i]) == 0) next
      what = ($7 != "-" && $7 != "") ? $7 : $9
      mark = (($1 in islive) ? "o live" : "")
      printf "%s\t%-8.8s  %-5s  %-6s  %-13.13s  %s\n", $1, $1, age($4), mark, $2, what
    }'
}

cmd_search() {
  # Contract, deliberately predictable:
  #   sessions search            -> the live fzf window (the point of the feature)
  #   sessions search <term>     -> a plain table, scriptable and testable
  #   sessions search -i <term>  -> the window, pre-seeded with <term>
  local interactive=false q="" window=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -w|--window)      window="--window" ;;
      -i|--interactive) interactive=true ;;
      *) q="${q:+$q }$1" ;;
    esac
    shift
  done
  [ -n "$q" ] || interactive=true
  # Piping or no fzf always means the table, whatever was asked for.
  [ -t 1 ] || interactive=false
  command -v fzf >/dev/null 2>&1 || interactive=false

  if [ "$interactive" != true ]; then
    local out; out="$(cmd_filter "$q" | cut -f2-)"
    if [ -z "$out" ]; then
      printf 'No sessions matched %s.\n\nFor a full-text sweep of every message:\n  %s search %s\n' \
        "'${q}'" "$RECALL" "'${q}'" >&2
      return 0
    fi
    printf '%-8s  %-5s  %-6s  %-13s  %s\n' "ID" "AGE" "LIVE" "PROJECT" "WHAT"
    printf '%s\n' "$out"
    return 0
  fi

  local id
  id=$(cmd_filter "$q" | fzf \
        --delimiter="$TAB" --with-nth=2.. \
        --disabled --query="$q" \
        --bind="change:reload('$SELF' _filter {q})" \
        --bind='?:toggle-preview' \
        --bind="ctrl-g:execute($RECALL search {q} --limit 40 2>&1 | \${PAGER:-less} -R)" \
        --prompt="session> " --header='enter resume | ctrl-g full-text | ? preview' \
        --preview="'$SELF' _preview {1}" \
        --preview-window='right,55%,border-left,wrap' \
      | cut -f1)
  [ -n "$id" ] || return 0
  cmd_resume ${window:+"$window"} "$id"
}

# ------------------------------------------------------------------- pick ---

pick_id() {
  # fzf-pick a session id from all registries; prints the full id.
  command -v fzf >/dev/null 2>&1 || { echo "sessions: fzf not installed" >&2; return 1; }
  load_live
  local rows="" id updated edits project transcript prompt what
  while IFS="$TAB" read -r id updated edits project transcript prompt; do
    [ -n "$id" ] || continue
    what="${LIVE_NAME[$id]:-}"
    [ -n "$what" ] || what="$(ai_title "$(_unsentinel "$transcript")")"
    [ -n "$what" ] || what="$prompt"
    rows+="$(printf '%s\t%-8s  %-5s  %-6s  %-12s  %s' \
      "$id" "${id:0:8}" "$(_age "$updated")" "$(live_marker "$id")" "$project" "$what")"$'\n'
  done <<< "$(rows_tsv --all)"
  printf '%s' "$rows" | fzf --with-nth=2.. --delimiter="$TAB" \
      --prompt="session> " \
      --preview="'$SELF' _preview {1}" \
      --preview-window='right,55%,border-left,wrap' \
      --bind='?:toggle-preview' \
    | cut -f1
}

# ----------------------------------------------------------------- resume ---

_ppid_of() {
  # /proc/PID/stat field 4 is unreliable: the comm field is parenthesised and may
  # contain spaces, which shifts every later field. status(5) is unambiguous.
  awk '/^PPid:/ {print $2; exit}' "/proc/${1:-0}/status" 2>/dev/null
}

session_window() {
  # $1 = session id -> "tmux_session:window_index" if a live pane owns it.
  # The Claude process is a child of the pane's shell, so walk up the ppid chain
  # until we land on a known pane_pid.
  local id="$1" pid p i panes
  [ -n "${TMUX:-}" ] || return 0
  pid=$(live_lines | awk -F"$TAB" -v i="$id" '$1==i {print $6; exit}')
  [ -n "$pid" ] || return 0
  panes="$(tmux list-panes -a -F '#{pane_pid} #{session_name}:#{window_index}' 2>/dev/null)" || return 0
  p="$pid"
  for i in 1 2 3 4 5 6 7 8; do
    [ -n "$p" ] && [ "$p" != 0 ] && [ "$p" != 1 ] || return 0
    local hit; hit="$(printf '%s\n' "$panes" | awk -v q="$p" '$1==q {print $2; exit}')"
    [ -n "$hit" ] && { printf '%s\n' "$hit"; return 0; }
    p="$(_ppid_of "$p")"
  done
}

cmd_resume() {
  local id="" new_window=false
  for a in "$@"; do
    case "$a" in
      --window|-w) new_window=true ;;
      --pick)      id="$(pick_id)" || return 1 ;;
      *)           id="$(resolve_id "$a")" || return 1 ;;
    esac
  done
  [ -n "$id" ] || { echo "usage: sessions resume [--window] <id|prefix|--pick>" >&2; return 1; }

  load_live
  if [ -n "${LIVE_STATUS[$id]:-}" ]; then
    # Already running. Two panes appending to one transcript interleave badly, so
    # never open a second - but jumping to the pane that already has it is what
    # you actually wanted.
    local win; win="$(session_window "$id")"
    if [ -n "$win" ]; then
      tmux select-window -t "$win" 2>/dev/null
      tmux switch-client -t "${win%%:*}" 2>/dev/null
      echo "sessions: $id is already open - switched to $win" >&2
      return 0
    fi
    echo "sessions: $id is already open (${LIVE_STATUS[$id]}) but I can't find its pane." >&2
    echo "          'claude -r $id --fork-session' branches a new session from it." >&2
    return 1
  fi

  local dir; dir="$(session_cwd "$id")"

  # From the tmux popup, exec'ing here would trap a full Claude session inside a
  # transient popup - closing it would kill the session. Open a real window.
  if [ "$new_window" = true ] && [ -n "${TMUX:-}" ]; then
    tmux new-window ${dir:+-c "$dir"} "claude -r '$id'" 2>/dev/null \
      && return 0
    echo "sessions: could not open a tmux window, resuming here instead" >&2
  fi

  if [ -n "$dir" ]; then
    cd "$dir" || echo "sessions: could not cd to $dir, resuming from $PWD" >&2
  fi
  exec claude -r "$id"
}

# ---------------------------------------------------------------- compact ---

cmd_compact() {
  local id=""
  for a in "$@"; do
    case "$a" in
      --pick) id="$(pick_id)" || return 1 ;;
      *)      id="$(resolve_id "$a")" || return 1 ;;
    esac
  done
  [ -n "$id" ] || { echo "usage: sessions compact <id|prefix|--pick>" >&2; return 1; }
  local t proj; t="$(lookup_field "$id" transcript)"; proj="$(lookup_field "$id" project)"
  [ -n "$t" ] && [ -f "$t" ] || { echo "sessions: no transcript for $id" >&2; return 1; }
  [ -n "$proj" ] || proj="$(resolve_project)"
  command -v claude >/dev/null 2>&1 || { echo "sessions: claude CLI not found" >&2; return 1; }

  local out_dir="$SESS_ROOT/$proj"
  local out="$out_dir/${id}-digest.md"
  mkdir -p "$out_dir" 2>/dev/null || true

  echo "Compacting session $id -> $out" >&2
  local prompt
  prompt="Read the Claude Code session transcript at $t (JSONL, one message per line). \
Write a concise digest to $out with these markdown sections: \
'# Session digest ${id}', '## What happened', '## Files touched', '## Key decisions', '## Next step'. \
Plain ASCII only, no em dashes, no emoji. Keep it under ~40 lines. Overwrite the file if it exists."
  claude -p "$prompt" >/dev/null 2>&1 \
    && echo "Digest written: $out" >&2 \
    || echo "sessions: compact run failed (see claude output)" >&2
}

# ------------------------------------------------------------------ usage ---

usage() {
  cat >&2 <<'EOF'
sessions - list / resume / compact important Claude sessions

  sessions search [-i] [-w] [term]         live fzf window over every session
  sessions list [project] [--all] [-n N]   registered sessions, newest first
  sessions live                            only what is running right now
  sessions show <id|prefix>                where that session got to
  sessions index [--rebuild]               refresh the search index
  sessions resume [-w] <id|prefix|--pick>  reopen a session, cd'ing to its repo
  sessions compact <id|prefix|--pick>      distill a transcript into a digest .md

Ids are matched by prefix, so the 8-char ID column is enough:
  sessions resume d950ba9f

`search` with no term opens the window; with a term it prints a table instead,
so it is scriptable. Typing searches each session's whole card - every AI title
it has carried, its first and last prompt, the files it touched, project and
branch - which is why "email" finds the session that now goes by "aerc-nested-
folders-config". In the window: enter resumes, ctrl-g escalates the query to a
full-text sweep, '?' toggles the preview.

-w/--window opens the chosen session in a NEW tmux window rather than in place.
That is what `prefix R` uses: exec'ing inside a display-popup would trap a live
Claude session in a transient popup, and closing it would kill the session.
Picking a session that is ALREADY running never opens a second copy - it jumps
to the window that has it.

--pick opens an fzf picker with `show` rendered alongside it; '?' toggles it.

LIVE column: '* busy' = mid-turn, 'o wait'/'o idle' = open, blank = closed.
WHAT column: the session's own name or AI title, else its first prompt. Titles
are read from the transcript, so closed sessions have them too.

`show` is read straight from the transcript - no model call. For a written
summary, `sessions compact <id>` is the explicit LLM escalation.

Registry:    ~/.agent/sessions/{project}/sessions.jsonl
Live state:  ~/.claude/sessions/<pid>.json
Index:       ~/.agent/sessions/index.tsv  (built by `claude-recall cards`)
EOF
}

sub="${1:-list}"; shift 2>/dev/null || true
case "$sub" in
  list)          cmd_list "$@" ;;
  live)          cmd_list --all --live "$@" ;;
  search)        cmd_search "$@" ;;
  index)         cmd_index "$@" ;;
  _filter)       cmd_filter "$@" ;;
  _window)       session_window "$(resolve_id "${1:-}" 2>/dev/null)" ;;
  show|_preview) cmd_preview "$@" ;;
  resume)        cmd_resume "$@" ;;
  compact)       cmd_compact "$@" ;;
  -h|--help|help) usage ;;
  *) echo "sessions: unknown command '$sub'" >&2; usage; exit 1 ;;
esac
