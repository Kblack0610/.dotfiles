#!/usr/bin/env bash
# release-state - what is pinned and what is live on every project's deploy channels.
#
#   release-state refresh [project...]   probe the targets, write the snapshot (a subset merges)
#   release-state show [--json] [project] the snapshot, exceptions first
#   release-state check [--grace MIN] [--max-age MIN]
#                                         exit 1 naming each drift past grace (default 30), a
#                                         floating prod target, or a snapshot older than max-age
#                                         (default 60); the links between stores (a missing
#                                         telemetry watch among them): hub releases check
#   release-state changelog [--json|--list] <project> [tag]
#                                         what a tag shipped (default: the newest release): its
#                                         CHANGELOG.md section, else the merged PRs since the
#                                         release before it; --list names every tag to pick from
#   release-state released <project> <sha>...
#                                         per commit, one JSON line: the first tag of the project's
#                                         line that holds it and when that tag was made
#
# Declared targets live in project-map.json `trackers.<p>.targets`; pinned is read from the
# fetched remote branch or, for a store channel, the newest recorded deploy; live from the
# cluster, health endpoint or store API; deploy history from the GitHub Deployments named after
# the target id, and a failed probe says `unknown`, never the last good value. Schema and
# statuses: docs/operations/release-state.md.
set -uo pipefail

PROJECT_NAME_LIB="${PROJECT_NAME_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../../.config/shared-hooks/project-name.sh}"
# shellcheck source=../../.config/shared-hooks/project-name.sh
. "$PROJECT_NAME_LIB"
# shellcheck source=../lib/agent-proof.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/agent-proof.sh"
# shellcheck source=../lib/origin-repo.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/origin-repo.sh"
# shellcheck source=../lib/store-auth.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/store-auth.sh"
NAME=release-state   # the runner refresh publishes under, never an inherited AGENTCTL_NAME

STATE_DIR="${RELEASE_STATE_DIR:-$HOME/.agent/releases}"
STATE="$STATE_DIR/state.json"
WATCH_DIR="${WATCH_DIR:-$HOME/.agent/watches}"
WATCH_STATE_DIR="${WATCH_STATE_DIR:-$HOME/.local/state/watch-companion}"
KUBECTL="${KUBECTL:-kubectl}"
# Timeout guard on every external call (git fetch, kubectl, curl), in seconds.
PROBE_TIMEOUT="${RELEASE_PROBE_TIMEOUT:-20}"
# Most merged-PR lines a tag's changelog lists when it has no CHANGELOG.md section.
CHANGELOG_LINES=100
# How many deployments a row keeps: what the opened row lists, and how far back PREV can look.
DEPLOY_HISTORY=10
# How many tags a project's release history keeps, newest first.
HISTORY_TAGS=20
# How many PRs a tag in that history names at most: the first tag of a line spans all history before it.
HISTORY_PRS=500
# The read-only store credentials: one rbw entry per store, each a single line. Never the release
# keys the upload workflows use. Formats: docs/operations/release-state.md, "Store credentials".
RBW_STEAM=release_state_steam
RBW_PLAY=release_state_play
RBW_ASC=release_state_asc
# How far back GetAppBuilds looks for the build a branch is on.
STEAM_BUILDS=50
STEAM_API=https://partner.steam-api.com/ISteamApps
PLAY_API=https://androidpublisher.googleapis.com/androidpublisher/v3
ASC_API=https://api.appstoreconnect.apple.com/v1
# Set once by store_credentials, before the probes' subshells: the value, or why there is none.
STEAM_KEY="" STEAM_WHY="" PLAY_TOKEN="" PLAY_WHY="" ASC_JWT="" ASC_WHY=""
# One call per target. The REST list has no status on it, which would be one more call per row.
DEPLOY_QUERY='query($owner: String!, $name: String!, $env: String!, $n: Int!) {
  repository(owner: $owner, name: $name) {
    deployments(environments: [$env], first: $n, orderBy: {field: CREATED_AT, direction: DESC}) {
      nodes { createdAt description commitOid payload ref { name } latestStatus { state logUrl createdAt } }
    }
  }
}'

# One call per app repo: the newest Deployments' environments, for link_facts.
ENV_QUERY='query($owner: String!, $name: String!) {
  repository(owner: $owner, name: $name) {
    deployments(first: 100, orderBy: {field: CREATED_AT, direction: DESC}) { nodes { environment description } }
  }
}'
# What makes a workflow file a deploy for link_facts: its name, or a step that ships (a recorded
# Deployment, a store upload, a cluster or gitops change, an image push). One that matches and is
# not a deploy is declared so in the registry's `deployWorkflows`, with why.
DEPLOY_NAMES='deploy|release|publish|promote|submit|steam|upload|rollout'
DEPLOY_MARKERS='record-deployment|steamcmd|upload-google-play|upload-app|altool|fastlane|kubectl (set image|rollout|apply)|helm upgrade|flux reconcile|home-config|docker push|build-push-action|wrangler'

# REFRESH_WHY (set by cmd_refresh) is where a dying pass leaves its reason for the outcome line;
# the first die keeps it, so a caller's die does not hide the inner one that caused it.
die() {
  echo "release-state: $*" >&2
  [ -n "${REFRESH_WHY:-}" ] && [ ! -s "$REFRESH_WHY" ] && printf '%s' "$*" > "$REFRESH_WHY"
  exit 2
}
usage() { sed -n '4,17p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-2}"; }
now_epoch() { date +%s; }

command -v jq >/dev/null 2>&1 || die "jq is not installed"

MAP="$(project_map_file)"

# targets_json -> one JSON object per line: {project, target}, implicit release rows included.
targets_json() {
  local only="${1:-}"
  [ -f "$MAP" ] || die "no registry at $MAP"
  project_machine_profile >/dev/null
  jq -c --arg only "$only" --arg m "$PROJECT_MACHINE_PROFILE" --slurpfile reg "$MAP" "$PROJECT_VISIBLE_JQ"'
    (.trackers // {}) | to_entries[]
    | select(.value | type == "object")
    | .key as $p
    | select($p | visible($m))
    | select($only == "" or ($only | split(" ") | index($p)))
    | if (.value.targets | type) == "array" and (.value.targets | length) > 0
      then .value.targets[] | {project: $p, target: .}
      elif .value.type == "app"
      then {project: $p, target: {id: $p, channel: "release", implicit: true, pinned: {tag: true}}}
      else empty end' "$MAP"
}

# repo_dir <repo-key> -> the checkout path for a registry repo key, or "".
repo_dir() { project_repo_path "$1"; }

# Fetch each repo's branch once per refresh. A failed fetch is remembered so every target on
# that repo reports unknown instead of reading a remote-tracking ref of unknown age.
declare -A FETCHED=()
fetch_branch() {
  local dir="$1" branch="$2" k="$1@$2"
  if [ -z "${FETCHED[$k]:-}" ]; then
    if timeout "$PROBE_TIMEOUT" git -C "$dir" fetch -q origin "$branch" </dev/null >/dev/null 2>&1; then
      FETCHED[$k]=ok
    else
      FETCHED[$k]=fail
    fi
  fi
  [ "${FETCHED[$k]}" = ok ]
}

# The branch name only: a clone whose origin/HEAD points at another remote's ref
# (home-config's reads forgejo/master) still names the branch origin fetches.
default_branch() {
  local dir="$1" b
  b="$(git -C "$dir" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)"
  printf '%s' "${b#*/}"
}

# pinned <project> <target-json> <deploys-json> <release-tag> -> {value, source, error}
pinned() {
  local proj="$1" t="$2" d="$3" tag="$4" repo path key image branch dir blob v="" deployed
  deployed="$(jq -r '.pinned.deployed // false' <<<"$t")"
  if [ "$deployed" = manual ]; then
    # A channel moved by hand (Steam's public branch is set in Steamworks): nothing records a
    # deploy there, so the pin is the reason the registry gives and live is the only fact.
    jq -c '{value: null, source: "manual", reason: (.pinned.reason // null)}' <<<"$t"
    return
  fi
  if [ "$deployed" = true ]; then
    # No file pins a store channel: the tag is chosen when it ships, so the pin is what the
    # newest successful upload said it put there. Source none is a channel nothing has recorded.
    jq -c 'if .error then {value: null, source: "github deployments", error: "deploy history unreadable"}
           else [.history[] | select(.state == "ok")][0] as $d
             | if $d.version then {value: $d.version, source: "github deployments", build: $d.build}
               else {value: null, source: "none"} end
           end' <<<"$d"
    return
  fi
  if [ "$(jq -r '.pinned.tag // false' <<<"$t")" = true ]; then
    if [ -n "$tag" ]; then
      jq -nc --arg v "$tag" '{value: $v, source: "newest release tag"}'
    else
      jq -nc '{value: null, source: "newest release tag", error: "no release tag"}'
    fi
    return
  fi
  repo="$(jq -r '.pinned.repo // empty' <<<"$t")"
  path="$(jq -r '.pinned.path // empty' <<<"$t")"
  key="$(jq -r '.pinned.key // empty' <<<"$t")"
  image="$(jq -r '.pinned.image // empty' <<<"$t")"
  [ -n "$repo" ] && [ -n "$path" ] || { jq -nc '{value: null, error: "pinned needs repo and path, or tag"}'; return; }
  dir="$(repo_dir "$repo")"
  [ -n "$dir" ] && [ -d "$dir/.git" ] || { jq -nc --arg r "$repo" '{value: null, error: "no checkout for repo \($r)"}'; return; }
  branch="$(jq -r '.pinned.branch // empty' <<<"$t")"
  [ -n "$branch" ] || branch="$(project_field "$repo" branch)"
  [ -n "$branch" ] || branch="$(default_branch "$dir")"
  [ -n "$branch" ] || branch=main
  local src="$repo:origin/$branch:$path"
  fetch_branch "$dir" "$branch" || { jq -nc --arg s "$src" '{value: null, source: $s, error: "fetch failed"}'; return; }
  blob="$(git -C "$dir" show "origin/$branch:$path" 2>/dev/null)" \
    || { jq -nc --arg s "$src" '{value: null, source: $s, error: "file not on branch"}'; return; }
  v="$(pin_value "$blob" "$image" "${key:-tag}")"
  if [ -z "$v" ]; then
    jq -nc --arg s "$src" --arg k "${image:-${key:-tag}}" '{value: null, source: $s, error: "no \($k) in file"}'
    return
  fi
  # When the pin took this value: the newest commit on the branch that changed how often the
  # value appears in the file, and the value the file held just before it. That is the date the
  # gitops PR merged, not the moment the cluster applied it.
  # -S also hits a commit that moved another pin holding the same string (two images in one
  # file), so the newest hit whose parent pinned something else for THIS key is the one.
  local hit at="" was=""
  while read -r hit; do
    blob="$(git -C "$dir" show "${hit%% *}^:$path" 2>/dev/null)" || blob=""
    was="$(pin_value "$blob" "$image" "${key:-tag}")"
    [ "$was" = "$v" ] && continue
    at="${hit#* }"
    break
  done < <(git -C "$dir" log --format='%H %ct' -S"$v" "origin/$branch" -- "$path" 2>/dev/null)
  [ -n "$at" ] || was=""
  jq -nc --arg v "$v" --arg s "$src" --arg at "$at" --arg was "$was" \
    '{value: $v, source: $s, at: ($at | tonumber? // null), prev: (if $was == "" then null else $was end)}'
}

# pin_value <file-text> <image> <key> -> the version a gitops file pins, or "".
pin_value() {
  local blob="$1" image="$2" key="$3" v
  if [ -n "$image" ]; then
    # A kustomize `images:` override (`- name: <image>` then `newTag:`) wins over the
    # `image: <image>:<tag>` it rewrites, as it does when kustomize builds the manifest.
    v="$(awk -v img="$image" '
      /^[[:space:]]*-[[:space:]]*name:/ { n = $0; sub(/^[[:space:]]*-[[:space:]]*name:[[:space:]]*/, "", n); gsub(/"/, "", n); on = (n == img); next }
      on && /^[[:space:]]*newTag:/ { t = $0; sub(/^[[:space:]]*newTag:[[:space:]]*/, "", t); gsub(/"/, "", t); sub(/[[:space:]].*/, "", t); print t; exit }
      /^[^[:space:]-]/ { on = 0 }' <<<"$blob")"
    [ -n "$v" ] || v="$(grep -Eo "image:[[:space:]]*\"?${image//./\\.}:[^\"[:space:]]+" <<<"$blob" | head -1 | sed -E 's/.*:([^:]+)$/\1/')"
  else
    v="$(grep -E "^[[:space:]-]*${key}:[[:space:]]*" <<<"$blob" | head -1 \
      | sed -E "s/^[[:space:]-]*${key}:[[:space:]]*\"?([^\"[:space:]#]+).*/\1/")"
  fi
  printf '%s' "$v"
}

play_credentials() {
  store_google_token "$RBW_PLAY" https://www.googleapis.com/auth/androidpublisher
  PLAY_TOKEN="$STORE_TOKEN" PLAY_WHY="$STORE_WHY"
}

asc_credentials() {
  store_asc_jwt "$RBW_ASC"
  ASC_JWT="$STORE_TOKEN" ASC_WHY="$STORE_WHY"
}

# store_credentials <targets> -> read once what these targets need. Runs in the main shell because
# each probe is a subshell.
store_credentials() {
  local kinds
  kinds="$(jq -r '.target.live | objects | keys[]' <<<"$1" 2>/dev/null | sort -u)"
  grep -qxE 'steam|play|testflight' <<<"$kinds" || return 0
  if ! store_rbw_ready; then
    STEAM_WHY="$STORE_WHY" PLAY_WHY="$STORE_WHY" ASC_WHY="$STORE_WHY"
    return 0
  fi
  if grep -qx steam <<<"$kinds"; then
    STEAM_KEY="$(rbw_read "$RBW_STEAM")"
    [ -n "$STEAM_KEY" ] || STEAM_WHY="no rbw entry $RBW_STEAM"
  fi
  grep -qx play <<<"$kinds" && play_credentials
  grep -qx testflight <<<"$kinds" && asc_credentials
  return 0
}

probe_failed() { jq -nc --arg s "$1" --arg e "$2" '{value: null, source: $s, error: $e}'; }

# bare_version <text> -> x.y.z when the text is only a version, optionally with "(build)"; a
# store that keeps no tag can be compared on that much and no more.
bare_version() { sed -nE 's/^v?([0-9]+\.[0-9]+\.[0-9]+)( \(.*\))?$/\1/p' <<<"$1"; }

# live_steam: the branch's BuildID, named by the tag stage.sh writes in that build's description
# ("<build> <tag> <sha>"). A build with no such description shows its BuildID.
live_steam() {
  local t="$1" app branch src betas builds bid desc v
  app="$(jq -r '.live.steam.app' <<<"$t")"
  branch="$(jq -r '.live.steam.branch' <<<"$t")"
  src="steam $app/$branch"
  [ -n "$STEAM_KEY" ] || { probe_failed "$src" "$STEAM_WHY"; return; }
  betas="$(store_get "$STEAM_API/GetAppBetas/v1/?key=$STEAM_KEY&appid=$app")" \
    || { probe_failed "$src" "steam GetAppBetas failed"; return; }
  bid="$(jq -r --arg b "$branch" '.response.betas[$b].BuildID // empty' <<<"$betas" 2>/dev/null)"
  [ -n "$bid" ] || { probe_failed "$src" "no branch $branch on the app"; return; }
  builds="$(store_get "$STEAM_API/GetAppBuilds/v1/?key=$STEAM_KEY&appid=$app&count=$STEAM_BUILDS")" \
    || { probe_failed "$src" "steam GetAppBuilds failed"; return; }
  jq -e --arg b "$bid" '.response.builds | has($b)' <<<"$builds" >/dev/null 2>&1 \
    || { probe_failed "$src" "build $bid is not in the last $STEAM_BUILDS builds"; return; }
  desc="$(jq -r --arg b "$bid" '.response.builds[$b].Description // empty' <<<"$builds")"
  v="$(tr ' ' '\n' <<<"$desc" | grep -E '^v?[0-9]+\.' | head -1)"
  jq -nc --arg v "${v:-$bid}" --arg b "$bid" --arg s "$src" '{value: $v, build: $b, source: $s}'
}

# live_play: the release on the track with the highest version code that users can get. Reads the
# edit-free tracks.releases list: an open edit could invalidate an upload running at the same time.
live_play() {
  local t="$1" pkg track src body rel v
  pkg="$(jq -r '.live.play.package' <<<"$t")"
  track="$(jq -r '.live.play.track' <<<"$t")"
  src="play $pkg/$track"
  [ -n "$PLAY_TOKEN" ] || { probe_failed "$src" "$PLAY_WHY"; return; }
  body="$(store_get "$PLAY_API/applications/$pkg/tracks/$track/releases" "$PLAY_TOKEN")" \
    || { probe_failed "$src" "play releases request failed"; return; }
  rel="$(jq -c '[.releases[]? | select(.releaseLifecycleState == "RELEASE_LIFECYCLE_STATE_PUBLISHED")
    | . + {code: ([.activeArtifacts[]?.versionCode | tonumber] | max)}] | max_by(.code) // empty' <<<"$body" 2>/dev/null)"
  [ -n "$rel" ] || { probe_failed "$src" "nothing published on the track"; return; }
  v="$(jq -r '.releaseName // empty' <<<"$rel")"
  [ -n "$v" ] || { probe_failed "$src" "published release has no name"; return; }
  jq -nc --arg v "$v" --arg b "$(jq -r '.code // empty' <<<"$rel")" --arg s "$src" --arg ver "$(bare_version "$v")" \
    '{value: $v, build: $b, source: $s} + (if $ver == "" then {} else {version: $ver} end)'
}

# live_testflight: the newest processed iOS build. TestFlight keeps no tag, only the marketing
# version and a build number.
live_testflight() {
  local t="$1" app src body ver build
  app="$(jq -r '.live.testflight.app' <<<"$t")"
  src="testflight $app"
  [ -n "$ASC_JWT" ] || { probe_failed "$src" "$ASC_WHY"; return; }
  body="$(store_get "$ASC_API/builds?filter[app]=$app&filter[processingState]=VALID&filter[expired]=false&filter[preReleaseVersion.platform]=IOS&sort=-uploadedDate&limit=1&include=preReleaseVersion" "$ASC_JWT")" \
    || { probe_failed "$src" "app store connect request failed"; return; }
  build="$(jq -r '.data[0].attributes.version // empty' <<<"$body" 2>/dev/null)"
  ver="$(jq -r '[.included[]? | select(.type == "preReleaseVersions")][0].attributes.version // empty' <<<"$body" 2>/dev/null)"
  [ -n "$build" ] && [ -n "$ver" ] || { probe_failed "$src" "no processed build"; return; }
  jq -nc --arg v "$ver ($build)" --arg ver "$ver" --arg b "$build" --arg s "$src" '{value: $v, version: $ver, build: $b, source: $s}'
}

# live <target-json> -> {value, sha, source, error}
live() {
  local t="$1" ctx ns dep ctr img url field body v
  case "$(jq -r '.live | objects | keys[0] // empty' <<<"$t" 2>/dev/null)" in
    steam) live_steam "$t"; return ;;
    play) live_play "$t"; return ;;
    testflight) live_testflight "$t"; return ;;
  esac
  if jq -e '.live.k8s' <<<"$t" >/dev/null 2>&1; then
    ctx="$(jq -r '.live.k8s.context' <<<"$t")"
    ns="$(jq -r '.live.k8s.namespace' <<<"$t")"
    dep="$(jq -r '.live.k8s.deployment' <<<"$t")"
    ctr="$(jq -r '.live.k8s.container // empty' <<<"$t")"
    local src="k8s $ctx $ns/$dep"
    local jp='{.spec.template.spec.containers[0].image}'
    [ -n "$ctr" ] && jp="{.spec.template.spec.containers[?(@.name==\"$ctr\")].image}"
    if ! img="$(timeout "$PROBE_TIMEOUT" "$KUBECTL" --context "$ctx" -n "$ns" get deploy "$dep" -o jsonpath="$jp" </dev/null 2>/dev/null)" || [ -z "$img" ]; then
      jq -nc --arg s "$src" '{value: null, source: $s, error: "kubectl get failed"}'
      return
    fi
    if [[ "$img" == *@sha256:* ]]; then
      v="sha256:${img##*@sha256:}"; v="${v:0:19}"
    elif [[ "${img##*/}" == *:* ]]; then
      v="${img##*:}"
    else
      v=latest
    fi
    jq -nc --arg v "$v" --arg s "$src" --arg i "$img" '{value: $v, source: $s, image: $i}'
  elif jq -e '.live.health' <<<"$t" >/dev/null 2>&1; then
    url="$(jq -r '.live.health.url' <<<"$t")"
    field="$(jq -r '.live.health.field // "commit"' <<<"$t")"
    if ! body="$(curl -fsS --max-time "$PROBE_TIMEOUT" "$url" 2>/dev/null)"; then
      jq -nc --arg s "$url" '{value: null, source: $s, error: "health request failed"}'
      return
    fi
    v="$(jq -r --arg f "$field" '.[$f] // empty' <<<"$body" 2>/dev/null)"
    if [ -n "$v" ]; then
      jq -nc --arg v "$v" --arg s "$url" '{value: $v, sha: $v, source: $s}'
    else
      jq -nc --arg s "$url" --arg f "$field" '{value: null, source: $s, error: "health has no \($f) field"}'
    fi
  else
    jq -nc '{value: null, source: "none"}'
  fi
}

# sha_is_tag <project> <target-json> <sha> <tag> -> 0 when the served commit IS the pinned tag.
sha_is_tag() {
  local repo dir tsha
  repo="$(jq -r '.pinned.repo // empty' <<<"$2")"
  [ -n "$repo" ] || repo="$(project_repo_name "$1")"
  dir="$(repo_dir "$repo")"
  [ -n "$dir" ] || return 1
  tsha="$(git -C "$dir" rev-parse -q --verify "$4^{commit}" 2>/dev/null)" || return 1
  [[ "$tsha" == "$3"* ]] || [[ "$3" == "$tsha"* ]]
}

# deploys_none <source> [error] -> a channel with no history to show.
deploys_none() {
  jq -nc --arg s "$1" --arg e "${2:-}" '{source: $s, error: ($e | if . == "" then null else . end), history: [], prev: null, last: null}'
}

# deploys <project> <target-json> -> {source, error, history, prev, last}.
# The workflow that deploys a target records a GitHub Deployment whose environment is the target
# id, whose description is the version, whose ref is the commit it shipped (`sha`) and whose
# payload may carry the store's build number (`build`). last is the newest finished one, whatever its result;
# prev is the newest version that succeeded before the one now succeeded.
deploys() {
  local proj="$1" t="$2" id slug out read_ok
  if [ "$(jq -r '.implicit // false' <<<"$t")" = true ]; then
    deploys_none none
    return
  fi
  slug="$(origin_repo "$(repo_dir "$proj")" github.com)" || slug=""
  if [ -z "$slug" ]; then
    deploys_none none
    return
  fi
  id="$(jq -r '.id' <<<"$t")"
  if ! out="$(timeout "$PROBE_TIMEOUT" gh api graphql -f query="$DEPLOY_QUERY" -f owner="${slug%%/*}" -f name="${slug##*/}" \
      -f env="$id" -F n="$DEPLOY_HISTORY" </dev/null 2>/dev/null)"; then
    deploys_none "$slug" "gh api failed"
    return
  fi
  # Captured, so a jq that dies part way never leaves a half answer beside the error row.
  if ! read_ok="$(jq -c --arg s "$slug" '
    def blank: if . == "" then null else . end;
    def word: ascii_downcase | if . == "success" then "ok" elif . == "failure" or . == "error" then "fail" else . end;
    [.data.repository.deployments.nodes[] | {
      version: ((.description | blank) // .ref.name // .commitOid[0:8]),
      state: ((.latestStatus.state // "pending") | word),
      at: ((.latestStatus.createdAt // .createdAt) | fromdate),
      url: (.latestStatus.logUrl | blank),
      sha: (.commitOid | blank),
      build: ((.payload // "" | fromjson? | objects | .build | values | tostring | blank) // null)
    }] as $h
    | [$h[] | select(.state == "ok")] as $ok
    | {source: $s, error: null, history: $h,
       prev: ([$ok[] | select(.version != $ok[0].version)][0].version),
       last: ([$h[] | select(.state == "ok" or .state == "fail")][0])}' <<<"$out" 2>/dev/null)" || [ -z "$read_ok" ]; then
    deploys_none "$slug" "unreadable answer"
    return
  fi
  printf '%s' "$read_ok"
}

# history <project> -> {line, glob, repo, error, tags}: the project's tags, newest first, at most
# HISTORY_TAGS, each {tag, version, sha, at, prev, prs}. line is `release` for its own release family
# (tagGlob or git-release.sh's ladder), `build` when it has none yet and the registry's
# `buildTags` names its per-build tags, `none` when neither has a tag. at is git's creatordate
# (a lightweight tag's commit date, a lower bound); prev is git_prev_tag, the same range the
# changelog reads. repo is the checkout's origin as the PR store keys it (owner/repo, host/owner/repo
# off GitHub); prs are the PR numbers in prev..tag, read from the squash subjects as the changelog
# is. Raw facts only: which channel shipped a tag, and each PR's row, are hub_core::release_graph's joins.
history() {
  local proj="$1" repo glob line=release tags="" t p sha_at out="[]" name host path
  if ! project_tag_scope "$proj"; then
    jq -nc '{line: "none", glob: null, repo: null, error: "no checkout", tags: []}'
    return
  fi
  repo="$_PTS_REPO"
  path="$(project_field "$proj" path)"
  name="$(origin_repo "$repo" || true)"; host="$(origin_host "$repo" || true)"
  [ -z "$name" ] || [ -z "$host" ] || [ "$host" = github.com ] || name="$host/$name"
  glob="$(_gr_glob "$repo" "$proj" "$_PTS_SCOPED" "$_PTS_GLOB")"
  [ -n "$glob" ] && tags="$(git_tags "$repo" "$proj" "$_PTS_SCOPED" "$glob")"
  if [ -z "$tags" ] && [ -n "$_PTS_BUILDS" ]; then
    line=build glob="$_PTS_BUILDS"
    tags="$(git_tags "$repo" "$proj" "$_PTS_SCOPED" "$glob")"
    # Several build families (barrage, shapecity) have no common version order: newest by date, then version.
    [ -n "$tags" ] && tags="$(git -C "$repo" for-each-ref --sort=-v:refname --sort=-creatordate --format='%(refname:short)' refs/tags |
      grep -Fxf <(printf '%s\n' "$tags"))"
  fi
  if [ -z "$tags" ]; then
    jq -nc --arg g "$glob" --arg r "$name" '{line: "none", glob: (if $g == "" then null else $g end),
      repo: (if $r == "" then null else $r end), error: null, tags: []}'
    return
  fi
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    sha_at="$(git_tag_at "$repo" "$t")"
    p="$(git_prev_tag "$repo" "$proj" "$_PTS_SCOPED" "$glob" "$t")"
    out="$(jq -c --arg t "$t" --arg v "$(git_tag_version "$t")" --arg sa "$sha_at" --arg p "$p" \
      --arg prs "$(git_tag_changes "$repo" "$p" "$t" "$path" "$HISTORY_PRS")" '
      ($sa | split(" ")) as $f
      | . + [{tag: $t, version: $v, sha: ($f[0] // null), at: ($f[1] // "" | tonumber? // null),
              prev: (if $p == "" then null else $p end),
              prs: [$prs | split("\n")[] | [scan("\\(#([0-9]+)\\)")] | last // empty | .[0] | tonumber]}]' <<<"$out")"
  done < <(head -n "$HISTORY_TAGS" <<<"$tags")
  jq -nc --arg l "$line" --arg g "$glob" --arg r "$name" --argjson tags "$out" \
    '{line: $l, glob: $g, repo: (if $r == "" then null else $r end), error: null, tags: $tags}'
}

# telemetry <target-json> -> [{watch, state, since}]; state OK|TRIP|pending|missing.
telemetry() {
  local t="$1" w st since out="[]"
  while IFS= read -r w; do
    [ -n "$w" ] || continue
    if [ ! -f "$WATCH_DIR/$w.yaml" ]; then
      st=missing; since=""
    else
      st="$(cat "$WATCH_STATE_DIR/$w.state" 2>/dev/null || true)"
      st="${st:-pending}"
      since="$(cat "$WATCH_STATE_DIR/$w.since" 2>/dev/null || true)"
    fi
    out="$(jq -c --arg w "$w" --arg s "$st" --arg since "$since" \
      '. + [{watch: $w, state: $s, since: (if $since == "" then null else ($since | tonumber? // null) end)}]' <<<"$out")"
  done < <(jq -r '.telemetry // [] | .[]' <<<"$t")
  printf '%s' "$out"
}

# row <project> <target-json> <previous-state-json> <release-tag> -> one snapshot row. The tag
# is the project's newest shipped one (project_release_tag), read once per project by the caller.
row() {
  local proj="$1" t="$2" prev="$3" tag="$4" p l d status tel id drift_since="" now
  id="$(jq -r '.id' <<<"$t")"
  d="$(deploys "$proj" "$t")"
  p="$(pinned "$proj" "$t" "$d" "$tag")"
  l="$(live "$t")"
  tel="$(telemetry "$t")"
  now="$(now_epoch)"
  local pv lv lsrc psrc lver pb lb
  pv="$(jq -r '.value // empty' <<<"$p")"
  psrc="$(jq -r '.source // empty' <<<"$p")"
  lver="$(jq -r '.version // empty' <<<"$l")"
  lv="$(jq -r '.value // empty' <<<"$l")"
  lsrc="$(jq -r '.source // empty' <<<"$l")"
  pb="$(jq -r '.build // empty' <<<"$p")"
  lb="$(jq -r '.build // empty' <<<"$l")"
  if [ -z "$pv" ] && [ "$(jq -r '.implicit // false' <<<"$t")" = true ]; then
    status=unreleased
  elif [ -z "$pv" ] && { { [ "$psrc" = none ] && [ -n "$lv" ]; } ||
         { [ "$psrc" = manual ] && { [ -n "$lv" ] || [ "$lsrc" = none ]; }; }; }; then
    # A store channel no upload has been recorded for, with live known, or one moved by hand
    # whose live is known or not probed: there is nothing to hold live to.
    status=released
  elif [ -z "$pv" ] || { [ "$lsrc" != none ] && [ -z "$lv" ]; }; then
    status=unknown
  elif [ "$pv" = latest ] || [ "$lv" = latest ]; then
    status=floating
  elif [ "$lsrc" = none ]; then
    status=released
  elif [ -n "$pb" ] && [ -n "$lb" ]; then
    # The upload recorded the store's build number and the store reports one (TestFlight, Play,
    # Steam's BuildID): the build decides, since two builds of one version are two deploys and
    # the version alone would call the older one live.
    if [ "$pb" = "$lb" ]; then status=ok; else status=drift; fi
  elif [ "$pv" = "$lv" ]; then
    status=ok
  elif [ -n "$(jq -r '.sha // empty' <<<"$l")" ] && sha_is_tag "$proj" "$t" "$lv" "$pv"; then
    status=ok
  elif [ -n "$lver" ] && [ "$(grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' <<<"$pv" | head -1)" = "$lver" ]; then
    status=ok
  else
    status=drift
  fi
  if [ "$status" = drift ]; then
    # Carry the start of a drift across refreshes, so check can tell a rollout in progress
    # from one that stalled.
    # A build-decided drift is a new one when either build moves, though the versions do not.
    drift_since="$(jq -r --arg id "$id" --arg pv "$pv" --arg lv "$lv" --arg pb "$pb" --arg lb "$lb" \
      '.rows // [] | map(select(.id == $id and .status == "drift" and .pinned.value == $pv and .live.value == $lv
         and (.pinned.build // "" | tostring) == $pb and (.live.build // "" | tostring) == $lb)) | .[0].drift_since // empty' <<<"$prev")"
    drift_since="${drift_since:-$now}"
  fi
  jq -nc --arg proj "$proj" --argjson t "$t" --argjson p "$p" --argjson l "$l" --argjson d "$d" --argjson tel "$tel" \
    --arg status "$status" --arg tag "$tag" --arg ds "$drift_since" --argjson now "$now" '{
      project: $proj, id: $t.id, channel: ($t.channel // "release"), where: ($t.where // null),
      implicit: ($t.implicit // false), tag: (if $tag == "" then null else $tag end),
      pinned: $p, live: $l, deploys: $d, status: $status,
      drift_since: (if $ds == "" then null else ($ds | tonumber) end),
      telemetry: $tel, deps: ($t.deps // []), probed_at: $now }'
}

# stage_facts <state-file> <labs-file> -> {stages: {project: {stage, rungs, needs}}}: what each
# registered project's lab stage asks of its deploys (~/.local/src/docs/stages.md, "The ladder").
# A live target serves the rung the registry's `channels` maps its channel to; `rungs` are the
# rungs served, low to high (the stage gate's rows read them against the stage being checked, so
# a project with no stage yet has them too), `needs` the rungs from alpha up to the stage nothing
# serves (game and app only: infra deploys by stow or Flux). A target above the stage is fine: a
# deploy is not the app being live, so the stage never caps where it deploys. `stage` is null when
# the lab sheet names none on the ladder, and then nothing is needed. The rung order is
# `notes projects --stages`. When notes cannot say, `stages` is empty and `stages_error` says why.
stage_facts() {
  local state="$1" labs="$2" ladder
  ladder="$(notes projects --stages 2>/dev/null)"
  [ -n "$ladder" ] || { jq -n '{stages: {}, stages_error: "notes projects --stages printed nothing"}'; return; }
  jq -e 'type == "array"' >/dev/null 2>&1 <"$labs" \
    || { jq -n '{stages: {}, stages_error: "notes projects --stats --json did not answer"}'; return; }
  project_machine_profile >/dev/null
  jq --slurpfile st "$state" --arg ladder "$ladder" --arg m "$PROJECT_MACHINE_PROFILE" \
    --slurpfile reg "$MAP" "$PROJECT_VISIBLE_JQ"'
    . as $labs | ($st[0].rows) as $rows
    | ($ladder | split(" ") | map(select(. != ""))) as $L
    | ($L | to_entries | map({key: .value, value: .key}) | from_entries) as $rank
    | ($reg[0].channels // {}) as $ch
    | ($labs | map({key: .name, value: (.stage // "")}) | from_entries) as $at
    | {ladder: $L, stages: ([($reg[0].trackers // {}) | to_entries[] | select(.value | type == "object")
        | .key as $p | select($p | visible($m))
        | (if $rank[$at[$p] // ""] != null then $at[$p] else null end) as $s
        | (.value.type // null) as $t
        | [$rows[] | select(.project == $p and (.implicit | not) and .live.value != null)
           | {rung: ($ch[.channel] // "")} | select($rank[.rung] != null)] as $live
        | {key: $p, value: {stage: $s,
            rungs: ([$live[].rung] | unique | sort_by($rank[.])),
            needs: (if $s != null and ($t == "game" or $t == "app")
                    then [$L[] | select($rank[.] >= ($rank["alpha"] // 0) and $rank[.] <= $rank[$s])
                          | . as $r | select([$live[] | select(.rung == $r)] | length == 0)]
                    else [] end)}}]
        | from_entries)}' <"$labs"
}

# link_facts <labs-file> -> {links: {...}}: the raw facts `hub releases check` holds the registry to, each
# with the error that stopped its read. Per app repo (a repo an app or game ships from): the
# GitHub environments that hold a recorded Deployment (record-deployment writes the version as
# its description; a job's `environment:` key writes none), and every workflow file on both
# forges at origin's default branch with whether it looks like a deploy. Per lab project: its
# versions, each with its roll stamp and its frozen rows' PRs; a project with `automation = false`
# has no roll (agentctl-wave-roll skips it), so it carries none and no version check runs on it.
# `since` is RELEASE_NOTES_SINCE, the day the links are enforced from.
link_facts() {
  local labs="$1" repos key slug dir branch f deploy envs out tmp proj lab root roadmap rolled manual
  local -A labroot=()
  project_machine_profile >/dev/null
  repos="$(jq -r --arg m "$PROJECT_MACHINE_PROFILE" --slurpfile reg "$MAP" "$PROJECT_VISIBLE_JQ"'
    (.trackers // {}) | to_entries[] | select(.value | type == "object")
    | select(.key | visible($m)) | select(.value.type == "app" or .value.type == "game")
    | .value.repo // .key' "$MAP" | sort -u)"
  tmp="$(mktemp -d)" || die "mktemp failed"
  while IFS= read -r key; do
    [ -n "$key" ] || continue
    slug="$(project_field "$key" github)"
    if [ -n "$slug" ]; then
      if envs="$(timeout "$PROBE_TIMEOUT" gh api graphql -f query="$ENV_QUERY" -F owner="${slug%%/*}" -F name="${slug#*/}" \
          --jq '[.data.repository.deployments.nodes[] | select((.description // "") != "") | .environment] | unique' 2>/dev/null)"; then
        jq -nc --arg k "$key" --arg s "$slug" --argjson e "$envs" '{key: $k, value: {slug: $s, names: $e}}'
      else
        jq -nc --arg k "$key" --arg s "$slug" '{key: $k, value: {slug: $s, names: [], error: "gh api deployments failed"}}'
      fi >>"$tmp/env"
    fi
    dir="$(repo_dir "$key")"
    if [ -z "$dir" ] || [ ! -d "$dir" ]; then
      jq -nc --arg k "$key" '{key: $k, value: {files: [], error: "no checkout"}}' >>"$tmp/wf"
      continue
    fi
    branch="$(default_branch "$dir")"
    if [ -z "$branch" ] || ! fetch_branch "$dir" "$branch"; then
      jq -nc --arg k "$key" '{key: $k, value: {files: [], error: "cannot fetch the default branch"}}' >>"$tmp/wf"
      continue
    fi
    : >"$tmp/files"
    while IFS= read -r f; do
      case "$f" in *.yml|*.yaml) ;; *) continue ;; esac
      deploy=false
      if [[ "${f##*/}" =~ $DEPLOY_NAMES ]] || git -C "$dir" show "origin/$branch:$f" 2>/dev/null | grep -Eiq -- "$DEPLOY_MARKERS"; then
        deploy=true
      fi
      jq -nc --arg p "$f" --argjson d "$deploy" '{path: $p, deploy: $d}' >>"$tmp/files"
    done < <(git -C "$dir" ls-tree -r --name-only "origin/$branch" -- .github/workflows .forgejo/workflows 2>/dev/null)
    jq -sc --arg k "$key" --arg b "$branch" '{key: $k, value: {branch: $b, files: .}}' "$tmp/files" >>"$tmp/wf"
  done <<<"$repos"
  manual="$(jq -r '.[]? | select(.automation == false) | .name' "$labs" 2>/dev/null || true)"
  while IFS=$'\037' read -r proj lab; do
    [ -n "$proj" ] || continue
    ! grep -qxF "$proj" <<<"$manual" || continue
    [ -v "labroot[$lab]" ] || labroot[$lab]="$(notes --profile "$lab" path projects 2>/dev/null || true)"
    root="${labroot[$lab]}"
    if [ -z "$root" ] || ! roadmap="$(notes --profile "$lab" projects --roadmap "$proj" --json 2>/dev/null)" \
        || ! jq -e 'type == "array"' >/dev/null 2>&1 <<<"$roadmap"; then
      jq -nc --arg p "$proj" '{key: $p, value: {list: [], error: "notes projects --roadmap did not answer"}}' >>"$tmp/ver"
      continue
    fi
    : >"$tmp/rolled"
    for f in "$root/$proj"/versions/*.md; do
      [ -f "$f" ] || continue
      rolled="$(sed -n 's/.*<!-- rolled: \([0-9][0-9]*\) -->.*/\1/p' "$f" | tail -1)"
      jq -nc --arg v "$(basename "$f" .md)" --arg r "$rolled" '{key: $v, value: ($r | tonumber? // null)}' >>"$tmp/rolled"
    done
    jq -c --arg p "$proj" --slurpfile r "$tmp/rolled" '($r | from_entries) as $at
      | {key: $p, value: {list: [.[] | select(.state != "current")
          | {version, state, rolled: $at[.version], prs: ([.rows[]?.prs[]?] | map(tonumber? // empty) | unique)}]}}' \
      <<<"$roadmap" >>"$tmp/ver"
  done < <(jq -r --arg m "$PROJECT_MACHINE_PROFILE" --slurpfile reg "$MAP" "$PROJECT_VISIBLE_JQ"'
    (.trackers // {}) | to_entries[] | select(.value | type == "object") | select(.key | visible($m))
    | select(.value.lab and (.value.type == "app" or .value.type == "game"))
    | "\(.key)\u001f\(.value.lab)"' "$MAP")
  out="$(jq -n --argjson since "$(date -d "$RELEASE_NOTES_SINCE" +%s)" \
    --slurpfile e <(cat "$tmp/env" 2>/dev/null) --slurpfile w <(cat "$tmp/wf" 2>/dev/null) --slurpfile v <(cat "$tmp/ver" 2>/dev/null) \
    '{links: {since: $since, environments: ($e | from_entries), workflows: ($w | from_entries), versions: ($v | from_entries)}}')"
  rm -rf "$tmp"
  [ -n "$out" ] || return 1
  printf '%s\n' "$out"
}

# refresh_snapshot [project...] -> probe, write the snapshot, print its one-line summary.
refresh_snapshot() {
  local only="$*" prev="{}" rows releases tmp line proj t targets summary facts
  local -A tag_of=()
  mkdir -p "$STATE_DIR" || die "cannot create $STATE_DIR"
  exec 9>"$STATE_DIR/.lock" || die "cannot open $STATE_DIR/.lock"
  flock -w 120 9 || die "another refresh holds $STATE_DIR/.lock"
  [ -f "$STATE" ] && prev="$(cat "$STATE")"
  jq -e . >/dev/null 2>&1 <<<"$prev" || prev="{}"
  # Read before the loop: a die inside a process substitution would only end that subshell,
  # and a full refresh would then overwrite the snapshot with zero rows.
  targets="$(targets_json "$only")" || die "cannot read the targets in $MAP"
  store_credentials "$targets"
  tmp="$(mktemp -d "$STATE_DIR/.refresh.XXXXXX")" || die "cannot write in $STATE_DIR"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    proj="$(jq -r '.project' <<<"$line")"
    t="$(jq -c '.target' <<<"$line")"
    # A target with no id cannot be joined across refreshes or named by check.
    [ -n "$(jq -r '.id // empty' <<<"$t")" ] || { echo "release-state: $proj has a target with no id; skipped" >&2; continue; }
    [ -v "tag_of[$proj]" ] || tag_of[$proj]="$(project_release_tag "$proj" 2>/dev/null || true)"
    row "$proj" "$t" "$prev" "${tag_of[$proj]}" >>"$tmp/row"
  done <<<"$targets"
  jq -sc . "$tmp/row" >"$tmp/rows" || { rm -rf "$tmp"; die "cannot read the probed rows"; }
  : >"$tmp/rel1"
  while IFS= read -r proj; do
    [ -n "$proj" ] || continue
    history "$proj" | jq -c --arg p "$proj" '{key: $p, value: .}' >>"$tmp/rel1"
  done < <(jq -r '.project' <<<"$targets" | sort -u)
  jq -sc 'from_entries' "$tmp/rel1" >"$tmp/rel" || { rm -rf "$tmp"; die "cannot read the release history"; }
  printf '%s\n' "$prev" >"$tmp/prev"
  local out="$STATE_DIR/.state.$$"
  # Files, never --argjson: the snapshot passed 128 KB on 2026-11-11, the kernel's cap on one
  # argument (MAX_ARG_STRLEN), and every refresh died with "Argument list too long".
  jq -n --slurpfile rows "$tmp/rows" --slurpfile releases "$tmp/rel" --slurpfile prev "$tmp/prev" --arg only "$only" --argjson now "$(now_epoch)" '
    $rows[0] as $rows | $releases[0] as $releases | $prev[0] as $prev
    | ($only | split(" ") | map(select(. != ""))) as $o
    | { generated_at: ($now | todate), generated_epoch: $now,
        rows: ((if ($o | length) > 0
                then ($prev.rows // []) | map(select(.project as $p | $o | index($p) | not))
                else [] end) + $rows),
        releases: ((if ($o | length) > 0 then ($prev.releases // {}) else {} end) + $releases) }' >"$out" \
    || { rm -rf "$out" "$tmp"; die "cannot write $out"; }
  # From the merged rows, so a subset refresh still judges every project on all its channels.
  # One `notes projects --stats --json` read serves both fact blocks.
  notes projects --stats --json >"$tmp/labs" 2>/dev/null || : >"$tmp/labs"
  stage_facts "$out" "$tmp/labs" >"$tmp/stage" || { rm -rf "$out" "$tmp"; die "cannot write the stage facts"; }
  link_facts "$tmp/labs" >"$tmp/links" || { rm -rf "$out" "$tmp"; die "cannot write the link facts"; }
  jq --slurpfile s "$tmp/stage" --slurpfile l "$tmp/links" '. + $s[0] + $l[0]' "$out" >"$out.f" && mv -f "$out.f" "$out" \
    || { rm -rf "$out" "$out.f" "$tmp"; die "cannot write the facts"; }
  rm -rf "$tmp"
  summary="$(jq -r '.rows | "\(length) rows, \(map(select(.status == "drift")) | length) drift, \(map(select(.status == "unknown")) | length) unknown"' "$out")" \
    || { rm -f "$out"; die "cannot summarize $out"; }
  mv -f "$out" "$STATE" || { rm -f "$out"; die "cannot replace $STATE"; }
  printf '%s\n' "$summary"
}

# One pass, one outcome, published here and nowhere else: a pass that fails at any step is
# FAILED with that step's reason, so agentctl never promotes a silent PENDING to STALLED.
cmd_refresh() {
  local summary rc why
  REFRESH_WHY="$(mktemp)" || die "mktemp failed"
  if summary="$(refresh_snapshot "$@")"; then
    rm -f "$REFRESH_WHY"
    echo "$summary"
    # Every pass rewrites the snapshot, so a written one is the artifact; drift is check's verdict.
    proof_outcome "$NAME" WORKED "$summary"
  else
    rc=$?
    why="$(cat "$REFRESH_WHY" 2>/dev/null)"
    rm -f "$REFRESH_WHY"
    proof_outcome "$NAME" FAILED "${why:-refresh exited $rc}"
    exit "$rc"
  fi
}

# severity order for show: broken first, then attention, then green.
RANK='{"drift":0,"unknown":1,"floating":2,"ok":3,"released":4,"unreleased":5}'

cmd_show() {
  local json=0 proj=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      -h|--help) usage 0 ;;
      -*) die "unknown option: $1" ;;
      *) proj="$1"; shift ;;
    esac
  done
  [ -f "$STATE" ] || die "no snapshot yet; run: release-state refresh"
  if [ "$json" = 1 ]; then
    jq --arg p "$proj" 'if $p == "" then . else .rows |= map(select(.project == $p)) end' "$STATE"
    return
  fi
  jq -r --argjson now "$(now_epoch)" '"refreshed \(.generated_at) (\((($now - .generated_epoch) / 60) | floor)m ago)"' "$STATE"
  jq -r --arg p "$proj" --argjson rank "$RANK" '
    # A blank says why: a pin nothing recorded yet, a live side nothing probes, a read that failed.
    def v(x; none): (x.value // (if x.source == "manual" then "manual" elif x.error == "no release tag" then "not recorded"
      elif x.source == "none" then none else "not read" end));
    def tel: (.telemetry | if length == 0 then "none declared" else "\(map(select(.state == "OK")) | length)/\(length)" end);
    def none: if .pinned.source == "manual" then "manual" elif (.deploys.source // "none") == "none" then "none declared" else "not recorded" end;
    def prev: none as $n | (.deploys // {}) | if .error then "not read" else (.prev // $n) end;
    def last: none as $n | (.deploys // {}) | if .error then "not read" elif .last == null then $n
      else "\(.last.at | strflocaltime("%m-%d %H:%M")) \(.last.state)" end;
    (["PROJECT","CHANNEL","PINNED","LIVE","STATUS","PREV","LAST DEPLOY","TELEMETRY"] | @tsv),
    (.rows | map(select($p == "" or .project == $p))
      | sort_by(($rank[.status] // 9), .project, .id)[]
      | [.project, (.channel + (if .implicit then "" else " " + .id end)), v(.pinned; "not recorded"), v(.live; "none declared"), .status, prev, last, tel] | @tsv)
  ' "$STATE" | column -t -s $'\t'
}

cmd_check() {
  local grace=30 max_age=60
  while [ $# -gt 0 ]; do
    case "$1" in
      --grace) grace="${2:?}"; shift 2 ;;
      --max-age) max_age="${2:?}"; shift 2 ;;
      -h|--help) usage 0 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [ -f "$STATE" ] || { echo "STALE no snapshot at $STATE"; return 1; }
  local out
  out="$(jq -r --argjson now "$(now_epoch)" --argjson grace "$grace" --argjson max "$max_age" '
    (if ($now - .generated_epoch) > ($max * 60)
     then "STALE snapshot is \((($now - .generated_epoch) / 60) | floor)m old (max \($max)m)" else empty end),
    (.rows[]
     | (select(.status == "drift" and (.drift_since != null) and ($now - .drift_since) > ($grace * 60))
        | "DRIFT \(.project) \(.id): pinned \(.pinned.value)\(if .pinned.build then " build \(.pinned.build)" else "" end) live \(.live.value)\(if .live.build then " build \(.live.build)" else "" end) for \((($now - .drift_since) / 60) | floor)m"),
       (select(.status == "floating" and .channel == "prod")
        | "FLOATING \(.project) \(.id): prod runs an unpinned image"))
  ' "$STATE")"
  [ -z "$out" ] && { echo "ok"; return 0; }
  printf '%s\n' "$out"
  return 1
}

# changelog_section <repo> <ref> <file> <version> -> the body of <version>'s section of <file> as
# it stands at <ref>, or nothing. A section is a heading (any level, `[1.2.3]`, `v1.2.3` or bare,
# then a space, bracket, paren, colon or the end) up to the next heading of its level or higher,
# so its `### Added` parts stay in. Headings inside a code fence are not headings.
changelog_section() {
  git -C "$1" show "$2:$3" 2>/dev/null | awk -v ver="$4" '
    /^(```|~~~)/ { fence = !fence }
    !fence && /^#+[ \t]/ {
      match($0, /^#+/); lvl = RLENGTH
      h = substr($0, lvl + 1); sub(/^[ \t]+/, "", h); sub(/^\[/, "", h); sub(/^[vV]/, "", h)
      if (on && lvl <= top) exit
      if (!on && index(h, ver) == 1) {
        c = substr(h, length(ver) + 1, 1)
        if (c == "" || index("] ),:(\t", c) > 0) { on = 1; top = lvl; next }
      }
    }
    on {
      if (!seen && $0 ~ /^[ \t]*$/) next
      seen = 1; buf[++n] = $0
      if ($0 !~ /^[ \t]*$/) last = n
    }
    END { for (i = 1; i <= last; i++) print buf[i] }'
}

# _cl_list <subjects> -> them as a markdown list, cut at CHANGELOG_LINES with a line saying so.
_cl_list() {
  [ -n "$1" ] || return 0
  sed 's/^/- /' <<<"$1" | head -n "$CHANGELOG_LINES"
  if [ "$(wc -l <<<"$1")" -gt "$CHANGELOG_LINES" ]; then echo "- ... and older PRs, not shown"; fi
}

cmd_changelog() {
  local json=0 list=0 proj="" tag="" repo path branch glob all prev ver text="" source="" range ref file root_changelog
  local own elsewhere n said
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --list) list=1; shift ;;
      -h|--help) usage 0 ;;
      -*) die "unknown option: $1" ;;
      *) if [ -z "$proj" ]; then proj="$1"; elif [ -z "$tag" ]; then tag="$1"; else die "too many arguments"; fi; shift ;;
    esac
  done
  [ -n "$proj" ] || usage
  project_tag_scope "$proj" || die "$proj has no checkout, so no tags to read"
  repo="$_PTS_REPO"
  glob="$_PTS_GLOB"
  all="$(git_tags "$repo" "$proj" "$_PTS_SCOPED" "$glob")"
  # A game with no release family yet reads its per-build tags, as history does.
  if [ -z "$all" ] && [ -n "$_PTS_BUILDS" ]; then
    glob="$_PTS_BUILDS"
    all="$(git_tags "$repo" "$proj" "$_PTS_SCOPED" "$glob")"
  fi
  [ -n "$all" ] || die "$proj has no release tags${_PTS_BUILDS:+ and no build tags}"
  if [ "$list" = 1 ]; then printf '%s\n' "$all"; return; fi
  # The newest release: the first tag that is not a prerelease, else the newest of all.
  [ -n "$tag" ] || tag="$(grep -vE -- "$_GR_PRERELEASE" <<<"$all" | head -1 || true)"
  [ -n "$tag" ] || tag="$(head -1 <<<"$all")"
  # Only a tag of this project's line: the argument reaches git, so it is never taken as typed.
  grep -Fxq -- "$tag" <<<"$all" || die "$tag is not a release tag of $proj"
  prev="$(git_prev_tag "$repo" "$proj" "$_PTS_SCOPED" "$glob" "$tag")"
  path="$(project_field "$proj" path)"
  branch="$(project_field "$proj" branch)"
  [ -n "$branch" ] || branch="$(default_branch "$repo")"
  ver="$(git_tag_version "$tag")"
  # A root CHANGELOG.md is this project's own only when it is its repo or has no folder of its own:
  # in a monorepo it may hold another product's `## 1.1.0`.
  root_changelog=""
  { [ -z "$path" ] || [ "$_PTS_SCOPED" = 0 ]; } && root_changelog=1
  # The tag's own file first; a project that writes its entry after tagging has it on the branch.
  for ref in "$tag" ${branch:+"origin/$branch"}; do
    for file in ${path:+"$path/CHANGELOG.md"} ${root_changelog:+CHANGELOG.md}; do
      text="$(changelog_section "$repo" "$ref" "$file" "$ver")"
      [ -n "$text" ] && { source="CHANGELOG.md"; break 2; }
    done
  done
  if [ -z "$source" ]; then
    source="merged PRs"
    # Whole, not cut: a PR of its own past the cut must not list again as one elsewhere.
    own="$(git_tag_changes "$repo" "$prev" "$tag" "$path" 100000)"
    text="$(_cl_list "$own")"
    # A product in a monorepo ships what the whole repo merged (its engine, packages, CI), so the
    # PRs that touch nothing under its folder list too, counted, never dropped unsaid.
    if [ "$_PTS_SCOPED" = 1 ] && [ -n "$path" ]; then
      elsewhere="$(git_tag_changes "$repo" "$prev" "$tag" "" 100000 | grep -Fxvf <(printf '%s\n' "$own") || true)"
      if [ -n "$elsewhere" ]; then
        n="$(wc -l <<<"$elsewhere")"
        said="$n merged PR$([ "$n" = 1 ] || echo s) elsewhere in the repo, touching nothing under $path:"
        if [ -n "$text" ]; then text="$text"$'\n\n'"$said"; else text="No merged PR touches $path. $said"; fi
        text="$text"$'\n\n'"$(_cl_list "$elsewhere")"
      fi
    fi
  fi
  range="${prev:+$prev..}$tag"
  if [ "$json" = 1 ]; then
    jq -n --arg project "$proj" --arg tag "$tag" --arg prev "$prev" --arg source "$source" \
      --arg range "$range" --arg text "$text" --arg all "$all" '{
        project: $project, tag: $tag, prev: (if $prev == "" then null else $prev end),
        source: $source, range: $range, text: $text, tags: ($all | split("\n"))}'
  else
    printf '%s %s (%s, from %s)\n\n%s\n' "$proj" "$tag" "$range" "$source" "${text:-no merged PRs in $range}"
  fi
}

# released <project> <sha>... -> one JSON object a commit: {sha, tag, at}, the oldest tag of the
# project's line that contains it (git_first_tag) and its creatordate epoch, a lower bound for a
# lightweight tag; tag and at null when no tag holds it yet. A commit the checkout lacks carries an error instead: an unfetched merge is
# unknown, never unreleased.
cmd_released() {
  local proj="${1:-}" repo sha hit err
  [ -n "$proj" ] && [ $# -gt 1 ] || usage
  shift
  project_tag_scope "$proj" || die "$proj has no checkout, so no tags to read"
  repo="$_PTS_REPO"
  for sha in "$@"; do
    hit="" err=""
    if ! [[ "$sha" =~ ^[0-9a-f]{7,40}$ ]]; then err="not a commit sha"
    elif ! git -C "$repo" cat-file -e "$sha^{commit}" 2>/dev/null; then err="commit not in the checkout"
    else hit="$(git_first_tag "$repo" "$proj" "$_PTS_SCOPED" "$_PTS_GLOB" "$sha")" || err="tag lookup failed"; fi
    jq -nc --arg s "$sha" --arg h "$hit" --arg e "$err" '($h | split(" ")) as $f
      | {sha: $s, tag: ($f[0] // null), at: ($f[1] // "" | tonumber? // null)} + (if $e == "" then {} else {error: $e} end)'
  done
}

case "${1:-}" in
  changelog) shift; cmd_changelog "$@" ;;
  released) shift; cmd_released "$@" ;;
  refresh) shift; cmd_refresh "$@" ;;
  show) shift; cmd_show "$@" ;;
  check) shift; cmd_check "$@" ;;
  -h|--help|help) usage 0 ;;
  *) usage ;;
esac
