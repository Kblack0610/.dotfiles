#!/usr/bin/env bash
# skill-drift - does a skill still describe a system that exists?
#
# A SKILL.md is prose an agent OBEYS. When a path in it moves, nothing fails
# loudly: the agent opens a file that is not there, improvises, and the session
# degrades silently. That is the same class as the LiteLLM/Ollama stale-SETUP
# incident (an email-triage skill classified against a host decommissioned
# months earlier, failing closed to "everything FYI" with no error) and as
# dotfiles-drift's merged-is-not-deployed gap.
#
# It was written after `update-rules` was found pointing EVERY path it named at
# ~/.dotfiles/, months after the rule layer moved to the ~/.dotfiles-private
# overlay. Six workflows, all opening files that did not exist. Its own built-in
# self-check had the same bug, so it could not report itself.
#
# The checks split into two families, and the split is what lets CI run this.
#
# STATIC - decidable from a repo checkout alone, so they gate every PR (--lint):
#
#   NOFRONTMATTER  no YAML frontmatter, or no name:/description:.
#   BADNAME    name is not kebab-case, or does not match its directory. A
#              mismatch is invisible until the wrong thing is invoked.
#   DUPNAME    the same skill name defined twice. ~/.claude/skills is ONE flat
#              namespace across both repos, so a duplicate is ambiguous.
#   BADMETA    metadata.category / tags / reviewed missing or malformed, a
#              category outside the known set, or a category that disagrees with
#              the parent directory.
#   CATCOLLIDE a category sharing a name with a skill. `comms/comms/` makes
#              `git mv` refuse, and the first attempt at the category migration
#              silently moved two sibling skills INSIDE the comms skill.
#   LONGDESC   description + when_to_use over 1536 chars, the documented cap on
#              the skill listing. Past it the trailing trigger phrases are
#              truncated away, so the skill stops being found by the thing the
#              description exists to do.
#   NONASCII   the house plain-ASCII rule (em/en dash, arrows, >=, ellipsis...).
#              Ratcheted against tests/skill-lint.baseline, not all-or-nothing.
#
# ENVIRONMENTAL - need a real machine, so they stay local (report/--quiet/--json):
#
#   DEADPATH   a ~/ or $HOME/ path named in a SKILL.md does not exist. This is
#              the update-rules class and the reason this script exists.
#   NOCMD      a command the skill tells you to RUN does not resolve on PATH.
#              (`rulesync` lives at ~/.rulesync/bin/rulesync, never on PATH.)
#   UNDEPLOYED a skill dir exists in a repo but has no link in ~/.claude/skills,
#              so it is documented and unreachable.
#   GHOST      CLAUDE.md bullets a skill that is not on disk (retired but still
#              advertised, so the agent tries to invoke it).
#   (UNLISTED was retired: the auto-injected description listing is the index
#    now, so CLAUDE.md carries only routing overrides. See check_registration.)
#   STALE      metadata.reviewed is older than STALE_DAYS. Not "last edited",
#              which git already answers - last VERIFIED against reality.
#   UNUSED     never invoked in USAGE_DAYS of transcripts. A skill nothing calls
#              still spends its description tokens in every session. This is a
#              SIGNAL, not a verdict: a release runbook fires per release and is
#              supposed to look idle.
#
# Deliberately trivial and dependency-free: it is polled by a sentinel watch and
# a checker that needs a working environment cannot report a broken one.
#
# Escape hatch: a line containing `skill-drift: ignore` is skipped entirely.
# Hostnames of the form *.example.internal are SANITIZATION for the public repo
# (see dotfiles-land), never drift - paths containing them are skipped.
#
# A BASELINE is what makes this adoptable. The first run found 60+ real findings
# across skills written over months; a watch that is red from birth is a watch
# nobody reads. `--write-baseline` freezes today's known debt, after which
# --quiet trips only on drift that is NEW. The full report always shows
# everything, baselined or not, so the debt stays visible instead of forgotten.
#
# Usage:
#   skill-drift                  human-readable report (everything)
#   skill-drift --quiet          print nothing; exit 1 on NEW drift only (for a watch)
#   skill-drift --json           machine-readable (everything, with "new": true|false)
#   skill-drift --new            human-readable, NEW findings only
#   skill-drift --write-baseline freeze current findings as accepted
#   skill-drift --lint [DIR]     STATIC checks only, over DIR/.claude/skills.
#                                What CI runs: no deployed tree, no private repo
#                                and no CLAUDE.md exist on a runner, so the
#                                environmental checks cannot even be attempted.
#   skill-drift --write-lint-baseline [DIR]   freeze current NONASCII debt
set -uo pipefail

SKILLS="${CLAUDE_SKILLS:-$HOME/.claude/skills}"
PUB="${DOTFILES:-$HOME/.dotfiles}"
PRIV="${DOTFILES_PRIVATE:-$HOME/.dotfiles-private}"
CODEX="${CODEX_SKILLS:-$PUB/.config/codex/skills}"
CLAUDE_MD="${CLAUDE_MD:-$HOME/.claude/CLAUDE.md}"
BASELINE="${SKILL_DRIFT_BASELINE:-$HOME/.agent/skill-drift.baseline}"
STALE_DAYS="${SKILL_STALE_DAYS:-180}"
USAGE_DAYS="${SKILL_USAGE_DAYS:-90}"
TRANSCRIPTS="${CLAUDE_TRANSCRIPTS:-$HOME/.claude/projects}"

# The known categories. A skill outside this set is a typo or a taxonomy that
# grew without anyone deciding to grow it; either way it should be a review
# conversation, not a silent new directory.
CATEGORIES=" authoring memory messaging monitoring ops reference research tickets workstreams "

# The listing cap. description + when_to_use are concatenated and truncated at
# this many characters, so everything past it is invisible to skill selection.
DESC_MAX=1536
DESC_WARN=1200

MODE=report LINT_DIR=""
case "${1:-}" in
  --quiet)          MODE=quiet ;;
  --json)           MODE=json ;;
  --new)            MODE=new ;;
  --write-baseline) MODE=write_baseline ;;
  --lint)               MODE=lint;               LINT_DIR="${2:-$PWD}" ;;
  --write-lint-baseline) MODE=write_lint_baseline; LINT_DIR="${2:-$PWD}" ;;
  -h|--help) sed -n '2,78p' "$0" | sed 's/^# \?//'; exit 0 ;;
esac

LINT_BASELINE="${SKILL_LINT_BASELINE:-$LINT_DIR/tests/skill-lint.baseline}"

FINDINGS=()   # "TYPE|skill|item|detail"
add() { FINDINGS+=("$1|$2|$3|$4"); }

# Commands so ubiquitous that their absence means a broken box, not a stale
# skill. Flagging these would bury the one finding that matters.
COMMON=" cd ls cat echo grep sed awk cut sort uniq head tail find xargs tr wc
diff comm test printf read for while if then else fi do done case esac exit
export local return set shift source eval exec mkdir rm cp mv ln touch chmod
git curl jq ssh scp rsync tar gzip open pwd env sleep date true false npx bash
sh zsh python python3 node npm pnpm yarn make docker kubectl helm gh stow "

is_common() { case "$COMMON" in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# --- per-skill checks --------------------------------------------------------

check_frontmatter() {
  local skill="$1" f="$2"
  head -1 "$f" | grep -q '^---$' || { add NOFRONTMATTER "$skill" SKILL.md "no YAML frontmatter"; return 0; }
  sed -n '2,/^---$/p' "$f" | grep -q '^name:'        || add NOFRONTMATTER "$skill" SKILL.md "frontmatter missing name:"
  sed -n '2,/^---$/p' "$f" | grep -q '^description:' || add NOFRONTMATTER "$skill" SKILL.md "frontmatter missing description:"
  return 0
}

# --- static checks (also run in CI, where nothing else can) -------------------

fm() { sed -n '2,/^---$/p' "$1"; }

# The frontmatter `name` must be kebab-case AND equal the directory name. Claude
# Code takes the command from the DIRECTORY for a personal skill and from `name`
# for a plugin skill, so a mismatch means the two disagree about what this skill
# is called - and which one wins depends on how it was installed.
check_name() {
  local skill="$1" f="$2" name
  name=$(fm "$f" | grep -m1 '^name:' | sed 's/^name:[[:space:]]*//; s/[[:space:]]*$//')
  [ -n "$name" ] || return 0
  printf '%s' "$name" | grep -qE '^[a-z][a-z0-9]*(-[a-z0-9]+)*$' \
    || add BADNAME "$skill" "$name" "name is not kebab-case"
  [ "$name" = "$skill" ] \
    || add BADNAME "$skill" "$name" "frontmatter name does not match the directory"
  return 0
}

# category/tags/reviewed. `reviewed` is the one that decays: it records when the
# skill's claims were last checked against reality, which is the question git
# cannot answer.
check_meta() {
  local skill="$1" f="$2" parent="$3" cat tags rev
  cat=$(fm "$f"  | sed -n 's/^  category:[[:space:]]*//p' | head -1 | tr -d ' ')
  tags=$(fm "$f" | sed -n 's/^  tags:[[:space:]]*//p'     | head -1)
  rev=$(fm "$f"  | sed -n 's/^  reviewed:[[:space:]]*//p' | head -1 | tr -d ' "')

  if [ -z "$cat" ]; then
    add BADMETA "$skill" category "missing metadata.category"
  else
    case "$CATEGORIES" in
      *" $cat "*) : ;;
      *) add BADMETA "$skill" "$cat" "category is not one of:$CATEGORIES" ;;
    esac
    # The directory IS the category. Two places to read it means one can be wrong.
    [ -z "$parent" ] || [ "$cat" = "$parent" ] \
      || add BADMETA "$skill" "$cat" "category disagrees with the parent directory ($parent)"
  fi

  [ -n "$tags" ] || add BADMETA "$skill" tags "missing metadata.tags"
  case "$tags" in
    ""|\[*\]) : ;;
    *) add BADMETA "$skill" tags "tags must be an inline list, e.g. [a, b]" ;;
  esac

  if [ -z "$rev" ]; then
    add BADMETA "$skill" reviewed "missing metadata.reviewed"
  elif ! printf '%s' "$rev" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'; then
    add BADMETA "$skill" "$rev" "reviewed must be a quoted YYYY-MM-DD date"
  fi
  return 0
}

# description + when_to_use are concatenated into the skill listing and truncated
# at DESC_MAX. Past that the trailing trigger phrases - the whole reason the
# description is long in this corpus - are silently cut off.
check_desc_len() {
  local skill="$1" f="$2" n
  n=$(fm "$f" | awk '
    /^(description|when_to_use):/ { grab=1; sub(/^[a-z_]+:[[:space:]]*/, ""); }
    /^[a-z_-]+:/ && !/^(description|when_to_use):/ { grab=0 }
    grab { total += length($0) + 1 }
    END { print total + 0 }')
  if [ "$n" -gt "$DESC_MAX" ]; then
    add LONGDESC "$skill" "${n}c" "over the ${DESC_MAX}-char listing cap - the tail is truncated away"
  elif [ "$n" -gt "$DESC_WARN" ]; then
    # Advisory. Failing a PR for a description that is merely LONG would train
    # people to pad the limit down, and the limit is not the problem - silent
    # truncation past it is.
    add DESCNEAR "$skill" "${n}c" "within $((DESC_MAX - n)) chars of the ${DESC_MAX} cap"
  fi
  return 0
}

# The house plain-ASCII rule (see the Writing Style section of CLAUDE.md). One
# finding per skill, not per character, so the baseline stays stable while a
# skill is being cleaned up and disappears entirely once it is clean.
check_ascii() {
  local skill="$1" f="$2" n
  n=$(grep -c -P '[\x{2014}\x{2013}\x{2192}\x{2190}\x{2265}\x{2264}\x{2026}\x{00A7}\x{00B7}]' "$f" 2>/dev/null || true)
  [ "${n:-0}" -gt 0 ] && add NONASCII "$skill" SKILL.md "$n line(s) with non-ASCII punctuation (em dash, arrow, ellipsis...)"
  return 0
}

# Pull every ~/... or $HOME/... token out of the prose and test it. A path is
# only CHECKABLE if it is concrete: placeholders (<repo>, {project}, *.md, ...)
# describe a shape, not a file, and testing them would produce pure noise.
#
# A trailing - or . means the regex stopped mid-template (`.../briefs/YYYY-MM-DD-`,
# `.../2026-04-30-<slug>`), not that a file is missing. Capitalised sanitisation
# stand-ins (AcmeCorp, YYYY) are the same story as *.example.internal.
check_paths() {
  local skill="$1" f="$2" p
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    case "$p" in
      *'<'*|*'>'*|*'{'*|*'}'*|*'*'*|*'?'*|*'...'*) continue ;;
      *'example.internal'*|*AcmeCorp*|*YYYY*|*vX.Y.Z*) continue ;;
      *-|*.) continue ;;
      *'$'*) case "$p" in '$HOME/'*) : ;; *) continue ;; esac ;;
    esac
    p="${p/#\~\//$HOME/}"
    p="${p/#\$HOME\//$HOME/}"
    p="${p%/}"
    [ -e "$p" ] || add DEADPATH "$skill" "${p/#$HOME/\~}" "path does not exist"
  done < <(
    grep -v 'skill-drift: ignore' "$f" \
      | grep -oE '(~|\$HOME)/[A-Za-z0-9._~/-]*[A-Za-z0-9._-]' \
      | sort -u
  )
  return 0
}

# The first token of a COMMAND line inside a ```bash fence. Two filters keep this
# from reading prose as shell, which is the whole difficulty: a continuation line
# (previous line ended in \ | && ||) has no command in first position, and a line
# with no flag, path, assignment, pipe or quote in it is English, not a command.
# Without those, `bump the version` reports a missing tool called "bump".
check_cmds() {
  local skill="$1" f="$2" c
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    is_common "$c" && continue
    command -v "$c" >/dev/null 2>&1 && continue
    add NOCMD "$skill" "$c" "command not found on PATH"
  done < <(
    awk '
      /^[[:space:]]*```(bash|sh|shell|console)[[:space:]]*$/ { inblock=1; cont=0; next }
      /^[[:space:]]*```/ { inblock=0; next }
      !inblock || /skill-drift: ignore/ { next }
      {
        line = $0
        sub(/^[[:space:]]+/, "", line)
        sub(/^[$#][[:space:]]+/, "", line)
        was_cont = cont
        cont = (line ~ /(\\|\||&&|\|\|)[[:space:]]*$/)
        if (was_cont) next                      # continuation: no command here
        # A command line carries a flag, a path, a pipe/redirect, or is a bare
        # invocation. Prose ("bump the version", "crash-free rate > 99.5%")
        # carries none of those. Precision over recall: a noisy report is an
        # ignored report, and DEADPATH already does the heavy lifting.
        if (line ~ /(^| )--?[A-Za-z]/)      { print line; next }   # flag
        if (line ~ /(^| )[~\/]|[a-z]\//)    { print line; next }   # path
        if (line ~ /\||>|\$\(/)             { print line; next }   # pipe/subshell
        if (line ~ /^[a-z][a-z0-9_-]*$/)    { print line; next }   # bare invocation
      }
    ' "$f" \
      | awk '{print $1}' \
      | grep -xE '[a-z][a-z0-9_-]*' \
      | sort -u
  )
  return 0
}

# --- registration checks -----------------------------------------------------

# A skill dir in either repo with no link in ~/.claude/skills is documented and
# unreachable - the agent cannot invoke it however well it is described.
# Discovery is by SKILL.md at any depth, matching skill-deploy, so this keeps
# working across the flat -> <category>/<name>/ move. Globbing */ instead would
# have "found" nine categories and reported all 60 real skills as undeployed.
find_skills() {
  local root="$1"
  [ -d "$root" ] || return 0
  find "$root" -mindepth 2 -maxdepth 3 -name SKILL.md -type f 2>/dev/null | sort
}

check_undeployed() {
  local repo="$1" name="$2" m skill
  [ -d "$repo/.claude/skills" ] || return 0
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    skill="$(basename "$(dirname "$m")")"
    [ -e "$SKILLS/$skill" ] || add UNDEPLOYED "$skill" "$name" "in the $name repo but not linked into ~/.claude/skills"
  done < <(find_skills "$repo/.claude/skills")
  return 0
}

# reviewed is a claim about REALITY, and reality moves. Past STALE_DAYS the claim
# is not false, it is unsupported - nobody has looked.
check_stale() {
  local skill="$1" f="$2" rev age
  rev=$(fm "$f" | sed -n 's/^  reviewed:[[:space:]]*//p' | head -1 | tr -d ' "')
  [ -n "$rev" ] || return 0
  age=$(( ( $(date +%s) - $(date -d "$rev" +%s 2>/dev/null || echo 0) ) / 86400 ))
  [ "$age" -gt "$STALE_DAYS" ] && add STALE "$skill" "$rev" "${age}d since last verified (limit ${STALE_DAYS}d)"
  return 0
}

# Every skill's description sits in the context window of every session whether
# it fires or not, so a skill nothing calls is a standing cost. Counted from the
# Skill tool calls recorded in transcripts.
#
# A SIGNAL, not a verdict. A release runbook is supposed to look idle between
# releases; what this is for is finding the ones that are idle because the router
# never picks them, which is the overlap problem skill-refine has had no data for.
declare -A USED=()
load_usage() {
  [ -d "$TRANSCRIPTS" ] || return 0
  local s
  # -mtime, NOT -newermt '-90 days': the latter silently matches nothing here,
  # and an empty input list would read as "no skill was ever used".
  while IFS= read -r s; do
    [ -n "$s" ] && USED[$s]=1
  done < <(
    find "$TRANSCRIPTS" -name '*.jsonl' -mtime "-$USAGE_DAYS" -print0 2>/dev/null \
      | xargs -0 -r grep -hoE '"name": ?"Skill", ?"input": ?\{ ?"skill": ?"[^"]*"' 2>/dev/null \
      | sed 's/.*"skill": \?"//; s/"$//' | sort -u
  )
  return 0
}

check_unused() {
  local skill="$1"
  # No transcripts at all means we cannot tell, which is not the same as unused.
  [ ${#USED[@]} -gt 0 ] || return 0
  [ -n "${USED[$skill]:-}" ] || add UNUSED "$skill" "${USAGE_DAYS}d" "never invoked in the last ${USAGE_DAYS}d of transcripts"
  return 0
}

check_registration() {
  local skill
  [ -f "$CLAUDE_MD" ] || { add DEADPATH CLAUDE.md "${CLAUDE_MD/#$HOME/\~}" "CLAUDE.md not found"; return 0; }

  # Bulleted in CLAUDE.md but absent from disk: the agent will try to invoke it.
  #
  # The "Retired" block is excluded, because naming a dead skill there is the
  # entire point of it - it is what stops the agent reaching for a skill that
  # used to exist. Flagging those would mean the only way to satisfy the check
  # is to delete the warning, which is backwards.
  while IFS= read -r skill; do
    [ -n "$skill" ] || continue
    [ -e "$SKILLS/$skill" ] || add GHOST "$skill" CLAUDE.md "bulleted in CLAUDE.md but not on disk"
  done < <(
    awk '
      /^\*\*Retired/        { skip=1; next }
      /^\*\*/               { skip=0 }
      /^##/                 { skip=0 }
      !skip
    ' "$CLAUDE_MD" \
      | grep -oE '^- `[a-z][a-z0-9:-]*`' | sed 's/^- `//; s/`$//' | grep -v ':' | sort -u
  )

  # There is deliberately no UNLISTED check any more.
  #
  # It existed when CLAUDE.md's skill section was the routing layer: a skill
  # missing from it was a skill nothing could route to. That stopped being true.
  # Every skill's `description` is injected into the context automatically, so
  # the listing IS the index, and CLAUDE.md now carries only what a description
  # cannot - which skill wins between two, what to prefer over an MCP, what is
  # retired. Requiring all 60 names in prose as well made the section a ~5k-token
  # duplicate of something already arriving, and it drifted anyway: 7 missing and
  # 1 retired-but-listed when it was cut.
  #
  # GHOST stays, because a routing rule that names a skill which no longer exists
  # is still a live bug - the agent will try to invoke it.
  return 0
}

# --- run ---------------------------------------------------------------------

# --- static pass, shared by --lint and the full local report ------------------
#
# Runs over SOURCE trees (a repo checkout), because that is all CI has and
# because the parent directory - which check_meta compares the category against -
# only exists there. The deployed tree is flat by design.
# SEEN_NAME is scoped to ONE namespace per call, because uniqueness is a property
# of the namespace and not of the filesystem. ~/.claude/skills is a single flat
# tree fed by both dotfiles repos, so a name repeated across them is ambiguous.
# .config/codex/skills is a DIFFERENT tool's corpus that happens to reuse names
# (deep-research, security-engineer); flagging those would be noise.
declare -A SEEN_NAME=()
# run_static <contract> <root>...
#
# <contract> is `full` or `structural`.
#
#   full        the Claude corpus: category/tags/reviewed, the category directory
#               layout, and the house ASCII rule.
#   structural  only what is true of ANY skill file - it parses, it has a name and
#               a description, the name matches its directory, no duplicates.
#
# The Codex corpus is `structural`. It is a different tool's skills, deployed by a
# different mechanism, with a deliberately smaller 2-key contract; holding it to
# the Claude one produced 25 findings that could never be actioned, which is how a
# report becomes something nobody reads. NOFRONTMATTER there was a REAL find
# (llm-judge had none), so it is not exempted from the checks that mean something.
run_static() {
  local contract="$1"; shift
  local root m d s parent c
  SEEN_NAME=()
  for root in "$@"; do
    [ -d "$root" ] || continue
    while IFS= read -r m; do
      [ -n "$m" ] || continue
      d="$(dirname "$m")"; s="$(basename "$d")"
      parent="$(basename "$(dirname "$d")")"
      # A flat skill sits directly under skills/, so it has no category dir.
      [ "$parent" = "skills" ] && parent=""
      if [ -n "${SEEN_NAME[$s]:-}" ]; then
        add DUPNAME "$s" "$d" "also defined at ${SEEN_NAME[$s]}"
      else
        SEEN_NAME[$s]="$d"
      fi
      check_frontmatter "$s" "$m"
      check_name        "$s" "$m"
      if [ "$contract" = full ]; then
        check_meta     "$s" "$m" "$parent"
        check_desc_len "$s" "$m"
        check_ascii    "$s" "$m"
      fi
    done < <(find_skills "$root")
  done
  # A category directory that shares a name with a skill: comms/comms/ makes
  # `git mv` refuse, and it silently swallowed two sibling skills once already.
  #
  # A directory is a CATEGORY only if it does not itself hold a SKILL.md. Without
  # that test every skill in the flat layout counts as a category colliding with
  # itself, which reported 68 findings for a corpus that had none.
  [ "$contract" = full ] || return 0
  for root in "$@"; do
    [ -d "$root" ] || continue
    for d in "$root"/*/; do
      [ -d "$d" ] || continue
      [ -f "$d/SKILL.md" ] && continue
      c="$(basename "$d")"
      [ -n "${SEEN_NAME[$c]:-}" ] && add CATCOLLIDE "$c" "$root/$c" "a category cannot share a name with a skill"
    done
  done
  return 0
}

if [ "$MODE" = lint ] || [ "$MODE" = write_lint_baseline ]; then
  run_static full "$LINT_DIR/.claude/skills"
else
  # Two namespaces, two calls: the dotfiles pair feed one flat ~/.claude/skills,
  # while the Codex corpus is a different tool's and legitimately reuses names.
  run_static full "$PUB/.claude/skills" "$PRIV/.claude/skills"
  run_static structural "$CODEX"

  load_usage
  for d in "$SKILLS"/*/; do
    [ -e "$d/SKILL.md" ] || continue
    s="$(basename "$d")"
    check_paths  "$s" "$d/SKILL.md"
    check_cmds   "$s" "$d/SKILL.md"
    check_stale  "$s" "$d/SKILL.md"
    check_unused "$s"
  done

  check_undeployed "$PUB"  public
  check_undeployed "$PRIV" private
  check_registration
fi

# Sorting keeps the baseline file stable across runs, so `git diff` on it shows
# real change instead of reordering noise. Guarded on non-empty: `printf '%s\n'`
# with no arguments still prints ONE blank line, which turned a clean run into a
# single empty "finding" and made --quiet exit 1 while the report said clean.
if [ ${#FINDINGS[@]} -gt 0 ]; then
  mapfile -t FINDINGS < <(printf '%s\n' "${FINDINGS[@]}" | sort)
fi
n=${#FINDINGS[@]}

if [ "$MODE" = write_baseline ]; then
  mkdir -p "$(dirname "$BASELINE")"
  [ "$n" -gt 0 ] && printf "%s\n" "${FINDINGS[@]}" > "$BASELINE" || : > "$BASELINE"
  echo "skill-drift: baselined $n finding(s) -> ${BASELINE/#$HOME/\~}"
  exit 0
fi

# --- lint (what CI runs) ------------------------------------------------------
#
# Only NONASCII is ratcheted, and only because the corpus carries 1355 known
# occurrences that predate the rule being enforced. Everything else is a hard
# error from the first run: those checks were all clean when the gate landed, so
# there is no debt to grandfather and no reason to allow any.
if [ "$MODE" = write_lint_baseline ]; then
  mkdir -p "$(dirname "$LINT_BASELINE")"
  : > "$LINT_BASELINE"
  for f in ${FINDINGS[@]+"${FINDINGS[@]}"}; do
    case "$f" in NONASCII\|*) printf '%s\n' "${f%%|*}|$(printf '%s' "$f" | cut -d'|' -f2)" >> "$LINT_BASELINE" ;; esac
  done
  sort -u -o "$LINT_BASELINE" "$LINT_BASELINE"
  echo "skill-lint: baselined $(wc -l < "$LINT_BASELINE") NONASCII skill(s) -> $LINT_BASELINE"
  exit 0
fi

if [ "$MODE" = lint ]; then
  errs=0 warns=0
  for f in ${FINDINGS[@]+"${FINDINGS[@]}"}; do
    IFS='|' read -r t s p d <<< "$f"
    if [ "$t" = NONASCII ] && [ -f "$LINT_BASELINE" ] && grep -qxF "NONASCII|$s" "$LINT_BASELINE"; then
      continue   # known debt, tracked in the baseline
    fi
    case "$t" in
      DESCNEAR) printf '  warn  %-13s %-24s %-24s %s\n' "$t" "$s" "$p" "$d"; warns=$((warns + 1)); continue ;;
    esac
    printf '  FAIL  %-13s %-24s %-24s %s\n' "$t" "$s" "$p" "$d"
    errs=$((errs + 1))
  done
  scanned=$(find_skills "$LINT_DIR/.claude/skills" | wc -l)
  # An empty input list is a FAILURE, not a clean run. Every tooling failure in
  # this repo has been a silent success, and a lint that scans nothing and says
  # "all good" is the purest form of it.
  if [ "$scanned" -eq 0 ]; then
    echo "skill-lint: found NO skills under $LINT_DIR/.claude/skills - refusing to report success"
    exit 2
  fi
  if [ "$errs" -gt 0 ]; then
    printf '\nskill-lint: %d error(s), %d warning(s) across %d skill(s)\n' "$errs" "$warns" "$scanned"
    exit 1
  fi
  printf 'skill-lint: %d skill(s) valid (%d warning(s))\n' "$scanned" "$warns"
  exit 0
fi

is_new() { [ -f "$BASELINE" ] || return 0; ! grep -qxF "$1" "$BASELINE"; }

NEW=()
for f in ${FINDINGS[@]+"${FINDINGS[@]}"}; do
  is_new "$f" && NEW+=("$f")
done
nnew=${#NEW[@]}

case "$MODE" in
  quiet) [ "$nnew" -eq 0 ] && exit 0 || exit 1 ;;
  json)
    printf '{"drift":%s,"new":%s,"findings":[' "$n" "$nnew"
    for i in "${!FINDINGS[@]}"; do
      IFS='|' read -r t s p d <<< "${FINDINGS[$i]}"
      [ "$i" -gt 0 ] && printf ','
      printf '{"type":"%s","skill":"%s","item":"%s","detail":"%s","new":%s}' \
        "$t" "$s" "$p" "$d" "$(is_new "${FINDINGS[$i]}" && echo true || echo false)"
    done
    printf ']}\n'
    [ "$nnew" -eq 0 ] && exit 0 || exit 1 ;;
esac

if [ "$MODE" = new ]; then
  if [ "$nnew" -eq 0 ]; then echo "skill-drift: no NEW drift since the baseline"; exit 0; fi
  printf 'skill-drift: %s NEW finding(s) since the baseline\n\n' "$nnew"
  for f in "${NEW[@]}"; do
    IFS='|' read -r t s p d <<< "$f"
    printf '  %-13s %-24s %-46s %s\n' "$t" "$s" "$p" "$d"
  done
  exit 1
fi

if [ "$n" -eq 0 ]; then
  echo "skill-drift: clean - every skill still describes a system that exists"
  exit 0
fi
printf 'skill-drift: %s finding(s) (%s new since the baseline)\n\n' "$n" "$nnew"
for f in "${FINDINGS[@]}"; do
  IFS='|' read -r t s p d <<< "$f"
  printf '  %-13s %-24s %-46s %s%s\n' "$t" "$s" "$p" "$d" "$(is_new "$f" && echo '  <-- NEW')"
done
cat <<'EOF'

  DEADPATH   -> the path moved. Find it (`fd`/`find` both repos) and fix the SKILL.md
  NOCMD      -> the tool is not on PATH. Name its real location, or drop the step
  UNDEPLOYED -> link them all:  skill-deploy    (--dry-run to preview)
  GHOST      -> the skill is retired; remove the bullet from CLAUDE.md
  BADNAME    -> rename the directory or the frontmatter so the two agree
  DUPNAME    -> one flat namespace across both repos; rename one of them
  BADMETA    -> fix the metadata block (see .claude/skills/SKILL-TEMPLATE.md)
  CATCOLLIDE -> rename the category; it cannot share a name with a skill
  LONGDESC   -> cut the description; past the cap the trigger phrases vanish
  DESCNEAR   -> advisory only, but the cap is closer than it looks
  NONASCII   -> plain ASCII (see the Writing Style rules); `--write-lint-baseline`
                only freezes debt, it does not make the rule optional
  STALE      -> re-verify the skill against reality, THEN bump metadata.reviewed.
                Bumping the date without checking is worse than leaving it stale.
  UNUSED     -> a signal, not a verdict. A release runbook is meant to look idle;
                a skill the router never picks is the one to look at

  Reason about these with `/skill-refine audit` - it adds the lessons/mem0 layer
  and writes proposed diffs. Do NOT silence a finding by deleting the check.
EOF
exit 1
