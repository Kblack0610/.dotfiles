#!/usr/bin/env bash
# Red screen flash for a timebox lap boundary, via Hyprland's screen_shader: COUNT
# pulses (default 3) of ON seconds each. Restores any pre-existing
# shader afterward. No-op when not on Hyprland or when the
# shader file is missing, so it is safe to call unconditionally.
set -u

command -v hyprctl >/dev/null 2>&1 || exit 0

SHADER="${TIMEBOX_FLASH_SHADER:-$HOME/.config/hypr/shaders/flash.frag}"
[ -f "$SHADER" ] || exit 0
COUNT="${TIMEBOX_FLASH_COUNT:-3}"
ON="${TIMEBOX_FLASH_SEC:-0.18}"
OFF=0.14

# Remember the current shader (if any) so a persistent one is restored, not clobbered.
cur=$(hyprctl getoption decoration:screen_shader -j 2>/dev/null \
        | sed -n 's/.*"str"[: ]*"\([^"]*\)".*/\1/p')

# A flash that starts mid-pulse of another must not "restore" the red shader.
# getoption reports an unset shader as [[EMPTY]]; setting it is an empty string.
restore=""
[ -n "${cur:-}" ] && [ "$cur" != "[[EMPTY]]" ] && [ "$cur" != "$SHADER" ] && restore="$cur"

# shader <path>: set decoration:screen_shader live ("" clears it). The path goes in a Lua
# long string, so no character in it needs escaping.
shader() { hyprctl eval "hl.config({ decoration = { screen_shader = [==[$1]==] } })" >/dev/null 2>&1; }

# The sleeps are the pulse itself (a visual cadence), not a wait on an event.
i=0
while [ "$i" -lt "$COUNT" ]; do
    shader "$SHADER"
    sleep "$ON"
    shader "$restore"
    i=$((i + 1))
    [ "$i" -lt "$COUNT" ] && sleep "$OFF"
done
