#!/usr/bin/env bash
# dotfiles-deploy - converge ~/ onto the TRACKED source by turning copies into links.
#
# THE BUG THIS EXISTS FOR
# -----------------------
# Two repos stow into the same $HOME: the public ~/.dotfiles and the private overlay
# ~/.dotfiles-private. When a file moved from public to private, the public tree kept a
# PHYSICAL copy of it - gitignored there, so nothing in the public repo ever complains
# about it again. $HOME still points at the public tree (directly, or through a folded
# directory link like ~/.config/systemd -> ../.dotfiles/.config/systemd), so that orphaned
# copy is what actually runs, while the tracked source in the private repo is what gets
# reviewed and merged. The two then drift, silently, forever.
#
# Measured on this machine 2026-08-09: 56 of the private repo's 299 tracked files have a
# physical twin in the public tree, and 53 private deploy paths resolve to the public copy
# rather than to the tracked source. Only 5 of those had drifted in CONTENT yet. The other
# 48 are the same latent bug that has simply not been edited since the split.
#
# The worst instance found: ~/.config/systemd/user/agentctl@.service, which is what systemd
# actually executes, was a 07-27 copy in the public tree missing the telemetry fix merged in
# the private repo on 08-05 (3b80c8f, "source the Claude OTel env, so runners are measurable
# at all"). Every headless runner had been starting without telemetry for four days, and
# nothing anywhere reported an error.
#
# WHY dotfiles-drift CANNOT CLOSE IT
# ----------------------------------
# dotfiles-drift DETECTS. It reports MIRROR findings and is deliberately left alone (a
# Sentinel watch calls `dotfiles-drift --quiet`). It only looks at .local/bin, .local/lib and
# .config/systemd/user, so it misses e.g. .claude/commands/dream.md, and it only fires
# once the content has ALREADY diverged. It never repairs.
#
# This script is the converging half: after `--apply`, `--check` is clean.
#
# WHAT IT DOES
# ------------
#   1. Builds a manifest of every path each repo actually DEPLOYS: tracked, minus whatever
#      that repo's .stow-local-ignore excludes. A tracked symlink can only be MISSING (git
#      stores those as mode 120000 blobs holding the link target, so diffing one against a
#      resolved file is a guaranteed false positive - the same 15-false-positives lesson
#      dotfiles-drift records).
#   2. A path deployed by BOTH repos is a HARD ERROR, not a precedence rule. Ambiguous
#      ownership is the disease; quietly picking a winner is how it hid for six weeks.
#      (In practice there is nothing to pick: README.md, .gitignore and .stow-local-ignore
#      are tracked in both repos and stow-ignored by both, so they never deploy at all.)
#   3. Symlinks only, never copies. Copying a file to "fix" it creates a second source of
#      truth, which is the original bug. Where the deployed content is a physical file, it
#      shows the diff against the tracked source and replaces the file with a link to it.
#   4. Every link it writes is the RELATIVE link stow writes (lib/stow-link.sh). An absolute
#      link resolves the same but stow does not own it, and one aborts the whole `stow .`
#      run, so a new file never deploys. Such a link reads ABSLINK and --apply rewrites it.
#   5. A MISSING path gets a link per file, as `stow --no-folding` writes it, except where
#      that cannot work or would litter the other repo: there one finding names the directory,
#      and one link serves it. See fold_point.
#   6. A FOLDED directory (a directory link into a repo that tools write through) is unfolded
#      the way `stow --no-folding` lays it out: a link per deploy path, the ignored runtime
#      entries moved out of the checkout into $HOME, the other repo's twins removed. A build
#      cache (a directory holding a CACHEDIR.TAG, as cargo's target/ does) stays in the checkout:
#      dotfiles-autopull builds there, and ~/.local/bin links point into it. A tracked absolute
#      link stow ignores (an enable into /usr/lib) is kept as it is; any other
#      tracked path stow ignores blocks it. Only a full --apply does it, never --missing. See unfold.
#   7. A STALE link (dangling, into a repo) is removed; --missing does that too.
#   8. A RUNTIME directory (a link to a checkout directory no repo tracks) moves out of the
#      checkout whole, under a full --apply only.
#
# The tracked source always wins. When the physical copy differs it is backed up first,
# under $XDG_STATE_HOME/dotfiles-deploy/backup/<stamp>/, because its content exists in no
# repo's history and cannot be recovered any other way.
#
# WORKING TREE, NOT origin/main
# -----------------------------
# This reads `git ls-files` - the working tree, which is what stow deploys. That is a
# deliberate split of concerns from dotfiles-drift, which compares against origin/main to
# answer "is what is MERGED deployed". Two questions, two answers:
#   dotfiles-drift   is the checked-out tree behind what was merged?
#   dotfiles-deploy  does ~/ point at the checked-out tree?
# Both must be clean for merged to equal running.
#
# INTERFACE
# ---------
#   dotfiles-deploy            same as --check (the default is never destructive)
#   dotfiles-deploy --check    read-only report; exit 1 if there is work to do
#   dotfiles-deploy --apply    do the repair, then re-check; exit 1 if it did not converge
#   dotfiles-deploy --quiet    print nothing; exit 1 if there is work to do (for a watch)
#   dotfiles-deploy --json     machine-readable report
#   dotfiles-deploy --missing  with any of the above: only MISSING and STALE paths, so --apply
#                              attaches a link where nothing resolves, prunes a dangling one, and
#                              never converts a copy or unfolds a directory. Safe to run
#                              unattended; every dotfiles-autopull pass runs `--apply --missing`,
#                              so a newly tracked file is linked however its checkout was pulled,
#                              and setup_dotfiles_private runs it after the overlay's first stow.
#   dotfiles-deploy --only <dir>  with any of the above, repeatable: only findings at or under
#                              <dir> (relative to $HOME), or the fold above it, e.g. one fold
#                              while its app is closed.
#
# Exit codes:  0 clean   1 work to do / did not converge   2 refused (see below)
#
# It REFUSES (2) rather than reporting clean when a repo is present but enumerates zero
# deploy paths, or when two repos claim the same path. "Nothing to check" and "everything
# passed" must not print the same thing - every failure in this repo's tooling has been a
# silent success.
set -uo pipefail

# shellcheck source=../lib/dotfiles-repos.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/dotfiles-repos.sh"
# Anchored to $HOME, deliberately NOT to $XDG_STATE_HOME. This tool's whole subject is one
# particular $HOME, so its backups have to land in the same one it is rewriting. Honouring
# XDG_STATE_HOME would let a run pointed at $HOME=X drop the only surviving copy of X's
# files into someone else's state dir - which is not hypothetical: writing this script's own
# test suite did exactly that, because XDG_STATE_HOME is inherited by the sandbox while HOME
# is redirected. Same class of leak as .dotfiles#220.
BACKUP_ROOT="$HOME/.local/state/dotfiles-deploy/backup"

MODE=check
FORMAT=text
ONLY_MISSING=0
ONLY_PATHS=()

# Field separator for the internal record arrays. A unit separator rather than the `|` a
# reader might expect, because these records carry filesystem paths and `|` is a legal
# character in one. Nothing here should be able to be broken by a weird filename.
SEP=$'\x1f'

# ── stow's ignore rules ──────────────────────────────────────────────────────
# Re-derived empirically against GNU Stow 2.4.1 rather than from the man page, because
# three of the four rules below are not obvious from reading it:
#
#   1. A pattern containing `/` is matched against the path relative to the package root
#      WITH A LEADING SLASH ("/.config/hypr"). A pattern without one is matched against the
#      BASENAME of each component.
#   2. Every pattern is implicitly anchored at both ends. Bare `notes` does not match
#      `notes.txt`; bare `hypr` does not match `xhyprx`.
#   3. Ignoring a directory prunes its whole subtree.
#   4. The package's own top-level .stow-local-ignore is ALWAYS ignored, even though the
#      public repo's list does not mention it. This is the rule that decides whether
#      .stow-local-ignore counts as a dual-owned deploy path. It does not.
#
# Consequence of 1 + 2 together: `^/README\.md$` excludes only the top-level README, and
# .local/bin/README.md would still deploy. That precision matters here, because getting it
# wrong in either direction invents a conflict or hides one.
#
# stow's patterns are Perl regexes and these are matched with bash ERE. Every pattern in
# both repos is a plain anchored literal, so the dialects agree; anything fancier would
# need re-checking.

# stow's built-in list, used only when a repo ships no .stow-local-ignore. Neither repo
# here is in that state, but a third one might be, and defaulting to "ignore nothing"
# would silently claim ~40 junk paths as deploy paths.
STOW_DEFAULT_IGNORE=(
  'RCS' '.+,v' 'CVS' '\.\#.+' '\.cvsignore' '\.svn' '_darcs' '\.hg'
  '\.git' '\.gitignore' '\.gitmodules' '.+~' '\#.*\#'
  '^/README.*' '^/LICENSE.*' '^/COPYING'
)

IGNORE_PATS=()

# load_ignore <repo-dir> - fill IGNORE_PATS from that repo's .stow-local-ignore.
load_ignore() {
  local repo="$1" file="$1/.stow-local-ignore" line
  IGNORE_PATS=()
  if [ ! -f "$file" ]; then
    IGNORE_PATS=("${STOW_DEFAULT_IGNORE[@]}")
    return 0
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line#"${line%%[![:space:]]*}"}"   # ltrim
    line="${line%"${line##*[![:space:]]}"}"   # rtrim
    [ -z "$line" ] && continue
    case "$line" in '#'*) continue ;; esac
    IGNORE_PATS+=("$line")
  done < "$file"
  return 0
}

# pat_matches <pattern> <string> - one pattern, implicitly anchored at both ends.
# The explicit ^ and $ that stow's own lists carry are stripped before re-anchoring, so
# `^/\.git$` and `/\.git` behave identically instead of depending on how ERE happens to
# treat an anchor nested inside a group.
pat_matches() {
  local pat="$1" s="$2"
  pat="${pat#^}"
  pat="${pat%\$}"
  [[ "$s" =~ ^(${pat})$ ]]
}

# stow_ignored <path> - would stow skip this path, given the loaded IGNORE_PATS?
# Every ancestor is tested, not just the path itself: rule 3 above means an ignored
# directory takes its whole subtree with it.
#
# The components are walked with parameter expansion rather than by splitting on IFS,
# because a filename here may legitimately contain a space (this repo's own test sandbox
# lives under a path with one, on purpose) and an IFS split would quietly mangle it.
stow_ignored() {
  local path="$1" rest="$1" prefix="" comp pat
  # Rule 4: the package's own ignore file never deploys.
  [ "$path" = ".stow-local-ignore" ] && return 0
  while [ -n "$rest" ]; do
    comp="${rest%%/*}"
    prefix="${prefix:+$prefix/}$comp"
    for pat in "${IGNORE_PATS[@]}"; do
      case "$pat" in
        */*) pat_matches "$pat" "/$prefix" && return 0 ;;
        *)   pat_matches "$pat" "$comp"    && return 0 ;;
      esac
    done
    if [ "$rest" = "$comp" ]; then rest=""; else rest="${rest#*/}"; fi
  done
  return 1
}

# ── the manifest ─────────────────────────────────────────────────────────────
# MANIFEST holds "path<SEP>owner-name<SEP>owner-dir<SEP>git-mode". OWNER_OF maps a path to the
# name of the repo that claims it, which is how a second claim is detected. HOLDS_IGNORED names
# each "<owner-dir>/<dir>" with a tracked path under it that stow skips.

declare -A OWNER_OF=()
declare -A HOLDS_IGNORED=()
# REPO_NAME maps each repo dir that enumerated to its name (public, private).
declare -A REPO_NAME=()
MANIFEST=()
CONFLICTS=()
SKIPPED_REPOS=()

# add_repo <name> <dir>
add_repo() {
  local name="$1" dir="$2" mode rest path up n=0
  if ! is_repo_root "$dir"; then
    SKIPPED_REPOS+=("$name${SEP}$dir")
    return 0
  fi
  REPO_NAME["$dir"]="$name"
  load_ignore "$dir"
  while IFS= read -r -d '' rest; do
    mode="${rest%% *}"
    path="${rest#*$'\t'}"
    [ -n "$path" ] || continue
    n=$((n + 1))
    if stow_ignored "$path"; then
      up="$path"
      while [ "$up" != "${up%/*}" ]; do
        up="${up%/*}"
        HOLDS_IGNORED["$dir/$up"]=1
      done
      continue
    fi
    # A tracked symlink that dangles in its own repo (a submodule not checked out) has nothing
    # to attach, so it is no deploy path.
    [ "$mode" = 120000 ] && [ ! -e "$dir/$path" ] && continue
    if [ -n "${OWNER_OF[$path]:-}" ]; then
      CONFLICTS+=("$path${SEP}${OWNER_OF[$path]}${SEP}$name")
      continue
    fi
    OWNER_OF["$path"]="$name"
    MANIFEST+=("$path${SEP}$name${SEP}$dir${SEP}$mode")
  done < <(git -C "$dir" ls-files -sz 2>/dev/null)

  # A repo that is present but enumerates NOTHING means git failed, not that the repo is
  # empty. Reporting "clean" off an empty input list is how tests/lint.sh once passed
  # having checked zero files.
  if [ "$n" -eq 0 ]; then
    printf 'dotfiles-deploy: refusing to run - %s (%s) enumerated ZERO tracked files.\n' "$name" "$dir" >&2
    printf '                 That is a broken `git ls-files`, not a clean repo.\n' >&2
    exit 2
  fi
  return 0
}

# build_manifest - both repos, then the two refusals that stop a broken run reading clean.
build_manifest() {
  local c cp ca cb
  add_repo public  "$PUB"
  add_repo private "$PRIV"

  if [ "${#CONFLICTS[@]}" -gt 0 ]; then
    printf 'dotfiles-deploy: refusing to run - %s path(s) are deployed by BOTH repos.\n\n' "${#CONFLICTS[@]}" >&2
    for c in "${CONFLICTS[@]}"; do
      IFS="$SEP" read -r cp ca cb <<< "$c"
      printf '  CONFLICT  %-52s claimed by %s and %s\n' "$cp" "$ca" "$cb" >&2
    done
    cat >&2 <<'EOF'

  Which repo owns a path has to be a fact, not a coin toss. Deleting the loser's copy
  makes it one; adding the path to the loser's .stow-local-ignore makes it one too.
  This script will not choose for you - picking a winner silently is the whole bug.
EOF
    exit 2
  fi

  # Both repos absent (or both un-gitted) leaves nothing to check. Same reasoning as the
  # per-repo zero guard: an empty manifest is a broken run, not a clean one.
  if [ "${#MANIFEST[@]}" -eq 0 ]; then
    printf 'dotfiles-deploy: refusing to run - the manifest is EMPTY (no repo enumerated a deploy path).\n' >&2
    printf '                 Looked for: %s and %s\n' "$PUB" "$PRIV" >&2
    exit 2
  fi
  return 0
}

# ── classification ───────────────────────────────────────────────────────────
# FINDINGS holds "status<SEP>owner<SEP>path<SEP>physical<SEP>detail".
#
#   OK       $HOME/<path> resolves to the owning repo's tracked source.
#   MISSING  $HOME/<path> does not resolve at all - stow has not run, or its link dangles.
#   MIRROR   $HOME/<path> resolves to a real file somewhere ELSE. That other file is the
#            deployed copy, and it is the thing that has to become a link.
#   ABSLINK  the first link on $HOME/<path> (its own, or a folded directory's) is ABSOLUTE
#            and resolves to the same path in the owning repo. It serves the right file, but
#            stow does not own it, so `stow .` aborts and no new file in that repo deploys.
#   FOLDED   $HOME/<dir> is one directory link to the same <dir> in a repo (stow without
#            --no-folding), and that repo dir holds paths it does not track: whatever a tool
#            writes under it (a `systemctl --user enable` wants link, a game's saves, the
#            other repo's files attached as links) lands in the checkout. Paths under it are
#            not classified one by one; the unfold lays every one of them out.
#   STALE    a dangling link in a real directory of $HOME that points into a repo: the file
#            it served was deleted or moved. A folded directory dropped such a file with it;
#            a per-file link stays behind, and a hook runner or systemd meets a dead entry.
#   RUNTIME  a link in a real directory of $HOME to the same directory in a repo that tracks
#            nothing there (a tool's state dir that was once folded with tracked files).
#
# The comparison is on the RESOLVED path, not on whether $HOME/<path> is itself a symlink.
# A folded directory link serves its files correctly, so OK does not assert per-file links;
# FOLDED reports the fold itself, and only when something is written through it.

FINDINGS=()

# in_repo_tree <abs-dir> - does this directory physically sit in either repo's checkout?
in_repo_tree() {
  local abs="$1/" repo
  for repo in "$PUB" "$PRIV"; do
    case "$abs" in "$(readlink -f -- "$repo")"/*) return 0 ;; esac
  done
  return 1
}

# fold_point <path> <repo-dir> - the directory of a MISSING <path> that takes one link instead
# of a link per file, or nothing. It is the first component with nothing at it in $HOME, when:
#   - its parent is a folded link into a repo: creating it there would leave a physical
#     directory of this repo's files in the other repo's checkout; or
#   - it is a dangling link, which `mkdir -p` cannot get past: the directory moved repos and
#     its old link stayed behind.
# A directory link deploys all of it, so one holding a stow-ignored path gets no fold.
fold_point() {
  local rest="$1" repo="$2" prefix="" at
  while [ "$rest" != "${rest#*/}" ]; do
    prefix="${prefix:+$prefix/}${rest%%/*}"
    rest="${rest#*/}"
    at="$HOME/$prefix"
    [ -e "$at" ] && continue
    [ -d "$repo/$prefix" ] && [ -z "${HOLDS_IGNORED[$repo/$prefix]:-}" ] || return 0
    if [ -L "$at" ] || in_repo_tree "$(readlink -f -- "${at%/*}")"; then
      printf '%s\n' "$prefix"
    fi
    return 0
  done
}

# first_link <path> - set FIRST_LINK to the shortest prefix of <path> that is a symlink under $HOME,
# or to nothing. A variable, not output: it runs per deploy path, and a subshell each is seconds.
FIRST_LINK=""
first_link() {
  local rest="$1" prefix="" comp
  FIRST_LINK=""
  while [ -n "$rest" ]; do
    comp="${rest%%/*}"
    prefix="${prefix:+$prefix/}$comp"
    [ -L "$HOME/$prefix" ] && { FIRST_LINK="$prefix"; return 0; }
    if [ "$rest" = "$comp" ]; then rest=""; else rest="${rest#*/}"; fi
  done
  return 0
}

# dev_of <path> - the device number of <path>, GNU stat then BSD stat.
dev_of() {
  stat -c %d -- "$1" 2>/dev/null || stat -f %d -- "$1" 2>/dev/null
}

# find_folds - fill FOLD_REPO: each directory link $HOME/<dir> -> <repo>/<dir> on the way to a
# deploy path, mapped to the repo it points into. A link to a different path (a skill linked from
# its category dir, an account dir's commands) is not a fold: stow never writes one.
declare -A FOLD_REPO=() FOLD_OTHER=()
find_folds() {
  local rec path dir lp real r
  declare -A seen=()
  local -a under=()
  FOLD_REPO=(); FOLD_OTHER=()
  for rec in "${MANIFEST[@]}"; do
    IFS="$SEP" read -r path _ dir _ <<< "$rec"
    first_link "$path"; lp="$FIRST_LINK"
    [ -n "$lp" ] && [ "$lp" != "$path" ] || continue
    under+=("$lp${SEP}$dir")
    [ -z "${seen[$lp]:-}" ] || continue
    seen["$lp"]=1
    real="$(readlink -f -- "$HOME/$lp")"
    [ -d "$real" ] || continue
    for r in "${!REPO_NAME[@]}"; do
      [ "$real" = "$(readlink -f -- "$r/$lp")" ] && FOLD_REPO["$lp"]="$r"
    done
  done
  # How many deploy paths of the OTHER repo each fold covers.
  for rec in ${under[@]+"${under[@]}"}; do
    IFS="$SEP" read -r lp dir <<< "$rec"
    [ -n "${FOLD_REPO[$lp]:-}" ] && [ "${FOLD_REPO[$lp]}" != "$dir" ] &&
      FOLD_OTHER["$lp"]=$(( ${FOLD_OTHER[$lp]:-0} + 1 ))
  done
  return 0
}

# fold_findings - one FOLDED finding per fold that something is written through: an untracked
# path in its repo dir (ignored ones included), or a deploy path of the other repo under it,
# which can only attach as a link inside this checkout. FOLDED_AT names each, for under_folded.
# untracked_under <repo-dir> <dir> - the untracked entries under <dir>, NUL-separated; `--directory`
# collapses a wholly untracked directory to one entry.
untracked_under() {
  git -C "$1" ls-files -z --others --directory -- ":(literal)$2" 2>/dev/null
}

# is_cache <path> - a real directory tagged per the Cache Directory Tagging Specification
# (bford.info/cachedir), as cargo tags target/. dotfiles-autopull builds in the checkout, not
# through a fold, and links point into it (~/.local/bin/<tool> -> <checkout>/.../target/release/<tool>),
# so an unfold leaves it where it is: moved, those links dangle and the next build starts cold.
is_cache() {
  [ -d "$1" ] && [ ! -L "$1" ] && [ -f "$1/CACHEDIR.TAG" ] && [ ! -L "$1/CACHEDIR.TAG" ] &&
    [ "$(head -c 43 -- "$1/CACHEDIR.TAG" 2>/dev/null)" = 'Signature: 8a477f597d28d172789f06886806bc55' ]
}

declare -A FOLDED_AT=()
fold_findings() {
  local lp repo n o
  FOLDED_AT=()
  while IFS= read -r lp; do
    [ -n "$lp" ] || continue
    repo="${FOLD_REPO[$lp]}"
    n="$(untracked_under "$repo" "$lp" | tr -cd '\0' | wc -c | tr -d ' ')"
    o="${FOLD_OTHER[$lp]:-0}"
    [ "$n" -gt 0 ] || [ "$o" -gt 0 ] || continue
    FOLDED_AT["$lp"]=1
    FINDINGS+=("FOLDED${SEP}${REPO_NAME[$repo]}${SEP}$lp${SEP}$HOME/$lp${SEP}directory link: $n untracked and $o other-repo path(s) under it sit in the checkout")
  done < <(printf '%s\n' "${!FOLD_REPO[@]}" | sort)
  return 0
}

# under_folded <path> - is <path> under a fold that fold_findings reported?
under_folded() {
  local rest="$1" prefix=""
  while [ "$rest" != "${rest#*/}" ]; do
    prefix="${prefix:+$prefix/}${rest%%/*}"
    rest="${rest#*/}"
    [ -n "${FOLDED_AT[$prefix]:-}" ] && return 0
  done
  return 1
}

# repo_of_target <link> - the repo dir a link's text points into, or nothing. The target is
# missing for a dangling link, so its deepest existing directory is resolved instead.
repo_of_target() {
  local text d phys r
  text="$(readlink -- "$1")" || return 0
  case "$text" in /*) d="$text" ;; *) d="$(dirname -- "$1")/$text" ;; esac
  d="${d%/*}"
  while [ -n "$d" ] && ! phys="$(cd -P -- "$d" 2>/dev/null && pwd -P)"; do d="${d%/*}"; done
  [ -n "$d" ] || return 0
  for r in "${!REPO_NAME[@]}"; do
    case "$phys/" in "$(readlink -f -- "$r")"/*) printf '%s\n' "$r"; return 0 ;; esac
  done
  return 0
}

# tracked_anywhere <rel> - true when any repo tracks a path at or under <rel>.
tracked_anywhere() {
  local r
  for r in "${!REPO_NAME[@]}"; do
    [ -n "$(git -C "$r" ls-files -- ":(literal)$1" 2>/dev/null)" ] && return 0
  done
  return 1
}

# link_findings - the links in each real directory of $HOME that holds a deploy path, which no
# deploy path accounts for: a STALE finding per dangling one into a repo, and a RUNTIME finding
# per directory link to the same path in a repo that tracks nothing there. A directory a repo
# deleted whole is not looked in: its parent is.
link_findings() {
  local rec path d l r rel real
  declare -A dirs=() deploys=()
  local -a starts=()
  for rec in "${MANIFEST[@]}"; do
    IFS="$SEP" read -r path _ _ _ <<< "$rec"
    deploys["$path"]=1
    d=""; [ "$path" != "${path%/*}" ] && d="${path%/*}"
    while :; do
      dirs["/$d"]=1
      [ -n "$d" ] || break
      if [ "$d" != "${d%/*}" ]; then d="${d%/*}"; else d=""; fi
    done
  done
  # Keyed "/<dir>", so $HOME itself is "/": bash refuses an empty key.
  for d in "${!dirs[@]}"; do
    d="${d#/}"
    [ -z "$d" ] || { [ -d "$HOME/$d" ] && first_link "$d" && [ -z "$FIRST_LINK" ]; } || continue
    starts+=("$HOME${d:+/$d}")
  done
  [ "${#starts[@]}" -gt 0 ] || return 0
  while IFS= read -r -d '' l; do
    rel="${l#"$HOME"/}"
    if [ -e "$l" ]; then
      # --missing drops RUNTIME, so the unattended pass does not pay for it.
      [ "$ONLY_MISSING" = 0 ] && [ -d "$l" ] && [ -z "${dirs[/$rel]:-}" ] || continue
      real="$(readlink -f -- "$l")"
      for r in "${!REPO_NAME[@]}"; do
        [ "$real" = "$(readlink -f -- "$r/$rel")" ] || continue
        # A nested clone kept in the checkout (a project of its own) is not runtime.
        [ -e "$r/$rel/.git" ] && continue
        # Either repo: a directory one tracks (stow-ignored on this OS, say) is not runtime.
        tracked_anywhere "$rel" && continue
        FINDINGS+=("RUNTIME${SEP}${REPO_NAME[$r]}${SEP}$rel${SEP}$l${SEP}directory link to a checkout directory no repo tracks: all of it is runtime")
      done
      continue
    fi
    # A deploy path that dangles is MISSING, and its repair replaces the link.
    [ -n "${deploys[$rel]:-}" ] && continue
    r="$(repo_of_target "$l")"
    [ -n "$r" ] || continue
    FINDINGS+=("STALE${SEP}${REPO_NAME[$r]}${SEP}${l#"$HOME"/}${SEP}$l${SEP}dangling link into the checkout: the file it served was deleted or moved")
  done < <(find "${starts[@]}" -mindepth 1 -maxdepth 1 -type l -print0 2>/dev/null | sort -z)
  return 0
}

classify_all() {
  FINDINGS=()
  local rec path owner dir mode src tgt real_src real_tgt lp fold
  declare -A SEEN_ABS=() SEEN_FOLD=()
  # --missing leaves folds alone: an unfold moves files, and that run is unattended.
  if [ "$ONLY_MISSING" = 1 ]; then FOLDED_AT=(); else find_folds; fold_findings; fi
  # Before the per-path findings: a pruned dangling directory link lets a MISSING path under it
  # attach per file in the same run.
  link_findings
  for rec in "${MANIFEST[@]}"; do
    IFS="$SEP" read -r path owner dir mode <<< "$rec"
    under_folded "$path" && continue
    src="$dir/$path"
    tgt="$HOME/$path"
    real_src="$(readlink -f -- "$src" 2>/dev/null)"

    if [ ! -e "$tgt" ]; then
      fold="$(fold_point "$path" "$dir")"
      if [ -n "$fold" ]; then
        [ -n "${SEEN_FOLD[$fold]:-}" ] \
          || FINDINGS+=("MISSING${SEP}$owner${SEP}$fold${SEP}$HOME/$fold${SEP}directory, one link serves every path under it")
        SEEN_FOLD["$fold"]=1
      elif [ -L "$tgt" ]; then
        FINDINGS+=("MISSING${SEP}$owner${SEP}$path${SEP}$tgt${SEP}symlink dangles (target missing)")
      else
        FINDINGS+=("MISSING${SEP}$owner${SEP}$path${SEP}$tgt${SEP}not linked into \$HOME (stow has not run)")
      fi
      continue
    fi
    # git stores a symlink as a mode-120000 blob holding the link TARGET, so comparing it to the
    # resolved file on disk always reports a difference - 15 false positives from systemd .wants/
    # entries alone the last time someone tried. Skipped here, exactly as dotfiles-drift does.
    [ "$mode" = 120000 ] && continue

    real_tgt="$(readlink -f -- "$tgt" 2>/dev/null)"
    if [ -n "$real_src" ] && [ "$real_tgt" = "$real_src" ]; then
      # The first link on the path is the one stow meets: the file's own, or a folded
      # directory's. Absolute and pointing at this repo's copy of that same path: ABSLINK.
      first_link "$path"; lp="$FIRST_LINK"
      if [ -n "$lp" ] && [ -z "${SEEN_ABS[$lp]:-}" ] && [[ "$(readlink -- "$HOME/$lp")" == /* ]] \
         && [ "$(readlink -f -- "$HOME/$lp")" = "$(readlink -f -- "$dir/$lp")" ]; then
        SEEN_ABS["$lp"]=1
        FINDINGS+=("ABSLINK${SEP}$owner${SEP}$lp${SEP}$HOME/$lp${SEP}absolute link, stow does not own it, so \`stow .\` aborts")
      fi
      continue
    fi

    local detail
    if cmp -s -- "$src" "$real_tgt" 2>/dev/null; then
      # Identical today. This is the LATENT half of the bug and the reason --check is
      # noisier than dotfiles-drift on purpose: nothing is wrong yet, and nothing will
      # report it on the day the tracked source is edited and this copy is not.
      detail="served by a copy at ${real_tgt/#$HOME/\~} (same content, will drift on the next edit)"
    else
      detail="served by a copy at ${real_tgt/#$HOME/\~} (CONTENT DIFFERS from the tracked source)"
    fi
    FINDINGS+=("MIRROR${SEP}$owner${SEP}$path${SEP}$real_tgt${SEP}$detail")
  done
  return 0
}

# ── repair ───────────────────────────────────────────────────────────────────

# tracked_somewhere <abs-path> - is this file tracked by either repo?
# The guard on every write. Replacing a TRACKED file with a symlink would delete real
# source from a real repo, which is a far worse outcome than the drift being fixed. In a
# clean two-repo split this can only fire for a path that is tracked but stow-ignored.
tracked_somewhere() {
  local abs="$1" repo rel
  for repo in "$PUB" "$PRIV"; do
    # Same worktree-blind test as add_repo. Getting this wrong here is the worse half: this
    # is the guard that stops a write from deleting tracked repo source, and a repo it
    # cannot recognise is a repo whose files it will happily overwrite.
    is_repo_root "$repo" || continue
    case "$abs" in
      "$repo"/*)
        rel="${abs#"$repo"/}"
        git -C "$repo" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1 && return 0
        ;;
    esac
  done
  return 1
}

APPLIED=0
FAILED=0
STAMP="$(date +%Y%m%dT%H%M%S)"

# convert <physical-file> <tracked-source> <path> - the operation this script exists for.
convert() {
  local phys="$1" src="$2" path="$3" backup

  if [ -d "$phys" ]; then
    printf '  SKIP  %s - the deployed thing is a DIRECTORY, not a file\n' "$path" >&2
    FAILED=$((FAILED + 1)); return 1
  fi
  if tracked_somewhere "$phys"; then
    printf '  SKIP  %s - the deployed copy at %s is TRACKED; refusing to delete repo source\n' "$path" "$phys" >&2
    FAILED=$((FAILED + 1)); return 1
  fi

  # Back up only when the content differs. When it matches, the copy's content already
  # exists in the owning repo and a backup would just be litter. When it differs, this is
  # the only copy of whatever was actually running and it is in no repo's history.
  if ! cmp -s -- "$src" "$phys" 2>/dev/null; then
    backup="$BACKUP_ROOT/$STAMP/$path"
    mkdir -p -- "$(dirname -- "$backup")" || { FAILED=$((FAILED + 1)); return 1; }
    cp -p -- "$phys" "$backup" || { FAILED=$((FAILED + 1)); return 1; }
    printf '  backed up %s -> %s\n' "$path" "$backup"
  fi

  if stow_link "$phys" "$src"; then
    printf '  linked    %s -> %s\n' "${phys/#$HOME/\~}" "${src/#$HOME/\~}"
    APPLIED=$((APPLIED + 1)); return 0
  fi
  FAILED=$((FAILED + 1)); return 1
}

# attach <target> <tracked-source> <path> - the MISSING case. Creating the parent may land inside
# the OTHER repo's tree when that parent is a folded directory link; that is correct for this
# layout and is exactly how the committed .local/bin/* overlay links already resolve.
attach() {
  local tgt="$1" src="$2" path="$3" parent
  parent="$(dirname -- "$tgt")"
  mkdir -p -- "$parent" || { FAILED=$((FAILED + 1)); return 1; }
  if tracked_somewhere "$(readlink -f -- "$parent")/$(basename -- "$tgt")"; then
    printf '  SKIP  %s - would overwrite a TRACKED path\n' "$path" >&2
    FAILED=$((FAILED + 1)); return 1
  fi
  if stow_link "$tgt" "$src"; then
    printf '  linked    %s -> %s\n' "${tgt/#$HOME/\~}" "${src/#$HOME/\~}"
    APPLIED=$((APPLIED + 1)); return 0
  fi
  FAILED=$((FAILED + 1)); return 1
}

# mode_of <path> - the permission bits of <path>, GNU stat then BSD stat.
mode_of() {
  stat -c %a -- "$1" 2>/dev/null || stat -f %Lp -- "$1" 2>/dev/null
}

# UNFOLD_OTHER maps each deploy path of the other repo under the directory being unfolded to
# that repo's dir; other_under <entry> says whether any of them sits below <entry>.
declare -A UNFOLD_OTHER=()
other_under() {
  local p
  for p in "${!UNFOLD_OTHER[@]}"; do [[ "$p" == "$1"/* ]] && return 0; done
  return 1
}

# move_entry <from> <to> - rename one runtime entry out of the checkout. A relative symlink is
# re-pointed at what it served, since the same text resolves elsewhere one level up.
move_entry() {
  local from="$1" to="$2" t=""
  [ -e "$to" ] || [ -L "$to" ] && return 1
  mkdir -p -- "$(dirname -- "$to")" || return 1
  if [ -L "$from" ] && [[ "$(readlink -- "$from")" != /* ]]; then t="$(readlink -f -- "$from")"; fi
  mv -- "$from" "$to" || return 1
  if [ -n "$t" ] && [ -e "$t" ] && [ "$(readlink -f -- "$to")" != "$t" ]; then ln -sfn -- "$t" "$to"; fi
  return 0
}

# unfold <dir> <repo-dir> - the FOLDED repair: lay $HOME/<dir> out the way `stow --no-folding`
# does. A sibling real directory gets a stow link per deploy path of either repo under <dir>, the
# ignored runtime entries tools wrote through the fold move into it, and a rename swaps it in.
# The other repo's links and copies left in the checkout (twins) go last. An untracked entry git
# does not ignore may be work in progress, so it blocks the directory and nothing moves.
unfold() {
  local lp="$1" repo="$2" new="$HOME/$1.unfold-$STAMP" old="$HOME/$1.folded-$STAMP"
  local rec path dir e c i src backup ndone=0
  local -a links=() queue=() twins=() moves=() blockers=() expanded=() moved=() keeps=() caches=()
  UNFOLD_OTHER=()
  for rec in "${MANIFEST[@]}"; do
    IFS="$SEP" read -r path _ dir _ <<< "$rec"
    [[ "$path" == "$lp"/* ]] || continue
    links+=("$path$SEP$dir")
    [ "$dir" != "$repo" ] && UNFOLD_OTHER["$path"]="$dir"
  done
  while IFS= read -r -d '' e; do queue+=("${e%/}"); done \
    < <(untracked_under "$repo" "$lp")
  # `--directory` collapses a wholly untracked directory to one entry, so each is judged here:
  # git's own ignored listing omits ignored files inside an untracked directory.
  while [ "${#queue[@]}" -gt 0 ]; do
    e="${queue[0]}"; queue=("${queue[@]:1}")
    if [ -n "${UNFOLD_OTHER[$e]:-}" ]; then
      twins+=("$e")
    elif [ -L "$repo/$e" ] && other_under "$e"; then
      twins+=("$e")
    elif [ -e "$repo/$e/.git" ]; then
      blockers+=("$e/ (a clone)")
    elif [ "$e" = "$lp" ] || { [ -d "$repo/$e" ] && [ ! -L "$repo/$e" ] && other_under "$e"; }; then
      expanded+=("$e")
      while IFS= read -r -d '' c; do queue+=("${c#"$repo"/}"); done \
        < <(find "$repo/$e" -mindepth 1 -maxdepth 1 -print0 | sort -z)
    elif [ -d "$repo/$e" ] && [ ! -L "$repo/$e" ]; then
      if [ -z "$(git -C "$repo" ls-files --others --exclude-standard -- ":(literal)$e/" 2>/dev/null)" ]; then
        if is_cache "$repo/$e"; then caches+=("$e"); else moves+=("$e"); fi
      else
        blockers+=("$e/")
      fi
    elif git -C "$repo" check-ignore -q -- "$e" 2>/dev/null; then
      moves+=("$e")
    else
      blockers+=("$e")
    fi
  done
  if [ "${#blockers[@]}" -gt 0 ]; then
    printf '  SKIP  %s - %s untracked path(s) git does not ignore, maybe work in progress: %s\n' \
      "$lp" "${#blockers[@]}" "${blockers[*]:0:5}" >&2
    FAILED=$((FAILED + 1)); return 1
  fi
  # A tracked path stow ignores reaches $HOME only through the fold. An absolute link (an enable
  # into /usr/lib) is kept as it is; a file would vanish from $HOME, so it blocks the directory.
  load_ignore "$repo"
  while IFS= read -r -d '' e; do
    stow_ignored "$e" || continue
    if [ -L "$repo/$e" ] && [[ "$(readlink -- "$repo/$e")" == /* ]]; then keeps+=("$e"); else blockers+=("$e"); fi
  done < <(git -C "$repo" ls-files -z -- ":(literal)$lp" 2>/dev/null)
  if [ "${#blockers[@]}" -gt 0 ]; then
    printf '  SKIP  %s - %s tracked path(s) stow ignores would leave $HOME: %s\n' \
      "$lp" "${#blockers[@]}" "${blockers[*]:0:5}" >&2
    FAILED=$((FAILED + 1)); return 1
  fi
  if [ -e "$new" ] || [ -L "$new" ] || [ -e "$old" ] || [ -L "$old" ]; then
    printf '  SKIP  %s - %s or %s already exists\n' "$lp" "$new" "$old" >&2
    FAILED=$((FAILED + 1)); return 1
  fi
  # Same filesystem, or every move below is a copy and the swap is not a rename.
  if [ "$(dev_of "$repo/$lp")" != "$(dev_of "$(dirname -- "$HOME/$lp")")" ]; then
    printf '  SKIP  %s - the checkout and $HOME are on different filesystems\n' "$lp" >&2
    FAILED=$((FAILED + 1)); return 1
  fi

  mkdir -m "$(mode_of "$repo/$lp")" -- "$new" || { FAILED=$((FAILED + 1)); return 1; }
  for rec in "${links[@]}"; do
    IFS="$SEP" read -r path dir <<< "$rec"
    c="$new/${path#"$lp"/}"
    mkdir -p -- "$(dirname -- "$c")" && stow_link "$c" "$dir/$path" || { ndone=-1; break; }
  done
  for e in ${keeps[@]+"${keeps[@]}"}; do
    [ "$ndone" -eq 0 ] || break
    c="$new/${e#"$lp"/}"
    mkdir -p -- "$(dirname -- "$c")" && ln -s -- "$(readlink -- "$repo/$e")" "$c" || ndone=-1
  done
  if [ "$ndone" -eq 0 ]; then
    for e in ${moves[@]+"${moves[@]}"}; do
      move_entry "$repo/$e" "$new/${e#"$lp"/}" || { ndone=-1; break; }
      moved+=("$e")
    done
  fi
  if [ "$ndone" -eq 0 ] && mv -- "$HOME/$lp" "$old"; then
    if mv -- "$new" "$HOME/$lp"; then
      rm -f -- "$old"
    else
      mv -- "$old" "$HOME/$lp"; ndone=-1
    fi
  else
    ndone=-1
  fi
  if [ "$ndone" -ne 0 ]; then
    # Roll back: every moved entry returns to the checkout, then only links and the empty
    # directories this run made are removed.
    for e in ${moved[@]+"${moved[@]}"}; do mv -- "$new/${e#"$lp"/}" "$repo/$e"; done
    find "$new" -depth \( -type l -o -type d -empty \) -delete 2>/dev/null
    printf '  FAIL  %s - unfold rolled back, the directory link is unchanged\n' "$lp" >&2
    FAILED=$((FAILED + 1)); return 1
  fi

  for e in ${twins[@]+"${twins[@]}"}; do
    src="${UNFOLD_OTHER[$e]:-}"
    if [ -n "$src" ] && [ -f "$repo/$e" ] && [ ! -L "$repo/$e" ] && ! cmp -s -- "$src/$e" "$repo/$e"; then
      backup="$BACKUP_ROOT/$STAMP/$e"
      mkdir -p -- "$(dirname -- "$backup")" && cp -p -- "$repo/$e" "$backup" || { FAILED=$((FAILED + 1)); continue; }
      printf '  backed up %s -> %s\n' "$e" "$backup"
    fi
    rm -f -- "$repo/$e"
  done
  for (( i=${#expanded[@]}-1; i>=0; i-- )); do rmdir -- "$repo/${expanded[$i]}" 2>/dev/null; done
  # A tool that wrote through the old link during the swap left its entry in the checkout.
  while IFS= read -r -d '' e; do
    e="${e%/}"
    [ -z "${UNFOLD_OTHER[$e]:-}" ] && ! is_cache "$repo/$e" && git -C "$repo" check-ignore -q -- "$e" 2>/dev/null &&
      move_entry "$repo/$e" "$HOME/$e" && moved+=("$e")
  done < <(untracked_under "$repo" "$lp")
  printf '  unfolded  ~/%s: %s link(s), %s runtime entr(ies) moved out of the checkout, %s twin(s) removed' \
    "$lp" "$(( ${#links[@]} + ${#keeps[@]} ))" "${#moved[@]}" "${#twins[@]}"
  [ "${#caches[@]}" -eq 0 ] || printf ', %s build cache(s) kept in the checkout' "${#caches[@]}"
  printf '\n'
  APPLIED=$((APPLIED + 1)); return 0
}

# prune <link> <path> - the STALE case: a dangling link into a checkout serves nothing.
prune() {
  [ -L "$1" ] && [ ! -e "$1" ] || return 0
  if rm -f -- "$1"; then
    printf '  pruned    ~/%s (dangling)\n' "$2"
    APPLIED=$((APPLIED + 1)); return 0
  fi
  FAILED=$((FAILED + 1)); return 1
}

# move_runtime <dir> <repo-dir> - the RUNTIME case: the directory holds nothing any repo tracks,
# so all of it moves out of the checkout to where the link stood, in one rename. An entry git does
# not ignore may be work in progress, and a .git inside is a clone; either blocks it.
move_runtime() {
  local lp="$1" repo="$2" text
  if [ -n "$(git -C "$repo" ls-files --others --exclude-standard -- ":(literal)$lp" 2>/dev/null)" ] ||
     [ -n "$(find "$repo/$lp" -name .git -print -quit 2>/dev/null)" ]; then
    printf '  SKIP  %s - it holds an untracked path git does not ignore, or a clone\n' "$lp" >&2
    FAILED=$((FAILED + 1)); return 1
  fi
  if [ "$(dev_of "$repo/$lp")" != "$(dev_of "$(dirname -- "$HOME/$lp")")" ]; then
    printf '  SKIP  %s - the checkout and $HOME are on different filesystems\n' "$lp" >&2
    FAILED=$((FAILED + 1)); return 1
  fi
  text="$(readlink -- "$HOME/$lp")" || { FAILED=$((FAILED + 1)); return 1; }
  if rm -f -- "$HOME/$lp" && mv -- "$repo/$lp" "$HOME/$lp"; then
    printf '  moved     ~/%s out of the checkout (runtime only)\n' "$lp"
    APPLIED=$((APPLIED + 1)); return 0
  fi
  [ -e "$HOME/$lp" ] || [ -L "$HOME/$lp" ] || ln -s -- "$text" "$HOME/$lp"
  printf '  FAIL  %s - not moved, the directory link is restored\n' "$lp" >&2
  FAILED=$((FAILED + 1)); return 1
}

# relink <link> <tracked-source> <path> - the ABSLINK case: same file, stow's relative form.
# Nothing to back up, the link text is all that changes.
relink() {
  local tgt="$1" src="$2" path="$3"
  if stow_link "$tgt" "$src"; then
    printf '  relinked  ~/%s -> %s\n' "$path" "$(readlink -- "$tgt")"
    APPLIED=$((APPLIED + 1)); return 0
  fi
  FAILED=$((FAILED + 1)); return 1
}

apply_all() {
  local rec status owner path phys dir
  for rec in "${FINDINGS[@]}"; do
    IFS="$SEP" read -r status owner path phys _ <<< "$rec"
    dir="$PUB"; [ "$owner" = private ] && dir="$PRIV"
    case "$status" in
      FOLDED)  unfold  "$path" "${FOLD_REPO[$path]}" ;;
      MIRROR)  convert "$phys" "$dir/$path" "$path" ;;
      MISSING) attach  "$phys" "$dir/$path" "$path" ;;
      ABSLINK) relink  "$phys" "$dir/$path" "$path" ;;
      STALE)   prune   "$phys" "$path" ;;
      RUNTIME) move_runtime "$path" "$dir" ;;
    esac
  done
  return 0
}

# ── reporting ────────────────────────────────────────────────────────────────

# The diff a human needs to see before agreeing to overwrite the running copy. Capped,
# because five of these unabridged is a report nobody reads to the end.
DIFF_CAP=40
show_diffs() {
  local rec status owner path phys dir shown=0
  for rec in "${FINDINGS[@]}"; do
    IFS="$SEP" read -r status owner path phys _ <<< "$rec"
    [ "$status" = MIRROR ] || continue
    dir="$PUB"; [ "$owner" = private ] && dir="$PRIV"
    cmp -s -- "$dir/$path" "$phys" 2>/dev/null && continue
    [ "$shown" -eq 0 ] && printf '\n  --- what is running vs what is tracked ---\n'
    shown=$((shown + 1))
    printf '\n'
    diff -u --label "tracked   $owner/$path" --label "deployed  ${phys/#$HOME/\~}" \
      -- "$dir/$path" "$phys" 2>/dev/null | awk -v n="$DIFF_CAP" 'NR<=n' | sed 's/^/  /'
    printf '  (diff capped at %s lines)\n' "$DIFF_CAP"
  done
  return 0
}

report_text() {
  local rec status owner path detail n="${#FINDINGS[@]}" s sname sdir
  # Name every repo that was NOT examined. A box with no private overlay is a legitimate
  # state, but "clean" has to mean "clean over what I actually looked at" - a report that
  # silently drops half the input reads identically to one that checked everything.
  for s in "${SKIPPED_REPOS[@]:-}"; do
    [ -n "$s" ] || continue
    IFS="$SEP" read -r sname sdir <<< "$s"
    printf 'dotfiles-deploy: NOT CHECKED - %s repo at %s is absent or not a git repo\n' "$sname" "$sdir"
  done
  if [ "$n" -eq 0 ]; then
    if [ "$ONLY_MISSING" = 1 ]; then
      printf 'dotfiles-deploy: clean - none of %s deploy path(s) is missing (copies not checked: --missing)\n' "${#MANIFEST[@]}"
    else
      printf 'dotfiles-deploy: clean - all %s deploy path(s) resolve to their tracked source\n' "${#MANIFEST[@]}"
    fi
    return 0
  fi
  printf 'dotfiles-deploy: %s of %s deploy path(s) do NOT resolve to their tracked source\n\n' \
    "$n" "${#MANIFEST[@]}"
  for rec in "${FINDINGS[@]}"; do
    IFS="$SEP" read -r status owner path _ detail <<< "$rec"
    printf '  %-7s %-8s %-52s %s\n' "$status" "$owner" "$path" "$detail"
  done
  show_diffs
  cat <<'EOF'

  MIRROR  -> a physical copy is serving this path. `dotfiles-deploy --apply` replaces the
             copy with a link to the tracked source (backing it up first if it differs).
  MISSING -> stow has not attached it. --apply links it; `stow --no-folding .` also works.
  ABSLINK -> --apply rewrites the absolute link as the relative one stow writes, so
             `stow --no-folding .` stops aborting on it.
  FOLDED  -> --apply unfolds it: a link per file, runtime entries moved out of the checkout
             into $HOME (a CACHEDIR.TAG build cache stays). An untracked file git does not
             ignore blocks it; commit, ignore or move that file. Close an app whose state
             lives there first, or use --only.
  STALE   -> --apply (and --missing) removes the dangling link.
  RUNTIME -> --apply moves the directory out of the checkout to where its link stood.

  A path listed here that SHOULD NOT deploy at all belongs in the owning repo's
  .stow-local-ignore. Do not add a skip list to this script - a second place that decides
  what deploys is how the first one stopped being true.
EOF
  return 0
}

# shellcheck source=../lib/fmt.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/fmt.sh"
# shellcheck source=../lib/stow-link.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/stow-link.sh"

report_json() {
  local status owner path phys detail i
  printf '{"deploy_paths":%s,"findings":[' "${#MANIFEST[@]}"
  for i in "${!FINDINGS[@]}"; do
    IFS="$SEP" read -r status owner path phys detail <<< "${FINDINGS[$i]}"
    [ "$i" -gt 0 ] && printf ','
    printf '{"status":"%s","repo":"%s","path":"%s","deployed_from":"%s","detail":"%s"}' \
      "$(json_esc "$status")" "$(json_esc "$owner")" "$(json_esc "$path")" \
      "$(json_esc "$phys")" "$(json_esc "$detail")"
  done
  printf ']}\n'
  return 0
}

# ── run ──────────────────────────────────────────────────────────────────────

# classify - classify_all, narrowed to the MISSING and STALE findings under --missing, and to
# the paths under an --only directory, or the fold above one (a fold is repaired whole).
classify() {
  classify_all
  local rec status path p keep=() hit
  for rec in ${FINDINGS[@]+"${FINDINGS[@]}"}; do
    IFS="$SEP" read -r status _ path _ <<< "$rec"
    [ "$ONLY_MISSING" = 1 ] && [ "$status" != MISSING ] && [ "$status" != STALE ] && continue
    if [ "${#ONLY_PATHS[@]}" -gt 0 ]; then
      hit=0
      for p in "${ONLY_PATHS[@]}"; do [ "$path" = "$p" ] || [[ "$path" == "$p"/* ]] || [[ "$p" == "$path"/* ]] && hit=1; done
      [ "$hit" = 1 ] || continue
    fi
    keep+=("$rec")
  done
  FINDINGS=(${keep[@]+"${keep[@]}"})
  return 0
}

main() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --check) MODE=check ;;
      --apply) MODE=apply ;;
      --quiet) FORMAT=quiet ;;
      --json)  FORMAT=json ;;
      --missing) ONLY_MISSING=1 ;;
      --only)
        [ $# -ge 2 ] || { printf 'dotfiles-deploy: --only needs a directory\n' >&2; exit 2; }
        case "$2" in /*|.|./|..|../*) printf 'dotfiles-deploy: --only takes a path under ~, relative: %s\n' "$2" >&2; exit 2 ;; esac
        ONLY_PATHS+=("${2%/}"); shift ;;
      -h|--help)
        # Print the header block, stopping at the first line that is not a comment.
        awk 'NR==1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$0"
        exit 0 ;;
      *)
        printf 'dotfiles-deploy: unknown argument: %s (try --help)\n' "$1" >&2
        exit 2 ;;
    esac
    shift
  done

  build_manifest
  classify

  if [ "$MODE" = apply ]; then
    if [ "${#FINDINGS[@]}" -eq 0 ]; then
      if [ "$ONLY_MISSING" = 1 ]; then
        printf 'dotfiles-deploy: nothing to attach - none of %s deploy path(s) is missing\n' "${#MANIFEST[@]}"
      else
        printf 'dotfiles-deploy: nothing to do - all %s deploy path(s) already resolve to their tracked source\n' \
          "${#MANIFEST[@]}"
      fi
      exit 0
    fi
    printf 'dotfiles-deploy: repairing %s path(s)\n' "${#FINDINGS[@]}"
    show_diffs
    printf '\n'
    apply_all

    # CONVERGENCE. Re-classifying from scratch afterwards is the only honest proof that the
    # repair took: a count of links written says nothing about what still serves wrong content.
    classify
    if [ "${#FINDINGS[@]}" -eq 0 ] && [ "$FAILED" -eq 0 ]; then
      if [ "$ONLY_MISSING" = 1 ]; then
        printf '\ndotfiles-deploy: converged - %s path(s) linked or pruned, none missing now (copies not checked: --missing)\n' "$APPLIED"
      else
        printf '\ndotfiles-deploy: converged - %s path(s) repaired, re-check is clean\n' "$APPLIED"
      fi
      exit 0
    fi
    printf '\ndotfiles-deploy: DID NOT CONVERGE - %s repaired, %s refused, %s still wrong\n' \
      "$APPLIED" "$FAILED" "${#FINDINGS[@]}" >&2
    report_text >&2
    exit 1
  fi

  case "$FORMAT" in
    quiet) [ "${#FINDINGS[@]}" -eq 0 ] && exit 0 || exit 1 ;;
    json)  report_json; [ "${#FINDINGS[@]}" -eq 0 ] && exit 0 || exit 1 ;;
    *)     report_text; [ "${#FINDINGS[@]}" -eq 0 ] && exit 0 || exit 1 ;;
  esac
}

# Source guard. A unit test sources this file to drive stow_ignored() directly, which is
# the only way to pin the ignore-matching rules against a table of cases rather than
# through a whole fixture repo. Everything above is definitions; nothing runs until here.
[[ "${BASH_SOURCE[0]}" != "$0" ]] && return 0

main "$@"
