#!/usr/bin/env bash
# wave-start — kick off a wave for an app WITHOUT opening a Claude session.
#
# The cockpit is where you keep your task list, so that is where handing work over should
# begin and end. Before this, capture was in the cockpit (`C-a`, `C-t`) but STARTING the
# wave meant leaving it, opening Claude and typing a slash command — the one manual step
# in an otherwise hands-off pipeline.
#
# Same headless shape `delivery-loop` already uses: `claude -p` under agentctl-style
# env, no TTY, bounded turns. The difference is this fires ONCE, on your keypress,
# rather than on a timer — starting a wave creates real tickets on a real tracker, so it
# stays an explicit act. What it does NOT do is run the work: it scopes, cuts the branch,
# opens the draft PR and writes the blackboard with `Approval: PENDING`, then posts the
# approval as an ASK so you answer it in the bridge with Enter. `delivery-loop` picks up
# from there once the board is approved.
#
# Backgrounded by default (`--now` to run in the foreground): the cockpit binding must
# return instantly, and a wave scope-out takes minutes. Progress lands in the log and the
# finish lands as a notification + a bridge ask.
#
# Usage: wave-start <app> [--now] [--verb start|status|ship]

set -uo pipefail

# The one board parser, shared with the cockpit, wave-session and the headless daemons.
# shellcheck source=/dev/null
. "${AGENT_BOARD_LIB:-/nonexistent}" 2>/dev/null \
  || . "$HOME/.local/lib/agent-board.sh" 2>/dev/null \
  || . "$(dirname "$(realpath "$0")")/../lib/agent-board.sh" 2>/dev/null \
  || { echo "wave-start: agent-board.sh not found" >&2; exit 1; }

APP="${1:-}"
[ -n "$APP" ] || { echo "usage: wave-start <app> [--now] [--verb start|status|ship]" >&2; exit 2; }
shift

FG=0
VERB="start"
while [ $# -gt 0 ]; do
  case "$1" in
    --now) FG=1 ;;
    --verb) shift; VERB="${1:-start}" ;;
    *) echo "wave-start: unknown flag '$1'" >&2; exit 2 ;;
  esac
  shift
done

STATE_DIR="${AGENTCTL_STATE_DIR:-$HOME/.local/state/agentctl}/wave"
LOG="$STATE_DIR/${APP}.log"
mkdir -p "$STATE_DIR"

# Guard the seam this script ACTUALLY invokes. It used to check `claude`, which stopped
# being the thing wave-start runs the moment the pass went through the role wrapper --
# so on a host with claude installed but no agentctl-run the guard passed and the run
# died later with exit 127, and on a host with neither it refused for the wrong reason.
command -v agentctl-run >/dev/null 2>&1 || { echo "wave-start: agentctl-run not on PATH" >&2; exit 1; }

# One wave per app at a time. Pressing W twice because the first press looked like it
# did nothing starts a second scope-out over the SAME `#ai` items, and both then file
# tickets, cut branches and open PRs for the same work. That happened: three concurrent# waves on one app from three presses.
#
# The pid is checked, not merely recorded - a stale file from a killed run must not lock
# the app out forever.
LOCK="$STATE_DIR/${APP}.pid"
if [ "${WAVE_FORCE:-0}" != 1 ] && [ -f "$LOCK" ]; then
  _held="$(cat "$LOCK" 2>/dev/null)"
  case "$_held" in
    ''|*[!0-9]*) rm -f "$LOCK" ;;
    *) if kill -0 "$_held" 2>/dev/null; then
         echo "wave-start: $APP already has a wave running (pid $_held)." >&2
         echo "  log:   $LOG" >&2
         echo "  force: WAVE_FORCE=1 wave-start $APP" >&2
         exit 3
       fi
       rm -f "$LOCK" ;;
  esac
fi

SHARED_HOOKS="$HOME/.config/shared-hooks"
MAP="${PROJECT_MAP_FILE:-$SHARED_HOOKS/project-map.json}"

# The app's repo, so the run starts where its code is (the tracker, the branch and the
# worktrees are all resolved relative to it).
repo_of() {
  local repo
  [ -f "$MAP" ] && command -v jq >/dev/null 2>&1 || return 0
  repo=$(jq -r --arg a "$APP" '.trackers[$a].repo // $a' "$MAP" 2>/dev/null || true)
  jq -r --arg r "$repo" '.paths | to_entries[] | select(.value == $r) | .key' "$MAP" 2>/dev/null | head -1
}
REPO="$(repo_of)"
[ -n "$REPO" ] && [ -d "$REPO" ] || REPO="$PWD"

# The runner status contract (see `agentctl`, the `report` subcommand): five keys,
# atomically replaced, read by fleet.sh and the cockpit's global footer.
#
# Wave writes a log and a pid lock, and until now nothing else - so the verdict computed
# below, INCLUDING "FAILED (no blackboard written)", existed only as a fire-and-forget
# notification. Nobody could go back and look at it, and `fleet.sh` could not see wave at
# all. This is the durable half.
#
# `--name wave` is explicit: AGENTCTL_NAME is only set by the systemd unit, and wave-start
# detaches with setsid rather than running as one. Guarded and `|| true` so a hand-run
# outside the cockpit, or a machine with no agentctl, is a silent no-op - the same shape
# watch-companion-loop:397-403 uses.
_report() { # <state> <item> [detail]
  command -v agentctl >/dev/null 2>&1 || return 0
  local -a kv=("state=$1" "project=$APP" "item=$2")
  [ $# -ge 3 ] && kv+=("detail=$3")
  agentctl report --name "${AGENTCTL_NAME:-wave}" "${kv[@]}" >/dev/null 2>&1 || true
}

run_pass() {
  cd "$REPO" 2>/dev/null || { echo "wave-start: repo $REPO missing" >&2; return 1; }

  # Backstop for the answer loop. The cockpit resumes an ask on the keypress that answers
  # it, which covers the normal path; this catches an answer given anywhere else (a
  # terminal `agent-ask answer`, a phone notification action) so a `W` press never scopes
  # a fresh wave on top of an approval that was already given and never acted on.
  # ASK_RESUME_DRAINING guards the recursion: ask-resume runs a `/wave` resume BY calling
  # this script, which would otherwise drain again from inside its own drain.
  if [ -z "${ASK_RESUME_DRAINING:-}" ] && command -v ask-resume >/dev/null 2>&1; then
    ASK_RESUME_DRAINING=1 ask-resume --all >>"$LOG" 2>&1 || true
  fi

  local t0 rc=0
  t0="$(date +%s)"

  echo "$$" > "$LOCK"
  # shellcheck disable=SC2064
  trap "rm -f '$LOCK'" EXIT INT TERM
  _report working "/wave $APP $VERB"

  echo "=== wave-start $APP $VERB — $(date -Is) — repo $REPO" >>"$LOG"
  # --dangerously-skip-permissions: a headless run must not hang on a permission
  # prompt with no TTY to answer it. The real gate is downstream and unaffected —
  # `/wave` writes `Approval: PENDING` and delivery-loop refuses to drain a board
  # without the human's marker, so nothing this starts can deliver itself.
  #
  # The exit status is CAPTURED, not discarded. It used to end in `|| true` inside a
  # brace group, so a pass that died on its first line looked exactly like one that
  # worked: `claude` exited non-zero, the status went nowhere, and the only report
  # the human got was the boilerplate `=== done` line. A `/wave` that failed in one
  # second announced itself as "finished".
  # `build` role, same as delivery-loop: a wave writes code and opens PRs. The
  # role pins the MCP set (playwright --headless) and carries its denials;
  # --dangerously-skip-permissions still applies via the adapter.
  agentctl-run --role build -p "/wave $APP $VERB" \
    --max-turns "${WAVE_MAX_TURNS:-60}" \
    >>"$LOG" 2>&1 || rc=$?
  echo "=== done (rc=$rc) — $(date -Is)" >>"$LOG"

  # Did this pass actually produce a board? A `start` whose whole job is to write one
  # has not succeeded without it, whatever it exited with. Compare against the pass
  # start time so a stale board from last week cannot vouch for this run.
  local board board_ts=0
  board="$(board_newest "$APP")"
  [ -n "$board" ] && board_ts="$(stat -c %Y "$board" 2>/dev/null || echo 0)"

  WAVE_VERDICT=ok
  if [ "$rc" -ne 0 ]; then
    WAVE_VERDICT="FAILED (exit $rc)"
  elif [ "$VERB" = start ] && [ "$board_ts" -lt "$t0" ]; then
    WAVE_VERDICT="FAILED (no blackboard written)"
  fi

  # The real diagnostic is the last line that is not our own boilerplate.
  WAVE_DIAG="$(grep -vE '^===|^[[:space:]]*$' "$LOG" 2>/dev/null | tail -1)"
  [ -n "$WAVE_DIAG" ] || WAVE_DIAG="(no output)"

  if [ "$WAVE_VERDICT" != ok ]; then
    printf 'wave-start: %s %s %s — %s\n' "$APP" "$VERB" "$WAVE_VERDICT" "$WAVE_DIAG" >&2
  fi

  # Report the outcome durably.
  #
  # A pass that stopped ON PURPOSE to ask the human is `blocked`, not `ok` and not
  # `error` - that is the state the contract invented for a healthy process waiting on a
  # person, and it is what makes the row show `!` instead of a dim tick. Detected
  # mechanically: a board that still says `Approval: PENDING` plus a pending ask for this
  # app. Checked BEFORE ok, because a paused wave has not finished.
  # `! board_approved`, not `grep PENDING`. Those are not inverses: PENDING is only ONE of
  # the ways a board can be un-approved, and a board carrying no Approval line at all
  # matched neither branch — so a wave that paused for a human, with a pending ask sitting
  # right there, reported `ok` and the row showed a dim tick instead of `!`. Ask the
  # single approval predicate (BOARD_APPROVAL_RE) that delivery-loop already gates on, so
  # the thing that STARTS a wave and the thing that DRAINS one cannot disagree about what
  # approved means.
  local waiting=0 askid=""
  if [ -n "$board" ] && ! board_approved "$board"; then
    if command -v agent-ask >/dev/null 2>&1; then
      askid="$(agent-ask list "$APP" --pending 2>/dev/null | awk -F'\t' 'NR==1{print $1}')"
      [ -n "$askid" ] && waiting=1
    fi
  fi

  if [ "$WAVE_VERDICT" != ok ]; then
    _report error "$VERB $WAVE_VERDICT" "$WAVE_DIAG"
  elif [ "$waiting" -eq 1 ]; then
    _report blocked "$VERB waiting on ask $askid" "$WAVE_DIAG"
  else
    _report ok "$VERB ok" "$WAVE_DIAG"
  fi

  # Publish the proof-contract outcome too. `_report` writes the agentctl STATUS
  # (state/project/item, last-value-only); last-outcome is the separate did-it-work
  # axis that fleet-liveness asserts across the whole roster, and `wave` was one of
  # the runners that had never written it -- so its absence read as "never wired".
  #
  # Derived from WAVE_VERDICT rather than from claude's exit code, because this
  # script already knows better: a pass can exit 0 having written no blackboard,
  # which is why WAVE_VERDICT exists at all. A wave HELD at its approval gate is
  # NOOP, not STALLED -- stopping for a human is the gate working, not a failure.
  if . "$HOME/.local/lib/agent-proof.sh" 2>/dev/null; then
    if [ "$WAVE_VERDICT" != ok ]; then
      proof_report "${AGENTCTL_NAME:-wave}" STALLED "$APP $VERB $WAVE_VERDICT"
    elif [ "$waiting" -eq 1 ]; then
      proof_report "${AGENTCTL_NAME:-wave}" NOOP "$APP $VERB held at gate (ask $askid)"
    else
      proof_report "${AGENTCTL_NAME:-wave}" WORKED "$APP $VERB ok"
    fi
  fi

  # Arm the overseer, but only now that a board exists. captain-watchdog SELF-DISARMS on
  # any pass that finds no active sprint (cmd_run -> cmd_disarm removes its own units), so
  # arming it before this point is a no-op that looks like it worked: it fires once,
  # sees nothing, and deletes itself. Nothing armed it at wave start, which is the real
  # reason no stall or false-completion detection has ever fired.
  if [ -n "$board" ] && [ "$board_ts" -ge "$t0" ]; then
    command -v captain-watchdog >/dev/null 2>&1 && captain-watchdog arm >>"$LOG" 2>&1 || true
  fi

  # Say what actually happened. This used to report the last non-empty line of the
  # log, which is always our own `=== done` marker - so every pass, including a
  # crash, notified "finished <timestamp>" and nothing else.
  local msg
  if [ "$WAVE_VERDICT" = ok ]; then
    msg="$VERB ok — $WAVE_DIAG"
  else
    msg="$VERB $WAVE_VERDICT — $WAVE_DIAG"
  fi
  command -v agent-notify >/dev/null 2>&1 && \
    agent-notify -t "wave:$APP" "$msg" >/dev/null 2>&1 || true

  [ "$WAVE_VERDICT" = ok ]
}

if [ "$FG" = 1 ]; then
  # Propagate the verdict. A bare `exit 0` here meant a foreground pass reported
  # success no matter what happened - including the one that printed
  # "Unknown command: /wave" and stopped after a second.
  rc=0
  run_pass || rc=$?
  tail -20 "$LOG"
  exit "$rc"
fi

# Detach so the run outlives the popup that launched it. A display-popup binding's whole
# process group dies when the popup closes, which would silently truncate the pass
# mid-scope — the failure would look like "the wave just didn't start".
# Re-exec THIS script with --now rather than exporting a function: one code path, and
# nothing depends on `declare -f` surviving the hop.
SELF="$(realpath "$0")"
if command -v setsid >/dev/null 2>&1; then
  setsid -f "$SELF" "$APP" --now --verb "$VERB" >/dev/null 2>&1 </dev/null
else
  nohup "$SELF" "$APP" --now --verb "$VERB" >/dev/null 2>&1 </dev/null &
fi

echo "wave-start: $APP $VERB running in the background"
echo "  log:    $LOG"
echo "  watch:  prefix t -> a a  (bridge)   ·   tail -f $LOG"
