#!/usr/bin/env bash
# agent-propose - what an analysis stream proposes to the human, and the only writer of its store.
#
#   add --stream s --project p --verb queue|row|mem0|none [--arg text] [--why text] [--evidence path|url]
#       [--key k] "title"             file a proposal; print its id (the open one when it repeats)
#   list [--json] [--status open|asked|accepted|rejected|expired|all] [--stream s]
#   show <id> | count
#   accept [--by who] <id>            run its verb, then record the decision
#   reject [--by who] <id>            record the decision; the verb never runs
#   expire                            ask about what passed its expiry, prune decided records
#   answered <ask-id>                 decide an expiring proposal by its ask's answer (its run: resume)
#
# A proposal is a decision for the human, or for the judge once it goes its TTL unread, so nothing
# here runs without an accept and no model reads it: the verb is one of the fixed set below, applied by this script. It is not an
# agent-ask, whose `resume` is a model prompt that runs whatever the answer was.
set -uo pipefail

AP_DIR="${AGENT_PROPOSE_DIR:-$HOME/.agent/proposals}"
AP_TTL_DAYS="${AGENT_PROPOSE_TTL_DAYS:-30}"   # an unread proposal is stale: dream's block expiry
AP_KEEP_DAYS="${AGENT_PROPOSE_KEEP_DAYS:-90}" # a decided record, long enough to stop a repeat
AP_MAX="${AGENT_PROPOSE_MAX:-12}"             # open per stream and project, above the largest real backlog (11)
AP_ASK_CMD="${AGENT_PROPOSE_ASK_CMD:-agent-ask}"   # where an expiring proposal is asked
# Where the mem0 verb posts: MEM0_BASE_URL, MEM0_USER_ID and MEM0_SECRET (the sops file holding the
# key), from the private overlay, since the URL may not enter this repo.
AP_MEM0_LIB="${AGENT_PROPOSE_MEM0_LIB:-$HOME/.local/lib/mem0.sh}"

die() { echo "agent-propose: $*" >&2; exit 1; }
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
records() { find "$AP_DIR" -maxdepth 1 -name '*.json' -print0 2>/dev/null | xargs -0 -r cat; }

# One writer at a time: a repeat check and its write, or a decision and its verb, are one step.
lock() {
  mkdir -p "$AP_DIR" || die "cannot create $AP_DIR"
  exec 9>"$AP_DIR/.lock"
  flock 9 || die "cannot lock $AP_DIR"
}

write() { # <id> <json>
  local tmp="$AP_DIR/.$1.tmp"
  printf '%s\n' "$2" > "$tmp" && mv "$tmp" "$AP_DIR/$1.json" || die "cannot write $1"
}

cmd_add() {
  local stream="" project="" verb="" arg="" why="" evidence="" key="" title
  while [ $# -gt 0 ]; do
    case "$1" in --*) [ $# -ge 2 ] || die "add: $1 needs a value" ;; esac
    case "$1" in
      --stream)   stream="${2-}"; shift 2 ;;
      --project)  project="${2-}"; shift 2 ;;
      --verb)     verb="${2-}"; shift 2 ;;
      --arg)      arg="${2-}"; shift 2 ;;
      --why)      why="${2-}"; shift 2 ;;
      --evidence) evidence="${2-}"; shift 2 ;;
      --key)      key="${2-}"; shift 2 ;;
      --*)        die "add: unknown flag $1" ;;
      *)          break ;;
    esac
  done
  title="$*"
  [ -n "$stream" ] && [ -n "$project" ] && [ -n "$title" ] || die "add needs --stream, --project and a title"
  case "$verb" in
    queue|row|mem0) [ -n "$arg" ] || die "add: --verb $verb needs --arg" ;;
    none) ;;
    *) die "add: --verb must be queue, row, mem0 or none" ;;
  esac
  [ -n "$key" ] || key="$stream/$project/$title"
  lock
  sweep >/dev/null
  # A repeat is the open record, or a decision still kept: a rejected idea is not asked again nightly.
  # An expired one was never decided, so it may come back.
  local seen id open_n ts
  seen="$(records | jq -rs --arg k "$key" 'map(select(.key == $k and .status != "expired")) | last | .id // empty')"
  if [ -n "$seen" ]; then echo "$seen"; return 0; fi
  ts="$(now)"
  # A past-due one still open is an ask that did not post: the sweep retries it, the cap skips it.
  open_n="$(records | jq -s --arg s "$stream" --arg p "$project" --arg t "$ts" \
    'map(select(.status == "open" and .expires >= $t and .stream == $s and .project == $p)) | length')"
  [ "$open_n" -lt "$AP_MAX" ] || die "$stream has $open_n open for $project (max $AP_MAX): decide those first"
  id="$(printf '%s' "$key" | sha256sum | cut -c1-12)"
  write "$id" "$(jq -cn --arg id "$id" --arg stream "$stream" --arg project "$project" --arg title "$title" \
    --arg why "$why" --arg evidence "$evidence" --arg verb "$verb" --arg arg "$arg" --arg key "$key" \
    --arg created "$ts" --arg expires "$(date -u -d "+$AP_TTL_DAYS days" +%Y-%m-%dT%H:%M:%SZ)" \
    '{id: $id, stream: $stream, project: $project, title: $title, why: $why, evidence: $evidence,
      verb: $verb, arg: $arg, key: $key, status: "open", created: $created, expires: $expires}')"
  echo "$id"
}

cmd_list() {
  local json="" status=open stream=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)   json=1; shift ;;
      --status) status="${2:?}"; shift 2 ;;
      --stream) stream="${2:?}"; shift 2 ;;
      *) die "list: unknown arg $1" ;;
    esac
  done
  case "$status" in open|asked|accepted|rejected|expired|all) ;; *) die "list: no status $status" ;; esac
  local rows
  rows="$(records | jq -cs --arg st "$status" --arg s "$stream" "$AP_DOES"'
    map(select(($st == "all" or .status == $st) and ($s == "" or .stream == $s)) | .does = does) | sort_by(.created)')"
  if [ -n "$json" ]; then printf '%s\n' "$rows"; return 0; fi
  jq -r '.[] | [.id, .status, .stream, .project, .created[0:10], .title] | @tsv' <<<"$rows"
}

record() { # <id>: the record's path, or die
  case "$1" in *[!0-9a-f]*|"") die "bad id: $1" ;; esac
  [ -f "$AP_DIR/$1.json" ] || die "no proposal $1"
  printf '%s' "$AP_DIR/$1.json"
}

# The fixed set of verbs, as the command each one runs: apply runs it and the surfaces show it.
# mem0 is no command: apply posts .arg itself (mem0_post), so the key never reaches an argv.
AP_ARGV='def argv: if .verb == "queue" then ["agent-queue", "add", "--project", .project, "--priority", "high", "--", .arg]
  elif .verb == "row" then ["notes", "ptask", .project, "--agent", "add", "--origin", "agent-propose", .arg]
  elif .verb == "none" then [] else null end;'
AP_DOES="$AP_ARGV"'def does: if .verb == "mem0" then "post to mem0, verbatim: " + .arg
  elif (argv // []) == [] then "nothing runs: the decision is recorded"
  else argv | join(" ") end;'

# mem0_post <fact>: store it in mem0 as written (infer false: the extractor drops a dense fact and
# still answers 200), and print the new memory ids. The key is read from sops at this moment and
# goes to curl on stdin (-K -), so no record, file or process list ever holds it.
mem0_post() {
  local key body out ids
  # shellcheck source=/dev/null
  . "$AP_MEM0_LIB" || { echo "no mem0 lib at $AP_MEM0_LIB" >&2; return 1; }
  mem0_load || return 1   # ~/.config/agentctl/mem0.env, or MEM0_ENV
  key="$(mem0_key)" || return 1
  body="$(jq -cn --arg c "$1" --arg u "$MEM0_USER_ID" \
    '{messages: [{role: "user", content: $c}], user_id: $u, infer: false}')"
  out="$(printf 'header = "X-API-Key: %s"\n' "$key" | curl -fsS --connect-timeout 10 --max-time 30 -K - -X POST "$MEM0_BASE_URL/memories" \
    -H 'Content-Type: application/json' --data-binary "$body")" || return 1
  ids="$(jq -r '[.results[]? | select(.event == "ADD") | .id] | join(" ")' <<<"$out" 2>/dev/null)"
  [ -n "$ids" ] || { echo "mem0 stored nothing: $out" >&2; return 1; }
  echo "mem0 $ids"
}

# apply <record file>: the verb, and only the fixed set. Its stdout is what the decision records.
apply() {
  local f="$1" cmd
  if jq -e '.verb == "mem0"' "$f" >/dev/null; then mem0_post "$(jq -r .arg "$f")"; return; fi
  jq -e "$AP_ARGV"'argv != null' "$f" >/dev/null || { echo "unknown verb $(jq -r .verb "$f")" >&2; return 1; }
  mapfile -d '' -t cmd < <(jq -j "$AP_ARGV"'argv[] | . + "\u0000"' "$f")
  [ "${#cmd[@]}" -eq 0 ] || "${cmd[@]}"
}

decide() { # <accepted|rejected> [--by who] <id>
  local status="$1" by=human; shift
  if [ "${1:-}" = --by ]; then by="${2:?}"; shift 2; fi
  local id="${1:-}" f result="" st
  [ -n "$id" ] || die "${status%ed} needs an id"
  f="$(record "$id")" || exit 1
  lock
  st="$(jq -r .status "$f")"
  case "$st" in open | asked) ;; *) die "$id is already $st" ;; esac
  if [ "$status" = accepted ]; then
    # A failed verb leaves it open with the reason, so the accept can be tried again.
    if ! result="$(apply "$f" 2>&1 9>&-)"; then  # 9>&-: a child must not keep the store lock
      write "$id" "$(jq -c --arg e "$result" '.error = $e' "$f")"
      die "$id: its ${status%ed} failed: $result"
    fi
  fi
  write "$id" "$(jq -c --arg s "$status" --arg by "$by" --arg t "$(now)" --arg r "$result" \
    '.status = $s | .decided_by = $by | .decided_at = $t | .result = $r | del(.error)' "$f")"
  echo "$id $status"
}

# ask_expiring <record file>: one gate ask for a proposal that went its TTL unread, which the judge
# accepts or declines under its policy like any gate (ar-4765). Its answer comes back through
# `answered` (ask-resume runs the `run:` resume with the ask id). Not this caller's session or pane:
# the ask is the proposal's, and a sweep may post several. Prints the id.
ask_expiring() {
  local f="$1" title does q context
  title="$(jq -r .title "$f")"
  does="$(jq -r "$AP_DOES"'does' "$f")"
  does="${does//|//}"   # --options splits on |, and a verb's arg is free text
  q="An unread proposal expires today: $title?"
  [ "${#q}" -le 160 ] || q="An unread proposal expires today: ${title:0:110}...?"
  context="A proposal is a change the automated $(jq -r .stream "$f") review suggested for you to accept or reject; this one waited $AP_TTL_DAYS days unread. The proposal: $title. Why: $(jq -r '.why // "-"' "$f"). Accept runs: $does."
  # post prints the card and an "end your turn on it" line for the asking session on stderr; the
  # caller (dream's add) is not that session, so only a failure's reason is shown.
  local out err rc
  err="$(mktemp)"
  out="$(env -u CLAUDE_CODE_SESSION_ID -u TMUX -u TMUX_PANE -u AGENTCTL_NAME "$AP_ASK_CMD" post --kind gate \
    --project "$(jq -r .project "$f")" --options "accept=$does|reject=drop it, it is not proposed again" \
    --context "$context" --resume 'run: agent-propose answered' -- "$q" 2>"$err" 9>&-)"
  rc=$?
  [ "$rc" -eq 0 ] || tail -n 3 "$err" >&2
  rm -f "$err"
  [ "$rc" -eq 0 ] && tail -n 1 <<<"$out"
}

# sweep: runs under the lock, and on every add, so a store with no reader still settles its past-due
# proposals and they stop counting against the cap. A past-due one is asked, never dropped unseen
# (penguin P4, ar-4155): `asked` holds the ask id until the answer decides it, and is kept until
# then, so a late answer still finds it. An ask that does not post leaves it open and past due, so
# the next sweep tries again.
sweep() {
  local ts cut f id ask n=0
  ts="$(now)"
  cut="$(date -u -d "-$AP_KEEP_DAYS days" +%Y-%m-%dT%H:%M:%SZ)"
  while IFS= read -r -d '' f; do
    if jq -e --arg t "$ts" '.status == "open" and .expires < $t' "$f" >/dev/null; then
      id="$(jq -r .id "$f")"
      if ask="$(ask_expiring "$f")" && [ -n "$ask" ]; then
        write "$id" "$(jq -c --arg t "$ts" --arg a "$ask" '.status = "asked" | .ask = $a | .asked_at = $t' "$f")"
        n=$((n + 1))
      else
        echo "agent-propose: $id is past due and its ask did not post; it stays open" >&2
      fi
    elif jq -e --arg c "$cut" '(.status == "open" or .status == "asked" | not) and .decided_at < $c' "$f" >/dev/null; then
      rm -f "$f"
    fi
  done < <(find "$AP_DIR" -maxdepth 1 -name '*.json' -print0)
  echo "$n asked"
}

# answered <ask id>: the `run:` resume of an expiring proposal's ask. accept or reject decides it as
# whoever answered it, the judge or the human (an ask with no answered_by is the human's); an answer
# naming neither or both leaves it asked and says so. One already decided another way (accept or
# reject by hand) is a no-op.
cmd_answered() {
  local ask="${1:-}" id st names acc rej by
  [ -n "$ask" ] || die "answered needs an ask id"
  read -r id st < <(records | jq -rs --arg a "$ask" 'map(select(.ask == $a)) | (map(select(.status == "asked")) + .) | first | "\(.id // "") \(.status // "")"')
  [ -n "$id" ] || die "no proposal waits on ask $ask"
  [ "$st" = asked ] || { echo "$id already $st"; return 0; }
  names="$("$AP_ASK_CMD" answer-names "$ask")" || die "cannot read the answer to ask $ask"
  by="$("$AP_ASK_CMD" show "$ask" 2>/dev/null | sed -n '/^answered_by: */{s///p;q;}')"
  by=${by:-human}
  grep -qx accept <<<"$names" && acc=a || acc=
  grep -qx reject <<<"$names" && rej=r || rej=
  case "$acc$rej" in
    a) decide accepted --by "$by" "$id" ;;
    r) decide rejected --by "$by" "$id" ;;
    ar) die "ask $ask names both accept and reject; $id stays asked: decide it with agent-propose accept or reject" ;;
    *) die "ask $ask names neither accept nor reject; $id stays asked: decide it with agent-propose accept or reject" ;;
  esac
}

cmd_expire() { lock; sweep; }

case "${1:-}" in
  add)    shift; cmd_add "$@" ;;
  list)   shift; cmd_list "$@" ;;
  show)   f="$(record "${2:-}")" || exit 1; jq . "$f" ;;
  count)  records | jq -s 'map(select(.status == "open")) | length' ;;
  accept) shift; decide accepted "$@" ;;
  reject) shift; decide rejected "$@" ;;
  expire) cmd_expire ;;
  answered) shift; cmd_answered "$@" ;;
  *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
