#!/usr/bin/env bash
# machine-mode - how much of this workstation background work may use.
#
#   machine-mode            print the mode and what each part reads right now
#   machine-mode <mode>     switch to a mode from the modes file, by hand
#   machine-mode next       switch to the next one, wrapping (the waybar chip's click)
#   machine-mode hours      print the day's parts, the mode each runs in, and which one is now
#   machine-mode clock      the timer's tick: a new part's mode applies once (agentctl machine-clock)
#   machine-mode auto       give the mode back to the clock: apply this part's mode now
#   machine-mode release-lane <host> --until <time>   keep <host>'s pool slots for release jobs
#                           until <time> (date -d, at most 24h ahead); it ends on its own
#   machine-mode release-lane --clear <host>          end that reservation now (removes the key)
#   machine-mode release-lane    list the reservations
#
# A reservation is the "<host>.reserve" key, {"until": <epoch>}, in the same ConfigMap: the
# governor pins the host to 0 until then, so gates go to other hosts while release.yml jobs,
# which ask for host-<host> alone, take the withheld slots. Any machine with the kube context
# can set one, for a cut or a re-send (playground docs/operations/steam.md#the-release-lane).
#
# The clock hours, .config/machine-mode/hours, name the day's parts. When a part begins, `clock`
# switches to its mode, except that a mode set by hand holds while the human is here
# (fleet-presence): the part's mode then applies at the first tick they are away. Inside a part
# the clock changes nothing, so a hand switch stands until the next part begins.
#
# A mode sets two things, its numbers in .config/machine-mode/modes:
#   runners and unity_slots
#                {"slots": N, "local": M, "by": "machine-mode <mode>"} as this host's "<host>.slots"
#                key in the ci-runner-governor-override ConfigMap, merge-patched so no other
#                writer's key is touched. slots pins the pool runners, local how many local Unity
#                runs the governor grants a seat at once (unity-core-playground's slots.sh leases
#                one per run). This writes no runner label: the governor relabels at runtime, so a
#                busy runner finishes its job and a running local run keeps its seat, and ansible
#                (put_labels.yml) resets each runner's labels on every apply. Takes minutes, and
#                longer if a gate is running.
#   level        how fast the fleet starts work: fleet-dispatch and claude-acct room scale their
#                limits by it where they read them (lib/machine-mode.sh), so nothing is written.
#
# No mode stops dispatch: the low level is reserved's trickle, and `agent-hold set dispatch` is
# the one full stop. The status shows a dispatch hold by anyone, and never sets or lifts one.
#
# If the cluster cannot be reached the local part still applies, the command exits 1, and
# RUNNERS_PINNED=no in the state file turns the chip amber until a retry lands. There is no
# second path to the runner labels. Usage and troubleshooting: .local/src/docs/machine-mode.md

set -uo pipefail
here="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
# shellcheck source=../lib/prom.sh
. "$here/../lib/prom.sh"
# shellcheck source=../lib/machine-mode.sh
. "$here/../lib/machine-mode.sh"

STATE="$MACHINE_MODE_STATE"
RUNNER_UNITS="${MACHINE_MODE_RUNNER_UNITS:-/etc/systemd/system/actions.runner.*-unity-pool-*.service}"
CONFIGMAP=ci-runner-governor-override
NAMESPACE=monitoring
HOST="$(uname -n)"

die() { echo "machine-mode: $*" >&2; exit 1; }

next_mode() {
  local names first
  names="$(mode_names)"
  first="${names%%$'\n'*}"
  awk -v cur="$(current_mode)" -v first="$first" \
    'found { print; done = 1; exit } $0 == cur { found = 1 } END { if (!done) print first }' <<< "$names"
}

# Who holds dispatch, empty when nobody does.
dispatch_holder() { agent-hold list | awk -F'\t' '$1 == "dispatch" { print $3 }'; }

kube() { kubectl --context "${CC_KUBE_CONTEXT:-}" --request-timeout=10s -n "$NAMESPACE" "$@"; }

# put_key <key> [<json>]: merge-patch one key of the ConfigMap, or remove it with no json. The
# override's one write style (home-config apps/ci-runner-governor/override.schema.json): no
# other writer's key is read or rewritten. Creates the ConfigMap only when it does not exist,
# and patches again when another writer created it first.
put_key() {
  local key="$1" value="${2:-}" patch err
  patch="$(jq -cn --arg k "$key" --arg v "$value" '{data: {($k): (if $v == "" then null else $v end)}}')"
  err="$(kube patch configmap "$CONFIGMAP" --type merge -p "$patch" 2>&1 >/dev/null)" && return 0
  if [[ "$err" == *NotFound* ]]; then
    [ -z "$value" ] && return 0
    err="$(kube create configmap "$CONFIGMAP" --from-literal="$key=$value" 2>&1 >/dev/null)" && return 0
    [[ "$err" == *AlreadyExists* ]] && err="$(kube patch configmap "$CONFIGMAP" --type merge -p "$patch" 2>&1 >/dev/null)" && return 0
  fi
  printf '%s\n' "$err" >&2
  return 1
}

# pin_host <slots> <local> <mode>: this host's "<host>.slots" key, the pool slots and local seats
# the governor moves it to.
pin_host() {
  [ -n "${CC_KUBE_CONTEXT:-}" ] || { echo "CC_KUBE_CONTEXT is not set in ~/.config/command-center/env" >&2; return 1; }
  put_key "$HOST.slots" "$(jq -cn --argjson n "$1" --argjson l "$2" --arg by "machine-mode $3" '{slots: $n, local: $l, by: $by}')"
}

# release_lane [<host> --until <time> | --clear <host>]: see the header. Writes or removes only
# the "<host>.reserve" key, and only for a host the governor reports on.
release_lane() {
  local host end now cm key
  [ -n "${CC_KUBE_CONTEXT:-}" ] || die "CC_KUBE_CONTEXT is not set in ~/.config/command-center/env"
  cm="$(kube get configmap "$CONFIGMAP" -o json --ignore-not-found)" || exit 1
  [ -n "$cm" ] || cm='{}'
  case "${1:-}" in
    '')
      jq -r '.data // {} | to_entries[] | select(.key | endswith(".reserve"))
        | (.value | try fromjson catch {}) as $r | select(($r | type) == "object" and ($r.until | type) == "number")
        | "\(.key | rtrimstr(".reserve")) \($r.until | floor)"' <<< "$cm" |
        while read -r host end; do
          printf '%s: until %s%s\n' "$host" "$(date -d "@$end" '+%Y-%m-%d %H:%M %Z')" \
            "$( ((end <= $(date +%s))) && echo ", ended")"
        done
      return ;;
    --clear)
      host="${2:-}"; [ -n "$host" ] || die "usage: machine-mode release-lane --clear <host>"
      key="$host.reserve"
      jq -e --arg k "$key" '.data // {} | has($k)' <<< "$cm" >/dev/null || { echo "$host: no reservation"; return; }
      put_key "$key" || exit 1
      echo "$host: reservation ended; the governor re-admits its slots"
      return ;;
  esac
  host="$1"
  [ "${2:-}" = --until ] && [ -n "${3:-}" ] || die "usage: machine-mode release-lane <host> --until <time>"
  [[ "$host" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "'$host' is not a pool host name"
  end="$(date -d "$3" +%s 2>/dev/null)" || die "cannot read the time '$3'"
  now="$(date +%s)"
  ((end > now)) || die "$3 is not in the future (for a time tomorrow, say 'tomorrow $3')"
  # One cut's whole run was under 10h (2026-11-06); a day caps a forgotten reservation.
  ((end - now <= 86400)) || die "$3 is more than 24h ahead: one cut at a time"
  # A typo would reserve nothing and say it had. Without Prometheus, say so and go on: a cut
  # should not wait on monitoring.
  local raw
  if raw="$(prom_q "ci_governor_registered{host=\"$host\"}")"; then
    jq -e --arg h "$host" 'any(.data.result[]; .metric.host == $h)' <<< "$raw" >/dev/null \
      || die "the governor runs no host '$host' (no ci_governor_registered series)"
  else
    echo "warning: cannot read Prometheus to check that the governor runs '$host'" >&2
  fi
  key="$host.reserve"
  put_key "$key" "{\"until\":$end}" || exit 1
  echo "$host: reserved for release jobs until $(date -d "@$end" '+%Y-%m-%d %H:%M %Z'); its slots leave the pool one per governor cycle"
}

write_state() {
  local tmp
  mkdir -p "$(dirname "$STATE")"
  tmp="$(mktemp "$STATE.XXXXXX")" || return 1
  printf 'MACHINE_MODE=%s\nRUNNERS_PINNED=%s\nMODE_BY=%s\nCLOCK_PART=%s\n' "$@" > "$tmp"
  mv "$tmp" "$STATE"
}

# Where the runners move is the governor's own ci_governor_effective_slots (its pin, a release
# reservation over it, or unpinned what it admits), never recomputed here.
runner_line() {
  local want="$1" mode="$2" raw admitted registered effective source
  local q="{__name__=~\"ci_governor_(admitted|registered|effective_slots)\",host=\"$HOST\"}"
  local pick='[.data.result[] | select(.metric.__name__ == $n) | .value[1] | tonumber] | max // empty'
  if raw="$(prom_q "$q")"; then
    admitted="$(jq -r --arg n ci_governor_admitted "$pick" <<< "$raw")"
    registered="$(jq -r --arg n ci_governor_registered "$pick" <<< "$raw")"
    effective="$(jq -r --arg n ci_governor_effective_slots "$pick" <<< "$raw")"
    source="$(jq -r '[.data.result[] | select(.metric.__name__ == "ci_governor_effective_slots") | .metric.source] | first // empty' <<< "$raw")"
  fi
  local line="runners: ${admitted:-?} of ${registered:-?} taking new jobs"
  if [ "$(state_value RUNNERS_PINNED)" = no ]; then
    line+=", $want was not applied: run machine-mode $mode again"
  elif [ -z "${admitted:-}" ] || [ -z "${registered:-}" ]; then
    line+=" (cannot read Prometheus), set to $want"
  elif [ -z "${effective:-}" ]; then
    line+=" (the governor reports no target), set to $want"
  elif ((admitted != effective)); then
    line+=", moving to $effective"
    [ "$source" = reserve ] && line+=" (reserved for release jobs)"
  fi
  printf '%s\n' "$line"
}

dispatch_line() {
  local by
  by="$(dispatch_holder)"
  if [ -n "$by" ]; then
    echo "new agent sessions: paused by $by"
  else
    echo "new agent sessions: as today"
  fi
}

status() {
  local mode runners
  mode="$(current_mode)"
  IFS='|' read -r _ runners _ <<< "$(mode_row "$mode")"
  echo "mode: $mode"
  echo "level: $(machine_level)"
  runner_line "$runners" "$mode"
  dispatch_line
  clock_line
}

# clock_line -> the part now, the mode it runs, and who set the mode in force.
clock_line() {
  local part window want by
  IFS='|' read -r part window want _ <<< "$(clock_part)"
  [ -n "$part" ] || { echo "clock: no part of $MACHINE_MODE_HOURS holds the time now"; return; }
  by="by the clock"
  [ "$(state_value MODE_BY)" = hand ] && by="by hand"
  echo "clock: $part ($window) runs $want; this mode was set $by"
}

# hours -> one line per part, now marked.
hours() {
  local now part window mode why mark
  now="$(clock_part | cut -d'|' -f1)"
  while IFS='|' read -r part window mode why; do
    mark=""; [ "$part" = "$now" ] && mark="  <- now"
    printf '%-8s %-12s %-9s %s%s\n' "$part" "$window" "$mode" "$why" "$mark"
  done < <(hour_rows)
}

# clock_target -> "<part> <mode>" for now, or die when the hours file does not cover it.
clock_target() {
  local part want
  IFS='|' read -r part _ want _ <<< "$(clock_part)"
  [ -n "$part" ] || die "no part of $MACHINE_MODE_HOURS holds the time now"
  mode_row "$want" >/dev/null || die "the $part part names mode '$want', which is not in $MACHINE_MODE_MODES"
  printf '%s %s\n' "$part" "$want"
}

# clock_proof <verdict> [detail] -- the tick's outcome for its agentctl runner (agent-proof.sh), so a
# run that changed nothing reads NOOP, not STALLED.
clock_proof() {
  # shellcheck source=../lib/agent-proof.sh
  . "$here/../lib/agent-proof.sh" || die "agent-proof.sh not found, so the tick cannot report an outcome"
  [ -z "${3:-}" ] || proof_why "$3"
  proof_report machine-clock "$1" "${2:-}"
}

clock() {
  local part want by rc=0
  read -r part want <<< "$(clock_target)"
  [ -n "$part" ] || { clock_proof FAILED "" "the hours file does not name a part for the time now, or names an unknown mode"; exit 1; }
  by="$(state_value MODE_BY)"
  # A state file from before the clock names no setter: its mode was set by hand.
  [ -z "$by" ] && [ -n "$(state_value MACHINE_MODE)" ] && by=hand
  if [ "$(state_value CLOCK_PART)" = "$part" ]; then
    # Applied this part already; retry only a runner pin that never reached the cluster.
    [ "$(state_value RUNNERS_PINNED)" = no ] && [ "$by" = clock ] || { clock_proof NOOP "$part: $(current_mode), applied already"; return 0; }
  elif [ "$by" = hand ] && [ "$(current_mode)" != "$want" ] && human_here; then
    echo "machine-mode: $part began; $(current_mode) was set by hand and you are here, so it holds until you are away"
    clock_proof NOOP "$part: $(current_mode) held by hand while the human is here"
    return 0
  fi
  switch "$want" clock "$part" || rc=$?
  if [ "$rc" = 0 ]; then clock_proof WORKED "$part: switched to $want"
  else clock_proof FAILED "$part: $want" "the runner pin did not reach the cluster"; fi
  return "$rc"
}

# switch <mode> [hand|clock] [part] -- apply a mode. A hand switch records the part it was made in,
# so the clock leaves it until the next part begins.
switch() {
  local mode="$1" by="${2:-hand}" part="${3:-$(clock_part | cut -d'|' -f1)}" runners unity pinned=yes rc=0
  IFS='|' read -r _ runners unity _ <<< "$(mode_row "$mode")"
  if ! pin_host "$runners" "$unity" "$mode"; then
    pinned=no rc=1
    echo "machine-mode: could not reach the cluster, so the runners and local Unity runs did not change. The level is set to $mode." >&2
  fi
  write_state "$mode" "$pinned" "$by" "$part" || die "could not write $STATE"
  "$HOME/.local/bin/desk" signal custom/machine-mode 2>/dev/null || true
  status
  return "$rc"
}

case "${1:-}" in
  hours) hours; exit 0 ;;
  release-lane) shift; release_lane "$@"; exit 0 ;;
  -h|--help) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

if ! compgen -G "$RUNNER_UNITS" >/dev/null; then
  # The timer runs on every machine with the runner confs; with no pool runners its tick has nothing to do.
  [ "${1:-}" = clock ] && { clock_proof NOOP "no pool runners on this machine"; exit 0; }
  die "no pool runners on this machine, so there is nothing to set"
fi

case "${1:-}" in
  '') status ;;
  next) switch "$(next_mode)" ;;
  clock) clock ;;
  auto) read -r part want <<< "$(clock_target)"; [ -n "$part" ] || exit 1; switch "$want" clock "$part" ;;
  *)
    mode_row "$1" >/dev/null || die "no mode '$1' (modes: $(mode_names | paste -sd' '))"
    switch "$1"
    ;;
esac
