#!/usr/bin/env bash
# pool-test-failures sync - the runner pool's failing-test ledger, read from each red Tests run's
# summary artifacts.
#
# A local gate writes ~/.local/state/unity-test-runs/test-failures.tsv (playground
# scripts/test/slots.sh). A gate on the runner pool (playground #1256) leaves its names only in its
# artifacts, as summary.txt files: playmode-summary (a full run), playmode-shard-<n> (each shard; a
# scoped gate uploads no playmode-summary, test.yml) and editmode-summary. Each FAIL line ends in a
# tab, "cases:", and each failed case after a tab (playground scripts/test/failed-cases.py).
# sync appends one line per failed case per run to pool-failures.tsv beside the local ledger, in its
# columns: the epoch the run ended, the local worktree on that branch (- when none), the branch,
# the full test name. fleet-sessions reads both ledgers for its SHARED rows.
#
# fleet-state.service runs it before each tick: GitHub has no event a user unit can await. Each run
# is read once (its id and attempt go to pool-runs.seen), so a minute with no new red costs one call.
# Summaries come from the home artifact store when the project's project-map.json tracker declares an
# artifactStore (its lister in the clone, run as hub-core run_page does), else from GitHub's artifacts API.
# Exit: 0 read (or another sync holds the lock), 1 gh could not list the runs, 2 usage, no checkout, or a
# declared artifactStore lister missing from it.
set -uo pipefail

: "${POOL_FAILURES_PROJECT:=unity-core-playground}" # project-map.json name; its checkout's origin is the repo read
: "${POOL_FAILURES_WORKFLOW:=test.yml}"
: "${POOL_FAILURES_RUNS:=20}" # red runs listed per sync; a new one is read once, so this only bounds a backfill
LEDGER="${UNITY_POOL_FAILURES:-${XDG_STATE_HOME:-$HOME/.local/state}/unity-test-runs/pool-failures.tsv}"
SEEN="$(dirname "$LEDGER")/pool-runs.seen"
STORE_CMD="" STORE_REPO="" # set by sync from project-map.json (artifactStore, github)
ARTIFACTS='^(playmode-summary|playmode-shard-[0-9]+|editmode-summary)$'
GH_SECS=30     # guard on each gh call
SYNC_SECS=60   # guard on the whole sync: the unit's TimeoutStartSec of 120 must leave the tick its time
MAX_AGE_H=24   # a red run older than this is not read: SHARED looks at 2h, so a backfill past a day is waste
TRIES=3        # a run whose artifacts fail to read this many times is given up as read
KEEP_DAYS=7    # ledger lines older than this are dropped when a sync writes

die() { echo "pool-test-failures: $*" >&2; exit "${2:-2}"; }

# gh_t <args>: gh under GH_SECS, cut to what is left of the sync's SYNC_SECS.
deadline=$((SECONDS + SYNC_SECS))
gh_t() {
  local left=$((deadline - SECONDS))
  [ "$left" -gt 0 ] || return 124
  timeout "$((left < GH_SECS ? left : GH_SECS))" gh "$@"
}

# failed_cases <dir>: each failed case the summary.txt files under <dir> name, once.
# A full run's playmode-summary repeats its shards' lines, hence the sort -u. awk reads each file
# itself, so one with no final newline cannot run into the next one's first line.
failed_cases() {
  find "$1" -name summary.txt -exec awk -F'\t' '
    /^FAIL / { for (i = 2; i <= NF; i++) if ($i == "cases:") { for (j = i + 1; j <= NF; j++) if ($j != "") print $j; next } }' {} + 2>/dev/null |
    sort -u
}

# worktrees <checkout>: "branch <TAB> worktree basename" for each checked-out branch.
worktrees() {
  git -C "$1" worktree list --porcelain 2>/dev/null | awk '
    /^worktree / { n = split(substr($0, 10), p, "/"); wt = p[n] }
    /^branch refs\/heads\// { print substr($2, 12) "\t" wt }'
}

# store_t <args>: the repo's artifact lister (STORE_CMD, set by sync) under the same guard as gh_t.
store_t() {
  local left=$((deadline - SECONDS))
  [ "$left" -gt 0 ] || return 124
  timeout "$((left < GH_SECS ? left : GH_SECS))" env GITHUB_REPOSITORY="$STORE_REPO" python3 "$STORE_CMD" "$@"
}

# fetch_summaries <id> <dir>: the run's summary artifacts, each into <dir>/<name>, from the repo's home
# artifact store when project-map.json declares one (artifactStore), else from GitHub's artifacts API.
# Returns 1 when they could not be read; 0 with <dir> empty when the run has no summary.
fetch_summaries() {
  local id="$1" dir="$2" names n args=()
  if [ -n "$STORE_CMD" ]; then
    # only the two name prefixes read, so the listing skips the logs, plans and test-runs objects
    names="$(store_t ls playmode- --run "$id" && store_t ls editmode- --run "$id")" || return 1
    names="$(awk '{ print $1 }' <<<"$names")"
  else
    names="$(gh_t api "repos/{owner}/{repo}/actions/runs/$id/artifacts?per_page=100" \
      --jq '.artifacts[] | select(.expired | not) | .name')" || return 1
  fi
  names="$(grep -E "$ARTIFACTS" <<<"$names" | sort -u)"
  # A red with no summary (the plan failed, a runner died before reporting) names no test.
  [ -n "$names" ] || return 0
  if [ -n "$STORE_CMD" ]; then
    while IFS= read -r n; do
      mkdir -p "$dir/$n" && store_t get "$n" --run "$id" --dir "$dir/$n" >/dev/null || return 1 # its stderr (no credentials, store down) goes to the journal
    done <<<"$names"
  else
    while IFS= read -r n; do args+=(-n "$n"); done <<<"$names"
    gh_t run download "$id" -D "$dir" "${args[@]}" >/dev/null 2>&1 || return 1
  fi
}

# read_run <id> <ended epoch> <branch> <worktrees file>: append the run's failed cases.
# Returns 1 when its artifacts could not be read, so the next sync tries it again.
read_run() {
  local id="$1" end="$2" branch="$3" dir wt
  dir="$(mktemp -d)"
  if ! fetch_summaries "$id" "$dir"; then
    rm -rf "$dir"; return 1
  fi
  wt="$(awk -F'\t' -v b="$branch" '$1 == b { print $2; exit }' "$4")"
  failed_cases "$dir" | awk -v OFS='\t' -v e="$end" -v w="${wt:--}" -v b="$branch" '{ print e, w, b, $0 }' >> "$LEDGER"
  rm -rf "$dir"
}

sync() {
  local here checkout runs id attempt end branch wts wrote=0
  here="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
  # shellcheck source=/dev/null
  . "$here/../../.config/shared-hooks/project-name.sh" || die "cannot load project-name.sh"
  checkout="$(project_repo_path "$POOL_FAILURES_PROJECT")"
  [ -d "$checkout" ] || die "no checkout of $POOL_FAILURES_PROJECT in project-map.json"
  # artifactStore: the lister's path in the clone. A repo that declares one no longer uploads these
  # artifacts to GitHub (unity-core-playground #3063), so GitHub is not read for it.
  STORE_CMD="$(project_field "$POOL_FAILURES_PROJECT" artifactStore)"
  if [ -n "$STORE_CMD" ]; then
    STORE_REPO="$(project_field "$POOL_FAILURES_PROJECT" github)"
    [ -n "$STORE_REPO" ] || die "$POOL_FAILURES_PROJECT has an artifactStore but no github slug in project-map.json"
    STORE_CMD="$checkout/$STORE_CMD"
    [ -f "$STORE_CMD" ] || die "artifact lister $STORE_CMD is missing"
  fi
  mkdir -p "$(dirname "$LEDGER")"
  exec 9>"$SEEN.lock"
  flock -n 9 || return 0 # another sync is reading the same runs
  cd "$checkout" || die "cannot enter $checkout"
  # A scheduled run is the nightly, not a gate: its reds are fleet-sessions' NIGHTLY row.
  runs="$(gh_t run list -w "$POOL_FAILURES_WORKFLOW" --status failure -L "$POOL_FAILURES_RUNS" \
    --json databaseId,attempt,event,headBranch,updatedAt \
    --jq ".[] | select(.event != \"schedule\") | (.updatedAt | fromdateiso8601) as \$e
          | select(\$e > now - $MAX_AGE_H * 3600) | [.databaseId, .attempt, \$e, .headBranch] | @tsv")" ||
    die "gh run list failed in $checkout" 1
  touch "$SEEN" "$SEEN.fail"
  wts="$(mktemp)"; worktrees "$checkout" > "$wts"
  # Oldest first, so the ledger stays in time order.
  while IFS=$'\t' read -r id attempt end branch; do
    [ -n "$id" ] || continue
    grep -qxF "$id.$attempt" "$SEEN" && continue
    [ "$SECONDS" -lt "$deadline" ] || break # the rest wait for the next sync
    if read_run "$id" "$end" "$branch" "$wts"; then wrote=1
    else
      echo "$id.$attempt" >> "$SEEN.fail"
      [ "$(grep -cxF "$id.$attempt" "$SEEN.fail")" -ge "$TRIES" ] || continue
      echo "pool-test-failures: run $id unreadable $TRIES times, given up" >&2
    fi
    echo "$id.$attempt" >> "$SEEN"
  done < <(sort -t$'\t' -k3,3n <<<"$runs")
  rm -f "$wts"
  # Keep the seen lists to the runs a listing can still return, and the ledger to KEEP_DAYS.
  local f
  for f in "$SEEN" "$SEEN.fail"; do tail -n $((POOL_FAILURES_RUNS * 10)) "$f" > "$f.tmp" && mv "$f.tmp" "$f"; done
  [ "$wrote" = 1 ] && [ -f "$LEDGER" ] && awk -F'\t' -v cut="$(($(date +%s) - KEEP_DAYS * 86400))" '$1 >= cut' "$LEDGER" > "$LEDGER.tmp" &&
    mv "$LEDGER.tmp" "$LEDGER"
  return 0
}

case "${1:-}" in
  sync) sync ;;
  cases) [ -d "${2:-}" ] || die "usage: pool-test-failures cases <artifact dir>"; failed_cases "$2" ;;
  *) echo "usage: pool-test-failures sync | cases <artifact dir>" >&2; exit 2 ;;
esac
