#!/usr/bin/env bash
# agentctl-docs-cleanup - the nightly docs cleanup pass: count the drift, then queue one session per drifted area to fix it.
#
#   agentctl-docs-cleanup [--dry-run]     agentctl: docs-cleanup.conf; --dry-run counts and prints the tasks, queues nothing
#
# Deterministic: no model runs here. It writes tonight's baseline to the inbox (skill-drift over the
# skills, skill-drift --docs over the global docs, skill-drift --dups --check over every home that
# restates an instruction, the size of every lessons file, its open correction chains, and
# `notes knowledge lint` over the knowledge base with the knowledge-retired list), and for each area
# with drift and no pass already open (skills, docs, dups, chains, knowledge) it files one pass that
# runs the docs-cleanup skill on that area of the baseline, under the slug docs-cleanup-pass-<area>.
# Only the board fills the queue (QUEUE.md "Admission"), so each pass is a board row (agent-queue
# exit 5) that fleet-dispatch promotes and starts, so an unattended pass starts only on an account
# under its weekly pace. The session lands its area's fixes by PR.
#
# It replaced the weekly propose-only skill-refine runner: six reports (2026-09-28 to 11-02) while
# skill DEADPATH rose from 25 to 31 showed that a report nobody applies fixes nothing.
#
# Verdict: WORKED when it filed a pass, NOOP when there was no drift or every drifted area's pass is
# still open, FAILED when a count could not be taken, an add failed, or an area's open pass has sat
# unstarted (on the board, or queued) past DOCS_CLEANUP_STARVED_DAYS; the other areas are filed first.
set -uo pipefail
# shellcheck source=/dev/null
. "$HOME/.local/lib/agent-proof.sh" || { echo "agentctl-docs-cleanup: agent-proof.sh not found; cannot publish an outcome" >&2; exit 1; }
NAME="${AGENTCTL_NAME:-docs-cleanup}"
# Each area's pass is queued under $SLUG-<area>; a bare $SLUG is the whole pass an old row line names.
SLUG=docs-cleanup-pass
# Provisional, confidence medium: 2 nights unstarted is a starved pass, not a busy queue. The pass
# queued 2026-11-06 at low sat 5 nights behind 678 high and urgent items, each night a quiet NOOP.
# Revisit when a pass at high still waits more than one night.
STARVED_DAYS="${DOCS_CLEANUP_STARVED_DAYS:-2}"
DRY=0; [ "${1:-}" = --dry-run ] && DRY=1
# A dry run publishes no outcome: it is a look, not a run.
report() { [ "$DRY" = 1 ] || proof_outcome "$NAME" "$@"; }
fail() { report FAILED "$1"; echo "$1" >&2; exit 1; }
INBOX="${AGENTCTL_INBOX:-$HOME/.local/state/agentctl/docs-cleanup}"
LESSONS="${DOCS_CLEANUP_LESSONS:-$HOME/.agent/lessons}"
# Tools by path beside this script, so a worktree run counts with the worktree's copy.
HERE="$(dirname "$(readlink -f "$0")")"
DRIFT="$HERE/skill-drift"
stamp="$(date +%Y%m%d)"
dir="$INBOX/$stamp"
mkdir -p "$dir"

# skill-drift exits 1 whenever it finds anything; only output that is not valid JSON is a failure.
snap() {
    local name=$1; shift
    "$DRIFT" "$@" > "$dir/$name.json" 2>"$dir/$name.err"
    jq -e . "$dir/$name.json" >/dev/null 2>&1 || fail "skill-drift $* gave no JSON ($dir/$name.err)"
}
snap skills --json
snap docs --docs --json
# A dead path whose file git renamed is fixed by script in the docs outside the dotfiles checkouts
# (those need a PR, so the pass edits them: status "repo"); the counts are then taken over the result.
mode=--apply; [ "$DRY" = 1 ] && mode=
"$HERE/docs-renamed-paths" $mode "$dir/skills.json" "$dir/docs.json" > "$dir/renames.tsv" 2>"$dir/renames.err" \
    || fail "docs-renamed-paths failed ($dir/renames.err)"
if grep -q '^fixed' "$dir/renames.tsv"; then
    snap skills --json
    snap docs --docs --json
fi
# --check exits 1 over the dup_pairs_max baseline in kpi-thresholds and still prints the JSON; with no
# such row it exits 2 with no JSON, so a lost baseline reads FAILED, never "no drift".
snap dups --dups --check --json
# A chain whose target is still in the file is archived by script (the corrector stays, its marker goes),
# so the chains below are the ones a session has to read: a dangling marker.
sup=; [ "$DRY" = 1 ] && sup=--dry-run
"$HERE/lessons" supersede $sup "$LESSONS" > "$dir/superseded.txt" 2>&1 \
    || fail "lessons supersede failed on $LESSONS ($dir/superseded.txt)"
for f in "$LESSONS"/*.md; do [ -f "$f" ] && printf '%s\t%s\n' "$(wc -c < "$f")" "$(basename "$f")"; done \
    | sort -rn > "$dir/lessons.tsv"
# A correction chain (a lesson whose supersedes marker names another, or names a key no lesson
# carries any more) is drift: pick already hides the named lesson, and the pass folds the two.
"$HERE/lessons" chains "$LESSONS" > "$dir/chains.tsv" \
    || fail "lessons chains failed on $LESSONS"
chains_n="$(awk 'END { print NR }' "$dir/chains.tsv")"
# Knowledge drift: `notes knowledge lint` over the vault with the retired list, so a page that
# still names a sold host or a deleted command as live counts beside the registry classes.
"$HERE/knowledge-retired" > "$dir/retired.tsv" 2>"$dir/retired.err" \
    || fail "knowledge-retired failed ($dir/retired.err)"
notes knowledge lint --json --retired "$dir/retired.tsv" > "$dir/knowledge.json" 2>"$dir/knowledge.err"
jq -e '.total | numbers' "$dir/knowledge.json" >/dev/null 2>&1 \
    || fail "notes knowledge lint gave no JSON ($dir/knowledge.err)"
knowledge_n="$(jq '.total' "$dir/knowledge.json")"

# UNUSED, STALE and PROMOTE are signals for a human, not drift a session can fix, so they do not count here.
skills_n="$(jq '[.findings[] | select(.type != "UNUSED" and .type != "STALE" and .type != "PROMOTE")] | length' "$dir/skills.json")"
docs_n="$(jq '.drift' "$dir/docs.json")"
dups_n="$(jq '.pairs' "$dir/dups.json")"
dups_over="$(jq '.over' "$dir/dups.json")"
dups_max="$(jq '.max' "$dir/dups.json")"
lessons_kb="$(awk '{s += $1} END {printf "%d", s / 1024}' "$dir/lessons.tsv")"
summary="skills $skills_n, global docs $docs_n, restated pairs $dups_n (baseline $dups_max), lessons ${lessons_kb} KB, correction chains $chains_n, knowledge $knowledge_n"
printf '%s\n' "$summary" > "$dir/summary.txt"

# Each drifted area is its own pass, so its own board row: the dispatch judge skipped the one row
# that named every area as a bundle (ar-2163, 2026-11-18). An area is named by its baseline file, and
# its words are its part of the summary. The lessons size rides with the chains, since a chain is
# folded in a lessons file; on its own it is a figure, not drift.
declare -A said=()
[ "$skills_n" = 0 ] || said[skills]="skills $skills_n"
[ "$docs_n" = 0 ] || said[docs]="global docs $docs_n"
[ "$dups_over" = 0 ] || said[dups]="restated pairs $dups_n (baseline $dups_max)"
[ "$chains_n" = 0 ] || said[chains]="correction chains $chains_n, lessons ${lessons_kb} KB"
[ "$knowledge_n" = 0 ] || said[knowledge]="knowledge $knowledge_n"
AREAS="skills docs dups chains knowledge"

if [ "${#said[@]}" = 0 ]; then
    report NOOP "no drift ($summary)"
    echo "docs-cleanup: no drift ($summary)"
    exit 0
fi

# The board rows the last adds filed (ROWF: one "<board>\t<id>\t<filed epoch>\t<area>" line per
# area) are the open passes while the board lists them: open is not started yet, starved past
# STARVED_DAYS; doing is an item working it. A row the board no longer lists closed or was dropped,
# so its line goes and tonight files that area again. A line with no area is from when one row was
# the whole pass: while the board lists it, every area waits on it, as it did then.
ROWF="$INBOX/row"
keep=()
declare -A open_row=()
if [ -s "$ROWF" ]; then
    board="$(notes board --json 2>/dev/null)" && [ -n "$board" ] || fail "could not read the board for the pass rows in $ROWF ($summary)"
    while IFS=$'\t' read -r rboard rid filed_s rarea; do
        [ -n "$rid" ] || continue
        rstate="$(jq -r --arg p "$rboard" --arg k "$rid" 'first(.rows[]? | select(.project == $p and .id == $k) | .state) // empty' <<<"$board")"
        [ -n "$rstate" ] || continue
        if [ -z "$rarea" ]; then
            [ "$rstate" != open ] || [ $(( $(date +%s) - filed_s )) -lt $(( STARVED_DAYS * 86400 )) ] \
                || fail "pass $SLUG starved: board row $rid on $rboard filed $(date -d "@$filed_s" +%F), never started ($summary)"
            report NOOP "pass $SLUG is board row $rid on $rboard, $rstate ($summary)"
            echo "docs-cleanup: pass $SLUG is board row $rid on $rboard, $rstate, not filing another ($summary)"
            exit 0
        fi
        keep+=("$rboard"$'\t'"$rid"$'\t'"$filed_s"$'\t'"$rarea")
        open_row[$rarea]="$rboard"$'\t'"$rid"$'\t'"$filed_s"$'\t'"$rstate"
    done < "$ROWF"
fi

# The skill is the one this runner's conf names, so a rename is one edit in the conf.
skill="$(agentctl skill "$NAME" 2>/dev/null)" && [ -n "$skill" ] || fail "no SKILL= in the $NAME conf (agentctl skill $NAME)"
# What each area came to: filed (a new pass), open (a pass still waiting or working) or bad (a
# starved pass or a failed add). A bad area does not stop the others, and the night reads FAILED.
filed=() open=() bad=()
for a in $AREAS; do
    [ -n "${said[$a]:-}" ] || continue
    slug="$SLUG-$a"
    # One pass at a time per area under its slug: agent-queue refuses a second active item with it,
    # and a finished one sits in done/ where `show` still finds it, so only an active state means
    # "open". Each night's pass is new work under that slug, so it is queued --repeat.
    item="$(agent-queue show "$slug" --json 2>/dev/null)"
    state="$(jq -r '.state // empty' <<<"$item" 2>/dev/null)"
    # Starved: queued past STARVED_DAYS with nothing holding it. Another hold
    # (after, focus, ask) is the queue's own choice, not starvation.
    if [ "$state" = queued ] && jq -e '(.hold // "") == ""' <<<"$item" >/dev/null; then
        queued_at="$(jq -r '.queued // empty' <<<"$item")"
        if ! queued_s="$(date -d "$queued_at" +%s 2>/dev/null)" || [ -z "$queued_at" ]; then
            bad+=("pass $slug has no readable queued time ('$queued_at'), cannot judge starvation"); continue
        fi
        [ $(( $(date +%s) - queued_s )) -lt $(( STARVED_DAYS * 86400 )) ] \
            || { bad+=("pass $slug starved: queued since $queued_at, never started"); continue; }
    fi
    case "$state" in
        queued|running|waiting|review)
            open+=("$slug $state")
            echo "docs-cleanup: pass $slug still $state, not queuing another"
            continue ;;
    esac
    if [ -n "${open_row[$a]:-}" ]; then
        IFS=$'\t' read -r rboard rid filed_s rstate <<<"${open_row[$a]}"
        if [ "$rstate" = open ] && [ $(( $(date +%s) - filed_s )) -ge $(( STARVED_DAYS * 86400 )) ]; then
            bad+=("pass $slug starved: board row $rid on $rboard filed $(date -d "@$filed_s" +%F), never started"); continue
        fi
        open+=("$slug row $rid $rstate")
        echo "docs-cleanup: pass $slug is board row $rid on $rboard, $rstate, not filing another"
        continue
    fi
    task="Run the $skill skill on area $a of tonight's baseline in ${dir/#$HOME/\~}: ${said[$a]}. Fix it by cause in one PR and write the pass report."
    if [ "$DRY" = 1 ]; then
        echo "docs-cleanup: would queue $slug: $task"
        continue
    fi
    # An automated filer: the add files a board row and exits 5 (QUEUE.md "Admission"); exit 0 is a
    # pulled run (AGENT_QUEUE_PULL), queued under $slug. High plus `cleanup` is where the queue orders
    # the fleet's own housekeeping (agent-queue ORDER); a row the add files keeps the priority, not the
    # tag, and an open twin row it lands on takes both, with this brief (agent-queue file_story).
    out="$(agent-queue add --project dotfiles --from auto:docs-cleanup --slug "$slug" --repeat --priority high --tags cleanup "$task")"
    rc=$?
    printf '%s\n' "$out" >&2
    case "$rc" in
        0) filed+=("queued $slug") ;;
        5) rboard='' rid=''
           IFS=: read -r rboard rid < <(sed -n '/^held [^ ]* -> \([^ ]*:[^ ]*\).*/{s//\1/p;q;}' <<<"$out")
           [ -n "${rid:-}" ] || { bad+=("the board took pass $slug but printed no held line"); continue; }
           keep+=("$rboard"$'\t'"$rid"$'\t'"$(date +%s)"$'\t'"$a")
           filed+=("filed $slug as board row $rid on $rboard") ;;
        *) bad+=("could not file pass $slug") ;;
    esac
done

# ROWF is rewritten once, before any verdict, so a night that files one area and finds another
# starved still records the row it filed.
if [ "$DRY" != 1 ]; then
    if [ "${#keep[@]}" -gt 0 ]; then printf '%s\n' "${keep[@]}" > "$ROWF"; else rm -f "$ROWF"; fi
fi
# join <part...> -> the parts as one "; "-separated line, for the outcome.
join() { local s; s="$(printf '%s; ' "$@")"; printf '%s' "${s%; }"; }
[ "${#bad[@]}" = 0 ] || fail "$(join "${bad[@]}") ($summary)"
[ "$DRY" != 1 ] || exit 0
if [ "${#filed[@]}" -gt 0 ]; then report WORKED "$(join "${filed[@]}") ($summary)"
else report NOOP "passes still open: $(join "${open[@]}") ($summary)"; fi
