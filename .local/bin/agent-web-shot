#!/usr/bin/env python3
"""agent-web-shot: screenshot agent-web pages in a headless scratch Firefox over raw Marionette.

usage: agent-web-shot [--base URL] [--cookie NAME=VALUE] [--width PX] [--height PX] --out DIR HASH...

Each HASH (`releases`, `releases/apps/binks`, `fleet?s=failed`) is opened under --base and saved
as DIR/<hash>-<width>.png, the whole page. The cookie signs the browser in: `agent_web=dev` for the
dev instance in .local/src/agent-web/README.md ("look at a change"). A page is shot once its tab
element has drawn and no visible element on the page is only a placeholder ("Loading.", "Reading the
tabs.", "reading..."), watched by a MutationObserver.

The profile is a new one under ~/.cache/agent-web-shot/, removed on exit, and only the Firefox this
started is stopped, by its process group. Never point this at the live Firefox profile.
"""
import argparse
import base64
import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time

# The page has drawn when this holds; the observer re-checks it on every DOM change.
READY = r"""
const [tab, done] = [arguments[0], arguments[arguments.length - 1]];
// Busy while a visible element's whole text is a placeholder: "Loading.", "Reading the tabs.",
// "reading...". A row that merely mentions reading, or a closed fold that reads on open, is not one.
const PLACEHOLDER = /^(loading|reading)\b[^.]{0,80}(\.\.\.|\.)$/i;
const busy = (el) => [...el.querySelectorAll("*")].some((e) =>
  !e.children.length && PLACEHOLDER.test(e.textContent.trim()) && e.checkVisibility());
// A tab draws into its own section (#home), or into #main's detail pane (#sessions draws into
// #scroll); the placeholder scan covers all of #main, where a hidden tab is not visible.
const ok = () => { const el = document.getElementById(tab) || document.getElementById("main"); return el && el.innerHTML.trim() && !busy(document.getElementById("main")); };
if (ok()) return done(true);
const mo = new MutationObserver(() => { if (ok()) { mo.disconnect(); done(true); } });
mo.observe(document.body, { childList: true, subtree: true, characterData: true });
"""
# How long a page may take to draw before the shot is taken anyway, with a warning.
DRAW_TIMEOUT_MS = 20000
# Marionette has no readiness event: the port is tried at this cadence until Firefox listens.
CONNECT_EVERY_S, CONNECT_TRIES = 0.25, 240
# A guard on one Marionette reply, past the draw timeout a page is given.
REPLY_TIMEOUT_S = DRAW_TIMEOUT_MS / 1000 + 30


class Marionette:
    def __init__(self, port):
        for _ in range(CONNECT_TRIES):
            try:
                self.s = socket.create_connection(("127.0.0.1", port), timeout=REPLY_TIMEOUT_S)
                break
            except OSError:
                time.sleep(CONNECT_EVERY_S)
        else:
            raise SystemExit("agent-web-shot: Firefox never opened its Marionette port")
        self.buf, self.id = b"", 0
        self._read()

    def _recv(self):
        chunk = self.s.recv(65536)
        if not chunk:
            raise SystemExit("agent-web-shot: Firefox closed its Marionette connection")
        return chunk

    def _read(self):
        while b":" not in self.buf:
            self.buf += self._recv()
        n, rest = self.buf.split(b":", 1)
        while len(rest) < int(n):
            rest += self._recv()
        self.buf = rest[int(n):]
        return json.loads(rest[: int(n)])

    def cmd(self, name, **params):
        self.id += 1
        msg = json.dumps([0, self.id, name, params]).encode()
        self.s.sendall(str(len(msg)).encode() + b":" + msg)
        r = self._read()
        if r[2]:
            raise RuntimeError(f"{name}: {r[2].get('message')}")
        return r[3]


def free_port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--base", default="http://127.0.0.1:8799")
    ap.add_argument("--cookie", default="agent_web=dev")
    ap.add_argument("--width", type=int, default=1400)
    ap.add_argument("--height", type=int, default=900)
    ap.add_argument("--out", required=True)
    ap.add_argument("hashes", nargs="+")
    a = ap.parse_args()
    os.makedirs(a.out, exist_ok=True)
    root = os.path.expanduser("~/.cache/agent-web-shot")
    os.makedirs(root, exist_ok=True)
    prof = tempfile.mkdtemp(prefix="profile-", dir=root)
    ff = None
    try:
        port = free_port()
        with open(f"{prof}/user.js", "w") as f:
            for k, v in {"marionette.port": port, "browser.shell.checkDefaultBrowser": False,
                         "datareporting.policy.dataSubmissionEnabled": False, "browser.aboutwelcome.enabled": False}.items():
                f.write(f'user_pref("{k}", {json.dumps(v)});\n')
        with open(f"{prof}/firefox.log", "w") as log:
            ff = subprocess.Popen(["firefox", "--headless", "--no-remote", "--marionette", "--profile", prof],
                                  stdout=log, stderr=log, start_new_session=True)
        m = Marionette(port)
        m.cmd("WebDriver:NewSession", capabilities={})
        m.cmd("WebDriver:SetTimeouts", script=DRAW_TIMEOUT_MS)
        m.cmd("WebDriver:SetWindowRect", width=a.width, height=a.height)
        name, value = a.cookie.split("=", 1)
        m.cmd("WebDriver:Navigate", url=a.base + "/healthz")
        m.cmd("WebDriver:AddCookie", cookie={"name": name, "value": value, "path": "/"})
        for h in a.hashes:
            # A new hash on the same page would not reload it: load the page fresh each time.
            m.cmd("WebDriver:Navigate", url=a.base + "/healthz")
            m.cmd("WebDriver:Navigate", url=f"{a.base}/#{h}")
            tab = h.split("/")[0].split("?")[0]
            try:
                m.cmd("WebDriver:ExecuteAsyncScript", script=READY, args=[tab])
            except RuntimeError as e:
                print(f"agent-web-shot: #{h} had not drawn in {DRAW_TIMEOUT_MS} ms ({e}); shooting it as it is", file=sys.stderr)
            png = m.cmd("WebDriver:TakeScreenshot", full=True)["value"]
            path = os.path.join(a.out, f"{h.replace('/', '_').replace('?', '_')}-{a.width}.png")
            with open(path, "wb") as f:
                f.write(base64.b64decode(png))
            print(path)
    finally:
        if ff:
            stop(ff)
        shutil.rmtree(prof, ignore_errors=True)


def stop(ff):
    """Stop the Firefox this started and every process in its group; one already gone is fine."""
    try:
        os.killpg(ff.pid, signal.SIGTERM)
        ff.wait(timeout=10)
    except ProcessLookupError:
        return
    except subprocess.TimeoutExpired:
        try:
            os.killpg(ff.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass


if __name__ == "__main__":
    main()
