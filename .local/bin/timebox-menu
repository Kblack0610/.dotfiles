#!/usr/bin/env bash
# timebox control menu for the Waybar module (bound to left-click). Uses wofi, falling
# back to rofi. Lets you start/switch/run a cycle/pause/resume/lap/stop, flip the sound and
# flash alerts, and peek at stats from the bar without touching a terminal.
# `timebox-menu <action>` skips the first menu (e.g. `timebox-menu cycle`).
set -u

menu() {
    if command -v wofi >/dev/null 2>&1; then
        wofi --dmenu -i -p "$1"
    elif command -v rofi >/dev/null 2>&1; then
        rofi -dmenu -i -p "$1"
    else
        return 1
    fi
}

action="${1:-}"
if [ -z "$action" ]; then
    alerts=$(timebox status | sed -n 's/^alerts: //p')
    action=$(printf '%s\n' start switch cycle pause resume "lap / next step" stop "stop all" \
        "toggle sound" "toggle flash" stats | menu "timebox (${alerts:-alerts})") || exit 0
fi
[ -n "$action" ] || exit 0

# For start/switch, offer a few common ops but allow typing any name.
ops="focus\ndeep-work\nemail\nmeeting\nreading\nbreak"
# Lap presets; "default" uses config default_lap, and any typed value (e.g. 45m) works.
laps="default\n25m\n45m\n50m\n1h\n15m\n5m"

# Pick a lap interval; echoes the `--lap X` args (empty for default).
pick_lap() {
    local lap
    lap=$(printf "$laps" | menu "lap for $1")
    case "$lap" in
        "" | default) : ;;
        *) printf -- '--lap %s' "$lap" ;;
    esac
}

case "$action" in
    start)  op=$(printf "$ops" | menu "start op"); [ -n "$op" ] && timebox start "$op" $(pick_lap "$op") ;;
    switch) op=$(printf "$ops" | menu "switch to"); [ -n "$op" ] && timebox switch "$op" $(pick_lap "$op") ;;
    pause)  timebox pause ;;
    resume) timebox resume ;;
    cycle)
        cycles=$(timebox cycle 2>&1) || { agent-notify -t "timebox" "$cycles"; exit 0; }
        pick=$(printf '%s\n' "$cycles" | menu "cycle") || exit 0
        name="${pick%%:*}"
        [ -n "$name" ] && timebox cycle "$name"
        ;;
    lap | "lap / next step") timebox lap ;;
    "toggle sound") agent-notify -t "timebox" "$(timebox toggle sound)" ;;
    "toggle flash") agent-notify -t "timebox" "$(timebox toggle flash)" ;;
    stop)   timebox stop ;;
    "stop all") timebox stop --all ;;
    stats)  agent-notify -t "timebox stats" "$(timebox stats)" ;;
esac
