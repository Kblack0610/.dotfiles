#!/usr/bin/env bash
# skill-deploy - link every skill in both repos into ~/.claude/skills.
#
# The fixer for skill-drift's UNDEPLOYED finding. ~/.claude/skills is a plain
# untracked directory of hand-made symlinks pointing back into ~/.dotfiles and
# ~/.dotfiles-private. Nothing ever created it from the repos, so "add a skill"
# silently had a second step: remember to symlink it. Forgetting is invisible -
# the SKILL.md is committed, merged, and bulleted in CLAUDE.md, but the agent
# never sees it, because a skill is only reachable if a link exists.
#
# That is exactly how `comms` and `meeting-ingest` sat undeployed: both written,
# both merged, both documented, neither reachable. skill-drift found them months
# later. This script closes the loop so the detector has a one-command answer
# instead of a manual `ln -s` that is itself easy to get wrong.
#
# Idempotent by construction: an already-correct link is left alone, so this is
# safe to run from provisioning on every boot and safe to run twice.
#
# It NEVER clobbers. A name that already exists as a real directory, or as a
# link pointing somewhere unexpected, is reported as CONFLICT and skipped -
# resolving it needs a human who knows which copy is the real one. Same for a
# name present in BOTH repos: silently preferring one would create the second
# source of truth this whole split exists to avoid.
#
# The ONE exception is --adopt, and only for a directory this system provably
# created itself: see adoptable() below.
#
# Layout-agnostic. A skill is "a directory containing SKILL.md", found at any
# depth under .claude/skills, so both the flat <name>/ and the categorised
# <category>/<name>/ layouts deploy to the same flat ~/.claude/skills/<name>.
# That flattening is required, not cosmetic: Claude Code reads personal skills
# from ~/.claude/skills/<skill-name>/SKILL.md, one level only. It does follow a
# symlink there to a directory anywhere on disk, which is what lets the REPO
# organise into categories the deployed tree cannot have.
#
# Usage:
#   skill-deploy              create missing links, report what changed
#   skill-deploy --dry-run    report only, touch nothing
#   skill-deploy --quiet      print only changes and conflicts (for provisioning)
#   skill-deploy --adopt      also replace stow-made link farms (see adoptable)
set -uo pipefail

SKILLS="${CLAUDE_SKILLS:-$HOME/.claude/skills}"
PUB="${DOTFILES:-$HOME/.dotfiles}"
PRIV="${DOTFILES_PRIVATE:-$HOME/.dotfiles-private}"

DRY=0 QUIET=0 ADOPT=0
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY=1 ;;
    --quiet)   QUIET=1 ;;
    --adopt)   ADOPT=1 ;;
    -h|--help) sed -n '2,38p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) printf 'skill-deploy: unknown option %s\n' "$arg" >&2; exit 2 ;;
  esac
done

say()  { [ "$QUIET" = 1 ] || printf '%s\n' "$*"; }
loud() { printf '%s\n' "$*"; }

mkdir -p "$SKILLS"

# Link target, relative to $SKILLS. For the normal layout this reproduces the
# existing convention exactly (../../.dotfiles-private/.claude/skills/<name>),
# but it is computed from where $SKILLS actually is rather than assumed - a
# hand-written ../../ silently dangles the moment CLAUDE_SKILLS points anywhere
# but ~/.claude/skills, which is precisely how a sandbox run produced 56 broken
# links that still reported success. Absolute is the fallback: an ugly link that
# resolves beats a tidy one that does not.
rel_target() {
  local abs=$1
  if command -v realpath >/dev/null 2>&1; then
    realpath -m --relative-to="$SKILLS" "$abs" 2>/dev/null || printf '%s\n' "$abs"
  else
    printf '%s\n' "$abs"
  fi
}

# A real directory in $SKILLS is normally untouchable. The single exception is a
# link farm: a directory whose every entry is a symlink resolving back into one
# of the two repos. `stow --no-folding` produces exactly that shape when it
# deploys .claude/skills - a real dir holding a per-file link - and it is a
# strictly worse deployment than ours, because only the files that existed at
# stow time are linked: add references/ to the source later and it never appears.
#
# Such a directory has no content of its own to lose, so replacing it with a
# whole-directory symlink is information-preserving. Anything else - a real file,
# a link pointing outside the repos, an empty dir - is NOT adoptable and still
# reports CONFLICT. This is deliberately narrow: it exists to migrate a shape
# this repo's own provisioning created, not to make --adopt a general override.
adoptable() {
  local d=$1 entry tgt found=0
  [ -d "$d" ] && [ ! -L "$d" ] || return 1
  shopt -s nullglob dotglob
  local entries=("$d"/*)
  shopt -u nullglob dotglob
  [ ${#entries[@]} -gt 0 ] || return 1        # empty dir: not provably ours
  for entry in "${entries[@]}"; do
    [ -L "$entry" ] || return 1
    # -m, not -f. `readlink -f` requires every component but the last to exist,
    # so it FAILS on a farm whose target moved - which is precisely the farm most
    # in need of adopting. After the category migration all three surviving farms
    # pointed at <repo>/.claude/skills/<name>/SKILL.md, a directory that no longer
    # existed, and -f rejected them as unadoptable. -m canonicalises without
    # requiring existence, so a farm is judged on WHERE it points, not on whether
    # that still resolves. A dangling link has even less to lose than a live one.
    tgt=$(readlink -m "$entry" 2>/dev/null) || return 1
    case "$tgt" in
      "$PUB"/*|"$PRIV"/*) found=1 ;;
      *) return 1 ;;
    esac
  done
  [ "$found" = 1 ]
}

linked=0 already=0 conflict=0 adopted=0 relinked=0

# Collision guard: a skill name defined in both repos is ambiguous, not a race.
# Discovery is by SKILL.md rather than by directory so the flat and categorised
# layouts both work, and so a non-skill sibling (SKILL-TEMPLATE.md, a category
# dir's own README) is never mistaken for a skill.
declare -A OWNER=() SRC=()
for repo in "$PUB" "$PRIV"; do
  [ -d "$repo/.claude/skills" ] || continue
  while IFS= read -r manifest; do
    [ -n "$manifest" ] || continue
    dir=$(dirname "$manifest")
    name=$(basename "$dir")
    if [ -n "${OWNER[$name]:-}" ]; then
      loud "CONFLICT  $name  defined in BOTH ${SRC[$name]} and $dir - skipped, resolve by hand"
      OWNER[$name]="__ambiguous__"
      conflict=$((conflict + 1))
    else
      OWNER[$name]=$repo
      SRC[$name]=$dir
    fi
  done < <(find "$repo/.claude/skills" -mindepth 2 -maxdepth 3 -name SKILL.md -type f 2>/dev/null | sort)
done

for name in $(printf '%s\n' "${!OWNER[@]}" | sort); do
  repo=${OWNER[$name]}
  [ "$repo" = "__ambiguous__" ] && continue
  src=${SRC[$name]}
  want=$(rel_target "$src")
  link="$SKILLS/$name"

  if [ -L "$link" ]; then
    have=$(readlink "$link")
    if [ "$have" = "$want" ]; then
      already=$((already + 1)); continue
    fi
    # A link that resolves to the same place by another spelling is fine.
    if [ -e "$link" ] && [ "$(cd "$(dirname "$link")" && readlink -f "$have")" = "$(readlink -f "$src")" ]; then
      already=$((already + 1)); continue
    fi
    # A DANGLING link whose old target was inside one of the two repos is a skill
    # whose source moved - a re-categorisation, or a hop between the public and
    # private repos. It points at nothing, so there is no other copy to lose and
    # nothing for a human to adjudicate: repoint it.
    #
    # This is narrower than it looks, and deliberately so. A link that still
    # RESOLVES but resolves somewhere unexpected stays a CONFLICT, because that
    # is the case where two real things disagree and only a human knows which is
    # meant. Only "points into our repos, and the target is gone" is auto-fixed.
    #
    # Without this the category migration stranded every machine: 29 dangling
    # links, and skill-deploy refused all of them and exited 1.
    if [ ! -e "$link" ]; then
      case "$(cd "$(dirname "$link")" 2>/dev/null && readlink -f "$have" 2>/dev/null)" in
        "$PUB"/*|"$PRIV"/*)
          if [ "$DRY" = 1 ]; then
            loud "WOULD RELINK $name  (source moved) -> $want"
          else
            rm -f -- "$link" && ln -s "$want" "$link" \
              && loud "RELINKED  $name -> $want" \
              || { loud "FAILED    $name  could not repoint stale link"; conflict=$((conflict + 1)); continue; }
          fi
          relinked=$((relinked + 1)); continue ;;
      esac
    fi
    loud "CONFLICT  $name  links to '$have', expected '$want' - skipped"
    conflict=$((conflict + 1)); continue
  fi

  if [ -e "$link" ]; then
    if adoptable "$link"; then
      if [ "$DRY" = 1 ]; then
        loud "WOULD ADOPT $name  (stow link farm -> whole-directory symlink)"
        adopted=$((adopted + 1)); continue
      elif [ "$ADOPT" = 1 ]; then
        rm -rf -- "$link" || { loud "FAILED    $name  could not remove link farm"; conflict=$((conflict + 1)); continue; }
        adopted=$((adopted + 1))
      else
        loud "CONFLICT  $name  is a stow link farm - rerun with --adopt to replace it"
        conflict=$((conflict + 1)); continue
      fi
    else
      loud "CONFLICT  $name  exists as a real path in $SKILLS - skipped"
      conflict=$((conflict + 1)); continue
    fi
  fi

  if [ "$DRY" = 1 ]; then
    loud "WOULD LINK  $name -> $want"
  else
    if ln -s "$want" "$link"; then
      loud "LINKED    $name -> $want"
    else
      loud "FAILED    $name -> $want"
      conflict=$((conflict + 1)); continue
    fi
  fi
  linked=$((linked + 1))
done

say "skill-deploy: $linked linked, $already already correct, $relinked relinked, $adopted adopted, $conflict conflict(s)"
[ "$conflict" -gt 0 ] && exit 1
exit 0
