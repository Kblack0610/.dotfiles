#!/usr/bin/env bash
# gh - the fleet's gh: read-only calls go out on the GitHub App's installation token (gh-app),
# everything else on the human's token, and every call is logged for attribution.
# Why: every agent account is the same GitHub user, so all of them spend one 5000/h REST budget;
# it ran out at 22:36 and 04:36 PST 2026-11-10 and every push, merge and probe failed with it.
#
# Routed: run list|view|download, pr list|view with --json, pr checks|diff, issue list|view with
# --json, workflow list|view, release list|view|download, and `gh api` GETs under repos/<owner>/,
# when the repo's owner is known (-R, GH_REPO, the api path, or a lone github.com origin). Not
# routed: writes, @me, --watch, graphql, a caller that set GH_TOKEN, or no App configured.
# A read the App's token is refused for reruns on the user's.
# Log: GH_CALLS_DIR/<day>.tsv, epoch, bucket (user | app:<owner> | user:app-error |
# user:app-denied | env), rc, caller script, $AGENT_QUEUE_ITEM, the command with values
# redacted. fleet-assess gh_callers reads it. Kept 7 days, readable by you only.
# Budget: every account spends the user's one REST budget, so the wrapper keeps one shared reading of
# it (GH_CALLS_DIR/budget, from the free rate_limit call, at most GH_BUDGET_STALE_S old) and, below
# GH_BUDGET_RESERVE calls left, refuses a read from a background caller in GH_DEFER_CALLERS (exit 75,
# bucket user:deferred) so gates, agent-land and the night keep what is left. Writes never wait.
# Docs: docs/operations/github-app.md.
set -u

: "${GH_BUDGET_RESERVE:=1000}"  # calls left under which a background read waits for the reset
: "${GH_BUDGET_STALE_S:=30}"    # age of the shared reading before one rate_limit call renews it
# Callers (the script that ran gh) that poll for a display or a report, not for a decision: on
# 2026-11-13 05:35Z-06:35Z they spent 1,264 of 4,651 calls. A gate, agent-land, gh-run-wait or
# night.sh is never in this list.
: "${GH_DEFER_CALLERS:=schedules-sync ci-failures.py fleet-sessions fleet-assess}"

[ -z "${GH_WRAPPED:-}" ] || exec "${GH_REAL:?}" "$@" # a gh that gh itself started: already counted
# A sandboxed HOME (a test's temp home) never reaches GitHub. A test that forgot to put its gh stub
# first on PATH acts on the real repos with the real token otherwise: tests/playground-night.sh
# started hd.yml and soak.yml on unity-core-playground main on 2026-11-12.
acct_home=$(getent passwd "$(id -un)" | cut -d: -f6)
[ -z "$acct_home" ] || [ "$(readlink -f "${HOME:-/}")" = "$(readlink -f "$acct_home")" ] \
  || { echo "gh: HOME is ${HOME:-unset}, not $acct_home: a sandboxed caller never reaches GitHub" >&2; exit 3; }
self=$(readlink -f "${BASH_SOURCE[0]}")
real="${GH_REAL:-}"
if [ -z "$real" ]; then
  IFS=: read -r -a dirs <<<"$PATH"
  for d in "${dirs[@]}"; do
    [ -f "$d/gh" ] && [ -x "$d/gh" ] && [ "$(readlink -f "$d/gh")" != "$self" ] && { real="$d/gh"; break; }
  done
fi
[ -n "$real" ] || { echo "gh: no gh on PATH besides this wrapper ($self)" >&2; exit 127; }

# owner_of <[host/]owner/repo or URL> -> the owner, when the host is github.com.
owner_of() {
  local r="${1#https://}"
  r="${r#http://}"
  r="${r#github.com/}"
  case "$r" in */*/*) return 1 ;; */*) printf '%s' "${r%%/*}" ;; *) return 1 ;; esac
}

# origin_owner -> the owner of this directory's origin, when it is the only GitHub remote and
# no `gh repo set-default` names another: gh would pick a different repo otherwise.
origin_owner() {
  local cfg url
  cfg=$(git config --get-regexp '^remote\..*\.(url|gh-resolved)$' 2>/dev/null) || return 1
  [ "$(grep -c 'github\.com' <<<"$cfg")" -eq 1 ] && ! grep -q 'gh-resolved' <<<"$cfg" || return 1
  url=$(awk '$1 == "remote.origin.url" { print $2 }' <<<"$cfg")
  [[ "$url" =~ github\.com[:/]([^/]+)/ ]] || return 1
  printf '%s' "${BASH_REMATCH[1]}"
}

# route_owner <gh args> -> the owner whose installation token this read-only call can use.
route_owner() {
  local grp="${1:-}" sub="${2:-}" a repo="${GH_REPO:-}" path="" method="" fields=0 json=0
  [ "${GH_HOST:-github.com}" = github.com ] || return 1
  # --watch: a watch can outlive the token's hour and die with a 401 partway through.
  for a in "$@"; do case "$a" in *@me* | --watch) return 1 ;; --json | --json=*) json=1 ;; esac; done
  case "$grp $sub" in
    'run list' | 'run view' | 'run download' | 'pr checks' | 'pr diff' | 'workflow list' | 'workflow view' | \
      'release list' | 'release view' | 'release download') ;;
    'pr list' | 'pr view' | 'issue list' | 'issue view') [ "$json" = 1 ] || return 1 ;; # the text view reads project fields an App may not see
    'api '*) ;;
    *) return 1 ;;
  esac
  shift
  [ "$grp" = api ] || shift
  while [ $# -gt 0 ]; do
    a="$1"
    shift
    case "$a" in
      -R | --repo) repo="${1:-}"; shift ;;
      --repo=*) repo="${a#--repo=}" ;;
      -R?*) repo="${a#-R}" ;;
      -X | --method) method="${1:-}"; shift ;;
      --method=*) method="${a#--method=}" ;;
      -X?*) method="${a#-X}" ;;
      -f | -F | --field | --raw-field | --input) fields=1; shift ;;
      -f?* | -F?* | --field=* | --raw-field=* | --input=*) fields=1 ;;
      --hostname) [ "${1:-}" = github.com ] || return 1; shift ;;
      --hostname=*) [ "${a#--hostname=}" = github.com ] || return 1 ;;
      -H | --header | -q | --jq | -t | --template | -p | --preview | --cache) shift ;;
      -*) ;;
      https://github.com/*/*) a="${a#https://github.com/}"; repo="${a%%/*}/x" ;; # a PR or run URL names its repo
      *) [ -n "$path" ] || path="$a" ;;
    esac
  done
  if [ "$grp" = api ]; then
    method=$(tr '[:lower:]' '[:upper:]' <<<"${method:-$([ "$fields" = 1 ] && echo POST || echo GET)}")
    [ "$method" = GET ] || return 1
    path="${path#/}"
    case "$path" in
      'repos/{owner}/'* | 'repos/:owner/'*) ;; # gh fills these from GH_REPO, else the directory
      repos/*/*) repo="${path#repos/}"; repo="${repo%%/*}/x" ;;
      *) return 1 ;;
    esac
  fi
  if [ -n "$repo" ]; then owner_of "$repo"; else origin_owner; fi
}

# caller -> the parent's program, or for an interpreter the script it runs. A `zsh -c '<cmd>'`
# (an agent's own Bash call) stays zsh: its payload is a command line, not a script.
caller() {
  local a name=""
  if [ -r "/proc/$PPID/cmdline" ]; then
    while IFS= read -r -d '' a; do
      if [ -z "$name" ]; then
        name="${a##*/}"
        [[ "$name" =~ ^(ba|z|da|k)?sh$|^python[0-9.]*$|^perl$|^node$|^env$ ]] || break
      else
        case "$a" in -*) ;; *' '*) break ;; *) name="${a##*/}"; break ;; esac
      fi
    done < "/proc/$PPID/cmdline"
  else
    name=$(ps -o comm= -p "$PPID" 2>/dev/null)
    name="${name##*/}"
  fi
  printf '%s' "${name:--}"
}

# redact <gh args> -> the command line with bodies, fields and headers blanked, and only the
# subcommand of secret, variable and auth: the log must not keep a secret for a week.
redact() {
  local a out="" skip=0
  case "${1:-}" in secret | variable | auth) printf '%s %s' "${1:-}" "${2:-}"; return ;; esac
  for a in "$@"; do
    if [ "$skip" = 1 ]; then a="_"; skip=0; else
      case "$a" in
        -b | --body | -f | -F | --field | --raw-field | -H | --header) skip=1 ;;
        --body=* | --field=* | --raw-field=* | --header=*) a="${a%%=*}=_" ;;
        -b?* | -f?* | -F?* | -H?*) a="${a:0:2}_" ;;
      esac
    fi
    out="$out${out:+ }$a"
  done
  printf '%s' "$out"
}

log_call() {
  local dir="${GH_CALLS_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/gh-calls}" f what
  umask 077
  f="$dir/$(date +%F).tsv"
  if [ ! -f "$f" ]; then
    mkdir -p "$dir" && find "$dir" -name '*.tsv' -mtime +7 -delete
  fi
  what=$(redact "$@")
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "${EPOCHSECONDS:-$(date +%s)}" "$bucket" "$rc" "$(caller)" \
    "${AGENT_QUEUE_ITEM:--}" "${what:0:160}" >> "$f"
}

# is_read <gh args>: the call only reads (the routable reads, `repo view`, and a GET `gh api`).
is_read() {
  local grp="${1:-}" sub="${2:-}" a method="" prev=""
  case "$grp $sub" in
    'run list' | 'run view' | 'run download' | 'pr list' | 'pr view' | 'pr checks' | 'pr diff' | 'issue list' | \
      'issue view' | 'workflow list' | 'workflow view' | 'release list' | 'release view' | 'release download' | \
      'repo view') return 0 ;;
    'api '*) ;;
    *) return 1 ;;
  esac
  shift
  for a in "$@"; do
    case "$prev" in -X | --method) method="$a" ;; esac
    case "$a" in
      graphql | -f | -F | --field | --raw-field | --input | -f?* | -F?* | --field=* | --raw-field=* | --input=*) return 1 ;;
      --method=*) method="${a#--method=}" ;;
      -X?*) method="${a#-X}" ;;
    esac
    prev="$a"
  done
  [ -z "$method" ] || [ "$(tr '[:lower:]' '[:upper:]' <<<"$method")" = GET ]
}

# budget_left -> "<remaining> <reset epoch>" of the user's core REST bucket, one reading shared by
# every process: a reading older than GH_BUDGET_STALE_S is renewed by whoever gets the lock first
# (rate_limit costs nothing), the rest use the old one. A failed renewal stores "- -" so a dead
# network is retried once per stale window, not once per call.
budget_left() {
  local dir="${GH_CALLS_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/gh-calls}" f rem="-" reset="-" at=0 now line
  f="$dir/budget"
  now="${EPOCHSECONDS:-$(date +%s)}"
  [ ! -f "$f" ] || read -r rem reset at <"$f" 2>/dev/null || true
  if [ $((now - ${at:-0})) -ge "$GH_BUDGET_STALE_S" ]; then
    umask 077
    mkdir -p "$dir" 2>/dev/null || true
    {
      if flock -n 9; then
        line=$(GH_WRAPPED=1 timeout 5 "$real" api rate_limit --jq '.resources.core | "\(.remaining) \(.reset)"' 2>/dev/null) || line="- -"
        printf '%s %s\n' "${line:-- -}" "$now" >"$f.$$" && mv "$f.$$" "$f"
      fi
    } 9>"$f.lock" 2>/dev/null || true
    read -r rem reset at <"$f" 2>/dev/null || true
  fi
  printf '%s %s' "$rem" "$reset"
}

# defer_read <gh args>: succeed (and say why on stderr) when this is a background caller's read and
# the shared budget is under the reserve with its reset still ahead.
defer_read() {
  local who a rem reset now="${EPOCHSECONDS:-$(date +%s)}"
  who=$(caller)
  case " $GH_DEFER_CALLERS " in *" $who "*) ;; *) return 1 ;; esac
  is_read "$@" || return 1
  for a in "$@"; do [ "$a" != rate_limit ] || return 1; done # the free probe that shows the reset
  read -r rem reset <<<"$(budget_left)"
  [[ "$rem" =~ ^[0-9]+$ && "$reset" =~ ^[0-9]+$ ]] || return 1
  [ "$rem" -lt "$GH_BUDGET_RESERVE" ] && [ "$reset" -gt "$now" ] || return 1
  echo "gh: $rem REST calls left, under the $GH_BUDGET_RESERVE kept for gates and merges; $who waits for the reset at $(date -d "@$reset" +%H:%M)" >&2
}

bucket=user
tok=""
if [ -n "${GH_TOKEN:-}${GITHUB_TOKEN:-}" ]; then
  bucket="env"
elif owner=$(route_owner "$@"); then
  tok=$(gh-app token "$owner" 2>/dev/null)
  case $? in
    0) bucket="app:$owner" ;;
    2) tok="" ;;
    *) tok="" bucket=user:app-error ;;
  esac
fi

if [ -z "$tok" ] && [ "$bucket" != env ] && defer_read "$@"; then
  rc=75 bucket=user:deferred
  { log_call "$@"; } 2>/dev/null || true
  exit 75
fi

export GH_WRAPPED=1 GH_REAL="$real"
if [ -n "$tok" ]; then
  # A refused App token (uninstalled, revoked, a missing permission, its own limit spent) must
  # not fail the read: rerun it on the user. stderr is held so only the answer that counts shows.
  err=$(mktemp "${TMPDIR:-/tmp}/gh-err.XXXXXX")
  GH_TOKEN="$tok" "$real" "$@" 2>"$err"
  rc=$?
  if [ "$rc" -ne 0 ] && grep -qE 'HTTP 40[13]|Bad credentials|not accessible by integration' "$err"; then
    bucket="user:app-denied"
    "$real" "$@"
    rc=$?
  else
    cat "$err" >&2
  fi
  rm -f "$err"
else
  "$real" "$@"
  rc=$?
fi
{ log_call "$@"; } 2>/dev/null || true
exit "$rc"
