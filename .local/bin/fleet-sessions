#!/usr/bin/env bash
# fleet-sessions - where is each live Claude session in its delivery, and does it need anyone?
#
#   fleet-sessions                    one row per session, grouped by bucket
#   fleet-sessions --json             the same, one JSON object per line (for the shepherd)
#   fleet-sessions --write            --json, and the fleet state document every view renders
#                                     ($FLEET_STATE_FILE; schema and vocabulary in
#                                     .local/src/docs/fleet-states.md), each session with its
#                                     eta from `fleet-bench eta`, and fleet_sessions.prom
#   fleet-sessions mark <sid> <fact>  record that <fact> was nudged, so it is nudged once
#   fleet-sessions escalate <sid> <fact>  record that <fact> went to the human, so it pages once
#                                     (both refuse, exit 3, outside the pass holding the
#                                     shepherd lease: fleet-shepherd holds)
#   fleet-sessions label <who> [+name|-name|^name ...]  set, clear, flip or (no ops) print a
#                                     session's labels; each change also lands on its tmux window
#   fleet-sessions tick               --write after a fetch, plus the stage changes since the
#                                     last tick appended to watch.log (fleet-state.service, every
#                                     minute and on each ask change); the hub Sessions tab
#   fleet-sessions explain <who>      one session from the state document: its task, plan, PRs,
#                                     where its time went, and what it is doing
#   fleet-sessions close [--json]     the close analysis from the state document: each session's
#                                     verdict (now, after <step>, keep), progress, eta and why,
#                                     close-now first (CLOSE_JQ; the shepherd skill's triage verb)
#   fleet-sessions close --self [<sid>]  this session's verdict from a fresh pass, as at the end of
#                                     its turn, then its blockers; exit 0 on now (/wind-down auto)
#   fleet-sessions stages [--from EPOCH] [--to EPOCH] [--json]  watch.log replayed over a window
#                                     (default the last 24h): minutes and episodes per stage and
#                                     reason, CI runs and reruns, PR open to merged, conflicts,
#                                     phase ticks, per project (.local/lib/fleet-stages.py)
#
# Buckets: PARKED, NEEDS, STALLED, WORKING, LANDED, DONE and CHAT, one per session, plus one NIGHTLY
# row per repo whose default branch is red, one SHARED row per test red on several branches at once
# and one CHECKOUT row per deployed checkout off its default branch. Each is defined once, with its entry facts, exit,
# actor, action and pinning test, in the bucket table of .local/src/docs/fleet-states.md, and
# tests/unit/fleet_states_doc.bats fails when the words emitted here differ from that table.
# The --json `finished` field is DONE without the idle and status checks, so a session can check
# its own row mid-turn, and `blockers` lists every reason it is false.
# Facts come from agent-panel, git, gh and the ask queue; no model. The shepherd skill's
# `status` and `nudge` verbs read this. Thresholds are the FLEET_* block below.

set -uo pipefail

# --write also publishes the rows to Prometheus (fleet_sessions.prom).
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/prom-textfile.sh"
# The board counts a session's PRs the way the nightly outcomes do (so_transcript_metrics).
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/session-outcomes.sh"
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/plan-phases.sh"
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/main-state.sh"
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/origin-repo.sh"
# A PR's check rollup as NONE, PENDING, FAIL or PASS (ci), and its red job ids (red): CI_JQ.
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/pr-ci.sh"
# FLEET_MAIN_TTL: seconds a gh answer (sibling_pr's PR view) is reused across passes: every caller
# (the ask watcher, fleet-bench, the shepherd, the board) runs a pass, and on 2026-10-29 the fleet
# spent GitHub's 5,000/hr REST limit; a PR's state is no less true five minutes later.
: "${FLEET_MAIN_TTL:=300}"
# FLEET_BASE_TTL: seconds a repo's default branch is reused across passes. It was one `gh repo view` per
# repo per pass (287 of the 4,651 calls in the hour the budget ran out, 2026-11-13 05:35Z) for a name
# that changes about never; origin/HEAD is the offline fallback either way.
: "${FLEET_BASE_TTL:=3600}"
# Each fleet worker's sessions are rows too (remote_panel_lines).
# shellcheck source=../lib/fleet-hosts.sh
. "${FLEET_HOSTS_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/fleet-hosts.sh}"

# --- thresholds (env overrides) --------------------------------------------------------
: "${FLEET_IDLE_MIN:=20}"   # idle fewer minutes than this -> still WORKING (just ended a turn)
# The close verdict (close_verdict): a CHAT session closes once quiet this long (the human set 24h,
# 2026-11-05). It is the only rule that reads quiet; DONE's own FLEET_IDLE_MIN is the idle gate.
: "${FLEET_CHAT_CLOSE_H:=24}"
: "${FLEET_SHELL_STALE_MIN:=120}" # a background shell this long past the last entry is not work:
                                  # a real gate wait is under an hour, a forgotten ugrep is not
: "${HUNG_REASON:=background shell is waiting on itself (tail --pid of its own parent)}"
: "${FLEET_DIRTY_NAMES:=3}" # a dirty-file reason names this many paths, then "+N more"
: "${FLEET_ITEM_DAYS:=7}" # days of done queue items read to see that a session's item moved on
: "${FLEET_SUSPECTS_MAX:=3}" # a red workflow names its PRs as suspects only up to this many; past
                             # it (a nightly suite after a busy day) nobody can be told it was theirs
# One test failing on this many branches within this many minutes is a SHARED row: a shared cause
# (the base, a runner, a flaky test), not any one branch's work. 3 in 2h hit about 4 tests a day in
# the week to 2026-11-06.
: "${FLEET_SHARED_RED_BRANCHES:=3}"
: "${FLEET_SHARED_RED_MIN:=120}"
# Run names (ERE) of the dispatched workflows that gate a PR (gate_ci). Tests is unity-core-playground's
# pool gate, `Tests (affected)` from ci-gate.sh; a dispatched Multi, Shots or tour is not a merge gate,
# and counting one held ready PRs at CI red.
: "${FLEET_GATE_WORKFLOWS:=^Tests( |$)}"
# Job step names (ERE) that stay red until that gate finishes: unity-core-playground's Checks ends
# with its Merge gate line step (gate-line.py), red while the Tests run is still going, and stays a
# red check because it is the merge block. A PR whose red jobs failed only in such steps reads CI
# running while a gate on its head runs (gate_ci, ar-82).
: "${FLEET_GATE_LINE_STEPS=^Merge gate line$}" # empty: off
# Run names (Oniguruma) of runs on a default branch that test only part of a workflow's suite, so they say
# nothing about main's health (main_state): unity-core-playground titles its scope in run-name, and
# a hand `Multi (named)` passing a few classes does not clear the nightly `Multi (all)` red before it.
: "${FLEET_PARTIAL_RUNS:=\((named|affected)\)$}"
# The gates' per-test failures, one line each: epoch, worktree, branch (- when detached), test. The
# local gate writes the first; pool-test-failures sync writes the runner pool's from its artifacts.
TEST_FAILURES="${UNITY_TEST_FAILURES:-${XDG_STATE_HOME:-$HOME/.local/state}/unity-test-runs/test-failures.tsv}"
POOL_FAILURES="${UNITY_POOL_FAILURES:-${XDG_STATE_HOME:-$HOME/.local/state}/unity-test-runs/pool-failures.tsv}"
LEDGER="${FLEET_SHEPHERD_DIR:-$HOME/.agent/shepherd}"
STATE_FILE="${FLEET_STATE_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/fleet/state.json}"
ASK_ROOT="${AGENT_ASK_DIR:-$HOME/.agent/asks}"
# The kind registry fleet-dispatch routes by: a kind whose `exit` is doc+ask finishes on a doc and an
# ask, not a PR (handoff_of).
KINDS="${DISPATCH_KINDS:-$HOME/.config/fleet-dispatch/kinds.json}"
# A session working a queue item is named by that item's `session:` (<server>:<tmux session>, a
# bare name on this server); its "<project>: <slug>" is shown so the shepherd knows what it works.
# claude-acct park writes one ledger per tmux session whose claude it exited to save usage.
# Such a session has no claude, so agent-panel cannot list it; the pass lists it from here.
PARKED_DIR="${CLAUDE_ACCT_PARKED_DIR:-$HOME/.agent/parked}"
# Labels say what git, gh and the transcript cannot: a human's `manual` (the shepherd
# leaves that session alone), a session's own `quality:<step>` while a cleanup pass runs, or
# `shepherd` on the fleet-shepherd pass itself, which is listed but left out of every count.
# One file per session id, one label per line. Stages are derived every pass, never stored.
LABELS="$LEDGER/labels"
# The bucket vocabulary, written once: state.json `vocab` and the agent_session_bucket gauge carry it
# to every reader (agent-web, hub, waybar, agent-panel, the phone), so none keeps its own list.
# BUCKET_ORDER is what needs the human first; BUCKET_FINISHED is a session whose work is done, so it
# is ready to wind down; BUCKET_IN_PROGRESS is a session an agent or the human still has to move.
BUCKET_ORDER="NEEDS STALLED DONE LANDED CHAT WORKING PARKED"
BUCKET_FINISHED="DONE LANDED"
BUCKET_IN_PROGRESS="WORKING NEEDS STALLED"

# session_bucket <status> <plan: 1 when status is waiting on an ExitPlanMode approval, else 0> <asks> <heavy 0|1> <idle_min> <git 0|1> \
#                <dirty> <ahead> <pr#|-> <pr_state|-> <ci PASS|FAIL|PENDING|NONE|-> <head_in_pr 0|1> \
#                <main_red: workflows this session's merged PR is a suspect for, or -> \
#                <phases: - (no plan file) | none (no checklist) | done/total> <next phase|-> \
#                <conflicts: yes|no|- (merging the default branch in would conflict)> \
#                <open job: gate|test|agent|human|jobs|none|hung|- (agent-panel's open_job, or a live gate/test process in the worktree or under its claude: live_wait; hung: self_wait, a shell waiting on itself; - unknown)> \
#                <dirty names: the first dirty paths, shown beside the count, or -> \
#                <landed: this session's own PRs ("#N,#M") when its transcript names a merged one,
#                 none open and every state known (a closed one was replaced or dropped), or -;
#                 a session in the main checkout lands from worktrees, so its branch never has
#                 a PR of its own>
#                <item: the queue item this session worked, by its sessions: or session:, as
#                 own:<slug>[,<slug>...] while one runs here, moved:<slug> (<where>) once it is done,
#                 requeued or running in another session, here:<slug> waiting here,
#                 review:<slug> pr <n|-> parked here in review (<n>, the item's PR, is handed off), or ->
#   -> "BUCKET reason"
# <git> is 1 in a repo, 0 outside one, gone when the cwd itself no longer exists (a reaped worktree).
# Who must act decides before whether the session is active: an ask waits on the human, and
# a PR that is otherwise ready but cannot merge wastes the wait, however busy the session is.
# Ready is green checks, or no checks and the session idle. A conflict on a red or running PR
# only rides along in the reason of its other bucket: resolving it before the PR is ready
# invites the next conflict and a fresh gate. On 2026-11-02 main's submodule pin moved
# several times and ~30 open PRs drew 55 conflict nudges in 6h, most of them not ready.
session_bucket() {
  local st="$1" note="" cn=""
  # Parked on purpose: its claude is gone, so a message would wake nothing, and nothing in it
  # moves until it is unparked.
  [ "$st" = parked ] && { echo "PARKED claude exited to save usage; claude-acct unpark resumes it"; return; }
  if [ "$st" = waiting ]; then
    [ "$2" = 1 ] && echo "NEEDS plan awaiting approval" || echo "NEEDS waiting on a prompt or permission"
    return
  fi
  # A session with an open question carries on with what does not depend on the answer. The
  # bucket stays NEEDS (the human still owes the answer), but one whose activity alone would read
  # WORKING busy or shell says so, and keeps WORKING's overdue check. Asking the rules below with no
  # ask keeps one definition of working.
  if [ "$3" -gt 0 ]; then
    case "$(session_bucket "$1" "$2" 0 "${@:4}")" in
      "WORKING busy"* | "WORKING shell"* | "WORKING subagent"*) echo "NEEDS $3 pending ask(s), carrying on" ;;
      *) echo "NEEDS $3 pending ask(s)" ;;
    esac
    return
  fi
  if [ "${10}" = OPEN ] && [ "${16:--}" = yes ]; then
    case "${11}" in
      PASS) echo "STALLED PR #$9 conflicts with the default branch"; return ;;
      FAIL|PENDING) ;;
      *) [ "$st" = idle ] && [ "$5" -ge "$FLEET_IDLE_MIN" ] \
           && { echo "STALLED PR #$9 conflicts with the default branch"; return; } ;;
    esac
    cn=", conflicts with the default branch"
  fi
  # A background subagent's work lands in its own worktree, so this tree's facts (clean, merged,
  # all phases ticked) say nothing about it until it ends: 2026-11-03 agent-10 read DONE and
  # agent-56 LANDED mid-phase. A gate or test left running past a finished plan is not its work.
  local job="${17:--}"
  case "$st" in
    busy) echo "WORKING busy$cn"; return ;;
    idle)
      # Claude writes shell only for a background Bash; a background subagent leaves it idle.
      if [ "$job" = agent ] && [ "$5" -ge "$FLEET_IDLE_MIN" ]; then
        [ "$5" -lt "$FLEET_SHELL_STALE_MIN" ] && { echo "WORKING subagent running$cn"; return; }
        note=", subagent running over ${FLEET_SHELL_STALE_MIN}m"
      fi ;;
    shell)
      # A finished plan is not waiting on its shell: DONE tells it to stop the shell first.
      if [ "$5" -ge "$FLEET_IDLE_MIN" ] && [ "$job" != agent ] && session_finished "$@"; then
        note=", background shell still running"
      elif [ "$5" -ge "$FLEET_IDLE_MIN" ] && [ "$job" = hung ]; then
        # 2026-11-09 agent-51 read WORKING for 100m on a shell waiting for its own parent to exit.
        note=", $HUNG_REASON"
      elif [ "$5" -ge "$FLEET_IDLE_MIN" ] && { [ "$job" = jobs ] || [ "$job" = none ]; }; then
        # Only a gate, a test or a subagent is work worth waiting 120m on. Anything else is a sleep
        # loop, a watch on a file or a job the transcript no longer shows; on 2026-11-03 13 of 24
        # "WORKING shell" sessions were one of those, idle up to 107m, and nothing looked at them.
        note=", background shell is not a gate or test"
      elif [ "$5" -lt "$FLEET_SHELL_STALE_MIN" ]; then
        echo "WORKING shell$cn"; return
      else
        # The threshold, not the minutes: a reason that changed every pass would re-nudge every pass.
        note=", background shell idle over ${FLEET_SHELL_STALE_MIN}m"
      fi ;;
  esac
  echo "$(bucket_facts "$@")$cn$note"
}

# live_wait <cwd> [<claude pid>]: gate or test when a process running in <cwd> (or below it), or
# descended from the session's claude whatever its cwd, matches a `gate` or `test` line of
# agent-panel's time-use.conf, else nothing. A background subagent's commands run in its own
# worktree and a gate script may cd elsewhere (2026-11-03 agent-49 read STALLED mid-gate on #1669),
# but both stay children of the claude that started them. The transcript shows a gate detached
# with & only as the until-loop watching its output file (2026-11-07 unity-core-playground-agent-30:
# Tests run in progress, row STALLED), so agent-panel reads it as `jobs`; the process itself is the
# fact. No event API names a gate's process, so this reads /proc, one `ls -l` of every cwd link and one `ps` per
# session whose open job reads jobs or none. Not counted: a `-c` command line (a shell holding its
# script's text, not the gate), the session's own `claude` (its argv carries the dispatch prompt,
# which names agent-land), and this pass's own ancestors. With no claude pid (an agent-panel row
# without .pid) only the worktree is read.
live_wait() {
  local cwd="$1" root="${2:-0}" conf="${FLEET_TIME_USE_CONF:-$HOME/.config/agent-panel/time-use.conf}" want kind text line pid cmd
  [ -r "$conf" ] && cwd="$(realpath "$cwd" 2>/dev/null)" || return 0
  local -A skip=() mine=()
  pid=$$; while [ "${pid:-0}" -gt 1 ]; do skip[$pid]=1; pid="$(awk '/^PPid:/ {print $2}' "/proc/$pid/status" 2>/dev/null)"; done
  if [[ "$root" =~ ^[0-9]+$ ]] && [ "$root" -gt 1 ]; then
    while read -r pid; do mine[$pid]=1; done < <(ps -e -o pid=,ppid= | awk -v r="$root" '
      { up[$1] = $2 }
      END { for (p in up) { x = up[p]; n = 0; while (x > 1 && x != r && (x in up) && n++ < 64) x = up[x]; if (x == r) print p } }')
  fi
  local -a cmds=()
  while read -r line; do
    [[ "$line" =~ \ /proc/([0-9]+)/cwd\ -\>\ (.*)$ ]] || continue
    pid="${BASH_REMATCH[1]}"
    [ -n "${mine[$pid]:-}" ] || [ "${BASH_REMATCH[2]}" = "$cwd" ] || [[ "${BASH_REMATCH[2]}" == "$cwd"/* ]] || continue
    [ -z "${skip[$pid]:-}" ] || continue
    cmd="$(tr '\0' ' ' 2>/dev/null < "/proc/$pid/cmdline")"
    case "$cmd" in "" | *" -c "* | claude" "* | */claude" "*) continue ;; esac
    cmds+=("$cmd")
  done < <(ls -l /proc/[0-9]*/cwd 2>/dev/null)
  [ "${#cmds[@]}" -gt 0 ] || return 0
  for want in gate test; do
    while read -r kind text; do
      [ "$kind" = "$want" ] && [ -n "$text" ] || continue
      for cmd in "${cmds[@]}"; do
        case "$cmd" in *"$text"*) echo "$want"; return 0 ;; esac
      done
    done < "$conf"
  done
}

# self_wait <claude pid>: `hung` when a process under that claude is a `tail --pid=N` whose N is its
# own parent (or on itself, when bash exec-ed tail in its place), else nothing. The parent waits for
# tail to end and tail waits for the parent to end, so nothing ever moves. Not checked: that the
# parent is blocked on the tail, so a `tail --pid=$$ -f log &` beside real work also reads hung once
# its row is idle past FLEET_IDLE_MIN with no live gate or test; the session is the one to say so. 2026-11-09 agent-51's `pgrep -f 'agent-land 2089'` matched its own shell and
# sat in that wait for 100m while the row read WORKING. A tail that watches any other pid is a real
# wait. No event names a deadlock, so this reads one `ps`, only for a shell row past FLEET_IDLE_MIN.
self_wait() {
  local root="${1:-0}"
  [[ "$root" =~ ^[0-9]+$ ]] && [ "$root" -gt 1 ] || return 0
  ps -e -o pid=,ppid=,args= | awk -v r="$root" '
    { p = $1; up[p] = $2; $1 = $2 = ""; args[p] = $0 }
    END {
      for (p in up) {
        x = up[p]; n = 0
        while (x > 1 && x != r && (x in up) && n++ < 64) x = up[x]
        if (x != r) continue
        k = split(args[p], a, " ")
        if (a[1] !~ /(^|\/)tail$/) continue
        for (i = 2; i <= k; i++) {
          w = ""
          if (a[i] ~ /^--pid=[0-9]+$/) w = substr(a[i], 7)
          else if (a[i] == "--pid" && i < k) w = a[i + 1]
          if (w != "" && w != r && (w == up[p] || w == p)) { print "hung"; exit }
        }
      }
    }'
}

# bucket_facts: session_bucket past the session status, from the same arguments.
bucket_facts() {
  local plan="$2" asks="$3" heavy="$4" idle="$5" git="$6" dirty="$7" ahead="$8" \
        pr="$9" state="${10}" ci="${11}" inpr="${12}" red="${13:--}" phases="${14:--}" next="${15:--}" nm="" \
        landed="${19:--}" item="${20:--}"
  [ "${18:--}" = - ] || nm=" (${18})"
  [ "$heavy" = 1 ] && { echo "WORKING heavy child process"; return; }
  [ "$asks" -gt 0 ] && { echo "NEEDS $asks pending ask(s)"; return; }
  [ "$idle" -lt "$FLEET_IDLE_MIN" ] && { echo "WORKING idle ${idle}m"; return; }
  # wt done reaps a worktree once its work landed; nothing is left here to land or lose.
  [ "$git" = gone ] && { echo "DONE its worktree was removed"; return; }
  [ "$git" = 1 ] || { echo "CHAT not in a git repo"; return; }
  case "$state" in
    MERGED)
      # A merge that may have turned a nightly red is not landed, whatever the tree says.
      if [ "$red" != - ]; then echo "STALLED nightly red after PR #$pr: $red"
      elif [ "$dirty" -gt 0 ]; then echo "STALLED PR #$pr merged, $dirty dirty file(s) left$nm"
      elif [ "$inpr" != 1 ]; then echo "STALLED commits after merged PR #$pr"
      else plan_bucket "PR #$pr merged, tree clean" "$phases" "$next" 1 "$item"; fi ;;
    OPEN)
      if handed_off "$item" "$pr" "$dirty" "$inpr"; then
        local slug="${item#review:}"; slug="${slug%% *}"; local why="PR #$pr parked for review, its item $slug owns it"
        case "$phases" in
          -|none) echo "DONE $why" ;;
          *) if [ "${phases%/*}" -ge "${phases#*/}" ] || [[ "$next" == queued:* ]]; then echo "DONE $why"
             else echo "LANDED $why, next phase: $next"; fi ;;
        esac
        return
      fi
      case "$ci" in
        FAIL)    echo "STALLED PR #$pr CI red" ;;
        PENDING) echo "WORKING PR #$pr CI running" ;;
        *)       echo "STALLED PR #$pr green, not merged" ;;
      esac ;;
    CLOSED)
      # Closed beside a merged PR of its own was replaced; alone it is the session's to explain.
      if [ "$landed" != - ]; then plan_bucket "PR #$pr closed, its PRs $landed merged" "$phases" "$next" 1 "$item"
      else echo "STALLED PR #$pr closed without merging"; fi ;;
    *)
      if [ "$dirty" -gt 0 ]; then echo "STALLED $dirty dirty file(s)$nm, no PR"
      elif [ "$ahead" -gt 0 ]; then echo "STALLED $ahead file(s) not on the default branch, no PR"
      elif [ "$landed" != - ]; then plan_bucket "clean, nothing on the branch, its PRs $landed merged" "$phases" "$next" 1 "$item"
      else plan_bucket "clean, nothing on the branch" "$phases" "$next" 0 "$item"; fi ;;
  esac
}

# handed_off <item> <pr> <dirty> <in_pr> -> exit 0 when this session's open PR is its parked
# item's (item_of's "review:<slug> pr <n>", the item's own pr:) and nothing here is outside it: no
# dirty file, HEAD inside the PR. fleet-dispatch's reap owns that PR once the session ends
# (own_parked_pr gives a red one a fix-ci session and a green one a lander), so it is no longer the session's to finish.
handed_off() {
  [[ "$1" == review:*" pr "* ]] && [ "${1##* pr }" = "${2##*#}" ] && [ "$3" = 0 ] && [ "$4" = 1 ]
}

# session_finished: session_bucket's arguments -> exit 0 when the work half of DONE holds
# (phases all ticked, no ask, nothing unlanded, not a red-main suspect). It skips status,
# plan mode, a heavy child and the idle threshold, so a session can check its own row mid-turn, when that row always reads WORKING busy.
session_finished() {
  case "$(bucket_facts - 0 "$3" 0 "$FLEET_IDLE_MIN" "${@:6}")" in DONE*) return 0 ;; esac
  return 1
}

# work_blockers <open ask ids, comma-separated> <session_bucket's arguments...> -> every reason
# session_finished is false, "; "-separated, empty when it is true. The ids lead so a new
# session_bucket argument never moves them.
# bucket_facts names only the first reason; a session told it is unfinished needs all of them.
work_blockers() {
  local ids="$1"; shift
  local asks="$3" git="$6" dirty="$7" ahead="$8" pr="$9" state="${10}" ci="${11}" inpr="${12}" \
        red="${13:--}" phases="${14:--}" next="${15:--}" b=() id merged=0 out="" nm=""
  [ "${18:--}" = - ] || nm=" (${18})"
  { [ "$state" = - ] || [ "$state" = CLOSED ]; } && [ "${19:--}" != - ] && merged=1
  if [ -n "$ids" ]; then
    for id in ${ids//,/ }; do b+=("open ask $id"); done
  elif [ "$asks" -gt 0 ]; then b+=("$asks open ask(s)"); fi
  if [ "$git" = gone ]; then :
  elif [ "$git" != 1 ]; then b+=("not in a git repo")
  else
  case "$state" in
    MERGED)
      merged=1
      [ "$red" != - ] && b+=("nightly red after PR #$pr: $red")
      [ "$dirty" -gt 0 ] && b+=("$dirty dirty file(s)$nm")
      [ "$inpr" != 1 ] && b+=("commits after merged PR #$pr") ;;
    OPEN) if handed_off "${20:--}" "$pr" "$dirty" "$inpr"; then merged=1
          else b+=("PR #$pr open, CI ${ci:--}"); fi ;;
    CLOSED) [ "$merged" = 1 ] || b+=("PR #$pr closed without merging") ;;
    *)
      [ "$dirty" -gt 0 ] && b+=("$dirty dirty file(s)$nm, no PR")
      [ "$ahead" -gt 0 ] && b+=("$ahead file(s) not on the default branch, no PR") ;;
  esac
  case "$phases" in
    # An item that moved on took the work with it: nothing here is left to finish.
    -) [ "$merged" = 1 ] || [[ "${20:--}" == moved:* ]] || b+=("no plan file and nothing merged") ;;
    none) [ "$merged" = 1 ] || b+=("plan has no ## Phases checklist and nothing merged") ;;
    *) [ "${phases%/*}" -ge "${phases#*/}" ] || [[ "$next" == queued:* ]] || b+=("next phase: $next") ;;
  esac
  if [[ "${20:--}" == own:* ]]; then
    # Every phase ticked or held by another item leaves only the item to close (the requeued
    # case, ucp-agent-82 2026-11-11: apo-120 stayed open after its partial landing while its
    # phases ran as items elsewhere). Its close verdict is then after, not keep.
    local own="${20#own:}" held=0
    case "$phases" in -|none) ;; *) { [ "${phases%/*}" -ge "${phases#*/}" ] || [[ "$next" == queued:* ]]; } && held=1 ;; esac
    for id in ${own//,/ }; do
      if [ "$held" = 1 ]; then b+=("its item $id is still open with every phase done or queued")
      else b+=("its item $id is running here"); fi
    done
  fi
  fi
  for id in "${b[@]}"; do out="${out:+$out; }$id"; done
  # A finished session is told to stop its shell; any other one is held up by it.
  [ -n "$out" ] && [ "$1" = shell ] && [ "${17:--}" = hung ] && [ "$5" -ge "$FLEET_IDLE_MIN" ] \
    && out="$out; $HUNG_REASON"
  printf '%s' "$out"
}

# plan_bucket <reason so far> <phases> <next> <merged 0|1> [<item>]: nothing is unlanded, so the
# plan decides. All phases ticked is DONE, and so is one whose unchecked phases are queue items
# (next is queued:<slugs>); one left is LANDED naming it. A plan with no checklist,
# or no plan file, is one phase of work: DONE once its PR merged. Without a merged PR, no
# checklist is LANDED asking for one. No plan file goes by the queue item: one that moved on
# (done, requeued, or running in another session) is DONE, one still running here with nothing
# on the branch is STALLED, and with no item it is CHAT, the human's own conversation, which
# closing on idle would cut off (its close verdict waits FLEET_CHAT_CLOSE_H). 2026-11-05: agent-26
# sat 22.5h and agent-21 a day after their items were requeued, escalated once and never wound down.
# A queue item still running here is unfinished work whatever merged: a merged PR may be a side
# item's, so it is STALLED naming the item, never DONE. 2026-11-06: unity-core-playground-agent-6
# merged #1922 for steam-untested-reason, read DONE and was told to wind down while its own
# steam-beta-cut-1106 was running with three release.yml runs in flight.
plan_bucket() {
  local why="$1" phases="$2" next="$3" merged="${4:-0}" item="${5:--}" own=-
  # The first running item names the row, so a side item starting or ending is not a new fact.
  [[ "$item" == own:* ]] && { own="${item#own:}"; own="${own%%,*}"; }
  case "$phases" in
    -)    if [ "$merged" = 1 ]; then plan_done "$why" "$own" ", no plan file, its PR landed"
          else case "$item" in
            moved:*) echo "DONE $why, no plan file, its item ${item#moved:}" ;;
            own:*)   echo "STALLED $why, no plan file, its item $own is running here" ;;
            *)       echo "CHAT $why, no plan file, no queue item: the human's conversation" ;;
          esac; fi ;;
    none) if [ "$merged" = 1 ]; then plan_done "$why" "$own" ", single-phase plan, its PR landed"
          else echo "LANDED $why, plan has no ## Phases checklist"; fi ;;
    *)
      if [ "${phases%/*}" -ge "${phases#*/}" ]; then plan_done "$why" "$own" ", all ${phases#*/} phases done" held
      elif [[ "$next" == queued:* ]]; then plan_done "$why" "$own" ", its next phases are queue items: ${next#queued:}" held
      else echo "LANDED $why, next phase: $next"; fi ;;
  esac
}

# plan_done <why> <first running item here|-> <DONE's reason after why> [held] -> DONE, or STALLED
# naming the item when one still runs here; held (every checklist phase done or queued) says the
# item is all that is left open (work_blockers' wording, which the close verdict reads).
plan_done() {
  if [ "$2" = - ]; then echo "DONE $1$3"
  elif [ "${4:-}" = held ]; then echo "STALLED $1, its item $2 is still open with every phase done or queued"
  else echo "STALLED $1, its item $2 is running here"; fi
}

# fact_key <fact> -> what "the same fact" means. A DONE fact is one fact for as long as the session
# is DONE: its tail (the queued phases, "no plan file", the merged PR list) shrinks as its queue
# items start, and each change drew a fresh wind-down nudge to the same session (2026-11-07:
# dotfiles-agent-6 got three, from three passes). Whether the nudge moved it is the escalation's
# question, not a reason to send it again. A NEEDS fact is what the human owes, so it drops the
# branch and head: a session holding an ask that switched branch or pushed paged again (ar-233).
fact_key() { case "$1" in DONE\ *) echo DONE ;; NEEDS\ *) printf '%s\n' "${1%% @*}" ;; *) printf '%s\n' "$1" ;; esac; }

# nudged <sid> <fact> -> exit 0 when this fact was already nudged for this session.
nudged() { [ "$(fact_key "$(sed -n 's/^fact: //p' "$LEDGER/$1" 2>/dev/null)")" = "$(fact_key "$2")" ]; }

# escalated <sid> <fact> -> exit 0 when this fact is already on the human's list.
escalated() { [ "$(fact_key "$(sed -n 's/^escalated: //p' "$LEDGER/$1" 2>/dev/null)")" = "$(fact_key "$2")" ]; }

# ledger_write <sid> <key> <fact>: set one key, keep the other. A new nudge clears an escalation,
# except a NEEDS one: the ask is still waiting while the session works on, so an overdue nudge to it
# keeps the page sent once; release_left drops it when the session leaves NEEDS.
ledger_write() {
  local sid="$1" key="$2" fact="$3" tmp keep=""
  case "$sid" in ''|*/*|.|..) echo "fleet-sessions: bad session id" >&2; return 2 ;; esac
  mkdir -p "$LEDGER"
  case "$key" in
    escalated) keep="$(grep '^fact: ' "$LEDGER/$sid" 2>/dev/null)" || true ;;
    fact)      keep="$(grep '^escalated: NEEDS ' "$LEDGER/$sid" 2>/dev/null)" || true ;;
  esac
  tmp="$(mktemp "$LEDGER/.$sid.XXXXXX")" || return 1
  { [ -n "$keep" ] && echo "$keep"; printf '%s: %s\nat: %s\n' "$key" "$fact" "$(date -Iseconds)"; } > "$tmp" \
    && mv "$tmp" "$LEDGER/$sid"
}
# mark <sid> <fact>: the claim on a nudge, taken before the message goes out. Exit 1 when the fact
# is already nudged, whichever pass nudged it, and the ledger is left as it is (a second mark would
# clear the escalation the first one earned).
mark() {
  case "$1" in ''|*/*|.|..) echo "fleet-sessions: bad session id" >&2; return 2 ;; esac
  mkdir -p "$LEDGER"
  (
    flock 8
    nudged "$1" "$2" && { echo "fleet-sessions: $1 already nudged for this fact" >&2; exit 1; }
    ledger_write "$1" fact "$2"
  ) 8>"$LEDGER/mark.lock"
}

# release_left <rows>: a session that left DONE is no longer holding the DONE nudge, so its next
# DONE is a new fact and is nudged (fact_key makes every DONE one fact while it lasts). One that
# left NEEDS drops its NEEDS escalation the same way, so its next ask or dialog pages once.
release_left() {
  local b sid _
  while IFS=$'\t' read -r b _ sid _; do
    [ -n "$sid" ] && [ -f "$LEDGER/$sid" ] || continue
    if [ "$b" != DONE ] && [ "$(fact_key "$(sed -n 's/^fact: //p' "$LEDGER/$sid")")" = DONE ]; then rm -f "$LEDGER/$sid"
    elif [ "$b" != NEEDS ] && grep -q '^escalated: NEEDS ' "$LEDGER/$sid"; then sed -i '/^escalated: NEEDS /d' "$LEDGER/$sid"; fi
  done <<<"$1"
}
escalate() { ledger_write "$1" escalated "$2" && finding_paged "$1" "$2"; }

# finding_paged <sid> <key>: a fleet-bench finding (sid finding-*, key "<fact> <class>") that went to
# the human is a page on that finding's episode, so `fleet-bench loop` can tell a page from an act.
# Best effort: a bench that cannot record leaves the escalation standing.
finding_paged() {
  [[ "$1" == finding-* && "$2" == *" human" ]] || return 0
  "${FLEET_BENCH:-fleet-bench}" respond "${2% human}" shepherd paged >/dev/null 2>&1 || true
}

# labels_of <sid> -> the session's labels, comma-joined in the order set, or "-".
labels_of() {
  local l
  l="$(paste -sd, "$LABELS/$1" 2>/dev/null)"
  echo "${l:--}"
}

# resolve_sid <who> -> a session id: `self` is this session ($CLAUDE_CODE_SESSION_ID); anything
# else matches a live session's id, target (lab/s1:1), tmux target (s1:1) or tmux session (s1).
resolve_sid() {
  local who="$1"
  if [ "$who" = self ]; then
    [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] || { echo "fleet-sessions: self needs CLAUDE_CODE_SESSION_ID" >&2; return 2; }
    echo "$CLAUDE_CODE_SESSION_ID"; return
  fi
  local sid
  sid="$("${AGENT_PANEL:-agent-panel}" list --json 2>/dev/null | jq -r --arg w "$who" '
    select(.session_id == $w or .target == $w or (.target | sub("^[^/]*/"; "")) == $w
           or (.target | sub("^[^/]*/"; "") | sub(":[^:]*$"; "")) == $w) | .session_id' | head -1)"
  [ -n "$sid" ] || { echo "fleet-sessions: no live session matches '$who'" >&2; return 2; }
  echo "$sid"
}

# label <who> [+name|-name|^name ...]: add, remove or flip labels, then print the session's labels.
# ^name lets a key binding (agent-panel ctrl-t) flip one without reading it first.
label() {
  local who="${1:-}" sid op name tmp add
  [ -n "$who" ] || { echo "usage: fleet-sessions label <who> [+name|-name|^name ...]" >&2; return 2; }
  sid="$(resolve_sid "$who")" || return 2
  case "$sid" in ''|*/*|.|..) echo "fleet-sessions: bad session id" >&2; return 2 ;; esac
  shift
  mkdir -p "$LABELS"
  for op in "$@"; do
    name="${op#[+^-]}"
    if [ "$name" = "$op" ] || ! [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9:._-]*$ ]]; then
      echo "fleet-sessions: label ops are +name, -name or ^name ([A-Za-z0-9:._-]), got '$op'" >&2; return 2
    fi
    add=0
    case "${op:0:1}" in
      +) add=1 ;;
      ^) grep -qxF -- "$name" "$LABELS/$sid" 2>/dev/null || add=1 ;;
    esac
    tmp="$(mktemp "$LABELS/.$sid.XXXXXX")" || return 1
    { grep -vxF -- "$name" "$LABELS/$sid" 2>/dev/null; [ "$add" = 1 ] && echo "$name"; } > "$tmp"
    if [ -s "$tmp" ]; then mv "$tmp" "$LABELS/$sid"; else rm -f "$tmp" "$LABELS/$sid"; fi
  done
  [ $# -gt 0 ] && tmux_labels "$sid"
  labels_of "$sid"
}

# --- tmux projection ----------------------------------------------------------------------
# The state document's stage and labels, copied onto each session's tmux window as @fleet_stage
# and @fleet_labels, so the window-status format (.tmux.conf) and agent-panel show them. It is a
# projection, never read back as a fact. Targets are <server>/<session>:<window>.

# tmux_project <state document>: per server, set both options on every session's window and clear
# them from windows that no longer hold one (a claude that exited in a pane that stayed). One tmux
# call per server; a server it cannot reach is skipped and the next tick tries again.
tmux_project() {
  local want srv have t st lb
  local -a cmd
  want="$(jq -r '.sessions[] | select(.target | test("^[^/]+/[^:]+:"))
    | [.target, .bucket, ((.labels // []) | join(","))] | @tsv' "$1" 2>/dev/null)" || return 0
  for srv in $( { find "${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)" -maxdepth 1 -type s -printf '%f\n' 2>/dev/null
                  [ -n "$want" ] && cut -d/ -f1 <<<"$want"; } | sort -u); do
    have="$(tmux -L "$srv" list-windows -a -f '#{@fleet_stage}' -F '#{session_name}:#{window_index}' 2>/dev/null)" || continue
    cmd=()
    while IFS=$'\t' read -r t st lb; do
      [ -n "$t" ] && [ "${t%%/*}" = "$srv" ] || continue
      t="${t#*/}"
      have="$(grep -vxF -- "$t" <<<"$have")"
      cmd+=(set-option -wq -t "=$t" @fleet_stage "$st" \;)
      if [ -n "$lb" ]; then cmd+=(set-option -wq -t "=$t" @fleet_labels "$lb" \;)
      else cmd+=(set-option -wqu -t "=$t" @fleet_labels \;); fi
    done <<<"$want"
    while IFS= read -r t; do
      [ -n "$t" ] && cmd+=(set-option -wqu -t "=$t" @fleet_stage \; set-option -wqu -t "=$t" @fleet_labels \;)
    done <<<"$have"
    [ ${#cmd[@]} -gt 0 ] || continue
    unset 'cmd[-1]'
    tmux -L "$srv" "${cmd[@]}" >/dev/null 2>&1 || echo "fleet-sessions: tmux projection on $srv failed" >&2
  done
}

# tmux_labels <sid>: put one session's labels on its window now, so a change made from agent-panel
# shows on its relaunch instead of at the next tick. The target comes from the state document; a
# session too new to be in it gets its labels at the next tick.
tmux_labels() {
  local t l
  t="$(jq -r --arg s "$1" '.sessions[] | select(.session_id == $s) | .target' "$STATE_FILE" 2>/dev/null | head -1)"
  [[ "$t" == */*:* ]] || return 0
  l="$(paste -sd, "$LABELS/$1" 2>/dev/null)" || l=""
  if [ -n "$l" ]; then tmux -L "${t%%/*}" set-option -wq -t "=${t#*/}" @fleet_labels "$l" >/dev/null 2>&1
  else tmux -L "${t%%/*}" set-option -wqu -t "=${t#*/}" @fleet_labels >/dev/null 2>&1; fi
  return 0
}

# --- facts ------------------------------------------------------------------------------
# asks_for <claude session id> -> the ids of its pending asks, one per line. Only the
# asking session owns an ask. The tmux session name is not a fallback: every window in it
# and every later session that reuses the name share it, and a 10-24 ask held a 10-28
# session open that way. An ask with no owner blocks nobody; the state document still
# lists it under `asks`.
asks_for() {
  [ -n "$1" ] || return 0
  # The store keeps every ask ever filed, so collect reads it once for its whole pass.
  awk -F'\t' -v s="$1" '$1 == s { print $2 }' <<<"${PENDING_ASKS-$(pending_asks)}"
}

# pending_asks -> "<claude session>\t<ask id>" per pending ask in the store, per owner line.
pending_asks() {
  awk '
    function flush(   i, id) {
      id = file; sub(/.*\//, "", id); sub(/\.md$/, "", id)
      if (pending) for (i = 1; i <= n; i++) print owner[i] "\t" id
      pending = 0; n = 0
    }
    FNR == 1 { if (file != "") flush(); file = FILENAME }
    $0 == "status: pending" { pending = 1 }
    /^claude_session: ./ { owner[++n] = substr($0, 17) }
    END { if (file != "") flush() }' "$ASK_ROOT"/*/*.md 2>/dev/null
}

# Panes (<server>/<pane id>, agent-panel's .pane) holding a heavy process, one per line, from
# fleet-assess's PANE column. Keyed on the pane, not the tmux session: one session's windows
# are separate agents, and a build in one is not work in the others (ar-290).
heavy_panes() {
  local fa
  fa="$(command -v fleet-assess || echo "$(dirname "$0")/fleet-assess")"
  "$fa" 2>/dev/null | awk 'f && NF == 0 { exit } f && $8 != "" && $8 != "-" { print $8 } /^PID /{ f = 1 }' | sort -u
}

# repo_slug <dir> -> the origin URL as a file-name-safe key (cache files, NIGHTLY ledger ids).
repo_slug() {
  local url
  url="$(git -C "$1" remote get-url origin 2>/dev/null)" || return 1
  printf '%s' "$url" | tr -c 'A-Za-z0-9' _
}

# unreadable <name>: this pass could not read <name>, so the state document names it.
unreadable() { echo "$1" >> "$CACHE/unreadable"; }
# blind_row: the row collect is building read a source that failed, on this call or earlier in the
# pass, so tick keeps that row's last cells (keep_blind). Every read of a failed source calls it.
blind_row() { : > "$CACHE/blind_row"; }

# PRs for one repo, cached per pass: "branch \t number \t state \t ci \t head_oid \t red job ids", newest first,
# from the PR store (`schedules-sync prs --checks`, unreadable once 30 minutes stale): ci is the run ledger's
# reading of the head commit, red the job archive's failed job ids (- for none it has yet). A clone
# on a Forgejo host (so_forgejo_hosts: the submodule External/asset-library) reads its host/owner/repo,
# and one the store does not list has no PRs, never an unreadable source (ar-1116 named it every pass),
# as has a GitHub mirror of a Forgejo-canonical repo (forge_canonical: its PRs are on Forgejo); any
# other GitHub repo it does not list is unreadable (`schedules-sync repos` is the list).
prs_for() {
  local dir="$1" key host repo out rc=0
  key="$CACHE/$(repo_slug "$dir")" || return 0
  if [ ! -f "$key" ]; then
    repo="$(origin_repo "$dir")" || return 0
    host="$(origin_host "$dir")"
    [[ " $(so_forgejo_hosts) " != *" $host "* ]] || repo="$host/$repo"
    out="$("$SCHEDULES_SYNC" prs "$repo" --checks 2>/dev/null)" || rc=$?
    if [ "$rc" = 0 ] && jq -r '.[] | [.branch // "-", .number, .state, .ci, .head_sha // "-", .red] | @tsv' \
         <<<"$out" > "$key" 2>/dev/null; then :
    elif [ "$rc" = 3 ] && { [[ "$repo" == */*/* ]] || forge_canonical "$dir"; }; then : > "$key"
    else : > "$key"; : > "$key.failed"; unreadable "PR store ($repo)"; fi
  fi
  [ ! -f "$key.failed" ] || blind_row
  cat "$key"
}

# branch_runs <dir> <branch> -> <branch>'s main_runs in <dir>'s origin repo: gate_ci, main_health
# and activity_line all read it, from one ledger read per repo per pass ($CACHE). A repo the ledger
# does not sync has no runs ([]); one it cannot answer for is named unreadable once, and is rc 1
# with the row blind on every read.
branch_runs() {
  local d="$1" b="$2" all one rc=0
  all="$CACHE/runs_$(repo_slug "$d")" || return 1
  one="${all}_${b//\//%2F}" # %2F: feat/x and feat_x are two branches
  if [ ! -f "$one" ]; then
    if [ ! -f "$all" ]; then
      main_runs "$(origin_repo "$d")" > "$all" || rc=$?
      case $rc in
        0) ;;
        3) echo '[]' > "$all" ;;
        *) : > "$all"; unreadable "run ledger ($(basename "$d"))" ;;
      esac
    fi
    if [ -s "$all" ]; then
      jq -c --arg b "$b" 'map(select(.headBranch == $b))' "$all" > "$one" 2>/dev/null \
        || { : > "$one"; unreadable "run ledger ($(basename "$d"))"; }
    else : > "$one"; fi
  fi
  [ -s "$one" ] || { blind_row; return 1; }
  cat "$one"
}

# gate_ci <dir> <PR head branch> <head_oid> <ci> [<red job ids>] -> <ci> with the branch's dispatched gate runs folded in.
# A pool gate is a workflow_dispatch run, which never appears in a PR's statusCheckRollup, so a PR
# whose Checks passed read green while its gate was queued or red (#1175, #1180). Each
# FLEET_GATE_WORKFLOWS workflow's newest dispatched run on a commit the PR head holds (a reused
# slot branch's old runs are on commits it does not) counts as a check, by CI_JQ's order: running
# is PENDING, else a red is FAIL. A run decides by MAIN_STREAKS' conclusions, so a cancelled,
# skipped or stale one decides nothing, as gate-line.py passes over a cancelled one. Whether an
# older gate still covers the head is Checks' call (gate-line.py), so an older green adds nothing.
# A workflow is its file (workflowPath), as in MAIN_STREAKS: its title follows run-name, so a newer
# green `Tests (all)` supersedes an older red `Tests (affected)` (ar-1094).
# Only a PASS or NONE can change, and a FAIL whose red jobs failed only in FLEET_GATE_LINE_STEPS, which
# a gate running on the head itself makes PENDING: that red is the gate line waiting on it (ar-82, #1692
# read CI red mid-gate). A gate still running on an older commit leaves it red: the head has none.
# The run list is branch_runs', and one the ledger cannot answer keeps <ci> and is named unreadable.
gate_ci() {
  local d="$1" br="$2" oid="$3" ci="$4" jobs="${5:--}" runs wf st c sha seen="" pend=0 fail=0 pass=0 pendhead=0
  case "$ci" in
    PASS|NONE) ;;
    FAIL) [ "$jobs" != - ] && [ -n "$FLEET_GATE_LINE_STEPS" ] || { echo FAIL; return; } ;;
    *) echo "$ci"; return ;;
  esac
  if ! runs="$(branch_runs "$d" "$br")"; then echo "$ci"; return; fi
  while IFS=$'\t' read -r wf st c sha; do
    case $'\n'"$seen" in *$'\n'"$wf"$'\n'*) continue ;; esac
    [ "$sha" = "$oid" ] || git -C "$d" merge-base --is-ancestor "$sha" "$oid" 2>/dev/null || continue
    seen+="$wf"$'\n'
    if [ "$st" != completed ]; then pend=1; [ "$sha" = "$oid" ] && pendhead=1
    elif [ "$c" = success ]; then pass=1
    else fail=1; fi
  done < <(jq -r --arg gates "$FLEET_GATE_WORKFLOWS" \
             'map(select(.event == "workflow_dispatch" and (.workflowName | test($gates))
                     and (.status != "completed"
                          or ((.conclusion // "") | test("^(success|failure|timed_out|startup_failure)$")))))
                  | sort_by(.createdAt) | reverse | .[]
                  | [.workflowPath, .status, ((.conclusion // "") | if . == "" then "-" else . end), .headSha]
                  | @tsv' <<<"$runs")  # "-": IFS tab would merge an empty field into the next
  if [ "$ci" = FAIL ]; then
    if [ "$pendhead" = 1 ] && gate_line_only "$d" "$jobs"; then echo PENDING; else echo FAIL; fi
  elif [ "$pend" = 1 ]; then echo PENDING
  elif [ "$fail" = 1 ]; then echo FAIL
  elif [ "$pass" = 1 ]; then echo PASS
  else echo "$ci"; fi
}

# gate_line_only <dir> <red job ids> -> true when each job failed only in FLEET_GATE_LINE_STEPS steps.
# A finished job's steps never change, so each is one gh call kept in MAIN_CACHE; a cancelled job, a
# check that is not a job (-) or one gh cannot read is a real red.
gate_line_only() {
  local d="$1" id file steps n
  for id in ${2//,/ }; do
    [ "$id" != - ] || return 1
    file="$MAIN_CACHE/job_steps_$id"
    if [ ! -s "$file" ]; then
      steps="$(cd "$d" && gh api "repos/{owner}/{repo}/actions/jobs/$id" \
        -q '[.steps[] | select((.conclusion // "skipped") | test("^(success|skipped)$") | not) | .name]
            | if length == 0 then "-" else .[] end' 2>/dev/null)" && [ -n "$steps" ] \
        || { unreadable "gh api actions/jobs/$id ($(basename "$d"))"; blind_row; return 1; }
      mkdir -p "$MAIN_CACHE"
      printf '%s\n' "$steps" > "$file.$$" && mv "$file.$$" "$file"
    fi
    while IFS= read -r n; do [[ "$n" =~ $FLEET_GATE_LINE_STEPS ]] || return 1; done < "$file"
  done
}

# pr_made_here <dir> <N> <branch> <session_prs JSON> <transcript> <plan|-> [<other plans>] -> true
# when this session made PR #N of <dir>'s repo: its plan's Phases name #N (bare, not <repo>#N), it
# opened or merged it (session_prs, a Forgejo repo's host dropped, since the clone's origin names
# only owner/repo), or, when no plan in <other plans> (newline-separated: the plans of the other
# windows in this worktree) names #N, its transcript holds the PR's URL or it pushed <branch> (the
# command, or git's `-> <branch>` line for a bare `git push`). A PR belongs to the plan it served:
# worktrees and branch names are shared and recycled, and a session that reads another window's PR
# (`gh pr view` prints its URL) holds it in its transcript. trader-real-money-plan read LANDED on
# #42 and #50 of so-how-do-i-velvet-pine, run in another window of its worktree (ar-492).
pr_made_here() {
  local repo n="$2" br="$3" t="$5" plan="$6" other re
  repo="$(origin_repo "$1")"
  phases_name "$plan" "$n" && return 0
  jq -e --arg r "${repo,,}" --argjson n "$n" 'any(.[]; (.repo | ascii_downcase | split("/")[-2:] | join("/")) == $r and .number == $n)' \
    <<<"$4" >/dev/null 2>&1 && return 0
  # The same plan under another account's plans dir is this plan, not another window's.
  while IFS= read -r other; do
    [ -n "$other" ] && [ "${other##*/}" != "${plan##*/}" ] && phases_name "$other" "$n" && return 1
  done <<<"${7:-}"
  [ -f "$t" ] || return 1
  [ -n "$repo" ] && grep -qiE "github\.com/$(re_quote "$repo")/pull/$n([^0-9]|$)" "$t" && return 0
  [ "$br" != - ] || return 1
  re="$(re_quote "$br")"
  grep -qE "(git push[^\"]*( |:|refs/heads/)| -> )$re([^A-Za-z0-9._/-]|$)" "$t"
}

# phases_name <plan|-> <N> -> true when the plan's ## Phases section names #N (bare, not <repo>#N).
phases_name() {
  [ "$1" != - ] && [ -f "$1" ] \
    && sed -n '/^## Phases/,/^## /p' "$1" | grep -qE "(^|[^A-Za-z0-9_./-])#$2([^0-9]|$)"
}

# re_quote <text> -> <text> with ERE metacharacters escaped.
re_quote() { sed 's/[][\.*^$+?(){}|]/\\&/g' <<<"$1"; }

# sibling_pr <dir> <session_prs JSON> -> "repo \t number \t ci \t head_oid" for the last OPEN PR
# this session opened in a repo other than <dir>'s, or nothing. A session that works in one clone
# can open its PR from another (ar-349, read STALLED "no PR" while that PR ran CI). A Forgejo PR
# (host/owner/repo) is skipped: gh cannot read its CI. Its CI is one
# `gh pr view` reused for FLEET_MAIN_TTL seconds across passes; a failed call is
# (or an answer that is not a PR) is not cached, nor retried in this pass, and is named unreadable so tick does not log the blink.
sibling_pr() {
  local own repo n file failed view
  own="$(origin_repo "$1")"
  IFS=$'\t' read -r repo n < <(jq -r --arg own "${own,,}" \
    'map(select(.state == "OPEN" and (.repo | test("^[^/]+/[^/]+$")) and (.repo | ascii_downcase) != $own)) | last // empty | [.repo, .number] | @tsv' <<<"$2")
  [ -n "${n:-}" ] || return 0
  file="$MAIN_CACHE/view_${repo//\//_}_$n.json"
  failed="$CACHE/view_failed_${repo//\//_}_$n"
  if [ -s "$file" ] && [ $(( $(date +%s) - $(date -r "$file" +%s) )) -lt "$FLEET_MAIN_TTL" ]; then
    view="$(cat "$file")"
  elif [ ! -f "$failed" ] && view="$(gh pr view "$n" --repo "$repo" --json statusCheckRollup,headRefOid 2>/dev/null)" \
       && jq -e 'has("headRefOid")' <<<"$view" >/dev/null 2>&1; then
    mkdir -p "$MAIN_CACHE"
    printf '%s\n' "$view" > "$file.$$" && mv "$file.$$" "$file"
  else
    [ -f "$failed" ] || { : > "$failed"; unreadable "gh pr view $repo#$n"; }
    blind_row; return 0
  fi
  jq -r --arg r "$repo" --argjson n "$n" "$CI_JQ"' [$r, $n, ci, (.headRefOid // "-")] | @tsv' <<<"$view"
}

# default_base <dir> -> origin/<default branch>, kept in MAIN_CACHE for FLEET_BASE_TTL across passes.
# GitHub's answer wins: origin/HEAD is set at clone time and goes stale when the default branch changes.
# The symref is the offline fallback, and a name this clone has no remote ref for is unused.
default_base() {
  local d="$1" key b slug
  slug="$(repo_slug "$d")" || { echo origin/main; return; }
  key="$MAIN_CACHE/base_$slug"
  if [ ! -s "$key" ] || [ $(( $(date +%s) - $(date -r "$key" +%s) )) -ge "$FLEET_BASE_TTL" ]; then
    mkdir -p "$MAIN_CACHE"
    b="$(cd "$d" && gh repo view --json defaultBranchRef -q .defaultBranchRef.name 2>/dev/null)"
    if [ -z "$b" ] || ! git -C "$d" rev-parse -q --verify "refs/remotes/origin/$b" >/dev/null 2>&1; then
      b="$(git -C "$d" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)"; b="${b#origin/}"
    fi
    echo "origin/${b:-main}" > "$key"
  fi
  cat "$key"
}

# main_state: main_runs JSON (any order) on stdin -> one line per workflow whose latest
# decided run failed: "workflow \t first_red_sha \t last_green_sha|-". The red sha is the
# FIRST failure after the last green (the oldest in the window when there is none), so the
# fact holds still while a red streak runs on, and the suspect range ends where it broke.
# Cancelled, skipped, running and FLEET_PARTIAL_RUNS runs decide nothing, so they are passed over,
# and so is a workflow MAIN_LIVE drops (no run in MAIN_STALE_HOURS before the branch's newest run).
main_state() {
  jq -r --arg partial "$FLEET_PARTIAL_RUNS" \
    'map(select(.workflowName // "" | test($partial) | not))
     | '"$MAIN_LIVE | $MAIN_STREAKS"' | [.workflow, .red.headSha, (.green.headSha // "-")] | @tsv'
}

# pr_states <owner/repo or host/owner/repo (Forgejo)> -> the repo's PRs as a JSON array of {number, state, mergedAt},
# from the PR store, read once per pass: it keys on the repo the PR is in, not the cwd, since one session
# lands PRs in several. A repo the store cannot answer for is rc 1, and not read again this pass.
pr_states() {
  local repo="$1" file
  file="$CACHE/prs_${repo//\//_}.json"
  if [ ! -f "$file" ]; then
    "$SCHEDULES_SYNC" prs "$repo" 2>/dev/null | jq -c 'map({number, state, mergedAt: .merged_at})' > "$file" 2>/dev/null
  fi
  [ -s "$file" ] && cat "$file"
}

# session_prs <transcript> -> the PRs this session opened or merged, as a JSON array of
# {repo, number, state, merged_at}. A PR its repo's list does not reach has a null state.
session_prs() {
  local f="$1" prs repo
  [ -f "$f" ] || { echo '[]'; return; }
  prs="$(so_transcript_metrics "$f" | jq -c '.prs // []')"
  [ -n "$prs" ] || { echo '[]'; return; }
  # a repo's whole PR list goes through a pipe, never argv: it outgrows an argument's 128 KB
  while IFS= read -r repo; do
    pr_states "$repo" | jq -c --arg r "$repo" '{($r): map({key: (.number | tostring), value: .}) | from_entries}' || :
  done < <(jq -r '.[].repo' <<<"$prs" | sort -u) |
    jq -sc --argjson p "$prs" '(add // {}) as $s | $p | map(. + {state: $s[.repo][.number | tostring].state,
      merged_at: $s[.repo][.number | tostring].mergedAt})'
}

# prs_cell: session_prs output on stdin -> "<merged>/<total>", with a ? while any state is
# unknown, or - with no PRs.
prs_cell() {
  jq -r 'if length == 0 then "-" else
    "\(map(select(.state == "MERGED")) | length)/\(length)\(if any(.state == null) then "?" else "" end)" end'
}

# main_health <dir> -> "RED \t <detail> \t <red sha> \t <suspect PRs, space-separated>", "OK"
# or "UNKNOWN", cached per repo per pass. A red workflow's range is last-green..red on this
# clone, and its (#N) squash subjects are suspects only when there are FLEET_SUSPECTS_MAX or
# fewer. No green in the window, or a range the clone lacks, names nobody.
main_health() {
  local dir="$1" url key base b runs st wf red green wfs="" sha="" prs="" range
  url="$(git -C "$dir" remote get-url origin 2>/dev/null)" || { echo OK; return; }
  key="$CACHE/main_$(repo_slug "$dir")"
  if [ ! -f "$key" ]; then
    base="$(default_base "$dir")"
    b="${base#origin/}"
    # Could not look is not green: say so, so the shepherd never reads a dead gh, or runs main_state
    # cannot read, as healthy.
    if ! runs="$(branch_runs "$dir" "$b")" || ! st="$(main_state <<<"$runs")"; then
      printf 'UNKNOWN\t-\t-\t-\t%s\n' "$(basename "$url" .git)" > "$key"
      cut -f1-4 "$key"; return
    fi
    while IFS=$'\t' read -r wf red green; do
      [ -n "$wf" ] || continue
      [ -n "$sha" ] || sha="$red"
      if [ "$green" = - ]; then range="no green in window"
      elif ! git -C "$dir" cat-file -e "$red^{commit}" 2>/dev/null \
           || ! git -C "$dir" cat-file -e "$green^{commit}" 2>/dev/null; then range="range not in clone"
      else
        range="$(git -C "$dir" log --format=%s "$green..$red" | grep -oE '\(#[0-9]+\)$' | tr -dc '0-9\n' | sort -un | tr '\n' ' ')"
        range="${range% }"
        if [ -z "$range" ]; then range="no PR in range"
        elif [ "$(wc -w <<<"$range")" -le "$FLEET_SUSPECTS_MAX" ]; then prs="$prs $range"; range="#${range// / #}"
        else range="$(wc -w <<<"$range") PRs since green"; fi
      fi
      # No green: the oldest red in view slides as runs age out, so that fact names no sha.
      if [ "$green" = - ]; then wfs="${wfs:+$wfs, }$wf ($range)"
      else wfs="${wfs:+$wfs, }$wf @${red:0:8} ($range)"; fi
    done <<<"$st"
    if [ -n "$wfs" ]; then
      # Every field non-empty: read with a tab IFS folds an empty field into the next.
      prs="$(tr ' ' '\n' <<<"$prs" | grep . | sort -un | paste -sd' ' -)"
      printf 'RED\t%s\t%s\t%s\t%s\n' "$wfs" "${sha:0:8}" "${prs:--}" "$(basename "$url" .git)" > "$key"
    else echo OK > "$key"; fi
  fi
  [ "$(cut -f1 "$key")" != UNKNOWN ] || blind_row   # a later row of the repo read the same failed ledger
  cut -f1-4 "$key"
}

# dirty_paths <dir> <edited files, one absolute path per line>: the session's dirty files,
# one repo-relative path per line. In its own worktree (under ~/.worktrees/) every dirty file
# is its own. A repo's main checkout is shared with the human and other sessions, so there
# only the files this session edited count: the human's half-done config is not this
# session's to land. -z: no quoting of odd names; --no-renames: one record per path.
dirty_paths() {
  local d="$1" edited="$2" top
  # Recursive status across many worktrees multiplies index reader and preload threads.
  # Keep these scans serial without changing the repo config or hiding submodule dirt.
  case "$d/" in
    "$HOME/.worktrees/"*)
      git -C "$d" -c index.threads=1 -c core.preloadIndex=false status --porcelain -z --no-renames 2>/dev/null \
        | while IFS= read -r -d '' e; do printf '%s\n' "${e:3}"; done; return ;;
  esac
  [ -n "$edited" ] || return 0
  top="$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)" || return 0
  # -uall: an untracked file inside a new dir is listed by name, as edited_files names it.
  git -C "$d" -c index.threads=1 -c core.preloadIndex=false status --porcelain -z --no-renames -uall 2>/dev/null \
    | while IFS= read -r -d '' e; do printf '%s/%s\n' "$top" "${e:3}"; done \
    | grep -xFf <(printf '%s\n' "$edited" | xargs -r -d '\n' realpath -m -- 2>/dev/null | grep .) \
    | cut -c"$(( ${#top} + 2 ))"-
}

# edited_work_blockers <cwd> <edited paths>: unlanded work in other repositories this
# session edited. Never scan unrelated sibling worktrees or count their work as ours.
edited_work_blockers() {
  local cwd="$1" edited="$2" top path dir g dirty ahead pr state ci inpr branch behind conflicts fork oid names why bucket red health workflows suspects kind=WORKING out=""
  [ -n "$edited" ] || return 0
  top="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)"
  while IFS= read -r dir; do
    [ -n "$dir" ] && [ "$dir" != "$top" ] || continue
    read -r g dirty ahead pr state ci inpr branch behind conflicts fork oid names < <(git_facts "$dir" "$edited")
    red=-
    if [ "$state" = MERGED ]; then
      IFS=$'\t' read -r health workflows _ suspects < <(main_health "$dir")
      if [ "$health" = RED ] && grep -qxF "$pr" <<<"$(tr ' ' '\n' <<<"$suspects")"; then
        red="$workflows"
        [ -z "${3:-}" ] || printf '%s\t%s\n' "$(repo_slug "$dir")" "$3" >> "$CACHE/owners"
      fi
    fi
    # A completed checklist suppresses plan blockers: only this tree's git facts matter.
    why="$(work_blockers '' idle 0 0 0 30 "$g" "$dirty" "$ahead" "$pr" "$state" "$ci" "$inpr" "$red" 1/1 - "$conflicts" - "$names")"
    if [ -n "$why" ]; then
      bucket="$(session_bucket idle 0 0 0 "$FLEET_IDLE_MIN" "$g" "$dirty" "$ahead" "$pr" "$state" "$ci" "$inpr" "$red" 1/1 - "$conflicts" - "$names")"
      [ "${bucket%% *}" != STALLED ] || kind=STALLED
      out="${out:+$out; }$dir: $why"
    fi
  done < <(
    while IFS= read -r path; do
      [[ "$path" = /* ]] || continue
      dir="$(dirname -- "$path")"
      while [ ! -d "$dir" ] && [ "$dir" != / ]; do dir="$(dirname -- "$dir")"; done
      git -C "$dir" rev-parse --show-toplevel 2>/dev/null
    done <<<"$edited" | sort -u
  )
  [ -z "$out" ] || printf '%s unlanded work in %s' "$kind" "$out"
}

# dirty_names <paths, one per line>: the first FLEET_DIRTY_NAMES of them for a reason, "+N more"
# past that; - when there are none. "1 dirty file(s)" alone sent agent-18 (2026-11-04) and the
# human guessing: the one file was a submodule Unity had re-imported.
dirty_names() {
  awk -v k="$FLEET_DIRTY_NAMES" 'NF { n++; if (n <= k) s = s (n > 1 ? ", " : "") $0 }
    END { if (n > k) s = s ", +" (n - k) " more"; print (n ? s : "-") }' <<<"$1"
}

# ahead_files <dir> <base>: files the branch changed since the merge base whose content in
# HEAD still differs from the base tip. A squash-merged branch, or a local merge commit
# whose content is already on origin, changed files that origin now has, so it counts 0.
ahead_files() {
  local d="$1" base="$2" mb
  mb="$(git -C "$d" merge-base "$base" HEAD 2>/dev/null)" || { echo 0; return; }
  comm -12 <(git -C "$d" diff --name-only "$mb" HEAD 2>/dev/null | sort) \
           <(git -C "$d" diff --name-only "$base" HEAD 2>/dev/null | sort) | wc -l
}

# fetch_once <dir>: with FLEET_FETCH=1 (tick sets it), fetch origin once per repo per pass,
# so behind and conflicts are measured against the remote tip, not the last manual fetch.
# Worktrees of one repo share its refs, so one fetch covers them all.
fetch_once() {
  [ "${FLEET_FETCH:-0}" = 1 ] || return 0
  local key
  key="$CACHE/fetched_$(repo_slug "$1")" || return 0
  [ -f "$key" ] || { git -C "$1" fetch -q origin 2>/dev/null; : > "$key"; }
}

# sync_facts <dir> <base> -> "behind conflicts fork": commits on the base this branch lacks,
# whether merging the base in would conflict (yes|no), and on a conflict the merge base (else
# -). merge-tree touches no checkout. The merge base moves only when the branch takes the base
# in, so it names one conflict across pushes and the base moving on.
sync_facts() {
  local d="$1" base="$2" behind conflicts=no fork=-
  behind="$(git -C "$d" rev-list --count "HEAD..$base" 2>/dev/null)" || { echo "- - -"; return; }
  if [ "$behind" -gt 0 ]; then
    git -C "$d" merge-tree --write-tree --no-messages "$base" HEAD >/dev/null 2>&1
    case $? in 0) ;; 1) conflicts=yes ;; *) conflicts=- ;; esac
  fi
  [ "$conflicts" = yes ] && fork="$(git -C "$d" merge-base "$base" HEAD 2>/dev/null)"
  echo "$behind $conflicts ${fork:--}"
}

# off_default_checkouts -> each checkout stow deploys (the two dotfiles-drift reads) that is not on
# its default branch, one per line. Worktrees are never in it: a branch is what they are for.
# The local symref settles the usual case, so a clean pass costs no gh call. Each is its real path,
# which is how a session's cwd reads.
off_default_checkouts() {
  local d cur base
  for d in "${DOTFILES:-$HOME/.dotfiles}" "${DOTFILES_PRIVATE:-$HOME/.dotfiles-private}"; do
    [ -e "$d/.git" ] || continue
    cur="$(git -C "$d" symbolic-ref -q --short HEAD)"
    [ "origin/$cur" = "$(git -C "$d" symbolic-ref -q --short refs/remotes/origin/HEAD)" ] && continue
    base="$(default_base "$d")"
    [ "$cur" = "${base#origin/}" ] || realpath "$d"
  done
}

# in_checkout <dir> <checkouts, one per line>: <dir> is one of them or inside one.
in_checkout() {
  local c
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    case "$1/" in "$c"/*) return 0 ;; esac
  done <<<"$2"
  return 1
}

# pr_of_head <dir> <branch> -> prs_for's row for the PR that holds this clone's HEAD, or nothing.
# A PR whose head commit is HEAD wins whatever its head branch is: a slot branch is reused and its
# work can go out on another branch (2026-11-07: agent-20 landed as #1500 via all-sources-p5-scoring,
# and the older closed #1490 of the same name was named the blocker). Else the newest PR of the
# local or upstream branch name, except a closed one that does not hold HEAD: that is an old PR.
pr_of_head() {
  local d="$1" branch="$2" head up row b s o
  head="$(git -C "$d" rev-parse HEAD 2>/dev/null)" || return 0
  up="$(git -C "$d" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)"; up="${up#*/}"
  while IFS= read -r row; do
    IFS=$'\t' read -r _ _ _ _ o _ <<<"$row"
    [ "$o" = "$head" ] && { printf '%s\n' "$row"; return; }
  done < <(prs_for "$d")
  while IFS= read -r row; do
    IFS=$'\t' read -r b _ s _ o _ <<<"$row"
    [ "$b" = "$branch" ] || { [ -n "$up" ] && [ "$b" = "$up" ]; } || continue
    if [ "$s" = CLOSED ] && ! git -C "$d" merge-base --is-ancestor "$head" "$o" 2>/dev/null; then continue; fi
    printf '%s\n' "$row"; return
  done < <(prs_for "$d")
}

# pr_holding_head <dir> -> prs_for's row for the oldest OPEN PR whose head holds this clone's HEAD
# (the nearest of a stack, which lands it first), or nothing. A stacked branch has no PR of its own when its commits went out inside the PR of the
# branch built on it (ar-82: agent-51 feat/tourney-daily-cap inside #1674). git_facts asks only
# when HEAD has files the base lacks, so a HEAD still on the base, held by every PR, never asks.
pr_holding_head() {
  local d="$1" head row s o hit=""
  head="$(git -C "$d" rev-parse HEAD 2>/dev/null)" || return 0
  while IFS= read -r row; do
    IFS=$'\t' read -r _ _ s _ o _ <<<"$row"
    [ "$s" = OPEN ] && git -C "$d" merge-base --is-ancestor "$head" "$o" 2>/dev/null && hit="$row"
  done < <(prs_for "$d")   # newest first, so the last hit is the oldest
  [ -z "$hit" ] || printf '%s\n' "$hit"
}

# One session's facts as the session_bucket arguments after status/plan/asks/heavy/idle,
# plus branch, sync, the PR head and the dirty names (last: they may hold spaces):
# "git dirty ahead pr state ci in_pr branch behind conflicts fork oid names".
git_facts() {
  local d="$1" edited="${2:-}" branch dirty=0 paths ahead base prb pr state ci oid red inpr=1 head
  [ -d "$d" ] || { echo "gone 0 0 - - - 1 - - - - - -"; return; }
  git -C "$d" rev-parse --git-dir >/dev/null 2>&1 || { echo "0 0 0 - - - 1 - - - - - -"; return; }
  fetch_once "$d"
  branch="$(git -C "$d" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  paths="$(dirty_paths "$d" "$edited")"
  [ -n "$paths" ] && dirty="$(wc -l <<<"$paths")"
  base="$(default_base "$d")"
  ahead="$(ahead_files "$d" "$base")"
  IFS=$'\t' read -r prb pr state ci oid red < <(pr_of_head "$d" "$branch")
  [ -z "${pr:-}" ] && [ "$ahead" -gt 0 ] && IFS=$'\t' read -r prb pr state ci oid red < <(pr_holding_head "$d")
  # The gate runs are on the PR's head branch, which a reused slot or a stacked branch does not share.
  [ "${state:-}" = OPEN ] && ci="$(gate_ci "$d" "$prb" "$oid" "$ci" "$red")"
  if [ -n "${oid:-}" ]; then
    head="$(git -C "$d" rev-parse HEAD)"
    # HEAD is in the PR when it is the PR head or behind it; an unknown oid means the
    # remote holds commits this clone lacks, which is also "nothing new here". HEAD already
    # in the base is landed too: a reused slot branch keeps its name, so its newest PR by
    # name is an old one whose head this HEAD has moved past.
    if [ "$head" != "$oid" ] && git -C "$d" cat-file -e "$oid^{commit}" 2>/dev/null \
       && ! git -C "$d" merge-base --is-ancestor HEAD "$oid" 2>/dev/null \
       && ! git -C "$d" merge-base --is-ancestor HEAD "$base" 2>/dev/null; then inpr=0; fi
  fi
  echo "1 $dirty $ahead ${pr:--} ${state:--} ${ci:--} $inpr ${branch:--} $(sync_facts "$d" "$base") ${oid:--} $(dirty_names "$paths")"
}

# activity_line <status> <open job> <doing> <dir|-> <branch> <head sha|-> <now epoch> -> what the
# session is doing now, for the ACTIVITY column on Sessions (nc-41), first match wins:
# parked; testing (a test command runs); editing (busy, its last tool call an edit); waiting on
# <workflow> <N>m (a run on its head still open in the run ledger, the oldest, N since it was
# queued, +K for the others); red on <workflow>[, ...] (MAIN_STREAKS over its head's runs); gating
# (a gate command runs); else the status word. CI is read only for a <dir> given (a branch off the
# default one), at <head>, else HEAD. The ledger lags a run by up to one schedules-sync pass (10m).
activity_line() {
  local status="$1" ojob="$2" doing="$3" d="$4" br="$5" head="$6" now="$7" runs ci=""
  [ "$status" = parked ] && { echo parked; return; }
  [ "$ojob" = test ] && { echo testing; return; }
  if [ "$status" = busy ] && [[ "$doing" =~ ^(Edit|Write|MultiEdit|NotebookEdit)(:|$) ]]; then echo editing; return; fi
  if [ "$d" != - ]; then
    [ "$head" != - ] || head="$(git -C "$d" rev-parse -q --verify HEAD 2>/dev/null || echo -)"
    if [ "$head" != - ] && runs="$(branch_runs "$d" "$br")"; then
      ci="$(jq -r --arg h "$head" --argjson now "$now" '
        map(select(.headSha == $h))
        | (map(select(.status != "completed")) | sort_by(.createdAt)) as $open
        | if ($open | length) > 0 then
            "waiting on \($open[0].workflowName) \([($now - ($open[0].createdAt | fromdateiso8601)) / 60 | floor, 0] | max)m"
            + (if ($open | length) > 1 then " +\(($open | length) - 1)" else "" end)
          else ['"$MAIN_STREAKS"' | .workflow] | if length > 0 then "red on \(join(", "))" else empty end
          end' <<<"$runs" 2>/dev/null)"
    fi
  fi
  if [ -n "$ci" ]; then echo "$ci"; return; fi
  [ "$ojob" = gate ] && { echo gating; return; }
  echo "${status:--}"
}

# parked_lines <agent-panel lines> -> one agent-panel-shaped line, status parked, per park
# ledger whose tmux session (a session:window ledger: whose window) has no live claude again, so a
# parked session's git, PR and main facts are read like any other's. A ledger beside a live claude
# is stale: the live row wins. A window ledger is one claude of a shared session (hub/dotfiles),
# whose other windows stay live.
parked_lines() {
  local f live
  live="$(jq -r '.target' <<<"$1" 2>/dev/null)"
  for f in "$PARKED_DIR"/*; do
    [ -f "$f" ] || continue
    jq -cn --rawfile l "$f" --arg live "$live" --arg key "${f##*/}" '
      ([$l | split("\n")[] | capture("^(?<key>[a-z_]+)=(?<value>.*)$")] | from_entries) as $p
      | ($p.target // "\($p.server)/\($p.session)") as $t
      | (if ($key | contains(":")) then [$t, ($live | split("\n"))]
         else [($t | sub(":[^:]*$"; "")), ($live | split("\n") | map(sub(":[^:]*$"; "")))] end) as [$me, $all]
      | select($all | index($me) | not)
      | {target: $t, pane: "\($p.server)/\($p.pane)", status: "parked", plan_mode: false,
         session_id: $p.session_id, cwd: $p.cwd, idle_since: ($p.parked | tonumber? // 0),
         context_tokens: 0, plan_file: ""}' 2>/dev/null
  done
}

# item_of <qitems> <session id> <server:tmux session> <claudes in that tmux session> <claude start epoch|->
# -> the queue item this session worked: own:<slug>[,<slug>...] while any runs here (every one,
# so a merged side item never hides the one still open), moved:<slug> moved on
# (<where>) once it is done, requeued or running elsewhere, or -. sessions: (Claude session ids)
# is the match for an item that records them. session: (the tmux session) counts only for one that
# records none, when one claude lives there, and a done item by it only when it finished after this
# claude started: worktree names are recycled (fleet-dispatch claude_gone reads the same rule).
# An item still running or waiting here wins over one that moved on; an item that recorded no
# session: (added by hand, `add --running`) is here when it names this Claude session, and
# here:<slug> is one waiting here, which decides no bucket but names the item on the row.
# review:<slug> is one this session parked in review/: its open PR is the item's, and
# fleet-dispatch's reap owns it once the session ends (own_parked_pr gives a red one a fix-ci session and a green one a lander),
# so the session is finished. 2026-11-11 such sessions read "PR open" as unfinished, wind-down
# refused, and the reap, which waits for the session to end, never took over.
item_of() {
  awk -F'\t' -v sid="$2" -v me="$3" -v solo="$4" -v start="$5" '
    function mine_sid(list,   n, a, i) { n = split(list, a, " "); for (i = 1; i <= n; i++) if (a[i] == sid) return 1; return 0 }
    {
      bysid = (sid != "" && mine_sid($3)); bysess = (solo == 1 && $2 == me && $3 == "-")
      if (!bysid && !bysess) next
      if (($1 == "running" || $1 == "waiting" || $1 == "review") && ($2 == me || ($2 == "-" && bysid))) {
        if ($1 == "running") own = own (own == "" ? "" : ",") $4
        else if ($1 == "review") { if (rev == "") rev = $4 " pr " ($6 == "" ? "-" : $6); next }
        if (hereslug == "") hereslug = $4
        here = 1; next
      }
      if ($1 == "done" && !bysid && !(start ~ /^[0-9]+$/ && $5 + 0 >= start + 0)) next
      if (moved != "") next
      where = ($1 == "done" || $1 == "queued") ? $1 : $1 " in " $2
      moved = $4 " moved on (" where ")"
    }
    END {
      if (own != "") print "own:" own
      else if (here) print "here:" hereslug
      else if (rev != "") print "review:" rev
      else if (moved != "") print "moved:" moved
      else print "-"
    }' <<<"$1"
}

# handoff_of <qall> <item_of's answer> -> "<ask id>\t<doc>" when the item is of a doc+ask kind
# (kinds.json `exit`, by the item's `type`, which agent-queue sets from `notes row parse`) and has handed its work
# over: its `report` doc exists and its `ask` is filed. That ask is the deliverable, so it is not the
# session's open question, and the item has moved on. Else nothing.
handoff_of() {
  local slug="${2#*:}" ask doc
  case "$2" in own:* | moved:*) ;; *) return 0 ;; esac
  [ -r "$KINDS" ] || return 0
  IFS=$'\t' read -r ask doc < <(jq -r --arg s "${slug%% *}" --slurpfile k "$KINDS" '
    select(.slug == $s)
    | (.type // "") as $t
    | select($t != "" and $k[0][$t].exit == "doc+ask" and (.report // "") != "" and (.ask // "") != "")
    | [.ask, .report] | @tsv' <<<"$1" 2>/dev/null)
  [ -n "${ask:-}" ] && [ -f "${doc/#\~/$HOME}" ] && compgen -G "$ASK_ROOT/*/$ask.md" >/dev/null && printf '%s\t%s\n' "$ask" "$doc"
  return 0
}

# remote_panel_lines -> each fleet worker's agent-panel lines (fleet-hosts.sh, the home-config
# roster), each with the worker in `host` and its target as <host>@<server>/<session>:<window>. That
# names no tmux server here, so a nudge or a set-option aimed at the row can never land on a local
# session that shares its name, and item_of joins it to its queue item by session id alone. A worker
# that does not answer (ssh exit 255), or whose agent-panel fails, adds no rows and is one
# {host, why} line in $CACHE/silent, which state.json carries as `silent` so the Sessions table says its rows are missing (dashboards.md
# rule 6). It is not $CACHE/unreadable: a laptop asleep is not this machine's sources blinking. It
# runs beside collect's row loop, so a gap goes straight to $CACHE/blind as "+" (keep_blind), never
# through blind_row, which names the row the loop is on.
remote_panel_lines() {
  local name out rc why
  fleet_hosts >/dev/null
  while IFS= read -r name; do
    # Exit 3 is a read with a gap (agent-panel README): keep its rows, and name it so tick does
    # not log the sessions it missed as gone.
    rc=0; out="$(fleet_host_run "$name" agent-panel list --json 2>/dev/null)" || rc=$?
    [ "$rc" -eq 3 ] && { unreadable "agent-panel@$name"; echo + >> "$CACHE/blind"; }
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 3 ]; then
      # ssh exits 255 when the host does not answer; any other code is agent-panel's own failure.
      why="did not answer"; [ "$rc" -eq 255 ] || why="ran agent-panel, which exited $rc"
      jq -cn --arg h "$name" --arg w "$why" '{host: $h, why: $w}' >> "$CACHE/silent"
      continue
    fi
    jq -c --arg h "$name" 'select(type == "object") | . + {host: $h, target: ($h + "@" + (.target // ""))}' <<<"$out" 2>/dev/null
  done < <(fleet_hosts | jq -r .name)
  return 0
}

collect() {
  local now heavy line
  # The one `project` every row carries is the name the hooks give its directory; a pass that cannot
  # load it fails here, not as a row with no project.
  # shellcheck source=/dev/null
  . "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../../.config/shared-hooks/project-name.sh" || return 1
  now="$(date +%s)"
  heavy="$(heavy_panes)"
  local panel items qjson qall qitems off qheld
  off="$(off_default_checkouts)"
  # A week of done items too: a session whose item finished, was requeued or moved to another
  # session has to see that, or it reads as never started (ar-343).
  qall="$(agent-queue list --json --state all --since "$(date -d "$FLEET_ITEM_DAYS days ago" +%F)" 2>/dev/null)"
  qjson="$(jq -c 'select(.state != "done")' <<<"$qall" 2>/dev/null)"
  # The asks a live item holds through its ask:<id>[=<option>] tag. That item carries the ask on,
  # so it is no longer an open question of the session that posted it, whatever state the item
  # reaches before the answer (ar-764).
  qheld="$(jq -r '(.tags // "") | splits("\\s+")
    | select(startswith("ask:")) | .[4:] | sub("=.*"; "")' <<<"$qjson" 2>/dev/null)"
  # "<state>\t<session>\t<sessions>\t<slug>\t<finished epoch>" per item, for item_of.
  qitems="$(jq -r '[.state, (.session // "" | if . == "" then "-" else . end),
      (.sessions // "" | if . == "" then "-" else . end), .slug,
      (.finished // "" | fromdateiso8601? // 0),
      (.pr // "" | tostring | sub(".*#"; "") | if . == "" then "-" else . end)] | map(tostring) | @tsv' <<<"$qall" 2>/dev/null)"
  # "<server>/<tmux session>\t<project>: <slug>" for each started queue item.
  items="$(jq -r <<<"$qjson" '
    select(.state != "queued" and ((.session // "") | contains(":")))
    | (.session | sub(":"; "/")) + "\t\(.project): \(.slug[:60])"' 2>/dev/null)"
  # A pass that could not read a source says so in $CACHE/unreadable, and marks the rows it feeds
  # in $CACHE/blind (keep_blind), so tick never logs a blink (a session "gone", a PR "-") as a change.
  # The local agent-panel feeds every row, parked ones included (parked_lines reads it): a failure
  # that printed nothing is "*"; exit 3 with rows is a gap, "+", like a remote one.
  # Exit 3 (a read with a gap) still prints the rows it read; they are kept, and the pass is named.
  # AGENT_PANEL_CODEX: a Codex run in a pane is a row too (busy, its thread id as session_id, so
  # item_of joins it by sessions: like a Claude). The env form, not --codex: a binary not yet
  # rebuilt ignores it instead of refusing the flag and reading as every session gone.
  local prc=0
  panel="$(AGENT_PANEL_CODEX=1 "${AGENT_PANEL:-agent-panel}" list --json 2>/dev/null)" || prc=$?
  if [ "$prc" -ne 0 ]; then
    unreadable agent-panel
    if [ "$prc" -eq 3 ] && [ -n "$panel" ]; then echo + >> "$CACHE/blind"; else echo '*' >> "$CACHE/blind"; fi
  fi
  local PENDING_ASKS
  PENDING_ASKS="$(pending_asks)"
  { [ -n "$panel" ] && printf '%s\n' "$panel"; parked_lines "$panel"; remote_panel_lines; } | while IFS= read -r line; do
    [ -n "$line" ] || continue
    # close --self reads one row: the others' git, gh and transcript reads cost a minute (54 rows).
    [ -z "${CLOSE_SELF:-}" ] || [[ "$line" == *"$CLOSE_SELF"* ]] || continue
    rm -f "$CACHE/blind_row"
    local target pane status plan sid cwd since ctx planf tsess idle asks ownask hv bucket fact edited \
          pdone ptotal pnext phases fin started age oid askids blk transcript prs \
          work jobs human parked compactions topic doing said gate test ojob acct pq names landed live cpid host
    IFS=$'\t' read -r target pane status plan sid cwd since ctx planf started cpid host < <(jq -r '[.target, (.pane | sub(".*/"; "")), .status,
      (if .plan_mode then 1 else 0 end), .session_id, .cwd, .idle_since, .context_tokens,
      (.plan_file | if . == "" then "-" else . end), (.started_at // "-"), (.pid // 0), (.host // "-")] | @tsv' <<<"$line")
    # A worker's session: its cwd, pid, plan file and panes are paths and ids on that machine, so
    # nothing here reads them (a worktree of the same name here is another session's). Its row says
    # what its agent-panel says; its PR is its queue item's.
    [ "$host" = - ] || planf=-
    edited="$(jq -r '.edited_files // [] | .[]' <<<"$line")"
    # read splits on tabs and collapses an empty field, so every text field here is - when empty.
    IFS=$'\t' read -r transcript work jobs human parked compactions topic doing said gate test ojob acct < <(jq -r '
      def text: (. // "") | if . == "" then "-" else gsub("[\t\n]"; " ") end;
      [(.transcript | text), (.time_use.work_min // 0), (.time_use.jobs_min // 0), (.time_use.human_min // 0),
       (.time_use.parked_min // 0), (.compactions // 0), (.summary | text), (.doing | text), (.said | text),
       (.time_use.gate_min // 0), (.time_use.test_min // 0), (.open_job | text), (.account | text)]
      | map(tostring) | join("\t")' <<<"$line")
    # plan_mode alone is only a mode: an idle session in it with no plan written is not waiting
    # on anyone (2026-11-06 hub/dotfiles:1 read NEEDS for an unsent draft). An approval is open
    # only while the dialog is: status waiting with ExitPlanMode as the last tool call. `doing`
    # outlives the dialog (a rejected plan leaves it), so it counts only together with waiting.
    # The mode itself still keeps the session open (the close verdict's in_plan_mode, ask 4RSfMg).
    inplan="$plan"
    if [ "$plan" = 1 ] && { [ "$status" != waiting ] || [[ "$doing" != ExitPlanMode* ]]; }; then plan=0; fi
    # A gate or test running in the worktree is a wait whatever the transcript's open job says.
    live=""
    if [ "$host" = - ] && [ "$status" = shell ] && { [ "$ojob" = jobs ] || [ "$ojob" = none ]; }; then
      live="$(live_wait "$cwd" "$cpid")"; ojob="${live:-$ojob}"
    fi
    # A shell waiting on itself is hung whatever the transcript's open job says: its command line may
    # read as a gate. A live gate or test process found above outranks it.
    if [ "$host" = - ] && [ "$status" = shell ] && [ "$ojob" != agent ] && [ -z "$live" ]; then
      live="$(self_wait "$cpid")"; ojob="${live:-$ojob}"
    fi
    prs="$(session_prs "$transcript")"
    landed="$(jq -r 'if any(.state == "MERGED") and all(.state != null and .state != "OPEN")
      then map(select(.state == "MERGED") | "#\(.number)") | join(",") else "-" end' <<<"$prs")"
    tsess="${target#*/}"; tsess="${tsess%:*}"
    idle=$(( (now - since) / 60 ))
    age=-; [[ "$started" =~ ^[0-9]+$ ]] && age=$(( (now - started) / 60 ))
    # Every ask this session filed and nobody answered (ownask), the ones a queue item carries on
    # included: the session may close (bucket), and the close verdict says whether its window must
    # stay open for the answer (close rule 8). askids are the ones still its own to wait on.
    local ownids; ownids="$(asks_for "$sid")"
    ownask=0; [ -n "$ownids" ] && ownask="$(wc -l <<<"$ownids")"; ownask=$((ownask + 0))
    askids="$(grep . <<<"$ownids" | { if [ -n "$qheld" ]; then grep -vxF "$qheld"; else cat; fi; } | paste -sd, -)"
    asks=0; [ -n "$askids" ] && asks="$(tr ',' '\n' <<<"$askids" | wc -l)"
    hv=0; [ "$host" = - ] && [ -n "$pane" ] && grep -qxF "${target%%/*}/$pane" <<<"$heavy" && hv=1
    local solo item
    solo="$(jq -r --arg k "${target%:*}" 'select((.target | sub(":[^:]*$"; "")) == $k) | .target' <<<"$panel" 2>/dev/null | wc -l)"
    item="$(item_of "$qitems" "$sid" "${target%%/*}:$tsess" "$solo" "$started")"
    local hask hdoc
    IFS=$'\t' read -r hask hdoc < <(handoff_of "$qall" "$item")
    if [ -n "${hask:-}" ]; then
      askids="$(tr ',' '\n' <<<"$askids" | grep -vxF "$hask" | paste -sd, -)"
      asks=0; [ -n "$askids" ] && asks="$(tr ',' '\n' <<<"$askids" | wc -l)"
      item="moved:${item#*:}"; item="${item%% *} handed off its doc ${hdoc##*/} and ask $hask"
    fi
    # The row's queue item (item_of's one join), with the board row it came from and its origin.
    local islug=- irel=- irow=- iorigin=-
    case "$item" in
      own:* | moved:* | here:* | review:*)
        irel="${item%%:*}"; islug="${item#*:}"; islug="${islug%% *}"; islug="${islug%%,*}"
        IFS=$'\t' read -r irow iorigin < <(jq -r --arg s "$islug" 'select(.slug == $s)
          | [(.row // (.from // "" | if startswith("board:") then sub("^board:"; "") else "" end)
              | if . == "" then "-" else . end), (.origin // "-")] | @tsv' <<<"$qall" 2>/dev/null | head -1)
        irow="${irow:--}"; iorigin="${iorigin:--}" ;;
    esac
    if [ "$host" = - ]; then read -r g dirty ahead pr state ci inpr branch behind conflicts fork oid names < <(git_facts "$cwd" "$edited")
    else read -r g dirty ahead pr state ci inpr branch behind conflicts fork oid names <<<"0 0 0 - - - 1 - - - - - -"; fi
    # What a deployed checkout off its default branch holds is one fault, its CHECKOUT row, and no
    # session's work: 2026-11-06 it read 9 files ahead on all 16 sessions there, each one STALLED.
    if [ "$g" = 1 ] && in_checkout "$cwd" "$off"; then ahead=0 pr=- state=- ci=- oid=- inpr=1; fi
    # A finished branch PR this session did not make is another session's (pr_made_here): drop it,
    # and the commits it holds with it. An open one stays: it is unlanded work in this tree either way.
    if [ "$g" = 1 ] && { [ "$state" = MERGED ] || [ "$state" = CLOSED ]; } && [ -s "$transcript" ] \
       && ! pr_made_here "$cwd" "$pr" "$branch" "$prs" "$transcript" "$planf" \
              "$(jq -r --arg c "$cwd" --arg s "$sid" 'select(.cwd == $c and .session_id != $s and (.host // "-") == "-")
                  | .plan_file // empty' <<<"$panel" 2>/dev/null)"; then
      [ "$inpr" = 1 ] && ahead=0
      pr=- state=- ci=- oid=-
    fi
    # No PR for this branch here: an open PR of its own in another repo is the row's PR. Its
    # conflict is not this clone's to measure, so it is unknown (-).
    local xr=- xpr xci xoid
    if [ "$g" = 1 ] && [ "$pr" = - ]; then
      IFS=$'\t' read -r xr xpr xci xoid < <(sibling_pr "$cwd" "$prs")
      if [ -n "${xpr:-}" ]; then pr="$xpr" state=OPEN ci="$xci" oid="$xoid" conflicts=-; else xr=-; fi
    fi
    IFS=$'\t' read -r pdone ptotal pnext < <(plan_phases "$planf")
    if [ "$planf" = - ] || [ ! -f "$planf" ]; then phases=-
    elif [ "$ptotal" = - ]; then phases=none
    else phases="$pdone/$ptotal"; fi
    # The plan's unchecked phases are queue items of their own: its next phase is not this session's.
    # An item that records `phases:` holds only those checklist numbers, so later phases queued
    # while this session works the next one do not make it queued (ar-267: agent-2 read DONE
    # mid-phase 3 because phases 4 and on were items); one with no `phases:` cannot say, and holds
    # all. The plan is queued only when every open phase is held; else its first free one is next.
    local dsp=- n=0 e=0
    dsp="$(awk -F'\t' -v k="${target%%/*}/$tsess" '$1 == k { print $2; exit }' <<<"$items")"
    pq="$pnext"
    if [ "$phases" != - ] && [ "$phases" != none ] && [ "$pdone" -lt "$ptotal" ]; then
      local qd
      qd="$(jq -rs --arg p "$planf" --arg own "${dsp#*: }" \
              --argjson open "$(plan_phase_list "$planf" | jq -c '[to_entries[] | select(.value.state == "open") | {n: (.key + 1 | tostring), name: .value.name}]')" \
              "$PLAN_ITEMS_JQ"' [.[] | select(.slug != $own and names_plan($p))
                 | {slug, ph: (.phases // "" | tostring | split(" ") | map(select(. != "")))}] as $it
              | def holds($n): (.ph | length) == 0 or (.ph | index($n)) != null;
              [$it[] | select(. as $i | any($open[]; .n as $n | $i | holds($n)))] as $holders
              | [$open[] | select(.n as $n | any($it[]; holds($n)) | not)] as $free
              | if ($holders | length) == 0 then empty
                elif ($free | length) == 0 then "queued:" + ($holders | map(.slug) | join(","))
                else $free[0].name end' <<<"$qjson" 2>/dev/null)"
      [ -z "$qd" ] || pq="$qd"
    fi
    # mh is this repo's main health for the row's main_red (RED, OK, UNKNOWN; - outside git).
    local red=- mh=- mwfs msuspects
    if [ "$g" = 1 ]; then
      IFS=$'\t' read -r mh mwfs _ msuspects < <(main_health "$cwd")
      if [ "$state" = MERGED ] && [ "$mh" = RED ] && grep -qxF "$pr" <<<"$(tr ' ' '\n' <<<"$msuspects")"; then
        red="$mwfs"
        printf '%s\t%s\n' "$(repo_slug "$cwd")" "$sid" >> "$CACHE/owners"
      fi
    fi
    [ "$host" != - ] || printf '%s\t%s\n' "${cwd##*/}" "$sid" >> "$CACHE/cwds"   # SHARED rows' owners, by worktree
    # ACTIVITY: CI is read on a branch off the default one, at its PR head, else at HEAD.
    local act act_dir=-
    if [ "$g" = 1 ] && [ "$branch" != - ] && [ "origin/$branch" != "$(default_base "$cwd")" ]; then act_dir="$cwd"; fi
    act="$(activity_line "${status:--}" "$ojob" "$doing" "$act_dir" "$branch" "$oid" "$now")"
    bucket="$(session_bucket "$status" "$plan" "$asks" "$hv" "$idle" "$g" "$dirty" "$ahead" \
              "$pr" "$state" "$ci" "$inpr" "$red" "$phases" "$pq" "$conflicts" "$ojob" "$names" "$landed" "$item")"
    fin=0; session_finished "$status" "$plan" "$asks" "$hv" "$idle" "$g" "$dirty" "$ahead" \
             "$pr" "$state" "$ci" "$inpr" "$red" "$phases" "$pq" "$conflicts" "$ojob" "$names" "$landed" "$item" && fin=1
    blk="$(work_blockers "$askids" "$status" "$plan" "$asks" "$hv" "$idle" "$g" "$dirty" "$ahead" \
             "$pr" "$state" "$ci" "$inpr" "$red" "$phases" "$pq" "$conflicts" "$ojob" "$names" "$landed" "$item")"
    local elsewhere=""
    [ "$host" != - ] || elsewhere="$(edited_work_blockers "$cwd" "$edited" "$sid")"
    if [ -n "$elsewhere" ]; then
      fin=0
      blk="${blk:+$blk; }${elsewhere#* }"
      case "${bucket%% *}" in
        DONE | LANDED | CHAT) bucket="$elsewhere" ;;
      esac
    fi
    # A sibling repo's PR is named the way GitHub cross-references it, so the nudge says where it is.
    [ "$xr" = - ] || { bucket="${bucket//PR #$pr/PR $xr#$pr}"; blk="${blk//PR #$pr/PR $xr#$pr}"; }
    # An open PR's fact carries its head commit, so a push that is still red is a new fact
    # and gets a new nudge, while the same commit is never nudged twice. A conflict's fact
    # carries the merge base instead: a push that leaves it unresolved is the same fact, and
    # only a branch that took the base in (was clean) and conflicts again is a new one.
    # Carrying on is activity, not a fact: a session flipping between busy and idle must never page twice.
    fact="${bucket%, carrying on}"; [ "$pr" != - ] && fact="$fact @$branch"
    if [ "$bucket" = "STALLED PR #$pr conflicts with the default branch" ]; then
      fact="$fact base ${fork:0:12}"
    elif [ "$state" = OPEN ] && [ "$oid" != - ]; then fact="$fact@${oid:0:12}"; fi
    nudged "$sid" "$fact" && n=1; escalated "$sid" "$fact" && e=1
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t-\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${bucket%% *}" "$target" "$sid" \
      "$cwd" "$branch" "$pr" "$idle" "$ctx" "$planf" "$n" "${bucket#* }" "${pane:--}" "$e" "${dsp:--}" \
      "$pdone" "$ptotal" "$pnext" "$fin" "$behind" "$conflicts" "$state" "$ci" "$dirty" "$ahead" \
      "$(labels_of "$sid")" "${status:--}" "$age" "$asks" "$fact" "${blk:--}" \
      "$prs" "$(prs_cell <<<"$prs")" "$work" "$jobs" "$human" "$parked" "$compactions" "$topic" "$doing" "$said" "$gate" "$test" "$mh" \
      "$(plan_phase_list "$planf")" "${acct:--}" "$islug" "$irel" "$irow" "$iorigin" "$(resolve_project_name "$cwd")" "$host" "${act:--}" "$ownask" "$inplan"
    [ ! -f "$CACHE/blind_row" ] || echo "$sid" >> "$CACHE/blind"
  done
  [ -z "${CLOSE_SELF:-}" ] || return 0
  main_rows
  checkout_rows "$off"
  shared_rows
}

# One NIGHTLY row per red repo seen this pass. Its ledger id is main-<repo slug>, so the shepherd
# escalates a nightly red once per fact; owners are the live sessions whose merge is a suspect, nudged
# on their own STALLED rows. Its nudged and escalated cells read that ledger, as every row's do.
main_rows() {
  local f slug st wfs sha prs repo sid reason owners nu e
  for f in "$CACHE"/main_*; do
    [ -f "$f" ] || continue
    IFS=$'\t' read -r st wfs sha prs repo < "$f"
    slug="${f##*/main_}"; sid="main-$slug"
    case "$st" in
      RED) reason="$repo red: $wfs" ;;
      UNKNOWN) reason="$repo main CI unreadable (the run ledger has no fresh sync of it)" ;;
      *) continue ;;
    esac
    owners="$(awk -F'\t' -v s="$slug" '$1 == s { print $2 }' "$CACHE/owners" 2>/dev/null | paste -sd, -)"
    nu=0; nudged "$sid" "NIGHTLY $reason" && nu=1; e=0; escalated "$sid" "NIGHTLY $reason" && e=1
    printf 'NIGHTLY\t%s\t%s\t-\t-\t-\t0\t0\t-\t%s\t%s\t-\t%s\t%s\t-\t-\t-\t-\t0\t-\t-\t-\t-\t-\t-\t-\t-\t-\t0\tNIGHTLY %s\t-\t[]\t-\t0\t0\t0\t0\t0\t-\t-\t-\t0\t0\n' "$repo" "$sid" "$nu" "$reason" "$e" "${owners:--}" "$reason"
  done
}

# checkout_rows <checkouts, one per line>: one CHECKOUT row each. The reflog says where to and when,
# the post-checkout hook's record for this HEAD says who. The row is born escalated: Sentinel's
# main-checkout-branch watch is the one page, and it trips from an inline probe that needs nothing
# from the tree this fault may have replaced. Its fact is the HEAD, so a further move is a new one.
checkout_rows() {
  local d name head short base at gs where actor reason
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    name="${d##*/}" head="$(git -C "$d" rev-parse HEAD)" base="$(default_base "$d")"
    short="${head:0:12}" at= gs=
    IFS=$'\t' read -r at gs < <(git -C "$d" log -g -1 --date=unix --format='%gd%x09%gs' --grep-reflog='^checkout: moving' 2>/dev/null)
    where="$(git -C "$d" symbolic-ref -q --short HEAD)"
    [ -n "$where" ] || where="${gs##* to }"
    at="${at//[^0-9]/}"
    actor="$(awk -F'\t' -v h="$head" '$3 == h { a = $4 } END { print a }' "$LEDGER/checkout-moves.tsv" 2>/dev/null)"
    reason="$name checkout on ${where:-$short} since $(date -d "@$at" '+%a %H:%M' 2>/dev/null || echo unknown), moved by ${actor:-an unrecorded actor}: stowed scripts run it, git -C $d switch ${base#origin/}"
    printf 'CHECKOUT\t%s\tcheckout-%s\t-\t-\t-\t0\t0\t-\t0\t%s\t-\t1\t-\t-\t-\t-\t-\t0\t-\t-\t-\t-\t-\t-\t-\t-\t-\t0\tCHECKOUT %s @%s\t-\t[]\t-\t0\t0\t0\t0\t0\t-\t-\t-\t0\t0\n' "$name" "$name" "$reason" "$name" "$short"
  done <<<"$1"
}

# One SHARED row per test that failed on FLEET_SHARED_RED_BRANCHES branches (a detached checkout
# counts by its worktree) within the last FLEET_SHARED_RED_MIN minutes of $TEST_FAILURES and
# $POOL_FAILURES, a branch red on both counted once. No session
# owns it: fleet-shepherd check files one queue item that does (shared_sample), the pass tells
# the owners once (nudged), and only a red no item could be filed for escalates (ar-185, ar-623).
# Its fact is the episode's first failure, an episode ending at a quiet gap longer than the window, so one more branch is not a new page and the
# same test red again tomorrow is. Owners are the live sessions in the failing worktrees.
shared_rows() {
  local ledgers=() f test start n keys owners sid reason fact nu e win="${FLEET_SHARED_RED_MIN}m"
  for f in "$TEST_FAILURES" "$POOL_FAILURES"; do [ -f "$f" ] && ledgers+=("$f"); done
  [ "${#ledgers[@]}" -gt 0 ] && [ -n "$(find "${ledgers[@]}" -mmin -"$FLEET_SHARED_RED_MIN" 2>/dev/null)" ] || return 0   # nothing new in the window
  [ $(( FLEET_SHARED_RED_MIN % 60 )) = 0 ] && win="$(( FLEET_SHARED_RED_MIN / 60 ))h"
  : >> "$CACHE/cwds"
  sort -t$'\t' -k1,1n "${ledgers[@]}" | awk -F'\t' -v OFS='\t' -v now="$(date +%s)" -v cw="$CACHE/cwds" \
      -v w="$(( FLEET_SHARED_RED_MIN * 60 ))" -v min="$FLEET_SHARED_RED_BRANCHES" '
    FILENAME == cw { sids[$1] = sids[$1] " " $2; next }
    $1 !~ /^[0-9]+$/ || $1 > now || $4 == "" { next }
    {
      t = $4; k = ($3 == "-" || $3 == "") ? $2 : $3
      if (!(t in last) || $1 - last[t] > w) start[t] = $1
      last[t] = $1
      if ($1 < now - w) next
      if (!((t, k) in seen)) { seen[t, k] = 1; n[t]++; keys[t] = keys[t] (n[t] > 1 ? ", " : "") k }
      if (!((t, $2) in wt)) {
        wt[t, $2] = 1; m = split(sids[$2], s, " ")
        for (i = 1; i <= m; i++) if (!((t, s[i]) in own)) { own[t, s[i]] = 1; o[t] = o[t] (o[t] == "" ? "" : ",") s[i] }
      }
    }
    END { for (t in n) if (n[t] >= min) print t, start[t], n[t], keys[t], (o[t] == "" ? "-" : o[t]) }' "$CACHE/cwds" - | sort |
  while IFS=$'\t' read -r test start n keys owners; do
    sid="shared-$(printf '%s' "$test" | tr -c 'A-Za-z0-9' _)"
    reason="$test red on $n branches in $win: $keys"
    fact="SHARED $test @$start"
    nu=0; nudged "$sid" "$fact" && nu=1; e=0; escalated "$sid" "$fact" && e=1
    printf 'SHARED\t%s\t%s\t-\t-\t-\t0\t0\t-\t%s\t%s\t-\t%s\t%s\t-\t-\t-\t-\t0\t-\t-\t-\t-\t-\t-\t-\t-\t-\t0\t%s\t-\t[]\t-\t0\t0\t0\t0\t0\t-\t-\t-\t0\t0\n' "$test" "$sid" "$nu" "$reason" "$e" "$owners" "$fact"
  done
}

# --- tick: the stage cells and their changes -------------------------------------------------------------
# eta_cells -> "sid <TAB> eta <TAB> epoch" for each session fleet-bench has an estimate for: the expected
# finish (HH:MM today, else "Thu HH:MM") and its basis, short: "<word>-median(N)" as its first
# letter and N ("21:30 s3" is the session's own median over 3 phases, "p16" the project's), its
# calibration suffix dropped, anything else as it is. fleet-bench reads only its own files, so one call per tick is cheap; how
# it estimates is its business (the fleet-bench skill), the board only shows the answer.
eta_cells() {
  "${FLEET_BENCH:-fleet-bench}" eta --json 2>/dev/null | jq -r --arg today "$(date +%F)" '
    select(type == "object" and .eta_epoch != null and (.finished | not))
    | .eta_epoch as $e
    | ($e | strflocaltime(if ($e | strflocaltime("%F")) == $today then "%H:%M" else "%a %H:%M" end)) as $at
    | [.session_id, ([$at, (.basis // empty | sub("^(?<k>[a-z])[a-z]*-median\\((?<n>[0-9]+)\\)( .*)?$"; "\(.k)\(.n)"))] | join(" ")), $e] | @tsv' 2>/dev/null
  return 0 # no bench, or a failed read, is no estimate: the column reads -
}

# board_cells [eta file]: collect's rows on stdin -> one line per session, in bucket order:
#   sid target sync conflicts tree pr ci plan quality stage labels idle age reason eta prs work wait task now project
# Columns 3-11 are the stages a transition is read from; idle, age and eta move without a stage
# changing, and reason rides along to explain a stage change. Newer cells come last so a
# watch.state written before them still lines up. now is what WHY shows: on a WORKING row, the
# session's last action (its reason only says busy or shell), else the reason. NIGHTLY, CHECKOUT and SHARED
# rows are rendered separately.
board_cells() {
  awk -F'\t' -v OFS='\t' -v etaf="${1:-}" -v order="$BUCKET_ORDER" '
    # minutes -> 45m, 3h12m, 2d4h; "-" when the session start is unknown
    function dur(m) {
      if (m !~ /^[0-9]+$/) return "-"
      if (m < 60) return m "m"
      if (m < 1440) return int(m / 60) "h" (m % 60) "m"
      return int(m / 1440) "d" int((m % 1440) / 60) "h"
    }
    # minutes -> 45m or 3h, rounded: a share of an age, not a clock. "-" when none or unknown.
    function hrs(m) {
      if (m !~ /^[0-9]+$/ || m == 0) return "-"
      return m < 60 ? m "m" : int(m / 60 + 0.5) "h"
    }
    # the largest wait that is not work, named; a tie goes to the first of gate, test, jobs, you, parked
    function wait_cell(g, t, j, h, p,    n, i, v, top, name) {
      n = split(g " " t " " j " " h " " p, v, " ")
      for (i = 1; i <= n; i++) if (v[i] + 0 > top + 0) { top = v[i]; name = i }
      return name ? wait_names[name] " " hrs(top) : "-"
    }
    BEGIN {
      n = split(order, o, " "); for (i = 1; i <= n; i++) rank[o[i]] = i
      split("gate test jobs you parked", wait_names, " ")
      if (etaf != "") while ((getline l < etaf) > 0) { split(l, kv, "\t"); eta[kv[1]] = kv[2] }
    }
    $1 == "NIGHTLY" || $1 == "CHECKOUT" || $1 == "SHARED" { next }
    {
      t = $2; sub(/^[^\/]*\//, "", t)
      git = ($5 != "-")
      sync = !git || $20 == "-" ? "-" : ($20 == 0 ? "current" : $20 " behind")
      conf = !git ? "-" : ($21 == "yes" ? "CONFLICT" : $21)
      tree = !git ? "-" : ($24 > 0 ? $24 " dirty" : ($25 > 0 ? $25 " ahead" : "clean"))
      pr = $6 == "-" ? "-" : "#" $6 " " tolower($22)
      ci = $23 == "-" ? "-" : tolower($23)
      plan = $16 == "-" ? "-" : $16 "/" $17
      q = ""; l = ""
      m = split($26 == "-" ? "" : $26, ls, ",")
      for (i = 1; i <= m; i++)
        if (ls[i] ~ /^quality:/) q = q (q == "" ? "" : ",") substr(ls[i], 9)
        else l = l (l == "" ? "" : ",") ls[i]
      now = $40; sub(/^Bash: /, "", now)
      print (rank[$1] ? rank[$1] : 9), $3, t, sync, conf, tree, pr, ci, plan,
            (q == "" ? "-" : q), $1, (l == "" ? "-" : l), $7 "m", dur($28), $11,
            ($3 in eta ? eta[$3] : "-"), ($33 == "" ? "-" : $33), hrs($34), wait_cell($42 + 0, $43 + 0, $35 + 0, $36 + 0, $37 + 0),
            ($39 == "" ? "-" : $39), ($1 == "WORKING" && now != "-" && now != "" ? now : $11), ($51 == "" ? "-" : $51)
    }' | sort -t$'\t' -k1,1n -k3,3 | cut -f2-
}

# transitions <previous cells file> <current cells file> -> one line per session that
# appeared, left, or changed a stage cell: "target  ci pending -> fail, stage ... (reason)".
transitions() {
  awk -F'\t' '
    BEGIN { split("- - sync conflicts tree pr ci plan quality stage labels", name, " ") }
    NR == FNR { prev[$1] = $0; next }
    {
      seen[$1] = 1
      if (!($1 in prev)) { print $2 "  new: " $10 " (" $14 ")"; print $2 "  project - -> " $21; next }
      split(prev[$1], p, "\t"); out = ""
      for (i = 3; i <= 11; i++)
        if (p[i] != $i) out = out (out == "" ? "" : ", ") name[i] " " p[i] " -> " $i
      # The project is the last cell, so a watch.state written before it has none: "-" is its old value.
      if (p[21] != $21) out = out (out == "" ? "" : ", ") "project " (p[21] == "" ? "-" : p[21]) " -> " $21
      if (out != "") print $2 "  " out (p[10] != $10 ? " (" $14 ")" : "")
    }
    END { for (s in prev) if (!(s in seen)) { split(prev[s], p, "\t"); print p[2] "  gone" } }' "$1" "$2"
}

# keep_blind <previous cells file> <current cells file> <blind file> -> the current cells with each
# row a failed source fed put back to its previous cells, so tick logs no blink for it and the next
# good read is compared with the last good one. <blind file> holds session ids (a row's per-row
# source failed: the PR store, the run ledger, gh api jobs, gh pr view), "+" (a remote agent-panel
# read with a gap: the previous rows it did not list are kept, not gone) or "*" (the local
# agent-panel failed: it feeds every row, so every row keeps its previous cells). A blind row with
# no previous cells waits for a good read before it is new. Any other row is logged as read: one
# blind source no longer holds the whole fleet (ar-1116, 2026-11-08 20:27 to 11-09 03:10).
keep_blind() {
  awk -F'\t' '
    FILENAME == ARGV[1] { blind[$1] = 1; next }
    FILENAME == ARGV[2] { prev[$1] = $0; order[++n] = $1; next }
    blind["*"] { next }
    !($1 in blind) { print; seen[$1] = 1; next }
    $1 in prev { print prev[$1]; seen[$1] = 1 }
    END { if (blind["*"] || blind["+"]) for (i = 1; i <= n; i++) if (!(order[i] in seen)) print prev[order[i]] }
  ' "$3" "$1" "$2"
}

# tick: one pass with a fetch first (FLEET_FETCH=1), for the hub Sessions tab. git, gh and the
# transcripts have no change event to await, so fleet-state.timer runs it every minute; a pass
# costs ~12s of gh and git. It logs what moved since the last tick to watch.log (the state file
# is shared and locked, so two ticks log each change once), keeps watch.state for the next
# compare, and writes the state document with each session's eta.
tick() {
  export FLEET_FETCH=1
  CACHE="$(mktemp -d)"; trap 'rm -rf "$CACHE"' EXIT
  local rows cur new now t0
  t0="$(date +%s)"
  rows="$(collect)"
  eta_cells > "$CACHE/eta"
  cur="$CACHE/cells"; board_cells "$CACHE/eta" <<<"$rows" > "$cur"
  now="$(date '+%Y-%m-%d %H:%M')"
  mkdir -p "$LEDGER"
  (
    flock 9
    # What a source could not read did not change: those rows keep their last good cells.
    if [ -f "$LEDGER/watch.state" ]; then
      # keep_blind failing keeps the whole last state: a blink must never become the baseline.
      [ ! -s "$CACHE/blind" ] || { keep_blind "$LEDGER/watch.state" "$cur" "$CACHE/blind" > "$cur.kept" && mv "$cur.kept" "$cur"; } \
        || cp "$LEDGER/watch.state" "$cur"
      new="$(transitions "$LEDGER/watch.state" "$cur")"
      [ -n "$new" ] && sed "s/^/$now  /" <<<"$new" >> "$LEDGER/watch.log"
    fi
    cp "$cur" "$LEDGER/watch.state"
  ) 9>"$LEDGER/watch.lock"
  release_left "$rows"
  write_state "$t0" "$rows" > /dev/null
}

# explain <who>: one session as the last pass saw it, from the state document. It runs no pass,
# so it answers at once and can be up to one pass old, which the first line says.
explain() {
  local who="${1:-}"
  [ -n "$who" ] || { echo "usage: fleet-sessions explain <target|session|session id>" >&2; return 2; }
  [ -f "$STATE_FILE" ] || { echo "fleet-sessions: no state document at $STATE_FILE" >&2; return 1; }
  jq -re --arg w "$who" --argjson now "$(date +%s)" '
    def hrs: if . == null or . == 0 then "0m" elif . < 60 then "\(.)m" else "\((. / 60 + 0.5) | floor)h" end;
    def line($k; $v): "\($k | . + ("         " | .[($k | length):]))\($v)";
    . as $d
    | [.sessions[] | select(.session_id == $w or .target == $w or (.target | sub("^[^/]*/"; "")) == $w
        or (.target | sub("^[^/]*/"; "") | sub(":[^:]*$"; "")) == $w)][0] // empty
    | ((.prs // []) | [(map(select(.state == "MERGED")) | length), length]) as [$m, $n]
    | (.time // {}) as $t
    | ["\(.target)  \(.bucket)  (state \(($now - $d.generated_epoch) / 60 | floor)m old)",
       line("task"; .topic // "-"),
       line("time"; "open \(.age_min | hrs): \($t.work_min | hrs) work, \($t.gate_min // 0 | hrs) gate, \($t.test_min // 0 | hrs) test, \($t.jobs_min | hrs) jobs, \($t.human_min | hrs) you, \($t.parked_min | hrs) parked; idle \(.idle_min | hrs) now; \(.compactions // 0) compactions"),
       line("plan"; if .phases_total then "\(.phases_done)/\(.phases_total)\(if .next_phase then ", next: \(.next_phase)" else "" end)" else "no checklist" end),
       line("branch"; "\(.branch)\(if .pr != "-" then " (PR #\(.pr))" else "" end)"),
       line("PRs"; "\($m) merged of \($n)"),
       ((.prs // [])[] | "  \(.repo)#\(.number)  \((.state // "unknown") | ascii_downcase)\(if .merged_at then "  \(.merged_at | fromdate | strflocaltime("%a %H:%M"))" else "" end)"),
       line("doing"; .doing // "-"),
       line("said"; .said // "-"),
       line("why"; .reason),
       ((.blockers // [])[] | "  - \(.)")] | .[]' "$STATE_FILE" \
    || { echo "fleet-sessions: no session in the state document matches '$who'" >&2; return 2; }
}

# CLOSE_JQ: a row -> its `pct` (phases ticked, of the checklist) and `close` {verdict, why}:
# whether the session may close now, after one named step, or must stay (keep). The one
# definition of when a session closes, first match wins, in the close table of
# .local/src/docs/fleet-states.md. Dispatched is the `@dispatch` window flag or a queue item with
# an origin; the world is not a sign, since a human may still type in a lab window. Only a
# dispatched session closes over its own open ask (the answer reopens it); a hand-started one waits
# for it. What waits on the human (an ask, a dialog, plan mode, the manual label) keeps a window.
# Unlanded work reads from `blockers` (work_blockers), not raw git counts: a squash-merged branch
# stays `ahead` of main with nothing left to land. Quiet is fleet-shepherd's: a null age_min reads
# 0, so an unknown age never closes a CHAT row. The row of the session named by `--arg self`
# (close --self) is read as at the end of its turn: it runs this mid-turn, so it always reads
# WORKING, and the working keep is not asked.
CLOSE_JQ='
  def close_verdict($chat):
    ((($ARGS.named.self // "") != "") and .session_id == $ARGS.named.self) as $me
    | ([.idle_min // 0, .age_min // 0] | min) as $quiet
    | ((.dispatch != null) or ((.item.origin // null) != null)) as $started
    | ((.own_asks // 0) > 0) as $ask
    | ((.blockers // []) | map(select(test("^(open ask |[0-9]+ open ask)") | not))) as $other
    | ($other[0] // .reason // .bucket) as $first
    | ($other | map(select(test("dirty file|not on the default branch|^PR #[0-9]+ open|commits after merged PR")))[0])
      as $unlanded
    | ([$other[] | capture("^its item (?<s>[^ ]+) is still open with every phase done or queued$").s]) as $open_items
    | (.bucket == "STALLED" and ($open_items | length) > 0 and ($open_items | length) == ($other | length)) as $only_item
    | if ((.labels // []) | index("manual")) then {verdict: "keep", why: "manual: the human keeps it"}
      elif .bucket == "PARKED" then {verdict: "keep", why: "parked: its claude is gone"}
      elif .host != null then {verdict: "keep", why: "on \(.host): its git facts are on the worker"}
      elif $unlanded then {verdict: "keep", why: "land it: \($unlanded)"}
      elif .bucket == "WORKING" and ($me | not) then {verdict: "keep", why: "working"}
      elif .bucket == "STALLED" and ($only_item | not) then {verdict: "keep", why: "stalled: \($first)"}
      elif .bucket == "NEEDS" and ((.reason // "") | test("pending ask") | not) then {verdict: "keep", why: "a dialog waits on the human"}
      elif .in_plan_mode then {verdict: "keep", why: "plan mode: the human approves or ends it"}
      elif .finished and ($ask | not) then {verdict: "now", why: "plan finished, nothing open"}
      elif $started and $ask and ($other | length) == 0 then {verdict: "now", why: "only its own ask is open: the answer carries on without this window"}
      elif $started and (.item.is // "") == "moved" then {verdict: "now", why: "its item \(.item.slug) moved on: the queue holds the rest"}
      elif $only_item then {verdict: "after", why: "close its item \($open_items | join(", ")) (agent-land its last PR without --partial, or agent-queue move <slug> done): every phase is done or queued"}
      elif .bucket == "LANDED" and .next_phase != null then {verdict: "after", why: "queue the next phases (agent-queue add --plan), then close"}
      elif .bucket == "CHAT" and $quiet >= $chat then {verdict: "now", why: "quiet \($quiet / 60 | floor)h with no plan, PR or item"}
      elif .bucket == "CHAT" then {verdict: "after", why: "quiet \($chat / 60 | floor)h (now \($quiet)m)"}
      elif $ask then {verdict: "after", why: "the human answers its ask"}
      else {verdict: "keep", why: $first} end;
  .pct = (if (.phases_total // 0) > 0 then (100 * (.phases_done // 0) / .phases_total | floor) else null end)
  | .close = (if .bucket | IN("NIGHTLY", "CHECKOUT", "SHARED") then null
              else close_verdict($chat) end)'

# close_view [--json]: every session in the state document by its close verdict, now first, then
# after, then keep, each oldest-quiet first: where it is (bucket, phases, eta) and why. Reads the
# document `tick` wrote a minute ago, so it costs no collect; one read, so counts and rows agree.
# A document older than FLEET_STATE_STALE_MIN, or one without verdicts, is named on stderr.
close_view() {
  [ -r "$STATE_FILE" ] || { echo "fleet-sessions: no state document at $STATE_FILE" >&2; return 1; }
  local doc age
  doc="$(jq -c --argjson now "$(date +%s)" '{age: (($now - (.generated_epoch // 0)) / 60 | floor),
    rows: ([.sessions[] | select((.labels // []) | index("shepherd") | not)]),
    } | .bare = (.rows | map(select(.close == null)) | length)
      | .rows |= (map(select(.close != null))
                  | sort_by((.close.verdict | {now: 0, after: 1, keep: 2}[.] // 3), -(.idle_min // 0)))' \
    "$STATE_FILE")" || return 1
  age="$(jq -r .age <<<"$doc")"
  [ "$age" -le "${FLEET_STATE_STALE_MIN:-5}" ] \
    || echo "fleet-sessions: the state document is ${age}m old: is fleet-state.timer running?" >&2
  [ "$(jq -r .bare <<<"$doc")" = 0 ] \
    || echo "fleet-sessions: $(jq -r .bare <<<"$doc") session(s) carry no verdict (a document from before close)" >&2
  if [ "${1:-}" = --json ]; then jq -c '.rows[]' <<<"$doc"; return; fi
  jq -r '.rows | [("now", "after", "keep") as $v | "\($v) \(map(select(.close.verdict == $v)) | length)"]
    | join(", ")' <<<"$doc"
  jq -r '.rows[] | [.close.verdict, (.target | sub("^[a-z]+/"; "")), .bucket,
      (if .phases_total then "\(.phases_done)/\(.phases_total) \(.pct)%" else "-" end),
      "\(.idle_min // 0)m", (.eta // "-"), .close.why] | @tsv' <<<"$doc" | column -t -s $'\t'
}

# close_self <rows>: this session's own verdict, from a fresh collect (CLOSE_SELF names it) and not
# the document, so a PR that merged a minute ago counts: `<verdict>: <why>`, then its blockers, one a
# line. Exit 0 only on now. The /wind-down auto check reads it.
close_self() {
  local row
  row="$(awk -F'\t' -v s="$CLOSE_SELF" '$3 == s {print; exit}' <<<"$1")"
  [ -n "$row" ] || { echo "fleet-sessions: no live session $CLOSE_SELF" >&2; return 2; }
  row="$(json_rows <<<"$row")"
  jq -r '"\(.close.verdict): \(.close.why)", ((.blockers // [])[] | "blocker: \(.)")' <<<"$row"
  [ "$(jq -r .close.verdict <<<"$row")" = now ]
}

# json_rows: collect's rows on stdin -> one JSON object per row (the --json contract), each with
# its close verdict (CLOSE_JQ).
json_rows() {
  jq -cR --argjson chat "$((FLEET_CHAT_CLOSE_H * 60))" \
    ${CLOSE_SELF:+--arg self "$CLOSE_SELF"} 'split("\t") | {bucket: .[0], target: .[1], session_id: .[2],
      cwd: .[3], branch: .[4], pr: .[5], idle_min: (.[6] | tonumber), context_tokens: (.[7] | tonumber),
      plan_file: .[8], nudged: (.[9] == "1"), reason: .[10], pane: .[11], escalated: (.[12] == "1"),
      owners: (if .[13] == "-" then [] else .[13] | split(",") end),
      dispatch: (if .[14] == "-" then null else .[14] end),
      phases_done: (if .[15] == "-" then null else .[15] | tonumber end),
      phases_total: (if .[16] == "-" then null else .[16] | tonumber end),
      next_phase: (if .[17] == "-" then null else .[17] end), finished: (.[18] == "1"),
      behind: (if .[19] == "-" then null else .[19] | tonumber end),
      conflicts: (if .[20] == "-" then null else .[20] == "yes" end),
      pr_state: (if .[21] == "-" then null else .[21] end), ci: (if .[22] == "-" then null else .[22] end),
      dirty: (if .[23] == "-" then null else .[23] | tonumber end),
      ahead: (if .[24] == "-" then null else .[24] | tonumber end),
      labels: (if .[25] == "-" then [] else .[25] | split(",") end),
      activity: (if .[26] == "-" then null else .[26] end),
      age_min: (if (.[27] // "-") == "-" then null else .[27] | tonumber end),
      asks: ((.[28] // "0") | tonumber),
      fact: .[29],
      blockers: (if (.[30] // "-") == "-" then [] else .[30] | split("; ") end),
      prs: ((.[31] // "[]") | fromjson),
      time: {work_min: ((.[33] // "0") | tonumber), gate_min: ((.[41] // "0") | tonumber),
             test_min: ((.[42] // "0") | tonumber), jobs_min: ((.[34] // "0") | tonumber),
             human_min: ((.[35] // "0") | tonumber), parked_min: ((.[36] // "0") | tonumber)},
      compactions: ((.[37] // "0") | tonumber),
      topic: (if (.[38] // "-") == "-" then null else .[38] end),
      doing: (if (.[39] // "-") == "-" then null else .[39] end),
      said: (if (.[40] // "-") == "-" then null else .[40] end),
      main_red: (if (.[43] // "-") == "RED" then true elif (.[43] // "-") == "OK" then false else null end),
      phases: ((.[44] // "[]") | fromjson),
      account: (if (.[45] // "-") == "-" then null else .[45] end),
      item: (if (.[46] // "-") == "-" then null else
        {slug: .[46], is: .[47], row: (if .[48] == "-" then null else .[48] end),
         origin: (if .[49] == "-" then null else .[49] end)} end),
      project: (if (.[50] // "") == "" then null else .[50] end),
      host: (if (.[51] // "-") == "-" then null else .[51] end),
      activity_line: (if (.[52] // "-") == "-" then null else .[52] end),
      own_asks: ((.[53] // "0") | tonumber), in_plan_mode: ((.[54] // "0") == "1")} | '"$CLOSE_JQ"
}

# write_state <started epoch> <rows>: print the rows as --json does, and replace the state
# document with them, each session carrying its eta cell (eta_cells, reused from tick's pass). The document is built beside the target and renamed into place, so a
# reader never sees half of one, and a pass that started before the one already written
# (a slow 10-minute pass finishing after an ask-event pass) leaves the newer document alone.
write_state() {
  local t="$1" rows="$2" json dir tmp asks prev stopped
  [ -f "$CACHE/eta" ] || eta_cells > "$CACHE/eta"
  json="$( [ -n "$rows" ] && json_rows <<<"$rows")"
  [ -n "$json" ] && printf '%s\n' "$json"
  dir="$(dirname "$STATE_FILE")"
  mkdir -p "$dir" || return 1
  asks="$(agent-ask list --all --pending 2>/dev/null)" || unreadable agent-ask
  # A hold that has stopped every dispatch pass (hub Home's Stopped row); rc 1 is "stopped", not a failure.
  stopped="$(fleet-dispatch stopped --json 2>/dev/null)"
  tmp="$(mktemp "$dir/.state.XXXXXX")" || return 1
  # The rows and asks go in by file: 77 sessions came to 136 KB, past the kernel's 128 KB cap on one argument.
  printf '%s' "$json" > "$CACHE/rows" && printf '%s' "$asks" > "$CACHE/asks" || return 1
  if ! jq -n --argjson t "$t" --arg unread "$(sort -u "$CACHE/unreadable" 2>/dev/null)" --arg silent "$(sort -u "$CACHE/silent" 2>/dev/null)" \
       --arg order "$BUCKET_ORDER" --arg finished "$BUCKET_FINISHED" --arg progress "$BUCKET_IN_PROGRESS" \
       --rawfile asks "$CACHE/asks" --rawfile rows "$CACHE/rows" --arg stopped "$stopped" --rawfile eta "$CACHE/eta" '
      ($rows | split("\n") | map(select(length > 0) | fromjson)) as $r
      | ($eta | split("\n") | map(select(length > 0) | split("\t") | {key: .[0], value: {eta: .[1], at: (.[2] // "" | tonumber? // null)}})
         | from_entries) as $e
      | {schema: 1, generated_epoch: $t, generated_at: ($t | todate),
         vocab: {buckets: ($order | split(" ")), finished: ($finished | split(" ")), in_progress: ($progress | split(" "))},
         unreadable: ($unread | split("\n") | map(select(length > 0))),
         silent: ($silent | split("\n") | map(select(length > 0) | fromjson)),
         sessions: ($r | map(select(.bucket | IN("NIGHTLY", "CHECKOUT", "SHARED") | not)
                     | if $e[.session_id] then .eta = $e[.session_id].eta | .eta_epoch = $e[.session_id].at else . end)),
         main: ($r | map(select(.bucket | IN("NIGHTLY", "CHECKOUT"))
                     | {repo: .target, id: .session_id, reason, fact, nudged, escalated, owners})),
         shared: ($r | map(select(.bucket == "SHARED")
                     | {test: .target, id: .session_id, reason, fact, nudged, escalated, owners})),
         asks: [$asks | split("\n")[] | select(length > 0) | split("\t")
                | {id: .[0], project: .[1], kind: .[4], question: (.[5] // "" | .[0:160]),
                   task: (if (.[7] // "") == "" then null else .[7] end), created: .[11],
                   session: (if (.[12] // "") == "" then null else .[12] end),
                   recommend: (if (.[10] // "") == "" then null else .[10] end),
                   judge: (if (.[16] // "") == "" then null else .[16] end)}],
         stopped: [$stopped | split("\n")[] | fromjson? | objects]}
      # Every bucket with its count, zeros included: a reader that keys on the buckets present
      # would keep the last non-zero count of a bucket after it empties (agent-mqtt-publish did).
      # The shepherd pass (label shepherd) is listed but not counted: it is not an agent session.
      | .counts = ((.sessions | map(select((.labels // []) | index("shepherd") | not) | .bucket)) as $b
          | (($order | split(" ")) + $b | unique)
          | map(. as $k | {key: $k, value: ($b | map(select(. == $k)) | length)}) | from_entries)' > "$tmp"; then
    rm -f "$tmp"; echo "fleet-sessions: could not build $STATE_FILE" >&2; return 1
  fi
  exec 8>"$dir/.lock"
  flock -w 30 8 || { rm -f "$tmp"; echo "fleet-sessions: $dir/.lock busy" >&2; return 1; }
  prev="$(jq -r '.generated_epoch // 0' "$STATE_FILE" 2>/dev/null)"
  if [ "${prev:-0}" -gt "$t" ] 2>/dev/null; then rm -f "$tmp"; return 0; fi
  mv -f "$tmp" "$STATE_FILE" || return 1
  prom_textfile fleet_sessions.prom sessions_prom "$STATE_FILE" ||
    echo "fleet-sessions: could not write fleet_sessions.prom" >&2
  tmux_project "$STATE_FILE"
}

# sessions_prom <state document> -> the fleet_sessions.prom lines: one series per session per
# fact it has, labelled {target, project, bucket}, an info series joining each target to its
# session_id (the label claude_code_* metrics carry), bucket counts, and the open asks unless
# agent-ask could not be read. project is the row's own, from resolve_project_name.
sessions_prom() {
  jq -r "$PROM_JQ"'
    def per($name; $help; f): gauge($name; $help;
      .sessions | sort_by(.target)[] | select((.labels // []) | index("shepherd") | not)
      | [{target, project: (.project // ""), bucket}, f]);
    per("agent_session_context_tokens"; "Context tokens the session holds."; .context_tokens),
    per("agent_session_idle_minutes"; "Minutes since the session went idle, by agent-panel."; .idle_min),
    per("agent_session_age_minutes"; "Minutes since the session started."; .age_min),
    per("agent_session_phases_done"; "Phases ticked in the plan checklist of the session."; .phases_done),
    per("agent_session_phases_total"; "Phases in the plan checklist of the session."; .phases_total),
    per("agent_session_behind"; "Commits the branch of the session is behind its base."; .behind),
    per("agent_session_dirty"; "Uncommitted files in the worktree of the session."; .dirty),
    per("agent_session_conflicts"; "1 when the branch of the session conflicts with its base."; .conflicts),
    gauge("agent_session_info"; "Joins a session target to its Claude Code session_id; always 1.";
      .sessions | sort_by(.target)[] | select((.session_id // "") != "")
      | [{target, project: (.project // ""), session_id}, 1]),
    gauge("agent_sessions"; "Live sessions per fleet-sessions bucket.";
      .counts | to_entries[] | [{bucket: .key}, .value]),
    gauge("agent_session_bucket"; "Place of a bucket in the order that needs the human first (0 is first), with its finished and in-progress flags.";
      .vocab as $v | $v.buckets | to_entries[] | .value as $b
      | [{bucket: $b, finished: (if ($v.finished | index($b)) then "1" else "0" end),
          in_progress: (if ($v.in_progress | index($b)) then "1" else "0" end)}, .key]),
    gauge("agent_sessions_unlinked"; "Live sessions with no agent-queue item, by the item_of join.";
      [{}, ([.sessions[] | select((.labels // []) | index("shepherd") | not)
             | select(.bucket != "NIGHTLY" and .bucket != "SHARED" and .item == null)] | length)]),
    gauge("agent_asks_open"; "Pending asks waiting on the human.";
      if (.unreadable | index("agent-ask")) then empty else [{}, (.asks | length)] end)' "$1"
}

# holds: the sibling fleet-shepherd's lease check, by path, so a test runs this checkout's.
holds() { "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/fleet-shepherd" holds; }

main() {
  case "${1:-}" in
    # A ledger write is the shepherd acting: only the pass holding its lease may (fleet-shepherd holds).
    mark) holds || return; shift; mark "$@"; return ;;
    escalate) holds || return; shift; escalate "$@"; return ;;
    label) shift; label "$@"; return ;;
    tick) tick; return ;;
    explain) shift; explain "$@"; return ;;
    stages) shift; python3 "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/fleet-stages.py" --log "$LEDGER/watch.log" --state "$STATE_FILE" "$@"; return ;;
    close)
      if [ "${2:-}" = --self ]; then
        CLOSE_SELF="$(resolve_sid "${3:-self}")" || return 2
      else shift; close_view "$@"; return; fi ;;
    -h|--help) sed -n '2,29p' "$0"; return ;;
  esac
  CACHE="$(mktemp -d)"; trap 'rm -rf "$CACHE"' EXIT
  local rows t0
  t0="$(date +%s)"
  rows="$(collect)"
  case "${1:-}" in
    --json) [ -n "$rows" ] && json_rows <<<"$rows"; return 0 ;;
    --write) write_state "$t0" "$rows"; return ;;
    close) close_self "$rows"; return ;;
  esac
  local b
  for b in NIGHTLY CHECKOUT SHARED $BUCKET_ORDER; do
    awk -F'\t' -v b="$b" '$1 == b' <<<"$rows" | sort -t$'\t' -k2 | {
      first=1
      while IFS=$'\t' read -r _ target _ _ branch pr idle _ _ n reason _ _ _ dsp _ _ _ _ _ _ _ _ _ _ lbl _; do
        [ "$first" = 1 ] && { echo "$b"; first=0; }
        printf '  %-44s %-28s %-6s %4sm  %s%s%s%s\n' "${target#*/}" "$branch" "$pr" "$idle" "$reason" \
          "$([ "$n" = 1 ] && echo '  (nudged)')" "$([ "${dsp:--}" != - ] && echo "  [dispatch: $dsp]")" \
          "$([ "${lbl:--}" != - ] && echo "  [labels: $lbl]")"
      done
    }
  done
}

# Sourceable for tests (session_bucket, main_state, nudged, mark, escalate); runs main only when executed.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
