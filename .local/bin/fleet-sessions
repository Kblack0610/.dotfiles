#!/usr/bin/env bash
# fleet-sessions - where is each live Claude session in its delivery, and does it need anyone?
#
#   fleet-sessions                    one row per session, grouped by bucket
#   fleet-sessions --json             the same, one JSON object per line (for fleet-overseer)
#   fleet-sessions mark <sid> <fact>  record that <fact> was nudged, so it is nudged once
#   fleet-sessions escalate <sid> <fact>  record that <fact> went to the human, so it pages once
#   fleet-sessions label <who> [+name|-name ...]  set, clear or (no ops) print a session's labels
#   fleet-sessions watch [--every N] [--once]  stage board: one column per delivery stage, plus a
#                                     log of what changed since the last tick
#
# Buckets: WORKING, NEEDS (the human), DONE (wind it down), LANDED (start the next phase),
# STALLED (nudge once), UNCLEAR, plus one MAIN row per repo whose default branch is red (the
# latest decided run of a workflow failed), naming the PRs merged since that workflow was
# last green. DONE means every line of the plan's `## Phases` checklist is `[x]` or `[-]`,
# nothing it made is unlanded, no ask is open, and it is idle. The --json `finished` field
# is DONE without the idle and status checks, so a session can check its own row mid-turn.
# A background shell keeps a session WORKING up to FLEET_SHELL_STALE_MIN, unless its plan is finished.
# Facts come from agent-panel, git, gh and the ask queue; no model. fleet-overseer's
# `status` and `shepherd` verbs read this. Thresholds are the FLEET_* block below.

set -uo pipefail

# --- thresholds (env overrides) --------------------------------------------------------
: "${FLEET_IDLE_MIN:=20}"   # idle fewer minutes than this -> still WORKING (just ended a turn)
: "${FLEET_SHELL_STALE_MIN:=120}" # a background shell this long past the last entry is not work:
                                  # a real gate wait is under an hour, a forgotten ugrep is not
: "${FLEET_SUSPECTS_MAX:=3}" # a red workflow names its PRs as suspects only up to this many; past
                             # it (a nightly suite after a busy day) nobody can be told it was theirs
LEDGER="${FLEET_SHEPHERD_DIR:-$HOME/.agent/shepherd}"
ASK_ROOT="${AGENT_ASK_DIR:-$HOME/.agent/asks}"
# fleet-dispatch writes live/<tmux session> for each session it starts; its label= line is
# the row that session is working, shown so the shepherd knows which sessions it fed.
DISPATCH_LIVE="${FLEET_DISPATCH_DIR:-$HOME/.agent/dispatch}/live"
# Labels say what git, gh and the transcript cannot: a human's `hands-off` (the shepherd
# leaves that session alone), or a session's own `quality:<step>` while a cleanup pass runs.
# One file per session id, one label per line. Stages are derived every pass, never stored.
LABELS="$LEDGER/labels"
# watch: git, gh and the transcripts have no change event to await, so the board samples them
# on this one cadence. A pass costs ~12s of gh and git, so a minute keeps it well under 10%.
: "${FLEET_WATCH_EVERY:=60}"
: "${FLEET_WATCH_LOG_LINES:=12}" # transitions shown above the table

# session_bucket <status> <plan_mode 0|1> <asks> <heavy 0|1> <idle_min> <git 0|1> \
#                <dirty> <ahead> <pr#|-> <pr_state|-> <ci PASS|FAIL|PENDING|NONE|-> <head_in_pr 0|1> \
#                <main_red: workflows this session's merged PR is a suspect for, or -> \
#                <phases: - (no plan file) | none (no checklist) | done/total> <next phase|->
#   -> "BUCKET reason"
session_bucket() {
  local st="$1" note=""
  case "$st" in
    waiting) echo "NEEDS waiting on a prompt or permission"; return ;;
    busy) echo "WORKING busy"; return ;;
    shell)
      # A finished plan is not waiting on its shell: DONE tells it to stop the shell first.
      if [ "$5" -ge "$FLEET_IDLE_MIN" ] && session_finished "$@"; then
        note=", background shell still running"
      elif [ "$5" -lt "$FLEET_SHELL_STALE_MIN" ]; then
        echo "WORKING shell"; return
      else
        # The threshold, not the minutes: a reason that changed every pass would re-nudge every pass.
        note=", background shell idle over ${FLEET_SHELL_STALE_MIN}m"
      fi ;;
  esac
  echo "$(bucket_facts "$@")$note"
}

# bucket_facts: session_bucket past the session status, from the same arguments.
bucket_facts() {
  local plan="$2" asks="$3" heavy="$4" idle="$5" git="$6" dirty="$7" ahead="$8" \
        pr="$9" state="${10}" ci="${11}" inpr="${12}" red="${13:--}" phases="${14:--}" next="${15:--}"
  [ "$heavy" = 1 ] && { echo "WORKING heavy child process"; return; }
  [ "$asks" -gt 0 ] && { echo "NEEDS $asks pending ask(s)"; return; }
  [ "$plan" = 1 ] && { echo "NEEDS plan awaiting approval"; return; }
  [ "$idle" -lt "$FLEET_IDLE_MIN" ] && { echo "WORKING idle ${idle}m"; return; }
  [ "$git" = 1 ] || { echo "UNCLEAR not in a git repo"; return; }
  case "$state" in
    MERGED)
      # A merge that may have turned main red is not landed, whatever the tree says.
      if [ "$red" != - ]; then echo "STALLED main red after PR #$pr: $red"
      elif [ "$dirty" -gt 0 ]; then echo "STALLED PR #$pr merged, $dirty dirty file(s) left"
      elif [ "$inpr" != 1 ]; then echo "STALLED commits after merged PR #$pr"
      else plan_bucket "PR #$pr merged, tree clean" "$phases" "$next"; fi ;;
    OPEN)
      case "$ci" in
        FAIL)    echo "STALLED PR #$pr CI red" ;;
        PENDING) echo "WORKING PR #$pr CI running" ;;
        *)       echo "STALLED PR #$pr green, not merged" ;;
      esac ;;
    CLOSED) echo "UNCLEAR PR #$pr closed without merging" ;;
    *)
      if [ "$dirty" -gt 0 ]; then echo "STALLED $dirty dirty file(s), no PR"
      elif [ "$ahead" -gt 0 ]; then echo "STALLED $ahead file(s) not on the default branch, no PR"
      else plan_bucket "clean, nothing on the branch" "$phases" "$next"; fi ;;
  esac
}

# session_finished: session_bucket's arguments -> exit 0 when the work half of DONE holds
# (phases all ticked, no ask, nothing unlanded, not a red-main suspect). It skips status,
# plan mode, a heavy child and the idle threshold, so a session can check its own row
# mid-turn, when that row always reads WORKING busy.
session_finished() {
  case "$(bucket_facts - 0 "$3" 0 "$FLEET_IDLE_MIN" "${@:6}")" in DONE*) return 0 ;; esac
  return 1
}

# plan_bucket <reason so far> <phases> <next>: nothing is unlanded, so the plan decides.
# All phases ticked is DONE; one left is LANDED naming it; no checklist is LANDED asking for
# one; no plan file at all is the human's call.
plan_bucket() {
  local why="$1" phases="$2" next="$3"
  case "$phases" in
    -)    echo "UNCLEAR $why, no plan file: done or never started" ;;
    none) echo "LANDED $why, plan has no ## Phases checklist" ;;
    *)
      if [ "${phases%/*}" -ge "${phases#*/}" ]; then echo "DONE $why, all ${phases#*/} phases done"
      else echo "LANDED $why, next phase: $next"; fi ;;
  esac
}

# plan_phases <plan file> -> "done \t total \t first unchecked", from the `## Phases`
# checklist: `- [x]` landed and `- [-]` deferred count as done, `- [ ]` does not. Only
# unindented items are phases; an indented item is a step inside one. A missing file, no
# such section, or a section with no checklist lines prints "- \t - \t -".
plan_phases() {
  local out=""
  [ -f "$1" ] && out="$(awk '
    /^## / { inp = ($0 ~ /^## Phases([[:space:]]|$)/); next }
    !inp { next }
    /^[-*] \[[xX-]\] / { d++; t++; next }
    /^[-*] \[ \] / {
      t++
      if (nx == "") { nx = $0; sub(/^[-*] \[ \] /, "", nx); gsub(/\t/, " ", nx) }
    }
    END { if (t) printf "%d\t%d\t%s\n", d, t, (nx == "" ? "-" : nx) }' "$1")"
  if [ -n "$out" ]; then printf '%s\n' "$out"; else printf -- '-\t-\t-\n'; fi
}

# nudged <sid> <fact> -> exit 0 when this exact fact was already nudged for this session.
nudged() { [ "$(sed -n 's/^fact: //p' "$LEDGER/$1" 2>/dev/null)" = "$2" ]; }

# escalated <sid> <fact> -> exit 0 when this exact fact is already on the human's list.
escalated() { [ "$(sed -n 's/^escalated: //p' "$LEDGER/$1" 2>/dev/null)" = "$2" ]; }

# ledger_write <sid> <key> <fact>: set one key, keep the other (a new nudge clears escalated).
ledger_write() {
  local sid="$1" key="$2" fact="$3" tmp keep=""
  case "$sid" in ''|*/*|.|..) echo "fleet-sessions: bad session id" >&2; return 2 ;; esac
  mkdir -p "$LEDGER"
  [ "$key" = escalated ] && keep="$(grep '^fact: ' "$LEDGER/$sid" 2>/dev/null)"
  tmp="$(mktemp "$LEDGER/.$sid.XXXXXX")" || return 1
  { [ -n "$keep" ] && echo "$keep"; printf '%s: %s\nat: %s\n' "$key" "$fact" "$(date -Iseconds)"; } > "$tmp" \
    && mv "$tmp" "$LEDGER/$sid"
}
mark()     { ledger_write "$1" fact "$2"; }
escalate() { ledger_write "$1" escalated "$2"; }

# labels_of <sid> -> the session's labels, comma-joined in the order set, or "-".
labels_of() {
  local l
  l="$(paste -sd, "$LABELS/$1" 2>/dev/null)"
  echo "${l:--}"
}

# resolve_sid <who> -> a session id: `self` is this session ($CLAUDE_CODE_SESSION_ID); anything
# else matches a live session's id, target (lab/s1:1), tmux target (s1:1) or tmux session (s1).
resolve_sid() {
  local who="$1"
  if [ "$who" = self ]; then
    [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] || { echo "fleet-sessions: self needs CLAUDE_CODE_SESSION_ID" >&2; return 2; }
    echo "$CLAUDE_CODE_SESSION_ID"; return
  fi
  local sid
  sid="$("${AGENT_PANEL:-agent-panel}" list --json 2>/dev/null | jq -r --arg w "$who" '
    select(.session_id == $w or .target == $w or (.target | sub("^[^/]*/"; "")) == $w
           or (.target | sub("^[^/]*/"; "") | sub(":[^:]*$"; "")) == $w) | .session_id' | head -1)"
  [ -n "$sid" ] || { echo "fleet-sessions: no live session matches '$who'" >&2; return 2; }
  echo "$sid"
}

# label <who> [+name|-name ...]: add or remove labels, then print the session's labels.
label() {
  local who="${1:-}" sid op name tmp
  [ -n "$who" ] || { echo "usage: fleet-sessions label <who> [+name|-name ...]" >&2; return 2; }
  sid="$(resolve_sid "$who")" || return 2
  case "$sid" in ''|*/*|.|..) echo "fleet-sessions: bad session id" >&2; return 2 ;; esac
  shift
  mkdir -p "$LABELS"
  for op in "$@"; do
    name="${op#[+-]}"
    if [ "$name" = "$op" ] || ! [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9:._-]*$ ]]; then
      echo "fleet-sessions: label ops are +name or -name ([A-Za-z0-9:._-]), got '$op'" >&2; return 2
    fi
    tmp="$(mktemp "$LABELS/.$sid.XXXXXX")" || return 1
    { grep -vxF -- "$name" "$LABELS/$sid" 2>/dev/null; [ "${op:0:1}" = + ] && echo "$name"; } > "$tmp"
    if [ -s "$tmp" ]; then mv "$tmp" "$LABELS/$sid"; else rm -f "$tmp" "$LABELS/$sid"; fi
  done
  labels_of "$sid"
}

# --- facts ------------------------------------------------------------------------------
# Pending asks whose `session:` names this session (tmux session name or session id).
asks_for() {
  local f n=0
  for f in "$ASK_ROOT"/*/*.md; do
    [ -f "$f" ] || continue
    grep -q '^status: pending$' "$f" || continue
    grep -qxF -e "session: $1" -e "session: $2" "$f" && n=$((n + 1))
  done
  echo "$n"
}

# tmux sessions holding a heavy process (fleet-assess rows), one per line.
heavy_sessions() {
  local fa
  fa="$(command -v fleet-assess || echo "$(dirname "$0")/fleet-assess")"
  "$fa" 2>/dev/null | awk 'f && $5 != "-" { print $5 } /^PID /{ f = 1 }' | sort -u
}

# repo_slug <dir> -> the origin URL as a file-name-safe key (cache files, MAIN ledger ids).
repo_slug() {
  local url
  url="$(git -C "$1" remote get-url origin 2>/dev/null)" || return 1
  printf '%s' "$url" | tr -c 'A-Za-z0-9' _
}

# PRs for one repo, cached per pass: "branch \t number \t state \t ci \t head_oid".
prs_for() {
  local dir="$1" key
  key="$CACHE/$(repo_slug "$dir")" || return 0
  [ -f "$key" ] || (cd "$dir" && gh pr list --state all --limit 100 \
      --json number,state,headRefName,headRefOid,statusCheckRollup -q '.[] | [
        .headRefName, .number, .state,
        (.statusCheckRollup // [] | map(.conclusion // .state // "") as $c
          | if ($c | length) == 0 then "NONE"
            elif any($c[]; test("FAIL|ERROR|CANCEL|TIMED_OUT|ACTION_REQUIRED")) then "FAIL"
            elif any($c[]; test("^$|PENDING|QUEUED|IN_PROGRESS|EXPECTED")) then "PENDING"
            else "PASS" end),
        .headRefOid ] | @tsv' 2>/dev/null) > "$key" || echo "gh pr list ($(basename "$dir"))" >> "$CACHE/unreadable"
  cat "$key"
}

# default_base <dir> -> origin/<default branch>, cached per repo per pass. GitHub's answer
# wins: origin/HEAD is set at clone time and goes stale when the default branch changes.
# The symref is the offline fallback, and a name this clone has no remote ref for is unused.
default_base() {
  local d="$1" key b
  key="$CACHE/base_$(repo_slug "$d")" || { echo origin/main; return; }
  if [ ! -f "$key" ]; then
    b="$(cd "$d" && gh repo view --json defaultBranchRef -q .defaultBranchRef.name 2>/dev/null)"
    if [ -z "$b" ] || ! git -C "$d" rev-parse -q --verify "refs/remotes/origin/$b" >/dev/null 2>&1; then
      b="$(git -C "$d" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)"; b="${b#origin/}"
    fi
    echo "origin/${b:-main}" > "$key"
  fi
  cat "$key"
}

# main_state: gh run list JSON (any order) on stdin -> one line per workflow whose latest
# decided run failed: "workflow \t first_red_sha \t last_green_sha|-". The red sha is the
# FIRST failure after the last green (the oldest in the window when there is none), so the
# fact holds still while a red streak runs on, and the suspect range ends where it broke.
# Cancelled, skipped and running runs decide nothing, so they are passed over.
main_state() {
  jq -r 'map(select(.status == "completed"
                    and (.conclusion | test("^(success|failure|timed_out|startup_failure)$"))))
    | group_by(.workflowName)[] | sort_by(.createdAt) | reverse
    | select(.[0].conclusion != "success")
    | (map(.conclusion == "success") | index(true)) as $g
    | [.[0].workflowName, (if $g == null then .[-1] else .[$g - 1] end).headSha,
       (if $g == null then "-" else .[$g].headSha end)] | @tsv'
}

# main_health <dir> -> "RED \t <detail> \t <red sha> \t <suspect PRs, space-separated>", "OK"
# or "UNKNOWN", cached per repo per pass. A red workflow's range is last-green..red on this
# clone, and its (#N) squash subjects are suspects only when there are FLEET_SUSPECTS_MAX or
# fewer. No green in the window, or a range the clone lacks, names nobody.
main_health() {
  local dir="$1" url key base b runs wf red green wfs="" sha="" prs="" range
  url="$(git -C "$dir" remote get-url origin 2>/dev/null)" || { echo OK; return; }
  key="$CACHE/main_$(repo_slug "$dir")"
  if [ ! -f "$key" ]; then
    base="$(default_base "$dir")"
    b="${base#origin/}"
    # Could not look is not green: say so, so the shepherd never reads a dead gh as healthy.
    if ! runs="$(cd "$dir" && gh run list --branch "$b" --limit 100 \
                   --json workflowName,status,conclusion,headSha,createdAt 2>/dev/null)"; then
      printf 'UNKNOWN\t-\t-\t-\t%s\n' "$(basename "$url" .git)" > "$key"
      cut -f1-4 "$key"; return
    fi
    while IFS=$'\t' read -r wf red green; do
      [ -n "$wf" ] || continue
      [ -n "$sha" ] || sha="$red"
      if [ "$green" = - ]; then range="no green in window"
      elif ! git -C "$dir" cat-file -e "$red^{commit}" 2>/dev/null \
           || ! git -C "$dir" cat-file -e "$green^{commit}" 2>/dev/null; then range="range not in clone"
      else
        range="$(git -C "$dir" log --format=%s "$green..$red" | grep -oE '\(#[0-9]+\)$' | tr -dc '0-9\n' | sort -un | tr '\n' ' ')"
        range="${range% }"
        if [ -z "$range" ]; then range="no PR in range"
        elif [ "$(wc -w <<<"$range")" -le "$FLEET_SUSPECTS_MAX" ]; then prs="$prs $range"; range="#${range// / #}"
        else range="$(wc -w <<<"$range") PRs since green"; fi
      fi
      # No green: the oldest red in view slides as runs age out, so that fact names no sha.
      if [ "$green" = - ]; then wfs="${wfs:+$wfs, }$wf ($range)"
      else wfs="${wfs:+$wfs, }$wf @${red:0:8} ($range)"; fi
    done < <(main_state <<<"$runs")
    if [ -n "$wfs" ]; then
      # Every field non-empty: read with a tab IFS folds an empty field into the next.
      prs="$(tr ' ' '\n' <<<"$prs" | grep . | sort -un | paste -sd' ' -)"
      printf 'RED\t%s\t%s\t%s\t%s\n' "$wfs" "${sha:0:8}" "${prs:--}" "$(basename "$url" .git)" > "$key"
    else echo OK > "$key"; fi
  fi
  cut -f1-4 "$key"
}

# dirty_count <dir> <edited files, one absolute path per line>: the session's dirty files.
# In its own worktree (under ~/.worktrees/) every dirty file is its own. A repo's main
# checkout is shared with the human and other sessions, so there only the files this
# session edited count: the human's half-done config is not this session's to land.
dirty_count() {
  local d="$1" edited="$2" top
  case "$d/" in
    "$HOME/.worktrees/"*) git -C "$d" status --porcelain 2>/dev/null | wc -l; return ;;
  esac
  [ -n "$edited" ] || { echo 0; return; }
  top="$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)" || { echo 0; return; }
  # -z: no quoting of odd names; -uall: an untracked file inside a new dir is listed by name.
  git -C "$d" status --porcelain -z --no-renames -uall 2>/dev/null \
    | while IFS= read -r -d '' e; do printf '%s/%s\n' "$top" "${e:3}"; done \
    | grep -cxFf <(printf '%s\n' "$edited" | xargs -r -d '\n' realpath -m -- 2>/dev/null | grep .)
}

# ahead_files <dir> <base>: files the branch changed since the merge base whose content in
# HEAD still differs from the base tip. A squash-merged branch, or a local merge commit
# whose content is already on origin, changed files that origin now has, so it counts 0.
ahead_files() {
  local d="$1" base="$2" mb
  mb="$(git -C "$d" merge-base "$base" HEAD 2>/dev/null)" || { echo 0; return; }
  comm -12 <(git -C "$d" diff --name-only "$mb" HEAD 2>/dev/null | sort) \
           <(git -C "$d" diff --name-only "$base" HEAD 2>/dev/null | sort) | wc -l
}

# fetch_once <dir>: with FLEET_FETCH=1 (watch sets it), fetch origin once per repo per pass,
# so behind and conflicts are measured against the remote tip, not the last manual fetch.
# Worktrees of one repo share its refs, so one fetch covers them all.
fetch_once() {
  [ "${FLEET_FETCH:-0}" = 1 ] || return 0
  local key
  key="$CACHE/fetched_$(repo_slug "$1")" || return 0
  [ -f "$key" ] || { git -C "$1" fetch -q origin 2>/dev/null; : > "$key"; }
}

# sync_facts <dir> <base> -> "behind conflicts": commits on the base this branch lacks, and
# whether merging the base in would conflict (yes|no). merge-tree touches no checkout.
sync_facts() {
  local d="$1" base="$2" behind conflicts=no
  behind="$(git -C "$d" rev-list --count "HEAD..$base" 2>/dev/null)" || { echo "- -"; return; }
  if [ "$behind" -gt 0 ]; then
    git -C "$d" merge-tree --write-tree --no-messages "$base" HEAD >/dev/null 2>&1
    case $? in 0) ;; 1) conflicts=yes ;; *) conflicts=- ;; esac
  fi
  echo "$behind $conflicts"
}

# One session's facts as the session_bucket arguments after status/plan/asks/heavy/idle,
# plus branch and sync: "git dirty ahead pr state ci in_pr branch behind conflicts".
git_facts() {
  local d="$1" edited="${2:-}" branch dirty ahead base pr state ci oid inpr=1 head
  git -C "$d" rev-parse --git-dir >/dev/null 2>&1 || { echo "0 0 0 - - - 1 - - -"; return; }
  fetch_once "$d"
  branch="$(git -C "$d" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  dirty="$(dirty_count "$d" "$edited")"
  base="$(default_base "$d")"
  ahead="$(ahead_files "$d" "$base")"
  IFS=$'\t' read -r _ pr state ci oid < <(prs_for "$d" | awk -F'\t' -v b="$branch" '$1 == b { print; exit }')
  if [ -n "${oid:-}" ]; then
    head="$(git -C "$d" rev-parse HEAD)"
    # HEAD is in the PR when it is the PR head or behind it; an unknown oid means the
    # remote holds commits this clone lacks, which is also "nothing new here".
    if [ "$head" != "$oid" ] && git -C "$d" cat-file -e "$oid^{commit}" 2>/dev/null \
       && ! git -C "$d" merge-base --is-ancestor HEAD "$oid" 2>/dev/null; then inpr=0; fi
  fi
  echo "1 $dirty $ahead ${pr:--} ${state:--} ${ci:--} $inpr ${branch:--} $(sync_facts "$d" "$base")"
}

collect() {
  local now heavy line
  now="$(date +%s)"
  heavy="$(heavy_sessions)"
  local panel
  # A pass that could not read a source says so in $CACHE/unreadable, so watch never logs a
  # blink (every session "gone", every PR "-") as a change.
  panel="$("${AGENT_PANEL:-agent-panel}" list --json 2>/dev/null)" || echo agent-panel >> "$CACHE/unreadable"
  [ -n "$panel" ] && printf '%s\n' "$panel" | while IFS= read -r line; do
    local target pane status plan sid cwd since ctx planf tsess idle asks hv bucket fact edited \
          pdone ptotal pnext phases fin
    IFS=$'\t' read -r target pane status plan sid cwd since ctx planf < <(jq -r '[.target, (.pane | sub(".*/"; "")), .status,
      (if .plan_mode then 1 else 0 end), .session_id, .cwd, .idle_since, .context_tokens,
      (.plan_file | if . == "" then "-" else . end)] | @tsv' <<<"$line")
    edited="$(jq -r '.edited_files // [] | .[]' <<<"$line")"
    tsess="${target#*/}"; tsess="${tsess%:*}"
    idle=$(( (now - since) / 60 ))
    asks="$(asks_for "$tsess" "$sid")"
    hv=0; grep -qxF "$tsess" <<<"$heavy" && hv=1
    read -r g dirty ahead pr state ci inpr branch behind conflicts < <(git_facts "$cwd" "$edited")
    IFS=$'\t' read -r pdone ptotal pnext < <(plan_phases "$planf")
    if [ "$planf" = - ] || [ ! -f "$planf" ]; then phases=-
    elif [ "$ptotal" = - ]; then phases=none
    else phases="$pdone/$ptotal"; fi
    local red=- mh mwfs msuspects
    if [ "$g" = 1 ] && [ "$state" = MERGED ]; then
      IFS=$'\t' read -r mh mwfs _ msuspects < <(main_health "$cwd")
      if [ "$mh" = RED ] && grep -qxF "$pr" <<<"$(tr ' ' '\n' <<<"$msuspects")"; then
        red="$mwfs"
        printf '%s\t%s\n' "$(repo_slug "$cwd")" "$sid" >> "$CACHE/owners"
      fi
    elif [ "$g" = 1 ]; then main_health "$cwd" >/dev/null; fi
    bucket="$(session_bucket "$status" "$plan" "$asks" "$hv" "$idle" "$g" "$dirty" "$ahead" \
              "$pr" "$state" "$ci" "$inpr" "$red" "$phases" "$pnext")"
    fin=0; session_finished "$status" "$plan" "$asks" "$hv" "$idle" "$g" "$dirty" "$ahead" \
             "$pr" "$state" "$ci" "$inpr" "$red" "$phases" "$pnext" && fin=1
    fact="$bucket"; [ "$pr" != - ] && fact="$fact @$branch"
    local n=0 e=0 dsp=-; nudged "$sid" "$fact" && n=1; escalated "$sid" "$fact" && e=1
    [ -f "$DISPATCH_LIVE/$tsess" ] && dsp="$(sed -n 's/^label=//p' "$DISPATCH_LIVE/$tsess" | head -1)"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t-\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${bucket%% *}" "$target" "$sid" \
      "$cwd" "$branch" "$pr" "$idle" "$ctx" "$planf" "$n" "${bucket#* }" "${pane:--}" "$e" "${dsp:--}" \
      "$pdone" "$ptotal" "$pnext" "$fin" "$behind" "$conflicts" "$state" "$ci" "$dirty" "$ahead" \
      "$(labels_of "$sid")"
  done
  main_rows
}

# One MAIN row per red repo seen this pass. Its ledger id is main-<repo slug>, so the shepherd
# escalates a red main once per fact; owners are the live sessions whose merge is a suspect.
main_rows() {
  local f slug st wfs sha prs repo sid reason owners e
  for f in "$CACHE"/main_*; do
    [ -f "$f" ] || continue
    IFS=$'\t' read -r st wfs sha prs repo < "$f"
    slug="${f##*/main_}"; sid="main-$slug"
    case "$st" in
      RED) reason="$repo red: $wfs" ;;
      UNKNOWN) reason="$repo main CI unreadable (gh run list failed)" ;;
      *) continue ;;
    esac
    owners="$(awk -F'\t' -v s="$slug" '$1 == s { print $2 }' "$CACHE/owners" 2>/dev/null | paste -sd, -)"
    e=0; escalated "$sid" "MAIN $reason" && e=1
    printf 'MAIN\t%s\t%s\t-\t-\t-\t0\t0\t-\t0\t%s\t-\t%s\t%s\t-\t-\t-\t-\t0\t-\t-\t-\t-\t-\t-\t-\n' "$repo" "$sid" "$reason" "$e" "${owners:--}"
  done
}

# --- watch: the stage board -------------------------------------------------------------
# board_cells: collect's rows on stdin -> one line per session, in bucket order:
#   sid target sync conflicts tree pr ci plan quality stage labels idle reason
# Columns 3-11 are the stages a transition is read from; idle moves every tick and reason
# rides along to explain a stage change. MAIN rows are rendered separately.
board_cells() {
  awk -F'\t' -v OFS='\t' '
    BEGIN { n = split("NEEDS STALLED DONE LANDED UNCLEAR WORKING", o, " "); for (i = 1; i <= n; i++) rank[o[i]] = i }
    $1 == "MAIN" { next }
    {
      t = $2; sub(/^[^\/]*\//, "", t)
      git = ($5 != "-")
      sync = !git || $20 == "-" ? "-" : ($20 == 0 ? "current" : $20 " behind")
      conf = !git ? "-" : ($21 == "yes" ? "CONFLICT" : $21)
      tree = !git ? "-" : ($24 > 0 ? $24 " dirty" : ($25 > 0 ? $25 " ahead" : "clean"))
      pr = $6 == "-" ? "-" : "#" $6 " " tolower($22)
      ci = $23 == "-" ? "-" : tolower($23)
      plan = $16 == "-" ? "-" : $16 "/" $17
      q = ""; l = ""
      m = split($26 == "-" ? "" : $26, ls, ",")
      for (i = 1; i <= m; i++)
        if (ls[i] ~ /^quality:/) q = q (q == "" ? "" : ",") substr(ls[i], 9)
        else l = l (l == "" ? "" : ",") ls[i]
      print (rank[$1] ? rank[$1] : 9), $3, t, sync, conf, tree, pr, ci, plan,
            (q == "" ? "-" : q), $1, (l == "" ? "-" : l), $7 "m", $11
    }' | sort -t$'\t' -k1,1n -k3,3 | cut -f2-
}

# transitions <previous cells file> <current cells file> -> one line per session that
# appeared, left, or changed a stage cell: "target  ci pending -> fail, stage ... (reason)".
transitions() {
  awk -F'\t' '
    BEGIN { split("- - sync conflicts tree pr ci plan quality stage labels", name, " ") }
    NR == FNR { prev[$1] = $0; next }
    {
      seen[$1] = 1
      if (!($1 in prev)) { print $2 "  new: " $10 " (" $13 ")"; next }
      split(prev[$1], p, "\t"); out = ""
      for (i = 3; i <= 11; i++)
        if (p[i] != $i) out = out (out == "" ? "" : ", ") name[i] " " p[i] " -> " $i
      if (out != "") print $2 "  " out (p[10] != $10 ? " (" $13 ")" : "")
    }
    END { for (s in prev) if (!(s in seen)) { split(prev[s], p, "\t"); print p[2] "  gone" } }' "$1" "$2"
}

# watch_tick -> one frame: run a pass, log what moved since the last tick (any watcher's: the
# state file is shared and locked, so two boards log each change once), then the board.
watch_tick() {
  local rows cur new f now
  CACHE="$(mktemp -d)"; trap 'rm -rf "$CACHE"' EXIT # runs in $(...), so this is its own exit
  rows="$(collect)"
  cur="$CACHE/cells"; board_cells <<<"$rows" > "$cur"
  now="$(date '+%Y-%m-%d %H:%M')"
  mkdir -p "$LEDGER"
  # A blind pass keeps the last good state: what it could not read did not change.
  [ -s "$CACHE/unreadable" ] && cp "$LEDGER/watch.state" "$cur" 2>/dev/null
  (
    flock 9
    if [ -s "$CACHE/unreadable" ]; then :
    elif [ -f "$LEDGER/watch.state" ]; then
      new="$(transitions "$LEDGER/watch.state" "$cur")"
      [ -n "$new" ] && sed "s/^/$now  /" <<<"$new" >> "$LEDGER/watch.log"
    fi
    cp "$cur" "$LEDGER/watch.state"
  ) 9>"$LEDGER/watch.lock"

  printf 'fleet watch  %s  %s session(s)\n' "$(date +%H:%M:%S)" "$(wc -l < "$cur")"
  [ -s "$CACHE/unreadable" ] && printf 'could not read %s this tick: showing the last good board, no changes logged\n' \
    "$(sort -u "$CACHE/unreadable" | paste -sd, - | sed 's/,/, /g')"
  echo
  if [ -s "$LEDGER/watch.log" ]; then
    tail -n "$FLEET_WATCH_LOG_LINES" "$LEDGER/watch.log"; echo
  fi
  f='%-34.34s %-10s %-9s %-9s %-13s %-8s %-5s %-12s %-8s %-16.16s %5s  %.60s\n'
  # shellcheck disable=SC2059
  printf "$f" SESSION SYNC CONFLICTS TREE PR CI PLAN QUALITY STAGE LABELS IDLE WHY
  while IFS=$'\t' read -r _ t sync conf tree pr ci plan q stage l idle why; do
    # shellcheck disable=SC2059
    printf "$f" "$t" "$sync" "$conf" "$tree" "$pr" "$ci" "$plan" "$q" "$stage" "$l" "$idle" "$why"
  done < "$cur"
  awk -F'\t' '$1 == "MAIN" { if (!h++) print "\nMAIN"; print "  " $11 }' <<<"$rows"
}

# paint: colour the words that need an eye, only on a terminal and without NO_COLOR.
paint() {
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    sed -E -e $'s/\\b(STALLED|NEEDS|CONFLICT|fail|red)\\b/\033[31m&\033[0m/g' \
           -e $'s/\\b(DONE|pass)\\b/\033[32m&\033[0m/g' -e $'s/\\b(LANDED|pending)\\b/\033[33m&\033[0m/g'
  else cat; fi
}

# watch [--every N] [--once]: redraw the board every N seconds (FLEET_WATCH_EVERY); on a
# terminal, n redraws now and q quits. --once draws one frame and exits.
watch() {
  local every="$FLEET_WATCH_EVERY" once=0 key frame
  while [ $# -gt 0 ]; do
    case "$1" in
      --every) every="${2:-}"; shift 2 || shift ;;
      --once) once=1; shift ;;
      *) echo "usage: fleet-sessions watch [--every N] [--once]" >&2; return 2 ;;
    esac
  done
  [[ "$every" =~ ^[1-9][0-9]*$ ]] || { echo "fleet-sessions: --every takes whole seconds" >&2; return 2; }
  export FLEET_FETCH=1
  while :; do
    frame="$(watch_tick)"
    [ -t 1 ] && printf '\033[H\033[2J'
    printf '%s\n' "$frame" | paint
    [ "$once" = 1 ] && return 0
    if [ -t 0 ]; then
      printf '\nnext tick in %ss - n run now - q quit' "$every"
      key=""; read -rsn1 -t "$every" key
      [ "$key" = q ] && { echo; return 0; }
    else
      sleep "$every"
    fi
  done
}

main() {
  case "${1:-}" in
    mark) shift; mark "$@"; return ;;
    escalate) shift; escalate "$@"; return ;;
    label) shift; label "$@"; return ;;
    watch) shift; watch "$@"; return ;;
    -h|--help) sed -n '2,13p' "$0"; return ;;
  esac
  CACHE="$(mktemp -d)"; trap 'rm -rf "$CACHE"' EXIT
  local rows
  rows="$(collect)"
  if [ "${1:-}" = --json ]; then
    [ -n "$rows" ] && jq -cR 'split("\t") | {bucket: .[0], target: .[1], session_id: .[2],
      cwd: .[3], branch: .[4], pr: .[5], idle_min: (.[6] | tonumber), context_tokens: (.[7] | tonumber),
      plan_file: .[8], nudged: (.[9] == "1"), reason: .[10], pane: .[11], escalated: (.[12] == "1"),
      owners: (if .[13] == "-" then [] else .[13] | split(",") end),
      dispatch: (if .[14] == "-" then null else .[14] end),
      phases_done: (if .[15] == "-" then null else .[15] | tonumber end),
      phases_total: (if .[16] == "-" then null else .[16] | tonumber end),
      next_phase: (if .[17] == "-" then null else .[17] end), finished: (.[18] == "1"),
      behind: (if .[19] == "-" then null else .[19] | tonumber end),
      conflicts: (if .[20] == "-" then null else .[20] == "yes" end),
      pr_state: (if .[21] == "-" then null else .[21] end), ci: (if .[22] == "-" then null else .[22] end),
      dirty: (if .[23] == "-" then null else .[23] | tonumber end),
      ahead: (if .[24] == "-" then null else .[24] | tonumber end),
      labels: (if .[25] == "-" then [] else .[25] | split(",") end),
      fact: (.[0] + " " + .[10] + (if .[5] != "-" then " @" + .[4] else "" end))}' <<<"$rows"
    return 0
  fi
  local b
  for b in MAIN NEEDS STALLED DONE LANDED UNCLEAR WORKING; do
    awk -F'\t' -v b="$b" '$1 == b' <<<"$rows" | sort -t$'\t' -k2 | {
      first=1
      while IFS=$'\t' read -r _ target _ _ branch pr idle _ _ n reason _ _ _ dsp _ _ _ _ _ _ _ _ _ _ lbl; do
        [ "$first" = 1 ] && { echo "$b"; first=0; }
        printf '  %-44s %-28s %-6s %4sm  %s%s%s%s\n' "${target#*/}" "$branch" "$pr" "$idle" "$reason" \
          "$([ "$n" = 1 ] && echo '  (nudged)')" "$([ "${dsp:--}" != - ] && echo "  [dispatch: $dsp]")" \
          "$([ "${lbl:--}" != - ] && echo "  [labels: $lbl]")"
      done
    }
  done
}

# Sourceable for tests (session_bucket, main_state, nudged, mark, escalate); runs main only when executed.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
