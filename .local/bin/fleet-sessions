#!/usr/bin/env bash
# fleet-sessions - where is each live Claude session in its delivery, and does it need anyone?
#
#   fleet-sessions                    one row per session, grouped by bucket, from the state document
#                                     (under a second); its age is the first line, and one older than
#                                     FLEET_STATE_STALE_SECS exits 1 naming --fresh. On a fleet worker
#                                     it reads the lease holder's pushed rows: this host's sessions only
#   fleet-sessions --fresh            the same table from a full pass (about a minute)
#   fleet-sessions --json             the same, one JSON object per line (for the shepherd)
#   fleet-sessions --write            --json, and the fleet state document every view renders
#                                     ($FLEET_STATE_FILE; schema and vocabulary in
#                                     .local/src/docs/fleet-states.md), each session with its
#                                     eta from `fleet-bench eta`, and fleet_sessions.prom (lease holder only)
#   fleet-sessions mark <sid> <fact>  record that <fact> was nudged, so it is nudged once
#   fleet-sessions mark --close <sid>  record that the session was typed its close, once for good
#   fleet-sessions mark --release <sid>  give back a close claim nothing was typed into
#                                     (each claim or release is also appended to nudges.jsonl)
#   fleet-sessions escalate <sid> <fact>  record that <fact> went to the human, so it pages once
#                                     (both refuse, exit 3, outside the pass holding the
#                                     shepherd lease: fleet-shepherd holds)
#   fleet-sessions label <who> [+name|-name|^name ...]  set, clear, flip or (no ops) print a
#                                     session's labels; each change also lands on its tmux window
#   fleet-sessions tick               --write after a fetch, plus the stage changes since the
#                                     last tick appended to watch.log (fleet-state.service, every
#                                     minute and on each ask change); the hub Sessions tab. Only
#                                     the fleet lease holder ticks; elsewhere it skips, exit 0
#   fleet-sessions explain <who>      one session from the state document: its task, plan, PRs,
#                                     where its time went, and what it is doing
#   fleet-sessions close [--json]     the close analysis from the state document: each session's
#                                     verdict (now, after <step>, keep), progress, eta and why,
#                                     close-now first (CLOSE_JQ; the shepherd skill's triage verb)
#   fleet-sessions close --self [<sid>]  this session's verdict from a fresh pass, as at the end of
#                                     its turn, then its blockers; exit 0 on now (/wind-down auto). On a
#                                     fleet worker it reads the lease holder's pushed row, not a pass
#   fleet-sessions stages [--from EPOCH] [--to EPOCH] [--json]  watch.log replayed over a window
#                                     (default the last 24h): minutes and episodes per stage and
#                                     reason, CI runs and reruns, PR open to merged, conflicts,
#                                     phase ticks, per project (.local/lib/fleet-stages.py)
#
# Buckets: PARKED, NEEDS, STALLED, WORKING, LANDED, DONE and CHAT, one per session, plus one NIGHTLY
# row per repo whose default branch is red, one SHARED row per test red on several branches at once
# and one CHECKOUT row per deployed checkout off its default branch. Each is defined once, with its entry facts, exit,
# actor, action and pinning test, in the bucket table of .local/src/docs/fleet-states.md, and
# tests/unit/fleet_states_doc.bats fails when the words emitted here differ from that table.
# The --json `finished` field is DONE without the idle and status checks, so a session can check
# its own row mid-turn, and `blockers` lists every reason it is false.
# Facts come from agent-panel, git, gh and the ask queue; no model. The shepherd skill's
# `status` and `nudge` verbs read this. Thresholds are the FLEET_* block below.

set -uo pipefail

# --write also publishes the rows to Prometheus (fleet_sessions.prom), on the fleet-lease holder only.
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/prom-textfile.sh"
# The board counts a session's PRs the way the nightly outcomes do (so_transcript_metrics).
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/session-outcomes.sh"
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/plan-phases.sh"
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/main-state.sh"
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/origin-repo.sh"
# shellcheck source=../lib/tmux-servers.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/tmux-servers.sh" || exit 1   # tmux_servers_all
# A PR's check rollup as NONE, PENDING, FAIL or PASS (ci), and its red job ids (red): CI_JQ.
# shellcheck source=/dev/null
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/pr-ci.sh"
# FLEET_MAIN_TTL: seconds a gh answer (sibling_pr's PR view) is reused across passes: every caller
# (the ask watcher, fleet-bench, the shepherd, the board) runs a pass, and on 2026-10-29 the fleet
# spent GitHub's 5,000/hr REST limit; a PR's state is no less true five minutes later.
: "${FLEET_MAIN_TTL:=300}"
# FLEET_BASE_TTL: seconds a repo's default branch is reused across passes. It was one `gh repo view` per
# repo per pass (287 of the 4,651 calls in the hour the budget ran out, 2026-11-13 05:35Z) for a name
# that changes about never; the canonical remote's HEAD symref is the offline fallback either way.
: "${FLEET_BASE_TTL:=3600}"
# Each fleet worker's sessions are rows too (remote_panel_lines).
# shellcheck source=../lib/fleet-hosts.sh
. "${FLEET_HOSTS_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/fleet-hosts.sh}"
# merge_proof_branch and merge_proof_ref: the one reader of a repo's default branch (default_base, off_default_checkouts, wp_base).
# shellcheck source=../lib/agent-merge-proof.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/agent-merge-proof.sh"
# ahead_files, unlanded_files and dirty_paths: one definition, which the worker panel read runs on each worker too.
# shellcheck source=../lib/fleet-worker-panel.sh
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/fleet-worker-panel.sh"

# --- thresholds (env overrides) --------------------------------------------------------
: "${FLEET_IDLE_MIN:=20}"   # idle fewer minutes than this -> still WORKING (just ended a turn)
# The close verdict (CLOSE_JQ): a session with nothing left to land or answer in its pane closes
# once quiet this long, quiet being the smaller of idle and age (provisional, 2026-11-17: the human
# asked for one static timer in place of the human and coordinator keeps; revisit if a window closes
# while the human is mid-way through it).
: "${FLEET_IDLE_CLOSE_MIN:=60}"
# A session the human labelled `chat` (fleet-sessions label <who> +chat) is their conversation and
# stays until quiet this many hours, then closes like any other (provisional, 2026-11-18: the human
# asked for 24h on a chat and 60m on everything else, hand-opened sessions included; revisit if a
# chat closes while the human still means to come back to it, or chats pile up overnight).
: "${FLEET_CHAT_CLOSE_H:=24}"
: "${FLEET_API_ERROR_IDLE_MIN:=2}" # an idle session this many minutes past its own stop line (an API Error, a resume that killed its gate) is stopped, not working
: "${FLEET_TIME_USE_CONF:=$HOME/.config/agent-panel/time-use.conf}" # agent-panel's gate, test and build texts (gate_text, live_wait)
: "${FLEET_SHELL_STALE_MIN:=120}" # a background shell this long past the last entry is not work:
                                  # a real gate wait is under an hour, a forgotten ugrep is not
: "${FLEET_GATE_LOGS:=Logs/gate.txt Logs/gate-and-land.out}" # files under a session's worktree a running local gate writes to: a write
                                  # within the transcript's idle minutes is activity (gate_log_idle, ar-42)
: "${FLEET_QUEUE_GATES:=gate-and-land.sh|ci-gate.sh|gate-line.py --recheck|agent-land}" # processes that are a gate waiting for its landing turn
                                  # behind another PR or on its checks (a gate polls every 120s, gives up after 280m; agent-land
                                  # waits on a queued run with no limit, and ends itself): live, never idle, whatever the output age
: "${HUNG_REASON:=background shell is waiting on itself (tail --pid of its own parent)}"
: "${FLEET_DIRTY_NAMES:=3}" # a dirty-file reason names this many paths, then "+N more"
: "${FLEET_ITEM_DAYS:=7}" # days of done queue items read to see that a session's item moved on
: "${FLEET_OVERDUE_MIN:=60}" # the least a phase runs before it can be overdue, whatever its eta (overdue_of)
: "${FLEET_SUSPECTS_MAX:=3}" # a red workflow names its PRs as suspects only up to this many; past
                             # it (a nightly suite after a busy day) nobody can be told it was theirs
# One test failing on this many branches within this many minutes is a SHARED row: a shared cause
# (the base, a runner, a flaky test), not any one branch's work. 3 in 2h hit about 4 tests a day in
# the week to 2026-11-06.
: "${FLEET_SHARED_RED_BRANCHES:=3}"
: "${FLEET_SHARED_RED_MIN:=120}"
# Run names (ERE) of the dispatched workflows that gate a PR (gate_ci). Tests is unity-core-playground's
# pool gate, `Tests (affected)` from ci-gate.sh; a dispatched Multi, Shots or tour is not a merge gate,
# and counting one held ready PRs at CI red.
: "${FLEET_GATE_WORKFLOWS:=^Tests( |$)}"
# Job step names (ERE) that stay red until that gate finishes: unity-core-playground's Checks ends
# with its Merge gate line step (gate-line.py), red while the Tests run is still going, and stays a
# red check because it is the merge block. A PR whose red jobs failed only in such steps reads CI
# running while a gate on its head runs (gate_ci, ar-82).
: "${FLEET_GATE_LINE_STEPS=^Merge gate line$}" # empty: off
# Branch prefix of a landing train's PR: unity-core-playground scripts/test/train.py merges the queue's PRs
# onto train/<utc>, gates that once and titles it "chore(train): land #a, #b", the members it names. A member's
# own Checks stays red meanwhile (the landing slot turns it away, or "re-gate: main changed"), and that is the
# train's wait, not the session's (ar-2160: agent-7 #2415, agent-28 #2417 and agent-31 #2444 on train #2467,
# 2026-11-13, each read STALLED CI red and was nudged while its PlayMode shard sat queued). Empty: off.
: "${FLEET_TRAIN_BRANCH=train/}"
# Label of a PR waiting its landing turn: unity-core-playground gate-line.py labels each PR queued for the landing
# slot, and its Checks stays red (the slot refuses it) or green-not-merged until its turn; a claim whose waiter is
# gone rides a train or loses its label, so the label alone is the wait (ar-1285: 2026-11-10 agent-2 #2149, 4th of 9
# in the queue, read STALLED CI red while its turn had not come). Empty: off.
: "${FLEET_QUEUE_LABEL=landing-queue}"
# Labels of the slot holder and of a waiter seated ahead of claim order (gate-line.py SLOT and URGENT), read for
# a held PR's place in the queue (queue_place). Empty: off.
: "${FLEET_SLOT_LABEL=landing-slot}"
: "${FLEET_URGENT_LABEL=landing-urgent}"
# Run names (Oniguruma) of runs on a default branch that test only part of a workflow's suite, so they say
# nothing about main's health (main_state): unity-core-playground titles its scope in run-name, and
# a hand `Multi (named)` passing a few classes does not clear the nightly `Multi (all)` red before it.
: "${FLEET_PARTIAL_RUNS:=\((named|affected)\)$}"
# Workflow titles (ERE) of default-branch runs that probe a deployment, not the branch's code: the platform's
# hourly `Binks Production Smoke` runs on develop but tests live binks.chat from binks-v* tags, so a red one
# names no PR in its range as suspect (main_health; ar-3072: platform #1602 was nudged for a red that
# predated it). The red still reads as the repo's NIGHTLY row. Empty: off.
: "${FLEET_DEPLOY_PROBES=Production Smoke}"
# The gates' per-test failures, one line each: epoch, worktree, branch (- when detached), test. The
# local gate writes the first; pool-test-failures sync writes the runner pool's from its artifacts.
TEST_FAILURES="${UNITY_TEST_FAILURES:-${XDG_STATE_HOME:-$HOME/.local/state}/unity-test-runs/test-failures.tsv}"
POOL_FAILURES="${UNITY_POOL_FAILURES:-${XDG_STATE_HOME:-$HOME/.local/state}/unity-test-runs/pool-failures.tsv}"
LEDGER="${FLEET_SHEPHERD_DIR:-$HOME/.agent/shepherd}"
STATE_FILE="${FLEET_STATE_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/fleet/state.json}"
ASK_ROOT="${AGENT_ASK_ROOT:-$HOME/.agent/asks}"
# The agent store: store-sync commits and pushes it every 15 minutes, so a file a session wrote
# there (a lesson, a plan, its wind-down note) is never unlanded work. Counting it held finished
# sessions STALLED and kept them on the pace target (2026-11-19).
AGENT_STORE="${AGENT_STORE_DIR:-$HOME/.agent}"
# The notes vault is the second store-sync store (`store-sync --store notes`), landed the same way.
NOTES_STORE="${NOTES_DIR:-$HOME/.notes}"
# The kind registry fleet-dispatch routes by: a kind whose `exit` is doc+ask finishes on a doc and an
# ask, not a PR (handoff_of).
KINDS="${DISPATCH_KINDS:-$HOME/.config/fleet-dispatch/kinds.json}"
# A session working a queue item is named by that item's `session:` (<server>:<tmux session>, a
# bare name on this server); its "<project>: <slug>" is shown so the shepherd knows what it works.
# claude-acct park writes one ledger per tmux session whose claude it exited to save usage.
# Such a session has no claude, so agent-panel cannot list it; the pass lists it from here.
PARKED_DIR="${CLAUDE_ACCT_PARKED_DIR:-$HOME/.agent/parked}"
# Labels say what git, gh and the transcript cannot: a human's `manual` (the shepherd
# leaves that session alone and never closes it; `label self` cannot set it), a session's own
# `stay` on the human's order to stay open (wind-down step 0, coordinate; it keeps until quiet
# FLEET_CHAT_CLOSE_H), a session's own `quality:<step>` while a cleanup pass runs, or
# `shepherd` on the fleet-shepherd pass itself, which is listed but left out of every count.
# One file per session id, one label per line. Stages are derived every pass, never stored.
LABELS="$LEDGER/labels"
# The bucket vocabulary, written once: state.json `vocab` and the agent_session_bucket gauge carry it
# to every reader (agent-web, hub, waybar, agent-panel, the phone), so none keeps its own list.
# BUCKET_ORDER is what needs the human first; BUCKET_FINISHED is a session whose work is done, so it
# is ready to wind down; BUCKET_IN_PROGRESS is a session an agent or the human still has to move.
BUCKET_ORDER="NEEDS STALLED DONE LANDED CHAT WORKING PARKED"
BUCKET_FINISHED="DONE LANDED"
BUCKET_IN_PROGRESS="WORKING NEEDS STALLED"

# session_bucket <status> <plan: 1 when status is waiting on an ExitPlanMode approval, else 0> <asks> <heavy 0|1> <idle_min> <git 0|1> \
#                <dirty> <ahead> <pr#|-> <pr_state|-> <ci PASS|FAIL|NOSTART|PENDING|NONE|-> <head_in_pr 0|1> \
#                <main_red: workflows this session's merged PR is a suspect for, or -> \
#                <phases: - (no plan file) | missing (a recorded plan file that is nowhere) | none (no checklist) | done/total> <next phase|-> \
#                <conflicts: yes|no|- (merging the default branch in would conflict)> \
#                <open job: gate|queue|test|build|checkout|agent|human|jobs|none|hung|wait|- (agent-panel's open_job, or a live gate/test/build process in the worktree or under its claude: live_wait; hung: self_wait, a shell waiting on itself; wait: self_wait, a tail --pid on another process; - unknown)> \
#                <dirty names: the first dirty paths, shown beside the count, or -> \
#                <landed: this session's own PRs ("#N,#M") when its transcript names a merged one,
#                 none open and every state known (a closed one was replaced or dropped), else
#                 the merged PR its done queue item recorded (a landing train's), or -;
#                 a session in the main checkout lands from worktrees, so its branch never has
#                 a PR of its own>
#                <item: the queue item this session worked, by its sessions: or session:, as
#                 own:<slug>[,<slug>...] while one runs here, moved:<slug> (<where>) once it is done,
#                 requeued or running in another session, here:<slug> waiting here,
#                 review:<slug> pr <n|-> parked here in review (<n>, the item's PR, is handed off), or ->
#                [<landing wait: "train #T", the open landing train the OPEN PR rides (train_of), "the landing queue" (queued_in),
#                 "slot holder #H", the PR whose slot refused it (slot_refuser), or ->]
#                [<cron: yes when a recurring cron the session scheduled is still live (wake_facts), or ->]
#                [<merged PRs: work_blockers' 23rd, - here>]
#                [<carried: the live items its own running items filed (carried_by), comma-separated, or ->]
#   -> "BUCKET reason"
# <git> is 1 in a repo, 0 outside one, gone when the cwd itself no longer exists (a reaped worktree).
# Who must act decides before whether the session is active: an ask waits on the human, and
# a PR that is otherwise ready but cannot merge wastes the wait, however busy the session is.
# Ready is green checks, or no checks and the session idle. A conflict on a red or running PR
# only rides along in the reason of its other bucket: resolving it before the PR is ready
# invites the next conflict and a fresh gate. On 2026-11-02 main's submodule pin moved
# several times and ~30 open PRs drew 55 conflict nudges in 6h, most of them not ready.
session_bucket() {
  local st="$1" note="" cn=""
  # Parked on purpose: its claude is gone, so a message would wake nothing, and nothing in it
  # moves until it is unparked.
  [ "$st" = parked ] && { echo "PARKED claude exited to save usage; claude-acct unpark resumes it"; return; }
  # A headless run's replay (agent-core status done): the run ended and its pane shows the transcript.
  # Its item, not this tree, carries the work, and the close flow keeps it for fleet-dispatch reap.
  [ "$st" = done ] && { echo "DONE headless run ended; its window shows the transcript until fleet-dispatch reap closes it"; return; }
  if [ "$st" = waiting ]; then
    [ "$2" = 1 ] && echo "NEEDS plan awaiting approval" || echo "NEEDS waiting on a prompt or permission"
    return
  fi
  # A session with an open question carries on with what does not depend on the answer. The
  # bucket stays NEEDS (the human still owes the answer), but one whose activity alone would read
  # WORKING busy or shell says so, and keeps WORKING's overdue check. Asking the rules below with no
  # ask keeps one definition of working.
  if [ "$3" -gt 0 ]; then
    case "$(session_bucket "$1" "$2" 0 "${@:4}")" in
      "WORKING busy"* | "WORKING shell"* | "WORKING subagent"*) echo "NEEDS $3 pending ask(s), carrying on" ;;
      *) echo "NEEDS $3 pending ask(s)" ;;
    esac
    return
  fi
  if [ "${10}" = OPEN ] && [ "${16:--}" = yes ]; then
    case "${11}" in
      PASS) echo "STALLED PR #$9 conflicts with the default branch"; return ;;
      FAIL|NOSTART|PENDING) ;;
      *) [ "$st" = idle ] && [ "$5" -ge "$FLEET_IDLE_MIN" ] \
           && { echo "STALLED PR #$9 conflicts with the default branch"; return; } ;;
    esac
    cn=", conflicts with the default branch"
  fi
  # A background subagent's work lands in its own worktree, so this tree's facts (clean, merged,
  # all phases ticked) say nothing about it until it ends: 2026-11-03 agent-10 read DONE and
  # agent-56 LANDED mid-phase. A gate or test left running past a finished plan is not its work.
  local job="${17:--}"
  case "$st" in
    busy) echo "WORKING busy$cn"; return ;;
    idle)
      # Claude writes shell only for a background Bash; a background subagent leaves it idle.
      if [ "$job" = agent ] && [ "$5" -ge "$FLEET_IDLE_MIN" ]; then
        [ "$5" -lt "$FLEET_SHELL_STALE_MIN" ] && { echo "WORKING subagent running$cn"; return; }
        note=", subagent running over ${FLEET_SHELL_STALE_MIN}m"
      fi ;;
    shell)
      # A finished plan is not waiting on its shell: DONE tells it to stop the shell first.
      if [ "$5" -ge "$FLEET_IDLE_MIN" ] && [ "$job" != agent ] && session_finished "$@"; then
        note=", background shell still running"
      elif [ "$5" -ge "$FLEET_IDLE_MIN" ] && [ "$job" = hung ]; then
        # 2026-11-09 agent-51 read WORKING for 100m on a shell waiting for its own parent to exit.
        note=", $HUNG_REASON"
      elif [ "$5" -ge "$FLEET_IDLE_MIN" ] && { [ "$job" = jobs ] || [ "$job" = none ]; }; then
        # Only a gate, a test, a build, a checkout, a subagent or an event wait is work worth waiting 120m on. Anything else is a sleep
        # loop, a watch on a file or a job the transcript no longer shows; on 2026-11-03 13 of 24
        # "WORKING shell" sessions were one of those, idle up to 107m, and nothing looked at them.
        note=", background shell is not a gate or test"
      elif [ "$5" -lt "$FLEET_SHELL_STALE_MIN" ] || [ "$job" = queue ]; then
        # queue: a live landing-queue gate outlasts the threshold by design and ends itself (ar-2346).
        echo "WORKING shell$cn"; return
      else
        # The threshold, not the minutes: a reason that changed every pass would re-nudge every pass.
        note=", background shell idle over ${FLEET_SHELL_STALE_MIN}m"
      fi ;;
  esac
  echo "$(bucket_facts "$@")$cn$note"
}

# queue_match <cmdline> <gate>: true when every word of <gate> is a whole argument of <cmdline> (a path
# ending in it counts, `--recheck=1` for `--recheck`), so `gate-line.py --repo x --recheck` matches
# and `tail -f ci-gate.sh.log` or an editor on the script do not.
queue_match() {
  local c=" $1" w
  case "$c" in " vim "* | " vi "* | " nvim "* | " nano "* | " less "* | " cat "* | " bat "* | " head "* | " tail "* | " grep "* | " rg "* | " shellcheck "* | " ugrep "* | " ag "* | " watch "* | " pgrep "* | " pkill "* | " man "* | " git "*) return 1 ;; esac
  for w in $2; do
    case "$c" in *" $w "* | *"/$w "* | *" $w="* | *"/$w="*) ;; *) return 1 ;; esac
  done
}

# queue_gate <cmdline>: true when <cmdline> is one of FLEET_QUEUE_GATES (queue_match).
queue_gate() {
  local text
  local -a qg=(); IFS='|' read -ra qg <<<"$FLEET_QUEUE_GATES"
  for text in "${qg[@]}"; do queue_match "$1" "$text" && return 0; done
  return 1
}

# proc_snapshot <prefix>: every process's "pid<TAB>ppid" in <prefix>.ppid and "pid<TAB>cwd" in <prefix>.cwd.
proc_snapshot() {
  ps -e -o pid=,ppid= 2>/dev/null | awk '{ print $1 "\t" $2 }' > "$1.ppid"
  ls -l /proc/[0-9]*/cwd 2>/dev/null | sed -nE 's|^.* /proc/([0-9]+)/cwd -> (.*)$|\1\t\2|p' > "$1.cwd" || :   # ls fails on a process that exits mid-read, whatever it listed
}

# gate_log_idle <host|-> <status> <open job> <cwd> <idle min> [<transcript>] -> the idle minutes the bucket reads. For
# a local session whose shell is a gate or test, the age of the newest FLEET_GATE_LOGS file under the worktree, or of
# an open background task's output file (open_outputs), when it is under <idle min>; otherwise <idle min>. A local
# suite.sh gate prints into Logs/gate.txt while the transcript sees nothing (2026-11-04 agent-23 read "background
# shell idle over 120m" with ~80 classes done), and a gate in the landing-slot wait prints a line a minute
# (2026-11-10 agent-92's gate-and-land.sh, 2h behind #2103, read STALLED CI red, ar-1334). The mtime is the event; a
# gate that ended leaves a log whose age only grows. idle_min and the wake and close reads keep the transcript's own idle.
gate_log_idle() {
  local idle="$5" f m age root
  local -a logs=()
  [ "$1" = - ] && [ "$2" = shell ] && { [ "$3" = gate ] || [ "$3" = test ]; } || { echo "$idle"; return; }
  # The worktree root, so a session started in a subdirectory finds the same log; no glob expands.
  root="$(git -C "$4" rev-parse --show-toplevel 2>/dev/null)" || root="$4"
  read -ra logs <<<"$FLEET_GATE_LOGS"
  logs=("${logs[@]/#/$root/}")
  [ -z "${6:-}" ] || mapfile -t -O "${#logs[@]}" logs < <(open_outputs "$6")
  for f in "${logs[@]}"; do
    m="$(stat -c %Y "$f" 2>/dev/null)" || continue
    age=$(( ($(date +%s) - m) / 60 ))
    [ "$age" -ge 0 ] && [ "$age" -lt "$idle" ] && idle="$age"
  done
  echo "$idle"
}

# bash_command <transcript> <tool_use id> -> the command of the Bash call with that id, or nothing. Only the lines
# naming the id reach jq: a transcript runs to 100 MB.
bash_command() {
  grep -F "\"id\":\"$2\"" "$1" 2>/dev/null | jq -r --arg id "$2" 'select(.type == "assistant")
    | .message.content[]? | select(.type? == "tool_use" and .id == $id and .name == "Bash") | .input.command // empty' 2>/dev/null
}

# gate_text <command> -> "<kind> <text>" of the first `gate` or `test` line of agent-panel's time-use.conf whose text is
# in <command>, or nothing (no command, no conf, no match).
gate_text() {
  local conf="$FLEET_TIME_USE_CONF" kind text
  [ -n "$1" ] && [ -r "$conf" ] || return 0
  while read -r kind text; do
    { [ "$kind" = gate ] || [ "$kind" = test ]; } && [ -n "$text" ] || continue
    case "$1" in *"$text"*) printf '%s %s\n' "$kind" "$text"; return 0 ;; esac
  done < "$conf"
}

# open_tasks <transcript> -> "<tool_use id><TAB><output file>" of each background Bash task the transcript started that no
# <task-notification> closed, one a line. Claude writes a background Bash's output to that file, so its mtime is the task's
# last line. It reads Claude Code's own wording: a tool result's "Output is being written to: <path>.output"
# (run_in_background, or a call moved to the background at its timeout) and a notification's <output-file>, so a reworded
# transcript reads no task and the bucket falls back to transcript idle (pinned by "a gate shell whose open output file is
# still being written ..." in tests/unit/fleet_sessions.bats). Only the lines holding those strings reach jq: a transcript
# runs to 100 MB.
open_tasks() {
  [ -r "$1" ] || return 0
  grep -F -e 'Output is being written to: ' -e '<output-file>' "$1" | jq -R -r '
      fromjson? | select(type == "object")
      | (select(.type == "user") | .message.content | arrays | .[] | select(.type? == "tool_result") | . as $t
         | $t.content | tostring | capture("Output is being written to: (?<p>[^\"\\\\]+?\\.output)")
         | "O\t\($t.tool_use_id)\t\(.p)"),
        (tostring | scan("<output-file>([^<]+)</output-file>") | "D\t-\t\(.[0])")' 2>/dev/null \
    | awk -F'\t' '$1 == "O" && !($3 in seen) { seen[$3] = 1; id[++n] = $2; p[n] = $3 } $1 == "D" { closed[$3] = 1 }
        END { for (i = 1; i <= n; i++) if (!(p[i] in closed)) print id[i] "\t" p[i] }'
}

# open_outputs <transcript> -> the output file of each open background Bash task (open_tasks) whose command matches a `gate`
# or `test` line of agent-panel's time-use.conf; a dev server or poll loop beside a hung gate is not the gate (ar-1334 review).
open_outputs() {
  local id path
  [ -r "$1" ] && [ -r "$FLEET_TIME_USE_CONF" ] || return 0
  while IFS=$'\t' read -r id path; do
    [ -z "$(gate_text "$(bash_command "$1" "$id")")" ] || printf '%s\n' "$path"
  done < <(open_tasks "$1")
}

# pgrep_pattern <command> -> the first non-option word after `pgrep` in <command>, quotes dropped (an option that takes
# a value, -u -U -g -G -P -s -t -n -o, is skipped with it): the regex pgrep -f matches against command lines, so
# `pgrep -f 'gate-and-land.sh 2200'` names one session's gate and not every gate's. Nothing (exit 1) when the word is
# not literal text (a $var, $(...) or backtick the shell expanded) or no pattern parses: such a loop names no gate.
pgrep_pattern() {
  local sq="'" re p
  re="pgrep(([[:space:]]+-[uUgGPstno][[:space:]]+[^[:space:]]+)|([[:space:]]+-[^[:space:]]+))*[[:space:]]+(${sq}([^${sq}]*)${sq}|\"([^\"]*)\"|([^[:space:];|&)]+))"
  [[ "$1" =~ $re ]] || return 1
  p="${BASH_REMATCH[5]}${BASH_REMATCH[6]}${BASH_REMATCH[7]}"
  case "$p" in "" | *'$'* | *'`'*) return 1 ;; esac
  printf '%s\n' "$p"
}

# watched_gate <transcript> -> queue when an open background Bash task (open_tasks) is a `pgrep` loop on one of
# FLEET_QUEUE_GATES' texts and a process of that text is alive (queue_match, so a pgrep and a `-c` line holding the
# loop's own text do not count), else nothing. The gate is the session's own, started apart from the loop (a
# gate-and-land.sh before its PR exists, which the session watches for its end); time-use.conf reads the loop as `jobs`
# because pgrep, not the text, starts the command, and live_wait finds the gate only inside this claude's tree.
# 2026-11-12 agent-24 read "background shell is not a gate or test" while its gate-and-land.sh ran (ar-2121). A loop
# whose target ended has ended with it, and one that matches only itself finds no live process. Not counted: a
# `-c` line and a claude (its argv carries a dispatch prompt that names agent-land), as wait_procs skips them. The
# loop is read from any open task, not only the one the panel calls the open job, and the process from any session,
# narrowed by the loop's own pattern (pgrep_pattern); a loop on a bare `gate-and-land.sh` reads any live one.
watched_gate() {
  local id path cmd text line pat args=""
  local -a qg=(); IFS='|' read -ra qg <<<"$FLEET_QUEUE_GATES"
  grep -qF pgrep "$1" 2>/dev/null || return 0   # most transcripts have no such loop: skip the task reads
  while IFS=$'\t' read -r id path; do
    cmd="$(bash_command "$1" "$id")"
    [[ "$cmd" == *pgrep* ]] || continue
    pat="$(pgrep_pattern "$cmd")" || continue
    [ -n "$args" ] || args="$(ps -e -o args= 2>/dev/null)"
    for text in "${qg[@]}"; do
      [[ "$cmd" == *pgrep*"$text"* ]] || continue
      while IFS= read -r line; do
        case "$line" in *" -c "* | claude" "* | */claude" "*) continue ;; esac
        queue_match "$line" "$text" && [[ "$line" =~ $pat ]] && { echo queue; return 0; }
      done <<<"$args"
    done
  done < <(open_tasks "$1")
}

# live_wait <cwd> [<claude pid>]: queue when such a process is a FLEET_QUEUE_GATES one (a gate waiting for its
# landing turn: WORKING past FLEET_SHELL_STALE_MIN, it ends itself), else gate, test or build when a process running in <cwd> (or below it), or
# descended from the session's claude whatever its cwd, matches a `gate`, `test` or `build` line of
# agent-panel's time-use.conf, else checkout for a live Git checkout or LFS transfer (git_checkout), else nothing. A background subagent's commands run in its own
# worktree and a gate script may cd elsewhere (2026-11-03 agent-49 read STALLED mid-gate on #1669),
# but both stay children of the claude that started them. The transcript shows a gate detached
# with & only as the until-loop watching its output file (2026-11-07 unity-core-playground-agent-30:
# Tests run in progress, row STALLED), so agent-panel reads it as `jobs`; the process itself is the
# fact. No event API names a gate's process, so this reads /proc: `ls -l` of every cwd link and one `ps`, once per pass (PROC_SNAP,
# proc_snapshot), so a gate that starts after a pass's first call is seen by the next tick, a minute on. Not counted: a `-c` command line that is not a git_checkout (a shell holding its
# script's text, not the gate), the session's own `claude` (its argv carries the dispatch prompt,
# which names agent-land), and this pass's own ancestors. With no claude pid (an agent-panel row
# without .pid) only the worktree is read.
live_wait() {
  local conf="$FLEET_TIME_USE_CONF" want kind text pid cmd
  local -a cmds=()
  while IFS=$'\t' read -r pid cmd; do [ -z "$pid" ] || cmds+=("$cmd"); done < <(wait_procs "$@")
  [ "${#cmds[@]}" -gt 0 ] || return 0
  local checkout=""
  for cmd in "${cmds[@]}"; do
    queue_gate "$cmd" && { echo queue; return 0; }
    [ -n "$checkout" ] || ! git_checkout "$cmd" || checkout=checkout
  done
  if [ -r "$conf" ]; then
    for want in gate test build; do
      while read -r kind text; do
        [ "$kind" = "$want" ] && [ -n "$text" ] || continue
        for cmd in "${cmds[@]}"; do
          case "$cmd" in *"$text"*) echo "$want"; return 0 ;; esac
        done
      done < "$conf"
    done
  fi
  [ -z "$checkout" ] || echo "$checkout"
}

# git_checkout <command line>: a live Git checkout, clone, submodule update or LFS transfer, which can
# run past FLEET_IDLE_MIN on a large repo and is work, not a sleep (ar-1065: sessions read STALLED and
# were nudged mid-checkout). `git -C <dir>` and `git -c <key=value>` prefixes are allowed.
GIT_CMD_RE='^([^ ]*/)?git ((-C|-c) [^ ]+ )*'
git_checkout() {
  [[ "$1" =~ ${GIT_CMD_RE}((submodule|submodule--helper)[[:space:]]+update|checkout|clone|lfs[[:space:]]+(smudge|filter-process|pull|fetch|checkout))([[:space:]]|$) ]] \
    || [[ "$1" =~ ^([^\ ]*/)?git-lfs[[:space:]]+(smudge|filter-process|pull|fetch|checkout)([[:space:]]|$) ]]
}

# queue_gate_of <cwd> [<claude pid>] -> "<minutes>\t<repo>\t<pr>" of the oldest FLEET_QUEUE_GATES process live_wait
# would find, or nothing. <minutes> is how long the session has waited its landing turn (ar-2525: 2026-11-15
# unity-core-playground-agent-3's gate-and-land.sh sat 3.5h behind #2733 with #2726 green); one `ps` of the matched
# pids, and a pid gone since the snapshot reads nothing. collect asks for a session whose open job is queue and for
# one whose PR is held by the landing queue or a train, since a gate-and-land behind another PR's re-check can read
# as another open job (ar-3486: agent-27 #2900 behind #2539 read overdue). <repo> is the owner/repo that gate lands in
# (agent-land's own order: --repo, the item's recorded pr:, its cwd's origin) and <pr> the number `agent-land <N>`
# names, each "-" when the command line or checkout does not say.
# Why: a lander the session runs from another repo's worktree (2026-11-21 lab/dotfiles-agent-24: a gate-line.py --land
# on unity-core-playground #2492) waits on that repo's PR, and the landing line read the session's own, `dotfiles PR
# #2492` (ar-4303).
queue_gate_of() {
  local pid cmd pids="" age top="" old="" repo="" pr=- dir
  local -A cmds=()
  while IFS=$'\t' read -r pid cmd; do
    if [ -n "$pid" ] && queue_gate "$cmd"; then pids+="${pids:+,}$pid"; cmds[$pid]="$cmd"; fi
  done < <(wait_procs "$@")
  [ -n "$pids" ] || return 0
  while read -r age pid; do
    [[ "$age" =~ ^[0-9]+$ ]] || continue
    if [ -z "$top" ] || [ "$age" -gt "$top" ]; then top="$age" old="$pid"; fi
  done < <(ps -o etimes=,pid= -p "$pids" 2>/dev/null)
  [ -n "$top" ] || return 0
  cmd="${cmds[$old]:-}"
  # agent-land <pr>'s number: its first bare integer before --plan and --phase (their text holds numbers), past any --flag value.
  if [[ "$cmd" =~ agent-land[[:space:]](.*) ]]; then
    local -a w; read -ra w <<<"${BASH_REMATCH[1]}"
    local i=0
    while [ "$i" -lt "${#w[@]}" ]; do
      case "${w[$i]}" in
        --plan | --phase) break ;;
        --repo | --item) i=$((i + 2)) ;;
        --*) i=$((i + 1)) ;;
        *) [[ "${w[$i]}" =~ ^[0-9]+$ ]] && pr="${w[$i]}"; break ;;
      esac
    done
  fi
  # The repo agent-land lands in: --repo, else the repo of the item's own pr:<owner>/<repo>#<pr>, else its checkout's origin.
  if [[ "$cmd" =~ (^|[[:space:]])--repo[[:space:]]([^[:space:]]+) ]]; then repo="${BASH_REMATCH[2]}"
  else
    if [ "$pr" != - ] && [[ "$cmd" =~ (^|[[:space:]])--item[[:space:]]([^[:space:]]+) ]]; then
      repo="$(jq -r --arg s "${BASH_REMATCH[2]}" --arg n "$pr" 'first(select(.slug == $s) | (.pr // "" | tostring | split(" ")[]) | select(endswith("#" + $n)) | sub("#.*"; ""))' \
        <<<"${qall:-}" 2>/dev/null)"
    fi
    if [ -z "$repo" ]; then
      repo=-
      if dir="$(readlink "/proc/$old/cwd" 2>/dev/null)" && [ -n "$dir" ]; then repo="$(origin_repo "$dir" 2>/dev/null)" || repo=-; fi
    fi
  fi
  [ -n "$repo" ] || repo=-
  printf '%s\t%s\t%s\n' $(( top / 60 )) "$repo" "$pr"
}

# queue_wait_of <cwd> <claude pid> <git dir or -> -> "<minutes>\t<repo>\t<pr>" of queue_gate_of, each "-" when unknown, the repo
# "-" too when it is the row's own (<git dir>'s origin, compared case-insensitively): only a lander run from another
# repo's worktree names its repo (ar-4303).
queue_wait_of() {
  local w r p own=-
  IFS=$'\t' read -r w r p < <(queue_gate_of "$1" "$2")
  [ "$3" = - ] || own="$(origin_repo "$3" 2>/dev/null)" || own=-
  [ "${r,,}" != "${own,,}" ] || r=-
  printf '%s\t%s\t%s\n' "${w:--}" "${r:--}" "${p:--}"
}

# wait_procs <cwd> [<claude pid>] -> "pid<TAB>command line" of each process live_wait reads: running in <cwd>
# or below it, or below the claude, less this pass's ancestors, `-c` command lines other than a git_checkout and the session's own claude.
wait_procs() {
  local cwd="$1" root="${2:-0}" kind pid cmd
  local snap="${PROC_SNAP:-}" own=""
  cwd="$(realpath "$cwd" 2>/dev/null)" || return 0
  [[ "$root" =~ ^[0-9]+$ ]] && [ "$root" -gt 1 ] || root=0
  # A pass reads /proc once (collect sets PROC_SNAP) instead of once per session: 57 calls of
  # `ls -l` over every process and a bash loop on each line were 8s of a 50s pass (2026-11-16).
  [ -n "$snap" ] || { own="$(mktemp)" || return 0; snap="$own"; }
  [ -f "$snap.cwd" ] || proc_snapshot "$snap"
  local -A skip=()
  local pick
  # This pass's own ancestors (skip), then each process running in <cwd> or below it, or below the claude.
  # The cwd goes in by ENVIRON, not -v, which would read a backslash in it as an escape. FILENAME, not NR == FNR,
  # splits the two files: an empty ppid file (ps failed) must not swallow the cwd lines.
  pick="$({ awk -F'\t' -v me="$$" '{ up[$1] = $2 } END { for (p = me; p > 1; p = up[p]) { print "S\t" p; if (!(p in up)) break } }' "$snap.ppid"
    LW_CWD="$cwd" awk -F'\t' -v r="$root" '
      BEGIN { c = ENVIRON["LW_CWD"] }
      FILENAME == ARGV[1] { up[$1] = $2; next }
      { p = $1
        if (r > 1) { x = up[p]; n = 0; while (x > 1 && x != r && (x in up) && n++ < 64) x = up[x]; if (x == r) { print "P\t" p; next } }
        if ($2 == c || index($2, c "/") == 1) print "P\t" p }' "$snap.ppid" "$snap.cwd"
  } )"
  [ -z "$own" ] || rm -f "$own" "$own".*
  while IFS=$'\t' read -r kind pid; do [ "$kind" != S ] || skip[$pid]=1; done <<<"$pick"
  while IFS=$'\t' read -r kind pid; do
    [ "$kind" = P ] && [ -z "${skip[$pid]:-}" ] || continue
    cmd="$(tr '\0\n' '  ' 2>/dev/null < "/proc/$pid/cmdline")"   # one record a process, whatever its argv holds
    case "$cmd" in "" | claude" "* | */claude" "*) continue ;; esac
    # A shell's -c holds unevaluated command text; git's -c sets configuration on a real git process.
    if [[ "$cmd" == *" -c "* ]] && ! git_checkout "$cmd"; then continue; fi
    printf '%s\t%s\n' "$pid" "$cmd"
  done <<<"$pick"
}

# self_wait <claude pid>: `hung` when a process under that claude is a `tail --pid=N` whose N is one of its
# own ancestors below the claude (or itself, when bash exec-ed tail in its place), `wait` when one waits on any other
# pid but the claude's, else nothing. In the hung case the parent waits for tail to end and tail
# waits for the parent to end, so nothing ever moves. Not checked: that the
# parent is blocked on the tail, so a `tail --pid=$$ -f log &` beside real work also reads hung once
# its row is idle past FLEET_IDLE_MIN with no live gate or test; the session is the one to say so. 2026-11-09 agent-51's `pgrep -f 'agent-land 2089'` matched its own shell and
# sat in that wait for 100m while the row read WORKING. A tail that watches any other pid is an event
# wait, the one the rules ask for over a sleep loop, and ends with that process: 2026-11-14 it read
# "background shell is not a gate or test". No event names a deadlock, so this reads one `ps`.
self_wait() {
  local root="${1:-0}"
  [[ "$root" =~ ^[0-9]+$ ]] && [ "$root" -gt 1 ] || return 0
  ps -e -o pid=,ppid=,args= | awk -v r="$root" '
    { p = $1; up[p] = $2; $1 = $2 = ""; args[p] = $0 }
    END {
      for (p in up) {
        x = up[p]; n = 0
        while (x > 1 && x != r && (x in up) && n++ < 64) x = up[x]
        if (x != r) continue
        k = split(args[p], a, " ")
        if (a[1] !~ /(^|\/)tail$/) continue
        for (i = 2; i <= k; i++) {
          w = ""
          if (a[i] ~ /^--pid=[0-9]+$/) w = substr(a[i], 7)
          else if (a[i] == "--pid" && i < k) w = a[i + 1]
          if (w == "" || w == r) continue
          if (w == p) { print "hung"; exit }
          for (x = up[p]; x > 1 && x != r && (x in up); x = up[x]) if (w == x) { print "hung"; exit }
          ev = 1
        }
      }
      if (ev) print "wait"
    }'
}

# api_error_stop <transcript>: "<code>\t<timestamp to the minute>" when the transcript's last message
# is Claude Code's own `API Error: <code>` line (an assistant entry with isApiErrorMessage; a limit notice
# with no code is the limit watch's), else nothing. The
# CLI retries first, so that line means the turn is over and only a message restarts it. 2026-11-13
# 01:46-01:51 PST a transient Cloudflare 403 stopped 10 sessions at an idle prompt; each read WORKING
# until it tripped overdue, and three never moved without a nudge. Only the tail is read (a first
# line cut by tail is skipped): a later message, a nudge or the human's, makes the error not last.
api_error_stop() {
  [ -s "${1:-}" ] || return 0
  tail -n 100 "$1" | jq -Rr 'fromjson? | select(.type == "assistant" or .type == "user")
      | if .isApiErrorMessage == true then
          ([.message.content[]? | select(.type == "text") | .text] | join(" ")
            | capture("API Error: (?<c>[0-9]+)")? // {c: ""}).c as $c
          | if $c == "" then "" else "\($c)\t\((.timestamp // "-")[:16])" end
        else "" end' 2>/dev/null | tail -n 1 | grep . || true
}

# resume_killed_gate <transcript> -> "<kind> <text>\t<timestamp to the minute>" when the newest notice that a resume
# ended a background shell (Claude Code's <task-notification>, status stopped, "Background shell command didn't finish
# before the previous session ended", written as the resumed claude starts) whose ids include a Bash call that was a gate
# or test (gate_text) has no gate or test Bash call after it; else nothing. Any later gate or test counts, not only the
# killed one's text: a session that went on to gate or land another way is past it (ar-1902 review). The notice wakes no turn:
# 2026-11-12 07:41 a planned reboot took the lab tmux server down, fleet-dispatch restore reopened its 22 conversations
# at 07:43 with no prompt, and agent-3, -5, -7 and -10 had each lost a gate-and-land, a local run or a train wait; they
# sat idle until they read STALLED at 08:07 (ar-1902). Only the notices' lines, then the lines after one, reach jq.
resume_killed_gate() {
  [ -s "${1:-}" ] || return 0
  local n at ids id g
  while IFS=$'\t' read -r n at ids; do
    for id in $ids; do
      g="$(gate_text "$(bash_command "$1" "$id")")"
      [ -n "$g" ] || continue
      [ -z "$(gate_text "$(tail -n "+$((n + 1))" "$1" | grep -a -F '"name":"Bash"' | jq -r 'select(.type == "assistant")
          | .message.content[]? | select(.type? == "tool_use" and .name == "Bash") | .input.command // empty' 2>/dev/null)")" ] \
        && printf '%s\t%s\n' "$g" "$at"
      return 0
    done
  done < <(grep -a -n -F 'finish before the previous session ended' "$1" 2>/dev/null | jq -R -r '
      capture("^(?<n>[0-9]+):(?<j>.*)$") | .n as $n | .j | fromjson? | select(type == "object" and .type == "user")
      | (.message.content | if type == "string" then . else (map(.text? // "") | join(" ")) end) as $c
      | select(($c | test("<status>stopped</status>")) and ($c | test("[Bb]ackground shell commands? didn.t finish before the previous session ended")))
      | [$n, (.timestamp // "-")[:16], ([$c | scan("<tool-use-id>([^<]+)</tool-use-id>") | .[0]] | join(" "))] | @tsv' 2>/dev/null | tac)
}

# stopped_bucket <transcript> <bucket> <main red|-> -> "<bucket>\t<stop minute>" when an idle session's transcript ends on
# its own stop line, else nothing: nothing in such a session wakes without a message. An API Error (api_error_stop) replaces
# a WORKING row (idle under FLEET_IDLE_MIN, a pending CI run). A resume that killed a background gate or test
# (resume_killed_gate) replaces a WORKING or STALLED one, since rerunning it is the next step whatever the tree reads, but
# not a nightly-red suspect, a PR conflict or a red CI run, whose own nudge comes first (ar-1902 review).
stopped_bucket() {
  local s k at
  if [[ "$2" == WORKING* ]]; then
    s="$(api_error_stop "$1")"
    [ -z "$s" ] || { printf 'STALLED turn ended on API Error %s\n' "$s"; return 0; }
  fi
  case "$2" in
    WORKING*) ;;
    "STALLED PR #"*" conflicts with the default branch" | "STALLED PR #"*" CI red") return 0 ;;
    STALLED*) [ "$3" = - ] || return 0 ;;
    *) return 0 ;;
  esac
  IFS=$'\t' read -r k at < <(resume_killed_gate "$1")
  [ -z "${k:-}" ] || printf 'STALLED resume killed its background %s (%s) before it finished\t%s\n' "${k%% *}" "${k#* }" "$at"
}

# pending_wakes <transcript> <claude start epoch|-> <now epoch> -> one "<kind>\t<id>\t<at epoch|->" line, soonest
# first, per thing that will wake the session by itself, so closing it would lose a turn it waits for:
#   cron     a recurring CronCreate job ("Scheduled recurring job <id>"), under 7 days old (Claude Code expires it then)
#   once     a one-shot CronCreate job ("Scheduled one-shot task <id>", toolUseResult.nextFireAt) not yet fired
#   wakeup   the last ScheduleWakeup call (its tool_use input; a stop:true one ends it), until ts + delaySeconds
#   monitor  an armed Monitor ("Monitor started (task <id>", toolUseResult.timeoutMs; a persistent one holds 7 days, as a
#            recurring cron) until it expires or a
#            <task-notification> for its task id reports a status other than running (its stream ended), or a TaskStop
#            result ("Successfully stopped task: <id>", a tool_result with no notification, ar-4158) names it;
#            the notice can be written before the "Monitor started" line, so an ended id counts in any order
# A CronDelete ("Cancelled job <id>") ends a cron; a "Running scheduled task" row (scheduled_task_fire, taskId = the
# job id) ends a one-shot and carries a recurring job over a --resume (hub/dotfiles:1, ar-2604). A session-only one
# dies with its process, so it counts only when made (a recurring job: or fired) after this claude started; with no
# known start none does; a durable cron outlives the process. The transcript is the only record: a session-only job
# is never written to disk and no event names it. Only the lines naming one are read (7 ms on a 43 MB transcript, so
# no cache); api-request lines repeat the conversation and are skipped. 2026-11-19: d4b20268 waited on its 04:33
# sprint-cut cron and was closed at 01:03 as quiet (ar-3598).
pending_wakes() {
  [ -s "${1:-}" ] || return 0
  local since="${2:--}"; [[ "$since" =~ ^[0-9]+$ ]] || since=9999999999
  { grep -a -E 'Scheduled recurring job|Scheduled one-shot task|Cancelled job|scheduled_task_fire|Monitor started \(task|Successfully stopped task|<task-id>|"name":"ScheduleWakeup","input"' "$1" 2>/dev/null || :; } \
    | { grep -a -v '^{"type":"api-request' || :; } | jq -Rrn --argjson since "$since" --argjson now "$3" '
    def text: if type == "array" then map(.text? // "") | join(" ") else tostring end;
    def epoch: (. // "") | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601? // 0;
    def secs: tonumber? // 0;
    def results: select(.type == "user") | .timestamp as $ts | .toolUseResult as $r
        | (.message.content | if type == "array" then .[] else empty end) | select(.type == "tool_result")
        | {ts: ($ts | epoch), c: (.content | text), r: (if ($r | type) == "object" then $r else {} end)};
    def fires: select(.type == "system" and .subtype == "scheduled_task_fire" and (.taskId | type) == "string") | {ts: (.timestamp | epoch), fire: .taskId};
    def wakeups: select(.type == "assistant") | .timestamp as $ts | (.message.content | if type == "array" then .[] else empty end)
        | select(.type == "tool_use" and .name == "ScheduleWakeup") | {ts: ($ts | epoch), wake: (.input // {})};
    def ends: select(.type | IN("user", "queue-operation", "attachment", "system"))
        | [tostring | scan("<task-id>([^<]+)</task-id>.*?<status>([^<]+)</status>") | select(.[1] != "running") | .[0]]
        | select(length > 0) | {end: .};
    reduce (inputs | fromjson? | (results, fires, wakeups, ends)) as $e ({};
      if $e.fire then (if .[$e.fire].kind == "once" then del(.[$e.fire]) elif has($e.fire) then .[$e.fire].fired = $e.ts else . end)
      elif $e.end then reduce $e.end[] as $i (.; .ended[$i] = true)
      elif $e.wake then
        (if $e.wake.stop == true then del(.wakeup)
         else .wakeup = {kind: "wakeup", ts: $e.ts, at: ($e.ts + ([[($e.wake.delaySeconds | secs), 60] | max, 3600] | min))} end)
      elif ($e.c | test("^(\\{\"message\":\")?Successfully stopped task: [0-9a-z]+")) then
        .ended[$e.c | capture("Successfully stopped task: (?<i>[0-9a-z]+)").i] = true
      elif ($e.c | test("^Scheduled recurring job [0-9a-f]+")) then
        .[$e.c | capture("^Scheduled recurring job (?<i>[0-9a-f]+)").i] = {kind: "cron", ts: $e.ts, fired: 0, durable: ($e.c | test("Session-only") | not)}
      elif ($e.c | test("^Scheduled one-shot task [0-9a-f]+")) then
        .[$e.c | capture("^Scheduled one-shot task (?<i>[0-9a-f]+)").i] = {kind: "once", ts: $e.ts, durable: ($e.c | test("Session-only") | not),
          at: (if ($e.r.nextFireAt | type) == "number" then ($e.r.nextFireAt / 1000 | floor) else null end)}
      elif ($e.c | test("^Monitor started \\(task [0-9a-z]+")) then
        .[$e.c | capture("^Monitor started \\(task (?<i>[0-9a-z]+)").i] = {kind: "monitor", ts: $e.ts,
          at: (if $e.r.persistent == true then null else $e.ts + (($e.r.timeoutMs // 300000 | secs) / 1000 | floor) end)}
      elif ($e.c | test("^Cancelled job [0-9a-f]+")) then del(.[$e.c | capture("^Cancelled job (?<i>[0-9a-f]+)").i])
      else . end)
    | (.ended // {}) as $ended | del(.ended) | with_entries(select(.value.kind != "monitor" or ($ended[.key] | not)))
    | to_entries | map(.value + {id: .key} | select(
        if .kind == "cron" then (.durable or .ts >= $since or .fired >= $since) and .ts > $now - 604800
        elif .kind == "once" then (.durable or .ts >= $since) and (if .at then .at > $now else .ts > $now - 604800 end)
        else .ts >= $since and (if .at then .at > $now else .ts > $now - 604800 end) end))
    | sort_by(.at // 9999999999)[] | "\(.kind)\t\(if .kind == "wakeup" then "-" else .id end)\t\(.at // "-")"' 2>/dev/null
}

# wake_facts <transcript> <claude start epoch|-> <now epoch> <idle min> <phases> <done> <total> <phase queue>
#   -> "<wake>\t<cron>": what will wake the session by itself in words (wake_phrase), which keeps it open (the close
# flow's scheduled step), and yes when an idle session whose plan has a phase no item holds may be running it in
# place, by a live recurring cron (session_bucket's cron); - for either when none. Any such cron counts, not only one naming
# the plan: closing the session ends its crons, so it is not finished. A one-shot is not in-place work.
wake_facts() {
  local wakes wake cron=-
  wakes="$(pending_wakes "$1" "$2" "$3")"
  wake="$(wake_phrase <<<"$wakes")"
  if [ "$4" -ge "$FLEET_IDLE_MIN" ] && [[ "$5" == */* ]] && [ "$6" -lt "$7" ] && [[ "$8" != queued:* ]] \
     && grep -q $'^cron\t' <<<"$wakes"; then cron=yes; fi
  printf '%s\t%s\n' "${wake:--}" "$cron"
}

# wake_phrase: pending_wakes lines on stdin -> the soonest in words ("a one-shot cron a318 at Fri 23:13"),
# with "+N more" when there are others, or nothing.
wake_phrase() {
  local kind id at when first="" n=0
  while IFS=$'\t' read -r kind id at; do
    [ -n "$kind" ] || continue
    n=$((n + 1)); [ -z "$first" ] || continue
    when=""; [ "$at" = - ] || when="$(date -d "@$at" '+%a %H:%M' 2>/dev/null)"
    case "$kind" in
      cron) first="a recurring cron $id" ;;
      once) first="a one-shot cron $id${when:+ at $when}" ;;
      wakeup) first="a ScheduleWakeup${when:+ at $when}" ;;
      monitor) first="a Monitor $id${when:+ until $when}" ;;
    esac
  done
  [ -n "$first" ] || return 0
  if [ "$n" -gt 1 ]; then echo "$first, +$((n - 1)) more"; else echo "$first"; fi
}

# bucket_facts: session_bucket past the session status, from the same arguments.
bucket_facts() {
  local plan="$2" asks="$3" heavy="$4" idle="$5" git="$6" dirty="$7" ahead="$8" \
        pr="$9" state="${10}" ci="${11}" inpr="${12}" red="${13:--}" phases="${14:--}" next="${15:--}" nm="" \
        landed="${19:--}" item="${20:--}" wait_on="${21:--}" cron="${22:--}" carried="${24:--}"
  [ "${18:--}" = - ] || nm=" (${18})"
  [ "$heavy" = 1 ] && { echo "WORKING heavy child process"; return; }
  [ "$asks" -gt 0 ] && { echo "NEEDS $asks pending ask(s)"; return; }
  [ "$idle" -lt "$FLEET_IDLE_MIN" ] && { echo "WORKING idle ${idle}m"; return; }
  # wt done reaps a worktree once its work landed; nothing is left here to land or lose.
  [ "$git" = gone ] && { echo "DONE its worktree was removed"; return; }
  [ "$git" = 1 ] || { echo "CHAT not in a git repo"; return; }
  case "$state" in
    MERGED)
      # A merge that may have turned a nightly red is not landed, whatever the tree says.
      if [ "$red" != - ]; then echo "STALLED nightly red after PR #$pr: $red"
      elif [ "$dirty" -gt 0 ]; then echo "STALLED PR #$pr merged, $dirty dirty file(s) left$nm"
      elif [ "$inpr" != 1 ]; then echo "STALLED commits after merged PR #$pr"
      else plan_bucket "PR #$pr merged, tree clean" "$phases" "$next" 1 "$item" "$cron" "$carried"; fi ;;
    OPEN)
      if handed_off "$item" "$pr" "$dirty" "$inpr" "${17:--}"; then
        local slug="${item#review:}"; slug="${slug%% *}"; local why="PR #$pr parked for review, its item $slug owns it"
        case "$phases" in
          -|none) echo "DONE $why" ;;
          missing) echo "STALLED $why, its plan file is missing" ;;
          *) if [ "${phases%/*}" -ge "${phases#*/}" ] || [[ "$next" == queued:* ]]; then echo "DONE $why"
             else echo "LANDED $why, next phase: $next"; fi ;;
        esac
        return
      fi
      [ "$wait_on" = - ] || { echo "WORKING PR #$pr waiting on $wait_on"; return; }
      case "$ci" in
        FAIL)    echo "STALLED PR #$pr CI red" ;;
        NOSTART) echo "WORKING PR #$pr CI never started (its jobs ran no steps), waiting on billing" ;;
        PENDING) echo "WORKING PR #$pr CI running" ;;
        -)       echo "STALLED PR #$pr open, CI unknown, not merged" ;;
        *)       echo "STALLED PR #$pr green, not merged" ;;
      esac ;;
    CLOSED)
      # Closed beside a merged PR of its own was replaced; alone it is the session's to explain.
      if [ "$landed" != - ]; then plan_bucket "PR #$pr closed, its PRs $landed merged" "$phases" "$next" 1 "$item" "$cron" "$carried"
      else echo "STALLED PR #$pr closed without merging"; fi ;;
    *)
      if [ "$dirty" -gt 0 ]; then echo "STALLED $dirty dirty file(s)$nm, no PR"
      elif [ "$ahead" -gt 0 ]; then echo "STALLED $ahead file(s) not on the default branch, no PR"
      elif [ "$landed" != - ]; then plan_bucket "clean, nothing on the branch, its PRs $landed merged" "$phases" "$next" 1 "$item" "$cron" "$carried"
      else plan_bucket "clean, nothing on the branch" "$phases" "$next" 0 "$item" "$cron" "$carried"; fi ;;
  esac
}

# handed_off <item> <pr> <dirty> <in_pr> [<job>] -> exit 0 when this session's open PR is its parked
# item's (item_of's "review:<slug> pr <n>", the item's own pr:) and nothing here is outside it: no
# dirty file, HEAD inside the PR, and no live waiter (gate or queue) still running in the background.
# fleet-dispatch's reap owns that PR once the session ends
# (own_parked_pr gives a red one a fix-ci session and a green one a lander), so it is no longer the session's to finish.
handed_off() {
  [[ "$1" == review:*" pr "* ]] && [ "${1##* pr }" = "${2##*#}" ] && [ "$3" = 0 ] && [ "$4" = 1 ] \
    && [ "${5:--}" != gate ] && [ "${5:--}" != queue ]
}

# salvaged_here <qall> <slug> <dir> -> exit 0 when the item that moved on from this session carries this
# checkout's HEAD in its `salvage:` (`<branch>@<sha>`): that sha, or one built on it by a later run's handoff.
# agent-queue handoff writes it only once that head is on origin, and the item's next start begins from it,
# so the branch is not this session's to land (ar-2777). A sha this clone lacks holds nothing.
salvaged_here() {
  local sv
  sv="$(jq -nr --arg s "$2" 'first(inputs | select(.slug == $s) | .salvage // empty)' <<<"$1" 2>/dev/null)"
  [ -n "$sv" ] && git -C "$3" merge-base --is-ancestor HEAD "${sv##*@}" 2>/dev/null
}

# session_finished: session_bucket's arguments -> exit 0 when the work half of DONE holds
# (phases all ticked, no ask, nothing unlanded, not a red-main suspect). It skips status,
# plan mode, a heavy child and the idle threshold, so a session can check its own row mid-turn, when that row always reads WORKING busy.
session_finished() {
  case "$(bucket_facts - 0 "$3" 0 "$FLEET_IDLE_MIN" "${@:6}")" in DONE*) return 0 ;; esac
  return 1
}

# work_blockers <open ask ids, comma-separated> <session_bucket's arguments...> -> every reason
# session_finished is false, "; "-separated, empty when it is true. The ids lead so a new
# session_bucket argument never moves them.
# bucket_facts names only the first reason; a session told it is unfinished needs all of them.
work_blockers() {
  local ids="$1"; shift
  local asks="$3" git="$6" dirty="$7" ahead="$8" pr="$9" state="${10}" ci="${11}" inpr="${12}" \
        red="${13:--}" phases="${14:--}" next="${15:--}" b=() id merged=0 out="" nm="" mwhy="nothing merged"
  [ "${18:--}" = - ] || nm=" (${18})"
  # A PR of the session's own merged while another is open or unread: landed stays - (nothing is landed
  # until every PR settles), but "nothing merged" would deny the PR the transcript and `prs` name (ar-165).
  [ "${23:--}" = - ] || mwhy="only ${23} merged"
  { [ "$state" = - ] || [ "$state" = CLOSED ]; } && [ "${19:--}" != - ] && merged=1
  if [ -n "$ids" ]; then
    for id in ${ids//,/ }; do b+=("open ask $id"); done
  elif [ "$asks" -gt 0 ]; then b+=("$asks open ask(s)"); fi
  if [ "$git" = gone ]; then :
  elif [ "$git" != 1 ]; then b+=("not in a git repo")
  else
  case "$state" in
    MERGED)
      merged=1
      [ "$red" != - ] && b+=("nightly red after PR #$pr: $red")
      [ "$dirty" -gt 0 ] && b+=("$dirty dirty file(s)$nm")
      [ "$inpr" != 1 ] && b+=("commits after merged PR #$pr") ;;
    OPEN) if handed_off "${20:--}" "$pr" "$dirty" "$inpr" "${17:--}"; then merged=1
          elif [ "${21:--}" != - ]; then b+=("PR #$pr open, waiting on ${21}")
          else b+=("PR #$pr open, CI ${ci:--}"); fi ;;
    CLOSED) [ "$merged" = 1 ] || b+=("PR #$pr closed without merging") ;;
    *)
      [ "$dirty" -gt 0 ] && b+=("$dirty dirty file(s)$nm, no PR")
      [ "$ahead" -gt 0 ] && b+=("$ahead file(s) not on the default branch, no PR") ;;
  esac
  case "$phases" in
    # An item that moved on took the work with it: nothing here is left to finish.
    -) [ "$merged" = 1 ] || [[ "${20:--}" == moved:* ]] || b+=("no plan file and $mwhy") ;;
    none) [ "$merged" = 1 ] || b+=("plan has no ## Phases checklist and $mwhy") ;;
    missing) [[ "${20:--}" == moved:* ]] || b+=("its plan file is missing") ;;
    *) if [ "${phases%/*}" -ge "${phases#*/}" ] || [[ "$next" == queued:* ]]; then :
       else b+=("next phase: $next"); fi ;;
  esac
  if [[ "${20:--}" == own:* ]]; then
    # Every phase ticked or held by another item leaves only the item to close (the requeued
    # case, ucp-agent-82 2026-11-11: apo-120 stayed open after its partial landing while its
    # phases ran as items elsewhere). Its close verdict is then after, not keep.
    local own="${20#own:}" held=0
    case "$phases" in -|none|missing) ;; *) { [ "${phases%/*}" -ge "${phases#*/}" ] || [[ "$next" == queued:* ]]; } && held=1 ;; esac
    for id in ${own//,/ }; do
      if [ "$held" = 1 ]; then b+=("its item $id is still open with every phase done or queued")
      else b+=("its item $id is running here"); fi
    done
  fi
  fi
  for id in "${b[@]}"; do out="${out:+$out; }$id"; done
  # A finished session is told to stop its shell; any other one is held up by it.
  [ -n "$out" ] && [ "$1" = shell ] && [ "${17:--}" = hung ] && [ "$5" -ge "$FLEET_IDLE_MIN" ] \
    && out="$out; $HUNG_REASON"
  printf '%s' "$out"
}

# carried_by <all items, jsonl> <session id> <item_of's answer> <server:tmux session> -> for an own:<slugs> answer, the
# comma list of running items (or a held `-close` item) in another session (not this session id, not this tmux session) filed from one of those
# slugs. A waiting or review item is blocked on someone, not working, so it carries nothing (`from: item:<slug>`, which
# agent-queue records for an add made inside an item's session), else -. A coordinator's own item is open while the
# fix items it filed do the work, so its idle pane is not a stall (ar-4015: nightly-green-ucp-2823 on
# hub/unity-core-playground:2, 2026-11-20). A queued `<slug>-close` item still held by its at: tag (`ready`
# in the future) carries the item too: the session kept it open on purpose and the close item ends it, so it is not
# STALLED. Once `ready` passes with the item still queued it is starved, and the row reads STALLED again (ar-4582:
# agent-21 kept ar-4554 open after agent-land refused at watch_gate, 2026-11-22). Only a running item closes the
# row's item through close_items_sample: a carried row is WORKING, so its close verdict is keep and close.items empty.
carried_by() {
  local out
  [[ "$3" == own:* ]] || { printf -- -; return; }
  out="$(jq -rn --arg sid "$2" --arg own ",${3#own:}," --arg me "$4" '
    [inputs | select((.state == "running" and (.session // "") != $me
        and ((.from // "") | startswith("item:"))
        and ((.from | sub("^item:"; "")) as $f | $own | contains("," + $f + ","))
        and (((.sessions // "") | split(" ") | any(. == $sid)) | not))
        or (.state == "queued" and ((.slug // "") | endswith("-close"))
        and ((.ready // "") | fromdateiso8601? // 0) > now
        and ((.slug | sub("-close$"; "")) as $f | $own | contains("," + $f + ","))))
      | .slug] | unique | join(",")' <<<"$1" 2>/dev/null)"
  printf '%s' "${out:--}"
}

# plan_bucket <reason so far> <phases> <next> <merged 0|1> [<item>] [<cron>] [<carried>]: nothing is unlanded, so the
# plan decides. All phases ticked is DONE, and so is one whose unchecked phases are queue items
# (next is queued:<slugs>); one left is LANDED naming it. A plan with no checklist,
# or no plan file, is one phase of work: DONE once its PR merged. Without a merged PR, no
# checklist is LANDED asking for one. No plan file goes by the queue item: one that moved on
# (done, requeued, or running in another session) is DONE, one still running here with nothing
# on the branch is STALLED, and with no item it is CHAT, the human's own conversation, which
# closes on the same quiet timer as any session (FLEET_IDLE_CLOSE_MIN). 2026-11-05: agent-26
# sat 22.5h and agent-21 a day after their items were requeued, escalated once and never wound down.
# A queue item still running here is unfinished work whatever merged: a merged PR may be a side
# item's, so it is STALLED naming the item, never DONE. 2026-11-06: unity-core-playground-agent-6
# merged #1922 for steam-untested-reason, read DONE and was told to wind down while its own
# steam-beta-cut-1106 was running with three release.yml runs in flight.
# A next phase a live cron of the session runs is the session's own, in place: WORKING, never LANDED
# (2026-11-16 the coordinator hub/dotfiles:1 read LANDED "P3 land today" and drew a wind-down nudge
# while its hourly cron was landing P3).
plan_bucket() {
  local why="$1" phases="$2" next="$3" merged="${4:-0}" item="${5:--}" cron="${6:--}" carried="${7:--}" own=-
  # The first running item names the row, so a side item starting or ending is not a new fact.
  [[ "$item" == own:* ]] && { own="${item#own:}"; own="${own%%,*}"; }
  case "$phases" in
    -)    if [ "$merged" = 1 ]; then plan_done "$why" "$own" ", no plan file, its PR landed" "" "$carried"
          else case "$item" in
            moved:*) echo "DONE $why, no plan file, its item ${item#moved:}" ;;
            own:*)   if [ "$carried" = - ]; then echo "STALLED $why, no plan file, its item $own is running here"
                     else echo "WORKING $why, no plan file, its item $own is carried by live items: $carried"; fi ;;
            *)       echo "CHAT $why, no plan file, no queue item: the human's conversation" ;;
          esac; fi ;;
    none) if [ "$merged" = 1 ]; then plan_done "$why" "$own" ", single-phase plan, its PR landed" "" "$carried"
          else echo "LANDED $why, plan has no ## Phases checklist"; fi ;;
    # A recorded plan that is nowhere has phases no one can read: never finished, whatever merged,
    # unless its item moved on and took the work (ar-2368).
    missing) case "$item" in
            moved:*) echo "DONE $why, its plan file is missing, its item ${item#moved:}" ;;
            *)       echo "STALLED $why, its plan file is missing" ;;
          esac ;;
    *)
      if [ "${phases%/*}" -ge "${phases#*/}" ]; then plan_done "$why" "$own" ", all ${phases#*/} phases done" held "$carried"
      elif [[ "$next" == queued:* ]]; then plan_done "$why" "$own" ", its next phases are queue items: ${next#queued:}" held "$carried"
      elif [ "$cron" = yes ]; then echo "WORKING $why, a live cron runs its next phase: $next"
      else echo "LANDED $why, next phase: $next"; fi ;;
  esac
}

# plan_copy_of <plan file> -> the one plan a queue item of this pass names ($qall) that this plan is a
# copy of under another file name, its phase names the same (plan_phase_key), or nothing. Plan mode
# names a plan at random, and a planner chat that queues its phases often writes them to a named plan
# first, so the items name that one: 2026-11-14 hub/dotfiles:9, :10 and :13 read LANDED with a next
# phase while every phase was a queue item of the named plan, and were told to queue them again. A plan
# an item names itself (by file name), or one whose phases match two named plans, is its own.
plan_copy_of() {
  local keys="$CACHE/plan_keys" own key f b="${1##*/}"
  if [ ! -f "$keys" ]; then
    jq -r '.plan // empty' <<<"$qall" 2>/dev/null | sort -u | while IFS= read -r f; do
      key="$(plan_phase_key "$f" | tr '\n' '\037')"
      printf '%s\t%s\n' "$key" "$f"   # a keyless plan still names its file for the check below
    done > "$keys"
  fi
  awk -F'\t' -v b="$b" '{ n = split($2, p, "/"); if (p[n] == b) { found = 1; exit } } END { exit !found }' "$keys" && return 0
  own="$(plan_phase_key "$1" | tr '\n' '\037')"
  [ -n "$own" ] || return 0
  K="$own" awk -F'\t' '$1 == ENVIRON["K"] { n++; f = $2 } END { if (n == 1) print f }' "$keys"   # ENVIRON: -v would read a backslash in a name
}

# plan_done <why> <first running item here|-> <DONE's reason after why> [held] [<carried>] -> DONE, or STALLED
# naming the item when one still runs here (WORKING when live items it filed carry it, carried_by); held
# (every checklist phase done or queued) says the item is all that is left open (work_blockers' wording,
# which the close verdict reads).
plan_done() {
  if [ "$2" = - ]; then echo "DONE $1$3"
  elif [ "${5:--}" != - ]; then echo "WORKING $1, its item $2 is carried by live items: $5"
  elif [ "${4:-}" = held ]; then echo "STALLED $1, its item $2 is still open with every phase done or queued"
  else echo "STALLED $1, its item $2 is running here"; fi
}

# fact_key <fact> -> what "the same fact" means. A DONE fact is one fact for as long as the session
# is DONE: its tail (the queued phases, "no plan file", the merged PR list) shrinks as its queue
# items start, and each change drew a fresh wind-down nudge to the same session (2026-11-07:
# dotfiles-agent-6 got three, from three passes). Whether the nudge moved it is the escalation's
# question, not a reason to send it again. A NEEDS fact is what the human owes, so it drops the
# branch and head: a session holding an ask that switched branch or pushed paged again (ar-233). A
# LANDED fact is the same: its "next phase: queued:<slugs>" tail shrinks as the items start (ar-1576).
fact_key() { case "$1" in DONE\ *) echo DONE ;; LANDED\ *) echo LANDED ;; NEEDS\ *) printf '%s\n' "${1%% @*}" ;; *) printf '%s\n' "$1" ;; esac; }

# nudged <sid> <fact> -> exit 0 when this fact was already nudged for this session.
nudged() { [ "$(fact_key "$(sed -n 's/^fact: //p' "$LEDGER/$1" 2>/dev/null)")" = "$(fact_key "$2")" ]; }

# escalated <sid> <fact> -> exit 0 when this fact is already on the human's list.
escalated() { [ "$(fact_key "$(sed -n 's/^escalated: //p' "$LEDGER/$1" 2>/dev/null)")" = "$(fact_key "$2")" ]; }

# ledger_write <sid> <key> <fact>: set one key, keep the other. A new nudge clears an escalation,
# except a NEEDS one: the ask is still waiting while the session works on, so an overdue nudge to it
# keeps the page sent once; release_left drops it when the session leaves NEEDS.
ledger_write() {
  local sid="$1" key="$2" fact="$3" tmp keep=""
  case "$sid" in ''|*/*|.|..) echo "fleet-sessions: bad session id" >&2; return 2 ;; esac
  mkdir -p "$LEDGER"
  case "$key" in
    escalated) keep="$(grep '^fact: ' "$LEDGER/$sid" 2>/dev/null)" || true ;;
    fact)      keep="$(grep '^escalated: NEEDS ' "$LEDGER/$sid" 2>/dev/null)" || true ;;
  esac
  tmp="$(mktemp "$LEDGER/.$sid.XXXXXX")" || return 1
  { [ -n "$keep" ] && echo "$keep"; printf '%s: %s\nat: %s\n' "$key" "$fact" "$(date -Iseconds)"; } > "$tmp" \
    && mv "$tmp" "$LEDGER/$sid"
}
# mark <sid> <fact>: the claim on a nudge, taken before the message goes out. Exit 1 when the fact
# is already nudged, whichever pass nudged it, and the ledger is left as it is (a second mark would
# clear the escalation the first one earned).
# mark --close <sid>: the claim on the close, which only fleet-shepherd's close_sample sends (it
# types /wind-down auto). A session is sent one for good: a coordinator that worked again after
# /wind-down and went DONE again was typed the same close every half hour (2026-11-17:
# hub/dotfiles:1, four times in 90 minutes). $CLOSED/<sid> is the claim, apart from the fact
# ledger: a LANDED or STALLED message held unseen for a session in another permission mode
# (2026-11-18: hub/dotfiles:4 and :8) marked that fact, and a close keyed on it was never typed.
# The row's `close_sent` reads the claim, and a DONE or CHAT row with one reads nudged (collect),
# so it is escalated once if it stays.
CLOSED="$LEDGER/.closed"
# Every claim mark takes, one JSON line each, never rewritten: the ledger keeps only a session's
# last fact and watch.log is keyed by tmux window, so whether a nudge moved its session (judge-eval,
# judges.md) needs this. A `*.jsonl` in the store, so store-sync merges two machines' lines as a union.
NUDGES="$LEDGER/nudges.jsonl"
# A line is a claim, taken before the message goes out, so `at` is the claim's time. A close nothing
# was typed into is given back (mark --release), which appends a close-released line for it.
# nudge_log <sid> <nudge|close|close-released> <fact>: append one line, with the row's target, project
# and bucket from the latest state document (null for a row it no longer lists, or an unreadable one).
# Called under mark.lock. A failed append is reported and leaves the claim standing: the message
# still goes out.
nudge_log() {
  local row
  row="$(jq -c --arg s "$1" '[(.sessions // [])[] | select(.session_id == $s)][0] // {}
    | {target, project, bucket}' "$STATE_FILE" 2>/dev/null)" || row=""
  [ -n "$row" ] || row='{"target":null,"project":null,"bucket":null}'
  jq -nc --arg at "$(date -Iseconds)" --arg sid "$1" --arg kind "$2" --arg fact "$3" --argjson row "$row" \
    '{at: $at, sid: $sid, kind: $kind, fact: (if $fact == "" then null else $fact end)} + $row' >> "$NUDGES" \
    || echo "fleet-sessions: could not append the $2 for $1 to $NUDGES" >&2
}
mark() {
  if [ "${1:-}" = --close ]; then
    case "${2:-}" in ''|*/*|.|..) echo "fleet-sessions: bad session id" >&2; return 2 ;; esac
    mkdir -p "$CLOSED"
    ( flock 8
      [ ! -e "$CLOSED/$2" ] || { echo "fleet-sessions: $2 already sent its close nudge" >&2; exit 1; }
      : > "$CLOSED/$2" && nudge_log "$2" close "" ) 8>"$LEDGER/mark.lock"
    return
  fi
  if [ "${1:-}" = --release ]; then
    case "${2:-}" in ''|*/*|.|..) echo "fleet-sessions: bad session id" >&2; return 2 ;; esac
    [ -e "$CLOSED/$2" ] || return 0
    ( flock 8; rm -f "$CLOSED/$2" && nudge_log "$2" close-released "" ) 8>"$LEDGER/mark.lock"
    return
  fi
  case "$1" in ''|*/*|.|..) echo "fleet-sessions: bad session id" >&2; return 2 ;; esac
  mkdir -p "$LEDGER"
  (
    flock 8
    nudged "$1" "$2" && { echo "fleet-sessions: $1 already nudged for this fact" >&2; exit 1; }
    ledger_write "$1" fact "$2" || exit 1
    nudge_log "$1" nudge "$2"
  ) 8>"$LEDGER/mark.lock"
}

# release_left <rows>: a session that left NEEDS drops its NEEDS escalation, so its next ask or
# dialog pages once. A session that left DONE keeps its entry, and its close claim in $CLOSED is
# never released: one typed close per session.
release_left() {
  local b sid _
  while IFS=$'\t' read -r b _ sid _; do
    [ -n "$sid" ] && [ -f "$LEDGER/$sid" ] || continue
    if [ "$b" != NEEDS ] && grep -q '^escalated: NEEDS ' "$LEDGER/$sid"; then sed -i '/^escalated: NEEDS /d' "$LEDGER/$sid"; fi
  done <<<"$1"
}
escalate() { ledger_write "$1" escalated "$2" && finding_paged "$1" "$2"; }

# finding_paged <sid> <key>: a fleet-bench finding (sid finding-*, key "<fact> <class>") that went to
# the human is a page on that finding's episode, so `fleet-bench loop` can tell a page from an act.
# Best effort: a bench that cannot record leaves the escalation standing.
finding_paged() {
  [[ "$1" == finding-* && "$2" == *" human" ]] || return 0
  "${FLEET_BENCH:-fleet-bench}" respond "${2% human}" shepherd paged >/dev/null 2>&1 || true
}

# labels_of <sid> -> the session's labels, comma-joined in the order set, or "-".
labels_of() {
  local l
  l="$(paste -sd, "$LABELS/$1" 2>/dev/null)"
  echo "${l:--}"
}

# resolve_sid <who> -> a session id: `self` is the live session in this tmux pane (its row's
# pane, <server>/$TMUX_PANE); anything else matches a live session's id, target (lab/s1:1), tmux
# target (s1:1) or tmux session (s1). Not $CLAUDE_CODE_SESSION_ID inside tmux: it can differ from the
# transcript id the row carries, and a label filed under it lands on no row (hub/dotfiles:3,
# 2026-11-20, ar-4148). A pane no row holds (a run-shell or popup pane) falls back to the env id only
# when a live row carries it. Outside tmux there is no pane, so the env id is the only identity.
resolve_sid() {
  local who="$1" pane=""
  if [ "$who" = self ]; then
    if [ -z "${TMUX:-}" ] || [ -z "${TMUX_PANE:-}" ]; then
      [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] || { echo "fleet-sessions: self needs a tmux pane or CLAUDE_CODE_SESSION_ID" >&2; return 2; }
      echo "$CLAUDE_CODE_SESSION_ID"; return
    fi
    pane="$(basename "${TMUX%%,*}")/$TMUX_PANE"
  fi
  local sid
  sid="$("${AGENT_PANEL:-agent-panel}" list --json 2>/dev/null | jq -rn --arg w "$who" --arg p "$pane" --arg env "${CLAUDE_CODE_SESSION_ID:-}" '
    [inputs] as $r
    | if $p != "" then ([$r[] | select(.pane == $p)] | if length > 0 then . else [$r[] | select($env != "" and .session_id == $env)] end)
      else [$r[] | select(.session_id == $w or .target == $w or (.target | sub("^[^/]*/"; "")) == $w
             or (.target | sub("^[^/]*/"; "") | sub(":[^:]*$"; "")) == $w)] end | map(.session_id) | .[:1][]')"
  [ -n "$sid" ] || { echo "fleet-sessions: no live session matches '${pane:-$who}'" >&2; return 2; }
  echo "$sid"
}

# prune_labels <cells file>: the tick's label sweep. A session with a row has its label file touched,
# so the file's mtime is when a tick last saw it; a file unseen FLEET_LABEL_GRACE_H (24h) is removed.
# The grace, not one pass, decides: a reboot or tmux restart reads no rows until the restore brings
# the same session ids back, and a partial read drops rows no source reports blind, and neither may
# take a `manual` hold. Without it, a gone session's labels sat in $LABELS for good (ar-4148).
prune_labels() {
  local f m cut
  cut=$(( $(date +%s) - ${FLEET_LABEL_GRACE_H:-24} * 3600 ))
  for f in "$LABELS"/*; do
    [ -f "$f" ] || continue
    if awk -F'\t' -v s="${f##*/}" '$1 == s { found = 1; exit } END { exit !found }' "$1"; then
      touch -c "$f"; continue
    fi
    m="$(stat -c %Y "$f" 2>/dev/null)" || continue
    [ "$m" -ge "$cut" ] || rm -f "$f"
  done
}

# label <who> [+name|-name|^name ...]: add, remove or flip labels, then print the session's labels.
# ^name lets a key binding (agent-panel ctrl-t) flip one without reading it first. `manual` is the
# human's and never expires, so the literal `label self` may not add it: a session held open on the
# human's order takes `stay`, which expires once quiet FLEET_CHAT_CLOSE_H (ar-4124). The check is on the
# word `self`, the form every skill gives a session; it stops a stale instruction, not a session that
# names its own target on purpose.
label() {
  local who="${1:-}" sid op name tmp add
  [ -n "$who" ] || { echo "usage: fleet-sessions label <who> [+name|-name|^name ...]" >&2; return 2; }
  if [ "$who" = self ]; then
    for op in "${@:2}"; do
      case "$op" in +manual|^manual)
        echo "fleet-sessions: manual is the human's label; a session held open on the human's order takes +stay" >&2; return 2 ;;
      esac
    done
  fi
  sid="$(resolve_sid "$who")" || return 2
  case "$sid" in ''|*/*|.|..) echo "fleet-sessions: bad session id" >&2; return 2 ;; esac
  shift
  mkdir -p "$LABELS"
  for op in "$@"; do
    name="${op#[+^-]}"
    if [ "$name" = "$op" ] || ! [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9:._-]*$ ]]; then
      echo "fleet-sessions: label ops are +name, -name or ^name ([A-Za-z0-9:._-]), got '$op'" >&2; return 2
    fi
    add=0
    case "${op:0:1}" in
      +) add=1 ;;
      ^) grep -qxF -- "$name" "$LABELS/$sid" 2>/dev/null || add=1 ;;
    esac
    tmp="$(mktemp "$LABELS/.$sid.XXXXXX")" || return 1
    { grep -vxF -- "$name" "$LABELS/$sid" 2>/dev/null; [ "$add" = 1 ] && echo "$name"; } > "$tmp"
    if [ -s "$tmp" ]; then mv "$tmp" "$LABELS/$sid"; else rm -f "$tmp" "$LABELS/$sid"; fi
  done
  [ $# -gt 0 ] && tmux_labels "$sid"
  labels_of "$sid"
}

# --- tmux projection ----------------------------------------------------------------------
# The state document's stage and labels, copied onto each session's tmux window as @fleet_stage
# and @fleet_labels, so the window-status format (.tmux.conf) and agent-panel show them. It is a
# projection, never read back as a fact. Targets are <server>/<session>:<window>.

# tmux_project <state document>: per server, set both options on every session's window and clear
# them from windows that no longer hold one (a claude that exited in a pane that stayed). One tmux
# call per server; a server it cannot reach is skipped and the next tick tries again.
tmux_project() {
  local want srv have t st lb
  local -a cmd
  want="$(jq -r '.sessions[] | select(.target | test("^[^/]+/[^:]+:"))
    | [.target, .bucket, ((.labels // []) | join(","))] | @tsv' "$1" 2>/dev/null)" || return 0
  for srv in $( { tmux_servers_all
                  [ -n "$want" ] && cut -d/ -f1 <<<"$want"; } | sort -u); do
    have="$(tmux -L "$srv" list-windows -a -f '#{@fleet_stage}' -F '#{session_name}:#{window_index}' 2>/dev/null)" || continue
    cmd=()
    while IFS=$'\t' read -r t st lb; do
      [ -n "$t" ] && [ "${t%%/*}" = "$srv" ] || continue
      t="${t#*/}"
      have="$(grep -vxF -- "$t" <<<"$have")"
      cmd+=(set-option -wq -t "=$t" @fleet_stage "$st" \;)
      if [ -n "$lb" ]; then cmd+=(set-option -wq -t "=$t" @fleet_labels "$lb" \;)
      else cmd+=(set-option -wqu -t "=$t" @fleet_labels \;); fi
    done <<<"$want"
    while IFS= read -r t; do
      [ -n "$t" ] && cmd+=(set-option -wqu -t "=$t" @fleet_stage \; set-option -wqu -t "=$t" @fleet_labels \;)
    done <<<"$have"
    [ ${#cmd[@]} -gt 0 ] || continue
    unset 'cmd[-1]'
    tmux -L "$srv" "${cmd[@]}" >/dev/null 2>&1 || echo "fleet-sessions: tmux projection on $srv failed" >&2
  done
}

# tmux_labels <sid>: put one session's labels on its window now, so a change made from agent-panel
# shows on its relaunch instead of at the next tick. The target comes from the state document; a
# session too new to be in it gets its labels at the next tick.
tmux_labels() {
  local t l
  t="$(jq -r --arg s "$1" 'first(.sessions[] | select(.session_id == $s) | .target)' "$STATE_FILE" 2>/dev/null)"
  [[ "$t" == */*:* ]] || return 0
  l="$(paste -sd, "$LABELS/$1" 2>/dev/null)" || l=""
  if [ -n "$l" ]; then tmux -L "${t%%/*}" set-option -wq -t "=${t#*/}" @fleet_labels "$l" >/dev/null 2>&1
  else tmux -L "${t%%/*}" set-option -wqu -t "=${t#*/}" @fleet_labels >/dev/null 2>&1; fi
  return 0
}

# --- facts ------------------------------------------------------------------------------
# asks_for <claude session id> -> the ids of its pending asks, one per line. Only the
# asking session owns an ask. The tmux session name is not a fallback: every window in it
# and every later session that reuses the name share it, and a 10-24 ask held a 10-28
# session open that way. An ask with no owner blocks nobody; the state document still
# lists it under `asks`.
asks_for() {
  [ -n "$1" ] || return 0
  # The store keeps every ask ever filed, so collect reads it once for its whole pass.
  awk -F'\t' -v s="$1" '$1 == s { print $2 }' <<<"${PENDING_ASKS-$(pending_asks)}"
}

# item_asks <live items, jsonl> <item_of's answer> <this session id> <panel rows, jsonl> -> the pending asks the item's
# earlier sessions filed (sessions: order), one id per line, skipping any a panel row shows live: it owns its ask (ar-4650).
item_asks() {
  case "${2:-}" in own:* | here:*) ;; *) return 0 ;; esac
  local slugs="${2#*:}" sib x
  slugs="${slugs%% *}"
  sib="$(jq -rn --arg own ",$slugs," --arg me "$3" --slurpfile pan <(printf '%s\n' "${4:-}") '
    ([$pan[] | .session_id // empty | tostring]) as $live
    | [inputs | select(.slug as $s | $own | contains("," + $s + ","))
      | (.sessions // "" | split(" ") | map(select(. != ""))) as $l | ($l | index($me)) as $i
      | ($l | if $i == null then . else .[:$i] end)[] | select(. as $x | $live | index($x) | not)]
    | unique[]' <<<"$1" 2>/dev/null)"
  while IFS= read -r x; do [ -z "$x" ] || asks_for "$x"; done <<<"$sib"
  return 0
}

# pending_asks -> "<claude session>\t<ask id>" per pending ask, per owner line (a blocker ask names
# every session it stops). agent-ask decides which asks are pending: a parked one (`parked_until`
# still ahead) waits on the human's later step, so it holds no session in NEEDS. A failed read
# returns 1 with nothing, and collect marks its pass blind (tick keeps every last cell, as for a
# failed panel read) rather than drop every NEEDS.
pending_asks() {
  local l
  l="$(AGENT_ASK_ROOT="$ASK_ROOT" agent-ask list --all --pending 2>/dev/null)" || return 1
  [ -n "$l" ] || return 0
  awk -v ids="$(cut -f1 <<<"$l")" '
    BEGIN { n = split(ids, a, "\n"); for (i = 1; i <= n; i++) want[a[i]] = 1 }
    function flush(   i, id) {
      id = file; sub(/.*\//, "", id); sub(/\.md$/, "", id)
      if (id in want) for (i = 1; i <= k; i++) print owner[i] "\t" id
      k = 0
    }
    FNR == 1 { if (file != "") flush(); file = FILENAME }
    /^claude_session: ./ { owner[++k] = substr($0, 17) }
    END { if (file != "") flush() }' "$ASK_ROOT"/*/*.md 2>/dev/null
}

# Panes (<server>/<pane id>, agent-panel's .pane) holding a heavy process, one per line, from
# fleet-assess's PANE column. Keyed on the pane, not the tmux session: one session's windows
# are separate agents, and a build in one is not work in the others (ar-290).
heavy_panes() {
  local fa
  fa="$(command -v fleet-assess || echo "$(dirname "$0")/fleet-assess")"
  "$fa" 2>/dev/null | awk 'f && NF == 0 { exit } f && $8 != "" && $8 != "-" { print $8 } /^PID /{ f = 1 }' | sort -u
}

# restored_panes <agent-panel rows> -> "<server>/<pane id> <epoch>" of each pane fleet-dispatch restore
# reopened, the epoch its @fleet_restored option holds (when its server was last seen alive), one per
# line, one tmux call per server the local rows name. The option dies with the pane, so a later hand
# resume of the same conversation is a new pane without it.
restored_panes() {
  local srv
  for srv in $(jq -r 'select((.host // "") == "") | .pane // "" | select(contains("/")) | sub("/.*"; "")' <<<"$1" 2>/dev/null | sort -u); do
    tmux -L "$srv" list-panes -a -f '#{@fleet_restored}' -F '#{pane_id} #{@fleet_restored}' 2>/dev/null | sed "s|^|$srv/|"
  done
}

# quiet_before <restored_panes lines> <host> <server>/<pane id> <since epoch> -> quiet_before_min, the
# minutes a restored pane's conversation had been quiet when its server was last seen alive (its last
# entry to its @fleet_restored epoch), or - for a remote row or a pane restore did not reopen. CLOSE_JQ
# adds it to the age: the pane's claude is new, its conversation is not (ar-4141).
quiet_before() {
  [ "$2" = - ] || { echo -; return; }
  awk -v p="$3" -v s="$4" '$1 == p && $2 ~ /^[0-9]+$/ && s > 0 { q = int(($2 - s) / 60); r = q > 0 ? q : 0; exit }
    END { print (r == "" ? "-" : r) }' <<<"$1"
}

# repo_slug <dir> -> the origin URL as a file-name-safe key (cache files, NIGHTLY ledger ids).
repo_slug() {
  local LC_ALL=C url f="${CACHE:+$CACHE/slug_${1//\//%}}"   # C: one _ per byte, as tr -c gave
  # One answer per directory per pass: 736 calls of git and tr were a tenth of a pass's forks (2026-11-16).
  if [ -n "$f" ] && [ -s "$f" ]; then IFS= read -r url < "$f"; printf '%s' "$url"; return; fi
  url="$(git -C "$1" remote get-url origin 2>/dev/null)" || return 1
  url="${url//[!A-Za-z0-9]/_}"
  [ -z "$f" ] || { printf '%s\n' "$url" > "$f.$$" && mv -f "$f.$$" "$f"; }
  printf '%s' "$url"
}

# unreadable <name>: this pass could not read <name>, so the state document names it.
unreadable() { echo "$1" >> "$CACHE/unreadable"; }
# blind_row: the row collect is building read a source that failed, on this call or earlier in the
# pass, so tick keeps that row's last cells (keep_blind). Every read of a failed source calls it.
blind_row() { : > "$CACHE/blind_row"; }

# prs_key <dir> -> the pass cache file of <dir>'s PRs (prs_for, train_of, queued_in, queue_depth). It names the
# forge remote as well as origin: clones of one origin URL may not land on one forge.
prs_key() {
  local slug
  slug="$(repo_slug "$1")" || return 1
  printf '%s\n' "$CACHE/${slug}_$(canonical_remote "$1")"
}

# store_key <repo> -> the PR-store key of a repo: a Forgejo repo (host/owner/repo) under the store's host, since a
# clone's remote may be on an alias of it (the public ROOT_URL host, not the store's), which the store does not list
# and which read as "no PR" (so_store_key is the one alias rule, agent-land's too). Any other repo as given.
store_key() {
  [[ "$1" == */*/* ]] || { printf '%s\n' "$1"; return; }
  so_store_key "${SO_PROJECT_MAP:-$HOME/.config/shared-hooks/project-map.json}" "$1"
}

# store_refresh <store key>: close --self only. The store is polled every 10 minutes, so a PR merged since the
# last poll still reads OPEN with its CI running, and holds a session that landed it (hc-658, tc-24: Forgejo
# PRs read "open, CI PENDING" after agent-land). Ask the store to read the forge now, as agent-land does after
# a merge, but --wait: a poll mid-read holds the store lock, and its read is the answer wanted. Once a pass per
# repo (case-blind). A repo the store does not list (rc 3) is no fault; any other failure leaves the store stale,
# so every row on that repo is blind (close keeps), never a stale OPEN taken as fact.
store_refresh() {
  [ -n "${CLOSE_SELF:-}" ] || return 0
  local key="${1//\//_}" f out rc=0
  f="$CACHE/refreshed_${key,,}"
  if [ ! -e "$f" ]; then
    : > "$f"
    out="$("$SCHEDULES_SYNC" sync-prs --wait "$1" 2>&1)" || rc=$?
    [ "$rc" = 0 ] || [ "$rc" = 3 ] || { : > "$f.failed"; unreadable "PR store refresh ($1): ${out##*$'\n'}"; }
  fi
  [ ! -e "$f.failed" ] || blind_row
}

# PRs for one repo, cached per pass: "branch \t number \t state \t ci \t head_oid \t red job ids", newest first,
# from the PR store (`schedules-sync prs --checks`, unreadable once 30 minutes stale): ci is the run ledger's
# reading of the head commit, red the job archive's failed job ids (- for none it has yet). The repo is
# the one the checkout lands on (forge_of): a clone on a Forgejo host (so_forgejo_hosts: the submodule
# External/asset-library) or a Forgejo-canonical one (home-config, whose origin is the GitHub mirror with
# no PRs) reads host/owner/repo. Read off origin, home-config's merged PRs were never found, and a branch
# whose files master rewrote after the merge read "no PR" (ar-2587).
# One the store does not list has no PRs, never an unreadable source (ar-1116 named it every pass), as
# has a mirror-only clone of a Forgejo-canonical repo, and a clone whose origin is on a host that is
# neither GitHub nor a listed Forgejo (~/.agent on forge-primary, backup-only: every session that wrote
# a lesson read "could not read PR store" and never closed itself). Any other GitHub repo it does not
# list is unreadable (`schedules-sync repos` is the list).
prs_for() {
  local dir="$1" key repo out rc=0
  key="$(prs_key "$dir")" || return 0
  if [ ! -f "$key" ]; then
    repo="$(forge_of "$dir")"
    if [ "$repo" != origin ]; then repo="$(store_key "${repo#* }")"
    else repo="$(origin_repo "$dir")" || return 0; fi
    store_refresh "$repo"
    out="$("$SCHEDULES_SYNC" prs "$repo" --checks 2>/dev/null)" || rc=$?
    if [ "$rc" = 0 ] && jq -r '.[] | [.branch // "-", .number, .state, .ci, .head_sha // "-", .red] | @tsv' \
         <<<"$out" > "$key" 2>/dev/null; then
      # The open trains (train_of), "number \t head \t member numbers": the title is the store's, the body is not.
      [ -z "$FLEET_TRAIN_BRANCH" ] || jq -r --arg p "$FLEET_TRAIN_BRANCH" '.[] | select(.state == "OPEN" and ((.branch // "") | startswith($p)))
          | [.number, .head_sha // "-", ([(.title // "") | scan("#([0-9]+)")[0]] | join(" "))] | @tsv' \
          <<<"$out" > "$key.trains" 2>/dev/null || { : > "$key.trains"; unreadable "PR store trains ($repo)"; }
      # The open PRs waiting their landing turn (queued_in), one number a line, in gate-line.py's seating order as
      # near as the store says: urgent first, then by PR number (it orders by claim time, which the store lacks).
      # The slot holders (queue_place) beside them.
      [ -z "$FLEET_QUEUE_LABEL" ] || jq -r --arg l "$FLEET_QUEUE_LABEL" --arg u "$FLEET_URGENT_LABEL" '[.[] | select(.state == "OPEN" and ((.labels // []) | index($l)))]
          | sort_by(((.labels // []) | ($u != "" and index($u) != null) | not), .number)[] | .number' \
          <<<"$out" > "$key.queued" 2>/dev/null || { : > "$key.queued"; unreadable "PR store labels ($repo)"; }
      [ -z "$FLEET_SLOT_LABEL" ] || jq -r --arg l "$FLEET_SLOT_LABEL" '.[] | select(.state == "OPEN" and ((.labels // []) | index($l))) | .number' \
          <<<"$out" > "$key.slot" 2>/dev/null || { : > "$key.slot"; unreadable "PR store labels ($repo)"; }
    elif [ "$rc" = 3 ] && { [[ "$repo" == */*/* ]] || forge_canonical "$dir" || ! origin_on_github "$dir"; }; then : > "$key"
    else : > "$key"; : > "$key.failed"; unreadable "PR store ($repo)"; fi
  fi
  [ ! -f "$key.failed" ] || blind_row
  cat "$key"
}

# train_of <dir> <pr> <head oid> -> the number of the open landing train (FLEET_TRAIN_BRANCH) that names PR
# #<pr> and whose head holds <head oid>, or nothing. A member's head is merged into the train, so a head pushed
# since the train was built is not on it: that PR is its session's again. A train head this clone lacks holds nothing.
train_of() {
  local key n head members
  key="$(prs_key "$1")" || return 0
  prs_for "$1" > /dev/null
  [ -f "$key.trains" ] || return 0
  while IFS=$'\t' read -r n head members; do
    [[ " $members " == *" $2 "* ]] && git -C "$1" merge-base --is-ancestor "$3" "$head" 2>/dev/null \
      && { echo "$n"; return; }
  done < "$key.trains"
}

# queued_in <dir> <pr> -> true when PR #<pr> of <dir>'s repo carries FLEET_QUEUE_LABEL in the PR store.
queued_in() {
  local key
  key="$(prs_key "$1")" || return 1
  prs_for "$1" > /dev/null
  [ -f "$key.queued" ] && grep -qxF "$2" "$key.queued"
}

# queue_depth <dir> -> how many open PRs of <dir>'s repo carry FLEET_QUEUE_LABEL in the PR store, or nothing
# when the store could not say.
queue_depth() {
  local key
  key="$(prs_key "$1")" || return 0
  prs_for "$1" > /dev/null
  [ ! -f "$key.queued" ] || grep -c . "$key.queued"
}

# queue_place <dir> <pr> -> where PR #<pr> stands for the landing slot: "holds the landing slot" (FLEET_SLOT_LABEL),
# "about <k> of <n> in the landing queue" (its line in queued_in's order, approximate: gate-line.py seats by claim time), or "waiting its landing turn" when the store
# says neither.
queue_place() {
  local key k=""
  key="$(prs_key "$1")" && prs_for "$1" > /dev/null
  if [ -n "$key" ] && [ -f "$key.slot" ] && grep -qxF "$2" "$key.slot"; then echo "holds the landing slot"; return; fi
  [ -z "$key" ] || [ ! -f "$key.queued" ] || k="$(grep -nxF "$2" "$key.queued" | cut -d: -f1)"
  if [ -n "$k" ]; then echo "about $k of $(grep -c . "$key.queued") in the landing queue"; else echo "waiting its landing turn"; fi
}

# board_feed -> `notes board --json`, read once a pass ($CACHE/board.json); empty when the board cannot be read.
board_feed() {
  [ -f "$CACHE/board.json" ] || { notes board --json > "$CACHE/board.json.$$" 2>/dev/null || : > "$CACHE/board.json.$$"
                                  mv -f "$CACHE/board.json.$$" "$CACHE/board.json"; }
  cat "$CACHE/board.json"
}

# critical_rows <row id> -> the open #high and #urgent board rows gated #after/<row id>, as "<id> #<priority>"
# joined by commas, or nothing: the rows a session's held PR keeps waiting, so a green PR held by the landing slot
# reads as their critical path (ar-3761: on 2026-11-19 P1 #2935 read WORKING in the slot while ucp-2712 waited 5h).
# One board read a pass (board_feed); a board it cannot read names no rows, as plan_gated_rows does.
critical_rows() {
  [ -f "$CACHE/after_high" ] || {
    board_feed | jq -r '.rows[]? | select(.state == "open" and (.priority == "high" or .priority == "urgent"))
      | .id as $id | .priority as $p | .tags[]? | select(startswith("after/")) | [ltrimstr("after/"), $id, $p] | @tsv' \
      > "$CACHE/after_high.$$" 2>/dev/null || : > "$CACHE/after_high.$$"
    mv -f "$CACHE/after_high.$$" "$CACHE/after_high"; }
  awk -F'\t' -v r="$1" '$1 == r { s = s (s == "" ? "" : ",") $2 " #" $3 } END { if (s != "") print s }' "$CACHE/after_high"
}

# critical_of <wait_on> <item row> <dir> <pr> -> "<rows> TAB <place>", or "- TAB -": a PR held by the landing slot
# (collect's wait_on) whose item came from a board row is the critical path of the #high and #urgent rows gated
# #after/ on that row (critical_rows), and where it stands (queue_place, the train it rides, or the slot holder that
# refused it), so the shepherd
# names the wait (critical_due) instead of reading it as plain WORKING (ar-3761). One printf argument, two row columns.
critical_of() {
  local crit=- place=-
  if [ -n "$1" ] && [ "$2" != - ]; then
    crit="$(critical_rows "${2#*:}")"; crit="${crit:--}"
    if [ "$crit" != - ]; then
      case "$1" in "train #"*) place="rides $1" ;; "slot holder #"*) place="behind the $1" ;; *) place="$(queue_place "$3" "$4")" ;; esac
    fi
  fi
  printf '%s\t%s\n' "$crit" "$place"
}

# branch_runs <dir> <branch> -> <branch>'s main_runs in <dir>'s origin repo: gate_ci, main_health
# and activity_line all read it, from one ledger read per repo per pass ($CACHE). A repo the ledger
# does not sync has no runs ([]); one it cannot answer for is named unreadable once, and is rc 1
# with the row blind on every read.
branch_runs() {
  local d="$1" b="$2" all one rc=0
  all="$CACHE/runs_$(repo_slug "$d")" || return 1
  one="${all}_${b//\//%2F}" # %2F: feat/x and feat_x are two branches
  if [ ! -f "$one" ]; then
    if [ ! -f "$all" ]; then
      main_runs "$(origin_repo "$d")" > "$all" || rc=$?
      case $rc in
        0) ;;
        3) echo '[]' > "$all" ;;
        *) : > "$all"; unreadable "run ledger ($(basename "$d"))" ;;
      esac
    fi
    if [ -s "$all" ]; then
      jq -c --arg b "$b" 'map(select(.headBranch == $b))' "$all" > "$one" 2>/dev/null \
        || { : > "$one"; unreadable "run ledger ($(basename "$d"))"; }
    else : > "$one"; fi
  fi
  [ -s "$one" ] || { blind_row; return 1; }
  cat "$one"
}

# gate_ci <dir> <PR head branch> <head_oid> <ci> [<red job ids>] [<shell job>] -> <ci> with the branch's dispatched gate runs folded in.
# A pool gate is a workflow_dispatch run, which never appears in a PR's statusCheckRollup, so a PR
# whose Checks passed read green while its gate was queued or red (#1175, #1180). Each
# FLEET_GATE_WORKFLOWS workflow's newest dispatched run on a commit the PR head holds (a reused
# slot branch's old runs are on commits it does not) counts as a check, by CI_JQ's order: running
# is PENDING, else a red is FAIL. A run decides by MAIN_STREAKS' conclusions, so a cancelled,
# skipped or stale one decides nothing, as gate-line.py passes over a cancelled one. Whether an
# older gate still covers the head is Checks' call (gate-line.py), so an older green adds nothing.
# A workflow is its file (workflowPath), as in MAIN_STREAKS: its title follows run-name, so a newer
# green `Tests (all)` supersedes an older red `Tests (affected)` (ar-1094).
# Only a PASS or NONE can change, and a FAIL whose red jobs failed only in FLEET_GATE_LINE_STEPS, which
# a gate running on the head itself makes PENDING: that red is the gate line waiting on it (ar-82, #1692
# read CI red mid-gate). A gate still running on an older commit leaves it red: the head has none.
# <shell job> gate (the session's background shell is a gate: its open job, or live_wait) makes it PENDING
# too, unless a gate already finished red on the head: a ci-gate.sh queued for the landing slot has
# dispatched nothing yet, and Checks refuses the head until it does (ar-2366: agent-15 #2546, agent-18 #2516 and agent-68 #2483, queued behind #2559 on
# 2026-11-13, each read STALLED CI red and was nudged).
# The run list is branch_runs', and one the ledger cannot answer keeps <ci> and is named unreadable.
gate_ci() {
  local d="$1" br="$2" oid="$3" ci="$4" jobs="${5:--}" shell="${6:--}" runs wf st c sha seen="" pend=0 fail=0 pass=0 pendhead=0 failhead=0
  case "$ci" in
    PASS|NONE) ;;
    FAIL) [ "$jobs" != - ] && [ -n "$FLEET_GATE_LINE_STEPS" ] || { echo FAIL; return; } ;;
    *) echo "$ci"; return ;;
  esac
  if ! runs="$(branch_runs "$d" "$br")"; then echo "$ci"; return; fi
  while IFS=$'\t' read -r wf st c sha; do
    case $'\n'"$seen" in *$'\n'"$wf"$'\n'*) continue ;; esac
    [ "$sha" = "$oid" ] || git -C "$d" merge-base --is-ancestor "$sha" "$oid" 2>/dev/null || continue
    seen+="$wf"$'\n'
    if [ "$st" != completed ]; then pend=1; [ "$sha" = "$oid" ] && pendhead=1
    elif [ "$c" = success ]; then pass=1
    else fail=1; [ "$sha" = "$oid" ] && failhead=1; fi
  done < <(jq -r --arg gates "$FLEET_GATE_WORKFLOWS" \
             'map(select(.event == "workflow_dispatch" and (.workflowName | test($gates))
                     and (.status != "completed"
                          or ((.conclusion // "") | test("^(success|failure|timed_out|startup_failure)$")))))
                  | sort_by(.createdAt) | reverse | .[]
                  | [.workflowPath, .status, ((.conclusion // "") | if . == "" then "-" else . end), .headSha]
                  | @tsv' <<<"$runs")  # "-": IFS tab would merge an empty field into the next
  if [ "$ci" = FAIL ]; then
    if { [ "$pendhead" = 1 ] || { { [ "$shell" = gate ] || [ "$shell" = queue ]; } && [ "$failhead" = 0 ]; }; } && gate_line_only "$d" "$jobs"; then echo PENDING; else echo FAIL; fi
  elif [ "$pend" = 1 ]; then echo PENDING
  elif [ "$fail" = 1 ]; then echo FAIL
  elif [ "$pass" = 1 ]; then echo PASS
  else echo "$ci"; fi
}

# job_facts <dir> <job id> -> one line of JSON, {conclusion, steps: [{name, conclusion}]}, for an Actions job.
# A finished job never changes, so it is one gh call kept in MAIN_CACHE; one read serves gate_line_only and
# jobs_unstarted. Returns 1 (and marks the row blind) when gh cannot read it.
job_facts() {
  local d="$1" id="$2" file="$MAIN_CACHE/job_facts_$2" out
  if [ ! -s "$file" ]; then
    out="$(cd "$d" && gh api "repos/{owner}/{repo}/actions/jobs/$id" \
      -q '{conclusion, steps: [(.steps // [])[] | {name, conclusion}]} | tojson' 2>/dev/null)" && [ -n "$out" ] \
      || { unreadable "gh api actions/jobs/$id ($(basename "$d"))"; blind_row; return 1; }
    mkdir -p "$MAIN_CACHE"
    printf '%s\n' "$out" > "$file.$$" && mv "$file.$$" "$file"
  fi
  cat "$file"
}

# jobs_unstarted <dir> <red job ids> -> true when every red check is an Actions job that failed having run no
# steps: it never started (an Actions billing or spending-limit block, a runner outage), so no code of the
# PR's is red and a fix cannot exist (2026-11-16 private#945 read STALLED "CI red" with 0 steps on every
# job). A check that is not a job (-), a cancelled job, a job with a step, or one gh cannot read is a real red.
jobs_unstarted() {
  local id
  [ "${2:--}" != - ] || return 1
  for id in ${2//,/ }; do
    [ "$id" != - ] || return 1
    job_facts "$1" "$id" | jq -e '.conclusion == "failure" and (.steps | length) == 0' >/dev/null || return 1
  done
}

# gate_line_only <dir> <red job ids> -> true when each job failed only in FLEET_GATE_LINE_STEPS steps.
# A cancelled job, a check that is not a job (-) or one gh cannot read is a real red.
gate_line_only() {
  local id steps n
  for id in ${2//,/ }; do
    [ "$id" != - ] || return 1
    steps="$(job_facts "$1" "$id" | jq -r '[.steps[] | select((.conclusion // "skipped") | test("^(success|skipped)$") | not) | .name]
            | if length == 0 then "-" else .[] end')" && [ -n "$steps" ] || return 1
    while IFS= read -r n; do [[ "$n" =~ $FLEET_GATE_LINE_STEPS ]] || return 1; done <<<"$steps"
  done
}

# refused_by <dir> <job id> -> the PR number a job's "landing slot: #N holds main" annotation names (gate-line.py
# slot_problem, the text its --rerun-refused matches), or nothing. A refusal found is kept in MAIN_CACHE, since a
# finished job's annotations never change; no refusal is kept for this pass only, so annotations not yet readable
# when the job turned red are read again next pass. Returns 1 (and marks the row blind) when gh cannot read them.
refused_by() {
  local file="$MAIN_CACHE/job_refused_$2" pass="$CACHE/job_refused_$2" out
  [ ! -s "$file" ] || { cat "$file"; return; }
  [ ! -f "$pass" ] || { cat "$pass"; return; }
  out="$(cd "$1" && gh api "repos/{owner}/{repo}/check-runs/$2/annotations" \
    -q 'first(.[].message | capture("^landing slot: #(?<n>[0-9]+) holds main") | .n) // ""' 2>/dev/null)" \
    || { unreadable "gh api check-runs/$2/annotations ($(basename "$1"))"; blind_row; return 1; }
  if [ -n "$out" ]; then mkdir -p "$MAIN_CACHE"; printf '%s\n' "$out" > "$file.$$" && mv "$file.$$" "$file"
  else : > "$pass"; fi
  printf '%s\n' "$out"
}

# slot_refuser <dir> <pr> <red job ids> -> the number of the open PR holding the landing slot (FLEET_SLOT_LABEL in the PR store)
# when PR #<pr>'s only red is the gate line, and each red job's annotation says that PR's slot refused it, else
# nothing (rc 1). That red is no fault of the branch: gate-line.py's --rerun-refused runs its Checks again once the
# holder lets go, so the PR waits on the holder with no gate of its own running and no landing-queue label (ar-3596:
# 2026-11-19 agent-23 ucp#2913, refused by train #2918, read STALLED CI red). A holder the store no longer shows
# holding is no wait: the red is the session's again.
slot_refuser() {
  local key red="${3:--}" id n h=""
  [ -n "$FLEET_SLOT_LABEL" ] && [ -n "$FLEET_GATE_LINE_STEPS" ] || return 1
  key="$(prs_key "$1")" || return 1
  # Cheapest first: another PR holds the slot, then the steps (job_facts), then one annotations read a job.
  [ "$red" != - ] && [ -f "$key.slot" ] && grep -vqxF "$2" "$key.slot" && gate_line_only "$1" "$red" || return 1
  for id in ${red//,/ }; do
    n="$(refused_by "$1" "$id")" && [ -n "$n" ] && [ "$n" != "$2" ] || return 1
    [ -z "$h" ] || [ "$h" = "$n" ] || return 1
    h="$n"
  done
  grep -qxF "$h" "$key.slot" || return 1
  printf '%s\n' "$h"
}

# pr_made_here <dir> <N> <branch> <session_prs JSON> <transcript> <plan|-> [<other plans>] -> true
# when this session made PR #N of <dir>'s repo: its plan's Phases name #N (bare, not <repo>#N), it
# opened or merged it (session_prs, a Forgejo repo's host dropped, since the clone's origin names
# only owner/repo), or, when no plan in <other plans> (newline-separated: the plans of the other
# windows in this worktree) names #N, its transcript holds the PR's URL or it pushed <branch> (the
# command, or git's `-> <branch>` line for a bare `git push`). A PR belongs to the plan it served:
# worktrees and branch names are shared and recycled, and a session that reads another window's PR
# (`gh pr view` prints its URL) holds it in its transcript. trader-real-money-plan read LANDED on
# #42 and #50 of so-how-do-i-velvet-pine, run in another window of its worktree (ar-492).
pr_made_here() {
  local repo n="$2" br="$3" t="$5" plan="$6" other re
  repo="$(origin_repo "$1")"
  phases_name "$plan" "$n" && return 0
  jq -e --arg r "${repo,,}" --argjson n "$n" 'any(.[]; (.repo | ascii_downcase | split("/")[-2:] | join("/")) == $r and .number == $n)' \
    <<<"$4" >/dev/null 2>&1 && return 0
  # The same plan under another account's plans dir is this plan, not another window's.
  while IFS= read -r other; do
    [ -n "$other" ] && [ "${other##*/}" != "${plan##*/}" ] && phases_name "$other" "$n" && return 1
  done <<<"${7:-}"
  [ -f "$t" ] || return 1
  [ -n "$repo" ] && grep -qiE "github\.com/$(re_quote "$repo")/pull/$n([^0-9]|$)" "$t" && return 0
  [ "$br" != - ] || return 1
  re="$(re_quote "$br")"
  grep -qE "(git push[^\"]*( |:|refs/heads/)| -> )$re([^A-Za-z0-9._/-]|$)" "$t"
}

# phases_name <plan|-> <N> -> true when the plan's ## Phases section names #N (bare, not <repo>#N).
phases_name() {
  [ "$1" != - ] && [ -f "$1" ] \
    && sed -n '/^## Phases/,/^## /p' "$1" | grep -qE "(^|[^A-Za-z0-9_./-])#$2([^0-9]|$)"
}

# landed_named <"#N,#M" | -> <plan files...> -> the PRs of that list that a plan's ## Phases section names
# (bare `#N`, as phases_name reads it), else -. Several plan files are one plan under other names (a copy,
# a pointer's canonical): any of them counts.
landed_named() {
  local list="$1" f n out=""; shift
  for n in ${list//,/ }; do
    for f in "$@"; do
      phases_name "$f" "${n#\#}" && { out="${out:+$out,}$n"; break; }
    done
  done
  echo "${out:--}"
}

# re_quote <text> -> <text> with ERE metacharacters escaped.
re_quote() { sed 's/[][\.*^$+?(){}|]/\\&/g' <<<"$1"; }

# sibling_pr <dir> <session_prs JSON> -> "repo \t number \t ci \t head_oid" for the last OPEN PR
# this session opened in a repo other than <dir>'s, or nothing. A session that works in one clone
# can open its PR from another (ar-349, read STALLED "no PR" while that PR ran CI). A Forgejo PR
# (host/owner/repo) is skipped: gh cannot read its CI. Its CI is one
# `gh pr view` reused for FLEET_MAIN_TTL seconds across passes; a failed call
# (or an answer that is not a PR) adopts the PR with CI unknown (-), is not cached, nor retried in this pass, and is named unreadable so tick does not log the blink.
sibling_pr() {
  local own repo n file failed view
  own="$(origin_repo "$1")"
  IFS=$'\t' read -r repo n < <(jq -r --arg own "${own,,}" \
    'map(select(.state == "OPEN" and (.repo | test("^[^/]+/[^/]+$")) and (.repo | ascii_downcase) != $own)) | last // empty | [.repo, .number] | @tsv' <<<"$2")
  [ -n "${n:-}" ] || return 0
  file="$MAIN_CACHE/view_${repo//\//_}_$n.json"
  failed="$CACHE/view_failed_${repo//\//_}_$n"
  if [ -s "$file" ] && [ $(( $(date +%s) - $(date -r "$file" +%s) )) -lt "$FLEET_MAIN_TTL" ]; then
    view="$(cat "$file")"
  elif [ ! -f "$failed" ] && view="$(gh pr view "$n" --repo "$repo" --json statusCheckRollup,headRefOid 2>/dev/null)" \
       && jq -e 'has("headRefOid")' <<<"$view" >/dev/null 2>&1; then
    mkdir -p "$MAIN_CACHE"
    printf '%s\n' "$view" > "$file.$$" && mv "$file.$$" "$file"
  else
    [ -f "$failed" ] || { : > "$failed"; unreadable "gh pr view $repo#$n"; }
    blind_row; printf '%s\t%s\t-\t-\n' "$repo" "$n"; return 0
  fi
  jq -r --arg r "$repo" --argjson n "$n" "$CI_JQ"' [$r, $n, ci, (.headRefOid // "-")] | @tsv' <<<"$view"
}

# canonical_remote <dir> -> the git remote a checkout's default branch lives on: the Forgejo remote of a
# Forgejo-canonical repo (home-config: `forgejo`; its `origin` is the GitHub mirror, which trails a merge until
# the mirror runs), else origin. so_forge_remote is the rule agent-land shares.
canonical_remote() { local r; r="$(forge_of "$1")"; printf '%s\n' "${r%% *}"; }

# forge_of <dir> -> so_forge_remote's "<remote> HOST/OWNER/REPO" for a checkout that lands on Forgejo, else
# "origin". One answer per directory per pass, which canonical_remote and prs_for share.
forge_of() {
  local r f="${CACHE:+$CACHE/canon_${1//\//%}}"
  if [ -n "$f" ] && [ -s "$f" ]; then cat "$f"; return; fi
  r="$(so_forge_remote "$1" 2>/dev/null)" || r=origin
  [ -z "$f" ] || { printf '%s\n' "$r" > "$f.$$" && mv -f "$f.$$" "$f"; }
  printf '%s\n' "$r"
}

# default_base <dir> -> <canonical remote>/<default branch>, kept in MAIN_CACHE for FLEET_BASE_TTL across passes.
# The cache key names the remote too: clones of one origin URL may not share a forgejo remote.
# GitHub's answer wins: a remote's HEAD is set at clone time and goes stale when the default branch changes.
# The canonical remote's own default (merge_proof_branch: its HEAD symref, which a later `git remote add` never
# sets, else its develop, main or master) is the offline fallback, and a name this clone has no remote ref for is unused.
default_base() {
  local d="$1" key pass b slug rem confirmed=
  slug="$(repo_slug "$d")" || { echo origin/main; return; }
  rem="$(canonical_remote "$d")"
  key="$MAIN_CACHE/base_${slug}_$rem" pass="$CACHE/base_${slug}_$rem"
  if [ -s "$key" ] && [ $(( $(date +%s) - $(date -r "$key" +%s) )) -lt "$FLEET_BASE_TTL" ]; then cat "$key"; return; fi
  if [ ! -s "$pass" ]; then
    b="$(cd "$d" && gh repo view --json defaultBranchRef -q .defaultBranchRef.name 2>/dev/null)"
    if [ -n "$b" ] && git -C "$d" rev-parse -q --verify "refs/remotes/$rem/$b" >/dev/null 2>&1; then
      confirmed=1
    else
      b="$(MERGE_PROOF_REMOTE="$rem" merge_proof_branch "$d")"
    fi
    # Only GitHub's answer outlives the pass: the symref may be the stale one, and a refused call must not pin it.
    if [ -n "$confirmed" ]; then mkdir -p "$MAIN_CACHE"; echo "$rem/$b" > "$key.$$" && mv "$key.$$" "$key"; fi
    echo "$rem/${b:-main}" > "$pass"
  fi
  cat "$pass"
}

# main_state: main_runs JSON (any order) on stdin -> one line per workflow whose latest
# decided run failed: "workflow \t first_red_sha \t last_green_sha|-". The red sha is the
# FIRST failure after the last green (the oldest in the window when there is none), so the
# fact holds still while a red streak runs on, and the suspect range ends where it broke.
# Cancelled, skipped, running and FLEET_PARTIAL_RUNS runs decide nothing, so they are passed over,
# and so is a workflow MAIN_LIVE drops (no run in MAIN_STALE_HOURS before the branch's newest run).
main_state() {
  jq -r --arg partial "$FLEET_PARTIAL_RUNS" \
    'map(select(.workflowName // "" | test($partial) | not))
     | '"$MAIN_LIVE | $MAIN_STREAKS"' | [.workflow, .red.headSha, (.green.headSha // "-")] | @tsv'
}

# pr_states <owner/repo or host/owner/repo (Forgejo)> -> the repo's PRs as a JSON array of {number, state, mergedAt},
# from the PR store, read once per pass: it keys on the repo the PR is in, not the cwd, since one session
# lands PRs in several. A repo the store cannot answer for is rc 1, and not read again this pass.
pr_states() {
  local repo="$1" file
  file="$CACHE/prs_${repo//\//_}.json"
  if [ ! -f "$file" ]; then
    store_refresh "$repo"
    "$SCHEDULES_SYNC" prs "$repo" 2>/dev/null | jq -c 'map({number, state, mergedAt: .merged_at})' > "$file" 2>/dev/null
  fi
  [ -s "$file" ] && cat "$file"
}

# inflight_done_items: the done items of this pass ($qall) whose recorded PRs (`pr:`, "owner/repo#N ...")
# include one still OPEN in the PR store, one JSON line each, for the phase holders beside the live items.
# Its phases are in flight elsewhere: 2026-11-10 agent-land closed urgent-runs-now-p2 on public #1727
# while P3 rode private #733, done items held no phase, and hub/dotfiles:9 read LANDED "queue P3" (ar-1429).
# A repo the store cannot answer for holds nothing, so its phase reads as next, never as queued.
inflight_done_items() {
  # held: only an item that can hold a phase (a plan: field or a "Phase N of" task) costs a PR store read.
  local refs repo open="" sel='def held: select(.state == "done" and ((.plan // "") != ""
      or ((.task // "") | test("(?i)\\bphases? [^\\s:,]+ of "))));
    def refs: .pr // "" | tostring | split(" ") | map(select(test("^[^#]+#[0-9]+$")));'
  refs="$(jq -r "$sel"' held | refs[]' <<<"$qall")" || return 1
  [ -n "$refs" ] || return 0
  while IFS= read -r repo; do
    open+="$(pr_states "$repo" | jq -r --arg r "$repo" '.[] | select(.state == "OPEN") | "\($r)#\(.number)"')"$'\n'
  done < <(sed 's/#[0-9]*$//' <<<"$refs" | sort -u)
  jq -c --arg open "$open" "$sel"' ($open | split("\n")) as $o | held | select(refs | any(. as $p | $o | index($p)))' <<<"$qall"
}

# inflight_done: inflight_done_items, read once a run into $CACHE/inflight_done; a failed read is named
# unreadable and its row blind, so the phase reads as next, never as queued.
inflight_done() {
  [ -f "$CACHE/inflight_done" ] || { inflight_done_items > "$CACHE/inflight_done.$$" 2>/dev/null || { unreadable "done items' open PRs"; blind_row; }
    mv -f "$CACHE/inflight_done.$$" "$CACHE/inflight_done"; }
  cat "$CACHE/inflight_done"
}

# merged_prs <session_prs json> -> "#7,#9" for the PRs that merged, "-" for none (work_blockers' 23rd argument).
merged_prs() {
  jq -r 'map(select(.state == "MERGED") | "#\(.number)") | if length == 0 then "-" else join(",") end' <<<"$1"
}

# session_prs <transcript> -> the PRs this session opened or merged, as a JSON array of
# {repo, number, state, merged_at}. A PR its repo's list does not reach has a null state. A Forgejo alias host is
# read as the store's (so_canon_claims); collect runs so_canon_init once, so each row inherits the alias list.
session_prs() {
  local f="$1" prs repo
  [ -f "$f" ] || { echo '[]'; return; }
  prs="$(so_transcript_metrics "$f" | so_canon_claims "${SO_PROJECT_MAP:-$HOME/.config/shared-hooks/project-map.json}" 2>/dev/null | jq -c '.prs // []')" \
    || { unreadable "PR claims (project map or alias list)"; blind_row; echo '[]'; return; }
  [ -n "$prs" ] || { echo '[]'; return; }
  # a repo's whole PR list goes through a pipe, never argv: it outgrows an argument's 128 KB
  while IFS= read -r repo; do
    pr_states "$repo" | jq -c --arg r "$repo" '{($r): map({key: (.number | tostring), value: .}) | from_entries}' || :
  done < <(jq -r '.[].repo' <<<"$prs" | sort -u) |
    jq -sc --argjson p "$prs" '(add // {}) as $s | $p | map(. + {state: $s[.repo][.number | tostring].state,
      merged_at: $s[.repo][.number | tostring].mergedAt})'
}

# prs_cell: session_prs output on stdin -> "<merged>/<total>", with a ? while any state is
# unknown, or - with no PRs.
prs_cell() {
  jq -r 'if length == 0 then "-" else
    "\(map(select(.state == "MERGED")) | length)/\(length)\(if any(.state == null) then "?" else "" end)" end'
}

# main_health <dir> -> "RED \t <detail> \t <red sha>", "OK" or "UNKNOWN", cached per repo per
# pass. A red workflow's range is last-green..red on this clone, and its (#N) squash subjects are
# its suspects only when there are FLEET_SUSPECTS_MAX or fewer, kept per workflow for main_blame.
# No green in the window, a range the clone lacks, or a FLEET_DEPLOY_PROBES workflow names nobody.
main_health() {
  local dir="$1" url key blame base b runs st wf red green wfs="" sha="" range one named p
  url="$(git -C "$dir" remote get-url origin 2>/dev/null)" || { echo OK; return; }
  key="$CACHE/main_$(repo_slug "$dir")"
  blame="$CACHE/blame_$(repo_slug "$dir")"
  if [ ! -f "$key" ]; then
    : > "$blame"
    base="$(default_base "$dir")"
    b="${base#*/}"
    # Could not look is not green: say so, so the shepherd never reads a dead gh, or runs main_state
    # cannot read, as healthy.
    if ! runs="$(branch_runs "$dir" "$b")" || ! st="$(main_state <<<"$runs")"; then
      printf 'UNKNOWN\t-\t-\t%s\n' "$(basename "$url" .git)" > "$key"
      cut -f1-3 "$key"; return
    fi
    while IFS=$'\t' read -r wf red green; do
      [ -n "$wf" ] || continue
      [ -n "$sha" ] || sha="$red"
      named=""
      if [ -n "$FLEET_DEPLOY_PROBES" ] && [[ $wf =~ $FLEET_DEPLOY_PROBES ]]; then range="probes a deployment"
      elif [ "$green" = - ]; then range="no green in window"
      elif ! git -C "$dir" cat-file -e "$red^{commit}" 2>/dev/null \
           || ! git -C "$dir" cat-file -e "$green^{commit}" 2>/dev/null; then range="range not in clone"
      else
        range="$(git -C "$dir" log --format=%s "$green..$red" | grep -oE '\(#[0-9]+\)$' | tr -dc '0-9\n' | sort -un | tr '\n' ' ')"
        range="${range% }"
        if [ -z "$range" ]; then range="no PR in range"
        elif [ "$(wc -w <<<"$range")" -le "$FLEET_SUSPECTS_MAX" ]; then named="$range"; range="#${range// / #}"
        else range="$(wc -w <<<"$range") PRs since green"; fi
      fi
      # No green: the oldest red in view slides as runs age out, so that fact names no sha.
      if [ "$green" = - ]; then one="$wf ($range)"; else one="$wf @${red:0:8} ($range)"; fi
      wfs="${wfs:+$wfs, }$one"
      for p in $named; do printf '%s\t%s\n' "$p" "$one" >> "$blame"; done
    done <<<"$st"
    # Every field non-empty: read with a tab IFS folds an empty field into the next.
    if [ -n "$wfs" ]; then printf 'RED\t%s\t%s\t%s\n' "$wfs" "${sha:0:8}" "$(basename "$url" .git)" > "$key"
    else echo OK > "$key"; fi
  fi
  [ "$(cut -f1 "$key")" != UNKNOWN ] || blind_row   # a later row of the repo read the same failed ledger
  cut -f1-3 "$key"
}

# main_blame <dir> <PR> -> the red workflows of <dir>'s main whose suspects name <PR>, comma-joined;
# rc 1 for none. It runs main_health itself (a cache hit after the first), so its file is always there. Only those are its merge's to fix: agent-10's #2983
# was a suspect of Drop closed gates alone, and its close verdict also held it for iOS release, Phone
# release, Release builds and Slim tour, reds whose ranges did not name it (ar-3985).
main_blame() {
  main_health "$1" > /dev/null
  awk -F'\t' -v p="$2" '$1 == p { out = out (out == "" ? "" : ", ") $2 } END { if (out == "") exit 1; print out }' \
    "$CACHE/blame_$(repo_slug "$1")" 2>/dev/null
}

# store_landed <toplevel> -> exit 0 when <toplevel> is the agent store (AGENT_STORE) or the notes vault
# (NOTES_STORE). store-sync commits and pushes both on its own and many writers share them, so nothing in
# either is a session's to land by PR: as a repo it edited (#2719) or as its own cwd (ar-3883). A store
# is only a repo root: one inside a bigger checkout must not make that whole checkout unlandable. Their
# roots are read once per process (STORE_TOPS), as this runs per session and per edited repo.
STORE_TOPS=""
store_landed() {
  local s t
  [ -n "$1" ] || return 1
  if [ -z "$STORE_TOPS" ]; then
    STORE_TOPS=:
    for s in "$AGENT_STORE" "$NOTES_STORE"; do
      t="$(git -C "$s" rev-parse --show-toplevel 2>/dev/null)" && [ "$t" = "$(cd "$s" && pwd -P)" ] && STORE_TOPS="$STORE_TOPS$t:"
    done
  fi
  [[ "$STORE_TOPS" == *":$1:"* ]]
}

# edited_work_blockers <cwd> <edited paths>: unlanded work in other repositories this
# session edited. Never scan unrelated sibling worktrees or count their work as ours, nor a
# store store-sync lands (store_landed).
edited_work_blockers() {
  local cwd="$1" edited="$2" top path dir g dirty ahead pr state ci inpr branch behind conflicts fork oid names why bucket red health workflows kind=WORKING out=""
  [ -n "$edited" ] || return 0
  top="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)"
  while IFS= read -r dir; do
    [ -n "$dir" ] && [ "$dir" != "$top" ] && ! store_landed "$dir" || continue
    read -r g dirty ahead pr state ci inpr branch behind conflicts fork oid names < <(git_facts "$dir" "$edited")
    red=-
    if [ "$state" = MERGED ]; then
      IFS=$'\t' read -r health _ < <(main_health "$dir")
      if [ "$health" = RED ] && workflows="$(main_blame "$dir" "$pr")"; then
        red="$workflows"
        [ -z "${3:-}" ] || printf '%s\t%s\n' "$(repo_slug "$dir")" "$3" >> "$CACHE/owners"
      fi
    fi
    # A completed checklist suppresses plan blockers: only this tree's git facts matter.
    why="$(work_blockers '' idle 0 0 0 30 "$g" "$dirty" "$ahead" "$pr" "$state" "$ci" "$inpr" "$red" 1/1 - "$conflicts" - "$names")"
    if [ -n "$why" ]; then
      bucket="$(session_bucket idle 0 0 0 "$FLEET_IDLE_MIN" "$g" "$dirty" "$ahead" "$pr" "$state" "$ci" "$inpr" "$red" 1/1 - "$conflicts" - "$names")"
      [ "${bucket%% *}" != STALLED ] || kind=STALLED
      out="${out:+$out; }$dir: $why"
    fi
  done < <(
    while IFS= read -r path; do
      [[ "$path" = /* ]] || continue
      dir="$(dirname -- "$path")"
      while [ ! -d "$dir" ] && [ "$dir" != / ]; do dir="$(dirname -- "$dir")"; done
      git -C "$dir" rev-parse --show-toplevel 2>/dev/null
    done <<<"$edited" | sort -u
  )
  [ -z "$out" ] || printf '%s unlanded work in %s' "$kind" "$out"
}

# dirty_names <paths, one per line>: the first FLEET_DIRTY_NAMES of them for a reason, "+N more"
# past that; - when there are none. "1 dirty file(s)" alone sent agent-18 (2026-11-04) and the
# human guessing: the one file was a submodule Unity had re-imported.
dirty_names() {
  awk -v k="$FLEET_DIRTY_NAMES" 'NF { n++; if (n <= k) s = s (n > 1 ? ", " : "") $0 }
    END { if (n > k) s = s ", +" (n - k) " more"; print (n ? s : "-") }' <<<"$1"
}

# pass_base <dir>: default_base after this pass's fetch of <dir>; the base reader a pass hands unlanded_files.
pass_base() { fetch_once "$1"; default_base "$1"; }

# fetch_once <dir>: with FLEET_FETCH=1 (tick sets it), fetch the canonical remote once per repo per pass,
# so behind and conflicts are measured against the remote tip, not the last manual fetch.
# Worktrees of one repo share its refs, so one fetch covers them all.
fetch_once() {
  [ "${FLEET_FETCH:-0}" = 1 ] || return 0
  local key
  key="$CACHE/fetched_$(repo_slug "$1")" || return 0
  [ -f "$key" ] || { git -C "$1" fetch -q "$(canonical_remote "$1")" 2>/dev/null; : > "$key"; }
}

# sync_facts <dir> <base> -> "behind conflicts fork": commits on the base this branch lacks,
# whether merging the base in would conflict (yes|no), and on a conflict the merge base (else
# -). merge-tree touches no checkout. The merge base moves only when the branch takes the base
# in, so it names one conflict across pushes and the base moving on.
sync_facts() {
  local d="$1" base="$2" behind conflicts=no fork=-
  behind="$(git -C "$d" rev-list --count "HEAD..$base" 2>/dev/null)" || { echo "- - -"; return; }
  if [ "$behind" -gt 0 ]; then
    git -C "$d" merge-tree --write-tree --no-messages "$base" HEAD >/dev/null 2>&1
    case $? in 0) ;; 1) conflicts=yes ;; *) conflicts=- ;; esac
  fi
  [ "$conflicts" = yes ] && fork="$(git -C "$d" merge-base "$base" HEAD 2>/dev/null)"
  echo "$behind $conflicts ${fork:--}"
}

# off_default_checkouts -> each checkout stow deploys (the two dotfiles-drift reads) that is not on
# its default branch, one per line. Worktrees are never in it: a branch is what they are for.
# The local answer (merge_proof_branch) settles the usual case, so a clean pass costs no gh call. Each is its real path,
# which is how a session's cwd reads.
off_default_checkouts() {
  local d cur base rem
  for d in "${DOTFILES:-$HOME/.dotfiles}" "${DOTFILES_PRIVATE:-$HOME/.dotfiles-private}"; do
    [ -e "$d/.git" ] || continue
    cur="$(git -C "$d" symbolic-ref -q --short HEAD)"
    rem="$(canonical_remote "$d")"
    [ -n "$cur" ] && [ "$cur" = "$(MERGE_PROOF_REMOTE="$rem" merge_proof_branch "$d")" ] && continue
    base="$(default_base "$d")"
    [ "$cur" = "${base#*/}" ] || realpath "$d"
  done
}

# in_checkout <dir> <checkouts, one per line>: <dir> is one of them or inside one.
in_checkout() {
  local c
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    case "$1/" in "$c"/*) return 0 ;; esac
  done <<<"$2"
  return 1
}

# pr_of_head <dir> <branch> -> prs_for's row for the PR that holds this clone's HEAD, or nothing.
# A PR whose head commit is HEAD wins whatever its head branch is: a slot branch is reused and its
# work can go out on another branch (2026-11-07: agent-20 landed as #1500 via all-sources-p5-scoring,
# and the older closed #1490 of the same name was named the blocker). Else an open PR of the local or
# upstream branch name whose head holds HEAD, else the newest of them, except a closed one that does not hold
# HEAD: that is an old PR. Open first: slot branch `agent-69` with upstream refactor/ar-88-delete-batch-rerun read the
# bare name's old merged #2125, not the open #2014 its upstream heads, and its row "no PR" (ar-1582).
# A worker's checkout passes its <head> and <upstream branch> (worker_git_facts); <dir> is then this
# machine's clone of its repo, which may not have that head.
pr_of_head() {
  local d="$1" branch="$2" head="${3:-}" up="${4:-}" row s o hit prs named
  if [ -z "$head" ]; then
    head="$(git -C "$d" rev-parse HEAD 2>/dev/null)" || return 0
    up="$(git -C "$d" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)"; up="${up#*/}"
  fi
  # The PR store lists every PR of the repo (thousands of rows): awk picks the few rows a bash
  # read loop would have walked one by one (849K of a pass's 1M trace lines, 2026-11-16).
  prs="$(prs_for "$d")"
  [ -n "$prs" ] || return 0
  hit="$(awk -F'\t' -v h="$head" '$5 == h { print; exit }' <<<"$prs")"
  [ -z "$hit" ] || { printf '%s\n' "$hit"; return; }
  # A branch cut from the default branch tracks it: that name is no PR of its own.
  if [ -n "$up" ]; then hit="$(default_base "$d")"; [ "$up" != "${hit#*/}" ] || up=""; fi
  # Names go in by ENVIRON, not -v, which would read a backslash in a branch name as an escape.
  named="$(PR_BRANCH="$branch" PR_UP="$up" awk -F'\t' 'BEGIN { b = ENVIRON["PR_BRANCH"]; u = ENVIRON["PR_UP"] } $1 == b || (u != "" && $1 == u)' <<<"$prs")"
  [ -n "$named" ] || return 0
  while IFS= read -r row; do
    IFS=$'\t' read -r _ _ s _ o _ <<<"$row"
    [ "$s" = OPEN ] && git -C "$d" merge-base --is-ancestor "$head" "$o" 2>/dev/null && { printf '%s\n' "$row"; return; }
  done <<<"$named"
  while IFS= read -r row; do
    IFS=$'\t' read -r _ _ s _ o _ <<<"$row"
    if [ "$s" = CLOSED ] && ! git -C "$d" merge-base --is-ancestor "$head" "$o" 2>/dev/null; then continue; fi
    printf '%s\n' "$row"; return
  done <<<"$named"
}

# pr_for_head <dir> <branch> <ahead> [<head> <upstream branch>] -> the PR row git_facts reads: pr_of_head's,
# unless HEAD has files the base lacks and that PR is missing, or finished without holding HEAD; then the
# open PR whose head holds HEAD (pr_holding_head) when there is one. Work that went out on another head
# branch is found by HEAD, not by the slot name's old PR (ar-1582). A finished PR whose head this clone
# lacks stays: nothing says it does not hold HEAD. A HEAD this clone lacks (a worker's unpushed one)
# is held by no PR here, so it scans none. A worker's checkout passes <head> and <upstream>.
pr_for_head() {
  local d="$1" branch="$2" ahead="$3" head="${4:-HEAD}" up="${5:-}" row s o held
  row="$(pr_of_head "$d" "$branch" "${4:-}" "$up")"
  IFS=$'\t' read -r _ _ s _ o _ <<<"$row"
  [ "$ahead" -gt 0 ] && git -C "$d" cat-file -e "$head^{commit}" 2>/dev/null || { [ -z "$row" ] || printf '%s\n' "$row"; return 0; }
  if [ -z "$row" ] || { [ "$s" != OPEN ] && git -C "$d" cat-file -e "$o^{commit}" 2>/dev/null \
       && ! git -C "$d" merge-base --is-ancestor "$head" "$o" 2>/dev/null; }; then
    held="$(pr_holding_head "$d" "$head")"
    [ -z "$held" ] || row="$held"
  fi
  [ -z "$row" ] || printf '%s\n' "$row"
}

# pr_holding_head <dir> -> prs_for's row for the oldest OPEN PR whose head holds this clone's HEAD
# (the nearest of a stack, which lands it first), or nothing. A stacked branch has no PR of its own when its commits went out inside the PR of the
# branch built on it (ar-82: agent-51 feat/tourney-daily-cap inside #1674). pr_for_head asks only
# when HEAD has files the base lacks, so a HEAD still on the base, held by every PR, never asks.
# A worker's checkout passes its <head>, as pr_of_head.
pr_holding_head() {
  local d="$1" head="${2:-}" row o hit=""
  [ -n "$head" ] || head="$(git -C "$d" rev-parse HEAD 2>/dev/null)" || return 0
  while IFS= read -r row; do
    IFS=$'\t' read -r _ _ _ _ o _ <<<"$row"
    git -C "$d" merge-base --is-ancestor "$head" "$o" 2>/dev/null && hit="$row"
  done < <(prs_for "$d" | awk -F'\t' '$3 == "OPEN"')   # newest first, so the last hit is the oldest
  [ -z "$hit" ] || printf '%s\n' "$hit"
}

# merged_inpr <state> <ahead> <based> -> 1 when a HEAD past its PR head is still nothing new: the PR is
# MERGED and the commits after it hold no file the base lacks (ahead 0: a merge of the default branch, or
# the squashed commits a deleted PR branch no longer holds), else 0. ar-5151: dotfiles-agent-4 on
# razer-laptop merged origin/main after #2798 and read STALLED "commits after merged PR" for four days, so
# its wind-down never closed the window. Only a measured 0 counts: ahead_files reads 0 when HEAD has no
# merge base with the base, so <based> (1: HEAD shares history with the base) must hold too.
merged_inpr() {
  [ "$1" = MERGED ] && [ "$2" = 0 ] && [ "$3" = 1 ] && echo 1 || echo 0
}

# One session's facts as the session_bucket arguments after status/plan/asks/heavy/idle,
# plus branch, sync, the PR head and the dirty names (last: they may hold spaces):
# "git dirty ahead pr state ci in_pr branch behind conflicts fork oid names". <shell job> is the
# open job of the session's background shell, for gate_ci (- when it has none); <chain> is chain_hold's answer.
git_facts() {
  local d="$1" edited="${2:-}" shell="${3:--}" chain="${4:-}" branch dirty=0 paths ahead base prb pr state ci oid red inpr=1 head
  [ -d "$d" ] || { echo "gone 0 0 - - - 1 - - - - - -"; return; }
  git -C "$d" rev-parse --git-dir >/dev/null 2>&1 || { echo "0 0 0 - - - 1 - - - - - -"; return; }
  branch="$(git -C "$d" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  # A session working in a store reads other writers' files and store-sync's unpushed commit there (ar-3883).
  store_landed "$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)" && { echo "1 0 0 - - - 1 ${branch:--} 0 no - - -"; return; }
  fetch_once "$d"
  paths="$(dirty_paths "$d" "$edited")"
  [ -n "$paths" ] && dirty="$(wc -l <<<"$paths")"
  base="$(default_base "$d")"
  ahead="$(unlanded_files "$d" "$base" pass_base)"
  IFS=$'\t' read -r prb pr state ci oid red < <(pr_for_head "$d" "$branch" "$ahead")
  [ "${state:-}" = OPEN ] && ci="$(open_pr_ci "$d" "$prb" "$pr" "$oid" "$ci" "$red" "$shell" "$chain")"
  if [ -n "${oid:-}" ]; then
    head="$(git -C "$d" rev-parse HEAD)"
    # HEAD is in the PR when it is the PR head or behind it; an unknown oid means the
    # remote holds commits this clone lacks, which is also "nothing new here". HEAD already
    # in the base is landed too: a reused slot branch keeps its name, so its newest PR by
    # name is an old one whose head this HEAD has moved past.
    if [ "$head" != "$oid" ] && git -C "$d" cat-file -e "$oid^{commit}" 2>/dev/null \
       && ! git -C "$d" merge-base --is-ancestor HEAD "$oid" 2>/dev/null \
       && ! git -C "$d" merge-base --is-ancestor HEAD "$base" 2>/dev/null; then inpr=0; fi
  fi
  [ "$inpr" = 0 ] && inpr="$(merged_inpr "${state:-}" "$ahead" "$(git -C "$d" merge-base HEAD "$base" >/dev/null 2>&1 && echo 1)")"
  echo "1 $dirty $ahead ${pr:--} ${state:--} ${ci:--} $inpr ${branch:--} $(sync_facts "$d" "$base") ${oid:--} $(dirty_names "$paths")"
}

# open_pr_ci <dir> <PR head branch> <pr> <head oid> <store ci> <red job ids> <shell job> [<chain>] -> an open PR's ci.
# The gate runs are on the PR's head branch, which a reused slot or a stacked branch does not share.
# A PR queued for the landing slot (queued_in) waits as a queued gate shell does: a red that is only the gate line is
# the slot refusing it, and any other red is the PR's own (ar-1285). A PR whose item waits on an `after:` item that is not done
# (<chain>, chain_hold) waits the same way: its gate is not dispatched until that item lands (ar-4314), and so does one
# the slot holder refused (slot_refuser, ar-3596): when that refusal alone turns its FAIL to PENDING (no gate on its head
# runs), the holder goes in <prs_key>.refused for pr_wait. A red whose jobs ran no steps is NOSTART.
open_pr_ci() {
  local d="$1" prb="$2" pr="$3" oid="$4" ci="$5" red="$6" shell="$7" chain="${8:-}" h key
  [ -z "$FLEET_QUEUE_LABEL" ] || ! queued_in "$d" "$pr" || shell=queue
  [ -z "$chain" ] || [ "$shell" = gate ] || shell=queue
  ci="$(gate_ci "$d" "$prb" "$oid" "$ci" "$red" "$shell")"
  if [ "$ci" = FAIL ] && [ "$shell" != gate ] && [ "$shell" != queue ] && h="$(slot_refuser "$d" "$pr" "$red")"; then
    ci="$(gate_ci "$d" "$prb" "$oid" FAIL "$red" queue)"
    [ "$ci" != PENDING ] || ! key="$(prs_key "$d")" || printf '%s\t%s\n' "$pr" "$h" >> "$key.refused"
  fi
  [ "$ci" = FAIL ] && jobs_unstarted "$d" "$red" && ci=NOSTART
  printf '%s\n' "$ci"
}

# worker_clone <main checkout> <origin url> -> this machine's clone of the repo a worker's checkout is in,
# or nothing: the path of the worker's main checkout (a worker clones each repo where this machine has
# it, the roster's fleet_repos) when it is here with the same origin repo (url_repo, so an https and an
# ssh spelling match). Repo-wide reads (the PR store, main health, the run ledger) go through it; nothing
# reads its tree as the worker's.
worker_clone() {
  local d="$1" url="$2" here
  [ -n "$d" ] && [ -n "$url" ] || return 0
  here="$(git -C "$d" remote get-url origin 2>/dev/null)" || return 0
  { [ "$here" = "$url" ] || [ "$(url_repo "$here")" = "$(url_repo "$url")" ]; } && printf '%s\n' "$d"
  return 0
}

# worker_git_facts <worker row> <clone here|-> <shell job> [<chain>] -> git_facts' line for a session on a fleet worker,
# from the `git` the worker read (fleet-worker-panel.sh), its PR looked up in <clone>'s PR store by its head
# and branch as pr_of_head does; a checkout with no commit has no PR. HEAD is in the PR as git_facts reads
# it when this clone has HEAD (it was pushed); a HEAD only the worker has is in it unless it carries
# commits no remote holds. behind, conflicts and fork are not read on a worker (-). A row with no `git`,
# or a repo with no clone here, is a read with a gap: named unreadable and blind_row, so tick keeps the
# row's last cells.
worker_git_facts() {
  local d="$2" shell="${3:--}" chain="${4:-}" f g branch head up unpushed ahead based paths dirty prb pr state ci oid red inpr=1
  # One jq: host, in, origin, branch, head, upstream, unpushed, ahead, based, then each dirty path on its own line.
  mapfile -t f < <(jq -r '.host // "a worker", (.git // {} | (.in // "-"), .origin // "-", .branch // "-", .head // "",
    .upstream // "", .unpushed // 0, .ahead // 0, (if .based == true then 1 else 0 end), (.dirty // [])[])' <<<"$1" 2>/dev/null)
  g="${f[1]:--}"
  case "$g" in
    gone|0|1) ;;
    *) unreadable "git facts on ${f[0]:-a worker}"; blind_row; g=0 ;;
  esac
  [ "$g" = 1 ] || { echo "$g 0 0 - - - 1 - - - - - -"; return; }
  branch="${f[3]:--}" head="${f[4]:-}" up="${f[5]:-}" unpushed="${f[6]:-0}" ahead="${f[7]:-0}" based="${f[8]:-0}"
  paths="$(printf '%s\n' "${f[@]:9}")"; dirty=$(( ${#f[@]} - 9 ))
  if [ "$d" = - ]; then
    unreadable "PR store for ${f[2]} (no clone here)"; blind_row
  elif [ -n "$head" ]; then
    IFS=$'\t' read -r prb pr state ci oid red < <(pr_for_head "$d" "$branch" "$ahead" "$head" "$up")
    [ "${state:-}" = OPEN ] && ci="$(open_pr_ci "$d" "$prb" "$pr" "$oid" "$ci" "$red" "$shell" "$chain")"
  fi
  if [ "${oid:--}" != - ] && [ "$head" != "$oid" ]; then
    if git -C "$d" cat-file -e "$head^{commit}" 2>/dev/null; then
      git -C "$d" cat-file -e "$oid^{commit}" 2>/dev/null \
        && ! git -C "$d" merge-base --is-ancestor "$head" "$oid" 2>/dev/null \
        && ! git -C "$d" merge-base --is-ancestor "$head" "$(default_base "$d")" 2>/dev/null && inpr=0
    elif [ "$unpushed" -gt 0 ]; then inpr=0; fi
  fi
  [ "$inpr" = 0 ] && inpr="$(merged_inpr "${state:-}" "$ahead" "$based")"
  echo "1 $dirty $ahead ${pr:--} ${state:--} ${ci:--} $inpr $branch - - - ${oid:--} $(dirty_names "$paths")"
}

# activity_line <status> <open job> <doing> <dir|-> <branch> <head sha|-> <now epoch> -> what the
# session is doing now, for the ACTIVITY column on Sessions (nc-41), first match wins:
# parked; testing (a test command runs); building (a Unity authoring run); editing (busy, its last tool call an edit); waiting on
# <workflow> <N>m (a run on its head still open in the run ledger, the oldest, N since it was
# queued, +K for the others); red on <workflow>[, ...] (MAIN_STREAKS over its head's runs); gating
# (a gate command runs); else the status word. CI is read only for a <dir> given (a branch off the
# default one), at <head>, else HEAD. The ledger lags a run by up to one schedules-sync pass (10m).
activity_line() {
  local status="$1" ojob="$2" doing="$3" d="$4" br="$5" head="$6" now="$7" runs ci=""
  [ "$status" = parked ] && { echo parked; return; }
  [ "$ojob" = test ] && { echo testing; return; }
  [ "$ojob" = build ] && { echo building; return; }
  if [ "$status" = busy ] && [[ "$doing" =~ ^(Edit|Write|MultiEdit|NotebookEdit)(:|$) ]]; then echo editing; return; fi
  if [ "$d" != - ]; then
    [ "$head" != - ] || head="$(git -C "$d" rev-parse -q --verify HEAD 2>/dev/null || echo -)"
    if [ "$head" != - ] && runs="$(branch_runs "$d" "$br")"; then
      ci="$(jq -r --arg h "$head" --argjson now "$now" '
        map(select(.headSha == $h))
        | (map(select(.status != "completed")) | sort_by(.createdAt)) as $open
        | if ($open | length) > 0 then
            "waiting on \($open[0].workflowName) \([($now - ($open[0].createdAt | fromdateiso8601)) / 60 | floor, 0] | max)m"
            + (if ($open | length) > 1 then " +\(($open | length) - 1)" else "" end)
          else ['"$MAIN_STREAKS"' | .workflow] | if length > 0 then "red on \(join(", "))" else empty end
          end' <<<"$runs" 2>/dev/null)"
    fi
  fi
  if [ -n "$ci" ]; then echo "$ci"; return; fi
  { [ "$ojob" = gate ] || [ "$ojob" = queue ]; } && { echo gating; return; }
  echo "${status:--}"
}

# park_pane_gone <ledger> -> 0 when the ledger's tmux server answers and its pane is gone, or sits in a
# session created after the park. A park keeps its pane (held dead, or a shell), so neither can be the
# parked pane: the server restarted, and pane ids restart with it, so the same id may be a live claude's
# window, the row would read PARKED and the pace line would send an unpark into it. Not the session's
# name: a renamed session keeps its pane. A server that cannot be read, or a ledger with no pane, decides
# nothing (a running server lists a pane, so an empty answer is no answer): the ledger stays. The server's
# panes are read once per pass, in PARK_PANES.
declare -A PARK_PANES=()
park_pane_gone() {
  local srv="" pane="" parked="" k v created
  while IFS='=' read -r k v; do
    case "$k" in server) srv="$v" ;; pane) pane="$v" ;; parked) parked="$v" ;; esac
  done <"$1"
  [ -n "$srv" ] && [ -n "$pane" ] || return 1
  [ -n "${PARK_PANES[$srv]+x}" ] || PARK_PANES[$srv]="$(tmux -L "$srv" list-panes -a -F '#{pane_id} #{session_created}' 2>/dev/null)" || return 1
  [ -n "${PARK_PANES[$srv]}" ] || return 1
  created="$(awk -v p="$pane" '$1 == p { print $2; exit }' <<<"${PARK_PANES[$srv]}")"
  [ -n "$created" ] || return 0
  [[ "$parked" =~ ^[0-9]+$ && "$created" =~ ^[0-9]+$ ]] && [ "$created" -gt "$parked" ]
}

# parked_lines <agent-panel lines> -> one agent-panel-shaped line, status parked, per park
# ledger whose tmux session (a session:%pane ledger: whose pane) has no live claude again, so a
# parked session's git, PR and main facts are read like any other's. A ledger beside a live claude
# is stale: the live row wins. A window ledger is one claude of a shared session (hub/dotfiles),
# whose other windows stay live; it is stale only when a claude lives in its own pane, since the
# window index its target recorded renumbers. A legacy session:window_index ledger (before #2116)
# has a pane id a tmux restart made unmatchable, so it dedupes on its session like a session ledger.
parked_lines() {
  local f live panes
  PARK_PANES=()
  live="$(jq -r '.target' <<<"$1" 2>/dev/null)"
  panes="$(jq -r '.pane' <<<"$1" 2>/dev/null)"
  for f in "$PARKED_DIR"/*; do
    [ -f "$f" ] || continue
    park_pane_gone "$f" && continue
    jq -cn --rawfile l "$f" --arg live "$live" --arg panes "$panes" --arg key "${f##*/}" '
      ([$l | split("\n")[] | capture("^(?<key>[a-z_]+)=(?<value>.*)$")] | from_entries) as $p
      | ($p.target // "\($p.server)/\($p.session)") as $t
      | (if ($key | contains(":%")) then ["\($p.server)/\($p.pane)", ($panes | split("\n"))]
         else [($t | sub(":[^:]*$"; "")), ($live | split("\n") | map(sub(":[^:]*$"; "")))] end) as [$me, $all]
      | select($all | index($me) | not)
      | {target: $t, pane: "\($p.server)/\($p.pane)", status: "parked", plan_mode: false,
         session_id: $p.session_id, cwd: $p.cwd, idle_since: ($p.parked | tonumber? // 0),
         context_tokens: 0, plan_file: ""}' 2>/dev/null
  done
}

# item_of <qitems> <session id> <server:tmux session> <claudes in that tmux session> <claude start epoch|->
# -> the queue item this session worked: own:<slug>[,<slug>...] while any runs here (every one,
# so a merged side item never hides the one still open), moved:<slug> moved on
# (<where>) once it is done, requeued or running elsewhere, or -. sessions: (Claude session ids)
# is the match for an item that records them. session: (the tmux session) counts only for one that
# records none, when one claude lives there, and a done item by it only when it finished after this
# claude started: worktree names are recycled (fleet-dispatch claude_gone reads the same rule).
# An item still running or waiting here wins over one that moved on; an item that recorded no
# session: (added by hand, `add --running`) is here when it names this Claude session, and
# here:<slug> is one waiting here, which decides no bucket but names the item on the row.
# review:<slug> is one this session parked in review/: its open PR is the item's, and
# fleet-dispatch's reap owns it once the session ends (own_parked_pr gives a red one a fix-ci session and a green one a lander),
# so the session is finished. 2026-11-11 such sessions read "PR open" as unfinished, wind-down
# refused, and the reap, which waits for the session to end, never took over.
item_of() {
  awk -F'\t' -v sid="$2" -v me="$3" -v solo="$4" -v start="$5" '
    function mine_sid(list,   n, a, i) { n = split(list, a, " "); for (i = 1; i <= n; i++) if (a[i] == sid) return 1; return 0 }
    {
      bysid = (sid != "" && mine_sid($3)); bysess = (solo == 1 && $2 == me && $3 == "-")
      if (!bysid && !bysess) next
      if (($1 == "running" || $1 == "waiting" || $1 == "review") && ($2 == me || ($2 == "-" && bysid))) {
        if ($1 == "running") own = own (own == "" ? "" : ",") $4
        else if ($1 == "review") { if (rev == "") rev = $4 " pr " ($6 == "" ? "-" : $6); next }
        if (hereslug == "") hereslug = $4
        here = 1; next
      }
      if ($1 == "done" && !bysid && !(start ~ /^[0-9]+$/ && $5 + 0 >= start + 0)) next
      if (moved != "") next
      where = ($1 == "done" || $1 == "queued") ? $1 : $1 " in " $2
      moved = $4 " moved on (" where ")"
    }
    END {
      if (own != "") print "own:" own
      else if (here) print "here:" hereslug
      else if (rev != "") print "review:" rev
      else if (moved != "") print "moved:" moved
      else print "-"
    }' <<<"$1"
}

# item_plan <islugs: the comma list of this session's item slugs, or -> <started epoch> <fallback plan> -> the plan this
# session wrote for its item (one-shot step 1: ~/.claude/plans/<slug>.md), the first slug's that exists, else the fallback.
# A file older than this claude is an earlier run's of a reused slug. It outranks the plan the transcript last landed against
# or ticked (collect), so a session that ticked a phase in another plan reads its own (ar-379).
item_plan() {
  local sl f
  if [[ "${2:-}" =~ ^[0-9]+$ ]]; then
    while IFS= read -r sl; do
      f="$HOME/.claude/plans/$sl.md"
      [ -f "$f" ] && [ "$(stat -c %Y "$f")" -ge "$2" ] && { printf '%s\n' "$f"; return 0; }
    done < <(tr ',' '\n' <<<"${1#-}" | grep .)
  fi
  printf '%s\n' "${3:--}"
}

# own_slugs <item_of's answer> -> the comma list of slugs it joined to this session (own:a,b running here, or
# the one waiting here), else nothing. They are the session's own work, not a phase handed off, so they hold no
# plan phase: the phase is this session's next one until it lands (ar-475: dotfiles-agent-4 read DONE while P4
# was its own running item, joined by sessions: alone).
own_slugs() {
  case "$1" in own:* | here:*) local s="${1#*:}"; printf '%s' "${s%% *}" ;; esac
}

# chain_hold <all items, jsonl> <comma list of a session's item slugs> <item_of's relation> -> the slug of another session's item
# that one of the session's live items is `after:` and that is not done, else nothing. agent-land's stack_gate refuses to
# merge (exit 4) while any `after:` item has not closed ok, before any gate runs: a red Merge gate line is that refusal,
# not the PR's own red (ar-4314: unity-core-playground #3076 and #3083 read STALLED CI red, 2026-11-21), and a green PR
# is held, not stalled (ar-4420: %305 and %312 read STALLED green, not merged, 2026-11-21). A queued dependency holds it
# too. A dependency that is done, ok or not, is no wait: ok releases it, and any other close never does, which is the
# session's to resolve. One of the session's own slugs is no wait either: it holds nothing back that the session is not
# itself doing.
chain_hold() {
  case "${3:-}" in own | review | here) ;; *) return 0 ;; esac
  [ -n "${2:-}" ] && [ "${2:--}" != - ] || return 0
  jq -rn --arg own ",$2," '[inputs] as $all
    | [$all[] | select(.state != "done" and (.slug as $s | $own | contains("," + $s + ",")))
        | (.after // "") | split(" ")[] | select(. != "" and (. as $d | $own | contains("," + $d + ",") | not))] as $deps
    | first($all[] | select(.state != "done" and (.slug as $s | $deps | any(. == $s))) | .slug) // empty' <<<"$1" 2>/dev/null
}

# refused_wait <dir> <pr> -> the slot holder open_pr_ci found PR #<pr> waiting on this pass, or nothing.
refused_wait() {
  local key
  key="$(prs_key "$1")" && [ -f "$key.refused" ] || return 0
  awk -F'\t' -v p="$2" '$1 == p { h = $2 } END { if (h != "") print h }' "$key.refused"
}

# pr_wait <git> <pr state> <sibling repo> <clone> <ci> <pr> <head oid> <chain> -> two lines: the landing-slot wait, then
# the wait the bucket reads (empty when none). A PR of this clone's repo riding an open landing train waits on that
# train's gate, one queued for the landing slot waits its turn, and one the slot holder refused waits on that holder
# (slot_refuser), unless its own Checks are red past the slot's refusal (git_facts left ci FAIL). A green or unknown-CI PR whose item is `after:` an item that is not done (<chain>,
# chain_hold) waits on it, not STALLED green, not merged (ar-4420); its red gate line is open_pr_ci's.
pr_wait() {
  local g="$1" state="$2" xr="$3" gd="$4" ci="$5" pr="$6" oid="$7" chain="$8" tn="" land="" w h
  [ "$g" = 1 ] && [ "$state" = OPEN ] && [ "$xr" = - ] || { printf '\n\n'; return 0; }
  if [ "$gd" != - ]; then
    [ "$oid" = - ] || tn="$(train_of "$gd" "$pr" "$oid")"
    if [ -n "$tn" ]; then land="train #$tn"
    elif [ "$ci" != FAIL ] && [ -n "$FLEET_QUEUE_LABEL" ] && queued_in "$gd" "$pr"; then land="the landing queue"
    elif [ "$ci" = PENDING ] && h="$(refused_wait "$gd" "$pr")" && [ -n "$h" ]; then land="slot holder #$h"; fi
  fi
  w="$land"
  if [ -z "$w" ] && [ -n "$chain" ]; then case "$ci" in FAIL | PENDING | NOSTART) ;; *) w="after: $chain" ;; esac; fi
  printf '%s\n%s\n' "$land" "$w"
}

# dispatch_tag <collect's items: "<slug>\t<project>: <slug>" lines> <item_of's relation> <its comma list of slugs>
# -> the row's [dispatch: <project>: <slug>] tag, else -. It is the row's own item by item_of's join (own, here,
# review), never its tmux lane: a recycled lane would show the previous Claude's item (ar-860).
dispatch_tag() {
  local d=
  case "$2" in own | here | review) d="$(awk -F'\t' -v sl=",$3," 'index(sl, "," $1 ",") { print $2; exit }' <<<"$1")" ;; esac
  printf '%s' "${d:--}"
}

# handoff_of <items: collect's qhand, the jsonl of doc+ask items with a report and an ask> <item_of's answer> -> "<ask id>\t<doc>"
# when the item is of a doc+ask kind (kinds.json `exit`, by the item's `type`) and has handed its work
# over: its `report` doc exists and its `ask` is filed. That ask is the deliverable, so it is not the
# session's open question, and the item has moved on. Else nothing.
handoff_of() {
  local slug="${2#*:}" ask doc
  case "$2" in own:* | moved:*) ;; *) return 0 ;; esac
  [ -n "$1" ] || return 0
  IFS=$'\t' read -r ask doc < <(jq -r --arg s "${slug%% *}" 'select(.slug == $s) | [.ask, .report] | @tsv' <<<"$1" 2>/dev/null)
  [ -n "${ask:-}" ] && [ -f "${doc/#\~/$HOME}" ] && compgen -G "$ASK_ROOT/*/$ask.md" >/dev/null && printf '%s\t%s\n' "$ask" "$doc"
  return 0
}

# remote_panel_lines -> each fleet worker's agent-panel lines (fleet-hosts.sh, the home-config
# roster), each with the worker in `host` and its target as <host>@<server>/<session>:<window>. That
# names no tmux server here, so a nudge or a set-option aimed at the row can never land on a local
# session that shares its name, and item_of joins it to its queue item by session id alone. A worker
# that does not answer (ssh exit 255), or whose agent-panel fails, adds no rows and is one
# {host, why} line in $CACHE/silent, which state.json carries as `silent` so the Sessions table says its rows are missing (dashboards.md
# rule 6). It is not $CACHE/unreadable: a laptop asleep is not this machine's sources blinking. It
# runs beside collect's row loop, so a gap goes straight to $CACHE/blind as "+" (keep_blind), never
# through blind_row, which names the row the loop is on.
# The rows are also published (fleet_panel_publish) as worker-panel.json for FLEET_PANEL_TTL seconds:
# the one read of the workers' sessions each minute, which agent-ask and agent-web read instead of
# each asking every worker over ssh, with the workers that did not answer (or read with a gap) named
# in `silent`, which a reader asks itself. The ttl covers a pass's own timeout (fleet-state.service,
# 120s) and the next minute's start.
: "${FLEET_PANEL_TTL:=180}"
remote_panel_lines() {
  local name out rc why all='' quiet=()
  fleet_hosts >/dev/null
  while IFS= read -r name; do
    # Exit 3 is a read with a gap (agent-panel README): keep its rows, and name it so tick does
    # not log the sessions it missed as gone.
    rc=0; out="$(fleet_host_panel "$name")" || rc=$?
    [ "$rc" -eq 3 ] && { unreadable "agent-panel@$name"; echo + >> "$CACHE/blind"; }
    [ "$rc" -eq 0 ] || quiet+=("$name")
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 3 ]; then
      # ssh exits 255 when the host does not answer; 124 is fleet_host_panel's timeout; any other code is agent-panel's own failure.
      why="did not answer"; [ "$rc" -eq 255 ] || why="ran agent-panel, which exited $rc"; [ "$rc" -ne 124 ] || why="ran past ${_FH_PANEL_SECS}s"
      jq -cn --arg h "$name" --arg w "$why" '{host: $h, why: $w}' >> "$CACHE/silent"
      continue
    fi
    [ -z "$out" ] || { printf '%s\n' "$out"; all+="$out"$'\n'; }
  done < <(fleet_hosts | jq -r .name)
  printf '%s' "$all" | fleet_panel_publish "$FLEET_PANEL_TTL" "${quiet[@]}" ||
    echo "fleet-sessions: could not publish $(fleet_panel_file); readers ask the workers instead" >&2
  return 0
}

# phases_word <plan file|-> <in plan mode 0|1> <done> <total|-> -> session_bucket's <phases> word. A plan the pane
# recorded that does not exist (every account shares ~/.claude/plans, claude-acct) is not a session with no plan:
# its phases are unknown, so it is never read as finished (ar-2368). In plan mode, though, the pane names the plan
# path before Claude writes it: no file yet is no plan, not missing (ar-3918).
phases_word() {
  if [ "$1" = - ] || { [ "$2" = 1 ] && [ ! -f "$1" ]; }; then echo -
  elif [ ! -f "$1" ]; then echo missing
  elif [ "$4" = - ]; then echo none
  else echo "$3/$4"; fi
}

collect() {
  local now heavy line
  # The one `project` every row carries is the name the hooks give its directory; a pass that cannot
  # load it fails here, not as a row with no project.
  # shellcheck source=/dev/null
  . "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../../.config/shared-hooks/project-name.sh" || return 1
  now="$(date +%s)"
  heavy="$(heavy_panes)"; so_canon_init "${SO_PROJECT_MAP:-$HOME/.config/shared-hooks/project-map.json}" 2>/dev/null || :
  local panel items qjson qall qitems off qheld qhand
  PROC_SNAP="$CACHE/procs"   # live_wait reads /proc into it on its first call
  off="$(off_default_checkouts)"
  # A week of done items too: a session whose item finished, was requeued or moved to another
  # session has to see that, or it reads as never started (ar-343).
  # A failed read (agent-queue exits 1 with nothing when its lock stays busy past LOCK_WAIT) is not
  # "no items": every row reads its item through item_of, so each row is blind (ar-2839).
  local qblind=
  qall="$(agent-queue list --json --state all --since "$(date -d "$FLEET_ITEM_DAYS days ago" +%F)" 2>/dev/null)" \
    || { unreadable agent-queue; qblind=1; }
  qjson="$(jq -c 'select(.state != "done")' <<<"$qall" 2>/dev/null)"
  # The few items of a doc+ask kind that filed their report and ask (handoff_of): read once, not per row.
  qhand=""
  [ ! -r "$KINDS" ] || qhand="$(jq -c --slurpfile k "$KINDS" '
    select((.type // "") as $t | $t != "" and $k[0][$t].exit == "doc+ask" and (.report // "") != "" and (.ask // "") != "")' <<<"$qall" 2>/dev/null)"
  # The asks a live item holds through its ask:<id>[=<option>] tag. That item carries the ask on,
  # so it is no longer an open question of the session that posted it, whatever state the item
  # reaches before the answer (ar-764).
  qheld="$(jq -r '(.tags // "") | splits("\\s+")
    | select(startswith("ask:")) | .[4:] | sub("=.*"; "")' <<<"$qjson" 2>/dev/null)"
  # "<state>\t<session>\t<sessions>\t<slug>\t<finished epoch>" per item, for item_of.
  qitems="$(jq -r '[.state, (.session // "" | if . == "" then "-" else . end),
      (.sessions // "" | if . == "" then "-" else . end), .slug,
      (.finished // "" | fromdateiso8601? // 0),
      (.pr // "" | tostring | sub(".*#"; "") | if . == "" then "-" else . end)] | map(tostring) | @tsv' <<<"$qall" 2>/dev/null)"
  # "<slug>\t<project>: <slug>" for each item dispatch started in a tmux session: the [dispatch:] tag.
  items="$(jq -r <<<"$qjson" '
    select(.state != "queued" and ((.session // "") | contains(":")))
    | "\(.slug)\t\(.project): \(.slug[:60])"' 2>/dev/null)"
  # A pass that could not read a source says so in $CACHE/unreadable, and marks the rows it feeds
  # in $CACHE/blind (keep_blind), so tick never logs a blink (a session "gone", a PR "-") as a change.
  # The local agent-panel feeds every row, parked ones included (parked_lines reads it): a failure
  # that printed nothing is "*"; exit 3 with rows is a gap, "+", like a remote one.
  # Exit 3 (a read with a gap) still prints the rows it read; they are kept, and the pass is named.
  # AGENT_PANEL_CODEX: a codex, opencode or agy run in a pane is a row too (busy, its session id as session_id, so
  # item_of joins it by sessions: like a Claude). The env form, not --codex: a binary not yet
  # rebuilt ignores it instead of refusing the flag and reading as every session gone.
  local prc=0
  panel="$(AGENT_PANEL_CODEX=1 "${AGENT_PANEL:-agent-panel}" list --json 2>/dev/null)" || prc=$?
  if [ "$prc" -ne 0 ]; then
    unreadable agent-panel
    if [ "$prc" -eq 3 ] && [ -n "$panel" ]; then echo + >> "$CACHE/blind"; else echo '*' >> "$CACHE/blind"; fi
  fi
  local PENDING_ASKS restored="$(restored_panes "$panel")"
  PENDING_ASKS="$(pending_asks)" || { unreadable agent-ask; echo "*" >> "$CACHE/blind"; }
  { [ -n "$panel" ] && printf '%s\n' "$panel"; parked_lines "$panel"; remote_panel_lines; } | while IFS= read -r line; do
    [ -n "$line" ] || continue
    # close --self reads one row: the others' git, gh and transcript reads cost a minute (54 rows).
    [ -z "${CLOSE_SELF:-}" ] || [[ "$line" == *"$CLOSE_SELF"* ]] || continue
    rm -f "$CACHE/blind_row"
    local target pane status plan sid cwd since ctx planf tsess idle bidle asks ownask hv bucket fact edited \
          pdone ptotal pnext phases fin started age oid askids blk transcript prs \
          work jobs human parked compactions topic doing said gate test ojob acct mdl harn pq names landed live cpid host cwin shown mman
    # The separator is a unit separator, not a tab: read collapses an empty tab-separated field and
    # shifts every later one left, so a park ledger with no cwd put plan_file's "-" in ctx and
    # json_rows died on it (ar-1500). A number a source left empty or null is 0.
    IFS=$'\x1f' read -r target pane status plan sid cwd since ctx planf started cpid host cwin shown mman < <(jq -r '
      def s: (. // "") | tostring | gsub("[\n\u001f]"; " ");
      def n: tonumber? // 0;
      [(.target | s), ((.pane // "") | sub(".*/"; "") | s), (.status | s),
      (if .plan_mode then 1 else 0 end), (.session_id | s), (.cwd | s), (.idle_since | n), (.context_tokens | n),
      (.plan_file | s | if . == "" then "-" else . end), (.started_at | s | if . == "" then "-" else . end), (.pid | n),
      (.host | s | if . == "" then "-" else . end),
      (.context_window | n), (if .attached then 1 else 0 end), (if .manual_mode then 1 else 0 end)] | join("\u001f")' <<<"$line")
    # A worker's session: its cwd, pid, plan file and panes are paths and ids on that machine, so
    # nothing here reads them (a worktree of the same name here is another session's). Its row says
    # what its agent-panel says; its PR is its queue item's.
    [ "$host" = - ] || planf=-
    edited="$(jq -r '.edited_files // [] | .[]' <<<"$line")"
    # read splits on tabs and collapses an empty field, so every text field here is - when empty.
    IFS=$'\t' read -r transcript work jobs human parked compactions topic doing said gate test ojob acct mdl harn < <(jq -r '
      def text: (. // "") | if . == "" then "-" else gsub("[\t\n]"; " ") end;
      [(.transcript | text), (.time_use.work_min // 0), (.time_use.jobs_min // 0), (.time_use.human_min // 0),
       (.time_use.parked_min // 0), (.compactions // 0), (.summary | text), (.doing | text), (.said | text),
       (.time_use.gate_min // 0), (.time_use.test_min // 0), (.open_job | text), (.account | text), (.model | text), (.harness | text)]
      | map(tostring) | join("\t")' <<<"$line")
    # plan_mode alone is only a mode: an idle session in it with no plan written is not waiting
    # on anyone (2026-11-06 hub/dotfiles:1 read NEEDS for an unsent draft). An approval is open
    # only while the dialog is: status waiting with ExitPlanMode as the last tool call. `doing`
    # outlives the dialog (a rejected plan leaves it), so it counts only together with waiting.
    # The mode itself still keeps the session open (the close verdict's in_plan_mode, ask 4RSfMg).
    inplan="$plan"
    if [ "$plan" = 1 ] && { [ "$status" != waiting ] || [[ "$doing" != ExitPlanMode* ]]; }; then plan=0; fi
    # A gate or test running in the worktree is a wait whatever the transcript's open job says.
    live=""
    if [ "$host" = - ] && [ "$status" = shell ] && { [ "$ojob" = jobs ] || [ "$ojob" = none ] || [ "$ojob" = gate ]; }; then
      live="$(live_wait "$cwd" "$cpid")"; [ -n "$live" ] || [ "$ojob" = gate ] || live="$(watched_gate "$transcript")"
      # watched_gate: a pgrep loop on a gate outside the claude's tree is its wait (ar-2121); a transcript job that already reads gate keeps its class: the probes only add the queue case
      [ "$ojob" != gate ] || [ "$live" = queue ] || live=""
      ojob="${live:-$ojob}"
    fi
    # A shell waiting on itself is hung whatever the transcript's open job says: its command line may
    # read as a gate. A live gate or test process found above outranks it. An event wait (a tail --pid
    # on another process) only names a shell the transcript could not class: a gate's keeps its own.
    if [ "$host" = - ] && [ "$status" = shell ] && [ "$ojob" != agent ] && [ -z "$live" ]; then
      live="$(self_wait "$cpid")"
      [ "$live" != wait ] || [ "$ojob" = jobs ] || [ "$ojob" = none ] || live=""
      ojob="${live:-$ojob}"
    fi
    prs="$(session_prs "$transcript")"
    landed="$(jq -r 'if any(.state == "MERGED") and all(.state != null and .state != "OPEN")
      then map(select(.state == "MERGED") | "#\(.number)") | join(",") else "-" end' <<<"$prs")"
    tsess="${target#*/}"; tsess="${tsess%:*}"
    idle=$(( (now - since) / 60 )); bidle="$(gate_log_idle "$host" "$status" "$ojob" "$cwd" "$idle" "$transcript")"
    age=-; [[ "$started" =~ ^[0-9]+$ ]] && age=$(( (now - started) / 60 ))
    local solo item
    solo="$(jq -r --arg k "${target%:*}" 'select((.target | sub(":[^:]*$"; "")) == $k) | .target' <<<"$panel" 2>/dev/null | wc -l)"
    item="$(item_of "$qitems" "$sid" "${target%%/*}:$tsess" "$solo" "$started")"
    # Every ask this session filed and nobody answered (ownask), the ones a queue item carries on included, and its
    # item's earlier sessions' (item_asks): the session may close (bucket), and the close verdict says whether its
    # window must stay open for the answer (the close step "its own asks are its only blockers"). askids: still its own.
    local ownids; ownids="$({ asks_for "$sid"; item_asks "$qjson" "$item" "$sid" "$panel"; } | grep . | sort -u)"
    ownask=0; [ -n "$ownids" ] && ownask="$(wc -l <<<"$ownids")"; ownask=$((ownask + 0))
    askids="$(grep . <<<"$ownids" | { if [ -n "$qheld" ]; then grep -vxF "$qheld"; else cat; fi; } | paste -sd, -)"
    asks=0; [ -n "$askids" ] && asks="$(tr ',' '\n' <<<"$askids" | wc -l)"
    hv=0; [ "$host" = - ] && [ -n "$pane" ] && grep -qxF "${target%%/*}/$pane" <<<"$heavy" && hv=1
    [ -z "$qblind" ] || blind_row
    local hask hdoc
    IFS=$'\t' read -r hask hdoc < <(handoff_of "$qhand" "$item")
    if [ -n "${hask:-}" ]; then
      askids="$(tr ',' '\n' <<<"$askids" | grep -vxF "$hask" | paste -sd, -)"
      asks=0; [ -n "$askids" ] && asks="$(tr ',' '\n' <<<"$askids" | wc -l)"
      item="moved:${item#*:}"; item="${item%% *} handed off its doc ${hdoc##*/} and ask $hask"
    fi
    # The row's queue item (item_of's one join), with the board row it came from and who started it (`by`);
    # islugs keeps every item running here (own:a,b), the JSON's item.also.
    local islug=- islugs=- irel=- irow=- iby=- carried=-
    case "$item" in
      own:* | moved:* | here:* | review:*)
        irel="${item%%:*}"; islugs="${item#*:}"; islugs="${islugs%% *}"; islug="${islugs%%,*}"
        IFS=$'\t' read -r irow iby < <(jq -rn --arg s "$islug" 'first(inputs | select(.slug == $s)
          | [(.row // (.from // "" | if startswith("board:") then sub("^board:"; "") else "" end)
              | if . == "" then "-" else . end), (.by // "-")] | @tsv)' <<<"$qall" 2>/dev/null)
        irow="${irow:--}"; iby="${iby:--}"; carried="$(carried_by "$qall" "$sid" "$item" "${target%%/*}:$tsess")" ;;
    esac
    # A done item's merged PRs are the session's landed ones when its transcript names no merged PR, none
    # open and every state known. A landing train merges a member's commits through its own train/* PR and
    # closes the member, so the transcript names only the closed member while agent-land records the train
    # PR on the item (ar-1324: ucp-342 #2166 closed, train #2178 merged, 2026-11-10, read STALLED). The item
    # is this session's by item_of's join. pr: and merged: are lists in step; a merged: shorter than pr:
    # cannot say which PR lacks its merge (agent-land settle_prior), so it names none.
    if [ "$landed" = - ] && [ "$irel" = moved ] \
       && jq -e 'all(.state != null and .state != "OPEN")' <<<"$prs" >/dev/null 2>&1; then
      landed="$(jq -rn --arg s "$islug" --arg sid "$sid" --arg me "${target%%/*}:$tsess" '
        [inputs | select(.slug == $s and .state == "done" and (.status // "") == "ok")
          | (.sessions // "" | split(" ") | map(select(. != ""))) as $ss
          | select(($ss | any(. == $sid)) or ($ss == [] and (.session // "") == $me))
          | (.pr // "" | split(" ") | map(select(. != ""))) as $p | (.merged // "" | split(" ") | map(select(. != ""))) as $m
          | select(($m | length) >= ($p | length)) | $p[] | "#" + sub(".*#"; "")]
        | if length == 0 then "-" else join(",") end' <<<"$qall" 2>/dev/null)"
      landed="${landed:--}"
    fi
    local sjob=- chain="$(chain_hold "$qall" "$islugs" "$irel")"; [ "$status" = shell ] && sjob="$ojob"
    # gd is the clone repo-wide reads go through: the cwd here, this machine's clone of a worker's repo
    # (worker_clone), - when there is none. whead is a worker's HEAD, for activity_line.
    local gd="$cwd" whead=- wmain worigin
    if [ "$host" = - ]; then read -r g dirty ahead pr state ci inpr branch behind conflicts fork oid names < <(git_facts "$cwd" "$edited" "$sjob" "$chain")
    else
      IFS=$'\x1f' read -r wmain worigin whead < <(jq -r '.git // {} | [.main // "", .origin // "", .head // ""] | join("\u001f")' <<<"$line" 2>/dev/null)
      gd="$(worker_clone "${wmain:-}" "${worigin:-}")"; gd="${gd:--}"; whead="${whead:--}"
      read -r g dirty ahead pr state ci inpr branch behind conflicts fork oid names < <(worker_git_facts "$line" "$gd" "$sjob" "$chain")
    fi
    # What a deployed checkout off its default branch holds is one fault, its CHECKOUT row, and no
    # session's work: 2026-11-06 it read 9 files ahead on all 16 sessions there, each one STALLED.
    if [ "$host" = - ] && [ "$g" = 1 ] && in_checkout "$cwd" "$off"; then ahead=0 pr=- state=- ci=- oid=- inpr=1; fi
    # A run that handed its item off left its pushed branch to the item's next start: a clean tree whose
    # HEAD is that item's salvage: has nothing left here to land.
    if [ "$host" = - ] && [ "$g" = 1 ] && [ "$irel" = moved ] && [ "$dirty" = 0 ] && [ "$ahead" -gt 0 ] && [ "$pr" = - ] \
       && salvaged_here "$qall" "$islug" "$cwd"; then ahead=0; fi
    # A finished branch PR this session did not make is another session's (pr_made_here): drop it,
    # and the commits it holds with it. An open one stays: it is unlanded work in this tree either way.
    if [ "$host" = - ] && [ "$g" = 1 ] && { [ "$state" = MERGED ] || [ "$state" = CLOSED ]; } && [ -s "$transcript" ] \
       && ! pr_made_here "$cwd" "$pr" "$branch" "$prs" "$transcript" "$planf" \
              "$(jq -r --arg c "$cwd" --arg s "$sid" 'select(.cwd == $c and .session_id != $s and (.host // "-") == "-")
                  | .plan_file // empty' <<<"$panel" 2>/dev/null)"; then
      [ "$inpr" = 1 ] && ahead=0
      pr=- state=- ci=- oid=-
    fi
    # No PR for this branch here: an open PR of its own in another repo is the row's PR. Its
    # conflict is not this clone's to measure, so it is unknown (-).
    local xr=- xpr xci xoid
    if [ "$host" = - ] && [ "$g" = 1 ] && [ "$pr" = - ]; then
      IFS=$'\t' read -r xr xpr xci xoid < <(sibling_pr "$cwd" "$prs")
      if [ -n "${xpr:-}" ]; then pr="$xpr" state=OPEN ci="$xci" oid="$xoid" conflicts=-; else xr=-; fi
    fi
    [ "$host" != - ] || planf="$(item_plan "$islugs" "$started" "$planf")"; IFS=$'\t' read -r pdone ptotal pnext < <(plan_phases "$planf")   # the item's own plan outranks the transcript's
    phases="$(phases_word "$planf" "$inplan" "$pdone" "$ptotal")"
    # A copy of a queued plan under another file name is that plan (plan_copy_of): the items name it and
    # tick it, and the session may tick its own, so a phase is done when either plan says so.
    local plist="$planf" pcopy="" plj merged=""
    plj="$(plan_phase_list "$planf")"
    if [[ "$phases" == */* ]] && [ "$pdone" -lt "$ptotal" ]; then
      pcopy="$(plan_copy_of "$planf")"
      [ -z "$pcopy" ] || merged="$(jq -c --argjson b "$(plan_phase_list "$pcopy")" 'select(length == ($b | length))
        | [to_entries[] | .value + (if .value.state == "open" then {state: $b[.key].state} else {} end)]' <<<"$plj")"
      if [ -n "$merged" ]; then
        plist="$pcopy" plj="$merged"
        IFS=$'\t' read -r pdone ptotal pnext < <(jq -r '[(map(select(.state != "open")) | length), length,
          (map(select(.state == "open"))[0].name // "-")] | map(tostring) | join("\t")' <<<"$plj")
        phases="$pdone/$ptotal"
      fi
    fi
    # The plan's unchecked phases are queue items of their own: its next phase is not this session's.
    # An item that records `phases:` holds only those checklist numbers, so later phases queued
    # while this session works the next one do not make it queued (ar-267: agent-2 read DONE
    # mid-phase 3 because phases 4 and on were items); one with no `phases:` whose task names one
    # ("Phase 2 of", "Phase Tailnet of": a number or the phase name's first word) holds that one,
    # and one that names none holds all (ar-2368: forgejo-hetzner-tailnet's "Phase Tailnet of"
    # held all six open phases, and two shepherds told its plan's session to close).
    # An item whose task names this session (its id's first 8 characters or its target, as a whole
    # token) is a report about it, not a holder of its phases (ar-2452: the bug-report item ar-2449
    # quoted the plan's path, held P3, and close --self read "plan finished"). A misfire fails safe:
    # the phase reads as next, never as queued.
    # The plan is queued only when every open phase is held; else its first free one is next.
    # A read that fails is named unreadable, and tick logs no blink for the row (blind_row) (ar-2905).
    local dsp=- n=0 e=0 prun=- pwq=- mine="$(own_slugs "$item")"
    dsp="$(dispatch_tag "$items" "$irel" "$islugs")"
    pq="$pnext"
    # With a phase open, a merged PR is a landed phase only when the plan names it: a side item's PR
    # (2026-11-16 the chore #2118 of hub/dotfiles:1's own done item, named by no phase of its plan) is not
    # the plan's, so the row never claims it (landed_named). A closed PR keeps its list: the PR that replaced
    # it (a landing train's) is the one that closed it (ar-1324).
    if [[ "$phases" == */* ]] && [ "$pdone" -lt "$ptotal" ] && [ "$landed" != - ] && [ "$state" != CLOSED ]; then
      landed="$(landed_named "$landed" "$planf" "$plist" "$(plan_pointer "$planf" | cut -f1)")"
    fi
    if [[ "$phases" == */* ]] && [ "$pdone" -lt "$ptotal" ]; then
      local qd
      # Items match by file name: a plan symlinked to its canonical name (plan mode wrote one, the
      # phases were queued under the other) matches either.
      # A pointer stub ("Phase N of <plan>.md") reads through to that plan: its open phases are the
      # canonical plan's phase N on, and the items name the canonical file (2026-11-14).
      # A phase add --plan filed on its board row behind a gate holds it as an item does (plan_gated_rows), read
      # once a run.
      [ -f "$CACHE/plan_gated" ] || { plan_gated_rows "$(board_feed)" > "$CACHE/plan_gated.$$" && mv -f "$CACHE/plan_gated.$$" "$CACHE/plan_gated"; }
      local canon ptgt pbase=1 pn
      canon="$(realpath -q -- "$plist" 2>/dev/null)" || canon="$plist"
      IFS=$'\t' read -r ptgt pn < <(plan_pointer "$plist")
      [ -z "${ptgt:-}" ] || { canon="$ptgt"; pbase="$pn"; }
      qd="$(jq -rs --arg p "$planf" --arg q "${canon:-$plist}" --arg own "${dsp#*: }" --arg mine "$mine" --arg sid "${sid:0:8}" --arg tgt "$target" \
              --argjson open "$(jq -c --argjson b "$pbase" '[.[] | select(.state == "open") | {n: ((if (.n | type) == "number" then .n + $b - 1 else .n end) | tostring), name: .name}]' <<<"$plj")" \
              "$PLAN_ITEMS_JQ"' def names_me: (.task // "") as $t
                | any($sid, $tgt; . as $w | $w != "" and (($t | split($w)) as $p
                    | any(range(1; $p | length); ($p[. - 1] | test("[0-9A-Za-z]$") | not) and ($p[.] | test("^[0-9A-Za-z]") | not))));
              [.[] | select(.slug != $own and (.slug as $s | $mine | split(",") | all(. != $s)) and (holds_plan($p) or holds_plan($q)) and (names_me | not))
                 | {slug, st: (.state // "queued"), ph: (.phases // "" | tostring | split(" ") | map(select(. != ""))),
                    ses: (if ((.session // "") | contains(":")) then (.session | sub(":"; "/")) else null end),
                    tp: ((.task // "") | (capture("(?i)\\bphase (?<t>[^\\s:,]+) of ") | .t | ascii_downcase) // null)}] as $it
              | def holds($o): .tp as $t
                  | if (.ph | length) > 0 then (.ph | index($o.n)) != null
                    elif $t == null then true
                    elif ($t | test("^[0-9]+$")) then ($t | tonumber | tostring) == $o.n
                    else ($o.name | ascii_downcase | sub("^(phase +)?[0-9]+[.:)]? *"; "")
                          | startswith($t) and (.[($t | length):] | test("^([^a-z0-9]|$)"))) end;
              [$it[] | select(. as $i | any($open[]; . as $o | $i | holds($o)))] as $holders
              | [$open[] | select(. as $o | any($it[]; holds($o)) | not)] as $free
              | [$holders[] | select(holds($open[0]))] as $first
              | ([$first[] | select(.ses != null) | .ses][0] // "-") as $run
              | (if ($first | length) > 0 and all($first[]; .st == "queued") then "1" else "-" end) as $wq
              | if ($holders | length) == 0 then empty
                elif ($free | length) == 0 then "queued:" + ($holders | map(.slug) | join(",")) + "\t" + $run + "\t" + $wq
                else $free[0].name + "\t" + $run + "\t" + $wq end' <<<"$qjson$(printf '\n'; cat "$CACHE/plan_gated"; inflight_done)" 2>/dev/null)" ||
        { unreadable "plan phases of $plist"; blind_row; }
      [ -z "$qd" ] || IFS=$'\t' read -r pq prun pwq <<<"$qd"
    fi
    # mh is this repo's main health for the row's main_red (RED, OK, UNKNOWN; - outside git).
    local red=- mh=- mwfs
    if [ "$g" = 1 ] && [ "$gd" != - ]; then
      IFS=$'\t' read -r mh _ < <(main_health "$gd")
      if [ "$state" = MERGED ] && [ "$mh" = RED ] && mwfs="$(main_blame "$gd" "$pr")"; then
        red="$mwfs"
        printf '%s\t%s\n' "$(repo_slug "$gd")" "$sid" >> "$CACHE/owners"
      fi
    fi
    [ "$host" != - ] || printf '%s\t%s\n' "${cwd##*/}" "$sid" >> "$CACHE/cwds"   # SHARED rows' owners, by worktree
    # ACTIVITY: CI is read on a branch off the default one, at its PR head, else at HEAD.
    local act act_dir=- dbase
    if [ "$g" = 1 ] && [ "$branch" != - ] && [ "$gd" != - ]; then dbase="$(default_base "$gd")"; [ "$branch" = "${dbase#*/}" ] || act_dir="$gd"; fi
    local act_sha="$oid"; [ "$oid" != - ] || act_sha="$whead"
    act="$(activity_line "${status:--}" "$ojob" "$doing" "$act_dir" "$branch" "$act_sha" "$now")"
    # What an open PR waits on (pr_wait); only a landing-slot wait carries the slot's wait, depth and critical path.
    local wait_on="" land_wait=""
    { IFS= read -r land_wait; IFS= read -r wait_on; } < <(pr_wait "$g" "$state" "$xr" "$gd" "$ci" "$pr" "$oid" "$chain")
    # A session waiting its landing turn carries how long its gate has waited and how deep its repo's
    # landing queue is, so the shepherd names a multi-hour wait on its own line (ar-2525).
    local qwait=- qdepth=- qrepo=- qpr=-
    if [ "$host" = - ] && { [ "$ojob" = queue ] || [ -n "$land_wait" ]; }; then IFS=$'\t' read -r qwait qrepo qpr < <(queue_wait_of "$cwd" "$cpid" "$gd"); fi
    if [ "$g" = 1 ] && [ "$gd" != - ] && [ -n "$FLEET_QUEUE_LABEL" ] && { [ "$ojob" = queue ] || [ -n "$land_wait" ]; }; then
      qdepth="$(queue_depth "$gd")"; qdepth="${qdepth:--}"
    fi
    # The transcript can be 40 MB, so it is read only for an idle session, or the one asking about itself (wake_facts).
    local cron=- wake=-
    if [ "$host" = - ] && { [ "$idle" -ge "$FLEET_IDLE_MIN" ] || [ "$sid" = "${CLOSE_SELF:-}" ]; }; then
      IFS=$'\t' read -r wake cron < <(wake_facts "$transcript" "$started" "$now" "$idle" "$phases" "$pdone" "$ptotal" "$pq")
    fi
    bucket="$(session_bucket "$status" "$plan" "$asks" "$hv" "$bidle" "$g" "$dirty" "$ahead" \
              "$pr" "$state" "$ci" "$inpr" "$red" "$phases" "$pq" "$conflicts" "$ojob" "$names" "$landed" "$item" "$wait_on" "$cron" - "$carried")"
    fin=0; session_finished "$status" "$plan" "$asks" "$hv" "$bidle" "$g" "$dirty" "$ahead" \
             "$pr" "$state" "$ci" "$inpr" "$red" "$phases" "$pq" "$conflicts" "$ojob" "$names" "$landed" "$item" && fin=1
    # An idle session whose transcript ends on its own stop line is stopped (stopped_bucket); a finished one is left to DONE.
    local stopped="" stopat=""
    if [ "$host" = - ] && [ "$status" = idle ] && [ "$hv" = 0 ] && [ "$ojob" != agent ] && [ "$fin" = 0 ] \
       && [ "$idle" -ge "$FLEET_API_ERROR_IDLE_MIN" ]; then
      IFS=$'\t' read -r stopped stopat < <(stopped_bucket "$transcript" "$bucket" "$red")
      [ -z "$stopped" ] || bucket="$stopped"
    fi
    blk="$(work_blockers "$askids" "$status" "$plan" "$asks" "$hv" "$bidle" "$g" "$dirty" "$ahead" \
             "$pr" "$state" "$ci" "$inpr" "$red" "$phases" "$pq" "$conflicts" "$ojob" "$names" "$landed" "$item" "$wait_on" - "$(merged_prs "$prs")")"
    local elsewhere=""
    [ "$host" != - ] || elsewhere="$(edited_work_blockers "$cwd" "$edited" "$sid")"
    if [ -n "$elsewhere" ]; then
      fin=0
      blk="${blk:+$blk; }${elsewhere#* }"
      case "${bucket%% *}" in
        DONE | LANDED | CHAT) bucket="$elsewhere" ;;
      esac
    fi
    # A sibling repo's PR is named the way GitHub cross-references it, so the nudge says where it is.
    [ "$xr" = - ] || { bucket="${bucket//PR #$pr/PR $xr#$pr}"; blk="${blk//PR #$pr/PR $xr#$pr}"; }
    # An open PR's fact carries its head commit, so a push that is still red is a new fact
    # and gets a new nudge, while the same commit is never nudged twice. A conflict's fact
    # carries the merge base instead: a push that leaves it unresolved is the same fact, and
    # only a branch that took the base in (was clean) and conflicts again is a new one.
    # Carrying on is activity, not a fact: a session flipping between busy and idle must never page twice.
    fact="${bucket%, carrying on}"; [ "$pr" != - ] && fact="$fact @$branch"
    # One error is one fact (its minute), so a second one after a nudge restarted the session is nudged again.
    [ -z "$stopat" ] || fact="$fact at $stopat"
    if [ "$bucket" = "STALLED PR #$pr conflicts with the default branch" ]; then
      fact="$fact base ${fork:0:12}"
    elif [ "$state" = OPEN ] && [ "$oid" != - ]; then fact="$fact@${oid:0:12}"; fi
    nudged "$sid" "$fact" && n=1; escalated "$sid" "$fact" && e=1
    [ ! -e "$CLOSED/$sid" ] || n=1
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t-\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${bucket%% *}" "$target" "$sid" \
      "$cwd" "$branch" "$pr" "$idle" "$ctx" "$planf" "$n" "${bucket#* }" "${pane:--}" "$e" "${dsp:--}" \
      "$pdone" "$ptotal" "$pnext" "$fin" "$behind" "$conflicts" "$state" "$ci" "$dirty" "$ahead" \
      "$(labels_of "$sid")" "${status:--}" "$age" "$asks" "$fact" "${blk:--}" \
      "$prs" "$(prs_cell <<<"$prs")" "$work" "$jobs" "$human" "$parked" "$compactions" "$topic" "$doing" "$said" "$gate" "$test" "$mh" \
      "$plj" "${acct:--}" "$islugs" "$irel" "$irow" "$iby" "$(resolve_project_name "$cwd")" "$host" "${act:--}" "$ownask" "$inplan" "$cwin" "${ojob:--}" "$qwait" "$qdepth" "$prun" "$pwq" "$wake" "$(critical_of "$land_wait" "$irow" "$gd" "$pr")" "${shown:-0}" "${mman:-0}" "$(quiet_before "$restored" "$host" "${target%%/*}/$pane" "$since")" "$qrepo" "$qpr" "${mdl:--}" "${harn:--}"
    [ ! -f "$CACHE/blind_row" ] || echo "$sid" >> "$CACHE/blind"
  done
  [ -z "${CLOSE_SELF:-}" ] || return 0
  main_rows
  checkout_rows "$off"
  shared_rows
}

# nightly_item_owners -> "<repo slug>\t<session>" per running nightly-green-* or nightly-fix-* item
# (the owner and fix items of playground-nightly-fix, steps 1 and 6), its repo its project's checkout
# (project_repo_path), its session the Claude session it last ran in, else its tmux session. An item
# with no session recorded owns nothing; one whose session is gone is moved off running by
# `fleet-dispatch reap`, which each shepherd pass runs first. Why: 2026-11-15 unity-core-playground read owners [] while two
# nightly-fix items ran, so a covered red read as the human's (ar-2467).
nightly_item_owners() {
  local proj who dir slug
  while IFS=$'\t' read -r proj who; do
    dir="$(project_repo_path "$proj")"
    [ -n "$dir" ] && [ -n "$who" ] && slug="$(repo_slug "$dir")" || continue
    printf '%s\t%s\n' "$slug" "$who"
  done < <(jq -r 'select(.state == "running" and (.slug // "" | test("^nightly-(green|fix)-")))
      | [.project // "", (((.sessions // "") | split(" ") | map(select(. != "")) | last) // .session // "")]
      | @tsv' <<<"${qjson:-}" 2>/dev/null)
}

# One NIGHTLY row per red repo seen this pass. Its ledger id is main-<repo slug>, so the shepherd
# escalates a nightly red once per fact; owners are the live sessions whose merge is a suspect, nudged
# on their own STALLED rows, and the sessions running a nightly item for that repo (nightly_item_owners).
# Its nudged and escalated cells read that ledger, as every row's do.
main_rows() {
  local f slug st wfs sha repo sid reason owners nu e
  nightly_item_owners >> "$CACHE/owners"
  for f in "$CACHE"/main_*; do
    [ -f "$f" ] || continue
    IFS=$'\t' read -r st wfs sha repo < "$f"
    slug="${f##*/main_}"; sid="main-$slug"
    case "$st" in
      RED) reason="$repo red: $wfs" ;;
      UNKNOWN) reason="$repo main CI unreadable (the run ledger has no fresh sync of it)" ;;
      *) continue ;;
    esac
    owners="$(awk -F'\t' -v s="$slug" '$1 == s && !seen[$2]++ { print $2 }' "$CACHE/owners" 2>/dev/null | paste -sd, -)"
    # A failed queue read lost the item owners: the row keeps its last cells (keep_blind).
    [ -z "${qblind:-}" ] || echo "$sid" >> "$CACHE/blind"
    nu=0; nudged "$sid" "NIGHTLY $reason" && nu=1; e=0; escalated "$sid" "NIGHTLY $reason" && e=1
    printf 'NIGHTLY\t%s\t%s\t-\t-\t-\t0\t0\t-\t%s\t%s\t-\t%s\t%s\t-\t-\t-\t-\t0\t-\t-\t-\t-\t-\t-\t-\t-\t-\t0\tNIGHTLY %s\t-\t[]\t-\t0\t0\t0\t0\t0\t-\t-\t-\t0\t0\n' "$repo" "$sid" "$nu" "$reason" "$e" "${owners:--}" "$reason"
  done
}

# checkout_rows <checkouts, one per line>: one CHECKOUT row each. The reflog says where to and when,
# the post-checkout hook's record for this HEAD says who. The row is born escalated: Sentinel's
# main-checkout-branch watch is the one page, and it trips from an inline probe that needs nothing
# from the tree this fault may have replaced. Its fact is the HEAD, so a further move is a new one.
checkout_rows() {
  local d name head short base at gs where actor reason
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    name="${d##*/}" head="$(git -C "$d" rev-parse HEAD)" base="$(default_base "$d")"
    short="${head:0:12}" at= gs=
    IFS=$'\t' read -r at gs < <(git -C "$d" log -g -1 --date=unix --format='%gd%x09%gs' --grep-reflog='^checkout: moving' 2>/dev/null)
    where="$(git -C "$d" symbolic-ref -q --short HEAD)"
    [ -n "$where" ] || where="${gs##* to }"
    at="${at//[^0-9]/}"
    actor="$(awk -F'\t' -v h="$head" '$3 == h { a = $4 } END { print a }' "$LEDGER/checkout-moves.tsv" 2>/dev/null)"
    reason="$name checkout on ${where:-$short} since $(date -d "@$at" '+%a %H:%M' 2>/dev/null || echo unknown), moved by ${actor:-an unrecorded actor}: stowed scripts run it, git -C $d switch ${base#*/}"
    printf 'CHECKOUT\t%s\tcheckout-%s\t-\t-\t-\t0\t0\t-\t0\t%s\t-\t1\t-\t-\t-\t-\t-\t0\t-\t-\t-\t-\t-\t-\t-\t-\t-\t0\tCHECKOUT %s @%s\t-\t[]\t-\t0\t0\t0\t0\t0\t-\t-\t-\t0\t0\n' "$name" "$name" "$reason" "$name" "$short"
  done <<<"$1"
}

# One SHARED row per test that failed on FLEET_SHARED_RED_BRANCHES branches (a detached checkout
# counts by its worktree) within the last FLEET_SHARED_RED_MIN minutes of $TEST_FAILURES and
# $POOL_FAILURES, a branch red on both counted once. No session
# owns it: fleet-shepherd check finds or files the owner, an item or a quarantine row (shared_sample), the pass tells
# the owners once (nudged), and only a red no item could be filed for escalates (ar-185, ar-623).
# Its fact is the episode's first failure, an episode ending at a quiet gap longer than the window, so one more branch is not a new page and the
# same test red again tomorrow is. Owners are the live sessions in the failing worktrees.
# A ledger line may carry a fifth column, the failure's fingerprint (a baseline-count test's count
# delta, say), - or none when unknown: a branch counts by its latest one, and a test is shared only
# when one fingerprint, with the unknown ones, reaches the bar. A different delta on each branch is
# each branch's own diff, not a shared cause (ar-2448: FlakePatternTests on agent-4 and agent-23).
shared_rows() {
  local ledgers=() f test start n keys owners sid reason fact nu e win="${FLEET_SHARED_RED_MIN}m"
  for f in "$TEST_FAILURES" "$POOL_FAILURES"; do [ -f "$f" ] && ledgers+=("$f"); done
  [ "${#ledgers[@]}" -gt 0 ] && [ -n "$(find "${ledgers[@]}" -mmin -"$FLEET_SHARED_RED_MIN" 2>/dev/null)" ] || return 0   # nothing new in the window
  [ $(( FLEET_SHARED_RED_MIN % 60 )) = 0 ] && win="$(( FLEET_SHARED_RED_MIN / 60 ))h"
  : >> "$CACHE/cwds"
  sort -t$'\t' -k1,1n "${ledgers[@]}" | awk -F'\t' -v OFS='\t' -v now="$(date +%s)" -v cw="$CACHE/cwds" \
      -v w="$(( FLEET_SHARED_RED_MIN * 60 ))" -v min="$FLEET_SHARED_RED_BRANCHES" '
    FILENAME == cw { sids[$1] = sids[$1] " " $2; next }
    $1 !~ /^[0-9]+$/ || $1 > now || $4 == "" { next }
    {
      t = $4; k = ($3 == "-" || $3 == "") ? $2 : $3
      if (!(t in last) || $1 - last[t] > w) start[t] = $1
      last[t] = $1
      if ($1 < now - w) next
      if (!((t, k) in seen)) { seen[t, k] = 1; b[t, ++nb[t]] = k }
      if (!((t, k, $2) in wt)) { wt[t, k, $2] = 1; wts[t, k] = wts[t, k] " " $2 }
      fp[t, k] = ($5 == "-") ? "" : $5
    }
    END {
      for (x in fp) if (fp[x] != "") { split(x, p, SUBSEP); if (++c[p[1], fp[x]] > mx[p[1]]) { mx[p[1]] = c[p[1], fp[x]]; g[p[1]] = fp[x] } }
      # the branches of the largest fingerprint, with the unknown ones, in first-failure order
      for (t in nb) {
        n = 0; keys = ""; o = ""; delete own; delete wd
        for (j = 1; j <= nb[t]; j++) {
          k = b[t, j]
          if (fp[t, k] != "" && fp[t, k] != g[t]) continue
          n++; keys = keys (n > 1 ? ", " : "") k
          m = split(wts[t, k], ws, " ")
          for (i = 1; i <= m; i++) {
            if (ws[i] in wd) continue
            wd[ws[i]] = 1; q = split(sids[ws[i]], s, " ")
            for (r = 1; r <= q; r++) if (!(s[r] in own)) { own[s[r]] = 1; o = o (o == "" ? "" : ",") s[r] }
          }
        }
        if (n >= min) print t, start[t], n, keys, (o == "" ? "-" : o)
      }
    }' "$CACHE/cwds" - | sort |
  while IFS=$'\t' read -r test start n keys owners; do
    sid="shared-$(printf '%s' "$test" | tr -c 'A-Za-z0-9' _)"
    reason="$test red on $n branches in $win: $keys"
    fact="SHARED $test @$start"
    nu=0; nudged "$sid" "$fact" && nu=1; e=0; escalated "$sid" "$fact" && e=1
    printf 'SHARED\t%s\t%s\t-\t-\t-\t0\t0\t-\t%s\t%s\t-\t%s\t%s\t-\t-\t-\t-\t0\t-\t-\t-\t-\t-\t-\t-\t-\t-\t0\t%s\t-\t[]\t-\t0\t0\t0\t0\t0\t-\t-\t-\t0\t0\n' "$test" "$sid" "$nu" "$reason" "$e" "$owners" "$fact"
  done
}

# --- tick: the stage cells and their changes -------------------------------------------------------------
# eta_cells -> "sid <TAB> eta <TAB> epoch" for each session fleet-bench has an estimate for: the expected
# finish (HH:MM today, else "Thu HH:MM") and its basis, short: "<word>-median(N)" as its first
# letter and N ("21:30 s3" is the session's own median over 3 phases, "p16" the project's), its
# calibration suffix dropped, anything else as it is. fleet-bench reads only its own files, so one call per tick is cheap; how
# it estimates is its business (the fleet-bench skill), the board only shows the answer. [raw file] keeps
# the bench's own lines for overdue_of, and a failed read is named unreadable there.
eta_cells() {
  local raw
  raw="$("${FLEET_BENCH:-fleet-bench}" eta --json 2>/dev/null)" || { [ -z "${1:-}" ] || unreadable "fleet-bench eta"; }
  [ -z "${1:-}" ] || printf '%s\n' "$raw" > "$1"
  printf '%s\n' "$raw" | jq -r --arg today "$(date +%F)" '
    select(type == "object" and .eta_epoch != null and (.finished | not))
    | .eta_epoch as $e
    | ($e | strflocaltime(if ($e | strflocaltime("%F")) == $today then "%H:%M" else "%a %H:%M" end)) as $at
    | [.session_id, ([$at, (.basis // empty | sub("^(?<k>[a-z])[a-z]*-median\\((?<n>[0-9]+)\\)( .*)?$"; "\(.k)\(.n)"))] | join(" ")), $e] | @tsv' 2>/dev/null
  return 0 # no bench, or a failed read, is no estimate: the column reads -
}

# board_cells [eta file]: collect's rows on stdin -> one line per session, in bucket order:
#   sid target sync conflicts tree pr ci plan quality stage labels idle age reason eta prs work wait task now project
# Columns 3-11 are the stages a transition is read from; idle, age and eta move without a stage
# changing, and reason rides along to explain a stage change. Newer cells come last so a
# watch.state written before them still lines up. now is what WHY shows: on a WORKING row, the
# session's last action (its reason only says busy or shell), else the reason. NIGHTLY, CHECKOUT and SHARED
# rows are rendered separately.
board_cells() {
  awk -F'\t' -v OFS='\t' -v etaf="${1:-}" -v order="$BUCKET_ORDER" '
    # minutes -> 45m, 3h12m, 2d4h; "-" when the session start is unknown
    function dur(m) {
      if (m !~ /^[0-9]+$/) return "-"
      if (m < 60) return m "m"
      if (m < 1440) return int(m / 60) "h" (m % 60) "m"
      return int(m / 1440) "d" int((m % 1440) / 60) "h"
    }
    # minutes -> 45m or 3h, rounded: a share of an age, not a clock. "-" when none or unknown.
    function hrs(m) {
      if (m !~ /^[0-9]+$/ || m == 0) return "-"
      return m < 60 ? m "m" : int(m / 60 + 0.5) "h"
    }
    # the largest wait that is not work, named; a tie goes to the first of gate, test, jobs, you, parked
    function wait_cell(g, t, j, h, p,    n, i, v, top, name) {
      n = split(g " " t " " j " " h " " p, v, " ")
      for (i = 1; i <= n; i++) if (v[i] + 0 > top + 0) { top = v[i]; name = i }
      return name ? wait_names[name] " " hrs(top) : "-"
    }
    BEGIN {
      n = split(order, o, " "); for (i = 1; i <= n; i++) rank[o[i]] = i
      split("gate test jobs you parked", wait_names, " ")
      if (etaf != "") while ((getline l < etaf) > 0) { split(l, kv, "\t"); eta[kv[1]] = kv[2] }
    }
    $1 == "NIGHTLY" || $1 == "CHECKOUT" || $1 == "SHARED" { next }
    {
      t = $2; sub(/^[^\/]*\//, "", t)
      git = ($5 != "-")
      sync = !git || $20 == "-" ? "-" : ($20 == 0 ? "current" : $20 " behind")
      conf = !git ? "-" : ($21 == "yes" ? "CONFLICT" : $21)
      tree = !git ? "-" : ($24 > 0 ? $24 " dirty" : ($25 > 0 ? $25 " ahead" : "clean"))
      pr = $6 == "-" ? "-" : "#" $6 " " tolower($22)
      ci = $23 == "-" ? "-" : tolower($23)
      plan = $16 == "-" ? "-" : $16 "/" $17
      q = ""; l = ""
      m = split($26 == "-" ? "" : $26, ls, ",")
      for (i = 1; i <= m; i++)
        if (ls[i] ~ /^quality:/) q = q (q == "" ? "" : ",") substr(ls[i], 9)
        else l = l (l == "" ? "" : ",") ls[i]
      now = $40; sub(/^Bash: /, "", now)
      print (rank[$1] ? rank[$1] : 9), $3, t, sync, conf, tree, pr, ci, plan,
            (q == "" ? "-" : q), $1, (l == "" ? "-" : l), $7 "m", dur($28), $11,
            ($3 in eta ? eta[$3] : "-"), ($33 == "" ? "-" : $33), hrs($34), wait_cell($42 + 0, $43 + 0, $35 + 0, $36 + 0, $37 + 0),
            ($39 == "" ? "-" : $39), ($1 == "WORKING" && now != "-" && now != "" ? now : $11), ($51 == "" ? "-" : $51)
    }' | sort -t$'\t' -k1,1n -k3,3 | cut -f2-
}

# transitions <previous cells file> <current cells file> -> one line per session that
# appeared, left, or changed a stage cell: "target  ci pending -> fail, stage ... (reason)". The
# new: and gone rows end in " sid=<session id>": a target like hub/dotfiles:3 is reused within a
# day, so only the id ties a close to the shepherd nudge that preceded it (ar-2013).
transitions() {
  awk -F'\t' '
    BEGIN { split("- - sync conflicts tree pr ci plan quality stage labels", name, " ") }
    NR == FNR { prev[$1] = $0; next }
    {
      seen[$1] = 1
      if (!($1 in prev)) { print $2 "  new: " $10 " (" $14 ") sid=" $1; print $2 "  project - -> " $21; next }
      split(prev[$1], p, "\t"); out = ""
      for (i = 3; i <= 11; i++)
        if (p[i] != $i) out = out (out == "" ? "" : ", ") name[i] " " p[i] " -> " $i
      # The project is the last cell, so a watch.state written before it has none: "-" is its old value.
      if (p[21] != $21) out = out (out == "" ? "" : ", ") "project " (p[21] == "" ? "-" : p[21]) " -> " $21
      if (out != "") print $2 "  " out (p[10] != $10 ? " (" $14 ")" : "")
    }
    END { for (s in prev) if (!(s in seen)) { split(prev[s], p, "\t"); print p[2] "  gone sid=" s } }' "$1" "$2"
}

# keep_blind <previous cells file> <current cells file> <blind file> -> the current cells with each
# row a failed source fed put back to its previous cells, so tick logs no blink for it and the next
# good read is compared with the last good one. <blind file> holds session ids (a row's per-row
# source failed: the PR store, the run ledger, gh api jobs, gh pr view), "+" (a remote agent-panel
# read with a gap: the previous rows it did not list are kept, not gone) or "*" (the local
# agent-panel failed: it feeds every row, so every row keeps its previous cells). A blind row with
# no previous cells waits for a good read before it is new. Any other row is logged as read: one
# blind source no longer holds the whole fleet (ar-1116, 2026-11-08 20:27 to 11-09 03:10).
keep_blind() {
  awk -F'\t' '
    FILENAME == ARGV[1] { blind[$1] = 1; next }
    FILENAME == ARGV[2] { prev[$1] = $0; order[++n] = $1; next }
    blind["*"] { next }
    !($1 in blind) { print; seen[$1] = 1; next }
    $1 in prev { print prev[$1]; seen[$1] = 1 }
    END { if (blind["*"] || blind["+"]) for (i = 1; i <= n; i++) if (!(order[i] in seen)) print prev[order[i]] }
  ' "$3" "$1" "$2"
}

# pass: one collect, its rows in PASS_ROWS, with $CACHE the scratch dir every helper of the pass
# writes. collect runs as a job in its own process group (set -m; stdin is /dev/null, so no read in
# it can stop it on SIGTTIN), so end_pass can end every process of the pass, its pipeline,
# subshells and process substitutions, before $CACHE goes. Before, an interrupt removed $CACHE under
# them: a subshell whose child handles SIGINT itself (gh, python) reads a plain non-zero exit and
# runs on into the removed dir, and a SIGINT sent to this pid alone waited out the whole pass (nc-42).
# Under fleet-state.service TMPDIR is the unit's RuntimeDirectory, which systemd removes on stop:
# its timeout kills the whole cgroup, the trap's rm with it.
pass() {
  CACHE="$(mktemp -d)"
  trap end_pass EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  set -m
  collect < /dev/null > "$CACHE/rows" &
  PASS_PID=$!
  set +m
  wait "$PASS_PID"
  PASS_PID=
  PASS_ROWS="$(< "$CACHE/rows")"
}

# end_pass: the EXIT trap. TERM, not KILL, so a git in the pass removes its lock files; pidwait
# returns once every process of the group has exited (run-bats.sh reaps the same way), bounded in
# case one ignores TERM, so nothing still writes into $CACHE when rm runs.
end_pass() {
  if [ -n "${PASS_PID:-}" ]; then
    kill -TERM -- "-$PASS_PID" 2>/dev/null
    wait "$PASS_PID" 2>/dev/null
    timeout 10 pidwait -g "$PASS_PID"
  fi
  rm -rf "$CACHE"
}

# tick: one pass with a fetch first (FLEET_FETCH=1), for the hub Sessions tab. git, gh and the
# transcripts have no change event to await, so fleet-state.timer runs it every minute; a pass
# costs ~12s of gh and git. It logs what moved since the last tick to watch.log (the state file
# is shared and locked, so two ticks log each change once), keeps watch.state for the next
# compare, and writes the state document with each session's eta.
tick() {
  export FLEET_FETCH=1
  local rows cur new now t0 rc=0
  t0="$(date +%s)"
  pass; rows="$PASS_ROWS"
  eta_cells "$CACHE/eta.json" > "$CACHE/eta"
  cur="$CACHE/cells"; board_cells "$CACHE/eta" <<<"$rows" > "$cur"
  now="$(date '+%Y-%m-%d %H:%M')"
  mkdir -p "$LEDGER"
  (
    flock 9
    # Read again at the write: a pass takes up to two minutes, and a holder whose lease lapsed
    # in it must not write over the next holder's ledger (ar-3439).
    lease_held || { echo "fleet-sessions: tick skipped: the fleet lease moved during this pass" >&2; exit 3; }
    # What a source could not read did not change: those rows keep their last good cells.
    if [ -f "$LEDGER/watch.state" ]; then
      # keep_blind failing keeps the whole last state: a blink must never become the baseline.
      [ ! -s "$CACHE/blind" ] || { keep_blind "$LEDGER/watch.state" "$cur" "$CACHE/blind" > "$cur.kept" && mv "$cur.kept" "$cur"; } \
        || cp "$LEDGER/watch.state" "$cur"
      new="$(transitions "$LEDGER/watch.state" "$cur")"
      [ -n "$new" ] && sed "s/^/$now  /" <<<"$new" >> "$LEDGER/watch.log"
      prune_labels "$cur"
    fi
    cp "$cur" "$LEDGER/watch.state"
  ) 9>"$LEDGER/watch.lock" || rc=$?
  [ "$rc" != 3 ] || return 0
  release_left "$rows"
  write_state "$t0" "$rows" > /dev/null
}

# explain <who>: one session as the last pass saw it, from the state document. It runs no pass,
# so it answers at once and can be up to one pass old, which the first line says.
explain() {
  local who="${1:-}"
  [ -n "$who" ] || { echo "usage: fleet-sessions explain <target|session|session id>" >&2; return 2; }
  [ -f "$STATE_FILE" ] || { echo "fleet-sessions: no state document at $STATE_FILE" >&2; return 1; }
  jq -re --arg w "$who" --argjson now "$(date +%s)" '
    def hrs: if . == null or . == 0 then "0m" elif . < 60 then "\(.)m" else "\((. / 60 + 0.5) | floor)h" end;
    def line($k; $v): "\($k | . + ("         " | .[($k | length):]))\($v)";
    . as $d
    | [.sessions[] | select(.session_id == $w or .target == $w or (.target | sub("^[^/]*/"; "")) == $w
        or (.target | sub("^[^/]*/"; "") | sub(":[^:]*$"; "")) == $w)][0] // empty
    | ((.prs // []) | [(map(select(.state == "MERGED")) | length), length]) as [$m, $n]
    | (.time // {}) as $t
    | ["\(.target)  \(.bucket)  (state \(($now - $d.generated_epoch) / 60 | floor)m old)",
       line("task"; .topic // "-"),
       line("time"; "open \(.age_min | hrs): \($t.work_min | hrs) work, \($t.gate_min // 0 | hrs) gate, \($t.test_min // 0 | hrs) test, \($t.jobs_min | hrs) jobs, \($t.human_min | hrs) you, \($t.parked_min | hrs) parked; idle \(.idle_min | hrs) now; \(.compactions // 0) compactions"),
       line("plan"; if .phases_total then "\(.phases_done)/\(.phases_total)\(if .next_phase then ", next: \(.next_phase)" else "" end)" elif ((.reason // "") | test("plan file is missing")) then "plan file missing" else "no checklist" end),
       line("branch"; "\(.branch)\(if .pr != "-" then " (PR #\(.pr))" else "" end)"),
       line("PRs"; "\($m) merged of \($n)"),
       ((.prs // [])[] | "  \(.repo)#\(.number)  \((.state // "unknown") | ascii_downcase)\(if .merged_at then "  \(.merged_at | fromdate | strflocaltime("%a %H:%M"))" else "" end)"),
       line("doing"; .doing // "-"),
       line("said"; .said // "-"),
       line("why"; .reason),
       (.pr as $pr | .critical // empty | line("critical"; "PR #\($pr) \(.place), \(.rows | join(", ")) wait on it")),
       ((.blockers // [])[] | "  - \(.)")] | .[]' "$STATE_FILE" \
    || { echo "fleet-sessions: no session in the state document matches '$who'" >&2; return 2; }
}

# CLOSE_JQ: a row -> its `pct` (phases ticked, of the checklist) and `close` {verdict, why}:
# whether the session may close now, after one named step, or must stay (keep). The one
# definition of when a session closes, one chain for every session, first match wins, as the
# close flow of .local/src/docs/fleet-states.md, each branch tagged `# step:<id>` with the Step
# of its table row (tests/unit/fleet_states_doc.bats keeps the two in order): a session stays
# only while closing it would lose something (its claude is elsewhere, the human labelled it
# manual, or it is stay or chat and quiet under FLEET_CHAT_CLOSE_H, a prompt in its pane, a turn under way, unlanded
# work) or until one named step (close its item); otherwise it closes once quiet FLEET_IDLE_CLOSE_MIN.
# The three work-left steps also set `left`, the blocker that holds the session, which fleet-shepherd
# nudges a DONE or LANDED row on. Open plan phases hold nothing: once the window is gone,
# fleet-dispatch reap files them (reconcile_plans), the one filer of a plan. A manual row always
# keeps, `--self` too: the human set it and only the human ends it (asked 2026-11-20, ar-4124). A stay
# row asked by `--self` reads quiet 0 mid-turn and keeps, so past the timer the shepherd's typed close
# is declined and its window is closed by close_sample an hour later, never by the session itself.
# Unlanded work reads from `blockers` (work_blockers), not raw git counts: a squash-merged branch
# stays `ahead` of main with nothing left to land. A null age_min reads 0. A row fleet-dispatch restore
# reopened adds quiet_before_min, the quiet it had when its server was last seen, to its age: its claude
# is new, its conversation is not, and the bare age would hold a finished window open another hour while
# the outage itself is no quiet (ar-4141). The row of the session
# named by `--arg self` (close --self, run mid-turn by /wind-down auto) skips the turn and the
# quiet steps: the shepherd's nudge came after the quiet time, and the session is always mid-turn.
CLOSE_JQ='
  def close_verdict($idle_close; $chat_close_h):
    ((($ARGS.named.self // "") != "") and .session_id == $ARGS.named.self) as $me
    | ([.idle_min // 0, (.age_min // 0) + (.quiet_before_min // 0)] | min) as $quiet
    | ((.blockers // []) | map(select(test("^(open ask |[0-9]+ open ask)") | not))) as $other
    | ($other | map(select(test("dirty file|not on the default branch|(^|: )PR ([^ /]+/[^ /]+)?#[0-9]+ open|commits after merged PR")))[0])
      as $unlanded
    | ($other | map(select(test("is running here$|^nightly red after PR")))[0]) as $held
    | ([$other[] | capture("^its item (?<s>[^ ]+) is still open with every phase done or queued$").s]) as $open_items
    | (($open_items | length) > 0 and ($open_items | length) == ($other | length)) as $only_item
    | (if .bucket == "PARKED" then (.idle_min // 0) else $quiet end) as $quiet
    | if .bucket == "PARKED" and ($unlanded or $held or ((.blockers // []) | any(test("^(open ask |[0-9]+ open ask)")))) then {verdict: "keep", why: "parked: its claude is gone, work is left here"} # step:parked
      elif .activity == "done" then {verdict: "keep", why: "headless run: fleet-dispatch reap closes its replay once its item leaves review"} # step:headless
      elif ((.labels // []) | index("manual")) then {verdict: "keep", why: "manual: the human keeps it"} # step:manual
      elif ((.labels // []) | index("stay")) and $quiet < $chat_close_h * 60 # step:stay
        then {verdict: "keep", why: "stay: kept open as the human asked, quiet \($quiet)m of \($chat_close_h)h"}
      elif ((.labels // []) | index("chat")) and ($me | not) and $quiet < $chat_close_h * 60 # step:chat
        then {verdict: "keep", why: "chat: quiet \($quiet)m of \($chat_close_h)h"}
      elif .in_plan_mode then {verdict: "keep", why: "plan mode: the human approves or ends it"} # step:plan-mode
      elif .bucket == "NEEDS" and ((.reason // "") | test("pending ask") | not) then {verdict: "keep", why: "a dialog waits on the human"} # step:dialog
      elif (.bucket == "WORKING" or (.bucket == "NEEDS" and ((.reason // "") | endswith("carrying on")))) # step:working
        and ($me | not) then {verdict: "keep", why: "working"}
      elif $unlanded then {verdict: "keep", why: "land it: \($unlanded)", left: $unlanded} # step:unlanded
      elif $only_item then {verdict: "after", why: "close its item \($open_items | join(", ")) (agent-land its last PR without --partial, or agent-queue move <slug> done; the shepherd moves it done once quiet): every phase is done or queued", left: $other[0], items: $open_items} # step:only-item
      elif $held then {verdict: "keep", why: "work left here: \($held)", left: $held} # step:held
      elif .wake then {verdict: "keep", why: "it wakes itself: \(.wake) (CronDelete, TaskStop or ScheduleWakeup stop ends it once the work is done)"} # step:scheduled
      elif ($me | not) and $quiet < $idle_close then {verdict: "after", why: "quiet \($quiet)m of \($idle_close)m"} # step:quiet
      else {verdict: "now", why: (if (.own_asks // 0) > 0 then "quiet \($quiet)m, its ask reopens it on an answer" else "quiet \($quiet)m, nothing to land" end)} end; # step:now
  .pct = (if (.phases_total // 0) > 0 then (100 * (.phases_done // 0) / .phases_total | floor) else null end)
  | .close = (if .bucket | IN("NIGHTLY", "CHECKOUT", "SHARED") then null
              else close_verdict($idle_close; $chat_close_h) end)'

# state_stale_secs: FLEET_STATE_STALE_SECS from .config/fleet-sessions/state.conf, the one home of
# how old the state document may be (hub-core home.rs includes the same file). No default here: a
# conf without the number prints the fault and -1, which no age is under, so the document reads stale.
state_stale_secs() {
  local conf v
  conf="${FLEET_STATE_CONF:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../../.config/fleet-sessions/state.conf}"
  v="$(sed -n '/^FLEET_STATE_STALE_SECS=/{s///p;q;}' "$conf" 2>/dev/null)"
  [[ "$v" =~ ^[0-9]+$ ]] || { echo "fleet-sessions: FLEET_STATE_STALE_SECS is not set to a number in $conf" >&2; v=-1; }
  printf '%s' "$v"
}

# close_view [--json]: every session in the state document by its close verdict, now first, then
# after, then keep, each oldest-quiet first: where it is (bucket, phases, eta) and why. Reads the
# document `tick` wrote a minute ago, so it costs no collect; one read, so counts and rows agree.
# A document older than FLEET_STATE_STALE_SECS, or one without verdicts, is named on stderr.
close_view() {
  [ -r "$STATE_FILE" ] || { echo "fleet-sessions: no state document at $STATE_FILE" >&2; return 1; }
  local doc age
  doc="$(jq -c --argjson now "$(date +%s)" '{age: ($now - (.generated_epoch // 0)),
    rows: ([.sessions[] | select((.labels // []) | index("shepherd") | not)]),
    } | .bare = (.rows | map(select(.close == null)) | length)
      | .rows |= (map(select(.close != null))
                  | sort_by((.close.verdict | {now: 0, after: 1, keep: 2}[.] // 3), -(.idle_min // 0)))' \
    "$STATE_FILE")" || return 1
  age="$(jq -r .age <<<"$doc")"
  [ "$age" -le "$(state_stale_secs)" ] \
    || echo "fleet-sessions: the state document is $((age / 60))m old: is fleet-state.timer running?" >&2
  [ "$(jq -r .bare <<<"$doc")" = 0 ] \
    || echo "fleet-sessions: $(jq -r .bare <<<"$doc") session(s) carry no verdict (a document from before close)" >&2
  if [ "${1:-}" = --json ]; then jq -c '.rows[]' <<<"$doc"; return; fi
  jq -r '.rows | [("now", "after", "keep") as $v | "\($v) \(map(select(.close.verdict == $v)) | length)"]
    | join(", ")' <<<"$doc"
  jq -r '.rows[] | [.close.verdict, (.target | sub("^[a-z]+/"; "")), .bucket,
      (if .phases_total then "\(.phases_done)/\(.phases_total) \(.pct)%" else "-" end),
      "\(.idle_min // 0)m", (.eta // "-"), .close.why] | @tsv' <<<"$doc" | column -t -s $'\t'
}

# close_self <rows>: this session's own verdict, from a fresh collect (CLOSE_SELF names it) and not
# the document, so a PR that merged a minute ago counts: `<verdict>: <why>`, then its blockers, one a
# line. Exit 0 only on now. The /wind-down auto check reads it.
close_self() {
  local row
  row="$(awk -F'\t' -v s="$CLOSE_SELF" '$3 == s {print; exit}' <<<"$1")"
  [ -n "$row" ] || { echo "fleet-sessions: no live session $CLOSE_SELF" >&2; return 2; }
  # A row a failed source fed is not this session's state (a lock-busy agent-queue read hides its
  # running item, ar-2839), so it waits for a good read, as tick keeps its cells (keep_blind).
  if [ -n "${CACHE:-}" ] && grep -qxF -e "$CLOSE_SELF" -e '*' "$CACHE/blind" 2>/dev/null; then
    echo "after: this pass could not read $(sort -u "$CACHE/unreadable" 2>/dev/null | paste -sd, -); ask again once it reads"
    return 1
  fi
  close_report "$(json_rows <<<"$row")"
}

# close_report <row with its close verdict>: `<verdict>: <why>`, then its blockers, one a line; exit 0 only on now.
close_report() {
  jq -r '"\(.close.verdict): \(.close.why)", ((.blockers // [])[] | "blocker: \(.)")' <<<"$1"
  [ "$(jq -r .close.verdict <<<"$1")" = now ]
}

# holder_state_file -> where the lease holder's rows for this worker land (worker_state_push), beside the
# state document.
holder_state_file() { echo "$(dirname "$STATE_FILE")/holder-state.json"; }

# on_worker: this machine does not hold the fleet lease and is a fleet worker: the lease holder has pushed
# it a state file, or the roster lists it. Its own pass reads no PR store and no run ledger, so a row it
# builds is blind and close --self would never approve.
on_worker() {
  ! lease_held || return 1
  [ -e "$(holder_state_file)" ] && return 0
  fleet_hosts 2>/dev/null | jq -e --arg me "$FLEET_HOST" 'select(.name == $me)' >/dev/null 2>&1
}

# close_self_held: close --self on a worker, answered from the lease holder's row for this session
# (holder_state_file, pushed each minute) through the one close chain, with this session as self. A
# file older than FLEET_STATE_STALE_SECS, or none, or no row for this session yet, is a wait: a stale
# row is not this session's state. The row can be that old, so what the checkout holds now (dirty
# files, files off the default branch) is read here, where it is, and added as the blockers the row
# lacks: work begun after the holder's last read must not read as nothing to land. The holder reads no
# worker's transcript, so what will wake this session (pending_wakes) is read here too, from agent-panel's
# transcript and start for it.
close_self_held() {
  local f doc age row cwd dirty=0 ahead=0 tx started wake
  f="$(holder_state_file)"
  doc="$(jq -c . "$f" 2>/dev/null)" && [ -n "$doc" ] \
    || { echo "after: the lease holder has sent no state to this worker yet ($f); ask again in a minute"; return 1; }
  age=$(( $(date +%s) - $(jq -r '.generated_epoch // 0' <<<"$doc") ))
  [ "$age" -le "$(state_stale_secs)" ] \
    || { echo "after: the lease holder's state is $((age / 60))m old; ask again once it is fresh"; return 1; }
  row="$(jq -c --arg s "$CLOSE_SELF" '[.sessions[]? | select(.session_id == $s)][0] // empty' <<<"$doc")"
  [ -n "$row" ] \
    || { echo "after: the lease holder has not read session $CLOSE_SELF yet; ask again in a minute"; return 1; }
  cwd="$(jq -r '.cwd // empty' <<<"$row")"
  if [ -d "$cwd" ] && git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1; then
    dirty="$(dirty_paths "$cwd" "" | grep -c .)" || dirty=0
    ahead="$(unlanded_files "$cwd" "$(wp_base "$cwd")")"
  fi
  IFS=$'\t' read -r tx started < <("${AGENT_PANEL:-agent-panel}" list --json 2>/dev/null | jq -rn --arg s "$CLOSE_SELF" '
    [inputs | select(.session_id == $s)][0] // {} | [(.transcript // "-"), (.started_at // "-" | tostring)] | @tsv')
  wake="$(pending_wakes "${tx:--}" "${started:--}" "$(date +%s)" | wake_phrase)"
  row="$(jq -c --argjson d "${dirty:-0}" --argjson a "${ahead:-0}" --arg w "$wake" '
    .wake = (if $w == "" then .wake else $w end)
    | .blockers = (.blockers // [])
    | .blockers += (if $d > 0 and (.blockers | any(test("dirty file")) | not) then ["\($d) dirty file(s) here since the lease holder last read"] else [] end)
    | .blockers += (if $a > 0 and (.blockers | any(test("not on the default branch")) | not) then ["\($a) file(s) not on the default branch here since the lease holder last read"] else [] end)' <<<"$row")"
  close_report "$(jq -c --argjson idle_close "$FLEET_IDLE_CLOSE_MIN" --argjson chat_close_h "$FLEET_CHAT_CLOSE_H" \
    --arg self "$CLOSE_SELF" "$CLOSE_JQ" <<<"$row")"
}

# worker_state_push <state document>: on the lease holder, each fleet worker with a session in the document gets
# its own rows (and when the pass started) as holder-state.json beside its state document, over the one ssh
# path, so close --self there answers from the holder's reads (close_self_held). A worker that does not answer
# keeps its last file, which ages out.
worker_state_push() {
  lease_held || return 0
  local h pids=()
  fleet_hosts >/dev/null 2>&1
  while IFS= read -r h; do
    [ -n "$h" ] || continue
    jq -c --arg h "$h" '{generated_epoch, host: $h, sessions: [.sessions[] | select(.host == $h)]}' "$1" \
      | FLEET_SSH_STDIN=1 fleet_host_run "$h" sh -c 'd=${XDG_STATE_HOME:-$HOME/.local/state}/fleet
        mkdir -p "$d" && cat > "$d/holder-state.json.tmp" && mv -f "$d/holder-state.json.tmp" "$d/holder-state.json"' >/dev/null 2>&1 &
    pids+=("$!")
  done < <(jq -r '[.sessions[].host // empty] | unique[]' "$1")
  [ ${#pids[@]} -eq 0 ] || wait "${pids[@]}"
  return 0
}

# json_rows: collect's rows on stdin -> one JSON object per row (the --json contract), each with
# its close verdict (CLOSE_JQ). `by` is who started the session, the one field every live reader
# takes: its item's `by` (agent-queue ORIGIN_BY), hand for a session with no item or an item that
# names no origin (a --running record), null for the shepherd's own.
json_rows() {
  local closed
  closed="$(find "$CLOSED" -mindepth 1 -maxdepth 1 -type f -printf '%f\n' 2>/dev/null | jq -Rn '[inputs | {(.): true}] | add // {}')"
  jq -cR --argjson idle_close "$FLEET_IDLE_CLOSE_MIN" --argjson chat_close_h "$FLEET_CHAT_CLOSE_H" --argjson closed "$closed" \
    ${CLOSE_SELF:+--arg self "$CLOSE_SELF"} 'split("\t") | {bucket: .[0], target: .[1], session_id: .[2],
      close_sent: ($closed[.[2]] // false),
      cwd: .[3], branch: .[4], pr: .[5], idle_min: (.[6] | tonumber), context_tokens: (.[7] | tonumber),
      plan_file: .[8], nudged: (.[9] == "1"), reason: .[10], pane: .[11], escalated: (.[12] == "1"),
      owners: (if .[13] == "-" then [] else .[13] | split(",") end),
      dispatch: (if .[14] == "-" then null else .[14] end),
      phases_done: (if .[15] == "-" then null else .[15] | tonumber end),
      phases_total: (if .[16] == "-" then null else .[16] | tonumber end),
      next_phase: (if .[17] == "-" then null else .[17] end), finished: (.[18] == "1"),
      behind: (if .[19] == "-" then null else .[19] | tonumber end),
      conflicts: (if .[20] == "-" then null else .[20] == "yes" end),
      pr_state: (if .[21] == "-" then null else .[21] end), ci: (if .[22] == "-" then null else .[22] end),
      dirty: (if .[23] == "-" then null else .[23] | tonumber end),
      ahead: (if .[24] == "-" then null else .[24] | tonumber end),
      labels: (if .[25] == "-" then [] else .[25] | split(",") end),
      activity: (if .[26] == "-" then null else .[26] end),
      age_min: (if (.[27] // "-") == "-" then null else .[27] | tonumber end),
      asks: ((.[28] // "0") | tonumber),
      fact: .[29],
      blockers: (if (.[30] // "-") == "-" then [] else .[30] | split("; ") end),
      prs: ((.[31] // "[]") | fromjson),
      time: {work_min: ((.[33] // "0") | tonumber), gate_min: ((.[41] // "0") | tonumber),
             test_min: ((.[42] // "0") | tonumber), jobs_min: ((.[34] // "0") | tonumber),
             human_min: ((.[35] // "0") | tonumber), parked_min: ((.[36] // "0") | tonumber)},
      # The one count of the work time of a session (overdue_of, the fleet-bench samples): the closed
      # minutes of its transcript but those waiting on the human or parked, plus the open gap while a job runs.
      active_min: (. as $c | ([$c[33], $c[41], $c[42], $c[34]] | map((. // "0") | tonumber) | add)
        + (if ($c[56] // "-") | IN("gate", "test", "build", "checkout", "agent", "jobs") then $c[6] | tonumber else 0 end)),
      compactions: ((.[37] // "0") | tonumber),
      topic: (if (.[38] // "-") == "-" then null else .[38] end),
      doing: (if (.[39] // "-") == "-" then null else .[39] end),
      said: (if (.[40] // "-") == "-" then null else .[40] end),
      main_red: (if (.[43] // "-") == "RED" then true elif (.[43] // "-") == "OK" then false else null end),
      phases: ((.[44] // "[]") | fromjson),
      account: (if (.[45] // "-") == "-" then null else .[45] end),
      item: (if (.[46] // "-") == "-" then null else
        (.[46] | split(",")) as $s
        | {slug: $s[0], is: .[47], row: (if .[48] == "-" then null else .[48] end)}
        + (if ($s | length) > 1 then {also: $s[1:]} else {} end) end),
      by: (if (.[25] // "-") | split(",") | index("shepherd") then null
           elif .[49] != "-" then .[49] else "hand" end),
      project: (if (.[50] // "") == "" then null else .[50] end),
      host: (if (.[51] // "-") == "-" then null else .[51] end),
      activity_line: (if (.[52] // "-") == "-" then null else .[52] end),
      own_asks: ((.[53] // "0") | tonumber), in_plan_mode: ((.[54] // "0") == "1"),
      context_window: ((.[55] // "0") | tonumber | if . > 0 then . else null end),
      open_job: (if (.[56] // "-") == "-" then null else .[56] end),
      wait_min: (if (.[57] // "-") == "-" then null else .[57] | tonumber end),
      landing_queue: (if (.[58] // "-") == "-" then null else .[58] | tonumber end),
      phase_runner: (if (.[59] // "-") == "-" then null else .[59] end),
      phase_queued: ((.[60] // "-") == "1"),
      wake: (if (.[61] // "-") == "-" then null else .[61] end),
      critical: (if (.[62] // "-") == "-" then null else {rows: (.[62] | split(",")), place: .[63]} end),
      # The human is looking at it (attached in agent-panel: the active window of an attached tmux
      # session). Not a close step (no presence keeps, fleet-states.md): close_sample never closes a
      # window on screen, so session-close-overdue skips a row with it.
      attached: ((.[64] // "0") == "1"),
      # The manual (default) permission mode is investigate-only, so the session cannot write a wind-down note.
      in_manual_mode: ((.[65] // "0") == "1"),
      # fleet-dispatch restore reopened it: the quiet it had when its server was last seen (CLOSE_JQ).
      quiet_before_min: (if (.[66] // "-") == "-" then null else .[66] | tonumber end),
      # The repo and PR the queue gate of the session lands, where its lander runs in another worktree (queue_gate_of).
      wait_repo: (if (.[67] // "-") == "-" then null else .[67] end),
      wait_pr: (if (.[68] // "-") == "-" then null else .[68] end),
      # The model id running (agent-panel, from the last turn of the transcript), null before the first turn, never guessed.
      # A run whose log names no model has none: hub-core takes the model of its queue item, and shortens either (costs::alias).
      model: (if (.[69] // "-") == "-" then null else .[69] end),
      # The harness agent-panel found running (claude, codex, opencode, agy); hub-core prefers the one of the queue item.
      harness: (if (.[70] // "-") == "-" then null else .[70] end)} | '"$CLOSE_JQ"
}

# overdue_of <now epoch> <rows file> <eta file> -> {session_id: verdict}: the one overdue rule, which
# write_state puts on each session as `overdue` and every reader takes (the shepherd's nudge, Home,
# the phone, agent-web). A plan's open phase is overdue once it has worked twice its fleet-bench estimate
# (`fleet-bench eta --json` lines: phase_min, phase_since_epoch) and at least FLEET_OVERDUE_MIN. Its age
# is work time, the running session's active_min, never wall clock: on the plan's own row, active_min
# now less phase_active_base (fleet-bench: active_min when the phase opened), and on a runner, whose
# session is the phase's, its whole active_min; capped at the wall-clock age. A phase paused overnight
# on the human or parked does not age (2026-11-06 dotfiles:6 read 437m for 7h of human wait, ar-528);
# with no base sampled yet there is no verdict. Not
# overdue: a finished plan; a phase whose queue item has not started (phase_queued: queued, held by an
# after: or at: gate, or a gated board row; ar-528), since nothing works it yet; a session in a landing
# wait (wait_min: on 2026-11-15 unity-core-playground-agent-3 sat 3.5h in the landing queue with #2726
# green and was nudged overdue, ar-2525). The verdict goes on the session running the phase
# (phase_runner), not on every session on the plan file (ar-1497); a runner with no row of its own
# leaves it on the plan row. One verdict a session, the longest open: {phase ("phase k/n"), name,
# age_min, expected_min, limit_min, escalate_min (how long a nudge waits before it goes to the human:
# a phase-length, at least the floor), basis, plan_target (the row whose plan it is)}.
overdue_of() {
  jq -cn --argjson now "$1" --argjson floor "$FLEET_OVERDUE_MIN" --slurpfile r "$2" --slurpfile e "$3" '
    ($r | map({key: .session_id, value: .}) | from_entries) as $rows
    | ($r | map(.target | split(":")[0])) as $live
    | [$e[] | objects
       | select((.finished | not) and .phase_min != null and .phase_since_epoch != null
                and $rows[.session_id] != null and .phases_done < .phases_total)
       | $rows[.session_id] as $o
       | select($o.wait_min == null and ($o.phase_queued | not))
       | ([2 * .phase_min, $floor] | max) as $limit | (($now - .phase_since_epoch) / 60 | floor) as $wall
       | select($wall >= $limit)
       | ($o.phase_runner // null) as $run
       | (if $run == null or $run == ($o.target | split(":")[0]) or ($live | index($run) | not) then $o
          else ($r | map(select((.target | split(":")[0]) == $run))[0]) end) as $at
       | select($at != null and $at.wait_min == null and $at.active_min != null)
       | (if $at == $o then .phase_active_base else 0 end) as $base
       | select($base != null)
       | ([[$at.active_min - $base, 0] | max, $wall] | min) as $age
       | select($age >= $limit)
       | {key: $at.session_id,
          value: {phase: "phase \(.phases_done + 1)/\(.phases_total)",
                  name: (if $at == $o then ($o.next_phase // "-")
                         else (([$o.phases[]? | select(.state == "open")][0].name) // $o.next_phase // "-") end),
                  age_min: $age, expected_min: .phase_min, limit_min: $limit,
                  escalate_min: ([.phase_min, $floor] | max), basis: (.basis // null), plan_target: $o.target}}]
    | group_by(.key) | map(max_by(.value.age_min)) | from_entries'
}

# write_state <started epoch> <rows>: print the rows as --json does, and replace the state
# document with them, each session carrying its eta cell (eta_cells, reused from tick's pass). The document is built beside the target and renamed into place, so a
# reader never sees half of one, and a pass that started before the one already written
# (a slow 10-minute pass finishing after an ask-event pass) leaves the newer document alone.
write_state() {
  local t="$1" rows="$2" json dir tmp asks prev stopped
  [ -f "$CACHE/eta" ] || eta_cells "$CACHE/eta.json" > "$CACHE/eta"
  json="$( [ -n "$rows" ] && json_rows <<<"$rows")"
  [ -n "$json" ] && printf '%s\n' "$json"
  dir="$(dirname "$STATE_FILE")"
  mkdir -p "$dir" || return 1
  asks="$(agent-ask list --all --pending 2>/dev/null)" || unreadable agent-ask
  # A hold that has stopped every dispatch pass (hub Home's Stopped row); rc 1 is "stopped", not a failure.
  stopped="$(fleet-dispatch stopped --json 2>/dev/null)"
  tmp="$(mktemp "$dir/.state.XXXXXX")" || return 1
  # The rows and asks go in by file: 77 sessions came to 136 KB, past the kernel's 128 KB cap on one argument.
  printf '%s' "$json" > "$CACHE/rows" && printf '%s' "$asks" > "$CACHE/asks" || return 1
  overdue_of "$t" "$CACHE/rows" "$CACHE/eta.json" > "$CACHE/overdue" || { unreadable "overdue verdicts"; echo '{}' > "$CACHE/overdue"; }
  if ! jq -n --argjson t "$t" --arg me "${FLEET_HOST:-}" --arg unread "$(sort -u "$CACHE/unreadable" 2>/dev/null)" --arg silent "$(sort -u "$CACHE/silent" 2>/dev/null)" \
       --arg order "$BUCKET_ORDER" --arg finished "$BUCKET_FINISHED" --arg progress "$BUCKET_IN_PROGRESS" \
       --rawfile asks "$CACHE/asks" --rawfile rows "$CACHE/rows" --arg stopped "$stopped" --rawfile eta "$CACHE/eta" --slurpfile od "$CACHE/overdue" '
      ($rows | split("\n") | map(select(length > 0) | fromjson)) as $r
      | ($eta | split("\n") | map(select(length > 0) | split("\t") | {key: .[0], value: {eta: .[1], at: (.[2] // "" | tonumber? // null)}})
         | from_entries) as $e
      | {schema: 2, generated_epoch: $t, generated_at: ($t | todate),
         # The machine that wrote this (fleet-hosts.sh FLEET_HOST): a row with no host runs here.
         host: (if $me == "" then null else $me end),
         vocab: {buckets: ($order | split(" ")), finished: ($finished | split(" ")), in_progress: ($progress | split(" "))},
         unreadable: ($unread | split("\n") | map(select(length > 0))),
         silent: ($silent | split("\n") | map(select(length > 0) | fromjson)),
         sessions: ($r | map(select(.bucket | IN("NIGHTLY", "CHECKOUT", "SHARED") | not)
                     | if $e[.session_id] then .eta = $e[.session_id].eta | .eta_epoch = $e[.session_id].at else . end
                     | .overdue = ($od[0][.session_id] // null))),
         main: ($r | map(select(.bucket | IN("NIGHTLY", "CHECKOUT"))
                     | {repo: .target, id: .session_id, reason, fact, nudged, escalated, owners})),
         shared: ($r | map(select(.bucket == "SHARED")
                     | {test: .target, id: .session_id, reason, fact, nudged, escalated, owners})),
         asks: [$asks | split("\n")[] | select(length > 0) | split("\t") | . as $c
                | {id: .[0], project: .[1], kind: .[4], question: (.[5] // "" | .[0:160]),
                   task: (if (.[7] // "") == "" then null else .[7] end), created: .[11],
                   session: (if (.[12] // "") == "" then null else .[12] end),
                   claude_session: (if (.[15] // "") == "" then null else .[15] end),
                   recommend: (if (.[10] // "") == "" then null else .[10] end),
                   judge: (if (.[16] // "") == "" then null else .[16] end)}
                  # audit_of is set only on an audit: the hub-core pager keeps those off the phone
                  | if ($c[32] // "") != "" then . + {audit_of: $c[32]} else . end],
         stopped: [$stopped | split("\n")[] | fromjson? | objects]}
      # Every bucket with its count, zeros included: a reader that keys on the buckets present
      # would keep the last non-zero count of a bucket after it empties (agent-mqtt-publish did).
      # The shepherd pass (label shepherd) is listed but not counted: it is not an agent session.
      | .counts = ((.sessions | map(select((.labels // []) | index("shepherd") | not) | .bucket)) as $b
          | (($order | split(" ")) + $b | unique)
          | map(. as $k | {key: $k, value: ($b | map(select(. == $k)) | length)}) | from_entries)' > "$tmp"; then
    rm -f "$tmp"; echo "fleet-sessions: could not build $STATE_FILE" >&2; return 1
  fi
  exec 8>"$dir/.lock"
  flock -w 30 8 || { rm -f "$tmp"; echo "fleet-sessions: $dir/.lock busy" >&2; return 1; }
  prev="$(jq -r '.generated_epoch // 0' "$STATE_FILE" 2>/dev/null)"
  if [ "${prev:-0}" -gt "$t" ] 2>/dev/null; then rm -f "$tmp"; return 0; fi
  mv -f "$tmp" "$STATE_FILE" || return 1
  # Only the fleet-lease holder publishes: a hand --write on another host, or a pass that outlived
  # its lease, would write the copy fleet-lease renew just removed there (ar-4375).
  if lease_held; then
    prom_textfile fleet_sessions.prom sessions_prom "$STATE_FILE" ||
      echo "fleet-sessions: could not write fleet_sessions.prom" >&2
  else
    echo "fleet-sessions: fleet_sessions.prom not published: this machine does not hold the fleet lease" >&2
  fi
  tmux_project "$STATE_FILE"
  worker_state_push "$STATE_FILE"
}

# sessions_prom <state document> -> the fleet_sessions.prom lines: one series per session per
# fact it has, labelled {target, project, bucket}, an info series joining each target to its
# session_id (the label claude_code_* metrics carry), bucket counts, and the open asks unless
# agent-ask could not be read. project is the row's own, from resolve_project_name.
sessions_prom() {
  jq -r "$PROM_JQ"'
    def per($name; $help; f): gauge($name; $help;
      .sessions | sort_by(.target)[] | select((.labels // []) | index("shepherd") | not)
      | [{target, project: (.project // ""), bucket}, f]);
    per("agent_session_context_tokens"; "Context tokens the session holds."; .context_tokens),
    per("agent_session_idle_minutes"; "Minutes since the session went idle, by agent-panel."; .idle_min),
    per("agent_session_age_minutes"; "Minutes since the session started."; .age_min),
    per("agent_session_phases_done"; "Phases ticked in the plan checklist of the session."; .phases_done),
    per("agent_session_phases_total"; "Phases in the plan checklist of the session."; .phases_total),
    per("agent_session_behind"; "Commits the branch of the session is behind its base."; .behind),
    per("agent_session_dirty"; "Uncommitted files in the worktree of the session."; .dirty),
    gauge("agent_session_info"; "Joins a session target to its Claude Code session_id; always 1.";
      .sessions | sort_by(.target)[] | select((.session_id // "") != "")
      | [{target, project: (.project // ""), session_id}, 1]),
    gauge("agent_sessions"; "Live sessions per fleet-sessions bucket.";
      .counts | to_entries[] | [{bucket: .key}, .value]),
    gauge("agent_session_bucket"; "Place of a bucket in the order that needs the human first (0 is first), with its finished and in-progress flags.";
      .vocab as $v | $v.buckets | to_entries[] | .value as $b
      | [{bucket: $b, finished: (if ($v.finished | index($b)) then "1" else "0" end),
          in_progress: (if ($v.in_progress | index($b)) then "1" else "0" end)}, .key]),
    gauge("agent_sessions_unlinked"; "Live sessions with no agent-queue item, by the item_of join.";
      [{}, ([.sessions[] | select((.labels // []) | index("shepherd") | not)
             | select(.bucket != "NIGHTLY" and .bucket != "SHARED" and .item == null)] | length)]),
    gauge("agent_asks_open"; "Pending asks waiting on the human.";
      if (.unreadable | index("agent-ask")) then empty else [{}, (.asks | length)] end)' "$1"
}

# list_view: the bare table (a row per session, grouped by bucket) from the state document, the one
# every view reads, so it costs no pass. On a worker the document is the lease holder's push, this
# host's sessions only. Its age is the first line; one older than FLEET_STATE_STALE_SECS, or none, exits 1
# naming --fresh (a full pass) and the timer, and never runs a pass of its own.
list_view() {
  local f=$STATE_FILE where="" epoch age
  local fix="run \`fleet-sessions --fresh\` or check fleet-state.timer"
  if on_worker; then
    # A worker runs no timer, and its own pass is blind (on_worker): only the lease holder's push helps.
    f="$(holder_state_file)"; where=" (the lease holder's rows for this host only)"
    fix="the lease holder pushes this host's rows each minute: ask again shortly, or check fleet-state.timer on the lease holder"
  fi
  [ -r "$f" ] || { echo "fleet-sessions: no state document at $f: $fix" >&2; return 1; }
  epoch="$(jq -r '.generated_epoch // empty' "$f" 2>/dev/null)"
  [[ "$epoch" =~ ^[0-9]+$ ]] || { echo "fleet-sessions: $f is not a state document: $fix" >&2; return 1; }
  age=$(( $(date +%s) - epoch ))
  if [ "$age" -gt "$(state_stale_secs)" ]; then
    echo "fleet-sessions: the state document $f is $((age / 60))m old: $fix" >&2
    return 1
  fi
  echo "state document $((age / 60))m old$where; \`fleet-sessions --fresh\` runs a full pass"
  # Fields join on the unit separator, not @tsv, which would double a backslash in a reason. A row's
  # target sorts as the full pass sorts it (server prefix first) and prints without that prefix.
  jq -r '(.vocab.buckets // ["NEEDS", "STALLED", "DONE", "LANDED", "CHAT", "WORKING", "PARKED"]) as $order
    | def s: if . == null then "" else tostring | gsub("[\t\n\u001f]"; " ") end;
    [(.main // [] | .[] | [((.fact // "NIGHTLY") | split(" ")[0]), .repo, "-", "-", 0, .reason, .nudged, "-", "-"]),
       (.shared // [] | .[] | ["SHARED", .test, "-", "-", 0, .reason, .nudged, "-", "-"]),
       (.sessions[] | [.bucket, .target, .branch, .pr, (.idle_min // 0), .reason, .nudged,
                       (.dispatch // "-"), ((.labels // []) | if length == 0 then "-" else join(",") end)])]
    | . as $rows
    | (["NIGHTLY", "CHECKOUT", "SHARED"] + $order)[] as $b
    | ($rows | map(select(.[0] == $b)) | sort_by(.[1])) as $g
    | select($g | length > 0)
    | "H\u001f\($b)", ($g[] | "R\u001f" + (.[1:] | .[0] |= sub("^[^/]*/"; "") | map(s) | join("\u001f")))' "$f" \
    | awk -F'\037' '$1 == "H" { print $2; next }
        { printf "  %-44s %-28s %-6s %4sm  %s%s%s%s\n", $2, $3, $4, $5, $6, ($7 == "true" ? "  (nudged)" : ""),
            ($8 != "-" ? "  [dispatch: " $8 "]" : ""), ($9 != "-" ? "  [labels: " $9 "]" : "") }'
}

# holds: the sibling fleet-shepherd's lease check, by path, so a test runs this checkout's.
holds() { "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/fleet-shepherd" holds; }

# lease_held: this machine holds the fleet lease, as it last read it (no network).
lease_held() { "${FLEET_LEASE:-fleet-lease}" held >/dev/null 2>&1; }

main() {
  case "${1:-}" in
    # A ledger write is the shepherd acting: only the pass holding its lease may (fleet-shepherd holds).
    mark) holds || return; shift; mark "$@"; return ;;
    escalate) holds || return; shift; escalate "$@"; return ;;
    label) shift; label "$@"; return ;;
    # The unit's ExecCondition gates the scheduled tick; this gates a hand run. The ledger is the
    # fleet's one copy (shepherd/ in the ~/.agent store) and fleet_sessions.prom a singleton: a hand
    # tick on razer-laptop wrote its rows over the holder's watch.state, logged every fleet-home
    # session gone, and the store merge stuck on it (2026-11-21, ar-3439).
    tick)
      lease_held ||
        { echo "fleet-sessions: tick skipped: this machine does not hold the fleet lease (fleet-lease status)" >&2; return 0; }
      tick; return ;;
    explain) shift; explain "$@"; return ;;
    stages) shift; python3 "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/fleet-stages.py" --log "$LEDGER/watch.log" --state "$STATE_FILE" "$@"; return ;;
    close)
      if [ "${2:-}" = --self ]; then
        CLOSE_SELF="$(resolve_sid "${3:-self}")" || return 2
        if on_worker; then close_self_held; return; fi
      else shift; close_view "$@"; return; fi ;;
    "") list_view; return ;;
    -h|--help) sed -n '2,/^# Buckets:/{/^# Buckets:/!p}' "$0"; return ;;
  esac
  local rows t0
  [ "${1:-}" != --fresh ] || shift
  t0="$(date +%s)"
  pass; rows="$PASS_ROWS"
  case "${1:-}" in
    --json) [ -n "$rows" ] && json_rows <<<"$rows"; return 0 ;;
    --write) write_state "$t0" "$rows"; return ;;
    close) close_self "$rows"; return ;;
  esac
  local b
  for b in NIGHTLY CHECKOUT SHARED $BUCKET_ORDER; do
    awk -F'\t' -v b="$b" '$1 == b' <<<"$rows" | sort -t$'\t' -k2 | {
      first=1
      while IFS=$'\t' read -r _ target _ _ branch pr idle _ _ n reason _ _ _ dsp _ _ _ _ _ _ _ _ _ _ lbl _; do
        [ "$first" = 1 ] && { echo "$b"; first=0; }
        printf '  %-44s %-28s %-6s %4sm  %s%s%s%s\n' "${target#*/}" "$branch" "$pr" "$idle" "$reason" \
          "$([ "$n" = 1 ] && echo '  (nudged)')" "$([ "${dsp:--}" != - ] && echo "  [dispatch: $dsp]")" \
          "$([ "${lbl:--}" != - ] && echo "  [labels: $lbl]")"
      done
    }
  done
}

# Sourceable for tests (session_bucket, main_state, nudged, mark, escalate); runs main only when executed.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
