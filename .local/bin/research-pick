#!/usr/bin/env bash
# research-pick: the nightly research stage, called from agentctl-dream. No model.
#
#   research-pick run [--dry-run]   queue tonight's research item and at most one coverage row
#   research-pick rank              the ranking, one facet per line, nothing written
#
# The roster (RESEARCH_FACETS, JSON) lists the facets of the stack worth a deep look: a repo,
# the paths inside it, the lenses to use and the board its findings go to. Each night the
# stalest facet, weighted by recent churn, becomes one agent-queue add (`from: research:<id>`)
# that runs `/rigor /stack-review research`. A script may not queue (QUEUE.md "Admission"), so the
# add files a board row that fleet-dispatch promotes and starts when an account has room. While a
# research item is still queued, running or waiting, or a picked row has started on its board, nothing
# new is filed. A picked row still open holds only its own facet, and the next stalest facet is filed
# behind it (ar-4979): one row a night, at most one open row per facet, so the roster's size bounds how
# many dispatch can start together. The roster grows by rows: a project-map project that no facet
# covers and the roster does not exclude gets one "add a facet" row on the agent-runtime board, for the
# human to accept or exclude. A full board does not hold it.
#
# picks.jsonl under RESEARCH_DIR is the record of what was picked, when, and the board row it went
# to; this is its only writer.
set -uo pipefail

# shellcheck source=../../.config/shared-hooks/project-name.sh
. "${PROJECT_NAME_LIB:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../../.config/shared-hooks/project-name.sh}"

: "${RESEARCH_FACETS:=$HOME/.config/agentctl/research-facets.json}"
: "${RESEARCH_DIR:=$HOME/.agent/research}"
: "${RESEARCH_MAP:=$(project_map_file)}"
: "${RESEARCH_NEVER_DAYS:=60}"   # the staleness of a facet never picked
: "${RESEARCH_CHURN_DAYS:=14}"   # the window recent commits are counted over

DRY=0
PICKS="$RESEARCH_DIR/picks.jsonl"

say() { printf 'research-pick: %s\n' "$*" >&2; }
expand() { local p="$1"; printf '%s' "${p/#\~/$HOME}"; }

# in_flight: "<slug> <from>" for each research item still queued, running or waiting, and for each
# picked board row dispatch has started (doing, under the item it promoted it to, whose slug and from
# are the row's, not research-<id>); those hold the lane. A picked row still open is only filed, so
# it prints "open<TAB><facet>" and holds that facet alone (ar-4979: ar-4274, open from 11-21, held
# every facet for days). rc 1 when the queue, the board while a pick has a row, or the picks record
# (a line jq cannot read, a picked row with no facet) cannot be read, which queues nothing: an unknown
# queue might already hold one.
in_flight() {
  local out rows
  out=$(agent-queue list --json --state active 2>/dev/null) || return 1
  jq -r 'select((.from // "") | startswith("research:")) | "\(.slug) \(.from)"' <<<"$out"
  [ -f "$PICKS" ] || return 0
  rows=$(jq -c -n '[inputs | select(.row // "" | contains(":")) | if .facet == null then error("a row with no facet") else {(.row): .facet} end] | add // {}' "$PICKS" 2>/dev/null) || return 1
  [ "$rows" != '{}' ] || return 0
  out=$(notes board --json 2>/dev/null) && [ -n "$out" ] || return 1
  jq -r --argjson want "$rows" '.rows[]? | ("\(.project):\(.id)") as $r | select($want | has($r))
    | if .state == "open" then "open\t\($want[$r])" else "\(.id) board row on \(.project), \(.state)" end' <<<"$out"
}

# last_pick <facet>: the epoch day it was last filed, or empty.
last_pick() {
  [ -f "$PICKS" ] || return 0
  jq -r --arg f "$1" 'select(.facet == $f) | .day' "$PICKS" 2>/dev/null | sort -n | tail -n 1
}

# churn <repo> <paths...>: commits touching the paths over the churn window.
churn() {
  local repo="$1"; shift
  git -C "$repo" rev-list --count --since="$RESEARCH_CHURN_DAYS days ago" HEAD -- "$@" 2>/dev/null || echo 0
}

# weight <commits>: 1 + the commit count's bit length, so churn raises a facet on a log scale
# (1054 commits weighs 12, 15 weighs 5) and one busy repo cannot starve the rest.
weight() { local n="$1" w=1; while [ "$n" -gt 0 ]; do w=$((w + 1)); n=$((n / 2)); done; echo "$w"; }

# rank: "<score>\t<id>\t<stale days>\t<churn>" per facet, best first. score is
# staleness * weight(churn), so an untouched facet still rises with age and a busy one rises faster.
rank() {
  local today id repo stale c last paths
  today=$(( $(date +%s) / 86400 ))
  while IFS=$'\t' read -r id repo; do
    repo="$(expand "$repo")"
    if [ ! -d "$repo" ]; then say "$id: no repo at $repo, skipped"; continue; fi
    mapfile -t paths < <(jq -r --arg f "$id" '.facets[] | select(.id == $f) | .paths[]?' "$RESEARCH_FACETS")
    [ "${#paths[@]}" -gt 0 ] || paths=(.)
    last="$(last_pick "$id")"
    if [ -n "$last" ]; then stale=$(( today - last )); else stale=$RESEARCH_NEVER_DAYS; fi
    c="$(churn "$repo" "${paths[@]}")"
    printf '%s\t%s\t%s\t%s\n' "$(( stale * $(weight "$c") ))" "$id" "$stale" "$c"
  done < <(jq -r '.facets[] | [.id, .repo] | @tsv' "$RESEARCH_FACETS") | sort -t$'\t' -k1,1nr -k2,2
}

# task_text <id>: the research item's task; stack-review's `research` verb reads it.
task_text() {
  jq -r --arg f "$1" '.facets[] | select(.id == $f) |
    "/rigor /stack-review research \(.repo)\(if (.paths // []) == [] then "" else " " + (.paths | join(" ")) end), lenses: \((.lenses // ["all"]) | join(", ")); findings on the \(.board) agent board tagged #research/\(.id)"' "$RESEARCH_FACETS"
}

# item_project <id>: the project-map name of the facet's repo, so the session's worktree is cut
# there; the facet's board when the map has no exact entry.
item_project() {
  local repo board name
  IFS=$'\t' read -r repo board < <(jq -r --arg f "$1" '.facets[] | select(.id == $f) | [.repo, .board] | @tsv' "$RESEARCH_FACETS")
  name=$(jq -r --arg p "$(expand "$repo")" '.paths[$p] // empty' "$RESEARCH_MAP" 2>/dev/null)
  printf '%s' "${name:-$board}"
}

# queue <id>: queue the facet's research item as research-<id> (a slug cut from the task text is
# the same 40 characters for every facet in one checkout). 0 when queued, or when the board took it
# (exit 5, QUEUE.md "Admission"): ROW is then its `<board>:<id>` from the `held` line, which
# in_flight watches (open, it holds this facet; started, the lane), because the item dispatch promotes it to carries the row's slug; or `-` when
# the add printed no row (the outbox took it, and inbox-triage files it). --repeat: a facet picked
# again reuses its slug, whose last item finished ok; this pick is new work under it.
# The row is research-pick's own, not a follow-up for the outbox: the add runs as
# AGENTCTL_NAME=research-pick with no session or item, a name on notes' agent_direct_filers (under
# dream it read as dream, whose rows inbox-triage filed #low). Tagged `interrupt`, the row carries
# #interrupt, so a locked sprint keeps it off tier:backlog, which dispatch never starts; cmd_run picks
# one a night and none while one is in flight (in_flight), which bounds what that lane takes; a filed
# row not yet started holds only its own facet, so the next one is picked behind it.
queue() {
  local project task out rc=0 tags="research interrupt"
  ROW=''
  project=$(item_project "$1"); task=$(task_text "$1")
  if [ "$DRY" = 1 ]; then printf 'would queue [%s] --tags "%s" %s\n' "$project" "$tags" "$task"; return 0; fi
  out=$(AGENTCTL_NAME=research-pick AGENT_QUEUE_ITEM='' CLAUDE_CODE_SESSION_ID='' agent-queue add --project "$project" \
    --from "research:$1" --tags "$tags" --repeat --slug "research-$1" --title "research($1)" -- "$task" 2>&1) || rc=$?
  case $rc in
    0) return 0 ;;
    5) ROW=$(sed -n '/^held [^ ]* -> \([^ ]*:[^ ]*\).*/{s//\1/p;q;}' <<<"$out")
       ROW="${ROW:--}"
       return 0 ;;
  esac
  say "$1: nothing queued, agent-queue add failed: $(tail -n 1 <<<"$out")"
  return 1
}

# add <board> <text>: file one row. The exit of notes: 0 filed, 3 an open twin, else failed.
add() {
  if [ "$DRY" = 1 ]; then printf 'would file [%s] %s\n' "$1" "$2"; return 0; fi
  notes ptask "$1" --agent add "$2" --origin research-pick >/dev/null 2>&1
}

# roster_open: 0 when a roster row is open on the agent-runtime board, 1 when none is, 2 when the
# board cannot be read. The board rewrites the row's scope to its area (research(roster): lists as
# research(notes):) and cleanup rewords it, so a row is a research(<scope>): row that names
# research-facets.json, not one with our exact text. The list is read whole first: a reader that stops at
# the first hit (grep -q) leaves the writer an EPIPE, which pipefail turns into "none open".
roster_open() {
  local rows
  rows=$(notes ptask agent-runtime --agent list 2>/dev/null) || return 2
  awk -F'\t' '$4 ~ /research\([^)]*\): add a .*facet.*research-facets\.json/ { hit = 1 } END { exit !hit }' <<<"$rows"
}

# uncovered: project-map projects on disk that no facet's repo lies in or under and the roster
# does not exclude, one name a line.
uncovered() {
  local path name hit repo
  local -a repos
  mapfile -t repos < <(jq -r '.facets[].repo' "$RESEARCH_FACETS")
  while IFS=$'\t' read -r path name; do
    [ -d "$path" ] || continue
    jq -e --arg n "$name" '(.exclude // []) | index($n)' "$RESEARCH_FACETS" >/dev/null && continue
    hit=0
    for repo in "${repos[@]}"; do
      repo="$(expand "$repo")"
      case "$repo/" in "$path"/*) hit=1; break ;; esac
    done
    [ "$hit" = 1 ] || printf '%s\t%s\n' "$name" "$path"
  done < <(jq -r '.paths | to_entries[] | [.key, .value] | @tsv' "$RESEARCH_MAP")
}

cmd_rank() {
  printf 'score\tfacet\tstale\tchurn\n'
  rank
}

cmd_run() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY=1 ;;
      *) say "unknown flag $1"; return 2 ;;
    esac
    shift
  done
  [ -f "$RESEARCH_FACETS" ] || { say "no roster at $RESEARCH_FACETS, nothing to pick"; return 0; }
  jq -e '.facets | type == "array"' "$RESEARCH_FACETS" >/dev/null 2>&1 \
    || { say "roster $RESEARCH_FACETS is not {facets: [...]}"; return 1; }
  mkdir -p "$RESEARCH_DIR"
  local flight busy held ranked score id stale c today
  today=$(( $(date +%s) / 86400 ))
  if ! flight=$(in_flight); then
    say "the queue, the board holding the last pick's row, or $PICKS could not be read, nothing queued"
  elif busy=$(awk -F'\t' '$1 != "open"' <<<"$flight"); [ -n "$busy" ]; then
    say "research item still in flight, nothing queued: $(head -n 1 <<<"$busy")"
  else
    held=$(awk -F'\t' '$1 == "open" { print $2 }' <<<"$flight")
    ranked=$(rank)
    IFS=$'\t' read -r score id stale c < <(awk -F'\t' 'NR == FNR { skip[$0] = 1; next } !($2 in skip)' <(printf '%s\n' "$held") - <<<"$ranked")
    if [ -z "${id:-}" ] && [ -n "$ranked" ]; then
      say "no facet to queue: each one on disk has a picked row still open on its board ($(paste -sd' ' <<<"$held"))"
    elif [ -z "${id:-}" ]; then
      say "no facet to queue: the roster lists none on disk"
    elif queue "$id"; then
      case "$ROW" in
        '') say "queued $id (score $score: ${stale}d stale, $c commits)" ;;
        -) say "$id: filed through the outbox, nothing queued and no row to watch: inbox-triage files it" ;;
        *) say "$id: filed on its board as $ROW, nothing queued: only the board fills the queue, and dispatch pulls it under the cap" ;;
      esac
      [ "$DRY" = 1 ] || jq -cn --arg f "$id" --argjson d "$today" --arg r "$ROW" \
        '{facet: $f, day: $d, date: (now | strftime("%Y-%m-%d"))} + (if ($r | contains(":")) then {row: $r} else {} end)' >> "$PICKS"
    fi
  fi

  # One coverage row a night, the first uncovered project, unless one is already open.
  local gap name path rc
  gap="$(uncovered)"
  [ -n "$gap" ] || return 0
  IFS=$'\t' read -r name path <<<"${gap%%$'\n'*}"
  roster_open; rc=$?
  case $rc in
    0) say "coverage: $name uncovered, a roster row is already open"; return 0 ;;
    2) say "coverage: $name uncovered, the board could not be read, nothing filed"; return 0 ;;
  esac
  add agent-runtime "research(roster): add a facet for $name ($path) to research-facets.json, or list it under exclude #research #size/s"
  rc=$?
  case $rc in
    0) if [ "$DRY" = 1 ]; then say "coverage: would file a roster row for $name"; else say "coverage: filed a roster row for $name"; fi ;;
    3) say "coverage: $name uncovered, a roster row is already open" ;;
    *) say "coverage: $name uncovered, notes ptask add failed (exit $rc)" ;;
  esac
  return 0
}

case "${1:-}" in
  run) shift; cmd_run "$@" ;;
  rank) cmd_rank ;;
  *) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
