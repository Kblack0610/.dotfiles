#!/usr/bin/env bash
# credit-backfill - credit past work to the project and the feature it built: one proposal per
# repo for the human to review, then the reviewed lines written through the existing writers.
#
#   propose <project>   write $CREDIT_BACKFILL_DIR/<project>.tsv and print its counts
#   apply <project>     write every line of that file not yet applied; a rerun skips applied lines
#   redate propose <project>             write $CREDIT_BACKFILL_DIR/<project>.redate.tsv: the `done:` day each
#                                        applied closed row should carry (its PR's merge day, an epic's last story's)
#   redate apply <project> <registry>    write the reviewed lines of one registry project; a rerun skips applied ones
#
# <project> is a repo (unity-core-playground, dotfiles); the proposal covers every registry project
# sharing its checkout. Lines are TSV `kind key project system size state proof item text id`:
# attr (an item its PR credits elsewhere), epic (a plan of 2+ phases, or a system's FAIL criteria)
# and story (a phase, a criterion, a done item with no row). The human edits or deletes lines; apply
# writes each id it gets into the last column. A closed story with a PR carries its merge day (`ptask done --on`), an epic
# its last story's, so the pace counts date the work when it landed, not the day apply ran. Plan: why-is-so-litel-stateless-puppy.md, P4.
set -uo pipefail

CB_DIR="${CREDIT_BACKFILL_DIR:-$HOME/.agent/backfill}"
SCHEDULES_SYNC="${SCHEDULES_SYNC:-schedules-sync}"
CB_PLANS="${CREDIT_BACKFILL_PLANS:-$HOME/.agent/plans}"
CB_LIVE_PLANS="${CREDIT_BACKFILL_LIVE_PLANS:-$HOME/.claude/plans}"
HERE="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
SYSTEMS_MD="${CREDIT_BACKFILL_SYSTEMS:-$HERE/../src/docs/systems.md}"
SYSTEM_CHECK="${CREDIT_BACKFILL_SYSTEM_CHECK:-$HERE/project-system-check}"
# A story's size from its PR's diff (additions plus deletions): up to S_MAX is s, up to M_MAX m, else l.
S_MAX=150 M_MAX=800
# A plan's open phase is filed when an item is on it or the plan changed in the last FRESH_DAYS:
# an open story is dispatch-eligible, and a stale plan's leftovers are not work anyone asked for.
FRESH_DAYS="${CREDIT_BACKFILL_FRESH_DAYS:-7}"
# The default words that name a system in a plan's title, first match wins; the human reviews every guess.
SYSTEM_WORDS='ui	menu|menus|title|hud|screen|ui|panel|lobby screen
netcode	multiplayer|online|netcode|lobby|server|join|relay|matchmaking
save	save|saves|persist|persistence|locker|account
input	input|controller|gamepad|rebind|bindings|keyboard
audio	audio|music|sound|sfx
perf	perf|lag|fps|hitch|hitches|frame time|memory
look	look|art|style|lighting|shader|vfx|palette
onboarding	tutorial|onboarding|first-run|first run
store	store|steam|listing|rating|testflight|play console
ci	ci|gate|nightly|runner|runners|pipeline
tests	test|tests|playtest
deploy	deploy|release|rollout
docs	doc|docs|readme
telemetry	telemetry|crash|crashes|sentry|logs
security	secret|secrets|security|auth'

die() { echo "credit-backfill: $*" >&2; exit 1; }
# shellcheck source=../../.config/shared-hooks/project-name.sh
. "${PROJECT_NAME_LIB:-$HERE/../../.config/shared-hooks/project-name.sh}"
AQ_MAP="${AGENT_QUEUE_PROJECT_MAP:-$(project_map_file)}"
PROJECT_MAP_FILE="$AQ_MAP"
# shellcheck source=../lib/plan-phases.sh
. "${PLAN_PHASES_LIB:-$HERE/../lib/plan-phases.sh}"

# family <project> -> every registry project sharing its checkout, and the repo's owner.
family() { local r; r="$(project_repo_name "$1")"; { project_field "$r" owner; project_lab_names "$r"; } | sort -u; }

# shellcheck source=../lib/origin-repo.sh
. "$HERE/../lib/origin-repo.sh"
# gh_slug <project> -> owner/repo of the project's checkout's origin (origin_repo), or nothing.
gh_slug() { origin_repo "$(project_repo_path "$1")"; }

# store_load <project> <owner/repo> -> the repo's merged PRs from the PR store (`schedules-sync prs`), read
# once per run into CB_PRS (number, merge sha, merged at), and its checkout into CB_GIT; dies when the
# store cannot answer (stale, or the repo not in its list), since every size and day would read as unknown.
CB_PRS="" CB_GIT=""
store_load() {
  local json key="$2" host
  CB_GIT="$(project_repo_path "$1")" host="$(origin_host "$(project_repo_path "$1")")"
  [ -z "$host" ] || [ "$host" = github.com ] || key="$host/$2"   # the store keys a Forgejo repo by its host
  json="$("$SCHEDULES_SYNC" prs "$key" --state merged 2>/dev/null)" ||
    die "PR store: $("$SCHEDULES_SYNC" prs "$key" --state merged 2>&1 >/dev/null)"
  CB_PRS="$(jq -r '.[] | [.number, .merge_sha // "", .merged_at // ""] | @tsv' <<<"$json")" || die "PR store: unreadable rows for $key"
}
# pr_field <N> <2=merge sha|3=merged at> -> that field of merged PR N, or nothing.
pr_field() { awk -F'\t' -v n="$1" -v f="$2" '$1 == n { print $f; exit }' <<<"$CB_PRS"; }

# pr_facts <owner/repo> <N> -> one JSON line {files, size}; nothing when the store has no merge commit
# for it, the checkout lacks that commit, or it changed no file. Both are the merge commit's diff
# against its first parent in the checkout (a squash holds the whole PR; a merge commit's first
# parent is the base): a local read, so no gh call and nothing to cache.
pr_facts() {
  local sha; sha="$(pr_field "$2" 2)"; [ -n "$sha" ] || return 0
  git -C "$CB_GIT" cat-file -e "$sha^{commit}" 2>/dev/null ||
    { echo "credit-backfill: $CB_GIT lacks #$2's merge commit ${sha:0:12}, so it is sized m: fetch it" >&2; return 0; }
  git -C "$CB_GIT" diff --numstat --no-renames "$sha^1" "$sha" 2>/dev/null |
    jq -cRn --argjson s "$S_MAX" --argjson m "$M_MAX" '[inputs | split("\t") | select(length == 3)] | select(length > 0)
      | (map((.[0] | tonumber? // 0) + (.[1] | tonumber? // 0)) | add) as $n
      | {files: map(.[2]), size: (if $n <= $s then "s" elif $n <= $m then "m" else "l" end)}'
}

# credit <project> <owner/repo> <N>... -> the project the PRs' changed files credit, or nothing.
credit() {
  local p="$1" slug="$2" n; shift 2
  for n in "$@"; do pr_facts "$slug" "$n" | jq -r '.files[]'; done |
    agent-queue credit-of "$p" | cut -f1
}

# phase_prs <phase text> -> its bare `#N` refs (a PR of the plan's own repo), one a line. A ref
# after a repo name (`unity-core #836`, `platform #1476`) is another repo's and is left out.
phase_prs() { grep -oE '(^|[(,;] *|and )#[0-9]+' <<<"$1" | grep -oE '[0-9]+$'; }

# words <text> -> the row's words: no markup or #tags, one line.
words() { sed -E 's/`|\*\*//g; s/<!--[^>]*-->//g; s/(^| )#[A-Za-z][A-Za-z0-9_/:.-]*//g; s/\t/ /g; s/ +/ /g; s/^ //; s/ $//' <<<"$1"; }

# guess_system <type> <title> -> a systems.md id applying to <type>, from SYSTEM_WORDS.
guess_system() {
  local type="$1" title sys pat
  title="$(tr '[:upper:]' '[:lower:]' <<<"$2")"
  while IFS=$'\t' read -r sys pat; do
    applies "$sys" "$type" || continue
    grep -qwE "$pat" <<<"$title" && { echo "$sys"; return 0; }
  done <<<"$SYSTEM_WORDS"
  if [ "$type" = game ]; then echo gameplay; else echo '?'; fi
}

# applies <system> <type> -- the systems.md Systems row for <system> applies to <type> (or base).
# A backfill knows only the type, so a `store` cell counts for a game or an app.
applies() {
  awk -F'|' -v s="$1" -v t="$2" '
    /^## Systems/ { on = 1; next } /^## / { on = 0 }
    on && NF > 3 { id = $2; gsub(/ /, "", id); if (id != s) next
      n = split($3, a, ","); for (i = 1; i <= n; i++) { gsub(/ /, "", a[i]); if (a[i] == "base" || a[i] == t || (a[i] == "store" && (t == "game" || t == "app"))) ok = 1 } }
    END { exit !ok }' "$SYSTEMS_MD"
}

# typed <text> <area> <type> -> the text as a board row's `type(area): title`; one that already has
# a type notes knows keeps it (`notes row parse` says whether the text parses); any other gets the prefix.
typed() {
  local ok
  ok="$(printf '%s\n' "$1" | notes row parse | cut -f4)" && [ -n "$ok" ] || die "notes row parse failed (an old notes? notes-bootstrap --build-only)"
  if [ "$ok" = 1 ]; then echo "$1"; else echo "$3($2): $1"; fi
}

row() { printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t\n' "$@"; }

cmd_propose() {
  [ $# -eq 1 ] || die "usage: credit-backfill propose <project>"
  [ -f "$AQ_MAP" ] || die "no registry at $AQ_MAP"
  local top="$1" slug dflt fam items out
  [ -n "$(project_repo_path "$top")" ] || die "unknown project: $top (no checkout for it in $AQ_MAP)"
  slug="$(gh_slug "$top")"; [ -n "$slug" ] || die "$top: its checkout has no origin remote"
  store_load "$top" "$slug"
  dflt="$(project_field "$top" owner)"; dflt="${dflt:-$top}"
  mapfile -t fam < <(family "$top")
  items="$(agent-queue list --json --state all --since 2000-01-01 2>/dev/null |
    jq -sc --args '[.[] | select(.project as $p | $ARGS.positional | index($p))]' "${fam[@]}")"
  out="$CB_DIR/$top.tsv"
  mkdir -p "$CB_DIR"
  {
    printf '# credit-backfill proposal for %s, %s. Delete or edit lines, then: credit-backfill apply %s\n' "$top" "$(date +%F)" "$top"
    printf '# kind\tkey\tproject\tsystem\tsize\tstate\tproof\titem\ttext\tid\n'
    propose_items "$slug" "$items"
    propose_plans "$top" "$slug" "$dflt" "$items" "${fam[@]}"
    propose_criteria "${fam[@]}"
  } >"$out.new" && mv "$out.new" "$out"
  echo "$out: $(awk -F'\t' '!/^#/ { n[$1]++ } END { printf "%d attr, %d epic, %d story", n["attr"], n["epic"], n["story"] }' "$out")"
}

# pr_num <pr field> -> the PR number when the item's PR is in <owner/repo> (or bare), else nothing.
pr_num() { sed -nE "s#^(${2//\//\\/}\#|\#)?([0-9]+)\$#\2#p" <<<"$1"; }

# The items: a credit move for each whose PR names another project, and a closed story for each
# done one with a PR and no row whose plan is not backfilled as an epic here (propose_plans files those).
propose_items() {
  local slug="$1" s p pr plan merged title n win w touches facts size epic to pf
  while IFS=$'\t' read -r s p pr plan merged title; do
    n="$(pr_num "$pr" "$slug")"; [ -n "$n" ] || continue
    [ "$merged" = - ] && merged=""
    facts="$(pr_facts "$slug" "$n")" to="$p" size=m
    if [ -n "$facts" ]; then
      size="$(jq -r .size <<<"$facts")"
      win="$(jq -r '.files[]' <<<"$facts" | agent-queue credit-of "$p")"
      IFS=$'\t' read -r w touches <<<"$win"
      if [ -n "$w" ] && [ "$w" != "$p" ]; then
        to="$w"
        row attr - "$to" - - - "touches:$touches" "$s" "from $p"
      fi
    fi
    epic=""
    if [ "$plan" != - ]; then
      pf="$(plan_file "$plan")" epic="$(plan_epic "$pf")"
      [ -n "$epic" ] || [ "$(plan_phase_list "$pf" | jq length)" -lt 2 ] || continue
    fi
    row story "${epic:--}" "$to" - "$size" done "pr:$n${merged:+ commit:${merged:0:12}}" "$s" "$(words "$title")"
  done < <(jq -r '.[] | select(.state == "done" and .status == "ok" and (.pr // "") != "" and (.row // "") == "")
      | .pr |= (tostring | split(" ")[0]) | .merged |= (. // "" | tostring | split(" ")[0])
      | [.slug, .project, .pr, .plan, .merged, (.title // .task // .slug | split("\n")[0])] | map(. // "" | if . == "" then "-" else . end) | @tsv' <<<"$2")
}

# plan_file <path or name> -> the plan as the backfill reads it: the live ~/.claude copy when it
# exists (agent-land ticks that one), else the ~/.agent/plans cache.
plan_file() {
  local b="${1##*/}"
  if [ -f "$CB_LIVE_PLANS/$b" ]; then echo "$CB_LIVE_PLANS/$b"; else echo "$1"; fi
}

propose_plans() {
  local top="$1" slug="$2" dflt="$3" items="$4" m f pf base phases title prj type sys i st name n prs it its size proof text fresh left stories i_slug i_state i_pr i_merged
  shift 4
  for m in "$@"; do
    for f in "$CB_PLANS/$m"/*.md; do
      [ -f "$f" ] || continue
      pf="$(plan_file "$f")" base="$(basename "$f" .md)"
      [ -z "$(plan_epic "$pf")" ] || continue
      phases="$(plan_phase_list "$pf")"
      [ "$(jq length <<<"$phases")" -ge 2 ] || continue
      its="$(jq -c --arg b "$base.md" '[.[] | select(((.plan // "") | split("/") | last) == $b)]' <<<"$items")"
      mapfile -t prs < <(
        jq -r '.[].name' <<<"$phases" | while IFS= read -r name; do phase_prs "$name"; done
        jq -r '.[].pr // empty | tostring | split(" ")[]' <<<"$its" | while IFS= read -r i; do pr_num "$i" "$slug"; done)
      prj="$( ((${#prs[@]})) && credit "$m" "$slug" "${prs[@]}")"
      prj="${prj:-$( [ "$m" = "$top" ] && echo "$dflt" || echo "$m")}"
      type="$(project_field "$prj" type)"
      title="$(sed -nE '0,/^# /s/^# +//p' "$pf")"; title="$(words "${title:-$base}")"
      sys="$(guess_system "${type:-infra}" "$title")"
      fresh=0; [ -n "$(find "$pf" -mtime -"$FRESH_DAYS" 2>/dev/null)" ] && fresh=1
      i=0 left=0 stories=""
      while IFS=$'\t' read -r st name; do
        i=$((i + 1))
        it="$(jq -r --arg n "$i" '[.[] | select((.phases // "" | split(" ")) | index($n))]
          | (map(select(.state == "done" and .status == "ok")) + map(select(.state != "done"))) | first
          | select(.) | [.slug, .state, (.pr // "" | tostring | split(" ")[0]), (.merged // "" | tostring | split(" ")[0])] | map(. // "" | if . == "" then "-" else . end) | @tsv' <<<"$its")"
        [ -n "$it" ] || it=$'-\t-\t-\t-'
        IFS=$'\t' read -r i_slug i_state i_pr i_merged <<<"$it"
        [ "$i_slug" = - ] && i_slug=""; [ "$i_merged" = - ] && i_merged=""
        n="$(pr_num "$i_pr" "$slug")"; [ -n "$n" ] || n="$(phase_prs "$name" | head -1)"
        size=m proof=-
        [ -n "$n" ] && { size="$(pr_facts "$slug" "$n" | jq -r .size)"; size="${size:-m}"; proof="pr:$n${i_merged:+ commit:${i_merged:0:12}}"; }
        case "$st" in
          done) [ -n "$n" ] || proof="unverified:plan $base ticks it with no PR" ;;
          deferred) proof="why:deferred in plan $base" ;;
          open)
            # An item that landed the phase is the record even when the plan's box was never ticked.
            if [ "$i_state" = done ] && [ -n "$n" ]; then st=done
            else
              left=$((left + 1))
              if [ -n "$i_slug" ]; then [ "$i_state" != done ] || continue; else [ "$fresh" = 1 ] || continue; fi
            fi ;;
        esac
        text="$(words "$name")"; [ "$st" = open ] && text="$text (plan $base, phase $i)"
        stories+="$(row story "$base" "$prj" - "$size" "$st" "$proof" "${i_slug:--}" "$text")"$'\n'
      done < <(jq -r '.[] | [.state, .name] | @tsv' <<<"$phases")
      st=done; [ "$left" -eq 0 ] || st=open
      row epic "$base" "$prj" "$sys" - "$st" "plan:$base" - "$title"
      printf '%s' "$stories"
    done
  done
}

# Each FAIL criterion of a typed project is a story under `epic(<sys>): <sys> to standard`.
propose_criteria() {
  local m json
  for m in "$@"; do
    [ -n "$(project_field "$m" type)" ] && [ -n "$(project_field "$m" code)" ] || continue
    json="$("$SYSTEM_CHECK" "$m" --json 2>/dev/null)" || [ -n "$json" ] || continue
    jq -r --arg m "$m" '.systems[] | .id as $s | [.criteria[] | select(.result == "FAIL")] | select(length > 0)
      | (["epic", "std:\($m):\($s)", $m, $s, "-", "open", "-", "-", "\($s) to standard", ""] | @tsv),
        (.[] | ["story", "std:\($m):\($s)", $m, "-", "s", "open", "-", "-", "\($s): \(.criterion | gsub("`"; ""))", ""] | @tsv)' <<<"$json"
  done
}

# --- apply ---

# ptask <project> [--agent] <args>... -> notes ptask on the project's lab profile.
ptask() { local p="$1"; shift; notes --profile "$(project_field "$p" lab)" ptask "$p" "$@"; }

# add_row <project> <lane> <text> -> the new row's id (an open twin's id when one exists), or fail.
add_row() {
  local p="$1" lane="$2" text="$3" detail=() out rc=0 id
  if [ "${#text}" -gt 80 ]; then
    detail=(--detail "$text"); text="${text:0:80}"; [[ "$text" != *' '* ]] || text="${text% *}"
  fi
  out="$(ptask "$p" $lane add "${detail[@]}" -- "$text${4:+ $4}" 2>&1)" || rc=$?
  id="$(sed -nE 's/.*<!--.*\bid:([a-z0-9]+-[0-9]+).*/\1/p' <<<"$out" | head -1)"
  { [ "$rc" = 0 ] || [ "$rc" = 3 ]; } && [ -n "$id" ] || { echo "credit-backfill: ${out##*$'\n'}" >&2; return 1; }
  echo "$id"
}

# merged_on <owner/repo> <N> -> the day PR N merged (local date), from the PR store; nothing when it
# has no merge for it.
merged_on() {
  local ts; ts="$(pr_field "$2" 3)"; [ -n "$ts" ] || return 0
  date -d "$ts" +%F 2>/dev/null || true
}

# proof_day <slug> <proof> -> the merge day of the PR a `pr:N ...` or `pr:<owner>/<repo>#N ...`
# proof names, or nothing.
proof_day() {
  local n; n="$(sed -nE 's/^pr:([^ #]+#)?([0-9]+)( .*)?$/\2/p' <<<"$2")"
  [ -z "$n" ] || merged_on "$1" "$n"
}

# epic_day <slug> <file> <epic key> -> the latest merge day among the epic's done stories.
epic_day() {
  local kind key st proof best="" day
  while IFS=$'\t' read -r kind key _ _ _ st proof _; do
    [ "$kind" = story ] && [ "$key" = "$3" ] && [ "$st" = done ] || continue
    day="$(proof_day "$1" "$proof")"
    [[ "$day" > "$best" ]] && best="$day"
  done <"$2"
  echo "$best"
}

# close_row <slug> <project> <id> <state> <proof> -- close a story on the project's agent board,
# dated by its PR's merge day when it has one. A PR the PR store has no merge day for is closed today
# with a warning; `redate propose` finds it again once the store has it.
close_row() {
  local slug="$1" p="$2" id="$3" on
  on="$(proof_day "$slug" "$5")"
  if [ -z "$on" ] && [[ "$4:$5" == *:pr:* ]]; then echo "credit-backfill: $id (${5%% *}): no merge day in the PR store, closed today" >&2; fi
  case "$4:$5" in
    open:*) return 0 ;;
    deferred:why:*) ptask "$p" --agent drop "$id" --why "${5#why:}" ;;
    *:unverified:*) ptask "$p" --agent done "$id" --unverified "${5#unverified:}" ;;
    *:pr:*) ptask "$p" --agent done "$id" --proof "$5" ${on:+--on "$on"} ;;
    *) ptask "$p" --agent done "$id" --unverified "backfilled by credit-backfill with no proof" ;;
  esac >/dev/null
}

cmd_apply() {
  [ $# -eq 1 ] || die "usage: credit-backfill apply <project>"
  local f="$CB_DIR/$1.tsv" tmp n=0 bad slug day
  slug="$(gh_slug "$1")"
  [ -f "$f" ] || die "no proposal at $f: run credit-backfill propose $1 first"
  [ -n "$slug" ] || die "$1: its checkout has no origin remote, so no PR can be dated"
  store_load "$1" "$slug"
  bad="$(awk -F'\t' '$1 == "epic" && $4 == "?" && $10 == "" { print $2 }' "$f")"
  [ -z "$bad" ] || die "name a system for these epics first (column 4 is ?): $(paste -sd' ' <<<"$bad")"
  declare -A ids=() epic_sys=()
  local kind key prj sys size st proof item text id eid area
  while IFS=$'\t' read -r kind key prj sys size st proof item text id; do
    [ "$kind" = epic ] || continue
    epic_sys[$key]="$sys"; [ -z "$id" ] || ids[$key]="$id"
  done <"$f"
  tmp="$f.new"; : >"$tmp"
  while IFS= read -r line; do
    IFS=$'\t' read -r kind key prj sys size st proof item text id <<<"$line"
    if [[ "$line" == '#'* ]] || [ -n "$id" ] || [ -z "$kind" ]; then printf '%s\n' "$line" >>"$tmp"; continue; fi
    case "$kind" in
      attr)
        agent-queue set "$item" project="$prj" touches="${proof#touches:}" >/dev/null && id=set ;;
      epic)
        id="$(add_row "$prj" "" "epic($sys): $text")" && ids[$key]="$id" ;;
      story)
        eid="${ids[$key]:-}"
        [[ "$key" =~ ^[a-z0-9]+-[0-9]+$ ]] && eid="$key"
        if [ "$key" != - ] && [ -z "$eid" ]; then
          echo "credit-backfill: story under $key skipped: that epic is not applied" >&2
        else
          area="$sys"; [ "$area" != - ] || area="${epic_sys[$key]:-$prj}"
          text="$(typed "$text" "$area" "$( [[ "$key" == std:* ]] && echo chore || echo feat)")" || exit 1
          id="$(add_row "$prj" --agent "$text" "#size/$size${eid:+ #of/$eid}")" || id=""
        fi
        if [ -n "$id" ]; then
          # An open story an item works on is started, so dispatch does not start it a second time.
          if [ "$st" != open ]; then close_row "$slug" "$prj" "$id" "$st" "$proof"
          elif [ "$item" != - ]; then ptask "$prj" --agent start "$id" >/dev/null 2>&1; fi
          [ "$item" = - ] || agent-queue set "$item" row="$prj:$id" project="$prj" >/dev/null
        fi ;;
    esac
    [ -n "$id" ] && n=$((n + 1))
    printf '%s\t%s\n' "${line%$'\t'*}" "$id" >>"$tmp"
  done <"$f"
  mv "$tmp" "$f"
  # The epics: close a done plan's epic once its stories are, and give the plan its `epic:` line.
  while IFS=$'\t' read -r kind key prj sys size st proof item text id; do
    [ "$kind" = epic ] && [ -n "$id" ] && [[ "$proof" == plan:* ]] || continue
    if [ "$st" = done ]; then
      day="$(epic_day "$slug" "$f" "$key")"
      ptask "$prj" done "$id" --unverified "backfilled: every phase of plan ${proof#plan:} is ticked" ${day:+--on "$day"} >/dev/null 2>&1
    fi
    file_plan "${proof#plan:}" "$id" "$prj"
  done <"$f"
  echo "$f: $n lines applied"
}

# file_plan <plan name> <epic id> <project> -- the plan's `epic: <id>` line under its title, in the
# live plan and its cache, and the cache filed under the epic's project (85-sync-plans keeps it there).
file_plan() {
  local name="$1.md" c
  for c in "$CB_LIVE_PLANS/$name" "$CB_PLANS"/*/"$name"; do
    [ -f "$c" ] && ! grep -q '^epic: ' "$c" || continue
    awk -v e="epic: $2" '!done && /^# / { print; print ""; print e; done = 1; next } { print }
      END { if (!done) print e }' "$c" >"$c.new" && mv "$c.new" "$c"
  done
  c="$(find "$CB_PLANS" -mindepth 2 -maxdepth 2 -name "$name" -print -quit)"
  if [ -n "$c" ] && [ "$(dirname "$c")" != "$CB_PLANS/$3" ]; then mkdir -p "$CB_PLANS/$3" && mv "$c" "$CB_PLANS/$3/"; fi
}

# --- redate ---

# redate_day <slug> <file> <kind> <key> <state> <proof> -> the day an applied closed line should carry.
redate_day() {
  case "$3:$5" in
    story:done) proof_day "$1" "$6" ;;
    epic:done) [[ "$6" == plan:* ]] && epic_day "$1" "$2" "$4" ;;
  esac
}

# redate_ptask <project> <proof> <args>... -- the writer on the board a line lives on: a story is on the
# agent board, an epic (its proof is plan:<name>) on the project's own sheet.
redate_ptask() { local p="$1" lane=--agent; [[ "$2" != plan:* ]] || lane=""; shift 2; ptask "$p" $lane "$@"; }

# redate propose: one line per applied closed row whose `done:` day is not its PR's merge day.
# The old day is read through the writer's own --dry-run, so a row that is not on the sheet
# (archived, retexted away) is counted and left out, not guessed at.
redate_propose() {
  [ $# -eq 1 ] || die "usage: credit-backfill redate propose <project>"
  local f="$CB_DIR/$1.tsv" out="$CB_DIR/$1.redate.tsv" slug kind key prj st proof id new got old _day gone=0 same=0
  [ -f "$f" ] || die "no applied proposal at $f"
  [ ! -e "$out" ] || die "$out exists: apply it, or delete it to propose again (a rerun would bring back lines you removed)"
  slug="$(gh_slug "$1")"; [ -n "$slug" ] || die "$1: its checkout has no origin remote"
  store_load "$1" "$slug"
  {
    printf '# credit-backfill redate for %s, %s. Delete lines you do not want, then: credit-backfill redate apply %s <project>\n' "$1" "$(date +%F)" "$1"
    printf '# project\tid\told\tnew\tproof\tapplied\n'
    while IFS=$'\t' read -r kind key prj _ _ st proof _ _ id; do
      [[ "$kind" != '#'* ]] && [ -n "$id" ] && [ "$id" != set ] || continue
      new="$(redate_day "$slug" "$f" "$kind" "$key" "$st" "$proof")"; [ -n "$new" ] || continue
      got="$(redate_ptask "$prj" "$proof" redate "$id" --on "$new" --dry-run 2>/dev/null)" || { gone=$((gone + 1)); continue; }
      IFS=$'\t' read -r _ old _day <<<"$got"
      if [ "$old" = "$new" ]; then same=$((same + 1)); continue; fi
      printf '%s\t%s\t%s\t%s\t%s\t\n' "$prj" "$id" "$old" "$new" "${proof%% *}"
    done <"$f"
  } >"$out.new" && mv "$out.new" "$out"
  echo "$out: $(grep -vc '^#' "$out") to re-date ($same already right, $gone not on a sheet)"
  awk -F'\t' '!/^#/ { n[$1]++ } END { for (p in n) printf "  %s: %d\n", p, n[p] }' "$out" | sort
}

# redate apply: write the lines of one registry project, the one review the human gave.
redate_apply() {
  [ $# -eq 2 ] || die "usage: credit-backfill redate apply <project> <registry project>"
  local f="$CB_DIR/$1.redate.tsv" tmp line prj id old new proof applied n=0
  [ -f "$f" ] || die "no proposal at $f: run credit-backfill redate propose $1 first"
  tmp="$f.new"; : >"$tmp"
  while IFS= read -r line; do
    IFS=$'\t' read -r prj id old new proof applied <<<"$line"
    if [[ "$line" != '#'* ]] && [ "$prj" = "$2" ] && [ -z "$applied" ] &&
      redate_ptask "$prj" "$proof" redate "$id" --on "$new" >/dev/null; then
      line="${line%$'\t'}"$'\t'applied; n=$((n + 1))
    elif [[ "$line" != '#'* ]] && [ "$prj" = "$2" ] && [ -z "$applied" ]; then
      echo "credit-backfill: $id not re-dated (not on the sheet, or not closed with a done day)" >&2
    fi
    printf '%s\n' "$line" >>"$tmp"
  done <"$f"
  mv "$tmp" "$f"
  echo "$f: $n rows re-dated in $2"
}

cmd_redate() {
  local v="${1:-}"; [ $# -eq 0 ] || shift
  case "$v" in propose | apply) "redate_$v" "$@" ;; *) die "usage: credit-backfill redate propose <project> | redate apply <project> <registry project>" ;; esac
}

case "${1:-}" in
  propose | apply | redate) v="$1"; shift; "cmd_$v" "$@" ;;
  -h | --help | '') sed -n '2,/^set -uo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
  *) die "unknown verb: $1 (try --help)" ;;
esac
