#!/usr/bin/env bash
# discord-post: post a message to a Discord channel through its webhook.
#
#   discord-post --channel <slug> [--username <name>] "<message>"   (no message: read stdin)
#   discord-post --list                                             the channel slugs there are
#
# Channels are data: rbw entries `webhook_<slug>` in folder `discord`. Setup, the Discord limits
# this follows (one lock per machine, 429 retried after retry_after, never a 5xx, timeout or 404)
# and troubleshooting: .config/rbw/README.md, "Discord webhooks".
set -euo pipefail

FOLDER=discord
TIMEOUT=15        # seconds per request
MAX_ATTEMPTS=3    # 429s only
MAX_WAIT=60       # a longer retry_after fails instead of blocking the caller

die() { echo "discord-post: $*" >&2; exit "${2:-1}"; }
usage() { sed -n '3,4p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

channels() {
  rbw list --fields folder,name | awk -F'\t' -v f="$FOLDER" '$1 == f && $2 ~ /^webhook_/ { sub(/^webhook_/, "", $2); print $2 }' | sort -u
}

channel='' username=''
while [ $# -gt 0 ]; do
  case "$1" in
    --list) channels; exit 0 ;;
    --channel) channel=${2-}; shift 2 || usage ;;
    --username) username=${2-}; shift 2 || usage ;;
    -h|--help) usage ;;
    --) shift; break ;;
    -*) die "unknown flag $1" 2 ;;
    *) break ;;
  esac
done
[ -n "$channel" ] || usage
if [ $# -gt 0 ]; then msg="$*"; else msg="$(cat)"; fi
[ -n "${msg//[[:space:]]/}" ] || die "empty message" 2
[ "${#msg}" -le 2000 ] || die "message is ${#msg} characters; Discord allows 2000" 2

url="$(rbw get --folder "$FOLDER" "webhook_$channel" 2>/dev/null)" ||
  die "no channel '$channel' (rbw $FOLDER/webhook_$channel); known: $(channels | paste -sd' ')"
case "$url" in https://*/api/webhooks/*) ;; *) die "rbw $FOLDER/webhook_$channel is not a webhook URL" ;; esac

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
jq -cn --arg c "$msg" --arg u "$username" \
  '{content: $c, allowed_mentions: {parse: ["roles", "users"]}} + (if $u == "" then {} else {username: $u} end)' >"$work/payload"
# The URL carries the webhook token, so it goes to curl on stdin, never in argv where ps shows it.
printf 'url = "%s?wait=true"\n' "$url" >"$work/curlrc"

lockdir="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
if command -v flock >/dev/null; then
  exec 9>"$lockdir/discord-post.lock"
  flock 9
fi

header() { tr -d '\r' <"$work/headers" | awk -v h="$(tr 'A-Z' 'a-z' <<<"$1"):" 'tolower($1) == h { print $2 }' | tail -n1; }
too_long() { awk -v s="$1" -v m="$MAX_WAIT" 'BEGIN { exit !(s + 0 > m + 0) }'; }

attempt=1
while :; do
  code="$(curl -sS --max-time "$TIMEOUT" -K - -X POST -H 'Content-Type: application/json' \
    --data-binary @"$work/payload" -D "$work/headers" -o "$work/body" -w '%{http_code}' <"$work/curlrc")" ||
    die "request failed or timed out; not retried, check #$channel before posting again"
  case "$code" in
    2??)
      remaining="$(header X-RateLimit-Remaining)" reset="$(header X-RateLimit-Reset-After)"
      # Hold the lock through a drained bucket, so the next post on this machine does not 429.
      if [ "$remaining" = 0 ] && [ -n "$reset" ] && ! too_long "$reset"; then sleep "$reset"; fi
      jq -r '.id // empty' "$work/body" 2>/dev/null || true
      exit 0
      ;;
    429)
      wait="$(jq -r '.retry_after // empty' "$work/body" 2>/dev/null || true)"
      [ -n "$wait" ] || wait="$(header Retry-After)"
      [ -n "$wait" ] || wait=1
      too_long "$wait" && die "rate limited for ${wait}s, over the ${MAX_WAIT}s cap"
      [ "$attempt" -lt "$MAX_ATTEMPTS" ] || die "still rate limited after $MAX_ATTEMPTS attempts"
      sleep "$wait"
      attempt=$((attempt + 1))
      ;;
    404) die "webhook for #$channel is gone (404); make a new one and update rbw $FOLDER/webhook_$channel" ;;
    5??) die "Discord answered $code; not retried, the message may have posted, check #$channel" ;;
    *) die "Discord answered $code: $(jq -r '.message // empty' "$work/body" 2>/dev/null || head -c 300 "$work/body")" ;;
  esac
done
