#!/usr/bin/env python3
"""claude-recall - search / list / show raw Claude Code transcripts.

On-demand pull-recall over the verbatim session record that Claude Code writes
to ~/.claude/projects/**/*.jsonl (and Claude Cowork's local-agent-mode-sessions
on macOS, when present). No index, no daemon, no cloud: it reads the .jsonl on
each call. ripgrep is used as a fast prefilter when available.

This is the local, skill-friendly equivalent of local-claude-chat-history-mcp:
same three capabilities (search / list / show), reached via Bash instead of a
standing MCP server, so it costs zero session context until invoked.

Usage:
  claude-recall search TERM [--project P] [--branch B] [--since YYYY-MM-DD]
                           [--role user|assistant] [--regex] [--thinking]
                           [--context N] [--limit N] [--ignore-case/-i]
  claude-recall list [--project P] [--limit N]
  claude-recall show SESSION_ID_OR_PREFIX [--thinking]
  claude-recall stats [--days N | --since YYYY-MM-DD] [--kind slash,skill,agent,prompt]
                      [--origin interactive|auto|all] [--by week|project] [--top K]
                      [--min N] [--min-words N] [--project P] [--json]
  claude-recall tool-output [--days N | --since YYYY-MM-DD]
                            [--by tool|command|filetype|kind|method|day|week|project]
                            [--top K] [--json]

Examples:
  claude-recall search "privacy overlay" --project dotfiles --since 2026-07-01
  claude-recall search "TODO|FIXME" --regex --role assistant
  claude-recall list --project brightsign
  claude-recall show 15eeee34
  claude-recall stats --kind prompt --origin interactive --min 3   # skill candidates
  claude-recall stats --kind agent --by week
  claude-recall tool-output --by command          # which Bash commands fill the context
  claude-recall tool-output --by filetype         # which kinds of file reads fill it
"""
import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

HOME = Path.home()
# CLAUDE_TRANSCRIPTS (colon-separated) replaces the default roots; skill-drift uses the same
# variable, so a test or a caller points both tools at one corpus. The bnb and personal
# accounts symlink their projects/ to ~/.claude/projects; the work account does not.
if os.environ.get("CLAUDE_TRANSCRIPTS"):
    ROOTS = [Path(p) for p in os.environ["CLAUDE_TRANSCRIPTS"].split(":") if p]
else:
    ROOTS = [HOME / ".claude" / "projects", HOME / ".claude-work" / "projects"]
COWORK = HOME / "Library" / "Application Support" / "Claude" / "local-agent-mode-sessions"
if COWORK.exists():
    ROOTS.append(COWORK)

# --- ANSI (suppressed when not a TTY) --------------------------------------
_TTY = sys.stdout.isatty()
def c(code, s):
    return f"\033[{code}m{s}\033[0m" if _TTY else s
DIM, BOLD, CYAN, YEL, GRN, MAG = "2", "1", "36", "33", "32", "35"


def iter_files():
    for root in ROOTS:
        if root.exists():
            yield from sorted(root.rglob("*.jsonl"))


def parse_line(line):
    line = line.strip()
    if not line:
        return None
    try:
        return json.loads(line)
    except json.JSONDecodeError:
        return None


def blocks_to_text(content, include_thinking=False):
    """Render a message's content (str or list of blocks) to readable text."""
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return ""
    parts = []
    for b in content:
        if not isinstance(b, dict):
            continue
        t = b.get("type")
        if t == "text":
            parts.append(b.get("text", ""))
        elif t == "thinking":
            if include_thinking:
                parts.append("[thinking] " + b.get("thinking", ""))
        elif t == "tool_use":
            inp = json.dumps(b.get("input", {}), ensure_ascii=False)
            parts.append(f"[tool_use {b.get('name', '?')}] {inp[:300]}")
        elif t == "tool_result":
            rc = b.get("content", "")
            if isinstance(rc, list):
                rc = " ".join(
                    x.get("text", "") for x in rc if isinstance(x, dict)
                )
            parts.append("[tool_result] " + str(rc)[:300])
    return "\n".join(p for p in parts if p)


def project_of(rec, path):
    """Friendly project label: prefer cwd basename, else encoded dir name."""
    cwd = rec.get("cwd")
    if cwd:
        return os.path.basename(cwd.rstrip("/")).lstrip(".") or cwd
    # fall back to the encoded parent dir (best-effort)
    return path.parent.name.lstrip("-").split("-")[-1]


def rg_prefilter(term, regex, ignore_case):
    """Return the set of candidate files rg matches, or None if rg is absent."""
    if not shutil.which("rg"):
        return None
    cmd = ["rg", "-l", "--no-messages", "-g", "*.jsonl"]
    if not regex:
        cmd.append("-F")
    if ignore_case:
        cmd.append("-i")
    cmd += ["-e", term]
    cmd += [str(r) for r in ROOTS if r.exists()]
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
    except (subprocess.TimeoutExpired, OSError):
        return None
    return {Path(p) for p in out.stdout.splitlines() if p}


def snippet(text, matcher, context):
    """A one-window excerpt around the first match in text."""
    flat = " ".join(text.split())
    m = matcher.search(flat)
    if not m:
        return flat[: context * 2].strip()
    start = max(0, m.start() - context)
    end = min(len(flat), m.end() + context)
    pre = "..." if start > 0 else ""
    post = "..." if end < len(flat) else ""
    body = flat[start:end]
    if _TTY:
        body = matcher.sub(lambda x: c(f"{YEL};{BOLD}", x.group(0)), body)
    return f"{pre}{body}{post}"


def cmd_search(a):
    flags = re.IGNORECASE if a.ignore_case else 0
    if a.regex:
        matcher = re.compile(a.term, flags)
    else:
        matcher = re.compile(re.escape(a.term), flags)

    candidates = rg_prefilter(a.term, a.regex, a.ignore_case)
    files = sorted(candidates) if candidates is not None else list(iter_files())

    results = []
    for path in files:
        try:
            lines = path.read_text(errors="replace").splitlines()
        except OSError:
            continue
        for line in lines:
            rec = parse_line(line)
            if not rec or rec.get("type") not in ("user", "assistant"):
                continue
            msg = rec.get("message")
            if not isinstance(msg, dict):
                continue
            role = msg.get("role", rec.get("type"))
            if a.role and role != a.role:
                continue
            ts = rec.get("timestamp", "")
            if a.since and ts[:10] < a.since:
                continue
            if a.branch and rec.get("gitBranch") != a.branch:
                continue
            proj = project_of(rec, path)
            if a.project and a.project.lower() not in proj.lower():
                continue
            text = blocks_to_text(msg.get("content"), include_thinking=a.thinking)
            if not matcher.search(text):
                continue
            results.append((ts, proj, role, path.stem, text))

    results.sort(key=lambda r: r[0])
    total = len(results)
    if a.limit and total > a.limit:
        results = results[-a.limit :]

    for ts, proj, role, sid, text in results:
        head = (
            c(DIM, ts[:19].replace("T", " "))
            + "  "
            + c(f"{CYAN};{BOLD}", proj)
            + c(DIM, f"  ({role})  ")
            + c(MAG, sid[:8])
        )
        print(head)
        print("  " + snippet(text, matcher, a.context))
        print()
    shown = len(results)
    note = f"{shown} match(es)"
    if shown < total:
        note += f" (of {total}; use --limit to widen)"
    if candidates is not None:
        note += "  [rg prefilter]"
    print(c(DIM, note))


def session_meta(path):
    """(sessionId, aiTitle, project, first_ts, last_ts, n_user_msgs)."""
    sid = path.stem
    title = None
    proj = None
    first = last = None
    n = 0
    try:
        for line in path.read_text(errors="replace").splitlines():
            rec = parse_line(line)
            if not rec:
                continue
            if rec.get("type") == "ai-title":
                title = rec.get("aiTitle") or title
            if proj is None:
                proj = project_of(rec, path) if rec.get("cwd") else proj
            ts = rec.get("timestamp")
            if ts:
                first = first or ts
                last = ts
            if rec.get("type") == "user":
                n += 1
    except OSError:
        pass
    return sid, title, (proj or path.parent.name.lstrip("-").split("-")[-1]), first, last, n


CARD_FIELDS = [
    "id", "project", "updated", "mtime", "cwd", "branch",
    "title", "titles_all", "first_prompt", "last_prompt", "files", "prs",
]


def _flatten(s, limit=None):
    """One physical line, no tabs - these become TSV fields."""
    s = " ".join(str(s or "").split())
    return s[:limit] if limit else s


def session_card(path):
    """A searchable summary of one session, in a single pass over the transcript.

    Richer than session_meta: collects EVERY distinct ai-title rather than only
    the last. Claude rewrites the title as a session's subject drifts, so the
    history is the best keyword source we have - the gsuite session carries
    "Automate Google Workspace across multiple email accounts" ... through to
    "aerc-nested-folders-config", and a search for "email" should find it by the
    first even though it now goes by the last.
    """
    sid = path.stem
    titles, files, prs = [], [], []
    proj = cwd = branch = None
    first_prompt = last_prompt = None
    last_ts = None
    try:
        for line in path.read_text(errors="replace").splitlines():
            rec = parse_line(line)
            if not rec:
                continue
            rtype = rec.get("type")
            if rtype == "ai-title":
                t = rec.get("aiTitle")
                if t and t not in titles:
                    titles.append(t)
            elif rtype == "last-prompt":
                last_prompt = rec.get("lastPrompt") or last_prompt
            elif rtype == "file-history-delta":
                p = rec.get("trackingPath")
                if p:
                    base, parent = os.path.basename(p), os.path.basename(os.path.dirname(p))
                    for tok in (base, parent):
                        if tok and tok not in files:
                            files.append(tok)
            elif rtype == "pr-link":
                u = rec.get("prUrl")
                if u and u not in prs:
                    prs.append(u)

            if rec.get("cwd"):
                cwd = rec["cwd"]
                proj = proj or project_of(rec, path)
            if rec.get("gitBranch"):
                branch = rec["gitBranch"]
            if rec.get("timestamp"):
                last_ts = rec["timestamp"]
            if first_prompt is None and rtype == "user":
                msg = rec.get("message") or {}
                txt = blocks_to_text(msg.get("content", ""))
                if txt and not txt.lstrip().startswith("<"):
                    first_prompt = txt
    except OSError:
        return None

    try:
        mtime = int(path.stat().st_mtime)
    except OSError:
        mtime = 0

    return {
        "id": sid,
        "project": proj or path.parent.name.lstrip("-").split("-")[-1],
        "updated": last_ts or "",
        "mtime": str(mtime),
        "cwd": cwd or "",
        "branch": branch or "",
        "title": titles[-1] if titles else "",
        "titles_all": " | ".join(titles),
        "first_prompt": _flatten(first_prompt, 300),
        "last_prompt": _flatten(last_prompt, 300),
        "files": " ".join(files[:40]),
        "prs": " ".join(prs[:10]),
    }


def cmd_cards(a):
    """Emit one TSV row per session - the index `sessions search` reads.

    Empty fields are emitted as "-": TAB counts as IFS whitespace in bash, so a
    genuinely empty middle field would collapse and shift every later field left.
    """
    n = 0
    for path in iter_files():
        # Subagent transcripts live in a `subagents/` subdir and are not
        # resumable sessions - indexing them would triple the index and put
        # rows in the picker that Enter cannot act on.
        if "subagents" in path.parts:
            continue
        if a.since_mtime:
            try:
                if path.stat().st_mtime <= a.since_mtime:
                    continue
            except OSError:
                continue
        card = session_card(path)
        if not card:
            continue
        row = [_flatten(card[f]) or "-" for f in CARD_FIELDS]
        print("\t".join(row))
        n += 1
    if a.verbose:
        print(f"{n} session(s) carded", file=sys.stderr)


def cmd_list(a):
    metas = []
    for path in iter_files():
        try:
            mtime = path.stat().st_mtime
        except OSError:
            continue
        metas.append((mtime, path))
    metas.sort(reverse=True)

    rows = []
    for _, path in metas:
        sid, title, proj, first, last, n = session_meta(path)
        if a.project and a.project.lower() not in proj.lower():
            continue
        rows.append((last or "", proj, sid, n, title or "(untitled)"))
        if a.limit and len(rows) >= a.limit:
            break

    for last, proj, sid, n, title in rows:
        print(
            c(DIM, (last[:19].replace("T", " ") if last else "?"))
            + "  "
            + c(f"{CYAN};{BOLD}", f"{proj:<22.22}")
            + " "
            + c(MAG, sid[:8])
            + c(DIM, f"  {n:>3} msgs  ")
            + title
        )
    print(c(DIM, f"{len(rows)} session(s)"))


def cmd_show(a):
    target = a.session
    match = None
    for path in iter_files():
        if path.stem == target or path.stem.startswith(target):
            match = path
            break
    if not match:
        print(c(YEL, f"no session matching '{target}'"), file=sys.stderr)
        return 1
    print(c(f"{GRN};{BOLD}", f"# session {match.stem}"))
    for line in match.read_text(errors="replace").splitlines():
        rec = parse_line(line)
        if not rec or rec.get("type") not in ("user", "assistant"):
            continue
        msg = rec.get("message")
        if not isinstance(msg, dict):
            continue
        role = msg.get("role", rec.get("type"))
        ts = rec.get("timestamp", "")[:19].replace("T", " ")
        text = blocks_to_text(msg.get("content"), include_thinking=a.thinking)
        if not text.strip():
            continue
        label = c(f"{CYAN};{BOLD}", role.upper()) if role == "user" else c(GRN, role.upper())
        print(f"\n{label} {c(DIM, ts)}")
        print(text)
    return 0


STATS_KINDS = ("slash", "skill", "agent", "intent", "prompt")
# A typed command record opens with its tag; one quoted inside a summary or paste does not.
CMD_RE = re.compile(r"\A\s*<command-(?:name|message)>(?:.*?<command-name>)?/?([^<\s]+)</command-name>", re.S)
# Masks applied before a prompt becomes a counting key, so "fix PR #712" and "fix PR #713"
# are one workflow. Order matters: URLs and paths hold digits the later masks would split.
PROMPT_MASKS = [
    (re.compile(r"https?://\S+"), " url "),
    # An inline /command is counted by the skill it triggers, not as part of a prompt.
    (re.compile(r"(?<![\w/])/[a-z][\w:-]*"), " "),
    (re.compile(r"(?:~|\.{1,2})?(?:/[\w.@~+-]+){2,}/?"), " path "),
    (re.compile(r"\b[0-9a-f]{7,40}\b"), " sha "),
    (re.compile(r"\d+"), " n "),
    (re.compile(r"[^\w\s]+|_+"), " "),
]


def letters(w):
    return "".join(sorted(w))


# Courtesy and assent words carry no workflow, and the human types them fast, so they are
# matched by sorted letters: thanks, thansk and tahnks are all one filler.
FILLERS = {letters(w) for w in (
    "ok", "okay", "k", "thanks", "thank", "thx", "ty", "you", "please", "pls", "plz",
    "yes", "yeah", "yep", "cool", "great", "nice", "sure", "go", "ahead", "now", "and", "then")}


def prompt_words(text):
    t = text.lower()
    for rx, rep in PROMPT_MASKS:
        t = rx.sub(rep, t)
    return t.split()


def normalize_prompt(text, words=8):
    return " ".join([w for w in prompt_words(text) if letters(w) not in FILLERS][:words])


def intents_path():
    env = os.environ.get("CLAUDE_RECALL_INTENTS")
    if env:
        return Path(env)
    xdg = os.environ.get("XDG_CONFIG_HOME") or str(HOME / ".config")
    return Path(xdg) / "claude-recall" / "intents.tsv"


def load_intents():
    """[(name, {skills}, [phrase, ...])] from intents.tsv; a phrase is a list of words,
    each matched by sorted letters (typo-tolerant), or as a prefix when it ends in *."""
    out = []
    try:
        lines = intents_path().read_text().splitlines()
    except OSError:
        return out
    for line in lines:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        parts = line.split("\t")
        if len(parts) != 3:
            continue
        name, skills, phrases = (x.strip() for x in parts)
        out.append((name, {x for x in skills.split(",") if x and x != "-"},
                    [p.lower().split() for p in phrases.split("|") if p.strip()]))
    return out


def word_matches(pat, word):
    if pat.endswith("*"):
        return word.startswith(pat[:-1])
    return letters(pat) == letters(word)


def match_intents(intents, text):
    words = prompt_words(text)
    hits = []
    for name, _skills, phrases in intents:
        for ph in phrases:
            n = len(ph)
            if any(all(word_matches(ph[j], words[i + j]) for j in range(n))
                   for i in range(len(words) - n + 1)):
                hits.append(name)
                break
    return hits


def cluster_key(norm):
    """Letters of each word sorted, so a transposition typo counts with its word. Only the
    grouping uses this; the row shows the commonest spelling."""
    return " ".join(letters(w) for w in norm.split())


def user_text(rec):
    """Typed text of a user record, or None for tool results."""
    content = (rec.get("message") or {}).get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        if any(isinstance(b, dict) and b.get("type") == "tool_result" for b in content):
            return None
        return "\n".join(b.get("text", "") for b in content
                         if isinstance(b, dict) and b.get("type") == "text")
    return None


def user_origin(rec):
    """interactive or auto. turnOrigin is authoritative where present (human, scheduled for
    a /loop fire, peer, sdk, task_notification, system); older records lack it, so a headless
    entrypoint or an isMeta injection (skill bodies, hook feedback) counts as auto.
    interactive is not proof a person typed it: a session fleet-dispatch starts gets its
    task as the opening interactive turn."""
    o = rec.get("turnOrigin")
    if isinstance(o, str):
        return "interactive" if o == "human" else "auto"
    if rec.get("entrypoint") == "sdk-cli" or rec.get("isMeta"):
        return "auto"
    return "interactive"


# Text our own tooling types into a session (claude-acct park/move resume it with tmux
# send-keys, so it arrives as an interactive turn), plus harness text that has no turnOrigin
# on older transcripts. None of it is a request anyone typed.
HARNESS_PREFIXES = ("This session is being continued", "Stop hook feedback",
                    "[Request interrupted", "Another Claude session sent", "Caveat:",
                    "This session was parked", "This session was moved",
                    "Moved to the alt Claude account")


def stats_repo(label):
    """dotfiles-agent-6 (a fleet worktree) and dotfiles-agent-a70248... (an Agent-tool worktree)
    -> dotfiles: a worktree counts toward its repo."""
    return re.sub(r"-agent-(?:\d+(?:-[a-z])?|a[0-9a-f]{12,})$", "", label)


def stats_events(path, since):
    """Yield (kind, key, origin, day, example) for one transcript.

    A subagent transcript contributes its Skill and Agent calls but no prompts or slash
    commands: its user records are the parent's dispatch prompt, not anything typed.
    """
    sub = "subagents" in path.parts
    session_auto = None
    for line in path.open(errors="replace"):
        # Cheap substring gates before json.loads: tool results and api records are most
        # of the bytes and none of the signal.
        if '"type":"assistant"' in line:
            if not ('"name":"Skill"' in line or '"name":"Agent"' in line or '"name":"Task"' in line):
                continue
        elif '"type":"user"' in line:
            if sub or '"tool_use_id"' in line:
                continue
        else:
            continue
        rec = parse_line(line)
        if not rec:
            continue
        ts = str(rec.get("timestamp") or "")[:10]
        if session_auto is None and rec.get("entrypoint"):
            session_auto = rec["entrypoint"] == "sdk-cli"
        if ts < since:
            continue
        rtype = rec.get("type")
        if rtype == "assistant":
            origin = "auto" if (session_auto or rec.get("entrypoint") == "sdk-cli") else "interactive"
            for b in (rec.get("message") or {}).get("content") or []:
                if not isinstance(b, dict) or b.get("type") != "tool_use":
                    continue
                inp = b.get("input") or {}
                if b.get("name") == "Skill" and inp.get("skill"):
                    yield "skill", str(inp["skill"]).lstrip("/"), origin, ts, ""
                elif b.get("name") in ("Agent", "Task"):
                    yield "agent", str(inp.get("subagent_type") or "general-purpose"), origin, ts, ""
        elif rtype == "user":
            text = user_text(rec)
            if not text:
                continue
            origin = user_origin(rec)
            m = CMD_RE.search(text)
            if m:
                yield "slash", m.group(1), origin, ts, ""
                continue
            # The first line only, and only when it opens with a letter or digit: what the
            # human types is one paragraph, and what follows a newline (or opens with a box
            # rule, a bullet, a cowsay border) is pasted output that would match everything.
            s = text.strip().split("\n", 1)[0].strip()
            if (origin != "interactive" or not s[:1].isalnum()
                    or s.startswith(HARNESS_PREFIXES)):
                continue
            yield "prompt", None, origin, ts, s


def cmd_stats(a):
    """Count slash commands, skills, subagents and repeated prompts. SESSIONS is the
    headline: a /loop that re-fires a command 200 times in one session is one session."""
    kinds = set(a.kind.split(",")) if a.kind else set(STATS_KINDS)
    bad = kinds - set(STATS_KINDS)
    if bad:
        print(f"claude-recall stats: unknown kind {','.join(sorted(bad))} "
              f"(one of {','.join(STATS_KINDS)})", file=sys.stderr)
        return 2
    if a.since:
        since = a.since
    else:
        since = (datetime.now(timezone.utc) - timedelta(days=a.days)).strftime("%Y-%m-%d")
    since_epoch = datetime.strptime(since, "%Y-%m-%d").replace(tzinfo=timezone.utc).timestamp()

    intents = load_intents() if "intent" in kinds else []
    if "intent" in kinds and not intents:
        print(f"claude-recall stats: no intents in {intents_path()}", file=sys.stderr)
    covers = {name: skills for name, skills, _ in intents}
    agg = {}
    used = {}  # session -> skills and slash commands it ran, for intent coverage

    def add(kind, key, shown, bucket, session, origin, example):
        row = agg.setdefault((kind, key, bucket), {
            "calls": 0, "sessions": set(), "interactive": set(), "auto": set(),
            "example": _flatten(example, 100), "shown": {}})
        row["calls"] += 1
        row["shown"][shown] = row["shown"].get(shown, 0) + 1
        row["sessions"].add(session)
        row[origin].add(session)

    for path in iter_files():
        try:
            if path.stat().st_mtime < since_epoch:
                continue
        except OSError:
            continue
        session = path.parent.parent.name if "subagents" in path.parts else path.stem
        project = None
        try:
            for kind, key, origin, day, example in stats_events(path, since):
                if kind in ("skill", "slash"):
                    used.setdefault(session, set()).add(key)
                if a.origin != "all" and origin != a.origin:
                    continue
                if project is None:
                    project = stats_repo(session_meta_project(path))
                if a.project and a.project not in project:
                    continue
                if a.by == "week":
                    y, w, _ = datetime.strptime(day, "%Y-%m-%d").isocalendar()
                    bucket = f"{y}-W{w:02d}"
                elif a.by == "project":
                    bucket = project
                else:
                    bucket = ""
                if kind != "prompt":
                    if kind in kinds:
                        add(kind, key, key, bucket, session, origin, example)
                    continue
                for name in match_intents(intents, example):
                    add("intent", name, name, bucket, session, origin, example)
                if "prompt" in kinds:
                    shown = normalize_prompt(example)
                    if len(shown.split()) >= a.min_words:
                        add("prompt", cluster_key(shown), shown, bucket, session, origin, example)
        except OSError:
            continue

    rows = [{
        "kind": k, "key": max(r["shown"], key=r["shown"].get), "bucket": b,
        "calls": r["calls"], "sessions": len(r["sessions"]),
        "interactive_sessions": len(r["interactive"]),
        "auto_sessions": len(r["auto"]), "example": r["example"],
        # intent only: the sessions where a skill that covers it actually ran. A low share
        # means the task gets described in words and the skill never fires.
        **({"covered_sessions": sum(1 for x in r["sessions"] if used.get(x, set()) & covers[key]),
            "covered_by": sorted(covers[key])} if k == "intent" else {}),
    } for (k, key, b), r in agg.items() if len(r["sessions"]) >= a.min]
    rows.sort(key=lambda r: (STATS_KINDS.index(r["kind"]), r["bucket"],
                             -r["sessions"], -r["calls"], r["key"]))
    if a.top:
        seen, kept = {}, []
        for r in rows:
            g = (r["kind"], r["bucket"])
            seen[g] = seen.get(g, 0) + 1
            if seen[g] <= a.top:
                kept.append(r)
        rows = kept

    if a.json:
        print(json.dumps({"since": since, "origin": a.origin, "by": a.by or "",
                          "rows": rows}, ensure_ascii=False))
        return 0
    if not rows:
        print(f"nothing counted since {since}")
        return 0
    last = None
    for r in rows:
        g = (r["kind"], r["bucket"])
        if g != last:
            head = r["kind"] + (f"  {r['bucket']}" if r["bucket"] else "")
            print(c(BOLD, f"\n{head}") + c(DIM, "   sessions  calls  inter  auto"))
            last = g
        key = r["key"]
        if r["kind"] == "prompt":
            key = f"{key}  {c(DIM, '| ' + r['example'])}"
        elif r["kind"] == "intent":
            by = ",".join(r["covered_by"]) or "no skill"
            cov = f"skill ran in {r['covered_sessions']}/{r['sessions']} ({by})"
            key = f"{key}  {c(DIM, cov)}"
        print(f"  {r['sessions']:>8} {r['calls']:>6} {r['interactive_sessions']:>6} "
              f"{r['auto_sessions']:>5}  {key}")
    print(c(DIM, f"\nsince {since}, origin {a.origin}"))
    return 0


def session_meta_project(path):
    """The project label of a transcript from its first record that carries a cwd."""
    with path.open(errors="replace") as fh:
        for line in fh:
            if '"cwd":"' in line:
                rec = parse_line(line)
                if rec and rec.get("cwd"):
                    return project_of(rec, path)
    return path.parent.name.lstrip("-").split("-")[-1]


# --- tool-output: where the tokens go ---------------------------------------
USAGE_FIELDS = ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens",
                "output_tokens")
SUBCMD_HEADS = ("git", "gh", "notes", "agent-queue", "cargo", "npm", "kubectl", "rtk")
TF_STATE = Path(os.environ.get("TOKEN_FILTER_STATE", HOME / ".agent" / "token-filter"))
TF_CACHE = Path(os.environ.get("TOKEN_FILTER_CACHE",
                               Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "token-filter"))


SEGMENTS = re.compile(r"\s*(?:&&|;|\|\||\|)\s*")  # one Bash call split into its commands


def bash_head(cmd):
    """grep, sed, git show: the first real command of a Bash call, past env, cd and wrappers."""
    for seg in SEGMENTS.split(cmd.strip()):
        w = seg.split()
        while w and (("=" in w[0] and not w[0].startswith("-")) or w[0] in ("timeout", "sudo", "env", "time")):
            w = w[1:]
            while w and w[0] and (w[0][0].isdigit() or w[0].startswith("-")):
                w = w[1:]  # timeout 30, env -i
        if not w or w[0] == "cd":
            continue
        head = os.path.basename(w[0])
        if head == "rtk" and len(w) > 1:  # count a filtered call under the tool it ran
            w, head = w[1:], w[1]
        if head in SUBCMD_HEADS:
            rest = [x for x in w[1:] if not x.startswith("-")]
            if head == "git" and w[1:2] == ["-C"]:
                rest = rest[1:]
            if rest:
                head += " " + rest[0]
        return head
    return "?"


READ_HEADS = {"sed", "cat", "head", "tail", "less", "nl", "bat"}
FILE_CLASS = {
    "code": "cs py rs go ts tsx js jsx mjs cjs lua sh bash zsh bats swift kt java c h cc cpp hpp "
            "rb php sql shader hlsl cginc compute gd vue svelte css scss",
    "prose": "md txt rst org adoc",
    "config": "json yaml yml toml ini conf cfg xml uxml uss csproj asmdef plist env service timer lock",
    "output": "output log out",
    "data": "jsonl csv tsv",
}
EXT_CLASS = {e: k for k, v in FILE_CLASS.items() for e in v.split()}


def read_target(name, inp):
    """'code .cs': the class and extension of the file a Read, or a sed/cat/head/tail call, read."""
    if name == "Read":
        path = inp.get("file_path") or ""
    elif name == "Bash":
        path = ""
        for seg in SEGMENTS.split((inp.get("command") or "").strip()):
            try:
                w = shlex.split(seg)
            except ValueError:
                w = seg.split()
            if not w or os.path.basename(w[0]) not in READ_HEADS or any(x.startswith((">", "<<")) for x in w):
                continue
            args = [x for x in w[1:] if not x.startswith("-") and ("." in x or "/" in x)]
            if args:
                path = args[-1]
                break
    else:
        return None
    if not path:
        return None
    ext = os.path.splitext(path)[1].lstrip(".").lower()
    return f"{EXT_CLASS.get(ext, 'other')} .{ext}" if ext else "other (none)"


def method_windows():
    """[(ts, method)] from the token-filter switch log; before the first switch it was off."""
    out = []
    try:
        for line in (TF_STATE / "methods.jsonl").open():
            rec = parse_line(line)
            if rec and rec.get("ts") and rec.get("method"):
                out.append((rec["ts"], rec["method"]))
    except OSError:
        pass
    return sorted(out)


def method_at(windows, ts):
    m = "off"
    for t, meth in windows:
        if t > ts:
            break
        m = meth
    return m


def rewritten_ids():
    ids = set()
    try:
        for line in (TF_CACHE / "rewrites.jsonl").open(errors="replace"):
            rec = parse_line(line)
            if rec and rec.get("id"):
                ids.add(rec["id"])
    except OSError:
        pass
    return ids


# A stretch of this many responses with no compaction is a long run: every tool result in it is
# re-read on each later response (about 32x its size on the 2026-11 fleet), so the longest are
# where a /compact would have paid most. 150 was the p99 stretch in the week to 2026-11-05
# (42 of 3,168; median 30). Tune with --long-turns.
LONG_TURNS = 150


def tool_output_file(path, since, until, windows, rewritten, emit):
    """Stream one transcript: emit('turn', ...) per API response, emit('result', ...) per tool
    result, with how many later turns re-read the result before a compaction drops it, and
    emit('segment', ...) per stretch between compactions that had a response in the window."""
    uses, pending, seen_msgs, turns = {}, [], set(), 0
    project, seg = None, {"start": 0, "in_win": 0, "carried": 0, "chars": 0, "last": ""}
    kind = "subagent" if "subagents" in path.parts else "main"

    def settle(compacted):
        for r in pending:
            r["carried_turns"] = turns - r.pop("at")
            seg["carried"] += r["chars"] * max(r["carried_turns"], 0)
            seg["chars"] += r["chars"]
            emit("result", r)
        pending.clear()
        if seg["in_win"]:
            emit("segment", {"session": path.stem, "project": project or "?",
                             "turns": turns - seg["start"], "chars": seg["chars"],
                             "carried": seg["carried"], "compacted": compacted, "last": seg["last"]})
        seg.update(start=turns, in_win=0, carried=0, chars=0, last="")

    for line in path.open(errors="replace"):
        if '"compact_boundary"' in line:
            settle(True)
            continue
        if '"type":"assistant"' not in line and '"tool_result"' not in line:
            continue
        rec = parse_line(line)
        if not rec:
            continue
        if project is None and rec.get("cwd"):
            project = stats_repo(project_of(rec, path))
        ts = str(rec.get("timestamp") or "")
        msg = rec.get("message") or {}
        if rec.get("type") == "assistant":
            mid = msg.get("id")
            if mid and mid not in seen_msgs:
                seen_msgs.add(mid)
                turns += 1
                u = msg.get("usage") or {}
                if since <= ts < until:
                    seg["in_win"] += 1
                    seg["last"] = ts
                    emit("turn", {"ts": ts, "project": project or "?",
                                  "method": method_at(windows, ts),
                                  **{f: int(u.get(f) or 0) for f in USAGE_FIELDS}})
            for b in msg.get("content") or []:
                if isinstance(b, dict) and b.get("type") == "tool_use":
                    name, inp = b.get("name") or "?", b.get("input") or {}
                    cmd = bash_head(inp.get("command") or "") if name == "Bash" else None
                    uses[b.get("id")] = (name, cmd, read_target(name, inp))
            continue
        if not since <= ts < until:
            continue
        for b in msg.get("content") or [] if isinstance(msg.get("content"), list) else []:
            if not isinstance(b, dict) or b.get("type") != "tool_result":
                continue
            tid = b.get("tool_use_id")
            name, cmd, ftype = uses.get(tid, ("?", None, None))
            pending.append({"ts": ts, "project": project or "?", "tool": name, "command": cmd,
                            "filetype": ftype, "kind": kind,
                            "chars": len(result_text(b)), "at": turns, "method": method_at(windows, ts),
                            "rewritten": tid in rewritten})
    settle(False)


def window_bound(s):
    """A --since/--until value as (string compared with transcript timestamps, epoch). A bare
    date is a UTC day, as transcript timestamps are UTC; an ISO time is converted to UTC."""
    if re.fullmatch(r"\d{4}-\d{2}-\d{2}", s):
        return s, datetime.strptime(s, "%Y-%m-%d").replace(tzinfo=timezone.utc).timestamp()
    t = datetime.fromisoformat(s.replace("Z", "+00:00"))
    t = t.astimezone(timezone.utc) if t.tzinfo else t.astimezone().astimezone(timezone.utc)
    return t.strftime("%Y-%m-%dT%H:%M:%S"), t.timestamp()


def cmd_tool_output(a):
    """Token use as a whole (API usage per response) and the tool output behind it."""
    since, since_epoch = window_bound(
        a.since or (datetime.now(timezone.utc) - timedelta(days=a.days)).strftime("%Y-%m-%d"))
    until = window_bound(a.until)[0] if a.until else "9999"
    windows, rewritten = method_windows(), rewritten_ids()
    bucket_of = {"tool": lambda r: r["tool"], "command": lambda r: r.get("command") or "?",
                 "method": lambda r: r["method"], "day": lambda r: r["ts"][:10],
                 "week": lambda r: datetime.strptime(r["ts"][:10], "%Y-%m-%d").strftime("%G-W%V"),
                 "project": lambda r: r["project"], "filetype": lambda r: r.get("filetype"),
                 "kind": lambda r: r["kind"]}[a.by]
    totals = {f: 0 for f in USAGE_FIELDS}
    totals.update(turns=0, calls=0, chars=0, carried=0, bash_calls=0, bash_chars=0)
    rows, segments = {}, []

    def row(k):
        return rows.setdefault(k, {"key": k, "turns": 0, **{f: 0 for f in USAGE_FIELDS},
                                   "calls": 0, "chars": 0, "carried": 0, "rewritten": 0,
                                   "bash_calls": 0, "bash_chars": 0})

    def emit(kind, r):
        if a.project and a.project not in r["project"]:
            return
        if kind == "segment":
            segments.append(r)
            return
        if kind == "turn":
            totals["turns"] += 1
            for f in USAGE_FIELDS:
                totals[f] += r[f]
            if a.by in ("method", "day", "week", "project"):
                x = row(bucket_of(r))
                x["turns"] += 1
                for f in USAGE_FIELDS:
                    x[f] += r[f]
            return
        if a.by == "command" and r["tool"] != "Bash":
            key = None
        else:
            key = bucket_of(r)
        carried = r["chars"] * max(r["carried_turns"], 0)
        totals["calls"] += 1
        totals["chars"] += r["chars"]
        totals["carried"] += carried
        if r["tool"] == "Bash":
            totals["bash_calls"] += 1
            totals["bash_chars"] += r["chars"]
        if key is None:
            return
        x = row(key)
        x["calls"] += 1
        x["chars"] += r["chars"]
        x["carried"] += carried
        x["rewritten"] += r["rewritten"]
        if r["tool"] == "Bash":
            x["bash_calls"] += 1
            x["bash_chars"] += r["chars"]

    seen, files = set(), 0
    for f in iter_files():
        try:
            real = f.resolve()
            if real in seen or real.stat().st_mtime < since_epoch:
                continue
        except OSError:
            continue
        seen.add(real)
        files += 1
        tool_output_file(real, since, until, windows, rewritten, emit)

    order = sorted(rows.values(), key=lambda r: r["key"]) if a.by in ("day", "week", "method") \
        else sorted(rows.values(), key=lambda r: -r["chars"])
    if a.top and a.by not in ("day", "week", "method", "kind"):
        order = order[:a.top]
    # Compaction cadence: the stretches that ran longest without one, by what they re-read.
    long = sorted((x for x in segments if x["turns"] >= a.long_turns), key=lambda x: -x["carried"])
    long_runs = {"turns_over": a.long_turns, "stretches": len(segments), "long": len(long),
                 "rows": long[:10]}
    if a.json:
        print(json.dumps({"since": since, "until": a.until and until, "by": a.by,
                          "transcripts": files, "totals": totals, "rows": order,
                          "long_runs": long_runs}, indent=1))
        return 0
    t = totals
    billed_in = t["input_tokens"] + t["cache_creation_input_tokens"] + t["cache_read_input_tokens"]
    print(c(BOLD, f"since {since}: {files} transcripts, {t['turns']:,} API responses"))
    print(f"  input {t['input_tokens']:,}  cache write {t['cache_creation_input_tokens']:,}  "
          f"cache read {t['cache_read_input_tokens']:,}  output {t['output_tokens']:,} tokens")
    if t["turns"]:
        print(f"  context per response {billed_in // t['turns']:,} tokens; "
              f"cache read is {100 * t['cache_read_input_tokens'] / max(billed_in, 1):.0f}% of input")
    print(f"  tool results {t['calls']:,} calls, {t['chars']:,} chars (~{t['chars'] // 4:,} tokens); "
          f"Bash {t['bash_calls']:,} calls, {t['bash_chars'] // max(t['bash_calls'], 1):,} chars/call")
    print(f"  carried: tool output re-read {t['carried'] // 4:,} tokens' worth before compaction "
          f"({t['carried'] // max(t['chars'], 1)}x its size), ~{100 * t['carried'] / 4 / max(billed_in, 1):.0f}% of input")
    print(f"  compaction: {len(long)} of {len(segments)} stretches ran {a.long_turns}+ responses without one"
          + "".join(f"\n    {x['session'][:8]} {x['project']}: {x['turns']:,} responses, carried "
                    f"{x['carried'] // 4:,} tokens' worth ({x['carried'] // max(x['chars'], 1)}x)"
                    for x in long[:3]) + "\n")
    if a.by in ("tool", "command", "filetype", "kind"):
        print(c(DIM, f"  {'calls':>8} {'chars':>13} {'avg':>7} {'share':>6} {'carried~tok':>13} {'filtered':>8}  {a.by}"))
        for r in order:
            print(f"  {r['calls']:>8,} {r['chars']:>13,} {r['chars'] // max(r['calls'], 1):>7,} "
                  f"{100 * r['chars'] / max(t['chars'], 1):>5.1f}% {r['carried'] // 4:>13,} "
                  f"{r['rewritten']:>8,}  {r['key']}")
    else:
        print(c(DIM, f"  {'responses':>9} {'in+write':>13} {'cache read':>14} {'output':>11} "
                     f"{'bash calls':>10} {'chars/call':>10} {'filtered':>8} {'carried~tok':>13}  {a.by}"))
        for r in order:
            print(f"  {r['turns']:>9,} {r['input_tokens'] + r['cache_creation_input_tokens']:>13,} "
                  f"{r['cache_read_input_tokens']:>14,} {r['output_tokens']:>11,} {r['bash_calls']:>10,} "
                  f"{r['bash_chars'] // max(r['bash_calls'], 1):>10,} {r['rewritten']:>8,} "
                  f"{r['carried'] // 4:>13,}  {r['key']}")
    return 0


# --- tool-calls: what each call costs in responses ---------------------------
# A response pays for the whole context, so a call's real price is the response after it. Each
# count below carries `ctx`: the context tokens of the responses that pattern caused.
FAIL_CLASSES = (
    ("denied", re.compile(r"^(The user doesn't want to proceed|Permission (to use|for this)|User rejected)")),
    ("hook", re.compile(r"^(<tool_use_error>)?\w*(Pre|Post)ToolUse\S* hook error")),
    ("no-tool", re.compile(r"No such tool available")),
    ("bad-input", re.compile(r"InputValidationError")),
    ("not-read", re.compile(r"has not been read yet|modified since read")),
    ("edit-miss", re.compile(r"String to replace not found|Found \d+ matches")),
    ("no-file", re.compile(r"File does not exist|EISDIR|Path does not exist")),
    ("zsh", re.compile(r"\(eval\):\d+: (no matches found|defining function based on alias|parse error|bad math|= not found)")),
    ("exit-empty", re.compile(r"^Exit code \d+\s*$")),
    ("exit", re.compile(r"^Exit code \d+")),
)
READONLY_HEADS = set("sed cat head tail ls rg grep find wc cut sort uniq jq awk stat file tree du df which pwd "
                     "echo printf nl diff readlink basename dirname date tr fd less bat".split())
READONLY_SUB = re.compile(r"^(git (status|log|show|diff|branch|rev-parse|rev-list|grep|ls-files|blame|worktree|remote"
                          r"|cat-file|merge-base|describe|shortlog)|gh (pr|run|issue|repo|api|release) ?(view|list|"
                          r"checks|diff|status)?$|agent-queue list|notes (list|show|board|ptask)|claude-recall .*)")
TASK_DONE = re.compile(r"<tool-use-id>(toolu_\w+)</tool-use-id>")
BG_OUTPUT = re.compile(r"/tasks/[\w.-]+\.output")
WORD = re.compile(r"[\w./~@:-]{5,}")
RUNNER_COMMANDS = ("fleet-lead", "fleet-overseer")


def readonly_call(name, inp):
    if name in ("Read", "Grep", "Glob", "WebFetch", "WebSearch", "ToolSearch"):
        return True
    if name != "Bash" or inp.get("run_in_background"):
        return False
    cmd = inp.get("command") or ""
    if re.search(r"(?<![0-9&])>(?!&)|\btee\b|sed -i|-delete|-exec|<<", cmd):
        return False
    for seg in SEGMENTS.split(cmd.strip()):
        h = bash_head(seg)
        if h != "?" and h not in READONLY_HEADS and not READONLY_SUB.match(h):
            return False
    return True


def session_kind(path, entrypoint, prompt):
    if "subagents" in path.parts:
        return "subagent"
    m = re.match(r"\s*<command-message>([\w:-]+)", prompt or "")
    if entrypoint == "sdk-cli" or (m and m.group(1) in RUNNER_COMMANDS):
        return "runner"
    return "dispatched" if m and m.group(1) == "one-shot" else "hand"


def fail_class(text):
    for name, pat in FAIL_CLASSES:
        if pat.search(text[:300]):
            return name
    return "other"


def result_text(b):
    rc = b.get("content")
    if isinstance(rc, list):
        return "".join(x.get("text") or "" for x in rc if isinstance(x, dict))
    return str(rc or "")


def tool_calls_file(path, since, until, seen_msgs, emit):
    """Stream one transcript into responses and results, then emit('stat', key, n) per measure."""
    resps, results, seg, entry, prompt, project = [], {}, 0, None, None, None
    by_mid, notified = {}, {}
    for line in path.open(errors="replace"):
        if '"compact_boundary"' in line:
            seg += 1
            continue
        if "<task-notification>" in line and '"tool_result"' not in line:
            rec = parse_line(line)
            m = rec and TASK_DONE.search(json.dumps(rec.get("message") or rec.get("content") or ""))
            if m and rec.get("timestamp"):
                notified.setdefault(m.group(1), (str(rec.get("timestamp") or ""), len(resps)))
            continue
        if '"type":"assistant"' not in line and '"type":"user"' not in line:
            continue
        rec = parse_line(line)
        if not rec:
            continue
        if project is None and rec.get("cwd"):
            project = stats_repo(project_of(rec, path))
        msg = rec.get("message") or {}
        if rec.get("type") == "user":
            if prompt is None and not rec.get("isMeta"):
                entry, prompt = rec.get("entrypoint"), user_text(rec) or None
            for b in msg.get("content") or [] if isinstance(msg.get("content"), list) else []:
                if isinstance(b, dict) and b.get("type") == "tool_result":
                    results[b.get("tool_use_id")] = (result_text(b), bool(b.get("is_error")))
            continue
        if rec.get("type") != "assistant":
            continue
        mid = msg.get("id")
        if not mid or (mid in seen_msgs and mid not in by_mid):
            continue
        r = by_mid.get(mid)
        if r is None:
            seen_msgs.add(mid)
            u = msg.get("usage") or {}
            r = by_mid[mid] = {"ts": str(rec.get("timestamp") or ""), "seg": seg, "calls": [],
                               "ctx": sum(int(u.get(f) or 0) for f in USAGE_FIELDS[:3])}
            resps.append(r)
        for b in msg.get("content") or []:
            if isinstance(b, dict) and b.get("type") == "tool_use":
                r["calls"].append((b.get("id"), b.get("name") or "?", b.get("input") or {}))
    kind = session_kind(path, entry, prompt)
    project = project or "?"
    emit("session", kind, project)
    last_in_seg, seen_words, repeats, edits = {}, set(), {}, 0
    for i, r in enumerate(resps):
        last_in_seg[r["seg"]] = i
    for i, r in enumerate(resps):
        nxt = resps[i + 1] if i + 1 < len(resps) and resps[i + 1]["seg"] == r["seg"] else None
        later = last_in_seg[r["seg"]] - i
        win = since <= r["ts"] < until
        if win:
            emit("n", kind, project, "responses", 1, r["ctx"])
            if r["calls"]:
                emit("n", kind, project, "tool_responses", 1, r["ctx"])
            if len(r["calls"]) > 1:
                emit("n", kind, project, "parallel_responses", 1, r["ctx"])
        mutated = False
        for tid, name, inp in r["calls"]:
            text, err = results.get(tid, ("", False))
            ro = readonly_call(name, inp)
            mutated = mutated or not ro
            seen_words.update(WORD.findall(json.dumps(inp)))
            key = None
            if name == "Bash":
                key = ("Bash", inp.get("command"))
            elif name == "Read":
                key = ("Read", inp.get("file_path"), inp.get("offset"), inp.get("limit"))
            elif name in ("Grep", "Glob"):
                key = (name, json.dumps(inp, sort_keys=True))
            prior = repeats.get(key) if key else None
            if key:
                repeats[key] = (r["seg"], edits)
            if not win:
                continue
            nctx = nxt["ctx"] if nxt else 0
            head = bash_head(inp.get("command") or "") if name == "Bash" else name
            emit("tool", name, len(text), len(text) * later, nctx)
            emit("n", kind, project, "calls", 1, nctx)
            if name.startswith("mcp__"):
                emit("group", "mcp", name.split("__")[1], 1, len(text) * later, nctx)
            if prior and prior[0] == r["seg"] and ro:
                emit("n", kind, project, "repeat_calls", 1, nctx)
                emit("group", "repeat", head, 1, len(text) * later, nctx)
                if prior[1] == edits:
                    emit("n", kind, project, "repeat_unchanged", 1, nctx)
            if err:
                fc = fail_class(text)
                emit("n", kind, project, "failed", 1, nctx)
                emit("group", "fail", fc, 1, len(text) * later, nctx)
                masked = re.sub(r"\d+", "N", re.sub(r"^Exit code \d+\s*", "", text)[:56]).replace("\n", " ")
                emit("group", "fail_text", f"{fc}: {head}: {masked}", 1, 0, nctx)
                if nxt and any(n == name for _, n, _ in nxt["calls"]):
                    same = any(n == name and x == inp for _, n, x in nxt["calls"])
                    emit("group", "retry", "same input" if same else "changed input", 1, 0, nctx)
            if name == "ToolSearch":
                emit("n", kind, project, "toolsearch", 1, nctx)
            if name == "Agent":
                emit("group", "agent", inp.get("subagent_type") or "general-purpose", 1,
                     len(text) * later, nctx)
            if name == "Bash" and inp.get("run_in_background"):
                emit("group", "background", "started", 1, 0, nctx)
                done = notified.get(tid)
                if done:
                    secs = (datetime.fromisoformat(done[0].replace("Z", "+00:00"))
                            - datetime.fromisoformat(r["ts"].replace("Z", "+00:00"))).total_seconds()
                    busy = done[1] - i - 2  # responses beyond the start's ack
                    wake = resps[done[1]]["ctx"] if done[1] < len(resps) else 0
                    band = "under 2m" if secs < 120 else "2-10m" if secs < 600 else "over 10m"
                    state = "worked meanwhile" if busy > 0 else "idle"
                    emit("group", "bg_wait", f"{band}, {state}", 1, 0, wake + nctx)
                    if band != "over 10m" and busy <= 0:
                        emit("group", "bg_short_idle", head, 1, 0, wake + nctx)
                else:
                    emit("group", "bg_wait", "no notification", 1, 0, nctx)
            elif name == "Bash" and "moved to the background" in text[:400]:
                emit("group", "background", "timed out into background", 1, 0, nctx)
            cmd = str(inp.get("command") or inp.get("file_path") or "")
            if BG_OUTPUT.search(cmd):
                emit("group", "background", "read task output", 1, len(text) * later, nctx)
            elif name == "Bash" and re.search(r"\bsleep\b|\buntil\b", cmd):
                emit("group", "background", "sleep or until loop", 1, len(text) * later, nctx)
            elif name in ("Monitor", "TaskOutput"):
                emit("group", "background", name, 1, 0, nctx)
        # Serial: this response and the next were read-only, none of this one's calls failed and
        # the next used nothing new from their results, so one response could have carried both.
        # An upper bound: a model can pick its next look from a result without quoting it.
        if win and nxt and r["calls"] and nxt["calls"] \
                and all(readonly_call(n, x) for _, n, x in r["calls"] + nxt["calls"]) \
                and not any(results.get(t, ("", False))[1] for t, _, _ in r["calls"]):
            shown = " ".join(results.get(t, ("", False))[0] for t, _, _ in r["calls"])
            words = {w for _, _, x in nxt["calls"] for w in WORD.findall(json.dumps(x))} - seen_words
            if not any(w in shown for w in words):
                emit("n", kind, project, "serial_batchable", 1, nxt["ctx"])
                emit("group", "serial", bash_head(nxt["calls"][0][2].get("command") or "")
                     if nxt["calls"][0][1] == "Bash" else nxt["calls"][0][1], 1, 0, nxt["ctx"])
        edits += mutated


def cmd_tool_calls(a):
    since = window_bound(a.since or (datetime.now(timezone.utc) - timedelta(days=a.days)).strftime("%Y-%m-%d"))
    until = window_bound(a.until)[0] if a.until else "9999"
    buckets, groups, tools, sessions = {}, {}, {}, {}

    def emit(what, *v):
        if what == "session":
            if not a.project or a.project in v[1]:
                for k in (f"kind:{v[0]}", f"project:{v[1]}", "all"):
                    sessions[k] = sessions.get(k, 0) + 1
        elif what == "n":
            kind, project, field, n, ctx = v
            if a.project and a.project not in project:
                return
            for k in (f"kind:{kind}", f"project:{project}", "all"):
                b = buckets.setdefault(k, {})
                b[field] = b.get(field, 0) + n
                b[field + "_ctx"] = b.get(field + "_ctx", 0) + ctx
        elif what == "tool":
            name, chars, carried, nctx = v
            t = tools.setdefault(name, {"key": name, "calls": 0, "chars": 0, "carried": 0, "next_ctx": 0})
            t["calls"] += 1
            t["chars"] += chars
            t["carried"] += carried
            t["next_ctx"] += nctx
        else:
            group, key, n, carried, ctx = v
            g = groups.setdefault(group, {}).setdefault(key, {"key": key, "calls": 0, "carried": 0, "ctx": 0})
            g["calls"] += n
            g["carried"] += carried
            g["ctx"] += ctx

    seen, seen_msgs = set(), set()
    for f in iter_files():
        try:
            real = f.resolve()
            if real in seen or real.stat().st_mtime < since[1]:
                continue
        except OSError:
            continue
        seen.add(real)
        tool_calls_file(real, since[0], until, seen_msgs, emit)
    out = {"since": since[0], "until": a.until and until, "sessions": sessions, "buckets": buckets,
           "tools": sorted(tools.values(), key=lambda t: -t["next_ctx"])[:a.top or None],
           "groups": {g: sorted(v.values(), key=lambda r: -r["ctx"])[:a.top or None]
                      for g, v in groups.items()}}
    if a.json:
        print(json.dumps(out, indent=1))
        return 0
    al = buckets.get("all", {})
    resp, ctx = al.get("responses", 0), al.get("responses_ctx", 0)
    print(c(BOLD, f"since {since[0]}: {sessions.get('all', 0):,} sessions, {resp:,} responses, "
                  f"{al.get('calls', 0):,} tool calls"))
    print(f"  {ctx // max(resp, 1):,} context tokens per response, {ctx:,} in all; "
          f"{100 * al.get('parallel_responses', 0) / max(al.get('tool_responses', 0), 1):.1f}% of "
          f"tool responses carried more than one call\n")
    head = f"  {'sessions':>8} {'responses':>9} {'calls':>8} {'ctx/resp':>8} {'parallel':>8} {'serial':>7} {'failed':>7} {'repeat':>6} {'search':>6}  bucket"
    print(c(DIM, head))
    rows = sorted((k for k in buckets if k != "all"), key=lambda k: (k[0] != "k", -buckets[k].get("responses_ctx", 0)))
    for k in [x for x in rows if x.startswith("kind:")] + [x for x in rows if x.startswith("project:")][:a.top or None]:
        b = buckets[k]
        print(f"  {sessions.get(k, 0):>8,} {b.get('responses', 0):>9,} {b.get('calls', 0):>8,} "
              f"{b.get('responses_ctx', 0) // max(b.get('responses', 0), 1):>8,} {b.get('parallel_responses', 0):>8,} "
              f"{b.get('serial_batchable', 0):>7,} {b.get('failed', 0):>7,} {b.get('repeat_calls', 0):>6,} "
              f"{b.get('toolsearch', 0):>6,}  {k}")
    print(c(DIM, f"\n  {'calls':>8} {'ctx tokens':>14} {'carried~tok':>12}  tool, by the response after it"))
    for t in out["tools"]:
        print(f"  {t['calls']:>8,} {t['next_ctx']:>14,} {t['carried'] // 4:>12,}  {t['key']}")
    titles = (("serial", "serial reads one response could have carried (upper bound), by the later call"),
              ("repeat", "exact repeats in one stretch, by call"), ("fail", "failed calls, by class"),
              ("fail_text", "failed calls, by message"), ("retry", "the response after a failure"),
              ("background", "background shells and how they are waited on"),
              ("bg_wait", "background shells by run time; ctx is the start ack plus the wake"),
              ("bg_short_idle", "background runs under 10m with nothing else done, by command"),
              ("agent", "Agent spawns; carried is the parent's cost of the report"),
              ("mcp", "MCP calls by server"))
    for g, title in titles:
        if out["groups"].get(g):
            print(c(DIM, f"\n  {'calls':>8} {'ctx tokens':>14} {'carried~tok':>12}  {title}"))
            for r in out["groups"][g]:
                print(f"  {r['calls']:>8,} {r['ctx']:>14,} {r['carried'] // 4:>12,}  {r['key']}")
    return 0


def main():
    p = argparse.ArgumentParser(prog="claude-recall", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("search", help="full-text/regex search across transcripts")
    s.add_argument("term")
    s.add_argument("--project", "-p", help="substring match on project (cwd basename)")
    s.add_argument("--branch", "-b", help="exact gitBranch match")
    s.add_argument("--since", help="only messages on/after YYYY-MM-DD")
    s.add_argument("--role", choices=["user", "assistant"])
    s.add_argument("--regex", action="store_true", help="treat TERM as a regex")
    s.add_argument("--thinking", action="store_true", help="include thinking blocks")
    s.add_argument("--ignore-case", "-i", action="store_true")
    s.add_argument("--context", type=int, default=120, help="chars of snippet context")
    s.add_argument("--limit", type=int, default=40, help="max matches (0 = all)")
    s.set_defaults(func=cmd_search)

    ls = sub.add_parser("list", help="recent sessions with titles")
    ls.add_argument("--project", "-p")
    ls.add_argument("--limit", type=int, default=30, help="max sessions (0 = all)")
    ls.set_defaults(func=cmd_list)

    sh = sub.add_parser("show", help="print a full session by id/prefix")
    sh.add_argument("session")
    sh.add_argument("--thinking", action="store_true")
    sh.set_defaults(func=cmd_show)

    cd = sub.add_parser("cards", help="one TSV summary row per session (index feed)")
    cd.add_argument("--since-mtime", type=float, default=0,
                    help="only sessions whose transcript changed after this epoch")
    cd.add_argument("--verbose", "-v", action="store_true", help="count to stderr")
    cd.set_defaults(func=cmd_cards)

    st = sub.add_parser("stats", help="count slash commands, skills, subagents, repeated prompts")
    st.add_argument("--days", type=int, default=30, help="window in days (default 30)")
    st.add_argument("--since", help="window start YYYY-MM-DD (overrides --days)")
    st.add_argument("--kind", help="comma list of " + ",".join(STATS_KINDS) + " (default all)")
    st.add_argument("--origin", choices=["interactive", "auto", "all"], default="all",
                    help="interactive = a turn in a CLI session (typed, or a dispatched task); "
                         "auto = headless, /loop fires, peer messages")
    st.add_argument("--by", choices=["week", "project"], help="split counts by ISO week or repo")
    st.add_argument("--top", type=int, default=20, help="rows per kind and bucket (0 = all)")
    st.add_argument("--min", type=int, default=1, help="drop rows seen in fewer sessions")
    st.add_argument("--min-words", type=int, default=3,
                    help="prompts shorter than this after masking are not counted")
    st.add_argument("--project", "-p", help="substring match on repo")
    st.add_argument("--json", action="store_true")
    st.set_defaults(func=cmd_stats)

    to = sub.add_parser("tool-output", help="token use and the tool output behind it")
    to.add_argument("--days", type=int, default=7, help="window in days (default 7)")
    to.add_argument("--since", help="window start: YYYY-MM-DD (a UTC day) or an ISO time "
                                     "(overrides --days)")
    to.add_argument("--until", help="window end, exclusive, in the same forms (default now)")
    to.add_argument("--long-turns", type=int, default=LONG_TURNS,
                    help=f"responses without a compaction that make a long run (default {LONG_TURNS})")
    to.add_argument("--by", choices=["tool", "command", "filetype", "kind", "method", "day", "week",
                                     "project"],
                    default="tool", help="command = Bash calls by command head; filetype = Read and "
                                         "sed/cat/head/tail by the file's class and extension; kind = "
                                         "main session or subagent; method = token-filter method windows")
    to.add_argument("--top", type=int, default=25, help="rows for tool/command/project (0 = all)")
    to.add_argument("--project", "-p", help="substring match on repo")
    to.add_argument("--json", action="store_true")
    to.set_defaults(func=cmd_tool_output)

    tc = sub.add_parser("tool-calls", help="what tool calls cost in responses, by session kind")
    tc.add_argument("--days", type=int, default=7, help="window in days (default 7)")
    tc.add_argument("--since", help="window start, as tool-output (overrides --days)")
    tc.add_argument("--until", help="window end, exclusive, as tool-output")
    tc.add_argument("--top", type=int, default=15, help="rows per group (0 = all)")
    tc.add_argument("--project", "-p", help="substring match on repo")
    tc.add_argument("--json", action="store_true")
    tc.set_defaults(func=cmd_tool_calls)

    a = p.parse_args()
    sys.exit(a.func(a) or 0)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
