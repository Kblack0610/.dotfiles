#!/usr/bin/env bash
# session-snapshot - spin the fleet down for a planned reboot or upgrade, and back up after it.
#
#   session-snapshot down [--dry-run] ["<reason>"]   hold dispatch, pause the agentctl runners, write the marker
#   session-snapshot up [--dry-run]                  hand the reopens to the restore walk, undo what down set, clear the marker
#   session-snapshot status                          the marker and what it holds, and what is still to reopen; rc 1 while down
#
# down sets only what is not already set and writes what it set into the marker, so up never lifts
# a hold or a pause somebody else put up. Nothing is parked or killed: the reboot stops the sessions,
# and `fleet-dispatch restore` reopens them from the pane record, in fleet-restore.service, not in up.
# session-snapshot-up.service runs `up` at boot only while the marker exists. The inventory half and the why: the session-snapshot skill.

set -uo pipefail

MARKER="${AGENT_MAINTENANCE:-$HOME/.agent/maintenance}"
# One down or up at a time on this machine. down reads the levers and writes the marker last, so
# two overlapping downs each took the other's dispatch hold for somebody else's, and up never lifted
# it (ar-3600). Machine-local like the levers, not beside the marker in the synced ~/.agent, and not
# read from XDG_RUNTIME_DIR: a caller with a stripped env (ssh, cron) would lock a different file.
LOCK="${SESSION_SNAPSHOT_LOCK:-/run/user/$(id -u)/session-snapshot.lock}"
LOCK_WAIT="${SESSION_SNAPSHOT_LOCK_WAIT:-300}"

say() { printf 'session-snapshot: %s\n' "$*"; }
field() { sed -n "/^$1: /{s///p;q;}" "$MARKER" 2>/dev/null; }
dispatch_held() { agent-hold list 2>/dev/null | awk -F'\t' '$1 == "dispatch" { found = 1 } END { exit !found }'; }
# agentctl has no read verb for the pause; list leads with it.
fleet_paused() { agentctl list 2>/dev/null | grep -q '^PAUSED since'; }
PANES="${FLEET_DISPATCH_DIR:-$HOME/.agent/dispatch}/panes"
# conversations <pane record>... -> the Claude conversations those records hold.
conversations() {
  local f files=()
  for f in "$@"; do [ -r "$f" ] && files+=("$f"); done
  [ "${#files[@]}" -gt 0 ] || { echo 0; return; }
  jq -s '[.[].panes[]? | select(.claude != "")] | length' "${files[@]}" 2>/dev/null || echo 0
}
# on_record -> conversations on the live pane records (not a .lost or .restored one): what restore would reopen.
on_record() {
  local f files=()
  for f in "$PANES"/*.json; do
    case $f in *.lost.json | *.restored.json) continue ;; esac
    files+=("$f")
  done
  conversations "${files[@]}"
}
# still_lost -> conversations on this machine's lost pane records: what the restore walk has not reopened yet.
still_lost() { conversations "$PANES"/*.lost.json; }
# undo <set word> -- lift one thing down set; rc 1 when the lever refused.
undo() {
  case $1 in
    agentctl-pause) agentctl resume >/dev/null ;;
    dispatch-hold) agent-hold release dispatch >/dev/null ;;
    *) return 0 ;;
  esac
}
# write_marker <reason> <since> <set words...>
write_marker() {
  local reason=$1 since=$2; shift 2
  mkdir -p "$(dirname "$MARKER")"
  printf 'since: %s\nreason: %s\nset: %s\n' "$since" "$reason" "$*" > "$MARKER"
}

# locked <verb> <args...> -- rerun this script under $LOCK. -o closes the lock fd in the rerun, so a
# process up starts (a reopened session) cannot keep holding it after up exits.
locked() {
  local rc
  SESSION_SNAPSHOT_LOCKED=1 flock -o -E 75 -w "$LOCK_WAIT" "$LOCK" "$BASH" "$(realpath "${BASH_SOURCE[0]}")" "$@"
  rc=$?
  [ "$rc" != 75 ] || say "another session-snapshot down or up still holds $LOCK after ${LOCK_WAIT}s; nothing changed"
  return "$rc"
}

cmd_status() {
  local lost
  lost=$(still_lost)
  if [ ! -e "$MARKER" ]; then
    echo "up: no planned reboot in progress"
  else
    echo "down since $(field since): $(field reason)"
    echo "set by down: $(field set)"
    echo "undo with: session-snapshot up"
  fi
  [ "$lost" = 0 ] || echo "still to reopen here: $lost conversation(s) on lost pane records (the restore walk, or by hand: fleet-dispatch restore)"
  [ -e "$MARKER" ] || return 0
  return 1
}

cmd_down() {
  local dry=0 words=() w
  for w in "$@"; do
    case $w in
      --dry-run) dry=1 ;;
      -*) say "down: unknown flag $w"; return 2 ;;
      *) words+=("$w") ;;
    esac
  done
  local reason="${words[*]:-planned reboot}"
  if [ -e "$MARKER" ]; then cmd_status; return 0; fi
  local set=() why="maintenance: $reason"
  if dispatch_held; then
    say "dispatch already held, left as it is"
  elif [ "$dry" = 1 ]; then
    say "would hold dispatch: $why"
  elif agent-hold set dispatch --by session-snapshot "$why" >/dev/null; then
    set+=(dispatch-hold)
  else
    say "down: agent-hold set dispatch failed; nothing left set"; return 1
  fi
  if fleet_paused; then
    say "agentctl already paused, left as it is"
  elif [ "$dry" = 1 ]; then
    say "would pause agentctl: $why"
  elif agentctl pause "$why" >/dev/null; then
    set+=(agentctl-pause)
  else
    for w in "${set[@]}"; do undo "$w"; done
    say "down: agentctl pause failed; nothing left set"; return 1
  fi
  if [ "$dry" = 1 ]; then
    say "would reopen $(on_record) conversation(s) at the next boot"
    return 0
  fi
  # A record now, so the restore point holds the panes as they are at the moment of going down.
  fleet-dispatch record >/dev/null 2>&1 || say "fleet-dispatch record failed; the last minute's record stands"
  write_marker "$reason" "$(date -Iseconds)" "${set[@]}"
  say "down: ${set[*]:-nothing new to set}; $(on_record) conversation(s) will reopen at the next boot"
  say "reboot when ready; not rebooting after all: session-snapshot up"
}

cmd_up() {
  local dry=0 w
  for w in "$@"; do
    case $w in
      --dry-run) dry=1 ;;
      *) say "up: unknown argument $w"; return 2 ;;
    esac
  done
  if [ ! -e "$MARKER" ]; then
    echo "up: no planned reboot in progress, nothing to do"
    return 0
  fi
  local reason since set=() restore rc=0 undone=() left=() prio=low reopen_failed=0
  reason=$(field reason); since=$(field since)
  read -ra set <<<"$(field set)"
  if [ "$dry" = 1 ]; then
    fleet-dispatch restore --dry-run
    for w in "${set[@]}"; do say "would undo $w"; done
    return 0
  fi
  # The reopens are handed to the restore walk in fleet-restore.service (`restore --defer`), never
  # walked here: each one waits on its claude, and on 2026-11-19 a walk in this unit reopened 12 of 23
  # before its 600s start timeout killed up with both levers still set (ar-3601). So up reopens none
  # itself and returns in seconds. The order the hold kept, no pass starting new work into a session
  # still coming back, is kept by dispatch itself: its gate reads closed while the walk runs
  # (fleet-dispatch restore_walking), and a walk cut short is walked again by the minute record.
  restore=$(fleet-dispatch restore --defer 2>&1) || { rc=1; prio=normal; reopen_failed=1; }
  printf '%s\n' "$restore"
  # In reverse of down, so dispatch, set first, is released last, once the runners are back.
  local i
  for (( i = ${#set[@]} - 1; i >= 0; i-- )); do
    if undo "${set[i]}"; then undone+=("${set[i]}"); else left+=("${set[i]}"); fi
  done
  # A lever that refused stays on the marker, so a rerun of up retries exactly it.
  if [ "${#left[@]}" -gt 0 ]; then
    write_marker "$reason" "$since" "${left[@]}"; rc=1; prio=high
  else
    rm -f "$MARKER"
  fi
  local summary tail=''
  # Reopened now is always 0: every conversation is left to the walk, which wakes the prompted ones in batches.
  summary=$(printf '%s\n' "$restore" | grep -E 'handed [0-9]+ conversation|could not start fleet-restore|no lost server' | paste -sd ';' -)
  [ "${#left[@]}" = 0 ] || tail+=". Still set: ${left[*]}, rerun session-snapshot up"
  [ "$reopen_failed" = 0 ] || tail+=". The walk did not start everywhere: fleet-dispatch restore"
  tail+=". Reopened now: 0; what is still to reopen: session-snapshot status"
  agent-notify -p "$prio" -t "back up after: ${reason:-planned reboot}" \
    "${summary:-restore printed nothing}; undone: ${undone[*]:-nothing}$tail" || say "could not page"
  say "up: undone ${undone[*]:-nothing}${left:+, still set ${left[*]}}"
  return "$rc"
}

case "${1:-}" in
  down | up)
    # A dry run changes nothing, so it previews without waiting on a running down or up.
    case " $* " in *" --dry-run "*) ;; *) [ -n "${SESSION_SNAPSHOT_LOCKED:-}" ] || { locked "$@"; exit; } ;; esac
    # Not passed on: a session up reopens would otherwise skip the lock on its own down.
    unset SESSION_SNAPSHOT_LOCKED
    verb=$1; shift; "cmd_$verb" "$@" ;;
  status) cmd_status ;;
  -h|--help|help|'') sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) say "unknown verb: $1"; exit 2 ;;
esac
