#!/usr/bin/env python3
"""shape-grow - list the long functions a change makes longer.

Usage: shape-grow [-C <dir>] <base> <head>

For each Python, shell or Rust file the change touches, measures every function at <base> and at
<head> and prints `path:line name base->head` for each one that is over LIMIT lines at <head> and
longer than at <base> (a new function counts from 0). Exit 0 when it prints nothing, 1 when it
prints a function, 2 on a usage or git error.

The rule it backs, checked by agent-land's shape gate: a function over LIMIT lines does not get
longer. Extract the new logic as a pure function (inputs in, result out) and call it: a helper that
mutates shared state only moves the length, and makes the caller order-dependent. When that cannot
be done in this PR, the PR body names an open board row that names the function and will split it,
"Split: <row id>". Measured 2026-11-04..18: 291 of 1660 dotfiles merges and 22 of 789 home-config
merges would have tripped it, 85% of the dotfiles ones on 10 functions. Why: 2026-11-18
ci-runner-governor's decide() grew from 34 to 269 lines across 35 sessions, each PR adding a few
lines to one function, and no review read the whole function.

Python is measured with ast. Shell and Rust end a function at the first later line that closes a
brace at the definition's own indent (rustfmt and this repo's shell style both do that). That is
rough, but it runs the same way on both sides, so the growth it reports holds.
"""
import ast
import re
import subprocess
import sys

LIMIT = 150

SH_DEF = re.compile(r'^(\s*)(?:function\s+)?([A-Za-z_][\w:.-]*)\s*\(\)\s*(\{.*)?$')
RS_DEF = re.compile(r'^(\s*)(?:pub(?:\([^)]*\))?\s+)?(?:(?:const|async|unsafe|extern\s+"[^"]*")\s+)*fn\s+(\w+)')


def git(args, cwd):
    return subprocess.run(['git', '-C', cwd] + args, capture_output=True, encoding='utf-8', errors='replace')


def blob(ref, path, cwd):
    r = git(['show', f'{ref}:{path}'], cwd)
    return r.stdout if r.returncode == 0 and '\0' not in r.stdout else ''


def kind(path, text):
    if path.endswith('.py'):
        return 'py'
    if path.endswith('.rs'):
        return 'rs'
    if path.endswith('.bats'):
        return None  # @test blocks are not functions, and helpers defined inside them nest
    if path.endswith(('.sh', '.bash')):
        return 'sh'
    first = text.split('\n', 1)[0]
    if first.startswith('#!'):
        if 'python' in first:
            return 'py'
        if re.search(r'\b(ba|z|da)?sh\b', first):
            return 'sh'
    return None


def py_funcs(text):
    try:
        tree = ast.parse(text)
    except SyntaxError:
        return []
    out = []

    def walk(node, prefix):
        for child in ast.iter_child_nodes(node):
            if isinstance(child, (ast.FunctionDef, ast.AsyncFunctionDef)):
                out.append((prefix + child.name, child.lineno, child.end_lineno - child.lineno + 1))
                walk(child, prefix + child.name + '.')
            elif isinstance(child, ast.ClassDef):
                walk(child, prefix + child.name + '.')
            else:
                walk(child, prefix)

    walk(tree, '')
    return out


def indent_funcs(text, pattern, lang):
    lines = text.split('\n')
    out = []
    for i, line in enumerate(lines):
        m = pattern.match(line)
        if not m:
            continue
        indent, name = m.group(1), m.group(2)
        if lang == 'rs':
            # A signature runs until a line ends in "{" (a body) or ";" (a trait declaration).
            j = i
            while j < len(lines) and not lines[j].rstrip().endswith(('{', ';')):
                j += 1
            if j == len(lines) or lines[j].rstrip().endswith(';'):
                continue
            if lines[j].rstrip().endswith('}'):
                out.append((name, i + 1, 1))
                continue
        elif m.group(3) and m.group(3).rstrip().endswith('}'):
            out.append((name, i + 1, 1))  # f() { ...; } on one line
            continue
        close = re.compile('^' + re.escape(indent) + r'\}')
        for k in range(i + 1, len(lines)):
            if close.match(lines[k]):
                out.append((name, i + 1, k - i + 1))
                break
            nxt = pattern.match(lines[k])
            if nxt and len(nxt.group(1)) <= len(indent):
                break  # the next definition came first: this one's end was missed, so leave it unmeasured
    return out


def funcs(path, text):
    lang = kind(path, text)
    if lang == 'py':
        return py_funcs(text)
    if lang == 'rs':
        return indent_funcs(text, RS_DEF, 'rs')
    if lang == 'sh':
        return indent_funcs(text, SH_DEF, 'sh')
    return []


def keyed(found):
    """name -> (line, length), with a repeated name (Rust's many `new`) keyed by its occurrence."""
    seen, out = {}, {}
    for name, line, length in found:
        n = seen.get(name, 0)
        seen[name] = n + 1
        out[name if n == 0 else f'{name}#{n + 1}'] = (line, length)
    return out


def main(argv):
    cwd = '.'
    if len(argv) >= 2 and argv[0] == '-C':
        cwd, argv = argv[1], argv[2:]
    if len(argv) != 2 or argv[0].startswith('-'):
        print(__doc__.split('\n\n')[1], file=sys.stderr)
        return 2
    base, head = argv
    r = git(['diff', '--name-only', '--diff-filter=AMR', base, head], cwd)
    if r.returncode != 0:
        print(f'shape-grow: git diff {base} {head}: {r.stderr.strip()}', file=sys.stderr)
        return 2
    hits = []
    for path in filter(None, r.stdout.split('\n')):
        new_text = blob(head, path, cwd)
        new = keyed(funcs(path, new_text))
        if not any(length > LIMIT for _, length in new.values()):
            continue
        old = keyed(funcs(path, blob(base, path, cwd)))
        for name, (line, length) in new.items():
            was = old.get(name, (0, 0))[1]
            if length > LIMIT and length > was:
                hits.append(f'{path}:{line} {name} {was}->{length}')
    for h in hits:
        print(h)
    return 1 if hits else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
