{
  "cleanupPeriodDays": 365,
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "150000",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read(//**)",
      "Edit(//**)",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Task",
      "Skill",
      "NotebookEdit",
      "mcp__context7",
      "mcp__playwright",
      "mcp__claude_ai_Gmail",
      "mcp__claude_ai_Google_Drive",
      "mcp__figma__get_screenshot",
      "mcp__figma__get_metadata"
    ],
    "deny": [
      "Bash(sudo)",
      "Bash(sudo *)",
      "Bash(su)",
      "Bash(su *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/)",
      "Bash(rm -rf --no-preserve-root*)",
      "Bash(dd if=*)",
      "Bash(dd of=/dev/*)",
      "Bash(mkfs*)",
      "Bash(mkfs.* *)",
      "Bash(shred *)",
      "Bash(wipefs *)",
      "Bash(fdisk *)",
      "Bash(parted *)",
      "Bash(chmod -R 777 /)",
      "Bash(chmod -R 777 /*)",
      "Bash(chown -R * /)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push --force-if-includes*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git clean -fx*)",
      "Bash(git clean -ffd*)",
      "Bash(git clean -f)",
      "Bash(git clean -f *)",
      "Bash(git clean -fdx*)",
      "Bash(git clean -xdf*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(curl * | zsh)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(>/dev/sda*)",
      "Bash(>/dev/nvme*)",
      "Read(/etc/shadow)",
      "Read(/etc/sudoers)",
      "Read(/etc/sudoers.d/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/*.pem)",
      "Edit(/etc/shadow)",
      "Edit(/etc/sudoers)",
      "Edit(/etc/sudoers.d/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(~/.agent/sessions/**/*-wind-down.md)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/id_rsa)",
      "Read(//**/id_ed25519)",
      "Read(//**/id_ecdsa)",
      "Read(//**/*.pem)",
      "Read(//**/.ssh/**/id_*)",
      "Read(//**/.ssh/**/*key*)",
      "Read(//**/.ssh/**/*_rsa*)",
      "Read(//**/.ssh/**/*_ed25519*)",
      "Read(//**/.ssh/**/*_ecdsa*)",
      "Read(//**/.ssh/**/*_dsa*)",
      "Read(//**/.ssh/**/known_hosts*)",
      "Read(//**/.ssh/**/*.ppk)",
      "Read(//**/.ssh/**/*.bak)",
      "Read(//**/.ssh/**/*.old)",
      "Read(//etc/shadow)",
      "Read(//etc/sudoers)",
      "Read(//etc/sudoers.d/**)",
      "Edit(//**/.env)",
      "Edit(//**/.env.*)",
      "Edit(//**/id_rsa)",
      "Edit(//**/id_ed25519)",
      "Edit(//**/id_ecdsa)",
      "Edit(//**/*.pem)",
      "Edit(//**/.ssh/**/id_*)",
      "Edit(//**/.ssh/**/*key*)",
      "Edit(//**/.ssh/**/*_rsa*)",
      "Edit(//**/.ssh/**/*_ed25519*)",
      "Edit(//**/.ssh/**/*_ecdsa*)",
      "Edit(//**/.ssh/**/*_dsa*)",
      "Edit(//**/.ssh/**/known_hosts*)",
      "Edit(//**/.ssh/**/*.ppk)",
      "Edit(//**/.ssh/**/*.bak)",
      "Edit(//**/.ssh/**/*.old)",
      "Edit(//etc/shadow)",
      "Edit(//etc/sudoers)",
      "Edit(//etc/sudoers.d/**)",
      "Edit(~/.config/gh/**)"
    ],
    "defaultMode": "plan",
    "disableAutoMode": "disable"
  },
  "model": "opus",
  "fallbackModel": [
    "claude-sonnet-4-6",
    "claude-haiku-4-5-20251001"
  ],
  "enableAllProjectMcpServers": true,
  "skillOverrides": {
    "blind-review": "name-only",
    "changelog-draft": "name-only",
    "claude-api": "name-only",
    "compact-prep": "name-only",
    "compliance": "name-only",
    "content-rating": "name-only",
    "cred-status": "name-only",
    "dataviz": "name-only",
    "fewer-permission-prompts": "name-only",
    "figma-use": "name-only",
    "fleet-env-rebuild": "name-only",
    "flow-review": "name-only",
    "init": "name-only",
    "jira-ticket-pipeline": "name-only",
    "keybindings-help": "name-only",
    "marp-slide": "name-only",
    "meeting-ingest": "name-only",
    "metavr-cli": "name-only",
    "plugin-authoring": "name-only",
    "prod-smoke-suite": "name-only",
    "quick-demo": "name-only",
    "reaper-ops": "name-only",
    "run": "name-only",
    "runn-log-time": "name-only",
    "schedule": "name-only",
    "scope": "name-only",
    "security-review": "name-only",
    "ui-audit": "name-only"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/context-budget-guard.sh"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/plan-approved.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/long-session-handoff.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/manual-mode-investigate.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/hosted-runner-guard.py || true",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/plan-standard.sh"
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/large-read-guard.py || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/block-poll.py || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/hand_methods.py || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/walker-guards.py || true",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.dotfiles/.config/shared-hooks/session-preflight.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.dotfiles/.local/src/tmux/wind-down.sh disarm"
          },
          {
            "type": "command",
            "command": "bash ~/.dotfiles/.config/shared-hooks/ask-settle.sh answered"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/plan-standard.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.dotfiles/.config/shared-hooks/session-preflight.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.dotfiles/.config/shared-hooks/compact-prep.sh precompact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/pre-stop-checks.sh"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.dotfiles/.config/shared-hooks/worktree-create.sh"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.dotfiles/.config/shared-hooks/worktree-remove.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "subagentPromptCacheTtl": "1h",
  "effortLevel": "high",
  "autoCompactWindow": 200000,
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:ember",
  "remoteControlAtStartup": true,
  "additionalDirectories": [
    "/root",
    "/mnt/c/Users/keblack",
    "/tmp"
  ]
}
