# --- AI Tool Aliases & Wrappers ---
# Sourced from .commonrc

# --- Claude Code OpenTelemetry ---
# Moved to .config/shared-hooks/claude-telemetry.sh so the HEADLESS path can use it too.
# It lived inline here, and .ai-rc is only sourced by interactive shells - so systemd user
# services (`/bin/bash -c 'exec ${COMMAND}'`, neither interactive nor login) never saw it,
# and 835 of the last 886 sessions exported nothing. The LAN guard that keeps prompt text
# off the corporate VDI moved with it, unchanged; see that file before widening it.
# shellcheck source=/dev/null
[ -f "$HOME/.config/shared-hooks/claude-telemetry.sh" ] \
    && . "$HOME/.config/shared-hooks/claude-telemetry.sh"

# --- mem0 API key ------------------------------------------------------------
# The self-hosted mem0 server authenticates on an X-API-Key header carrying a
# m0sk_ CLIENT key, exported here for interactive mem0 calls (the mem0-ops skill).
# Without it every call 401s, which two dream-diary entries once misread as a
# server fault: the server answers 200 with the right key.
#
# The config (MEM0_BASE_URL, MEM0_USER_ID, MEM0_SECRET) and the key reader are the
# ones agent-propose, agentctl-dream and agentctl-nightly-sync use: see mem0.sh.
# Unset is a valid outcome, not a failure: on a corporate machine there is no
# mem0.env or no age key, and personal memory should not be reachable from there.
# A subshell reads it, so only the key reaches the environment: not the endpoint, the user,
# the secret path, or mem0_load and mem0_key as shell functions.
if [ -z "${MEM0_API_KEY:-}" ] && [ -r "$HOME/.local/lib/mem0.sh" ]; then
    MEM0_API_KEY="$( { . "$HOME/.local/lib/mem0.sh" && mem0_load && mem0_key; } 2>/dev/null )"
    if [ -n "$MEM0_API_KEY" ]; then export MEM0_API_KEY; else unset MEM0_API_KEY; fi
fi

# Claude Code entry point — two-case permission cycle (pairs with settings.json
# "defaultMode": "plan", which boots every session into plan mode):
#   Default (corporate-safe): bypass is NOT offered. Boots in plan; one
#     Shift+Tab toggles plan <-> default (Manual). acceptEdits also sits in
#     the ring — Claude Code has no setting to hide it.
#   CLAUDE_YOLO set (personal): adds bypassPermissions to the cycle via
#     --allow-dangerously-skip-permissions (available, NOT auto-activated), so
#     it still boots in plan and one Shift+Tab lands on bypass.
# Opt in per-machine in an UNTRACKED file (e.g. ~/.bash_profile) with:
#     export CLAUDE_YOLO=1
# Corporate machines leave it unset (the default) — bypass never appears.
claude() {
    if [ -n "$CLAUDE_YOLO" ]; then
        _claude_launch --allow-dangerously-skip-permissions "$@"
    else
        _claude_launch "$@"
    fi
}

# Claude Code reads OTEL_RESOURCE_ATTRIBUTES once, at start, so the project of the directory
# it starts in is added here, per launch (claude-telemetry.sh says why not at shell start).
_claude_launch() {
    if command -v claude_telemetry_launch >/dev/null 2>&1; then
        OTEL_RESOURCE_ATTRIBUTES="$(claude_telemetry_launch)" command claude "$@"
    else
        command claude "$@"
    fi
}

# cl starts on whichever Claude account is cheapest to spend from (`claude-acct run`, the one
# launcher every human start goes through; accounts in ~/.config/claude-acct/accounts);
# `cl --acct <name>` forces one. `cl --lazer` runs on the paid Lazer reserve instead
# (claude-lazer: Sonnet only, capped). Plain `claude` keeps the inherited account, for
# `claude mcp`, `claude update` and the like.
unalias cl 2>/dev/null
cl() {
    local acct=()
    case "${1:-}" in
        --acct) acct=(--acct "${2:?cl: --acct needs an account name}"); shift 2 ;;
        --acct=*) acct=(--acct "${1#--acct=}"); shift ;;
        --lazer)
            shift
            ( unset CLAUDE_CONFIG_DIR AGENT_HARNESS   # a hand start is claude-lazer, not a parent pane's harness
              command -v claude_telemetry_launch >/dev/null 2>&1 \
                  && export OTEL_RESOURCE_ATTRIBUTES="$(claude_telemetry_launch)"
              claude-lazer --dangerously-skip-permissions "$@" )
            return ;;
    esac
    claude-acct run "${acct[@]}" --dangerously-skip-permissions "$@"
}
alias codex-sync="$HOME/.dotfiles/.config/codex/sync-ai-global-config.sh"
alias cb="agent" # need to rename to agent

# --- Tmux pane title wrappers for AI tools ---
# Sets ✳ in pane title so tmux agent detection works (like Claude does natively)
# Exports TMUX_PANE_KEY so agents with event APIs can write structured state files
_tmux_agent_wrap() {
    local name="$1"; shift
    if [[ -n "$TMUX" ]]; then
        printf '\033]2;✳ %s\033\\' "$name"
        local sess win
        sess=$(tmux display-message -p '#{session_name}')
        win=$(tmux display-message -p '#{window_index}')
        export TMUX_PANE_KEY="${sess}_${win}"
    fi
    command "$name" "$@"
    if [[ -n "$TMUX" ]]; then
        printf '\033]2;\033\\'
        rm -f "/tmp/agent-events/${TMUX_PANE_KEY}.state.json" 2>/dev/null
        unset TMUX_PANE_KEY
    fi
}
codex()    { _tmux_agent_wrap codex "$@"; }
gemini()   { _tmux_agent_wrap gemini "$@"; }
opencode() { _tmux_agent_wrap opencode "$@"; }
# opencode personal profile (OpenCode Go only): ~/.config/opencode/README.md
ocp()      { ( export OPENCODE_CONFIG="$HOME/.config/opencode/personal.json"; opencode "$@" ) }
aider()    { _tmux_agent_wrap aider "$@"; }

alias co="codex"
