^/\.claude/plans$
^/\.claude/tasks$
^/\.claude/session-env$
^/\.claude/output-styles$
# Named individually, NOT as ^/\.claude/.*\.json$ — that pattern also swallows the
# TRACKED .claude/settings.json and would silently stop it deploying on a fresh install.
^/\.claude/settings\.local\.json$
^/\.claude/remote-settings\.json$
^/\.claude/policy-limits\.json$
^/\.claude/mcp-needs-auth-cache\.json$
^/\.claude/last-update-result\.json$
