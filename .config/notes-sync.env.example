# Optional overrides for the notes sync units (git-sync-notes, notes-watch, notes-mqtt,
# notes-ntfy). The engine, store-sync --store notes, reads only NOTES_DIR; the remotes are
# the clone's own, set by notes-sync-bootstrap.sh.

# NOTES_DIR=$HOME/.notes

# Primary URL notes-bootstrap and notes-phone-setup clone from.
# NOTES_PRIMARY_REMOTE_URL=https://git.example.internal/kblack0610/.notes.git

# Pull subscribers.
# NOTES_MQTT_HOST=mosquitto.example.internal
# NOTES_MQTT_PORT=31883
# NOTES_MQTT_TOPIC=notes/sync/needed
# NOTES_NTFY_URL=https://ntfy.example.internal/notes-sync/raw
