// -*- mode: jsonc -*-
// Shared module DEFINITIONS only.
// Per-host outer files (config.desktop, config.laptop) supply modules-left / modules-right.
// Per `man waybar`, on duplicate keys the outer (including) file wins — module list arrays MUST live there.
{
    // Waybar watches style.css and reloads only the CSS when it changes, which is all a
    // theme switch needs. theme-switch used to send SIGUSR2 instead, a FULL reload of
    // every bar (pin included); that aborted the main bar at the 07:00 switch on
    // 2026-09-17 (g_application_run assertion, coredump).
    "reload_style_on_change": true,
    "height": 30,
    "spacing": 2,
    "hyprland/workspaces": {
        "all-outputs": false,
        "format": "{icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "6": "6",
            "7": "7",
            "8": "8",
            "9": "9",
            "urgent": "",
            "default": "●"
        }
    },
    // Caffeine: a click holds idle off, a second lets it go (caffeine.sh); the interval catches a hold
    // that ended on its own. Custom, not the built-in
    // idle_inhibitor, so `modules.sh off caffeine` can drop it per machine.
    "custom/caffeine": {
        "format": "{}",
        "return-type": "json",
        "interval": 10,
        "exec": "$HOME/.config/waybar/modules.sh gate custom/caffeine $HOME/.config/waybar/caffeine.sh",
        "signal": 12,
        "hide-empty-text": true,
        "on-click": "$HOME/.config/waybar/caffeine.sh toggle",
        "tooltip": true
    },
    "clock#date": {
        "format": "{:%a %b %d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "clock#time": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%H:%M:%S}",
        "format-alt": "{:%I:%M %p}"
    },
    // The notification panel: shown only while desk's notify part is swaync (docs/desk.md),
    // because swaync-client would D-Bus start swaync, which stops dunst. Click opens the
    // panel, right click toggles do-not-disturb.
    "custom/notify": {
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂞",
            "none": "󰂚",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂞",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "[ \"$($HOME/.local/bin/desk get notify)\" = swaync ]",
        "exec": "swaync-client -swb",
        "on-click": "$HOME/.local/bin/desk notify history",
        "on-click-right": "$HOME/.local/bin/desk notify dnd",
        "escape": true,
        "tooltip": false
    },
    // Labelled like the CPU pill, so CPU and RAM read at a glance.
    "memory": {
        "format": "RAM {}%",
        "tooltip-format": "{used:0.1f} of {total:0.1f} GiB used\nswap {swapUsed:0.1f} of {swapTotal:0.1f} GiB"
    },
    // The root disk fills from Unity worktrees (15-20 GB each), so it warns early.
    // Root use% on the bar; hover shows every drive, the biggest buckets and what can be
    // reclaimed; click opens the storage picker. See .local/src/system/README.md.
    "custom/storage": {
        "format": "{}",
        "return-type": "json",
        "interval": 60,
        "exec": "$HOME/.config/waybar/modules.sh gate custom/storage $HOME/.local/bin/storage waybar",
        "signal": 10,
        "hide-empty-text": true,
        "on-click": "kitty --class storage-term -e $HOME/.local/bin/storage",
        "tooltip": true
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C"
    },
    // Only connected or not on the bar; the interface, address and gateway are on hover.
    "network": {
        "format-wifi": "\uf1eb",
        "format-ethernet": "\udb80\ude00",
        "format-linked": "\udb80\ude00 no IP",
        "format-disconnected": "offline \u26a0",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname}: {ipaddr}/{cidr}\nvia {gwaddr}",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}\nvia {gwaddr}",
        "tooltip-format-disconnected": "{ifname}: disconnected"
    },
    "custom/bluetooth": {
        "format": "",
        "tooltip-format": "Bluetooth - Click to open bluetui",
        "on-click": "kitty --class floating-term -e bluetui"
    },
    "pulseaudio": {
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-click": "kitty --class floating-term -e wiremix"
    },
    // The `modules.sh gate <id>` prefix below is what makes these toggleable at
    // runtime: while a module is off the gate prints nothing and waybar drops it.
    // "signal": 10 is the shared re-run signal every gated module listens on.
    // See modules.registry and PIN.md.
    // The status cluster: our own custom modules, one divider line between each
    // VISIBLE member (layout.css). A member added here gets its divider for free,
    // and one that is hidden (toggled off, or shown on the pin) takes its line
    // with it. Order is left to right.
    "group/status": {
        "orientation": "horizontal",
        "modules": [
            "custom/needs",
            "custom/timebox",
            "custom/health",
            "custom/fleet",
            "custom/projects",
            "custom/ai-agents",
            "custom/queue",
            "custom/ci",
            "custom/printer"
        ]
    },
    // CPU use, load and temperature read as one pill (layout.css). custom/load prints the CPU
    // and load half, because a built-in cpu module cannot show every machine on hover; the
    // temperature half keeps its own sensor path and critical state.
    "group/cpu-temp": {
        "orientation": "horizontal",
        "modules": [
            "custom/load",
            "temperature"
        ]
    },
    // Shown only while keys bypass Hyprland (the passthru submap). Not gated:
    // it is a safety indicator. No interval: the submap binds fire RTMIN+11 instead.
    "custom/passthrough": {
        "format": "{}",
        "return-type": "json",
        "interval": "once",
        "exec": "$HOME/.config/waybar/passthrough.sh",
        "signal": 11,
        "hide-empty-text": true,
        "tooltip": true
    },
    // Shown only while a gungan voice take runs (red mic: stream, mic: record). Not gated: a
    // hot mic is a privacy indicator. No interval: gungan fires RTMIN+9 on every start and
    // stop. A click stops a stream; a record take is stopped by whoever started it.
    "custom/gungan": {
        "format": "{}",
        "return-type": "json",
        "interval": "once",
        "exec": "$HOME/.local/bin/gungan status",
        "signal": 9,
        "hide-empty-text": true,
        "tooltip": true,
        "on-click": "[ \"$(~/.local/bin/gungan status | jq -r .tooltip)\" = 'Gungan: Streaming...' ] && ~/.local/bin/gungan stream"
    },
    // Shown only while a process holds a /dev/video* node open (CAM, the holders on hover). Not
    // gated: a live camera is a privacy indicator. No interval: webcam.sh stays running on inotify
    // and prints a line per change.
    "custom/webcam": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.config/waybar/webcam.sh",
        "hide-empty-text": true,
        "tooltip": true
    },
    // The input apps hear, and the switch between the rig's inputs (audio_input.sh, PIN.md "Input
    // chip"). Noctalia only (.config/noctalia/config.toml): no waybar lists it, since the desktop bar has no width left. No
    // interval: it runs on `pactl subscribe`; restart-interval brings it back after a PipeWire restart.
    "custom/audio-input": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.config/waybar/audio_input.sh watch",
        "restart-interval": 5,
        "hide-empty-text": true,
        "tooltip": true,
        "on-click": "$HOME/.config/waybar/audio_input.sh next",
        "on-click-right": "$HOME/.config/waybar/audio_input.sh prev"
    },
    // Needs you: Home's one count of what only the human can do, first in the status group; the hover is its kind
    // split and oldest rows (needs.sh, from the retained summary/overview). 30s: one broker read, and the publisher
    // sends on events. Click opens the hub on Home.
    "custom/needs": {
        "format": "{}",
        "return-type": "json",
        "interval": 30,
        "exec": "$HOME/.config/waybar/modules.sh gate custom/needs $HOME/.config/waybar/needs.sh",
        "signal": 10,
        "hide-empty-text": true,
        "on-click": "kitty --class floating-term -e $HOME/.local/bin/hub --popup --tab home",
        "tooltip": true
    },
    // Agents: the robot coloured by fleet health, then the live total and its working and ready parts on the bar (what needs you is
    // custom/needs); the hover is one sentence, then Waiting, Stuck and Working sections, a row per session from summary/bar, capped
    // by the comms-lint bar channel (ai_agents.sh). 15s because fleet-sessions ticks once a minute. Click opens agent-panel,
    // right-click the hub board on Sessions.
    "custom/ai-agents": {
        "format": "{}",
        "return-type": "json",
        "interval": 15,
        "exec": "$HOME/.config/waybar/modules.sh gate custom/ai-agents /home/kblack0610/.config/waybar/ai_agents.sh",
        "signal": 10,
        "hide-empty-text": true,
        "on-click": "kitty --class floating-term -e $HOME/.local/bin/agent-panel",
        "on-click-right": "kitty --class floating-term -e $HOME/.local/bin/hub --popup --tab sessions",
        "tooltip": true
    },
    // Fleet pulse: shown beside the health heart only while a machine is not up (fleet_pulse.sh
    // prints nothing for a healthy fleet). Click opens the gatus status page.
    "custom/fleet": {
        "format": "{}",
        "return-type": "json",
        "interval": 15,
        "exec": "$HOME/.config/waybar/modules.sh gate custom/fleet /home/kblack0610/.config/waybar/fleet_pulse.sh",
        "signal": 10,
        "hide-empty-text": true,
        "on-click": "sh -c '. $HOME/.config/fleet-pulse/env 2>/dev/null; xdg-open ${GATUS_BASE:-https://status.example.com}'",
        "tooltip": true
    },
    // This machine's CPU and load, every machine's load/CPU/mem/temp on hover from the
    // Prometheus cc:host_* rules (load.sh). Click opens the hub board on Machines.
    "custom/load": {
        "format": "{}",
        "return-type": "json",
        "interval": 15,
        "exec": "$HOME/.config/waybar/modules.sh gate custom/load $HOME/.config/waybar/load.sh",
        "signal": 10,
        "hide-empty-text": true,
        "on-click": "kitty --class floating-term -e $HOME/.local/bin/hub --popup --tab 'infra machines'",
        "tooltip": true
    },
    // CI: jobs running and queued on the bar (CI r:N q:N), no runner count or red; runners by machine and the last day's finished
    // jobs on hover (ci_runners.sh). 60s because the exporter and rules move once a minute.
    "custom/ci": {
        "format": "{}",
        "return-type": "json",
        "interval": 60,
        "exec": "$HOME/.config/waybar/modules.sh gate custom/ci $HOME/.config/waybar/ci_runners.sh",
        "signal": 10,
        "hide-empty-text": true,
        "on-click": "kitty --class floating-term -e $HOME/.local/bin/hub --popup --tab 'infra ci'",
        "on-click-right": "sh -c '. $HOME/.config/command-center/env 2>/dev/null; xdg-open ${CC_GRAFANA_URL:-https://grafana.example.com}'",
        "tooltip": true
    },
    // 3D printers: N for the Neptune with its progress or a check when done, B for the A1 while on, hidden when idle or off (printer.sh); the addresses are in
    // command-center/env. Click opens the Neptune page in Home Assistant, right-click the slicer.
    "custom/printer": {
        "format": "{}",
        "return-type": "json",
        "interval": 30,
        "exec": "$HOME/.config/waybar/modules.sh gate custom/printer $HOME/.config/waybar/printer.sh",
        "signal": 10,
        "hide-empty-text": true,
        "on-click": "sh -c '. $HOME/.config/command-center/env 2>/dev/null; xdg-open ${CC_PRINTER_URL:-https://homeassistant.example.com}'",
        "on-click-right": "sh -c '. $HOME/.config/command-center/env 2>/dev/null; xdg-open ${CC_SLICER_URL:-https://slicer.example.com}'",
        "tooltip": true
    },
    // System health: the heart in the overall colour; the hover leads with one dot per system,
    // worst first, then says what is down and what is up (health.sh). Click opens the hub board on Home.
    "custom/health": {
        "format": "{}",
        "return-type": "json",
        "interval": 60,
        "exec": "$HOME/.config/waybar/modules.sh gate custom/health $HOME/.config/waybar/health.sh",
        "signal": 10,
        "hide-empty-text": true,
        "on-click": "kitty --class floating-term -e $HOME/.local/bin/hub --popup --tab home",
        "tooltip": true
    },
    // Projects: how many have work in flight and the running sprint (`S:v0.5.4 10/15`, +N past one); the hover leads with
    // the running sprints, then each project's release window and sessions, in flight first (projects.sh, from `hub projects --json`). Click opens the hub
    // board on Projects.
    "custom/projects": {
        "format": "{}",
        "return-type": "json",
        "interval": 60,
        "exec": "$HOME/.config/waybar/modules.sh gate custom/projects $HOME/.config/waybar/projects.sh",
        "signal": 10,
        "hide-empty-text": true,
        "on-click": "kitty --class floating-term -e $HOME/.local/bin/hub --popup --tab projects",
        "tooltip": true
    },
    // Machine mode: the mode's initial, in every mode. Placed by config.desktop only (right of
    // custom/storage); the laptop has no pool runners, so it has no chip.
    "custom/machine-mode": {
        "format": "{}",
        "return-type": "json",
        "interval": 60,
        "exec": "$HOME/.config/waybar/modules.sh gate custom/machine-mode $HOME/.config/waybar/machine_mode.sh",
        "signal": 10,
        "hide-empty-text": true,
        "on-click": "$HOME/.local/bin/machine-mode next",
        "tooltip": true
    },
    // Queue: Q ready to start and D done today; the hover leads with whether work flows and
    // what to fix, then Up next by name, In flight, Today and Room (queue.sh). Click opens the hub on Queue.
    "custom/queue": {
        "format": "{}",
        "return-type": "json",
        "interval": 60,
        "exec": "$HOME/.config/waybar/modules.sh gate custom/queue $HOME/.config/waybar/queue.sh",
        "signal": 10,
        "hide-empty-text": true,
        "on-click": "kitty --class floating-term -e $HOME/.local/bin/hub --popup --tab queue",
        "on-click-right": "kitty --class floating-term -e $HOME/.local/bin/hub --popup",
        "tooltip": true
    },
    "custom/timebox": {
        "format": "{}",
        "return-type": "json",
        "interval": 1,
        "exec": "$HOME/.config/waybar/modules.sh gate custom/timebox $HOME/.local/bin/timebox status --json",
        "signal": 10,
        "hide-empty-text": true,
        "on-click": "kitty --class floating-term -e $HOME/.local/bin/timebox-panel",
        "on-click-right": "$HOME/.local/bin/timebox pause",
        "on-click-middle": "$HOME/.local/bin/timebox done",
        "tooltip": true
    }
}
