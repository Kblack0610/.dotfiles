// -*- mode: jsonc -*-
// Shared module DEFINITIONS only.
// Per-host outer files (config.desktop, config.laptop) supply modules-left / modules-right.
// Per `man waybar`, on duplicate keys the outer (including) file wins — module list arrays MUST live there.
{
    // Waybar watches style.css and reloads only the CSS when it changes, which is all a
    // theme switch needs. theme-switch used to send SIGUSR2 instead, a FULL reload of
    // every bar (pin included); that aborted the main bar at the 07:00 switch on
    // 2026-09-17 (g_application_run assertion, coredump).
    "reload_style_on_change": true,
    "height": 30,
    "spacing": 2,
    "hyprland/workspaces": {
        "all-outputs": false,
        "format": "{icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "6": "6",
            "7": "7",
            "8": "8",
            "9": "9",
            "urgent": "",
            "default": "●"
        }
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "clock#date": {
        "format": "{:%a %b %d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "clock#time": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%H:%M:%S}",
        "format-alt": "{:%I:%M %p}"
    },
    // Labelled like the temperature chips, so CPU and RAM read at a glance.
    "cpu": {
        "format": "CPU {usage}%",
        "tooltip": false
    },
    "memory": {
        "format": "RAM {}%",
        "tooltip-format": "{used:0.1f} of {total:0.1f} GiB used\nswap {swapUsed:0.1f} of {swapTotal:0.1f} GiB"
    },
    // The root disk fills from Unity worktrees (15-20 GB each), so it warns early.
    // Root use% on the bar; hover shows every drive, the biggest buckets and what can be
    // reclaimed; click opens the storage picker. See .local/src/system/README.md.
    "custom/storage": {
        "format": "{}",
        "return-type": "json",
        "interval": 60,
        "exec": "$HOME/.config/waybar/modules.sh gate custom/storage $HOME/.local/bin/storage waybar",
        "signal": 10,
        "hide-empty-text": true,
        "on-click": "kitty --class storage-term -e $HOME/.local/bin/storage",
        "tooltip": true
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C"
    },
    // Only connected or not on the bar; the interface, address and gateway are on hover.
    "network": {
        "format-wifi": "\uf1eb",
        "format-ethernet": "\udb80\ude00",
        "format-linked": "\udb80\ude00 no IP",
        "format-disconnected": "offline \u26a0",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname}: {ipaddr}/{cidr}\nvia {gwaddr}",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}\nvia {gwaddr}",
        "tooltip-format-disconnected": "{ifname}: disconnected"
    },
    "custom/bluetooth": {
        "format": "",
        "tooltip-format": "Bluetooth - Click to open bluetuith",
        "on-click": "kitty --class floating-term -e bluetuith"
    },
    "pulseaudio": {
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-click": "pavucontrol"
    },
    // The `modules.sh gate <id>` prefix below is what makes these toggleable at
    // runtime: while a module is off the gate prints nothing and waybar drops it.
    // "signal": 10 is the shared re-run signal every gated module listens on.
    // See modules.registry and PIN.md.
    // The status cluster: our own custom modules, one divider line between each
    // VISIBLE member (layout.css). A member added here gets its divider for free,
    // and one that is hidden (toggled off, or shown on the pin) takes its line
    // with it. Order is left to right.
    "group/status": {
        "orientation": "horizontal",
        "modules": [
            "custom/timebox",
            "custom/ai-agents",
            "custom/fleet",
            "custom/ci",
            "custom/day"
        ]
    },
    // CPU use and temperature read as one pill (layout.css): neither built-in can print the
    // other's value, and the temperature half keeps its own sensor path and critical state.
    "group/cpu-temp": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "temperature"
        ]
    },
    // Shown only while keys bypass Hyprland (VDI submap or RustDesk grab). Not gated:
    // it is a safety indicator. No interval: the toggles fire RTMIN+11 instead.
    "custom/passthrough": {
        "format": "{}",
        "return-type": "json",
        "interval": "once",
        "exec": "$HOME/.config/waybar/passthrough.sh",
        "signal": 11,
        "hide-empty-text": true,
        "tooltip": true
    },
    "custom/ai-agents": {
        "format": "{}",
        "return-type": "json",
        "interval": 3,
        "exec": "$HOME/.config/waybar/modules.sh gate custom/ai-agents /home/kblack0610/.config/waybar/ai_agents.sh",
        "signal": 10,
        "hide-empty-text": true,
        "on-click": "kitty --class floating-term -e $HOME/.local/bin/agent-panel",
        "tooltip": true
    },
    "custom/fleet": {
        "format": "{}",
        "return-type": "json",
        "interval": 15,
        "exec": "$HOME/.config/waybar/modules.sh gate custom/fleet /home/kblack0610/.config/waybar/fleet_pulse.sh",
        "signal": 10,
        "hide-empty-text": true,
        "on-click": "sh -c '. $HOME/.config/fleet-pulse/env 2>/dev/null; xdg-open ${GATUS_BASE:-https://status.example.com}'",
        "tooltip": true
    },
    // This machine's load beside CPU and RAM, every machine's load/CPU/mem/temp on hover
    // from the Prometheus cc:host_* rules (load.sh). Click opens the hub:infra board.
    "custom/load": {
        "format": "{}",
        "return-type": "json",
        "interval": 15,
        "exec": "$HOME/.config/waybar/modules.sh gate custom/load $HOME/.config/waybar/load.sh",
        "signal": 10,
        "hide-empty-text": true,
        "on-click": "kitty --class floating-term -e $HOME/.local/src/tmux/command-center.sh",
        "tooltip": true
    },
    // CI: busy/slots and queued on the bar; runners by machine and the last day's finished
    // jobs on hover (ci_runners.sh). 60s because the exporter and rules move once a minute.
    "custom/ci": {
        "format": "{}",
        "return-type": "json",
        "interval": 60,
        "exec": "$HOME/.config/waybar/modules.sh gate custom/ci $HOME/.config/waybar/ci_runners.sh",
        "signal": 10,
        "hide-empty-text": true,
        "on-click": "kitty --class floating-term -e $HOME/.local/src/tmux/command-center.sh",
        "on-click-right": "sh -c '. $HOME/.config/command-center/env 2>/dev/null; xdg-open ${CC_GRAFANA_URL:-https://grafana.example.com}'",
        "tooltip": true
    },
    // Day: PRs merged today (day-log's record, refreshed by hub:log) and a red !N for what is
    // red now (day.sh). Click opens hub:log's board, right-click the infra board.
    "custom/day": {
        "format": "{}",
        "return-type": "json",
        "interval": 60,
        "exec": "$HOME/.config/waybar/modules.sh gate custom/day $HOME/.config/waybar/day.sh",
        "signal": 10,
        "hide-empty-text": true,
        "on-click": "kitty --class floating-term -e $HOME/.local/bin/day-log watch",
        "on-click-right": "kitty --class floating-term -e $HOME/.local/src/tmux/command-center.sh",
        "tooltip": true
    },
    "custom/timebox": {
        "format": "{}",
        "return-type": "json",
        "interval": 2,
        "exec": "$HOME/.config/waybar/modules.sh gate custom/timebox $HOME/.local/bin/timebox status --json",
        "signal": 10,
        "hide-empty-text": true,
        "on-click": "$HOME/.local/bin/timebox-menu",
        "on-click-right": "$HOME/.local/bin/timebox pause",
        "on-click-middle": "$HOME/.local/bin/timebox lap",
        "tooltip": true
    }
}
