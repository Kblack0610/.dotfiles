// -*- mode: jsonc -*-
// Workstation profile (no battery, no backlight, no PPD).
{
    "include": [
        "~/.config/waybar/config.base"
    ],
    "modules-left": [
        "hyprland/workspaces",
        "custom/passthrough",
        "custom/gungan",
        "custom/webcam"
    ],
    "modules-right": [
        "group/status",
        "idle_inhibitor",
        "pulseaudio",
        "custom/audio-input",
        "custom/bluetooth",
        "network",
        "group/cpu-temp",
        "temperature#gpu",
        "memory",
        "custom/storage",
        "clock#date",
        "clock#time",
        "tray"
    ],
    // The input is custom/audio-input beside this, so the volume chip shows the output only.
    // Waybar merges this over config.base's pulseaudio block key by key.
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-bluetooth-muted": " {icon}",
        "format-muted": ""
    },
    // With no sensor set, waybar reads thermal_zone0, which on this box is the
    // WiFi card. Point at the CPU (k10temp Tctl) and dGPU junction instead, by
    // PCI path because hwmonN numbering changes between boots.
    // Critical at 95: this Zen 4 part boosts until Tctl reads 95 C, so low 90s under
    // load are normal (fleet-assess FLEET_HOT_TCTL uses the same line).
    "temperature": {
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 95
    },
    "temperature#gpu": {
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:01.1/0000:01:00.0/0000:02:00.0/0000:03:00.0/hwmon",
        "input-filename": "temp2_input",
        "critical-threshold": 95,
        "format": "GPU {temperatureC}°C"
    }
}
