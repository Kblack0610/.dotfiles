// -*- mode: jsonc -*-
// Mini pin - BIGGER detailed view (wider single row: labels + system + actions).
// Same overlay-layer floating bar as config.pin-min; pin.sh swaps between them.
{
    "include": [
        "~/.config/waybar/config.base"
    ],
    "name": "pin",
    "layer": "overlay",
    "position": "top",
    "exclusive": false,
    "height": 34,
    "width": 940,
    "margin-top": 8,
    "spacing": 2,
    "modules-left": [],
    "modules-center": [
        "custom/machines",
        "custom/fleet",
        "custom/ai-agents",
        "custom/timebox",
        "cpu",
        "memory",
        "custom/act-sync",
        "custom/act-pull",
        "custom/act-panel",
        "custom/act-ssh",
        "custom/pin-size"
    ],
    "modules-right": [],

    // Gated + signal 10 like the config.base modules, so `modules.sh` can hide
    // them. Signal 10 doubles as this module's manual re-probe (it was 8, which
    // the since-removed hypr/scripts/voice_to_text.sh also fired at an
    // unrelated module).
    "custom/machines": {
        "format": "{}",
        "return-type": "json",
        "interval": 10,
        "exec": "$HOME/.config/waybar/modules.sh gate custom/machines $HOME/.config/waybar/machines.sh full",
        "on-click": "kitty --class floating-term -e $HOME/.config/waybar/machines.sh pick",
        "on-click-right": "pkill -RTMIN+10 waybar",
        "signal": 10,
        "hide-empty-text": true,
        "tooltip": true
    },
    // Icons are \u escapes, not literal glyphs: the literal Nerd Font characters were
    // stripped from this file before it was ever committed and every button rendered
    // empty (the same loss #23 fixed in fleet_pulse.sh). An escape cannot vanish silently.
    "custom/act-sync": {
        "format": " \uf021 ",
        "tooltip": "Restow dotfiles (stow .)",
        "on-click": "kitty --class floating-term -e sh -c 'cd $HOME/.dotfiles && stow -v . ; echo ; echo [done] ; read -r _'"
    },
    "custom/act-pull": {
        "format": " \uf019 ",
        "tooltip": "git pull --ff-only in ~/.dotfiles and ~/.notes",
        "on-click": "kitty --class floating-term -e sh -c 'for d in $HOME/.dotfiles $HOME/.notes ; do echo \"== $d ==\" ; git -C \"$d\" pull --ff-only ; done ; echo ; read -r _'"
    },
    "custom/act-panel": {
        "format": " \uf0c0 ",
        "tooltip": "Open the agent panel",
        "on-click": "kitty --class floating-term -e $HOME/.local/bin/agent-panel"
    },
    "custom/act-ssh": {
        "format": " \uf120 ",
        "tooltip": "SSH into a fleet host",
        "on-click": "kitty --class floating-term -e $HOME/.config/waybar/machines.sh pick"
    },
    "custom/pin-size": {
        "format": " \uf066 ",
        "tooltip": "Collapse the pin",
        "on-click": "$HOME/.config/waybar/pin.sh size"
    }
}
