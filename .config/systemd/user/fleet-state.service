[Unit]
Description=Fleet state document and stage changes (fleet-sessions tick)

[Service]
Type=oneshot
# A singleton: only the machine holding the fleet lease runs it, any other skips (fleet-lease).
ExecCondition=%h/.local/bin/fleet-lease fleet-state
# Each world's pane record, and the page when a server died. First, and allowed to fail: the
# minute this keeps is what `fleet-dispatch restore` reopens from.
ExecStartPre=-%h/.local/bin/fleet-dispatch record
ExecStartPre=-%h/.local/bin/agent-ask assume-due
# The backstop for agent-ask-deliver.path: any answer still queued goes out, in that unit and
# without waiting, so a slow delivery never holds this pass past its timeout.
ExecStartPre=-/usr/bin/systemctl --user start --no-block agent-ask-deliver.service
# The runner pool's failing tests, for the tick's SHARED rows. Allowed to fail: a missed read is
# retried next minute, and the local gate's ledger still counts.
ExecStartPre=-%h/.local/bin/pool-test-failures sync
ExecStart=%h/.local/bin/fleet-sessions tick
# Then one page for what is new on hub Home's NEEDS YOU list, under the bar and cap in
# channels.toml [pager.needs]. Allowed to fail: a missed page leaves the list on Home and in the journal.
ExecStartPost=-%h/.local/bin/hub needs --page
# Home Assistant hears from agent-mqtt-publish.timer (--full, every 5 minutes) and the agentctl
# and sentinel triggers, not from this pass: a publish per pass cost about 15 CPU-hours a day.
StandardOutput=null
TimeoutStartSec=120
# Every scratch dir of the pass (fleet-sessions' $CACHE) lives here, and systemd removes it when the
# unit stops: a timeout kills the whole cgroup, the EXIT trap's rm with it, and 22 timed-out passes
# had left 158 MB in /tmp, which is RAM (nc-42).
RuntimeDirectory=fleet-state
Environment=TMPDIR=%t/fleet-state
