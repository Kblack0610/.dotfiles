[Unit]
Description=Write whether this machine can hold the fleet lease to the store (fleet-node publish)

[Service]
Type=oneshot
# publish pushes the store with store-sync, which lives beside it in ~/.local/bin; ready asks gh, git,
# kubectl and ssh, so the PATH is the one the agentctl lane units run with.
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=%h/.local/bin/fleet-node publish
# ready fetches both dotfiles checkouts, asks the store remotes and the cluster: seconds when well, bounded when not.
TimeoutStartSec=240
