[Unit]
Description=Deliver recorded ask answers (agent-ask deliver --all)

[Service]
Type=oneshot
# Only the fleet home runs it; any other machine skips (fleet-is-home, the roster's fleet_state_host).
ExecCondition=%h/.local/bin/fleet-is-home
Environment=AGENT_STATE_LOCAL=1
# Repeats until nothing is queued, so an answer given while it runs goes out in this run.
ExecStart=%h/.local/bin/agent-ask deliver --all
TimeoutStartSec=300
