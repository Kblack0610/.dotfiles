[Unit]
Description=Publish each Claude account's weekly usage for node_exporter
# The collector dir is the workstation's (home-config's node-exporter-linux role) or a k3s node's
# (its node-disk-metrics role); claude-acct picks the one that exists (prom-textfile.sh,
# PROM_TEXTFILE_DIRS, which tests/unit/prom_textfile.bats pins these two lines to). A `|`
# condition is an OR, so with neither the unit skips, the gateway snapshot included.
ConditionPathIsDirectory=|/var/lib/node_exporter/textfile
ConditionPathIsDirectory=|/var/lib/node-exporter-textfile

[Service]
Type=oneshot
ExecStart=%h/.local/bin/claude-acct textfile
# The Consumers snapshot (Costs tab) rides the same 15 min timer. The `-` keeps a failed
# snapshot from failing the textfile unit: the old snapshot stays, and Consumers turns amber
# once it is stale (gateway::STALE_SECS), which is the signal.
ExecStart=-%h/.local/bin/claude-acct gateway
TimeoutStartSec=90
