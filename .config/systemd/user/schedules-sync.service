[Unit]
Description=Sync GitHub scheduled runs and the CI run ledger (schedules-sync)

[Service]
Type=oneshot
# A singleton: only the machine holding the fleet lease runs it, any other skips (fleet-lease).
ExecCondition=%h/.local/bin/fleet-lease schedules-sync
ExecStart=%h/.local/bin/schedules-sync
# The per-case test ledger reads the runs the sync just recorded (hub-cases ingest, bounded by its own
# wall-time budget and the gh wrapper's REST reserve); its failure shows on this unit.
ExecStartPost=%h/.local/bin/hub-cases ingest
StandardOutput=null
StandardError=journal
TimeoutStartSec=600
