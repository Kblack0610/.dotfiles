[Unit]
Description=Refresh the fleet state document every minute (the hub Sessions tab)

# git, gh and the transcripts have no change event to await, so this samples; fleet-state.path
# adds a pass on each ask change. A pass is git and gh per session, which runs for much of that
# minute, so whatever must not lag (who is waiting on the human) is read live, not from this pass.
[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
