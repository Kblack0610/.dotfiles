#!/usr/bin/env bats
# regen-anchor.sh + stop-post.d/87-regen-anchor.sh.
#
# The generator existed for two months with NO caller, so its AUTO block went stale and
# nothing said so -- a stale generated block and a fresh one render identically. These
# tests pin the two properties that make wiring it to every Stop safe:
#
#   the block actually refreshes            (else the hook is decoration)
#   an unchanged block is NOT rewritten     (else ~/.agent, a git repo with a 15-minute
#                                            auto-commit, gains a commit every turn)
#
# and the two that keep the hook from doing damage: it never scaffolds an anchor for a
# directory nobody asked about, and it never rotates behind a human's back.

setup() {
  load '../vendor/bats-support/load'
  load '../vendor/bats-assert/load'
  load '../helpers/sandbox'
  sandbox_init basic

  REGEN="$REPO_ROOT/.claude/skills/memory/project-index/regen-anchor.sh"
  HOOK="$REPO_ROOT/.claude/hooks/stop-post.d/87-regen-anchor.sh"

  # The script reads its libs from the STOWED path, which sandbox_init has rewritten.
  # md-splice.sh is already linked in there by sandbox_init; only project-name.sh needs
  # placing.
  mkdir -p "$HOME/.config/shared-hooks" "$HOME/.agent/anchors" \
           "$HOME/.agent/plans/proj" "$HOME/.agent/outcomes/proj" "$HOME/.agent/lessons"
  cp "$REPO_ROOT/.config/shared-hooks/project-name.sh" "$HOME/.config/shared-hooks/"

  MAP="$HOME/project-map.json"
  export PROJECT_MAP_FILE="$MAP"
  cat > "$MAP" <<'EOF'
{
  "paths": { "/repos/toolrepo": "toolrepo" },
  "aliases": {},
  "trackers": {
    "_comment_lab_projects": "a string value, to catch an unguarded jq",
    "proj": { "system": "vikunja", "instance": "https://example.test" }
  }
}
EOF

  ANCHOR="$HOME/.agent/anchors/proj.md"
}

seed_anchor() {
  local entries="${1:-3}" i
  {
    echo "# proj - anchor"
    echo
    echo "## Key URLs & facts"
    echo "- a hand-written fact"
    echo
    echo "## Decisions log"
    for i in $(seq "$entries" -1 1); do
      echo "- **2026-08-0$i:** decision $i"
      echo "  a continuation line for $i"
    done
    echo
    echo "## Blockers / known issues"
    echo "- none"
    echo
    echo "<!-- AUTO:START — regenerated by /project-index; edits below are overwritten -->"
    echo "## Links"
    echo "- Outcomes: \`~/.agent/outcomes/proj/\` (latest: \`1999-01.jsonl\`)"
    echo "<!-- AUTO:END -->"
  } > "$ANCHOR"
}

# ── the generator ────────────────────────────────────────────────────────────

@test "regen-anchor: refreshes a stale AUTO block" {
  seed_anchor
  touch "$HOME/.agent/outcomes/proj/2026-08.jsonl"
  run bash "$REGEN" proj
  assert_success
  assert_output --partial 'regenerated AUTO block'
  run cat "$ANCHOR"
  assert_output --partial '2026-08.jsonl'
  refute_output --partial '1999-01.jsonl'
}

@test "regen-anchor: links the newest outcomes month by name, not the archived evals" {
  # The eval corpus stopped growing 2026-10-28; outcomes is what the nightly writes now.
  # A late re-observation touches an older month, so mtime would pick the wrong file.
  seed_anchor
  mkdir -p "$HOME/.agent/evals/proj"
  touch "$HOME/.agent/evals/proj/2026-10-27.md"
  touch "$HOME/.agent/outcomes/proj/2026-10.jsonl"
  touch -d '+1 minute' "$HOME/.agent/outcomes/proj/2026-09.jsonl"
  run bash "$REGEN" proj
  assert_success
  run cat "$ANCHOR"
  assert_output --partial '- Outcomes: `~/.agent/outcomes/proj/` (latest: `2026-10.jsonl`)'
  refute_output --partial 'evals'
}

@test "regen-anchor: preserves the hand-curated sections byte-for-byte" {
  seed_anchor
  local before
  before=$(awk '/^## Key URLs/,/^<!-- AUTO:START/' "$ANCHOR" | head -n -1)
  bash "$REGEN" proj >/dev/null
  local after
  after=$(awk '/^## Key URLs/,/^<!-- AUTO:START/' "$ANCHOR" | head -n -1)
  assert_equal "$after" "$before"
}

@test "regen-anchor: a second run does NOT rewrite the file" {
  # The cmp guard. Without it every Stop dirties ~/.agent.
  seed_anchor
  bash "$REGEN" proj >/dev/null
  local mtime_before
  mtime_before=$(stat -c %Y "$ANCHOR")
  sleep 1.1

  run bash "$REGEN" proj
  assert_success
  assert_output --partial 'AUTO block unchanged'
  assert_equal "$(stat -c %Y "$ANCHOR")" "$mtime_before"
}

@test "regen-anchor: errors rather than guessing when the marker is absent" {
  printf '# proj\n\n## Key URLs & facts\n- a fact\n' > "$ANCHOR"
  run bash "$REGEN" proj
  assert_failure
  assert_output --partial 'no AUTO:START marker'
}

# ── --rotate ─────────────────────────────────────────────────────────────────

@test "regen-anchor --rotate: ages the tail into a sidecar and leaves a link" {
  seed_anchor 6
  ANCHOR_ROTATE_KEEP=2 run bash "$REGEN" proj --rotate
  assert_success
  assert_output --partial 'rotated 4 decisions'

  run cat "$ANCHOR"
  assert_output --partial 'decision 6'
  assert_output --partial 'decision 5'
  refute_output --partial 'decision 1'
  assert_output --partial 'older entries rotated to'

  run cat "$HOME/.agent/anchors/proj.decisions.md"
  assert_output --partial 'decision 1'
  assert_output --partial 'a continuation line for 1'
}

@test "regen-anchor --rotate: repeated rotation does not stack link lines" {
  seed_anchor 6
  ANCHOR_ROTATE_KEEP=2 bash "$REGEN" proj --rotate >/dev/null
  ANCHOR_ROTATE_KEEP=2 bash "$REGEN" proj --rotate >/dev/null
  run grep -c 'older entries rotated to' "$ANCHOR"
  assert_output '1'
}

@test "regen-anchor: rotation NEVER happens without the flag" {
  # The hook runs without it, and rotation rewrites a hand-curated section.
  seed_anchor 6
  ANCHOR_ROTATE_KEEP=2 run bash "$REGEN" proj
  assert_success
  run cat "$ANCHOR"
  assert_output --partial 'decision 1'
  refute_output --partial 'older entries rotated to'
  [ ! -f "$HOME/.agent/anchors/proj.decisions.md" ]
}

# ── the Lab section and --all ───────────────────────────────────────────────

# One `notes projects --stats --json` row. $1 name, $2 stage, $3 status_date, $4 status.
lab_row() {
  printf '{"profile":"bnb","name":"%s","dir":"%s/lab/%s","stage":"%s","version":"v1.2.0","wave":"v1.2.0","open":3,"done":2,"urgent":0,"high":1,"low":1,"planned":4,"agent":5,"status":"%s","status_date":"%s","sheet":"x","summary":"y"}' \
    "$1" "$HOME" "$1" "$2" "$4" "$3"
}

@test "regen-anchor: the Lab section carries the project's counts and its status" {
  echo "[$(lab_row proj beta "$(date +%F)" 'boss fight in review'),$(lab_row other prod '' '')]" \
    > "$NOTES_FIXTURE/stats.json"
  run bash "$REGEN" proj
  assert_success
  run cat "$ANCHOR"
  assert_output --partial '## Lab'
  assert_output --partial "- **proj** (bnb, beta) v1.2.0: 3 open, 2 done this wave, 5 on the agent board; status $(date +%F); \`~/lab/proj/\`"
  assert_output --partial '  - Status: boss fight in review'
  refute_output --partial 'STALE'
  refute_output --partial '**other**'
}

@test "regen-anchor: a prod project with an old status is flagged STALE" {
  echo "[$(lab_row proj prod 2026-01-01 'shipped')]" > "$NOTES_FIXTURE/stats.json"
  run bash "$REGEN" proj
  assert_success
  run cat "$ANCHOR"
  assert_output --partial 'status 2026-01-01 (STALE, over 14 days at prod)'
}

@test "regen-anchor: an old status on an alpha project is not stale" {
  echo "[$(lab_row proj alpha 2026-01-01 'early days')]" > "$NOTES_FIXTURE/stats.json"
  run bash "$REGEN" proj
  run cat "$ANCHOR"
  refute_output --partial 'STALE'
}

@test "regen-anchor: a repo key lists each of its lab projects, without a status line" {
  cat > "$MAP" <<'EOF2'
{ "paths": {}, "aliases": {},
  "trackers": { "proj": {}, "app-a": { "repo": "proj", "path": "apps/a" },
                "app-b": { "repo": "proj", "path": "apps/b" } } }
EOF2
  echo "[$(lab_row app-a beta "$(date +%F)" 'a status'),$(lab_row app-b alpha '' '')]" \
    > "$NOTES_FIXTURE/stats.json"
  run bash "$REGEN" proj
  assert_success
  run cat "$ANCHOR"
  assert_output --partial '- **app-a** (bnb, beta)'
  assert_output --partial '- **app-b** (bnb, alpha) v1.2.0: 3 open, 2 done this wave, 5 on the agent board; no status;'
  refute_output --partial '  - Status:'
}

@test "regen-anchor: says so when the notes CLI gives no lab facts" {
  rm -f "$NOTES_FIXTURE/stats.json"
  run bash "$REGEN" proj
  assert_success
  run cat "$ANCHOR"
  assert_output --partial '_(notes CLI unavailable; lab facts not read)_'
}

@test "regen-anchor: links the newest three ADRs, never the template" {
  mkdir -p "$HOME/repo/docs/decisions"
  for f in 000-template.md 001-a.md 002-b.md 003-c.md 004-d.md README.md; do
    touch "$HOME/repo/docs/decisions/$f"
  done
  cat > "$MAP" <<EOF2
{ "paths": { "$HOME/repo": "proj" }, "aliases": {}, "trackers": {} }
EOF2
  run bash "$REGEN" proj
  assert_success
  run cat "$ANCHOR"
  assert_output --partial "- ADRs: \`$HOME/repo/docs/decisions/\` (latest: 004-d.md, 003-c.md, 002-b.md)"
}

@test "regen-anchor --all: scaffolds every project's anchor, but none for a repo-only key" {
  cat > "$MAP" <<'EOF2'
{ "paths": { "/repos/toolrepo": "toolrepo" }, "aliases": {},
  "trackers": { "default": { "system": "vikunja" }, "_comment": "doc",
                "game": { "repo": "toolrepo", "path": "games/g" },
                "board-only": { "repo": "toolrepo" }, "proj": {} } }
EOF2
  run bash "$REGEN" --all
  assert_success
  for k in toolrepo game proj; do
    [ -f "$HOME/.agent/anchors/$k.md" ] || fail "no anchor for $k"
  done
  [ ! -e "$HOME/.agent/anchors/board-only.md" ] || fail "a repo-only key got an anchor"
  [ ! -e "$HOME/.agent/anchors/default.md" ] || fail "the tracker fallback got an anchor"
}

# ── the stop hook ────────────────────────────────────────────────────────────

@test "87-regen-anchor: refreshes the anchor for the session's project" {
  seed_anchor
  touch "$HOME/.agent/outcomes/proj/2026-08.jsonl"
  # The DEPLOYED path, which is what the hook reads. ~/.claude/skills stays flat
  # however the repo is organised, and that stability is the point of it.
  mkdir -p "$HOME/.claude/skills/project-index"
  cp "$REGEN" "$HOME/.claude/skills/project-index/"
  mkdir -p "$HOME/proj"

  cat > "$MAP" <<EOF
{ "paths": { "$HOME/proj": "proj" }, "aliases": {}, "trackers": {} }
EOF

  CLAUDE_PROJECT_DIR="$HOME/proj" run bash "$HOOK" </dev/null
  assert_success
  run cat "$ANCHOR"
  assert_output --partial '2026-08.jsonl'
}

@test "87-regen-anchor: NEVER scaffolds an anchor for a project that has none" {
  # A Stop hook that mints project files for every directory anyone opens is how
  # ~/.agent filled with namespaces nobody reads.
  mkdir -p "$HOME/.claude/skills/project-index" "$HOME/stranger"
  cp "$REGEN" "$HOME/.claude/skills/project-index/"

  CLAUDE_PROJECT_DIR="$HOME/stranger" run bash "$HOOK" </dev/null
  assert_success
  [ ! -f "$HOME/.agent/anchors/stranger.md" ]
}

@test "87-regen-anchor: exits 0 when the generator is missing" {
  # Never block a Stop.
  seed_anchor
  CLAUDE_PROJECT_DIR="$HOME/proj" run bash "$HOOK" </dev/null
  assert_success
}
