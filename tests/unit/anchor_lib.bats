#!/usr/bin/env bats
# anchor-lib.sh renders the anchor for turn 1. The decisions log is never injected (one
# pointer line stands in for it), and the generated plans and lessons sections can be
# dropped from the anchor and emitted alone, so the preflight can place them in its own
# priority order.
#
# The risk is not that it emits too much -- the preflight budget catches that -- but
# that it silently eats a section that is load-bearing in full. So most assertions are
# about what must SURVIVE.

setup() {
  load '../vendor/bats-support/load'
  load '../vendor/bats-assert/load'
  load '../helpers/sandbox'
  sandbox_init basic
  source "$REPO_ROOT/.config/shared-hooks/anchor-lib.sh"
  ANCHOR="$BATS_TEST_TMPDIR/proj.md"
}

# seed_anchor <n-entries> -- a realistic anchor: sections around a NEWEST-FIRST log of
# <n> dated entries, each 3 lines, plus an AUTO block below it.
seed_anchor() {
  local n="${1:-12}" i day
  {
    echo "# proj - anchor"
    echo
    echo "## Key URLs & facts"
    echo "- **Repo:** \`~/proj\`"
    echo "- **Main branch:** \`main\`"
    echo
    echo "## Decisions log"
    for i in $(seq "$n" -1 1); do
      day=$(printf '%02d' "$i")
      echo "- **2026-08-$day:** decision number $i headline"
      echo "  a continuation line for entry $i"
      echo "  a second continuation line for entry $i"
    done
    echo
    echo "## Blockers / known issues"
    echo "- a blocker that must survive"
    echo
    echo "<!-- AUTO:START - regenerated by /project-index; edits below are overwritten -->"
    echo "## Links"
    echo "- Outcomes: ~/.agent/outcomes/proj/ (latest: 2026-08.jsonl)"
    echo
    echo "## Active plans (most recent)"
    echo "- a plan line"
    echo
    echo "## Recent lessons (digest)"
    echo "- a lesson line"
    echo "<!-- AUTO:END -->"
  } > "$ANCHOR"
}

@test "anchor_inject: every section other than the log passes through" {
  seed_anchor 12
  run anchor_inject "$ANCHOR"
  assert_success
  assert_output --partial '## Key URLs & facts'
  assert_output --partial '- **Repo:** `~/proj`'
  assert_output --partial '## Blockers / known issues'
  assert_output --partial '- a blocker that must survive'
  assert_output --partial '## Links'
  assert_output --partial '- a plan line'
  assert_output --partial '- a lesson line'
}

@test "anchor_inject: the decisions log is one pointer line that counts entries and names the file" {
  seed_anchor 12
  run anchor_inject "$ANCHOR"
  assert_success
  assert_output --partial "## Decisions log: 12 entries, newest first, not injected - read $ANCHOR"
  refute_output --partial 'decision number'
  refute_output --partial 'continuation line'
  [ "$(grep -c 'Decisions log' <<<"$output")" -eq 1 ]
}

@test "anchor_inject: the pointer is singular for exactly one entry" {
  seed_anchor 1
  run anchor_inject "$ANCHOR"
  assert_output --partial '## Decisions log: 1 entry,'
}

@test "anchor_inject: a log that runs to end-of-file still gets its pointer" {
  # No trailing section to trigger the section-close path -- the END rule must.
  printf '# proj\n## Decisions log\n- **2026-08-02:** two\n  more\n- **2026-08-01:** one\n' > "$ANCHOR"
  run anchor_inject "$ANCHOR"
  assert_success
  assert_output --partial '## Decisions log: 2 entries'
  refute_output --partial 'two'
}

@test "anchor_inject: the drop pattern removes only the matching sections" {
  seed_anchor 3
  run anchor_inject "$ANCHOR" '^(Active plans|Recent lessons)'
  assert_success
  refute_output --partial 'Active plans'
  refute_output --partial 'a plan line'
  refute_output --partial 'a lesson line'
  assert_output --partial '## Links'
  assert_output --partial '- a blocker that must survive'
}

@test "anchor_inject and anchor_section: the AUTO marker comments are left out" {
  seed_anchor 3
  run anchor_inject "$ANCHOR"
  refute_output --partial 'AUTO:'
  run anchor_section "$ANCHOR" '^Recent lessons'
  refute_output --partial 'AUTO:'
}

@test "anchor_inject: an anchor with no decisions log passes through unchanged" {
  printf '# proj\n\n## Key URLs & facts\n- a fact\n\n## Blockers\n- none\n' > "$ANCHOR"
  run anchor_inject "$ANCHOR"
  assert_success
  assert_equal "$(anchor_inject "$ANCHOR")" "$(cat "$ANCHOR")"
}

@test "anchor_section: emits only the matching section, heading included" {
  seed_anchor 3
  run anchor_section "$ANCHOR" '^Recent lessons'
  assert_success
  assert_output '## Recent lessons (digest)
- a lesson line'
}

@test "anchor_section: no match prints nothing" {
  seed_anchor 3
  run anchor_section "$ANCHOR" '^No such section'
  assert_success
  assert_output ''
}

@test "a missing anchor prints nothing and succeeds" {
  run anchor_inject "$BATS_TEST_TMPDIR/nope.md"
  assert_success
  assert_output ''
  run anchor_section "$BATS_TEST_TMPDIR/nope.md" 'x'
  assert_success
  assert_output ''
}
