#!/usr/bin/env bash
# Stub for the `agent-panel` Rust binary.
#
# fleet.sh consumes two subcommands -- `agent-panel list`, whose contract is
# `target<TAB>glyph<TAB>project<TAB>summary` with target `<server>/<session>:<window>`,
# one live Claude pane per line, and `agent-panel jump <target>`. Serving that
# from a fixture lets the "agents in OTHER sessions" filter be tested deterministically:
# the real binary's output depends on which panes happen to be running on the machine,
# which is not something a test can pin.
#
# Fixture files, all optional:
#   agent-panel.list    lines for `agent-panel list`
#   agent-panel.asks    present: `agent-panel asks-human` exits 0 (the turn asks the human)
#   agent-panel.unsent  present: `agent-panel send` exits 3 (the pane did not take the Enter)
#   agent-panel.said    the JSON `agent-panel said <transcript> --around <id>` prints; absent:
#                       exit 1, as the real one does when no turn printed the id
#   agent-panel.dialog  the card `agent-panel dialog <target>` prints; absent: exit 1 (no dialog)
#   agent-panel.options the "<key>\t<free>\t<text>" lines of `agent-panel dialog <target> --options`
#   agent-panel.answer  `agent-panel answer` exits with its first line and prints the rest to
#                       stderr; absent: exit 0 (sent)
#   (none)              `agent-panel plain` passes stdin through: the cleaning is md.rs's, tested
#                       there; a caller's test checks only that it routes text through plain
set -uo pipefail

FIX="${NOTES_FIXTURE:?NOTES_FIXTURE unset - stub used outside the sandbox}"
printf 'agent-panel %s\n' "$*" >> "$FIX/calls.log"

case "${1:-}" in
  list) [ -f "$FIX/agent-panel.list" ] && cat "$FIX/agent-panel.list" ;;
  asks-human) [ -f "$FIX/agent-panel.asks" ] && exit 0; exit 1 ;;
  said) [ -f "$FIX/agent-panel.said" ] || exit 1; cat "$FIX/agent-panel.said" ;;
  send) [ -f "$FIX/agent-panel.unsent" ] && { echo "agent-panel send: did not take the Enter" >&2; exit 3; } ;;
  dialog)
    if [[ " $* " == *" --options "* ]]; then [ -f "$FIX/agent-panel.options" ] || exit 1; cat "$FIX/agent-panel.options"
    else [ -f "$FIX/agent-panel.dialog" ] || exit 1; cat "$FIX/agent-panel.dialog"; fi ;;
  plain) cat ;;
  answer)
    [ -f "$FIX/agent-panel.answer" ] || exit 0
    tail -n +2 "$FIX/agent-panel.answer" >&2; exit "$(head -1 "$FIX/agent-panel.answer")" ;;
  *) : ;;   # jump / next / preview / interactive: recorded no-ops
esac
exit 0
