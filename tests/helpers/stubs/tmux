#!/usr/bin/env bash
# Stub for `tmux`, used by the unit and integ tiers only.
#
# Two jobs:
#   1. Record every invocation, so tests can assert intent. The cockpit's --jump /
#      --open-file / --journal / --resume-session verbs all shell out to
#      `tmux new-window "nvim +N file"`; a test must capture that, not spawn an editor.
#   2. Serve canned pane data, so claude-status.sh can be driven through every branch
#      of its classifier without a live tmux server full of real Claude sessions.
#
# The UI tier does NOT use this stub -- tmux_harness.bash calls `command tmux -L <socket>`,
# which bypasses PATH lookup and reaches the real binary.
#
# `display-popup` is a recorded no-op on purpose: it is the one tmux command that cannot
# run headless (`no current client`, rc=1, command never runs), so the only way to assert
# on it is to shim it. Same trick junegunn uses in fzf's own suite (test/test_tmux.rb).
#
# Fixture files, all optional:
#   tmux.panes                  lines for `list-panes -a -F ...`
#   tmux.capture.<sess>_<idx>   content for `capture-pane -t <sess>:<idx>`
#   tmux.activity.<sess>_<idx>  epoch seconds for `#{window_activity}`
#   tmux.session                name returned for `#{session_name}`
set -uo pipefail

FIX="${NOTES_FIXTURE:?NOTES_FIXTURE unset - stub used outside the sandbox}"
printf 'tmux %s\n' "$*" >> "$FIX/calls.log"

# target_key <sess:idx> -> <sess>_<idx>, the fixture filename suffix
target_key() { printf '%s' "${1//:/_}"; }

# Pull `-t <target>` out of the arg list wherever it sits.
target=""
fmt=""
prev=""
for a in "$@"; do
  [ "$prev" = "-t" ] && target="$a"
  # The -F format, extracted EXACTLY rather than grepped for. A substring test on the
  # flattened arg list cannot tell '#{window_id}' from
  # '#{window_id} #{session_name}:#{window_index}' -- the first is a prefix of the
  # second -- and those two answers are not interchangeable to wind-down.sh.
  [ "$prev" = "-F" ] && fmt="$a"
  prev="$a"
done

# The SUBCOMMAND, which is not always "$1". tmux takes global flags before it, and
# servers.sh addresses a world by socket -- `tmux -L lab list-sessions` -- so keying the
# dispatch on "$1" saw `-L` and matched nothing, falling through to a silent exit 0.
#
# That silence is indistinguishable from a real answer of "no sessions", which is exactly
# the condition cmd_land refuses to attach on. Every existing caller happens to put the
# subcommand first, so the gap only appeared once something used a global flag.
#
# -L/-S/-f take a value; the rest of tmux's global flags (-2, -u, -v, -C) do not.
verb=""
skip_value=0
for a in "$@"; do
  if [ "$skip_value" = 1 ]; then skip_value=0; continue; fi
  case "$a" in
    -L|-S|-f) skip_value=1; continue ;;
    -*)       continue ;;
    *)        verb="$a"; break ;;
  esac
done

case "$verb" in
  list-panes)
    [ -f "$FIX/tmux.panes" ] && cat "$FIX/tmux.panes"
    ;;
  has-session)
    # wind-down.sh `fire` gates every teardown on this: a session that is already gone
    # must abort the fire, not fall through to a kill. Default 0 (exists) so no existing
    # caller changes behaviour; drop tmux.no-session to make it report gone.
    [ -f "$FIX/tmux.no-session" ] && exit 1
    exit 0
    ;;
  list-sessions)
    # servers.sh `session_count` pipes this to `wc -l`, and cmd_land refuses to attach
    # to a world whose count is 0 ("every manifest entry's directory is missing"). An
    # unmodelled command answers with silence, which reads as that empty world -- so
    # every hop/back test would die on a guard about a condition it never set up.
    #
    # Default is ONE session, matching has-session above: a stub that does not model a
    # command must not change the behaviour of callers that never cared about it. Drop
    # tmux.sessions to name the sessions a test needs, or tmux.no-sessions to assert
    # the genuinely-empty world the guard exists for.
    [ -f "$FIX/tmux.no-sessions" ] && exit 0
    if [ -f "$FIX/tmux.sessions" ]; then cat "$FIX/tmux.sessions"; else echo "stub"; fi
    exit 0
    ;;
  list-windows)
    # wind-down.sh asks for two DIFFERENT formats and the answers are not
    # interchangeable, so they get their own fixtures:
    #   -F '#{window_id}'                              -> tmux.window_ids
    #   -F '#{window_id} #{session_name}:#{window_index}' -> tmux.window_labels
    # Anything else keeps the pre-existing tmux.windows behaviour (cockpit.sh stale).
    case "$fmt" in
      '#{window_id}')
        [ -f "$FIX/tmux.window_ids" ] && cat "$FIX/tmux.window_ids"
        exit 0 ;;
      '#{window_id} #{session_name}:#{window_index}')
        [ -f "$FIX/tmux.window_labels" ] && cat "$FIX/tmux.window_labels"
        exit 0 ;;
    esac
    # Canned rows for `cockpit.sh stale`, which reads
    #   session:index:name:pane_current_command:pane_current_path:window_activity
    #
    # The real call also passes `-f '#{&&:...@tag_pinned...}'` so tmux drops protected
    # windows server-side. A stub cannot evaluate a tmux format expression, so the
    # fixture stands in for the POST-filter result: a window that must be treated as
    # protected simply does not belong in tmux.windows. Tests that care about the
    # protection contract assert on the filter argument via calls.log instead, which is
    # the only part this stub can honestly speak to.
    [ -f "$FIX/tmux.windows" ] && cat "$FIX/tmux.windows"
    ;;
  capture-pane)
    f="$FIX/tmux.capture.$(target_key "$target")"
    [ -f "$f" ] && cat "$f"
    ;;
  display-message)
    # `-p -t <target> "#{window_activity}"` and `-p '#{session_name}'`
    #
    # ORDER IS LOAD-BEARING. wind-down.sh asks for the composite
    # '#{session_name}:#{window_index}' as its human label, and that string CONTAINS
    # session_name -- so the composite must be matched before the bare one or the label
    # comes back as just the session and the sentinel records the wrong thing.
    # servers.sh `_current_loc` asks for all three at once, on purpose -- the fields have
    # to describe one moment. It must be matched BEFORE socket_path and session_name,
    # both of which it contains; either of those arms would answer a 3-field question
    # with 1 field and `back` would read a server name as a session.
    # STUB_SOCKET empty is the "no current client" case: _current_loc must reject it.
    if printf '%s ' "$@" | grep -q 'socket_path.*session_name.*window_index'; then
      printf '%s\t%s\t%s\n' "${STUB_SOCKET:-}" "${STUB_SESSION:-}" "${STUB_WINDOW_INDEX:-}"
    elif printf '%s ' "$@" | grep -q 'window_activity'; then
      f="$FIX/tmux.activity.$(target_key "$target")"
      [ -f "$f" ] && cat "$f"
    elif printf '%s ' "$@" | grep -q 'session_name}:#{window_index'; then
      echo "${STUB_LABEL:-cockpit:3}"
    elif printf '%s ' "$@" | grep -q 'window_id'; then
      echo "${STUB_WINDOW_ID:-@7}"
    elif printf '%s ' "$@" | grep -q 'pane_id'; then
      echo "${STUB_PANE_ID:-%12}"
    elif printf '%s ' "$@" | grep -q 'pane_current_command'; then
      # servers.sh `_refresh_landing` branches on this: a shell means re-run the
      # manifest's startup command, nvim means `:e` the world's page. Default is a shell,
      # the state a freshly-created session is in.
      echo "${STUB_PANE_CMD:-bash}"
    elif printf '%s ' "$@" | grep -q 'pane_title'; then
      echo "${STUB_PANE_TITLE:-}"
    elif printf '%s ' "$@" | grep -q 'pane_current_path'; then
      # wind-down.sh `arm` asks for this to decide whether the session sits in a `wt`
      # worktree. Empty by default, which is the ordinary-checkout case.
      echo "${STUB_PANE_PATH:-}"
    elif printf '%s ' "$@" | grep -q 'session_windows'; then
      echo "${STUB_SESSION_WINDOWS:-3}"
    elif printf '%s ' "$@" | grep -q 'socket_path'; then
      echo "${STUB_SOCKET:-}"
    elif printf '%s ' "$@" | grep -q 'session_name'; then
      [ -f "$FIX/tmux.session" ] && cat "$FIX/tmux.session" || echo dotfiles
    fi
    ;;
  select-window)
    # refs.sh uses the exit status as "does this window already exist" and only creates
    # one when it does not. Default 0 (exists) so nothing that merely selects a window
    # has to opt in; a test wanting the create path sets STUB_SELECT_WINDOW_RC=1.
    exit "${STUB_SELECT_WINDOW_RC:-0}"
    ;;
  *)
    : ;;   # new-window, display-popup, set-option, ...: recorded no-ops
esac
exit 0
