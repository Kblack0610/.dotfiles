#!/usr/bin/env bash
# Stub for the `gh` CLI.
#
# Serves canned `gh pr list` JSON per repo and records every invocation, so a test can
# assert both what pr-viewer.sh rendered AND that it never reached for the network.
#
# Fixture files under $GH_FIXTURE (all optional):
#   prs.<owner>-<repo>        the JSON array `gh pr list --json ...` would return
#   auth.fail                 present => `gh auth status` exits 1
#
#   gh.script                 present => a test's own behaviour, written by `gh_script` (sandbox.bash):
#                             bash, sourced here in place of everything below (a shebang first line: exec'd,
#                             for a test that wants another language). The script logs what it needs to.
#
# A repo with no fixture returns `[]`, which is the real gh's answer for "no open PRs" --
# so "this repo has none" and "this repo is not set up" stay distinguishable in a test.
set -uo pipefail

_dir="${GH_FIXTURE:?GH_FIXTURE unset - stub used outside the sandbox}"
# $FIX is not set yet: a body is the test's own code, and a test may have a FIX of its own.
if [ -f "$_dir/gh.script" ]; then
  if [ "$(head -c2 "$_dir/gh.script")" = '#!' ]; then exec "$_dir/gh.script" "$@"; fi
  set +u +o pipefail
  . "$_dir/gh.script"
  rc=$?
  [ -n "${STUB_FALLTHROUGH:-}" ] || exit "$rc"   # a body that sets STUB_FALLTHROUGH adds to the canned answers, not replaces them
  set -uo pipefail
fi
FIX="$_dir"
printf 'gh %s\n' "$*" >> "$FIX/calls.log"

case "${1:-}" in
auth)
  [ -f "$FIX/auth.fail" ] && exit 1
  exit 0
  ;;
pr)
  case "${2:-}" in
  list)
    # Pull `-R owner/repo` out of anywhere in the arg list.
    repo=""
    while [ $# -gt 0 ]; do
      case "$1" in
      -R | --repo)
        repo="${2:-}"
        shift 2
        ;;
      *) shift ;;
      esac
    done
    f="$FIX/prs.${repo//\//-}"
    [ -f "$f" ] && cat "$f" || printf '[]\n'
    exit 0
    ;;
  view)
    printf 'stub: gh pr view %s\n' "$*"
    exit 0
    ;;
  esac
  ;;
esac

exit 0
