#!/usr/bin/env bash
# Stub for the `notes` Rust CLI.
#
# Reads canned output from $NOTES_FIXTURE and appends every invocation to calls.log, so
# tests can assert BOTH what the cockpit rendered and which vault-mutating command it
# would have issued -- without a real vault anywhere near the test.
#
# Fixture files (all TAB-delimited, all optional):
#   profiles                    one profile name per line
#   projects.<profile>          name  summary  status  version
#   focus.all                   profile  file  line  key  text
#   ptask.<profile>.<project>   path  line  key  text
set -uo pipefail

FIX="${NOTES_FIXTURE:?NOTES_FIXTURE unset - stub used outside the sandbox}"
printf 'notes %s\n' "$*" >> "$FIX/calls.log"

emit() { [ -f "$FIX/$1" ] && cat "$FIX/$1" || true; }

# Pull `--profile P` out of anywhere in the arg list.
profile=""
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --profile) profile="${2:-}"; shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- "${args[@]+"${args[@]}"}"

case "${1:-}" in
  config)
    [ "${2:-}" = "--profiles" ] && emit profiles
    ;;
  projects)
    case "${2:-}" in
      # `notes projects --roll <name> [--minor|--major]`. The real verb prints
      # `rolled <name>: <cur> -> <next> (froze <path>)`, and the cockpit parses the
      # `(froze …)` tail to find the note it must append the agent changelog to -- so the
      # stub has to reproduce that exact shape or the test proves nothing.
      # `roll.frozen` names the path to claim was frozen; `roll.fail` makes it fail.
      --roll)
        [ -f "$FIX/roll.fail" ] && { echo "roll failed: no Version: line" >&2; exit 1; }
        froze="$(cat "$FIX/roll.frozen" 2>/dev/null)"
        printf 'rolled %s: v1.0.0 -> v1.0.1%s\n' "${3:-x}" "${froze:+ (froze $froze)}"
        ;;
      --version-of) emit "version-of.${3:-}" ;;
      # `notes --profile P projects` -> name TAB summary TAB status TAB version
      *) emit "projects.${profile:-personal}" ;;
    esac
    ;;
  focus)
    case "${2:-}" in
      --all) emit focus.all ;;
      add|done|start|rm|mv) : ;;   # mutation: recorded in calls.log, no output
      *) emit focus.all ;;
    esac
    ;;
  ptask)
    # `notes --profile P ptask <name> list`
    proj="$(printf '%s' "${2:-}" | tr '[:upper:]' '[:lower:]')"
    case "${3:-}" in
      list|"") emit "ptask.${profile:-personal}.${proj}" ;;
      *) : ;;                      # add/done/rm: recorded only
    esac
    ;;
  today)
    : ;;                           # bootstrap no-op
  *)
    : ;;
esac
exit 0
