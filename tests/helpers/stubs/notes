#!/usr/bin/env bash
# Stub for the `notes` Rust CLI.
#
# Reads canned output from $NOTES_FIXTURE and appends every invocation to calls.log, so
# tests can assert BOTH what a subject rendered and which vault-mutating command it
# would have issued -- without a real vault anywhere near the test.
#
# Fixture files (all TAB-delimited, all optional):
#   profiles                    one profile name per line
#   projects.<profile>          name  summary  status  version
#   stats                       profile name stage version open urgent high low planned agent sheet
#   stats.json                  the `projects --stats --json` array, verbatim
#   focus.all                   profile  file  line  key  text
#   ptask.<profile>.<project>   path  line  key  text
#   path.<profile>.<kind>       the root `notes --profile P path <kind>` prints
#   stages                      the ladder `notes projects --stages` prints
#   prios                       name  prio, what `notes projects --prios` prints
#   front-page.<project>        the file `notes projects --front-page <dir>` prints for that dir
#   board.json                  what `notes board --json` prints; its .elsewhere rows only --id finds
#   ptask.added                 what `notes ptask <name> add` prints (the row, with its id)
#   ptask.agent.added           what `notes ptask <name> --agent add` prints
#   playtest.<profile>.<project> what `notes ptask <name> --playtest list` prints; with none it fails
#   stats.fail                  makes `projects --stats` fail
#   roll.window                 the `window ...` lines `projects --release` prints after the freeze
set -uo pipefail

FIX="${NOTES_FIXTURE:?NOTES_FIXTURE unset - stub used outside the sandbox}"
printf 'notes %s\n' "$*" >> "$FIX/calls.log"

emit() { [ -f "$FIX/$1" ] && cat "$FIX/$1" || true; }

# Pull `--profile P` out of anywhere in the arg list.
profile=""
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --profile) profile="${2:-}"; shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- "${args[@]+"${args[@]}"}"

case "${1:-}" in
  # `notes --profile P path <kind>` -> the root the fixture names in path.<P>.<kind>
  path) emit "path.${profile}.${2:-}" ;;
  config)
    if [ "${2:-}" = "--profiles" ]; then
      emit profiles
    else
      # Bare `notes config` prints the resolved profile as `profile <name>`. Mirrors the real
      # resolution order closely enough for tests: $NOTES_PROFILE wins, else the first
      # configured profile.
      p="${NOTES_PROFILE:-$(emit profiles | awk 'NR==1')}"
      [ -n "$p" ] && printf 'profile     %s\n' "$p"
    fi
    ;;
  projects)
    case "${2:-}" in
      # `notes projects --release <name> [--minor|--major]`. The real verb prints
      # `released <name>: <cur> -> <next> (froze <path>)`, and notes-roll parses the
      # `(froze …)` tail to find the note it must append the agent changelog to -- so the
      # stub has to reproduce that exact shape or the test proves nothing.
      # `roll.frozen` names the path to claim was frozen; `roll.fail` makes it fail.
      --release)
        [ -f "$FIX/roll.fail" ] && { echo "roll failed: no Version: line" >&2; exit 1; }
        froze="$(cat "$FIX/roll.frozen" 2>/dev/null)"
        # `--family <file>`: the tag family it was handed, kept as roll.family for the test
        a=("$@")
        for i in "${!a[@]}"; do
          [ "${a[$i]}" = --family ] && cat "${a[$((i + 1))]}" > "$FIX/roll.family"
        done
        printf 'released %s: v1.0.0 -> v1.0.1%s\n' "${3:-x}" "${froze:+ (froze $froze)}"
        # `roll.window`: the `window ...` lines the real verb prints after a cut with a snapshot
        emit roll.window
        ;;
      # `notes projects --stages` -> the ladder, from the `stages` fixture
      --stages) emit stages ;;
      # `notes projects --prios` -> name TAB prio, every project that declares one
      --prios) emit prios ;;
      --version-of) emit "version-of.${3:-}" ;;
      # `notes projects --front-page <dir>` -> the front-page.<project> fixture, else the sheet
      # cases of projects.rs::sheet_path (a README with a `Version:` line, else any tasks.md),
      # else summary.md. The version-parent case is the registry's, so a test of it seeds the fixture.
      --front-page)
        d="${3%/}"
        if [ -f "$FIX/front-page.${d##*/}" ]; then emit "front-page.${d##*/}"
        elif grep -q '^Version:' "$d/README.md" 2>/dev/null; then printf '%s\n' "$d/README.md"
        elif [ -f "$d/tasks.md" ]; then printf '%s\n' "$d/tasks.md"
        else printf '%s\n' "$d/summary.md"
        fi ;;
      # `notes projects --stage <name>` -> the bare stage tag, or nothing if undeclared
      --stage) emit "stage.${3:-}" ;;
      # `notes projects --roadmap <name>` -> version TAB state TAB open TAB done TAB open_weight TAB done_weight TAB unsized_open
      --roadmap) emit "roadmap.${3:-}" ;;
      # `notes projects --stats [--json]` -> every profile's projects with their open
      # counts, as TSV (`stats`) or the JSON array (`stats.json`)
      --stats) [ -f "$FIX/stats.fail" ] && exit 1
               if [ "${3:-}" = "--json" ]; then emit stats.json; else emit stats; fi ;;
      # `notes --profile P projects` -> name TAB summary TAB status TAB version
      *) emit "projects.${profile:-personal}" ;;
    esac
    ;;
  focus)
    case "${2:-}" in
      --all) emit focus.all ;;
      add|done|start|rm|mv) : ;;   # mutation: recorded in calls.log, no output
      *) emit focus.all ;;
    esac
    ;;
  ptask)
    # `notes --profile P ptask <name> list`
    proj="$(printf '%s' "${2:-}" | tr '[:upper:]' '[:lower:]')"
    case "${3:-}" in
      list|"") emit "ptask.${profile:-personal}.${proj}" ;;
      # `notes ptask <name> --playtest list`: no fixture fails, as an unreadable sheet does;
      # any other --playtest verb is recorded only
      --playtest) [ "${4:-}" = list ] || exit 0
                  [ -f "$FIX/playtest.${profile:-personal}.${proj}" ] || exit 1
                  emit "playtest.${profile:-personal}.${proj}" ;;
      add) emit ptask.added ;;     # the row the real verb prints; recorded too
      # `notes ptask <name> --agent add`: the agent row it prints, from ptask.agent.added
      --agent) [ "${4:-}" != add ] || emit ptask.agent.added ;;
      *) : ;;                      # done/rm: recorded only
    esac
    ;;
  # `notes row parse`: each stdin line looked up in row.parse (text TAB type TAB area TAB title
  # TAB ok), else untyped. A lookup table, never the grammar: that lives in notes-cli alone.
  # `notes row types`: the row.types fixture, else a short made-up list.
  row)
    case "${2:-}" in
      parse)
        while IFS= read -r l; do
          hit="$(awk -F'\t' -v l="$l" '$1 == l { print $2 "\t" $3 "\t" $4 "\t" $5; exit }' "$FIX/row.parse" 2>/dev/null)"
          if [ -n "$hit" ]; then printf '%s\n' "$hit"; else printf -- '-\t-\t%s\t0\n' "${l:--}"; fi
        done ;;
      types) if [ -f "$FIX/row.types" ]; then cat "$FIX/row.types"; else echo "feat fix chore"; fi ;;
    esac
    ;;
  # `notes board --json`: the board.json fixture (every open row, both lanes, every profile). With
  # --id, `{today, rows}` of the fixture's .rows, .done and .elsewhere (a row the open board lacks:
  # aimed at a later version, dropped, rolled into a version note) that have one of those ids.
  board)
    ids=()
    while [ $# -gt 0 ]; do [ "$1" = --id ] && ids+=("${2:-}"); shift; done
    if [ "${#ids[@]}" -eq 0 ]; then emit board.json
    else
      jq -c --args '$ARGS.positional as $ids | {today: "", rows: [((.rows // []), (.done // []), (.elsewhere // []))[] | select(.id as $i | $ids | index($i))]}' \
        "${ids[@]}" < "$FIX/board.json"
    fi ;;
  today)
    : ;;                           # bootstrap no-op
  *)
    : ;;
esac
exit 0
